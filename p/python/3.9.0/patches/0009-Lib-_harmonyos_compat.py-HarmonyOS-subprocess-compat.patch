+"""
+HarmonyOS Subprocess Compatibility Layer
+
+This module provides transparent compatibility for subprocess execution
+on HarmonyOS/OpenHarmony systems where SELinux domain transitions prevent
+child processes from executing SDK binaries directly.
+
+Problem:
+--------
+HarmonyOS SELinux policy enforces domain transitions:
+- Shell process: u:r:hishell_hap:s0 (can execute SDK tools)
+- Python process: u:r:adhoc_bin:s0 (cannot execute SDK tools)
+
+When Python spawns a subprocess to run clang/llvm tools, the SELinux
+policy denies execution, causing silent failures (exit code 1, no output).
+
+Solution:
+---------
+Use pipe syntax (cmd | cat) to force the shell to fork a subprocess that
+retains execution permissions. This workaround is applied transparently
+to all subprocess calls.
+
+Usage:
+------
+This module is automatically imported by site.py during Python startup.
+No user action required.
+
+Debug:
+------
+Set HARMONYOS_SUBPROCESS_DEBUG=1 to enable logging.
+"""
+
+import os
+import sys
+
+# Configuration
+_DEBUG = os.environ.get('HARMONYOS_SUBPROCESS_DEBUG', '0') == '1'
+
+def _log(msg):
+    """Log debug messages if debugging is enabled."""
+    if _DEBUG:
+        print(f"[HarmonyOS-Compat] {msg}", file=sys.stderr)
+
+
+def _is_harmonyos():
+    """Detect if running on HarmonyOS/OpenHarmony."""
+    platform = sys.platform.lower()
+    return 'harmonyos' in platform or 'ohos' in platform
+
+
+def _wrap_with_pipe(cmd_str):
+    """
+    Wrap command with pipe syntax to bypass SELinux restrictions.
+    
+    Format: set -o pipefail; {cmd} 2>&1 | cat
+    
+    - pipefail: ensures exit code reflects the actual command
+    - 2>&1: redirects stderr to stdout for proper capture
+    - | cat: forces shell to fork subprocess with correct permissions
+    """
+    return f"set -o pipefail; {cmd_str} 2>&1 | cat"
+
+
+def _apply_compat_layer():
+    """
+    Apply HarmonyOS compatibility patches to subprocess-related functions.
+    
+    This modifies:
+    - os.system
+    - os.popen
+    - subprocess.Popen
+    """
+    if not _is_harmonyos():
+        _log("Not HarmonyOS, skipping compatibility layer")
+        return
+    
+    _log("Detected HarmonyOS, applying subprocess compatibility layer")
+    
+    # ============================================================
+    # Patch os.system
+    # ============================================================
+    _original_os_system = os.system
+    
+    def _wrapped_os_system(cmd):
+        if cmd:
+            wrapped_cmd = _wrap_with_pipe(cmd)
+            _log(f"os.system: '{cmd[:60]}...' -> pipe wrapped")
+            return _original_os_system(wrapped_cmd)
+        return _original_os_system(cmd)
+    
+    os.system = _wrapped_os_system
+    _log("Patched: os.system")
+    
+    # ============================================================
+    # Patch os.popen
+    # ============================================================
+    _original_os_popen = os.popen
+    
+    def _wrapped_os_popen(cmd, mode='r', buffering=-1):
+        if cmd:
+            wrapped_cmd = _wrap_with_pipe(cmd)
+            _log(f"os.popen: '{cmd[:60]}...' -> pipe wrapped")
+            return _original_os_popen(wrapped_cmd, mode, buffering)
+        return _original_os_popen(cmd, mode, buffering)
+    
+    os.popen = _wrapped_os_popen
+    _log("Patched: os.popen")
+    
+    # ============================================================
+    # Patch subprocess.Popen
+    # ============================================================
+    import subprocess
+    import shlex
+    
+    _original_popen_init = subprocess.Popen.__init__
+    
+    def _wrapped_popen_init(self, *args, **kwargs):
+        cmd = args[0] if args else kwargs.get('args')
+        
+        if cmd:
+            # Convert command to string
+            if isinstance(cmd, (list, tuple)):
+                cmd_str = ' '.join(shlex.quote(str(a)) for a in cmd)
+            else:
+                cmd_str = str(cmd)
+            
+            # Wrap with pipe syntax
+            wrapped_cmd = _wrap_with_pipe(cmd_str)
+            
+            # Update arguments for shell execution
+            kwargs['shell'] = True
+            kwargs.pop('executable', None)
+            
+            # Handle capture_output
+            if 'capture_output' in kwargs and kwargs['capture_output']:
+                kwargs.pop('capture_output')
+                if 'stdout' not in kwargs:
+                    kwargs['stdout'] = subprocess.PIPE
+                if 'stderr' not in kwargs:
+                    kwargs['stderr'] = subprocess.PIPE
+            
+            _log(f"subprocess.Popen: '{cmd_str[:60]}...' -> pipe wrapped")
+            return _original_popen_init(self, wrapped_cmd, **kwargs)
+        
+        return _original_popen_init(self, *args, **kwargs)
+    
+    subprocess.Popen.__init__ = _wrapped_popen_init
+    _log("Patched: subprocess.Popen.__init__")
+    
+    _log("Compatibility layer applied successfully")
+
+
+# Auto-apply when module is imported (called from site.py)
+def init():
+    """Initialize HarmonyOS compatibility layer."""
+    _apply_compat_layer()