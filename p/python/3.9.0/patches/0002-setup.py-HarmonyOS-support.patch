+HARMONY_SDK_ROOT = None
+
+def ohos_sdk_root():
+    """返回鸿蒙 SDK 的 sysroot 路径（参考 macosx_sdk_root 逻辑）"""
+    global HARMONY_SDK_ROOT
+    if HARMONY_SDK_ROOT:
+        return HARMONY_SDK_ROOT
+
+    # 方法1：从 CFLAGS 中提取 --sysroot 参数
+    cflags = sysconfig.get_config_var('CFLAGS') or ''
+    m = re.search(r'--sysroot=(\S+)', cflags)
+    if m is not None:
+        HARMONY_SDK_ROOT = m.group(1)
+        return HARMONY_SDK_ROOT
+
+    # 方法2：调用 Clang 命令探测 sysroot（兜底逻辑）
+    cc = sysconfig.get_config_var('CC') or 'clang'
+    tmpfile = './setup_harmony_sysroot.%d' % os.getpid()
+    try:
+        os.unlink(tmpfile)
+    except:
+        pass
+    # 执行 Clang 命令并捕获输出
+    cmd = f'{cc} -v -E - </dev/null 2>{tmpfile} 1>/dev/null'
+    ret = run_command(cmd)
+    if ret == 0:
+        with open(tmpfile) as fp:
+            for line in fp.readlines():
+                # 匹配鸿蒙 sysroot 特征路径
+                if '../../sysroot/usr/include' in line and not 'ignoring' in line:
+                    # 提取 sysroot 根目录
+                    sysroot_rel = re.search(r'(\S+/llvm/bin/../../sysroot)', line)
+                    if sysroot_rel:
+                        HARMONY_SDK_ROOT = os.path.abspath(sysroot_rel.group(1))
+                        break
+    # 清理临时文件
+    try:
+        os.unlink(tmpfile)
+    except:
+        pass
+    
+    return HARMONY_SDK_ROOT
+
+# 新增到 setup.py 中（sysroot_paths 函数下方即可）
+def get_ohos_arch():
+    """获取鸿蒙架构（纯内置模块，无外部依赖）"""
+    try:
+        # 优先用 os.uname (鸿蒙/类Unix原生支持)
+        arch = os.uname().machine.lower()
+    except AttributeError:
+        # Windows 兜底（理论上鸿蒙不会走到这）
+        arch = platform.machine().lower()
+
+    # 架构映射（可根据你的 SDK 目录扩展）
+    arch_map = {
+        "aarch64": "aarch64",
+        "arm64": "aarch64",
+        "armv8": "aarch64",
+        "armv8l": "aarch64",
+        "armv7": "arm32",
+        "armv7l": "arm32",
+        "arm": "arm32",
+        "x86_64": "x86_64",
+        "amd64": "x86_64"
+    }
+    return arch_map.get(arch, "aarch64")
+
 
