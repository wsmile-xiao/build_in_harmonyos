 /* Format an Ethernet mac address */
 char *mac_addr(const struct sockaddr *sa)
 {
 	if (sa->sa_family != ARPHRD_ETHER)
 		return "00:00:00:00:00:00";
 	return ether_lookup((const struct ether_addr *)sa->sa_data);
 }
