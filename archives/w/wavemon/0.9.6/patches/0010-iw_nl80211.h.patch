diff -ruN a/iw_nl80211.h b/iw_nl80211.h
--- a/iw_nl80211.h
+++ b/iw_nl80211.h
@@ -1,17 +1,28 @@
 /*
  * Definitions and functions for nl80211 based routines.
  */
 #include <stdbool.h>
 #include <netinet/ether.h>
 
+#ifdef __OHOS__
+/* On OHOS, linux/socket.h redefines sockaddr_storage conflicting with sys/socket.h.
+ * Include sys/socket.h first, skip linux/socket.h, but provide __kernel_sa_family_t
+ * which linux/netlink.h needs. */
+#include <sys/socket.h>
+#define _UAPI_LINUX_SOCKET_H
+typedef unsigned short __kernel_sa_family_t;
+#endif
 #include <netlink/netlink.h>
+#ifdef __OHOS__
+#undef _UAPI_LINUX_SOCKET_H
+#endif
 #include <netlink/cli/addr.h>
 #include <netlink/cli/link.h>
 
 /*
  * Use local copy of nl80211.h rather than the one shipped with the distro in
  * /usr/include/linux. There are different versions, local one may be out of date.
  */
 #include "nl80211.h"
 
 #define BIT(x) (1ULL<<(x))		/* from iw:iw.h */
