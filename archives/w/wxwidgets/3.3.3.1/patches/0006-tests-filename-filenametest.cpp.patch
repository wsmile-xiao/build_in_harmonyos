+#ifdef __UNIX__
+static bool IsExpectedCapabilityError(int error)
+{
+    if ( error == EACCES || error == EPERM || error == ENOSYS )
+        return true;
+#ifdef EOPNOTSUPP
+    if ( error == EOPNOTSUPP )
+        return true;
+#endif
+#ifdef EROFS
+    if ( error == EROFS )
+        return true;
+#endif
+    return false;
+}
+
+static bool IsUnsupportedSymlinkError()
+{
+    return IsExpectedCapabilityError(errno);
+}
+#endif // __UNIX__
