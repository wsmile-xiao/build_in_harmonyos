From: OHOS adaptation
Subject: [PATCH] Replace glibc-only headers for OHOS (musl)

- src/dockapp_main.c: drop `#include <bits/getopt_core.h>`. It is a
  glibc internal header (absent in musl/OHOS) and redundant because
  `<getopt.h>` is already included one line above.
- src/dockapp_utils.c: replace `#include <bits/types/time_t.h>`
  (glibc internal) with the standard `<time.h>`, which defines `time_t`
  on glibc and musl alike.
---
 src/dockapp_main.c  | 1 -
 src/dockapp_utils.c | 2 +-
 2 files changed, 1 insertion(+), 2 deletions(-)

diff --git a/src/dockapp_main.c b/src/dockapp_main.c
--- a/src/dockapp_main.c
+++ b/src/dockapp_main.c
@@ -22,7 +22,6 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <unistd.h>
-#include <bits/getopt_core.h>
 #include <signal.h>

 #ifdef USE_MTRACE
diff --git a/src/dockapp_utils.c b/src/dockapp_utils.c
--- a/src/dockapp_utils.c
+++ b/src/dockapp_utils.c
@@ -18,7 +18,7 @@
  *
  */

-#include <bits/types/time_t.h>
+#include <time.h>
 #include <paths.h>
 #include <stdio.h>
 #include <sys/stat.h>
--
2.0
