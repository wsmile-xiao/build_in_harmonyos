--- a/Makefile.waon
+++ b/Makefile.waon
@@ -3,15 +3,16 @@
 # $Id: Makefile.waon,v 1.7 2007/11/04 23:59:41 kichiki Exp $
 
 
-CC = gcc
+# conan exports CC/CFLAGS/LDFLAGS/LIBS through the environment; `?=`
+# keeps those values instead of clobbering them.
+CC ?= gcc
 
 # with FFTW3
-CFLAGS = \
-	-Wall -march=pentium -O3 -ffast-math \
+CFLAGS ?= \
+	-Wall -O3 -ffast-math \
 	`pkg-config --cflags fftw3` \
 	`pkg-config --cflags sndfile`
-LDFLAGS= \
-	-L/usr/local/lib \
+LDFLAGS ?= \
 	`pkg-config --libs fftw3` \
 	`pkg-config --libs sndfile` \
 	-lm
@@ -36,7 +37,7 @@
 	snd.o
 
 waon: $(OBJS)
-	$(CC) $(CFLAGS) -o waon $(OBJS) $(LDFLAGS)
+	$(CC) $(CFLAGS) -o waon $(OBJS) $(LDFLAGS) $(LIBS)
 
 clean: 
 	rm -f *.o *~ waon *.core
