diff --git a/tests/unit/CMakeLists.txt b/tests/unit/CMakeLists.txt
index 8075989..01a7b03 100644
--- a/tests/unit/CMakeLists.txt
+++ b/tests/unit/CMakeLists.txt
@@ -233,3 +233,23 @@ set_property(TEST unit PROPERTY
   "WEECHAT_TESTS_SCRIPTS_DIR=${CMAKE_CURRENT_SOURCE_DIR}/scripts/python;"
   "WEECHAT_TESTS_PLUGINS_LIB=${CMAKE_CURRENT_BINARY_DIR}/libweechat_unit_tests_plugins.so"
 )
+
+# OHOS: the loader does not make symbols of RTLD_GLOBAL-opened libraries
+# available to libraries opened later, so the plugins test module
+# (dlopened by the tests binary) cannot resolve plugin symbols (e.g.
+# alias_new) at runtime; preload the plugin shared objects into the test
+# process so their symbols land in the initial global scope
+if(CMAKE_SYSTEM_NAME MATCHES "OHOS|HarmonyOS")
+  set(WEECHAT_TESTS_PRELOAD_SO "")
+  foreach(plugin alias buflist charset exec fifo fset irc logger relay script trigger typing xfer)
+    if(TARGET ${plugin})
+      list(APPEND WEECHAT_TESTS_PRELOAD_SO "${CMAKE_BINARY_DIR}/src/plugins/${plugin}/${plugin}.so")
+    endif()
+  endforeach()
+  if(WEECHAT_TESTS_PRELOAD_SO)
+    string(JOIN ":" WEECHAT_TESTS_PRELOAD_STR ${WEECHAT_TESTS_PRELOAD_SO})
+    set_property(TEST unit APPEND PROPERTY
+      ENVIRONMENT "LD_PRELOAD=${WEECHAT_TESTS_PRELOAD_STR}"
+    )
+  endif()
+endif()
