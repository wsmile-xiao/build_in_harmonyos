diff --git a/CMakeLists.txt b/CMakeLists.txt
index 479c206..5eecbfe 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -29,7 +29,11 @@ project(weechat C)
 set(CMAKE_VERBOSE_MAKEFILE OFF)
 set(CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake" "${CMAKE_MODULE_PATH}")
 set(CMAKE_POSITION_INDEPENDENT_CODE ON)
-set(CMAKE_SKIP_RPATH ON)
+# keep RPATH on OHOS: shared libraries required at run time (for example
+# dependencies from the package cache) are not in the default library path
+if(NOT CMAKE_SYSTEM_NAME MATCHES "OHOS|HarmonyOS")
+  set(CMAKE_SKIP_RPATH ON)
+endif()
 
 # compiler options
 set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fsigned-char -fms-extensions -Wall -Wextra -Werror-implicit-function-declaration -Wformat -Werror=format-security")
@@ -207,6 +211,8 @@ check_symbol_exists("htonll" "sys/types.h;netinet/in.h;inttypes.h" HAVE_HTONLL)
 
 check_symbol_exists("eat_newline_glitch" "term.h" HAVE_EAT_NEWLINE_GLITCH)
 
+check_symbol_exists("pthread_cancel" "pthread.h" HAVE_PTHREAD_CANCEL)
+
 # Check if res_init requires libresolv
 check_function_exists(res_init, LIBC_HAS_RES_INIT)
 if(NOT LIBC_HAS_RES_INIT)
@@ -242,6 +248,14 @@ list(APPEND EXTRA_LIBS ${GNUTLS_LDFLAGS})
 
 # Check for zlib
 find_package(ZLIB REQUIRED)
+if(NOT ZLIB_LIBRARY AND TARGET ZLIB::ZLIB)
+  # ZLIB in config mode (for example from a package manager) provides the
+  # ZLIB::ZLIB imported target but not the ZLIB_LIBRARY variable
+  set(ZLIB_LIBRARY ZLIB::ZLIB)
+endif()
+if(ZLIB_INCLUDE_DIRS)
+  include_directories(${ZLIB_INCLUDE_DIRS})
+endif()
 list(APPEND EXTRA_LIBS ${ZLIB_LIBRARY})
 
 # Check for zstd
