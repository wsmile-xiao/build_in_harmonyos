+/* SPDX-FileCopyrightText: 2026 OpenHarmony PC Developer
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * GDK Wayland accessor compatibility shim for HarmonyOS PC.
+ *
+ * The HarmonyOS PC GTK 3 package (gtk/3.24.43) is built with the Broadway
+ * (HTML5) backend only: it ships neither the Wayland backend nor
+ * <gdk/gdkwayland.h>.  wdisplays is a Wayland client and relies on the small
+ * set of GDK accessors that expose the underlying wl_display / wl_output /
+ * wl_surface objects.
+ *
+ * This shim provides those accessors on top of wayland-client, which *is*
+ * available on HarmonyOS: the wl_display comes from a real
+ * wl_display_connect() and the wl_output objects from the registry.  A
+ * GdkWindow rendered through Broadway has no wl_surface behind it, so the
+ * surface accessor reports "unavailable" and callers must tolerate NULL.
+ */
+#pragma once
+
+#include <gdk/gdk.h>
+#include <wayland-client.h>
+
+G_BEGIN_DECLS
+
+struct wl_display *gdk_wayland_display_get_wl_display(GdkDisplay *display);
+struct wl_output *gdk_wayland_monitor_get_wl_output(GdkMonitor *monitor);
+struct wl_surface *gdk_wayland_window_get_wl_surface(GdkWindow *window);
+void gdk_wayland_window_set_use_custom_surface(GdkWindow *window);
+
+/* <gdk/gdkwayland.h> also provides this guard, used by main.c to reject
+ * non-Wayland sessions.  Without a Wayland backed GDK the truthful answer is
+ * whether a Wayland connection could be established at all. */
+#define GDK_IS_WAYLAND_DISPLAY(display) \
+  (gdk_wayland_display_get_wl_display(GDK_DISPLAY(display)) != NULL)
+
+G_END_DECLS
