--- /dev/null
+++ b/src/gdkwayland-compat.c
@@ -0,0 +1,77 @@
+/* SPDX-FileCopyrightText: 2026 OpenHarmony PC Developer
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * GDK Wayland accessor compatibility shim for HarmonyOS PC.
+ * See gdkwayland-compat.h for the rationale.
+ */
+
+#include "gdkwayland-compat.h"
+
+/* The Wayland connection is process wide, exactly like GDK's own Wayland
+ * backend, so a single cached handle is enough. */
+static struct wl_display *wl_display_singleton = NULL;
+static struct wl_output **wl_output_list = NULL;
+static unsigned int wl_output_list_size = 0;
+
+static void registry_handle_global(void *data, struct wl_registry *registry,
+    uint32_t name, const char *interface, uint32_t version) {
+  if (g_strcmp0(interface, wl_output_interface.name) != 0)
+    return;
+  struct wl_output *output =
+      wl_registry_bind(registry, name, &wl_output_interface, 1);
+  if (output == NULL)
+    return;
+  struct wl_output **grown = g_try_realloc_n(wl_output_list,
+      wl_output_list_size + 1, sizeof(*grown));
+  if (grown == NULL) {
+    wl_output_destroy(output);
+    return;
+  }
+  wl_output_list = grown;
+  wl_output_list[wl_output_list_size++] = output;
+}
+
+static void registry_handle_global_remove(void *data,
+    struct wl_registry *registry, uint32_t name) {
+}
+
+static const struct wl_registry_listener registry_listener = {
+  .global = registry_handle_global,
+  .global_remove = registry_handle_global_remove,
+};
+
+struct wl_display *gdk_wayland_display_get_wl_display(GdkDisplay *display) {
+  if (wl_display_singleton == NULL) {
+    wl_display_singleton = wl_display_connect(NULL);
+    if (wl_display_singleton != NULL) {
+      struct wl_registry *registry =
+          wl_display_get_registry(wl_display_singleton);
+      wl_registry_add_listener(registry, &registry_listener, NULL);
+      wl_display_roundtrip(wl_display_singleton);
+    }
+  }
+  return wl_display_singleton;
+}
+
+struct wl_output *gdk_wayland_monitor_get_wl_output(GdkMonitor *monitor) {
+  GdkDisplay *display = gdk_monitor_get_display(monitor);
+  if (gdk_wayland_display_get_wl_display(display) == NULL)
+    return NULL;
+  /* Broadway exposes a single synthetic monitor, so the registry order is the
+   * best available association between GdkMonitor and wl_output. */
+  int count = gdk_display_get_n_monitors(display);
+  for (int i = 0; i < count && (unsigned int) i < wl_output_list_size; i++) {
+    if (gdk_display_get_monitor(display, i) == monitor)
+      return wl_output_list[i];
+  }
+  return NULL;
+}
+
+struct wl_surface *gdk_wayland_window_get_wl_surface(GdkWindow *window) {
+  /* A Broadway window is a HTML5 canvas: there is no wl_surface behind it. */
+  return NULL;
+}
+
+void gdk_wayland_window_set_use_custom_surface(GdkWindow *window) {
+  /* Meaningless without a Wayland backed GDK window. */
+}
