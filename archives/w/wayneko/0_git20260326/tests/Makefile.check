# Makefile.check -- supplemented layer-1 behaviour suite for wayneko.
#
# Upstream wayneko has no test target; this suite is driven explicitly from the
# Conan recipe's build() step:
#
#   make -f <tests>/Makefile.check check \
#        CC=<clang> SRC_DIR=<wayneko src> GEN_DIR=<generated protocols> \
#        TEST_SRC=<tests>/test_wayneko.c OUT=<test binary> \
#        CFLAGS="..." LDFLAGS="..."
#
# test_wayneko.c compiles the ACTUAL upstream wayneko.c (entry point renamed)
# together with the wayland-scanner generated protocol sources, then runs the
# assertion driver. A non-zero driver exit fails `make check` -> conan create.

CC        ?= clang
SRC_DIR   ?= .
GEN_DIR   ?= .
TEST_SRC  ?= $(SRC_DIR)/tests/test_wayneko.c
OUT       ?= test_wayneko
CFLAGS    ?= -O0 -g -Wno-unused-function
LDFLAGS   ?=

PROTO_SRCS := $(GEN_DIR)/wlr-layer-shell-unstable-v1.c \
              $(GEN_DIR)/xdg-shell.c \
              $(GEN_DIR)/ext-idle-notify-v1.c

check: $(OUT)
	@echo "[layer-1] running supplemented wayneko behaviour suite"
	$(OUT)
	@echo "[layer-1] make check target completed"

$(OUT): $(TEST_SRC) $(PROTO_SRCS)
	$(CC) $(CFLAGS) -I$(GEN_DIR) -I$(SRC_DIR) -o $(OUT) \
	    $(TEST_SRC) $(PROTO_SRCS) $(LDFLAGS)

.PHONY: check clean
clean:
	$(RM) $(OUT)
