--- /dev/null
+++ b/pthread_compat.c
@@ -0,0 +1,47 @@
+/*
+ * OpenHarmony (musl) compatibility shim for the POSIX thread cancellation API.
+ *
+ * The OpenHarmony libc exports 101 pthread_* entry points but deliberately
+ * omits the cancellation family: pthread_cancel(), pthread_setcancelstate(),
+ * pthread_setcanceltype() and pthread_testcancel() are not present in
+ * libc.so. libfuse 2.9 references them unconditionally from fuse.o
+ * (fuse_stop_cleanup_thread) and fuse_loop_mt.o (fuse_session_loop_mt), so
+ * linking winregfs against the static libfuse.a fails with:
+ *
+ *     ld.lld: error: undefined symbol: pthread_cancel
+ *     >>> referenced by fuse.c
+ *     >>>               fuse.o:(fuse_stop_cleanup_thread) in archive .../libfuse.a
+ *
+ * winregfs itself only uses pthread mutexes (see winregfs.h LOCK()/UNLOCK())
+ * and never cancels a thread. These definitions exist to satisfy the linker
+ * on targets where the C library lacks them (built only when the Makefile
+ * variable BUILD_PTHREAD_COMPAT=1). Cancellation is a best-effort no-op: the
+ * platform does not implement asynchronous thread cancellation.
+ */
+#include <pthread.h>
+
+int pthread_cancel(pthread_t thread)
+{
+	(void)thread;
+	return 0;
+}
+
+int pthread_setcancelstate(int state, int *oldstate)
+{
+	(void)state;
+	if (oldstate != NULL)
+		*oldstate = 0;	/* PTHREAD_CANCEL_ENABLE */
+	return 0;
+}
+
+int pthread_setcanceltype(int type, int *oldtype)
+{
+	(void)type;
+	if (oldtype != NULL)
+		*oldtype = 0;	/* PTHREAD_CANCEL_DEFERRED */
+	return 0;
+}
+
+void pthread_testcancel(void)
+{
+}
