+// Names below are resolved through the `using namespace` directives of the
+// branch selected above, so they are valid for both Boost.Asio and standalone
+// Asio, and for both sides of WEBSOCKETPP_ASIO_MODERN.
+namespace asio {
+
+    #if WEBSOCKETPP_ASIO_MODERN
+        /// io_service was removed; io_context is its drop-in replacement.
+        typedef io_context io_service;
+
+        /// io_service::work was replaced by an explicit work guard.
+        typedef executor_work_guard<io_context::executor_type> work;
+
+        /// The classic resolver handed back an iterator, the modern one a
+        /// results range. Both are delivered to handle_resolve().
+        typedef ip::tcp::resolver::results_type resolve_results;
+
+        /// Synchronously resolve a host/service pair.
+        inline resolve_results resolve_endpoints(ip::tcp::resolver & resolver,
+            std::string const & host, std::string const & service)
+        {
+            return resolver.resolve(host, service);
+        }
+
+        /// Asynchronously resolve a host/service pair.
+        template <typename handler_type>
+        void async_resolve_endpoints(ip::tcp::resolver & resolver,
+            std::string const & host, std::string const & service,
+            handler_type handler)
+        {
+            resolver.async_resolve(host, service, handler);
+        }
+    #else
+        // io_service itself comes from the using namespace directive here.
+        typedef io_service::work work;
+        typedef ip::tcp::resolver::iterator resolve_results;
+
+        inline resolve_results resolve_endpoints(ip::tcp::resolver & resolver,
+            std::string const & host, std::string const & service)
+        {
+            return resolver.resolve(ip::tcp::resolver::query(host,service));
+        }
+
+        template <typename handler_type>
+        void async_resolve_endpoints(ip::tcp::resolver & resolver,
+            std::string const & host, std::string const & service,
+            handler_type handler)
+        {
+            resolver.async_resolve(
+                ip::tcp::resolver::query(host,service),handler);
+        }
+    #endif
+
+    /// Whether a resolution produced no usable endpoint.
+    inline bool resolve_empty(resolve_results const & results) {
+        #if WEBSOCKETPP_ASIO_MODERN
+            return results.empty();
+        #else
+            return results == resolve_results();
+        #endif
+    }
+
+    /// The first endpoint of a resolution result.
+    inline ip::tcp::endpoint resolve_first(resolve_results const & results) {
+        #if WEBSOCKETPP_ASIO_MODERN
+            return results.begin()->endpoint();
+        #else
+            return results->endpoint();
+        #endif
+    }
+
+    /// Append every resolved endpoint to a log stream.
+    template <typename stream_type>
+    void log_resolve_results(stream_type & s, resolve_results const & results)
+    {
+        #if WEBSOCKETPP_ASIO_MODERN
+            for (resolve_results::const_iterator it = results.begin();
+                it != results.end(); ++it)
+            {
+                s << it->endpoint() << " ";
+            }
+        #else
+            resolve_results it, end;
+            for (it = results; it != end; ++it) {
+                s << (*it).endpoint() << " ";
+            }
+        #endif
+    }
+
+    /// Whether a timer's deadline has already passed.
+    /**
+     * Replaces the removed expires_from_now() getter, which reported the time
+     * still left on the timer: a negative duration meant the timer had already
+     * expired or been cancelled.
+     */
+    template <typename timer_type>
+    bool is_expired(timer_type const & timer) {
+        #if WEBSOCKETPP_ASIO_MODERN
+            return timer.expiry() <= timer_type::clock_type::now();
+        #else
+            return is_neg(timer.expires_from_now());
+        #endif
+    }
+
+    /// Queue a handler to run on the io_service.
+    /**
+     * io_service::post() is gone from Asio >= 1.31; the free post() function is
+     * the replacement.
+     */
+    template <typename handler_type>
+    void post_handler(io_service & service, handler_type handler) {
+        #if WEBSOCKETPP_ASIO_MODERN
+            post(service, handler);
+        #else
+            service.post(handler);
+        #endif
+    }
+
+    /// Allow a stopped io_service to be run again.
+    /**
+     * io_service::reset() became restart() when io_context replaced io_service.
+     */
+    inline void reset_io_service(io_service & service) {
+        #if WEBSOCKETPP_ASIO_MODERN
+            service.restart();
+        #else
+            service.reset();
+        #endif
+    }
+
+} // namespace asio
