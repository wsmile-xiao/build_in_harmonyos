diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,27 @@
+#!/bin/sh
+# Minimal configure wrapper for ioping (pure Makefile project)
+# This script accepts standard configure parameters but is essentially a no-op
+# since ioping builds directly via Makefile with no autoconf support.
+# Created for HarmonyOS pre-compile clean-verify compatibility.
+
+prefix=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*) prefix="${1#--prefix=}" ;;
+        --help) echo "Usage: ./configure [--prefix=PREFIX]"; exit 0 ;;
+        *) ;; # ignore unknown options
+    esac
+    shift
+done
+
+if [ -z "$prefix" ]; then
+    prefix="/usr/local"
+fi
+
+# Patch Makefile with the prefix if it differs from default
+if [ "$prefix" != "/usr/local" ]; then
+    sed -i "s|^prefix=/usr/local|prefix=$prefix|" Makefile
+fi
+
+echo "configure: ioping configured (prefix=$prefix)"
+exit 0
