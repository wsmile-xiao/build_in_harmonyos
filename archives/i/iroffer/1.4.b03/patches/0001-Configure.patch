 case "$ostype" in
+ HarmonyOS )
+  # HarmonyOS PC reports "HarmonyOS" from uname -s (HongMeng kernel).
+  # Its C library is musl-based with Linux-compatible socket/file APIs,
+  # so map it onto the existing Linux branch: config.h then defines
+  # _OS_Linux, which is what selects _GNU_SOURCE in iroffer_defines.h.
+  ostype=Linux
+  ;;
  Linux | FreeBSD | OpenBSD | NetBSD | IRIX | IRIX64 | \
  OSF1 | Rhapsody | Darwin | AIX )
   # nothing fancy
   ;;
  SunOS )
   libs="$libs -lsocket -lnsl"
   ;;
  BSD/OS )
   ostype=BSD_OS
   ;;
