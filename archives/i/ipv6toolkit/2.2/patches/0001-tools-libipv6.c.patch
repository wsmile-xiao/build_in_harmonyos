diff -ruN a/tools/libipv6.c b/tools/libipv6.c
--- a/tools/libipv6.c
+++ b/tools/libipv6.c
@@ -40,6 +40,24 @@
 #include <netinet/tcp.h>
 #ifdef __linux__
 #include <asm/types.h>
+/*
+ * Feature detection: if sys/socket.h has already been included, it
+ * defines sockaddr_storage.  On systems where linux/socket.h uses
+ * _UAPI_LINUX_SOCKET_H as its include guard (e.g. OHOS musl libc),
+ * pre-defining that guard prevents linux/socket.h — pulled in by
+ * netlink.h/rtnetlink.h — from redefining sockaddr_storage.
+ * On standard Linux the guard name differs, making this a no-op.
+ * __kernel_sa_family_t is provided here because linux/socket.h
+ * (now skipped on OHOS) would normally define it; asm/types.h
+ * does not on OHOS.
+ */
+#ifdef _SYS_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+typedef unsigned short __kernel_sa_family_t;
+#endif
 #include <linux/netlink.h>
 #include <linux/rtnetlink.h>
+#ifdef _SYS_SOCKET_H
+#undef _UAPI_LINUX_SOCKET_H
+#endif
 #include <netpacket/packet.h> /* For datalink structure */
