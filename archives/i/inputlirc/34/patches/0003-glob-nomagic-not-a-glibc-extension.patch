+/* GLOB_NOMAGIC is a GNU/glibc-only glob(3) extension; it is absent from the
+ * libc shipped with HarmonyOS. Its only effect here is to let a device path
+ * with no glob metacharacters stand for itself, so falling back to 0 keeps
+ * the behaviour that matters (a literal device node is still matched when it
+ * exists) while degrading gracefully where the extension is missing. */
+#ifndef GLOB_NOMAGIC
+#define GLOB_NOMAGIC 0
+#endif
