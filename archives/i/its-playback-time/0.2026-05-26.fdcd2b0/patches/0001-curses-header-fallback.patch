Fall back to probing the curses include directory directly

CMake's FindCurses module only fills in CURSES_HAVE_NCURSES_CURSES_H
/CURSES_HAVE_NCURSES_NCURSES_H from an ncursesw/ (or ncurses/) header
subdirectory, and it only fills in CURSES_HAVE_NCURSES_H /
CURSES_HAVE_CURSES_H when CURSES_NEED_WIDE is false. unix/CMakeLists.txt
asks for the wide library (CURSES_NEED_WIDE TRUE), so on a curses
installation that exposes ncurses.h / curses.h directly in its include
directory - such as the ncurses Conan package - all four variables end
up false, unix/ipbt.c then includes no curses header at all and the
build dies with undeclared identifiers (stdscr, wmove, wattrset,
waddch, ACS_DIAMOND, A_BLINK).

Probe the include directory CMake already resolved and set the variable
that matches the header actually found there. This only ever changes a
previously-false variable and only when the header exists, so builds
that already worked are unaffected.

--- a/unix/CMakeLists.txt
+++ b/unix/CMakeLists.txt
@@ -26,6 +26,32 @@
 endif()
 if(NOT CURSES_FOUND)
   message(FATAL_ERROR "Cannot build IPBT without a curses library")
+endif()
+
+# CMake's FindCurses module only populates the CURSES_HAVE_*_H variables from
+# the ncursesw/ (or ncurses/) header *subdirectory* layout, and it skips the
+# plain ncurses.h / curses.h cases altogether whenever CURSES_NEED_WIDE is
+# set. Installations that ship the wide-character library from a single flat
+# include directory - which is how the ncurses Conan package is laid out, and
+# how some distributions package it as well - therefore end up with all four
+# CURSES_HAVE_*_H variables false, so unix/ipbt.c includes no curses header at
+# all and the build fails on undeclared curses identifiers (stdscr, wmove,
+# wattrset, ACS_*). Probe the include directory directly as a fallback; this
+# only ever sets a variable that was previously false, and only when the
+# header is genuinely present.
+if(NOT CURSES_HAVE_NCURSES_CURSES_H AND NOT CURSES_HAVE_NCURSES_NCURSES_H
+   AND NOT CURSES_HAVE_NCURSES_H AND NOT CURSES_HAVE_CURSES_H)
+  foreach(_curses_inc ${CURSES_INCLUDE_DIRS})
+    if(EXISTS "${_curses_inc}/ncurses.h")
+      set(CURSES_HAVE_NCURSES_H TRUE)
+    elseif(EXISTS "${_curses_inc}/curses.h")
+      set(CURSES_HAVE_CURSES_H TRUE)
+    endif()
+  endforeach()
+  if(CURSES_HAVE_NCURSES_H OR CURSES_HAVE_CURSES_H)
+    message(STATUS
+      "Curses headers found directly in ${CURSES_INCLUDE_DIRS}")
+  endif()
 endif()
 set(CURSES_HAVE_CURSES_H ${CURSES_HAVE_CURSES_H} PARENT_SCOPE)
 set(CURSES_HAVE_NCURSES_H ${CURSES_HAVE_NCURSES_H} PARENT_SCOPE)
