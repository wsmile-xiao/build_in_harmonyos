diff -ruN a/src/drv_imap.c b/src/drv_imap.c
--- a/src/drv_imap.c
+++ b/src/drv_imap.c
@@ -5,20 +5,65 @@
 /*
  * mbsync - mailbox synchronizer
  */
 
 #include "imap_p.h"
 
 #include "socket.h"
 
 #include <ctype.h>
 #include <sys/wait.h>
+
+/* OpenHarmony compatibility: provide getpass replacement */
+#ifndef HAVE_GETPASS
+#include <termios.h>
+static char *
+getpass(const char *prompt)
+{
+	static char buf[256];
+	FILE *in, *out;
+	struct termios oldt, newt;
+	int tty_changed = 0;
+
+	in = fopen("/dev/tty", "r");
+	if (!in) in = stdin;
+	out = fopen("/dev/tty", "w");
+	if (!out) out = stderr;
+
+	/* Try to disable echo */
+	if (in != stdin && tcgetattr(fileno(in), &oldt) == 0) {
+		newt = oldt;
+		newt.c_lflag &= ~ECHO;
+		if (tcsetattr(fileno(in), TCSAFLUSH, &newt) == 0)
+			tty_changed = 1;
+	}
+
+	fprintf(out, "%s", prompt);
+	fflush(out);
+
+	if (!fgets(buf, sizeof(buf), in)) {
+		buf[0] = 0;
+	} else {
+		size_t len = strlen(buf);
+		if (len > 0 && buf[len-1] == '\n')
+			buf[len-1] = 0;
+	}
+
+	if (tty_changed)
+		tcsetattr(fileno(in), TCSAFLUSH, &oldt);
+
+	if (in != stdin) fclose(in);
+	if (out != stderr) fclose(out);
+
+	return buf[0] ? buf : NULL;
+}
+#endif /* HAVE_GETPASS */
 
 #ifdef HAVE_LIBSASL
 # include <sasl/sasl.h>
 # include <sasl/saslutil.h>
 #endif
 
 #ifdef HAVE_MACOS_KEYCHAIN
 # include <Security/Security.h>
 #endif
 
