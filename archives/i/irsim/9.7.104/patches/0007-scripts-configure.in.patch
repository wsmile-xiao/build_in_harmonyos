--- a/scripts/configure.in
+++ b/scripts/configure.in
@@ -806,20 +806,26 @@
      gr_libs="$gr_libs -lX11"
      gr_srcs="$gr_srcs \${TK_SRCS}"
   else
      gr_srcs="$gr_srcs \${NULL_SRCS}"
   fi
 else
   if test $usingX11 ; then
     gr_dflags="$gr_dflags -DX11 -DXLIB"
     gr_libs="$gr_libs -lX11"
     gr_srcs="$gr_srcs \${X11_SRCS}"
+  else
+    # 覆盖而非追加：此前 gr_srcs 已含 thread.c（X11 事件线程，见
+    # --enable-threads 分支），thread.c 依赖 X11/Xlib.h，无 X11 时必须
+    # 从源码列表移除，故此处整体覆盖为 NULL_SRCS（无图形桩 noana.c）。
+    gr_srcs="\${NULL_SRCS}"
+    gr_libs=""
   fi
   if test $usingX11 ; then
     if ! test $usingThreads; then
       gr_dflags="$gr_dflags -DX11HELP_PROG=\\\"\${X11HELP_PROG}\\\""
       gr_hsrcs="$gr_hsrcs \${X11HELPER_SRCS}"
       gr_prog="$gr_hprog \${X11HELP_PROG}"
     fi
   fi
 fi
 
