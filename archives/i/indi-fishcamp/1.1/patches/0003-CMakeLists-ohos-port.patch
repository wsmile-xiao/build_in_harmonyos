--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,6 +10,17 @@
 find_package(ZLIB REQUIRED)
 find_package(FISHCAMP REQUIRED)
 
+# The driver links libfishcamp (built against libusb-1.0); the 1.1 tree has no
+# FindUSB1 wiring, so locate the libusb library via the package prefix (conan)
+# and add it to the link line. The libusb *include* dir (leaf holding libusb.h)
+# is injected by the Conan toolchain (fishcamp_common.h includes <libusb.h>).
+find_library(LIBUSB_LIBRARY NAMES usb-1.0)
+
+# Install the device descriptor into THIS package's share/indi. The vendored
+# FindINDI.cmake reports INDI_DATA_DIR as the libindi package's data dir, which
+# would install the xml into the wrong package.
+set(INDI_DATA_DIR "${CMAKE_INSTALL_PREFIX}/share/indi")
+
 set (FISHCAMP_VERSION_MAJOR 1)
 set (FISHCAMP_VERSION_MINOR 1)
 
@@ -24,6 +35,12 @@
 
 include(CMakeCommon)
 
+# INDI >= 2.0 base-class headers (defaultdevice.h) use C++17 features such as
+# std::any; the vendored CMakeCommon.cmake pins CMAKE_CXX_STANDARD to 14, which
+# cannot compile them. Raise the standard for this driver.
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
 ############# FISHCAMP STARFISH CCD ###############
 set(fishcampccd_SRCS
         ${CMAKE_CURRENT_SOURCE_DIR}/indi_fishcamp.cpp
@@ -31,7 +48,7 @@
 
 add_executable(indi_fishcamp_ccd ${fishcampccd_SRCS})
 
-target_link_libraries(indi_fishcamp_ccd ${FISHCAMP_LIBRARIES} ${INDI_LIBRARIES} ${CFITSIO_LIBRARIES} m ${ZLIB_LIBRARY})
+target_link_libraries(indi_fishcamp_ccd ${FISHCAMP_LIBRARIES} ${INDI_LIBRARIES} ${CFITSIO_LIBRARIES} m ${ZLIB_LIBRARY} ${LIBUSB_LIBRARY})
 
 install(TARGETS indi_fishcamp_ccd RUNTIME DESTINATION bin)
 
