+def _command_output(cmd):
+	# Run a short git probe as bytes and decode defensively. Direct os.popen()
+	# reads the pipe through a host-derived codec and raises "TypeError: can't
+	# concat str to bytes" on some HarmonyOS/python runtimes when the tree is
+	# not a git repository. Reading raw bytes and decoding with replacement
+	# keeps single-header generation deterministic regardless of locale/env.
+	try:
+		import subprocess
+		return subprocess.Popen(
+			cmd,
+			shell=True,
+			stdout=subprocess.PIPE,
+			stderr=subprocess.DEVNULL).communicate(timeout=5)[0].decode(
+				'utf-8', 'replace').strip()
+	except Exception:
+		return ''
+
+
