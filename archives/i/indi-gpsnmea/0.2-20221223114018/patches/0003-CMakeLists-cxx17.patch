--- a/CMakeLists.txt	2026-10-04 10:33:18.917485156 +0800
+++ b/CMakeLists.txt	2026-10-04 10:33:19.169483281 +0800
@@ -29,6 +29,12 @@
 
 include(CMakeCommon)
 
+# INDI >= 2.0 base-class headers (defaultdevice.h) use C++17 features such as
+# std::any; the vendored CMakeCommon.cmake pins CMAKE_CXX_STANDARD to 14, which
+# cannot compile them. Raise the standard for this driver.
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
 add_executable(indi_gpsnmea gpsnmea_driver.cpp minmea.c)
 target_link_libraries(indi_gpsnmea ${INDI_LIBRARIES} ${NOVA_LIBRARIES} ${CMAKE_THREAD_LIBS_INIT})
 install(TARGETS indi_gpsnmea RUNTIME DESTINATION bin )
