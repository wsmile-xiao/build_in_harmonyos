 	if (uc_cpu) {
 		/* tie linked lists */
 		add_filter_list_to_list(filter_list, uc_cpu);
 		uc_cpu = NULL;
 	}
 
 	return (rc > 0) ? rc : 0;
+#endif /* HAVE_CPUID_H */
 }
 
