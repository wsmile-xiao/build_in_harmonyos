Subject: [PATCH] tests: honour TMPDIR instead of hardcoded /tmp

Upstream test_trim.cpp and test_amplicon_search.cpp hardcode /tmp as the
scratch directory. On HarmonyOS PCs /tmp is a read-only mount, so
check_trim fails with EROFS (4 write attempts to /tmp/trim.bam all
failed, round-3 device run: 20/21 PASS). Make both tests resolve the
scratch dir from TMPDIR (conan provides a writable one; the recipe also
exports TMPDIR for make check), falling back to the current directory.
Test-only change: library code untouched, assertions unchanged.
---
 tests/test_amplicon_search.cpp | 22 +++++++++++++++-----
 tests/test_trim.cpp            | 20 ++++++++++++++++++--
 2 files changed, 34 insertions(+), 6 deletions(-)

--- a/tests/test_amplicon_search.cpp
+++ b/tests/test_amplicon_search.cpp
@@ -1,6 +1,22 @@
 #include <iostream>
+
+#include <cstdlib>
+#include <string>
 #include <vector>
 
+// OHOS adaptation (build_in_harmonyos): upstream hardcodes /tmp, which is
+// a read-only mount on HarmonyOS PCs (EROFS on device, round-3实测).
+// Honour TMPDIR when set (conan provides a writable one), else fall back
+// to the current directory. Test-only change; library code untouched.
+static std::string ivar_test_tmpdir() {
+  const char *env = std::getenv("TMPDIR");
+  std::string d = (env && *env) ? std::string(env) : std::string(".");
+  while (d.size() > 1 && d[d.size() - 1] == '/') {
+    d.erase(d.size() - 1);
+  }
+  return d;
+}
+
 #include "../src/interval_tree.h"
 #include "../src/primer_bed.h"
 #include "../src/trim_primer_quality.h"
@@ -39,8 +55,8 @@
   std::string pair_indice = "../data/pair_info_2.tsv";
   int32_t primer_offset = 0;
   std::string bed = "../data/test_isize.bed";
-  std::string prefix = "/tmp/data/trim_amplicon";
-  std::string bam_out = "/tmp/trim_amplicon.bam";
+  std::string prefix = ivar_test_tmpdir() + "/data/trim_amplicon";
+  std::string bam_out = ivar_test_tmpdir() + "/trim_amplicon.bam";
 
   IntervalTree amplicons;
   bool expected[8] = {true, false, true, false, true, false, true, false};
--- a/tests/test_trim.cpp
+++ b/tests/test_trim.cpp
@@ -5,6 +5,22 @@
 #include "../src/trim_primer_quality.h"
 #include "htslib/sam.h"
 
+#include <cstdlib>
+#include <string>
+
+// OHOS adaptation (build_in_harmonyos): upstream hardcodes /tmp, which is
+// a read-only mount on HarmonyOS PCs (EROFS on device, round-3实测).
+// Honour TMPDIR when set (conan provides a writable one), else fall back
+// to the current directory. Test-only change; library code untouched.
+static std::string ivar_test_tmpdir() {
+  const char *env = std::getenv("TMPDIR");
+  std::string d = (env && *env) ? std::string(env) : std::string(".");
+  while (d.size() > 1 && d[d.size() - 1] == '/') {
+    d.erase(d.size() - 1);
+  }
+  return d;
+}
+
 typedef struct {
   uint16_t flag;
   uint32_t n_cigar;
@@ -24,8 +40,8 @@
   std::string bed = "../data/test.bed";
   std::string pair_info = "";
   int32_t primer_offset = 0;
-  std::string prefix = "/tmp/trim";
-  std::string bam_out = "/tmp/trim.bam";
+  std::string prefix = ivar_test_tmpdir() + "/trim";
+  std::string bam_out = prefix + ".bam";
 
   std::string region_ = "";
   std::string cmd = "@PG\tID:ivar-trim\tPN:ivar\tVN:1.0.0\tCL:ivar trim\n";
