+static const char *
+read_password(const char *prompt)
+{
+  static char password[BUFSIZ];
+  struct termios saved;
+  struct termios noecho;
+  size_t used = 0;
+  int tty = open("/dev/tty", O_RDWR);
+  int complete = 0;
+  char ch;
+
+  if (tty < 0)
+    return NULL;
+  if (tcgetattr(tty, &saved) < 0)
+  {
+    close(tty);
+    return NULL;
+  }
+
+  noecho = saved;
+  noecho.c_lflag &= ~(ECHO | ECHONL);
+  if (write(tty, prompt, strlen(prompt)) < 0 ||
+      tcsetattr(tty, TCSAFLUSH, &noecho) < 0)
+  {
+    close(tty);
+    return NULL;
+  }
+
+  while (used < sizeof(password) - 1)
+  {
+    if (read(tty, &ch, 1) != 1)
+      break;
+    if (ch == '\n' || ch == '\r')
+    {
+      complete = 1;
+      break;
+    }
+    password[used++] = ch;
+  }
+
+  if (tcsetattr(tty, TCSAFLUSH, &saved) < 0)
+    complete = 0;
+  (void)write(tty, "\n", 1);
+  close(tty);
+
+  if (!complete)
+    return NULL;
+  password[used] = '\0';
+  return password;
+}
 
