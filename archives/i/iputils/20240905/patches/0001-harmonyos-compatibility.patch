From: OpenHarmony Compiler Team
Subject: [PATCH] HarmonyOS compatibility fixes for iputils 20240905

This patch fixes compilation issues on HarmonyOS/musl platform:
1. program_invocation_short_name is glibc-specific, use __progname fallback
2. sockaddr_storage redefinition conflict between sys/socket.h and linux/socket.h

--- a/iputils_common.c
+++ b/iputils_common.c
@@ -19,7 +19,14 @@
 #ifdef HAVE_ERROR_H
 # include <error.h>
 #else
+/* program_invocation_short_name is glibc-specific, provide fallback for HarmonyOS/musl */
+#ifndef program_invocation_short_name
+/* Use __progname which is available in most libc implementations */
+extern char *__progname;
+# define program_invocation_short_name (__progname ? __progname : "iputils")
+#endif
+
 void error(int status, int errnum, const char *format, ...)
 {
 	va_list ap;

--- a/clockdiff.c
+++ b/clockdiff.c
@@ -16,6 +16,13 @@
 
 #define _GNU_SOURCE
 
+/* program_invocation_short_name is glibc-specific, provide fallback for HarmonyOS */
+#ifndef program_invocation_short_name
+# ifdef __OHOS__
+extern char *__progname;
+# define program_invocation_short_name (__progname ? __progname : "clockdiff")
+# endif
+#endif
+
 #define TSPTYPES
 
 #include <arpa/inet.h>

--- a/arping.c
+++ b/arping.c
@@ -11,6 +11,15 @@
 
 #define _GNU_SOURCE
 
+/* Avoid sockaddr_storage redefinition between sys/socket.h and linux/socket.h */
+#define sockaddr_storage __linux_sockaddr_storage
+
+#include <sys/socket.h>
+#include <arpa/inet.h>
+#include <errno.h>
+#include <ifaddrs.h>
+
+#undef sockaddr_storage  /* Restore sockaddr_storage name */
+
 #include <arpa/inet.h>
 #include <errno.h>
 #include <ifaddrs.h>