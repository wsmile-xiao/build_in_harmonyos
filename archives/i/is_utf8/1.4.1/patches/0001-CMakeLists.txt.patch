 message(STATUS "Compiling using the C++ standard:" ${CMAKE_CXX_STANDARD})
 # ---- Install rules ----
 add_library(is_utf8::is_utf8 ALIAS is_utf8)
 
 set_target_properties(
     is_utf8 PROPERTIES
