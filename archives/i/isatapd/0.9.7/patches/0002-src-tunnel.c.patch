--- a/src/tunnel.c
+++ b/src/tunnel.c
@@ -19,8 +19,23 @@
 #include <sys/socket.h>
 #include <arpa/inet.h>
 #include <netinet/ip.h>
+/* OHOS/musl: netinet/ip.h already provides IP_DF and a field-compatible
+   struct iphdr; guard out the kernel linux/ip.h (pulled via linux/if_tunnel.h)
+   to avoid redefinition of struct iphdr on the OHOS sysroot. */
+#define _UAPI_LINUX_IP_H 1
 #include <net/if.h>
+/* OHOS sysroot: UAPI linux/if.h -> linux/socket.h bare-defines struct
+   sockaddr_storage/sockaddr/sa_family_t again (its guard macro name varies
+   per SDK revision and cannot be relied on). Musl headers are already
+   included above; rename the kernel copies away while including, then
+   restore. Kernel-only sock_filter-style structs are unaffected. */
+#define sockaddr sockaddr_kernel_unused_ohos
+#define sockaddr_storage sockaddr_storage_kernel_unused_ohos
+#define sa_family_t sa_family_t_kernel_unused_ohos
 #include <linux/if_tunnel.h>
+#undef sockaddr
+#undef sockaddr_storage
+#undef sa_family_t
 
 #ifdef HAVE_CONFIG_H
 	#include <config.h>
