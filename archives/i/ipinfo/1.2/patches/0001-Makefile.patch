diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,47 +1,48 @@
 PROGRAMS = ipinfo ipmatch
 
-BINDIR = /usr/local/bin
-MANDIR = /usr/local/man/man1
+PREFIX ?= /usr/local
+BINDIR = $(PREFIX)/bin
+MANDIR = $(PREFIX)/man/man1
 
-MAKE = /usr/bin/make
-MKDIR = /bin/mkdir
-RM = /bin/rm
-CC = /usr/bin/gcc
-INSTALL = /usr/bin/install
-POD2MAN = /usr/bin/pod2man -c '' -r ''
+MAKE ?= make
+MKDIR ?= mkdir
+RM ?= rm
+CC ?= clang
+INSTALL ?= install
+POD2MAN ?= pod2man -c '' -r ''
 
-CFLAGS = 
+CFLAGS ?= -fPIC -O2
 LIBS = -lm
-DEFINES = 
+DEFINES =
 
 all: $(PROGRAMS)
 
 ipinfo:
 	$(CC) $(DEFINES) $(CFLAGS) ipinfo.c -o ipinfo $(LIBS)
 
 ipmatch:
 	$(CC) $(DEFINES) $(CFLAGS) ipmatch.c -o ipmatch $(LIBS)
 
 clean:
 	$(RM) -f $(PROGRAMS)
 
 install:
-	@test -d $(BINDIR) || $(MKDIR) -p $(BINDIR) || exit 1
-	@test -d $(MANDIR) || $(MKDIR) -p $(MANDIR) || exit 1
+	@test -d $(DESTDIR)$(BINDIR) || $(MKDIR) -p $(DESTDIR)$(BINDIR) || exit 1
+	@test -d $(DESTDIR)$(MANDIR) || $(MKDIR) -p $(DESTDIR)$(MANDIR) || exit 1
 	@for P in $(PROGRAMS); do \
 		if [ ! -s "$${P}" ]; then $(MAKE) $${P} || exit 1; fi; \
-		echo $(INSTALL) $${P} $(BINDIR); \
-		$(INSTALL) $${P} $(BINDIR) || exit 1; \
+		echo $(INSTALL) $${P} $(DESTDIR)$(BINDIR); \
+		$(INSTALL) $${P} $(DESTDIR)$(BINDIR) || exit 1; \
 		if [ ! -s "$${P}.1" ]; then echo "Manpage $${P}.1 does not exist"; exit 1; fi; \
-		echo $(INSTALL) $${P}.1 $(MANDIR); \
-		$(INSTALL) $${P}.1 $(MANDIR) || exit 1; \
+		echo $(INSTALL) $${P}.1 $(DESTDIR)$(MANDIR); \
+		$(INSTALL) $${P}.1 $(DESTDIR)$(MANDIR) || exit 1; \
 	done
 
 uninstall:
 	@for P in $(PROGRAMS); do \
 		echo $(RM) -f $(BINDIR)/$${P} $(MANDIR)/$${P}.1; \
 		test -f $(BINDIR)/$${P} && $(RM) -f $(BINDIR)/$${P}; \
 		test -f $(MANDIR)/$${P}.1 && $(RM) -f $(MANDIR)/$${P}.1; \
 	done
 
 man:
