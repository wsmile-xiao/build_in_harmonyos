--- a/contrib/mkpasswd/mkpasswd.c	2005-01-04 06:16:59.000000000 +0800
+++ b/contrib/mkpasswd/mkpasswd.c	2026-10-08 17:51:58.895254063 +0800
@@ -27,7 +27,30 @@
 #define FLAG_ROUNDS  0x00000040
 #define FLAG_EXT     0x00000080
 
+#ifdef __GLIBC__
 extern char *getpass(const char * prompt);
+#else
+/* musl（含 OHOS）不提供 getpass()：用 /dev/tty（回退 stdin）读取口令，行为等价 */
+static char *getpass(const char *prompt)
+{
+    static char buf[128];
+    FILE *in = fopen("/dev/tty", "r");
+
+    if (!in)
+        in = stdin;
+    if (prompt)
+        fprintf(stderr, "%s", prompt);
+    if (!fgets(buf, sizeof(buf), in)) {
+        if (in != stdin)
+            fclose(in);
+        return NULL;
+    }
+    if (in != stdin)
+        fclose(in);
+    buf[strcspn(buf, "\r\n")] = '\0';
+    return buf;
+}
+#endif
 extern char *crypt(const char *key, const char *salt);
 
 char *make_des_salt(void);
