--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -1,5 +1,18 @@
-if (NOT Boost_UNIT_TEST_FRAMEWORK_FOUND)
-    message("Boost Unit Test Framework not found. Not compiling tests")
+# Boost.Test header-only support (Boost >= 1.64): the unit_test_framework
+# compiled library is not required; the framework is self-contained when
+# BOOST_TEST_MODULE is defined in exactly one translation unit. The OHOS
+# recipe passes BOOST_INCLUDE_DIR; fall back to find_package / Boost_INCLUDE_DIR.
+if (NOT BOOST_INCLUDE_DIR)
+    if (Boost_INCLUDE_DIR)
+        set(BOOST_INCLUDE_DIR ${Boost_INCLUDE_DIR})
+    else ()
+        find_package(Boost 1.43 QUIET)
+        set(BOOST_INCLUDE_DIR ${Boost_INCLUDE_DIR})
+    endif ()
+endif ()
+
+if (NOT BOOST_INCLUDE_DIR)
+    message("Boost headers not found. Not compiling tests")
     return()
 endif ()
 
@@ -13,7 +26,7 @@
 
 configure_file(embedded_xml.h.in embedded_xml.h)
 
-include_directories(${CMAKE_SOURCE_DIR}/include ${CMAKE_BINARY_DIR}/include ${Boost_INCLUDE_DIR} ${CMAKE_CURRENT_BINARY_DIR})
+include_directories(${CMAKE_SOURCE_DIR}/include ${CMAKE_BINARY_DIR}/include ${BOOST_INCLUDE_DIR} ${CMAKE_CURRENT_BINARY_DIR})
 
 set(TEST_SOURCES
     test_main.cpp
