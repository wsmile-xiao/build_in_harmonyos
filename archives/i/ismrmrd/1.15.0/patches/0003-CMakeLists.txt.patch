--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -162,7 +162,12 @@
 endif()
 
 # Find Boost for tests and utilities
-find_package(Boost CONFIG COMPONENTS filesystem random program_options unit_test_framework)
+# OHOS: Boost.Random is header-only since 1.69 and the OHOS boost package
+# does not export a 'random' component; unit_test_framework is consumed in
+# header-only mode by tests/ (see patches/0001). Request only the
+# components the package actually provides, otherwise find_package()
+# fails as a whole and Boost_LIBRARIES stays empty.
+find_package(Boost CONFIG COMPONENTS filesystem program_options)
 find_package(pugixml CONFIG REQUIRED)
 find_package(FFTW COMPONENTS FLOAT_LIB)
 
@@ -242,10 +247,10 @@
   if (WIN32)
     set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
   endif()
-  set(ISMRMRD_PUGIXML_LIBRARIES pugixml::static)
+  set(ISMRMRD_PUGIXML_LIBRARIES pugixml::pugixml)
   add_library(ismrmrd STATIC ${ISMRMRD_TARGET_SOURCES})
 else()
-  set(ISMRMRD_PUGIXML_LIBRARIES pugixml::shared)
+  set(ISMRMRD_PUGIXML_LIBRARIES pugixml::pugixml)
   add_library(ismrmrd SHARED ${ISMRMRD_TARGET_SOURCES})
