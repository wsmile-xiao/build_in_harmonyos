Link the INDI client library explicitly in the indi-aok build script.

indi-aok/CMakeLists.txt requests only the "driver" and "lx200" components, so the
executable records libindidriver.so.2 and libindilx200.so.2 in DT_NEEDED while
the symbols those two import from libindiclient (e.g. tty_write_string) are
resolved at link time through the sibling shared objects and never recorded.
The musl loader then aborts the driver with:

  Error relocating .../libindilx200.so.2: tty_write_string: symbol not found

Asking for the "client" component (libindiclient) makes that dependency
explicit. Only the build script is touched; no compiled source is modified.

--- a/indi-aok/CMakeLists.txt
+++ b/indi-aok/CMakeLists.txt
@@ -5,7 +5,7 @@
 LIST(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/../cmake_modules/")
 include(GNUInstallDirs)
 
-find_package(INDI COMPONENTS driver lx200 REQUIRED)
+find_package(INDI COMPONENTS driver client lx200 REQUIRED)
 find_package(Nova REQUIRED)
 
 include_directories(${CMAKE_CURRENT_BINARY_DIR})
