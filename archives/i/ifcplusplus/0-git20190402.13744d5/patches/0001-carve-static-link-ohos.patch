--- a/external/Carve/CMakeLists.txt
+++ b/external/Carve/CMakeLists.txt
@@ -62,7 +62,10 @@
 )
 IF(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
 	ADD_DEFINITIONS(-DCMAKE_BUILD)
-    ADD_LIBRARY(carve SHARED ${CARVE_SOURCE_FILES})
+    # Upstream hardcodes SHARED for GNU/Clang. A shared carve forces the OHOS
+    # consumer to ship libcarve.so plus a runtime search path, which breaks the
+    # static, no-runtime-dependency delivery contract for this package.
+    ADD_LIBRARY(carve STATIC ${CARVE_SOURCE_FILES})
 ELSE(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
     ADD_LIBRARY(carve STATIC ${CARVE_SOURCE_FILES})
 ENDIF()
