 /* packet_loop:
  * Worker function for packet capture thread. */
 void packet_loop(void* ptr) {
+#ifdef __OHOS__
+    /* On OHOS/musl, pthread_cancel is not available. 
+     * We use pcap_breakloop to stop the loop when the main thread sets the flag. */
+    while (!thread_should_exit) {
+        pcap_loop(pd, 1, (pcap_handler)packet_handler, NULL);
+    }
+#else
     pcap_loop(pd,-1,(pcap_handler)packet_handler,NULL);
+#endif
 }
 
 
