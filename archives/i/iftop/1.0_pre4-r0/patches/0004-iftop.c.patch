+#ifdef __OHOS__
+    /* On OHOS/musl, pthread_cancel is not available.
+     * Set the flag and call pcap_breakloop to stop the packet_loop thread. */
+    thread_should_exit = 1;
+    pcap_breakloop(pd);
+    pthread_join(thread, NULL);
+#else
     pthread_cancel(thread);
+#endif
 
