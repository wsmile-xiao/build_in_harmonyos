 timestamp='2024-05-27'
+
+# Handle empty argument (configure bug workaround)
+# Workaround for configure passing empty $ac_build_alias
+if test $# -eq 0 || test -z "$1"; then
+    # Call config.guess to get the build type and exit
+    if test -f "${0%/*}/config.guess"; then
+        result="`"${0%/*}/config.guess"`"
+        # Validate the result using ourselves
+        exec "$0" "$result"
+    fi
+fi
 
