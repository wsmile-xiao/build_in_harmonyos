diff --git a/src/imagew-png.c b/src/imagew-png.c
--- a/src/imagew-png.c
+++ b/src/imagew-png.c
@@ -660,6 +660,8 @@
 	int no_cslabel;
 	int palette_is_gray;
 	int cmprlevel;
+	png_color_8 sbit_buf;
+	int have_sbit_shift = 0;
 	const char *optv;
 
 	iw_get_output_image(ctx,&pw->img);
@@ -774,11 +776,24 @@
 		sbit.gray  = iw_max_color_to_bitdepth(pw->img.maxcolorcode[IW_CHANNELTYPE_GRAY]);
 		sbit.alpha = iw_max_color_to_bitdepth(pw->img.maxcolorcode[IW_CHANNELTYPE_ALPHA]);
 		png_set_sBIT(pw->png_ptr,pw->info_ptr,&sbit);
-		png_set_shift(pw->png_ptr,&sbit);
+		/* Defer png_set_shift until after png_write_info.
+		 * libpng >= 1.6 (pngtrans.c) validates shift values against
+		 * png_ptr->bit_depth/color_type, which are still 0 before
+		 * png_write_info (png_set_IHDR only fills info_ptr), so the
+		 * pre-info call always fails with "invalid shift values".
+		 * The PNG_SHIFT transform still applies to png_write_image
+		 * rows when set after png_write_info (same as the existing
+		 * png_set_packing call below). */
+		sbit_buf = sbit;
+		have_sbit_shift = 1;
 	}
 
 	png_write_info(pw->png_ptr, pw->info_ptr);
 
+	if(have_sbit_shift) {
+		png_set_shift(pw->png_ptr,&sbit_buf);
+	}
+
 	pw->row_pointers = (iw_byte**)iw_malloc(ctx, pw->img.height * sizeof(iw_byte*));
 	if(!pw->row_pointers) goto done;
 
