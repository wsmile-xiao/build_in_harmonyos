--- a/meson.build
+++ b/meson.build
@@ -16,9 +16,11 @@
 glib_dep = dependency('glib-2.0')
 json_dep = dependency('json-glib-1.0')
 
-# Required programs
-asciidoctor = find_program('asciidoctor', required: true)
-po4a = find_program('po4a', required: true)
+# Man pages need asciidoctor and po4a; catalogs need msgfmt.
+# feature 'auto' skips a missing tool. 'enabled' still fails configure.
+asciidoctor = find_program('asciidoctor', required: get_option('man'))
+po4a = find_program('po4a', required: get_option('man'))
+msgfmt = find_program('msgfmt', required: get_option('nls'))
 
 # Definition of required constants
 add_project_arguments(
@@ -36,11 +38,13 @@
 # Tests
 subdir('tests')
 
-# Translations
-subdir('po')
-
-# Manpages
-subdir('man')
+# Translations and man pages are useful, not required to compile or test.
+if msgfmt.found()
+    subdir('po')
+endif
+if asciidoctor.found() and po4a.found()
+    subdir('man')
+endif
 
 # Install documentation
 docdir = get_option('datadir') / 'doc' / meson.project_name()
--- /dev/null
+++ b/meson_options.txt
@@ -0,0 +1,16 @@
+# SPDX-FileCopyrightText: 2026 Dr. Tobias Quathamer <toddy@debian.org>
+#
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+option(
+    'man',
+    type: 'feature',
+    value: 'auto',
+    description: 'Build man pages (needs asciidoctor and po4a)',
+)
+option(
+    'nls',
+    type: 'feature',
+    value: 'auto',
+    description: 'Build message catalogs (needs msgfmt)',
+)
