+static void *isoquery_libintl_handle(void)
+{
+    static void *handle;
+    static int tried;
+
+    if (tried) {
+        return handle;
+    }
+    tried = 1;
+#ifdef ISOQUERY_LIBINTL
+    handle = dlopen(ISOQUERY_LIBINTL, RTLD_LAZY | RTLD_GLOBAL);
+#endif
+    if (handle == NULL) {
+        handle = dlopen("libintl.so.8", RTLD_LAZY | RTLD_GLOBAL);
+    }
+    if (handle == NULL) {
+        handle = dlopen("libintl.so", RTLD_LAZY | RTLD_GLOBAL);
+    }
+    return handle;
+}
+
+static void isoquery_bind_domain(const char *domain, const char *localedir)
+{
+    void *handle = isoquery_libintl_handle();
+    char *(*bindfn)(const char *, const char *);
+    char *(*codesetfn)(const char *, const char *);
+
+    if (handle == NULL) {
+        return;
+    }
+    bindfn = dlsym(handle, "bindtextdomain");
+    codesetfn = dlsym(handle, "bind_textdomain_codeset");
+    if (bindfn != NULL) {
+        bindfn(domain, localedir);
+    }
+    if (codesetfn != NULL) {
+        codesetfn(domain, "UTF-8");
+    }
+}
+
+/* GNU gettext ignores LANGUAGE while the locale stays C or POSIX.
+   setlocale(LC_ALL, "") fails when LC_ALL names a locale the C library
+   does not ship (the upstream harness asks for en_GB.UTF-8). A UTF-8
+   locale is enough for LANGUAGE to select the catalog. */
+static void isoquery_setlocale_utf8(void)
+{
+    if (setlocale(LC_ALL, "") != NULL) {
+        return;
+    }
+    if (setlocale(LC_ALL, "C.UTF-8") != NULL) {
+        return;
+    }
+    setlocale(LC_ALL, "en_US.UTF-8");
+}
+
+static void isoquery_setup_i18n(void)
+{
+    const char *localedir = getenv("ISOQUERY_LOCALEDIR");
+    const char *iso_localedir = getenv("ISO_CODES_LOCALEDIR");
+    static const char *iso_domains[] = {
+        "iso_639-2", "iso_639-3", "iso_639-5",
+        "iso_3166-1", "iso_3166-2", "iso_3166-3",
+        "iso_4217", "iso_15924",
+        NULL
+    };
+    int i;
+
+    if (localedir == NULL || localedir[0] == '\0') {
+        localedir = "/usr/share/locale";
+    }
+    isoquery_bind_domain(GETTEXT_PACKAGE, localedir);
+    textdomain(GETTEXT_PACKAGE);
+    isoquery_setlocale_utf8();
+
+    if (iso_localedir == NULL || iso_localedir[0] == '\0') {
+#ifdef ISOQUERY_ISO_CODES_LOCALEDIR
+        iso_localedir = ISOQUERY_ISO_CODES_LOCALEDIR;
+#endif
+    }
+    if (iso_localedir != NULL && iso_localedir[0] != '\0') {
+        for (i = 0; iso_domains[i] != NULL; i++) {
+            isoquery_bind_domain(iso_domains[i], iso_localedir);
+        }
+    }
+}
