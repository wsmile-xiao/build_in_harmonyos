+static char *isoquery_dgettext(const char *domain, const char *msgid)
+{
+    void *handle = isoquery_libintl_handle();
+    char *(*fn)(const char *, const char *);
+
+    if (handle == NULL || msgid == NULL) {
+        return (char *)msgid;
+    }
+    fn = dlsym(handle, "dgettext");
+    if (fn == NULL) {
+        return (char *)msgid;
+    }
+    return fn(domain, msgid);
+}
