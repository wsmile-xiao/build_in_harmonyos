--- a/io_lib/thread_pool.c
+++ b/io_lib/thread_pool.c
@@ -481,8 +481,15 @@
 	w->idx = i;
 	w->wait_time = 0;
 	pthread_cond_init(&w->pending_c, NULL);
-	if (0 != pthread_create(&w->tid, NULL, t_pool_worker, w))
+	/* OHOS/musl: default thread stack is 128KB (glibc: 8MB); CRAM
+	 * workers recurse deeply and overflow -> SIGSEGV. Give each
+	 * worker an explicit 8MB stack. */
+	pthread_attr_t attr;
+	pthread_attr_init(&attr);
+	pthread_attr_setstacksize(&attr, 8 * 1024 * 1024);
+	if (0 != pthread_create(&w->tid, &attr, t_pool_worker, w))
 	    return NULL;
+	pthread_attr_destroy(&attr);
     }
 #else
     pthread_cond_init(&p->pending_c, NULL);
@@ -492,8 +499,13 @@
 	w->p = p;
 	w->idx = i;
 	pthread_cond_init(&w->pending_c, NULL);
-	if (0 != pthread_create(&w->tid, NULL, t_pool_worker, w))
+	/* OHOS/musl: 128KB default stack is too small for CRAM workers */
+	pthread_attr_t attr;
+	pthread_attr_init(&attr);
+	pthread_attr_setstacksize(&attr, 8 * 1024 * 1024);
+	if (0 != pthread_create(&w->tid, &attr, t_pool_worker, w))
 	    return NULL;
+	pthread_attr_destroy(&attr);
     }
 #endif
  
