--- a/tests/hextool
+++ b/tests/hextool
@@ -1,11 +1,24 @@
-#!/usr/bin/perl -s
+#!/usr/bin/env perl
+
+# OHOS portability: upstream shipped `#!/usr/bin/perl -s`, but OHOS has no
+# /usr/bin/perl (perl lives on PATH) and the kernel hands `perl -s` over as a
+# single env(1) argument, so the env-form shebang cannot carry `-s` either.
+# Reproduce the -s switch semantics in-script; `perl -s` invocations still work
+# because Perl removes parsed switches before @ARGV reaches this loop.
+my @_ohos_args = @ARGV;
+@ARGV = ();
+for my $arg (@_ohos_args) {
+    if ($arg =~ /^-([A-Za-z_][A-Za-z_0-9]*)=(.*)$/s) { no strict 'refs'; ${$1} = $2; }
+    elsif ($arg =~ /^-([A-Za-z_][A-Za-z_0-9]*)$/s) { no strict 'refs'; ${$1} = 1; }
+    else { push @ARGV, $arg; }
+}
 
 # This tool either emits hex in a machine or human parseable format, or
 # compares two binaries in the form of cmp. It is mostly to deal with
 # systems with an unreliable hexdump, that *lack* hexdump (or od), and/or
 # emit non-standard output. 
 
 # "use bytes"
 BEGIN { $^H |= 0x00000008 unless ($] < 5.006); }
 
 
