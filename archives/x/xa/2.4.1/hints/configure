#!/bin/sh
# Dummy configure script for xa (makefile project, no autotools)
# xa uses a plain Makefile without configure, no configuration needed.
# Build: make CC=clang LD=clang CFLAGS="-fPIC -O2 -g" LDFLAGS="-lc"
# Install: make install PREFIX=$DEFAULT_PREFIX DESTDIR=$TEST_PREFIX
echo "xa: makefile project, skipping configure"
exit 0
