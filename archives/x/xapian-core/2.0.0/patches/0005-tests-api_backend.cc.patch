--- a/tests/api_backend.cc
+++ b/tests/api_backend.cc
@@ -55,25 +55,37 @@
 using namespace std;
 
 /// Regression test - lockfile should honour umask, was only user-readable.
 DEFINE_TESTCASE(lockfileumask1, glass) {
 #if !defined __WIN32__ && !defined __CYGWIN__ && !defined __OS2__
     mode_t old_umask = umask(022);
     try {
 	Xapian::WritableDatabase db = get_named_writable_database("lockfileumask1");
 
 	string path = get_named_writable_database_path("lockfileumask1");
+	string probe_path = path;
 	path += "/flintlock";
+	probe_path += "/umaskprobe";
+
+	// Some filesystems (e.g. HarmonyOS HMDFS) mask permission bits that
+	// umask() would otherwise leave set, so compare the lock file against
+	// the mode the same directory actually yields for a 0666 file.
+	int fd = ::open(probe_path.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0666);
+	TEST(fd != -1);
+	TEST(::close(fd) == 0);
 
 	struct stat statbuf;
+	TEST(stat(probe_path.c_str(), &statbuf) == 0);
+	mode_t expected_mode = statbuf.st_mode & 0777;
+	TEST(::unlink(probe_path.c_str()) == 0);
 	TEST(stat(path.c_str(), &statbuf) == 0);
-	TEST_EQUAL(statbuf.st_mode & 0777, 0644);
+	TEST_EQUAL(statbuf.st_mode & 0777, expected_mode);
     } catch (...) {
 	umask(old_umask);
 	throw;
     }
 
     umask(old_umask);
 #endif
 }
 
