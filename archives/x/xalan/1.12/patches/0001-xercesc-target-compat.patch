--- a/cmake/XalanXerces.cmake
+++ b/cmake/XalanXerces.cmake
@@ -18,5 +18,15 @@
 # limitations under the License.
 
 # Determine if Xerces-C
 
-find_package(XercesC 3.1 REQUIRED)
+# ConanCenter's xerces-c exports capital-C XercesC::XercesC, but the
+# in-repo xerces-c/3.2.5 exports lowercase xerces-c::xerces-c. Try the
+# canonical name first, then fall back to the lowercase package and
+# alias it, so both sources resolve without touching platform code.
+find_package(XercesC 3.1 QUIET)
+if(NOT XercesC_FOUND)
+  find_package(xerces-c REQUIRED)
+  if(NOT TARGET XercesC::XercesC AND TARGET xerces-c::xerces-c)
+    add_library(XercesC::XercesC ALIAS xerces-c::xerces-c)
+  endif()
+endif()
