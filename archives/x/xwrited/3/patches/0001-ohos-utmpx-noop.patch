--- a/xwd-utmp-utmpx.c
+++ b/xwd-utmp-utmpx.c
@@ -29,9 +29,39 @@
 #include <utmpx.h>
 #include <errno.h>
 #include <sys/time.h>
 
+#ifdef OHOS_NO_UTMPX_DB
+/* OHOS (musl-based) ships <utmpx.h> struct definitions only: it declares
+ * no setutxent/pututxline/endutxent symbols and its struct utmpx has no
+ * ut_name member (E121; true-machine error "no member named 'ut_name' in
+ * 'struct utmpx'" plus implicit-declaration warnings for setutxent etc.).
+ * OHOS provides no utmp/utmpx login-accounting subsystem, so recording the
+ * pty entry is a deliberate no-op here. The notification path (pty read +
+ * GNotification) does not depend on it: upstream utmp_write_entry() itself
+ * returns void and only emits g_critical on failure.
+ */
+void
+xwd_utmp_add_entry(int fd)
+{
+	(void) fd;
+}
+
+void
+xwd_utmp_remove_entry(int fd)
+{
+	(void) fd;
+}
+#else
+
+/* musl (including the OHOS libc headers) names the user field ut_user;
+ * glibc provides ut_name only as a compat alias. Map it when missing so
+ * the same source builds on both. */
+#ifndef ut_name
+#define ut_name ut_user
+#endif
+
 #ifndef	DEV_PREFIX
 #define	DEV_PREFIX	"/dev/"
 #endif /* !DEV_PREFIX */
 
 static void
@@ -91,3 +121,5 @@
 {
 	utmp_write_entry(fd, FALSE);
 }
+
+#endif /* OHOS_NO_UTMPX_DB */
