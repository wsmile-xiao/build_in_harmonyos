-XDT_FEATURE_DEBUG([xdt_debug_default])
+AC_ARG_ENABLE([debug],
+              [AS_HELP_STRING([--enable-debug=@<:@no/minimum/yes/full@:>@],
+                              [Turn on debugging @<:@default=minimum@:>@])],
+              [enable_debug=$enableval], [enable_debug=minimum])
+if test x"$enable_debug" = x"full"; then
+  DEBUG_CFLAGS="-DG_ENABLE_DEBUG -DG_DEBUG_ENABLE"
