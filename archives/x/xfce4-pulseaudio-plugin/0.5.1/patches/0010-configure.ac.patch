+  DEBUG_CFLAGS="-DG_ENABLE_DEBUG"
+elif test x"$enable_debug" = x"minimum"; then
+  DEBUG_CFLAGS=""
+elif test x"$enable_debug" = x"no"; then
+  DEBUG_CFLAGS="-DG_DISABLE_ASSERT -DG_DISABLE_CAST_CHECKS"
+fi
+AC_SUBST([DEBUG_CFLAGS])
 
