+PKG_CHECK_MODULES([PULSEAUDIO], [libpulse-mainloop-glib >= 0.9.19])
+PKG_CHECK_MODULES([GLIB], [glib-2.0 >= 2.50.0])
+PKG_CHECK_MODULES([GIO], [gio-2.0 >= 2.50.0])
+PKG_CHECK_MODULES([GIO_UNIX], [gio-unix-2.0 >= 2.50.0])
+PKG_CHECK_MODULES([GTK], [gtk+-3.0 >= 3.22.0])
+PKG_CHECK_MODULES([EXO], [exo-2 >= 4.16.0])
+PKG_CHECK_MODULES([LIBXFCE4UTIL], [libxfce4util-1.0 >= 4.16.0])
+PKG_CHECK_MODULES([LIBXFCE4UI], [libxfce4ui-2 >= 4.16.0])
+PKG_CHECK_MODULES([LIBXFCE4PANEL], [libxfce4panel-2.0 >= 4.16.0])
+PKG_CHECK_MODULES([XFCONF], [libxfconf-0 >= 4.16.0])
+
+dnl Check for glib-compile-resources
+AC_MSG_CHECKING([for glib-compile-resources])
+GLIB_COMPILE_RESOURCES=""
+if test -n "$GIO_CFLAGS"; then
+  for gio_dir in `echo "$GIO_CFLAGS" | sed 's/-I//g'`; do
+    if test -x "$gio_dir/../bin/glib-compile-resources"; then
+      GLIB_COMPILE_RESOURCES="$gio_dir/../bin/glib-compile-resources"
+      break
+    fi
+  done
+fi
+if test -z "$GLIB_COMPILE_RESOURCES"; then
+  AC_PATH_PROG([GLIB_COMPILE_RESOURCES], [glib-compile-resources], [no])
+fi
+if test x"$GLIB_COMPILE_RESOURCES" = x"no"; then
+  AC_MSG_ERROR([glib-compile-resources not found])
+fi
+AC_MSG_RESULT([$GLIB_COMPILE_RESOURCES])
+AC_SUBST([GLIB_COMPILE_RESOURCES])
 
