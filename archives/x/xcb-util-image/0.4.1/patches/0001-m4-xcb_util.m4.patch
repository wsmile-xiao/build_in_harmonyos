diff -ruN a/m4/xcb_util.m4 b/m4/xcb_util.m4
--- a/m4/xcb_util.m4
+++ b/m4/xcb_util.m4
@@ -0,0 +1,28 @@
+# XCB_UTIL_COMMON - Common initialization for XCB utility libraries
+# Usage: XCB_UTIL_COMMON([min-xcb-version], [max-xcb-version])
+AC_DEFUN([XCB_UTIL_COMMON],
+[
+# Require libtool for building shared libraries
+LT_INIT
+
+# Check for xcb
+PKG_CHECK_MODULES(XCB, [xcb >= $1])
+
+# Define pkgconfig directory
+pkgconfigdir='${libdir}/pkgconfig'
+AC_SUBST([pkgconfigdir])
+
+# Define xcb include directory
+xcbincludedir='${includedir}/xcb'
+AC_SUBST([xcbincludedir])
+
+# Define CWARNFLAGS if not already set
+AC_ARG_VAR([CWARNFLAGS], [C compiler warning flags])
+if test -z "$CWARNFLAGS"; then
+    CWARNFLAGS="-Wall -pedantic -Wshadow -Wmissing-declarations"
+fi
+AC_SUBST([CWARNFLAGS])
+
+# Require a C compiler
+AC_PROG_CC
+])
