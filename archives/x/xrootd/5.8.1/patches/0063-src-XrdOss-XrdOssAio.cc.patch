 int sigwaitinfo(const sigset_t *set, siginfo_t *info)
 {
 // Now enable the signal handler by unblocking the signal. It will move the
 // siginfo into the waiting struct and we can return.
 //
    sigsuspend(set);
    return info->si_signo;
 }
