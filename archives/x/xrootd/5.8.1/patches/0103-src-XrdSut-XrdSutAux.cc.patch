+#ifdef __OHOS__
+namespace
+{
+// OHOS musl omits getpass(); implement the classic terminal variant
+// (prompt on /dev/tty, echo disabled) matching glibc's behaviour.
+char *OhosGetPass(const char *prompt)
+{
+   static char buf[128];
+   struct termios told, tnew;
+   bool restore = false;
+   FILE *in  = fopen("/dev/tty", "r+");
+   FILE *out = in;
+   if (!in) {in = stdin; out = stderr;}
+   fprintf(out, "%s", prompt);
+   fflush(out);
+   if (tcgetattr(fileno(in), &told) == 0)
+   {
+      tnew = told;
+      tnew.c_lflag &= static_cast<tcflag_t>(~(ECHO | ECHOE | ECHOK | ECHONL));
+      restore = tcsetattr(fileno(in), TCSAFLUSH, &tnew) == 0;
+   }
+   if (fgets(buf, static_cast<int>(sizeof(buf)), in))
+      {size_t n = strlen(buf);
+       while (n && (buf[n-1] == '\n' || buf[n-1] == '\r')) buf[--n] = '\0';
+      }
+   else buf[0] = '\0';
+   if (restore) tcsetattr(fileno(in), TCSAFLUSH, &told);
+   fprintf(out, "\n");
+   if (in != stdin) fclose(in);
+   return buf;
+}
+}
+#define getpass(p) OhosGetPass(p)
+#endif
