+/******************************************************************************/
+/*              O H O S   t h r e a d   c a n c e l l a t i o n               */
+/*                                                                            */
+/* OHOS musl omits pthread_cancel/pthread_setcancelstate/pthread_setcancel-   */
+/* type/pthread_testcancel. We reconstruct deferred cancellation with a       */
+/* dedicated signal: Cancel() sends the signal to the target thread via       */
+/* pthread_kill(); the handler exits the thread with pthread_exit(0) unless   */
+/* cancellation is currently disabled, in which case the request is recorded  */
+/* and acted upon when cancellation is re-enabled (SetCancelOn) or at the     */
+/* next cancellation point (CancelPoint) - the same deferred semantics glibc  */
+/* provides.                                                                  */
+/*                                                                            */
+/* Signal choice: realtime signals are never delivered through pthread_kill   */
+/* on this platform (verified: pthread_kill(tid, SIGRTMIN) returns 0 but the  */
+/* handler never runs), so we must use a regular signal. SIGUSR1 is already   */
+/* taken by xrootd's own code paths (XrdClLocalFileHandler AIO completion and */
+/* the XrdFfs fuse driver), while SIGUSR2 is only referenced by XrdOssAio's   */
+/* no-RT-signals fallback, which is compile-time inactive here because        */
+/* SIGRTMAX is defined and POSIX AIO is disabled altogether on OHOS.          */
+/******************************************************************************/
+
+#ifdef __OHOS__
+#include <cstring>
+#include <signal.h>
+namespace
+{
+// Per-thread cancellation state; threads are cancellable by default, which
+// matches the POSIX PTHREAD_CANCEL_ENABLE default.
+__thread int ohosNoCancel   = 0;
+__thread int ohosPending    = 0;
+
+void ohosThreadExitHandler(int)
+{
+   if (ohosNoCancel) {ohosPending = 1; return;}
+   pthread_exit(0);
+}
+
+int ohosInstallExitHandler()
+{
+   static int rc = -1;
+   static bool done = false;
+   if (!done)
+      {struct sigaction sa;
+       memset(&sa, 0, sizeof(sa));
+       sa.sa_handler = ohosThreadExitHandler;
+       sigemptyset(&sa.sa_mask);
+       sa.sa_flags = 0;   // no SA_RESTART: blocking syscalls must be interrupted
+       rc = sigaction(SIGUSR2, &sa, 0);
+       done = true;
+      }
+   return rc;
+}
+}
+
+int XrdSysThread::Cancel(pthread_t tid)
+{
+   if (ohosInstallExitHandler() != 0) return -1;
+   return pthread_kill(tid, SIGUSR2);
+}
+
+int XrdSysThread::Kill(pthread_t tid) {return Cancel(tid);}
+
+int XrdSysThread::SetCancelOff() {ohosNoCancel = 1; return 0;}
+
+int XrdSysThread::SetCancelOn()
+{
+   ohosNoCancel = 0;
+   if (ohosPending) pthread_exit(0);   // deferred request fires on re-enable
+   return 0;
+}
+
+int XrdSysThread::SetCancelAsynchronous() {return 0;}
+int XrdSysThread::SetCancelDeferred()     {return 0;}
+
+void XrdSysThread::CancelPoint()
+{
+   if (ohosPending && !ohosNoCancel) pthread_exit(0);
+}
+#endif
