 void XrdSysSemaphore::Post()
 {
 // Add one to the semaphore counter. If we the value is > 0 and there is a
 // thread waiting for the semaphore, signal it to get the semaphore.
 //
    semVar.Lock();
    semVal++;
    if (semVal && semWait) semVar.Signal();
    semVar.UnLock();
 }
 
