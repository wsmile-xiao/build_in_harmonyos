    strcat(buff, inst); strcat(buff, "/");
 
    if ((rc = XrdOucUtils::makePath(buff, lfm)))
       {eDest.Emsg("Config", rc, "create log file path", buff);
        return 0;
       }
 
    if (sp) {*sp = '/'; strcat(buff, sp+1);}
