       JobHelper h = pJobs.Get();
-      pthread_setcancelstate( PTHREAD_CANCEL_DISABLE, 0 );
+      XrdSysThread::SetCancelOff();
       h.job->Run( h.arg );
-      pthread_setcancelstate( PTHREAD_CANCEL_ENABLE, 0 );
+      XrdSysThread::SetCancelOn();
     }
   }
