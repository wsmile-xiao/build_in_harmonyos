--- /dev/null
+++ b/include/fsmap_compat.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * The HarmonyOS SDK's <linux/fsmap.h> omits the fsmap_sizeof() and
+ * fsmap_advance() inline helpers that the upstream Linux UAPI header
+ * provides.  The definitions below are copied from Linux
+ * include/uapi/linux/fsmap.h so that xfs_io, xfs_scrub, and xfs_spaceman
+ * build on this platform.
+ */
+#ifndef XFS_FSMAP_COMPAT_H
+#define XFS_FSMAP_COMPAT_H
+
+#include <linux/fsmap.h>
+
+/* Size of an fsmap_head with room for nr records. */
+static inline __kernel_size_t
+fsmap_sizeof(
+	unsigned int	nr)
+{
+	return sizeof(struct fsmap_head) + nr * sizeof(struct fsmap);
+}
+
+/* Start the next fsmap query at the end of the current query results. */
+static inline void
+fsmap_advance(
+	struct fsmap_head	*head)
+{
+	head->fmh_keys[0] = head->fmh_recs[head->fmh_entries - 1];
+}
+
+#endif /* XFS_FSMAP_COMPAT_H */
