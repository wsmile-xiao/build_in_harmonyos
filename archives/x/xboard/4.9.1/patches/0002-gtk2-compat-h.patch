--- /dev/null	2026-06-04 21:15:25.427636250 +0800
+++ /storage/Users/currentUser/tmp/builds/xboard-4.9.1.work/gtk/gtk2-compat.h	2026-06-05 17:11:57.143256719 +0800
@@ -0,0 +1,66 @@
+/* GTK2 to GTK3 compatibility header for xboard on OpenHarmony */
+#ifndef GTK2_COMPAT_H
+#define GTK2_COMPAT_H
+
+#include <gtk/gtk.h>
+
+/* Key symbol renames: GDK_* -> GDK_KEY_* */
+#define GDK_Return      GDK_KEY_Return
+#define GDK_Escape      GDK_KEY_Escape
+#define GDK_Tab         GDK_KEY_Tab
+#define GDK_Up          GDK_KEY_Up
+#define GDK_Down        GDK_KEY_Down
+#define GDK_Left        GDK_KEY_Left
+#define GDK_Right       GDK_KEY_Right
+#define GDK_Prior       GDK_KEY_Prior
+#define GDK_Next        GDK_KEY_Next
+#define GDK_Home        GDK_KEY_Home
+#define GDK_End         GDK_KEY_End
+#define GDK_BackSpace   GDK_KEY_BackSpace
+#define GDK_Delete      GDK_KEY_Delete
+#define GDK_Insert      GDK_KEY_Insert
+#define GDK_F1          GDK_KEY_F1
+#define GDK_F2          GDK_KEY_F2
+#define GDK_F3          GDK_KEY_F3
+#define GDK_F4          GDK_KEY_F4
+#define GDK_F5          GDK_KEY_F5
+#define GDK_F6          GDK_KEY_F6
+#define GDK_F7          GDK_KEY_F7
+#define GDK_F8          GDK_KEY_F8
+#define GDK_F9          GDK_KEY_F9
+#define GDK_F10         GDK_KEY_F10
+#define GDK_F11         GDK_KEY_F11
+#define GDK_F12         GDK_KEY_F12
+#define GDK_space        GDK_KEY_space
+#define GDK_KP_Enter    GDK_KEY_KP_Enter
+#define GDK_Shift_L     GDK_KEY_Shift_L
+#define GDK_Control_L   GDK_KEY_Control_L
+
+/* Widget macro renames */
+#define GTK_OBJECT(obj)             G_OBJECT(obj)
+#define GTK_SIGNAL_FUNC(func)       G_CALLBACK(func)
+#define gtk_signal_connect_object   g_signal_connect
+
+/* Menu functions */
+#define gtk_menu_append(menu, item) gtk_menu_shell_append(GTK_MENU_SHELL(menu), item)
+#define gtk_menu_bar_append(bar, item) gtk_menu_shell_append(GTK_MENU_SHELL(bar), item)
+#define gtk_menu_insert(menu, item, pos) gtk_menu_shell_insert(GTK_MENU_SHELL(menu), item, pos)
+#define gtk_menu_bar_insert(bar, item, pos) gtk_menu_shell_insert(GTK_MENU_SHELL(bar), item, pos)
+
+/* ComboBox text functions */
+#define gtk_combo_box_new_text() gtk_combo_box_text_new()
+#define gtk_combo_box_append_text(combo, text) gtk_combo_box_text_append(GTK_COMBO_BOX_TEXT(combo), NULL, text)
+
+/* GtkCheckMenuItem.active -> use gtk_check_menu_item_set_active() */
+/* GtkWidget.window -> gtk_widget_get_window() */
+
+/* Stock items */
+#define GTK_STOCK_CANCEL "_Cancel"
+#define GTK_STOCK_OK     "_OK"
+#define GTK_STOCK_OPEN   "_Open"
+#define GTK_STOCK_SAVE   "_Save"
+
+/* GTK_DIALOG_NO_SEPARATOR removed in GTK3 */
+#define GTK_DIALOG_NO_SEPARATOR 0
+
+#endif /* GTK2_COMPAT_H */
