+#ifdef __OHOS__
+	/* On OHOS, Int10 is a stub without BIOSseg/xf86int10Addr.
+	 * Skip Int10 BIOS reading, fall through to PCI ROM path. */
+#else
 	info->BIOSAddr = pInt10->BIOSseg << 4;
 	(void)memcpy(info->VBIOS, xf86int10Addr(pInt10, info->BIOSAddr),
 		     R128_VBIOS_SIZE);
+#endif
     } else {
 #ifdef XSERVER_LIBPCIACCESS
