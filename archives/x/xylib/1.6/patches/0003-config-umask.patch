diff -ruN a/configure b/configure
--- a/configure	2026-09-18 11:13:18.511221542 +0000
+++ b/configure	2026-09-18 11:13:18.550220597 +0000
@@ -18283,14 +18283,13 @@
   trap 'as_fn_exit 1' 1 2 13 15
 }
 # Create a (secure) tmp directory for tmp files.
-
-{
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
-  test -d "$tmp"
-}  ||
+# HMFS (OHOS /data storage) cannot be written into by a scratch directory
+# created with `mktemp -d` (toybox mktemp sets a mode the same process cannot
+# later write, e.g. drwxr-s--x; chmod is a no-op on HMFS).  Skip mktemp and use
+# Autoconf's plain mkdir fallback, which yields a writable directory.
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
