--- a/cdda_d/pthr.h
+++ b/cdda_d/pthr.h
@@ -21,20 +21,45 @@
 #ifndef __PTHR_H__
 #define __PTHR_H__
 
 #ifndef lint
 static char *_pthr_h_ident_ = "@(#)pthr.h	7.9 04/02/13";
 #endif
 
 #ifdef CDDA_PTHREADS
 
 #include <pthread.h>
+
+
+/*
+ * PTHR_SELF_ABORT(t)
+ *	Abort the calling thread after an unrecoverable synchronization
+ *	failure (state of the semaphore can no longer be trusted).
+ *
+ *	The default is pthread_cancel(), which is the historical behavior.
+ *	Some C libraries (e.g. musl-based ones) do not provide
+ *	pthread_cancel(); such builds can pass -DHAVE_PTHREAD_CANCEL=0 and
+ *	the thread is terminated with pthread_exit() instead, which is the
+ *	same observable effect for these error paths.
+ *
+ *	The statement shape is kept identical in both cases so call sites
+ *	need no restructuring.
+ */
+#ifndef HAVE_PTHREAD_CANCEL
+#define HAVE_PTHREAD_CANCEL	1
+#endif
+
+#if HAVE_PTHREAD_CANCEL
+#define PTHR_SELF_ABORT(t)	pthread_cancel(t)
+#else
+#define PTHR_SELF_ABORT(t)	(pthread_exit(NULL), 0)
+#endif
 
 
