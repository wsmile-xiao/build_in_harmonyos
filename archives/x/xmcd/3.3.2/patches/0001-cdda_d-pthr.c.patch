 			"pthread_cancel failed (ret=%d)\n", ret);
 	}
+#else
+	/* This C library provides no thread cancellation.  The only caller is
+	 * the heartbeat-timeout path in cdda_pthr_getstatus(), which follows
+	 * up with cdda_pthr_stop() to unblock and stop the reader/writer
+	 * pipeline, so a request to cancel a hung thread is logged and
+	 * otherwise treated as a no-op.
+	 */
+	(void) ret;
+	DBGPRN(DBG_GEN)(errfp, "cdda_pthr_kill: thread id=%d: "
+		"thread cancellation not supported by this system\n", (int) id);
