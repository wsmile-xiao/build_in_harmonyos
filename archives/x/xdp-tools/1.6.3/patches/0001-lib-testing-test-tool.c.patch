--- a/lib/testing/test-tool.c
+++ b/lib/testing/test-tool.c
@@ -1,10 +1,19 @@
+/* OHOS/musl: the libc <netinet/if_ether.h> (pulled in via xdpsock.h)
+ * defines struct ethhdr unconditionally, while the kernel UAPI
+ * <linux/if_ether.h> defines the same struct under __UAPI_DEF_ETHHDR.
+ * glibc's libc-compat sets that macro to 0 once the libc header is in use;
+ * musl does not, so apply the same guard here to keep one definition. */
+#ifndef __UAPI_DEF_ETHHDR
+#define __UAPI_DEF_ETHHDR 0
+#endif
+
