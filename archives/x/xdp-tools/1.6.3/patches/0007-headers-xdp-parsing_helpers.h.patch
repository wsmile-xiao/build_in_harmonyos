--- a/headers/xdp/parsing_helpers.h
+++ b/headers/xdp/parsing_helpers.h
@@ -19,20 +19,33 @@
 #include <linux/if_packet.h>
 #include <linux/ip.h>
 #include <linux/ipv6.h>
 #include <linux/icmp.h>
 #include <linux/icmpv6.h>
 #include <linux/udp.h>
 #include <linux/tcp.h>
 #include <linux/in.h>
 #include <bpf/bpf_endian.h>
 
+#ifdef HAVE_OHOS_BPF
+/* OHOS/bionic (musl) exposes the UAPI UDP header as struct __kernel_udphdr
+ * and keeps struct udphdr in the libc-only <netinet/udp.h>, which a bpf
+ * target cannot include. Restore the conventional UAPI name for the
+ * in-kernel parsing helpers. */
+struct udphdr {
+	__be16 source;
+	__be16 dest;
+	__be16 len;
+	__sum16 check;
+};
+#endif
+
 /* Header cursor to keep track of current parsing position */
 struct hdr_cursor {
 	void *pos;
 };
 
