--- a/sesman/tools/sesrun.c
+++ b/sesman/tools/sesrun.c
@@ -31,6 +31,46 @@
 #include <unistd.h>
 #include <limits.h>
 #include <ctype.h>
+
+#if defined(XRDP_LIBC_LACKS_GETPASS)
+/* Capability macro set by the recipe's own getpass(3) probe (see conanfile.py:
+ * _probe_libc_auth_apis): this libc cannot link getpass(3), so define the
+ * symbol here instead of overriding the libc name with a macro.
+ * sesrun is a client-side diagnostic tool, so a minimal termios-based read
+ * with echo disabled is enough for interactive use. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <termios.h>
+char *getpass(const char *prompt)
+{
+    static char buf[128];
+    struct termios term;
+    int echo_off = 0;
+    fputs(prompt, stderr);
+    fflush(stderr);
+    if (tcgetattr(fileno(stdin), &term) == 0)
+    {
+        term.c_lflag &= ~(ECHO);
+        if (tcsetattr(fileno(stdin), TCSAFLUSH, &term) == 0)
+        {
+            echo_off = 1;
+        }
+    }
+    if (fgets(buf, sizeof(buf), stdin) == NULL)
+    {
+        buf[0] = '\0';
+    }
+    if (echo_off)
+    {
+        term.c_lflag |= ECHO;
+        (void)tcsetattr(fileno(stdin), TCSAFLUSH, &term);
+        fputc('\n', stderr);
+    }
+    buf[strcspn(buf, "\r\n")] = '\0';
+    return buf;
+}
+#endif
 
 #include "parse.h"
 #include "trans.h"
