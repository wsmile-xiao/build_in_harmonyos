--- a/tests/setup-sourced
+++ b/tests/setup-sourced
@@ -11,16 +11,35 @@
 # Start a new authority file
 rm -f $XAUTHORITY ; touch $XAUTHORITY
 
+# OHOS 适配：本平台的文件系统（HMDFS）不支持硬链接，而 libXau 的
+# XauLockAuth() 加锁走的是
+#
+#     open("<auth>-c", O_CREAT|O_EXCL) + link("<auth>-c", "<auth>-l")
+#
+# 第二句在这里必然失败（errno 既不是 ENOENT 也不是 EEXIST），libXau 直接返回
+# LOCK_ERROR；由于 "<auth>-c" 已被上一次调用留下，之后每次调用都落在 EEXIST
+# 分支，睡满 10 次 2 秒重试后返回 LOCK_TIMEOUT。xauth 于是在写授权文件之前就
+# 退出（stderr 只有 "error/timeout in locking authority file ..."），随包夹具
+# 里的期望输出一条都产生不出来，5 个场景集体 FAIL。
+#
+# libXau 自带的「文件系统不支持硬链接」兜底分支（pathconf(_PC_LINK_MAX) == 1
+# 时改用 rename()）在此不触发：musl 的 pathconf 对 _PC_LINK_MAX 恒返回
+# _POSIX_LINK_MAX(8)，不是 1。
+#
+# xauth 对此提供了上游自己的逃生口（xauth(1)：-i = "ignore locks on authority
+# file"）。本测试是单进程顺序访问同一个 XAUTHORITY 文件，锁不参与任何被断言的
+# 语义——随包 .stdout/.stderr 夹具里没有任何锁相关文本。因此只在**真正执行**的
+# 那一句上加 -i；echo 出来的命令行保持原样，与夹具逐字节一致。
 xauth()
 {
   echo "> xauth" "$@"
-  ../xauth "$@"
+  ../xauth -i "$@"
   echo "  exits with $?"
 }
 
 xauth_silent()
 {
   echo "> xauth" "some silent commands which should not be logged..."
-  ../xauth "$@"
+  ../xauth -i "$@"
   echo "  exits with $?"
 }
