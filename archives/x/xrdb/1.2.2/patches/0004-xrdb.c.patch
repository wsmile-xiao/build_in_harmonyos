+#ifdef __OHOS__
+/* On OpenHarmony, libXmu only provides the minimal Xmuu subset.
+ * XmuGetHostname is from the full libXmu which depends on libXt.
+ * Provide a local implementation using gethostname(). */
+static int
+XmuGetHostname_OHOS(char *buf, int maxlen)
+{
+    buf[0] = '\0';
+    gethostname(buf, maxlen);
+    buf[maxlen - 1] = '\0';
+    return (int)strlen(buf);
+}
+#define XmuGetHostname(buf, maxlen) XmuGetHostname_OHOS(buf, maxlen)
