--- pristine/src/xlslib/common.h	2026-09-18 08:25:00.000000000 +0000
+++ modified/src/xlslib/common.h	2026-09-18 08:25:00.000000000 +0000
@@ -36,7 +36,22 @@
 
 /* part of fix for PR #3039001 */
 #ifndef __GLIBC__
+/* musl libc (used by OHOS) does not recognise the glibc-only name
+ * "UCS-2-INTERNAL": musl's iconv_open(=fuzzycmp) folds "UCS-2-INTERNAL"
+ * to "ucs2internal", which matches no codec (only ucs2/ucs2be/ucs2le), so
+ * iconv_open returns (iconv_t)-1 and the XL_ASSERT in wide2str16() throws,
+ * aborting unicode label writes.  Use the native-endian 16-bit musl codec
+ * that matches glibc's "UCS-2-INTERNAL" in-memory layout on this target
+ * (UCS-2LE on little-endian, UCS-2BE on big-endian). */
+#if defined(__linux__) || defined(__OHOS__)
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define UCS_2_INTERNAL "UCS-2BE"
+#else
+#define UCS_2_INTERNAL "UCS-2LE"
+#endif
+#else
 #define UCS_2_INTERNAL "UCS-2-INTERNAL"
+#endif
 #else
 #if (__GLIBC__ == 2 && __GLIBC_MINOR__ <= 1)
 #error "Too old glibc. This version's iconv() implementation cannot be trusted."
