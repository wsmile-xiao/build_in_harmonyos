--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,69 @@
+# CMakeLists.txt for XMill / xdemill
+#
+# Upstream (AT&T Labs XMill, mirror github.com/jungsagacity/xmill) ships ONLY a
+# Microsoft Visual Studio solution (xmill.sln + xmill/xmill.vcproj) and no
+# Makefile/CMake/configure script, so this file is added by the OHOS port to
+# provide a buildable, cross-compilable build system.
+#
+# Upstream builds *two* binaries out of the very same sources (documented in
+# Options.cpp:PrintUsage()):
+#   * xmill   - -DXMILL   : compressor   ( "xmill   [-i file] ... file ..." )
+#   * xdemill - -DXDEMILL : decompressor ( "xdemill [-i file] ... file ..." )
+#
+# zlib: the upstream tree carries a vendored zlib 1.1.3 copy and includes it
+# through "../zlib/zlib.h".  The port consumes the Conan package zlib/1.3.2
+# instead (see conanfile.py and patches 0002/0008), so the vendored copy is not built.
+
+cmake_minimum_required(VERSION 3.15)
+project(xmill LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_CXX_EXTENSIONS OFF)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+
+if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
+  set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
+endif()
+
+find_package(ZLIB REQUIRED)
+
+set(XMILL_SHARED_SOURCES
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/CompressMan.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/ContMan.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/Decode.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/DivCompress.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/EnumCompress.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/Error.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/FSM.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/Main.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/MemMan.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/MemStreamer.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/Options.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/OrCompress.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/Output.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/PathDict.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/PathTree.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/RepeatCompress.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/RunLenCompress.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/SAXClient.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/StdCompress.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/UnCompCont.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/VPathExprMan.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/VRegExpr.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/XMLOutput.cpp
+    ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src/ZLib.cpp
+)
+
+add_executable(xmill ${XMILL_SHARED_SOURCES})
+target_include_directories(xmill PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src)
+target_compile_definitions(xmill PRIVATE XMILL)
+target_link_libraries(xmill PRIVATE ZLIB::ZLIB)
+
+add_executable(xdemill ${XMILL_SHARED_SOURCES})
+target_include_directories(xdemill PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/xmill/src)
+target_compile_definitions(xdemill PRIVATE XDEMILL)
+target_link_libraries(xdemill PRIVATE ZLIB::ZLIB)
+
+include(GNUInstallDirs)
+install(TARGETS xmill xdemill RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
