--- a/src/blosc2/internal-complibs/zstd/common/zstd_deps.h
+++ b/src/blosc2/internal-complibs/zstd/common/zstd_deps.h
@@ -24,23 +24,25 @@
 #ifndef ZSTD_DEPS_COMMON
 #define ZSTD_DEPS_COMMON
 
 /* Even though we use qsort_r only for the dictionary builder, the macro
  * _GNU_SOURCE has to be declared *before* the inclusion of any standard
  * header and the script 'combine.sh' combines the whole zstd source code
  * in a single file.
  */
 #if defined(__linux) || defined(__linux__) || defined(linux) || defined(__gnu_linux__) || \
     defined(__CYGWIN__) || defined(__MSYS__)
-#if !defined(_GNU_SOURCE) && !defined(__ANDROID__) /* NDK doesn't ship qsort_r(). */
-#define _GNU_SOURCE
-#endif
+/* OHOS libc does not provide glibc-style qsort_r(); we use the portable
+ * qsort() + global-context fallback (g_coverCtx) in the dict builder,
+ * so do NOT force _GNU_SOURCE here. This matches the C90 fallback path
+ * already present in zstd's dictBuilder/cover.c and keeps zstd buildable
+ * on non-glibc Linux variants (musl / OHOS) without platform macros. */
 #endif
 
 #include <limits.h>
 #include <stddef.h>
 #include <string.h>
 
 #if defined(__GNUC__) && __GNUC__ >= 4
 # define ZSTD_memcpy(d,s,l) __builtin_memcpy((d),(s),(l))
 # define ZSTD_memmove(d,s,l) __builtin_memmove((d),(s),(l))
 # define ZSTD_memset(p,v,l) __builtin_memset((p),(v),(l))
