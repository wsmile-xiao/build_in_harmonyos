#lang zuo

;; Exercises fd file I/O and core primitives against the installed zuo
(define fd (fd-open-output "out.txt"))
(fd-write fd "written by zuo\n")
(fd-close fd)
(define in (fd-open-input "out.txt"))
(define s (fd-read in 100))
(fd-close in)
(unless (string=? s "written by zuo\n") (error "readback mismatch"))
(unless (= 3 (+ 1 2)) (error "arith mismatch"))
(displayln "filetest OK")
