-find_library(FOUND_JUDY HINTS /usr/include/ NAMES Judy libjudy-dev judy dev-libs/judy judy-devel)
+# Modified for OpenHarmony: add $HOME/usr/local paths
+set(USER_LOCAL_LIB "$ENV{HOME}/usr/local/lib")
+set(USER_LOCAL_INCLUDE "$ENV{HOME}/usr/local/include")
+set(USER_LOCAL_BIN "$ENV{HOME}/usr/local/bin")
+
+find_library(FOUND_JUDY HINTS ${USER_LOCAL_LIB} /usr/include/ NAMES Judy libjudy-dev judy dev-libs/judy judy-devel)
 if (NOT FOUND_JUDY)
     message(FATAL_ERROR "Missing dependency: did not find Judy library, please install Judy or equivalent. More details in INSTALL.md")
 endif()
 
