+# Thread cancellation is declared in <pthread.h> but NOT implemented by some
+# musl-based libcs (e.g. HarmonyOS OHOS). Detect it at configure time; the
+# kevent.c/kqueue.c calls are then gated on the same capability.
+include(CheckFunctionExists)
+check_function_exists(pthread_cancel HAVE_PTHREAD_CANCEL)
+
+if(NOT HAVE_PTHREAD_CANCEL)
+  list(APPEND LIBKQUEUE_COMPAT_SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/src/common/pthread_cancel_compat.c)
+  list(APPEND LIBKQUEUE_COMPAT_DEFINES HAVE_PTHREAD_CANCEL_COMPAT)
+endif()
 
