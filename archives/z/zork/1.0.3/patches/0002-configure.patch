diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Minimal configure wrapper for zork (plain Makefile project)
+# Accepts --prefix= argument but does nothing - all config is in Makefile
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*)
+            # PREFIX is set in Makefile, just acknowledge it
+            ;;
+        --help)
+            echo "Options: --prefix=DIR"
+            exit 0
+            ;;
+        *)
+            # Ignore unknown options
+            ;;
+    esac
+    shift
+done
+
+exit 0
