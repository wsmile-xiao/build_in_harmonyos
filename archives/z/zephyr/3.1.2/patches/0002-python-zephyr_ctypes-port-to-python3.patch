+def encoded(func):
+    """Encode ``str`` arguments to ``bytes`` for a ctypes function.
+
+    Under Python 3 ctypes refuses ``str`` for ``c_char_p`` parameters, while
+    the upstream (Python 2 era) code and its test suite pass text.  Only the
+    Python-side marshalling is adapted; the C ABI is unchanged.
+    """
+    def wrapper(*args, **kwargs):
+        args = tuple(a.encode("utf-8") if isinstance(a, str) else a
+                     for a in args)
+        return func(*args, **kwargs)
+    wrapper.__name__ = getattr(func, "__name__", "wrapper")
+    return wrapper
+
