+    #: probability/probe symbol used to tell whether the process already has
+    #: libzephyr mapped into its global symbol scope.
+    _PROBE_SYMBOL = "ZGetRealm"
+
+    def _load_library(self, library_path):
+        """Load libzephyr, falling back to the process' global symbol scope.
+
+        On the HarmonyOS PC build sandbox ``dlopen`` refuses shared objects
+        located in user directories (the failure is ``Error loading shared
+        library <path>: Permission denied``, independent of the ELF signature),
+        while loading at exec time through ``DT_NEEDED`` works.  The adapted
+        build therefore runs this suite from a launcher that links the freshly
+        built library, and this fallback picks its symbols up from the global
+        scope.  The probe symbol keeps the fallback honest: when the library is
+        not actually mapped, the original loader error is re-raised.
+        """
+        if os.environ.get("ZEPHYR_CTYPES_FORCE_GLOBAL") == "1":
+            return self._global_scope_library()
+        try:
+            return ctypes.cdll.LoadLibrary(library_path)
+        except OSError:
+            return self._global_scope_library()
+
+    def _global_scope_library(self):
+        global_lib = ctypes.CDLL(None)
+        if not hasattr(global_lib, self._PROBE_SYMBOL):
+            raise OSError(
+                "libzephyr is neither loadable by path nor mapped into the "
+                "global symbol scope (%s missing)" % self._PROBE_SYMBOL)
+        return global_lib
