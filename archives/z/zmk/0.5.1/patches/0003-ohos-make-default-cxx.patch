diff --git a/zmk/Toolchain.mk b/zmk/Toolchain.mk
--- a/zmk/Toolchain.mk
+++ b/zmk/Toolchain.mk
@@ -58,6 +58,15 @@
 # Should compiling produce dependency information for make?
 Toolchain.DependencyTracking ?= $(Configure.DependencyTracking)
 
+# The make package shipped with OpenHarmony has a build-machine path baked
+# into its built-in CXX value. Replace that unusable default with the
+# conventional c++ command name and remember that the value came from make's
+# built-in database so the cross-compiler logic below can still run.
+ifneq (,$(findstring /home/runner/work/ohos-make/,$(CXX)))
+ZMK.OHOS.MakeDefaultCXX = yes
+CXX := c++
+endif
+
 # Deduce the kind of the selected compiler. Some build rules or compiler
 # options depend on the compiler used. As an alternative we could look at
 # preprocessor macros but this way seems sufficient for now.
diff --git a/zmk/toolchain.GCC.mk b/zmk/toolchain.GCC.mk
--- a/zmk/toolchain.GCC.mk
+++ b/zmk/toolchain.GCC.mk
@@ -52,7 +52,7 @@
 ifneq (,$(and $(Configure.Configured),$(Configure.HostArchTriplet),$(Configure.BuildArchTriplet)))
 ifneq ($(Configure.BuildArchTriplet),$(Configure.HostArchTriplet))
-ifeq ($(origin CXX),default)
+ifneq (,$(or $(filter default,$(origin CXX)),$(ZMK.OHOS.MakeDefaultCXX)))
 CXX = $(Configure.HostArchTriplet)-g++
 $(if $(Toolchain.debug),$(info DEBUG: g++ cross-compiler selected CXX=$(CXX)))
 endif # !default CXX
 endif # !cross-compiling
