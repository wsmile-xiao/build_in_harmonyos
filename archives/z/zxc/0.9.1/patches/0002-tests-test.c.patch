+/* OHOS workaround: tmpfile() uses /tmp which is read-only.
+ * Use mkstemp in $TMPDIR instead, unlink for auto-cleanup like tmpfile(). */
+static FILE* zxc_tmpfile(void) {
+    const char* tmpdir = getenv("TMPDIR");
+    if (!tmpdir || !tmpdir[0]) tmpdir = "/storage/Users/currentUser/tmp";
+    char template[512];
+    snprintf(template, sizeof(template), "%s/zxc_test_XXXXXX", tmpdir);
+    int fd = mkstemp(template);
+    if (fd < 0) return NULL;
+    unlink(template);
+    return fdopen(fd, "w+b");
+}
