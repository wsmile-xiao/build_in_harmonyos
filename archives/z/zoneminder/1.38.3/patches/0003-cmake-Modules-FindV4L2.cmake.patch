     ${PC_V4L2_LIBV4L2_INCLUDEDIR}
     ${PC_V4L2_LIBV4L2_INCLUDE_DIRS})
 mark_as_advanced(V4L2_LIBV4L2_INCLUDE_DIR)
 
 find_library(V4L2_LIBV4L2_LIBRARY
   NAMES ${PC_V4L2_LIBV4L2_LIBRARIES}
