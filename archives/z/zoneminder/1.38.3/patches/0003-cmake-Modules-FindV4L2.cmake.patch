 mark_as_advanced(V4L2_VIDEODEV2_INCLUDE_DIR)
 
 if(EXISTS "${V4L2_VIDEODEV2_INCLUDE_DIR}")
   set(V4L2_videodev2_FOUND TRUE)
 else()
   set(V4L2_videodev2_FOUND FALSE)
 endif()
 
-pkg_check_modules(PC_V4L2_LIBV4L2 QUIET libv4l2)
