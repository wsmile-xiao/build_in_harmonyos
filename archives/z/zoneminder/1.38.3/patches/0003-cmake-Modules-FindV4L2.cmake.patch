+set(PC_V4L2_LIBV4L2_LIBRARIES "")
+set(PC_V4L2_LIBV4L2_LIBDIR "")
+set(PC_V4L2_LIBV4L2_LIBRARY_DIR "")
 
 find_path(V4L2_LIBV4L2_INCLUDE_DIR
   NAMES libv4l2.h
