+/* zsync_tmpfile() - Open a temporary file for intermediate data.
+ *
+ * The C library tmpfile() is tried first, but it is not sufficient on its own:
+ * it creates its file in a fixed directory (P_tmpdir, normally /tmp) and
+ * ignores TMPDIR, so it fails outright wherever /tmp is not writable. HarmonyOS
+ * ships a read-only /tmp, which makes zsyncmake abort as soon as it writes its
+ * first block checksum. Fall back to $TMPDIR, then /tmp, then the current
+ * directory; return NULL only when none of them work, so callers can report an
+ * error rather than dereferencing a NULL stream. */
+static FILE *zsync_tmpfile(void) {
+    const char *dirs[3];
+    FILE *f;
+    int i;
+
+    /* Fast path - let the C library choose its own location */
+    f = tmpfile();
+    if (f)
+        return f;
+
+    dirs[0] = getenv("TMPDIR");
+    dirs[1] = "/tmp";
+    dirs[2] = ".";
+
+    for (i = 0; i < 3; i++) {
+        char *name;
+        int fd;
+        size_t len;
+
+        if (!dirs[i] || !dirs[i][0])
+            continue;
+
+        len = strlen(dirs[i]) + sizeof("/zsync-XXXXXX");
+        name = malloc(len);
+        if (!name)
+            return NULL;
+        snprintf(name, len, "%s/zsync-XXXXXX", dirs[i]);
+
+        fd = mkstemp(name);
+        /* Unlink immediately - the caller only needs the stream, and this
+         * keeps the automatic cleanup that tmpfile() provides. */
+        if (fd != -1)
+            unlink(name);
+        free(name);
+
+        if (fd != -1) {
+            f = fdopen(fd, "w+b");
+            if (f)
+                return f;
+            close(fd);
+        }
+    }
+
+    return NULL;
+}
