--- a/src/debug.c
+++ b/src/debug.c
@@ -16,6 +16,20 @@
 
 #include "gssapi_ntlmssp.h"
 
+/* secure_getenv 不是 POSIX：OHOS/musl libc 既无头文件声明也无链接符号
+ * （2026-09-25 实测：stdlib.h 无声明；带 extern 声明链接报 undefined symbol），
+ * 直接调用在 -Werror-implicit-function-declaration 下编译必失败。
+ * glibc/bionic 用系统实现；其余平台用等价判据内联实现（真实 uid/gid ==
+ * effective uid/gid 才读环境变量，语义对齐 secure_getenv）。 */
+#if !defined(__GLIBC__) && !defined(__BIONIC__)
+static char *gssntlm_secure_getenv(const char *name)
+{
+    if (getuid() != geteuid() || getgid() != getegid()) return NULL;
+    return getenv(name);
+}
+#define secure_getenv gssntlm_secure_getenv
+#endif
+
 #define OPEN_FLAGS O_WRONLY | O_CREAT | O_APPEND| O_CLOEXEC
 #define discard_const(ptr) ((void *)((uintptr_t)(ptr)))
 
