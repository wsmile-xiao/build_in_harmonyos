{% set ndk = os.getenv("OHOS_NDK_HOME") %}
[settings]
os=OHOS
os.version=6.0
arch=armv8
compiler=clang
compiler.version=15
compiler.libcxx=c++_shared
build_type=Release

[conf]
tools.cmake.cmaketoolchain:user_toolchain=["{{ ndk }}/build/cmake/ohos.toolchain.cmake"]
tools.build:compiler_executables={"c": "{{ ndk }}/llvm/bin/aarch64-unknown-linux-ohos-clang", "cpp": "{{ ndk }}/llvm/bin/aarch64-unknown-linux-ohos-clang++"}

[buildenv]
CC={{ ndk }}/llvm/bin/aarch64-unknown-linux-ohos-clang
CXX={{ ndk }}/llvm/bin/aarch64-unknown-linux-ohos-clang++
