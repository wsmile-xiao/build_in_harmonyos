 static gboolean
 _init_session (GxrContext *context)
 {
   OpenXRContext *self = OPENXR_CONTEXT (context);
 
   GulkanClient *gc = gxr_context_get_gulkan (context);
   GulkanDevice *gd = gulkan_client_get_device (gc);
   GulkanQueue *queue = gulkan_device_get_graphics_queue (gd);
+
+  PFN_xrGetVulkanGraphicsDeviceKHR get_vulkan_graphics_device = NULL;
+  XrResult result = xrGetInstanceProcAddr (
+    self->instance, "xrGetVulkanGraphicsDeviceKHR",
+    (PFN_xrVoidFunction *) &get_vulkan_graphics_device);
+  if (!_check_xr_result (result,
+        "Failed to retrieve xrGetVulkanGraphicsDeviceKHR"))
+    return FALSE;
+
+  VkPhysicalDevice runtime_device = VK_NULL_HANDLE;
+  result = get_vulkan_graphics_device (
+    self->instance, self->system_id,
+    gulkan_client_get_instance_handle (gc), &runtime_device);
+  if (!_check_xr_result (result,
+        "Failed to get the runtime Vulkan physical device"))
+    return FALSE;
+
+  if (runtime_device != gulkan_device_get_physical_handle (gd))
+    {
+      g_printerr ("OpenXR runtime selected a different Vulkan device.\n");
+      return FALSE;
+    }
 
   uint32_t family_index = gulkan_queue_get_family_index (queue);
 
   self->graphics_binding = (XrGraphicsBindingVulkanKHR){
     .type = XR_TYPE_GRAPHICS_BINDING_VULKAN_KHR,
     .instance = gulkan_client_get_instance_handle (gc),
     .physicalDevice = gulkan_device_get_physical_handle (gd),
     .device = gulkan_device_get_handle (gd),
     .queueFamilyIndex = family_index,
     .queueIndex = 0,
@@ -1558,33 +1582,97 @@
