--- a/GSettings/CMakeLists.txt
+++ b/GSettings/CMakeLists.txt
@@ -1,14 +1,26 @@
-find_package(QmlPlugins REQUIRED)
-
 set(CHECK_DEFAULT_PATH "")
 if (EXISTS "/etc/debian_version")
     set(CHECK_DEFAULT_PATH "NO_DEFAULT_PATH")
 endif()
-find_program(QML_PLUGIN_DUMP qmlplugindump REQUIRED
+find_program(QML_PLUGIN_DUMP qmlplugindump
                  PATHS /usr/lib/qt${QT_VERSION_MAJOR}/bin
                  ${CHECK_DEFAULT_PATH}
 )
 
+# OHOS adaptation: the Qt5 stack ships no qmlplugindump host tool (the
+# qt5-qtdeclarative package delivers no bin/ directory), while cmake-extras'
+# QmlPluginsConfig.cmake raises FATAL_ERROR when neither the qmlplugindump
+# executable nor an existing "qmlplugindump" target can be located. Provide a
+# placeholder imported target so find_package(QmlPlugins) still succeeds, and
+# skip the optional plugins.qmltypes metadata generation below when the real
+# tool is unavailable (the QML plugin itself is built and installed normally).
+if (NOT QML_PLUGIN_DUMP AND NOT TARGET qmlplugindump)
+    add_executable(qmlplugindump IMPORTED GLOBAL)
+    set_target_properties(qmlplugindump PROPERTIES IMPORTED_LOCATION "${CMAKE_COMMAND}")
+endif()
+
+find_package(QmlPlugins REQUIRED)
+
 add_definitions(-DQT_NO_KEYWORDS)
 
 set(URI "GSettings")
@@ -40,7 +52,7 @@
               TARGETS GSettingsQmlPlugin
 )
 
-if(NOT CMAKE_CROSSCOMPILING)
+if(NOT CMAKE_CROSSCOMPILING AND QML_PLUGIN_DUMP)
     add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/plugins.qmltypes
         COMMAND ${QML_PLUGIN_DUMP} -noinstantiate -notrelocatable ${URI} ${API_VER} ../ > ${CMAKE_CURRENT_BINARY_DIR}/plugins.qmltypes
         DEPENDS GSettingsQmlPlugin
