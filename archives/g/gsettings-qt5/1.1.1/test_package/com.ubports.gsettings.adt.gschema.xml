<?xml version="1.0" encoding="UTF-8"?>
<!-- test_package 使用的 GSettings schema（仅在测试 schema 目录内生效） -->
<schemalist>
  <enum id="com.ubports.gsettings.adt.TestChoice">
    <value nick="low" value="0"/>
    <value nick="medium" value="1"/>
    <value nick="high" value="2"/>
  </enum>

  <schema id="com.ubports.gsettings.adt" path="/com/ubports/gsettings/adt/">
    <key name="test-string" type="s">
      <default>'default'</default>
      <summary>string test key</summary>
      <description>string test key</description>
    </key>
    <key name="test-integer" type="i">
      <default>42</default>
      <summary>integer test key</summary>
      <description>integer test key</description>
    </key>
    <key name="test-double" type="d">
      <default>1.5</default>
      <summary>double test key</summary>
      <description>double test key</description>
    </key>
    <key name="test-choice" enum="com.ubports.gsettings.adt.TestChoice">
      <default>'medium'</default>
      <summary>enum test key</summary>
      <description>enum test key</description>
    </key>
  </schema>
</schemalist>
