+static gboolean
+symlink_creation_is_supported (void)
+{
+  g_autoptr (GError) error = NULL;
+  g_autoptr (GFile) directory = NULL;
+  g_autoptr (GFile) link = NULL;
+  g_autofree gchar *directory_path = NULL;
+  gboolean capability_missing;
+
+  directory_path = g_dir_make_tmp ("gnome-autoar-symlink-XXXXXX", &error);
+  if (directory_path == NULL)
+    g_error ("Failed to create symlink probe directory: %s", error->message);
+
+  directory = g_file_new_for_path (directory_path);
+  link = g_file_get_child (directory, "probe");
+
+  if (!g_file_make_symbolic_link (link, "target", NULL, &error)) {
+    capability_missing =
+      g_error_matches (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED) ||
+      g_error_matches (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED);
+    g_file_delete (directory, NULL, NULL);
+    if (capability_missing)
+      return FALSE;
+    g_error ("Unexpected symlink probe failure: %s", error->message);
+  }
+
+  if (!g_file_delete (link, NULL, &error))
+    g_error ("Failed to remove symlink probe: %s", error->message);
+  if (!g_file_delete (directory, NULL, &error))
+    g_error ("Failed to remove symlink probe directory: %s", error->message);
+
+  return TRUE;
+}
+
 /* Be sure that symlink itself is replaced, not its target. */
 static void
 test_conflict_overwrite_symlink (void)
 {
+  if (!symlink_creation_is_supported ()) {
+    g_test_skip ("The current sandbox does not permit symbolic links");
+    return;
+  }
+
