diff --git a/test/test.cpp b/test/test.cpp
index 2906e0a..1afa48f 100644
--- a/test/test.cpp
+++ b/test/test.cpp
@@ -173,13 +173,17 @@ static void testFeature(bool use_convert) {
 
     const auto &nested = f.properties.at("nested");
 
-    // Explicit recursive_wrapper as a workaround for https://github.com/mapbox/variant/issues/102
-    assert(nested.is<mapbox::util::recursive_wrapper<values>>());
-    assert(nested.get<values>().at(0).is<std::uint64_t>());
-    assert(nested.get<values>().at(0).get<std::uint64_t>() == 5);
-    assert(nested.get<values>().at(1).is<mapbox::util::recursive_wrapper<prop_map>>());
-    assert(nested.get<values>().at(1).get<prop_map>().at("foo").is<std::string>());
-    assert(nested.get<values>().at(1).get<prop_map>().at("foo").get<std::string>() == "bar");
+    // mapbox-geometry 2.x stores arrays/objects as shared_ptr (feature.hpp
+    // value::const_array_ptr_type / const_object_ptr_type). Use the accessors
+    // instead of the old recursive_wrapper<values> variant types.
+    assert(nested.getArray() != nullptr);
+    const auto &nestedArray = *nested.getArray();
+    assert(nestedArray.at(0).is<std::uint64_t>());
+    assert(nestedArray.at(0).get<std::uint64_t>() == 5);
+    assert(nestedArray.at(1).getObject() != nullptr);
+    const auto &nestedObj = *nestedArray.at(1).getObject();
+    assert(nestedObj.at("foo").is<std::string>());
+    assert(nestedObj.at("foo").get<std::string>() == "bar");
 
     assert(parse(writeGeoJSON(data, use_convert)) == data);
 }
