{
  "name": "gcc-11-cross",
  "description": "GNU GCC 11.5.0 C cross-compiler for arm-none-eabi bare-metal targets on HarmonyOS PC",
  "homepage": "https://gcc.gnu.org/",
  "type": "tool",
  "versions": {
    "26": {
      "ref": "gcc-11-cross/26",
      "binary": true,
      "commands": [
        {
          "name": "arm-none-eabi-gcc",
          "version_arg": "--version"
        },
        {
          "name": "arm-none-eabi-gcc-11.5.0",
          "version_arg": "--version"
        },
        {
          "name": "arm-none-eabi-cpp",
          "version_arg": "--version"
        },
        {
          "name": "arm-none-eabi-gcc-ar",
          "version_arg": "--version"
        },
        {
          "name": "arm-none-eabi-gcc-nm",
          "version_arg": "--version"
        },
        {
          "name": "arm-none-eabi-gcc-ranlib",
          "version_arg": "--version"
        }
      ]
    }
  }
}
