# Target board: arm-none-eabi cross compiler on a HarmonyOS/aarch64 host.
#
# The host cannot execute ARM32 objects: the aarch64 kernel provides no AArch32
# compatibility layer (measured: "not executable: 32-bit ELF file" for both
# armv4t and armv7 builds) and no ARM emulator is installed.  The generic unix
# loader is therefore wrapped to report "unsupported" for execution, which
# DejaGNU records as UNSUPPORTED — the same outcome upstream reports for tests
# whose target cannot run them.  Compilation and linking still execute and are
# checked normally against the packaged newlib.
load_base_board_description "unix"
set_board_info noexec 1
set_board_info is_simulator 0

if {[catch {
    if {[info procs _orig_unix_load] eq ""} {
        rename unix_load _orig_unix_load
        proc unix_load { dest prog args } {
            return [list "unsupported" ""]
        }
        puts "OHOS-BOARD: execution declared unsupported (no AArch32 compat layer)"
    }
} err]} {
    puts "OHOS-BOARD: unix_load wrap failed: $err"
}
