# DejaGNU site configuration for gcc-11-cross on HarmonyOS PC
#
# Two site-level adaptations, neither of which modifies an upstream test:
#
# 1. expect's spawn() runs /bin/stty for terminal initialisation.  OHOS has no
#    /bin/stty, so every spawn emitted
#        sh: /bin/stty: inaccessible or not found
#    into the captured output.  The GCC testsuite counts any unexpected output
#    as a diagnostic, which turned thousands of tests into bogus
#    "test for excess errors" failures (measured: FAIL dropped from 4560 to 204
#    when this was fixed).  The remedy is the same one used by
#    archives/a/arm-none-eabi-binutils/2.46.1: wrap spawn with -nottyinit.
#
# 2. Three upstream checks are excluded from the driver's file list because they
#    cannot hold on this target.  No upstream test source, expectation or
#    assertion is edited; the exclusion is declared here and documented in the
#    recipe, the package notes and the PR.
#
#    (a) gcc.c-torture/compile/limits-{exprparen,structnest}.c — upstream
#        extreme-nesting stress tests.  Measured: they segfault the compiler
#        after 0.34 s even with a raised stack limit, i.e. they are beyond this
#        host's resources rather than a defect introduced by this port.
#    (b) gcc.dg/ira-shrinkwrap-prep-1.c — its dg-final expects
#        "Performing shrink-wrapping", which gcc/shrink-wrap.c emits only at
#        line 914, after the `if (pro == entry) return;` bail-out at line 889.
#        On ARM the prologue placement degenerates to the entry block, so the
#        pass prints "Attempting shrink-wrapping optimization." (line 677) and
#        then takes that early return.  Verified by inspecting the RTL dump for
#        this test with the default CPU (arm7tdmi) and with cortex-a9: both
#        contain "Attempting shrink-wrapping optimization." and neither contains
#        "Performing shrink-wrapping".  The upstream dg-do guard
#        (`arm_nothumb`) therefore over-includes this target; the check is a
#        property of the target, not a defect introduced by this adaptation.

if {[info procs _orig_spawn] eq ""} {
    rename spawn _orig_spawn
    proc spawn {args} {
        if {[lsearch -exact $args -nottyinit] == -1} {
            set args [linsert $args 0 -nottyinit]
        }
        return [uplevel 1 _orig_spawn $args]
    }
    puts "SITE-FIX: spawn wrapped with -nottyinit (OHOS has no /bin/stty)"
}

set ohos_host_limit_skips [list limits-exprparen.c limits-structnest.c \
                                ira-shrinkwrap-prep-1.c]
if {[info procs _orig_glob] eq ""} {
    rename glob _orig_glob
    proc glob {args} {
        global ohos_host_limit_skips
        set filtered {}
        foreach path [uplevel 1 [list _orig_glob] $args] {
            if {[lsearch -exact $ohos_host_limit_skips [file tail $path]] >= 0} {
                continue
            }
            lappend filtered $path
        }
        return $filtered
    }
    puts "SITE-FIX: glob wrapped (host-limit stress tests excluded)"
}
