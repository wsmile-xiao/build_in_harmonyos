--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,16 +1,25 @@
-cmake_minimum_required(VERSION 2.8.12)
+cmake_minimum_required(VERSION 3.10)
 project(gason)
 
 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -std=c++11 -fno-rtti -fno-exceptions")
 if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -stdlib=libc++")
 endif()
 
 add_compile_options(-Wall -Wextra)
 
 add_library(gason STATIC src/gason.cpp)
 link_libraries(gason)
 add_executable(test-suite src/test-suite.cpp)
 add_executable(gasonpp src/pretty-print.cpp)
-add_executable(benchmark src/benchmark.cpp)
-target_include_directories(benchmark PRIVATE rapidjson/include)
+
+# benchmark needs the rapidjson submodule, which is not part of the
+# release tarball — build it only when explicitly requested.
+option(BUILD_GASON_BENCHMARK "Build the benchmark (requires rapidjson submodule)" OFF)
+if(BUILD_GASON_BENCHMARK)
+    add_executable(benchmark src/benchmark.cpp)
+    target_include_directories(benchmark PRIVATE rapidjson/include)
+endif()
+
+install(TARGETS gason ARCHIVE DESTINATION lib)
+install(FILES src/gason.h DESTINATION include)
