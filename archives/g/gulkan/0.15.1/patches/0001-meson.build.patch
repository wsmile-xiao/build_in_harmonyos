--- a/meson.build
+++ b/meson.build
@@ -65,15 +65,26 @@
 json_glib_dep = dependency('json-glib-1.0', required : false)
 
 subdir('src')
-subdir('shaders')
-subdir('res')
+
+# OHOS adaptation: tests/ is built unconditionally — test_instance/device/
+# client need only gulkan_deps + gulkan_lib (no gresources/shaders), so they
+# compile and run without a GPU/ICD (vkCreateInstance needs only the loader,
+# which OHOS provides at /system/lib64/libvulkan.so). shaders/ and res/ stay
+# guarded behind build_tests (default false): they need glslangValidator /
+# glib-compile-resources at build time — not permitted for downloaded conan
+# packages on HarmonyOS PC — and the texture/renderer tests they feed cannot
+# run headless on CI anyway (see tests/meson.build).
+subdir('tests')
+
+if get_option('build_tests')
+  subdir('shaders')
+  subdir('res')
+endif
 
 if glfw_dep.found()
   subdir('examples')
 endif
 
-subdir('tests')
-
 if get_option('api_doc')
     subdir('doc')
 endif
