--- a/giscanner/meson.build
+++ b/giscanner/meson.build
@@ -103,19 +103,27 @@
   python_ext_dep = python.dependency()
 else
   python_ext_dep = python.dependency().partial_dependency(compile_args: true)
 endif
 
 if not python_ext_dep.found()
   # For example if Python is 32bit but we require a 64bit variant
   error('Python installation not useable')
 endif
 
+# On HarmonyOS, Python extension modules cannot be loaded due to hmmac security
+# labels (E212). Additionally, _giscanner is only needed when generating
+# introspection data (build_introspection_data=true). Skip building it when
+# that feature is disabled to avoid linking shared module against static deps.
+if get_option('build_introspection_data')
 giscanner_pymod = python.extension_module('_giscanner', ['giscannermodule.c'],
   link_with: giscanner_lib,
   c_args: gi_hidden_visibility_cflags + custom_c_args,
   include_directories : configinc,
   dependencies: [glib_dep, gobject_dep, gio_dep, gmodule_dep,
                  python_ext_dep],
   install: true,
   install_dir: giscannerdir,
 )
+else
+giscanner_pymod = disabler()
+endif
