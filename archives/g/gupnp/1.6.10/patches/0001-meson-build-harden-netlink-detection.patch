--- a/meson.build
+++ b/meson.build
@@ -13,7 +13,17 @@
 prefix = get_option('prefix')
 bindir = join_paths(prefix, get_option('bindir'))
 
-netlink_available = cc.has_header('linux/rtnetlink.h')
+# The netlink context manager source includes <sys/socket.h> and
+# <linux/netlink.h> in the same translation unit. On musl-based sysroots
+# (e.g. OHOS/HarmonyOS) the two headers conflict (struct sockaddr_storage is
+# defined in both), so a standalone has_header() probe is a false positive
+# and the netlink backend would fail to compile. Probe the headers the way
+# the source actually uses them instead; when they are not usable together
+# the build falls back to the generic unix context manager (ifaddrs based),
+# which is the same selection path used on other non-netlink platforms.
+netlink_available = cc.has_header('linux/rtnetlink.h') and cc.compiles(
+    '#include <sys/socket.h>\n#include <linux/netlink.h>\n#include <linux/rtnetlink.h>\nint main(void) { return 0; }\n',
+    name: 'netlink headers usable together with sys/socket.h')
 ifaddrs_available = cc.has_header('ifaddrs.h')
 
 ifa_flags_exists = cc.compiles('''#include <linux/if_addr.h>
