   ifneq (,$(findstring static,$(MAKECMDGOALS)))
     LDFLAGS += -static-libstdc++ -static-libgcc
   endif
   CXXFLAGS := -O3 -DNDEBUG $(CXXFLAGS)
 else #debug builds
   ifneq (,$(filter %profile %gprof %prof, $(MAKECMDGOALS)))
     CXXFLAGS += -pg -O0 -DNDEBUG
     LDFLAGS += -pg
   else
     #CXXFLAGS += -g -O0 -DNDEBUG
