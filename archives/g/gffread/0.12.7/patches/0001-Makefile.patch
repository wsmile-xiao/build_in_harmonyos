diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,35 +1,35 @@
 GCLDIR := $(if $(GCLDIR),$(GCLDIR),./gclib)
 
 SEARCHDIRS := -I. -I${GCLDIR}
 
