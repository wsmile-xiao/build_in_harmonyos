diff -ruN a/libguile/_scm.h b/libguile/_scm.h
--- a/libguile/_scm.h
+++ b/libguile/_scm.h
@@ -61,8 +61,28 @@
 #ifdef HAVE_STRUCT_TIMESPEC
 #undef HAVE_STRUCT_TIMESPEC
 #endif
 
 #include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef HAVE_CANONICALIZE_FILE_NAME
+#ifndef PATH_MAX
+#define PATH_MAX 4096
+#endif
+
+static inline char *
+scm_i_canonicalize_file_name (const char *path)
+{
+  char resolved[PATH_MAX];
+  if (realpath (path, resolved) == NULL)
+    return NULL;
+  return strdup (resolved);
+}
+#define canonicalize_file_name scm_i_canonicalize_file_name
+#endif
+
 #include <verify.h>
 #include <alignof.h>
