diff -ruN a/intl/config.intl b/intl/config.intl
--- a/intl/config.intl
+++ b/intl/config.intl
@@ -0,0 +1,12 @@
+# This file records the configuration of libintl in a form that
+# can be read back in by a configure script in a sister directory.
+# See config/gettext.m4 for its use.
+
+USE_NLS='no'
+LIBINTL=''
+LIBINTL_DEP=''
+INCINTL=''
+
+XGETTEXT='/storage/Users/currentUser/usr/local/bin/xgettext'
+GMSGFMT='/storage/Users/currentUser/usr/local/bin/msgfmt'
+POSUB=''
