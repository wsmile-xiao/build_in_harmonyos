 static void
+test_fallback_e2big (void)
+{
+  const gchar *in_utf8 = "\xc2\xbd";
+  g_autofree gchar *fallback = g_strnfill (4096, 'a');
+  g_autofree gchar *out = NULL;
+  gsize bytes_read = 0;
+  gsize bytes_written = 0;
+  GError *error = NULL;
+
+  out = g_convert_with_fallback (in_utf8, -1,
+                                 "ISO8859-15", "UTF-8",
+                                 fallback,
+                                 &bytes_read, &bytes_written,
+                                 &error);
+
+  g_assert_no_error (error);
+  g_assert_cmpuint (bytes_read, ==, 2);
+  g_assert_cmpuint (bytes_written, ==, 4096);
+  g_assert_cmpmem (out, bytes_written, fallback, 4096);
+  g_assert_cmpint (out[bytes_written], ==, '\0');
+}
+
