+static gboolean
+localtime_try_symlink (LocaltimeFixture *fixture,
+                       const char       *target,
+                       const char       *linkpath)
+{
+  int ret = symlink (target, linkpath);
+
+  if (ret == 0)
+    return TRUE;
+
+  {
+    int errsv = errno;
+
+    if (errsv == EACCES || errsv == EPERM || errsv == EROFS ||
+        errsv == ENOSYS || errsv == ENOTSUP || errsv == EOPNOTSUPP)
+      {
+        fixture->symlink_errno = errsv;
+        return FALSE;
+      }
+
+    errno = errsv;
+    g_assert_no_errno (ret);
+  }
+
+  return FALSE;
+}
 #endif
 
