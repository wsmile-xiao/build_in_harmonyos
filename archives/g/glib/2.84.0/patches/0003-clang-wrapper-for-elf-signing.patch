--- /dev/null
+++ b/scripts/clang-wrapper
@@ -0,0 +1,48 @@
+#!/usr/bin/env zsh
+# clang wrapper: 编译后自动签名，链接时使用 GNU ld
+
+GNU_LD="/data/service/hnp/binutils.org/binutils_2.45/bin/ld"
+SKILL_ROOT="/storage/Users/currentUser/.opendesk/apps/skills/resources/openharmony-compile-agent"
+
+# 检测 -Wl,--version 参数（meson 链接器检测）
+for arg in "$@"; do
+  if [[ "$arg" == "-Wl,--version" ]]; then
+    $GNU_LD --version
+    exit 0
+  fi
+done
+
+# 处理参数
+args=()
+has_compile_only=false
+output_next=false
+output_file=""
+
+for arg in "$@"; do
+  if [[ "$arg" == "-c" ]]; then
+    has_compile_only=true
+  fi
+  if [[ "$arg" != "-fuse-ld"* ]]; then
+    args+=("$arg")
+  fi
+  if $output_next; then
+    output_file="$arg"
+    output_next=false
+  fi
+  if [[ "$arg" == "-o" ]]; then
+    output_next=true
+  fi
+done
+
+# 只有在链接时才添加 -fuse-ld=bfd
+if ! $has_compile_only; then
+  args+=("-fuse-ld=bfd")
+fi
+
+# 调用 clang
+clang "${args[@]}"
+ret=$?
+
+# 签名
+if ! $has_compile_only && [[ -n "$output_file" ]] && [[ -f "$output_file" ]]; then
+  python3 "$SKILL_ROOT/scripts/ohc-run.py" sign-elf "$output_file" 2>/dev/null || true
+fi
+
+exit $ret
