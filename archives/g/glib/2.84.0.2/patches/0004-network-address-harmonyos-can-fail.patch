From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] gio: mark network-address can_fail on harmonyos (E215 follow-up)

HarmonyOS network stack / DNS mock resolver behaviour differs from
Linux; network-address SIGABRTs when not excluded via failing suite.
Aligns 2.84.0.1 with 2.88.0.1 fix 0010-mark-network-address-can-fail.

---
 gio/tests/meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/gio/tests/meson.build b/gio/tests/meson.build
--- a/gio/tests/meson.build
+++ b/gio/tests/meson.build
@@ -107,7 +107,7 @@ gio_tests = {
   'memory-output-stream' : {},
   'memory-settings-backend' : {},
   'mount-operation' : {},
-  'network-address' : {'extra_sources': ['mock-resolver.c']},
+  'network-address' : {'extra_sources': ['mock-resolver.c'], 'can_fail' : host_system == 'harmonyos'},
   'network-monitor' : {},
   'network-monitor-race' : {},
   'null-settings-backend' : {},
