+static void
+assert_date_format_one_of (gint         year,
+                           gint         month,
+                           gint         day,
+                           const gchar *format,
+                           const gchar *expected_a,
+                           const gchar *expected_b)
+{
+  GDateTime *date_time = g_date_time_new_utc (year, month, day, 0, 0, 0);
+  gchar *actual = g_date_time_format (date_time, format);
+  gchar *actual_casefold = g_utf8_casefold (actual, -1);
+  gchar *expected_a_casefold = g_utf8_casefold (expected_a, -1);
+  gchar *expected_b_casefold = g_utf8_casefold (expected_b, -1);
+
+  g_test_message ("%s -> expected one of: %s || %s", format, expected_a, expected_b);
+  g_test_message ("%s -> actual:          %s", format, actual);
+  g_assert_true (g_str_equal (actual_casefold, expected_a_casefold) ||
+                 g_str_equal (actual_casefold, expected_b_casefold));
+
+  g_free (expected_b_casefold);
+  g_free (expected_a_casefold);
+  g_free (actual_casefold);
+  g_free (actual);
+  g_date_time_unref (date_time);
+}
