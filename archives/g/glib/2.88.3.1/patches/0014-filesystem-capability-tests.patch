+static gboolean
+filesystem_supports_symbolic_links (void)
+{
+  gchar *tmpdir_path = NULL;
+  GFile *tmpdir = NULL;
+  GFile *link = NULL;
+  GError *local_error = NULL;
+  gboolean supported;
+
+  tmpdir_path = g_dir_make_tmp ("g_file_symlink_capability_XXXXXX", &local_error);
+  g_assert_no_error (local_error);
+  tmpdir = g_file_new_for_path (tmpdir_path);
+  link = g_file_get_child (tmpdir, "link");
+
+  supported = g_file_make_symbolic_link (link, "target", NULL, &local_error);
+  if (!supported)
+    {
+      g_assert_true (g_error_matches (local_error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED) ||
+                     g_error_matches (local_error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED));
+      g_assert_cmpint (g_file_query_file_type (link, G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS, NULL),
+                       ==, G_FILE_TYPE_UNKNOWN);
+      g_test_message ("symbolic-link capability rejected the operation: %s", local_error->message);
+      g_clear_error (&local_error);
+    }
+  else
+    {
+      g_assert_cmpint (g_file_query_file_type (link, G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS, NULL),
+                       ==, G_FILE_TYPE_SYMBOLIC_LINK);
+      g_file_delete (link, NULL, &local_error);
+      g_assert_no_error (local_error);
+    }
+
+  g_file_delete (tmpdir, NULL, &local_error);
+  g_assert_no_error (local_error);
+  g_clear_object (&link);
+  g_clear_object (&tmpdir);
+  g_free (tmpdir_path);
+
+  return supported;
+}
