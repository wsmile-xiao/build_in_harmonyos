 static void
+find_known_read_only_filesystem (GFile **read_only_file)
+{
+  GList *mounts;
+  GList *iter;
+
+  g_assert_nonnull (read_only_file);
+  g_assert_null (*read_only_file);
+
+  mounts = g_unix_mounts_get (NULL);
+  for (iter = mounts; iter != NULL; iter = iter->next)
+    {
+      GUnixMountEntry *mount = iter->data;
+      GFile *candidate;
+      GFileInfo *candidate_info;
+      GError *candidate_error = NULL;
+
+      if (!g_unix_mount_is_readonly (mount))
+        continue;
+
+      candidate = g_file_new_for_path (g_unix_mount_get_mount_path (mount));
+      candidate_info = g_file_query_filesystem_info (candidate,
+                                                     G_FILE_ATTRIBUTE_FILESYSTEM_READONLY,
+                                                     NULL, &candidate_error);
+      if (candidate_info != NULL &&
+          g_file_info_get_attribute_boolean (candidate_info,
+                                             G_FILE_ATTRIBUTE_FILESYSTEM_READONLY))
+        *read_only_file = g_steal_pointer (&candidate);
+
+      g_clear_error (&candidate_error);
+      g_clear_object (&candidate_info);
+      g_clear_object (&candidate);
+
+      if (*read_only_file != NULL)
+        break;
+    }
+
+  g_list_free_full (mounts, (GDestroyNotify) g_unix_mount_free);
+}
+
+static void
+test_known_readonly_and_writable_filesystems (gconstpointer with_mount_monitor)
+{
+  GFile *read_only_file = NULL;
+  GFile *writable_file = NULL;
+  GFileInfo *file_info = NULL;
+  GUnixMountMonitor *mount_monitor = NULL;
+  GError *error = NULL;
+  gchar *read_only_path = NULL;
+
+  if (with_mount_monitor)
+    mount_monitor = g_unix_mount_monitor_get ();
+
+  writable_file = g_file_new_for_path (g_get_tmp_dir ());
+  file_info = g_file_query_filesystem_info (writable_file,
+                                            G_FILE_ATTRIBUTE_FILESYSTEM_READONLY,
+                                            NULL, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (file_info);
+  g_assert_false (g_file_info_get_attribute_boolean (file_info,
+                                                      G_FILE_ATTRIBUTE_FILESYSTEM_READONLY));
+  g_clear_object (&file_info);
+
+  find_known_read_only_filesystem (&read_only_file);
+  if (read_only_file == NULL)
+    {
+      g_test_skip ("no verifiable read-only filesystem mount is available");
+      goto out;
+    }
+
+  file_info = g_file_query_filesystem_info (read_only_file,
+                                            G_FILE_ATTRIBUTE_FILESYSTEM_READONLY,
+                                            NULL, &error);
+  g_assert_no_error (error);
+  g_assert_nonnull (file_info);
+  g_assert_true (g_file_info_get_attribute_boolean (file_info,
+                                                     G_FILE_ATTRIBUTE_FILESYSTEM_READONLY));
+  read_only_path = g_file_get_path (read_only_file);
+  g_test_message ("validated %s as read-only and the task temporary filesystem as writable",
+                  read_only_path);
+
+ out:
+  g_free (read_only_path);
+  g_clear_object (&file_info);
+  g_clear_object (&writable_file);
+  g_clear_object (&read_only_file);
+  g_clear_object (&mount_monitor);
+}
