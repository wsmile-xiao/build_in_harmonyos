+                            G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS,
+                            NULL, &error);
+  if (info != NULL && error == NULL &&
+      g_file_info_has_attribute (info, G_FILE_ATTRIBUTE_UNIX_MODE))
+    supported = (g_file_info_get_attribute_uint32 (info,
+                                                    G_FILE_ATTRIBUTE_UNIX_MODE) & 0777) == expected_mode;
+
+out:
+  if (error != NULL && !file_mode_error_is_capability (error))
+    g_assert_no_error (error);
+  g_clear_error (&error);
+  g_clear_object (&info);
+  g_clear_object (&stream);
+  g_clear_object (&file);
+  if (path != NULL)
+    g_remove (path);
+  if (tmpdir_path != NULL)
+    g_rmdir (tmpdir_path);
+  g_free (path);
+  g_free (tmpdir_path);
+  return supported;
+#else
+  return TRUE;
+#endif
