+/* Two blocking pipes can deadlock GDBus authentication when both workers
+ * share one thread. A socket pair keeps both directions schedulable. */
+static gboolean
+test_socket_pair (GInputStream  **left_in,
+                  GOutputStream **left_out,
+                  GInputStream  **right_in,
+                  GOutputStream **right_out,
+                  GError        **error)
+{
+#ifdef G_OS_UNIX
+  gint fds[2] = { -1, -1 };
+  gint left_out_fd = -1;
+  gint right_out_fd = -1;
+
+  if (socketpair (AF_UNIX, SOCK_STREAM, 0, fds) != 0)
+    {
+      gint saved_errno = errno;
+
+      g_set_error (error, G_IO_ERROR, g_io_error_from_errno (saved_errno),
+                   "socketpair: %s", g_strerror (saved_errno));
+      return FALSE;
+    }
+
+  left_out_fd = dup (fds[0]);
+  right_out_fd = dup (fds[1]);
+  if (left_out_fd < 0 || right_out_fd < 0)
+    {
+      gint saved_errno = errno;
+
+      if (left_out_fd >= 0)
+        close (left_out_fd);
+      if (right_out_fd >= 0)
+        close (right_out_fd);
+      close (fds[0]);
+      close (fds[1]);
+      g_set_error (error, G_IO_ERROR, g_io_error_from_errno (saved_errno),
+                   "dup: %s", g_strerror (saved_errno));
+      return FALSE;
+    }
+
+  *left_in = g_unix_input_stream_new (fds[0], TRUE);
+  *left_out = g_unix_output_stream_new (left_out_fd, TRUE);
+  *right_in = g_unix_input_stream_new (fds[1], TRUE);
+  *right_out = g_unix_output_stream_new (right_out_fd, TRUE);
+  return TRUE;
+#else
+  return test_pipe (left_in, left_out, error) &&
+         test_pipe (right_in, right_out, error);
+#endif
+}
