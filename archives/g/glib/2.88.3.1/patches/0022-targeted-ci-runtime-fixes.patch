+static void
+remove_test_directory_contents (const gchar *path)
+{
+  GDir *dir;
+  GError *error = NULL;
+  const gchar *name;
+
+  dir = g_dir_open (path, 0, &error);
+  if (dir == NULL)
+    {
+      if (g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+        {
+          g_clear_error (&error);
+          return;
+        }
+
+      g_assert_no_error (error);
+      return;
+    }
+
+  while ((name = g_dir_read_name (dir)) != NULL)
+    {
+      gchar *child = g_build_filename (path, name, NULL);
+      gboolean is_directory = FALSE;
+
+#ifdef G_OS_UNIX
+      {
+        GStatBuf statbuf;
+
+        if (g_lstat (child, &statbuf) == 0)
+          is_directory = S_ISDIR (statbuf.st_mode);
+        else if (errno != ENOENT)
+          g_assert_no_errno (-1);
+      }
+#else
+      is_directory = g_file_test (child, G_FILE_TEST_IS_DIR);
+#endif
+
+      if (is_directory)
+        {
+          g_chmod (child, 0777);
+          remove_test_directory_contents (child);
+          if (g_rmdir (child) != 0 && errno != ENOENT)
+            g_assert_no_errno (-1);
+        }
+      else
+        {
+          g_chmod (child, 0777);
+          if (g_remove (child) != 0 && errno != ENOENT)
+            g_assert_no_errno (-1);
+        }
+
+      g_free (child);
+    }
+
+  g_dir_close (dir);
