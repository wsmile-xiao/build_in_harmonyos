+ * POSIX permission bits. */
+static gboolean
+replace_preserves_posix_mode (void)
+{
+#ifdef __linux__
+  gchar *tmpdir_path = NULL;
+  gchar *path = NULL;
+  GFile *file = NULL;
+  GFileOutputStream *stream = NULL;
+  GFileInfo *info = NULL;
+  GError *error = NULL;
+  gboolean supported = FALSE;
+  guint32 expected_mode = 0644;
+
+  tmpdir_path = g_dir_make_tmp ("g-file-replace-mode-XXXXXX", &error);
+  if (tmpdir_path == NULL)
+    goto out;
+
+  path = g_build_filename (tmpdir_path, "source", NULL);
+  if (!g_file_set_contents (path, "old", 3, &error))
+    goto out;
+  if (g_chmod (path, expected_mode) != 0)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED) &&
+          errno != EACCES && errno != EPERM && errno != EROFS &&
+          errno != ENOTSUP && errno != EOPNOTSUPP)
+        g_assert_no_errno (-1);
+      goto out;
+    }
+
+  file = g_file_new_for_path (path);
+  stream = g_file_replace (file, NULL, FALSE, G_FILE_CREATE_NONE,
+                           NULL, &error);
+  if (stream == NULL)
+    goto out;
+  if (!g_output_stream_write_all (G_OUTPUT_STREAM (stream), "new", 3,
+                                  NULL, NULL, &error))
+    goto out;
+  if (!g_output_stream_close (G_OUTPUT_STREAM (stream), NULL, &error))
+    goto out;
+  g_clear_object (&stream);
