+/* Some target filesystems accept chmod() but expose a policy-projected mode
+ * on stat().  The set-contents-full test verifies exact permission bits, so
+ * run it only when this contract is observable on the actual filesystem. */
+static gboolean
+filesystem_preserves_requested_mode (void)
+{
+#ifdef G_OS_UNIX
+  gchar *path = NULL;
+  GError *error = NULL;
+  GStatBuf statbuf;
+  gint fd;
+  gboolean supported = FALSE;
+  gint saved_errno;
+
+  fd = g_file_open_tmp ("glib-fileutils-mode-probeXXXXXX", &path, &error);
+  if (fd < 0)
+    {
+      if (error != NULL &&
+          (g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_ACCES) ||
+           g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_ROFS) ||
+           g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOSPC)))
+        goto out;
+
+      g_assert_no_error (error);
+      goto out;
+    }
+
+  g_assert_no_errno (close (fd));
+  if (g_chmod (path, 0666) != 0)
+    {
+      saved_errno = errno;
+      if (saved_errno != EACCES && saved_errno != EPERM &&
+          saved_errno != EROFS && saved_errno != ENOTSUP &&
+          saved_errno != EOPNOTSUPP)
+        g_assert_no_errno (-1);
+      goto out;
+    }
+
+  g_assert_no_errno (g_lstat (path, &statbuf));
+  supported = (statbuf.st_mode & 0777) == 0666;
+
+out:
+  if (path != NULL)
+    g_remove (path);
+  g_clear_error (&error);
+  g_free (path);
+  return supported;
+#else
+  return TRUE;
+#endif
+}
