+static void
+remove_test_directory (const gchar *path)
+{
+  const gint64 deadline = g_get_monotonic_time () + 2 * G_TIME_SPAN_SECOND;
+
+  while (TRUE)
+    {
+      gint saved_errno;
+
+      remove_test_directory_contents (path);
+      if (g_rmdir (path) == 0 || errno == ENOENT)
+        return;
+
+      saved_errno = errno;
+      if (saved_errno != ENOTEMPTY && saved_errno != EEXIST)
+        g_assert_no_errno (-1);
+
+      if (g_get_monotonic_time () >= deadline)
+        {
+          errno = saved_errno;
+          g_assert_no_errno (-1);
+        }
+
+      while (g_main_context_pending (NULL))
+        g_main_context_iteration (NULL, FALSE);
+      g_usleep (1000);
+    }
