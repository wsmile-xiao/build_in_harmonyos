 # FreeBSD includes a malloc.h which always throws compilation error, so we have
 # to use check_header() rather than has_header().
 if cc.check_header('malloc.h')
   glib_conf.set('HAVE_MALLOC_H', 1)
   glib_conf_prefix = glib_conf_prefix + '#define HAVE_MALLOC_H 1\n'
 endif
 
-if (glib_conf.has('HAVE_LINUX_NETLINK_H') or
+unix_domain_peer_address_code = '''
+  #include <string.h>
+  #include <sys/socket.h>
+  #include <sys/un.h>
+  int main (void)
+  {
+    struct sockaddr_storage storage;
+    struct sockaddr_un address;
+    socklen_t address_len = sizeof (storage);
+
+    memset (&storage, 0, sizeof (storage));
+    memset (&address, 0, sizeof (address));
+    return getpeername (-1, (struct sockaddr *) &storage, &address_len) == 0 ||
+           address.sun_path[0] != '\\0';
+  }
+'''
+have_unix_domain_peer_address = cc.links(
+  unix_domain_peer_address_code,
+  name : 'UNIX-domain peer address support',
+)
+glib_conf.set('HAVE_UNIX_DOMAIN_PEER_ADDRESS', have_unix_domain_peer_address)
+
+netlink_headers_found = (glib_conf.has('HAVE_LINUX_NETLINK_H') or
     (glib_conf.has('HAVE_NETLINK_NETLINK_H') and glib_conf.has('HAVE_NETLINK_NETLINK_ROUTE_H')))
+netlink_monitor = get_option('netlink_monitor')
+if netlink_monitor.enabled() and not netlink_headers_found
+  error('netlink monitor requested but the required headers are unavailable')
+endif
+if not netlink_monitor.disabled() and netlink_headers_found
   glib_conf.set('HAVE_NETLINK', 1)
 endif
 
