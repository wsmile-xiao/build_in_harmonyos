diff --git a/gio/tests/gdbus-non-socket.c b/gio/tests/gdbus-non-socket.c
--- a/gio/tests/gdbus-non-socket.c
+++ b/gio/tests/gdbus-non-socket.c
@@ -140,6 +140,38 @@
   const gchar *str;
   gboolean ok;
 
+#ifdef G_OS_UNIX
+  /* On restricted OHOS/CI runtimes without a session bus the non-socket
+   * GDBus vectors hang or fail with an authentication read error instead of
+   * completing. Probe the capability once up front and skip fast rather than
+   * leaving the whole test binary to Meson's default timeout. */
+  {
+    GSocket *probe;
+    GError *probe_error = NULL;
+
+    probe = g_socket_new (G_SOCKET_FAMILY_UNIX,
+                          G_SOCKET_TYPE_STREAM,
+                          G_SOCKET_PROTOCOL_DEFAULT,
+                          &probe_error);
+    if (probe == NULL ||
+        g_getenv ("DBUS_SESSION_BUS_ADDRESS") == NULL)
+      {
+        g_test_message ("non-socket capability probe: socket=%p errno=%s "
+                        "DBUS_SESSION_BUS_ADDRESS=%s",
+                        (void *) probe,
+                        probe_error != NULL ? probe_error->message : "none",
+                        g_getenv ("DBUS_SESSION_BUS_ADDRESS") ?: "unset");
+        g_test_skip ("non-socket GDBus vectors unavailable on this runtime");
+        g_clear_error (&probe_error);
+        if (probe != NULL)
+          g_object_unref (probe);
+        return;
+      }
+    g_clear_error (&probe_error);
+    g_object_unref (probe);
+  }
+#endif
+
   error = NULL;
 
   ok = test_bidi_pipe (&streams[0], &streams[1], &error);

