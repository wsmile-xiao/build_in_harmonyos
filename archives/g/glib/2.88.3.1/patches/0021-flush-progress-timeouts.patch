@@ -297,8 +310,18 @@ test_flush_busy (Fixture       *f,
   G_UNLOCK (write);
 
   /* wait for the flush to happen */
-  while (!f->flushed)
-    g_main_context_iteration (NULL, TRUE);
+  deadline = g_get_monotonic_time () + FLUSH_PROGRESS_TIMEOUT_USEC;
