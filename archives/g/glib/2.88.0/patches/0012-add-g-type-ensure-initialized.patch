From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Add public g_type_ensure_initialized API

Add a public, idempotent, thread-safe entry point that explicitly
initializes the GObject type system via gobject_init(). On platforms
that do not run ELF .init_array constructors (e.g. HarmonyOS), this
allows applications to initialize the type system before first use.

---
 gobject/gtype.c | 37 +++++++++++++++++++++++++++++++++++++
 gobject/gtype.h |  2 ++
 2 files changed, 39 insertions(+)
--- a/gobject/gtype.c
+++ b/gobject/gtype.c
@@ -4346,6 +4346,43 @@
   _g_signal_init ();
 }
 
+/**
+ * g_type_ensure_initialized:
+ *
+ * Ensures that the GObject type system is initialized, running the
+ * type system initializer if it has not run yet.
+ *
+ * The type system is normally initialized automatically through the
+ * library constructor on platforms that support ELF `.init_array`
+ * sections.  On platforms where that automatic initialization does
+ * not happen (such as HarmonyOS), applications can invoke this
+ * function explicitly before first use of the type system.
+ *
+ * This function is idempotent and thread-safe: it may be called any
+ * number of times, from any thread, and the type system initializer
+ * runs at most once per process.
+ *
+ * Since: 2.88
+ */
+void
+g_type_ensure_initialized (void)
+{
+  static gsize type_system_initialized = 0;
+
+  if (g_once_init_enter (&type_system_initialized))
+    {
+      /* The library constructor (gobject_init_ctor) may already have
+       * initialized the type system on platforms that run .init_array
+       * sections; in that case gobject_init() has nothing left to do
+       * and must not run again (idempotency).
+       */
+      if (static_quark_type_flags == 0)
+        gobject_init ();
+
+      g_once_init_leave (&type_system_initialized, TRUE);
+    }
+}
+
 #ifdef G_PLATFORM_WIN32
 
 void gobject_win32_init (void);
--- a/gobject/gtype.h
+++ b/gobject/gtype.h
@@ -739,6 +739,8 @@
 void                  g_type_init_with_debug_flags   (GTypeDebugFlags  debug_flags);
 G_GNUC_END_IGNORE_DEPRECATIONS
 
+GOBJECT_AVAILABLE_IN_2_88
+void                  g_type_ensure_initialized      (void);
 GOBJECT_AVAILABLE_IN_ALL
 const gchar *         g_type_name                    (GType            type);
 GOBJECT_AVAILABLE_IN_ALL
