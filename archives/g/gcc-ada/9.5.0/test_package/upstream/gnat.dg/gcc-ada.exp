# DejaGNU driver for the packaged GNAT compiler.
# The executable tests are run separately by verify_upstream_ada.py; this
# harness proves that the published DejaGNU/Expect chain can drive GNATmake.

if {![info exists ::env(GNATMAKE)]} {
    error "GNATMAKE was not supplied by the gcc-ada test package"
}

set tests {
    modular2
    fixedpnt
    concat_length
    array31
    overflow_sum3
    access_test
    aggr1
    array10
    alignment2
    abstract_with_anonymous_result
    array3
    array4
    array6
    array12
    array21
    array30
    array33
    array34
    array_bounds_test
    access4
    access_discr2
    aggr3
    alignment1
    alignment7
    alignment8
    alignment9
    alignment10
    modular1
    modular3
    fixedpnt5
}

# Keep DejaGNU artifacts in the same tree consumed by verify_upstream_ada.py.
set build_root [file join [pwd] "upstream" "gnat.dg"]
file mkdir $build_root

foreach test_name $tests {
    set source [file join $srcdir "${test_name}.adb"]
    set output_dir [file join $build_root $test_name]
    set output [file join $output_dir $test_name]
    file mkdir $output_dir
    set command [list $::env(GNATMAKE) -q -D $output_dir $source -o $output]

    if {[catch {exec {*}$command 2>@1} details]} {
        fail "gcc-ada/$test_name"
        puts $details
    } else {
        pass "gcc-ada/$test_name"
    }
}
