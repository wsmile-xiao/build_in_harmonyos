diff -ruN a/gl-stubs/GL/glut.h b/gl-stubs/GL/glut.h
--- a/gl-stubs/GL/glut.h
+++ b/gl-stubs/GL/glut.h
@@ -0,0 +1,172 @@
+/*
+ * GL/glut.h - Stub header for OpenHarmony (no GLUT available)
+ * Provides type definitions, constants, and function declarations
+ * so that GLUI library can compile. Actual GLUT implementations
+ * are resolved at link time on the target platform.
+ */
+#ifndef __GL_STUBS_GLUT_H__
+#define __GL_STUBS_GLUT_H__
+
+#include <GL/gl.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* GLUT display mode bits */
+#define GLUT_RGB                          0x0000
+#define GLUT_DOUBLE                       0x0002
+#define GLUT_DEPTH                        0x0010
+
+/* GLUT mouse buttons */
+#define GLUT_LEFT_BUTTON                  0x0000
+#define GLUT_MIDDLE_BUTTON                0x0001
+#define GLUT_RIGHT_BUTTON                 0x0002
+
+/* GLUT cursor direction (used in some GLUI code) */
+#define GLUT_LEFT                         0x0001
+
+/* GLUT button state */
+#define GLUT_DOWN                         0x0000
+#define GLUT_UP                           0x0001
+
+/* GLUT special keys */
+#define GLUT_KEY_F1                       0x0001
+#define GLUT_KEY_F2                       0x0002
+#define GLUT_KEY_F3                       0x0003
+#define GLUT_KEY_F4                       0x0004
+#define GLUT_KEY_F5                       0x0005
+#define GLUT_KEY_F6                       0x0006
+#define GLUT_KEY_F7                       0x0007
+#define GLUT_KEY_F8                       0x0008
+#define GLUT_KEY_F9                       0x0009
+#define GLUT_KEY_F10                      0x000A
+#define GLUT_KEY_F11                      0x000B
+#define GLUT_KEY_F12                      0x000C
+#define GLUT_KEY_LEFT                     0x0064
+#define GLUT_KEY_UP                       0x0065
+#define GLUT_KEY_RIGHT                    0x0066
+#define GLUT_KEY_DOWN                     0x0067
+#define GLUT_KEY_PAGE_UP                  0x0068
+#define GLUT_KEY_PAGE_DOWN                0x0069
+#define GLUT_KEY_HOME                     0x006A
+#define GLUT_KEY_END                      0x006B
+#define GLUT_KEY_INSERT                   0x006C
+
+/* GLUT modifier keys */
+#define GLUT_ACTIVE_SHIFT                 0x0001
+#define GLUT_ACTIVE_CTRL                  0x0002
+#define GLUT_ACTIVE_ALT                   0x0004
+
+/* GLUT cursor types */
+#define GLUT_CURSOR_INHERIT               0x0000
+#define GLUT_CURSOR_LEFT_ARROW            0x0001
+#define GLUT_CURSOR_TEXT                  0x0005
+#define GLUT_CURSOR_LEFT_RIGHT            0x0009
+#define GLUT_CURSOR_UP_DOWN               0x000A
+#define GLUT_CURSOR_SPRAY                 0x000B
+
+/* GLUT state queries */
+#define GLUT_WINDOW_WIDTH                 0x0064
+#define GLUT_WINDOW_HEIGHT                0x0065
+#define GLUT_WINDOW_PARENT                0x0068
+#define GLUT_ELAPSED_TIME                 0x0070
+
+/* GLUT callback IDs (used by GLUI internal enum) */
+#define GLUT_RESHAPE                      0
+#define GLUT_KEYBOARD                     1
+#define GLUT_DISPLAY                      2
+#define GLUT_MOUSE                        3
+#define GLUT_MOTION                       4
+#define GLUT_PASSIVE_MOTION               5
+#define GLUT_VISIBILITY                   6
+#define GLUT_ENTRY                        7
+#define GLUT_SPECIAL                      8
+
+/* GLUT bitmap fonts - declared as void* pointers */
+extern void *GLUT_BITMAP_HELVETICA_12;
+extern void *GLUT_BITMAP_HELVETICA_18;
+
+/* GLUT function declarations - implementations provided at link time */
+
+/* Initialization */
+void glutInit(int *argcp, char **argv);
+void glutInitDisplayMode(unsigned int mode);
+void glutInitWindowSize(int width, int height);
+void glutInitWindowPosition(int x, int y);
+
+/* Window management */
+int glutCreateWindow(const char *title);
+int glutCreateSubWindow(int win, int x, int y, int width, int height);
+void glutDestroyWindow(int win);
+void glutSetWindow(int win);
+int glutGetWindow(void);
+void glutShowWindow(void);
+void glutHideWindow(void);
+void glutPositionWindow(int x, int y);
+void glutReshapeWindow(int width, int height);
+
+/* Display */
+void glutPostRedisplay(void);
+void glutSwapBuffers(void);
+
+/* Callback registration */
+void glutDisplayFunc(void (*func)(void));
+void glutReshapeFunc(void (*func)(int width, int height));
+void glutKeyboardFunc(void (*func)(unsigned char key, int x, int y));
+void glutSpecialFunc(void (*func)(int key, int x, int y));
+void glutMouseFunc(void (*func)(int button, int state, int x, int y));
+void glutMotionFunc(void (*func)(int x, int y));
+void glutPassiveMotionFunc(void (*func)(int x, int y));
+void glutIdleFunc(void (*func)(void));
+void glutVisibilityFunc(void (*func)(int state));
+void glutEntryFunc(void (*func)(int state));
+void glutTimerFunc(unsigned int millis, void (*func)(int value), int value);
+void glutOverlayDisplayFunc(void (*func)(void));
+void glutMenuStateFunc(void (*func)(int state));
+void glutMenuStatusFunc(void (*func)(int status, int x, int y));
+void glutWindowStatusFunc(void (*func)(int state));
+void glutButtonBoxFunc(void (*func)(int button, int state));
+void glutDialsFunc(void (*func)(int dial, int value));
+void glutTabletButtonFunc(void (*func)(int button, int state, int x, int y));
+void glutTabletMotionFunc(void (*func)(int x, int y));
+void glutSpaceballMotionFunc(void (*func)(int x, int y, int z));
+void glutSpaceballRotateFunc(void (*func)(int x, int y, int z));
+void glutSpaceballButtonFunc(void (*func)(int button, int state));
+
+/* Main loop */
+void glutMainLoop(void);
+
+/* State queries */
+int glutGet(GLenum state);
+int glutGetModifiers(void);
+
+/* Cursor */
+void glutSetCursor(int cursor);
+
+/* Menu */
+int glutCreateMenu(void (*func)(int));
+void glutDestroyMenu(int menu);
+void glutAddMenuEntry(const char *label, int value);
+void glutAttachMenu(int button);
+void glutDetachMenu(int button);
+
+/* Bitmap font functions */
+void glutBitmapCharacter(void *font, int character);
+int glutBitmapWidth(void *font, int character);
+void glutBitmapString(void *font, const char *string);
+int glutBitmapWidthString(void *font, const char *string);
+
+/* Solid/wire objects */
+void glutSolidSphere(GLdouble radius, GLint slices, GLint stacks);
+void glutWireSphere(GLdouble radius, GLint slices, GLint stacks);
+void glutSolidTorus(GLdouble innerRadius, GLdouble outerRadius, GLint sides, GLint rings);
+void glutWireTorus(GLdouble innerRadius, GLdouble outerRadius, GLint sides, GLint rings);
+void glutSolidTeapot(GLdouble size);
+void glutWireTeapot(GLdouble size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __GL_STUBS_GLUT_H__ */
