+    set(GLUI_GL_LIBS ${GLUT_LIBRARIES} ${OPENGL_LIBRARIES})
+    set(GLUI_BUILD_EXAMPLES ON)
+else()
+    # No GL/GLUT available (e.g., OpenHarmony headless build)
+    # Use stub headers for compilation; symbols resolved at link time
+    include_directories(${CMAKE_SOURCE_DIR}/gl-stubs)
+    set(GLUI_GL_LIBS "")
+    set(GLUI_BUILD_EXAMPLES OFF)
+endif()
