+# Platform detection: try to find GLUT/OpenGL, fall back to stubs
+find_package(GLUT QUIET)
+find_package(OpenGL QUIET)
 
-include_directories(${GLUT_INCLUDE_DIR}/include)
+if(GLUT_FOUND AND OPENGL_FOUND)
