diff --git a/tests/gpgscm/ffi.c b/tests/gpgscm/ffi.c
index fd4f3ad..949c833 100644
--- a/tests/gpgscm/ffi.c
+++ b/tests/gpgscm/ffi.c
@@ -364,7 +364,13 @@ do_get_temp_path (scheme *sc, pointer args)
     }
   FFI_RETURN_STRING (sc, buffer);
 #else
-  FFI_RETURN_STRING (sc, "/tmp");
+  /* OHOS (and other platforms where /tmp is not writable): honour $TMPDIR.
+     /tmp is a read-only erofs mount on HarmonyOS PC, so the test framework's
+     _mkdtemp() failed outright and no upstream test could run at all. */
+  {
+    const char *tmpdir = getenv ("TMPDIR");
+    FFI_RETURN_STRING (sc, (tmpdir && *tmpdir) ? tmpdir : "/tmp");
+  }
 #endif
 }
 
