diff --git a/common/sysutils.c b/common/sysutils.c
index 9c36bc8..5b7d960 100644
--- a/common/sysutils.c
+++ b/common/sysutils.c
@@ -814,6 +814,38 @@ gnupg_tmpfile (void)
 
 #else /*!HAVE_W32_SYSTEM*/
 
+  /* HarmonyOS (musl): tmpfile() resolves to a compile-time P_tmpdir of
+     "/tmp", which on OHOS PC is a read-only erofs mount; it ignores $TMPDIR.
+     Build the temporary file inside $TMPDIR instead (mkstemp + immediate
+     unlink + fdopen gives the same delete-on-close semantics), and fall back
+     to the original tmpfile() when $TMPDIR is unset or unusable.  */
+  {
+    const char *tmpdir = getenv ("TMPDIR");
+
+    if (tmpdir && *tmpdir)
+      {
+        char name[PATH_MAX];
+        int len = snprintf (name, sizeof name, "%s/gnupg-XXXXXX", tmpdir);
+
+        if (len > 0 && (size_t) len < sizeof name)
+          {
+            int fd = mkstemp (name);
+
+            if (fd != -1)
+              {
+                FILE *fp;
+
+                unlink (name);
+                fp = fdopen (fd, "w+b");
+                if (fp)
+                  return fp;
+                close (fd);
+                return NULL;
+              }
+          }
+      }
+  }
+
   return tmpfile ();
 
 #endif /*!HAVE_W32_SYSTEM*/
