@@ -2372,7 +2373,28 @@ copy_file (const char *src_name, const char *dst_name)
 
   return 0;
 }
-#endif /* HAVE_W32_SYSTEM */
+
+
+/* OHOS: HMDFS (and several other OHOS mounts) refuse link(2) with EPERM, so the
+ * atomic-commit primitive below cannot rely on hard links.  Try link() first for
+ * the strongest guarantee, and fall back to copy_file() only when the filesystem
+ * itself refuses the operation (so genuine errors still propagate). */
+static int
+link_or_copy_file (const char *src_name, const char *dst_name)
+{
+  int saved_err;
+
+  if (link (src_name, dst_name) == 0)
+    return 0;
+  saved_err = errno;
+  if (saved_err != EPERM && saved_err != EACCES && saved_err != ENOSYS
+      && saved_err != EXDEV && saved_err != EOPNOTSUPP)
+    return -1;
+  if (copy_file (src_name, dst_name) == 0)
+    return 0;
+  gpg_err_set_errno (saved_err);
+  return -1;
+}
 
 
 /* Create and verify the new configuration file for the specified
@@ -2429,7 +2451,7 @@ change_options_program (gc_component_id_t component,
 #ifdef HAVE_W32_SYSTEM
   res = copy_file (dest_filename, orig_filename);
 #else
-  res = link (dest_filename, orig_filename);
+  res = link_or_copy_file (dest_filename, orig_filename);
 #endif
   if (res < 0 && errno != ENOENT)
     {
@@ -2910,7 +2932,7 @@ gc_component_change_options (int component, estream_t in, estream_t out,
