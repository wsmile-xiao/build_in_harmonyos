diff -ruN a/common/sysutils.c b/common/sysutils.c
--- a/common/sysutils.c
+++ b/common/sysutils.c
@@ -677,6 +677,39 @@
 #else /*!HAVE_W32_SYSTEM*/
 
+# if defined(HAVE_ANDROID_SYSTEM) || defined(__OHOS__)
+  /* OHOS libc's tmpfile() does not honor TMPDIR and may target an
+     inaccessible global temporary directory.  Create an anonymous file in
+     the caller-provided temporary directory instead.  */
+  {
+    char buffer[4096];
+    const char *tmpdir = getenv ("TMPDIR");
+    int fd;
+    FILE *fp;
+
+    if (!tmpdir || !*tmpdir)
+      tmpdir = "/tmp";
+    if (snprintf (buffer, sizeof buffer, "%s/gnupg-tmp-XXXXXX", tmpdir)
+        >= (int)sizeof buffer)
+      {
+        errno = ENAMETOOLONG;
+        return NULL;
+      }
+    fd = mkstemp (buffer);
+    if (fd == -1)
+      return NULL;
+    unlink (buffer);
+    fp = fdopen (fd, "w+b");
+    if (!fp)
+      {
+        int save = errno;
+        close (fd);
+        errno = save;
+      }
+    return fp;
+  }
+# else
   return tmpfile ();
+# endif
 
 #endif /*!HAVE_W32_SYSTEM*/
 }
