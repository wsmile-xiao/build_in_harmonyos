--- a/posix/gawkmisc.c
+++ b/posix/gawkmisc.c
@@ -102,8 +102,17 @@
 	memset(stb, '\0', sizeof(struct stat));
 
 	/* always stat, in case stb is used by higher level code. */
-	if (fstat(fd, stb) == -1)
-		fatal("can't stat fd %d (%s)", fd, strerror(errno));
+	if (fstat(fd, stb) == -1) {
+		/* Some systems (e.g. HarmonyOS) return EACCES/EPERM for
+		 * fstat on pipes/terminals/sockets. Use fallback values
+		 * so I/O can proceed normally. */
+		if (errno == EACCES || errno == EPERM) {
+			stb->st_blksize = 4096;
+			stb->st_mode = S_IFIFO;
+		} else {
+			fatal("can't stat fd %d (%s)", fd, strerror(errno));
+		}
+	}
 
 	if (first) {
 		first = false;
