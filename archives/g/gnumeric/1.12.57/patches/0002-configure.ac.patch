+dnl We use a LINGUAS file, so we need intltool >= 0.35.
+dnl intltool requires XML::Parser (perl) which is not available on
+dnl HarmonyOS PC, and translations are not needed for the spreadsheet
+dnl application, so replace the full IT_PROG_INTLTOOL machinery with a
+dnl minimal shim that strips the "_" translation markers from the plugin
+dnl .xml.in/.ui.in files.
+dnl IT_PROG_INTLTOOL([0.35.0])
+AC_SUBST(INTLTOOL_EXTRACT, ['true'])
+AC_SUBST(INTLTOOL_MERGE, ['$(SHELL) $(top_srcdir)/intltool-merge-shim'])
+AC_SUBST(INTLTOOL_PERL, ['perl'])
+AC_SUBST(INTLTOOL_UPDATE, ['true'])
+AC_SUBST(INTLTOOL_V_MERGE, [''])
+AC_SUBST(INTLTOOL_V_MERGE_OPTIONS, [''])
+AC_SUBST(INTLTOOL_XML_RULE, ['%.xml: %.xml.in ; $(SHELL) $(top_srcdir)/intltool-merge-shim $< $@'])
+AC_SUBST(INTLTOOL_XML_NOMERGE_RULE, ['%.xml: %.xml.in ; $(SHELL) $(top_srcdir)/intltool-merge-shim $< $@'])
+AC_SUBST(INTLTOOL_DESKTOP_RULE, ['%.desktop: %.desktop.in ; $(SHELL) $(top_srcdir)/intltool-merge-shim $< $@'])
+AC_SUBST(INTLTOOL_SCHEMAS_RULE, ['%.schemas: %.schemas.in ; $(SHELL) $(top_srcdir)/intltool-merge-shim $< $@'])
+AC_SUBST(INTLTOOL__v_MERGE_, [''])
+dnl IT_PO_SUBDIR(po-functions)
 
