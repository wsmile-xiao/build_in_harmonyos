<?xml version="1.0"?>
<!-- 消费者测试夹具：最小可用的 GObject Introspection 描述文件。
     由 test_girtod.py 作为真实输入喂给 girtod，验证它能生成 D 绑定。 -->
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <namespace name="Test" version="1.0" shared-library="libtest.so"
             c:identifier-prefixes="Test" c:symbol-prefixes="test">
    <class name="Widget" c:type="TestWidget" glib:get-type="test_widget_get_type"
           parent="GObject.Object">
      <method name="new" c:identifier="test_widget_new">
        <return-value transfer-ownership="full">
          <type name="Widget" c:type="TestWidget*"/>
        </return-value>
      </method>
    </class>
  </namespace>
</repository>
