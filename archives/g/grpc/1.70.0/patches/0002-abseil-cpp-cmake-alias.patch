--- a/cmake/abseil-cpp.cmake
+++ b/cmake/abseil-cpp.cmake
@@ -36,6 +36,36 @@
   endif()
 elseif(gRPC_ABSL_PROVIDER STREQUAL "package")
   # Use "CONFIG" as there is no built-in cmake module for absl.
-  find_package(absl REQUIRED CONFIG)
+  # OHOS: registry absl is aggregated under abseil-cpp (lts_20260107, same ABI
+  # as protobuf). Use abseil-cpp package and alias absl::absl to it.
+  find_package(abseil-cpp CONFIG QUIET)
+  if(NOT TARGET absl::absl AND TARGET abseil-cpp::abseil-cpp)
+    add_library(absl::absl INTERFACE IMPORTED)
+    set_target_properties(absl::absl PROPERTIES INTERFACE_LINK_LIBRARIES "abseil-cpp::abseil-cpp")
+    if(abseil-cpp_INCLUDE_DIRS_RELEASE)
+      set_target_properties(absl::absl PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${abseil-cpp_INCLUDE_DIRS_RELEASE}")
+    endif()
+  endif()
+  if(NOT TARGET absl::absl)
+    find_package(absl REQUIRED CONFIG)
+  endif()
+  # OHOS adaptation: registry absl package exports an aggregated target
+  # (absl::absl) instead of per-component targets; alias the components
+  # gRPC + protobuf reference onto it.
+  if(NOT TARGET absl::strings AND TARGET absl::absl)
+    foreach(_c absl_check absl_log algorithm algorithm_container any any_invocable base bind_front bits btree check cleanup config cord core_headers debugging die_if_null dynamic_annotations failure_signal_handler flags flags_marshalling flags_parse flags_reflection flags_usage flat_hash_map flat_hash_set function_ref hash inlined_vector layout log log_globals log_initialize log_severity memory no_destructor node_hash_map node_hash_set optional random_bit_gen_ref random_distributions random_random span stacktrace status statusor str_format strings symbolize synchronization time type_traits utility variant)
+      if(NOT TARGET absl::${_c})
+        add_library(absl::${_c} INTERFACE IMPORTED)
+        if(TARGET abseil-cpp::abseil-cpp)
+        set_target_properties(absl::${_c} PROPERTIES INTERFACE_LINK_LIBRARIES "abseil-cpp::abseil-cpp")
+      else()
+        set_target_properties(absl::${_c} PROPERTIES INTERFACE_LINK_LIBRARIES "absl::absl")
+      endif()
+        if(abseil-cpp_INCLUDE_DIRS_RELEASE)
+          set_target_properties(absl::${_c} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${abseil-cpp_INCLUDE_DIRS_RELEASE}")
+        endif()
+      endif()
+    endforeach()
+  endif()
 endif()
 set(_gRPC_FIND_ABSL "if(NOT TARGET absl::strings)\n  find_package(absl CONFIG)\nendif()")
