--- a/platform/linuxbsd/detect.py	2026-08-17 09:18:38.000000000 +0800
+++ b/platform/linuxbsd/detect.py	2026-09-13 05:30:00.000000000 +0800
@@ -567,10 +567,19 @@
         env.Append(LINKFLAGS=["-lkvm"])

     # Link those statically for portability
+    # OHOS (OpenHarmony): the OHOS sysroot is musl-based and provides no
+    # libatomic — 64-bit atomics are compiler builtins provided by libc.
+    # Detect any *-linux-ohos cross target in the user-supplied toolchain
+    # flags; substring matching over the joined flag text accepts any arch
+    # variant (aarch64/arm/x86_64-linux-ohos) and any flag grouping.
+    ohos_target = "-linux-ohos" in " ".join(
+        str(flag)
+        for flag in (env.get("CCFLAGS") or []) + (env.get("LINKFLAGS") or [])
+    )
     if env["use_static_cpp"]:
         env.Append(LINKFLAGS=["-static-libgcc", "-static-libstdc++"])
-        if env["use_llvm"] and platform.system() != "FreeBSD":
+        if env["use_llvm"] and platform.system() != "FreeBSD" and not ohos_target:
             env["LINKCOM"] = env["LINKCOM"] + " -l:libatomic.a"
     else:
-        if env["use_llvm"] and platform.system() != "FreeBSD":
+        if env["use_llvm"] and platform.system() != "FreeBSD" and not ohos_target:
             env.Append(LIBS=["atomic"])
