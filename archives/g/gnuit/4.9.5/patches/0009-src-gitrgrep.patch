 name=`basename "$0"`
 
 # Start grep/egrep/fgrep depending on argv[0]
 
 case $name in
 gitrgrep)	grep="grep";;
 gitregrep)	grep="egrep";;
 gitrfgrep)	grep="fgrep";;
 esac
 
+# Non-interactive probe support: answer --version without descending the tree.
+case "$1" in
+  --version)
+    echo "gitrgrep (GNU Interactive Tools) 4.9.5"
+    exit 0;;
+esac
+
 find . -follow -type d -exec gitxgrep '{}'\
