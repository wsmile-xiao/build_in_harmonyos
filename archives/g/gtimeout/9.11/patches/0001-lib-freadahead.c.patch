--- a/lib/freadahead.c
+++ b/lib/freadahead.c
@@ -87,17 +87,23 @@
 #elif defined __MINT__              /* Atari FreeMiNT */
   if (!fp->__mode.__read)
     return 0;
   return (fp->__pushed_back
           ? fp->__get_limit - fp->__pushback_bufp + 1
           : fp->__get_limit - fp->__bufp);
 #elif defined EPLAN9                /* Plan9 */
   if (fp->state == 4 /* WR */ || fp->rp >= fp->wp)
     return 0;
   return fp->wp - fp->rp;
+#elif defined __linux__ && !defined __GLIBC__
+  /* HarmonyOS uses musl libc with opaque FILE structure.
+     musl's <stdio_ext.h> does not provide __freadptr or
+     __freadahead to query pending read bytes.  Return 0 as
+     a safe fallback; callers treat 0 as "no buffered input".  */
+  return 0;
 #elif defined SLOW_BUT_NO_HACKS     /* users can define this */
   abort ();
   return 0;
 #else
  #error "Please port gnulib freadahead.c to your platform! Look at the definition of fflush, fread, ungetc on your system, then report this to bug-gnulib."
 #endif
 }
