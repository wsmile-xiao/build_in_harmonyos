--- a/googletest/src/gtest-port.cc
+++ b/googletest/src/gtest-port.cc
@@ -1089,7 +1089,18 @@
     if (name_template.back() != GTEST_PATH_SEP_[0])
       name_template.push_back(GTEST_PATH_SEP_[0]);
 #else
-    name_template = "/tmp/";
+    // On Linux/other POSIX (including HarmonyOS PC), the sandbox may mount
+    // /tmp read-only. Honor the caller-controlled TMPDIR environment variable
+    // when it is set and non-empty, falling back to the upstream default /tmp/
+    // otherwise to preserve upstream behavior and security boundaries.
+    const char* const tmpdir_env = getenv("TMPDIR");
+    if (tmpdir_env != nullptr && tmpdir_env[0] != '\0') {
+      name_template = tmpdir_env;
+      if (name_template.back() != GTEST_PATH_SEP_[0])
+        name_template.push_back(GTEST_PATH_SEP_[0]);
+    } else {
+      name_template = "/tmp/";
+    }
 #endif
     name_template.append("gtest_captured_stream.XXXXXX");
 
