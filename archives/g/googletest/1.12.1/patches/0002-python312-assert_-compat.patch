--- /dev/null
+++ b/googletest/test/gtest_compat_py3.py
@@ -0,0 +1,33 @@
+"""Python 3.12 compatibility shim for upstream GoogleTest test scripts.
+
+Python 3.12 removed a set of deprecated unittest.TestCase aliases
+(assert_, assertEquals, assertNotEquals, assertAlmostEquals,
+assertNotAlmostEquals, assertRegexpMatches, assertNotRegexpMatches, ...).
+Before 3.12 each was a documented alias of a current method with identical
+semantics. This module restores those aliases so the Python-2-era upstream test
+scripts (googletest 1.12.1) keep running unchanged on Python 3.12. Upstream
+logic, assertions and output are untouched; only the removed alias names are
+re-pointed at their exact semantic equivalents.
+"""
+import unittest
+
+
+def _alias(old_name, new_name):
+    if not hasattr(unittest.TestCase, old_name):
+        setattr(unittest.TestCase, old_name, getattr(unittest.TestCase, new_name))
+
+
+_alias("assert_", "assertTrue")
+_alias("assertEquals", "assertEqual")
+_alias("assertNotEquals", "assertNotEqual")
+_alias("assertAlmostEquals", "assertAlmostEqual")
+_alias("assertNotAlmostEquals", "assertNotAlmostEqual")
+_alias("assertRegexpMatches", "assertRegex")
+_alias("assertNotRegexpMatches", "assertNotRegex")
+_alias("failUnlessEqual", "assertEqual")
+_alias("failIfEqual", "assertNotEqual")
+_alias("failUnlessAlmostEqual", "assertAlmostEqual")
+_alias("failIfAlmostEqual", "assertNotAlmostEqual")
+_alias("failUnless", "assertTrue")
+_alias("failIf", "assertFalse")
+_alias("failUnlessRaises", "assertRaises")
