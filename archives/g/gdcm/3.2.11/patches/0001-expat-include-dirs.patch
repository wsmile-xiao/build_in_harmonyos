GDCM_USE_SYSTEM_EXPAT=ON: add EXPAT_INCLUDE_DIRS to gdcmIOD include path

When using system expat, gdcmTableReader.cxx compiles with -DXML_STATIC and
#include <expat.h> (via Utilities/gdcm_expat.h), but the gdcmIOD target never
adds EXPAT_INCLUDE_DIRS — the top-level CMakeLists calls find_package(EXPAT)
but (unlike ZLIB) does not propagate include_directories() for it.

Result: fatal error: 'expat.h' file not found on platforms where expat
headers live outside the default sysroot include path (Conan layout / OHOS).

--- a/Source/InformationObjectDefinition/CMakeLists.txt	2026-09-20 22:50:59.860072812 +0800
+++ b/Source/InformationObjectDefinition/CMakeLists.txt	2026-09-20 22:51:01.980070624 +0800
@@ -38,6 +38,9 @@
   "${GDCM_SOURCE_DIR}/Source/DataDictionary"
   "${GDCM_SOURCE_DIR}/Utilities"
   )
+if(GDCM_USE_SYSTEM_EXPAT)
+  include_directories(${EXPAT_INCLUDE_DIRS})
+endif()
 if(NOT GDCM_USE_SYSTEM_EXPAT) # only needed _without_ find_package
   include_directories(
     "${GDCM_BINARY_DIR}/Utilities/gdcmexpat" # expat_mangle.h
