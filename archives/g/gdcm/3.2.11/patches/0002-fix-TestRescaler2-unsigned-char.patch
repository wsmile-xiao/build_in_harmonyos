Fix TestRescaler2 on platforms where plain char is unsigned

The test instantiates TestRescaler2Func<char,char> for INT8 pixel
formats (Cases 11/12), assuming plain char is signed (true on x86
Linux). On arm64 OHOS the SDK builds with unsigned plain char
semantics (std::numeric_limits<char>::min() == 0), so both the input
cast (char)(min + i) wraps around AND the output cast (char)(...)
re-wraps negative values, breaking the monotonic min2<=max2 assertion
and the inverse-rescale roundtrip.

The signed-ness of plain char is implementation-defined in C++
(CHAR_MIN may be 0). Use "signed char" explicitly for both input and
output pixel types — matching the INT8 PixelFormat the test intends
to exercise — and add the matching TypeToPixelFormat<signed char>
specialization, so the test is portable across char signed-ness.

--- a/Testing/Source/MediaStorageAndFileFormat/Cxx/TestRescaler2.cxx
+++ b/Testing/Source/MediaStorageAndFileFormat/Cxx/TestRescaler2.cxx
@@ -25,6 +25,7 @@
 template<> struct TypeToPixelFormat<unsigned short> { enum { Type = gdcm::PixelFormat::UINT16 }; };
 template<> struct TypeToPixelFormat<unsigned char> { enum { Type = gdcm::PixelFormat::UINT8 }; };
 template<> struct TypeToPixelFormat<char> { enum { Type = gdcm::PixelFormat::INT8 }; };
+template<> struct TypeToPixelFormat<signed char> { enum { Type = gdcm::PixelFormat::INT8 }; };
 template<> struct TypeToPixelFormat<int> { enum { Type = gdcm::PixelFormat::INT32 }; };

 template <typename input_pixel, typename output_pixel>
@@ -179,9 +180,9 @@
     // Case 10. best fit
     if( !TestRescaler2Func<short,short>(intercept, slope,16,12,1,true) ) return 1;
     // Case 11. unsigned char:
-    if( !TestRescaler2Func<char,char>(intercept,slope,8,8,1,true) ) return 1;
+    if( !TestRescaler2Func<signed char,signed char>(intercept,slope,8,8,1,true) ) return 1;
     // Case 12. char
-    if( !TestRescaler2Func<char,char>(intercept,slope,8,7,1,true) ) return 1;
+    if( !TestRescaler2Func<signed char,signed char>(intercept,slope,8,7,1,true) ) return 1;
     }

