 void ThreadCache::GetThreadStats(uint64_t* total_bytes, uint64_t* class_count) {
   for (ThreadCache* h = thread_heaps_; h != NULL; h = h->next_) {
     *total_bytes += h->Size();
     if (class_count) {
       for (int cl = 0; cl < kNumClasses; ++cl) {
         class_count[cl] += h->freelist_length(cl);
       }
