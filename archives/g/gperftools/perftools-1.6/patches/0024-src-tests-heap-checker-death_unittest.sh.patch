   perl -e '
     $timeout=$ARGV[0]; shift;
     $retval = 255;   # the default retval, for the case where we timed out
     eval {           # need to run in an eval-block to trigger during system()
       local $SIG{ALRM} = sub { die "alarm\n" };  # \n is required!
       alarm $timeout;
