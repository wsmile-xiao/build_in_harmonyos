diff -ruN /dev/null b/Makefile
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,54 @@
+# Makefile for gifify 2.4.0 (npm project)
+# This is a pure Node.js project - no compilation needed.
+# Installation: copy all files to DESTDIR/PREFIX/lib/gifify and create bin symlink
+
+PREFIX ?= /usr/local
+DESTDIR ?=
+
+GIFIFY_LIBDIR = $(DESTDIR)$(PREFIX)/lib/gifify
+GIFIFY_BINDIR = $(DESTDIR)$(PREFIX)/bin
+
+FILES_TO_INSTALL = \
+	bin/gifify \
+	index.js \
+	package.json \
+	HISTORY.md \
+	LICENSE.md \
+	README.md
+
+NODE_MODULES = node_modules
+
+all: install_deps
+
+install_deps:
+	npm install --production
+
+install: install-deps install-files install-symlink
+
+install-deps: install_deps
+
+install-files:
+	mkdir -p $(GIFIFY_LIBDIR)
+	mkdir -p $(GIFIFY_LIBDIR)/bin
+	for f in $(FILES_TO_INSTALL); do \
+		cp -R $$f $(GIFIFY_LIBDIR)/$$f; \
+	done
+	cp -R $(NODE_MODULES) $(GIFIFY_LIBDIR)/$(NODE_MODULES)
+
+install-symlink:
+	mkdir -p $(GIFIFY_BINDIR)
+	rm -f $(GIFIFY_BINDIR)/gifify
+	ln -s $(PREFIX)/lib/gifify/bin/gifify $(GIFIFY_BINDIR)/gifify
+
+check:
+	@echo "gifify is an npm CLI tool - no traditional test suite"
+	@echo "Runtime requirements: ffmpeg, convert (ImageMagick), gifsicle"
+	@echo "Checking runtime requirements..."
+	@which ffmpeg || echo "WARNING: ffmpeg not found"
+	@which convert || echo "WARNING: convert (ImageMagick) not found"
+	@which gifsicle || echo "WARNING: gifsicle not found"
+
+clean:
+	rm -rf node_modules
+
+.PHONY: all install_deps install install-deps install-files install-symlink check clean
