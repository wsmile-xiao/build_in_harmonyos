diff -ruN a/gphoto2/main.c b/gphoto2/main.c
--- a/gphoto2/main.c
+++ b/gphoto2/main.c
@@ -1160,46 +1160,66 @@
 /* Set/init global variables                                    */
 /* ------------------------------------------------------------ */
 
 #ifdef HAVE_PTHREAD
 
 typedef struct _ThreadData ThreadData;
 struct _ThreadData {
 	Camera *camera;
 	time_t timeout;
 	CameraTimeoutFunc func;
+#ifdef __OHOS__
+	volatile int cancelled;
+#endif
 };
+
+#ifdef __OHOS__
+/* pthread_cancel unavailable on musl/OHOS; flag-based cancellation */
+#define MAX_TIMEOUT_THREADS 8
+static ThreadData *_ohos_td_registry[MAX_TIMEOUT_THREADS];
+static unsigned int _ohos_td_ids[MAX_TIMEOUT_THREADS];
+static int _ohos_td_count = 0;
+#endif
 
 static void
 thread_cleanup_func (void *data)
 {
 	ThreadData *td = data;
 
 	free (td);
 }
 
 static void *
 thread_func (void *data)
 {
 	ThreadData *td = data;
 	time_t t, last;
 
 	pthread_cleanup_push (thread_cleanup_func, td);
 
 	last = time (NULL);
 	while (1) {
+#ifdef __OHOS__
+		if (td->cancelled)
+			break;
+#endif
 		t = time (NULL);
 		if (t - last > td->timeout) {
 			td->func (td->camera, NULL);
 			last = t;
 		}
+#ifdef __OHOS__
+		/* Sleep briefly to allow cancellation flag check */
+		{ struct timespec ts = {0, 100000000}; nanosleep(&ts, NULL); }
+#else
 		pthread_testcancel ();
+#endif
 	}
 
 	pthread_cleanup_pop (1);
 }
 
 static unsigned int
 start_timeout_func (Camera *camera, unsigned int timeout,
 		    CameraTimeoutFunc func, void __unused__ *data)
 {
 	pthread_t tid;
@@ -1208,31 +1228,53 @@
 	td = malloc (sizeof (ThreadData));
 	if (!td)
 		return 0;
 	memset (td, 0, sizeof (ThreadData));
 	td->camera = camera;
 	td->timeout = timeout;
 	td->func = func;
 
 	pthread_create (&tid, NULL, thread_func, td);
 
+#ifdef __OHOS__
+	/* Register ThreadData for flag-based cancellation */
+	if (_ohos_td_count < MAX_TIMEOUT_THREADS) {
+		_ohos_td_registry[_ohos_td_count] = td;
+		_ohos_td_ids[_ohos_td_count] = (unsigned int)tid;
+		_ohos_td_count++;
+	}
+#endif
+
 	return (unsigned int)tid;
 }
 
 static void
 stop_timeout_func (Camera __unused__ *camera, unsigned int id,
 		   void __unused__ *data)
 {
 	pthread_t tid = (pthread_t)id;
 
+#ifdef __OHOS__
+	/* pthread_cancel unavailable; set cancelled flag then join */
+	for (int i = 0; i < _ohos_td_count; i++) {
+		if (_ohos_td_ids[i] == id) {
+			_ohos_td_registry[i]->cancelled = 1;
+			_ohos_td_ids[i] = 0;
+			_ohos_td_registry[i] = NULL;
+			break;
+		}
+	}
+	pthread_join (tid, NULL);
+#else
 	pthread_cancel (tid);
 	pthread_join (tid, NULL);
+#endif
 }
 
 #endif
 
