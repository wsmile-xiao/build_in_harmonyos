From e4f71d20cafa2ee914ac67c7f53c845c9552f81e Mon Sep 17 00:00:00 2001
From: OHOS PC porting <porting@openharmony-pc.invalid>
Date: Sun, 6 Sep 2026 11:14:10 +0800
Subject: [PATCH] meson: add gui-tools option for headless/CLI-only builds

The GUI tools (gupnp-network-light, gupnp-universal-cp, gupnp-av-cp)
hard-depend on GTK+ 3 and the shared data files. On headless targets
where no GTK+ stack is available the whole project failed to configure
because gtk+-3.0 was an unconditional hard dependency.

Add a 'gui-tools' boolean option (default true, upstream behaviour
unchanged). When disabled:
- gtk+-3.0 becomes an optional dependency (not required)
- the GUI subdirs (common, av-cp, upload, network-light, universal-cp)
  and the data/ resources are skipped
- HAVE_GTK_SOURCEVIEW is forced to false
- the CLI tools gssdp-discover and gupnp-event-dumper are still built

Pure build-system portability fix: no platform macros, no source
changes; default behaviour on desktop systems is identical.
---
 meson.build       |  9 ++++++---
 meson_options.txt |  2 ++
 src/meson.build   | 15 ++++++++-------
 3 files changed, 16 insertions(+), 10 deletions(-)

diff --git a/meson.build b/meson.build
index 2614ef0..8fd7391 100644
--- a/meson.build
+++ b/meson.build
@@ -11,7 +11,8 @@ gssdp = dependency('gssdp-1.6', version : '>= 1.6.2', default_options: ['sniffer
 gupnp = dependency('gupnp-1.6', version: '>= 1.6.0')
 soup = dependency('libsoup-3.0', version: '>= 3.0')
 gupnp_av = dependency('gupnp-av-1.0', version: '>= 0.5.5', required: get_option('av-tools'))
-gtk = dependency('gtk+-3.0', version: '>= 3.10')
+gui_tools = get_option('gui-tools')
+gtk = dependency('gtk+-3.0', version: '>= 3.10', required: gui_tools)
 glib_version = '2.68'
 glib = dependency('glib-2.0', version: '>= ' + glib_version)
 gio = dependency('gio-2.0', version: '>= ' + glib_version)
@@ -40,7 +41,7 @@ desktopdir = join_paths(datadir, 'applications')
 conf = configuration_data()
 conf.set('VERSION', '"@0@"'.format(meson.project_version()))
 conf.set('DATA_DIR', '"@0@"'.format(shareddir))
-conf.set('HAVE_GTK_SOURCEVIEW', gtksourceview.found())
+conf.set('HAVE_GTK_SOURCEVIEW', gui_tools and gtksourceview.found())
 conf.set('GETTEXT_PACKAGE', '"@0@"'.format(meson.project_name()))
 conf.set('LOCALEDIR', '"@0@"'.format(localedir))
 conf.set('GLIB_VERSION_MIN_REQUIRED', 'GLIB_VERSION_@0@'.format(glib_version.underscorify()))
@@ -50,6 +51,8 @@ conf.set('GLIB_VERSION_MAX_ALLOWED', 'GLIB_VERSION_@0@'.format(glib_version.unde
 configure_file(input: 'config.h.meson', output: 'config.h', configuration: conf)
 config_header = declare_dependency(include_directories : include_directories('.'))
 
-subdir('data')
+if get_option('gui-tools')
+    subdir('data')
+endif
 subdir('src')
 subdir('po')
diff --git a/meson_options.txt b/meson_options.txt
index a74a9ec..4eae578 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -1,3 +1,5 @@
 option('av-tools', type: 'boolean', value: 'true', description: 'Built AV tools')
 option('uninstalled', type: 'boolean', value: 'false', description: 'Run UPnP tools from src tree')
 
+option('gui-tools', type: 'boolean', value: 'true', description: 'Build the GUI tools (requires GTK+; disable for headless/CLI-only builds)')
+
diff --git a/src/meson.build b/src/meson.build
index ddca4d5..54a17cf 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -1,11 +1,12 @@
-subdir('common')
-
-if get_option('av-tools') and gupnp_av.found()
-    subdir('av-cp')
-    subdir('upload')
+if get_option('gui-tools')
+    subdir('common')
+    if get_option('av-tools') and gupnp_av.found()
+        subdir('av-cp')
+        subdir('upload')
+    endif
+    subdir('network-light')
+    subdir('universal-cp')
 endif
 
 subdir('discover')
-subdir('network-light')
-subdir('universal-cp')
 subdir('event-dumper')
-- 
2.45.2

