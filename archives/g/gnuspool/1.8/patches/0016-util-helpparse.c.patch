+#include <fcntl.h>
+
+/*	OHOS/HMDFS 不支持硬链接（link() 返回 EPERM），退化为复制 */
+static	int	file_copy(char *src, char *dst, mode_t mode)
+{
+	int	in, out, n;
+	char	buf[8192];
+
+	if  ((in = open(src, O_RDONLY)) < 0)
+		return  0;
+	if  ((out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, mode & 07777)) < 0)  {
+		close(in);
+		return  0;
+	}
+	while  ((n = read(in, buf, sizeof(buf))) > 0)  {
+		if  (write(out, buf, n) != n)  {
+			close(in);
+			close(out);
+			return  0;
+		}
+	}
+	close(in);
+	close(out);
+	(void) chmod(dst, mode & 07777);
+	return  (n == 0);
+}
