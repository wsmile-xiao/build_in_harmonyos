+/* Not found in BSDs; musl (OHOS) 同样不提供 l64a（E213）与 getpass（E093） */
+
+#ifndef	OS_FREEBSD
+/* musl: POSIX 已废弃的 getpass（E093），用 fgets 等价实现 */
+char *getpass(const char *prompt)
+{
+	static	char	buf[256];
+	size_t	n;
+
+	fprintf(stderr, "%s", prompt);
+	fflush(stderr);
+	if  (!fgets(buf, sizeof(buf), stdin))
+		return  (char *) 0;
+	n = strlen(buf);
+	if  (n > 0  &&  buf[n - 1] == '\n')
+		buf[n - 1] = '\0';
+	return  buf;
+}
+#endif
 
