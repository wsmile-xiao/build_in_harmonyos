-    _file = std::tmpfile();
+    // std::tmpfile() writes to the system temp dir (/tmp), which is read-only on
+    // HarmonyOS/OHOS. Create the temporary file under $TMPDIR instead when set.
+    // Explicitly default _file to nullptr so a mkstemp failure leaves has_file()
+    // false and never reads an uninitialized/leftover handle.
+    _file = nullptr;
+
+    char const* tmp_dir = std::getenv("TMPDIR");
+    std::string name_template =
+      (tmp_dir != nullptr && *tmp_dir != '\0') ? std::string{tmp_dir} + "/quill_test_sink.XXXXXX"
+                                               : "/tmp/quill_test_sink.XXXXXX";
+    int const fd = mkstemp(name_template.data());
+    if (fd != -1)
+    {
+      _file = ::fdopen(fd, "w+");
+      if (_file == nullptr)
+      {
+        close(fd);
+      }
+      else
+      {
+        tmp_path_ = name_template;
+      }
+    }
 #endif
   }
 
   ~TestConsoleSink() override
   {
     if (_file)
     {
       std::fclose(_file);
+    }
+    if (!tmp_path_.empty())
+    {
+      std::remove(tmp_path_.c_str());
     }
   }
 
   bool has_file() const noexcept { return _file != nullptr; }
 
   std::string contents()
   {
     if ((std::fflush(_file) != 0) || (std::fseek(_file, 0, SEEK_END) != 0))
