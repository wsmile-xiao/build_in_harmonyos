     std::rewind(_file);
 
     std::string result(static_cast<size_t>(file_size), '\0');
     if (!result.empty())
     {
       size_t const bytes_read = std::fread(result.data(), sizeof(char), result.size(), _file);
       result.resize(bytes_read);
     }
     return result;
   }
