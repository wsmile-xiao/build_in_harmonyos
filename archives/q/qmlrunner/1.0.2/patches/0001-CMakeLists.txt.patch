--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,55 @@
+cmake_minimum_required(VERSION 3.16)
+project(qmlrunner VERSION 1.0.2 LANGUAGES CXX)
+
+# OHOS PC (aarch64 musl) adaptation build for qmlrunner 1.0.2.
+#
+# Upstream builds with qmake (qmlrunner.pro: QT += quick qml widgets).
+# This adaptation replaces the .pro file with a CMake build that wires
+# Qt5 manually from the conan packages qt5-qtbase/5.15.2.2
+# (Core/Gui/Widgets) and qt5-qtdeclarative/5.15.2 (Qml/Quick) — the
+# CMakeDeps configs are not wired for this Qt packaging, matching the
+# diffpdf/disomaster/acetoneiso recipes. The include and library
+# directories are passed by the recipe via QMLRUNNER_QT5_INCLUDE_DIRS /
+# QMLRUNNER_QT5_LIB_DIRS.
+#
+# main.cpp has no Q_OBJECT / .qrc resources, so neither moc nor rcc is
+# needed.
+
+set(CMAKE_CXX_STANDARD 11)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+# OHOS: the linker stamps an ELF code signature (.codesign) into the
+# binary, and the HarmonyOS kernel refuses to exec a binary whose
+# signature no longer matches its contents. CMake's install-time RPATH
+# rewrite edits the dynamic section in place and invalidates that
+# signature (observed: EPERM "Operation not permitted" on the installed
+# binary while the untouched build-tree binary runs). Disable RPATH
+# generation entirely so the installed binary stays bit-identical to
+# the linked one; runtime library resolution uses LD_LIBRARY_PATH from
+# the Conan run environment (VirtualRunEnv), matching the diffpdf
+# recipe's runtime model.
+set(CMAKE_SKIP_RPATH ON)
+
+add_executable(qmlrunner src/main.cpp)
+set_target_properties(qmlrunner PROPERTIES
+    SKIP_BUILD_RPATH TRUE
+    SKIP_INSTALL_RPATH TRUE
+)
+
+target_include_directories(qmlrunner PRIVATE
+    ${QMLRUNNER_QT5_INCLUDE_DIRS}
+)
+
+target_link_directories(qmlrunner PRIVATE
+    ${QMLRUNNER_QT5_LIB_DIRS}
+)
+
+target_link_libraries(qmlrunner PRIVATE
+    Qt5Widgets
+    Qt5Quick
+    Qt5Qml
+    Qt5Gui
+    Qt5Core
+)
+
+install(TARGETS qmlrunner DESTINATION bin)
