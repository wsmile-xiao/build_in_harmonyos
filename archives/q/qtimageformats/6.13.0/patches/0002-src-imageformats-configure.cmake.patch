--- a/src/imageformats/configure.cmake
+++ b/src/imageformats/configure.cmake
@@ -15,37 +15,58 @@
 
 
 
 #### Libraries
 
 qt_find_package(WrapJasper PROVIDED_TARGETS WrapJasper::WrapJasper MODULE_NAME imageformats
     QMAKE_LIB jasper
     VCPKG_PORT jasper
     VCPKG_ADD_TO_FEATURE jasper
 )
+# The Conan CMakeDeps config for jasper exports jasper::jasper, while Qt's
+# qt_find_package(WrapJasper PROVIDED_TARGETS WrapJasper::WrapJasper) expects
+# WrapJasper::WrapJasper. Alias the Conan target so the jp2 plugin builds.
+if(TARGET jasper::jasper AND NOT TARGET WrapJasper::WrapJasper)
+    add_library(WrapJasper::WrapJasper INTERFACE IMPORTED)
+    set_target_properties(WrapJasper::WrapJasper PROPERTIES INTERFACE_LINK_LIBRARIES jasper::jasper)
+endif()
 qt_find_package(TIFF PROVIDED_TARGETS TIFF::TIFF MODULE_NAME imageformats QMAKE_LIB tiff
     VCPKG_PORT tiff
     VCPKG_ADD_TO_FEATURE tiff
     VCPKG_DEFAULT_FEATURES OFF
 )
+# The Conan CMakeDeps config for libtiff exports TIFF::tiff (lowercase), while
+# Qt's qt_find_package(TIFF PROVIDED_TARGETS TIFF::TIFF) and the tiff plugin
+# expect TIFF::TIFF. Alias the Conan target so the plugin links it.
+if(TARGET TIFF::tiff AND NOT TARGET TIFF::TIFF)
+    add_library(TIFF::TIFF INTERFACE IMPORTED)
+    set_target_properties(TIFF::TIFF PROPERTIES INTERFACE_LINK_LIBRARIES TIFF::tiff)
+endif()
 # Threads::Threads might be brought in via a top-level CMakeLists.txt find_package dependency
 # in which case if the system WebpConfig.cmake depends Threads, it shouldn't try to promote it to
 # global to avoid a 'global promotion of a target in a different subdirectory' error.
 if(TARGET Threads::Threads)
     qt_internal_disable_find_package_global_promotion(Threads::Threads)
 endif()
 qt_find_package(WrapWebP PROVIDED_TARGETS WrapWebP::WrapWebP MODULE_NAME imageformats
     QMAKE_LIB webp
     VCPKG_PORT libwebp
     VCPKG_ADD_TO_FEATURE webp
 )
 qt_find_package(Libmng PROVIDED_TARGETS Libmng::Libmng MODULE_NAME imageformats QMAKE_LIB mng)
+# The Conan CMakeDeps config for libmng exports libmng::libmng, while Qt's
+# qt_find_package(Libmng PROVIDED_TARGETS Libmng::Libmng) expects Libmng::Libmng.
+# Alias the Conan target so the mng plugin builds.
+if(TARGET libmng::libmng AND NOT TARGET Libmng::Libmng)
+    add_library(Libmng::Libmng INTERFACE IMPORTED)
+    set_target_properties(Libmng::Libmng PROPERTIES INTERFACE_LINK_LIBRARIES libmng::libmng)
+endif()
 
 
