     add_definitions(-DENABLE_ENCODER_GENERIC -DENABLE_ENCODER_QR_CODE)
 endif(QZXING_USE_ENCODER)
 
-add_library(qzxing "" ${SOURCES})
+# OHOS adaptation: conan CMakeDeps sets no QT_VERSION_MAJOR, so CMake's
+# AUTOMOC cannot detect Qt5 (it disables itself with a dev warning).
+# qt5-qtbase ships bin/moc; the recipe passes its absolute path via the
+# QZXING_MOC_PATH cache variable. Run moc explicitly on the Q_OBJECT
+# headers so the shared library carries its metaobjects (a shared lib
+# linked without them would leave QZXing::staticMetaObject undefined at
+# load time).
+if(DEFINED QZXING_MOC_PATH AND NOT QZXING_MOC_PATH STREQUAL "")
+    set(QZXING_MOC ${QZXING_MOC_PATH})
+else()
+    find_program(QZXING_MOC moc)
+endif()
+if(NOT QZXING_MOC)
+    message(FATAL_ERROR "moc not found (qt5-qtbase bin dir must be on PATH)")
+endif()
+set(QZXING_MOC_OUT
+    ${CMAKE_CURRENT_BINARY_DIR}/moc_QZXing.cpp
+    ${CMAKE_CURRENT_BINARY_DIR}/moc_ImageHandler.cpp)
+add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/moc_QZXing.cpp
+    COMMAND ${QZXING_MOC}
+            -DENABLE_ENCODER_GENERIC -DENABLE_ENCODER_QR_CODE
+            ${CMAKE_CURRENT_SOURCE_DIR}/QZXing.h
+            -o ${CMAKE_CURRENT_BINARY_DIR}/moc_QZXing.cpp
+    DEPENDS QZXing.h)
+add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/moc_ImageHandler.cpp
+    COMMAND ${QZXING_MOC}
+            ${CMAKE_CURRENT_SOURCE_DIR}/ImageHandler.h
+            -o ${CMAKE_CURRENT_BINARY_DIR}/moc_ImageHandler.cpp
+    DEPENDS ImageHandler.h)
+LIST(APPEND SOURCES ${QZXING_MOC_OUT})
+
+add_library(qzxing SHARED ${SOURCES})
+set_target_properties(qzxing PROPERTIES VERSION 3.3.0 SOVERSION 3)
+target_compile_definitions(qzxing PRIVATE QZXING_LIBRARY)
 
