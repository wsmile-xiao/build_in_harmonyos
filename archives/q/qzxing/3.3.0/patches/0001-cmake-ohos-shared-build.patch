+# OHOS adaptation: consume the qt5-qtbase root config generated by
+# CMakeDeps. It declares the Qt5::Core / Qt5::Gui / Qt5::Concurrent
+# component targets and resolves the transitive dependencies; no
+# per-module Qt5Core-config.cmake files are generated (conan 2
+# CMakeDeps), and the native Qt5 umbrella configs (Qt5Config.cmake) are
+# not relocatable: Qt5CoreConfig bakes the build machine's mkspecs path.
+find_package(qt5-qtbase REQUIRED)
+if(QZXING_MULTIMEDIA)
+    find_package(Qt5Multimedia)
+endif()
+if(QZXING_USE_QML)
+    find_package(Qt5Svg REQUIRED)
+    find_package(Qt5Quick REQUIRED)
+    find_package(Qt5QuickControls2 REQUIRED)
+endif()
 
