 #include <stdarg.h>
 #include <stdlib.h>
 #include <unistd.h>
+#include <sys/ioctl.h>
 #include <sys/time.h>
 #include "qperf.h"
 
 
 /*
+ * socket_atmark -- out-of-band mark state of a socket.
+ *
+ * sockatmark(3) is declared by the glibc/macOS <sys/socket.h>, but the
+ * OpenHarmony C library provides neither a declaration anywhere under the SDK
+ * sysroot include tree nor a libc.so symbol, while the SIOCATMARK ioctl it is
+ * specified in terms of *is* provided (<bits/ioctl.h>).  Issue that ioctl
+ * directly -- the same operation the POSIX wrapper performs, and the same
+ * fallback musl uses -- and keep the POSIX call where it is available.
+ */
+static int
+socket_atmark(int fd)
+{
+#ifdef SIOCATMARK
+	int atmark = 0;
+
+	if (ioctl(fd, SIOCATMARK, &atmark) < 0)
+		return -1;
+	return atmark;
+#else
+	return sockatmark(fd);
+#endif
+}
+
+
+/*
  * Configurable parameters.
  */
 #define ERROR_TIMEOUT   3               /* Error timeout in seconds */
