--- a/src/qperf.c
+++ b/src/qperf.c
@@ -1556,7 +1556,32 @@
 
     if (ioctl(RemoteFD, FIONBIO, &one) < 0)
         error(SYS, "ioctl FIONBIO failed");
-    if (fcntl(RemoteFD, F_SETOWN, getpid()) < 0)
+
+    /*
+     * Socket I/O ownership is best effort here.
+     *
+     * F_SETOWN only picks the process that later SIGIO notifications go to,
+     * and this program never arms the notification it belongs to: O_ASYNC is
+     * never set on RemoteFD and no SIGIO handler is installed, so nothing
+     * consumes the ownership this call establishes.  Dropping the hard
+     * failure therefore cannot alter a measurement.
+     *
+     * Some kernels implement no signal-ownership fcntl at all.  Measured on
+     * HarmonyOS (HongMeng Kernel 1.12.0, aarch64) with a standalone probe
+     * that contains no qperf code: on both AF_INET/SOCK_STREAM and
+     * AF_INET/SOCK_DGRAM, F_SETOWN, F_SETOWN_EX and F_SETSIG each return -1
+     * with EINVAL and F_GETOWN returns -22, while ioctl(FIONBIO) on the very
+     * same descriptor succeeds; on a regular file those four commands fail
+     * with ENOTSUP.  Treating that as fatal aborted every socket transport
+     * with "fcntl F_SETOWN failed: Invalid argument" before one byte was
+     * exchanged, even though the transport itself works.
+     *
+     * Still request ownership, but abort only on a failure that does not
+     * mean "not implemented", so genuine misuse keeps surfacing.  Where
+     * F_SETOWN succeeds the behaviour is unchanged.
+     */
+    if (fcntl(RemoteFD, F_SETOWN, getpid()) < 0 &&
+        errno != EINVAL && errno != ENOTSUP)
         error(SYS, "fcntl F_SETOWN failed");
 }
 
