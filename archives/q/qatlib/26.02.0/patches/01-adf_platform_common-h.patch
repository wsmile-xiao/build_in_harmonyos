--- a/quickassist/lookaside/access_layer/src/qat_direct/include/adf_platform_common.h
+++ b/quickassist/lookaside/access_layer/src/qat_direct/include/adf_platform_common.h
@@ -195,7 +195,7 @@
     } while (0);
 #define adf_memcpy64 adf_memcpy64_64
 #define adf_memcpy128 adf_memcpy64_128
-#else
+#elif defined(__i386__)
 /*
  * 32bit versions of fast memcpy
  */
@@ -243,6 +243,17 @@
     } while (0);
 #define adf_memcpy64 adf_memcpy32_64
 #define adf_memcpy128 adf_memcpy32_128
+#else
+/*
+ * OHOS / non-x86 fallback: the two branches above are both x86 inline
+ * assembly (SSE2 movdqu + %%rsi/%%rdi or %%esi/%%edi), so neither
+ * compiles on aarch64.  The only callers pass contiguous ring
+ * buffers, so a plain memcpy is equivalent and lets the library
+ * build on other architectures.
+ */
+#include <string.h>
+#define adf_memcpy64(dst, src)  memcpy((dst), (src), 64)
+#define adf_memcpy128(dst, src) memcpy((dst), (src), 128)
 #endif
 
 /* modulo function that doesn't use slow divide operation */
