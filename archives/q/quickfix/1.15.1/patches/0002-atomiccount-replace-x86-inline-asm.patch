--- a/src/C++/AtomicCount.h
+++ b/src/C++/AtomicCount.h
@@ -156,18 +156,12 @@
       // *pw += dv;
       // return r;
 
-      int r;
-
-      __asm__ __volatile__
-        (
-          "lock\n\t"
-          "xadd %1, %0":
-          "+m"(*pw), "=r"(r) : // outputs (%0, %1)
-          "1"(dv) : // inputs (%2 == %1)
-          "memory", "cc" // clobbers
-        );
-
-      return r;
+      // OHOS port: the original 486+/AMD64 inline asm ("lock; xadd") is
+      // x86-only and does not assemble on aarch64.  The __atomic_fetch_add
+      // builtin returns the PRE-modification value and provides the same
+      // full barrier as the original "memory", "cc" clobber list, so the
+      // exchange-and-add semantics are preserved on every GCC/clang target.
+      return __atomic_fetch_add(pw, dv, __ATOMIC_SEQ_CST);
     }
   };
 
