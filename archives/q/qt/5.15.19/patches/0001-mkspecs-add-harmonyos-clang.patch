diff -ruN a/qtbase/mkspecs/harmonyos-clang/qmake.conf b/qtbase/mkspecs/harmonyos-clang/qmake.conf
--- /dev/null
+++ b/qtbase/mkspecs/harmonyos-clang/qmake.conf
@@ -0,0 +1,18 @@
+# qmake configuration for native HarmonyOS clang builds.
+
+MAKEFILE_GENERATOR = UNIX
+CONFIG += incremental
+
+QMAKE_INCREMENTAL_STYLE = sublib
+QMAKE_LN_SHLIB = cp -f
+
+include(../common/linux.conf)
+include(../common/gcc-base-unix.conf)
+include(../common/clang.conf)
+
+QMAKE_PLATFORM += harmonyos ohos
+DEFINES += QT_NO_PTHREAD_CANCEL QT_NO_ARM_AES_INTRINSICS
+
+QMAKE_LFLAGS += -ccc-gcc-name g++
+
+load(qt_config)
