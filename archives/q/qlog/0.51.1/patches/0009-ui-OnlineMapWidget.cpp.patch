+OnlineMapWidget::~OnlineMapWidget()
+{
+    FCT_IDENTIFICATION;
+}
+
+void OnlineMapWidget::assignPropConditions(PropConditions *in_prop)
+{
+    FCT_IDENTIFICATION;
+
+    qCDebug(runtime) << "Prop conditions overlay is not supported by the offline map";
+    prop_cond = in_prop;
+}
+
+void OnlineMapWidget::registerContactWidget(const NewContactWidget *in_contact)
+{
+    FCT_IDENTIFICATION;
+
+    contact = in_contact;
+}
