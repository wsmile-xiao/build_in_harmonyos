+void OnlineMapWidget::flyToMyQTH()
+{
+    FCT_IDENTIFICATION;
+
+    const Gridsquare myGrid = Gridsquare::mapDisplayGrid(
+        StationProfilesManager::instance()->getCurProfile1().locator);
+
+    if ( myGrid.isValid() )
+        MapWidget::setTarget(myGrid.getLatitude(), myGrid.getLongitude());
+}
+
+void OnlineMapWidget::drawChatUsers(const QList<KSTUsersInfo> &list)
+{
+    FCT_IDENTIFICATION;
+    Q_UNUSED(list)
+    qCDebug(runtime) << "Chat user overlay is not supported by the offline map";
+}
+
+void OnlineMapWidget::drawWSJTXSpot(const WsjtxEntry &spot)
+{
+    FCT_IDENTIFICATION;
+
+    const Gridsquare spotGrid = Gridsquare::mapDisplayGrid(spot.grid);
+
+    if ( spotGrid.isValid() )
+        addPoint(spotGrid.getLatitude(), spotGrid.getLongitude());
+}
