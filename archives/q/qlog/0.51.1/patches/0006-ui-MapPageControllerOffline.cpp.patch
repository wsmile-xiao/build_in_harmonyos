--- /dev/null
+++ b/ui/MapPageControllerOffline.cpp
@@ -0,0 +1,280 @@
+#include "MapPageController.h"
+
+#include <QDateTime>
+
+#include "core/debug.h"
+#include "ui/MapWidget.h"
+
+MODULE_IDENTIFICATION("qlog.ui.mappagecontroller");
+
+/*
+ * OHOS adaptation (QLOG_NO_WEBENGINE): offline fallback implementation of
+ * MapPageController. The interactive Leaflet web map (QtWebEngine +
+ * QtWebChannel) is replaced by the bundled offline MapWidget (QGraphicsView
+ * NASA blue-marble world map). Point/home-point drawing, QSO short paths and
+ * the great-circle target line are rendered through MapWidget's public
+ * drawing API; web-only features (layer selection, grid heat layers, chat
+ * click-through, IBP beacons, aurora/MUF overlays, static map time, dark
+ * theme) degrade gracefully and only emit a debug message.
+ */
+
+MapPageController::MapPageController(const QString &inConfigID,
+                                     QObject *parent) :
+    QObject(parent),
+    mapWidget(nullptr),
+    mapLayers(MapLayer::Layers())
+{
+    FCT_IDENTIFICATION;
+    Q_UNUSED(inConfigID)
+}
+
+MapPageController::~MapPageController()
+{
+    FCT_IDENTIFICATION;
+}
+
+void MapPageController::attach(QWidget *view,
+                               MapLayer::Layers layers)
+{
+    FCT_IDENTIFICATION;
+
+    mapWidget = qobject_cast<MapWidget*>(view);
+    mapLayers = layers;
+
+    if ( !mapWidget )
+    {
+        qCDebug(runtime) << "Attached view is not a MapWidget — offline map unavailable";
+        return;
+    }
+
+    mapWidget->clearPoints();
+    emit loaded();
+}
+
+void MapPageController::setDarkTheme(bool isDark)
+{
+    FCT_IDENTIFICATION;
+    qCDebug(runtime) << "Dark theme is not supported by the offline map:" << isDark;
+}
+
+void MapPageController::setStaticMapTime(const QDateTime &dateTime)
+{
+    FCT_IDENTIFICATION;
+    qCDebug(runtime) << "Static map time is not supported by the offline map:" << dateTime;
+}
+
+void MapPageController::drawPoints(const QList<MapPoint> &points)
+{
+    FCT_IDENTIFICATION;
+
+    if ( !mapWidget )
+        return;
+
+    mapWidget->clearPoints();
+    for ( const MapPoint &point : points )
+        mapWidget->addPoint(point.coordinate.latitude, point.coordinate.longitude);
+}
+
+void MapPageController::drawPointsBusy(const QList<MapPoint> &points,
+                                       const QString &text)
+{
+    FCT_IDENTIFICATION;
+    Q_UNUSED(text)
+    drawPoints(points);
+}
+
+void MapPageController::drawPointsAndShortPathsBusy(const QList<MapPoint> &points,
+                                                    const QList<MapPath> &paths,
+                                                    const QString &text)
+{
+    FCT_IDENTIFICATION;
+    Q_UNUSED(text)
+
+    if ( !mapWidget )
+        return;
+
+    mapWidget->clearPoints();
+    for ( const MapPoint &point : points )
+        mapWidget->addPoint(point.coordinate.latitude, point.coordinate.longitude);
+    for ( const MapPath &path : paths )
+        mapWidget->addLine(path.from.latitude, path.from.longitude,
+                           path.to.latitude, path.to.longitude);
+}
+
+void MapPageController::drawHomePoints(const QList<MapPoint> &points)
+{
+    FCT_IDENTIFICATION;
+
+    if ( !mapWidget )
+        return;
+
+    for ( const MapPoint &point : points )
+        mapWidget->addHomePoint(point.coordinate.latitude, point.coordinate.longitude);
+}
+
+void MapPageController::drawChatPoints(const QList<MapPoint> &points)
+{
+    FCT_IDENTIFICATION;
+    drawPoints(points);
+}
+
+void MapPageController::flyToPoint(const MapPoint &point, int zoom)
+{
+    FCT_IDENTIFICATION;
+
+    if ( !mapWidget )
+        return;
+
+    qCDebug(runtime) << "Zoom is ignored by the offline map:" << zoom;
+    mapWidget->setTarget(point.coordinate.latitude, point.coordinate.longitude);
+}
+
+void MapPageController::drawPath(const QList<MapCoordinate> &points)
+{
+    FCT_IDENTIFICATION;
+
+    if ( !mapWidget || points.isEmpty() )
+        return;
+
+    for ( int i = 1; i < points.size(); i++ )
+        mapWidget->addLine(points[i-1].latitude, points[i-1].longitude,
+                           points[i].latitude, points[i].longitude);
+}
+
+void MapPageController::clearPath()
+{
+    FCT_IDENTIFICATION;
+
+    if ( mapWidget )
+        mapWidget->clearPoints();
+}
+
+void MapPageController::drawShortPaths(const QList<MapPath> &paths)
+{
+    FCT_IDENTIFICATION;
+
+    if ( !mapWidget )
+        return;
+
+    for ( const MapPath &path : paths )
+        mapWidget->addLine(path.from.latitude, path.from.longitude,
+                           path.to.latitude, path.to.longitude);
+}
+
+void MapPageController::drawShortPathsBusy(const QList<MapPath> &paths,
+                                           const QString &text)
+{
+    FCT_IDENTIFICATION;
+    Q_UNUSED(text)
+    drawShortPaths(paths);
+}
+
+void MapPageController::drawAntPath(const MapCoordinate &from,
+                                    double distance,
+                                    double azimuth,
+                                    double antAngle)
+{
+    FCT_IDENTIFICATION;
+    qCDebug(runtime) << "Antenna path is not supported by the offline map:"
+                     << from.latitude << from.longitude << distance << azimuth << antAngle;
+}
+
+void MapPageController::clearAntPath()
+{
+    FCT_IDENTIFICATION;
+}
+
+void MapPageController::setGridLayers(const QStringList &confirmedGrids,
+                                      const QStringList &workedGrids)
+{
+    FCT_IDENTIFICATION;
+    qCDebug(runtime) << "Grid layers are not supported by the offline map:"
+                     << confirmedGrids.size() << workedGrids.size();
+}
+
+void MapPageController::clearGridLayers()
+{
+    FCT_IDENTIFICATION;
+}
+
+void MapPageController::redrawGridLayer()
+{
+    FCT_IDENTIFICATION;
+}
+
+void MapPageController::invalidateSize()
+{
+    FCT_IDENTIFICATION;
+
+    /* MapWidget refits the scene in its resizeEvent()/showEvent(); nothing
+     * else to invalidate here. */
+}
+
+void MapPageController::panToBoundsLongitudeCenter(const QList<MapCoordinate> &coordinates)
+{
+    FCT_IDENTIFICATION;
+    qCDebug(runtime) << "Panning is not supported by the offline map:" << coordinates.size();
+}
+
+void MapPageController::setAuroraData(const QList<MapHeatPoint> &points)
+{
+    FCT_IDENTIFICATION;
+    qCDebug(runtime) << "Aurora overlay is not supported by the offline map:" << points.size();
+}
+
+void MapPageController::drawMuf(const QList<MapPoint> &points)
+{
+    FCT_IDENTIFICATION;
+    qCDebug(runtime) << "MUF overlay is not supported by the offline map:" << points.size();
+}
+
+void MapPageController::setCurrentBand(const QString &band)
+{
+    FCT_IDENTIFICATION;
+    qCDebug(runtime) << "Band overlay is not supported by the offline map:" << band;
+}
+
+void MapPageController::addWsjtxSpot(const MapPoint &point,
+                                     const QString &color,
+                                     const QString &textColor)
+{
+    FCT_IDENTIFICATION;
+    Q_UNUSED(color)
+    Q_UNUSED(textColor)
+
+    if ( mapWidget )
+        mapWidget->addPoint(point.coordinate.latitude, point.coordinate.longitude);
+}
+
+void MapPageController::clearWsjtxSpots()
+{
+    FCT_IDENTIFICATION;
+}
+
+void MapPageController::handleLayerSelectionChanged(const QVariant &data,
+                                                    const QVariant &state)
+{
+    FCT_IDENTIFICATION;
+    Q_UNUSED(data)
+    Q_UNUSED(state)
+}
+
+void MapPageController::chatCallsignClicked(const QVariant &data)
+{
+    FCT_IDENTIFICATION;
+    Q_UNUSED(data)
+}
+
+void MapPageController::wsjtxCallsignClicked(const QVariant &data)
+{
+    FCT_IDENTIFICATION;
+    Q_UNUSED(data)
+}
+
+void MapPageController::IBPCallsignClicked(const QVariant &callsign,
+                                           const QVariant &freq)
+{
+    FCT_IDENTIFICATION;
+    Q_UNUSED(callsign)
+    Q_UNUSED(freq)
+}
