+// Compare the digit runs starting at i and j. Returns -1/0/1 when the runs
+// decide the order, or 2 when the runs are numerically equal and the caller
+// must continue with the following characters. Advances i and j past both
+// runs.
+static int compareDigitRuns(QStringView s1, qsizetype &i, QStringView s2,
+                            qsizetype &j)
+{
+    qsizetype start1 = i;
+    qsizetype start2 = j;
+    while (i < s1.size() && s1.at(i).isDigit())
+        ++i;
+    while (j < s2.size() && s2.at(j).isDigit())
+        ++j;
+    const qsizetype end1 = i;
+    const qsizetype end2 = j;
+    // Skip leading zeros so the effective run lengths decide by magnitude.
+    while (start1 < end1 - 1 && s1.at(start1) == u'0')
+        ++start1;
+    while (start2 < end2 - 1 && s2.at(start2) == u'0')
+        ++start2;
+    const qsizetype length1 = end1 - start1;
+    const qsizetype length2 = end2 - start2;
+    if (length1 != length2)
+        return length1 < length2 ? -1 : 1;
+    for (qsizetype offset = 0; offset < length1; ++offset) {
+        const char16_t left = s1.at(start1 + offset).unicode();
+        const char16_t right = s2.at(start2 + offset).unicode();
+        if (left != right)
+            return left < right ? -1 : 1;
+    }
+    return 2;
+}
