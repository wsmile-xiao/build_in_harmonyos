+QStringList QFreeTypeFontDatabase::fallbacksForFamily(const QString &family, QFont::Style style,
+        QFont::StyleHint styleHint, QFontDatabasePrivate::ExtendedScript script) const
+{
+    QStringList result = QPlatformFontDatabase::fallbacksForFamily(family, style, styleHint, script);
+    if (script != QFontDatabasePrivate::Script_Common
+            && script != QFontDatabasePrivate::Script_Latin)
+        return result;
+
+    QStringList preferred;
+    if (styleHint == QFont::Monospace || styleHint == QFont::TypeWriter
+            || family.compare("monospace"_L1, Qt::CaseInsensitive) == 0) {
+        for (const QString &candidate : result) {
+            if (QFontDatabase::isFixedPitch(candidate)
+                    && QFontDatabase::writingSystems(candidate).contains(QFontDatabase::Latin))
+                preferred.append(candidate);
+        }
+    } else if (styleHint == QFont::Serif) {
+        preferred = {"Noto Serif"_L1, "DejaVu Serif"_L1, "Liberation Serif"_L1};
+    } else {
+        preferred = {"HarmonyOS Sans"_L1, "Noto Sans"_L1, "DejaVu Sans"_L1,
+                     "Roboto"_L1, "Liberation Sans"_L1};
+    }
+    QStringList ordered;
+    for (const QString &candidate : preferred) {
+        if (result.removeAll(candidate))
+            ordered.append(candidate);
+    }
+    return ordered + result;
+}

