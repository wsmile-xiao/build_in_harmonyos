-    username = getpwuid(geteuid())->pw_name;
+    /*
+     * getpwuid() returns NULL when the current uid has no /etc/passwd entry
+     * (HarmonyOS app/container uids such as 20020085 are not listed).
+     * Fall back to $LOGNAME/$USER and then to a fixed name so that we never
+     * dereference a NULL struct passwd.
+     */
+    struct passwd * q_passwd_entry = getpwuid(geteuid());
+    username = (q_passwd_entry != NULL) ? q_passwd_entry->pw_name
+        : getenv("LOGNAME");
+    if (username == NULL) {
+        username = getenv("USER");
+    }
+    if (username == NULL) {
+        username = "qodem";
+    }
     mbstowcs(value_wchar, username, strlen(username) + 1);
