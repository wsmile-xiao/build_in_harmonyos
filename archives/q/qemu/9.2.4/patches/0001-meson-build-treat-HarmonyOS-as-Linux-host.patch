 host_os = host_machine.system()
+# HarmonyOS sits on a Linux-compatible kernel (musl libc, /proc, and its C
+# compilers define __linux__), which QEMU's own configure already relies on
+# when it resolves host_os=linux.  meson probes the system name through
+# Python instead and reports 'harmonyos', so normalise it here to keep both
+# halves of the build system in agreement.
+if host_os == 'harmonyos'
+  host_os = 'linux'
+endif
