diff --git a/include/linux/qrtr.h b/include/linux/qrtr.h
new file mode 100644
index 0000000..7dd0199
--- /dev/null
+++ b/include/linux/qrtr.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _LINUX_QRTR_H
+#define _LINUX_QRTR_H
+
+#include <linux/types.h>
+
+#define QRTR_NODE_BCAST	0xffffffffu
+#define QRTR_PORT_CTRL	0xfffffffeu
+
+struct sockaddr_qrtr {
+	unsigned short sq_family;
+	__u32 sq_node;
+	__u32 sq_port;
+};
+
+enum qrtr_pkt_type {
+	QRTR_TYPE_DATA		= 1,
+	QRTR_TYPE_HELLO		= 2,
+	QRTR_TYPE_BYE		= 3,
+	QRTR_TYPE_NEW_SERVER	= 4,
+	QRTR_TYPE_DEL_SERVER	= 5,
+	QRTR_TYPE_DEL_CLIENT	= 6,
+	QRTR_TYPE_RESUME_TX	= 7,
+	QRTR_TYPE_EXIT		= 8,
+	QRTR_TYPE_PING		= 9,
+	QRTR_TYPE_NEW_LOOKUP	= 10,
+	QRTR_TYPE_DEL_LOOKUP	= 11,
+};
+
+struct qrtr_ctrl_pkt {
+	__le32 cmd;
+
+	union {
+		struct {
+			__le32 service;
+			__le32 instance;
+			__le32 node;
+			__le32 port;
+		} server;
+
+		struct {
+			__le32 node;
+			__le32 port;
+		} client;
+	};
+} __attribute__((packed));
+
+#endif /* _LINUX_QRTR_H */
diff --git a/include/linux/socket.h b/include/linux/socket.h
new file mode 100644
index 0000000..fdbb48d
--- /dev/null
+++ b/include/linux/socket.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _LINUX_SOCKET_H
+#define _LINUX_SOCKET_H
+
+/*
+ * Keep the socket address declarations in sys/socket.h and expose only
+ * the kernel family typedef required by Linux UAPI headers.  This avoids
+ * the duplicate sockaddr_storage definition without hiding the libc ABI.
+ */
+#include <sys/socket.h>
+
+typedef unsigned short __kernel_sa_family_t;
+
+#endif /* _LINUX_SOCKET_H */
