--- a/src/main.cpp
+++ b/src/main.cpp
@@ -7,20 +7,32 @@
 #include <iostream>
 #include <ostream>
 #include <unistd.h>
 
 int main(int argc, char *argv[])
 {
     bool isHeadless = false;
     QString devicePath;
 
     for (int i = 1; i < argc; ++i) {
+        // 上游只实现了 --ascii-view；补齐 --version/--help 的无 GUI 早期退出
+        // 分支，供 CI 冒烟检查（L2）与用户自检使用：两个分支都在
+        // QApplication 构造之前返回，因此不依赖显示服务器 / Qt 平台插件。
+        if (QString(argv[i]) == "--version") {
+            std::cout << "QDiskInfo " << PROJECT_VERSION_MAJOR << "." << PROJECT_VERSION_MINOR << std::endl;
+            return 0;
+        }
+        if (QString(argv[i]) == "--help" || QString(argv[i]) == "-h") {
+            std::cout << "Usage: QDiskInfo [--ascii-view <device>]" << std::endl;
+            std::cout << "       QDiskInfo --version" << std::endl;
+            return 0;
+        }
         if (QString(argv[i]) == "--ascii-view") {
             isHeadless = true;
             if (i + 1 < argc) {
                 devicePath = argv[i + 1];
             } else {
                 std::cerr << "Error: Missing device path after --ascii-view" << std::endl;
                 return 1;
             }
             break;
         }
