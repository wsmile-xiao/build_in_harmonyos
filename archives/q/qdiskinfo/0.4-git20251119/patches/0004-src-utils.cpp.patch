+QString utils::getSmartctlPath() {
+    return findExecutable("smartctl");
+}
+
+QString utils::getPrivilegeElevator()
+{
+    // HarmonyOS PC 没有 polkit/pkexec。返回空串表示“无提权器可用”，
+    // 调用方应直接执行目标命令，而不是让 QProcess 启动失败后静默返回空结果。
+    return findExecutable("pkexec");
+}
+
+void utils::startProcess(QProcess &process, const QString &program, const QStringList &arguments, bool root)
+{
+    if (program.isEmpty()) {
+        return;
+    }
+
+    const QString elevator = root ? getPrivilegeElevator() : QString();
+
+    if (elevator.isEmpty()) {
+        // 无提权器（HarmonyOS PC）或本来就不需要提权：直接执行，
+        // 权限由进程自身决定（例如以特权用户身份启动时可直接访问磁盘）。
+        process.start(program, arguments);
+    } else {
+        process.start(elevator, QStringList{program} + arguments);
+    }
+}
