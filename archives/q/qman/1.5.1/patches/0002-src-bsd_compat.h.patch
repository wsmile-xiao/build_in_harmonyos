diff -ruN /dev/null b/src/bsd_compat.h
--- /dev/null
+++ b/src/bsd_compat.h
@@ -0,0 +1,21 @@
+// BSD compatibility functions for HarmonyOS
+// Provides: wcslcpy, wcslcat, strcasestr
+// These are BSD extensions not available in musl/Bionic libc
+
+#ifndef BSD_COMPAT_H
+#define BSD_COMPAT_H
+
+#include <wchar.h>
+#include <string.h>
+#include <ctype.h>
+
+// Size-bounded wide string copy (BSD extension)
+size_t wcslcpy(wchar_t *dst, const wchar_t *src, size_t size);
+
+// Size-bounded wide string concatenation (BSD extension)
+size_t wcslcat(wchar_t *dst, const wchar_t *src, size_t size);
+
+// Case-insensitive substring search (BSD/GNU extension)
+char *strcasestr(const char *haystack, const char *needle);
+
+#endif
