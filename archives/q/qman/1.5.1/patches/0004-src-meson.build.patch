diff -ruN a/src/meson.build b/src/meson.build
--- a/src/meson.build
+++ b/src/meson.build
@@ -18,31 +18,35 @@
 config_c = custom_target('config.c',
   input: 'config.c.cog',
   output: 'config.c',
   command: cog_cmd
 )
 
 # Non-main sources
 src = [
   config_h,
   config_c,
+  'bsd_compat.c',
   'util.c',
   'eini.c',
   'base64.c',
   'program.c',
   'cli.c',
   'tui.c'
 ]
 
 # Dependencies
+# ncursesw: use static library on HarmonyOS (stub .so lacks symbols)
+ncursesw_libdir = get_option('prefix') + '/lib'
+ncursesw = cc.find_library('ncursesw', dirs: [ncursesw_libdir], static: true)
 deps = [
-  dependency('ncursesw', required: true),
+  ncursesw,
 ]
 if get_option('libbsd').enabled() or get_option('libbsd').auto()
   libbsd = dependency('libbsd-overlay', required: true)
   deps += [libbsd]
 endif
 if get_option('gzip').enabled() or get_option('gzip').auto()
   gzip = dependency('zlib', required: true)
   deps += [gzip]
   add_global_arguments('-DQMAN_GZIP=true', language: 'c')
 endif
