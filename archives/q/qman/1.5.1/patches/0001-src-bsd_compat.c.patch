diff -ruN /dev/null b/src/bsd_compat.c
--- /dev/null
+++ b/src/bsd_compat.c
@@ -0,0 +1,69 @@
+// BSD compatibility functions for HarmonyOS
+// Provides: wcslcpy, wcslcat, strcasestr
+// These are BSD extensions not available in musl/Bionic libc
+
+#include "bsd_compat.h"
+
+// wcslcpy: Size-bounded wide string copy
+// Copies at most size-1 characters from src to dst, null-terminates.
+// Returns the length of src (like strlcpy but for wchar_t).
+size_t wcslcpy(wchar_t *dst, const wchar_t *src, size_t size) {
+  size_t srclen = wcslen(src);
+  if (size == 0) {
+    return srclen;
+  }
+  if (srclen < size) {
+    wmemcpy(dst, src, srclen + 1);  // includes null terminator
+  } else {
+    wmemcpy(dst, src, size - 1);
+    dst[size - 1] = L'\0';
+  }
+  return srclen;
+}
+
+// wcslcat: Size-bounded wide string concatenation
+// Appends at most size-wcslen(dst)-1 characters from src to dst, null-terminates.
+// Returns the total length of the string they tried to create.
+size_t wcslcat(wchar_t *dst, const wchar_t *src, size_t size) {
+  size_t dstlen = wcslen(dst);
+  size_t srclen = wcslen(src);
+  if (dstlen >= size) {
+    return dstlen + srclen;
+  }
+  if (srclen < size - dstlen) {
+    wmemcpy(dst + dstlen, src, srclen + 1);
+  } else {
+    wmemcpy(dst + dstlen, src, size - dstlen - 1);
+    dst[size - 1] = L'\0';
+  }
+  return dstlen + srclen;
+}
+
+// strcasestr: Case-insensitive substring search
+// Finds the first occurrence of needle in haystack, ignoring case.
+char *strcasestr(const char *haystack, const char *needle) {
+  if (!needle || !needle[0]) {
+    return (char *)haystack;
+  }
+  if (!haystack) {
+    return NULL;
+  }
+  size_t needle_len = strlen(needle);
+  for (; *haystack; haystack++) {
+    if (tolower((unsigned char)*haystack) == tolower((unsigned char)needle[0])) {
+      size_t i;
+      for (i = 1; i < needle_len; i++) {
+        if (!haystack[i]) {
+          return NULL;
+        }
+        if (tolower((unsigned char)haystack[i]) != tolower((unsigned char)needle[i])) {
+          break;
+        }
+      }
+      if (i == needle_len) {
+        return (char *)haystack;
+      }
+    }
+  }
+  return NULL;
+}
