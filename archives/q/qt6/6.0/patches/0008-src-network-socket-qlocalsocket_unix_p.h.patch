+#ifndef QLOCALSOCKET_UNIX_P_H
+#define QLOCALSOCKET_UNIX_P_H
+
+#if defined(QT_BUILD_HARMONYOS_LOCAL_SOCKETS)
+
+#include "qnet_unix_p.h"
+
+#include <QtCore/qcryptographichash.h>
+#include <QtCore/qdir.h>
+#include <QtCore/qfile.h>
+#include <QtCore/qstring.h>
+
+#include <sys/un.h>
+#include <unistd.h>
+#include <stddef.h>
+#include <string.h>
+
+QT_BEGIN_NAMESPACE
+
+static inline bool qt_harmonyos_local_socket_address(const QString &serverName,
+                                                     sockaddr_un *address,
+                                                     QT_SOCKLEN_T *addressLength,
+                                                     QString *displayName,
+                                                     bool acceptDisplayName = false)
+{
+    if (!address || !addressLength)
+        return false;
+    if (serverName.isEmpty())
+        return false;
+
+    QByteArray key;
+    if (acceptDisplayName && serverName.startsWith(QLatin1String("@qt6:"))) {
+        const QByteArray encodedDisplayName = serverName.toLatin1();
+        if (QString::fromLatin1(encodedDisplayName) != serverName)
+            return false;
+
+        key = encodedDisplayName.mid(1);
+        const int uidSeparator = key.indexOf(':', 4);
+        if (!key.startsWith("qt6:") || uidSeparator <= 4)
+            return false;
+
+        const QByteArray uid = key.mid(4, uidSeparator - 4);
+        bool uidIsNumber = false;
+        const qulonglong displayUid = uid.toULongLong(&uidIsNumber, 10);
+        if (!uidIsNumber || uid != QByteArray::number(displayUid))
+            return false;
+
+        // A client may connect to a managed endpoint owned by another UID.
+        // The server checks SO_PEERCRED before admitting the connection.
+        const QByteArray hash = key.mid(uidSeparator + 1);
+        if (hash.size() != 64)
+            return false;
+        for (char digit : hash) {
+            if (!((digit >= '0' && digit <= '9') || (digit >= 'a' && digit <= 'f')))
+                return false;
+        }
+    } else {
+        const QString fullPath = QDir::cleanPath(QDir::tempPath() + QLatin1Char('/') + serverName);
+        const QByteArray encodedPath = QFile::encodeName(fullPath);
+        if (encodedPath.size() + 1 > int(sizeof(address->sun_path)))
+            return false;
+
+        const QByteArray uid = QByteArray::number(static_cast<qulonglong>(::geteuid()));
+        QByteArray hashInput = encodedPath;
+        hashInput.append('\0');
+        hashInput.append(uid);
+        key = QByteArray("qt6:") + uid + ':'
+                + QCryptographicHash::hash(hashInput, QCryptographicHash::Sha256).toHex();
+    }
+    if (key.size() + 1 > int(sizeof(address->sun_path)))
+        return false;
+
+    memset(address, 0, sizeof(*address));
+    address->sun_family = AF_UNIX;
+    memcpy(address->sun_path + 1, key.constData(), size_t(key.size()));
+    *addressLength = QT_SOCKLEN_T(offsetof(sockaddr_un, sun_path) + 1 + key.size());
+    if (displayName)
+        *displayName = QLatin1Char('@') + QString::fromLatin1(key);
+    return true;
+}
+
+QT_END_NAMESPACE
+
+#endif // defined(QT_BUILD_HARMONYOS_LOCAL_SOCKETS)
+
+#endif // QLOCALSOCKET_UNIX_P_H
