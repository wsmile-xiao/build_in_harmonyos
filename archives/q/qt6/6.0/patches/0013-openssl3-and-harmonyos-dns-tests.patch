         && !(_q_##func = _q_PTR_##func(libs.crypto->resolve(#func)))) \
         qsslSocketCannotResolveSymbolWarning(#func);
 
+// OpenSSL 3 renamed these symbols while keeping their signatures and behavior.
+#define RESOLVEFUNC_WITH_ALIAS(func, alias) \
+    if (!(_q_##func = _q_PTR_##func(libs.ssl->resolve(#func))) \
+        && !(_q_##func = _q_PTR_##func(libs.crypto->resolve(#func))) \
+        && !(_q_##func = _q_PTR_##func(libs.ssl->resolve(#alias))) \
+        && !(_q_##func = _q_PTR_##func(libs.crypto->resolve(#alias)))) \
+        qsslSocketCannotResolveSymbolWarning(#func);
+
 #if !defined QT_LINKED_OPENSSL
 
 #if !QT_CONFIG(library)
