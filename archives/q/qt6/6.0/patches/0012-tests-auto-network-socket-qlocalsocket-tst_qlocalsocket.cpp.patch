+void tst_QLocalSocket::managedAbstractNameAllowsDifferentClientUid()
+{
+#if defined(QT_BUILD_HARMONYOS_LOCAL_SOCKETS)
+    const qulonglong displayUid = static_cast<qulonglong>(::geteuid()) + 1;
+    const QByteArray hash = QByteArray::number(::getpid(), 16).rightJustified(64, '0');
+    const QByteArray key = QByteArray("qt6:") + QByteArray::number(displayUid) + ':' + hash;
+
+    sockaddr_un address {};
+    address.sun_family = AF_UNIX;
+    address.sun_path[0] = '\0';
+    ::memcpy(address.sun_path + 1, key.constData(), size_t(key.size()));
+    const socklen_t addressLength = socklen_t(offsetof(sockaddr_un, sun_path) + 1 + key.size());
+
+    const int listener = ::socket(AF_UNIX, SOCK_STREAM, 0);
+    QVERIFY2(listener != -1, "could not create native abstract AF_UNIX listener");
+    const int bindResult = ::bind(listener, reinterpret_cast<const sockaddr *>(&address), addressLength);
+    QVERIFY2(bindResult == 0, "could not bind native abstract AF_UNIX listener");
+    QVERIFY2(::listen(listener, 1) == 0, "could not listen on native abstract AF_UNIX socket");
+
+    QLocalSocket socket;
+    const QString displayName = QLatin1Char('@') + QString::fromLatin1(key);
+    socket.connectToServer(displayName);
+    QVERIFY2(socket.waitForConnected(3000), qPrintable(socket.errorString()));
+
+    const int accepted = ::accept(listener, nullptr, nullptr);
+    QVERIFY2(accepted != -1, "native listener did not receive the Qt client connection");
+    ::close(accepted);
+    socket.abort();
+    ::close(listener);
+#else
+    QSKIP("HarmonyOS managed abstract socket names are only enabled in this Qt build");
+#endif
+}
