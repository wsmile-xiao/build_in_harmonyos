     QString serverName = path + '/' + name;
+#if defined(QT_BUILD_HARMONYOS_LOCAL_SOCKETS)
+    QLocalServer::removeServer(serverName);
+    if (!server.listen(serverName)) {
+        QVERIFY(server.serverName().isEmpty());
+        QVERIFY(server.fullServerName().isEmpty());
+        QVERIFY(!server.errorString().isEmpty());
+
+        const QByteArray encodedServerName = QFile::encodeName(serverName);
+        sockaddr_un address {};
+        QVERIFY(encodedServerName.size() + 1 <= int(sizeof(address.sun_path)));
+        address.sun_family = AF_UNIX;
+        ::memcpy(address.sun_path, encodedServerName.constData(), encodedServerName.size() + 1);
+
+        const int nativeSocket = ::socket(PF_UNIX, SOCK_STREAM, 0);
+        QVERIFY(nativeSocket != -1);
+        const int nativeBindResult = ::bind(nativeSocket, (sockaddr *)&address,
+                                            sizeof(sockaddr_un));
+        const int nativeBindError = errno;
+        ::close(nativeSocket);
+        if (nativeBindResult == 0) {
+            ::unlink(encodedServerName.constData());
+            QFAIL("QLocalServer rejected an absolute pathname while native AF_UNIX bind succeeded");
+        }
+
+        const bool platformRejectedPathname = nativeBindError == EACCES
+                || nativeBindError == EPERM || nativeBindError == EAFNOSUPPORT
+                || nativeBindError == EPROTONOSUPPORT || nativeBindError == EOPNOTSUPP
+                || nativeBindError == EROFS || nativeBindError == ENOTDIR
+                || nativeBindError == ENOENT;
+        QVERIFY2(platformRejectedPathname,
+                 qPrintable(QStringLiteral("Native AF_UNIX pathname bind failed unexpectedly with errno %1")
+                            .arg(nativeBindError)));
+        QAbstractSocket::SocketError expectedQtError = QAbstractSocket::UnknownSocketError;
+        if (nativeBindError == EACCES)
+            expectedQtError = QAbstractSocket::SocketAccessError;
+        else if (nativeBindError == EROFS || nativeBindError == ENOTDIR
+                 || nativeBindError == ENOENT)
+            expectedQtError = QAbstractSocket::HostNotFoundError;
+        QCOMPARE(server.serverError(), expectedQtError);
+        QSKIP(qPrintable(QStringLiteral("HarmonyOS rejected absolute pathname AF_UNIX bind (errno %1; Qt: %2)")
+                         .arg(nativeBindError).arg(server.errorString())));
+    }
+#else
     QVERIFY2(server.listen(serverName), server.errorString().toLatin1().constData());
+#endif
     QCOMPARE(server.serverName(), serverName);
     QCOMPARE(server.fullServerName(), serverName);
 
