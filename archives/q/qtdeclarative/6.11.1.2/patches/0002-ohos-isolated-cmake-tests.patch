 function(add_aotstats_target_to_all)
     # Ensure aotstats generation happens when building the default "all" target
     set_target_properties(all_aotstats PROPERTIES EXCLUDE_FROM_ALL FALSE)
+    # Unix Makefiles do not pull generated byproducts across directory-scoped
+    # targets. Build the QML modules before aggregating their AOT statistics.
+    add_dependencies(module_normal_module_aotstats_target normal_module)
+    add_dependencies(module_nobindings_module_aotstats_target nobindings_module)
 endfunction()
