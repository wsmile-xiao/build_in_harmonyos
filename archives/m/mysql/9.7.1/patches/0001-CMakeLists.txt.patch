-IF(LINUX)
+# OHOS (HarmonyOS PC) portability: capability detection instead of platform
+# macros (repo rule R8). The probes check what the target libc actually
+# provides; the generated feature macros gate the small compat shims so that
+# any libc with the same shapes (e.g. musl-based ones) gets the same fixes.
+INCLUDE(CheckFunctionExists)
+
+# Some libcs (OHOS, musl-style) provide res_init()/res_search() in libc
+# itself and ship no libresolv; glibc needs -lresolv (handled below by the
+# FIND_LIBRARY(RESOLV_LIBRARY) path in libmysql/CMakeLists.txt).
+CHECK_FUNCTION_EXISTS(res_search HAVE_LIBC_RES_SEARCH)
+IF(HAVE_LIBC_RES_SEARCH)
+  ADD_DEFINITIONS(-DHAVE_LIBC_RES_SEARCH)
+ENDIF()
+
+# OHOS libc provides no pthread_cancel() at all; most other libcs do.
+SET(CMAKE_REQUIRED_LIBRARIES pthread)
+CHECK_FUNCTION_EXISTS(pthread_cancel HAVE_LIBC_PTHREAD_CANCEL)
+UNSET(CMAKE_REQUIRED_LIBRARIES)
+IF(NOT HAVE_LIBC_PTHREAD_CANCEL)
+  ADD_DEFINITIONS(-DNO_LIBC_PTHREAD_CANCEL)
+ENDIF()
+
+# OHOS libc provides no pthread_setaffinity_np() nor SYS_gettid; the InnoDB
+# buffer-pool thread affinity/priority tweak is optional, so gate it on the
+# actual capabilities instead of on a platform macro (repo rule R8).
+INCLUDE(CheckCSourceCompiles)
+CHECK_C_SOURCE_COMPILES("
+#include <pthread.h>
+#include <sys/syscall.h>
+int main() {
+  cpu_set_t s; CPU_ZERO(&s);
+  if (pthread_setaffinity_np(pthread_self(), sizeof(s), &s) != 0) return 1;
+  return (int)syscall(SYS_gettid);
+}
+" HAVE_PTHREAD_SETAFFINITY_AND_GETTID)
+IF(HAVE_PTHREAD_SETAFFINITY_AND_GETTID)
+  ADD_DEFINITIONS(-DHAVE_PTHREAD_SETAFFINITY_AND_GETTID)
+ENDIF()
+
+IF(LINUX AND NOT OHOS)
   MYSQL_CHECK_RPC()
 ENDIF()
 
+# Capability probes for libc/compiler portability workarounds. These produce
+# feature macros through my_config.h rather than platform-specific source macros.
+INCLUDE(CheckSymbolExists)
+INCLUDE(CheckIncludeFileCXX)
+CHECK_SYMBOL_EXISTS(res_nsearch "resolv.h" HAVE_RES_NSEARCH)
+CHECK_SYMBOL_EXISTS(pthread_cancel "pthread.h" HAVE_PTHREAD_CANCEL)
+CHECK_INCLUDE_FILE_CXX(source_location HAVE_STD_SOURCE_LOCATION)
+
