+  # OHOS clang 15: same situation (see the comment in ../CMakeLists.txt); the
+  # mysqlbinlog target is skipped on OHOS.
 ELSE()
   MYSQL_ADD_EXECUTABLE(mysqlbinlog
     ${MYSQLBINLOG_SOURCES}
