--- a/libs/mysql/iterators/iterator_interface.h
+++ b/libs/mysql/iterators/iterator_interface.h
@@ -447,15 +447,27 @@
   ///
   /// This delegates the work to the `prev` member function if there is one;
   /// otherwise to the `advance` member function.
+#if defined(__clang__) && __clang_major__ < 17
+  // Older clang (e.g. 15, shipped by some toolchains): when the constraint
+  // depends on detecting members of the CRTP derived class, libc++ evaluates
+  // `--i` inside std::bidirectional_iterator as invalid even though the
+  // derived class has prev(); drop the constraint for those compilers (the
+  // iterator_concept machinery does not depend on it).
+  Self_t &operator--()
+#else
   Self_t &operator--()
     requires(detail::Has_member_prev<Self_t> ||
              detail::Has_member_advance<Self_t>)
+#endif
   {
     if constexpr (detail::Has_member_prev<Self_t>) {
       self().prev();
-    } else {
+    } else if constexpr (detail::Has_member_advance<Self_t>) {
       self().advance(-1);
     }
+    // else: the iterator does not model bidirectional; operator-- is only
+    // reachable from code that is itself constrained away on conforming
+    // compilers (see the operator-- constraint above).
     return self();
   }
 
