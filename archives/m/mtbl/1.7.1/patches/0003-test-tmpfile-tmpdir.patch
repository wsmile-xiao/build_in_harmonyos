--- a/t/test-iter-seek.c
+++ b/t/test-iter-seek.c
@@ -5,1 +5,2 @@
-#include <unistd.h>
+#include <string.h>
+#include <unistd.h>
@@ -27,1 +28,21 @@
-static int
+/* musl tmpfile() creates the temp file in the read-only /tmp on HarmonyOS;
+ * create an anonymous temp file under TMPDIR (falling back to the current
+ * directory) instead. Unlinking right after mkstemp keeps the delete-on-close
+ * semantics of tmpfile(). */
+static FILE *
+tmpfile_rw(void)
+{
+	char template[4096];
+	const char *dir = getenv("TMPDIR");
+	int fd;
+
+	if (dir == NULL || dir[0] == '\0')
+		dir = ".";
+	snprintf(template, sizeof(template), "%s/mtbl-iter-seek.XXXXXX", dir);
+	fd = mkstemp(template);
+	assert(fd >= 0);
+	unlink(template);
+	return (fdopen(fd, "w+"));
+}
+
+static int
@@ -202 +223,2 @@
-		tmps[i] = tmpfile();
+		tmps[i] = tmpfile_rw();
+		assert(tmps[i] != NULL);
@@ -215 +237 @@
-	FILE *tmp3 = tmpfile();
+	FILE *tmp3 = tmpfile_rw();
@@ -241 +263 @@
-	FILE *tmp4 = tmpfile();
+	FILE *tmp4 = tmpfile_rw();
