--- a/src/util/u_process.c
+++ b/src/util/u_process.c
@@ -158,20 +158,38 @@
 #elif DETECT_OS_HAIKU
 #  include <kernel/OS.h>
 #  include <kernel/image.h>
 static char *
 __getProgramName()
 {
    image_info info;
    get_image_info(B_CURRENT_TEAM, &info);
    return strdup(info.name);
 }
+#elif defined(HAVE_READ_PROC_SELF_EXE)
+/* Platforms without program_invocation_name/getprogname but with a
+ * linux-style /proc/self/exe (e.g. HarmonyOS user-space) fall back to
+ * reading the process name from it.  The capability macro is injected by
+ * meson.build, not by OHOS-specific preprocessor macros. */
+static char *
+__getProgramName()
+{
+   char path[4096];
+   ssize_t len = readlink("/proc/self/exe", path, sizeof(path) - 1);
+   if (len <= 0)
+      return strdup("");
+   path[len] = '\0';
+   char *base = strrchr(path, '/');
+   if (base && base[1] != '\0')
+      return strdup(base + 1);
+   return strdup(path);
+}
 #else
 #define GET_PROGRAM_NAME_NOT_AVAILABLE
 #endif
 
