diff --git a/src/util/memstream.c b/src/util/memstream.c
index bd909b7..f190275 100644
--- a/src/util/memstream.c
+++ b/src/util/memstream.c
@@ -97,6 +97,11 @@ u_memstream_close(struct u_memstream *mem)
 #ifdef _WIN32
    u_memstream_update_buffer(mem);
    remove(mem->temp);
+#else
+   /* OHOS (musl-based) open_memstream() only synchronizes the caller's
+    * buffer with the stream on fflush(); fclose() alone leaves it stale.
+    * Flush explicitly so the buffer/size are valid after close. */
+   fflush(f);
 #endif
 
    fclose(f);
