diff --git a/meson.build b/meson.build
index 1eca91f..6735054 100644
--- a/meson.build
+++ b/meson.build
@@ -156,7 +156,7 @@ pre_args += '-DHAVE_OPENGL_ES_2=@0@'.format(with_gles2.to_int())
 
 with_any_opengl = with_opengl or with_gles1 or with_gles2
 
-system_has_kms_drm = ['openbsd', 'netbsd', 'freebsd', 'gnu/kfreebsd', 'dragonfly', 'linux', 'sunos', 'android', 'managarm'].contains(host_machine.system())
+system_has_kms_drm = ['openbsd', 'netbsd', 'freebsd', 'gnu/kfreebsd', 'dragonfly', 'linux', 'sunos', 'android', 'managarm', 'harmonyos'].contains(host_machine.system())
 
 gallium_drivers = get_option('gallium-drivers')
 if gallium_drivers.contains('auto')
@@ -577,10 +577,10 @@ foreach platform : _platforms
   pre_args += '-DHAVE_@0@_PLATFORM'.format(platform.to_upper())
 endforeach
 
-if with_platform_android and get_option('platform-sdk-version') >= 29
+if (with_platform_android and get_option('platform-sdk-version') >= 29) or host_machine.system() == 'harmonyos'
   # By default the NDK compiler, at least, emits emutls references instead of
   # ELF TLS, even when building targeting newer API levels.  Make it actually do
-  # ELF TLS instead.
+  # ELF TLS instead.  The OHOS toolchain behaves the same way.
   c_cpp_args += '-fno-emulated-tls'
   add_project_link_arguments('-Wl,-plugin-opt=-emulated-tls=0', language: ['c', 'cpp'])
 endif
@@ -1205,7 +1205,7 @@ if cc.has_function('fmemopen')
 endif
 
 # TODO: this is very incomplete
-if ['linux', 'cygwin', 'gnu', 'freebsd', 'gnu/kfreebsd', 'haiku', 'android', 'managarm'].contains(host_machine.system())
+if ['linux', 'cygwin', 'gnu', 'freebsd', 'gnu/kfreebsd', 'haiku', 'android', 'managarm', 'harmonyos'].contains(host_machine.system())
   pre_args += '-D_GNU_SOURCE'
 elif host_machine.system() == 'sunos'
   pre_args += '-D__EXTENSIONS__'
@@ -1603,9 +1603,16 @@ if cc.has_function('thrd_create', prefix: '#include <threads.h>')
   endif
 endif
 
-if cc.has_header_symbol('errno.h', 'program_invocation_name',
+prog_invocation_name = cc.has_header_symbol('errno.h', 'program_invocation_name',
                         args : '-D_GNU_SOURCE')
+if prog_invocation_name
    pre_args += '-DHAVE_PROGRAM_INVOCATION_NAME'
+elif host_machine.system() == 'harmonyos'
+   # HarmonyOS user-space provides /proc/self/exe but neither
+   # program_invocation_name nor getprogname().  Inject a capability macro so
+   # u_process.c can derive the process name from /proc/self/exe without
+   # OHOS-specific preprocessor macros.
+   pre_args += '-DHAVE_READ_PROC_SELF_EXE'
 elif with_tools.contains('intel') and not with_platform_android
   # Intel tools is supported on Android where the program name is from
   # `getprogname()` without `program_invocation_name` in glibc.
@@ -2413,7 +2420,10 @@ elif host_machine.system() == 'windows' and cc.get_argument_syntax() != 'msvc'
     symbols_check_args = ['--gendef', prog_gendef.full_path()]
   endif
 else
-  prog_nm = find_program('nm')
+  # Symbol checks are only registered when tests are enabled.  The OHOS
+  # worker does not ship `nm` in PATH, so a disabled test feature must not
+  # become a configure-time hard dependency.
+  prog_nm = find_program('nm', required : with_tests)
   with_symbols_check = prog_nm.found() and with_tests
   if with_symbols_check
     symbols_check_args = ['--nm', prog_nm.full_path()]
