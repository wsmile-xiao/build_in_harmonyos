             target_link_libraries(LMegacmdTestsCommon PUBLIC GTest::gtest GTest::gmock)
         endif()
 
-    else() # No VCPKG usage. Use pkg-config
+    else() # No VCPKG usage. Prefer CMake config packages, fall back to pkg-config
         find_package(PkgConfig REQUIRED) # For libraries loaded using pkg-config
 
         if(USE_PCRE) #TODO: UNTESTED!
-            pkg_check_modules(pcre REQUIRED IMPORTED_TARGET libpcre)
-            target_link_libraries(LMegacmdServer PRIVATE PkgConfig::pcre)
+            # [OHOS/Conan] 同上：有 CMake config 包（Conan CMakeDeps 产出 pcre::pcre）
+            # 就用它，否则回退系统 pkg-config 的 libpcre。可见性同样 PRIVATE→PUBLIC：
+            # src/megacmdutils.cpp 直接 #include <pcrecpp.h>，而该文件被编进
+            # mega-cmd-server（消费 LMegacmdServer），PRIVATE 时 include 目录不传递。
+            find_package(pcre CONFIG QUIET)
+            if(pcre_FOUND)
+                target_link_libraries(LMegacmdServer PUBLIC pcre::pcre)
+            else()
+                pkg_check_modules(pcre REQUIRED IMPORTED_TARGET libpcre)
+                target_link_libraries(LMegacmdServer PUBLIC PkgConfig::pcre)
+            endif()
             set(USE_PCRE 1)
         endif()
     endif()
