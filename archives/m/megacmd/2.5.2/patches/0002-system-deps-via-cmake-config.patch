--- a/sdk/cmake/modules/sdklib_libraries.cmake
+++ b/sdk/cmake/modules/sdklib_libraries.cmake
@@ -94,63 +94,114 @@
             set(NO_READLINE 1)
         endif()
 
-    else() # No VCPKG usage. Use pkg-config
+    else() # No VCPKG usage. Prefer CMake config packages, fall back to pkg-config
 
         find_package(PkgConfig REQUIRED) # For libraries loaded using pkg-config
 
-        pkg_check_modules(cryptopp REQUIRED IMPORTED_TARGET libcrypto++)
-        target_link_libraries(SDKlib PUBLIC PkgConfig::cryptopp) # TODO: Private for SDK core
+        # [OHOS/Conan] 上游此分支假定系统已为每个依赖安装 pkg-config 文件。Conan 的
+        # CMakeDeps 只产出 CMake config 包，且 cryptopp 上游根本不提供 libcrypto++.pc，
+        # 因此这里改为「有 CMake config 包就用它，否则回退 pkg-config」，两条路径都保留。
+        #
+        # 同时把链接可见性 PRIVATE→PUBLIC：SDK 的**公开头**会包含这些依赖的头
+        # （mega/posix/megasys.h、megaapi_impl.h → curl/curl.h；mega/crypto/sodium.h
+        # → sodium.h；mega/db/sqlite.h → sqlite3.h；mega/utils.h → unicode/uchar.h；
+        # mega/posix/meganet.h → openssl/ssl.h），而 megacmd 自己的目标
+        # （LMegacmdServer/mega-cmd）也要包含 SDK 公开头。上游在 vcpkg 路径下靠
+        # vcpkg toolchain 把已安装的 include 目录**全局**注入编译命令才成立；
+        # Conan 的 CMakeDeps 只把 include 目录挂在各自 target 的 INTERFACE 上，
+        # PRIVATE 不向消费者传递 ⇒ 在 Conan 路径下必须 PUBLIC，否则报
+        # 'curl/curl.h' file not found。
+        find_package(cryptopp CONFIG QUIET)
+        if(cryptopp_FOUND)
+            target_link_libraries(SDKlib PUBLIC cryptopp::cryptopp) # TODO: Private for SDK core
+        else()
+            pkg_check_modules(cryptopp REQUIRED IMPORTED_TARGET libcrypto++)
+            target_link_libraries(SDKlib PUBLIC PkgConfig::cryptopp) # TODO: Private for SDK core
+        endif()
 
-        pkg_check_modules(sodium REQUIRED IMPORTED_TARGET libsodium)
-        target_link_libraries(SDKlib PRIVATE PkgConfig::sodium)
+        find_package(libsodium CONFIG QUIET)
+        if(libsodium_FOUND)
+            target_link_libraries(SDKlib PUBLIC libsodium::libsodium)
+        else()
+            pkg_check_modules(sodium REQUIRED IMPORTED_TARGET libsodium)
+            target_link_libraries(SDKlib PUBLIC PkgConfig::sodium)
+        endif()
 
-        pkg_check_modules(sqlite3 REQUIRED IMPORTED_TARGET sqlite3)
-        target_link_libraries(SDKlib PRIVATE PkgConfig::sqlite3)
+        find_package(sqlite3 CONFIG QUIET)
+        if(sqlite3_FOUND)
+            target_link_libraries(SDKlib PUBLIC sqlite3::sqlite3)
+        else()
+            pkg_check_modules(sqlite3 REQUIRED IMPORTED_TARGET sqlite3)
+            target_link_libraries(SDKlib PUBLIC PkgConfig::sqlite3)
+        endif()
 
-        pkg_check_modules(curl REQUIRED IMPORTED_TARGET libcurl)
-        target_link_libraries(SDKlib PRIVATE PkgConfig::curl)
+        find_package(CURL CONFIG QUIET)
+        if(CURL_FOUND)
+            target_link_libraries(SDKlib PUBLIC CURL::libcurl)
+        else()
+            pkg_check_modules(curl REQUIRED IMPORTED_TARGET libcurl)
+            target_link_libraries(SDKlib PUBLIC PkgConfig::curl)
+        endif()
 
         find_package(ICU COMPONENTS uc data REQUIRED)
-        target_link_libraries(SDKlib PRIVATE ICU::uc ICU::data)
+        if(TARGET icu::icu)
+            target_link_libraries(SDKlib PUBLIC icu::icu)
+        else()
+            target_link_libraries(SDKlib PUBLIC ICU::uc ICU::data)
+        endif()
 
         if(USE_OPENSSL)
             find_package(OpenSSL REQUIRED)
-            target_link_libraries(SDKlib PRIVATE OpenSSL::SSL OpenSSL::Crypto)
+            if(TARGET openssl::openssl)
+                target_link_libraries(SDKlib PUBLIC openssl::openssl)
+            else()
+                target_link_libraries(SDKlib PUBLIC OpenSSL::SSL OpenSSL::Crypto)
+            endif()
         endif()
 
         if(ENABLE_MEDIA_FILE_METADATA)
             pkg_check_modules(mediainfo REQUIRED IMPORTED_TARGET libmediainfo)
-            target_link_libraries(SDKlib PRIVATE PkgConfig::mediainfo)
+            target_link_libraries(SDKlib PUBLIC PkgConfig::mediainfo)
             set(USE_MEDIAINFO 1)
         endif()
 
         if(USE_FREEIMAGE)
             # FreeImage has no pkg-config file. Use out own FindFreeImage.cmake to find the library.
             find_package(FreeImage REQUIRED)
-            target_link_libraries(SDKlib PRIVATE FreeImage::FreeImage)
+            target_link_libraries(SDKlib PUBLIC FreeImage::FreeImage)
         endif()
 
         if(USE_FFMPEG)
             pkg_check_modules(ffmpeg REQUIRED IMPORTED_TARGET libavformat libavutil libavcodec libswscale libswresample)
-            target_link_libraries(SDKlib PRIVATE PkgConfig::ffmpeg)
+            target_link_libraries(SDKlib PUBLIC PkgConfig::ffmpeg)
             set(HAVE_FFMPEG 1)
         endif()
 
         if(USE_LIBUV)
-            pkg_check_modules(uv REQUIRED IMPORTED_TARGET libuv)
-            target_link_libraries(SDKlib PRIVATE PkgConfig::uv)
+            find_package(libuv CONFIG QUIET)
+            if(libuv_FOUND)
+                target_link_libraries(SDKlib PUBLIC libuv::libuv)
+            else()
+                pkg_check_modules(uv REQUIRED IMPORTED_TARGET libuv)
+                target_link_libraries(SDKlib PUBLIC PkgConfig::uv)
+            endif()
             set(HAVE_LIBUV 1)
         endif()
 
         if(USE_PDFIUM)
             pkg_check_modules(pdfium REQUIRED IMPORTED_TARGET pdfium)
-            target_link_libraries(SDKlib PRIVATE PkgConfig::pdfium)
+            target_link_libraries(SDKlib PUBLIC PkgConfig::pdfium)
             set(HAVE_PDFIUM 1)
         endif()
 
         if(USE_READLINE)
-            pkg_check_modules(readline REQUIRED IMPORTED_TARGET readline)
-            target_link_libraries(SDKlib PRIVATE PkgConfig::readline)
+            find_package(readline CONFIG QUIET)
+            if(readline_FOUND)
+                target_link_libraries(SDKlib PUBLIC readline::readline)
+            else()
+                pkg_check_modules(readline REQUIRED IMPORTED_TARGET readline)
+                target_link_libraries(SDKlib PUBLIC PkgConfig::readline)
+            endif()
         else()
             set(NO_READLINE 1)
         endif()
