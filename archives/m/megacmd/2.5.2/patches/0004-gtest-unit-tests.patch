--- a/build/cmake/modules/megacmd_libraries.cmake
+++ b/build/cmake/modules/megacmd_libraries.cmake
@@ -29,6 +29,13 @@
             endif()
             set(USE_PCRE 1)
         endif()
+
+        if (ENABLE_MEGACMD_TESTS)
+            # [OHOS/Conan] 无 vcpkg 分支原本不接 GTest（只在 VCPKG_ROOT 分支
+            # find_package(GTest CONFIG)）；Conan 的 gtest 包同样提供 GTest::gtest/gmock。
+            find_package(GTest CONFIG REQUIRED)
+            target_link_libraries(LMegacmdTestsCommon PUBLIC GTest::gtest GTest::gmock)
+        endif()
     endif()
 
 endmacro()
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -365,6 +365,26 @@
     if(APPLE)
         target_link_libraries(mega-cmd-tests-unit PRIVATE "-framework Security" )
     endif()
+
+    # [OHOS/Conan] 上游只构建测试可执行文件、全树没有 enable_testing()/add_test()
+    # ⇒ ctest 里 0 条用例。这里把**单元测试按套件**注册进 ctest，配方 build() 用
+    # `ctest -V` 真实执行后再断言文档化基线。套件级隔离是必需的：
+    # ComunicationsManagerFileSocketsTest 在 OHOS PC 上会因 AF_UNIX bind 被拒而段错误，
+    # 整包注册成一条会让其后所有套件的结果一起丢失。
+    # 集成测试（tests/integration）需要真实 MEGA 账号与公网，平台环境不可用，故不注册。
+    enable_testing()
+    foreach(_megacmd_unit_suite IN ITEMS
+            ComunicationsManagerFileSocketsTest
+            ComunicationsManagerFileSocketsWithClientTest
+            OptionsFlagsUtilsTest
+            PlatformDirectoriesTest
+            StringUtilsTest
+            Utf8Test
+            PathUtf8Test
+            UtilsTest)
+        add_test(NAME "${_megacmd_unit_suite}"
+                 COMMAND mega-cmd-tests-unit "--gtest_filter=${_megacmd_unit_suite}.*")
+    endforeach()
 endif()
 
 if (WIN32)
