--- /dev/null
+++ b/Makefile
@@ -0,0 +1,35 @@
+CXX ?= clang++
+CXXFLAGS ?= -Wall -O2 -fPIC
+PREFIX ?= /usr/local
+DESTDIR ?= 
+
+mp3val: main.o mpegparse.o out.o report.o crossapi.o crc.o
+	$(CXX) $(CXXFLAGS) $^ -o $@
+
+main.o: main.cpp
+	$(CXX) $(CXXFLAGS) -c main.cpp -o main.o
+
+mpegparse.o: mpegparse.cpp
+	$(CXX) $(CXXFLAGS) -c mpegparse.cpp -o mpegparse.o
+
+out.o: out.cpp
+	$(CXX) $(CXXFLAGS) -c out.cpp -o out.o
+
+report.o: report.cpp
+	$(CXX) $(CXXFLAGS) -c report.cpp -o report.o
+
+crossapi.o: crossapi.cpp
+	$(CXX) $(CXXFLAGS) -c crossapi.cpp -o crossapi.o
+
+crc.o: crc.cpp crc.h
+	$(CXX) $(CXXFLAGS) -c crc.cpp -o crc.o
+
+install: mp3val
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	cp mp3val $(DESTDIR)$(PREFIX)/bin/
+
+clean:
+	rm -f mp3val
+	rm -f *.o
+
+.PHONY: install clean
