diff -ruN a/acceptance-tests/microbench-perf.sh b/acceptance-tests/microbench-perf.sh
--- a/acceptance-tests/microbench-perf.sh
+++ b/acceptance-tests/microbench-perf.sh
@@ -0,0 +1,17 @@
+#! /bin/sh
+r='/storage/Users/currentUser/builds/mono-6.12.0.122.work'
+aotpattern="--aot="
+
+# if this is an aot invoke
+if [[ $@ =~ $aotpattern ]];
+then
+# just aot the code
+echo "$r/runtime/mono-wrapper $@"
+exec $r/runtime/mono-wrapper $@
+else
+# else run it under perf
+echo "$MONO_PERF_BINARY record -o $r/acceptance-tests/perf.data -v -s -g -- $r/mono/mini/mono-sgen $@"
+exec $MONO_PERF_BINARY record -o $r/acceptance-tests/perf.data -v -s -g $r/mono/mini/mono-sgen $@
+fi
+
+
