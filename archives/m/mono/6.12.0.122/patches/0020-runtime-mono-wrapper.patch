diff -ruN a/runtime/mono-wrapper b/runtime/mono-wrapper
--- a/runtime/mono-wrapper
+++ b/runtime/mono-wrapper
@@ -0,0 +1,11 @@
+#! /bin/sh
+r='/storage/Users/currentUser/builds/mono-6.12.0.122.work'
+MONO_CFG_DIR='b/runtime/etc'
+PATH="$r/runtime/_tmpinst/bin:$PATH"
+if [ -z "$MONO_EXECUTABLE_WRAPPER" ]
+then
+    MONO_EXECUTABLE_WRAPPER=${MONO_EXECUTABLE:-"$r/mono/mini/mono"}
+fi
+MONO_EXECUTABLE=${MONO_EXECUTABLE:-"$r/mono/mini/mono"}
+export MONO_CFG_DIR PATH
+exec "$r/libtool" --mode=execute "${MONO_EXECUTABLE_WRAPPER}" --config "b/runtime/etc/mono/config" "$@"
