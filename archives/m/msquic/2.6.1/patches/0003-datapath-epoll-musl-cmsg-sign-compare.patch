--- a/src/platform/datapath_epoll.c
+++ b/src/platform/datapath_epoll.c
@@ -20,6 +20,15 @@
 #include "datapath_epoll.c.clog.h"
 #endif
 
+#if defined(__OHOS__)
+// OHOS(musl): musl's CMSG_NXTHDR macro mixes size_t (unsigned long) and
+// ptrdiff_t (long) operands in its boundary comparison, which triggers
+// -Werror -Wsign-compare inside the macro expansion (not in msquic code).
+// glibc's CMSG_NXTHDR is cast-clean, so this only fires on musl systems.
+// Disable the diagnostic for this translation unit only.
+#pragma clang diagnostic ignored "-Wsign-compare"
+#endif
+
 CXPLAT_STATIC_ASSERT((SIZEOF_STRUCT_MEMBER(QUIC_BUFFER, Length) <= sizeof(size_t)), "(sizeof(QUIC_BUFFER.Length) == sizeof(size_t) must be TRUE.");
 CXPLAT_STATIC_ASSERT((SIZEOF_STRUCT_MEMBER(QUIC_BUFFER, Buffer) == sizeof(void*)), "(sizeof(QUIC_BUFFER.Buffer) == sizeof(void*) must be TRUE.");
 
