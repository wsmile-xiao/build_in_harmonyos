--- a/src/platform/datapath_linux.c
+++ b/src/platform/datapath_linux.c
@@ -16,6 +16,17 @@
 #include "datapath_linux.c.clog.h"
 #endif
 
+#if defined(__OHOS__)
+// OHOS(musl): the CMSG_NXTHDR macro in musl's sys/socket.h computes
+// "__CMSG_LEN(cmsg) + sizeof(struct cmsghdr) >= __MHDR_END(mhdr) - (unsigned char *)(cmsg)"
+// where __MHDR_END is a ptrdiff_t (long) subtraction while the left side is
+// size_t (unsigned long). With -Werror -Wsign-compare this expands into a
+// false-positive sign-compare error inside the macro (not in msquic code).
+// glibc's CMSG_NXTHDR is cast-clean, so this only triggers on musl systems.
+// Disable the diagnostic for this translation unit only.
+#pragma clang diagnostic ignored "-Wsign-compare"
+#endif
+
 QUIC_STATUS
 CxPlatSocketUpdateQeo(
     _In_ CXPLAT_SOCKET* Socket,
