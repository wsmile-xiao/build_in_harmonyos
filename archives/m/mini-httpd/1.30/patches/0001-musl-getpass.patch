-#ifdef MPE
+#if defined(MPE) || !defined(__GLIBC__)
 /* MPE lacks getpass() and a way to suppress stdin echo.  So for now, just
 issue the prompt and read the results with echo.  (Ugh). */
+/* musl (OHOS) ships no getpass() either; provide a termios-based version
+   instead of the historic gets()-based MPE fallback. */
+
+#include <termios.h>
+#include <unistd.h>
 
 char *getpass(const char *prompt) {
 
 static char password[81];
+struct termios told, tnew;
+int tty_changed = 0;
+size_t len;
 
 fputs(prompt,stderr);
-gets((char *)&password);
-
-if (strlen((char *)&password) > 8) {
-  password[8]='\0';
-}
+fflush(stderr);
+if ( tcgetattr( STDIN_FILENO, &told ) == 0 )
+    {
+    tnew = told;
+    tnew.c_lflag &= ~ECHO;
+    (void) tcsetattr( STDIN_FILENO, TCSAFLUSH, &tnew );
+    tty_changed = 1;
+    }
+if ( fgets( password, sizeof(password), stdin ) == (char*) 0 )
+    password[0] = 0;
+/* Restore the attributes saved before echo was disabled; never re-read
+   them here, otherwise the save would be overwritten with the echo-off
+   state and this call would become a no-op. */
+if ( tty_changed )
+    (void) tcsetattr( STDIN_FILENO, TCSAFLUSH, &told );
+len = strlen( password );
+if ( len > 0 && password[len-1] == 10 )
+    password[len-1] = 0;
+fputc( 10, stderr );
 
 return (char *)&password;
 }
