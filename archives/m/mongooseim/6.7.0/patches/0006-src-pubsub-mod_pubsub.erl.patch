--doc "Stores recipients of the user's presence for notification broadcast (see the IQ handlers)".
 -spec user_send_iq(mongoose_acc:t(), mongoose_c2s_hooks:params(), gen_hook:extra()) ->
           {ok, mongoose_acc:t()}.
 user_send_iq(Acc, _Args = #{c2s_data := C2SData}, _Extra) ->
     case jlib:iq_query_info(mongoose_acc:element(Acc)) of
         #iq{xmlns = NS} when NS =:= ?NS_PUBSUB;
                              NS =:= ?NS_PUBSUB_OWNER ->
             case mongoose_c2s:get_mod_state(C2SData, mod_presence) of
                 {ok, State} ->
                     SubFrom = maps:keys(mod_presence:get(State, s_from)),
                     {ok, mongoose_acc:set_permanent(?MODULE, presence_subscribers, SubFrom, Acc)};
