--- a/libmysql/CMakeLists.txt
+++ b/libmysql/CMakeLists.txt
@@ -273,6 +273,13 @@
   SET(HAVE_UNIX_DNS_SRV 1 PARENT_SCOPE)
   MESSAGE(STATUS "BSD built in DNS SRV APIs")
 ELSE()
+  IF(OHOS)
+    # OHOS libc provides the resolver functions used by dns_srv.cc
+    # (the LINUX_ALPINE code path), but no libresolv to link.
+    SET(HAVE_UNIX_DNS_SRV 1 PARENT_SCOPE)
+    SET(HAVE_DNS_SRV 1)
+    MESSAGE(STATUS "OHOS libc DNS SRV APIs")
+  ENDIF()
   FIND_LIBRARY(RESOLV_LIBRARY NAMES resolv)
   IF (RESOLV_LIBRARY)
     LIST(APPEND LIBS_TO_LINK ${RESOLV_LIBRARY})
@@ -358,6 +365,9 @@
 
 # Merge several convenience libraries into one big mysqlclient
 # and link them together into shared library.
+# On OHOS the shared-library symlink/versioning steps are skipped;
+# the static mysqlclient library below is still built.
+IF(NOT OHOS)
 MERGE_LIBRARIES_SHARED(libmysql ${LIBS_TO_MERGE}
   EXPORTS
   ${CLIENT_API_FUNCTIONS}
@@ -369,6 +379,7 @@
   ${UNIX_SOVERSION}
   ${UNIX_VERSION}
   )
+ENDIF()
 
 # Downgrade warning for strncat in my_crypt_genhash.
 IF((WITH_LTO OR CMAKE_COMPILER_FLAG_WITH_LTO) AND MY_COMPILER_IS_GNU)
@@ -381,11 +392,11 @@
 ENDIF()
 
 IF(UNIX)
-  IF(LINK_FLAG_Z_DEFS)
+  IF(LINK_FLAG_Z_DEFS AND TARGET libmysql)
     MY_TARGET_LINK_OPTIONS(libmysql "LINKER:${LINK_FLAG_Z_DEFS}")
   ENDIF()
 
-  IF(LINUX)
+  IF(LINUX AND TARGET libmysql)
     CONFIGURE_FILE(libmysql.ver.in ${CMAKE_CURRENT_BINARY_DIR}/libmysql.ver)
     MY_TARGET_LINK_OPTIONS(libmysql
       "LINKER:--version-script=${CMAKE_CURRENT_BINARY_DIR}/libmysql.ver")
@@ -394,7 +405,9 @@
   # clean direct output needs to be set several targets have the same name
   #(mysqlclient in this case)
   SET_TARGET_PROPERTIES(mysqlclient PROPERTIES CLEAN_DIRECT_OUTPUT 1)
-  SET_TARGET_PROPERTIES(libmysql PROPERTIES CLEAN_DIRECT_OUTPUT 1)
+  IF(TARGET libmysql)
+    SET_TARGET_PROPERTIES(libmysql PROPERTIES CLEAN_DIRECT_OUTPUT 1)
+  ENDIF()
 ENDIF()
 
