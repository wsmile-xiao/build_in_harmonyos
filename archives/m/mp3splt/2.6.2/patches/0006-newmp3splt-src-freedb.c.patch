+/* OpenHarmony and other systems without getpass */
+#ifndef HAVE_GETPASS
+char *getpass(const char *prompt)
+{
+  char *ret = malloc(128);
+  if (!ret)
+    return NULL;
+  fputs(prompt, stdout);
+  fflush(stdout);
+  fgets(ret, 128, stdin);
+  /* Strip trailing newline */
+  size_t len = strlen(ret);
+  if (len > 0 && ret[len-1] == '\n')
+    ret[len-1] = '\0';
+  return ret;
+}
+#endif
