 # Use a proper internal environment variable to ensure we don't fall
   # into an infinite loop, continuously re-executing ourselves.
+
+# HarmonyOS/HMDFS: a toolchain-provided CONFIG_SHELL may be unable to
+# determine the working directory. Probe it from this directory and fall back
+# to /bin/sh when the probe fails, so the re-exec below cannot pick a broken
+# shell (E386).
+if test "x$CONFIG_SHELL" != x; then
+  _ohos_probe_out=`(cd . && "$CONFIG_SHELL" -c 'pwd') 2>&1` && _ohos_probe_rc=0 || _ohos_probe_rc=$?
+  _ohos_probe_cwd=`pwd`
+  if test "$_ohos_probe_rc" != 0 || test "x$_ohos_probe_out" != "x$_ohos_probe_cwd"; then
+    CONFIG_SHELL=
+    unset CONFIG_SHELL
+  fi
+  unset _ohos_probe_out _ohos_probe_rc _ohos_probe_cwd
+fi
   if test x"${_as_can_reexec}" != xno && test "x$CONFIG_SHELL" != x; then
     _as_can_reexec=no; export _as_can_reexec;
     # We cannot yet assume a decent shell, so we have to provide a
 # neutralization value for shells without unset; and this also
 # works around shells that cannot unset nonexistent variables.
 # Preserve -v and -x to the replacement shell.
 BASH_ENV=/dev/null
 ENV=/dev/null
 (unset BASH_ENV) >/dev/null 2>&1 && unset BASH_ENV ENV
