 struct SectionHeader {
   ul32 version = 7;
   ul32 cu_list_offset = 0;
   ul32 cu_types_offset = 0;
   ul32 ranges_offset = 0;
   ul32 symtab_offset = 0;
   ul32 const_pool_offset = 0;
 };
 
 struct NameType {
+#ifdef __OHOS__
+  // OHOS libc++ lacks operator<=> for string_view, so provide operator< explicitly
+  bool operator<(const NameType &other) const {
+    if (hash != other.hash) return hash < other.hash;
+    if (type != other.type) return type < other.type;
+    return name < other.name;
+  }
+  bool operator==(const NameType &other) const {
+    return hash == other.hash && type == other.type && name == other.name;
+  }
+#else
   auto operator<=>(const NameType &) const = default;
+#endif
   u64 hash;
   u8 type;
   std::string_view name;
 };
 
 struct MapValue {
   u32 gdb_hash = 0;
   Atomic<u32> count;
   u32 name_offset = 0;
   u32 type_offset = 0;
