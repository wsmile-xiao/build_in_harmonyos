+static bool is_malformed_abort_pmi1(char *buf, int buflen)
+{
+    static const char prefix[] = "cmd=abort";
+
+    if (buflen < (int) (sizeof(prefix) - 1))
+        return false;
+    if (strncmp(buf, prefix, sizeof(prefix) - 1) != 0)
+        return false;
+    if (buflen == (int) (sizeof(prefix) - 1))
+        return true;
+    return (unsigned char) buf[sizeof(prefix) - 1] <= 0x20;
+}
+

