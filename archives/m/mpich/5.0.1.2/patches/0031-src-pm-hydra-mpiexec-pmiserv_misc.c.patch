+static int is_ascii_digit(char ch)
+{
+    return ch >= '0' && ch <= '9';
+}
+
+HYD_status HYD_pmiserv_abort_cleanup(int *exitcode)
+{
+    HYD_status status = HYD_SUCCESS;
+    HYD_status overall_status = HYD_SUCCESS;
+
+    /* hydra_server.h declares these process-group accessors; pg.c implements them. */
+    for (int i = 0; i < PMISERV_pg_max_id(); i++) {
+        struct HYD_pg *pg = PMISERV_pg_by_id(i);
+        if (pg == NULL || !pg->is_active)
+            continue;
+        for (int j = 0; j < pg->proxy_count; j++) {
+            struct HYD_proxy *proxy = &pg->proxy_list[j];
+            if (proxy->control_fd == HYD_FD_UNSET || proxy->control_fd == HYD_FD_CLOSED)
+                continue;
+            status = HYD_pmcd_pmiserv_send_signal(proxy, SIGKILL);
+            if (status != HYD_SUCCESS) {
+                overall_status = status;
+                *exitcode = EXIT_FAILURE;
+            }
+        }
+    }
+
+    status = HYDT_bsci_wait_for_completion(0);
+    if (status != HYD_SUCCESS) {
+        overall_status = status;
+        *exitcode = EXIT_FAILURE;
+    }
+    return overall_status;
+}
+
 HYD_status HYD_pmiserv_abort(struct HYD_proxy *proxy, int process_fd, int pgid,
                              struct PMIU_cmd *pmi)
 {
     HYD_status status = HYD_SUCCESS;
     int pmi_errno;
+    int exitcode = EXIT_FAILURE;
+    long parsed_exitcode;
+    char *endptr;
+    const char *exitcode_text;
+    const char *digits;

     HYDU_FUNC_ENTER();

-    int exitcode;
+    exitcode_text = PMIU_cmd_find_keyval(pmi, "exitcode");
+    if (exitcode_text == NULL) {
+        if (pmi->version == PMIU_WIRE_V1)
+            goto fn_cleanup;
+    } else {
+        digits = exitcode_text;
+        if (*digits == '+' || *digits == '-')
+            digits++;
+        if (!is_ascii_digit(*digits))
+            goto fn_cleanup;
+        while (*digits != '\0') {
+            if (!is_ascii_digit(*digits))
+                goto fn_cleanup;
+            digits++;
+        }
+        errno = 0;
+        parsed_exitcode = strtol(exitcode_text, &endptr, 10);
+        if (errno == ERANGE || endptr == exitcode_text || *endptr != '\0' ||
+            parsed_exitcode < INT_MIN || parsed_exitcode > INT_MAX)
+            goto fn_cleanup;
+    }
+
     const char *error_msg;
     pmi_errno = PMIU_msg_get_query_abort(pmi, &exitcode, &error_msg);
     HYDU_ASSERT(!pmi_errno, status);

+  fn_cleanup:
+    status = HYD_pmiserv_abort_cleanup(&exitcode);
+
   fn_exit:
     /* clean everything up and exit */
-    status = HYDT_bsci_wait_for_completion(0);
     exit(exitcode);

     /* never get here */
@@ -124,5 +189,5 @@ HYD_status HYD_pmiserv_abort(struct HYD_proxy *proxy, int process_fd, int pgid,
     return status;

   fn_fail:
-    goto fn_exit;
+    goto fn_cleanup;
 }
