     struct PMIU_cmd pmi;
     status = PMIU_cmd_parse(buf, buflen, pmi_version, &pmi);
+    if (status != HYD_SUCCESS && pmi_version == PMIU_WIRE_V1 &&
+        is_malformed_abort_pmi1(buf, buflen)) {
+        int exitcode = EXIT_FAILURE;
+        status = HYD_pmiserv_abort_cleanup(&exitcode);
+        exit(exitcode);
+    }
     HYDU_ERR_POP(status, "unable to parse PMI command\n");

