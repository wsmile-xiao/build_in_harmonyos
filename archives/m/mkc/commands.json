{
  "name": "mkc",
  "description": "基于 bmake 的构建系统 mk-configure，提供 mkcmake 与 mkc_check_* / mkc_install 等命令",
  "homepage": "https://github.com/cheusov/mk-configure",
  "type": "tool",
  "versions": {
    "0.27.0": {
      "ref": "mkc/0.27.0",
      "binary": false,
      "commands": [
        "mkcmake",
        "mkc_check_compiler",
        "mkc_check_custom",
        "mkc_check_decl",
        "mkc_check_funclib",
        "mkc_check_header",
        "mkc_check_prog",
        "mkc_check_sizeof",
        "mkc_check_version",
        "mkc_install",
        "mkc_which"
      ]
    }
  }
}
