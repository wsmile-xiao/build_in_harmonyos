diff --git a/mk/mkc.init.mk b/mk/mkc.init.mk
index 7d7339f..98a5415 100644
--- a/mk/mkc.init.mk
+++ b/mk/mkc.init.mk
@@ -11,6 +11,9 @@
 .ifndef OPSYS
 OPSYS !=	uname -s
 OPSYS :=	${OPSYS:C/^CYGWIN.*$/Cygwin/}
+# OpenHarmony/HarmonyOS PC reports "HarmonyOS" from uname -s.
+# Normalize it to the short name OHOS used elsewhere on the platform.
+OPSYS :=	${OPSYS:C/^HarmonyOS$/OHOS/}
 .endif
 TARGET_OPSYS ?=	${OPSYS}
 
@@ -135,8 +138,12 @@ PROJECTNAME  ?=	${!empty(PROG):?${PROG}:${!empty(LIB):?${LIB}:${.CURDIR:T}}}
 _MKC_USER   !=	/usr/xpg4/bin/id -un
 _MKC_GROUP  !=	/usr/xpg4/bin/id -gn
 .else
-_MKC_USER   !=	id -un
-_MKC_GROUP  !=	id -gn
+# Some platforms (e.g. HarmonyOS/OHOS) ship a userland whose user database
+# does not describe the uid running the build, so id(1) fails.  Keep the
+# invocations quiet: a failing id(1) must neither abort the build nor
+# pollute the make output captured by the regression tests.
+_MKC_USER   !=	(id -un 2>/dev/null || true)
+_MKC_GROUP  !=	(id -gn 2>/dev/null || true)
 .endif
 
 .if ${_MKC_USER} != root && ${OPSYS}${_MKC_USER} != "InterixAdministrator"
diff --git a/mk/mkc_imp.platform.sys.mk b/mk/mkc_imp.platform.sys.mk
index 90fee7f..a577fd4 100644
--- a/mk/mkc_imp.platform.sys.mk
+++ b/mk/mkc_imp.platform.sys.mk
@@ -90,6 +90,15 @@ CPP.QNX =	${CC} -E
 
 CPP.AIX =	${CC} -E
 
+# OHOS (OpenHarmony / HarmonyOS PC): Linux-kernel based, ELF objects and an
+# LLVM/Clang toolchain whose default target triple is
+# aarch64-unknown-linux-ohos.  `uname -s` prints "HarmonyOS"; mkc.init.mk
+# normalizes that to OHOS.  Unlike GNU/Linux distributions there is no bare
+# `cc`/`c++`/`cpp` in PATH, so provide the platform defaults.
+CC.OHOS  =	clang
+CXX.OHOS =	clang++
+CPP.OHOS =	${CC} -E
+
 CC  ?=		${CC.${TARGET_OPSYS}:Ucc}
 CXX ?=		${CXX.${TARGET_OPSYS}:Uc++}
 CPP ?=		${CPP.${TARGET_OPSYS}:Ucpp}
