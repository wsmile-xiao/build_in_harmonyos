diff --git a/tests/os_OHOS/Makefile b/tests/os_OHOS/Makefile
new file mode 100644
index 0000000..0f368fe
--- /dev/null
+++ b/tests/os_OHOS/Makefile
@@ -0,0 +1,37 @@
+# OHOS (OpenHarmony / HarmonyOS PC) specific regression test.
+#
+# It is executed only when mk-configure detects OHOS (uname -s reports
+# "HarmonyOS", which mk/mkc.init.mk normalizes to OHOS); on any other
+# system the test is reported as skipped.
+
+MKC_CHECK_HEADERS      +=	sys/types.h
+
+MKC_CHECK_HEADERS      +=	sys/stat.h
+
+MKC_CHECK_SIZEOF       +=	int:sys/types.h
+
+# OHOS specific: the OHOS native clang toolchain predefines the
+# __OHOS_FAMILY__ macro for the aarch64-unknown-linux-ohos target triple.
+MKC_CHECK_DEFINES      +=	__OHOS_FAMILY__
+
+.include <mkc.configure.mk>
+
+.if ${OPSYS:U} == "OHOS"
+.PHONY : test_output
+test_output:
+	@echo OPSYS=${OPSYS}; \
+	echo HAVE_HEADER.sys_types_h=${HAVE_HEADER.sys_types_h:U0}; \
+	echo HAVE_HEADER.sys_stat_h=${HAVE_HEADER.sys_stat_h:U0}; \
+	echo SIZEOF.int.sys_types_h=${SIZEOF.int.sys_types_h:U0}; \
+	echo HAVE_DEFINE.__OHOS_FAMILY__=${HAVE_DEFINE.__OHOS_FAMILY__:U0}
+
+.include <mkc.minitest.mk>
+.else
+.PHONY: test
+test:
+	@echo '      skipped'; \
+	: =========== cleandir ============; \
+	${MAKE} cleandir > /dev/null
+.endif
+
+.include <mkc.mk>
diff --git a/tests/os_OHOS/expect.out b/tests/os_OHOS/expect.out
new file mode 100644
index 0000000..42f0faa
--- /dev/null
+++ b/tests/os_OHOS/expect.out
@@ -0,0 +1,5 @@
+OPSYS=OHOS
+HAVE_HEADER.sys_types_h=1
+HAVE_HEADER.sys_stat_h=1
+SIZEOF.int.sys_types_h=4
+HAVE_DEFINE.__OHOS_FAMILY__=1
