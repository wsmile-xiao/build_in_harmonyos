diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,14 @@
+#!/bin/sh
+# CMake configure wrapper for OpenHarmony
+# Translates autotools-style --prefix= to cmake -DCMAKE_INSTALL_PREFIX
+# Compatible with toybox sh
+PREFIX="/usr/local"
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            # Extract prefix value using cut (toybox-compatible)
+            PREFIX=$(echo "$arg" | cut -d= -f2)
+            ;;
+    esac
+done
+cmake -S . -B build -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_BUILD_TYPE=Release -DENABLE_TOOLS=ON < /dev/null
