diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,32 @@
+#!/bin/sh
+# configure wrapper for microsocks (makefile project)
+# Generates config.mak based on --prefix and standard configure options
+
+PREFIX=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*)
+            PREFIX="${1#--prefix=}"
+            ;;
+        --help)
+            echo "Usage: ./configure --prefix=PREFIX"
+            echo "  This is a wrapper for microsocks which uses config.mak instead of autotools."
+            exit 0
+            ;;
+        *)
+            # Ignore unknown options
+            ;;
+    esac
+    shift
+done
+
+if [ -z "$PREFIX" ]; then
+    PREFIX="/usr/local"
+fi
+
+cat > config.mak << MAKEOF
+prefix = $PREFIX
+MAKEOF
+
+echo "config.mak generated with prefix=$PREFIX"
+exit 0
