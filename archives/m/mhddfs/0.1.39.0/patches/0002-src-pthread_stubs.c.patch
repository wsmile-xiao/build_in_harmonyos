--- /dev/null
+++ b/src/pthread_stubs.c
@@ -0,0 +1,47 @@
+/*
+ * pthread_stubs.c — link-time compatibility shims for the OHOS C library.
+ *
+ * The OHOS C library does not implement pthread_cancel() or
+ * pthread_setcancelstate() (E051, unimplemented libc functions; the libfuse
+ * 2.9.9 adaptation notes in this repository record the same limitation).
+ * libfuse.a references both symbols unconditionally: lib/fuse.c
+ * fuse_stop_cleanup_thread() and lib/fuse_loop_mt.c worker cancellation.
+ * Every static consumer of libfuse therefore needs definitions in order to
+ * link. The libfuse 2.9.9 test_package ships the identical shim.
+ *
+ * Both libfuse call sites ignore the return value. The shims report ENOSYS
+ * (thread cancellation is unavailable) instead of pretending success. The
+ * code paths using them — the optional LRU prune thread, only started with
+ * "-o remember=N", and the multithreaded session loop — are not reachable in
+ * the default single-threaded fuse_main() flow mhddfs uses.
+ *
+ * The guard is a libc capability check: glibc and musl provide these
+ * functions, the OHOS libc does not. Skipping the shim there avoids
+ * shadowing a real implementation.
+ */
+#if !defined(__GLIBC__) && !defined(__MUSL__)
+
+#include <errno.h>
+#include <pthread.h>
+
+#ifndef PTHREAD_CANCEL_ENABLE
+#define PTHREAD_CANCEL_ENABLE 0
+#endif
+
+int pthread_cancel(pthread_t thread)
+{
+	(void)thread;
+	errno = ENOSYS;
+	return -1;
+}
+
+int pthread_setcancelstate(int state, int *oldstate)
+{
+	(void)state;
+	if (oldstate)
+		*oldstate = PTHREAD_CANCEL_ENABLE;
+	errno = ENOSYS;
+	return -1;
+}
+
+#endif /* !__GLIBC__ && !__MUSL__ */
