diff -ruN a/src/musl_shim.h b/src/musl_shim.h
--- a/src/musl_shim.h
+++ b/src/musl_shim.h
@@ -0,0 +1,44 @@
+/*
+ * musl_shim.h - Compatibility shim for musl libc (OpenHarmony)
+ *
+ * Provides missing glibc-specific functions:
+ * - l64a() - Convert long to base64 string (used in salt generation)
+ * - getspnam() - Get shadow password entry (used in password verification)
+ * - struct spwd - Shadow password structure
+ *
+ * These functions are not available in musl libc used by OpenHarmony.
+ */
+
+#ifndef MUSL_SHIM_H
+#define MUSL_SHIM_H 1
+
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <stdio.h>
+
+/* l64a() - Convert a 32-bit integer to a 6-character base64 string
+ * This is a glibc extension not available in musl.
+ * The conversion uses a base64 alphabet: ./0-9A-Za-z
+ */
+char *l64a(long value);
+
+/* Shadow password support - not available in musl libc */
+struct spwd {
+    char *sp_namp;    /* Login name */
+    char *sp_pwdp;    /* Encrypted password */
+    long sp_lstchg;   /* Last password change */
+    long sp_min;      /* Minimum days between changes */
+    long sp_max;      /* Maximum days between changes */
+    long sp_warn;     /* Days before expiration to warn */
+    long sp_inact;    /* Days after expiration until account locked */
+    long sp_expire;   /* Days until account expires */
+    unsigned long sp_flag; /* Reserved */
+};
+
+/* getspnam() - Get shadow password entry by name
+ * Returns NULL if shadow passwords are not available (OpenHarmony)
+ */
+struct spwd *getspnam(const char *name);
+
+#endif /* MUSL_SHIM_H */