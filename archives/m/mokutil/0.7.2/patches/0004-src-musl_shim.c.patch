diff -ruN a/src/musl_shim.c b/src/musl_shim.c
--- a/src/musl_shim.c
+++ b/src/musl_shim.c
@@ -0,0 +1,44 @@
+/*
+ * musl_shim.c - Compatibility shim implementations for musl libc (OpenHarmony)
+ *
+ * Provides missing glibc-specific functions used by mokutil.
+ */
+
+#include "musl_shim.h"
+
+/* l64a() - Convert a 32-bit integer to a 6-character base64 string
+ * glibc uses the alphabet: ./0-9A-Za-z (64 chars)
+ * Only the lower 32 bits of the value are used, producing up to 6 characters.
+ * Returns a pointer to a static buffer (not thread-safe, same as glibc).
+ */
+char *l64a(long value)
+{
+    static char buf[7];
+    const char alphabet[] = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+    uint32_t v = (uint32_t)(value & 0xffffffff);
+    int i;
+
+    if (v == 0) {
+        buf[0] = '\0';
+        return buf;
+    }
+
+    for (i = 0; v != 0 && i < 6; i++) {
+        buf[i] = alphabet[v & 0x3f];
+        v >>= 6;
+    }
+    buf[i] = '\0';
+
+    return buf;
+}
+
+/* getspnam() - Get shadow password entry by name
+ * On OpenHarmony (musl libc), shadow passwords are not supported.
+ * Always returns NULL to indicate shadow passwords are unavailable.
+ * mokutil code handles NULL return by returning -1 from get_password_from_shadow().
+ */
+struct spwd *getspnam(const char *name)
+{
+    (void)name; /* unused */
+    return NULL;
+}