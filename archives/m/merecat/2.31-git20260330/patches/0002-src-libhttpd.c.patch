+/*
+ * The POSIX "other" permission bits are not reported by every file system.
+ * HMDFS, which hosts /storage/Users on HarmonyOS PC, masks them out: a file
+ * that is chmod(2)ed 0777 is still reported as 0750, so the world-readable
+ * and world-executable tests below - all of them written in terms of
+ * S_IROTH/S_IXOTH - would reject every static file, directory listing and
+ * CGI program with 403.
+ *
+ * httpd_other_bits_hidden() decides, once per device and cached, whether the
+ * "other" bits seen in st_mode can be trusted for the file system holding
+ * the file.  Only positive evidence turns the fallback off: a 0777 file is
+ * created in the temporary directory and read back, and that answer is used
+ * only when the temporary directory lives on the same device as the file
+ * being checked.  A file system that reports the bits faithfully therefore
+ * keeps the upstream tests verbatim - "the server can read it" must never be
+ * mistaken for "everyone can read it" - while a file system that hides the
+ * bits falls back to an access(2) probe, the closest available equivalent,
+ * while a probe that cannot tell keeps the upstream test unchanged.
+ */
+static int httpd_other_bits_hidden(dev_t dev)
+{
+	static dev_t cached_dev;
+	static int cached = -1;
+	struct stat tsb, psb;
+	const char *dir;
+	char path[PATH_MAX];
+	int fd;
+
+	/* Cached per device, so one probe covers a whole directory listing. */
+	if (cached >= 0 && cached_dev == dev)
+		return cached;
+
+	/*
+	 * Fail safe: assume the file system reports the "other" bits until
+	 * the runtime probe below proves otherwise (evidence only, no
+	 * platform conditional; R8).
+	 */
+	cached = 0;
+
+	dir = getenv("TMPDIR");
+	if (dir == NULL || *dir == '\0')
+		dir = _PATH_TMP;
+
+	if (stat(dir, &tsb) == 0 && tsb.st_dev == dev &&
+	    snprintf(path, sizeof(path), "%s/merecat-othbits-XXXXXX", dir) < (int)sizeof(path)) {
+		fd = mkstemp(path);
+		if (fd >= 0) {
+			if (fchmod(fd, S_IRWXU | S_IRWXG | S_IRWXO) == 0 &&
+			    fstat(fd, &psb) == 0)
+				cached = (psb.st_mode & (S_IROTH | S_IXOTH)) ? 0 : 1;
+			close(fd);
+			unlink(path);
+		}
+	}
+
+	cached_dev = dev;
+	return cached;
+}
+
+/* World-executable test used for CGI programs. */
+static int httpd_executable(const char *path, const struct stat *sb)
+{
+	if (sb->st_mode & S_IXOTH)
+		return 1;
+	if (!httpd_other_bits_hidden(sb->st_dev))
+		return 0;
+
+	return path && access(path, X_OK) == 0;
+}
+
+/* World-readable/world-executable test used for static files. */
+static int httpd_accessible(const char *path, const struct stat *sb, mode_t bits)
+{
+	if (sb->st_mode & bits)
+		return 1;
+	if (!httpd_other_bits_hidden(sb->st_dev))
+		return 0;
+
+	return path && access(path, R_OK) == 0;
+}
