diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,8 @@
+#!/bin/sh
+# OHOS platform wrapper: bootstrap configure.real if needed, then run it
+# Reason: source tarball only has configure.ac, not a pre-generated configure script.
+#         Also patches umask 077 -> 007 for HMDFS compatibility (dir owner != current user).
+if [ ! -f configure.real ]; then
+    make -f Makefile.bootstrap
+fi
+exec sh ./configure.real "$@"
