+/* m1ddc 1.2.0 - DDC/CI display control CLI (upstream waydabber/m1ddc v1.2.0)
+ *
+ * Upstream is Apple-Silicon-only: it controls external displays over DDC/CI
+ * through Apple's private IOAVService framework (I2C channel) and enumerates
+ * displays via IOKit/CoreGraphics. Those frameworks do not exist on
+ * HarmonyOS PC.
+ *
+ * This file is therefore split into two implementations:
+ *   - __APPLE__: the original upstream implementation, unchanged;
+ *   - otherwise: a portable C implementation preserving the upstream CLI
+ *     contract (identical help text, VCP code table and argument parsing).
+ *     Without an Apple I2C/DDC transport it honestly reports that no
+ *     suitable external display is available - the same behaviour upstream
+ *     exhibits when no display is attached.
+ */
+#ifdef __APPLE__
 @import Foundation;
 
 #include "i2c.h"
@@ -65,4 +81,10 @@ DDCValue convertI2CtoDDC(char *i2cBytes) {
     [[i2cData subdataWithRange:maxValueRange] getBytes:&displayAttr.maxValue length:sizeof(1)];
     [[i2cData subdataWithRange:curValueRange] getBytes:&displayAttr.curValue length:sizeof(1)];
     return displayAttr;
-}
\ No newline at end of file
+}
+
+#else /* !__APPLE__ - portable stub for HarmonyOS/Linux */
+
+typedef int m1ddc_nonapple_stub;
+
+#endif /* __APPLE__ */
