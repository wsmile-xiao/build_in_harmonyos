diff --git a/sources/m1ddc.m b/sources/m1ddc.m
index 4fa5f12..ac70e4c 100644
--- a/sources/m1ddc.m
+++ b/sources/m1ddc.m
@@ -1,3 +1,19 @@
+/* m1ddc 1.2.0 - DDC/CI display control CLI (upstream waydabber/m1ddc v1.2.0)
+ *
+ * Upstream is Apple-Silicon-only: it controls external displays over DDC/CI
+ * through Apple's private IOAVService framework (I2C channel) and enumerates
+ * displays via IOKit/CoreGraphics. Those frameworks do not exist on
+ * HarmonyOS PC.
+ *
+ * This file is therefore split into two implementations:
+ *   - __APPLE__: the original upstream implementation, unchanged;
+ *   - otherwise: a portable C implementation preserving the upstream CLI
+ *     contract (identical help text, VCP code table and argument parsing).
+ *     Without an Apple I2C/DDC transport it honestly reports that no
+ *     suitable external display is available - the same behaviour upstream
+ *     exhibits when no display is attached.
+ */
+#ifdef __APPLE__
 @import Darwin;
 @import Foundation;
 @import IOKit;
@@ -272,4 +288,154 @@ int main(int argc, char** argv) {
     }
     writeToStdOut(@"Use 'set', 'get', 'max', 'chg' as first parameter! Enter 'm1ddc help' for help!\n");
     return EXIT_FAILURE;
-}
\ No newline at end of file
+}
+
+#else /* !__APPLE__ - portable implementation for HarmonyOS/Linux */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define M1DDC_LUMINANCE 0x10
+#define M1DDC_CONTRAST 0x12
+#define M1DDC_VOLUME 0x62
+#define M1DDC_MUTE 0x8D
+#define M1DDC_INPUT 0x60
+#define M1DDC_INPUT_ALT 0xF4
+#define M1DDC_STANDBY 0xD6
+#define M1DDC_RED 0x16
+#define M1DDC_GREEN 0x18
+#define M1DDC_BLUE 0x1A
+#define M1DDC_PBP_INPUT 0xE8
+#define M1DDC_PBP 0xE9
+
+static const char *M1DDC_USAGE_TEXT =
+    "Controls volume, luminance (brightness), contrast, color gain, input of an external Display connected via USB-C (DisplayPort Alt Mode) over DDC on an Apple Silicon Mac.\n"
+    "Displays attached via the built-in HDMI port of M1 or entry level M2 Macs are not supported.\n"
+    "\n"
+    "Usage examples:\n"
+    "\n"
+    " m1ddc set contrast 5          - Sets contrast to 5\n"
+    " m1ddc get luminance           - Returns current luminance\n"
+    " m1ddc set red 90              - Sets red gain to 90\n"
+    " m1ddc chg volume -10          - Decreases volume by 10\n"
+    " m1ddc display list            - Lists displays\n"
+    " m1ddc display 1 set volume 50 - Sets volume to 50 on Display 1\n"
+    "\n"
+    "Commands:\n"
+    "\n"
+    " set luminance n         - Sets luminance (brightness) to n, where n is a number between 0 and the maximum value (usually 100).\n"
+    "     contrast n          - Sets contrast to n, where n is a number between 0 and the maximum value (usually 100).\n"
+    "     (red,green,blue) n  - Sets selected color channel gain to n, where n is a number between 0 and the maximum value (usually 100).\n"
+    "     volume n            - Sets volume to n, where n is a number between 0 and the maximum value (usually 100).\n"
+    "     input n             - Sets input source to n, common values include:\n"
+    "                           DisplayPort 1: 15, DisplayPort 2: 16, HDMI 1: 17, HDMI 2: 18, USB-C: 27.\n"
+    "     input-alt n         - Sets input source to n (using alternate addressing, as used by LG), common values include:\n"
+    "                           DisplayPort 1: 208, DisplayPort 2: 209, HDMI 1: 144, HDMI 2: 145, USB-C / DP 3: 210.\n"
+    "\n"
+    "     mute on             - Sets mute on (you can use 1 instead of 'on')\n"
+    "     mute off            - Sets mute off (you can use 2 instead of 'off')\n"
+    "\n"
+    "     pbp n               - Switches PIP/PBP on certain Dell screens (e.g. U3421W), possible values:\n"
+    "                           off: 0, small window: 33, large window: 34, 50/50 split: 36, 26/74 split: 43, 74/26 split: 44.\n"
+    "     pbp-input n         - Sets second PIP/PBP input on certain Dell screens, possible values:\n"
+    "                           DisplayPort 1: 15, DisplayPort 2: 16, HDMI 1: 17, HDMI 2: 18.\n"
+    "\n"
+    " get luminance           - Returns current luminance (if supported by the display).\n"
+    "     contrast            - Returns current contrast (if supported by the display).\n"
+    "     (red,green,blue)    - Returns current color gain (if supported by the display).\n"
+    "     volume              - Returns current volume (if supported by the display).\n"
+    "\n"
+    " max luminance           - Returns maximum luminance (if supported by the display, usually 100).\n"
+    "     contrast            - Returns maximum contrast (if supported by the display, usually 100).\n"
+    "     (red,green,blue)    - Returns maximum color gain (if supported by the display, usually 100).\n"
+    "     volume              - Returns maximum volume (if supported by the display, usually 100).\n"
+    "\n"
+    " chg luminance n         - Changes luminance by n and returns the current value (requires current and max reading support).\n"
+    "     contrast n          - Changes contrast by n and returns the current value (requires current and max reading support).\n"
+    "     (red,green,blue) n  - Changes color gain by n and returns the current value (requires current and max reading support).\n"
+    "     volume n            - Changes volume by n and returns the current value (requires current and max reading support).\n"
+    "\n"
+    " display list [detailed] - Lists displays. If `detailed` is provided, prints display extended attributes.\n"
+    "         n               - Chooses which display to control (use number 1, 2 etc.)\n"
+    "         (method=)<id>   - Chooses which display to control using a specific identification method. (If not set, it defaults to `uuid`).\n"
+    "\n"
+    "Tip: You can also use 'l', 'v' instead of 'luminance', 'volume' etc.\n";
+
+static int m1ddc_streq(const char *a, const char *b) {
+    return strcmp(a, b) == 0;
+}
+
+static int m1ddc_command_supported(const char *name) {
+    return m1ddc_streq(name, "set") || m1ddc_streq(name, "get") ||
+           m1ddc_streq(name, "max") || m1ddc_streq(name, "chg");
+}
+
+static unsigned char m1ddc_attr_code(const char *command) {
+    if (m1ddc_streq(command, "luminance") || m1ddc_streq(command, "l")) return M1DDC_LUMINANCE;
+    else if (m1ddc_streq(command, "contrast") || m1ddc_streq(command, "c")) return M1DDC_CONTRAST;
+    else if (m1ddc_streq(command, "volume") || m1ddc_streq(command, "v")) return M1DDC_VOLUME;
+    else if (m1ddc_streq(command, "mute") || m1ddc_streq(command, "m")) return M1DDC_MUTE;
+    else if (m1ddc_streq(command, "input") || m1ddc_streq(command, "i")) return M1DDC_INPUT;
+    else if (m1ddc_streq(command, "input-alt") || m1ddc_streq(command, "I")) return M1DDC_INPUT_ALT;
+    else if (m1ddc_streq(command, "standby") || m1ddc_streq(command, "s")) return M1DDC_STANDBY;
+    else if (m1ddc_streq(command, "red") || m1ddc_streq(command, "r")) return M1DDC_RED;
+    else if (m1ddc_streq(command, "green") || m1ddc_streq(command, "g")) return M1DDC_GREEN;
+    else if (m1ddc_streq(command, "blue") || m1ddc_streq(command, "b")) return M1DDC_BLUE;
+    else if (m1ddc_streq(command, "pbp") || m1ddc_streq(command, "p")) return M1DDC_PBP;
+    else if (m1ddc_streq(command, "pbp-input") || m1ddc_streq(command, "pi")) return M1DDC_PBP_INPUT;
+    return 0x00;
+}
+
+int main(int argc, char **argv) {
+    argv += 1;
+    argc -= 1;
+
+    if (argc < 2) {
+        fputs(M1DDC_USAGE_TEXT, stdout);
+        return (argc && m1ddc_streq(argv[0], "help")) ? 1 : 0;
+    }
+
+    if (m1ddc_streq(argv[0], "-v") || m1ddc_streq(argv[0], "--verbose")) {
+        argv += 1;
+        argc -= 1;
+        if (argc < 2) {
+            fputs(M1DDC_USAGE_TEXT, stdout);
+            return 1;
+        }
+    }
+
+    if (m1ddc_streq(argv[0], "display")) {
+        if (m1ddc_streq(argv[1], "list") || m1ddc_streq(argv[1], "l")) {
+            fputs("No external display found, aborting", stdout);
+            return 1;
+        }
+        fputs("The specified display does not exist. Use 'display list' to list displays and use it's number (1, 2...) or its UUID to specify display!\n", stdout);
+        return 1;
+    }
+
+    if (!m1ddc_command_supported(argv[0])) {
+        fputs("Use 'set', 'get', 'max' or 'chg' as first parameter! Enter 'm1ddc help' for help!\n", stdout);
+        return 1;
+    }
+
+    if (m1ddc_attr_code(argv[1]) == 0x00) {
+        fputs("Invalid command! Enter 'm1ddc help' for help!\n", stdout);
+        return 1;
+    }
+
+    if ((m1ddc_streq(argv[0], "set") || m1ddc_streq(argv[0], "chg")) && argc < 3) {
+        fputs("Missing value! Enter 'm1ddc help' for help!\n", stdout);
+        return 1;
+    }
+
+    if (!m1ddc_streq(argv[0], "set") && argc < 2) {
+        fputs("Missing parameter! Enter 'm1ddc help' for help!\n", stdout);
+        return 1;
+    }
+
+    fputs("Could not find a suitable external display.\n", stdout);
+    return 1;
+}
+
+#endif /* __APPLE__ */
