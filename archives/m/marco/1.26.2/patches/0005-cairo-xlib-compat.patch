+/* Standalone Cairo-Xlib compatibility declarations for non-Xlib Cairo builds.
+ *
+ * HarmonyOS 制品仓的 cairo/1.18.4 以 xlib=disabled 构建（无 cairo_xlib_* 符号
+ * 与 cairo-xlib.h）。marco 的窗口边框（src/ui/ui.c、src/ui/frames.c）与
+ * xrender 合成器（src/compositor/compositor-xrender.c）需要把 X pixmap 变成
+ * cairo surface，故这里提供同名的替代实现（XGetImage 取像素 + cairo image
+ * surface），窗口枚举与 X11 数据面仍走真实 libX11。
+ */
+#ifndef MARCO_CAIRO_XLIB_COMPAT_H
+#define MARCO_CAIRO_XLIB_COMPAT_H
+
+#include <cairo.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+
+CAIRO_BEGIN_DECLS
+
+cairo_surface_t *cairo_xlib_surface_create (Display *dpy,
+                                            Drawable drawable,
+                                            Visual *visual,
+                                            int width,
+                                            int height);
+
+cairo_surface_t *cairo_xlib_surface_create_for_bitmap (Display *dpy,
+                                                       Pixmap bitmap,
+                                                       Screen *screen,
+                                                       int width,
+                                                       int height);
+
+int cairo_xlib_surface_get_width (cairo_surface_t *surface);
+
+int cairo_xlib_surface_get_height (cairo_surface_t *surface);
+
+CAIRO_END_DECLS
+
+#endif
