--- /dev/null
+++ b/src/x11-compat/canberra-gtk.h
@@ -0,0 +1,21 @@
+/* Minimal libcanberra-gtk shim.
+ *
+ * marco only uses the ca_gtk_context_get() convenience accessor from
+ * libcanberra-gtk (src/core/bell.c, src/core/workspace.c).  The libcanberra
+ * build shipped with HarmonyOS PC disables the gtk3 module, so neither
+ * <canberra-gtk.h> nor libcanberra-gtk3.pc exists.  This header provides the
+ * single declaration; the implementation lives in marco-x11-compat.c and
+ * deliberately does not pull in any GTK+ header.
+ */
+#ifndef MARCO_CANBERRA_GTK_COMPAT_H
+#define MARCO_CANBERRA_GTK_COMPAT_H
+
+#include <canberra.h>
+
+G_BEGIN_DECLS
+
+ca_context *ca_gtk_context_get (void);
+
+G_END_DECLS
+
+#endif /* MARCO_CANBERRA_GTK_COMPAT_H */
