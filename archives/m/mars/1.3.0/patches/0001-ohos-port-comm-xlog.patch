+/*
+ * Feature-detect the BSD sysctl debugger probe instead of branching on a
+ * platform macro: glibc/musl do not provide <sys/sysctl.h> at all, so on
+ * those libcs (Linux incl. OHOS) the probe falls back to the Linux
+ * standard /proc/self/status TracerPid indicator — same debugger-attach
+ * semantics as the BSD P_TRACED flag check below.
+ */
+#if defined(__has_include)
+#  if __has_include(<sys/sysctl.h>)
+#    include <sys/sysctl.h>
+#    define MARSCOMM_HAVE_BSD_SYSCTL 1
+#  endif
+#endif
+
+#ifndef MARSCOMM_HAVE_BSD_SYSCTL
+#  include <stdio.h>
+#  include <stdlib.h>
+#  include <string.h>
+
+int isDebuggerPerforming() {
+    FILE* f = fopen("/proc/self/status", "r");
+    if (!f) return 0;
+
+    char line[256];
+    int traced = 0;
+    while (fgets(line, sizeof(line), f)) {
+        if (0 == strncmp(line, "TracerPid:", 10)) {
+            traced = (strtol(line + 10, NULL, 10) != 0);
+            break;
+        }
+    }
+    fclose(f);
+    return traced;
+}
+
+#else /* MARSCOMM_HAVE_BSD_SYSCTL */
 
 int isDebuggerPerforming() {
     struct kinfo_proc infos_process;
@@ -39,3 +74,5 @@ int isDebuggerPerforming() {
     int flags = process.p_flag;
     return flags & P_TRACED;       // value of the debug flag
 }
+
+#endif /* MARSCOMM_HAVE_BSD_SYSCTL */
