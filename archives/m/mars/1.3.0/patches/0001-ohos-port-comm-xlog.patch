+// See the License for the specific language governing permissions and limitations under the License.
+
+/*
+ * platform_comm_ohos.cc
+ *
+ * HarmonyOS (OHOS) implementation of the platform abstraction layer that
+ * upstream mars provides through comm/jni/platform_comm.cc (Android, backed
+ * by Java callbacks over JNI).  OHOS native consumers have no Java bridge
+ * inside the library, so the network-state queries fall back to link-level
+ * detection (equivalent to what a headless Linux build would do) and the
+ * alarm/wakelock entry points become no-ops: the Timer driver of mars's
+ * MessageQueue already delivers the Alarm callback without the Android
+ * kernel alarm device, and OHOS PCs have no suspend wakelock concept.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "comm/platform_comm.h"
+#include "comm/socket/local_ipstack.h"
+#include "comm/xlogger/xlogger.h"
+#include "comm/xlogger/loginfo_extract.h"
+
+void ConsoleLog(const XLoggerInfo* _info, const char* _log) {
+    /*
+     * Upstream semantics: the console sink is an *output* of the xlogger
+     * pipeline, next to the file appender — Android routes it to
+     * __android_log_write (logcat), Windows to the debug console. Neither
+     * feeds back into xlogger_Write: doing so would recurse
+     * (ConsoleLog -> xlogger_Write -> appender -> ConsoleLog ...) up to the
+     * recursion guard. OHOS native has no logcat; write to stderr, which
+     * hilogd/hilog buffers pick up for native processes.
+     */
+    char result_log[2048] = {0};
+    if (_info) {
+        const char* filename = ExtractFileName(_info->filename);
+        char strFuncName[128] = {0};
+        ExtractFunctionName(_info->func_name, strFuncName, sizeof(strFuncName));
+        static const char* levelStrings[] = {
+            "V", "D", "I", "W", "E", "F"
+        };
+        const char* level = (_info->level >= 0 && _info->level <= 5)
+                            ? levelStrings[_info->level] : "?";
+        snprintf(result_log, sizeof(result_log), "[%s][%s][%s, %s, %d]:%s",
+                 level, _info->tag ? _info->tag : "", filename, strFuncName,
+                 _info->line, _log ? _log : "NULL==log!!!");
+    } else {
+        snprintf(result_log, sizeof(result_log), "%s", _log ? _log : "NULL==log!!!");
+    }
+    fputs(result_log, stderr);
+    fputc('\n', stderr);
+}
+
+int getNetInfo() {
+    // No Java-side NetworkCallback on OHOS; infer connectivity from the
+    // local IP stack (UDP-connect probe, same technique comm already uses
+    // for AI_ADDRCONFIG detection).
+    TLocalIPStack stack = local_ipstack_detect();
+    if (ELocalIPStack_IPv4 == stack || ELocalIPStack_IPv6 == stack || ELocalIPStack_Dual == stack) {
+        return kOtherNet;
+    }
+    return kNoNet;
+}
+
+bool getCurRadioAccessNetworkInfo(RadioAccessNetworkInfo& _raninfo) {
+    // OHOS PCs are not cellular; no RAN info available.
+    return false;
+}
+
+bool getCurWifiInfo(WifiInfo& _wifi_info) {
+    // SSID/BSSID require the Wi-Fi Kit (ArkTS); native layer cannot query.
+    return false;
+}
+
+bool getCurSIMInfo(SIMInfo& _sim_info) {
+    return false;
+}
+
+bool getAPNInfo(APNInfo& _info) {
+    return false;
+}
+
+bool isNetworkConnected() {
+    return kNoNet != getNetInfo();
+}
+
+bool getProxyInfo(int& _port, std::string& _strProxy, const std::string& _host) {
+    return false;
+}
