diff -ruN a/src/password.c b/src/password.c
--- a/src/password.c	2026-09-26 07:42:36.214682032 +0800
+++ b/src/password.c	2026-09-26 07:42:36.386682344 +0800
@@ -211,6 +211,16 @@
         }
         if (getpass_is_allowed)
         {
+            /*
+             * configure already probes for getpass() (AC_CHECK_FUNCS), so the
+             * call is guarded by the result: OHOS' C library neither declares
+             * getpass() in <unistd.h> nor exports the symbol, and an
+             * unguarded call makes the final link fail with
+             * "ld.lld: error: undefined symbol: getpass / referenced by
+             * password.c".  Where the function is missing, the password still
+             * comes from --passwordeval or the netrc file.
+             */
+#ifdef HAVE_GETPASS
             char *prompt = xasprintf(_("password for %s at %s: "), user, hostname);
             char *gpw = getpass(prompt);
             free(prompt);
@@ -218,6 +228,7 @@
             {
                 password = xstrdup(gpw);
             }
+#endif
         }
     }
 
