--- a/mmap_allocator.h
+++ b/mmap_allocator.h
@@ -121,20 +121,48 @@
 			map_whole_file((flags & MAP_WHOLE_FILE) != 0),
 			allow_remap((flags & ALLOW_REMAP) != 0),
 			bypass_file_pool((flags & BYPASS_FILE_POOL) != 0),
 			private_file(),
 			keep_forever((flags & KEEP_FOREVER) != 0)
 		{
 		}
 			
 		~mmap_allocator() throw() { }
 
+#if defined(_LIBCPP_VERSION)
+		/* libc++ adaptation: mmappable_vector::mmap_file() grows the vector
+		 * via resize(); the no-argument construct must NOT write into the
+		 * mmap-backed region (the file content is the element storage).
+		 * Value constructs (resize(n, x), fill/range constructors) must still
+		 * behave normally. */
+		template <class U>
+		void construct(U *p)
+		{
+			(void)p;
+		}
+		template <class U, class... Args>
+		void construct(U *p, Args &&...args)
+		{
+			::new (static_cast<void*>(p)) U(std::forward<Args>(args)...);
+		}
+		template <class U>
+		void destroy(U *p)
+		{
+			(void)p;
+		}
+		/* Stateful allocator: container swap/move must transfer the file
+		 * configuration along with the storage. */
+		typedef std::true_type propagate_on_container_swap;
+		typedef std::true_type propagate_on_container_move_assignment;
+		typedef std::true_type propagate_on_container_copy_assignment;
+#endif
+
 private:
 		friend class mmappable_vector<T, mmap_allocator<T> >;
 
