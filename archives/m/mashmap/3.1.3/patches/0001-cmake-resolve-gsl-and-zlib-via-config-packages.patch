@@ -58,6 +58,15 @@
 
 add_compile_options(-Wfatal-errors)
 
+# GSL and zlib are resolved through their config packages instead of the bare
+# `gsl`/`gslcblas`/`z` link names below. The bare names only work when the
+# dependencies happen to sit in the default system library search path; a
+# cross build with dependencies staged outside the sysroot needs both the
+# include directory (gsl/gsl_cdf.h, zlib.h) and the exact library paths, and
+# only the config packages carry them.
+find_package(gsl CONFIG REQUIRED)
+find_package(zlib CONFIG REQUIRED)
