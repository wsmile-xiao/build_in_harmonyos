diff --git a/munit.c b/munit.c
--- a/munit.c
+++ b/munit.c
@@ -864,3 +864,33 @@ munit_restore_stderr(int orig_stderr) {
 }
-
+static FILE*
+munit_create_stderr_buffer(void) {
+  const char* tmpdir = getenv("MUNIT_TMPDIR");
+  const size_t suffix_len = strlen("/munit-XXXXXX");
+  size_t tmpdir_len;
+  char* path;
+  int fd;
+  FILE* fp;
+
+  if (tmpdir == NULL || *tmpdir == '\0')
+    return tmpfile();
+
+  tmpdir_len = strlen(tmpdir);
+  path = malloc(tmpdir_len + suffix_len + 2);
+  if (path == NULL)
+    return NULL;
+  snprintf(path, tmpdir_len + suffix_len + 2, "%s%smunit-XXXXXX", tmpdir,
+           (tmpdir[tmpdir_len - 1] == '/') ? "" : "/");
+  fd = mkstemp(path);
+  if (fd == -1) {
+    free(path);
+    return NULL;
+  }
+  unlink(path);
+  free(path);
+  fp = fdopen(fd, "w+b");
+  if (fp == NULL)
+    close(fd);
+  return fp;
+}
+
 /* Run a test with the specified parameters. */
@@ -898,6 +928,6 @@ munit_test_runner_run_test_with_params(MunitTestRunner* runner, const MunitTest* test, const MunitParameter params[]) {
   FILE* stderr_buf = NULL;
 #if !defined(_WIN32) || defined(__MINGW32__)
-  stderr_buf = tmpfile();
+  stderr_buf = munit_create_stderr_buffer();
 #else
   tmpfile_s(&stderr_buf);
 #endif
