--- a/src/mlmmj-make-ml.in
+++ b/src/mlmmj-make-ml.in
@@ -7,6 +7,17 @@
 ALIASFILE=/etc/aliases
 CRONTAB=/etc/crontab
 TEXTLIBDIR="@textlibdir@"
+
+# Prefer the text skeleton shipped next to this script (relocatable
+# installs such as Conan packages); keep the configured default otherwise.
+case "$0" in
+	*/*) SELFPATH="$0" ;;
+	*) SELFPATH=`command -v -- "$0" 2>/dev/null || echo "$0"` ;;
+esac
+SELFDIR=`dirname "$SELFPATH"`
+if [ -d "$SELFDIR/../share/mlmmj/text.skel" ]; then
+	TEXTLIBDIR=`cd "$SELFDIR/../share/mlmmj/text.skel" && pwd`
+fi
 
 USAGE="mlmmj-make-ml $VERSION
 
