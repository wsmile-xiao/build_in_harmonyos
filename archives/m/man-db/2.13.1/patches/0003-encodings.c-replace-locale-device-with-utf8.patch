From 4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3 Mon Sep 17 00:00:00 2001
From: OpenDesk <opendesk@openharmony.io>
Date: Mon, 23 Mar 2026 20:04:00 +0800
Subject: [PATCH 3/4] lib/encodings.c: replace "locale" device with "utf8"

groff 1.23.0 does not provide a "locale" (devlocale) device.
Replace the charset_table entry from "locale" to "utf8" under
the HEIRLOOM_NROFF code path.

The comment "Not strictly accurate, but we only use this in UTF-8
locales" already acknowledges this is a simplification; using
"utf8" is a closer match on systems with groff >= 1.23.
---
 lib/encodings.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/encodings.c b/lib/encodings.c
index 0123456..789abcd 100644
--- a/lib/encodings.c
+++ b/lib/encodings.c
@@ -241,7 +241,7 @@
 
 #ifdef HEIRLOOM_NROFF
         /* Not strictly accurate, but we only use this in UTF-8 locales. */
-        {"locale",  "UTF-8",          "UTF-8"         },
+        {"utf8",   "UTF-8",          "UTF-8"         },
 #endif  /* HEIRLOOM_NROFF */
 
         /* troff devices */
-- 
2.39.3
