From 5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4 Mon Sep 17 00:00:00 2001
From: OpenDesk <opendesk@openharmony.io>
Date: Mon, 23 Mar 2026 20:03:00 +0800
Subject: [PATCH 4/4] src/man.c: replace "locale" roff_device with "utf8"

Under HEIRLOOM_NROFF, when the locale charset is UTF-8, the code
sets roff_device to "locale". groff 1.23.0 does not have a "locale"
device (devlocale), causing "unable to find device 'locale'" errors.

Replace with "utf8" which is available in all modern groff versions.
---
 src/man.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/man.c b/src/man.c
index 3456789..bcdef01 100644
--- a/src/man.c
+++ b/src/man.c
@@ -1275,7 +1275,7 @@
 					if (real_locale_charset &&
 					    STREQ (real_locale_charset,
 					           "UTF-8"))
-						roff_device = "locale";
+					roff_device = "utf8";
 				}
 #endif /* HEIRLOOM_NROFF */
 				debug ("roff_device (locale) = %s\n",
-- 
2.39.3
