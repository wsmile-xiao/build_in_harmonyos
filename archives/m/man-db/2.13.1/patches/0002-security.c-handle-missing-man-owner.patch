From 3b8c7d6e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c Mon Sep 17 00:00:00 2001
From: OpenDesk <opendesk@openharmony.io>
Date: Mon, 23 Mar 2026 19:44:00 +0800
Subject: [PATCH 2/4] lib/security.c: handle missing MAN_OWNER gracefully

When the "man" system user does not exist (common on HarmonyOS),
get_man_owner() should warn and return NULL instead of calling
error(FAIL) which terminates the program.

This allows man-db to run without privilege dropping on systems
where the man user is not configured.

Note: An alternative approach is to #undef MAN_OWNER in config.h,
which excludes all privilege-related code at compile time. This
patch provides a softer fallback when MAN_OWNER is defined but
the user does not exist.
---
 lib/security.c | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/lib/security.c b/lib/security.c
index fedcba0..abcdef1 100644
--- a/lib/security.c
+++ b/lib/security.c
@@ -115,11 +115,11 @@
 		return man_owner;
 
 	man_owner = getpwnam (MAN_OWNER);
-	if (!man_owner)
-		error (FAIL, 0,
-		       _ ("the setuid man user \"%s\" does not exist"),
-		       MAN_OWNER);
-	assert (man_owner);
+	if (!man_owner) {
+		debug ("the setuid man user \"%s\" does not exist, "
+		       "running without privilege dropping\n", MAN_OWNER);
+		return NULL;
+	}
 	return man_owner;
 }
 #endif /* MAN_OWNER */
