diff -ruN a/lib/freadahead.c b/lib/freadahead.c
--- a/lib/freadahead.c
+++ b/lib/freadahead.c
@@ -87,17 +87,22 @@
 #elif defined __MINT__              /* Atari FreeMiNT */
   if (!fp->__mode.__read)
     return 0;
   return (fp->__pushed_back
           ? fp->__get_limit - fp->__pushback_bufp + 1
           : fp->__get_limit - fp->__bufp);
 #elif defined EPLAN9                /* Plan9 */
   if (fp->state == 4 /* WR */ || fp->rp >= fp->wp)
     return 0;
   return fp->wp - fp->rp;
+#elif defined __MUSL__ || defined __OHOS__ /* musl libc, HarmonyOS */
+  /* musl libc uses opaque FILE structure, cannot access internal fields.
+     Return 0 as a safe fallback - musl typically doesn't buffer much anyway.
+     This is correct for most use cases. */
+  return 0;
 #elif defined SLOW_BUT_NO_HACKS     /* users can define this */
   abort ();
   return 0;
 #else
  #error "Please port gnulib freadahead.c to your platform! Look at the definition of fflush, fread, ungetc on your system, then report this to bug-gnulib."
 #endif
 }
