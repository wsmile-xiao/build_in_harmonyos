@@ -169,7 +169,19 @@
 
     }
 
-    assert ( simpleaudio_write(sa_out, buf, nsamples_dur) > 0 );
+    /* OHOS adaptation: this was the ONLY audio write, and it lived inside
+     * assert(); with -DNDEBUG (conan Release default) the write vanished and
