diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -57,10 +57,15 @@
 INCLUDE_DIRECTORIES(${CMAKE_CURRENT_SOURCE_DIR})
 
 ADD_LIBRARY(maxflow SHARED maxflow.cpp)
-SET_TARGET_PROPERTIES(maxflow PROPERTIES 
-  SOVERSION ${LIBRARY_SOVERSION_INFO}
-  VERSION ${LIBRARY_VERSION_INFO}
-  )
+# HMDFS (/storage) has no symlink(2): VERSION/SOVERSION make CMake create
+# libmaxflow.so.0 / libmaxflow.so symlinks, which fail with
+# "cmake_symlink_library: Permission denied" on the OHOS device.  Drop the
+# versioned names and ship a flat libmaxflow.so (knowledge:
+# DRAFT-libfreenect-0.5.3-hmdfs-shared-lib-versioned-symlink).
+# SET_TARGET_PROPERTIES(maxflow PROPERTIES
+#   SOVERSION ${LIBRARY_SOVERSION_INFO}
+#   VERSION ${LIBRARY_VERSION_INFO}
+#   )
 
 INSTALL(TARGETS maxflow
   EXPORT MaxFlow
