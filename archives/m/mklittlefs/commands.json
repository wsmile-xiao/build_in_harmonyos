{
  "name": "mklittlefs",
  "description": "LittleFS 文件系统镜像构建工具（创建/列出/解包）",
  "homepage": "https://github.com/earlephilhower/mklittlefs",
  "type": "tool",
  "versions": {
    "4.1.0": {
      "ref": "mklittlefs/4.1.0",
      "binary": false,
      "commands": {
        "mklittlefs": {
          "path": "bin/mklittlefs",
          "usage": "mklittlefs [-c dir] [-l img] [-u dir] [-s size] [-b block] [-p page] [--size-bytes] ...",
          "subcommands": {
            "create": "mklittlefs -c <dir> -s <size> <img>",
            "list": "mklittlefs -l <img>",
            "unpack": "mklittlefs -u <dir> -s <size> <img>"
          }
        }
      }
    }
  }
}
