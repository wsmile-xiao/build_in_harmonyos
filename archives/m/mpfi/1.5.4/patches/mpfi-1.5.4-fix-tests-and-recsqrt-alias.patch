+     as b->left, destroying that input endpoint before the second
+     mpfr_rec_sqrt reads it; b->right is only read, never overwritten
+     first */
+  mpfr_init2 (tmp_left, mpfr_get_prec (&(b->left)));
+  mpfr_init2 (tmp_right, mpfr_get_prec (&(b->right)));
+  mpfr_set (tmp_left, &(b->left), MPFR_RNDN);
+  mpfr_set (tmp_right, &(b->right), MPFR_RNDN);
 
   /* if b is (partially) negative, the left bound will be a NaN */
