-  inexact_right = mpfr_rec_sqrt (&(a->right), &(b->left), MPFI_RNDU);
+  inexact_left = mpfr_rec_sqrt (&(a->left), tmp_right, MPFI_RNDD);
+  inexact_right = mpfr_rec_sqrt (&(a->right), tmp_left, MPFI_RNDU);
+
+  mpfr_clear (tmp_left);
+  mpfr_clear (tmp_right);
 
   /* if ( mpfi_is_zero(b) ) { */
     /* if b is [0-, 0+], mpfr_rec_sqrt returns +Inf for both bounds */
