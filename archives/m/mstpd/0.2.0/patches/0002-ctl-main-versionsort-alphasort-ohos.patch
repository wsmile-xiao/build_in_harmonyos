--- a/ctl_main.c
+++ b/ctl_main.c
@@ -449,7 +449,26 @@
 
 static inline int get_bridge_list(struct dirent ***namelist)
 {
+    /* OHOS sysroot <dirent.h> does not provide the GNU versionsort(3)
+     * extension: the whole SDK include tree carries zero declarations
+     * of it, and the _GNU_SOURCE / _BSD_SOURCE blocks of <dirent.h>
+     * only add getdents() and the *64 aliases, so -D_GNU_SOURCE cannot
+     * make the symbol appear (the same scandir comparator failure is
+     * proven undeclarable that way in archives/b/buildtorrent/0.9.1).
+     * scandir() here only enumerates the bridge interfaces that the
+     * filter accepted, so the comparator decides the ORDER the names
+     * are listed in, never which interfaces are seen: fall back to
+     * POSIX alphasort(3), which <dirent.h> does declare with exactly
+     * the signature scandir() expects.  Disclosed behavior change: on
+     * OHOS 'mstpctl showbridge' lists bridges lexicographically
+     * instead of by embedded version number.  Nothing is disabled and
+     * no test is skipped.
+     */
+#ifdef __OHOS__
+    return scandir(SYSFS_CLASS_NET, namelist, isbridge, alphasort);
+#else
     return scandir(SYSFS_CLASS_NET, namelist, isbridge, versionsort);
+#endif
 }
 
 static int cmd_showbridge(int argc, char *const *argv)
@@ -1168,7 +1187,15 @@
     /* strlen(sysfs_class_net) + strlen("/%.230s/brif") must be < sizeof(buf)
        to prevent truncation ; gcc7's fortify headers complain about that */
     snprintf(buf, sizeof(buf), SYSFS_CLASS_NET "/%.230s/brif", br_ifname);
+    /* Same OHOS fallback as get_bridge_list() above: versionsort(3)
+     * is absent from the sysroot, alphasort(3) enumerates the very
+     * same ports and only orders them lexicographically.
+     */
+#ifdef __OHOS__
+    if(0 > (res = scandir(buf, namelist, not_dot_dotdot, alphasort)))
+#else
     if(0 > (res = scandir(buf, namelist, not_dot_dotdot, versionsort)))
+#endif
         fprintf(stderr, "Error getting list of all ports of bridge %s\n",
                 br_ifname);
     return res;
