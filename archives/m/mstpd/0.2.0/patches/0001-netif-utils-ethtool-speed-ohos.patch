--- a/netif_utils.c
+++ b/netif_utils.c
@@ -117,7 +117,12 @@
         ERROR("Cannot get speed/duplex for %s: %m\n", ifname);
         return -1;
     }
-    *speed = ethtool_cmd_speed(&ecmd); /* Ethtool speed is in Mbps */
+    /* OHOS sysroot linux/ethtool.h does not provide the kernel static
+     * inline ethtool_cmd_speed(); expand its body in place. struct
+     * ethtool_cmd keeps __u16 speed (low 16 bits) + __u16 speed_hi (high
+     * 16 bits), exactly the kernel ABI the inline composes as
+     * speed | (speed_hi << 16). */
+    *speed = (ecmd.speed | (ecmd.speed_hi << 16)); /* Ethtool speed is in Mbps */
     *duplex = ecmd.duplex; /* We have same convention as ethtool.
                                0 = half, 1 = full */
     return 0;
