#====================================================================
# DRAFT-mysqltuner-source-url-fallback - GitHub tag archives need checked mirror fallback on OHOS shadow CI
#====================================================================

id:                     DRAFT-mysqltuner-source-url-fallback
trigger_tool:           conan|tools.files.get|github
phase:                  conan_source|download
error_signature:        Error downloading file https://github\.com/.+ConnectTimeoutError|Connection to github\.com timed out|Max retries exceeded
severity:               2
category:               conan|download|mirror|ohos
match_keywords:         mysqltuner, GitHub tag archive, ghfast, gh-proxy, mirror.ghproxy, sha256, source(), get(), timeout
title:                  Use a SHA-checked URL fallback list for GitHub tag archives on OHOS shadow CI
topic: >
  mysqltuner/2.9.1 source() timed out against github.com on the OHOS device.
  The package itself needed no native build fix; it needed transport fallback.
root_cause: >
  Single GitHub source URL plus unstable device network path blocked source()
  before recipe build/test logic.
durable_solution: >
  Pass a list of mirror URLs to conan.tools.files.get(), keep the official
  GitHub URL as fallback, and retain the verified upstream SHA256.
rec_priority:           2
rec_approach:           sha-checked-source-url-fallback
rec_command:            get(self, url=[mirror1, mirror2, official_github], sha256=official_sha256, strip_root=True)
rec_auto_fix:           false
verification_cmd:       conan create archives/m/mysqltuner/2.9.1 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
evidence_chain: >
  OHOS shadow CI first timed out on github.com. After mirror list was added,
  Conan downloaded from ghfast.top, verified the same SHA256, and completed
  mysqltuner/2.9.1 build/test successfully.
limitations: >
  Mirrors are transport fallbacks only. If a mirror returns a different
  archive, the SHA256 must fail the build.
doc_file:               archives/m/mysqltuner/2.9.1/knowledge_drafts/DRAFT-mysqltuner-source-url-fallback.md
last_updated:           2026-09-11
source_event:           mysqltuner 2.9.1 source download during OHOS shadow CI
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9
draft:                  true
