#====================================================================
# DRAFT-mysqltuner-ohos-perl-runenv-prove - OHOS Conan Perl package must run prove through perl -S under conanrun
#====================================================================

id:                     DRAFT-mysqltuner-ohos-perl-runenv-prove
trigger_tool:           conan|perl|prove
phase:                  conan_build|upstream_tests
error_signature:        /system/bin/sh: .*bin/prove: No such file or directory|Can't locate strict\.pm in \@INC|#!//bin/perl
severity:               2
category:               conan|perl|ohos|test
match_keywords:         mysqltuner, perl/5.42.2, prove, TAP, PERL5LIB, conanrun, @INC, strict.pm, shebang, relocated perl
title:                  Run Perl helper scripts as "perl -S <tool>" under Conan runenv on OHOS
topic: >
  mysqltuner/2.9.1 passed "perl -c mysqltuner.pl" but failed when build()
  called "prove" directly. The packaged prove script existed, yet its shebang
  was "#!//bin/perl" and the relocated perl package needed PERL5LIB from
  conanrun to find core modules.
root_cause: >
  The OHOS perl/5.42.2 package is relocatable through generated environment
  variables. Direct helper-script execution can hit invalid shebangs, and
  explicit perl execution without conanrun loses PERL5LIB.
durable_solution: >
  Use VirtualRunEnv and run "perl -S prove ..." with env="conanrun". This lets
  PATH locate prove and PERL5LIB locate standard/core Perl modules.
rec_priority:           1
rec_approach:           perl-helper-explicit-interpreter
rec_command:            self.run(f"perl -S prove {tests}", cwd=self.source_folder, env="conanrun")
rec_auto_fix:           false
verification_cmd:       CI_PACKAGES="archives/m/mysqltuner/2.9.1" zsh ci/conan/build_and_test.sh
evidence_chain: >
  mysqltuner/2.9.1 OHOS shadow CI: direct prove failed with No such file or
  directory; after changing to perl -S prove under conanrun, 6 TAP files and
  65 tests passed.
limitations: >
  Applies to Perl package helper scripts. If a helper is a native executable
  rather than a Perl script, use direct execution with the generated env.
doc_file:               archives/m/mysqltuner/2.9.1/knowledge_drafts/DRAFT-mysqltuner-ohos-perl-runenv-prove.md
last_updated:           2026-09-11
source_event:           mysqltuner 2.9.1 HarmonyOS adaptation shadow CI
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9
draft:                  true
