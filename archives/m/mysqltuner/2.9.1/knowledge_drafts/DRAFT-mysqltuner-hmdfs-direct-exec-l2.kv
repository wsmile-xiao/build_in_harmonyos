#====================================================================
# DRAFT-mysqltuner-hmdfs-direct-exec-l2 - hmdfs package cache can make direct CLI smoke non-blocking while runenv Perl succeeds
#====================================================================

id:                     DRAFT-mysqltuner-hmdfs-direct-exec-l2
trigger_tool:           ci/conan/build_and_test.sh|mysqltuner|perl
phase:                  l2_smoke|test_package
error_signature:        L2: .*--version/--help failed|Permission denied.*bin/mysqltuner|Can't locate strict\.pm in \@INC
severity:               1
category:               ohos|hmdfs|script-cli|smoke-test
match_keywords:         mysqltuner, hmdfs, L2, direct exec, Permission denied, VirtualRunEnv, PERL5LIB, test_package, negative test
title:                  For script CLIs on hmdfs, make consumer tests interpreter-explicit under Conan runenv
topic: >
  mysqltuner/2.9.1 shadow CI passed overall but direct L2 --help smoke was
  skipped non-blockingly. The package file was mode 0750, yet direct execution
  from hmdfs returned Permission denied. Explicit Perl execution under Conan
  runenv succeeded.
root_cause: >
  Direct smoke tests combine storage execute permissions, shebang behavior,
  and relocated interpreter environment. For Perl packages, usability is better
  validated by interpreter-explicit execution under VirtualRunEnv.
durable_solution: >
  Keep package_info runenv paths, use test_package to invoke the script through
  the packaged Perl interpreter with env="conanrun", and rely on L1e negative
  test to prove the consumer test is not a stub.
rec_priority:           2
rec_approach:           interpreter-explicit-consumer-smoke
rec_command:            self.run(f'"{python}" "{test_script}" "{package_folder}" "{perl}"', env="conanrun")
rec_auto_fix:           false
verification_cmd:       . build/conan/conanrun.sh && "$PERL" "<pkg>/bin/mysqltuner" --help
evidence_chain: >
  Shadow CI: test_package passed, destructive negative test passed, L2 direct
  exec warned non-blockingly. Manual runenv Perl --help returned exit 0.
limitations: >
  This does not remove the L2 warning from the shared CI script. It records why
  the package-level validation is stronger for this script package.
doc_file:               archives/m/mysqltuner/2.9.1/knowledge_drafts/DRAFT-mysqltuner-hmdfs-direct-exec-l2.md
last_updated:           2026-09-11
source_event:           mysqltuner 2.9.1 OHOS shadow CI L2 and test_package
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.8
draft:                  true
