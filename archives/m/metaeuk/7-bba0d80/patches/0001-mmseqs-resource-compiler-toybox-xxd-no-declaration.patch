--- a/lib/mmseqs/cmake/MMseqsResourceCompiler.cmake
+++ b/lib/mmseqs/cmake/MMseqsResourceCompiler.cmake
@@ -1,6 +1,13 @@
 set(compile_resource__internal_dir ${CMAKE_CURRENT_LIST_DIR} CACHE INTERNAL "")
 
-find_program(XXD_EXECUTABLE xxd)
+# OHOS 设备 /usr/bin/xxd 是 toybox 0.8.12 实现：`xxd -i` 只输出裸 hex 数组体，
+# 没有 vim xxd -i 的 `unsigned char 名[] = {...}` 声明行与 `名_len` 长度变量。
+# 本模块后续 sed 只把 `unsigned char` 替换为 `static const unsigned char`，
+# 补不回声明，生成资源头（lib/mmseqs/generated/*.h）编译时连锁报
+# expected unqualified-id / use of undeclared identifier（*_lib 与 *_lib_len）。
+# 因此跳过 xxd 探测、强制走下方 xxdi.pl 分支（vim xxd -i 的 perl 等价实现，
+# shebang 为 #!/usr/bin/env perl，构建 env PATH 含 perl，输出含完整声明与 _len）。
+set(XXD_EXECUTABLE "")
 if(NOT XXD_EXECUTABLE)
     find_program(PERL_EXECUTABLE perl)
     if(NOT PERL_EXECUTABLE)
