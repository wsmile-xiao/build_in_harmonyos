+  #if __has_include(<sys/sysctl.h>)
   #ifdef OS_TYPE_LINUX
 	#warning GLIBC either not defined or version < 2.30 ... including <sys/sysctl.h> header.
   #endif
 	#include <sys/sysctl.h>
+  #endif
 #endif
 
