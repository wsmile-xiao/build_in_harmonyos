--- a/scripts/mkc_install.in
+++ b/scripts/mkc_install.in
@@ -39,6 +39,16 @@
 chmodprog="${CHMODPROG-chmod}"
 chownprog="${CHOWNPROG-chown}"
 chgrpprog="${CHGRPPROG-chgrp}"
+
+# chown(1)/chgrp(1) are not available on every platform (HarmonyOS/OHOS only
+# exposes them as shell aliases that cannot be executed).  Fall back to ":"
+# unless the program resolves to an executable file, so that "set -e" does
+# not abort the installation when ownership cannot be changed.
+_mkc_chown=`command -v "$chownprog" 2>/dev/null` || _mkc_chown=
+test -x "$_mkc_chown" || chownprog=":"
+_mkc_chgrp=`command -v "$chgrpprog" 2>/dev/null` || _mkc_chgrp=
+test -x "$_mkc_chgrp" || chgrpprog=":"
+unset _mkc_chown _mkc_chgrp
 stripprog="${STRIPPROG-$STRIP}"
 rmprog="${RMPROG-rm}"
 mkdirprog="${MKDIRPROG-mkdir}"
--- a/mk/mkc_imp.links.mk
+++ b/mk/mkc_imp.links.mk
@@ -12,7 +12,9 @@
 . for l r in ${LINKS}
 linksinstall: ${DESTDIR}${r}
 ${DESTDIR}${r}: ${DESTDIR}${l}
-	${RM} -f ${DESTDIR}${r}; ${LN} ${DESTDIR}${l} ${DESTDIR}${r}
+	${RM} -f ${DESTDIR}${r}; \
+	${LN} ${DESTDIR}${l} ${DESTDIR}${r} || \
+	${LN_S} ${l:T} ${DESTDIR}${r}
 . endfor
 
 . for l r in ${SYMLINKS}
