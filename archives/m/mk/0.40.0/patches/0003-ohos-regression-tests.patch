--- /dev/null
+++ b/tests/os_OHOS/Makefile
@@ -0,0 +1,29 @@
+# OHOS (OpenHarmony / HarmonyOS PC) specific regression test.
+#
+# It is executed only when mk-configure detects OHOS (uname -s reports
+# "HarmonyOS", which mk/mkc.init.mk normalizes to OHOS); on any other
+# system the test is reported as skipped.
+
+MKC_CHECK_HEADERS      +=	sys/types.h,sys/stat.h
+
+MKC_CHECK_SIZEOF       +=	int:sys/types.h
+
+# OHOS specific: the OHOS native clang toolchain predefines the
+# __OHOS_FAMILY__ macro for the aarch64-unknown-linux-ohos target triple.
+MKC_CHECK_DEFINES      +=	__OHOS_FAMILY__
+
+.include <mkc.configure.mk>
+
+.if ${OPSYS:U} == "OHOS"
+VARIABLES_TO_CHECK=	OPSYS HAVE_HEADER.sys_stat_h SIZEOF.int.sys_types_h \
+			HAVE_DEFINE.__OHOS_FAMILY__
+.include "test.mk"
+.else
+.PHONY: test
+test:
+	@echo '      skipped'; \
+	: =========== cleandir ============; \
+	${MAKE} cleandir > /dev/null
+.endif
+
+.include <mkc.mk>
--- /dev/null
+++ b/tests/os_OHOS/test.mk
@@ -0,0 +1 @@
+.include "../os_NetBSD/test.mk"
--- /dev/null
+++ b/tests/os_OHOS/expect.out
@@ -0,0 +1,5 @@
+OPSYS=OHOS
+HAVE_HEADER.sys_stat_h=1
+SIZEOF.int.sys_types_h=n
+HAVE_DEFINE.__OHOS_FAMILY__=1
+CPPFLAGS=-DHAVE_HEADER_SYS_STAT_H=1 -DSIZEOF_INT_SYS_TYPES_H=n -DHAVE_DEFINE___OHOS_FAMILY__=1
