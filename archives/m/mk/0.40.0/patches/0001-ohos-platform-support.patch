--- a/mk/mkc.init.mk
+++ b/mk/mkc.init.mk
@@ -11,6 +11,9 @@
 .ifndef OPSYS
 OPSYS !=	uname -s
 OPSYS :=	${OPSYS:C/^CYGWIN.*$/Cygwin/}
+# OpenHarmony/HarmonyOS PC reports "HarmonyOS" from uname -s.
+# Normalize it to the short name OHOS used elsewhere on the platform.
+OPSYS :=	${OPSYS:C/^HarmonyOS$/OHOS/}
 .endif
 TARGET_OPSYS ?=	${OPSYS}
 
@@ -68,8 +71,12 @@
 .endif
 
 .if ${ID} != "@ID@"  #empty(MK_C_PROJECT)
-_MKC_USER   !=	${ID:Uid} -un
-_MKC_GROUP  !=	${ID:Uid} -gn
+# Some platforms (e.g. HarmonyOS/OHOS) ship a userland whose user database
+# does not describe the uid running the build, so id(1) fails.  Keep the
+# invocations quiet: a failing id(1) must neither abort the build nor
+# pollute the make output captured by the regression tests.
+_MKC_USER   !=	${ID:Uid} -un 2>/dev/null || true
+_MKC_GROUP  !=	${ID:Uid} -gn 2>/dev/null || true
 .else
 _MKC_USER   =	fake
 _MKC_GROUP  =	fake
--- /dev/null
+++ b/mk/mkc_imp.platform.OHOS.mk
@@ -0,0 +1,18 @@
+# Copyright (c) 2026 by the mk-configure contributors
+#
+# See LICENSE file in the distribution.
+############################################################
+
+# OHOS (OpenHarmony / HarmonyOS PC) platform settings.
+#
+# OpenHarmony is Linux-kernel based and uses ELF objects, ".so" shared
+# libraries and an LLVM/Clang toolchain whose default target triple is
+# aarch64-unknown-linux-ohos.  `uname -s` prints "HarmonyOS"; mk/mkc.init.mk
+# normalizes that to OHOS.
+#
+# Unlike GNU/Linux distributions there is no bare `cc`/`c++`/`cpp` in PATH,
+# so provide the platform defaults expected by mk/mkc_imp.platform.mk.
+
+CC.OHOS  ?=	clang
+CXX.OHOS ?=	clang++
+CPP.OHOS ?=	clang -E
