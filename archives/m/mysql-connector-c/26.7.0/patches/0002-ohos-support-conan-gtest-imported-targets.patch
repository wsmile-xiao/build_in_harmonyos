--- a/cdk/cmake/gtest.cmake
+++ b/cdk/cmake/gtest.cmake
@@ -53,8 +53,36 @@
             " was built from sources using cmake.")
   endif()

-  list(GET GTEST_LIBRARIES 0 gtest_location)
-  list(GET GTEST_MAIN_LIBRARIES 0  gtest_main_location)
+  # Skip the list(GET ...) when GTEST_LIBRARIES contains a CMake target
+  # name (e.g. "GTest::gtest") instead of a file path.  This happens when
+  # find_package(GTest) uses FindGTest.cmake with a CONFIG-based GTest package
+  # (Conan 2.x).  In that case FindGTest sets GTEST_LIBRARIES=GTest::gtest
+  # but we should derive the actual .a path from GTestConfig.cmake's install
+  # prefix instead (see the block below this one).
+  list(GET GTEST_LIBRARIES 0 _first_gtest_lib)
+  if(_first_gtest_lib AND NOT _first_gtest_lib MATCHES "^GTest::")
+    list(GET GTEST_LIBRARIES 0 gtest_location)
+    list(GET GTEST_MAIN_LIBRARIES 0  gtest_main_location)
+  else()
+    # OHOS/Conan 2.x: derive gtest_location / gtest_main_location from
+    # GTestConfig.cmake (which is at <prefix>/lib/cmake/GTest/).
+    # The .a files are at <prefix>/lib/.
+    find_file(_gtest_config_file GTestConfig.cmake
+      HINTS ${CMAKE_PREFIX_PATH} ${GTest_DIR} ${GTest_CONFIG}
+      PATH_SUFFIXES "lib/cmake/GTest"
+      NO_DEFAULT_PATH
+    )
+    if(_gtest_config_file)
+      get_filename_component(_gtest_prefix "${_gtest_config_file}" DIRECTORY)
+      get_filename_component(_gtest_prefix "${_gtest_prefix}" DIRECTORY)
+      get_filename_component(_gtest_prefix "${_gtest_prefix}" DIRECTORY)
+      get_filename_component(_gtest_prefix "${_gtest_prefix}" DIRECTORY)
+      if(EXISTS "${_gtest_prefix}/lib/libgtest.a")
+        set(gtest_location "${_gtest_prefix}/lib/libgtest.a")
+        set(gtest_main_location "${_gtest_prefix}/lib/libgtest_main.a")
+      endif()
+    endif()
+  endif()

 else(NOT WITH_GTEST)

@@ -132,6 +160,30 @@
 add_library(gtest STATIC IMPORTED)
 add_library(gtest_main STATIC IMPORTED)

+# Mirror INTERFACE_INCLUDE_DIRECTORIES from modern Conan GTest imported
+# targets (GTest::gtest, GTest::gtest_main) onto the legacy
+# gtest / gtest_main IMPORTED targets.  We do NOT override
+# IMPORTED_LOCATION because hunk 1 above already sets it to the
+# actual .a file path.  Conan's GTestTargets-release.cmake only
+# sets IMPORTED_LOCATION_<CONFIG>, and get_target_property on that
+# returns the target name (not the path) on CMake >= 4.0.
+if(TARGET GTest::gtest)
+  get_target_property(_gtest_inc GTest::gtest INTERFACE_INCLUDE_DIRECTORIES)
+  if(_gtest_inc)
+    set_target_properties(gtest PROPERTIES
+      INTERFACE_INCLUDE_DIRECTORIES "${_gtest_inc}"
+    )
+  endif()
+endif()
+if(TARGET GTest::gtest_main)
+  get_target_property(_gtest_main_inc GTest::gtest_main INTERFACE_INCLUDE_DIRECTORIES)
+  if(_gtest_main_inc)
+    set_target_properties(gtest_main PROPERTIES
+      INTERFACE_INCLUDE_DIRECTORIES "${_gtest_main_inc}"
+    )
+  endif()
+endif()
+
 target_include_directories(gtest INTERFACE ${GTEST_INCLUDE_DIRS})

