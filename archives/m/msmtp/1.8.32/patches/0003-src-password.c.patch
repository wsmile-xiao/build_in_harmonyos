 #include <stdio.h>
 #include <stdlib.h>
 #include <unistd.h>
 #include <errno.h>
+#include <string.h>
+
+/* HarmonyOS/musl does not provide getpass() - provide a simple replacement */
+#ifdef __OHOS__
+static char *getpass(const char *prompt)
+{
+    static char buf[256];
+    FILE *tty;
+    
+    fprintf(stderr, "%s", prompt);
+    fflush(stderr);
+    
+    /* Try to open /dev/tty for direct terminal access */
+    tty = fopen("/dev/tty", "r+");
+    if (tty) {
+        if (fgets(buf, sizeof(buf), tty)) {
+            fclose(tty);
+            /* Remove trailing newline */
+            size_t len = strlen(buf);
+            if (len > 0 && buf[len - 1] == '\n')
+                buf[len - 1] = '\0';
+            return buf;
+        }
+        fclose(tty);
+    }
+    
+    /* Fallback: read from stdin */
+    if (fgets(buf, sizeof(buf), stdin)) {
+        size_t len = strlen(buf);
+        if (len > 0 && buf[len - 1] == '\n')
+            buf[len - 1] = '\0';
+        return buf;
+    }
+    
+    return NULL;
+}
+#endif /* __OHOS__ */
