--- a/test/msgpuck.c	2017-02-07 20:14:17
+++ b/test/msgpuck.c	2026-09-18 11:32:53
@@ -823,7 +823,17 @@
 	ok(fsize == esize && result[esize] == '\0',
 	   "mp_snprint limit = expected + 1");
 
-	FILE *tmpf = tmpfile();
+	/* This platform's /tmp is read-only, so tmpfile() returns NULL and
+	 * the two mp_fprint checks below would silently be skipped.  Create
+	 * the scratch file under TMPDIR instead (set by the build recipe);
+	 * behaviour is otherwise unchanged. */
+	const char *tmpdir = getenv("TMPDIR");
+	char tmppath[512];
+	FILE *tmpf = NULL;
+	if (tmpdir != NULL) {
+		snprintf(tmppath, sizeof(tmppath), "%s/msgpuck_tmpfile", tmpdir);
+		tmpf = fopen(tmppath, "w+");
+	}
 	if (tmpf != NULL) {
 		int fsize = mp_fprint(tmpf, msgpack);
 		ok(fsize == esize, "mp_fprint return value");
@@ -832,6 +842,7 @@
 		ok(rsize == esize && memcmp(result, expected, esize) == 0,
 		   "mp_fprint result");
 		fclose(tmpf);
+		remove(tmppath);
 	}
 
 	/* stdin is read-only */
