--- a/libs/mysql/strconv/decode/decode.h
+++ b/libs/mysql/strconv/decode/decode.h
@@ -147,9 +147,12 @@
 /// unchanged.
 ///
 /// @return Parser that can be queried for success and error messages.
-[[nodiscard]] Parser decode(
-    const Is_parse_options_nocheck auto &opt, const std::string_view &in_sv,
-    mysql::meta::Is_specialization<std::basic_string> auto &out) {
+// OHOS clang 15: C++23 curried-concept placeholders are not supported
+// (clang crashes); use an explicit template + requires clause instead.
+template <class String_t>
+  requires mysql::meta::Is_specialization<String_t, std::basic_string>
+[[nodiscard]] Parser decode(const Is_parse_options_nocheck auto &opt,
+                            const std::string_view &in_sv, String_t &out) {
   return decode(opt, in_sv, out_str_growable(out));
 }
 
