+# OHOS client-only (WITHOUT_SERVER): gunit_large is the entry point for the
+# suites that link the whole server. ext::icu is only configured when the
+# server (or its components) are built, so skip the library here. This mirrors
+# the upstream VS2019 + WITHOUT_SERVER combination, which also leaves the
+# server-dependent unit tests out of the build.
+IF(NOT WITHOUT_SERVER)
+  ADD_STATIC_LIBRARY(gunit_large
+    benchmark.cc
+    gunit_test_main_server.cc
+    test_utils.cc
+    thread_utils.cc
+    LINK_LIBRARIES ext::icu ext::zlib extra::unordered_dense
+  )
+ENDIF()
 
