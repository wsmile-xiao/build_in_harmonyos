 ADD_LIBRARY(sqlgunitlib STATIC ${SQL_GUNIT_LIB_SOURCE})
 ADD_DEPENDENCIES(sqlgunitlib GenError)
+# OHOS client-only: this library compiles a few sql/ sources (mdl.cc, ...)
+# which declare their PSI keys under HAVE_PSI_INTERFACE. That macro is driven
+# by WITH_PERFSCHEMA_STORAGE_ENGINE, which is off in a client-only build, so
+# enable it here. The DISABLE_PSI_* definitions keep every instrumentation
+# call a no-op, so no PSI implementation needs to be linked.
 SET_TARGET_PROPERTIES(sqlgunitlib
-  PROPERTIES COMPILE_DEFINITIONS "${DISABLE_PSI_DEFINITIONS}"
+  PROPERTIES COMPILE_DEFINITIONS "${DISABLE_PSI_DEFINITIONS};HAVE_PSI_INTERFACE"
 )
 
