--- a/extra/libedit/libedit-20240808-3.1/src/CMakeLists.txt
+++ b/extra/libedit/libedit-20240808-3.1/src/CMakeLists.txt
@@ -142,6 +142,16 @@ IF(FREEBSD AND HAVE_GETLINE)
 ENDIF()

 ADD_LIBRARY(edit STATIC ${LIBEDIT_SOURCES})
+# tgetent & friends come from the curses library, but some libcs (OHOS /
+# musl-style) do not declare them in <term.h>; declare them manually in that
+# case. Capability probe instead of a platform macro (repo rule R8).
+INCLUDE(CheckLibraryExists)
+INCLUDE(CheckSymbolExists)
+CHECK_LIBRARY_EXISTS("${CURSES_LIBRARY}" tgetent "" HAVE_LIB_TGETENT)
+CHECK_SYMBOL_EXISTS(tgetent "term.h" HAVE_TGETENT_DECL)
+IF(HAVE_LIB_TGETENT AND NOT HAVE_TGETENT_DECL)
+  TARGET_COMPILE_DEFINITIONS(edit PRIVATE HAVE_TERMCAP)
+ENDIF()
 TARGET_LINK_LIBRARIES(edit ${CURSES_LIBRARY})
 ADD_DEPENDENCIES(edit libedit_vi libedit_emacs libedit_common libedit_fcns libedit_help libedit_func)

