 #
@@ -424,9 +437,18 @@
 # from @CLIENT_API_FUNCTIONS@ are declared by <mysql.h>. It will fail
 # to run if not all of these symbols are exported by the library.
 #
+# On OHOS only the static client library is produced (the shared libmysql
+# target is not created), so keep the upstream test but link it against
+# whichever client library target exists: the compile-time header check and
+# the link/run-time symbol check are preserved on every platform.
+IF(TARGET libmysql)
+  SET(MYSQL_API_TEST_CLIENT_TARGET libmysql)
+ELSE()
+  SET(MYSQL_API_TEST_CLIENT_TARGET mysqlclient)
+ENDIF()
 MYSQL_ADD_EXECUTABLE(libmysql_api_test
   ${CMAKE_CURRENT_BINARY_DIR}/api_test.c
-  LINK_LIBRARIES libmysql ${LIBRT}
+  LINK_LIBRARIES ${MYSQL_API_TEST_CLIENT_TARGET} ${LIBRT}
   SKIP_INSTALL
   )
 # Clang/UBSAN needs this on some platforms.
@@ -451,8 +473,9 @@
 ADD_CUSTOM_COMMAND(
   OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/libmysql_api_test.out
   DEPENDS libmysql_api_test
-  COMMAND libmysql_api_test
+  COMMAND $<TARGET_FILE:libmysql_api_test>
   > ${CMAKE_CURRENT_BINARY_DIR}/libmysql_api_test.out
+  COMMAND ${CMAKE_COMMAND} -E cat ${CMAKE_CURRENT_BINARY_DIR}/libmysql_api_test.out
   )
 MY_ADD_CUSTOM_TARGET(run_libmysql_api_test ALL
   DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/libmysql_api_test.out
