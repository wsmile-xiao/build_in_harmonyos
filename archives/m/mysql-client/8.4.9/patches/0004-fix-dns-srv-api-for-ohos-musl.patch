--- mysql-client-8.4.9.orig/libmysql/CMakeLists.txt	2026-04-07 23:34:16.000000000 +0800
+++ mysql-client-8.4.9.work/libmysql/CMakeLists.txt	2026-06-09 11:16:13.306119688 +0800
@@ -279,11 +279,29 @@
     SET(HAVE_UNIX_DNS_SRV 1 PARENT_SCOPE)
     SET(HAVE_DNS_SRV 1)
     MESSAGE(STATUS "Found Unix DNS SRV APIs")
+  ELSE()
+    # On HarmonyOS NEXT (musl libc), DNS SRV APIs are built into libc.
+    # Check if res_query is available directly in libc.
+    INCLUDE(CheckLibraryExists)
+    CHECK_LIBRARY_EXISTS(c res_query "" HAVE_RES_QUERY_IN_LIBC)
+    IF(HAVE_RES_QUERY_IN_LIBC)
+      SET(HAVE_UNIX_DNS_SRV 1 PARENT_SCOPE)
+      SET(HAVE_DNS_SRV 1)
+      MESSAGE(STATUS "Found Unix DNS SRV APIs in libc (OHOS/musl)")
+    ENDIF()
   ENDIF()
 ENDIF()
 
 IF(HAVE_DNS_SRV EQUAL 0)
-  MESSAGE(FATAL_ERROR "Can't find neither Win32 nor Unix DNS SRV APIs")
+  # On OHOS/musl, DNS SRV functions are in libc. Allow building without
+  # libresolv by assuming libc provides them.
+  IF(OHOS)
+    SET(HAVE_UNIX_DNS_SRV 1 PARENT_SCOPE)
+    SET(HAVE_DNS_SRV 1)
+    MESSAGE(STATUS "Assuming Unix DNS SRV APIs in libc (OHOS/musl)")
+  ELSE()
+    MESSAGE(FATAL_ERROR "Can't find neither Win32 nor Unix DNS SRV APIs")
+  ENDIF()
 ENDIF()
