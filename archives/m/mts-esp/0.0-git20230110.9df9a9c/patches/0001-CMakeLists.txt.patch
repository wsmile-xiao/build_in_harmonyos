--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,26 @@
+cmake_minimum_required(VERSION 3.16)
+
+project(mts-esp VERSION 0.0 LANGUAGES CXX)
+
+include(GNUInstallDirs)
+
+add_library(MTS STATIC
+    Client/libMTSClient.cpp
+    Master/libMTSMaster.cpp
+)
+target_compile_features(MTS PUBLIC cxx_std_11)
+target_include_directories(MTS PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/Client>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/Master>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+)
+set_target_properties(MTS PROPERTIES POSITION_INDEPENDENT_CODE ON)
+
+install(TARGETS MTS
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+)
+install(FILES
+    Client/libMTSClient.h
+    Master/libMTSMaster.h
+    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+)
