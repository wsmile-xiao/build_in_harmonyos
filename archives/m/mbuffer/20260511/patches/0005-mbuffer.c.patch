+/* POSIX thread cancellation is not implemented by every C library -- the musl
+   variant on HarmonyOS neither declares nor exports pthread_cancel().  Declare
+   it weakly so the link succeeds there, and skip cancellation when the
+   reference does not resolve.  cancelAll() is only ever reached from
+   joinSenders() after Terminate has been set, so the worker threads still
+   exit cooperatively and every pthread_join() that follows completes. */
+#pragma weak pthread_cancel
+extern int pthread_cancel (pthread_t);
+
 static void cancelAll(void)
 {
 	dest_t *d = Dest;
 	do {
-		(void) pthread_cancel(d->thread);
+		if (pthread_cancel)
+			(void) pthread_cancel(d->thread);
 		if (d->result == 0)
 			d->result = "canceled";
 		d = d->next;
 	} while (d);
 }
 
 
