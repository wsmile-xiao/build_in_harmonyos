--- meson-1.11.0.orig/configure	1970-01-01 08:00:00.000000000 +0800
+++ meson-1.11.0.work/configure	2026-04-17 13:39:55.598248907 +0800
@@ -0,0 +1,15 @@
+#!/bin/sh
+# configure wrapper for meson (pure Python project)
+# This script is a no-op placeholder to satisfy build systems that expect ./configure
+# Actual build is done via: python3 setup.py install --prefix=PREFIX
+
+# Handle --prefix argument (ignore, Python handles it at install time)
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*) PREFIX="${arg#--prefix=}" ;;
+    esac
+done
+
+echo "Meson is a pure Python project. No configure step needed."
+echo "Build command: python3 setup.py install --prefix=${PREFIX:-/usr/local}"
+exit 0
