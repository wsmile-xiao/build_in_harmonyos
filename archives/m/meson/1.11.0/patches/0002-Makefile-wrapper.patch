--- meson-1.11.0.orig/Makefile	1970-01-01 08:00:00.000000000 +0800
+++ meson-1.11.0.work/Makefile	2026-04-17 13:55:43.464235312 +0800
@@ -0,0 +1,17 @@
+# Makefile wrapper for meson (pure Python project)
+PREFIX ?= /usr/local
+DESTDIR ?= 
+
+all: build
+
+build:
+	@python3 setup.py build > /storage/Users/currentUser/tmp/meson-make-debug.log 2>&1; \
+	echo "EXIT_CODE=$$?" >> /storage/Users/currentUser/tmp/meson-make-debug.log
+
+install:
+	python3 setup.py install --prefix=$(PREFIX) --root=$(DESTDIR)
+
+check:
+	@echo "Skip check for pure Python project"
+
+.PHONY: all build install check
