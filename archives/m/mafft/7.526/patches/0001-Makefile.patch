diff -ruN /dev/null b/Makefile
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,28 @@
+# Top-level Makefile wrapper for mafft (OpenHarmony build)
+# Delegates to core/ and extensions/ subdirectories
+
+.PHONY: all core extensions install clean check
+
+all: core extensions
+
+core:
+	cd core && $(MAKE)
+
+extensions:
+	cd extensions && $(MAKE)
+
+install: core-install extensions-install
+
+core-install:
+	cd core && $(MAKE) install
+
+extensions-install:
+	cd extensions && $(MAKE) install
+
+clean:
+	cd core && $(MAKE) clean
+	cd extensions && $(MAKE) clean
+
+check:
+	@echo "No automated test suite available for mafft."
+	@echo "Manual testing: mafft --version should report v7.526"
