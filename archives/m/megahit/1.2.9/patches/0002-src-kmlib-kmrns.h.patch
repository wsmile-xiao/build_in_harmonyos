+#else
+// portable software pdep for non-x86 (BMI2 unavailable)
+inline ULL PdepSoft(ULL x, ULL mask) {
+  ULL res = 0;
+  for (unsigned i = 0, j = 0; i < sizeof(ULL) * 8; ++i) {
+    if ((mask >> i) & 1ULL) {
+      res |= ((x >> j) & 1ULL) << i;
+      ++j;
+    }
+  }
+  return res;
+}
+template <typename Tx, typename Ty>
+inline Tx Pdep(Tx x, Ty y) {
+  CHECK_TYPE(Tx);
+  return sizeof(Tx) <= sizeof(ULL) ? static_cast<Tx>(PdepSoft(x, y)) : 0;
+}
