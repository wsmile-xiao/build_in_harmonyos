diff --git a/src/mcron/job-specifier.scm b/src/mcron/job-specifier.scm
--- a/src/mcron/job-specifier.scm
+++ b/src/mcron/job-specifier.scm
@@ -190,7 +190,14 @@
 ;; the job actually runs.

-(define configuration-user (box (getpw (getuid))))
+(define configuration-user
+  (box (or (false-if-exception (getpw (getuid)))
+           ;; OHOS fallback: create a fake passwd entry when user not in /etc/passwd
+           ;; passwd struct: #(name passwd uid gid gecos dir shell)
+           (vector (format #f "user~a" (getuid))  ; name
+                   "x"                            ; passwd
+                   (getuid)                       ; uid
+                   (getuid)                       ; gid
+                   ""                             ; gecos
+                   (or (getenv "HOME") "/tmp")    ; dir
+                   "/bin/sh"))))                  ; shell

 (define configuration-time