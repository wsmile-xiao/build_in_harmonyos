+bool Semaphore::decrement(size_t index, bool wait, size_t timeoutMs)
+{
+    if (index >= m_semaphores.size() || !m_semaphores[index]) {
+        errno = 0;
+        return false;
+    }
+
+    int rv = -1;
+    if (!wait) {
+        rv = ::sem_trywait(m_semaphores[index]);
+    } else if (timeoutMs > 0) {
+        struct timespec deadline;
+        ::clock_gettime(CLOCK_REALTIME, &deadline);
+        deadline.tv_sec += static_cast<time_t>(timeoutMs / 1000);
+        deadline.tv_nsec += static_cast<long>(timeoutMs % 1000) * 1000000L;
+        if (deadline.tv_nsec >= 1000000000L) {
+            deadline.tv_sec += 1;
+            deadline.tv_nsec -= 1000000000L;
+        }
+        rv = ::sem_timedwait(m_semaphores[index], &deadline);
+    } else {
+        do {
+            rv = ::sem_wait(m_semaphores[index]);
+        } while (rv != 0 && errno == EINTR);
+    }
+
+    if (rv != 0) {
+        if (errno != EAGAIN || wait) {
+            error("Unable to decrement semaphore", errno);
+        }
+        return false;
+    }
+
+    return true;
+}
