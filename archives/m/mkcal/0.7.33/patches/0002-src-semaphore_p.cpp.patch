+void Semaphore::initialize(size_t count, const int *initialValues)
+{
+    m_semaphores.assign(count, nullptr);
+
+    for (size_t i = 0; i < count; ++i) {
+        const QByteArray name = semaphoreName(m_identifier, i);
+        sem_t *semaphore = ::sem_open(name.constData(), O_CREAT, 0666,
+                                      static_cast<unsigned>(initialValues[i]));
+        if (semaphore == SEM_FAILED) {
+            semaphoreError("Unable to create semaphore", m_identifier.toUtf8().constData(), errno);
+            // Close the slots opened so far and report the failure.
+            for (size_t j = 0; j < m_semaphores.size(); ++j) {
+                if (m_semaphores[j]) {
+                    ::sem_close(m_semaphores[j]);
+                    m_semaphores[j] = nullptr;
+                }
+            }
+            return;
+        }
+
+        m_semaphores[i] = semaphore;
+    }
+}
