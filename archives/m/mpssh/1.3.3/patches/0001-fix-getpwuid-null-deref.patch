--- a/mpssh.c
+++ b/mpssh.c
@@ -458,7 +458,23 @@

     if (!user) {
         pw = getpwuid(getuid());
-        user = pw->pw_name;
+        /*
+         * getpwuid() returns NULL when the running uid has no passwd
+         * entry (e.g. service accounts on minimal systems); the
+         * unguarded pw->pw_name dereference would crash with SIGSEGV
+         * before any host is processed. Fall back to the login name
+         * from the environment, then to a safe constant.
+         */
+        if (pw == NULL) {
+            const char *env_user = getenv("USER");
+            if (env_user == NULL || strlen(env_user) == 0)
+                env_user = getenv("LOGNAME");
+            if (env_user == NULL || strlen(env_user) == 0)
+                env_user = "nobody";
+            user = strdup(env_user);
+        } else {
+            user = pw->pw_name;
+        }
     }

     hst = host_readlist(fname);
