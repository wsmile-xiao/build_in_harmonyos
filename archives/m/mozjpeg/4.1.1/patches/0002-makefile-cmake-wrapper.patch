--- a/Makefile	2026-05-26 14:59:33.439416562 +0800
+++ Makefile	2026-05-27 10:47:08.969767656 +0800
@@ -0,0 +1,23 @@
+# Makefile wrapper for cmake-based mozjpeg
+# Delegates make commands to the cmake build directory
+# This allows the G0 clean-verify script (which runs make from source root) to work with cmake projects
+
+BUILD_DIR := build-release
+
+.PHONY: all install clean check
+
+all:
+	$(MAKE) -C $(BUILD_DIR) all
+
+install:
+	if [ -n "$(DESTDIR)" ]; then \
+		$(MAKE) -C $(BUILD_DIR) install DESTDIR=$(DESTDIR); \
+	else \
+		$(MAKE) -C $(BUILD_DIR) install; \
+	fi
+
+clean:
+	$(MAKE) -C $(BUILD_DIR) clean
+
+check:
+	$(MAKE) -C $(BUILD_DIR) check
\ No newline at end of file
