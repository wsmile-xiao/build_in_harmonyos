--- a/configure	2026-05-26 14:59:33.439416562 +0800
+++ configure	2026-05-27 10:44:56.121769219 +0800
@@ -0,0 +1,43 @@
+#!/bin/sh
+# configure wrapper for cmake-based mozjpeg
+# Translates autotools-style configure arguments to cmake arguments
+# This allows the G0 clean-verify script (which calls ./configure) to work with cmake projects
+
+# Parse arguments
+CMAKE_ARGS=""
+PREFIX=""
+BUILD_DIR="build-release"
+
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            CMAKE_ARGS="$CMAKE_ARGS -DCMAKE_INSTALL_PREFIX=$PREFIX"
+            ;;
+        -DCMAKE*)
+            CMAKE_ARGS="$CMAKE_ARGS $arg"
+            ;;
+        *)
+            CMAKE_ARGS="$CMAKE_ARGS $arg"
+            ;;
+    esac
+done
+
+# Add required cmake options for HarmonyOS
+CMAKE_ARGS="$CMAKE_ARGS -DCMAKE_SYSTEM_NAME=Linux"
+CMAKE_ARGS="$CMAKE_ARGS -DCMAKE_SYSTEM_PROCESSOR=aarch64"
+CMAKE_ARGS="$CMAKE_ARGS -DCMAKE_POLICY_VERSION_MINIMUM=3.5"
+
+if [ -z "$PREFIX" ]; then
+    CMAKE_ARGS="$CMAKE_ARGS -DCMAKE_INSTALL_PREFIX=$HOME/usr/local"
+fi
+
+# Create build directory and run cmake
+mkdir -p "$BUILD_DIR"
+cd "$BUILD_DIR"
+cmake $CMAKE_ARGS ..
+
+# Copy generated files back to source root for make to find them
+# This allows 'make' and 'make install' to work from the source root
+echo "Configure (cmake wrapper) completed successfully"
+exit 0
\ No newline at end of file
