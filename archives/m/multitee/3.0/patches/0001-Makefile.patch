--- /dev/null
+++ b/Makefile
@@ -0,0 +1,17 @@
+# Build rules for multitee 3.0.
+#
+# The multitee 3.0 distribution (alt.sources, 1991) ships no Makefile.
+# The compiler and every flag come from the environment (CC, CPPFLAGS,
+# CFLAGS, LDFLAGS, LDLIBS), so the caller's toolchain drives the build.
+
+OBJS = multitee.o sigsched.o sigdfl.o ralloc.o getopt.o fmt.o scan.o
+
+all: multitee
+
+multitee: $(OBJS)
+	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)
+
+clean:
+	rm -f multitee $(OBJS)
+
+.PHONY: all clean
