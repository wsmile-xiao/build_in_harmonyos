--- a/configure.ac	2017-03-01 19:09:48.000000000 +0800
+++ b/configure.ac	2026-09-17 16:05:33.320044688 +0800
@@ -1734,17 +1734,17 @@
 # If the user provided its Yasm, check it seems functional
 MPIR_AS=""
 if test -z "$with_yasm"; then
-  echo "Looking for a system-wide yasm..."
-  MPIR_AS=`which yasm`
-  if test $? -ne 0; then
-    AC_MSG_ERROR([no system-wide yasm found])
-  fi
+  dnl yasm is only invoked for x86-family .asm sources; on hosts taking the
+  dnl generic C path (e.g. aarch64) it is never used, so probe without failing.
+  MPIR_AS=`which yasm 2>/dev/null` || MPIR_AS=""
 else
   MPIR_AS="$with_yasm"
 fi
-echo "Checking yasm..."
-if ! test -f "$MPIR_AS" || ! test -x "$MPIR_AS"; then
-  AC_MSG_ERROR([$MPIR_AS does not seem functional])
+if test -n "$MPIR_AS"; then
+  echo "Checking yasm..."
+  if ! test -f "$MPIR_AS" || ! test -x "$MPIR_AS"; then
+    AC_MSG_ERROR([$MPIR_AS does not seem functional])
+  fi
 fi
 AC_SUBST(MPIR_AS)
 
