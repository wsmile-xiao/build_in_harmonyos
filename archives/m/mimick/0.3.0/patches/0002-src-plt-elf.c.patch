+static void plt_write_slot(plt_fn **slot, plt_fn *value)
+{
+    long page_size = sysconf(_SC_PAGESIZE);
+    mmk_assert(page_size > 0);
+    uintptr_t address = (uintptr_t) slot;
+    void *page = (void *) (address & ~((uintptr_t) page_size - 1));
+
+    /* HarmonyOS enables RELRO for the executable, so its GOT is read-only
+     * by the time main starts. Temporarily change only the containing page,
+     * perform the slot update, then restore the read-only protection. */
+    mmk_assert(mprotect(page, (size_t) page_size,
+            PROT_READ | PROT_WRITE) == 0);
+    *slot = value;
+    mmk_assert(mprotect(page, (size_t) page_size, PROT_READ) == 0);
 }

