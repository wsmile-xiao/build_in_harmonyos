+static int offset_seen(plt_offset *offsets, size_t count, plt_fn **offset)
+{
+    for (size_t i = 0; i < count; ++i) {
+        if (offsets[i].offset == offset)
+            return 1;
+    }
+    return 0;
+}
+
+static size_t append_offsets(struct rel_info *info, ElfW(Sym) *symtab,
+        const char *strtab, const char *name, ElfWord relocation_type,
+        ElfW(Addr) base, plt_offset *offsets, size_t count, size_t capacity)
+{
+    ElfW(Rel) *rel = info->tab;
+    for (ElfWord i = 0; i < info->size / info->entry_sz;
+            ++i, rel = (void*)(((char *) rel) + info->entry_sz))
+    {
+        ElfW(Sym) *sym = &symtab[ELF_R_SYM(rel->r_info)];
+        if (ELF_R_TYPE(rel->r_info) != relocation_type
+                || strcmp(strtab + sym->st_name, name))
+            continue;
+
+        plt_fn **offset = (plt_fn **) (rel->r_offset + base);
+        if (count < capacity && !offset_seen(offsets, count, offset))
+            offsets[count++] = (plt_offset) { .offset = offset };
+    }
+    return count;
+}
