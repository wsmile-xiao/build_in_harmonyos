--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -74,20 +74,26 @@
     set (MMK_ARCH "aarch64")
     set (MMK_ABI "aarch64")
     set (MMK_BITS 64)
     set (MMK_ARCH_ARM64 1)
   else ()
     message (FATAL_ERROR "Architecture '${_ARCH}' is not supported.")
   endif ()
   set (ASM_EXTENSION ".S")
 endif ()

+if (MMK_ARCH_ARM64 AND CMAKE_C_COMPILER_ID MATCHES "Clang")
+  # HarmonyOS clang otherwise emits emulated-TLS calls. They re-enter a
+  # mocked allocator while the trampoline is resolving its thread-local state.
+  set (CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fno-emulated-tls")
+endif ()
+
 option (USE_QEMU "Use QEMU to run the tests" OFF)

 if (CMAKE_SYSTEM_NAME MATCHES "Linux")
   set (MMK_EXE_FORMAT elf)
   set (MMK_EXE_FMT_ELF 1)
   add_definitions(-D_GNU_SOURCE)
 elseif (CMAKE_SYSTEM_NAME MATCHES "Darwin")
   set (MMK_EXE_FORMAT mach-o)
   set (MMK_EXE_FMT_MACH_O 1)
   set (MMK_MANGLING "leading-underscore")
