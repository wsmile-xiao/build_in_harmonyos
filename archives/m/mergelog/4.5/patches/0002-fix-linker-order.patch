Description: List libraries after the object file

  The upstream Makefile.am places $(LIBS) before the .c source on the
  link line. With modern linkers (ld.lld / --as-needed) the order of
  objects and -lz matters: the zlib symbols referenced by mergelog.c
  are only resolved when -lz appears after the object that consumes
  them. Move $(LIBS) to the end so both mergelog and zmergelog link.

Origin: https://sources.debian.org/src/mergelog/4.5.1-10/debian/patches/fix_linker.patch

--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -3,3 +3,3 @@
 mergelog: mergelog.c
-	$(COMPILE) $(LIBS) -DVERSION=\"$(VERSION)\" -Wall mergelog.c -o $@
+	$(COMPILE) -DVERSION=\"$(VERSION)\" -Wall mergelog.c -o $@ $(LIBS)

@@ -6,2 +6,2 @@
 zmergelog: mergelog.c
-	$(COMPILE) $(LIBS) -DVERSION=\"$(VERSION)\" -Wall -DUSE_ZLIB mergelog.c -o $@
+	$(COMPILE) -DVERSION=\"$(VERSION)\" -Wall -DUSE_ZLIB mergelog.c -o $@ $(LIBS)
