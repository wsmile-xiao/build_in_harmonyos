+# OHOS: 上游 TUI 目标 include <ncursesw/curses.h>，而 Conan 的 ncurses 包头文件
+# 直接位于 include/。为构建目录建立 ncursesw -> ncurses 的视图并加入包含路径，
+# 使 TUI 编译在共享 Conan 包不被改写的前提下仍可找到头文件。
+if (CMAKE_SYSTEM_NAME MATCHES "HarmonyOS|OHOS")
+  set(NCURSESW_VIEW "${CMAKE_BINARY_DIR}/include/ncursesw")
+  if (NOT EXISTS "${NCURSESW_VIEW}")
+    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/include")
+    file(MAKE_DIRECTORY "${NCURSESW_VIEW}")
+  endif()
+  foreach(_ncur_inc ${CMAKE_INCLUDE_PATH})
+    if (EXISTS "${_ncur_inc}/curses.h")
+      file(COPY "${_ncur_inc}/" DESTINATION "${NCURSESW_VIEW}" FILES_MATCHING PATTERN "*.h")
+    endif()
+  endforeach()
+  list(APPEND PROJECT_INCLUDE_DIRECTORIES "${CMAKE_BINARY_DIR}/include")
+endif()
+
 include_directories(${PROJECT_INCLUDE_DIRECTORIES})
 
 link_directories("${musikcube_SOURCE_DIR}/bin/plugins")
 
+# OHOS: 上游 TUI 目标 include <ncursesw/curses.h>，而 Conan 的 ncurses 包头文件
