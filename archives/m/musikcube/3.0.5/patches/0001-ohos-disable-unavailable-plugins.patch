+    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/include")
+    file(MAKE_DIRECTORY "${NCURSESW_VIEW}")
+  endif()
+  foreach(_ncur_inc ${CMAKE_INCLUDE_PATH})
+    if (EXISTS "${_ncur_inc}/curses.h")
+      file(COPY "${_ncur_inc}/" DESTINATION "${NCURSESW_VIEW}" FILES_MATCHING PATTERN "*.h")
+    endif()
+  endforeach()
+  list(APPEND PROJECT_INCLUDE_DIRECTORIES "${CMAKE_BINARY_DIR}/include")
+endif()
