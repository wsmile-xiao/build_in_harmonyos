-mapnik_find_package(ICU REQUIRED COMPONENTS uc i18n data)
+# OHOS/conan: the icu4c conan package declares no CMake config properties,
+# so no icu4cConfig.cmake is generated for consumers (CMakeDeps only emits
+# configs for packages with cmake_file_name). Find icu4c for its include
+# dir (plain find_package: NOT registered in mapnik_deps, so the exported
+# mapnikConfig.cmake does not emit a find_dependency(icu4c) consumers
+# cannot satisfy), link by plain library names and re-export the upstream
+# component target names mapnik expects.
+find_package(icu4c CONFIG REQUIRED)
+set(ICU_REQUIRED_LIBS uc i18n data)
+set(ICU_LIBRARIES "")
+foreach(_icu_comp ${ICU_REQUIRED_LIBS})
+    list(APPEND ICU_LIBRARIES "icu${_icu_comp}")
+endforeach()
+# Link ICU by plain library names (resolved via CMAKE_LIBRARY_PATH, which
+# conan propagates for every dependency). Plain names survive the
+# mapnikTargets.cmake export as bare -l flags; consumers get the icu4c
+# libdir through the conan dependency propagation as well, so no
+# find_dependency(icu4c) (whose config consumers cannot generate) is
+# needed in the exported mapnikConfig.cmake.
+if(NOT TARGET ICU::uc)
+    add_library(ICU::uc INTERFACE IMPORTED)
+    target_include_directories(ICU::uc INTERFACE ${icu4c_INCLUDE_DIRS})
+    target_link_libraries(ICU::uc INTERFACE ${ICU_LIBRARIES})
+    add_library(ICU::i18n ALIAS ICU::uc)
+    add_library(ICU::data ALIAS ICU::uc)
+endif()
+# bare -l names need the icu4c libdir on the link search path (both for
+# this build and for consumers; conan propagates the dir through
+# CMAKE_LIBRARY_PATH only at generate time, not to the linker directly)
+link_directories("${icu4c_LIB_DIRS_RELEASE}")
+set(ICU_VERSION_STRING "${icu4c_VERSION}")
 
