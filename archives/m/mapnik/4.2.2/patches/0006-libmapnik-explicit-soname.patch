--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -44,6 +44,11 @@
 endif()
 
 set_target_properties(mapnik PROPERTIES
+    # OHOS: force an explicit SONAME so plugins reference libmapnik.so by
+    # name instead of a cwd-relative path (musl resolves relative DT_NEEDED
+    # entries against the process working directory, which breaks plugin
+    # dlopen unless the cwd matches the build tree layout).
+    LINK_FLAGS "-Wl,-soname,libmapnik.so"
     POSITION_INDEPENDENT_CODE ON
     CXX_VISIBILITY_PRESET hidden
     VISIBILITY_INLINES_HIDDEN ON
