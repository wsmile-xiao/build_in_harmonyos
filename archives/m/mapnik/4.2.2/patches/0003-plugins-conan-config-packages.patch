--- a/plugins/input/sqlite/CMakeLists.txt
+++ b/plugins/input/sqlite/CMakeLists.txt
@@ -1,4 +1,9 @@
-find_package(SQLite3 REQUIRED)
+# OHOS/conan: sqlite3 conan package ships sqlite3-config.cmake with the
+# sqlite3::sqlite3 target, not the FindSQLite3 module target SQLite::SQLite3.
+find_package(sqlite3 CONFIG REQUIRED)
+if(NOT TARGET SQLite::SQLite3)
+    add_library(SQLite::SQLite3 ALIAS sqlite3::sqlite3)
+endif()
 
 add_plugin_target(input-sqlite "sqlite")
 target_sources(input-sqlite ${_plugin_visibility}
