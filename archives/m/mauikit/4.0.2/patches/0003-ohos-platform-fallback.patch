diff --git a/src/platforms/platform.cpp b/src/platforms/platform.cpp
index 468bfd3..103d3a3 100644
--- a/src/platforms/platform.cpp
+++ b/src/platforms/platform.cpp
@@ -8,6 +8,47 @@
 #include "mauiwindows.h"
 #elif defined Q_OS_IOS
 #include "mauiios.h"
+#elif defined(__OHOS__)
+// OHOS adaptation: none of the upstream platform backends is compiled
+// for HarmonyOS (CMake UNIX/ANDROID are false and the desktop backend
+// needs XCB/KF6::WindowSystem), so use a minimal in-file backend
+// instead of mauilinux.h.
+namespace
+{
+class MAUIOHOS final : public AbstractPlatform
+{
+public:
+    explicit MAUIOHOS(QObject *parent = nullptr)
+        : AbstractPlatform(parent)
+    {
+    }
+
+    void shareFiles(const QList<QUrl> &urls) override
+    {
+        Q_UNUSED(urls)
+    }
+
+    void shareText(const QString &text) override
+    {
+        Q_UNUSED(text)
+    }
+
+    bool hasKeyboard() override
+    {
+        return true;
+    }
+
+    bool hasMouse() override
+    {
+        return true;
+    }
+
+    bool darkModeEnabled() override
+    {
+        return false;
+    }
+};
+}
 #else
 #include "mauilinux.h"
 #endif
@@ -33,6 +74,8 @@ Platform::Platform(QObject *parent)
     m_platform(new MAUIWindows(this))
 #elif defined Q_OS_IOS
     m_platform(new MAUIIOS(this))
+#elif defined(__OHOS__)
+    m_platform(new MAUIOHOS(this))
 #else
     m_platform(MAUIKDE::instance())
 #endif
