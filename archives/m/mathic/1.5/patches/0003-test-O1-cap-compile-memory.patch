--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -80,7 +80,15 @@
     target_include_directories(mathic-unit-tests PRIVATE
       ${googletest_SOURCE_DIR}/googletest/include
       ${googletest_SOURCE_DIR}/googletest/src
       ${googletest_SOURCE_DIR}/googletest
       )
   endif()
+  # HMBS OOM mitigation (mathic/1.4): cap peak clang memory when building
+  # the test executable on constrained workers (/bin/sh: Out of memory
+  # persists even with serial -j1 build). Test sources and logic are
+  # unchanged; only the optimization level of the non-shipped test
+  # executable is capped (-O1 wins over Release -O3 as it appears later
+  # on the compile line). The shipped mathic static library keeps its
+  # Release optimization level.
+  target_compile_options(mathic-unit-tests PRIVATE -O1)
 endif()
