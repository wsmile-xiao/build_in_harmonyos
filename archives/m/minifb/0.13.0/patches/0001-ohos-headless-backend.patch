--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -17,6 +17,8 @@
 # `UNIX` also overlaps MacOS, iOS, and Emscripten, which we don't want
 if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
     set(LINUX TRUE) # this is a default variable in cmake 3.25 and over
+elseif (CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    set(LINUX TRUE) # OHOS: linux-like kernel/musl; window backends disabled below
 elseif (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
     set(MACOS TRUE)
 endif()
@@ -71,6 +73,13 @@
     src/MiniFB_common.c
     src/MiniFB_cpp.cpp
     src/MiniFB_internal.c
+    # OHOS headless backend: the linux clock_gettime timer (its __linux__
+    # guard is true on OHOS) provides mfb_timer_tick/mfb_timer_init, and
+    # the recipe-shipped MiniFB_ohos_stub.c provides headless definitions
+    # for the four window-dependent entry points the core references
+    # (mfb_open_ex returns NULL — OHOS has no window system).
+    $<$<PLATFORM_ID:HarmonyOS>:src/MiniFB_linux.c>
+    $<$<PLATFORM_ID:HarmonyOS>:${CMAKE_CURRENT_SOURCE_DIR}/MiniFB_ohos_stub.c>
     src/MiniFB_internal.h
     src/MiniFB_timer.c
     src/WindowData.h
@@ -209,7 +218,11 @@
         "LINUX" OFF)
 
     if (NOT MINIFB_USE_WAYLAND_API AND LINUX)
-        set(MINIFB_USE_X11_API ON)
+        if (CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+            set(MINIFB_USE_X11_API OFF)
+        else()
+            set(MINIFB_USE_X11_API ON)
+        endif()
     endif()
 
     cmake_dependent_option(MINIFB_USE_OPENGL_API "Build the project using OpenGL API code" ON
@@ -238,6 +251,9 @@
 
     if (LINUX)
         option(MINIFB_USE_WAYLAND_API "Build the project using Wayland API code" OFF)
+        if (CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+            set(MINIFB_USE_X11_API OFF)
+        endif()
     else()
         set(MINIFB_USE_WAYLAND_API OFF)
         set(MINIFB_USE_X11_API ON)
