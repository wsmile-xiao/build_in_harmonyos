{
  "name": "minibwa",
  "description": "Lightweight BWA short-read aligner (index/map/meth) with a static C library",
  "homepage": "https://github.com/lh3/minibwa",
  "type": "tool",
  "versions": {
    "0.4": {
      "ref": "minibwa/0.4",
      "binary": true,
      "commands": [
        "minibwa index <ref.fa|fa.gz>",
        "minibwa map <ref.fa|fa.gz> <read1.fq|fa> [<read2.fq|fa>]",
        "minibwa map -f <ref> <read>",
        "minibwa version",
        "minibwa --help"
      ]
    },
    "0.7": {
      "ref": "minibwa/0.7",
      "binary": true
    }
  }
}
