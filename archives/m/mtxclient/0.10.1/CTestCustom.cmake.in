# Custom ctest configuration: skip the upstream test cases that need a live
# Synapse homeserver (upstream marks them `suite: network` in tests/meson.build).
#
# CTEST_CUSTOM_TESTS_IGNORE is an *ignored test file* -- a plain CMake variable
# holding a list of test-name regexes, so it must be set with set(), not called
# like a command. ctest reads this file from the build directory.
set(CTEST_CUSTOM_TESTS_IGNORE
  "BasicConnectivity"
  "ClientAPI"
  "MediaAPI"
  "Encryption"
  "Devices"
  "Pushrules"
)
