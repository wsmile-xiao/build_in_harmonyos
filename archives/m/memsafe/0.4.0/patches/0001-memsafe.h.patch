+#ifndef __cpp_lib_format
+namespace memsafe {
+// Minimal "{}" single-placeholder substitution (OHOS libc++15 lacks std::format).
+inline std::string ms_fmt1(const std::string &fmt, const std::string &a) {
+    std::string out;
+    size_t pos = 0;
+    bool done = false;
+    while (!done) {
+        size_t f = fmt.find("{}", pos);
+        if (f == std::string::npos) { out += fmt.substr(pos); break; }
+        out += fmt.substr(pos, f - pos); out += a; pos = f + 2; done = true;
+    }
+    return out;
+}}
 #endif
 
