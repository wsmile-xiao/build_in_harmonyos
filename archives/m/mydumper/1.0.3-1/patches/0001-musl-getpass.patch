--- a/src/connection.c
+++ b/src/connection.c
@@ -22,6 +22,48 @@
 #include <string.h>
 #include <stdbool.h>
 #include "config.h"
+
+#ifndef HAVE_GETPASS
+/* musl has no getpass(3). Inline a minimal termios-based replacement
+ * (same approach as openssh openbsd-compat readpassphrase): echo off
+ * while typing, terminal state restored afterwards. Selected purely by
+ * the CMake getpass() feature probe - no platform-specific macros. */
+#include <termios.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+
+static char *mydumper_getpass(const char *prompt)
+{
+    struct termios oldt, newt;
+    int tty = open("/dev/tty", O_RDWR);
+    char *ret = NULL;
+    static char buf[256];
+
+    if (tty < 0)
+        return NULL;
+    if (tcgetattr(tty, &oldt) == 0) {
+        newt = oldt;
+        newt.c_lflag &= ~(ECHO);
+        newt.c_lflag |= (ICANON | ISIG);
+        if (tcsetattr(tty, TCSAFLUSH, &newt) == 0) {
+            fputs(prompt, stderr);
+            fflush(stderr);
+            if (fgets(buf, sizeof(buf), stdin)) {
+                size_t len = strlen(buf);
+                while (len > 0 && (buf[len-1] == '\n' || buf[len-1] == '\r'))
+                    buf[--len] = 0;
+                ret = buf;
+            }
+            fputc('\n', stderr);
+            tcsetattr(tty, TCSAFLUSH, &oldt);
+        }
+    }
+    close(tty);
+    return ret;
+}
+#endif
+
 #include "connection.h"
 #include "common.h"
 #include "logging.h"
