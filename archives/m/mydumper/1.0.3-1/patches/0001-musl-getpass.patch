 char *passwordPrompt(void) {
+#ifndef HAVE_GETPASS
+  char *p = mydumper_getpass("Enter MySQL Password: ");
+#else
   char *p;
   p = getpass("Enter MySQL Password: ");
+#endif
 
   return p;
 }
