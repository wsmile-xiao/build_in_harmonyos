-	}
-
-	gbuf = xgetgrgid(sbuf.st_gid);
-	if (!gbuf) {
-		msg(MSG_ERROR, "getgrgid failed for %s: gid %i not found\n",
-		    path, (int)sbuf.st_gid);
+	/* Resolve the owner/group by name, but do not give up when the
+	 * passwd/group database has no entry for the id: HarmonyOS has none for
+	 * application uids, and discarding the entry would make every action a
+	 * no-op for every file this process can see.  The numeric id is used
+	 * instead and is accepted verbatim by the apply path. */
+	owner_name = xgetpwuid_name_or_num(sbuf.st_uid);
+	group_name = xgetgrgid_name_or_num(sbuf.st_gid);
+	if (!owner_name || !group_name) {
+		msg(MSG_ERROR, "failed to resolve owner/group for %s\n", path);
+		free(owner_name);
+		free(group_name);
 		return NULL;
 	}
 
 	mentry = mentry_alloc();
 	mentry->path = xstrdup(path);
 	mentry->pathlen = strlen(mentry->path);
-	mentry->owner = xstrdup(pbuf->pw_name);
-	mentry->group = xstrdup(gbuf->gr_name);
+	mentry->owner = owner_name;
+	mentry->group = group_name;
 	mentry->mode = sbuf.st_mode & 0177777;
 	mentry->mtime = sbuf.st_mtim.tv_sec;
 	mentry->mtimensec = sbuf.st_mtim.tv_nsec;
