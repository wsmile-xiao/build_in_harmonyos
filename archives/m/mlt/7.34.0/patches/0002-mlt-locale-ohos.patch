 #elif (defined _WIN32 && defined _LIBCPP_VERSION)
 struct mlt_locale_t;
+#elif defined(__has_include) && __has_include(<locale.h>)
+/* POSIX 平台（含 OHOS）：locale_t 由 <locale.h> 提供（newlocale/freelocale），
