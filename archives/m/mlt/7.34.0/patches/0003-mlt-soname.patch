+# OHOS 链接器未按 VERSION/SOVERSION 生成 SONAME（CMake 的 UNIX 变量在 OHOS 为 FALSE，
+# 不能用 if(UNIX...) 判断），显式指定 -Wl,-soname 使插件 NEEDED 记录 SONAME
+if(NOT WIN32)
+  target_link_options(mlt PRIVATE -Wl,-soname,libmlt-${MLT_VERSION_MAJOR}.so)
+endif()
+
 if(WIN32)
   if(MINGW)
     target_link_libraries(mlt PRIVATE ${MLT_PTHREAD_LIBS})
