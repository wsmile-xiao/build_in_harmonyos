diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,15 @@
+#!/bin/sh
+# Minimal configure wrapper for Makefile-only projects on OpenHarmony
+# mon uses a simple Makefile, no autotools. This wrapper accepts
+# standard configure options (--prefix etc.) and exits successfully.
+prefix=/usr/local
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*) prefix="${1#--prefix=}" ;;
+        *) ;;
+    esac
+    shift
+done
+# Write prefix to config.mk for Makefile to pick up
+echo "PREFIX = $prefix" > config.mk
+exit 0
