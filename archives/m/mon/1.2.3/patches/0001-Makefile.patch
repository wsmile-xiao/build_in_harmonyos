diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,22 +1,24 @@
 PREFIX ?= /usr/local
+-include config.mk
 SRC = src/mon.c deps/ms.c deps/commander.c
 OBJ = $(SRC:.c=.o)
 CFLAGS = -D_GNU_SOURCE -std=c99 -I deps/
 
 mon: $(OBJ)
 	$(CC) $(OBJ) -o $@
 
 .SUFFIXES: .c .o
 .c.o:
 	$(CC) $< $(CFLAGS) -c -o $@
 
 install: mon
-	cp -f mon $(PREFIX)/bin/mon
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	cp -f mon $(DESTDIR)$(PREFIX)/bin/mon
 
 uninstall:
 	rm -f $(PREFIX)/bin/mon
 
 clean:
 	rm -f mon $(OBJ)
 
 .PHONY: clean install uninstall