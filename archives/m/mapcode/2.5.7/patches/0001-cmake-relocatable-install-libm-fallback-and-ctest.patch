--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -93,7 +93,19 @@
 
 set(THREADS_PREFER_PTHREAD_FLAG ON)
 find_package(Threads REQUIRED)
+
+# Look for libm. Toolchains that keep their libraries in a target-triplet
+# directory (for example the OpenHarmony NDK, which only ships a static
+# libm.a) are not probed by find_library, which then leaves M_LIB set to
+# "M_LIB-NOTFOUND" and breaks the link step with "-lM_LIB-NOTFOUND".
+# Fall back to the plain linker flag so the math functions are resolved
+# from whichever libm the active toolchain provides.
 find_library(M_LIB m)
+if(NOT M_LIB)
+    set(M_LIB m)
+endif()
+
+include(GNUInstallDirs)
 
 add_library(mapcodelib ${SOURCE_FILES_MAPCODELIB})
 target_include_directories(mapcodelib PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
@@ -110,4 +122,24 @@
 target_link_libraries(mapcode LINK_PUBLIC Threads::Threads)
 target_link_libraries(mapcode LINK_PUBLIC ${M_LIB})
 
-install(TARGETS mapcode DESTINATION /usr/local/bin)
+# Register the upstream unit tests with CTest so that packaging builds can
+# run them through "ctest --output-on-failure". The upstream test reads
+# territories.csv relative to the working directory, hence the explicit
+# WORKING_DIRECTORY.
+enable_testing()
+add_test(NAME unittest COMMAND unittest
+         WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/test)
+
+# Install into relocatable, prefix-relative destinations. The library and its
+# public headers were not installed at all before, and the command line tool
+# was hard-coded to the absolute path /usr/local/bin, which makes the install
+# tree unusable for relocating packaging.
+install(TARGETS mapcodelib
+        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+install(TARGETS mapcode RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+install(FILES mapcodelib/mapcoder.h
+              mapcodelib/mapcode_territories.h
+              mapcodelib/mapcode_alphabets.h
+        DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/mapcodelib)
