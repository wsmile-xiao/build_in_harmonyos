-CPMAddPackage("gh:catchorg/Catch2@3.4.0")
+# OHOS/offline: use a preinstalled Catch2 (e.g. the Conan package) when one is
+# available, and only fall back to CPM's GitHub download when it is not.  The
+# upstream line below fetches Catch2 3.4.0 from github.com at configure time,
+# which cannot work on a network-restricted build worker.
+find_package(Catch2 CONFIG QUIET)
+if(NOT Catch2_FOUND)
+    CPMAddPackage("gh:catchorg/Catch2@3.4.0")
+endif()
 
