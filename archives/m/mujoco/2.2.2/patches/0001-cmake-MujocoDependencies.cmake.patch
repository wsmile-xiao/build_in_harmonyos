--- a/cmake/MujocoDependencies.cmake
+++ b/cmake/MujocoDependencies.cmake
@@ -71,20 +71,81 @@
 include(FetchContent)
 include(FindOrFetch)
 
 # We force all the dependencies to be compiled as static libraries.
 # TODO(fraromano) Revisit this choice when adding support for install.
 set(BUILD_SHARED_LIBS_OLD ${BUILD_SHARED_LIBS})
 set(BUILD_SHARED_LIBS
     OFF
     CACHE INTERNAL "Build SHARED libraries"
 )
+
+# ===== OHOS/Conan adaptation bridge (patch by DS-8) =====
+# Prefer Conan-provided packages: find them up front and pre-define the
+# upstream-expected (FetchContent-internal) target names so that every
+# findorfetch() call short-circuits on its TARGETS check, and so that
+# target_link_libraries(mujoco PRIVATE ccd lodepng qhullstatic_r ...) resolve
+# to the Conan-installed libraries instead of FetchContent builds.
+set(MUJOCO_OHOS_SYSTEM_DEPS ON)
+find_package(qhull QUIET)
+find_package(tinyxml2 QUIET)
+find_package(tinyobjloader QUIET)
+find_package(libccd QUIET)
+find_package(lodepng QUIET)
+find_package(GTest QUIET)
+find_package(benchmark QUIET)
+find_package(abseil-cpp QUIET)
+if(NOT TARGET qhull AND TARGET qhull::qhull)
+  add_library(qhull INTERFACE)
+  target_link_libraries(qhull INTERFACE qhull::qhull)
+endif()
+if(NOT TARGET qhullstatic_r AND TARGET qhull::qhull)
+  add_library(qhullstatic_r INTERFACE)
+  target_link_libraries(qhullstatic_r INTERFACE qhull::qhull)
+endif()
+if(NOT TARGET tinyxml2 AND TARGET tinyxml2::tinyxml2)
+  add_library(tinyxml2 INTERFACE)
+  target_link_libraries(tinyxml2 INTERFACE tinyxml2::tinyxml2)
+endif()
+if(NOT TARGET tinyobjloader AND TARGET tinyobjloader::tinyobjloader)
+  add_library(tinyobjloader INTERFACE)
+  target_link_libraries(tinyobjloader INTERFACE tinyobjloader::tinyobjloader)
+endif()
+if(NOT TARGET ccd AND TARGET libccd::libccd)
+  add_library(ccd INTERFACE)
+  target_link_libraries(ccd INTERFACE libccd::libccd)
+endif()
+if(NOT TARGET lodepng AND TARGET lodepng::lodepng)
+  add_library(lodepng INTERFACE)
+  target_link_libraries(lodepng INTERFACE lodepng::lodepng)
+endif()
+if(NOT TARGET gtest AND TARGET GTest::gtest)
+  add_library(gtest INTERFACE)
+  target_link_libraries(gtest INTERFACE GTest::gtest)
+endif()
+if(NOT TARGET gmock AND TARGET GTest::gmock)
+  add_library(gmock INTERFACE)
+  target_link_libraries(gmock INTERFACE GTest::gmock)
+endif()
+if(NOT TARGET gtest_main AND TARGET GTest::gtest_main)
+  add_library(gtest_main INTERFACE)
+  target_link_libraries(gtest_main INTERFACE GTest::gtest_main)
+endif()
+# components referenced by mujoco's test targets (grep test/ absl::*)
+foreach(_absl_comp core_headers strings synchronization string_view
+                   str_format flat_hash_set)
+  if(NOT TARGET absl::${_absl_comp} AND TARGET abseil-cpp::abseil-cpp)
+    # "::" names must be IMPORTED/ALIAS; alias the Conan target (same scope)
+    add_library(absl::${_absl_comp} ALIAS abseil-cpp::abseil-cpp)
+  endif()
+endforeach()
+# ===== end OHOS/Conan bridge =====
 
 if(NOT TARGET lodepng)
   FetchContent_Declare(
     lodepng
     GIT_REPOSITORY https://github.com/lvandeve/lodepng.git
     GIT_TAG ${MUJOCO_DEP_VERSION_lodepng}
   )
 
   FetchContent_GetProperties(lodepng)
   if(NOT lodepng_POPULATED)
@@ -125,44 +186,48 @@
   "-q"
   "${PROJECT_SOURCE_DIR}/cmake/qhull_fix_testing.patch"
   "||"
   "${CMAKE_COMMAND}"
   "-E"
   "true"
   EXCLUDE_FROM_ALL
 )
 # MuJoCo includes a file from libqhull_r which is not exported by the qhull include directories.
 # Add it to the target.
+if(NOT MUJOCO_OHOS_SYSTEM_DEPS)
 target_include_directories(
   qhullstatic_r INTERFACE $<BUILD_INTERFACE:${qhull_SOURCE_DIR}/src/libqhull_r>
 )
 target_compile_options(qhullstatic_r PRIVATE ${MUJOCO_MACOS_COMPILE_OPTIONS})
 target_link_options(qhullstatic_r PRIVATE ${MUJOCO_MACOS_LINK_OPTIONS})
+endif()
 
 set(tinyxml2_BUILD_TESTING OFF)
 findorfetch(
   USE_SYSTEM_PACKAGE
   OFF
   PACKAGE_NAME
   tinyxml2
   LIBRARY_NAME
   tinyxml2
   GIT_REPO
   https://github.com/leethomason/tinyxml2.git
   GIT_TAG
   ${MUJOCO_DEP_VERSION_tinyxml2}
   TARGETS
   tinyxml2
   EXCLUDE_FROM_ALL
 )
+if(NOT MUJOCO_OHOS_SYSTEM_DEPS)
 target_compile_options(tinyxml2 PRIVATE ${MUJOCO_MACOS_COMPILE_OPTIONS})
 target_link_options(tinyxml2 PRIVATE ${MUJOCO_MACOS_LINK_OPTIONS})
+endif()
 
 findorfetch(
   USE_SYSTEM_PACKAGE
   OFF
   PACKAGE_NAME
   tinyobjloader
   LIBRARY_NAME
   tinyobjloader
   GIT_REPO
   https://github.com/tinyobjloader/tinyobjloader.git
@@ -183,22 +248,24 @@
   LIBRARY_NAME
   ccd
   GIT_REPO
   https://github.com/danfis/libccd.git
   GIT_TAG
   ${MUJOCO_DEP_VERSION_ccd}
   TARGETS
   ccd
   EXCLUDE_FROM_ALL
 )
+if(NOT MUJOCO_OHOS_SYSTEM_DEPS)
 target_compile_options(ccd PRIVATE ${MUJOCO_MACOS_COMPILE_OPTIONS})
 target_link_options(ccd PRIVATE ${MUJOCO_MACOS_LINK_OPTIONS})
+endif()
 
 # libCCD has an unconditional `#define _CRT_SECURE_NO_WARNINGS` on Windows.
 # TODO(stunya): Remove this after https://github.com/danfis/libccd/pull/77 is merged.
 if(WIN32)
   if(MSVC)
     # C4005 is the MSVC equivalent of -Wmacro-redefined.
     target_compile_options(ccd PRIVATE /wd4005)
   else()
     target_compile_options(ccd PRIVATE -Wno-macro-redefined)
   endif()
