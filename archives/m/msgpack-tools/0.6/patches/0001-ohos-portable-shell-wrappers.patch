diff --git a/CMakeLists.txt b/CMakeLists.txt
index ab56e32..3c413c4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -126,6 +126,28 @@ file(READ ${LIBB64_CENCODE_FILE} LIBB64_CENCODE)
 string(REPLACE "*codechar++ = '\\n';" "/* *codechar++ = '\\n'; */" LIBB64_CENCODE "${LIBB64_CENCODE}")
 file(WRITE ${LIBB64_CENCODE_FILE} "${LIBB64_CENCODE}")

+# OpenHarmony/AArch64: char defaults to unsigned, so libb64's
+# `char fragment; ... if (fragment < 0)` sentinel test never fires and
+# base64 decode overruns by the pad bytes. Force signed char.
+# Idempotent and fail-closed: skip when already patched, rewrite only
+# the exact pristine declaration, and abort when neither form is found
+# so an upstream change can never silently disable the fix (and a rerun
+# can never produce "signed signed char fragment;").
+set(LIBB64_CDECODE_FILE ${LIBB64_DIR}/src/cdecode.c)
+file(READ ${LIBB64_CDECODE_FILE} LIBB64_CDECODE)
+string(FIND "${LIBB64_CDECODE}" "signed char fragment;" LIBB64_CDECODE_SIGNED_AT)
+string(FIND "${LIBB64_CDECODE}" "char fragment;" LIBB64_CDECODE_DECL_AT)
+if(LIBB64_CDECODE_SIGNED_AT GREATER -1)
+    # Rewriting an already-signed declaration would produce
+    # "signed signed char fragment;" and break the build.
+    message(STATUS "libb64 cdecode.c: 'signed char fragment' already present, skipping rewrite")
+elseif(LIBB64_CDECODE_DECL_AT GREATER -1)
+    string(REPLACE "char fragment;" "signed char fragment;" LIBB64_CDECODE "${LIBB64_CDECODE}")
+    file(WRITE ${LIBB64_CDECODE_FILE} "${LIBB64_CDECODE}")
+else()
+    message(FATAL_ERROR "libb64 cdecode.c: 'char fragment;' declaration not found; refusing to build without the AArch64 signed-char fix")
+endif()
+
 file(GLOB_RECURSE LIBB64_SRCS ${LIBB64_DIR}/src/*.c)
 include_directories(SYSTEM ${LIBB64_DIR}/include)

@@ -197,7 +219,7 @@ add_test("json2msgpack-basic-strict-fail"     ${FAIL}
 add_test("msgpack2json-basic-min"             ${COMPARE} ${TESTS_DIR}/basic-min.json               ${VALGRIND} ./msgpack2json -i ${TESTS_DIR}/basic.mp)
 add_test("msgpack2json-basic"                 ${COMPARE} ${TESTS_DIR}/basic.json                   ${VALGRIND} ./msgpack2json -pi ${TESTS_DIR}/basic.mp)
 add_test("msgpack2json-basic-debug"           ${COMPARE} ${TESTS_DIR}/basic.json                   ${VALGRIND} ./msgpack2json -di ${TESTS_DIR}/basic.mp)
-add_test("msgpack2json-stdin"                 ${COMPARE} ${TESTS_DIR}/basic.json                   bash -c "cat ${TESTS_DIR}/basic.mp | ${VALGRIND} ./msgpack2json -p")
+add_test("msgpack2json-stdin"                 ${COMPARE} ${TESTS_DIR}/basic.json                   sh -c "cat ${TESTS_DIR}/basic.mp | ${VALGRIND} ./msgpack2json -p")

 add_test("json2msgpack-base64-str-prefix"     ${COMPARE} ${TESTS_DIR}/base64-str-prefix.mp         ${VALGRIND} ./json2msgpack -i ${TESTS_DIR}/base64-prefix.json)
 add_test("json2msgpack-base64-bin"            ${COMPARE} ${TESTS_DIR}/base64-bin-ext.mp            ${VALGRIND} ./json2msgpack -bi ${TESTS_DIR}/base64-prefix.json)
