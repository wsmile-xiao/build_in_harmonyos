--- /dev/null
+++ b/include/sse_to_neon.h
@@ -0,0 +1,205 @@
+/**
+ * sse_to_neon.h -- a small, self-contained ARM NEON implementation of the
+ * 128-bit Intel SSE2/SSSE3/SSE4.1 intrinsics that MaskedVByte's vectorized
+ * decoder (src/varintdecode.c) uses on AArch64.
+ *
+ * Upstream references this header (README / CMakeLists.txt: "On 64-bit ARM it
+ * uses the NEON baseline via include/sse_to_neon.h"), but the v0.1.0 release
+ * tag does not ship the file, which breaks the aarch64 build out of the box.
+ * This shim restores the missing header with the same semantics as the
+ * corresponding SSE instructions (see inline notes). It is written directly
+ * against <arm_neon.h> and keeps the Intel spellings (__m128i, _mm_*) so the
+ * rest of the library compiles unchanged.
+ */
+#ifndef MASKEDVBYTE_SSE_TO_NEON_H_
+#define MASKEDVBYTE_SSE_TO_NEON_H_
+
+#include <arm_neon.h>
+#include <stdint.h>
+
+#if defined(__GNUC__) || defined(__clang__)
+#define SSE_TO_NEON_INLINE __inline__ __attribute__((always_inline))
+#else
+#define SSE_TO_NEON_INLINE inline
+#endif
+
+/* The canonical 128-bit integer vector, treated as four 32-bit lanes for
+ * arithmetic and as raw 128 bits for the logical / byte operations. */
+typedef int32x4_t __m128i;
+/* Only used as the bridge for _mm_castsi128_ps -> _mm_movemask_ps. */
+typedef float32x4_t __m128;
+
+/* ---- loads and stores (aligned and unaligned are identical on AArch64) ---- */
+
+static SSE_TO_NEON_INLINE __m128i _mm_loadu_si128(const __m128i *p) {
+  return vld1q_s32((const int32_t *)p);
+}
+static SSE_TO_NEON_INLINE __m128i _mm_load_si128(const __m128i *p) {
+  return vld1q_s32((const int32_t *)p);
+}
+/* _mm_lddqu_si128 is an unaligned load on SSE3; NEON has no alignment trap. */
+static SSE_TO_NEON_INLINE __m128i _mm_lddqu_si128(const __m128i *p) {
+  return vld1q_s32((const int32_t *)p);
+}
+static SSE_TO_NEON_INLINE void _mm_storeu_si128(__m128i *p, __m128i a) {
+  vst1q_s32((int32_t *)p, a);
+}
+static SSE_TO_NEON_INLINE void _mm_store_si128(__m128i *p, __m128i a) {
+  vst1q_s32((int32_t *)p, a);
+}
+/* Store only the low 64 bits (MOVQ / _mm_storel_epi64). */
+static SSE_TO_NEON_INLINE void _mm_storel_epi64(__m128i *p, __m128i a) {
+  vst1_u64((uint64_t *)p, vget_low_u64(vreinterpretq_u64_s32(a)));
+}
+
+/* ---- constructors ---- */
+
+static SSE_TO_NEON_INLINE __m128i _mm_setzero_si128(void) {
+  return vdupq_n_s32(0);
+}
+static SSE_TO_NEON_INLINE __m128i _mm_set1_epi32(int v) {
+  return vdupq_n_s32(v);
+}
+static SSE_TO_NEON_INLINE __m128i _mm_set1_epi16(short w) {
+  return vreinterpretq_s32_s16(vdupq_n_s16(w));
+}
+static SSE_TO_NEON_INLINE __m128i _mm_set1_epi8(char b) {
+  return vreinterpretq_s32_s8(vdupq_n_s8(b));
+}
+/* lane 0 == e0, matching the "reversed" Intel constructors */
+static SSE_TO_NEON_INLINE __m128i _mm_setr_epi32(int e0, int e1, int e2,
+                                                 int e3) {
+  int32_t tmp[4] = {e0, e1, e2, e3};
+  return vld1q_s32(tmp);
+}
+static SSE_TO_NEON_INLINE __m128i _mm_setr_epi16(short w0, short w1, short w2,
+                                                 short w3, short w4, short w5,
+                                                 short w6, short w7) {
+  int16_t tmp[8] = {w0, w1, w2, w3, w4, w5, w6, w7};
+  return vreinterpretq_s32_s16(vld1q_s16(tmp));
+}
+static SSE_TO_NEON_INLINE __m128i _mm_setr_epi8(signed char b0, signed char b1,
+                                                signed char b2, signed char b3,
+                                                signed char b4, signed char b5,
+                                                signed char b6, signed char b7,
+                                                signed char b8, signed char b9,
+                                                signed char b10,
+                                                signed char b11,
+                                                signed char b12,
+                                                signed char b13,
+                                                signed char b14,
+                                                signed char b15) {
+  int8_t tmp[16] = {b0, b1, b2,  b3,  b4,  b5,  b6,  b7,
+                    b8, b9, b10, b11, b12, b13, b14, b15};
+  return vreinterpretq_s32_s8(vld1q_s8(tmp));
+}
+
+/* ---- bitwise logic over all 128 bits ---- */
+
+static SSE_TO_NEON_INLINE __m128i _mm_and_si128(__m128i a, __m128i b) {
+  return vandq_s32(a, b);
+}
+static SSE_TO_NEON_INLINE __m128i _mm_or_si128(__m128i a, __m128i b) {
+  return vorrq_s32(a, b);
+}
+
+/* ---- 32-bit lane integer arithmetic / compare ---- */
+
+static SSE_TO_NEON_INLINE __m128i _mm_add_epi32(__m128i a, __m128i b) {
+  return vaddq_s32(a, b);
+}
+static SSE_TO_NEON_INLINE __m128i _mm_sub_epi32(__m128i a, __m128i b) {
+  return vsubq_s32(a, b);
+}
+/* Signed 32-bit lane compare (a < b -> all ones, else zero). */
+static SSE_TO_NEON_INLINE __m128i _mm_cmplt_epi32(__m128i a, __m128i b) {
+  return vreinterpretq_s32_u32(vcltq_s32(a, b));
+}
+/* PMULLW: low 16 bits of each 16-bit lane product. */
+static SSE_TO_NEON_INLINE __m128i _mm_mullo_epi16(__m128i a, __m128i b) {
+  return vreinterpretq_s32_s16(vmulq_s16(vreinterpretq_s16_s32(a),
+                                         vreinterpretq_s16_s32(b)));
+}
+/* Sign-extend the low 4 bytes of a into 4 int32 lanes (SSE4.1). */
+static SSE_TO_NEON_INLINE __m128i _mm_cvtepi8_epi32(__m128i a) {
+  int16x8_t s16x8 = vmovl_s8(vget_low_s8(vreinterpretq_s8_s32(a)));
+  int32x4_t s32x4 = vmovl_s16(vget_low_s16(s16x8));
+  return s32x4;
+}
+
+/* ---- per-lane logical shifts by a (possibly run-time) count ----
+ * NEON's vshlq with a negative count performs a right shift; a count whose
+ * magnitude is >= the lane width yields 0, which matches the SSE intrinsics. */
+static SSE_TO_NEON_INLINE __m128i _mm_srli_epi32(__m128i a, int count) {
+  return vreinterpretq_s32_u32(
+      vshlq_u32(vreinterpretq_u32_s32(a), vdupq_n_s32(-count)));
+}
+static SSE_TO_NEON_INLINE __m128i _mm_srli_epi16(__m128i a, int count) {
+  return vreinterpretq_s32_u16(
+      vshlq_u16(vreinterpretq_u16_s32(a), vdupq_n_s16((int16_t)-count)));
+}
+static SSE_TO_NEON_INLINE __m128i _mm_slli_epi64(__m128i a, int count) {
+  return vreinterpretq_s32_u64(
+      vshlq_u64(vreinterpretq_u64_s32(a), vdupq_n_s64(count)));
+}
+static SSE_TO_NEON_INLINE __m128i _mm_srli_epi64(__m128i a, int count) {
+  return vreinterpretq_s32_u64(
+      vshlq_u64(vreinterpretq_u64_s32(a), vdupq_n_s64(-count)));
+}
+
+/* ---- lane extraction (immediate must fold to a compile-time constant) ---- */
+static SSE_TO_NEON_INLINE int _mm_cvtsi128_si32(__m128i a) {
+  return vgetq_lane_s32(a, 0);
+}
+#define _mm_extract_epi32(a, imm) vgetq_lane_s32((a), (imm))
+
+/* Reorder 32-bit lanes per the 2-bit fields of the Intel control byte. */
+#define _mm_shuffle_epi32(a, imm)                                              \
+  vsetq_lane_s32(vgetq_lane_s32((a), ((imm) >> 6) & 3),                        \
+                 vsetq_lane_s32(vgetq_lane_s32((a), ((imm) >> 4) & 3),         \
+                                vsetq_lane_s32(vgetq_lane_s32((a),             \
+                                                              ((imm) >> 2) & 3), \
+                                               vsetq_lane_s32(                 \
+                                                   vgetq_lane_s32((a), (imm) & 3), \
+                                                   vdupq_n_s32(0), 0),          \
+                                               1),                             \
+                                2),                                            \
+                3)
+
+/* ---- whole-register byte shifts (shift in zeroes), imm in [0,15] ---- */
+#define _mm_srli_si128(a, imm)                                                 \
+  vreinterpretq_s32_u8(                                                        \
+      vextq_u8(vreinterpretq_u8_s32(a), vdupq_n_u8(0), (imm)))
+#define _mm_slli_si128(a, imm)                                                 \
+  vreinterpretq_s32_u8(                                                        \
+      vextq_u8(vdupq_n_u8(0), vreinterpretq_u8_s32(a), 16 - (imm)))
+
+/* ---- per-byte table lookup (PSHUFB) ----
+ * Masking the control with 0x8F reproduces PSHUFB exactly: a control byte
+ * with bit 7 set (or any value >= 16) selects 0, otherwise only the low
+ * nibble indexes the source. */
+static SSE_TO_NEON_INLINE __m128i _mm_shuffle_epi8(__m128i a, __m128i mask) {
+  uint8x16_t idx = vandq_u8(vreinterpretq_u8_s32(mask), vdupq_n_u8(0x8F));
+  return vreinterpretq_s32_u8(vqtbl1q_u8(vreinterpretq_u8_s32(a), idx));
+}
+
+/* ---- byte sign-bit gather (PMOVMSKB) ---- */
+static SSE_TO_NEON_INLINE int _mm_movemask_epi8(__m128i a) {
+  uint8x16_t input = vreinterpretq_u8_s32(a);
+  uint8x16_t msbs = vshrq_n_u8(input, 7);
+  static const int8_t shift_table[16] = {0, 1, 2, 3, 4, 5, 6, 7,
+                                         0, 1, 2, 3, 4, 5, 6, 7};
+  uint8x16_t positioned = vshlq_u8(msbs, vld1q_s8(shift_table));
+  return vaddv_u8(vget_low_u8(positioned)) |
+         (vaddv_u8(vget_high_u8(positioned)) << 8);
+}
+
+/* ---- float reinterpretation + sign-bit gather ---- */
+#define _mm_castsi128_ps(a) vreinterpretq_f32_s32(a)
+static SSE_TO_NEON_INLINE int _mm_movemask_ps(__m128 a) {
+  static const int32_t shift[4] = {0, 1, 2, 3};
+  uint32x4_t tmp = vshrq_n_u32(vreinterpretq_u32_f32(a), 31);
+  return (int)vaddvq_u32(vshlq_u32(tmp, vld1q_s32(shift)));
+}
+
+#endif /* MASKEDVBYTE_SSE_TO_NEON_H_ */
