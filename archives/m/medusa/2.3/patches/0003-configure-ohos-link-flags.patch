--- a/configure	2025-05-14 08:36:35.000000000 +0800
+++ b/configure	2026-09-29 16:39:34.574909300 +0800
@@ -7512,7 +7512,14 @@
 
 case "$target" in
   *linux*)
-    LIBDL="-ldl -lrt -lm"
+    case "$target" in
+      *ohos*)
+        LIBDL="-ldl -lm"
+        ;;
+      *)
+        LIBDL="-ldl -lrt -lm"
+        ;;
+    esac
     RDYNAMIC="-rdynamic"
     MODULE_LIBS="$MODULE_LIBS -shared"
     EXTRA_LDFLAGS=""
--- a/configure.ac	2025-05-14 08:31:56.000000000 +0800
+++ b/configure.ac	2026-09-29 16:39:34.574909300 +0800
@@ -976,7 +976,17 @@
 
 case "$target" in
   *linux*)
-    LIBDL="-ldl -lrt -lm"
+    dnl HarmonyOS (OHOS) is musl-based: clock_gettime() and the other
+    dnl POSIX realtime calls live in libc, so there is no separate librt.
+    dnl Keeping "-lrt" makes the link step fail with "cannot find -lrt".
+    case "$target" in
+      *ohos*)
+        LIBDL="-ldl -lm"
+        ;;
+      *)
+        LIBDL="-ldl -lrt -lm"
+        ;;
+    esac
     RDYNAMIC="-rdynamic"
     MODULE_LIBS="$MODULE_LIBS -shared"
     EXTRA_LDFLAGS=""
