--- a/configure	2025-05-14 08:36:35.000000000 +0800
+++ b/configure	2026-09-29 16:58:01.488090300 +0800
@@ -6677,7 +6677,9 @@
     check_libgcrypt="true"
   fi
 
-    if test -f "`which ldd`"; then
+    if test "$target" != "${target%ohos*}"; then
+    check_libgcrypt="false"
+  elif test -f "`which ldd`"; then
     LDD="ldd"
   elif test -f "`which otool`"; then
     LDD="otool -L"
--- a/configure.ac	2025-05-14 08:31:56.000000000 +0800
+++ b/configure.ac	2026-09-29 16:58:01.487101400 +0800
@@ -667,7 +667,13 @@
   fi  
 
   dnl Use otool on Mac OS X
-  if test -f "`which ldd`"; then
+  dnl HarmonyOS: `ldd`/`otool` do not exist, and the OHOS libssh2 package is
+  dnl built against OpenSSL, so the fallback below ("assume libgcrypt, then
+  dnl require GnuTLS") would disable the SSH module even though both the
+  dnl libssh2 and libgcrypt probes above already succeeded.
+  if test "$target" != "${target%ohos*}"; then
+    check_libgcrypt="false"
+  elif test -f "`which ldd`"; then
     LDD="ldd"
   elif test -f "`which otool`"; then
     LDD="otool -L"
