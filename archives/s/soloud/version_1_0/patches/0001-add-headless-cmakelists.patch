diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..d5f1a2b
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,65 @@
+cmake_minimum_required(VERSION 3.15)
+project(soloud C CXX)
+
+# SoLoud version_1_0 upstream ships no build system (demos drive SDL directly).
+# This CMakeLists builds the headless core engine: core + sinewave + speech + wav
+# (+ bundled stb_vorbis) + filter. The optional SDL back-end (sdl/) and all
+# SDL-dependent demos (demos/, main.cpp) are intentionally excluded so the
+# library carries zero external dependencies on OHOS.
+
+set(SOLOUD_SRC
+    core/soloud.cpp
+    sinewave/soloud_sinewave.cpp
+    speech/darray.cpp
+    speech/klatt.cpp
+    speech/resonator.cpp
+    speech/soloud_speech.cpp
+    speech/tts.cpp
+    wav/soloud_wav.cpp
+    wav/soloud_wavstream.cpp
+    wav/stb_vorbis.c
+    filter/soloud_filter.cpp
+)
+
+add_library(soloud ${SOLOUD_SRC})
+
+target_include_directories(soloud PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/core>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/sinewave>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/speech>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/wav>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/filter>
+    $<INSTALL_INTERFACE:include>
+)
+
+# stb_vorbis is C; the rest is C++
+set_source_files_properties(wav/stb_vorbis.c PROPERTIES LANGUAGE C)
+
+find_package(Threads REQUIRED)
+target_link_libraries(soloud PUBLIC Threads::Threads)
+
+if(NOT BUILD_SHARED_LIBS)
+    target_compile_definitions(soloud PRIVATE SOLOUD_STATIC)
+endif()
+
+include(GNUInstallDirs)
+install(TARGETS soloud
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+)
+
+install(FILES
+    core/soloud.h
+    sinewave/soloud_sinewave.h
+    speech/darray.h
+    speech/klatt.h
+    speech/resonator.h
+    speech/soloud_speech.h
+    speech/tts.h
+    wav/soloud_wav.h
+    wav/soloud_wavstream.h
+    wav/stb_vorbis.h
+    filter/soloud_filter.h
+    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+)
