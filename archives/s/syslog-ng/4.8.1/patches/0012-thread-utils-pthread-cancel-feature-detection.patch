--- a/lib/thread-utils.h
+++ b/lib/thread-utils.h
@@ -55,8 +55,15 @@
 thread_cancel(ThreadId tid)
 {
 #ifndef _WIN32
+#ifdef SYSLOG_NG_HAVE_PTHREAD_CANCEL
   pthread_cancel(tid);
 #else
+  /* Optional POSIX interface; some C libraries do not provide it and
+   * this helper has no callers in the tree: stay a no-op there
+   * (detected by configure). */
+  (void) tid;
+#endif
+#else
   TerminateThread(tid, 0);
 #endif
 }
--- a/configure
+++ b/configure
@@ -31027,6 +31027,12 @@
   printf "%s\n" "#define HAVE_GETUTXENT 1" >>confdefs.h
 
 fi
+ac_fn_c_check_func "$LINENO" "pthread_cancel" "ac_cv_func_pthread_cancel"
+if test "x$ac_cv_func_pthread_cancel" = xyes
+then :
+  printf "%s\n" "#define HAVE_PTHREAD_CANCEL 1" >>confdefs.h
+
+fi
 ac_fn_c_check_func "$LINENO" "pread" "ac_cv_func_pread"
 if test "x$ac_cv_func_pread" = xyes
 then :
