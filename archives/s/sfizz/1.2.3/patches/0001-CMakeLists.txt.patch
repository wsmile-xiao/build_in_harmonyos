+# Vendored third-party libraries (abseil/wavpack/aiff/... ) must stay static:
+# CMakeToolchain injects BUILD_SHARED_LIBS=ON when shared is enabled, which
+# would turn them into shared libraries that sfizz's install rules do not ship.
+# A plain (non-CACHE) set shadows that and is inherited by add_subdirectory().
+set(BUILD_SHARED_LIBS OFF)
+
 include(SfizzConfig)
