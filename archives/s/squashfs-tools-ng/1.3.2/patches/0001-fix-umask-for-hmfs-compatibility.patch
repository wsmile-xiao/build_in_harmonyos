#!/bin/sh
# 0001-fix-umask-for-hmfs-compatibility.patch
#
# squashfs-tools-ng 1.3.2: Fix autoconf umask 077 for HMFS compatibility
#
# On HarmonyOS NEXT's HMFS filesystem, newly created directories inherit the
# owner UID from the parent directory regardless of the creating process's UID.
# When autoconf's generated configure/config.status scripts create temporary
# directories with "umask 077 && mktemp -d", the result is a directory with
# permissions drwx------ owned by the parent directory's owner (UID 20001006),
# not the current user (UID 20020082). This makes the temp directory inaccessible
# to the build process, causing "Permission denied" errors when config.status
# tries to create subs1.awk inside the temp directory.
#
# This patch changes umask 077 to umask 007 in the generated configure script
# after running autoreconf. With umask 007, the created directories have
# permissions drwxrws---, allowing group (file_manager) access since our user
# belongs to that group.
#
# This patch must be applied AFTER running autoreconf, since configure is a
# generated file not included in the original source tarball.
#
# Apply: cd squashfs-tools-ng-1.3.2.work && sed -i 's/umask 077/umask 007/g' configure

--- /dev/null
+++ b/configure.umask-fix
@@ -0,0 +1,5 @@
+# This is a sed-based patch applied after autoreconf generates configure.
+# The configure script is ~22K lines, so a full diff would be impractical.
+# Apply with: sed -i 's/umask 077/umask 007/g' configure
+# This changes lines 21061 and 21066 from "umask 077" to "umask 007"
+# to allow group access to autoconf's temporary directories on HMFS.