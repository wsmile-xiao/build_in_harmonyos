diff -ruN a/bsd-compat/getpeereid.c b/bsd-compat/getpeereid.c
--- a/bsd-compat/getpeereid.c
+++ b/bsd-compat/getpeereid.c
@@ -14,20 +14,32 @@
  * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
  */
 #include <sys/types.h>
 #include <sys/socket.h>
 #include "bsd-compat.h"
 
 #ifndef HAVE_GETPEEREID
 int
 getpeereid(int s, uid_t *ruid, gid_t *rgid)
 {
+#ifdef __OHOS__
+	/* OpenHarmony/musl: struct ucred is incomplete in headers;
+	 * define local struct matching kernel ABI */
+	struct sndio_ucred {
+		pid_t pid;
+		uid_t uid;
+		gid_t gid;
+	};
+	struct sndio_ucred cr;
+	socklen_t len = sizeof(cr);
+#else
 	struct ucred cr;
 	socklen_t len = sizeof(cr);
+#endif
 
 	if (getsockopt(s, SOL_SOCKET, SO_PEERCRED, &cr, &len) < 0)
 		return -1;
 	*ruid = cr.uid;
 	*rgid = cr.gid;
 	return 0;
 }
 #endif
