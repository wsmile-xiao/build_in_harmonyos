--- a/core/AmThread.cpp
+++ b/core/AmThread.cpp
@@ -145,6 +145,12 @@
 void AmThread::cancel() {
   _m_td.lock();
 
+#if defined(__OHOS__) || defined(__MUSL__)
+  // OHOS musl libc has no pthread_cancel; cooperative stop only.
+  DBG("pthread_cancel unavailable on OHOS/musl; cooperative stop for thread %lu.\n",
+      (unsigned long int) _pid);
+  _stopped.set(true);
+#else
   int res;
   if ((res = pthread_cancel(_td)) != 0) {
     ERROR("pthread_cancel failed with code %i\n", res);
@@ -152,6 +158,7 @@
     DBG("Thread %lu is canceled.\n", (unsigned long int) _pid);
     _stopped.set(true);
   }
+#endif
 
   _m_td.unlock();
 }
