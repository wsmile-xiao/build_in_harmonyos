--- a/vttest.c
+++ b/vttest.c
@@ -17,6 +17,26 @@
 #include	<fcntl.h>
 #ifdef HAVE_TERMIO_H 
 #include        <termio.h> 
+#elif defined(__has_include) && __has_include(<termios.h>) && !__has_include(<termio.h>)
+/* Neither System V <termio.h> nor the BSD sgtty layer (TIOCGETP/TIOCSETP,
+   struct sgttyb, RAW) exists on this libc -- musl-based sysroots such as the
+   OHOS aarch64 one.  Run the vt100 probe through POSIX termios: struct
+   termios carries the same c_iflag/c_oflag/c_lflag/c_cc fields and TCSETS
+   drains the output queue the way TCSETAW did.  Defining HAVE_TERMIO_H below
+   also selects the existing VMIN/VTIME character-timer path instead of the
+   SIGALRM/setjmp fallback, so no alarm() is left armed in the caller. */
+#include	<sys/ioctl.h>
+#include	<termios.h>
+#ifdef TCGETA
+#undef TCGETA
+#endif
+#ifdef TCSETAW
+#undef TCSETAW
+#endif
+#define termio	termios
+#define TCGETA	TCGETS
+#define TCSETAW	TCSETS
+#define HAVE_TERMIO_H 1
 #else 
 #include	<setjmp.h> 
 #include	<signal.h> 
