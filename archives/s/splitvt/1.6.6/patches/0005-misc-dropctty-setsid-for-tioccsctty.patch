--- a/misc.c
+++ b/misc.c
@@ -428,8 +428,16 @@
 {
 	int fd;
 
+/* TIOCSCTTY, which pty_open() uses right after the fork to re-attach the
+   slave pty as the controlling terminal, is only permitted to a session
+   leader -- so every system that offers it wants the POSIX setsid() route
+   here.  Taking the TIOCNOTTY branch on such a system leaves the child in
+   its parent's session, never owning its pty, and an interactive program
+   started there (a shell) sees itself as a background job and never runs
+   the line typed into it. */
 #if defined(_POSIX_SOURCE) || defined(SOLARIS) || \
-				defined(__386BSD__) || defined(__FreeBSD__)
+				defined(__386BSD__) || defined(__FreeBSD__) || \
+				defined(TIOCSCTTY)
 	setsid();		/* The POSIX solution is simple. :) */
 #else
 #ifdef TIOCNOTTY  /* We want to get HP-UX, BSD, and Sun/OS here */
