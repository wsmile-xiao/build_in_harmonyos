--- a/misc.c
+++ b/misc.c
@@ -13,6 +13,33 @@
 #include	<termio.h>
 #else
 #include	<sys/ioctl.h>
+/* libcs shipping neither <termio.h> nor <sgtty.h> (musl-based sysroots, e.g.
+   the OHOS aarch64 one) still provide the POSIX termios API, so use it as the
+   termio substitute instead of the legacy BSD sgtty ioctls they never
+   declared: struct termio -> struct termios, and the System V queue requests
+   -> their POSIX equivalents (TCSETAW drains pending output, which is what
+   the TCSADRAIN-style behaviour of the original code relies on).
+   __has_include() keeps platforms that really do have <termio.h> (glibc) on
+   the original System V branch, so existing behaviour there is unchanged. */
+#if defined(__has_include)
+#  if __has_include(<termios.h>) && !__has_include(<termio.h>)
+#    include	<termios.h>
+#    ifdef TCGETA
+#      undef TCGETA
+#    endif
+#    ifdef TCSETA
+#      undef TCSETA
+#    endif
+#    ifdef TCSETAW
+#      undef TCSETAW
+#    endif
+#    define termio		termios
+#    define TCGETA		TCGETS
+#    define TCSETA		TCSETS
+#    define TCSETAW		TCSETS
+#    define HAVE_TERMIO_H	1
+#  endif
+#endif
 #endif  /* HAVE_TERMIO_H */
 
 #ifdef HAVE_BSDTTY_H
