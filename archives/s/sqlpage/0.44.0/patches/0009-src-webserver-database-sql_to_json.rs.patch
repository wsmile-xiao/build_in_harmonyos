 fn decimal_to_json(decimal: &BigDecimal) -> Value {
     // to_plain_string always returns a valid JSON string
     Value::Number(serde_json::Number::from_string_unchecked(
         decimal.normalized().to_plain_string(),
     ))
 }
 
