diff -ruN a/.cargo/config.toml b/.cargo/config.toml
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -1,10 +1,16 @@
 [env]
 # To use built-in math functions, this compile time flag must be set
 # See https://www.sqlite.org/draft/lang_mathfunc.html as a reference
 # According to Cargo docs this will not overwrite any env var that was already
 # set by the user, and this is a good thing. If the user already set some
 # LIBSQLITE3_FLAGS, he probably knows what he is doing.
 LIBSQLITE3_FLAGS = "-DSQLITE_ENABLE_MATH_FUNCTIONS"
 
 [build]
 rustflags = []
+
+# __OHOS__: Cross-compilation target with OHOS linker/CC/CXX wrapper
+# The system is OHOS but Rust uses musl target; wrapper converts musl→ohos for clang
+[target.aarch64-unknown-linux-musl]
+linker = "/storage/Users/currentUser/tmp/clang-ohos-wrapper.sh"
+rustflags = ["-C", "link-arg=-L/storage/Users/currentUser/usr/local/lib"]
