--- /dev/null
+++ b/pthread_compat.c
@@ -0,0 +1,23 @@
+/*
+ * pthread_compat.c - pthread 函数兼容性存根
+ * 
+ * 鸿蒙系统使用 musl libc，不支持 pthread_cancel 和 pthread_testcancel
+ * 提供空实现以满足链接需求
+ */
+
+#include <pthread.h>
+
+/* pthread_cancel - 在 musl 中不支持的线程取消功能
+ * 返回值：0 表示成功，ESRCH 表示线程不存在
+ * 在不支持线程取消的系统上，这只是一个空操作
+ */
+int pthread_cancel(pthread_t thread) {
+    (void)thread;
+    /* 在 musl 系统上，线程取消不被支持
+     * 返回 0 以避免错误，但实际不执行任何操作
+     */
+    return 0;
+}
+
+/* pthread_testcancel - 测试取消点
+ * 在 musl 中不支持，提供空实现
+ */
+void pthread_testcancel(void) {
+    /* 在 musl 系统上，线程取消不被支持
+     * 这是一个空操作
+     */
+}
