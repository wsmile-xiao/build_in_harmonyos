diff -ruN a/Makefile.manual b/Makefile.manual
--- a/Makefile.manual
+++ b/Makefile.manual
@@ -0,0 +1,38 @@
+CC = clang
+CFLAGS = -fPIC -O2 -DHAVE_CONFIG_H -I. -Iinclude -Iinclude/speex
+AR = llvm-ar
+RANLIB = llvm-ranlib
+
+SOURCES = libspeexdsp/preprocess.c libspeexdsp/jitter.c libspeexdsp/mdf.c \
+          libspeexdsp/fftwrap.c libspeexdsp/filterbank.c libspeexdsp/resample.c \
+          libspeexdsp/buffer.c libspeexdsp/scal.c libspeexdsp/smallft.c
+
+OBJECTS = $(SOURCES:.c=.o)
+
+all: config.h libspeexdsp.a libspeexdsp.so
+
+config.h: config.h.in
+	cp config.h.in config.h
+
+libspeexdsp.a: $(OBJECTS)
+	$(AR) rcs $@ $^
+	$(RANLIB) $@
+
+libspeexdsp.so: $(OBJECTS)
+	$(CC) -shared -o $@ $^ -lm
+
+%.o: %.c config.h
+	$(CC) $(CFLAGS) -c -o $@ $<
+
+clean:
+	rm -f $(OBJECTS) libspeexdsp.a libspeexdsp.so config.h
+
+install: all
+	mkdir -p $(DESTDIR)$(PREFIX)/lib $(DESTDIR)$(PREFIX)/lib/pkgconfig $(DESTDIR)$(PREFIX)/include/speex
+	cp libspeexdsp.a libspeexdsp.so $(DESTDIR)$(PREFIX)/lib/
+	cp include/speex/speexdsp_types.h include/speex/speexdsp_config_types.h $(DESTDIR)$(PREFIX)/include/speex/
+	cp include/speex/speex_echo.h include/speex/speex_preprocess.h $(DESTDIR)$(PREFIX)/include/speex/
+	cp include/speex/speex_resampler.h include/speex/speex_jitter.h $(DESTDIR)$(PREFIX)/include/speex/
+	cp include/speex/speex_buffer.h $(DESTDIR)$(PREFIX)/include/speex/
+
+.PHONY: all clean install
