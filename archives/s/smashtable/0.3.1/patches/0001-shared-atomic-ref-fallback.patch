+// itself lowers to. Memory order enumerators match the `__ATOMIC_*` values.
+template <typename scalar_type_>
+class atomic_ref {
+    static_assert(std::is_trivially_copyable_v<scalar_type_>,
+                  "atomic_ref requires a trivially copyable type");
+    scalar_type_ &ref_;
+
+  public:
+    static constexpr std::size_t required_alignment = alignof(scalar_type_);
+    explicit atomic_ref(scalar_type_ &ref) noexcept : ref_(ref) {}
+    atomic_ref(atomic_ref const &) noexcept = default;
+    scalar_type_ load(std::memory_order order = std::memory_order_seq_cst) const noexcept {
+        return __atomic_load_n(&ref_, static_cast<int>(order));
+    }
+    void store(scalar_type_ arg, std::memory_order order = std::memory_order_seq_cst) noexcept {
+        __atomic_store_n(&ref_, arg, static_cast<int>(order));
+    }
