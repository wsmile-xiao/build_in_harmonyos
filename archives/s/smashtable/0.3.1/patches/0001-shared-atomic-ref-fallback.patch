+    // the observed value differs from `expected`. No sleeping semantics, but the
+    // library only uses waiting for readiness, so progress is what matters.
+    void wait(scalar_type_ expected, std::memory_order order = std::memory_order_seq_cst) const noexcept {
+        while (__atomic_load_n(&ref_, static_cast<int>(order)) == expected) std::this_thread::yield();
+    }
+    void notify_all() const noexcept {}
+    scalar_type_ fetch_add(scalar_type_ arg, std::memory_order order = std::memory_order_seq_cst) noexcept {
+        return __atomic_fetch_add(&ref_, arg, static_cast<int>(order));
+    }
+    scalar_type_ fetch_sub(scalar_type_ arg, std::memory_order order = std::memory_order_seq_cst) noexcept {
+        return __atomic_fetch_sub(&ref_, arg, static_cast<int>(order));
+    }
+    scalar_type_ fetch_or(scalar_type_ arg, std::memory_order order = std::memory_order_seq_cst) noexcept {
+        return __atomic_fetch_or(&ref_, arg, static_cast<int>(order));
+    }
+    scalar_type_ fetch_xor(scalar_type_ arg, std::memory_order order = std::memory_order_seq_cst) noexcept {
+        return __atomic_fetch_xor(&ref_, arg, static_cast<int>(order));
+    }
