  *  Formats straight into @p stream rather than into a @c std::string, so there is no allocation and
  *  no buffer to size: a long @c what() prints whole instead of being truncated to fit.
  */
+#if defined(SMASHTABLE_HAS_STD_FORMAT)
 template <typename... args_types_>
 inline void print_line(std::FILE *stream, std::format_string<args_types_...> pattern, args_types_ &&...args) noexcept {
     std::format_to(file_output_iterator_t {stream}, pattern, std::forward<args_types_>(args)...);
     std::fputc('\n', stream);
 }
+#else
+// Minimal replacement for standard libraries whose `<format>` is unimplemented
+// (e.g. libc++ before v16). Supports the `{}` and `{:.2f}` substitutions used
+// by the runner status lines - the same patterns `std::format` would accept -
+// streamed through `std::ostringstream`.
+template <std::size_t index_, typename tuple_type_>
+inline void stream_formatted_arg(std::FILE *stream, tuple_type_ &args_tuple, std::string_view spec) noexcept {
+    std::ostringstream buffer;
+    if (spec == ".2f") buffer << std::fixed << std::setprecision(2);
+    buffer << std::get<index_>(args_tuple);
+    std::fputs(buffer.str().c_str(), stream);
+}
+
+template <typename tuple_type_, std::size_t... indices_>
+inline void stream_formatted_arg_at(std::FILE *stream, tuple_type_ &args_tuple, std::size_t index,
+                                    std::string_view spec, std::index_sequence<indices_...>) noexcept {
+    ((index == indices_ && (stream_formatted_arg<indices_>(stream, args_tuple, spec), true)) || ...);
+}
+
+template <typename... args_types_>
+inline void print_line(std::FILE *stream, std::string_view pattern, args_types_ &&...args) noexcept {
+    auto args_tuple = std::forward_as_tuple(std::forward<args_types_>(args)...);
+    std::size_t arg_index = 0;
+    std::size_t cursor = 0;
+    while (cursor < pattern.size()) {
+        char character = pattern[cursor++];
+        if (character != '{') {
+            std::fputc(character, stream);
+            continue;
+        }
+        std::size_t close = pattern.find('}', cursor);
+        if (close == std::string_view::npos || arg_index >= sizeof...(args_types_)) {
+            std::fputc(character, stream);
+            continue;
+        }
+        stream_formatted_arg_at(stream, args_tuple, arg_index, pattern.substr(cursor, close - cursor),
+                                std::make_index_sequence<sizeof...(args_types_)>{});
+        arg_index++;
+        cursor = close + 1;
+    }
+    std::fputc('\n', stream);
+}
+#endif
 
 #pragma endregion Formatted Output
 
