--- slowhttptest-1.9.0/configure.orig	2022-07-10 10:57:00.000000000 +0000
+++ slowhttptest-1.9.0/configure	2026-06-11 12:25:00.000000000 +0000
@@ -7288,7 +7288,7 @@
 # Create a (secure) tmp directory for tmp files.

 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`mktemp -d "$TMPDIR/confXXXXXX" 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
+  tmp=$TMPDIR/conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  mkdir -p "$tmp"
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp

说明：
- 修改临时目录创建逻辑，使用 $TMPDIR 替代硬编码的 ./confXXXXXX
- 移除 umask 077 限制，因为 HMDFS 文件系统不支持在 umask 077 创建的子目录中写入文件
- 此补丁需要在 configure 运行后，对生成的 config.status 进行同样的修改

实际操作步骤：
1. 设置环境变量：export TMPDIR=$HOME/tmp
2. 运行 configure（会失败）
3. 修改生成的 config.status 第 581 行（与上述修改相同）
4. 重新运行 ./config.status
5. 继续 make 流程