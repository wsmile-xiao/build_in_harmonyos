+macro(CheckNativeWindow)
+  if(SDL_NATIVEWINDOW)
+    if(NOT SDL_OPENGLES OR NOT HAVE_OPENGL_EGL OR NOT HAVE_OPENGLES_V2)
+      message(FATAL_ERROR "SDL_NATIVEWINDOW requires EGL and OpenGL ES 2")
+    endif()
+    cmake_push_check_state(RESET)
+    set(CMAKE_REQUIRED_LIBRARIES native_window EGL GLESv2)
+    check_c_source_compiles("
+        #include <stdint.h>
+        #include <native_window/external_window.h>
+        #include <EGL/egl.h>
+        #include <GLES2/gl2.h>
+        int main(void) {
+          OHNativeWindow *window = 0;
+          EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+          EGLSurface surface;
+          unsigned char pixel[4] = { 0, 0, 0, 0 };
+          int height = 0;
+          int width = 0;
+          OH_NativeWindow_CreateNativeWindowFromSurfaceId(1, &window);
+          OH_NativeWindow_NativeWindowHandleOpt(window, SET_BUFFER_GEOMETRY,
+                                                1, 1);
+          OH_NativeWindow_NativeWindowHandleOpt(window, GET_BUFFER_GEOMETRY,
+                                                &height, &width);
+          surface = eglCreateWindowSurface(display, (EGLConfig)0,
+                                           (EGLNativeWindowType)window, 0);
+          eglMakeCurrent(display, surface, surface, EGL_NO_CONTEXT);
+          glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, pixel);
+          eglSwapBuffers(display, surface);
+          OH_NativeWindow_DestroyNativeWindow(window);
+          return pixel[0] + width + height;
+        }" HAVE_NATIVEWINDOW_EGL_GLES2)
+    cmake_pop_check_state()
+    if(NOT HAVE_NATIVEWINDOW_EGL_GLES2)
+      message(FATAL_ERROR "SDL_NATIVEWINDOW requires NativeWindow, EGL, and GLES2")
+    endif()
+    set(SDL_VIDEO_DRIVER_NATIVEWINDOW 1)
+    file(GLOB NATIVEWINDOW_SOURCES
+         ${SDL2_SOURCE_DIR}/src/video/nativewindow/*.c)
+    list(APPEND SOURCE_FILES ${NATIVEWINDOW_SOURCES})
+    list(APPEND EXTRA_LIBS native_window EGL GLESv2)
+    set(HAVE_NATIVEWINDOW TRUE)
+    set(HAVE_SDL_VIDEO TRUE)
   endif()
 endmacro()

