+macro(CheckOHAudio)
+  if(SDL_OHAUDIO)
+    cmake_push_check_state(RESET)
+    set(CMAKE_REQUIRED_LIBRARIES ohaudio)
+    check_c_source_compiles("
+        #include <stdint.h>
+        #include <time.h>
+        #include <ohaudio/native_audiostream_base.h>
+        #include <ohaudio/native_audiostreambuilder.h>
+        #include <ohaudio/native_audiorenderer.h>
+        static OH_AudioData_Callback_Result write_data(
+            OH_AudioRenderer *renderer, void *userdata, void *buffer,
+            int32_t size) {
+          (void)renderer; (void)userdata; (void)buffer; (void)size;
+          return AUDIO_DATA_CALLBACK_RESULT_VALID;
+        }
+        int main(void) {
+          OH_AudioStreamBuilder *builder = 0;
+          OH_AudioRenderer *renderer = 0;
+          int64_t frames = 0;
+          int64_t timestamp = 0;
+          OH_AudioStreamBuilder_Create(&builder, AUDIOSTREAM_TYPE_RENDERER);
+          OH_AudioStreamBuilder_SetSamplingRate(builder, 48000);
+          OH_AudioStreamBuilder_SetChannelCount(builder, 2);
+          OH_AudioStreamBuilder_SetSampleFormat(builder, AUDIOSTREAM_SAMPLE_S16LE);
+          OH_AudioStreamBuilder_SetEncodingType(builder, AUDIOSTREAM_ENCODING_TYPE_RAW);
+          OH_AudioStreamBuilder_SetLatencyMode(builder, AUDIOSTREAM_LATENCY_MODE_NORMAL);
+          OH_AudioStreamBuilder_SetRendererInfo(builder, AUDIOSTREAM_USAGE_MUSIC);
+          OH_AudioStreamBuilder_SetFrameSizeInCallback(builder, 512);
+          OH_AudioStreamBuilder_SetRendererWriteDataCallback(builder, write_data, 0);
+          OH_AudioStreamBuilder_GenerateRenderer(builder, &renderer);
+          OH_AudioRenderer_Start(renderer);
+          OH_AudioRenderer_GetFramesWritten(renderer, &frames);
+          OH_AudioRenderer_GetAudioTimestampInfo(renderer, &frames, &timestamp);
+          OH_AudioRenderer_Stop(renderer);
+          OH_AudioRenderer_Release(renderer);
+          return (int)OH_AudioStreamBuilder_Destroy(builder);
+        }" HAVE_OHAUDIO_NATIVE_OUTPUT)
+    cmake_pop_check_state()
+    if(NOT HAVE_OHAUDIO_NATIVE_OUTPUT)
+      message(FATAL_ERROR "SDL_OHAUDIO requires the complete OHAudio renderer API")
+    endif()
+    set(SDL_AUDIO_DRIVER_OHAUDIO 1)
+    file(GLOB OHAUDIO_SOURCES ${SDL2_SOURCE_DIR}/src/audio/ohaudio/*.c)
+    list(APPEND SOURCE_FILES ${OHAUDIO_SOURCES})
+    list(APPEND EXTRA_LIBS ohaudio)
+    set(HAVE_OHAUDIO TRUE)
+    set(HAVE_SDL_AUDIO TRUE)
+  endif()
+endmacro()
