--- a/ia.log
+++ b/ia.log
@@ -137,21 +137,21 @@
   fi
 
   if [ "${ia_logfile:=}" = "" ]; then
     if [ "${ia_log_fd:=}" = "" ]; then
       ia_logfile=/dev/null
     else
       :
       # if ia_logfile is not set but ia_log_fd is set, then only use ia_log_fd
       # this may happen, if we are called from ia_ssh or ia_file, to locally log remote output
     fi
-  elif ! touch "$ia_logfile" >/dev/null 2>&1; then
+  elif [ "$ia_logfile" != "/dev/null" ] && ! touch "$ia_logfile" >/dev/null 2>&1; then
     ia_err "WARNING: $ia_logfile is not writeable, ia_logfile is set to /dev/null now."
     ia_logfile=/dev/null
   else
     ia_logfile="$(realpath "$ia_logfile")" # needed, if path is relative and we change dir
   fi
   if [ -s "$ia_old_logfile" ] && ! [ "$ia_old_logfile" = "$ia_logfile" ] \
     && ! [ "$ia_logfile" = "/dev/null" ] \
     && ! [ "$ia_logfile" = "" ]; then
     cat "$ia_old_logfile" >> "$ia_logfile"
     rm -f "$ia_old_logfile" >/dev/null 2>&1
