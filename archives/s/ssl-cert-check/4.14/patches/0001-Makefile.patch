diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,15 +1,19 @@
 # Makefile for ssl-cert-check (pure script tool)
 # No compilation needed, just install
 # Modified for HongMeng compatibility (use mkdir -p instead of install -d)
 
 PREFIX ?= /usr/local
+DESTDIR ?=
+
+# Default target (nothing to build for pure script)
+all:
 
 install:
 	mkdir -p $(DESTDIR)$(PREFIX)/bin
 	mkdir -p $(DESTDIR)$(PREFIX)/share/doc/ssl-cert-check
 	mkdir -p $(DESTDIR)$(PREFIX)/share/licenses/ssl-cert-check
 	install -m 755 ssl-cert-check $(DESTDIR)$(PREFIX)/bin/ssl-cert-check
 	install -m 644 README.md $(DESTDIR)$(PREFIX)/share/doc/ssl-cert-check/README.md
 	install -m 644 LICENSE $(DESTDIR)$(PREFIX)/share/licenses/ssl-cert-check/LICENSE
 
-.PHONY: install
+.PHONY: all install
