+#ifndef _WIN32
+/* Some filesystems cannot host path-based unix sockets (e.g. HarmonyOS
+   hmdfs-backed home directories fail bind() with EPERM, and /tmp may be a
+   read-only mount).  Probe the working directory and fall back to an
+   abstract socket, which does not involve the filesystem at all. */
+static const char *unix_socket_address(void)
+{
+    static const char path[] = "test-listen.unix";
+    static const char abstract[] = "@test-listen.unix";
+    struct sockaddr_un addr;
+    char probe[] = "test-listen-probe.sock";
+    int sock;
+
+    sock = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (sock < 0) {
+        return abstract;
+    }
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    strcpy(addr.sun_path, probe);
+    unlink(probe);
+    if (bind(sock, (struct sockaddr *) &addr, sizeof(addr)) < 0) {
+        close(sock);
+        return abstract;
+    }
+    close(sock);
+    unlink(probe);
+    return path;
+}
+#endif
+
