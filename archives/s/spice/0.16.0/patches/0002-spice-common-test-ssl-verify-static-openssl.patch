--- a/subprojects/spice-common/tests/meson.build
+++ b/subprojects/spice-common/tests/meson.build
@@ -11,8 +11,18 @@
 
 foreach t : tests
   name = t.underscorify()
+  extra_args = []
+  if t == 'test-ssl-verify'
+    # test-ssl-verify.c intentionally overrides X509_NAME_add_entry_by_txt
+    # (OpenSSL symbol interposition): with a shared libcrypto the executable
+    # definition wins, but with a static libcrypto.a the archive member for
+    # the other X509 functions collides with it.  Let the first definition
+    # (the test binary's) win, keeping the shared-library semantics.
+    extra_args = ['-Wl,--allow-multiple-definition']
+  endif
   exe = executable(name, '@0@.c'.format(t),
                    dependencies : tests_deps,
+                   link_args : extra_args,
                    install : false)
   test(name, exe)
 endforeach
