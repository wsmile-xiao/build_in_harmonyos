--- a/lib/socket/wscript
+++ b/lib/socket/wscript
@@ -1,7 +1,23 @@
 #!/usr/bin/env python
 
 def configure(conf):
     conf.CHECK_HEADERS('linux/sockios.h linux/ethtool.h')
     if (conf.CONFIG_SET('HAVE_LINUX_SOCKIOS_H') and \
                     conf.CONFIG_SET('HAVE_LINUX_ETHTOOL_H')):
         conf.DEFINE('HAVE_ETHTOOL', 1)
+        # 符号级链接探测：glibc 提供 ethtool_cmd_speed() 辅助函数，
+        # 部分 libc（如 OHOS musl）不提供。真实链接结果定义
+        # HAVE_ETHTOOL_CMD_SPEED，interfaces.c 据此分支——不依赖平台宏。
+        conf.CHECK_CODE('''
+                        #include "linux/sockios.h"
+                        #include "linux/ethtool.h"
+                        int main(void) {
+                            struct ethtool_cmd ecmd;
+                            ethtool_cmd_speed(&ecmd);
+                            return 0;
+                        }
+                        ''',
+                        define='HAVE_ETHTOOL_CMD_SPEED',
+                        msg='Checking for ethtool_cmd_speed',
+                        add_headers=False,
+                        mandatory=False)
