+# OHOS adaptation: no libacl in the sysroot (acl/libacl.h and sys/acl.h
+# both absent; --without-acl-support). test_vfs_posixacl.c needs the acl
+# types via #include "vfs_posixacl.c"; those only exist when filesys.h
+# picks up <acl/libacl.h> or <sys/acl.h>. Build the test only in that
+# case. No selftest suite runs this binary, and the vfs_posixacl module
+# itself is not built without acl support either.
+# Gate on the same config facts filesys.h uses for the acl includes.
+if bld.CONFIG_SET('HAVE_SYS_ACL_H') or bld.CONFIG_SET('HAVE_ACL_LIBACL_H'):
+    bld.SAMBA3_BINARY('test_vfs_posixacl',
+                      source='test_vfs_posixacl.c',
+                      deps='smbd_base cmocka',
+                      for_selftest=True)
 
