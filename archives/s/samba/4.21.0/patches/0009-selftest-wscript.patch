+    # OHOS adaptation: wrapper .so paths are only defined by configure
+    # when the matching wrapper check runs (pam/pam_matrix are skipped
+    # with --without-pam, e.g. when the sysroot has no PAM headers).
+    # Skip the selftest.pl options whose path is unset instead of
+    # crashing on str + NoneType; suites that need the skipped wrappers
+    # are reported as environment-limited in the test report.
+    for _wrapper_opt, _wrapper_var in (
+            ('--nss_wrapper_so_path', 'LIBNSS_WRAPPER_SO_PATH'),
+            ('--resolv_wrapper_so_path', 'LIBRESOLV_WRAPPER_SO_PATH'),
+            ('--uid_wrapper_so_path', 'LIBUID_WRAPPER_SO_PATH'),
+            ('--pam_wrapper_so_path', 'LIBPAM_WRAPPER_SO_PATH'),
+            ('--pam_matrix_so_path', 'PAM_MATRIX_SO_PATH'),
+    ):
+        _wrapper_so_path = CONFIG_GET(opt, _wrapper_var)
+        if _wrapper_so_path:
+            env.OPTIONS += " " + _wrapper_opt + "=" + _wrapper_so_path
 
     # selftest can optionally use kernel namespaces instead of socket-wrapper
     if os.environ.get('USE_NAMESPACES') is None:
-        env.OPTIONS += " --socket_wrapper_so_path=" + CONFIG_GET(opt, 'LIBSOCKET_WRAPPER_SO_PATH')
