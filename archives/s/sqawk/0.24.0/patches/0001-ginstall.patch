From: OpenHarmony Compiler <ohc@openharmony.net>
Subject: Use ginstall instead of install for HarmonyOS compatibility

On HarmonyOS, the `install` command is not available by default,
but `ginstall` (from GNU coreutils) is available. This patch
replaces the `install` command reference with `ginstall`.

diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -10,7 +10,7 @@
 man1dir     = $(mandir)/man1
 
-INSTALL         = install
+INSTALL         = ginstall
 INSTALL_PROGRAM = $(INSTALL)
 INSTALL_DATA    = $(INSTALL) -m 644
 
