+    /// Portable stand-in for get_current_dir_name(), which is a GNU extension
+    /// rather than POSIX and is therefore not declared by every libc.
+    /// Grows a getcwd() buffer until it is large enough.
+    static inline std::string current_dir_name() {
+        std::vector<char> buffer(4096);
+        while (getcwd(buffer.data(), buffer.size()) == nullptr) {
+            if (errno != ERANGE || buffer.size() >= (1u << 20)) {
+                return std::string();
+            }
+            buffer.resize(buffer.size() * 2);
+        }
+        return std::string(buffer.data());
+    }
+
 } // namespace temp_file
