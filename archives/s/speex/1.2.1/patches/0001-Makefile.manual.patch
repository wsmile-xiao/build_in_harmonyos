diff -ruN a/Makefile.manual b/Makefile.manual
--- a/Makefile.manual
+++ b/Makefile.manual
@@ -0,0 +1,56 @@
+CC = clang
+CFLAGS = -fPIC -O2 -DHAVE_CONFIG_H -I. -Iinclude -Iinclude/speex -Ilibspeex \
+         $(shell PKG_CONFIG_PATH=$(PREFIX)/lib/pkgconfig pkg-config --cflags ogg speexdsp 2>/dev/null)
+LDFLAGS = -L$(PREFIX)/lib
+LDLIBS = -lspeexdsp -logg -lm
+AR = llvm-ar
+RANLIB = llvm-ranlib
+
+LIBSPEEX_SOURCES = libspeex/cb_search.c libspeex/exc_10_32_table.c libspeex/exc_8_128_table.c \
+          libspeex/filters.c libspeex/gain_table.c libspeex/hexc_table.c libspeex/high_lsp_tables.c \
+          libspeex/lsp.c libspeex/ltp.c libspeex/speex.c libspeex/stereo.c libspeex/vbr.c \
+          libspeex/vq.c libspeex/bits.c libspeex/exc_10_16_table.c libspeex/exc_20_32_table.c \
+          libspeex/exc_5_256_table.c libspeex/exc_5_64_table.c libspeex/gain_table_lbr.c \
+          libspeex/hexc_10_32_table.c libspeex/lpc.c libspeex/lsp_tables_nb.c libspeex/modes.c \
+          libspeex/modes_wb.c libspeex/nb_celp.c libspeex/quant_lsp.c libspeex/sb_celp.c \
+          libspeex/speex_callbacks.c libspeex/speex_header.c libspeex/window.c
+
+LIBSPEEX_OBJECTS = $(LIBSPEEX_SOURCES:.c=.o)
+
+all: config.h libspeex.a libspeex.so speexenc speexdec
+
+config.h: config.h.in
+	cp config.h.in config.h
+
+libspeex.a: $(LIBSPEEX_OBJECTS)
+	$(AR) rcs $@ $^
+	$(RANLIB) $@
+
+libspeex.so: $(LIBSPEEX_OBJECTS)
+	$(CC) -shared -o $@ $^ $(LDFLAGS) -lm
+
+speexenc: src/speexenc.o src/wav_io.o src/skeleton.o libspeex.a
+	$(CC) -o $@ $^ $(LDFLAGS) $(LDLIBS)
+
+speexdec: src/speexdec.o src/wav_io.o libspeex.a
+	$(CC) -o $@ $^ $(LDFLAGS) $(LDLIBS)
+
+%.o: %.c config.h
+	$(CC) $(CFLAGS) -c -o $@ $<
+
+clean:
+	rm -f $(LIBSPEEX_OBJECTS) src/speexenc.o src/speexdec.o src/wav_io.o src/skeleton.o
+	rm -f libspeex.a libspeex.so speexenc speexdec config.h
+
+install: all
+	mkdir -p $(DESTDIR)$(PREFIX)/lib $(DESTDIR)$(PREFIX)/lib/pkgconfig
+	mkdir -p $(DESTDIR)$(PREFIX)/include/speex
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	mkdir -p $(DESTDIR)$(PREFIX)/share/man/man1
+	cp libspeex.a libspeex.so $(DESTDIR)$(PREFIX)/lib/
+	cp include/speex/speex.h include/speex/speex_bits.h include/speex/speex_callbacks.h \
+	   include/speex/speex_header.h include/speex/speex_stereo.h include/speex/speex_types.h \
+	   include/speex/speex_config_types.h $(DESTDIR)$(PREFIX)/include/speex/
+	cp speexenc speexdec $(DESTDIR)$(PREFIX)/bin/
+
+.PHONY: all clean install
