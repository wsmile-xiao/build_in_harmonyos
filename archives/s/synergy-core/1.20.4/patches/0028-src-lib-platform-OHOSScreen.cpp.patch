+
+bool OHOSScreen::clipboardFingerprint(
+    bool hasText, const String &text, bool hasHtml, const String &html,
+    bool hasBitmap, const String &bitmap, ClipboardFingerprint &fingerprint
+) const
+{
+  const std::array<const std::uint8_t *, 3> data{
+      hasText ? reinterpret_cast<const std::uint8_t *>(text.data()) : nullptr,
+      hasHtml ? reinterpret_cast<const std::uint8_t *>(html.data()) : nullptr,
+      hasBitmap ? reinterpret_cast<const std::uint8_t *>(bitmap.data()) : nullptr,
+  };
+  const std::array<std::size_t, 3> lengths{
+      hasText ? text.size() : 0,
+      hasHtml ? html.size() : 0,
+      hasBitmap ? bitmap.size() : 0,
+  };
+  const std::array<bool, 3> present{hasText, hasHtml, hasBitmap};
+  std::vector<std::uint8_t> bytes;
+  try {
+    if (!deskflow::platform::canonicalClipboardBytes(data, lengths, present, bytes)) {
+      return false;
+    }
+  } catch (const std::bad_alloc &) {
+    return false;
+  }
+  return SHA256(bytes.data(), bytes.size(), fingerprint.data()) != nullptr;
+}
+
+OHOSScreen::ClipboardSnapshot OHOSScreen::readClipboardSnapshot() const
+{
+  ClipboardSnapshot snapshot;
+  const std::uint32_t beforeCount = m_native.m_pasteboardChangeCount(m_pasteboard);
+  const bool hasData = m_native.m_pasteboardHasData(m_pasteboard);
+  int status = 0;
+  OH_UdmfData *data = m_native.m_pasteboardGetData(m_pasteboard, &status);
+  const std::uint32_t afterCount = m_native.m_pasteboardChangeCount(m_pasteboard);
+  snapshot.m_changeCount = afterCount;
+  snapshot.m_hasData = hasData;
+  snapshot.m_getDataWasNull = data == nullptr;
+
+  if (beforeCount != afterCount) {
+    if (data != nullptr) {
+      OH_UdmfData_Destroy(data);
+    }
+    return snapshot;
+  }
+  if (!hasData) {
+    if (data != nullptr) {
+      OH_UdmfData_Destroy(data);
+      return snapshot;
+    }
+    String empty;
+    snapshot.m_readable = clipboardFingerprint(
+        false, empty, false, empty, false, empty, snapshot.m_fingerprint
+    );
+    return snapshot;
+  }
+  if (status != 0 || data == nullptr) {
+    if (data != nullptr) {
+      OH_UdmfData_Destroy(data);
+    }
+    return snapshot;
+  }
+
+  bool hasText = false;
+  bool hasHtml = false;
+  bool hasBitmap = false;
+  String text;
+  String html;
+  String bitmap;
+  const bool payloadReadable = readUdmfPayload(
+      data, hasText, text, hasHtml, html, hasBitmap, bitmap
+  );
+  OH_UdmfData_Destroy(data);
+  if (!payloadReadable) {
+    return snapshot;
+  }
+  snapshot.m_readable = clipboardFingerprint(
+      hasText, text, hasHtml, html, hasBitmap, bitmap, snapshot.m_fingerprint
+  );
+  return snapshot;
+}
+
+void OHOSScreen::processClipboardChange(bool localChange)
+{
+  const ClipboardSnapshot snapshot = readClipboardSnapshot();
+  deskflow::platform::ClipboardObservation observation;
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    observation = m_clipboardWriteTracker.observe(
+        snapshot, localChange, m_native.m_monotonicMicroseconds()
+    );
+  }
+  if (observation == deskflow::platform::ClipboardObservation::kNotifyExternal) {
+    sendClipboardEvent(kClipboardClipboard);
+    sendClipboardEvent(kClipboardSelection);
+  }
+}
+
+bool OHOSScreen::waitForClipboardCallback(std::uint64_t generation, std::int64_t deadline)
+{
+  std::unique_lock<std::mutex> lock(m_clipboardCallbackMutex);
+  for (;;) {
+    if (m_observedClipboardGeneration == generation &&
+        m_observedClipboardCallbackCount != 0) {
+      return true;
+    }
+    if (m_activeClipboardGeneration != generation) {
+      return false;
+    }
+    const std::int64_t now = m_native.m_monotonicMicroseconds();
+    if (now >= deadline) {
+      return false;
+    }
+    m_clipboardCondition.wait_for(
+        lock, std::chrono::microseconds(std::min<std::int64_t>(deadline - now, 50'000))
+    );
+  }
+}
+
+void OHOSScreen::setClipboardCallbackGeneration(std::uint64_t generation)
+{
+  {
+    std::lock_guard<std::mutex> lock(m_clipboardCallbackMutex);
+    m_activeClipboardGeneration = generation;
+    m_observedClipboardGeneration = generation;
+    m_observedClipboardCallbackCount = 0;
+  }
+  m_clipboardCondition.notify_all();
+}
+
+std::uint32_t OHOSScreen::takeClipboardCallbackCount(std::uint64_t generation)
+{
+  std::lock_guard<std::mutex> lock(m_clipboardCallbackMutex);
+  if (m_observedClipboardGeneration != generation) {
+    return 0;
+  }
+  const std::uint32_t count = m_observedClipboardCallbackCount;
+  m_observedClipboardCallbackCount = 0;
+  return count;
+}
+
+void OHOSScreen::clearPendingClipboardWrite()
+{
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    m_clipboardWriteTracker.clear();
+  }
+  setClipboardCallbackGeneration(0);
+}
