+OHOSScreen *OHOSScreen::acquireInstance()
+{
+  std::lock_guard<std::mutex> lock(s_instanceMutex);
+  if (s_instance != nullptr) {
+    ++s_instance->m_callbackCount;
+  }
+  return s_instance;
+}
+
+void OHOSScreen::releaseInstance(OHOSScreen *instance)
+{
+  if (instance != nullptr) {
+    std::lock_guard<std::mutex> lock(instance->m_callbackMutex);
+    if (--instance->m_callbackCount == 0) {
+      instance->m_callbackCondition.notify_all();
+    }
+  }
+}
