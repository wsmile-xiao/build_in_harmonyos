+bool OHOSScreen::snapshotNativeEventGeneration(std::uint64_t &generation) const noexcept
+{
+  generation = m_nativeEventGeneration.load(std::memory_order_acquire);
+  return m_acceptNativeEvents.load(std::memory_order_acquire);
+}
+
+void OHOSScreen::enqueueNativeEvent(NativeEventData *data) noexcept
+{
+  if (data == nullptr) {
+    return;
+  }
+  if (!m_acceptNativeEvents.load(std::memory_order_acquire) ||
+      data->m_generation != m_nativeEventGeneration.load(std::memory_order_acquire) ||
+      !m_nativeEventHandlerRegistered || m_nativeEventType == Event::kUnknown) {
+    delete data;
+    return;
+  }
+
+  try {
+    m_events->addEvent(Event(m_nativeEventType, getEventTarget(), data));
+  } catch (...) {
+    delete data;
+    LOG((CLOG_ERR "failed to queue OpenHarmony native event"));
+  }
+}
+
+void OHOSScreen::queueHotkeyCleanup(UInt32 id, std::uint64_t epoch) noexcept
+{
+  if (!m_nativeEventHandlerRegistered || m_nativeEventType == Event::kUnknown) {
+    m_hotkeyCleanupPending.store(true, std::memory_order_release);
+    return;
+  }
+  auto *data = new (std::nothrow) NativeEventData;
+  if (data == nullptr) {
+    m_hotkeyCleanupPending.store(true, std::memory_order_release);
+    return;
+  }
+  data->m_kind = NativeEventKind::kHotkeyCleanup;
+  data->m_generation = m_nativeEventGeneration.load(std::memory_order_acquire);
+  data->m_id = id;
+  data->m_epoch = epoch;
+  try {
+    m_events->addEvent(Event(m_nativeEventType, getEventTarget(), data));
+  } catch (...) {
+    delete data;
+    m_hotkeyCleanupPending.store(true, std::memory_order_release);
+  }
+}
+
+void OHOSScreen::handleNativeEvent(const Event &event, void *)
+{
+  if (m_hotkeyCleanupPending.exchange(false, std::memory_order_acq_rel)) {
+    drainHotkeyCleanup();
+  }
+  auto *data = static_cast<NativeEventData *>(event.getDataObject());
+  if (data == nullptr) {
+    return;
+  }
+  if (data->m_kind == NativeEventKind::kHotkeyCleanup) {
+    cleanupHotkey(static_cast<UInt32>(data->m_id), data->m_epoch);
+    return;
+  }
+  if (!m_acceptNativeEvents.load(std::memory_order_acquire) ||
+      data->m_generation != m_nativeEventGeneration.load(std::memory_order_acquire)) {
+    return;
+  }
+
+  switch (data->m_kind) {
+  case NativeEventKind::kKey:
+    if (!data->m_injectedEcho) {
+      onKeyEvent(data->m_code, data->m_action);
+    }
+    break;
+  case NativeEventKind::kMouse:
+    if (data->m_injectedEcho) {
+      if (data->m_action == MOUSE_ACTION_MOVE) {
+        std::lock_guard<std::mutex> lock(m_stateMutex);
+        if (m_warpPending && data->m_x == m_cursorX && data->m_y == m_cursorY) {
+          m_warpPending = false;
+          m_warpPendingExpiresAt = 0;
+        }
+      }
+    } else {
+      onMouseEvent(data->m_action, data->m_code, data->m_x, data->m_y);
+    }
+    break;
+  case NativeEventKind::kAxis:
+    if (!data->m_injectedEcho) {
+      onAxisEvent(
+          static_cast<InputEvent_AxisAction>(data->m_action), data->m_horizontal, data->m_vertical
+      );
+    }
+    break;
+  case NativeEventKind::kHotkey:
+    onHotkey(static_cast<UInt32>(data->m_id), data->m_epoch);
+    break;
+  case NativeEventKind::kHotkeyCleanup:
+    break;
+  case NativeEventKind::kPasteboard:
+    onClipboardChanged(static_cast<Pasteboard_NotifyType>(data->m_code));
+    break;
+  case NativeEventKind::kDisplay:
+    onDisplayChanged(data->m_id);
+    break;
+  }
+}
