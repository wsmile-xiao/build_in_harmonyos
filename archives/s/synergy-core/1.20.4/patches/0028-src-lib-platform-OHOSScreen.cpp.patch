+
+void OHOSScreen::pasteboardCallback(void *context, Pasteboard_NotifyType type)
+{
+  auto *instance = acquireInstance();
+  std::uint64_t generation = 0;
+  if (instance != nullptr && instance == context &&
+      instance->snapshotNativeEventGeneration(generation)) {
+    if (type == NOTIFY_LOCAL_DATA_CHANGE) {
+      {
+        std::lock_guard<std::mutex> lock(instance->m_clipboardCallbackMutex);
+        const std::uint64_t clipboardGeneration = instance->m_activeClipboardGeneration;
+        if (clipboardGeneration != 0) {
+          if (instance->m_observedClipboardGeneration != clipboardGeneration) {
+            instance->m_observedClipboardGeneration = clipboardGeneration;
+            instance->m_observedClipboardCallbackCount = 0;
+          }
+          if (instance->m_observedClipboardCallbackCount !=
+              std::numeric_limits<std::uint32_t>::max()) {
+            ++instance->m_observedClipboardCallbackCount;
+          }
+        }
+      }
+      instance->m_clipboardCondition.notify_all();
+    }
+    auto *data = new (std::nothrow) NativeEventData;
+    if (data != nullptr) {
+      data->m_kind = NativeEventKind::kPasteboard;
+      data->m_generation = generation;
+      data->m_code = static_cast<std::int32_t>(type);
+      instance->enqueueNativeEvent(data);
+    }
+  }
+  releaseInstance(instance);
+}
+
+bool OHOSScreen::refreshShape(bool notify)
+{
+  uint64_t defaultDisplayId = 0;
+  if (OH_NativeDisplayManager_GetDefaultDisplayId(&defaultDisplayId) != DISPLAY_MANAGER_OK) {
+    LOG((CLOG_ERR "failed to obtain OpenHarmony default display ID"));
+    return false;
+  }
+
+  NativeDisplayManager_DisplaysInfo *displays = nullptr;
+  const auto createResult = OH_NativeDisplayManager_CreateAllDisplays(&displays);
+  deskflow::platform::NativeResourceOwner<
+      NativeDisplayManager_DisplaysInfo,
+      decltype(&OH_NativeDisplayManager_DestroyAllDisplays)>
+      displaysOwner(displays, &OH_NativeDisplayManager_DestroyAllDisplays);
+  if (createResult != DISPLAY_MANAGER_OK || displaysOwner.get() == nullptr) {
+    LOG((CLOG_ERR "failed to enumerate OpenHarmony displays"));
+    return false;
+  }
+
+  int64_t left = std::numeric_limits<int64_t>::max();
+  int64_t top = std::numeric_limits<int64_t>::max();
+  int64_t right = std::numeric_limits<int64_t>::min();
+  int64_t bottom = std::numeric_limits<int64_t>::min();
+  bool found = false;
+  bool foundDefault = false;
+  int32_t defaultX = 0;
+  int32_t defaultY = 0;
+  int32_t defaultWidth = 0;
+  int32_t defaultHeight = 0;
+  for (uint32_t i = 0; i < displays->displaysLength; ++i) {
+    const auto &display = displays->displaysInfo[i];
+    if (!display.isAlive || display.width <= 0 || display.height <= 0) {
+      continue;
+    }
+    int32_t x = 0;
+    int32_t y = 0;
+    if (OH_NativeDisplayManager_GetDisplayPosition(display.id, &x, &y) != DISPLAY_MANAGER_OK) {
+      LOG((CLOG_ERR "failed to obtain position for OpenHarmony display %u", display.id));
+      return false;
+    }
+    left = std::min(left, static_cast<int64_t>(x));
+    top = std::min(top, static_cast<int64_t>(y));
+    right = std::max(right, static_cast<int64_t>(x) + display.width);
+    bottom = std::max(bottom, static_cast<int64_t>(y) + display.height);
+    found = true;
+    if (display.id == defaultDisplayId) {
+      defaultX = x;
+      defaultY = y;
+      defaultWidth = display.width;
+      defaultHeight = display.height;
+      foundDefault = true;
+    }
+  }
+  const int64_t defaultRight = static_cast<int64_t>(defaultX) + defaultWidth;
+  const int64_t defaultBottom = static_cast<int64_t>(defaultY) + defaultHeight;
+  if (!found || !foundDefault || right <= left || bottom <= top ||
+      right - left > std::numeric_limits<SInt32>::max() ||
+      bottom - top > std::numeric_limits<SInt32>::max() ||
+      defaultRight > std::numeric_limits<SInt32>::max() ||
+      defaultBottom > std::numeric_limits<SInt32>::max()) {
+    LOG((CLOG_ERR "OpenHarmony returned an invalid display layout"));
+    return false;
+  }
+
+  bool changed = false;
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    const SInt32 newX = static_cast<SInt32>(left);
+    const SInt32 newY = static_cast<SInt32>(top);
+    const SInt32 newWidth = static_cast<SInt32>(right - left);
+    const SInt32 newHeight = static_cast<SInt32>(bottom - top);
+    changed = newX != m_x || newY != m_y || newWidth != m_width || newHeight != m_height ||
+              defaultDisplayId != m_defaultDisplayId || defaultX != m_defaultDisplayX ||
+              defaultY != m_defaultDisplayY || defaultWidth != m_defaultDisplayWidth ||
+              defaultHeight != m_defaultDisplayHeight;
+    m_x = newX;
+    m_y = newY;
+    m_width = newWidth;
+    m_height = newHeight;
+    m_defaultDisplayId = defaultDisplayId;
+    m_defaultDisplayX = defaultX;
+    m_defaultDisplayY = defaultY;
+    m_defaultDisplayWidth = defaultWidth;
+    m_defaultDisplayHeight = defaultHeight;
+  }
+
+  if (notify && changed) {
+    sendEvent(m_events->forIScreen().shapeChanged());
+  }
+  return true;
+}
+
+bool OHOSScreen::requestInjectionAuthorization()
+{
+  if (m_injectionAuthorizationReady.load(std::memory_order_acquire)) {
+    return true;
+  }
+
+  auto &broker = authorizationBroker();
+  std::uint64_t epoch = 0;
+  {
+    std::lock_guard<std::mutex> lock(broker.m_mutex);
+    epoch = m_authorizationEpoch.load(std::memory_order_acquire);
+    if (epoch == 0 || !broker.m_coordinator.waiting(epoch)) {
+      epoch = broker.m_coordinator.begin();
+      broker.m_requestIssued = false;
+      m_authorizationEpoch.store(epoch, std::memory_order_release);
+    }
+  }
+
+  const std::int64_t deadline = deadlineAfter(
+      m_native.m_monotonicMicroseconds(), kAuthorizationTimeoutMicroseconds
+  );
+  for (;;) {
+    if (m_authorizationEpoch.load(std::memory_order_acquire) != epoch) {
+      return false;
+    }
+
+    Input_InjectionStatus status = UNAUTHORIZED;
+    const Input_Result queryResult = m_native.m_queryAuthorization(&status);
+    if (queryResult != INPUT_SUCCESS) {
+      std::lock_guard<std::mutex> lock(broker.m_mutex);
+      broker.m_coordinator.fail(epoch);
+      LOG((CLOG_ERR "failed to query OpenHarmony input injection authorization, result=%d", queryResult));
+      return false;
+    }
+    if (status == AUTHORIZED) {
+      bool published = false;
+      {
+        std::lock_guard<std::mutex> lock(broker.m_mutex);
+        published = broker.m_coordinator.publishReady(epoch);
+      }
+      if (!published) {
+        return false;
+      }
+      m_injectionAuthorizationReady.store(true, std::memory_order_release);
+      return true;
+    }
+    if (status != UNAUTHORIZED && status != AUTHORIZING) {
+      std::lock_guard<std::mutex> lock(broker.m_mutex);
+      broker.m_coordinator.fail(epoch);
+      LOG((CLOG_ERR "unsupported OpenHarmony injection authorization status=%d", status));
+      return false;
+    }
+
+    bool issueRequest = false;
+    {
+      std::lock_guard<std::mutex> lock(broker.m_mutex);
+      if (!broker.m_coordinator.waiting(epoch)) {
+        return false;
+      }
+      if (status == AUTHORIZING) {
+        broker.m_requestIssued = true;
+      } else if (!broker.m_requestIssued) {
+        broker.m_requestIssued = true;
+        issueRequest = true;
+      }
+    }
+    if (issueRequest) {
+      const Input_Result requestResult = m_native.m_requestAuthorization(
+          injectionAuthorizationCallback
+      );
+      if (requestResult != INPUT_SUCCESS && requestResult != INPUT_INJECTION_AUTHORIZING &&
+          requestResult != INPUT_INJECTION_AUTHORIZED) {
+        std::lock_guard<std::mutex> lock(broker.m_mutex);
+        broker.m_coordinator.fail(epoch);
+        LOG((CLOG_ERR "failed to request OpenHarmony input injection authorization, result=%d", requestResult));
+        return false;
+      }
+    }
+
+    const std::int64_t now = m_native.m_monotonicMicroseconds();
+    if (now >= deadline) {
+      std::lock_guard<std::mutex> lock(broker.m_mutex);
+      broker.m_coordinator.fail(epoch);
+      LOG((CLOG_ERR "timed out waiting for OpenHarmony input injection authorization"));
+      return false;
+    }
+    std::unique_lock<std::mutex> lock(broker.m_mutex);
+    const std::uint64_t sequence = broker.m_coordinator.sequence();
+    broker.m_condition.wait_for(lock, kAuthorizationPollInterval, [&broker, sequence, epoch] {
+      return !broker.m_coordinator.waiting(epoch) ||
+             broker.m_coordinator.sequence() != sequence;
+    });
+  }
+}
+
+bool OHOSScreen::injectionAuthorized() const
+{
+  return m_injectionAuthorizationReady.load(std::memory_order_acquire);
+}
+
+bool OHOSScreen::removeInputRegistrations()
+{
+  bool success = true;
+  bool registered = false;
+  {
+    std::lock_guard<std::mutex> lock(m_inputModeMutex);
+    registered = m_axisMonitorRegistered;
+  }
+  if (registered) {
+    const Input_Result result = OH_Input_RemoveAxisEventMonitor(AXIS_EVENT_TYPE_SCROLL, axisEventCallback);
+    if (result == INPUT_SUCCESS) {
+      std::lock_guard<std::mutex> lock(m_inputModeMutex);
+      m_axisMonitorRegistered = false;
+    } else {
+      LOG((CLOG_ERR "failed to remove OpenHarmony scroll monitor, result=%d", result));
+      success = false;
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lock(m_inputModeMutex);
+    registered = m_mouseMonitorRegistered;
+  }
+  if (registered) {
+    const Input_Result result = OH_Input_RemoveMouseEventMonitor(mouseEventCallback);
+    if (result == INPUT_SUCCESS) {
+      std::lock_guard<std::mutex> lock(m_inputModeMutex);
+      m_mouseMonitorRegistered = false;
+    } else {
+      LOG((CLOG_ERR "failed to remove OpenHarmony mouse monitor, result=%d", result));
+      success = false;
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lock(m_inputModeMutex);
+    registered = m_keyMonitorRegistered;
+  }
+  if (registered) {
+    const Input_Result result = OH_Input_RemoveKeyEventMonitor(keyEventCallback);
+    if (result == INPUT_SUCCESS) {
+      std::lock_guard<std::mutex> lock(m_inputModeMutex);
+      m_keyMonitorRegistered = false;
+    } else {
+      LOG((CLOG_ERR "failed to remove OpenHarmony key monitor, result=%d", result));
+      success = false;
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lock(m_inputModeMutex);
+    registered = m_pointerInterceptorRegistered;
+  }
+  if (registered) {
+    const Input_Result result = OH_Input_RemoveInputEventInterceptor();
+    if (result == INPUT_SUCCESS) {
+      std::lock_guard<std::mutex> lock(m_inputModeMutex);
+      m_pointerInterceptorRegistered = false;
+    } else {
+      LOG((CLOG_ERR "failed to remove OpenHarmony pointer interceptor, result=%d", result));
+      success = false;
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lock(m_inputModeMutex);
+    registered = m_keyInterceptorRegistered;
+  }
+  if (registered) {
+    const Input_Result result = OH_Input_RemoveKeyEventInterceptor();
+    if (result == INPUT_SUCCESS) {
+      std::lock_guard<std::mutex> lock(m_inputModeMutex);
+      m_keyInterceptorRegistered = false;
+    } else {
+      LOG((CLOG_ERR "failed to remove OpenHarmony key interceptor, result=%d", result));
+      success = false;
+    }
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(m_inputModeMutex);
+    if (!m_axisMonitorRegistered && !m_mouseMonitorRegistered && !m_keyMonitorRegistered &&
+        !m_pointerInterceptorRegistered && !m_keyInterceptorRegistered) {
+      m_inputMode = InputMode::kNone;
+    }
+  }
+  return success;
+}
+
+bool OHOSScreen::removeInputRegistrationsWithRetry()
+{
+  for (int attempt = 0; attempt < kInputCleanupAttempts; ++attempt) {
+    if (removeInputRegistrations()) {
+      return true;
+    }
+    if (attempt + 1 < kInputCleanupAttempts) {
+      std::this_thread::sleep_for(kInputCleanupRetryDelay);
+    }
+  }
+
+  bool interceptorRegistered = false;
+  {
+    std::lock_guard<std::mutex> lock(m_inputModeMutex);
+    interceptorRegistered = m_keyInterceptorRegistered || m_pointerInterceptorRegistered;
+  }
+  if (interceptorRegistered) {
+    LOG((CLOG_CRIT "OpenHarmony input interceptor cleanup failed; terminating to restore local input"));
+    std::terminate();
+  }
+  return false;
+}
+
+void OHOSScreen::finishInputModeOperation()
+{
+  {
+    std::lock_guard<std::mutex> lock(m_inputModeMutex);
+    m_inputModeOperationActive = false;
+  }
+  m_inputModeCondition.notify_all();
+}
+
+bool OHOSScreen::setInputMode(InputMode mode)
+{
+  {
+    std::unique_lock<std::mutex> lock(m_inputModeMutex);
+    m_inputModeCondition.wait(lock, [this] { return !m_inputModeOperationActive; });
+    const bool monitorsReady = m_keyMonitorRegistered && m_mouseMonitorRegistered &&
+                               m_axisMonitorRegistered && !m_keyInterceptorRegistered &&
+                               !m_pointerInterceptorRegistered;
+    const bool interceptorsReady = m_keyInterceptorRegistered && m_pointerInterceptorRegistered &&
+                                   !m_keyMonitorRegistered && !m_mouseMonitorRegistered &&
+                                   !m_axisMonitorRegistered;
+    const bool registrationsEmpty = !m_keyMonitorRegistered && !m_mouseMonitorRegistered &&
+                                    !m_axisMonitorRegistered && !m_keyInterceptorRegistered &&
+                                    !m_pointerInterceptorRegistered;
+    if ((mode == InputMode::kMonitor && m_inputMode == mode && monitorsReady) ||
+        (mode == InputMode::kIntercept && m_inputMode == mode && interceptorsReady) ||
+        (mode == InputMode::kNone && registrationsEmpty)) {
+      return true;
+    }
+    m_inputModeOperationActive = true;
+  }
+  struct OperationGuard
+  {
+    OHOSScreen *m_screen;
+    ~OperationGuard() { m_screen->finishInputModeOperation(); }
+  } operationGuard{this};
+
+  if (!removeInputRegistrationsWithRetry()) {
+    return false;
+  }
+  if (mode == InputMode::kNone) {
+    return true;
+  }
+
+  if (mode == InputMode::kMonitor) {
+    Input_Result result = OH_Input_AddKeyEventMonitor(keyEventCallback);
+    if (result != INPUT_SUCCESS) {
+      LOG((CLOG_ERR "failed to add OpenHarmony key monitor, result=%d", result));
+      return false;
+    }
+    {
+      std::lock_guard<std::mutex> lock(m_inputModeMutex);
+      m_keyMonitorRegistered = true;
+    }
+    result = OH_Input_AddMouseEventMonitor(mouseEventCallback);
+    if (result != INPUT_SUCCESS) {
+      LOG((CLOG_ERR "failed to add OpenHarmony mouse monitor, result=%d", result));
+      removeInputRegistrationsWithRetry();
+      return false;
+    }
+    {
+      std::lock_guard<std::mutex> lock(m_inputModeMutex);
+      m_mouseMonitorRegistered = true;
+    }
+    result = OH_Input_AddAxisEventMonitor(AXIS_EVENT_TYPE_SCROLL, axisEventCallback);
+    if (result != INPUT_SUCCESS) {
+      LOG((CLOG_ERR "failed to add OpenHarmony scroll monitor, result=%d", result));
+      removeInputRegistrationsWithRetry();
+      return false;
+    }
+    {
+      std::lock_guard<std::mutex> lock(m_inputModeMutex);
+      m_axisMonitorRegistered = true;
+    }
+  } else {
+    Input_Result result = OH_Input_AddKeyEventInterceptor(keyEventCallback, nullptr);
+    if (result != INPUT_SUCCESS) {
+      LOG((CLOG_ERR "failed to add OpenHarmony key interceptor, result=%d", result));
+      return false;
+    }
+    {
+      std::lock_guard<std::mutex> lock(m_inputModeMutex);
+      m_keyInterceptorRegistered = true;
+    }
+    result = OH_Input_AddInputEventInterceptor(&s_interceptorCallbacks, nullptr);
+    if (result != INPUT_SUCCESS) {
+      LOG((CLOG_ERR "failed to add OpenHarmony pointer interceptor, result=%d", result));
+      removeInputRegistrationsWithRetry();
+      return false;
+    }
+    {
+      std::lock_guard<std::mutex> lock(m_inputModeMutex);
+      m_pointerInterceptorRegistered = true;
+    }
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(m_inputModeMutex);
+    m_inputMode = mode;
+  }
+  return true;
+}
+
+bool OHOSScreen::removeInputMode()
+{
+  return setInputMode(InputMode::kNone);
+}
+
+bool OHOSScreen::nativeCleanupIncomplete() const
+{
+  bool incomplete = m_displayListenerRegistered;
+  {
+    std::lock_guard<std::mutex> lock(m_inputModeMutex);
+    incomplete = incomplete || m_inputMode != InputMode::kNone || m_keyMonitorRegistered ||
+                 m_mouseMonitorRegistered || m_axisMonitorRegistered ||
+                 m_keyInterceptorRegistered || m_pointerInterceptorRegistered;
+  }
+  {
+    std::lock_guard<std::mutex> lock(m_clipboardWriteMutex);
+    incomplete = incomplete || m_localPasteboardSubscribed || m_remotePasteboardSubscribed;
+  }
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    incomplete = incomplete || !m_hotkeys.empty();
+  }
+  return incomplete;
+}
+
+void OHOSScreen::enable()
+{
+  if (m_enabled) {
+    return;
+  }
+
+  if (m_cleanupFailed) {
+    disable();
+    if (m_cleanupFailed) {
+      throw std::runtime_error(
+          "cannot enable OpenHarmony screen while native callback cleanup is incomplete"
+      );
+    }
+  }
+
+  m_acceptNativeEvents.store(false, std::memory_order_release);
+  m_nativeEventGeneration.fetch_add(1, std::memory_order_acq_rel);
+
+  updateKeyMap();
+  updateKeyState();
+
+  if (!refreshShape(false)) {
+    throw std::runtime_error("failed to refresh OpenHarmony display layout");
+  }
+
+  if (!m_displayListenerRegistered) {
+    const NativeDisplayManager_ErrorCode displayResult =
+        OH_NativeDisplayManager_RegisterDisplayChangeListener(
+            displayChangeCallback, &m_displayListenerIndex
+        );
+    if (displayResult != DISPLAY_MANAGER_OK) {
+      disable();
+      throw std::runtime_error(
+          "failed to register OpenHarmony display listener, result=" + std::to_string(displayResult)
+      );
+    }
+    m_displayListenerRegistered = true;
+  }
+
+  if (!m_localPasteboardSubscribed) {
+    const int pasteboardResult = OH_Pasteboard_Subscribe(
+        m_pasteboard, NOTIFY_LOCAL_DATA_CHANGE, m_localPasteboardObserver
+    );
+    if (pasteboardResult != 0) {
+      disable();
+      throw std::runtime_error(
+          "failed to subscribe to local OpenHarmony pasteboard changes, result=" +
+          std::to_string(pasteboardResult)
+      );
+    }
+    m_localPasteboardSubscribed = true;
+  }
+  if (!m_remotePasteboardSubscribed) {
+    const int pasteboardResult = OH_Pasteboard_Subscribe(
+        m_pasteboard, NOTIFY_REMOTE_DATA_CHANGE, m_remotePasteboardObserver
+    );
+    if (pasteboardResult != 0) {
+      disable();
+      throw std::runtime_error(
+          "failed to subscribe to remote OpenHarmony pasteboard changes, result=" +
+          std::to_string(pasteboardResult)
+      );
+    }
+    m_remotePasteboardSubscribed = true;
+  }
+  const ClipboardSnapshot clipboardSnapshot = readClipboardSnapshot();
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    m_clipboardWriteTracker.reset(clipboardSnapshot);
+  }
+
+  if (!m_isPrimary && !requestInjectionAuthorization()) {
+    disable();
+    throw std::runtime_error("OpenHarmony input injection authorization was not granted");
+  }
+
+  if (m_isPrimary && !setInputMode(InputMode::kMonitor)) {
+    disable();
+    throw std::runtime_error(
+        "OpenHarmony global input monitoring is unavailable; check INPUT_MONITORING permission"
+    );
+  }
+
+  m_enabled = true;
+  m_acceptNativeEvents.store(true, std::memory_order_release);
+}
+
+void OHOSScreen::disable()
+{
+  m_acceptNativeEvents.store(false, std::memory_order_release);
+  m_nativeEventGeneration.fetch_add(1, std::memory_order_acq_rel);
+  m_enabled = false;
+  m_injectionAuthorizationReady.store(false, std::memory_order_release);
+  const std::uint64_t authorizationEpoch = m_authorizationEpoch.exchange(
+      0, std::memory_order_acq_rel
+  );
+  if (authorizationEpoch != 0) {
+    auto &broker = authorizationBroker();
+    {
+      std::lock_guard<std::mutex> lock(broker.m_mutex);
+      broker.m_coordinator.disable(authorizationEpoch);
+    }
+    broker.m_condition.notify_all();
+  }
+  removeInputMode();
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    m_warpPending = false;
+    m_warpPendingExpiresAt = 0;
+    m_buttons.fill(false);
+  }
+
+  std::vector<UInt32> hotkeyIds;
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    hotkeyIds.reserve(m_hotkeys.size());
+    for (const auto &entry : m_hotkeys) {
+      hotkeyIds.push_back(entry.first);
+    }
+  }
+  for (const UInt32 hotkeyId : hotkeyIds) {
+    unregisterHotKey(hotkeyId);
+  }
+  drainHotkeyCleanup();
+
+  beginClipboardOperation();
+  struct ClipboardOperationGuard
+  {
+    OHOSScreen *m_screen;
+    ~ClipboardOperationGuard() { m_screen->finishClipboardOperation(); }
+  } clipboardOperationGuard{this};
+  bool localSubscribed = false;
+  bool remoteSubscribed = false;
+  {
+    std::lock_guard<std::mutex> lock(m_clipboardWriteMutex);
+    localSubscribed = m_localPasteboardSubscribed;
+    remoteSubscribed = m_remotePasteboardSubscribed;
+  }
+  if (localSubscribed) {
+      const int result = OH_Pasteboard_Unsubscribe(
+          m_pasteboard, NOTIFY_LOCAL_DATA_CHANGE, m_localPasteboardObserver
+      );
+      if (result == 0) {
+        std::lock_guard<std::mutex> lock(m_clipboardWriteMutex);
+        m_localPasteboardSubscribed = false;
+      } else {
+        LOG((CLOG_WARN "failed to unsubscribe from local OpenHarmony pasteboard changes, result=%d", result));
+      }
+  }
+  if (remoteSubscribed) {
+      const int result = OH_Pasteboard_Unsubscribe(
+          m_pasteboard, NOTIFY_REMOTE_DATA_CHANGE, m_remotePasteboardObserver
+      );
+      if (result == 0) {
+        std::lock_guard<std::mutex> lock(m_clipboardWriteMutex);
+        m_remotePasteboardSubscribed = false;
+      } else {
+        LOG((CLOG_WARN "failed to unsubscribe from remote OpenHarmony pasteboard changes, result=%d", result));
+      }
+  }
+  clearPendingClipboardWrite();
+
+  if (m_displayListenerRegistered) {
+    const auto result = OH_NativeDisplayManager_UnregisterDisplayChangeListener(m_displayListenerIndex);
+    if (result == DISPLAY_MANAGER_OK) {
+      m_displayListenerRegistered = false;
+    } else {
+      LOG((CLOG_WARN "failed to unregister OpenHarmony display listener, result=%d", result));
+    }
+  }
+
+  const Input_Result pointerResult = OH_Input_SetPointerVisible(true);
+  if (pointerResult != INPUT_SUCCESS) {
+    LOG((CLOG_WARN "failed to show OpenHarmony pointer while disabling, result=%d", pointerResult));
+  }
+
+  m_cleanupFailed = nativeCleanupIncomplete();
+  if (m_cleanupFailed) {
+    LOG((CLOG_ERR "OpenHarmony native cleanup is incomplete; re-enable will retry and fail closed"));
+  }
+}
+
+void OHOSScreen::enter()
+{
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    m_isOnScreen = true;
+  }
+  const Input_Result result = OH_Input_SetPointerVisible(true);
+  if (result != INPUT_SUCCESS) {
+    LOG((CLOG_WARN "failed to show OpenHarmony pointer, result=%d", result));
+  }
+  if (m_isPrimary && m_enabled && !setInputMode(InputMode::kMonitor)) {
+    LOG((CLOG_CRIT "failed to restore OpenHarmony input monitors while entering screen"));
+    sendEvent(m_events->forIScreen().error());
+  }
+}
+
+bool OHOSScreen::canLeave()
+{
+  if (!m_isPrimary) {
+    return true;
+  }
+  if (!injectionAuthorized() && !requestInjectionAuthorization()) {
+    return false;
+  }
+  if (!setInputMode(InputMode::kIntercept)) {
+    if (!setInputMode(InputMode::kMonitor)) {
+      sendEvent(m_events->forIScreen().error());
+    }
+    return false;
+  }
+  return true;
+}
+
+void OHOSScreen::leave()
+{
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    m_isOnScreen = false;
+  }
+  const Input_Result result = OH_Input_SetPointerVisible(false);
+  if (result != INPUT_SUCCESS) {
+    LOG((CLOG_WARN "failed to hide OpenHarmony pointer, result=%d", result));
+  }
+  SInt32 centerX = 0;
+  SInt32 centerY = 0;
+  getCursorCenter(centerX, centerY);
+  warpCursor(centerX, centerY);
+}
+
+void *OHOSScreen::getEventTarget() const
+{
+  return const_cast<OHOSScreen *>(this);
+}
+
+void OHOSScreen::getShape(SInt32 &x, SInt32 &y, SInt32 &width, SInt32 &height) const
+{
+  std::lock_guard<std::mutex> lock(m_stateMutex);
+  x = m_x;
+  y = m_y;
+  width = m_width;
+  height = m_height;
+}
+
+void OHOSScreen::getCursorPos(SInt32 &x, SInt32 &y) const
+{
+  int32_t displayId = 0;
+  double displayX = 0.0;
+  double displayY = 0.0;
+  const Input_Result result = OH_Input_GetPointerLocation(&displayId, &displayX, &displayY);
+  if (result == INPUT_SUCCESS) {
+    int32_t originX = 0;
+    int32_t originY = 0;
+    if (OH_NativeDisplayManager_GetDisplayPosition(displayId, &originX, &originY) == DISPLAY_MANAGER_OK) {
+      std::int32_t globalX = 0;
+      std::int32_t globalY = 0;
+      if (deskflow::platform::checkedPointerCoordinate(originX, displayX, globalX) &&
+          deskflow::platform::checkedPointerCoordinate(originY, displayY, globalY)) {
+        x = static_cast<SInt32>(globalX);
+        y = static_cast<SInt32>(globalY);
+        std::lock_guard<std::mutex> lock(m_stateMutex);
+        m_cursorX = x;
+        m_cursorY = y;
+        return;
+      }
+      LOG((
+          CLOG_WARN "ignoring out-of-range OpenHarmony pointer position, display=%d x=%g y=%g origin=%d,%d",
+          displayId, displayX, displayY, originX, originY
+      ));
+    }
+  }
+
+  std::lock_guard<std::mutex> lock(m_stateMutex);
+  x = m_cursorX;
+  y = m_cursorY;
+  LOG((CLOG_DEBUG1 "using cached OpenHarmony pointer position, query result=%d", result));
+}
+
+void OHOSScreen::reconfigure(UInt32)
+{
+  if (!refreshShape(true)) {
+    sendEvent(m_events->forIScreen().error());
+  }
+}
+
+bool OHOSScreen::injectMouseEvent(Input_MouseEvent *event, bool global, bool recenterWarp) const
+{
+  if (event == nullptr || !injectionAuthorized()) {
+    return false;
+  }
+  const std::int32_t action = OH_Input_GetMouseEventAction(event);
+  const InjectionTokenClass tokenClass =
+      action == MOUSE_ACTION_AXIS_BEGIN || action == MOUSE_ACTION_AXIS_UPDATE || action == MOUSE_ACTION_AXIS_END
+          ? InjectionTokenClass::kAxis
+          : InjectionTokenClass::kMouse;
+  if (!inputRoleAllowsInjection(tokenClass, recenterWarp)) {
+    return false;
+  }
+  InjectionFingerprint fingerprint;
+  fingerprint.m_class = tokenClass;
+  if (tokenClass == InjectionTokenClass::kAxis) {
+    fingerprint.m_action = static_cast<std::int32_t>(axisActionForMouseAction(action));
+    const std::int32_t axisType = OH_Input_GetMouseEventAxisType(event);
+    const double axisValue = OH_Input_GetMouseEventAxisValue(event);
+    if (axisType == MOUSE_AXIS_SCROLL_HORIZONTAL) {
+      if (!axisFingerprintValue(axisValue, fingerprint.m_horizontal)) {
+        return false;
+      }
+    } else if (axisType == MOUSE_AXIS_SCROLL_VERTICAL) {
+      if (!axisFingerprintValue(axisValue, fingerprint.m_vertical)) {
+        return false;
+      }
+    }
+  } else {
+    fingerprint.m_action = action;
+    fingerprint.m_code = OH_Input_GetMouseEventButton(event);
+    fingerprint.m_x = OH_Input_GetMouseEventGlobalX(event);
+    fingerprint.m_y = OH_Input_GetMouseEventGlobalY(event);
+  }
+  const std::int64_t actionTime = beginInjectionToken(fingerprint);
+  if (actionTime == 0) {
+    return false;
+  }
+  OH_Input_SetMouseEventActionTime(event, actionTime);
+  const int32_t result = global ? OH_Input_InjectMouseEventGlobal(event) : OH_Input_InjectMouseEvent(event);
+  finishInjectionToken(actionTime, result == INPUT_SUCCESS);
+  if (result != INPUT_SUCCESS) {
+    LOG((CLOG_ERR "failed to inject OpenHarmony mouse event, result=%d", result));
+    return false;
+  }
+  return true;
+}
+
+bool OHOSScreen::injectAbsoluteMouse(SInt32 x, SInt32 y, bool recenterWarp) const
+{
+  Input_MouseEvent *event = OH_Input_CreateMouseEvent();
+  if (event == nullptr) {
+    LOG((CLOG_ERR "failed to allocate OpenHarmony mouse event"));
+    return false;
+  }
+  OH_Input_SetMouseEventAction(event, MOUSE_ACTION_MOVE);
+  OH_Input_SetMouseEventGlobalX(event, x);
+  OH_Input_SetMouseEventGlobalY(event, y);
+  const bool success = injectMouseEvent(event, true, recenterWarp);
+  OH_Input_DestroyMouseEvent(&event);
+  if (success) {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    m_cursorX = x;
+    m_cursorY = y;
+  }
+  return success;
+}
+
+void OHOSScreen::warpCursor(SInt32 x, SInt32 y)
+{
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    m_warpPending = true;
+    m_warpPendingExpiresAt = deadlineAfter(
+        monotonicMicroseconds(), kInjectionTokenLifetimeMicroseconds
+    );
+  }
+  if (!injectAbsoluteMouse(x, y, true)) {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    m_warpPending = false;
+    m_warpPendingExpiresAt = 0;
+    sendEvent(m_events->forIScreen().error());
+  }
+}
+
+void OHOSScreen::fakeMouseMove(SInt32 x, SInt32 y)
+{
+  injectAbsoluteMouse(x, y);
+}
+
+void OHOSScreen::fakeMouseRelativeMove(SInt32 dx, SInt32 dy) const
+{
+  SInt32 x = 0;
+  SInt32 y = 0;
+  getCursorPos(x, y);
+  std::int32_t targetX = 0;
+  std::int32_t targetY = 0;
+  if (!deskflow::platform::checkedPointerDelta(x, dx, targetX) ||
+      !deskflow::platform::checkedPointerDelta(y, dy, targetY)) {
+    LOG((
+        CLOG_WARN "ignoring out-of-range relative mouse move, current=%d,%d delta=%d,%d",
+        x, y, dx, dy
+    ));
+    return;
+  }
+  injectAbsoluteMouse(static_cast<SInt32>(targetX), static_cast<SInt32>(targetY));
+}
+
+void OHOSScreen::fakeMouseButton(ButtonID id, bool press)
+{
+  const int32_t button = mapMouseButtonToOHOS(id);
+  if (button == MOUSE_BUTTON_NONE) {
+    LOG((CLOG_ERR "cannot map Deskflow mouse button %u to OpenHarmony", id));
+    return;
+  }
+
+  Input_MouseEvent *event = OH_Input_CreateMouseEvent();
+  if (event == nullptr) {
+    LOG((CLOG_ERR "failed to allocate OpenHarmony mouse button event"));
+    return;
+  }
+  OH_Input_SetMouseEventButton(event, button);
+  OH_Input_SetMouseEventAction(event, press ? MOUSE_ACTION_BUTTON_DOWN : MOUSE_ACTION_BUTTON_UP);
+  injectMouseEvent(event, false);
+  OH_Input_DestroyMouseEvent(&event);
+}
+
+void OHOSScreen::fakeMouseWheel(SInt32 xDelta, SInt32 yDelta) const
+{
+  xDelta = mapClientScrollDirection(xDelta);
+  yDelta = mapClientScrollDirection(yDelta);
+
+  const auto injectAxis = [this](int32_t axis, SInt32 delta) {
+    if (delta == 0) {
+      return;
+    }
+    Input_MouseEvent *event = OH_Input_CreateMouseEvent();
+    if (event == nullptr) {
+      LOG((CLOG_ERR "failed to allocate OpenHarmony wheel event"));
+      return;
+    }
+    OH_Input_SetMouseEventAxisType(event, axis);
+    OH_Input_SetMouseEventAction(event, MOUSE_ACTION_AXIS_BEGIN);
+    bool success = injectMouseEvent(event, false);
+    OH_Input_SetMouseEventAxisValue(event, static_cast<float>(delta) / kWheelDelta);
+    OH_Input_SetMouseEventAction(event, MOUSE_ACTION_AXIS_UPDATE);
+    success = injectMouseEvent(event, false) && success;
+    OH_Input_SetMouseEventAction(event, MOUSE_ACTION_AXIS_END);
+    success = injectMouseEvent(event, false) && success;
+    OH_Input_DestroyMouseEvent(&event);
+    if (!success) {
+      LOG((CLOG_ERR "failed to inject complete OpenHarmony wheel sequence"));
+    }
+  };
+
+  injectAxis(MOUSE_AXIS_SCROLL_HORIZONTAL, xDelta);
+  injectAxis(MOUSE_AXIS_SCROLL_VERTICAL, yDelta);
+}
