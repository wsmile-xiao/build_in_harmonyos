+
+bool OHOSScreen::getClipboard(ClipboardID id, IClipboard *clipboard) const
+{
+  if (id >= kClipboardEnd || clipboard == nullptr) {
+    return false;
+  }
+
+  int status = 0;
+  OH_UdmfData *data = OH_Pasteboard_GetData(m_pasteboard, &status);
+  if (status != 0 || data == nullptr) {
+    if (data != nullptr) {
+      OH_UdmfData_Destroy(data);
+    }
+    LOG((CLOG_ERR "failed to read OpenHarmony pasteboard, result=%d", status));
+    return false;
+  }
+
+  Clipboard local;
+  bool success = local.open(clipboardTime()) && local.empty();
+  if (success) {
+    OH_UdsPlainText *plainText = OH_UdsPlainText_Create();
+    if (plainText != nullptr && OH_UdmfData_GetPrimaryPlainText(data, plainText) == 0) {
+      const char *content = OH_UdsPlainText_GetContent(plainText);
+      if (content != nullptr) {
+        local.add(IClipboard::kText, content);
+      }
+    }
+    if (plainText != nullptr) {
+      OH_UdsPlainText_Destroy(plainText);
+    }
+
+    OH_UdsHtml *html = OH_UdsHtml_Create();
+    if (html != nullptr && OH_UdmfData_GetPrimaryHtml(data, html) == 0) {
+      const char *content = OH_UdsHtml_GetContent(html);
+      if (content != nullptr) {
+        local.add(IClipboard::kHTML, content);
+      }
+    }
+    if (html != nullptr) {
+      OH_UdsHtml_Destroy(html);
+    }
+
+    const int recordCount = OH_UdmfData_GetRecordCount(data);
+    for (int i = 0; i < recordCount; ++i) {
+      OH_UdmfRecord *record = OH_UdmfData_GetRecord(data, static_cast<unsigned int>(i));
+      OH_UdsArrayBuffer *buffer = OH_UdsArrayBuffer_Create();
+      if (record != nullptr && buffer != nullptr &&
+          OH_UdmfRecord_GetArrayBuffer(record, kDeskflowBitmapType, buffer) == 0) {
+        unsigned char *bytes = nullptr;
+        unsigned int length = 0;
+        if (OH_UdsArrayBuffer_GetData(buffer, &bytes, &length) == 0 && bytes != nullptr) {
+          local.add(IClipboard::kBitmap, String(reinterpret_cast<const char *>(bytes), length));
+          OH_UdsArrayBuffer_Destroy(buffer);
+          break;
+        }
+      }
+      if (buffer != nullptr) {
+        OH_UdsArrayBuffer_Destroy(buffer);
+      }
+    }
+    local.close();
+  }
+
+  OH_UdmfData_Destroy(data);
+  return success && Clipboard::copy(clipboard, &local);
+}
+
+bool OHOSScreen::setClipboard(ClipboardID id, const IClipboard *clipboard)
+{
+  if (id >= kClipboardEnd || clipboard == nullptr) {
+    return false;
+  }
+
+  if (!clipboard->open(clipboardTime())) {
+    return false;
+  }
+
+  const bool hasText = clipboard->has(IClipboard::kText);
+  const bool hasHtml = clipboard->has(IClipboard::kHTML);
+  const bool hasBitmap = clipboard->has(IClipboard::kBitmap);
+  const String text = hasText ? clipboard->get(IClipboard::kText) : String();
+  const String htmlText = hasHtml ? clipboard->get(IClipboard::kHTML) : String();
+  const String bitmap = hasBitmap ? clipboard->get(IClipboard::kBitmap) : String();
+  clipboard->close();
+
+  beginClipboardOperation();
+  struct OperationGuard
+  {
+    OHOSScreen *m_screen;
+    ~OperationGuard() { m_screen->finishClipboardOperation(); }
+  } operationGuard{this};
+
+  const ClipboardSnapshot before = readClipboardSnapshot();
+  const std::int64_t deadline = deadlineAfter(
+      m_native.m_monotonicMicroseconds(), kClipboardWriteTimeoutMicroseconds
+  );
+
+  const auto observeLocalCallbacks = [this](
+                                           std::uint64_t generation,
+                                           const ClipboardSnapshot &snapshot) {
+    bool notifyExternal = false;
+    const std::uint32_t callbackCount = takeClipboardCallbackCount(generation);
+    if (callbackCount == 0) {
+      return false;
+    }
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    for (std::uint32_t index = 0; index < callbackCount; ++index) {
+      const auto observation = m_clipboardWriteTracker.observe(
+          snapshot, true, m_native.m_monotonicMicroseconds()
+      );
+      notifyExternal = notifyExternal ||
+                       observation == deskflow::platform::ClipboardObservation::kNotifyExternal;
+    }
+    return notifyExternal;
+  };
+
+  const auto notifyClipboardExternal = [this](bool notify) {
+    if (notify) {
+      sendClipboardEvent(kClipboardClipboard);
+      sendClipboardEvent(kClipboardSelection);
+    }
+  };
+
+  if (!hasText && !hasHtml && !hasBitmap) {
+    ClipboardFingerprint intended;
+    String empty;
+    if (!clipboardFingerprint(false, empty, false, empty, false, empty, intended)) {
+      return false;
+    }
+    std::uint64_t generation = 0;
+    {
+      std::lock_guard<std::mutex> lock(m_stateMutex);
+      generation = m_clipboardWriteTracker.begin(
+          deskflow::platform::ClipboardWriteKind::kClear, before, intended, deadline
+      );
+    }
+    if (generation == 0) {
+      return false;
+    }
+    setClipboardCallbackGeneration(generation);
+    const int result = m_native.m_pasteboardClearData(m_pasteboard);
+    if (result == 0) {
+      waitForClipboardCallback(generation, deadline);
+    }
+    const ClipboardSnapshot firstEmpty = readClipboardSnapshot();
+    const bool observedExternal = observeLocalCallbacks(generation, firstEmpty);
+    std::this_thread::yield();
+    const ClipboardSnapshot secondEmpty = readClipboardSnapshot();
+    deskflow::platform::ClipboardFinish finish;
+    {
+      std::lock_guard<std::mutex> lock(m_stateMutex);
+      if (m_clipboardWriteTracker.generation() == generation) {
+        finish = m_clipboardWriteTracker.finishClear(
+            generation, result == 0, firstEmpty, secondEmpty,
+            m_native.m_monotonicMicroseconds()
+        );
+      }
+    }
+    setClipboardCallbackGeneration(0);
+    notifyClipboardExternal(observedExternal || finish.m_notifyExternal);
+    if (result != 0) {
+      LOG((CLOG_ERR "failed to clear OpenHarmony pasteboard, result=%d", result));
+    }
+    return finish.m_succeeded;
+  }
+
+  ClipboardFingerprint intended;
+  if (!clipboardFingerprint(
+          hasText, text, hasHtml, htmlText, hasBitmap, bitmap, intended
+      )) {
+    return false;
+  }
+
+  OH_UdmfData *data = OH_UdmfData_Create();
+  OH_UdmfRecord *record = OH_UdmfRecord_Create();
+  OH_UdsPlainText *plainText = nullptr;
+  OH_UdsHtml *html = nullptr;
+  OH_UdsArrayBuffer *buffer = nullptr;
+  bool valid = data != nullptr && record != nullptr;
+
+  if (valid && hasText) {
+    plainText = OH_UdsPlainText_Create();
+    valid = plainText != nullptr && OH_UdsPlainText_SetContent(plainText, text.c_str()) == 0 &&
+            OH_UdmfRecord_AddPlainText(record, plainText) == 0;
+  }
+  if (valid && hasHtml) {
+    html = OH_UdsHtml_Create();
+    valid = html != nullptr && OH_UdsHtml_SetContent(html, htmlText.c_str()) == 0;
+    if (valid && hasText) {
+      valid = OH_UdsHtml_SetPlainContent(html, text.c_str()) == 0;
+    }
+    if (valid) {
+      valid = OH_UdmfRecord_AddHtml(record, html) == 0;
+    }
+  }
+  if (valid && hasBitmap) {
+    buffer = OH_UdsArrayBuffer_Create();
+    auto *bytes = reinterpret_cast<unsigned char *>(const_cast<char *>(bitmap.data()));
+    valid = buffer != nullptr && OH_UdsArrayBuffer_SetData(buffer, bytes, bitmap.size()) == 0 &&
+            OH_UdmfRecord_AddArrayBuffer(record, kDeskflowBitmapType, buffer) == 0;
+  }
+  if (valid) {
+    valid = OH_UdmfData_AddRecord(data, record) == 0;
+  }
+
+  int result = -1;
+  deskflow::platform::ClipboardFinish finish;
+  bool observedExternal = false;
+  std::uint64_t generation = 0;
+  if (valid) {
+    {
+      std::lock_guard<std::mutex> lock(m_stateMutex);
+      generation = m_clipboardWriteTracker.begin(
+          deskflow::platform::ClipboardWriteKind::kSet, before, intended, deadline
+      );
+    }
+    if (generation != 0) {
+      setClipboardCallbackGeneration(generation);
+      result = m_native.m_pasteboardSetData(m_pasteboard, data);
+      const ClipboardSnapshot after = readClipboardSnapshot();
+      observedExternal = observeLocalCallbacks(generation, after);
+      {
+        std::lock_guard<std::mutex> lock(m_stateMutex);
+        if (m_clipboardWriteTracker.generation() == generation) {
+          finish = m_clipboardWriteTracker.finishSet(
+              generation, result == 0, after, m_native.m_monotonicMicroseconds()
+          );
+        }
+        if (m_clipboardWriteTracker.generation() != generation) {
+          setClipboardCallbackGeneration(0);
+        }
+      }
+    }
+  }
+
+  if (buffer != nullptr) {
+    OH_UdsArrayBuffer_Destroy(buffer);
+  }
+  if (html != nullptr) {
+    OH_UdsHtml_Destroy(html);
+  }
+  if (plainText != nullptr) {
+    OH_UdsPlainText_Destroy(plainText);
+  }
+  if (record != nullptr) {
+    OH_UdmfRecord_Destroy(record);
+  }
+  if (data != nullptr) {
+    OH_UdmfData_Destroy(data);
+  }
+
+  notifyClipboardExternal(observedExternal || finish.m_notifyExternal);
+  if (!valid || result != 0 || !finish.m_succeeded) {
+    LOG((CLOG_ERR "failed to publish Deskflow clipboard through OpenHarmony UDMF, result=%d", result));
+    return false;
+  }
+  return true;
+}
