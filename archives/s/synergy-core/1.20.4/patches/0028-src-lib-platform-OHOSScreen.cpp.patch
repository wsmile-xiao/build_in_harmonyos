+bool readUdmfPayload(
+    OH_UdmfData *data, bool &hasText, String &text, bool &hasHtml, String &html,
+    bool &hasBitmap, String &bitmap
+)
+{
+  if (data == nullptr) {
+    return false;
+  }
+
+  hasText = false;
+  hasHtml = false;
+  hasBitmap = false;
+
+  OH_UdsPlainText *plainText = OH_UdsPlainText_Create();
+  if (plainText == nullptr) {
+    return false;
+  }
+  if (OH_UdmfData_GetPrimaryPlainText(data, plainText) == 0) {
+    const char *content = OH_UdsPlainText_GetContent(plainText);
+    if (content == nullptr) {
+      OH_UdsPlainText_Destroy(plainText);
+      return false;
+    }
+    hasText = true;
+    text = content;
+  }
+  OH_UdsPlainText_Destroy(plainText);
+
+  OH_UdsHtml *htmlData = OH_UdsHtml_Create();
+  if (htmlData == nullptr) {
+    return false;
+  }
+  if (OH_UdmfData_GetPrimaryHtml(data, htmlData) == 0) {
+    const char *content = OH_UdsHtml_GetContent(htmlData);
+    if (content == nullptr) {
+      OH_UdsHtml_Destroy(htmlData);
+      return false;
+    }
+    hasHtml = true;
+    html = content;
+  }
+  OH_UdsHtml_Destroy(htmlData);
+
+  const int recordCount = OH_UdmfData_GetRecordCount(data);
+  if (recordCount < 0) {
+    return false;
+  }
+  for (int i = 0; i < recordCount; ++i) {
+    OH_UdmfRecord *record = OH_UdmfData_GetRecord(data, static_cast<unsigned int>(i));
+    OH_UdsArrayBuffer *buffer = OH_UdsArrayBuffer_Create();
+    if (buffer == nullptr) {
+      return false;
+    }
+    if (record != nullptr && OH_UdmfRecord_GetArrayBuffer(record, kDeskflowBitmapType, buffer) == 0) {
+      unsigned char *bytes = nullptr;
+      unsigned int length = 0;
+      if (OH_UdsArrayBuffer_GetData(buffer, &bytes, &length) != 0 ||
+          (bytes == nullptr && length != 0)) {
+        OH_UdsArrayBuffer_Destroy(buffer);
+        return false;
+      }
+      hasBitmap = true;
+      bitmap.assign(reinterpret_cast<const char *>(bytes), length);
+      OH_UdsArrayBuffer_Destroy(buffer);
+      break;
+    }
+    OH_UdsArrayBuffer_Destroy(buffer);
+  }
+  return true;
+}
