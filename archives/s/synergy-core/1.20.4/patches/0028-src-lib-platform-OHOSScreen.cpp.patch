+         left.m_actionTime == right.m_actionTime && left.m_action == right.m_action &&
+         left.m_code == right.m_code && left.m_x == right.m_x && left.m_y == right.m_y &&
+         left.m_horizontal == right.m_horizontal && left.m_vertical == right.m_vertical;
+}
