+using ClipboardFingerprint = std::array<std::uint8_t, 32>;
+
+struct ClipboardSnapshot
+{
+  bool m_readable{false};
+  bool m_hasData{false};
+  bool m_getDataWasNull{false};
+  ClipboardFingerprint m_fingerprint{};
+  std::uint32_t m_changeCount{};
+};
+
+enum class ClipboardWriteKind
+{
+  kSet,
+  kClear
+};
+
+enum class ClipboardWritePhase
+{
+  kIdle,
+  kCalling,
+  kReadbackConfirmed
+};
+
+enum class ClipboardObservation
+{
+  kIgnore,
+  kSuppressSelfWrite,
+  kNotifyExternal
+};
+
+struct ClipboardFinish
+{
+  bool m_succeeded{false};
+  bool m_notifyExternal{false};
+};
+
+class ClipboardWriteTracker
+{
+public:
+  void reset(const ClipboardSnapshot &snapshot)
+  {
+    m_current = snapshot;
+    m_pending = {};
+  }
+
+  std::uint64_t begin(
+      ClipboardWriteKind kind, const ClipboardSnapshot &before,
+      const ClipboardFingerprint &intended, std::int64_t deadline
+  )
+  {
+    if (!before.m_readable || (kind == ClipboardWriteKind::kClear && !before.m_hasData)) {
+      return 0;
+    }
+    ++m_generation;
+    if (m_generation == 0) {
+      ++m_generation;
+    }
+    m_current = before;
+    m_pending = {};
+    m_pending.m_generation = m_generation;
+    m_pending.m_kind = kind;
+    m_pending.m_phase = ClipboardWritePhase::kCalling;
+    m_pending.m_before = before;
+    m_pending.m_intended = intended;
+    m_pending.m_deadline = deadline;
+    return m_generation;
+  }
+
+  ClipboardObservation observe(
+      const ClipboardSnapshot &snapshot, bool localChange, std::int64_t now
+  )
+  {
+    if (m_pending.m_generation == 0) {
+      return observeWithoutPending(snapshot);
+    }
+    if (!localChange || now >= m_pending.m_deadline || !snapshot.m_readable ||
+        !matchesIntended(snapshot) || !countRelationExact(snapshot) ||
+        m_pending.m_callbackSeen) {
+      m_pending = {};
+      if (snapshot.m_readable) {
+        m_current = snapshot;
+      }
+      return ClipboardObservation::kNotifyExternal;
+    }
+
+    m_pending.m_callbackSeen = true;
+    m_pending.m_after = snapshot;
+    m_current = snapshot;
+    if (m_pending.m_phase == ClipboardWritePhase::kReadbackConfirmed &&
+        m_pending.m_kind == ClipboardWriteKind::kSet) {
+      m_pending = {};
+    }
+    return ClipboardObservation::kSuppressSelfWrite;
+  }
+
+  ClipboardFinish finishSet(
+      std::uint64_t generation, bool callSucceeded, const ClipboardSnapshot &after,
+      std::int64_t now
+  )
+  {
+    ClipboardFinish result;
+    if (!pendingMatches(generation, ClipboardWriteKind::kSet) || now >= m_pending.m_deadline) {
+      result.m_notifyExternal = true;
+      m_pending = {};
+      return result;
+    }
+    const Pending pending = m_pending;
+    if (!callSucceeded || !after.m_readable || !matchesIntended(after)) {
+      result.m_notifyExternal = !after.m_readable || changed(pending.m_before, after);
+      if (after.m_readable) {
+        m_current = after;
+      }
+      m_pending = {};
+      return result;
+    }
+
+    const bool zeroEvent = sameContent(pending.m_before, after) &&
+                           pending.m_before.m_changeCount == after.m_changeCount;
+    if (!zeroEvent && !countRelationExact(after)) {
+      result.m_notifyExternal = true;
+      m_current = after;
+      m_pending = {};
+      return result;
+    }
+    if (zeroEvent && pending.m_callbackSeen) {
+      result.m_notifyExternal = true;
+      m_current = after;
+      m_pending = {};
+      return result;
+    }
+
+    result.m_succeeded = true;
+    m_current = after;
+    if (zeroEvent || pending.m_callbackSeen) {
+      m_pending = {};
+    } else {
+      m_pending.m_phase = ClipboardWritePhase::kReadbackConfirmed;
+      m_pending.m_after = after;
+    }
+    return result;
+  }
+
+  ClipboardFinish finishClear(
+      std::uint64_t generation, bool callSucceeded, const ClipboardSnapshot &firstEmpty,
+      const ClipboardSnapshot &secondEmpty, std::int64_t now
+  )
+  {
+    ClipboardFinish result;
+    if (!pendingMatches(generation, ClipboardWriteKind::kClear) || now >= m_pending.m_deadline) {
+      result.m_notifyExternal = true;
+      m_pending = {};
+      return result;
+    }
+    const Pending pending = m_pending;
+    const bool stableEmpty = callSucceeded && pending.m_callbackSeen && emptyRead(firstEmpty) &&
+                             emptyRead(secondEmpty) &&
+                             firstEmpty.m_changeCount == secondEmpty.m_changeCount &&
+                             firstEmpty.m_fingerprint == secondEmpty.m_fingerprint &&
+                             countRelationExact(firstEmpty) && countRelationExact(secondEmpty);
+    if (!stableEmpty) {
+      result.m_notifyExternal = true;
+      if (secondEmpty.m_readable) {
+        m_current = secondEmpty;
+      }
+      m_pending = {};
+      return result;
+    }
+
+    result.m_succeeded = true;
+    m_current = secondEmpty;
+    m_pending = {};
+    return result;
+  }
+
+  void clear() { m_pending = {}; }
+  bool callbackSeen(std::uint64_t generation) const
+  {
+    return m_pending.m_generation == generation && m_pending.m_callbackSeen;
+  }
+  std::uint64_t generation() const { return m_pending.m_generation; }
+
+private:
+  struct Pending
+  {
+    std::uint64_t m_generation{};
+    ClipboardWriteKind m_kind{ClipboardWriteKind::kSet};
+    ClipboardWritePhase m_phase{ClipboardWritePhase::kIdle};
+    ClipboardSnapshot m_before;
+    ClipboardSnapshot m_after;
+    ClipboardFingerprint m_intended{};
+    std::int64_t m_deadline{};
+    bool m_callbackSeen{false};
+  };
+
+  static bool emptyRead(const ClipboardSnapshot &snapshot)
+  {
+    return snapshot.m_readable && !snapshot.m_hasData && snapshot.m_getDataWasNull;
+  }
+
+  static bool sameContent(const ClipboardSnapshot &left, const ClipboardSnapshot &right)
+  {
+    return left.m_readable && right.m_readable && left.m_hasData == right.m_hasData &&
+           left.m_fingerprint == right.m_fingerprint;
+  }
+
+  static bool changed(const ClipboardSnapshot &left, const ClipboardSnapshot &right)
+  {
+    return !sameContent(left, right) || left.m_changeCount != right.m_changeCount;
+  }
+
+  bool pendingMatches(std::uint64_t generation, ClipboardWriteKind kind) const
+  {
+    return generation != 0 && m_pending.m_generation == generation && m_pending.m_kind == kind;
+  }
+
+  bool matchesIntended(const ClipboardSnapshot &snapshot) const
+  {
+    const bool expectedData = m_pending.m_kind == ClipboardWriteKind::kSet;
+    return snapshot.m_readable && snapshot.m_hasData == expectedData &&
+           snapshot.m_fingerprint == m_pending.m_intended;
+  }
+
+  bool countRelationExact(const ClipboardSnapshot &snapshot) const
+  {
+    if (m_pending.m_kind == ClipboardWriteKind::kClear) {
+      return snapshot.m_changeCount == m_pending.m_before.m_changeCount;
+    }
+    if (snapshot.m_changeCount == 0) {
+      return false;
+    }
+    return static_cast<std::uint32_t>(
+               snapshot.m_changeCount - m_pending.m_before.m_changeCount
+           ) == 1;
+  }
+
+  ClipboardObservation observeWithoutPending(const ClipboardSnapshot &snapshot)
+  {
+    if (!snapshot.m_readable) {
+      return ClipboardObservation::kNotifyExternal;
+    }
+    if (!changed(m_current, snapshot)) {
+      return ClipboardObservation::kIgnore;
+    }
+    m_current = snapshot;
+    return ClipboardObservation::kNotifyExternal;
+  }
+
+  std::uint64_t m_generation{};
+  ClipboardSnapshot m_current;
+  Pending m_pending;
+};
