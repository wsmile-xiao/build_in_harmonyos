+enum class HotKeyLifecycle
+{
+  kRegistered,
+  kRemoving,
+  kRemoved
+};
+
+struct HotKeyTicket
+{
+  std::uint32_t m_id{};
+  std::uint64_t m_epoch{};
+};
+
+class HotKeyRegistry
+{
+public:
+  std::uint64_t add(std::uint32_t id)
+  {
+    ++m_epoch;
+    if (m_epoch == 0) {
+      ++m_epoch;
+    }
+    m_entries[id] = Entry{m_epoch, HotKeyLifecycle::kRegistered, 0};
+    return m_epoch;
+  }
+
+  bool beginCallback(const HotKeyTicket &ticket)
+  {
+    auto entry = m_entries.find(ticket.m_id);
+    if (entry == m_entries.end() || entry->second.m_epoch != ticket.m_epoch ||
+        entry->second.m_lifecycle != HotKeyLifecycle::kRegistered) {
+      return false;
+    }
+    ++entry->second.m_callbacksInFlight;
+    return true;
+  }
+
+  bool endCallback(const HotKeyTicket &ticket)
+  {
+    auto entry = m_entries.find(ticket.m_id);
+    if (entry != m_entries.end() && entry->second.m_epoch == ticket.m_epoch &&
+        entry->second.m_callbacksInFlight != 0) {
+      --entry->second.m_callbacksInFlight;
+      return entry->second.m_lifecycle == HotKeyLifecycle::kRemoved &&
+             entry->second.m_callbacksInFlight == 0;
+    }
+    return false;
+  }
+
+  bool beginRemove(const HotKeyTicket &ticket)
+  {
+    auto entry = m_entries.find(ticket.m_id);
+    if (entry == m_entries.end() || entry->second.m_epoch != ticket.m_epoch ||
+        entry->second.m_lifecycle != HotKeyLifecycle::kRegistered) {
+      return false;
+    }
+    entry->second.m_lifecycle = HotKeyLifecycle::kRemoving;
+    return true;
+  }
+
+  bool removeFailed(const HotKeyTicket &ticket)
+  {
+    auto entry = m_entries.find(ticket.m_id);
+    if (entry == m_entries.end() || entry->second.m_epoch != ticket.m_epoch ||
+        entry->second.m_lifecycle != HotKeyLifecycle::kRemoving) {
+      return false;
+    }
+    entry->second.m_lifecycle = HotKeyLifecycle::kRegistered;
+    return true;
+  }
+
+  bool removeSucceeded(const HotKeyTicket &ticket)
+  {
+    auto entry = m_entries.find(ticket.m_id);
+    if (entry == m_entries.end() || entry->second.m_epoch != ticket.m_epoch ||
+        entry->second.m_lifecycle != HotKeyLifecycle::kRemoving) {
+      return false;
+    }
+    entry->second.m_lifecycle = HotKeyLifecycle::kRemoved;
+    return true;
+  }
+
+  bool canErase(const HotKeyTicket &ticket) const
+  {
+    const auto entry = m_entries.find(ticket.m_id);
+    return entry != m_entries.end() && entry->second.m_epoch == ticket.m_epoch &&
+           entry->second.m_lifecycle == HotKeyLifecycle::kRemoved &&
+           entry->second.m_callbacksInFlight == 0;
+  }
+
+  bool erase(const HotKeyTicket &ticket)
+  {
+    if (!canErase(ticket)) {
+      return false;
+    }
+    m_entries.erase(ticket.m_id);
+    return true;
+  }
+
+  bool registered(const HotKeyTicket &ticket) const
+  {
+    const auto entry = m_entries.find(ticket.m_id);
+    return entry != m_entries.end() && entry->second.m_epoch == ticket.m_epoch &&
+           entry->second.m_lifecycle == HotKeyLifecycle::kRegistered;
+  }
+
+private:
+  struct Entry
+  {
+    std::uint64_t m_epoch{};
+    HotKeyLifecycle m_lifecycle{HotKeyLifecycle::kRegistered};
+    std::size_t m_callbacksInFlight{};
+  };
+
+  std::uint64_t m_epoch{};
+  std::map<std::uint32_t, Entry> m_entries;
+};
+
+inline bool canonicalClipboardBytes(
+    const std::array<const std::uint8_t *, 3> &data,
+    const std::array<std::size_t, 3> &lengths,
+    const std::array<bool, 3> &present, std::vector<std::uint8_t> &bytes
+)
+{
+  for (std::size_t index = 0; index < present.size(); ++index) {
+    if ((!present[index] && lengths[index] != 0) ||
+        (present[index] && lengths[index] != 0 && data[index] == nullptr)) {
+      bytes.clear();
+      return false;
+    }
+  }
+
+  std::uint8_t formatBitmap = 0;
+  for (std::size_t index = 0; index < present.size(); ++index) {
+    if (present[index]) {
+      formatBitmap = static_cast<std::uint8_t>(formatBitmap | (1u << index));
+    }
+  }
+  bytes = {1, formatBitmap};
+  for (std::size_t index = 0; index < present.size(); ++index) {
+    if (!present[index]) {
+      continue;
+    }
+    bytes.push_back(static_cast<std::uint8_t>(index + 1));
+    const std::uint64_t length = lengths[index];
+    for (int shift = 56; shift >= 0; shift -= 8) {
+      bytes.push_back(static_cast<std::uint8_t>((length >> shift) & 0xffu));
+    }
+    if (lengths[index] != 0) {
+      bytes.insert(bytes.end(), data[index], data[index] + lengths[index]);
+    }
+  }
+  return true;
+}
