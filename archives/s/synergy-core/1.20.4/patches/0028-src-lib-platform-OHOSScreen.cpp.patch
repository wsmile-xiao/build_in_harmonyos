+
+void OHOSScreen::setOptions(const OptionsList &options)
+{
+  KeyModifierMask halfDuplex = 0;
+  for (std::size_t i = 0; i + 1 < options.size(); i += 2) {
+    if (options[i] == kOptionHalfDuplexCapsLock && options[i + 1] != 0) {
+      halfDuplex |= KeyModifierCapsLock;
+    } else if (options[i] == kOptionHalfDuplexNumLock && options[i + 1] != 0) {
+      halfDuplex |= KeyModifierNumLock;
+    } else if (options[i] == kOptionHalfDuplexScrollLock && options[i + 1] != 0) {
