+
+void OHOSScreen::onMouseEvent(std::int32_t action, std::int32_t nativeButton, SInt32 x, SInt32 y)
+{
+  if (action == MOUSE_ACTION_BUTTON_DOWN || action == MOUSE_ACTION_BUTTON_UP) {
+    const ButtonID button = mapMouseButtonFromOHOS(nativeButton);
+    if (button == kButtonNone) {
+      return;
+    }
+    if (nativeButton >= 0 && static_cast<std::size_t>(nativeButton) < m_buttons.size()) {
+      std::lock_guard<std::mutex> lock(m_stateMutex);
+      m_buttons[static_cast<std::size_t>(nativeButton)] = action == MOUSE_ACTION_BUTTON_DOWN;
+    }
+    const Event::Type type = action == MOUSE_ACTION_BUTTON_DOWN
+                                 ? m_events->forIPrimaryScreen().buttonDown()
+                                 : m_events->forIPrimaryScreen().buttonUp();
+    sendEvent(type, ButtonInfo::alloc(button, m_keyState->getActiveModifiers()));
+    return;
+  }
+
+  if (action != MOUSE_ACTION_MOVE) {
+    return;
+  }
+
+  SInt32 deltaX = 0;
+  SInt32 deltaY = 0;
+  bool onScreen = false;
+  bool discardWarp = false;
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    onScreen = m_isOnScreen;
+    if (!onScreen &&
+        (!deskflow::platform::checkedPointerDifference(x, m_cursorX, deltaX) ||
+         !deskflow::platform::checkedPointerDifference(y, m_cursorY, deltaY))) {
+      return;
+    }
+    if (m_warpPending && monotonicMicroseconds() >= m_warpPendingExpiresAt) {
+      m_warpPending = false;
+      m_warpPendingExpiresAt = 0;
+    }
+    discardWarp = m_warpPending && x == m_cursorX && y == m_cursorY;
+    if (discardWarp) {
+      m_warpPending = false;
+      m_warpPendingExpiresAt = 0;
+    }
+    m_cursorX = x;
+    m_cursorY = y;
+  }
+  if (discardWarp) {
+    return;
+  }
+
+  if (onScreen) {
+    sendEvent(m_events->forIPrimaryScreen().motionOnPrimary(), MotionInfo::alloc(x, y));
+    return;
+  }
+
+  if (deltaX != 0 || deltaY != 0) {
+    sendEvent(m_events->forIPrimaryScreen().motionOnSecondary(), MotionInfo::alloc(deltaX, deltaY));
+  }
+  SInt32 centerX = 0;
+  SInt32 centerY = 0;
+  getCursorCenter(centerX, centerY);
+  if (deskflow::platform::pointerDistanceExceeds(x, centerX, kRecenterDistance) ||
+      deskflow::platform::pointerDistanceExceeds(y, centerY, kRecenterDistance)) {
+    warpCursor(centerX, centerY);
+  }
+}
+
+void OHOSScreen::onAxisEvent(InputEvent_AxisAction action, double horizontal, double vertical)
+{
+  if (action != AXIS_ACTION_UPDATE) {
+    return;
+  }
+  SInt32 xDelta = 0;
+  SInt32 yDelta = 0;
+  if (!deskflow::platform::checkedAxisConversion(horizontal, kWheelDelta, xDelta) ||
+      !deskflow::platform::checkedAxisConversion(vertical, kWheelDelta, yDelta)) {
+    return;
+  }
+  if (xDelta != 0 || yDelta != 0) {
+    sendEvent(m_events->forIPrimaryScreen().wheel(), WheelInfo::alloc(xDelta, yDelta));
+  }
+}
