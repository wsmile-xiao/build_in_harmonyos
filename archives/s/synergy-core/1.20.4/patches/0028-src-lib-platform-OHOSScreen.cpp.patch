+bool OHOSScreen::injectionEchoTrackingActive(InjectionTokenClass tokenClass) const
+{
+  static_cast<void>(tokenClass);
+  // InputKit monitoring does not expose a trusted injected-source marker. An
+  // actionTime and payload match can therefore collide with physical input.
+  // Keep correlation fail-open until the platform provides source identity.
+  return false;
+}
+
+bool OHOSScreen::inputRoleAllowsInjection(
+    InjectionTokenClass tokenClass, bool recenterWarp
+) const
+{
+  const auto role = m_isPrimary ? deskflow::platform::NativeInputRole::kCaptureServer
+                                : deskflow::platform::NativeInputRole::kInjectClient;
+  return deskflow::platform::NativeInputRolePolicy::allowsInjection(
+      role, tokenClass, recenterWarp
+  );
+}
+
+std::int64_t OHOSScreen::beginInjectionToken(InjectionFingerprint fingerprint) const
+{
+  const bool trackEcho = injectionEchoTrackingActive(fingerprint.m_class);
+  const std::int64_t now = m_native.m_monotonicMicroseconds();
+  fingerprint.m_epoch = m_nativeEventGeneration.load(std::memory_order_acquire);
+  std::lock_guard<std::mutex> lock(m_injectionTokenMutex);
+  std::int64_t actionTime = 0;
+  try {
+    actionTime = m_injectionEchoTracker.begin(now, fingerprint, trackEcho);
+  } catch (const std::bad_alloc &) {
+    actionTime = 0;
+  }
+  if (actionTime == 0 && !m_injectionTokenOverflowLogged) {
+    LOG((CLOG_ERR "OpenHarmony injected-input token allocation or sequence failed; refusing injection"));
+    m_injectionTokenOverflowLogged = true;
+  } else if (actionTime != 0 && m_injectionEchoTracker.pending() < kMaxPendingInjectionTokens / 2) {
+    m_injectionTokenOverflowLogged = false;
+  }
+  return actionTime;
+}
+
+void OHOSScreen::finishInjectionToken(std::int64_t actionTime, bool success) const
+{
+  std::lock_guard<std::mutex> lock(m_injectionTokenMutex);
+  m_injectionEchoTracker.finish(actionTime, success);
+  if (m_injectionEchoTracker.pending() < kMaxPendingInjectionTokens / 2) {
+    m_injectionTokenOverflowLogged = false;
+  }
+}
+
+bool OHOSScreen::consumeInjectionToken(const InjectionFingerprint &fingerprint) const
+{
+  const std::int64_t now = m_native.m_monotonicMicroseconds();
+  std::lock_guard<std::mutex> lock(m_injectionTokenMutex);
+  const bool consumed = m_injectionEchoTracker.consume(now, fingerprint);
+  if (m_injectionEchoTracker.pending() < kMaxPendingInjectionTokens / 2) {
+    m_injectionTokenOverflowLogged = false;
+  }
+  return consumed;
+}
+
+void OHOSScreen::keyEventCallback(const Input_KeyEvent *event)
+{
+  if (event == nullptr) {
+    return;
+  }
+  auto *instance = acquireInstance();
+  std::uint64_t generation = 0;
+  if (instance != nullptr && instance->snapshotNativeEventGeneration(generation)) {
+    const std::int32_t action = OH_Input_GetKeyEventAction(event);
+    const std::int32_t code = OH_Input_GetKeyEventKeyCode(event);
+    const std::int64_t actionTime = OH_Input_GetKeyEventActionTime(event);
+    InjectionFingerprint fingerprint;
+    fingerprint.m_epoch = generation;
+    fingerprint.m_class = InjectionTokenClass::kKey;
+    fingerprint.m_actionTime = actionTime;
+    fingerprint.m_action = action;
+    fingerprint.m_code = code;
+    const bool injectedEcho = instance->consumeInjectionToken(fingerprint);
+    auto *data = new (std::nothrow) NativeEventData;
+    if (data != nullptr) {
+      data->m_kind = NativeEventKind::kKey;
+      data->m_generation = generation;
+      data->m_action = action;
+      data->m_code = code;
+      data->m_actionTime = actionTime;
+      data->m_injectedEcho = injectedEcho;
+      instance->enqueueNativeEvent(data);
+    }
+  }
+  releaseInstance(instance);
+}
+
+void OHOSScreen::mouseEventCallback(const Input_MouseEvent *event)
+{
+  if (event == nullptr) {
+    return;
+  }
+  auto *instance = acquireInstance();
+  std::uint64_t generation = 0;
+  if (instance != nullptr && instance->snapshotNativeEventGeneration(generation)) {
+    const std::int32_t action = OH_Input_GetMouseEventAction(event);
+    const std::int32_t code = OH_Input_GetMouseEventButton(event);
+    const std::int32_t x = OH_Input_GetMouseEventGlobalX(event);
+    const std::int32_t y = OH_Input_GetMouseEventGlobalY(event);
+    const std::int64_t actionTime = OH_Input_GetMouseEventActionTime(event);
+    InjectionFingerprint fingerprint;
+    fingerprint.m_epoch = generation;
+    fingerprint.m_class = InjectionTokenClass::kMouse;
+    fingerprint.m_actionTime = actionTime;
+    fingerprint.m_action = action;
+    fingerprint.m_code = code;
+    fingerprint.m_x = x;
+    fingerprint.m_y = y;
+    const bool injectedEcho = instance->consumeInjectionToken(fingerprint);
+    auto *data = new (std::nothrow) NativeEventData;
+    if (data != nullptr) {
+      data->m_kind = NativeEventKind::kMouse;
+      data->m_generation = generation;
+      data->m_action = action;
+      data->m_code = code;
+      data->m_x = x;
+      data->m_y = y;
+      data->m_actionTime = actionTime;
+      data->m_injectedEcho = injectedEcho;
+      instance->enqueueNativeEvent(data);
+    }
+  }
+  releaseInstance(instance);
+}
+
+void OHOSScreen::axisEventCallback(const Input_AxisEvent *event)
+{
+  if (event == nullptr) {
+    return;
+  }
+  auto *instance = acquireInstance();
+  std::uint64_t generation = 0;
+  if (instance != nullptr && instance->snapshotNativeEventGeneration(generation)) {
+    InputEvent_AxisAction action = AXIS_ACTION_CANCEL;
+    std::int64_t actionTime = 0;
+    if (OH_Input_GetAxisEventAction(event, &action) == INPUT_SUCCESS &&
+        OH_Input_GetAxisEventActionTime(event, &actionTime) == INPUT_SUCCESS) {
+      double horizontal = 0.0;
+      double vertical = 0.0;
+      const Input_Result horizontalResult = OH_Input_GetAxisEventAxisValue(
+          event, AXIS_TYPE_SCROLL_HORIZONTAL, &horizontal
+      );
+      const Input_Result verticalResult =
+          OH_Input_GetAxisEventAxisValue(event, AXIS_TYPE_SCROLL_VERTICAL, &vertical);
+      std::int64_t horizontalFingerprint = 0;
+      std::int64_t verticalFingerprint = 0;
+      if (horizontalResult == INPUT_SUCCESS && verticalResult == INPUT_SUCCESS &&
+          axisFingerprintValue(horizontal, horizontalFingerprint) &&
+          axisFingerprintValue(vertical, verticalFingerprint)) {
+        InjectionFingerprint fingerprint;
+        fingerprint.m_epoch = generation;
+        fingerprint.m_class = InjectionTokenClass::kAxis;
+        fingerprint.m_actionTime = actionTime;
+        fingerprint.m_action = static_cast<std::int32_t>(action);
+        fingerprint.m_horizontal = horizontalFingerprint;
+        fingerprint.m_vertical = verticalFingerprint;
+        const bool injectedEcho = instance->consumeInjectionToken(fingerprint);
+        auto *data = new (std::nothrow) NativeEventData;
+        if (data != nullptr) {
+          data->m_kind = NativeEventKind::kAxis;
+          data->m_generation = generation;
+          data->m_action = static_cast<std::int32_t>(action);
+          data->m_actionTime = actionTime;
+          data->m_injectedEcho = injectedEcho;
+          data->m_horizontal = horizontal;
+          data->m_vertical = vertical;
+          instance->enqueueNativeEvent(data);
+        }
+      }
+    }
+  }
+  releaseInstance(instance);
+}
+
+void OHOSScreen::hotkeyCallback(Input_Hotkey *hotkey)
+{
+  auto *instance = acquireInstance();
+  std::uint64_t generation = 0;
+  if (instance != nullptr && instance->snapshotNativeEventGeneration(generation)) {
+    std::int32_t *preKeys = nullptr;
+    std::int32_t preKeyCount = 0;
+    std::int32_t finalKey = 0;
+    if (OH_Input_GetPreKeys(hotkey, &preKeys, &preKeyCount) == INPUT_SUCCESS &&
+        OH_Input_GetFinalKey(hotkey, &finalKey) == INPUT_SUCCESS && preKeys != nullptr &&
+        preKeyCount > 0 && preKeyCount <= 2) {
+      std::array<std::int32_t, 2> normalizedPreKeys{};
+      std::copy_n(preKeys, preKeyCount, normalizedPreKeys.begin());
+      std::sort(normalizedPreKeys.begin(), normalizedPreKeys.begin() + preKeyCount);
+      deskflow::platform::HotKeyTicket ticket;
+      bool callbackStarted = false;
+      {
+        std::lock_guard<std::mutex> lock(instance->m_stateMutex);
+        for (const auto &[id, registration] : instance->m_hotkeys) {
+          if (registration.m_hotkey == hotkey && registration.m_finalKey == finalKey &&
+              registration.m_preKeyCount == preKeyCount &&
+              std::equal(
+                  registration.m_preKeys.begin(),
+                  registration.m_preKeys.begin() + preKeyCount,
+                  normalizedPreKeys.begin()
+              )) {
+            ticket = deskflow::platform::HotKeyTicket{id, registration.m_epoch};
+            callbackStarted = instance->m_hotkeyRegistry.beginCallback(ticket);
+            break;
+          }
+        }
+      }
+      if (callbackStarted) {
+        auto *data = new (std::nothrow) NativeEventData;
+        if (data != nullptr) {
+          data->m_kind = NativeEventKind::kHotkey;
+          data->m_generation = generation;
+          data->m_code = finalKey;
+          data->m_hotkeyPreKeyCount = preKeyCount;
+          data->m_id = ticket.m_id;
+          data->m_epoch = ticket.m_epoch;
+          std::copy_n(
+              normalizedPreKeys.begin(), preKeyCount, data->m_hotkeyPreKeys.begin()
+          );
+          instance->enqueueNativeEvent(data);
+        }
+        bool cleanupReady = false;
+        {
+          std::lock_guard<std::mutex> lock(instance->m_stateMutex);
+          cleanupReady = instance->m_hotkeyRegistry.endCallback(ticket);
+        }
+        if (cleanupReady) {
+          instance->queueHotkeyCleanup(ticket.m_id, ticket.m_epoch);
+        }
+      }
+    }
+  }
+  releaseInstance(instance);
+}
+
+void OHOSScreen::injectionAuthorizationCallback(Input_InjectionStatus status)
+{
+  auto &broker = authorizationBroker();
+  {
+    std::lock_guard<std::mutex> lock(broker.m_mutex);
+    broker.m_coordinator.hint(static_cast<int>(status));
+  }
+  broker.m_condition.notify_all();
+}
