+
+UInt32 OHOSScreen::registerHotKey(KeyID key, KeyModifierMask mask)
+{
+  constexpr KeyModifierMask supported =
+      KeyModifierShift | KeyModifierControl | KeyModifierAlt | KeyModifierSuper;
+  if ((mask & ~supported) != 0) {
+    LOG((CLOG_ERR "OpenHarmony hotkey contains unsupported modifiers, mask=0x%04x", mask));
+    return 0;
+  }
+
+  std::vector<int32_t> modifiers = hotkeyModifiers(mask);
+  if (modifiers.empty() || modifiers.size() > 2) {
+    LOG((CLOG_ERR "OpenHarmony hotkeys require one or two modifiers, mask=0x%04x", mask));
+    return 0;
+  }
+  std::sort(modifiers.begin(), modifiers.end());
+
+  int32_t finalKey = 0;
+  if (!m_keyState->mapKeyToOHOS(key, finalKey)) {
+    LOG((CLOG_ERR "cannot map Deskflow hotkey 0x%04x to OpenHarmony", key));
+    return 0;
+  }
+
+  Input_Hotkey *hotkey = OH_Input_CreateHotkey();
+  if (hotkey == nullptr) {
+    return 0;
+  }
+  OH_Input_SetPreKeys(hotkey, modifiers.data(), static_cast<int32_t>(modifiers.size()));
+  OH_Input_SetFinalKey(hotkey, finalKey);
+  OH_Input_SetRepeat(hotkey, false);
+
+  UInt32 id = 0;
+  std::uint64_t registrationEpoch = 0;
+  bool registrationInserted = false;
+  bool registrationAllocationFailed = false;
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    do {
+      id = m_nextHotkeyId++;
+    } while (id == 0 || m_hotkeys.find(id) != m_hotkeys.end());
+    HotKeyRegistration registration;
+    registration.m_hotkey = hotkey;
+    registration.m_preKeyCount = static_cast<std::int32_t>(modifiers.size());
+    registration.m_finalKey = finalKey;
+    std::copy(modifiers.begin(), modifiers.end(), registration.m_preKeys.begin());
+    try {
+      registration.m_epoch = m_hotkeyRegistry.add(id);
+      registrationEpoch = registration.m_epoch;
+      registrationInserted = m_hotkeys.emplace(id, registration).second;
+    } catch (const std::bad_alloc &) {
+      registrationAllocationFailed = true;
+    }
+    if (!registrationInserted && registrationEpoch != 0) {
+      const deskflow::platform::HotKeyTicket ticket{id, registrationEpoch};
+      m_hotkeyRegistry.beginRemove(ticket);
+      m_hotkeyRegistry.removeSucceeded(ticket);
+      m_hotkeyRegistry.erase(ticket);
+    }
+  }
+  if (!registrationInserted) {
+    if (registrationAllocationFailed) {
+      LOG((CLOG_ERR "failed to allocate OpenHarmony hotkey registration"));
+    } else {
+      LOG((CLOG_ERR "OpenHarmony hotkey ID collision for %u", id));
+    }
+    m_native.m_destroyHotkey(&hotkey);
+    return 0;
+  }
+
+  const Input_Result result = OH_Input_AddHotkeyMonitor(hotkey, hotkeyCallback);
+  if (result != INPUT_SUCCESS) {
+    {
+      std::lock_guard<std::mutex> lock(m_stateMutex);
+      const auto registration = m_hotkeys.find(id);
+      if (registration != m_hotkeys.end()) {
+        const deskflow::platform::HotKeyTicket ticket{id, registration->second.m_epoch};
+        m_hotkeyRegistry.beginRemove(ticket);
+        m_hotkeyRegistry.removeSucceeded(ticket);
+        registrationEpoch = ticket.m_epoch;
+      }
+    }
+    LOG((CLOG_ERR "failed to register OpenHarmony hotkey, result=%d", result));
+    cleanupHotkey(id, registrationEpoch);
+    return 0;
+  }
+  return id;
+}
+
+void OHOSScreen::unregisterHotKey(UInt32 id)
+{
+  Input_Hotkey *hotkey = nullptr;
+  deskflow::platform::HotKeyTicket ticket;
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    const auto found = m_hotkeys.find(id);
+    if (found == m_hotkeys.end()) {
+      return;
+    }
+    hotkey = found->second.m_hotkey;
+    ticket = deskflow::platform::HotKeyTicket{id, found->second.m_epoch};
+    if (!m_hotkeyRegistry.beginRemove(ticket)) {
+      return;
+    }
+  }
+  const Input_Result result = m_native.m_removeHotkey(hotkey, hotkeyCallback);
+  if (result != INPUT_SUCCESS) {
+    {
+      std::lock_guard<std::mutex> lock(m_stateMutex);
+      const auto found = m_hotkeys.find(id);
+      if (found != m_hotkeys.end() && found->second.m_hotkey == hotkey &&
+          found->second.m_epoch == ticket.m_epoch) {
+        m_hotkeyRegistry.removeFailed(ticket);
+      }
+      m_cleanupFailed = true;
+    }
+    LOG((CLOG_WARN "failed to unregister OpenHarmony hotkey %u, result=%d", id, result));
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    const auto found = m_hotkeys.find(id);
+    if (found == m_hotkeys.end() || found->second.m_hotkey != hotkey ||
+        found->second.m_epoch != ticket.m_epoch ||
+        !m_hotkeyRegistry.removeSucceeded(ticket)) {
+      m_cleanupFailed = true;
+      return;
+    }
+  }
+  queueHotkeyCleanup(ticket.m_id, ticket.m_epoch);
+}
+
+void OHOSScreen::cleanupHotkey(UInt32 id, std::uint64_t epoch)
+{
+  Input_Hotkey *hotkey = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(m_stateMutex);
+    const auto found = m_hotkeys.find(id);
+    const deskflow::platform::HotKeyTicket ticket{id, epoch};
+    if (found == m_hotkeys.end() || found->second.m_epoch != epoch ||
+        !m_hotkeyRegistry.erase(ticket)) {
+      return;
+    }
+    hotkey = found->second.m_hotkey;
+    m_hotkeys.erase(found);
+  }
+  if (hotkey != nullptr) {
+    m_native.m_destroyHotkey(&hotkey);
+  }
+}
+
+void OHOSScreen::drainHotkeyCleanup()
+{
+  for (;;) {
+    deskflow::platform::HotKeyTicket ticket;
+    {
+      std::lock_guard<std::mutex> lock(m_stateMutex);
+      const auto ready = std::find_if(
+          m_hotkeys.begin(), m_hotkeys.end(), [this](const auto &entry) {
+            return m_hotkeyRegistry.canErase(
+                deskflow::platform::HotKeyTicket{entry.first, entry.second.m_epoch}
+            );
+          }
+      );
+      if (ready == m_hotkeys.end()) {
+        return;
+      }
+      ticket = deskflow::platform::HotKeyTicket{ready->first, ready->second.m_epoch};
+    }
+    cleanupHotkey(ticket.m_id, ticket.m_epoch);
+  }
+}
