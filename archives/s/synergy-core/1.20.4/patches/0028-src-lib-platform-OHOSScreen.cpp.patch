+enum class AuthorizationPhase
+{
+  kDisabled,
+  kWaiting,
+  kReady,
+  kFailed
+};
+
+class AuthorizationCoordinator
+{
+public:
+  std::uint64_t begin()
+  {
+    ++m_epoch;
+    if (m_epoch == 0) {
+      ++m_epoch;
+    }
+    m_phase = AuthorizationPhase::kWaiting;
+    ++m_sequence;
+    return m_epoch;
+  }
+
+  void hint(int status)
+  {
+    m_hint = status;
+    ++m_sequence;
+  }
+
+  bool publishReady(std::uint64_t epoch)
+  {
+    if (!waiting(epoch)) {
+      return false;
+    }
+    m_phase = AuthorizationPhase::kReady;
+    ++m_sequence;
+    return true;
+  }
+
+  void fail(std::uint64_t epoch)
+  {
+    if (epoch == m_epoch && m_phase == AuthorizationPhase::kWaiting) {
+      m_phase = AuthorizationPhase::kFailed;
+      ++m_sequence;
+    }
+  }
+
+  void disable(std::uint64_t epoch)
+  {
+    if (epoch == m_epoch) {
+      m_phase = AuthorizationPhase::kDisabled;
+      ++m_sequence;
+    }
+  }
+
+  bool waiting(std::uint64_t epoch) const
+  {
+    return epoch == m_epoch && m_phase == AuthorizationPhase::kWaiting;
+  }
+
+  bool ready(std::uint64_t epoch) const
+  {
+    return epoch == m_epoch && m_phase == AuthorizationPhase::kReady;
+  }
+
+  int hint() const { return m_hint; }
+  std::uint64_t sequence() const { return m_sequence; }
+
+private:
+  std::uint64_t m_epoch{};
+  std::uint64_t m_sequence{};
+  int m_hint{};
+  AuthorizationPhase m_phase{AuthorizationPhase::kDisabled};
+};
