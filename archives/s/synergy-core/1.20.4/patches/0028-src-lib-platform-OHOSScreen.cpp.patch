+std::int64_t deadlineAfter(std::int64_t now, std::int64_t delay)
+{
+  if (now > std::numeric_limits<std::int64_t>::max() - delay) {
+    return std::numeric_limits<std::int64_t>::max();
+  }
+  return now + delay;
+}
