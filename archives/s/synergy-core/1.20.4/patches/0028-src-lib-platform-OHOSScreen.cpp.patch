+OHOSScreen::OHOSScreen(
+    bool isPrimary, IEventQueue *events, bool enableLangSync,
+    deskflow::ClientScrollDirection scrollDirection, const OHOSNativeDependencies &native
+)
+    : PlatformScreen(events, scrollDirection),
+      m_isPrimary(isPrimary),
+      m_events(events),
+      m_keyState(nullptr),
+      m_native(native),
+      m_isOnScreen(isPrimary)
+{
+  {
+    std::lock_guard<std::mutex> lock(s_instanceMutex);
+    if (s_instance != nullptr || s_constructionInProgress) {
+      throw std::runtime_error("only one OpenHarmony screen can be active in a process");
+    }
+    if (s_restartBlocked) {
+      throw std::runtime_error(
+          "cannot create another OpenHarmony screen after incomplete native callback cleanup"
+      );
+    }
+    s_interceptorCallbacks.mouseCallback = mouseEventCallback;
+    s_interceptorCallbacks.touchCallback = nullptr;
+    s_interceptorCallbacks.axisCallback = axisEventCallback;
+    s_constructionInProgress = true;
+  }
+
+  try {
+    m_keyState = new OHOSKeyState(
+        events, m_keyMap, AppUtil::instance().getKeyboardLayoutList(), enableLangSync, this
+    );
+
+    m_pasteboard = OH_Pasteboard_Create();
+    m_localPasteboardObserver = OH_PasteboardObserver_Create();
+    m_remotePasteboardObserver = OH_PasteboardObserver_Create();
+    if (m_pasteboard == nullptr || m_localPasteboardObserver == nullptr ||
+        m_remotePasteboardObserver == nullptr) {
+      throw std::runtime_error("failed to create OpenHarmony pasteboard objects");
+    }
+    const int localObserverResult = OH_PasteboardObserver_SetData(
+        m_localPasteboardObserver, this, pasteboardCallback, finalizePasteboardContext
+    );
+    if (localObserverResult != 0) {
+      throw std::runtime_error(
+          "failed to configure local OpenHarmony pasteboard observer, result=" +
+          std::to_string(localObserverResult)
+      );
+    }
+    const int remoteObserverResult = OH_PasteboardObserver_SetData(
+        m_remotePasteboardObserver, this, pasteboardCallback, finalizePasteboardContext
+    );
+    if (remoteObserverResult != 0) {
+      throw std::runtime_error(
+          "failed to configure remote OpenHarmony pasteboard observer, result=" +
+          std::to_string(remoteObserverResult)
+      );
+    }
+
+    if (!refreshShape(false)) {
+      throw std::runtime_error("failed to query OpenHarmony display layout");
+    }
+    getCursorPos(m_cursorX, m_cursorY);
+
+    m_nativeEventType = m_events->registerTypeOnce(m_nativeEventType, "OHOSScreen::nativeEvent");
+    m_events->adoptHandler(
+        m_nativeEventType, getEventTarget(),
+        new TMethodEventJob<OHOSScreen>(this, &OHOSScreen::handleNativeEvent)
+    );
+    m_nativeEventHandlerRegistered = true;
+    m_events->adoptHandler(
+        Event::kSystem, m_events->getSystemTarget(),
+        new TMethodEventJob<OHOSScreen>(this, &OHOSScreen::handleSystemEvent)
+    );
+    m_systemEventHandlerRegistered = true;
+
+    std::lock_guard<std::mutex> lock(s_instanceMutex);
+    s_instance = this;
+    s_constructionInProgress = false;
+  } catch (...) {
+    if (m_systemEventHandlerRegistered) {
+      m_events->removeHandler(Event::kSystem, m_events->getSystemTarget());
+      m_systemEventHandlerRegistered = false;
+    }
+    if (m_nativeEventHandlerRegistered) {
+      m_events->removeHandler(m_nativeEventType, getEventTarget());
+      m_nativeEventHandlerRegistered = false;
+    }
+    if (m_remotePasteboardObserver != nullptr) {
+      OH_PasteboardObserver_Destroy(m_remotePasteboardObserver);
+      m_remotePasteboardObserver = nullptr;
+    }
+    if (m_localPasteboardObserver != nullptr) {
+      OH_PasteboardObserver_Destroy(m_localPasteboardObserver);
+      m_localPasteboardObserver = nullptr;
+    }
+    if (m_pasteboard != nullptr) {
+      OH_Pasteboard_Destroy(m_pasteboard);
+      m_pasteboard = nullptr;
+    }
+    delete m_keyState;
+    m_keyState = nullptr;
+    std::lock_guard<std::mutex> lock(s_instanceMutex);
+    s_constructionInProgress = false;
+    throw;
+  }
+}
+
+OHOSScreen::~OHOSScreen()
+{
+  disable();
+
+  bool restartBlocked = false;
+  {
+    std::lock_guard<std::mutex> lock(s_instanceMutex);
+    if (m_cleanupFailed) {
+      s_restartBlocked = true;
+      restartBlocked = true;
+    }
+    if (s_instance == this) {
+      s_instance = nullptr;
+    }
+  }
+  if (restartBlocked) {
+    LOG((CLOG_CRIT "blocking OpenHarmony screen restart after incomplete native cleanup"));
+  }
+  {
+    std::unique_lock<std::mutex> lock(m_callbackMutex);
+    m_callbackCondition.wait(lock, [this] { return m_callbackCount.load() == 0; });
+  }
+  drainHotkeyCleanup();
+
+  if (m_systemEventHandlerRegistered) {
+    m_events->removeHandler(Event::kSystem, m_events->getSystemTarget());
+    m_systemEventHandlerRegistered = false;
+  }
+  if (m_nativeEventHandlerRegistered) {
+    m_events->removeHandler(m_nativeEventType, getEventTarget());
+    m_nativeEventHandlerRegistered = false;
+  }
+  if (!m_hotkeys.empty()) {
+    LOG((CLOG_CRIT "retaining OpenHarmony hotkey objects after monitor removal failure"));
+  }
+  if (m_localPasteboardSubscribed || m_remotePasteboardSubscribed) {
+    LOG((CLOG_CRIT "retaining OpenHarmony pasteboard objects after unsubscribe failure"));
+  } else {
+    if (m_remotePasteboardObserver != nullptr) {
+      const int result = OH_PasteboardObserver_Destroy(m_remotePasteboardObserver);
+      if (result != 0) {
+        LOG((CLOG_WARN "failed to destroy remote OpenHarmony pasteboard observer, result=%d", result));
+      }
+      m_remotePasteboardObserver = nullptr;
+    }
+    if (m_localPasteboardObserver != nullptr) {
+      const int result = OH_PasteboardObserver_Destroy(m_localPasteboardObserver);
+      if (result != 0) {
+        LOG((CLOG_WARN "failed to destroy local OpenHarmony pasteboard observer, result=%d", result));
+      }
+      m_localPasteboardObserver = nullptr;
+    }
+    if (m_pasteboard != nullptr) {
+      OH_Pasteboard_Destroy(m_pasteboard);
+      m_pasteboard = nullptr;
+    }
+  }
+  delete m_keyState;
+}
