+std::vector<int32_t> hotkeyModifiers(KeyModifierMask mask)
+{
+  std::vector<int32_t> modifiers;
+  if ((mask & KeyModifierShift) != 0) {
+    modifiers.push_back(KEYCODE_SHIFT_LEFT);
+  }
+  if ((mask & KeyModifierControl) != 0) {
+    modifiers.push_back(KEYCODE_CTRL_LEFT);
+  }
+  if ((mask & KeyModifierAlt) != 0) {
+    modifiers.push_back(KEYCODE_ALT_LEFT);
+  }
+  if ((mask & KeyModifierSuper) != 0) {
+    modifiers.push_back(KEYCODE_META_LEFT);
+  }
+  return modifiers;
+}
