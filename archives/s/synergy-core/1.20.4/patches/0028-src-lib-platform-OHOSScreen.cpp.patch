+class InjectionEchoTracker
+{
+public:
+  InjectionEchoTracker(std::size_t limit = 512, std::int64_t lifetime = 2'000'000)
+      : m_limit(limit), m_lifetime(lifetime)
+  {
+  }
+
+  std::int64_t begin(std::int64_t now, InjectionFingerprint fingerprint, bool track)
+  {
+    prune(now);
+    if (track && (m_limit == 0 || m_pending.size() >= m_limit)) {
+      return 0;
+    }
+    if (m_lastActionTime == std::numeric_limits<std::int64_t>::max()) {
+      if (!m_pending.empty()) {
+        return 0;
+      }
+      m_lastActionTime = std::max<std::int64_t>(now, 1);
+    } else {
+      m_lastActionTime = std::max<std::int64_t>(
+          std::max<std::int64_t>(now, 1), m_lastActionTime + 1
+      );
+    }
+    if (track) {
+      fingerprint.m_actionTime = m_lastActionTime;
+      m_pending.push_back(Token{fingerprint, deadlineAfter(now, m_lifetime)});
+    }
+    return m_lastActionTime;
+  }
+
+  void finish(std::int64_t actionTime, bool success)
+  {
+    if (success) {
+      return;
+    }
+    const auto token = std::find_if(
+        m_pending.begin(), m_pending.end(), [actionTime](const Token &candidate) {
+          return candidate.m_fingerprint.m_actionTime == actionTime;
+        }
+    );
+    if (token != m_pending.end()) {
+      m_pending.erase(token);
+    }
+  }
+
+  bool consume(std::int64_t now, const InjectionFingerprint &fingerprint)
+  {
+    if (fingerprint.m_actionTime <= 0) {
+      return false;
+    }
+    prune(now);
+    const auto token = std::find_if(
+        m_pending.begin(), m_pending.end(), [&fingerprint](const Token &candidate) {
+          return candidate.m_fingerprint == fingerprint;
+        }
+    );
+    if (token == m_pending.end()) {
+      return false;
+    }
+    m_pending.erase(token);
+    return true;
+  }
+
+  void clear() { m_pending.clear(); }
+  std::size_t pending() const { return m_pending.size(); }
+
+private:
+  struct Token
+  {
+    InjectionFingerprint m_fingerprint;
+    std::int64_t m_expiresAt{};
+  };
+
+  static std::int64_t deadlineAfter(std::int64_t now, std::int64_t delay)
+  {
+    if (delay > 0 && now > std::numeric_limits<std::int64_t>::max() - delay) {
+      return std::numeric_limits<std::int64_t>::max();
+    }
+    return now + std::max<std::int64_t>(delay, 0);
+  }
+
+  void prune(std::int64_t now)
+  {
+    m_pending.erase(
+        std::remove_if(
+            m_pending.begin(), m_pending.end(),
+            [now](const Token &token) { return token.m_expiresAt <= now; }
+        ),
+        m_pending.end()
+    );
+  }
+
+  std::size_t m_limit{};
+  std::int64_t m_lifetime{};
+  std::int64_t m_lastActionTime{};
+  std::deque<Token> m_pending;
+};
