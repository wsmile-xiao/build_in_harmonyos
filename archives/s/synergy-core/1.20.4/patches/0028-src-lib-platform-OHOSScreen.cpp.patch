+template <typename Integer>
+inline bool checkedAxisConversion(double value, long double scale, Integer &result)
+{
+  static_assert(std::numeric_limits<Integer>::is_integer);
+  static_assert(std::numeric_limits<Integer>::is_signed);
+  if (!std::isfinite(value) || !std::isfinite(scale) || scale <= 0.0L) {
+    return false;
+  }
+  const long double scaled = static_cast<long double>(value) * scale;
+  if (!std::isfinite(scaled)) {
+    return false;
+  }
+  const long double rounded = std::round(scaled);
+  const long double exclusiveLimit =
+      std::ldexp(1.0L, std::numeric_limits<Integer>::digits);
+  if (rounded < -exclusiveLimit || rounded >= exclusiveLimit) {
+    return false;
+  }
+  result = static_cast<Integer>(rounded);
+  return true;
+}
+
+inline bool checkedPointerCoordinate(std::int32_t origin, double offset, std::int32_t &coordinate)
+{
+  if (!std::isfinite(offset)) {
+    return false;
+  }
+  const double rounded = std::round(offset);
+  const double minimumOffset = static_cast<double>(std::numeric_limits<std::int32_t>::min()) -
+                               static_cast<double>(origin);
+  const double maximumOffset = static_cast<double>(std::numeric_limits<std::int32_t>::max()) -
+                               static_cast<double>(origin);
+  if (rounded < minimumOffset || rounded > maximumOffset) {
+    return false;
+  }
+  const std::int64_t combined = static_cast<std::int64_t>(origin) +
+                                static_cast<std::int64_t>(rounded);
+  coordinate = static_cast<std::int32_t>(combined);
+  return true;
+}
+
+inline bool checkedPointerDelta(
+    std::int32_t coordinate, std::int32_t delta, std::int32_t &result
+)
+{
+  const std::int64_t combined = static_cast<std::int64_t>(coordinate) +
+                                static_cast<std::int64_t>(delta);
+  if (combined < std::numeric_limits<std::int32_t>::min() ||
+      combined > std::numeric_limits<std::int32_t>::max()) {
+    return false;
+  }
+  result = static_cast<std::int32_t>(combined);
+  return true;
+}
+
+inline bool checkedPointerDifference(
+    std::int32_t coordinate, std::int32_t previous, std::int32_t &difference
+)
+{
+  const std::int64_t wideDifference = static_cast<std::int64_t>(coordinate) -
+                                      static_cast<std::int64_t>(previous);
+  if (wideDifference < std::numeric_limits<std::int32_t>::min() ||
+      wideDifference > std::numeric_limits<std::int32_t>::max()) {
+    return false;
+  }
+  difference = static_cast<std::int32_t>(wideDifference);
+  return true;
+}
+
+inline bool pointerDistanceExceeds(
+    std::int32_t coordinate, std::int32_t center, std::int32_t threshold
+)
+{
+  const std::int64_t difference = static_cast<std::int64_t>(coordinate) -
+                                  static_cast<std::int64_t>(center);
+  const std::int64_t wideThreshold = static_cast<std::int64_t>(threshold);
+  return threshold < 0 || difference < -wideThreshold || difference > wideThreshold;
+}
