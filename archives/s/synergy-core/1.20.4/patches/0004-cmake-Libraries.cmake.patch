--- /dev/null
+++ b/cmake/DeskflowBackendSelection.cmake
@@ -0,0 +1,32 @@
+function(
+  deskflow_select_backend
+  is_win32
+  have_posix
+  have_input
+  have_pasteboard
+  have_udmf
+  have_display
+  result_variable)
+  if(is_win32)
+    set(${result_variable} "WIN32" PARENT_SCOPE)
+    return()
+  endif()
+  if(NOT have_posix)
+    set(${result_variable} "INVALID_NO_POSIX" PARENT_SCOPE)
+    return()
+  endif()
+
+  set(native_count 0)
+  foreach(capability have_input have_pasteboard have_udmf have_display)
+    if(${capability})
+      math(EXPR native_count "${native_count} + 1")
+    endif()
+  endforeach()
+  if(native_count EQUAL 4)
+    set(${result_variable} "NATIVE" PARENT_SCOPE)
+  elseif(native_count EQUAL 0)
+    set(${result_variable} "POSIX" PARENT_SCOPE)
+  else()
+    set(${result_variable} "INVALID_PARTIAL" PARENT_SCOPE)
+  endif()
+endfunction()
