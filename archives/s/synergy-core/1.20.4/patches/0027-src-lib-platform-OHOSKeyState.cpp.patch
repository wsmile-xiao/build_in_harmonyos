+void OHOSKeyState::getKeyMap(deskflow::KeyMap &keyMap)
+{
+  for (std::size_t i = 0; i < kDefinitionCount; ++i) {
+    const auto &definition = s_keyDefinitions[i];
+    const KeyButton button = buttonForIndex(i);
+
+    if (definition.m_shifted == kKeyNone) {
+      addKeyMapEntry(keyMap, definition, button, definition.m_base, 0, 0);
+      continue;
+    }
+
+    if (isLetter(definition)) {
+      const KeyModifierMask sensitive = KeyModifierShift | KeyModifierCapsLock;
+      addKeyMapEntry(keyMap, definition, button, definition.m_base, 0, sensitive);
+      addKeyMapEntry(keyMap, definition, button, definition.m_base, KeyModifierShift | KeyModifierCapsLock, sensitive);
+      addKeyMapEntry(keyMap, definition, button, definition.m_shifted, KeyModifierShift, sensitive);
+      addKeyMapEntry(keyMap, definition, button, definition.m_shifted, KeyModifierCapsLock, sensitive);
+    } else {
+      addKeyMapEntry(keyMap, definition, button, definition.m_base, 0, KeyModifierShift);
+      addKeyMapEntry(keyMap, definition, button, definition.m_shifted, KeyModifierShift, KeyModifierShift);
+    }
+  }
+}
+
+void OHOSKeyState::fakeKey(const Keystroke &keystroke)
+{
+  if (keystroke.m_type == Keystroke::kGroup) {
+    if (keystroke.m_data.m_group.m_group != 0) {
+      LOG_WARN(
+          "OpenHarmony has no public NDK API for selecting keyboard layout group %d", keystroke.m_data.m_group.m_group
+      );
+    }
+    return;
+  }
+
+  const auto &button = keystroke.m_data.m_button;
+  const std::int32_t keyCode = static_cast<std::int32_t>(button.m_client);
+  const std::int32_t result = injectKey(keyCode, button.m_press);
+  if (result != INPUT_SUCCESS) {
+    LOG_WARN(
+        "failed to inject OpenHarmony key code %d (%s), result=%d", keyCode, button.m_press ? "down" : "up", result
+    );
+  }
+}
