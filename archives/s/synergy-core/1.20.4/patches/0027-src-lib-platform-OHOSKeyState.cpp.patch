+KeyButton buttonForIndex(std::size_t index)
+{
+  return static_cast<KeyButton>(index + 1);
+}
+
+bool isLetter(const KeyDefinition &definition)
+{
+  return definition.m_base >= 'a' && definition.m_base <= 'z' && definition.m_shifted == definition.m_base - 'a' + 'A';
+}
+
+const KeyDefinition *findByOHOS(std::int32_t keyCode, std::size_t *indexOut = nullptr)
+{
+  for (std::size_t i = 0; i < kDefinitionCount; ++i) {
+    if (s_keyDefinitions[i].m_ohos == keyCode) {
+      if (indexOut != nullptr) {
+        *indexOut = i;
+      }
+      return &s_keyDefinitions[i];
+    }
+  }
+  return nullptr;
+}
+
+bool queryPressed(std::int32_t keyCode, bool &pressed)
+{
+  Input_KeyState *state = OH_Input_CreateKeyState();
+  if (state == nullptr) {
+    LOG_WARN("failed to allocate OpenHarmony key-state query for code %d", keyCode);
+    return false;
+  }
+
+  OH_Input_SetKeyCode(state, keyCode);
+  const Input_Result result = OH_Input_GetKeyState(state);
+  if (result == INPUT_SUCCESS) {
+    pressed = OH_Input_GetKeyPressed(state) == KEY_PRESSED;
+  }
+  OH_Input_DestroyKeyState(&state);
+  return result == INPUT_SUCCESS;
+}
+
+void updatePressedModifier(
+    KeyModifierMask &mask, KeyModifierMask modifier, std::initializer_list<std::int32_t> keyCodes
+)
+{
+  bool anyPressed = false;
+  bool allQueried = true;
+  for (const auto keyCode : keyCodes) {
+    bool pressed = false;
+    if (!queryPressed(keyCode, pressed)) {
+      allQueried = false;
+    } else if (pressed) {
+      anyPressed = true;
+    }
+  }
+
+  if (anyPressed) {
+    mask |= modifier;
+  } else if (allQueried) {
+    mask &= ~modifier;
+  }
+}
+
+void updateLockModifier(KeyModifierMask &mask, KeyModifierMask modifier, std::int32_t keyCode)
+{
+  std::int32_t enabled = 0;
+  if (OH_Input_GetFunctionKeyState(keyCode, &enabled) != INPUT_SUCCESS) {
+    return;
+  }
+  if (enabled != 0) {
+    mask |= modifier;
+  } else {
+    mask &= ~modifier;
+  }
+}
+
+KeyModifierMask
+applyModifierTransition(const OHOSKeyState &keyState, std::int32_t keyCode, bool press, KeyModifierMask mask)
+{
+  KeyModifierMask modifier = 0;
+  std::int32_t pairedKeyCode = KEYCODE_UNKNOWN;
+  switch (keyCode) {
+  case KEYCODE_SHIFT_LEFT:
+    modifier = KeyModifierShift;
+    pairedKeyCode = KEYCODE_SHIFT_RIGHT;
+    break;
+  case KEYCODE_SHIFT_RIGHT:
+    modifier = KeyModifierShift;
+    pairedKeyCode = KEYCODE_SHIFT_LEFT;
+    break;
+  case KEYCODE_CTRL_LEFT:
+    modifier = KeyModifierControl;
+    pairedKeyCode = KEYCODE_CTRL_RIGHT;
+    break;
+  case KEYCODE_CTRL_RIGHT:
+    modifier = KeyModifierControl;
+    pairedKeyCode = KEYCODE_CTRL_LEFT;
+    break;
+  case KEYCODE_ALT_LEFT:
+    modifier = KeyModifierAlt;
+    pairedKeyCode = KEYCODE_ALT_RIGHT;
+    break;
+  case KEYCODE_ALT_RIGHT:
+    modifier = KeyModifierAlt;
+    pairedKeyCode = KEYCODE_ALT_LEFT;
+    break;
+  case KEYCODE_META_LEFT:
+    modifier = KeyModifierSuper;
+    pairedKeyCode = KEYCODE_META_RIGHT;
+    break;
+  case KEYCODE_META_RIGHT:
+    modifier = KeyModifierSuper;
+    pairedKeyCode = KEYCODE_META_LEFT;
+    break;
+  case KEYCODE_CAPS_LOCK:
+    updateLockModifier(mask, KeyModifierCapsLock, KEYCODE_CAPS_LOCK);
+    return mask;
+  case KEYCODE_NUM_LOCK:
+    updateLockModifier(mask, KeyModifierNumLock, KEYCODE_NUM_LOCK);
+    return mask;
+  case KEYCODE_SCROLL_LOCK:
+    updateLockModifier(mask, KeyModifierScrollLock, KEYCODE_SCROLL_LOCK);
+    return mask;
+  default:
+    break;
+  }
+
+  if (press) {
+    mask |= modifier;
+  } else if (pairedKeyCode == KEYCODE_UNKNOWN || !keyState.isKeyDown(keyState.mapKeyButtonFromOHOS(pairedKeyCode))) {
+    mask &= ~modifier;
+  }
+  return mask;
+}
+
+void addKeyMapEntry(
+    deskflow::KeyMap &keyMap, const KeyDefinition &definition, KeyButton button, KeyID id, KeyModifierMask required,
+    KeyModifierMask sensitive
+)
+{
+  deskflow::KeyMap::KeyItem item{};
+  item.m_id = id;
+  item.m_group = 0;
+  item.m_button = button;
+  item.m_required = required;
+  item.m_sensitive = sensitive;
+  item.m_client = static_cast<UInt32>(definition.m_ohos);
+  deskflow::KeyMap::initModifierKey(item);
+  keyMap.addKeyEntry(item);
+}
