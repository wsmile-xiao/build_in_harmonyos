+SInt32 OHOSKeyState::pollActiveGroup() const
+{
+  // InputKit exposes physical key codes but no NDK keyboard-layout group API.
+  return 0;
+}
+
+void OHOSKeyState::pollPressedKeys(KeyButtonSet &pressedKeys) const
+{
+  for (std::size_t i = 0; i < kDefinitionCount; ++i) {
+    bool pressed = false;
+    if (queryPressed(s_keyDefinitions[i].m_ohos, pressed) && pressed) {
+      pressedKeys.insert(buttonForIndex(i));
+    }
+  }
+}
