+std::int32_t OHOSKeyState::injectKey(std::int32_t keyCode, bool press) const
+{
+  if (m_screen != nullptr &&
+      !m_screen->inputRoleAllowsInjection(OHOSScreen::InjectionTokenClass::kKey, false)) {
+    return INPUT_SERVICE_EXCEPTION;
+  }
+  Input_KeyEvent *event = OH_Input_CreateKeyEvent();
+  if (event == nullptr) {
+    LOG_WARN("failed to allocate OpenHarmony key event for code %d", keyCode);
+    return INPUT_SERVICE_EXCEPTION;
+  }
+
+  OH_Input_SetKeyEventKeyCode(event, keyCode);
+  OH_Input_SetKeyEventAction(event, press ? KEY_ACTION_DOWN : KEY_ACTION_UP);
+  std::int64_t actionTime = 0;
+  if (m_screen != nullptr) {
+    OHOSScreen::InjectionFingerprint fingerprint;
+    fingerprint.m_class = OHOSScreen::InjectionTokenClass::kKey;
+    fingerprint.m_action = press ? KEY_ACTION_DOWN : KEY_ACTION_UP;
+    fingerprint.m_code = keyCode;
+    actionTime = m_screen->beginInjectionToken(fingerprint);
+    if (actionTime == 0) {
+      OH_Input_DestroyKeyEvent(&event);
+      return INPUT_SERVICE_EXCEPTION;
+    }
+    OH_Input_SetKeyEventActionTime(event, actionTime);
+  }
+  const std::int32_t result = OH_Input_InjectKeyEvent(event);
+  if (m_screen != nullptr) {
+    m_screen->finishInjectionToken(actionTime, result == INPUT_SUCCESS);
+  }
+  OH_Input_DestroyKeyEvent(&event);
+  return result;
+}
+
+bool OHOSKeyState::fakeCtrlAltDel()
+{
+  bool success = true;
+  success = injectKey(KEYCODE_CTRL_LEFT, true) == INPUT_SUCCESS && success;
+  success = injectKey(KEYCODE_ALT_LEFT, true) == INPUT_SUCCESS && success;
+  success = injectKey(KEYCODE_FORWARD_DEL, true) == INPUT_SUCCESS && success;
+  success = injectKey(KEYCODE_FORWARD_DEL, false) == INPUT_SUCCESS && success;
+  success = injectKey(KEYCODE_ALT_LEFT, false) == INPUT_SUCCESS && success;
+  success = injectKey(KEYCODE_CTRL_LEFT, false) == INPUT_SUCCESS && success;
+  return success;
+}
+
+bool OHOSKeyState::fakeMediaKey(KeyID id)
+{
+  std::int32_t keyCode = 0;
+  if (!mapKeyToOHOS(id, keyCode)) {
+    return false;
+  }
+  const bool press = injectKey(keyCode, true) == INPUT_SUCCESS;
+  const bool release = injectKey(keyCode, false) == INPUT_SUCCESS;
+  return press && release;
+}
+
+KeyModifierMask OHOSKeyState::pollActiveModifiers() const
+{
+  KeyModifierMask mask = getActiveModifiers();
+  updatePressedModifier(mask, KeyModifierShift, {KEYCODE_SHIFT_LEFT, KEYCODE_SHIFT_RIGHT});
+  updatePressedModifier(mask, KeyModifierControl, {KEYCODE_CTRL_LEFT, KEYCODE_CTRL_RIGHT});
+  updatePressedModifier(mask, KeyModifierAlt, {KEYCODE_ALT_LEFT, KEYCODE_ALT_RIGHT});
+  updatePressedModifier(mask, KeyModifierSuper, {KEYCODE_META_LEFT, KEYCODE_META_RIGHT});
+  updateLockModifier(mask, KeyModifierCapsLock, KEYCODE_CAPS_LOCK);
+  updateLockModifier(mask, KeyModifierNumLock, KEYCODE_NUM_LOCK);
+  updateLockModifier(mask, KeyModifierScrollLock, KEYCODE_SCROLL_LOCK);
+  return mask;
+}
