+KeyID OHOSKeyState::mapKeyFromOHOS(std::int32_t keyCode, KeyModifierMask mask) const
+{
+  const KeyDefinition *definition = findByOHOS(keyCode);
+  if (definition == nullptr) {
+    return kKeyNone;
+  }
+
+  if (definition->m_shifted == kKeyNone) {
+    return definition->m_base;
+  }
+
+  const bool shifted = (mask & KeyModifierShift) != 0;
+  if (isLetter(*definition)) {
+    const bool capsLocked = (mask & KeyModifierCapsLock) != 0;
+    return shifted != capsLocked ? definition->m_shifted : definition->m_base;
+  }
+  return shifted ? definition->m_shifted : definition->m_base;
+}
+
+KeyButton OHOSKeyState::mapKeyButtonFromOHOS(std::int32_t keyCode) const
+{
+  std::size_t index = 0;
+  return findByOHOS(keyCode, &index) == nullptr ? 0 : buttonForIndex(index);
+}
+
+bool OHOSKeyState::mapKeyToOHOS(KeyID id, std::int32_t &keyCode) const
+{
+  if (id == kKeyNone) {
+    return false;
+  }
+  for (const auto &definition : s_keyDefinitions) {
+    if (definition.m_base == id) {
+      keyCode = definition.m_ohos;
+      return true;
+    }
+  }
+  for (const auto &definition : s_keyDefinitions) {
+    if (definition.m_shifted == id) {
+      keyCode = definition.m_ohos;
+      return true;
+    }
+  }
+  return false;
+}
+
+bool OHOSKeyState::translateKeyEvent(const struct Input_KeyEvent *event, KeyEvent &translated) const
+{
+  if (event == nullptr) {
+    return false;
+  }
+
+  return translateKeyEvent(
+      OH_Input_GetKeyEventKeyCode(event), OH_Input_GetKeyEventAction(event), translated
+  );
+}
+
+bool OHOSKeyState::translateKeyEvent(std::int32_t keyCode, std::int32_t action, KeyEvent &translated) const
+{
+  if (action != KEY_ACTION_DOWN && action != KEY_ACTION_UP && action != KEY_ACTION_CANCEL) {
+    return false;
+  }
+
+  const KeyButton button = mapKeyButtonFromOHOS(keyCode);
+  if (button == 0) {
+    LOG_DEBUG1("unmapped OpenHarmony key code: %d", keyCode);
+    return false;
+  }
+
+  const bool press = action == KEY_ACTION_DOWN;
+  KeyModifierMask mask = applyModifierTransition(*this, keyCode, press, getActiveModifiers());
+  const KeyID id = mapKeyFromOHOS(keyCode, mask);
+  if (id == kKeyNone) {
+    return false;
+  }
+
+  translated.m_id = id;
+  translated.m_button = button;
+  translated.m_mask = mask;
+  translated.m_press = press;
+  translated.m_repeat = press && isKeyDown(button);
+  return true;
+}
+
+bool OHOSKeyState::handleKeyEvent(const struct Input_KeyEvent *event, void *target)
+{
+  if (event == nullptr) {
+    return false;
+  }
+  return handleKeyEvent(
+      OH_Input_GetKeyEventKeyCode(event), OH_Input_GetKeyEventAction(event), target
+  );
+}
+
+bool OHOSKeyState::handleKeyEvent(std::int32_t keyCode, std::int32_t action, void *target)
+{
+  KeyEvent translated;
+  if (!translateKeyEvent(keyCode, action, translated)) {
+    return false;
+  }
+
+  onKey(translated.m_button, translated.m_press, translated.m_mask);
+  sendKeyEvent(
+      target, translated.m_press, translated.m_repeat, translated.m_id, translated.m_mask, 1, translated.m_button
+  );
+  return true;
+}
