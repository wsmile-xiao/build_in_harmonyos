+#pragma once
+
+struct PthreadCancelControlResult
+{
+  int m_setState;
+  int m_setType;
+
+  bool ok() const noexcept
+  {
+    return m_setState == 0 && m_setType == 0;
+  }
+};
+
+using PthreadCancelSetter = int (*)(int, int *);
+
+inline PthreadCancelControlResult configurePthreadCancelControl(
+    int disabledState, int deferredType, PthreadCancelSetter setState, PthreadCancelSetter setType
+) noexcept
+{
+  return {setState(disabledState, nullptr), setType(deferredType, nullptr)};
+}
