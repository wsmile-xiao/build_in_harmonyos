+#include "OHOSServerTaskBarReceiver.h"
+
+#include "arch/Arch.h"
+#include "base/Log.h"
+
+OHOSServerTaskBarReceiver::OHOSServerTaskBarReceiver(const BufferedLogOutputter *, IEventQueue *events)
+    : ServerTaskBarReceiver(events)
+{
+  ARCH->addReceiver(this);
+}
+
+OHOSServerTaskBarReceiver::~OHOSServerTaskBarReceiver()
+{
+  ARCH->removeReceiver(this);
+}
+
+void OHOSServerTaskBarReceiver::showStatus()
+{
+  LOG((CLOG_PRINT "%s", getToolTip().c_str()));
+}
+
+void OHOSServerTaskBarReceiver::runMenu(int, int)
+{
+  showStatus();
+}
+
+void OHOSServerTaskBarReceiver::primaryAction()
+{
+  showStatus();
+}
+
+const IArchTaskBarReceiver::Icon OHOSServerTaskBarReceiver::getIcon() const
+{
+  return nullptr;
+}
+
+IArchTaskBarReceiver *createTaskBarReceiver(const BufferedLogOutputter *logBuffer, IEventQueue *events)
+{
+  return new OHOSServerTaskBarReceiver(logBuffer, events);
+}
