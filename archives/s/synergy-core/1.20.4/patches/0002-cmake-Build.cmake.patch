--- a/cmake/Build.cmake
+++ b/cmake/Build.cmake
@@ -40,6 +40,9 @@
   if(WIN32)
     message(STATUS "Enabling warnings as errors (MSVC)")
     add_compile_options(/WX)
+  elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+    message(STATUS "Enabling warnings as errors (Clang, except driver-only arguments)")
+    add_compile_options(-Werror -Wno-error=unused-command-line-argument)
   elseif(UNIX)
     message(STATUS "Enabling warnings as errors (GNU/Clang)")
     add_compile_options(-Werror)
