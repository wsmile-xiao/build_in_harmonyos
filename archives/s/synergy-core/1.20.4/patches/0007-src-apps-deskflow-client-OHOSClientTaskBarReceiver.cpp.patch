+#include "OHOSClientTaskBarReceiver.h"
+
+#include "arch/Arch.h"
+#include "base/Log.h"
+
+OHOSClientTaskBarReceiver::OHOSClientTaskBarReceiver(const BufferedLogOutputter *, IEventQueue *events)
+    : ClientTaskBarReceiver(events)
+{
+  ARCH->addReceiver(this);
+}
+
+OHOSClientTaskBarReceiver::~OHOSClientTaskBarReceiver()
+{
+  ARCH->removeReceiver(this);
+}
+
+void OHOSClientTaskBarReceiver::showStatus()
+{
+  LOG((CLOG_PRINT "%s", getToolTip().c_str()));
+}
+
+void OHOSClientTaskBarReceiver::runMenu(int, int)
+{
+  showStatus();
+}
+
+void OHOSClientTaskBarReceiver::primaryAction()
+{
+  showStatus();
+}
+
+const IArchTaskBarReceiver::Icon OHOSClientTaskBarReceiver::getIcon() const
+{
+  return nullptr;
+}
+
+IArchTaskBarReceiver *createTaskBarReceiver(const BufferedLogOutputter *logBuffer, IEventQueue *events)
+{
+  return new OHOSClientTaskBarReceiver(logBuffer, events);
+}
