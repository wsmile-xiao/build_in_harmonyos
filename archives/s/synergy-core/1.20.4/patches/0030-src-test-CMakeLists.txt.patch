+void testInputRolePolicy()
+{
+  CHECK(NativeInputRolePolicy::capturesRawInput(NativeInputRole::kCaptureServer));
+  CHECK(!NativeInputRolePolicy::capturesRawInput(NativeInputRole::kInjectClient));
+  CHECK(!NativeInputRolePolicy::allowsInjection(
+      NativeInputRole::kCaptureServer, InjectionTokenClass::kKey, false
+  ));
+  CHECK(!NativeInputRolePolicy::allowsInjection(
+      NativeInputRole::kCaptureServer, InjectionTokenClass::kMouse, false
+  ));
+  CHECK(!NativeInputRolePolicy::allowsInjection(
+      NativeInputRole::kCaptureServer, InjectionTokenClass::kAxis, false
+  ));
+  CHECK(NativeInputRolePolicy::allowsInjection(
+      NativeInputRole::kCaptureServer, InjectionTokenClass::kMouse, true
+  ));
+  CHECK(NativeInputRolePolicy::allowsInjection(
+      NativeInputRole::kInjectClient, InjectionTokenClass::kKey, false
+  ));
+  CHECK(NativeInputRolePolicy::allowsInjection(
+      NativeInputRole::kInjectClient, InjectionTokenClass::kMouse, false
+  ));
+  CHECK(NativeInputRolePolicy::allowsInjection(
+      NativeInputRole::kInjectClient, InjectionTokenClass::kAxis, false
+  ));
+}
