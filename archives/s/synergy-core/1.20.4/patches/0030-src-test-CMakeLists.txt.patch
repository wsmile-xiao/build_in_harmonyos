+class TestFailure : public std::runtime_error
+{
+public:
+  TestFailure(const char *expression, int line)
+      : std::runtime_error(
+            "line=" + std::to_string(line) + " expression=" + expression
+        )
+  {
+  }
+};
+
+[[noreturn]] void fail(const char *expression, int line) { throw TestFailure(expression, line); }
+
+#define CHECK(expression) ((expression) ? static_cast<void>(0) : fail(#expression, __LINE__))
