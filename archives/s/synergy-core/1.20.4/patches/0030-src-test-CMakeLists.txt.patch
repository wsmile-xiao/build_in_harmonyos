+void testAxisConversions()
+{
+  std::int32_t wheel = 123;
+  CHECK(checkedAxisConversion(1.5, 120.0L, wheel));
+  CHECK(wheel == 180);
+  CHECK(checkedAxisConversion(2147483647.0, 1.0L, wheel));
+  CHECK(wheel == std::numeric_limits<std::int32_t>::max());
+  CHECK(checkedAxisConversion(-2147483648.0, 1.0L, wheel));
+  CHECK(wheel == std::numeric_limits<std::int32_t>::min());
+  wheel = 123;
+  CHECK(!checkedAxisConversion(2147483648.0, 1.0L, wheel));
+  CHECK(wheel == 123);
+  CHECK(!checkedAxisConversion(-2147483649.0, 1.0L, wheel));
+  CHECK(!checkedAxisConversion(std::numeric_limits<double>::quiet_NaN(), 120.0L, wheel));
+  CHECK(!checkedAxisConversion(std::numeric_limits<double>::infinity(), 120.0L, wheel));
+  CHECK(!checkedAxisConversion(-std::numeric_limits<double>::infinity(), 120.0L, wheel));
+  CHECK(!checkedAxisConversion(std::numeric_limits<double>::max(), 120.0L, wheel));
+
+  std::int64_t fingerprint = 0;
+  CHECK(checkedAxisConversion(-std::ldexp(1.0, 63), 1.0L, fingerprint));
+  CHECK(fingerprint == std::numeric_limits<std::int64_t>::min());
+  CHECK(!checkedAxisConversion(std::ldexp(1.0, 63), 1.0L, fingerprint));
+}
