+void testAuthorization()
+{
+  AuthorizationCoordinator coordinator;
+  const auto first = coordinator.begin();
+  coordinator.hint(2);
+  CHECK(!coordinator.ready(first));
+  CHECK(coordinator.publishReady(first));
+  CHECK(coordinator.ready(first));
+
+  const auto second = coordinator.begin();
+  coordinator.hint(1);
+  CHECK(coordinator.waiting(second));
+  coordinator.disable(second);
+  coordinator.hint(2);
+  CHECK(!coordinator.publishReady(second));
+
+  const auto third = coordinator.begin();
+  coordinator.hint(99);
+  CHECK(coordinator.waiting(third));
+  coordinator.fail(third);
+  CHECK(!coordinator.publishReady(third));
+
+  const auto fourth = coordinator.begin();
+  const auto sequence = coordinator.sequence();
+  coordinator.hint(1);
+  CHECK(coordinator.sequence() != sequence);
+  CHECK(coordinator.waiting(fourth));
+  coordinator.disable(fourth);
+  coordinator.hint(2);
+  CHECK(!coordinator.publishReady(fourth));
+}
