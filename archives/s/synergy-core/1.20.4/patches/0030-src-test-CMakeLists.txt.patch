+void testInjectionEcho()
+{
+  InjectionEchoTracker tracker(8, 100);
+  InjectionFingerprint key;
+  key.m_epoch = 7;
+  key.m_class = InjectionTokenClass::kKey;
+  key.m_action = 1;
+  key.m_code = 42;
+  key.m_actionTime = tracker.begin(1000, key, true);
+  CHECK(key.m_actionTime > 0);
+
+  auto realInterleaved = key;
+  realInterleaved.m_code = 43;
+  CHECK(!tracker.consume(1001, realInterleaved));
+  CHECK(tracker.consume(1001, key));
+  CHECK(!tracker.consume(1001, key));
+
+  InjectionFingerprint mouse;
+  mouse.m_epoch = 7;
+  mouse.m_class = InjectionTokenClass::kMouse;
+  mouse.m_action = 2;
+  mouse.m_code = 1;
+  mouse.m_x = 10;
+  mouse.m_y = 20;
+  mouse.m_actionTime = tracker.begin(1100, mouse, true);
+  auto wrongEpoch = mouse;
+  ++wrongEpoch.m_epoch;
+  CHECK(!tracker.consume(1101, wrongEpoch));
+  auto wrongClass = mouse;
+  wrongClass.m_class = InjectionTokenClass::kAxis;
+  CHECK(!tracker.consume(1101, wrongClass));
+  CHECK(tracker.consume(1101, mouse));
+
+  InjectionFingerprint expired = key;
+  expired.m_code = 99;
+  expired.m_actionTime = tracker.begin(1200, expired, true);
+  CHECK(!tracker.consume(1300, expired));
+
+  InjectionFingerprint failed = key;
+  failed.m_code = 100;
+  failed.m_actionTime = tracker.begin(1400, failed, true);
+  tracker.finish(failed.m_actionTime, false);
+  CHECK(!tracker.consume(1401, failed));
+
+  InjectionFingerprint untrusted = key;
+  untrusted.m_code = 101;
+  untrusted.m_actionTime = tracker.begin(1500, untrusted, false);
+  CHECK(untrusted.m_actionTime != 0);
+  CHECK(!tracker.consume(1501, untrusted));
+}
