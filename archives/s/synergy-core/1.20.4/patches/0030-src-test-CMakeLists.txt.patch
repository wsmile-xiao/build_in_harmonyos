+int main()
+{
+  struct TestCase
+  {
+    const char *m_id;
+    void (*m_run)();
+  };
+  const std::array<TestCase, 10> tests{
+      TestCase{"authorization_fail_closed", testAuthorization},
+      TestCase{"injection_echo_untrusted_policy", testInjectionEcho},
+      TestCase{"input_role_policy", testInputRolePolicy},
+      TestCase{"pointer_coordinate_bounds", testPointerCoordinates},
+      TestCase{"axis_numeric_boundaries", testAxisConversions},
+      TestCase{"native_failure_output_cleanup", testNativeFailureOutputCleanup},
+      TestCase{"clipboard_set_state", testClipboardSet},
+      TestCase{"clipboard_clear_state", testClipboardClear},
+      TestCase{"hotkey_deferred_cleanup", testHotKeys},
+      TestCase{"canonical_clipboard_encoding", testCanonicalClipboardEncoding},
+  };
+
+  std::size_t passed = 0;
+  for (const auto &test : tests) {
+    try {
+      test.m_run();
+      ++passed;
+      std::cout << "TEST_PASS id=" << test.m_id << '\n';
+    } catch (const std::exception &error) {
+      std::cout << "TEST_FAIL id=" << test.m_id << " reason=" << error.what() << '\n';
+    } catch (...) {
+      std::cout << "TEST_FAIL id=" << test.m_id << " reason=unknown\n";
+    }
+  }
+  const std::size_t failed = tests.size() - passed;
+  std::cout << "OHOS_SCREEN_STATE_TESTS tests=" << tests.size() << " passed=" << passed
+            << " failed=" << failed << '\n';
+  return failed == 0 ? 0 : 1;
+}
