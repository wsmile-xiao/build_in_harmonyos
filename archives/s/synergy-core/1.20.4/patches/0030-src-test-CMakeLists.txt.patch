+void testClipboardSet()
+{
+  ClipboardWriteTracker tracker;
+  const auto before = snapshot(true, 1, 10);
+  const auto after = snapshot(true, 2, 11);
+  tracker.reset(before);
+  auto generation = tracker.begin(ClipboardWriteKind::kSet, before, after.m_fingerprint, 2000);
+  CHECK(generation != 0);
+  CHECK(tracker.observe(after, true, 1000) == ClipboardObservation::kSuppressSelfWrite);
+  auto finish = tracker.finishSet(generation, true, after, 1001);
+  CHECK(finish.m_succeeded && !finish.m_notifyExternal);
+
+  tracker.reset(before);
+  generation = tracker.begin(ClipboardWriteKind::kSet, before, fingerprint(2), 2000);
+  CHECK(tracker.observe(snapshot(true, 3, 11), true, 1000) == ClipboardObservation::kNotifyExternal);
+
+  tracker.reset(before);
+  generation = tracker.begin(ClipboardWriteKind::kSet, before, fingerprint(2), 2000);
+  CHECK(tracker.observe(snapshot(true, 2, 12), true, 1000) == ClipboardObservation::kNotifyExternal);
+
+  const auto wrapBefore = snapshot(true, 1, std::numeric_limits<std::uint32_t>::max());
+  tracker.reset(wrapBefore);
+  generation = tracker.begin(ClipboardWriteKind::kSet, wrapBefore, fingerprint(2), 2000);
+  CHECK(tracker.observe(snapshot(true, 2, 0), true, 1000) == ClipboardObservation::kNotifyExternal);
+
+  tracker.reset(before);
+  generation = tracker.begin(ClipboardWriteKind::kSet, before, fingerprint(2), 2000);
+  CHECK(tracker.observe(after, false, 1000) == ClipboardObservation::kNotifyExternal);
+
+  tracker.reset(before);
+  generation = tracker.begin(ClipboardWriteKind::kSet, before, fingerprint(2), 2000);
+  CHECK(tracker.observe(snapshot(false, 0, 0, false), true, 1000) == ClipboardObservation::kNotifyExternal);
+
+  tracker.reset(after);
+  generation = tracker.begin(ClipboardWriteKind::kSet, after, after.m_fingerprint, 2000);
+  finish = tracker.finishSet(generation, true, after, 1000);
+  CHECK(finish.m_succeeded && !finish.m_notifyExternal);
+
+  tracker.reset(before);
+  generation = tracker.begin(ClipboardWriteKind::kSet, before, fingerprint(2), 1000);
+  CHECK(tracker.observe(after, true, 1000) == ClipboardObservation::kNotifyExternal);
+
+  tracker.reset(before);
+  generation = tracker.begin(ClipboardWriteKind::kSet, before, fingerprint(2), 2000);
+  CHECK(tracker.observe(after, true, 1000) == ClipboardObservation::kSuppressSelfWrite);
+  CHECK(tracker.observe(after, true, 1001) == ClipboardObservation::kNotifyExternal);
+
+  tracker.reset(before);
+  generation = tracker.begin(ClipboardWriteKind::kSet, before, fingerprint(2), 2000);
+  finish = tracker.finishSet(generation, true, after, 1000);
+  CHECK(finish.m_succeeded && tracker.generation() == generation);
+  CHECK(tracker.observe(after, true, 1001) == ClipboardObservation::kSuppressSelfWrite);
+  CHECK(tracker.generation() == 0);
+}
