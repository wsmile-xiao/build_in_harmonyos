+void testPointerCoordinates()
+{
+  std::int32_t coordinate = 123;
+  CHECK(checkedPointerCoordinate(10, 1.5, coordinate));
+  CHECK(coordinate == 12);
+  CHECK(checkedPointerCoordinate(std::numeric_limits<std::int32_t>::max(), 0.49, coordinate));
+  CHECK(coordinate == std::numeric_limits<std::int32_t>::max());
+  coordinate = 123;
+  CHECK(!checkedPointerCoordinate(std::numeric_limits<std::int32_t>::max(), 0.5, coordinate));
+  CHECK(coordinate == 123);
+  CHECK(!checkedPointerCoordinate(std::numeric_limits<std::int32_t>::min(), -0.5, coordinate));
+  CHECK(!checkedPointerCoordinate(0, std::numeric_limits<double>::infinity(), coordinate));
+  CHECK(!checkedPointerCoordinate(0, std::numeric_limits<double>::quiet_NaN(), coordinate));
+
+  CHECK(checkedPointerDelta(std::numeric_limits<std::int32_t>::max(), -1, coordinate));
+  CHECK(coordinate == std::numeric_limits<std::int32_t>::max() - 1);
+  coordinate = 123;
+  CHECK(!checkedPointerDelta(std::numeric_limits<std::int32_t>::max(), 1, coordinate));
+  CHECK(coordinate == 123);
+  CHECK(!checkedPointerDelta(std::numeric_limits<std::int32_t>::min(), -1, coordinate));
+  CHECK(checkedPointerDelta(std::numeric_limits<std::int32_t>::min(), 1, coordinate));
+  CHECK(coordinate == std::numeric_limits<std::int32_t>::min() + 1);
+
+  coordinate = 123;
+  CHECK(!checkedPointerDifference(
+      std::numeric_limits<std::int32_t>::max(),
+      std::numeric_limits<std::int32_t>::min(), coordinate
+  ));
+  CHECK(coordinate == 123);
+  CHECK(!checkedPointerDifference(
+      std::numeric_limits<std::int32_t>::min(),
+      std::numeric_limits<std::int32_t>::max(), coordinate
+  ));
+  CHECK(coordinate == 123);
+  CHECK(checkedPointerDifference(
+      std::numeric_limits<std::int32_t>::max(),
+      std::numeric_limits<std::int32_t>::max() - 1, coordinate
+  ));
+  CHECK(coordinate == 1);
+  CHECK(pointerDistanceExceeds(
+      std::numeric_limits<std::int32_t>::min(),
+      std::numeric_limits<std::int32_t>::max(), 32
+  ));
+}
