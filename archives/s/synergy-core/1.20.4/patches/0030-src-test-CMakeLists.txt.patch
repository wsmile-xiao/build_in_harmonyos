+void testNativeFailureOutputCleanup()
+{
+  int destroyCount = 0;
+  FakeNativeResource resource{&destroyCount};
+  const int createResult = -1;
+  {
+    NativeResourceOwner<FakeNativeResource, decltype(&destroyFakeNativeResource)> owner(
+        &resource, &destroyFakeNativeResource
+    );
+    CHECK(createResult != 0);
+    CHECK(owner.get() == &resource);
+  }
+  CHECK(destroyCount == 1);
+}
