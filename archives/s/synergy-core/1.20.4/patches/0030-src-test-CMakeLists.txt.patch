+cmake_minimum_required(VERSION 3.16)
+
+include("${CMAKE_CURRENT_LIST_DIR}/../../../cmake/DeskflowBackendSelection.cmake")
+
+set(test_count 0)
+set(pass_count 0)
+
+macro(check_selection test_id expected)
+  math(EXPR test_count "${test_count} + 1")
+  deskflow_select_backend(${ARGN} actual)
+  if("${actual}" STREQUAL "${expected}")
+    math(EXPR pass_count "${pass_count} + 1")
+    message("TEST_PASS id=${test_id}")
+  else()
+    message("TEST_FAIL id=${test_id} expected=${expected} actual=${actual}")
+  endif()
+endmacro()
+
+check_selection(cmake_win32_no_native_probe WIN32 TRUE FALSE FALSE FALSE FALSE FALSE)
+check_selection(cmake_posix_fallback_none POSIX FALSE TRUE FALSE FALSE FALSE FALSE)
+check_selection(cmake_native_complete NATIVE FALSE TRUE TRUE TRUE TRUE TRUE)
+check_selection(cmake_native_partial_rejected INVALID_PARTIAL FALSE TRUE TRUE FALSE TRUE TRUE)
+
+math(EXPR test_count "${test_count} + 1")
+file(READ "${CMAKE_CURRENT_LIST_DIR}/../../../cmake/Libraries.cmake" libraries_source)
+set(expected_posix_probe
+    "  if(WIN32)\n    set(HAVE_POSIX_DESKFLOW_API FALSE)\n  else()")
+string(FIND "${libraries_source}" "${expected_posix_probe}" posix_probe_index)
+if(posix_probe_index EQUAL -1)
+  message("TEST_FAIL id=cmake_posix_probe_not_preseeded")
+else()
+  math(EXPR pass_count "${pass_count} + 1")
+  message("TEST_PASS id=cmake_posix_probe_not_preseeded")
+endif()
+
+math(EXPR test_count "${test_count} + 1")
+set(expected_posix_gate "  if(NOT WIN32 AND NOT HAVE_POSIX_DESKFLOW_API)")
+string(FIND "${libraries_source}" "${expected_posix_gate}" posix_gate_index)
+if(posix_gate_index EQUAL -1)
+  message("TEST_FAIL id=cmake_win32_posix_gate_scoped")
+else()
+  math(EXPR pass_count "${pass_count} + 1")
+  message("TEST_PASS id=cmake_win32_posix_gate_scoped")
+endif()
+
+math(EXPR failed_count "${test_count} - ${pass_count}")
+message("DESKFLOW_BACKEND_SELECTION_TESTS tests=${test_count} passed=${pass_count} failed=${failed_count}")
+if(NOT failed_count EQUAL 0)
+  message(FATAL_ERROR "Deskflow backend selection tests failed")
+endif()
