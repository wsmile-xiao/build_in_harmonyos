+ClipboardSnapshot snapshot(
+    bool hasData, std::uint8_t digest, std::uint32_t count,
+    bool readable = true, bool getDataWasNull = false
+)
+{
+  return ClipboardSnapshot{readable, hasData, getDataWasNull, fingerprint(digest), count};
+}
