+void testClipboardClear()
+{
+  ClipboardWriteTracker tracker;
+  const auto before = snapshot(true, 4, 20);
+  const auto empty = snapshot(false, 0, 20, true, true);
+  tracker.reset(before);
+  auto generation = tracker.begin(ClipboardWriteKind::kClear, before, empty.m_fingerprint, 2000);
+  CHECK(generation != 0);
+  CHECK(tracker.observe(empty, true, 1000) == ClipboardObservation::kSuppressSelfWrite);
+  auto finish = tracker.finishClear(generation, true, empty, empty, 1001);
+  CHECK(finish.m_succeeded && !finish.m_notifyExternal);
+
+  tracker.reset(before);
+  generation = tracker.begin(ClipboardWriteKind::kClear, before, empty.m_fingerprint, 2000);
+  finish = tracker.finishClear(generation, true, before, before, 1001);
+  CHECK(!finish.m_succeeded && finish.m_notifyExternal);
+
+  tracker.reset(empty);
+  CHECK(tracker.begin(ClipboardWriteKind::kClear, empty, empty.m_fingerprint, 2000) == 0);
+
+  tracker.reset(before);
+  generation = tracker.begin(ClipboardWriteKind::kClear, before, empty.m_fingerprint, 2000);
+  finish = tracker.finishClear(generation, true, empty, empty, 1001);
+  CHECK(!finish.m_succeeded && finish.m_notifyExternal);
+
+  tracker.reset(before);
+  generation = tracker.begin(ClipboardWriteKind::kClear, before, empty.m_fingerprint, 1000);
+  CHECK(tracker.observe(empty, true, 1000) == ClipboardObservation::kNotifyExternal);
+}
