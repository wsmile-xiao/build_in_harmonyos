+void testHotKeys()
+{
+  HotKeyRegistry registry;
+  HotKeyTicket first{7, registry.add(7)};
+  CHECK(registry.registered(first));
+  CHECK(registry.beginCallback(first));
+  CHECK(registry.beginRemove(first));
+  CHECK(!registry.beginRemove(first));
+  CHECK(!registry.canErase(first));
+  CHECK(!registry.endCallback(first));
+  CHECK(!registry.canErase(first));
+  CHECK(registry.removeSucceeded(first));
+  CHECK(registry.canErase(first));
+  CHECK(registry.erase(first));
+  CHECK(!registry.registered(first));
+
+  HotKeyTicket second{7, registry.add(7)};
+  CHECK(!registry.beginCallback(first));
+  CHECK(registry.beginRemove(second));
+  CHECK(registry.removeFailed(second));
+  CHECK(registry.registered(second));
+
+  HotKeyTicket third{8, registry.add(8)};
+  CHECK(registry.beginCallback(third));
+  CHECK(registry.beginRemove(third));
+  CHECK(registry.removeSucceeded(third));
+  CHECK(!registry.registered(third));
+  CHECK(registry.endCallback(third));
+  CHECK(registry.erase(third));
+  CHECK(!registry.beginCallback(third));
+}
