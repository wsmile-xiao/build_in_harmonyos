+#pragma once
+
+#include "deskflow/KeyState.h"
+
+#include <cstdint>
+
+struct Input_KeyEvent;
+class OHOSScreen;
+
+//! OpenHarmony key state
+/*!
+Maps OpenHarmony key codes to Deskflow's compact KeyButton space and
+synthesizes key events with InputKit. OpenHarmony key codes are retained as
+KeyMap client data so the same mapping is used in both directions.
+*/
+class OHOSKeyState : public KeyState
+{
+public:
+  struct KeyEvent
+  {
+    KeyID m_id{kKeyNone};
+    KeyButton m_button{};
+    KeyModifierMask m_mask{};
+    bool m_press{};
+    bool m_repeat{};
+  };
+
+  OHOSKeyState(IEventQueue *events, std::vector<String> layouts, bool isLangSyncEnabled);
+  OHOSKeyState(
+      IEventQueue *events, deskflow::KeyMap &keyMap, std::vector<String> layouts, bool isLangSyncEnabled,
+      OHOSScreen *screen = nullptr
+  );
+  ~OHOSKeyState() override = default;
+
+  //! Convert an OpenHarmony key code to a Deskflow KeyID.
+  KeyID mapKeyFromOHOS(std::int32_t keyCode, KeyModifierMask mask) const;
+
+  //! Convert an OpenHarmony key code to its compact Deskflow KeyButton.
+  KeyButton mapKeyButtonFromOHOS(std::int32_t keyCode) const;
+
+  //! Convert a Deskflow KeyID to an injectable OpenHarmony key code.
+  bool mapKeyToOHOS(KeyID id, std::int32_t &keyCode) const;
+
+  //! Translate an InputKit event without posting it to the event queue.
+  bool translateKeyEvent(const struct Input_KeyEvent *event, KeyEvent &translated) const;
+
+  //! Update local state and post a translated InputKit event.
+  bool handleKeyEvent(const struct Input_KeyEvent *event, void *target);
+  bool handleKeyEvent(std::int32_t keyCode, std::int32_t action, void *target);
+
+  //! Inject one physical OpenHarmony key transition.
+  std::int32_t injectKey(std::int32_t keyCode, bool press) const;
+
+  // IKeyState overrides
+  bool fakeCtrlAltDel() override;
+  bool fakeMediaKey(KeyID id) override;
+  KeyModifierMask pollActiveModifiers() const override;
+  SInt32 pollActiveGroup() const override;
+  void pollPressedKeys(KeyButtonSet &pressedKeys) const override;
+
+protected:
+  // KeyState overrides
+  void getKeyMap(deskflow::KeyMap &keyMap) override;
+  void fakeKey(const Keystroke &keystroke) override;
+
+private:
+  bool translateKeyEvent(std::int32_t keyCode, std::int32_t action, KeyEvent &translated) const;
+
+  OHOSScreen *m_screen{};
+};
