+#include "arch/unix/ArchTaskBarOHOS.h"
+
+#include "arch/IArchTaskBarReceiver.h"
+#include "base/Log.h"
+
+void ArchTaskBarOHOS::addReceiver(IArchTaskBarReceiver *receiver)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_receivers.insert(receiver);
+}
+
+void ArchTaskBarOHOS::removeReceiver(IArchTaskBarReceiver *receiver)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_receivers.erase(receiver);
+}
+
+void ArchTaskBarOHOS::updateReceiver(IArchTaskBarReceiver *receiver)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (m_receivers.contains(receiver)) {
+    LOG((CLOG_INFO "status: %s", receiver->getToolTip().c_str()));
+  }
+}
+
+void ArchTaskBarOHOS::init()
+{
+  // OpenHarmony has no native taskbar service for this command-line backend.
+}
