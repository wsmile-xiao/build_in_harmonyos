{
  "name": "sockstat",
  "description": "提供 `sockstat` 命令行工具：详细列出系统上每个打开的套接字（USER / PROCESS / PID / PROTO / SOURCE ADDRESS / FOREIGN ADDRESS / STATE），是 FreeBSD sockstat(1) 的 Linux 实现，通过关联 /proc/net/* 与 /proc/<pid>/fd 得到",
  "homepage": "https://codeberg.org/alteholz/sockstat",
  "type": "tool",
  "versions": {
    "0.4.2": {
      "ref": "sockstat/0.4.2",
      "binary": false,
      "commands": [
        "sockstat",
        "sockstat -4",
        "sockstat -6",
        "sockstat -u",
        "sockstat -l",
        "sockstat -c",
        "sockstat -R tcp",
        "sockstat -R udp",
        "sockstat -p 0-1023",
        "sockstat -P 1",
        "sockstat -U root",
        "sockstat -h"
      ]
    }
  }
}
