--- a/autoconf/config.guess
+++ b/autoconf/config.guess
@@ -133,6 +133,16 @@
 UNAME_VERSION=`(uname -v) 2>/dev/null` || UNAME_VERSION=unknown
 
 case "$UNAME_SYSTEM" in
+HarmonyOS)
+    # HarmonyOS (OHOS): musl userland, aarch64.  Answer directly --
+    # the generic Linux branch compiles a dummy.c probe, which fails
+    # on this platform (read-only /tmp, restrictive umask).
+    case "$UNAME_MACHINE" in
+        aarch64|arm64) GUESS=aarch64-unknown-linux-ohos ;;
+        *)             GUESS="$UNAME_MACHINE-unknown-linux-ohos" ;;
+    esac
+    echo "$GUESS"
+    exit ;;
 Linux|GNU|GNU/*)
 	# If the system lacks a compiler, then just pick glibc.
 	# We could probably try harder.
