--- a/configure
+++ b/configure
@@ -6533,7 +6533,9 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  # OHOS/hmdfs: umask 077 makes the temp dir unwritable for this session,
+  # so config.status cannot create its awk helper scripts (SDL precedent).
+  tmp=`(umask 022 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
@@ -6540,5 +6542,5 @@
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
