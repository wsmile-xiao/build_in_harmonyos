+++ b/src/include/musl/string.h	2026-09-03 00:30:50.755485313 +0800
@@ -3,5 +3,14 @@
 
 #include_next <string.h>
 
+/* OHOS musl 不提供 explicit_bzero（glibc 2.25+）——用 memset + 编译器
+ * barrier 内联实现，保证清零不被优化掉。 */
+static inline void explicit_bzero(void *p, size_t l) {
+        if (p && l > 0) {
+                memset(p, 0, l);
+                __asm__ __volatile__("" : : "r"(p) : "memory");
+        }
+}
+
 char* strerror_r_gnu(int errnum, char *buf, size_t buflen);
