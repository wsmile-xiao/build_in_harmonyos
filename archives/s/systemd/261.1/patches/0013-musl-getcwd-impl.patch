+
+/* OHOS musl 无 get_current_dir_name——基于 getcwd + malloc 实现（glibc 语义）。 */
+char *missing_get_current_dir_name(void) {
+        size_t size = 256;
+        for (;;) {
+                char *buf = malloc(size);
+                if (!buf)
+                        return NULL;
+                if (getcwd(buf, size))
+                        return buf;
+                free(buf);
+                if (errno != ERANGE)
+                        return NULL;
+                size *= 2;
+        }
+}
+
+/* OHOS musl 不实现 statx() 系统调用包装（仅内核支持）——用 syscall 直接调用。 */
+int statx(int dirfd, const char *pathname, int flags, unsigned int mask, struct statx *statxbuf) {
+        return syscall(__NR_statx, dirfd, pathname, flags, mask, statxbuf);
+}
