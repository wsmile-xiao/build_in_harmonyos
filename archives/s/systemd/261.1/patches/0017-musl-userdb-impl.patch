--- /dev/null	2026-08-24 02:58:04.443252344 +0800
+++ b/src/libc/musl/userdb.c	2026-09-03 01:58:12.215481094 +0800
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <errno.h>
+#include <grp.h>
+#include <pwd.h>
+#include <shadow.h>
+#include <stdio.h>
+#include <stddef.h>
+
+/* OHOS 不管理 passwd/shadow/group 文件，这些 glibc 文件访问函数无实际
+ * 数据源——stub：读返回 NULL（EOF），写返回 -1（ENOSYS）。 */
+
+struct passwd *fgetpwent(FILE *stream) {
+        (void) stream;
+        return NULL;
+}
+
+int putpwent(const struct passwd *pw, FILE *stream) {
+        (void) pw;
+        (void) stream;
+        errno = ENOSYS;
+        return -1;
+}
+
+struct group *fgetgrent(FILE *stream) {
+        (void) stream;
+        return NULL;
+}
+
+int putgrent(const struct group *gr, FILE *stream) {
+        (void) gr;
+        (void) stream;
+        errno = ENOSYS;
+        return -1;
+}
+
+struct spwd *fgetspent(FILE *stream) {
+        (void) stream;
+        return NULL;
+}
+
+int putspent(const struct spwd *sp, FILE *stream) {
+        (void) sp;
+        (void) stream;
+        errno = ENOSYS;
+        return -1;
+}
+
+struct spwd *getspnam(const char *name) {
+        (void) name;
+        errno = EACCES;
+        return NULL; /* OHOS 无 /etc/shadow——与 polkit 同款存根语义 */
+}
+
+int getspnam_r(const char *name, struct spwd *result_buf, char *buf, size_t buflen, struct spwd **result) {
+        (void) name; (void) result_buf; (void) buf; (void) buflen;
+        *result = NULL;
+        errno = EACCES;
+        return EACCES; /* OHOS 无 /etc/shadow——与 polkit 同款存根语义 */
+}
