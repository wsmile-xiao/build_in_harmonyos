+/* OHOS musl 无 secure_getenv——直接透传 getenv（进程非 setuid 场景语义一致）。 */
+char *missing_secure_getenv(const char *name) {
+        return getenv(name);
+}
+
+/* glibc 的 program_invocation_name/program_invocation_short_name 全局变量，
+ * OHOS musl 无——提供可写定义（systemd 会在 argv-util/main 中赋值）。 */
+char *program_invocation_name = NULL;
+char *program_invocation_short_name = NULL;
+
+/* OHOS musl 无 reallocarray——溢出安全实现（与 glibc 语义一致）。 */
+void *missing_reallocarray(void *ptr, size_t nmemb, size_t size) {
+        if (size && nmemb > (size_t)-1 / size)
+                return NULL;
+        return realloc(ptr, nmemb * size);
+}
+
+/* OHOS musl 无 qsort_r——用线程局部上下文把 (compar, arg) 包装成普通
+ * qsort() 的 compar（glibc GNU 签名兼容）。 */
+static __thread int (*qsort_r_compar)(const void *, const void *, void *);
+static __thread void *qsort_r_arg;
+
+static int qsort_r_wrap(const void *a, const void *b) {
+        return qsort_r_compar(a, b, qsort_r_arg);
+}
+
+void missing_qsort_r(void *base, size_t nmemb, size_t size,
+                     int (*compar)(const void *, const void *, void *),
+                     void *arg) {
+        qsort_r_compar = compar;
+        qsort_r_arg = arg;
+        qsort(base, nmemb, size, qsort_r_wrap);
+}
