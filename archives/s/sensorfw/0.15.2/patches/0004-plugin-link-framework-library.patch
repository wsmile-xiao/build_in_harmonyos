--- a/sensorfw.pro
+++ b/sensorfw.pro
@@ -16,8 +16,8 @@
 TEMPLATE = subdirs
 CONFIG += ordered
 SUBDIRS = datatypes \
-          adaptors \
           core \
+          adaptors \
           filters \
           sensors \
           sensord \
--- a/adaptors/adaptor-config.pri
+++ b/adaptors/adaptor-config.pri
@@ -15,4 +15,15 @@
 publicheaders.files += $$HEADERS
 target.path = $$PLUGINPATH
 
+# The plugins reference symbols exported by the sensorfw framework library
+# (libsensorfw-qt5: InputDevAdaptor, AbstractChain, AbstractSensor, PluginBase,
+# ...). Upstream lets the process that dlopen()s them provide those symbols,
+# which only holds on loaders that expose the host's global symbol scope to
+# dlopen()ed objects. HarmonyOS/musl does not - a dlopen()ed object resolves
+# its undefined symbols only inside its own DT_NEEDED closure - so every plugin
+# records DT_NEEDED on libsensorfw-qt5 instead. On glibc the library is already
+# loaded when a plugin is opened, so the extra DT_NEEDED is satisfied by the
+# very same instance and the change is inert there.
+LIBS += -L../../core -lsensorfw-qt$${QT_MAJOR_VERSION}
+
 INSTALLS += target
--- a/chains/chain-config.pri
+++ b/chains/chain-config.pri
@@ -17,4 +17,10 @@
 publicheaders.files += $$HEADERS
 target.path = $$PLUGINPATH
 
