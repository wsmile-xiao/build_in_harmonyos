--- a/chains/compasschain/compasschain.pro
+++ b/chains/compasschain/compasschain.pro
@@ -18,3 +18,23 @@
                ../../filters/declinationfilter
 
 include( ../chain-config.pri )
+
+# compasschain instantiates classes whose implementations live in *other*
+# plugin modules (AvgAccFilter, DownsampleFilter, DeclinationFilter,
+# MagCalibrationChain - see the INCLUDEPATH list above). Upstream relies on the
+# process that dlopen()s the plugins to expose those symbols globally
+# (QLibrary::ExportExternalSymbolsHint in core/loader.cpp), which only holds on
+# loaders that share the host's global symbol scope with dlopen()ed objects, as
+# glibc does. HarmonyOS/musl resolves a dlopen()ed object's undefined symbols
+# only inside its own DT_NEEDED closure, so compasschain has to record
+# DT_NEEDED on those plugin modules explicitly. On glibc the modules are already
+# resident when compasschain is opened, so the extra DT_NEEDED entries are
+# satisfied by the very same instances and the change is inert there.
+#
+# Ordering: filters/ is built before chains/ (sensorfw.pro SUBDIRS) and
+# magcalibrationchain precedes compasschain in chains/chains.pro, so all four
+# targets exist by the time this project is linked.
+LIBS += -L../../filters/avgaccfilter -lavgaccfilter-qt$${QT_MAJOR_VERSION} \
+        -L../../filters/downsamplefilter -ldownsamplefilter-qt$${QT_MAJOR_VERSION} \
+        -L../../filters/declinationfilter -ldeclinationfilter-qt$${QT_MAJOR_VERSION} \
+        -L../../chains/magcalibrationchain -lmagcalibrationchain-qt$${QT_MAJOR_VERSION}
