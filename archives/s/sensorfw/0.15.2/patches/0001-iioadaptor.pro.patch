--- a/adaptors/iioadaptor/iioadaptor.pro
+++ b/adaptors/iioadaptor/iioadaptor.pro
@@ -8,6 +8,22 @@
 
 CONFIG += qt debug warn_on link_prl link_pkgconfig plugin
 
-PKGCONFIG += libudev
+# libudev may be supplied by the build system (e.g. a Conan package) rather
+# than installed system-wide. When the search paths are provided through the
+# environment, use them directly and fall back to the pkg-config based lookup
+# otherwise. Environment variables are used because qmake does not forward
+# command line assignments to the sub-project runs of a recursive build.
+LIBUDEV_INCLUDEPATH = $$(SENSORFW_LIBUDEV_INCLUDEPATH)
+LIBUDEV_LIBDIR      = $$(SENSORFW_LIBUDEV_LIBDIR)
+
+!isEmpty(LIBUDEV_INCLUDEPATH) {
+    INCLUDEPATH += $$LIBUDEV_INCLUDEPATH
+} else {
+    PKGCONFIG += libudev
+}
+
+!isEmpty(LIBUDEV_LIBDIR) {
+    LIBS += -L$$LIBUDEV_LIBDIR -ludev
+}
 
 include( ../adaptor-config.pri )
