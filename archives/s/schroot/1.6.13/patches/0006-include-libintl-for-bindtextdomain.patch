schroot-base-run.h calls bindtextdomain()/textdomain() but never includes
<libintl.h>: it only compiled while NLS was enabled, because sbuild-i18n.h
pulls the declarations in transitively.  OHOS's libc ships no gettext (the
sysroot libintl.h is an empty stub without any function declaration and
there is no libintl library), so gettext is taken from the gettext package;
include the header explicitly.  Pure include, no platform conditional.

--- a/bin/schroot-base/schroot-base-run.h
+++ b/bin/schroot-base/schroot-base-run.h
@@ -26,6 +26,7 @@
 #include <cstdlib>
 #include <iostream>
 #include <string>
+#include <libintl.h>
 
 namespace schroot_base
 {
