sbuild-feature.cc calls the project's own gettext() helper (declared in
sbuild-i18n.h) but never includes that header: it only compiled because
sbuild-i18n.h pulls in <libintl.h> when SBUILD_FEATURE_NLS is set, and
<libintl.h> declares the global ::gettext().  When NLS support is disabled
(no message catalogs are built) that declaration is no longer reachable and
the file fails with "use of undeclared identifier 'gettext'".  Include the
header explicitly; no platform conditional is involved.

--- a/sbuild/sbuild-feature.cc
+++ b/sbuild/sbuild-feature.cc
@@ -21,6 +21,7 @@
 #include <iostream>
 
 #include "sbuild-feature.h"
+#include "sbuild-i18n.h"
 
 using namespace sbuild;
 
