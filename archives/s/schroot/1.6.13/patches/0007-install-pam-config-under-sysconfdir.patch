Installing the PAM configuration into the hard-coded absolute path /etc/pam.d
fails during a packaging build (the destination is outside the package prefix
and creating directories there requires administrative privileges). Install it
under the configured sysconf directory instead, so the file stays inside the
package prefix like every other configuration file.

--- a/etc/pam/CMakeLists.txt
+++ b/etc/pam/CMakeLists.txt
@@ -17,7 +17,7 @@
 #####################################################################
 
 set(pam_data schroot)
-set(pam_dir "/etc/pam.d")
+set(pam_dir "${SCHROOT_SYSCONF_DIR}/pam.d")
 
 install(FILES ${pam_data}
         DESTINATION ${pam_dir})
