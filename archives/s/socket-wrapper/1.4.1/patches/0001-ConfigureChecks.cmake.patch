+        "-1"
+        "sys/types.h;sys/socket.h"
+        HAVE_RECVMMSG_UNSIGNED_FLAGS)
+    set(CMAKE_REQUIRED_DEFINITIONS)
 endif (HAVE_RECVMMSG)
 
