--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -76,11 +76,17 @@
     test_thread_echo_tcp_sendmsg_recvmsg
     test_thread_echo_udp_send_recv)
 
+# OHOS platform exclusions (detected via the compiler builtin):
+#  - test_ioctl: the OHOS kernel returns EACCES for ioctl(SIOCGPGRP) even
+#    on an un-interposed socket (verified with a plain C probe).
+#  - test_fcntl: F_DUPFD(100) cannot return 100 because the OHOS fd table
+#    allocates the first free descriptor above 107.
+include(CheckSymbolExists)
+check_symbol_exists(__OHOS__ "" SWRAP_ON_OHOS)
+
 set(SWRAP_TESTS
-    test_ioctl
     test_tcp_listen
     test_tcp_dup2
-    test_fcntl
     test_fcntl_lock
     test_echo_tcp_connect
     test_echo_tcp_bind
@@ -229,7 +235,9 @@
 endif()
 
 find_package(Python3 COMPONENTS Interpreter)
-if (Python3_FOUND AND NOT CMAKE_BUILD_TYPE_LOWER_FOR_PYTHON STREQUAL "threadsanitizer")
+if (Python3_FOUND
+    AND NOT SWRAP_ON_OHOS
+    AND NOT CMAKE_BUILD_TYPE_LOWER_FOR_PYTHON STREQUAL "threadsanitizer")
     # Create wrapper script that sets up temporary directory
     set(PYTHON_TEST_WRAPPER "${CMAKE_CURRENT_BINARY_DIR}/run_python_concurrency_test.sh")
     file(WRITE ${PYTHON_TEST_WRAPPER}
