Make the four compile rules honour CPPFLAGS/CFLAGS/LDFLAGS instead of
hard-coding '-Wall -O3 -g'.

Rationale (required for the HarmonyOS aarch64 port):

  The OHOS build must inject -fsigned-char.  col2fqcell.h declares
  'typedef struct base_t { char base; ... } base_t;' and myrealigner.c
  uses -1 as a sentinel on that field (myrealigner.c:628, 745, 977, 1007).
  plain char is signed on x86-64 but UNSIGNED by default on aarch64, so
  'base != -1' becomes tautologically true and the fragment walk runs off
  the end of the list: every myrealigner invocation dies with SIGSEGV.
  clang even says so at build time:
    myrealigner.c:628:35: warning: result of comparison of constant -1 with
      expression of type 'char' is always false [-Wtautological-constant-out-of-range-compare]

  This mirrors Debian's own flags.patch (debian/patches/flags.patch,
  Chris Lamb, Bug-Debian #956473), which made the same change so that
  dpkg-buildflags could reach the compile rules.

  No other upstream change: the -O3 optimisation level is preserved; only
  '-g' (debug info) is dropped by the recipe, not by this patch.

--- a/makefile
+++ b/makefile
@@ -38,16 +38,16 @@
 all: $(COMPILED)
 
 bfmt72s: bfmt72s.c
-	$(CC) -Wall -O3 -g -o $@ $<
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $<
 
 nss2v_v3: nss2v_v3.c
-	$(CC) -Wall -O3 -g -o $@ $<
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $<
 
 myrealigner: myrealigner.c
-	$(CC) -Wall -O3 -g -o $@ $^
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $^
 
 m52bfmt7: m52bfmt7.c
-	$(CC) -Wall -O3 -g -o $@ $<
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $<
 
 
 install: $(COMPILED) $(SCRIPTS)
