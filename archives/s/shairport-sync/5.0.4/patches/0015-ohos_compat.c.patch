+++ b/ohos_compat.c	2026-05-26 12:56:10.300288125 +0800
@@ -0,0 +1,42 @@
+/*
+ * ohos_compat.c — OpenHarmony compatibility shim for pthread cancellation functions.
+ *
+ * musl/OHOS does not implement pthread_cancel, pthread_setcancelstate, or pthread_testcancel.
+ * This file provides stub implementations so shairport-sync can build and run on OpenHarmony.
+ *
+ * Strategy:
+ * - pthread_cancel: no-op (return 0). Thread cleanup relies on graceful shutdown
+ *   via pthread_join, which shairport-sync already uses.
+ * - pthread_setcancelstate: no-op (return 0). Saves/restores state variable for API compat.
+ * - pthread_testcancel: no-op (return 0). No cancellation checkpoints needed.
+ */
+
+#include <pthread.h>
+
+#ifdef __OHOS__
+
+int pthread_cancel(pthread_t thread) {
+    /* On OHOS/musl, pthread_cancel is not implemented.
+     * Threads will be joined during graceful shutdown.
+     * This stub returns 0 (success) to allow compilation.
+     */
+    (void)thread;
+    return 0;
+}
+
+int pthread_setcancelstate(int state, int *oldstate) {
+    /* No-op: cancellation is not supported.
+     * Preserve oldstate API contract for callers that check it.
+     */
+    if (oldstate) {
+        *oldstate = PTHREAD_CANCEL_ENABLE;
+    }
+    (void)state;
+    return 0;
+}
+
+void pthread_testcancel(void) {
+    /* No-op: no cancellation checkpoints on OHOS/musl. */
+}
+
+#endif /* __OHOS__ */
