+/* Create a gzip file with a valid header but truncated deflate payload:
+ * zlib reports Z_DATA_ERROR/Z_BUF_ERROR on read, which deterministically
+ * triggers gz_check_error -> log_fatal (unlike the old test_read_fatal2,
+ * which relied on undefined behaviour after gzclose() and hung on OHOS). */
+static void
+create_corrupt_gz (char *path)
+{
+	FILE *fp = NULL;
+	int fd;
+	unsigned char header[] = {0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00,
+				  0x00, 0x00, 0x00, 0xff};
+	unsigned char truncated[] = {0xf3, 0x48, 0xcd, 0xc9, 0xc9, 0x57, 0x00};
+
+	fd = xmkstemp (path);
+	fp = xfdopen (fd, "wb");
+
+	fwrite (header, sizeof (char), sizeof (header), fp);
+	fwrite (truncated, sizeof (char), sizeof (truncated), fp);
+
+	xfclose (fp);
+}
