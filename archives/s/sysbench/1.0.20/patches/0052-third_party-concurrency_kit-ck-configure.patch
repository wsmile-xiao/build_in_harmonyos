diff -ruN a/third_party/concurrency_kit/ck/configure b/third_party/concurrency_kit/ck/configure
--- a/third_party/concurrency_kit/ck/configure
+++ b/third_party/concurrency_kit/ck/configure
@@ -318,21 +318,21 @@
 LSE_ENABLE=${LSE_ENABLE_SET:-"CK_MD_LSE_DISABLE"}
 VMA_BITS=${VMA_BITS:-"unknown"}
 
 DCORES=2
 printf "Detecting operating system......."
 SYSTEM=`uname -s 2> /dev/null`
 case "$SYSTEM" in
 	"SunOS")
 		SYSTEM=solaris
 		;;
-	"Linux"|"uClinux")
+	"Linux"|"uClinux"|"HarmonyOS")
 		DCORES=`egrep '(^CPU[0-9]+|^processor.*:.*)' /proc/cpuinfo|wc -l`
 		SYSTEM=linux
 		;;
 	"FreeBSD"|"GNU/kFreeBSD")
 		DCORES=`sysctl -n hw.ncpu`
 		SYSTEM=freebsd
 		;;
 	"NetBSD")
 		DCORES=`sysctl -n hw.ncpu`
 		SYSTEM=netbsd
