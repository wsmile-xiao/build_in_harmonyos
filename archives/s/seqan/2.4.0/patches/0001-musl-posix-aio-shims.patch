--- a/include/seqan/system/file_async.h
+++ b/include/seqan/system/file_async.h
@@ -37,6 +37,47 @@
 #ifndef SEQAN_HEADER_FILE_ASYNC_H
 #define SEQAN_HEADER_FILE_ASYNC_H
 
+// ==========================================================================
+// POSIX AIO availability shim
+// ==========================================================================
+// Some musl-based C libraries (observed with the OpenHarmony 6.0 sysroot)
+// ship <aio.h> with the aiocb type and the AIO_*/LIO_* constants, but do not
+// provide the POSIX AIO entry points at all. SeqAn 2.4.0 calls those entry
+// points unconditionally in the POSIX branch below, which makes every
+// translation unit that includes <seqan/system/file_async.h> fail to compile
+// on such platforms.
+//
+// Provide compile-time shims so the header keeps compiling everywhere. Using
+// asynchronous file I/O on such a platform reports ENOSYS at runtime instead
+// of failing to link.
+#if defined(__has_include)
+#  if __has_include(<aio.h>)
+#    include <aio.h>
+#    define SEQAN_HAVE_AIO_HEADER 1
+#  endif
+#endif
+#if defined(SEQAN_HAVE_AIO_HEADER) && defined(__unix__) && \
+    !defined(__GLIBC__) && !defined(__APPLE__) && !defined(__FreeBSD__) && \
+    !defined(__NetBSD__) && !defined(__OpenBSD__) && !defined(__DragonFly__) && \
+    !defined(__sun)
+#  include <errno.h>
+#  ifndef SEQAN_POSIX_AIO_SHIMS
+#    define SEQAN_POSIX_AIO_SHIMS 1
+static inline int aio_read(struct aiocb *) { errno = ENOSYS; return -1; }
+static inline int aio_write(struct aiocb *) { errno = ENOSYS; return -1; }
+static inline int aio_error(const struct aiocb *) { return ENOSYS; }
+static inline ssize_t aio_return(struct aiocb *) { return -1; }
+static inline int aio_suspend(const struct aiocb *const[], int,
+                              const struct timespec *)
+{
+    errno = ENOSYS;
+    return -1;
+}
+static inline int aio_cancel(int, struct aiocb *) { return AIO_ALLDONE; }
+static inline int aio_fsync(int, struct aiocb *) { errno = ENOSYS; return -1; }
+#  endif
+#endif
+
 /* IOREV
