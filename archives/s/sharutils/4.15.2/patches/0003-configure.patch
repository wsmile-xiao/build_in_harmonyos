--- a/configure
+++ b/configure
@@ -150,8 +150,10 @@
   *v* ) as_opts=-v ;;
   *x* ) as_opts=-x ;;
   * ) as_opts= ;;
 esac
-exec $CONFIG_SHELL $as_opts "$as_myself" ${1+"$@"}
+  _as_shell=$CONFIG_SHELL
+  command -v "$_as_shell" >/dev/null 2>&1 || _as_shell=$(command -v bash 2>/dev/null || echo /bin/sh)
+exec "$_as_shell" $as_opts "$as_myself" ${1+"$@"}
 # Admittedly, this is quite paranoid, since all the known shells bail
 # out after a failed `exec'.
 $as_echo "$0: could not re-execute with $CONFIG_SHELL" >&2
