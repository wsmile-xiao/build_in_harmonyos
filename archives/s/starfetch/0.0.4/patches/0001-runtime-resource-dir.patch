+  static string path = [] {
+      const char *envDir = getenv("STARFETCH_RES_DIR");
+      string p = envDir ? string(envDir) : string("/usr/local/share/starfetch");
+      while (!p.empty() && p.back() == '/')
+          p.pop_back();
+      return p + "/";
+  }();
   static string SEP = "/";
 #endif // _WIN32
