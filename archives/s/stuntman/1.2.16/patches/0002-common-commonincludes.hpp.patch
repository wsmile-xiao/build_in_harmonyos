 #include <boost/scoped_ptr.hpp>
+
+// CRC-32 implementation (replaces boost::crc_32_type, avoids boost::crc.hpp dependency)
+class crc_32_type {
+public:
+    void process_bytes(const void* data, std::size_t length) {
+        const uint8_t* p = static_cast<const uint8_t*>(data);
+        for (std::size_t i = 0; i < length; i++) {
+            _crc ^= p[i];
+            for (int j = 0; j < 8; j++)
+                _crc = (_crc >> 1) ^ (0xEDB88320u & -static_cast<int32_t>(_crc & 1));
+        }
+    }
+    uint32_t checksum() const { return _crc ^ 0xFFFFFFFFu; }
+private:
+    uint32_t _crc = 0xFFFFFFFFu;
+};
 
