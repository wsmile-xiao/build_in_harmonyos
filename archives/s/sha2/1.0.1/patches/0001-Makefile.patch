diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,15 +1,15 @@
 # Makefile for sha2 - Simple SHA-2 hash utility
 
 CC = cc
 CFLAGS = -Wall -O2 -I$(PREFIX)/include
-LDFLAGS = -L$(PREFIX)/lib -lcrypto
+LDFLAGS = -L$(PREFIX)/lib -lcrypto -Wl,-rpath,$(PREFIX)/lib
 
