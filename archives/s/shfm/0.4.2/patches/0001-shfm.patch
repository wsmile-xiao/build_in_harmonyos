--- a/shfm
+++ b/shfm
@@ -33,21 +33,24 @@
 
 term_reset() {
     esc DECAWM h     >&2
     esc DECTCEM h    >&2
     esc ED2          >&2
     esc DECSTBM      >&2
     esc screen_alt l >&2
     stty "$stty"
 
     # needed for cd-on-exit
-    printf '%s\n' "$PWD" >&1
+    # fd 3 holds the caller's stdout (saved before 'main >/dev/tty' below).
+    # Only dash drops that redirect before the EXIT trap runs; in mksh (OHOS
+    # /bin/sh), bash and zsh '>&1' is still /dev/tty and "$(shfm)" is empty.
+    printf '%s\n' "$PWD" >&3
 }
 
 term_resize() {
     # false-positive, behavior intentional, globbing is disabled.
     # shellcheck disable=2046
     {
         set -f
         set +f -- $(stty size)
     }
 
@@ -87,21 +90,22 @@
 
     line_print "$y" "$@"
     status_line "$#"
 }
 
 cmd_run() {
     stty "$stty"
     esc DECTCEM h
     esc DECSTBM
     esc ED2
-    "$@" ||:
+    # children must not hold the cd-on-exit pipe (fd 3) open
+    "$@" 3>&- ||:
     esc DECSTBM 1 "$((LINES - 2))"
     esc DECTCEM l
     stty -icanon -echo
     hist=2
 }
 
 file_escape() {
     tmp=$1 safe=
 
     # loop over string char by char
@@ -416,11 +420,12 @@
             q?) exit 0 ;;
 
             # handle keys which emit escape sequences
             "$esc_c"*) esc=1 ;;
                  '[1') esc=2 ;;
                     *) esc=0 ;;
         esac
     done
 }
 
+exec 3>&1
 main "$@" >/dev/tty
