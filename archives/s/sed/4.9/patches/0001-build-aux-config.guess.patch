--- a/build-aux/config.guess	2022-10-09 22:42:28.000000000 +0800
+++ b/build-aux/config.guess	2026-04-07 10:37:43.207995938 +0800
@@ -975,6 +975,26 @@
     *:Minix:*:*)
 	GUESS=$UNAME_MACHINE-unknown-minix
 	;;
+    *:HarmonyOS:*:*)
+	case "$UNAME_MACHINE" in
+	    aarch64|arm64)
+		MACHINE=aarch64
+		;;
+	    armv7*|armv8*)
+		MACHINE=arm
+		;;
+	    x86_64|amd64)
+		MACHINE=x86_64
+		;;
+	    i?86)
+		MACHINE=i686
+		;;
+	    *)
+		MACHINE="$UNAME_MACHINE"
+		;;
+	esac
+	GUESS=${MACHINE}-unknown-linux-ohos
+	;;
     aarch64:Linux:*:*)
 	GUESS=$UNAME_MACHINE-unknown-linux-$LIBC
 	;;
