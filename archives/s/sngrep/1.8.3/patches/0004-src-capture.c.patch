+
+/*
+ * Some libc implementations (musl-based platforms) do not provide
+ * pthread_cancel(). Thread shutdown here is already cooperative:
+ * pcap_breakloop() unblocks the capture loop before the call, so a
+ * no-op pthread_cancel keeps the same call sites working.
+ */
+#include <pthread.h>
+#ifndef HAVE_PTHREAD_CANCEL
+int pthread_cancel(pthread_t thread)
+{
+    return 0;
+}
+#endif
