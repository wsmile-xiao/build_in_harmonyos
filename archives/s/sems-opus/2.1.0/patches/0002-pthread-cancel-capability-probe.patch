diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	2026-09-30 19:22:47.287858437 +0800
+++ b/CMakeLists.txt	2026-09-30 19:22:55.243859531 +0800
@@ -318,6 +318,16 @@
   message(STATUS "Using hiredis: NO")
 endif(HIREDIS_FOUND)
 
+# Check whether the C library provides pthread_cancel; not every libc does,
+# and the symbol is also missing from some headers, so probe instead of
+# assuming it exists.
+include(CheckSymbolExists)
+check_symbol_exists(pthread_cancel "pthread.h" HAVE_PTHREAD_CANCEL)
+message(STATUS "Have pthread_cancel: ${HAVE_PTHREAD_CANCEL}")
+if(HAVE_PTHREAD_CANCEL)
+  add_definitions(-DHAVE_PTHREAD_CANCEL)
+endif(HAVE_PTHREAD_CANCEL)
+
 if(NOT ${CMAKE_SYSTEM_NAME} STREQUAL FreeBSD)
   # Check for res_search in -lresolv
   include(CheckSymbolExists)
diff -ruN a/core/AmThread.cpp b/core/AmThread.cpp
--- a/core/AmThread.cpp	2026-09-30 19:22:47.243857031 +0800
+++ b/core/AmThread.cpp	2026-09-30 19:22:55.243859531 +0800
@@ -145,6 +145,7 @@
 void AmThread::cancel() {
   _m_td.lock();
 
+#ifdef HAVE_PTHREAD_CANCEL
   int res;
   if ((res = pthread_cancel(_td)) != 0) {
     ERROR("pthread_cancel failed with code %i\n", res);
@@ -152,6 +153,16 @@
     DBG("Thread %lu is canceled.\n", (unsigned long int) _pid);
     _stopped.set(true);
   }
+#else
+  /* This libc provides no pthread_cancel (probed at configure time, see
+     HAVE_PTHREAD_CANCEL). Ask the thread to stop cooperatively through its
+     on_stop() hook and leave the stopped flag alone: _start() sets it once
+     run() has actually returned, so a thread which is still alive is never
+     reported as stopped. */
+  WARN("pthread_cancel is unavailable in this libc; asking thread %lu to stop cooperatively.\n",
+       (unsigned long int) _pid);
+  try { on_stop(); } catch (...) {}
+#endif
 
   _m_td.unlock();
 }
