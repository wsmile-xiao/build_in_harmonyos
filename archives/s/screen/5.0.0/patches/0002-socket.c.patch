diff -ruN a/socket.c b/socket.c
--- a/socket.c
+++ b/socket.c
@@ -1210,33 +1210,40 @@
 
 #ifndef _PWD_H
 	struct passwd *p;
 #else
 	struct spwd *p;
 #endif
 
 	gid_t gid = getegid();
 	uid_t uid = geteuid();
 
+#ifndef __OHOS__
 	if (seteuid(0) || setegid(0))
 		Panic(0, "\r\ncan't get root uid/gid\r\n");
+#endif
 
 #ifndef _PWD_H
 	p = getpwnam_shadow(ppp->pw_name);
+#elif defined(__OHOS__)
+	/* HarmonyOS does not support shadow password */
+	p = NULL;
 #else
 	p = getspnam(ppp->pw_name);
 #endif
 	if (p == NULL)
 		return false;
 
+#ifndef __OHOS__
 	if (seteuid(uid) || setegid(gid))
 		Panic(0, "\r\ncan't restore uid/gid\r\n");
+#endif
 
 	if (p == NULL) {
 		AddStr("\r\ncan't open passwd file\r\n");
 		return false;
 	}
 #ifndef _PWD_H
 	passwd = crypt(password, p->pw_passwd);
 	ret    = (strcmp(passwd, p->pw_passwd) == 0);
 #else
 	passwd = crypt(password, p->sp_pwdp);
