--- a/src/cutest_zAVLTree.c
+++ b/src/cutest_zAVLTree.c
@@ -505,18 +505,24 @@
   CuAssertStrEquals(tc, "balloon", zAVL_string_get(ztest_tree, "balloon")); 
 
   str = zAVL_string_get(ztest_tree, "foobar");
   CuAssertTrue(tc, str == NULL);
   str = zAVL_string_get(ztest_tree, "");
   CuAssertTrue(tc, str == NULL);
   str = zAVL_string_get(ztest_tree, NULL);
   CuAssertTrue(tc, str == NULL);
 
   zAVL_string_reset(ztest_tree);
+  /* UAF-FIX: reset() frees the tree but the caller kept the dangling
+   * pointer; the following gets used to "work" only by allocator luck
+   * (glibc leaves stale bytes that happen to look empty) and segfaults
+   * on OHOS malloc.  The assertions below all expect NULL results, which
+   * zAVL_string_get() already guarantees for a NULL tree. */
+  ztest_tree = NULL;
   str = zAVL_string_get(ztest_tree, "foo");
   CuAssertTrue(tc, str == NULL);
   str = zAVL_string_get(ztest_tree, "bar");
   CuAssertTrue(tc, str == NULL);
   str = zAVL_string_get(ztest_tree, "balloon");
   CuAssertTrue(tc, str == NULL);
 
 }
