--- a/src/sh_pthread.c
+++ b/src/sh_pthread.c
@@ -1,13 +1,59 @@
 #include "config_xor.h"
 
 #include "sh_pthread.h"
+/*
+ * ---- pthread cancellation shims ----
+ *
+ * The OHOS NDK sysroot does not provide the POSIX thread-cancellation
+ * API: pthread_cancel(), pthread_testcancel() and pthread_setcanceltype()
+ * are absent from both libc.so and libpthread.a (verified with readelf on
+ * the SDK sysroot); pthread.h only exposes the PTHREAD_CANCEL_* macros.
+ * samhain references the three functions from the mutex macros and from
+ * sh_pthread_cancel_all()/sh_threaded_module_run().
+ *
+ * Cancellation can never fire on this platform, so the shims keep that
+ * state explicit instead of failing the link.  They are declared here,
+ * before the first call site, so no implicit (int) declaration can
+ * conflict with the void return type of pthread_testcancel():
+ *   - pthread_setcanceltype() records the "old type" so the paired
+ *     restore in SH_MUTEX_* still reads a defined value, then no-ops;
+ *   - pthread_testcancel() has no pending cancellation -> no-op;
+ *   - pthread_cancel() reports ESRCH; sh_pthread_cancel_all() treats a
+ *     non-zero return as "not a live thread slot", clears ithread[i] and
+ *     skips the joining loop (no hang on exit).
+ */
+#include <errno.h>
+#include <pthread.h>
+
+int pthread_setcanceltype(int type, int *oldtype);
+void pthread_testcancel(void);
+int pthread_cancel(pthread_t thread);
+
+int pthread_setcanceltype(int type, int *oldtype)
+{
+  if (oldtype)
+    *oldtype = type;
+  return 0;
+}
+
+void pthread_testcancel(void)
+{
+  return;
+}
+
+int pthread_cancel(pthread_t thread)
+{
+  (void) thread;
+  return ESRCH;
+}
+
 
 #ifdef HAVE_PTHREAD
 
 #include <signal.h>
 #include "sh_calls.h"
 #include "sh_modules.h"
 extern volatile  int      sh_thread_pause_flag;
 
 SH_MUTEX_INIT(mutex_skey,         PTHREAD_MUTEX_INITIALIZER);
 SH_MUTEX_INIT(mutex_resolv,       PTHREAD_MUTEX_INITIALIZER);
