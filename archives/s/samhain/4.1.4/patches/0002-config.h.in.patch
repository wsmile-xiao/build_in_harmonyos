--- a/config.h.in
+++ b/config.h.in
@@ -1063,21 +1063,25 @@
 /* Define if you do not want IPv6 */
 #undef USE_IPV4
 
 /* Define if you want the logfile monitor module. */
 #undef USE_LOGFILE_MONITOR
 
 /* Define for registry check */
 #undef USE_REGISTRY_CHECK
 
 /* Define if you want to use the system malloc */
-#undef USE_SYSTEM_MALLOC
+/* SYSTEM-MALLOC-FIX: dnmalloc aborts on OHOS (hashval < AMOUNTHASH).
+ * The --disable-dnmalloc / -DUSE_SYSTEM_MALLOC=1 paths are both fragile
+ * here (the static-link branch rewrites CPPFLAGS and drops env CPPFLAGS),
+ * so bake the system-allocator switch into the template itself. */
+#define USE_SYSTEM_MALLOC 1
 
 /* Define if you want extended attributes support. */
 #undef USE_XATTR
 
 /* Define WORDS_BIGENDIAN to 1 if your processor stores words with the most
    significant byte first (like Motorola and SPARC, unlike Intel). */
 #if defined AC_APPLE_UNIVERSAL_BUILD
 # if defined __BIG_ENDIAN__
 #  define WORDS_BIGENDIAN 1
 # endif
