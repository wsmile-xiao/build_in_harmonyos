diff -ruN a/src/shared/missing.h b/src/shared/missing.h
--- a/src/shared/missing.h
+++ b/src/shared/missing.h
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+/* Missing definitions for OHOS/musl compatibility */
+
+#include <stdlib.h>
+#include <errno.h>
+#include <unistd.h>
+#include <limits.h>
+#include <pwd.h>
+#include <grp.h>
+#include <shadow.h>
+
+/* reallocarray - BSD extension, not available in musl */
+#ifndef reallocarray
+static inline void *reallocarray(void *ptr, size_t nmemb, size_t size) {
+        size_t total;
+        if (nmemb == 0 || size == 0)
+                return realloc(ptr, 0);
+        total = nmemb * size;
+        if (total / nmemb != size) {
+                errno = ENOMEM;
+                return NULL;
+        }
+        return realloc(ptr, total);
+}
+#endif
+
+/* secure_getenv - glibc extension, not available in musl */
+#ifndef secure_getenv
+#define secure_getenv getenv
+#endif
+
+/* get_current_dir_name - glibc extension, not available in musl */
+#ifndef get_current_dir_name
+static inline char *get_current_dir_name(void) {
+        char *buf = malloc(PATH_MAX);
+        if (!buf)
+                return NULL;
+        if (!getcwd(buf, PATH_MAX)) {
+                free(buf);
+                return NULL;
+        }
+        return buf;
+}
+#endif
+
+/* program_invocation_short_name - glibc extension */
+#ifndef program_invocation_short_name
+#define program_invocation_short_name "sd-tools"
+#endif
+
+/* fgetpwent/fgetgrent - glibc extensions, not available in musl */
+/* These functions read passwd/group entries from a FILE stream */
+#ifndef HAVE_FGETPWENT
+static inline struct passwd *fgetpwent(FILE *stream) {
+        static struct passwd pw;
+        static char buf[1024];
+        char *line = NULL;
+        char *fields[7];
+        int i = 0;
+
+        if (!fgets(buf, sizeof(buf), stream))
+                return NULL;
+
+        /* Remove newline */
+        line = buf;
+        while (*line && *line != '\n') line++;
+        *line = '\0';
+
+        /* Parse fields: name:passwd:uid:gid:comment:home:shell */
+        line = buf;
+        for (i = 0; i < 7 && line; i++) {
+                fields[i] = line;
+                line = strchr(line, ':');
+                if (line) *line++ = '\0';
+        }
+
+        if (i < 7)
+                return NULL;
+
+        pw.pw_name = fields[0];
+        pw.pw_passwd = fields[1];
+        pw.pw_uid = (uid_t)atoi(fields[2]);
+        pw.pw_gid = (gid_t)atoi(fields[3]);
+        pw.pw_dir = fields[5];
+        pw.pw_shell = fields[6];
+
+        return &pw;
+}
+#endif
+
+#ifndef HAVE_FGETGRENT
+static inline struct group *fgetgrent(FILE *stream) {
+        static struct group gr;
+        static char buf[1024];
+        static char *members[64];
+        char *line = NULL;
+        char *fields[4];
+        int i = 0;
+
+        if (!fgets(buf, sizeof(buf), stream))
+                return NULL;
+
+        /* Remove newline */
+        line = buf;
+        while (*line && *line != '\n') line++;
+        *line = '\0';
+
+        /* Parse fields: name:passwd:gid:members */
+        line = buf;
+        for (i = 0; i < 4 && line; i++) {
+                fields[i] = line;
+                line = strchr(line, ':');
+                if (line) *line++ = '\0';
+        }
+
+        if (i < 4)
+                return NULL;
+
+        gr.gr_name = fields[0];
+        gr.gr_passwd = fields[1];
+        gr.gr_gid = (gid_t)atoi(fields[2]);
+
+        /* Parse members (comma-separated) */
+        if (fields[3] && fields[3][0]) {
+                char *member = fields[3];
+                i = 0;
+                members[i++] = member;
+                while ((member = strchr(member, ',')) && i < 63) {
+                        *member++ = '\0';
+                        members[i++] = member;
+                }
+                members[i] = NULL;
+                gr.gr_mem = members;
+        } else {
+                members[0] = NULL;
+                gr.gr_mem = members;
+        }
+
+        return &gr;
+}
+#endif
+
+/* fgetspent - glibc extension, not available in musl */
+#ifndef HAVE_FGETSPENT
+static inline struct spwd *fgetspent(FILE *stream) {
+        static struct spwd sp;
+        static char buf[1024];
+        char *line = NULL;
+        char *fields[9];
+        int i = 0;
+
+        if (!fgets(buf, sizeof(buf), stream))
+                return NULL;
+
+        /* Remove newline */
+        line = buf;
+        while (*line && *line != '\n') line++;
+        *line = '\0';
+
+        /* Parse fields: name:passwd:lastchg:min:max:warn:inactive:expire:flag */
+        line = buf;
+        for (i = 0; i < 9 && line; i++) {
+                fields[i] = line;
+                line = strchr(line, ':');
+                if (line) *line++ = '\0';
+        }
+
+        if (i < 9)
+                return NULL;
+
+        sp.sp_namp = fields[0];
+        sp.sp_pwdp = fields[1];
+        sp.sp_lstchg = atoi(fields[2]);
+        sp.sp_min = atoi(fields[3]);
+        sp.sp_max = atoi(fields[4]);
+        sp.sp_warn = atoi(fields[5]);
+        sp.sp_inact = atoi(fields[6]);
+        sp.sp_expire = atoi(fields[7]);
+        sp.sp_flag = atoi(fields[8]);
+
+        return &sp;
+}
+#endif
+
+/* putpwent - glibc extension, not available in musl */
+#ifndef HAVE_PUTPWENT
+static inline int putpwent(const struct passwd *p, FILE *stream) {
+        if (!p || !stream)
+                return -1;
+
+        return fprintf(stream, "%s:%s:%u:%u:%s:%s:%s\n",
+                       p->pw_name, p->pw_passwd,
+                       (unsigned)p->pw_uid, (unsigned)p->pw_gid,
+                       "", /* comment field not in struct passwd */
+                       p->pw_dir, p->pw_shell) < 0 ? -1 : 0;
+}
+#endif
+
+/* putgrent - glibc extension, not available in musl */
+#ifndef HAVE_PUTGRENT
+static inline int putgrent(const struct group *g, FILE *stream) {
+        if (!g || !stream)
+                return -1;
+
+        fprintf(stream, "%s:%s:%u:", g->gr_name, g->gr_passwd, (unsigned)g->gr_gid);
+
+        if (g->gr_mem) {
+                for (int i = 0; g->gr_mem[i]; i++) {
+                        if (i > 0) fprintf(stream, ",");
+                        fprintf(stream, "%s", g->gr_mem[i]);
+                }
+        }
+
+        return fprintf(stream, "\n") < 0 ? -1 : 0;
+}
+#endif
+
+/* putspent - glibc extension, not available in musl */
+#ifndef HAVE_PUTSPENT
+static inline int putspent(const struct spwd *sp, FILE *stream) {
+        if (!sp || !stream)
+                return -1;
+
+        return fprintf(stream, "%s:%s:%ld:%ld:%ld:%ld:%ld:%ld:%ld\n",
+                       sp->sp_namp, sp->sp_pwdp,
+                       sp->sp_lstchg, sp->sp_min, sp->sp_max,
+                       sp->sp_warn, sp->sp_inact, sp->sp_expire,
+                       sp->sp_flag) < 0 ? -1 : 0;
+}
+#endif