@@ -22,6 +22,28 @@
 #include <inttypes.h>
 #include <pthread.h>
 
+#ifdef SR_NO_ROBUST_MUTEX
+/* OHOS musl libc does not implement the POSIX robust mutex functions
+ * pthread_mutexattr_setrobust() and pthread_mutex_consistent() (neither
+ * libc.so nor libpthread.a exports them).  Compile-time fallback: the
+ * attribute setter becomes a no-op, so plain process-shared mutexes are
+ * initialized and owner-death recovery becomes unreachable because
+ * pthread_mutex_lock() can never return EOWNERDEAD. */
+static inline int pthread_mutexattr_setrobust(pthread_mutexattr_t *attr,
+                                              int robust)
+{
+    (void)attr;
+    (void)robust;
+    return 0;
+}
+
+static inline int pthread_mutex_consistent(pthread_mutex_t *mutex)
+{
+    (void)mutex;
+    return 0;
+}
+#endif /* SR_NO_ROBUST_MUTEX */
+
 #include "common_types.h"
 #include "shm_types.h"
 #include "sysrepo_types.h"
