+/* Stub gst/tag/tag.h for OHOS.
+ * The gst/tag directory belongs to gst-plugins-base, which is not
+ * published in the OHOS conan registry. The tag-setter API used by
+ * sj-extractor.c (GstTagSetter, gst_tag_setter_add_tags, GST_TAG_*)
+ * lives in gstreamer core headers, so forwarding to those is enough;
+ * the MusicBrainz tag names below are the canonical upstream values
+ * (gst-plugins-base gst/tag/tag.h). */
+#ifndef __GST_TAG_TAG_STUB_H__
+#define __GST_TAG_TAG_STUB_H__
+
+#include <gst/gsttagsetter.h>
+#include <gst/gsttaglist.h>
+
