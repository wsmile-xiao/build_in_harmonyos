+ * types; all constructors return NULL so callers take their "profile not
+ * available" paths. Implementations live in libjuicer/stub-ohos.c. */
+#ifndef __GST_PBUTILS_ENCODING_PROFILE_STUB_H__
+#define __GST_PBUTILS_ENCODING_PROFILE_STUB_H__
