--- /dev/null
+++ b/libjuicer/stub-ohos.c
@@ -0,0 +1,202 @@
+/*
+ * stub-ohos.c - Stub implementations for libraries that are not published
+ * in the OHOS conan registry.
+ *
+ * Stubs cover: brasero (drive/medium monitoring), canberra-gtk (sound
+ * events), totem-disc, libdiscid, libmusicbrainz5 and the gst-plugins-base
+ * pbutils encoding-profile API. All stub functions return NULL/0/false -
+ * with the stub profile the application compiles and runs its UI code
+ * paths, but CD drive detection, metadata lookup and audio encoding
+ * profile handling report "not available" instead of performing work.
+ *
+ * Built only when HAVE_STUB_DEPS is defined (see meson.build c_flags).
+ */
+
+#ifdef HAVE_STUB_DEPS
+
+#include <glib.h>
+#include <glib-object.h>
+#include <gio/gio.h>
+#include <string.h>
+
+/* ===== Brasero stubs ===== */
+#include <brasero-volume.h>
+#include <brasero-medium-selection.h>
+#include <brasero-drive-selection.h>
+
+GType brasero_drive_get_type(void) { return G_TYPE_OBJECT; }
+GType brasero_medium_get_type(void) { return G_TYPE_OBJECT; }
+GType brasero_medium_monitor_get_type(void) { return G_TYPE_OBJECT; }
+GType brasero_media_get_type(void) { return G_TYPE_ENUM; }
+
+BraseroMediumMonitor* brasero_medium_monitor_get_default(void) { return NULL; }
+BraseroDrive* brasero_medium_monitor_get_drive(BraseroMediumMonitor *monitor, const gchar *device) { return NULL; }
+BraseroMedium* brasero_drive_get_medium(BraseroDrive *drive) { return NULL; }
+const gchar* brasero_drive_get_device(BraseroDrive *drive) { return ""; }
+gboolean brasero_drive_lock(BraseroDrive *drive, const gchar *reason, gchar **reason_out) { return FALSE; }
+gboolean brasero_drive_unlock(BraseroDrive *drive) { return FALSE; }
+gboolean brasero_drive_eject(BraseroDrive *drive, gboolean force, GError **error) { return FALSE; }
+gboolean brasero_drive_can_eject(BraseroDrive *drive) { return FALSE; }
+gboolean brasero_drive_is_door_open(BraseroDrive *drive) { return FALSE; }
+gboolean brasero_medium_monitor_is_probing(BraseroMediumMonitor *monitor) { return FALSE; }
+BraseroMedia brasero_medium_get_status(BraseroMedium *medium) { return BRASERO_MEDIUM_NONE; }
+BraseroDrive* brasero_medium_get_drive(BraseroMedium *medium) { return NULL; }
+GSList* brasero_medium_monitor_get_drives(BraseroMediumMonitor *monitor, BraseroDriveType type) { return NULL; }
+gboolean brasero_drive_can_write(BraseroDrive *drive) { return FALSE; }
+void brasero_media_library_start(void) { }
+void brasero_media_library_stop(void) { }
+
+GOptionGroup* brasero_media_get_option_group(void)
+{
+  /* Return a real (empty) option group: passing NULL to
+   * g_application_add_option_group() triggers a g_return_if_fail
+   * critical in main(). */
+  return g_option_group_new("brasero-stub", "Brasero stub options",
+                            "Show Brasero stub help", NULL, NULL);
+}
+
+/* Drive Selection stubs */
+GType brasero_drive_selection_get_type(void) { return G_TYPE_OBJECT; }
+void brasero_drive_selection_set_active(BraseroDriveSelection *selection, BraseroDrive *drive) { }
+BraseroDrive* brasero_drive_selection_get_active(BraseroDriveSelection *selection) { return NULL; }
+
+/* ===== Canberra-gtk stubs ===== */
+#include <canberra-gtk.h>
+
+int ca_gtk_play_for_widget(GtkWidget *widget, int id, ...) { return 0; }
+int ca_gtk_play_for_event(GtkWidget *widget, int id, ...) { return 0; }
+
+/* ===== Totem-disc stubs ===== */
+#include <totem-disc.h>
+
+char* totem_disc_get_cdda_disc_id(const char *device, GError **error) { return NULL; }
+
+/* ===== DiscId stubs ===== */
+#include <discid.h>
+
+DiscId discid_new(void) { return NULL; }
+void discid_free(DiscId disc) { }
+int discid_read_sparse(DiscId disc, const char *device, unsigned int features) { return 0; }
+int discid_read(DiscId disc, const char *device) { return 0; }
+const char* discid_get_id(DiscId disc) { return ""; }
+const char* discid_get_submission_url(DiscId disc) { return ""; }
+const char* discid_get_mcn(DiscId disc) { return ""; }
+char* discid_get_error_msg(DiscId disc) { return ""; }
+const char* discid_get_default_device(void) { return ""; }
+int discid_has_feature(int feature) { return 0; }
+
+/* ===== MusicBrainz5 stubs =====
+ * The whole sj-metadata-musicbrainz5.c implementation is replaced by a
+ * minimal GObject under HAVE_STUB_DEPS (patch 0002); these entry points
+ * only exist to keep the symbol surface complete. */
+#include <mb5_c.h>
+
+Mb5Query mb5_query_new(const char *useragent, const char *server, int port) { return NULL; }
+void mb5_query_delete(Mb5Query query) { }
+Mb5Metadata mb5_query_query(Mb5Query query, const char *entity, const char *id, const char *inc, ...) { return NULL; }
+int mb5_query_get_lasthttpcode(Mb5Query query) { return 0; }
+int mb5_query_get_lasterrormessage(Mb5Query query, char *buf, int len) { if (buf && len > 0) buf[0] = 0; return 0; }
+void mb5_query_set_proxyhost(Mb5Query query, const char *host) { }
+void mb5_query_set_proxyport(Mb5Query query, int port) { }
+void mb5_query_set_proxyusername(Mb5Query query, const char *username) { }
+void mb5_query_set_proxypassword(Mb5Query query, const char *password) { }
+
+/* ===== GStreamer pbutils stubs (gst-plugins-base not published) ===== */
+#include <gst/pbutils/encoding-target.h>
+#include <gst/pbutils/missing-plugins.h>
+
+GType gst_encoding_profile_get_type(void)
+{
+  static GType t = 0;
+  if (t == 0)
+    t = g_type_register_static_simple(G_TYPE_OBJECT, "GstEncodingProfile",
+                                      sizeof(GObjectClass), NULL,
+                                      sizeof(GObject), NULL, 0);
+  return t;
+}
+
+GType gst_encoding_container_profile_get_type(void)
+{
+  static GType t = 0;
+  if (t == 0)
+    t = g_type_register_static_simple(G_TYPE_OBJECT, "GstEncodingContainerProfile",
+                                      sizeof(GObjectClass), NULL,
+                                      sizeof(GObject), NULL, 0);
+  return t;
+}
+
+GType gst_encoding_audio_profile_get_type(void)
+{
+  static GType t = 0;
+  if (t == 0)
+    t = g_type_register_static_simple(G_TYPE_OBJECT, "GstEncodingAudioProfile",
+                                      sizeof(GObjectClass), NULL,
+                                      sizeof(GObject), NULL, 0);
+  return t;
+}
+
+GType gst_encoding_target_get_type(void)
+{
+  static GType t = 0;
+  if (t == 0)
+    t = g_type_register_static_simple(G_TYPE_OBJECT, "GstEncodingTarget",
+                                      sizeof(GObjectClass), NULL,
+                                      sizeof(GObject), NULL, 0);
+  return t;
+}
+
+const GstCaps *gst_encoding_profile_get_format(GstEncodingProfile *profile)
+{
+  g_return_val_if_fail(profile != NULL, NULL);
+  return NULL;
+}
+
+const gchar *gst_encoding_profile_get_name(GstEncodingProfile *profile)
+{
+  g_return_val_if_fail(profile != NULL, NULL);
+  return NULL;
+}
+
+const gchar *gst_encoding_profile_get_description(GstEncodingProfile *profile)
+{
+  g_return_val_if_fail(profile != NULL, NULL);
+  return NULL;
+}
+
+GstEncodingProfile *gst_encoding_profile_ref(GstEncodingProfile *profile)
+{
+  g_return_val_if_fail(profile != NULL, NULL);
+  return profile;
+}
+
+void gst_encoding_profile_unref(GstEncodingProfile *profile)
+{
+  if (profile != NULL)
+    g_object_unref(profile);
+}
+
+const GList *gst_encoding_container_profile_get_profiles(GstEncodingContainerProfile *container)
+{
+  g_return_val_if_fail(container != NULL, NULL);
+  return NULL;
+}
+
+GstEncodingTarget *gst_encoding_target_load_from_file(const gchar *path, GError **error)
+{
+  if (error != NULL && *error == NULL)
+    *error = g_error_new_literal(G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                                 "gst-plugins-base (pbutils) is not available on OHOS");
+  return NULL;
+}
+
+const GList *gst_encoding_target_get_profiles(GstEncodingTarget *target)
+{
+  g_return_val_if_fail(target != NULL, NULL);
+  return NULL;
+}
+
+gboolean gst_is_missing_plugin_message(GstMessage *msg) { return FALSE; }
+gchar *gst_missing_plugin_message_get_installer_detail(GstMessage *msg) { return NULL; }
+gchar *gst_missing_plugin_message_get_description(GstMessage *msg) { return NULL; }
+
+#endif /* HAVE_STUB_DEPS */
