+/* buffer file for stdin: honour $TMPDIR before falling back to tmpfile(),
+   because some libcs hard-code the tmpfile() directory (OpenHarmony musl
+   uses /data/local/tmp, which ordinary processes cannot write), making
+   reading from a pipe impossible there. */
+static FILE *shed_tmpfile(void) {
+  const char *dir = getenv("TMPDIR");
+  char *path;
+  size_t n;
+  FILE *tf;
+  int fd, e;
+
+  if(!dir || !*dir)
+    return tmpfile();
+  n = strlen(dir) + sizeof("/shed-XXXXXX");
+  path = malloc(n);
+  if(!path)
+    return NULL;
+  snprintf(path,n,"%s/shed-XXXXXX",dir);
+  fd = mkstemp(path);
+  e = errno;
+  if(fd>=0)
+    unlink(path); /* anonymous, like tmpfile() */
+  free(path);
+  errno = e;
+  if(fd<0)
+    return NULL;
+  tf = fdopen(fd,"w+");
+  if(!tf)
+    close(fd);
+  return tf;
+}
