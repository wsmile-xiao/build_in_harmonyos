 ////////////////////////////////////////////////////////////
 void ThreadImpl::terminate()
 {
     if (m_isActive)
     {
-        #ifndef SFML_SYSTEM_ANDROID
-            pthread_cancel(m_thread);
-        #else
+        #if defined(SFML_SYSTEM_ANDROID)
             // See https://stackoverflow.com/questions/4610086/pthread-cancel-al
             pthread_kill(m_thread, SIGUSR1);
+        #elif !defined(SFML_HAS_PTHREAD_CANCEL)
+            // Targets without pthread_cancel cannot force asynchronous
+            // cancellation. Join instead of detaching so sf::Thread::terminate()
+            // does not return while the user entry point may still be using the
+            // owning sf::Thread object.
+            wait();
+        #else
+            pthread_cancel(m_thread);
         #endif
     }
 }
 
 
