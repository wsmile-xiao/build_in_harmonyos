diff -ruN a/cmake/Config.cmake b/cmake/Config.cmake
--- a/cmake/Config.cmake
+++ b/cmake/Config.cmake
@@ -9,25 +9,29 @@
     include(CheckTypeSize)
     check_type_size(void* SIZEOF_VOID_PTR)
     if(${SIZEOF_VOID_PTR} STREQUAL "4")
         set(ARCH_32BITS 1)
     elseif(${SIZEOF_VOID_PTR} STREQUAL "8")
         set(ARCH_64BITS 1)
     else()
         message(FATAL_ERROR "Unsupported architecture")
         return()
     endif()
-elseif(${CMAKE_SYSTEM_NAME} STREQUAL "Linux")
+elseif(${CMAKE_SYSTEM_NAME} STREQUAL "Linux" OR ${CMAKE_SYSTEM_NAME} STREQUAL "HarmonyOS")
     set(SFML_OS_UNIX 1)
     if(ANDROID)
         set(SFML_OS_ANDROID 1)
         # use the OpenGL ES implementation on Android
+        set(OPENGL_ES 1)
+    elseif(${CMAKE_SYSTEM_NAME} STREQUAL "HarmonyOS")
+        set(SFML_OS_LINUX 1)
+        # use the OpenGL ES implementation on HarmonyOS
         set(OPENGL_ES 1)
     else()
         set(SFML_OS_LINUX 1)
         # don't use the OpenGL ES implementation on Linux
         set(OPENGL_ES 0)
     endif()
 elseif(CMAKE_SYSTEM_NAME MATCHES "^k?FreeBSD$")
     set(SFML_OS_FREEBSD 1)
     # don't use the OpenGL ES implementation on FreeBSD
     set(OPENGL_ES 0)
