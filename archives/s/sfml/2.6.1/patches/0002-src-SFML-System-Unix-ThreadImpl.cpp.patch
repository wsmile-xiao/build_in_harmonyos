 ////////////////////////////////////////////////////////////
 void ThreadImpl::terminate()
 {
     if (m_isActive)
     {
-        #ifndef SFML_SYSTEM_ANDROID
-            pthread_cancel(m_thread);
-        #else
+        #ifdef SFML_SYSTEM_ANDROID
             // See https://stackoverflow.com/questions/4610086/pthread-cancel-al
             pthread_kill(m_thread, SIGUSR1);
+        #elif defined(__OHOS__)
+            // HarmonyOS doesn't support pthread_cancel or SIGUSR1
+            // Detach the thread and let it run until it naturally exits
+            pthread_detach(m_thread);
+        #else
+            pthread_cancel(m_thread);
         #endif
     }
 }
 
 
 ////////////////////////////////////////////////////////////
 void* ThreadImpl::entryPoint(void* userData)
 {
     // The Thread instance is stored in the user data
     Thread* owner = static_cast<Thread*>(userData);
 
-    #ifndef SFML_SYSTEM_ANDROID
+    #if !defined(SFML_SYSTEM_ANDROID) && !defined(__OHOS__)
         // Tell the thread to handle cancel requests immediately
+        // HarmonyOS and Android don't support pthread_cancel
         pthread_setcanceltype(PTHREAD_CANCEL_ASYNCHRONOUS, NULL);
     #endif
 
     // Forward to the owner
     owner->run();
 
     return NULL;
 }
 
 } // namespace priv
