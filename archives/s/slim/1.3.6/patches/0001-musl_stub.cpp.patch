diff -ruN /dev/null b/musl_stub.cpp
--- /dev/null
+++ b/musl_stub.cpp
@@ -0,0 +1,32 @@
+/* Stub implementation for missing musl libc functions
+ * HarmonyOS NEXT uses musl libc which does not provide:
+ * - getusershell/setusershell/endusershell (user shell access functions)
+ *
+ * These stubs allow compilation to succeed on musl-based systems.
+ * getusershell returns "/bin/sh" as a safe default shell.
+ */
+
+#include <string.h>
+
+static const char *default_shell = "/bin/sh";
+static int shell_index = 0;
+
+const char *getusershell(void)
+{
+    /* Only return one shell: /bin/sh */
+    if (shell_index == 0) {
+        shell_index++;
+        return default_shell;
+    }
+    return NULL;
+}
+
+void setusershell(void)
+{
+    shell_index = 0;
+}
+
+void endusershell(void)
+{
+    shell_index = 0;
+}