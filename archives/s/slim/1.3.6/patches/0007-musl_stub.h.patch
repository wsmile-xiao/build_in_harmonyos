diff -ruN /dev/null b/musl_stub.h
--- /dev/null
+++ b/musl_stub.h
@@ -0,0 +1,17 @@
+/* Stub declarations for missing musl libc functions
+ * HarmonyOS NEXT uses musl libc which does not provide:
+ * - getusershell/setusershell/endusershell (user shell access functions)
+ * - shadow.h / getspnam / endspent (shadow password functions)
+ *
+ * These declarations allow compilation on musl-based systems.
+ * Implementations are in musl_stub.cpp
+ */
+#ifndef _MUSL_STUB_H
+#define _MUSL_STUB_H
+
+/* User shell functions - normally in <unistd.h> on glibc */
+const char *getusershell(void);
+void setusershell(void);
+void endusershell(void);
+
+#endif /* _MUSL_STUB_H */