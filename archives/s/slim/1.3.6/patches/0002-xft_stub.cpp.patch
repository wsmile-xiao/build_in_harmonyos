diff -ruN /dev/null b/xft_stub.cpp
--- /dev/null
+++ b/xft_stub.cpp
@@ -0,0 +1,118 @@
+/* Stub Xft implementation for HarmonyOS NEXT build
+ * Xft (X FreeType extension) library is not available on HarmonyOS.
+ * These stub implementations allow compilation to succeed but the
+ * resulting binary will NOT render text correctly.
+ *
+ * SLiM fundamentally depends on Xft for text rendering in its login panel.
+ * Without a real Xft library, the login manager cannot display any text.
+ * This is an inherent incompatibility between X11 login managers and
+ * HarmonyOS NEXT (which uses Wayland/HiDisplay instead of X11).
+ */
+
+#include <X11/Xlib.h>
+#include "X11/Xft/Xft.h"
+#include <stdlib.h>
+
+/* Stub XftDraw */
+struct _XftDraw {
+    Display *dpy;
+    Drawable drawable;
+    Visual *visual;
+    Colormap colormap;
+};
+
+XftDraw* XftDrawCreate(Display *dpy, Drawable drawable, Visual *visual, Colormap colormap)
+{
+    XftDraw *draw = (XftDraw*)calloc(1, sizeof(XftDraw));
+    if (draw) {
+        draw->dpy = dpy;
+        draw->drawable = drawable;
+        draw->visual = visual;
+        draw->colormap = colormap;
+    }
+    return draw;
+}
+
+void XftDrawDestroy(XftDraw *draw)
+{
+    if (draw) {
+        free(draw);
+    }
+}
+
+XftFont* XftFontOpenName(Display *dpy, int screen, const char *name)
+{
+    /* Stub: return a minimal font structure */
+    XftFont *font = (XftFont*)calloc(1, sizeof(XftFont));
+    if (font) {
+        font->ascent = 12;
+        font->descent = 3;
+        font->height = 15;
+        font->max_advance_width = 8;
+    }
+    return font;
+}
+
+void XftFontClose(Display *dpy, XftFont *font)
+{
+    if (font) {
+        free(font);
+    }
+}
+
+Bool XftColorAllocName(Display *dpy, Visual *visual, Colormap colormap,
+                       const char *name, XftColor *color)
+{
+    /* Stub: set color to white as default */
+    if (color) {
+        color->red = 0xFFFF;
+        color->green = 0xFFFF;
+        color->blue = 0xFFFF;
+        color->alpha = 0xFFFF;
+        color->pixel = WhitePixel(dpy, DefaultScreen(dpy));
+    }
+    return True;
+}
+
+void XftColorFree(Display *dpy, Visual *visual, Colormap colormap, XftColor *color)
+{
+    /* Stub: nothing to free */
+}
+
+void XftDrawString8(XftDraw *draw, XftColor *color, XftFont *font,
+                     int x, int y, const XftChar8 *string, int len)
+{
+    /* Stub: no rendering happens - text will not appear */
+}
+
+void XftDrawStringUtf8(XftDraw *draw, XftColor *color, XftFont *font,
+                        int x, int y, const FcChar8 *string, int len)
+{
+    /* Stub: no rendering happens - text will not appear */
+}
+
+void XftTextExtents8(Display *dpy, XftFont *font, const XftChar8 *string, int len, XGlyphInfo *extents)
+{
+    /* Stub: return minimal extent info */
+    if (extents) {
+        extents->width = len * 8;
+        extents->height = font ? font->height : 15;
+        extents->x = 0;
+        extents->y = 0;
+        extents->xOff = len * 8;
+        extents->yOff = 0;
+    }
+}
+
+void XftTextExtentsUtf8(Display *dpy, XftFont *font, const FcChar8 *string, int len, XGlyphInfo *extents)
+{
+    /* Stub: return minimal extent info */
+    if (extents) {
+        extents->width = len * 8;
+        extents->height = font ? font->height : 15;
+        extents->x = 0;
+        extents->y = 0;
+        extents->xOff = len * 8;
+        extents->yOff = 0;
+    }
+}