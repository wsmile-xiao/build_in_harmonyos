--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,61 @@
+# CMakeLists.txt — SASM 3.15.0 (OHOS 适配)
+# 上游构建系统为 qmake（SASM.pro）；本文件声明等价目标：
+#   sasm — Qt5 Widgets GUI 应用（Core/Gui/Widgets/Network）
+# sources/headers/资源/表单 与 SASM.pro 逐项对应。
+# singleapplication 子树：与上游 qtsingleapplication.pri 保持一致，仅编
+# qtsingleapplication.cpp 与 qtlocalpeer.cpp —— qtlocalpeer.cpp 在
+# QtLP_Private 命名空间内源码内嵌 #include "qtlockedfile.cpp"/_unix.cpp，
+# 这两个 .cpp 不可再单独编译（否则 QtLockedFile 定义落在命名空间外）。
+cmake_minimum_required(VERSION 3.16)
+project(sasm VERSION 3.15.0 LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_AUTOMOC ON)
+set(CMAKE_AUTOUIC ON)
+set(CMAKE_AUTORCC ON)
+
+find_package(Qt5 REQUIRED COMPONENTS Core Gui Widgets Network)
+
+add_executable(sasm
+    main.cpp
+    mainwindow.cpp
+    tab.cpp
+    highlighter.cpp
+    codeeditor.cpp
+    debugger.cpp
+    finddialog.cpp
+    ruqtextedit.cpp
+    ruqplaintextedit.cpp
+    getstartedwidget.cpp
+    debugtablewidget.cpp
+    watchsettingswidget.cpp
+    debuganycommandwidget.cpp
+    assembler.cpp
+    nasm.cpp
+    gas.cpp
+    common.cpp
+    fasm.cpp
+    signallocker.cpp
+    masm.cpp
+    gccbasedassembler.cpp
+    singleapplication/qtsingleapplication.cpp
+    singleapplication/qtlocalpeer.cpp
+    settings.ui
+    Languages.qrc
+    Images.qrc
+    Help.qrc
+)
+
+target_include_directories(sasm PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/singleapplication
+)
+
+target_link_libraries(sasm PRIVATE
+    Qt5::Core
+    Qt5::Gui
+    Qt5::Widgets
+    Qt5::Network
+)
+
+install(TARGETS sasm RUNTIME DESTINATION bin)
