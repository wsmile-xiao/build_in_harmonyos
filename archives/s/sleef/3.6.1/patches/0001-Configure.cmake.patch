diff -ruN a/Configure.cmake b/Configure.cmake
--- a/Configure.cmake
+++ b/Configure.cmake
@@ -92,20 +92,32 @@

 # Sanitizers
 if(SLEEF_ASAN)
   # Add address sanitizing to all targets
   add_compile_options(-fno-omit-frame-pointer -fsanitize=address)
   add_link_options(-fno-omit-frame-pointer -fsanitize=address)
 endif()

 # TARGET PROCESSOR DETECTION
 set(SLEEF_TARGET_PROCESSOR "${CMAKE_SYSTEM_PROCESSOR}")
+# HarmonyOS special handling: CMAKE_SYSTEM_PROCESSOR is unknown, detect via uname
+if(NOT SLEEF_TARGET_PROCESSOR OR SLEEF_TARGET_PROCESSOR STREQUAL "unknown")
+  execute_process(
+    COMMAND uname -m
+    OUTPUT_VARIABLE UNAME_PROCESSOR
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+  )
+  if(UNAME_PROCESSOR)
+    set(SLEEF_TARGET_PROCESSOR "${UNAME_PROCESSOR}")
+    message(STATUS "Detected processor via uname: ${SLEEF_TARGET_PROCESSOR} (HarmonyOS)")
+  endif()
+endif()
 if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_OSX_ARCHITECTURES MATCHES "^(x86_64|arm64)$")
   set(SLEEF_TARGET_PROCESSOR "${CMAKE_OSX_ARCHITECTURES}")
 endif()

 # PLATFORM DETECTION
 if(CMAKE_SIZEOF_VOID_P EQUAL 4)
   set(SLEEF_ARCH_32BIT ON CACHE INTERNAL "True for 32-bit architecture.")
 endif()

 if(SLEEF_TARGET_PROCESSOR MATCHES "(x86|AMD64|amd64|^i.86$)")