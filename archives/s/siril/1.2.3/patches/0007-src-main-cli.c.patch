--- a/src/main-cli.c
+++ b/src/main-cli.c
@@ -97,6 +97,37 @@
 	list_format_available();
 	exit(EXIT_SUCCESS);
 	return TRUE;
+}
+
+/* OHOS (R30): g_application_run() on the OHOS glib/musl stack deadlocks in a
+ * futex when a GOptionEntry ARG_CALLBACK exits from inside option parsing
+ * (exit() while GApplication still holds an internal lock).  The glib
+ * built-in --help path returns cleanly, but every user callback option
+ * (--version/-v, --copyright/-c, --format/-f) hangs forever, which breaks
+ * headless `siril-cli --version` smoke tests.  Handle those pure
+ * "print and exit" options in main() before any GApplication is created.
+ * Output format mirrors the original GOptionEntry callbacks. */
+static gboolean _cli_handle_early_print_options(int argc, char **argv) {
+	for (int i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--version") || !strcmp(argv[i], "-v")) {
+#ifdef SIRIL_UNSTABLE
+			printf("%s %s-%s\n", PACKAGE, VERSION, SIRIL_GIT_VERSION_ABBREV);
+#else
+			printf("%s %s\n", PACKAGE, VERSION);
+#endif
+			return TRUE;
+		}
+		if (!strcmp(argv[i], "--copyright") || !strcmp(argv[i], "-c")) {
+			printf("Copyright (c) 2012-%s team free-astro\n",
+			       SIRIL_GIT_LAST_COMMIT_YEAR);
+			return TRUE;
+		}
+		if (!strcmp(argv[i], "--format") || !strcmp(argv[i], "-f")) {
+			list_format_available();
+			return TRUE;
+		}
+	}
+	return FALSE;
 }
 
 static GOptionEntry main_option[] = {
@@ -300,6 +331,10 @@
 	GApplication *app;
 	const gchar *dir;
 	gint status;
+	/* OHOS (R30): print-and-exit options first so we never enter the
+	 * deadlocking GApplication option-callback path (see helper above). */
+	if (_cli_handle_early_print_options(argc, argv))
+		return EXIT_SUCCESS;
 
 #if defined(ENABLE_RELOCATABLE_RESOURCES) && defined(OS_OSX)
