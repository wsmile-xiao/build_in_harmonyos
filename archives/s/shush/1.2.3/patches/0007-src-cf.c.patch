--- a/src/cf.c
+++ b/src/cf.c
@@ -398,24 +398,34 @@
 
     assert( reports == NULL );
 
     cf_timestamp = 0;
     /* Map the configuration file to memory so it can be parsed */
     switch (mapfile(fname, -1, (void **)&conf, &cflen))
       {
       case 0:
 	  /* OK! */
 	  cf_timestamp = mapstat()->st_mtime;
+#if defined(RELAXED_OWNERSHIP)
+	  /*
+	  ** The file system projects ownership onto a shared identity and
+	  ** forces the group write bit (e.g. HarmonyOS HMDFS), so only the
+	  ** world writable bit remains meaningful.
+	  */
+	  if ((mapstat()->st_mode & S_IWOTH) != 0)
+	    error("%s must not be world writable!", fname);
+#else
 	  if (mapstat()->st_uid != geteuid())
 	      error("someone else owns %s!", fname);
 	  else if ((mapstat()->st_mode & (S_IWGRP|S_IWOTH)) != 0)
 	    error("%s must not be group or world writable!", fname);
+#endif
 	  else
 	      break;
 	  exit(1);
       case 1:
 	  error("Configuration file \"%s\" does not exist.", fname);
 	  /* FALLTHRU */
       default:
 	  exit(1);
       }
 
