--- a/configure
+++ b/configure
@@ -13635,12 +13635,16 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  # HarmonyOS/HMDFS: mktemp -d 会创建 drwx--S--- 目录（属主 uid 被映射，
+  # setgid），config.status 随后写入 subs1.awk 报 Permission denied。
+  # 改用普通 mkdir + 默认 umask，目录即可正常读写。
+  tmp="${TMPDIR:-$HOME/tmp}/conf$$-$RANDOM" &&
+  mkdir -p "$tmp" &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
