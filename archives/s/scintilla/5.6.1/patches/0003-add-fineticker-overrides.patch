From: OpenDesk <opendesk>
Date: 2026-04-01
Subject: [PATCH 3/4] Add FineTicker overrides to prevent runtime crash

Editor base class FineTickerCancel/Start/Running contain assert(false).
Override with stub implementations using std::bitset<TickReason::dwell>.

Files: ohos/ScintillaOHOS.cxx
--- a/ohos/ScintillaOHOS.cxx	2026-04-02 00:19:14.668105626 +0800
+++ b/ohos/ScintillaOHOS.cxx	2026-04-02 00:19:14.688100313 +0800
@@ -22,6 +22,7 @@
 #include <memory>
 #include <functional>
 #include <algorithm>
+#include <bitset>
 
 // Scintilla core headers - must follow this exact order (same as GTK build)
 #include "ScintillaTypes.h"
@@ -123,6 +124,9 @@
     std::function<std::string()> clipboardGetter;
     std::function<void(const std::string &)> clipboardSetter;
 
+    // FineTicker support
+    std::bitset<static_cast<size_t>(TickReason::dwell)> tickerReasons;
+
     // Size state
     int editorWidth = 800;
     int editorHeight = 600;
@@ -297,6 +301,21 @@
         (void)rc;
     }
 
+    // ----------------------------------------------------------------
+    // FineTicker overrides (prevent Editor base class assert(false))
+    // ----------------------------------------------------------------
+
+    bool FineTickerRunning(TickReason reason) override {
+        return tickerReasons.test(static_cast<size_t>(reason));
+    }
+    void FineTickerStart(TickReason reason, int millis, int tolerance) override {
+        tickerReasons.set(static_cast<size_t>(reason));
+        (void)millis; (void)tolerance;
+    }
+    void FineTickerCancel(TickReason reason) override {
+        tickerReasons.reset(static_cast<size_t>(reason));
+    }
+
