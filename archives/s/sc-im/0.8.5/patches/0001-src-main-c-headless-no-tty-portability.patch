--- a/src/main.c
+++ b/src/main.c
@@ -308,7 +308,14 @@
         }
     } else {
         f = fopen("/dev/tty", "rw");
-        if (f == NULL) sc_error("fatal error loading stdin");
+        if (f == NULL) {
+            // Headless run: there is no interactive input source. Quit after
+            // load instead of dereferencing f below (fgetws would take NULL),
+            // and keep the message off stderr so the non-interactive output
+            // contract (what the upstream tests assert on) stays clean.
+            sc_debug("no /dev/tty available (headless), quitting after load");
+            put(user_conf_d, "quit_afterload", "1");
+        }
     }
 
     // handle input from keyboard
@@ -416,8 +423,16 @@
     if (f != NULL) fclose(f);
 
     if ( ! freopen("/dev/tty", "rw", stdin)) {
-        perror(NULL);
-        exit(-1);
+        // No controlling terminal (headless/CI/conan test/plain pipeline).
+        // Upstream prints errno and exit(-1) here, which makes every
+        // non-interactive run (--version, --help, piped commands) return 255
+        // with a stray "Bad file descriptor" line on stderr. Keep running:
+        // main() cannot open /dev/tty either and will set quit_afterload so
+        // the interactive loop is skipped and the app exits normally.
+        sc_debug("no /dev/tty available (headless), continuing");
+        clearerr(stdin);
+        put(user_conf_d, "quit_afterload", "1");
+        return;
     }
     //sc_debug("finish reading");
 }
