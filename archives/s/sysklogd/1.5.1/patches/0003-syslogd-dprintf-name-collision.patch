-#if defined(__GLIBC__)
+/* The private debug printf below is called dprintf().  glibc declares
+ * POSIX dprintf(int, const char *, ...) in <stdio.h>, so upstream renamed
+ * the private one for __GLIBC__ only.  Musl-derived sysroots declare that
+ * same POSIX prototype without defining __GLIBC__, which makes the guard
+ * miss and the declaration clash:
+ *   error: static declaration of dprintf follows non-static declaration
+ * The symbol is file-local, so renaming it unconditionally is a no-op on
+ * every libc that has no dprintf() and correct on every libc that has. */
 #define dprintf mydprintf
-#endif /* __GLIBC__ */
 static void dprintf(char *, ...);
