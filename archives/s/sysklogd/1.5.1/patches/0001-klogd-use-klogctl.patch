--- a/klogd.c
+++ b/klogd.c
@@ -277,13 +277,27 @@
 
 #define __LIBRARY__
 #include <linux/unistd.h>
-#if !defined(__GLIBC__)
-# define __NR_ksyslog __NR_syslog
-_syscall3(int,ksyslog,int, type, char *, buf, int, len);
-#else
+/* Read the kernel log through the C library's klogctl() wrapper rather than
+ * assembling a raw syscall stub with _syscall3().
+ *
+ * _syscall3() is a glibc-era kernel-header macro.  Modern <linux/unistd.h>
+ * copies -- musl's and the HarmonyOS OHOS sysroot's among them -- ship the
+ * __NR_syslog number but no _syscallN() helper at all.  On such a libc the
+ * old "not glibc => roll our own syscall" branch does NOT fail at compile
+ * time: clang parses the missing macro as an implicit-int function
+ * declaration (only -Wimplicit-int warnings), klogd.o still builds, and the
+ * first real error defers to the link step, where ld.lld reports
+ * "undefined symbol: ksyslog".  Roll-your-own syscall is also unnecessary:
+ * exactly those libcs provide klogctl(), which is the documented wrapper
+ * around the same __NR_syslog call.  Using the wrapper is therefore
+ * portable *and* functionally identical -- kernel log reading remains
+ * fully available, no feature is configured out.
+ *
+ * The extern prototype (int ksyslog(int, char *, int)) used further below
+ * lines up with klogctl(int, char *, int) after this substitution.
+ */
 #include <sys/klog.h>
 #define ksyslog klogctl
-#endif
 
 #define LOG_BUFFER_SIZE 4096
 #define LOG_LINE_LENGTH 1000
