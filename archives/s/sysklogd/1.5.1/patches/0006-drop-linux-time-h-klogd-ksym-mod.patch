--- a/klogd.c
+++ b/klogd.c
@@ -263,7 +263,12 @@
 #include <sys/fcntl.h>
 #include <sys/stat.h>
 #if !defined(__GLIBC__)
-#include <linux/time.h>
+/* <linux/time.h> is an installed kernel header that defines struct timespec
+ * with no guard against the C library one.  On a musl-derived sysroot
+ * bits/alltypes.h has already defined struct timespec, so including it is a
+ * redefinition error.  No symbol from the kernel header is used here, the
+ * userspace <time.h> is what this include was standing in for. */
+#include <time.h>
 #endif /* __GLIBC__ */
 #include <stdarg.h>
 #include <paths.h>
