--- /dev/null
+++ b/tests/test_asmix.c
@@ -0,0 +1,49 @@
+/* test_asmix.c — asmix 1.5 上游测试补全（单元测试）
+ *
+ * 直接 include 真实源码 ../asmix.c（将 main 重命名为 asmix_orig_main 避免冲突），
+ * 使 aToVol()/VolToa() 断言作用于**被测包真实代码**而非复制品（R34/检视 P2）。
+ * 测试仅依赖 libm，不触发 X11 路径。
+ */
+#include <math.h>
+#include <stdio.h>
+
+/* 隔离真实 asmix.c 的 main：本测试提供自己的 main */
+#define main asmix_orig_main
+#include "../asmix.c"
+#undef main
+
+#define TEST_ASSERT(cond)                                                     \
+  do {                                                                        \
+    if (!(cond)) {                                                            \
+      fprintf(stderr, "FAIL: %s (line %d)\n", #cond, __LINE__);               \
+      return 1;                                                               \
+    }                                                                         \
+  } while (0)
+
+int main(void)
+{
+  /* 边界：起始角度 3*M_PI/4 -> 音量 0 */
+  TEST_ASSERT(aToVol(3 * M_PI / 4) == 0);
+  /* 满角度：3*M_PI/4 + 1.5*M_PI -> 音量 100 */
+  TEST_ASSERT(aToVol(3 * M_PI / 4 + 1.5 * M_PI) == 100);
+  /* 中间：半程 -> 音量 50 */
+  TEST_ASSERT(aToVol(3 * M_PI / 4 + 0.75 * M_PI) == 50);
+  /* 角度回绕：负角应归一化到 [0, 2*M_PI) 后映射 */
+  TEST_ASSERT(aToVol(-M_PI / 4) >= 0 && aToVol(-M_PI / 4) <= 100);
+  /* 越界 clamp：超大角度 -> 100 */
+  TEST_ASSERT(aToVol(3 * M_PI / 4 + 10 * M_PI) == 100);
+  /* 回绕一致性：0 与 2*M_PI 同角，映射相同 */
+  TEST_ASSERT(aToVol(0.0) == aToVol(2 * M_PI));
+
+  /* 反向映射：音量 0 -> 起始角度 */
+  TEST_ASSERT(fabs(VolToa(0) - 3 * M_PI / 4) < 1e-9);
+  /* 反向映射：音量 100 -> 满角度（可能回绕） */
+  TEST_ASSERT(VolToa(100) <= M_PI || VolToa(100) >= 2 * M_PI - 1e-6);
+  /* 往返一致性：aToVol(VolToa(50)) == 50 */
+  TEST_ASSERT(aToVol(VolToa(50)) == 50);
+  TEST_ASSERT(aToVol(VolToa(100)) == 100);
+  TEST_ASSERT(aToVol(VolToa(0)) == 0);
+
+  printf("PASS: asmix 1.5 单元测试全部通过（真实 asmix.c 的 aToVol/VolToa，11 项断言）\n");
+  return 0;
+}

--- /dev/null
+++ b/tests/Makefile
@@ -0,0 +1,22 @@
+# tests/Makefile — asmix 1.5 上游测试补全
+# 单元测试：include 真实 asmix.c 的 aToVol/VolToa（隔离 main），11 项断言。
+# 用法: make -C tests check X11_INCDIRS='...' X11_LIBDIRS='...' X11_LDPATH='...'
+#   X11_INCDIRS/X11_LIBDIRS 传给编译器（-I/-L）；X11_LDPATH 为冒号分隔的
+#   库目录，供运行期 LD_LIBRARY_PATH（真实 asmix.c 引用 X11 符号）。
+
+CC        ?= clang
+CFLAGS    ?= -O2 -Wall -Wno-implicit-function-declaration
+X11_INCDIRS ?=
+X11_LIBDIRS ?=
+X11_LDPATH ?=
+LDLIBS    := -lX11 -lXext -lm
+
+test_asmix: test_asmix.c
+	$(CC) $(CFLAGS) $(X11_INCDIRS) -I.. test_asmix.c -o test_asmix $(X11_LIBDIRS) $(LDLIBS)
+
+check: test_asmix
+	LD_LIBRARY_PATH="$(X11_LDPATH)" ./test_asmix
+
+.PHONY: check clean
+clean:
+	rm -f test_asmix
