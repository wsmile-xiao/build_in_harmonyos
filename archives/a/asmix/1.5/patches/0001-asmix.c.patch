 /****************************************************************************/
 /* Removes expose events for a specific window from the queue */
 int flush_expose (Window w)
 {
   XEvent dummy;
   int i=0;
   
   while (XCheckTypedWindowEvent (dpy, w, Expose, &dummy))i++;
   return i;
 }
 
