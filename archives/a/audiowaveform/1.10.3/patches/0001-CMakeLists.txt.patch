diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -92,20 +92,31 @@
             set(ZLIB_ROOT "/usr/local/opt/zlib")
         endif()
     endif()
 endif(BUILD_STATIC)
 
 find_package(LibGD REQUIRED)
 if(LIBGD_FOUND)
     message(STATUS "LIBGD_INCLUDE_DIRS='${LIBGD_INCLUDE_DIRS}'")
     message(STATUS "LIBGD_LIBRARIES=${LIBGD_LIBRARIES}")
     include_directories(${LIBGD_INCLUDE_DIRS})
+    # When libgd.a (static) is found, add its transitive dependencies
+    if(LIBGD_LIBRARIES MATCHES "\\.a$")
+        find_package(PNG REQUIRED)
+        find_package(JPEG REQUIRED)
+        find_package(TIFF REQUIRED)
+        find_package(Freetype REQUIRED)
+        find_package(ZLIB REQUIRED)
+        list(APPEND LIBGD_LIBRARIES ${PNG_LIBRARIES} ${JPEG_LIBRARIES} ${TIFF_LIBRARIES} ${FREETYPE_LIBRARIES} ${ZLIB_LIBRARIES})
+        list(APPEND LIBGD_INCLUDE_DIRS ${PNG_INCLUDE_DIRS} ${JPEG_INCLUDE_DIRS} ${TIFF_INCLUDE_DIRS} ${FREETYPE_INCLUDE_DIRS} ${ZLIB_INCLUDE_DIRS})
+        include_directories(${PNG_INCLUDE_DIRS} ${JPEG_INCLUDE_DIRS} ${TIFF_INCLUDE_DIRS} ${FREETYPE_INCLUDE_DIRS} ${ZLIB_INCLUDE_DIRS})
+    endif()
 endif(LIBGD_FOUND)
 
 find_package(LibSndFile REQUIRED)
