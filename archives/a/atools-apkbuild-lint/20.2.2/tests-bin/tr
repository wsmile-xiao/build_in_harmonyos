#!/bin/sh
# tr wrapper: handle toybox differences, delegate to real tr
_real=""
IFS=":"
for dir in $PATH; do
  case "$dir" in *tests-bin*) continue;; esac
  if [ -x "$dir/tr" ]; then _real="$dir/tr"; break; fi
done
unset IFS
if [ -z "$_real" ]; then _real="/system/bin/tr"; fi
if [ -x "$_real" ]; then exec "$_real" "$@"
else exec tr "$@"
fi
