#!/bin/sh
# 最小 unexpand(1) —— 仅覆盖上游 tests/*.bats 中 retab() 的用法：
#   retab() { case $(realpath "$(which unexpand)") in *busybox*) flag="-f";;
#             *) flag="--first-only";; esac; unexpand $flag -t4; }
# OHOS toybox 未提供 unexpand；本实现只折叠行首空白（与 --first-only /
# busybox -f 语义一致），行内空白原样保留。
# 实现代码在同级 unexpand.py；解释器运行时从环境解析（优先 HMBS_PYTHON3，
# 其次 PATH 中可用的 python3/python），并做一次真实可用性探测，避免命中
# 不可用的同名存根；不烘焙配方进程的路径。

P3=""
if [ -n "${HMBS_PYTHON3:-}" ] && [ -x "${HMBS_PYTHON3}" ]; then
    if "${HMBS_PYTHON3}" -c "import sys" >/dev/null 2>&1; then
        P3="${HMBS_PYTHON3}"
    fi
fi
if [ -z "$P3" ]; then
    for _cand in python3 python; do
        if command -v "$_cand" >/dev/null 2>&1 && "$_cand" -c "import sys" >/dev/null 2>&1; then
            P3="$(command -v "$_cand")"
            break
        fi
    done
fi
if [ -z "$P3" ]; then
    for _cand in "${HMBS_PYTHON3:-}"; do
        [ -n "$_cand" ] || continue
        if command -v "$_cand" >/dev/null 2>&1 && "$_cand" -c "import sys" >/dev/null 2>&1; then
            P3="$(command -v "$_cand")"
            break
        fi
        if [ -x "$_cand" ] && "$_cand" -c "import sys" >/dev/null 2>&1; then
            P3="$_cand"
            break
        fi
    done
fi
if [ -z "$P3" ]; then
    echo "unexpand mock: no usable python interpreter found (HMBS_PYTHON3=${HMBS_PYTHON3:-unset})" >&2
    exit 127
fi

_self="$0"
case "$_self" in
    */*) DIR="${_self%/*}" ;;
    *) DIR="." ;;
esac

exec "$P3" "$DIR/unexpand.py" "$@"
