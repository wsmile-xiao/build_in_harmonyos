#!/bin/sh
# grep wrapper: delegate to system grep when available (lightweight, avoids python fork OOM)
# Fallback to python grep.py only if no system grep found
_real=""
IFS=":"
for dir in $PATH; do
  case "$dir" in *tests-bin*) continue;; esac
  if [ -x "$dir/grep" ]; then _real="$dir/grep"; break; fi
done
unset IFS
if [ -z "$_real" ]; then
  for _cand in /system/bin/grep /bin/grep /usr/bin/grep; do
    if [ -x "$_cand" ]; then _real="$_cand"; break; fi
  done
fi
if [ -n "$_real" ] && [ -x "$_real" ]; then
  exec "$_real" "$@"
fi
# fallback python
P3=""
if [ -n "${HMBS_PYTHON3:-}" ] && [ -x "${HMBS_PYTHON3}" ]; then
  if "${HMBS_PYTHON3}" -c "import sys" >/dev/null 2>&1; then P3="${HMBS_PYTHON3}"; fi
fi
if [ -z "$P3" ]; then
  for _cand in python3 python; do
    if command -v "$_cand" >/dev/null 2>&1 && "$_cand" -c "import sys" >/dev/null 2>&1; then P3="$(command -v "$_cand")"; break; fi
  done
fi
if [ -z "$P3" ]; then echo "grep wrapper: no python (HMBS_PYTHON3=${HMBS_PYTHON3:-unset})" >&2; exit 127; fi
_self="$0"; case "$_self" in */*) DIR="${_self%/*}";; *) DIR=".";; esac
exec "$P3" -W ignore "$DIR/grep.py" "$@"
