#!/bin/sh
# sort wrapper: strip -V which toybox lacks
P3=""
for _cand in "${HMBS_PYTHON3:-}" python3 python; do
    [ -n "$_cand" ] || continue
    if command -v "$_cand" >/dev/null 2>&1 && "$_cand" -c "import sys" >/dev/null 2>&1; then
        P3="$(command -v "$_cand")"
        break
    fi
done
args=""
for a in "$@"; do
  case "$a" in -V|--version-sort) continue;; *) args="$args $a";; esac
done
# find real sort not in tests-bin
_real=""
IFS=":"
for dir in $PATH; do
  case "$dir" in ""|".") dir=".";; esac
  case "$dir" in *tests-bin*) continue;; esac
  if [ -x "$dir/sort" ]; then _real="$dir/sort"; break; fi
done
unset IFS
if [ -z "$_real" ]; then _real="/system/bin/sort"; fi
if [ -x "$_real" ]; then exec "$_real" $args
else exec sort $args
fi
