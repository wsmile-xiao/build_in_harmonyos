#!/bin/sh
# cat wrapper: support -n (number lines) for toybox compatibility
has_n=0
for a in "$@"; do case "$a" in -n) has_n=1;; -n*) has_n=1;; esac; done
if [ "$has_n" = "1" ]; then
  # use awk to number lines
  if command -v awk >/dev/null 2>&1; then
    # filter out -n from args
    files=""
    for a in "$@"; do case "$a" in -n|-n*) continue;; *) files="$files $a";; esac; done
    # shellcheck disable=SC2086
    if [ -z "$files" ]; then
      awk '{printf "%6d\t%s\n", NR, $0}'
    else
      # shellcheck disable=SC2086
      awk '{printf "%6d\t%s\n", NR, $0}' $files
    fi
    exit $?
  fi
fi
# fallback to real cat
_real=""
IFS=":"
for dir in $PATH; do
  case "$dir" in *tests-bin*) continue;; esac
  if [ -x "$dir/cat" ]; then _real="$dir/cat"; break; fi
done
unset IFS
if [ -z "$_real" ]; then _real="/system/bin/cat"; fi
if [ -x "$_real" ]; then exec "$_real" "$@"
else exec cat "$@"
fi
