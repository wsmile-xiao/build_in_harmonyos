+      printf("autocutsel 0.10.1\n");
+      return 0;
+    }
+    if (strcmp(argv[i], "--help") == 0 || strcmp(argv[i], "-h") == 0) {
+      printf("usage:  %s [-selection <name>] [-cutbuffer <number>]"
+        " [-pause <milliseconds>] [-debug] [-verbose] [-fork] [-buttonup]\n",
+        argv[0]);
+      printf("\nSynchronizes the CLIPBOARD and PRIMARY X11 selections.\n");
+      return 0;
+    }
+  }
+
   Widget top;
