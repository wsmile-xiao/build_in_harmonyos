--- a/alberta_util/src/parameters.c
+++ b/alberta_util/src/parameters.c
@@ -33,6 +33,7 @@
 #include <stdarg.h>
 #include <string.h>
 #include <strings.h>
+#include <stdlib.h>
 
 #include "alberta_util.h"
 
@@ -648,15 +649,31 @@
   fp = NULL;
 
   time(&act_time);
-  if (sys_test("test -w", "/tmp"))               /* you may write to /tmp  */
-  {
-    const char  *file = get_filename(fn);
-    sprintf(tmp_file, "/tmp/%s.cpp", file);
-    if (sys_test("test -f", tmp_file))           /* file exists :-( */
-    {
-      sprintf(tmp_file, "/tmp/%s.cpp.%d", file, (int) act_time);
-      if (sys_test("test -f", tmp_file))            /* file exists :-( */
-	*tmp_file = 0;
+  tmp_file[0] = '\0';
+  {
+    /* HMBS portability: /tmp is read-only on the HarmonyOS worker.
+     * Honor the injected TMPDIR/TMP/TEMP first, keep /tmp only as a
+     * fallback when it is actually writable. No test is removed. */
+    const char *tmp_root = getenv("TMPDIR");
+    if (!tmp_root || !*tmp_root)
+      tmp_root = getenv("TMP");
+    if (!tmp_root || !*tmp_root)
+      tmp_root = getenv("TEMP");
+    if ((!tmp_root || !*tmp_root || !sys_test("test -w", tmp_root))
+        && sys_test("test -w", "/tmp"))
+      tmp_root = "/tmp";
+    else if (!tmp_root || !*tmp_root || !sys_test("test -w", tmp_root))
+      tmp_root = NULL;
+    if (tmp_root)
+    {
+      const char  *file = get_filename(fn);
+      sprintf(tmp_file, "%s/%s.cpp", tmp_root, file);
+      if (sys_test("test -f", tmp_file))           /* file exists :-( */
+      {
+        sprintf(tmp_file, "%s/%s.cpp.%d", tmp_root, file, (int) act_time);
+        if (sys_test("test -f", tmp_file))            /* file exists :-( */
+          *tmp_file = 0;
+      }
     }
   }
 
