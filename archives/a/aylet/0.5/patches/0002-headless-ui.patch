--- /dev/null
+++ b/ui-stdout.c
@@ -0,0 +1,87 @@
+/* Headless UI backend for stdout PCM mode. */
+
+#include <signal.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "main.h"
+#include "ui.h"
+
+static int need_update = 1;
+static int need_nexttrack = 0;
+
+static int non_ui_frame(void)
+{
+  static int oldfile = -1;
+  static int oldtrack = -1;
+
+  if (need_update)
+  {
+    need_update = 0;
+    if (ay_file != oldfile)
+    {
+      char *filename = ay_filenames[ay_file];
+      char *ptr = strrchr(filename, '/');
+
+      fprintf(stderr,
+              "\n   File: %s\n   Misc: %s\n Author: %s\n Tracks: %3d\n",
+              ptr ? ptr + 1 : filename, aydata.miscstr, aydata.authorstr,
+              aydata.num_tracks);
+    }
+    if (ay_file != oldfile || ay_track != oldtrack)
+    {
+      oldtrack = ay_track;
+      fprintf(stderr, "Playing: %3d - %s\n", ay_track + 1,
+              aydata.tracks[ay_track].namestr);
+    }
+    oldfile = ay_file;
+  }
+
+  if (!playing && !paused)
+    return action_callback(cb_quit);
+
+  if (need_nexttrack)
+  {
+    need_nexttrack = 0;
+    return action_callback(cb_next_track);
+  }
+
+  return 1;
+}
+
+static void non_ui_ctrlc(int signal_number)
+{
+  (void)signal_number;
+  if (tunetime.min == 0 && tunetime.sec == 0 &&
+      tunetime.subsecframes < 25)
+    playing = 0;
+  else
+    need_nexttrack = 1;
+}
+
+void ui_init(int argc, char **argv)
+{
+  struct sigaction sa;
+  (void)argc;
+  (void)argv;
+
+  sa.sa_flags = SA_RESTART;
+  sa.sa_handler = non_ui_ctrlc;
+  sigemptyset(&sa.sa_mask);
+  sigaction(SIGINT, &sa, NULL);
+  need_update = 1;
+}
+
+int ui_frame(void)
+{
+  return non_ui_frame();
+}
+
+void ui_change_notify(void)
+{
+  need_update = 1;
+}
+
+void ui_end(void)
+{
+}
