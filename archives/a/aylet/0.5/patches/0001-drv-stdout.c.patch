--- /dev/null
+++ b/drv-stdout.c
@@ -0,0 +1,33 @@
+/* Portable audio backend for platforms without OSS or OpenBSD audio APIs. */
+
+#include <unistd.h>
+
+#include "sound.h"
+#include "driver.h"
+
+int driver_init(int *freqptr, int *stereoptr)
+{
+  (void)freqptr;
+  (void)stereoptr;
+  soundfd = 1;
+  return 1;
+}
+
+void driver_end(void)
+{
+}
+
+void driver_frame(signed short *data, int len)
+{
+  const unsigned char *bytes = (const unsigned char *)data;
+  size_t remaining = (size_t)len * sizeof(*data);
+
+  while (remaining > 0)
+  {
+    ssize_t written = write(soundfd, bytes, remaining);
+    if (written <= 0)
+      return;
+    bytes += written;
+    remaining -= (size_t)written;
+  }
+}
