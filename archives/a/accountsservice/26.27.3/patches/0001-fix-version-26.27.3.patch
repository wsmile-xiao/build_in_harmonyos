--- a/generate-version.sh
+++ b/generate-version.sh
@@ -1,5 +1,19 @@
 #!/bin/sh
 
+# OHOS/PC adaptation: pin the release version.
+# The upstream logic below derives a rolling version from the outer git
+# history / date (%y.%V) or from the source directory name. Inside the OHOS
+# conan build the extracted source dir is renamed (e.g. 'src') and sits under
+# a git work tree, so this script would either print "Version unknown" (exit
+# 1) or spuriously emit e.g. 26.34.1. We always build from the 26.27.3 release
+# tarball, so pin the version to the release tag instead. An explicit
+# ACCOUNTS_VERSION override is honoured for forward compatibility.
+VERSION_OVERRIDE="${ACCOUNTS_VERSION:-26.27.3}"
+if [ -n "$VERSION_OVERRIDE" ]; then
+    echo "$VERSION_OVERRIDE"
+    exit 0
+fi
+
 exec 3>&2 2> /dev/null
 SRCDIR=$(dirname "$0")
 cd "$SRCDIR"
