--- a/src/daemon.c
+++ b/src/daemon.c
@@ -42,6 +42,31 @@
 #include <errno.h>
 #include <sys/types.h>
 
+/* Portability fallbacks for the shadow-password API, gated by the neutral
+ * HAVE_GETSPNAM / HAVE_FGETSPENT feature macros probed in meson.build (no
+ * platform ifdefs). Some libcs (e.g. the musl-based OHOS libc) ship
+ * <shadow.h> (struct spwd definition only) without implementing the
+ * functions.
+ *
+ * ADAPTATION COMPLETENESS NOTE (manual sign-off required, R40):
+ * on such platforms the stubs below keep the daemon linking and treat
+ * every account as having NO shadow entry: getspnam() -> NULL means
+ * user_update_from_pwent() sees spent == NULL (regular password mode,
+ * never locked), and build_shadow_users_hash() finds no shadow users
+ * (every local user already comes from getpwnam()/the user cache dir).
+ * Shadow password management (expiry policy fields, locked detection)
+ * is a documented runtime limitation of the OHOS adaptation: OHOS has
+ * no /etc/shadow subsystem, so "no shadow entry" is the truthful answer
+ * for every user rather than an error. */
+#ifdef HAVE_SHADOW_H
+#ifndef HAVE_GETSPNAM
+struct spwd *getspnam (const char *name) { (void) name; return NULL; }
+#endif
+#ifndef HAVE_FGETSPENT
+struct spwd *fgetspent (FILE *stream) { (void) stream; return NULL; }
+#endif
+#endif
+
 #include <json-c/json.h>
 
 #include <glib.h>
