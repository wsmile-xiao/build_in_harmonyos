--- a/src/wtmp-helper.c
+++ b/src/wtmp-helper.c
@@ -29,6 +29,35 @@
 
 #include <utmpx.h>
 
+/* Portability fallbacks for the utmpx/wtmp accounting API, gated by the
+ * neutral HAVE_* feature macros probed in meson.build (no platform
+ * ifdefs). Some libcs (e.g. the musl-based OHOS libc) ship <utmpx.h>
+ * (struct/constant definitions only) without implementing the functions.
+ *
+ * ADAPTATION COMPLETENESS NOTE (manual sign-off required, R40):
+ * on such platforms the daemon links against the no-op stubs below and
+ * login accounting / previous-login frequency tracking silently yields
+ * no records (getutxent() -> NULL). This is a deliberate runtime
+ * limitation of the OHOS adaptation: OHOS has no wtmp/utmpx login
+ * accounting subsystem to read from, so "no records" is the truthful
+ * answer rather than an error. setutxent/endutxent are void per POSIX;
+ * utmpxname() returns 0 on success per the glibc convention, so the stub
+ * below returns 0 (success): wtmp_helper_start() proceeds to the
+ * setutxent/getutxent loop, and getutxent() -> NULL ends the iteration
+ * immediately with zero records read. */
+#ifndef HAVE_UTMPXNAME
+int utmpxname (const char *path) { (void) path; return 0; }
+#endif
+#ifndef HAVE_SETUTXENT
+void setutxent (void) {}
+#endif
+#ifndef HAVE_GETUTXENT
+struct utmpx *getutxent (void) { return NULL; }
+#endif
+#ifndef HAVE_ENDUTXENT
+void endutxent (void) {}
+#endif
+
 typedef struct
 {
         guint64 frequency;
