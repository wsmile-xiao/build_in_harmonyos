#!/bin/sh
# 发布式 configure：与上游发行 tarball 惯例一致，configure 随档提供，
# 构建现场不需要 autoconf（autoconf 在真机/CI/注册表均不可用）。
# 功能：解析 --prefix，对 automake 1.19 生成的 Makefile.in 做 @VAR@ 替换
# 产出 Makefile 与最小 config.status。替换表已按真机实际生成的
# Makefile.in 全部 @VAR@（84 个）对齐（2026-09-27 真机 grep -o 清点）。
#
# 适配 OHOS PC 的关键替换：
#   - INSTALL* 系列带 sh 前缀（真机内核拒绝 shebang execve，install-sh
#     必须以 sh 驱动，见 automake 1.19 notes.md）；
#   - install_sh 用构建目录绝对路径（Makefile.in 的 dist/维护规则直接
#     exec $(install_sh)）；
#   - ACLOCAL/AUTOMAKE 从环境继承 test_e2e.sh 导出的 sh 前缀绝对路径，
#     保证 make 因时间戳重建 aclocal.m4/Makefile.in 时同样可执行；
#   - AM_V/AM_DEFAULT_V 值保留 make 语法（Makefile.in 里作为变量名
#     后缀使用：$(am__v_P_@AM_V@)）。
set -e

prefix=/usr/local
srcdir=.
for a in "$@"; do
    case "$a" in
        --prefix=*) prefix=${a#--prefix=} ;;
        --srcdir=*) srcdir=${a#--srcdir=} ;;
        *) : ;;   # --recheck / 目标名等由 make 传的参数按真实 configure 忽略
    esac
done

exec_prefix=${prefix}
here=$(pwd)
abs_srcdir=$(cd "$srcdir" && pwd)

# 最小 config.status（真实 autoconf 语义的退化版）：automake 1.19 生成的
# Makefile 带重生成规则
#   Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
# make 因时间戳变化触发时会执行 `$(SHELL) ./config.status`；本实现 =
# 以相同 --prefix 重跑本 configure（未识别参数被忽略），行为收敛。
# 先于 Makefile 创建，保证 Makefile 时间戳最新，make 不会无谓重建。
cat > config.status <<CFGSTAT
#!/bin/sh
exec sh '$here/configure' --prefix='$prefix'
CFGSTAT

# ── 目录表（automake 标准）──
datarootdir=${prefix}/share
bindir=${exec_prefix}/bin
sbindir=${exec_prefix}/sbin
libexecdir=${exec_prefix}/libexec
datadir=${datarootdir}
sysconfdir=${prefix}/etc
sharedstatedir=${prefix}/com
localstatedir=${prefix}/var
runstatedir=${localstatedir}/run
libdir=${exec_prefix}/lib
includedir=${prefix}/include
oldincludedir=/usr/include
docdir=${datarootdir}/doc/probe
infodir=${datarootdir}/info
htmldir=${docdir}
dvidir=${docdir}
pdfdir=${docdir}
psdir=${docdir}
mandir=${datarootdir}/man
localedir=${datarootdir}/locale

# ── 包元数据 ──
PACKAGE_NAME=probe
PACKAGE_TARNAME=probe
PACKAGE_VERSION=1.0
PACKAGE_STRING='probe 1.0'
PACKAGE_BUGREPORT=
PACKAGE_URL=
PACKAGE=probe
VERSION=1.0

# ── 工具与可执行（OHOS 适配：install-sh 一律 sh 前缀）──
SHELL=/bin/sh
INSTALL='sh ./install-sh'
INSTALL_PROGRAM='sh ./install-sh -c'
INSTALL_SCRIPT='sh ./install-sh -c'
INSTALL_DATA='sh ./install-sh -m 644'
INSTALL_STRIP_PROGRAM='sh ./install-sh -c -s'
install_sh="sh $abs_srcdir/install-sh"
MKDIR_P='mkdir -p'
mkdir_p='mkdir -p'
STRIP=strip
AWK=awk
GREP=grep
EGREP='grep -E'
FGREP='grep -F'
LN_S='ln -s'
CYGPATH_W=echo
PATH_SEPARATOR=:
TAR=tar
AMTAR=tar
am__tar='tar chf -'
am__untar='tar -xf -'
am__tar_ignore_stderr=
am__rm_f_notfound=
am__xargs_n='xargs -n'
am__leading_dot=.

# ── 工具链路径（automake 体系；经环境继承 test_e2e.sh 的 sh 前缀绝对路径）──
ACLOCAL=${ACLOCAL:-aclocal}
AUTOMAKE=${AUTOMAKE:-automake}
AUTOCONF=${AUTOCONF:-autoconf}
AUTOHEADER=${AUTOHEADER:-autoheader}
MAKEINFO=makeinfo
ETAGS=etags
CTAGS=ctags
CSCOPE=cscope

# ── 目录变量（源码树 = 构建树）──
srcdir=$srcdir
top_srcdir=$srcdir
top_builddir=.
top_build_prefix=
builddir=.
abs_builddir=$here
abs_top_srcdir=$abs_srcdir
abs_top_builddir=$here

# ── 杂项 ──
SET_MAKE=
VPATH=
DEFS='-DPACKAGE_NAME="probe" -DPACKAGE_VERSION="1.0"'
LIBOBJS=
LIBS=
LTLIBOBJS=
ECHO_C=
ECHO_N=
ECHO_T=
configure_input='Generated from Makefile.in by configure.'
program_transform_name='s,x,x,'
build_alias=
host_alias=
target_alias=

# 替换表：printf 直书（不 eval，避免 $(V) 之类 make 语法被当命令替换）
seds="./.configure-seds.$$"
: > "$seds"
{
printf '%s\n' \
  "prefix	$prefix" \
  "exec_prefix	$exec_prefix" \
  "datarootdir	$datarootdir" \
  "bindir	$bindir" \
  "sbindir	$sbindir" \
  "libexecdir	$libexecdir" \
  "datadir	$datadir" \
  "sysconfdir	$sysconfdir" \
  "sharedstatedir	$sharedstatedir" \
  "localstatedir	$localstatedir" \
  "runstatedir	$runstatedir" \
  "libdir	$libdir" \
  "includedir	$includedir" \
  "oldincludedir	$oldincludedir" \
  "docdir	$docdir" \
  "infodir	$infodir" \
  "htmldir	$htmldir" \
  "dvidir	$dvidir" \
  "pdfdir	$pdfdir" \
  "psdir	$psdir" \
  "mandir	$mandir" \
  "localedir	$localedir" \
  "PACKAGE_NAME	$PACKAGE_NAME" \
  "PACKAGE_TARNAME	$PACKAGE_TARNAME" \
  "PACKAGE_VERSION	$PACKAGE_VERSION" \
  "PACKAGE_STRING	$PACKAGE_STRING" \
  "PACKAGE_BUGREPORT	$PACKAGE_BUGREPORT" \
  "PACKAGE_URL	$PACKAGE_URL" \
  "PACKAGE	$PACKAGE" \
  "VERSION	$VERSION" \
  "SHELL	$SHELL" \
  "INSTALL	$INSTALL" \
  "INSTALL_PROGRAM	$INSTALL_PROGRAM" \
  "INSTALL_SCRIPT	$INSTALL_SCRIPT" \
  "INSTALL_DATA	$INSTALL_DATA" \
  "INSTALL_STRIP_PROGRAM	$INSTALL_STRIP_PROGRAM" \
  "install_sh	$install_sh" \
  "MKDIR_P	$MKDIR_P" \
  "mkdir_p	$mkdir_p" \
  "STRIP	$STRIP" \
  "AWK	$AWK" \
  "GREP	$GREP" \
  "EGREP	$EGREP" \
  "FGREP	$FGREP" \
  "LN_S	$LN_S" \
  "CYGPATH_W	$CYGPATH_W" \
  "PATH_SEPARATOR	$PATH_SEPARATOR" \
  "TAR	$TAR" \
  "AMTAR	$AMTAR" \
  "am__tar	$am__tar" \
  "am__untar	$am__untar" \
  "am__tar_ignore_stderr	$am__tar_ignore_stderr" \
  "am__rm_f_notfound	$am__rm_f_notfound" \
  "am__xargs_n	$am__xargs_n" \
  "am__leading_dot	$am__leading_dot" \
  "ACLOCAL	$ACLOCAL" \
  "AUTOMAKE	$AUTOMAKE" \
  "AUTOCONF	$AUTOCONF" \
  "AUTOHEADER	$AUTOHEADER" \
  "MAKEINFO	$MAKEINFO" \
  "ETAGS	$ETAGS" \
  "CTAGS	$CTAGS" \
  "CSCOPE	$CSCOPE" \
  "srcdir	$srcdir" \
  "top_srcdir	$top_srcdir" \
  "top_builddir	$top_builddir" \
  "top_build_prefix	$top_build_prefix" \
  "builddir	$builddir" \
  "abs_builddir	$abs_builddir" \
  "abs_srcdir	$abs_srcdir" \
  "abs_top_srcdir	$abs_top_srcdir" \
  "abs_top_builddir	$abs_top_builddir" \
  "SET_MAKE	$SET_MAKE" \
  "VPATH	$VPATH" \
  "DEFS	$DEFS" \
  "LIBOBJS	$LIBOBJS" \
  "LIBS	$LIBS" \
  "LTLIBOBJS	$LTLIBOBJS" \
  "ECHO_C	$ECHO_C" \
  "ECHO_N	$ECHO_N" \
  "ECHO_T	$ECHO_T" \
  "configure_input	$configure_input" \
  "program_transform_name	$program_transform_name" \
  "build_alias	$build_alias" \
  "host_alias	$host_alias" \
  "target_alias	$target_alias" \
  "AM_DEFAULT_VERBOSITY	1" \
  "AM_DEFAULT_V	\$(AM_DEFAULT_VERBOSITY)" \
  "AM_V	\$(V)" \
  "am__isrc	"
} | while IFS='	' read -r name value; do
    printf 's|@%s@|%s|g\n' "$name" "$value" >> "$seds"
done

sed -f "$seds" Makefile.in > Makefile
rm -f "$seds"

# 未替换变量检查：任何遗留的 @VAR@ 都说明替换表与 Makefile.in 不对齐，
# 立即失败并列出
if grep -q '@[A-Za-z_][A-Za-z0-9_]*@' Makefile; then
    echo "configure: 未替换变量: $(grep -o '@[A-Za-z_][A-Za-z0-9_]*@' Makefile | sort -u | tr '\n' ' ')"
    exit 1
fi

echo "configure: 已从 Makefile.in 生成 Makefile + config.status (prefix=$prefix)"
