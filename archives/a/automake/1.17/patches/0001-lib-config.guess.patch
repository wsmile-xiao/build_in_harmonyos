diff -ruN a/lib/config.guess b/lib/config.guess
--- a/lib/config.guess
+++ b/lib/config.guess
@@ -971,20 +971,40 @@
 	GNU_SYS=`echo "$UNAME_SYSTEM" | sed 's,^[^/]*/,,' | tr "[:upper:]" "[:lower:]"`
 	GNU_REL=`echo "$UNAME_RELEASE" | sed -e 's/[-(].*//'`
 	GUESS=$UNAME_MACHINE-unknown-$GNU_SYS$GNU_REL-$LIBC
 	;;
     x86_64:[Mm]anagarm:*:*|i?86:[Mm]anagarm:*:*)
 	GUESS="$UNAME_MACHINE-pc-managarm-mlibc"
 	;;
     *:[Mm]anagarm:*:*)
 	GUESS="$UNAME_MACHINE-unknown-managarm-mlibc"
 	;;
+    *:HarmonyOS:*:*)
+	# HarmonyOS/OpenHarmony detection
+	case "$UNAME_MACHINE" in
+		aarch64|arm64)
+			GUESS="aarch64-unknown-linux-ohos"
+			;;
+		armv7*|arm*)
+			GUESS="arm-unknown-linux-ohos"
+			;;
+		x86_64|amd64)
+			GUESS="x86_64-unknown-linux-ohos"
+			;;
+		i?86)
+			GUESS="i686-unknown-linux-ohos"
+			;;
+		*)
+			GUESS="$UNAME_MACHINE-unknown-linux-ohos"
+			;;
+	esac
+	;;
     *:Minix:*:*)
 	GUESS=$UNAME_MACHINE-unknown-minix
 	;;
     aarch64:Linux:*:*)
 	set_cc_for_build
 	CPU=$UNAME_MACHINE
 	LIBCABI=$LIBC
 	if test "$CC_FOR_BUILD" != no_compiler_found; then
 	    ABI=64
 	    sed 's/^	    //' << EOF > "$dummy.c"
