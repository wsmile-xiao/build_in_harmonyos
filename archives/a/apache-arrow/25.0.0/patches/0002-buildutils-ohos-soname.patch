--- a/cpp/cmake_modules/BuildUtils.cmake
+++ b/cpp/cmake_modules/BuildUtils.cmake
@@ -383,6 +383,20 @@
       set(ARG_SHARED_LINK_FLAGS "-undefined dynamic_lookup ${ARG_SHARED_LINK_FLAGS}")
     endif()
 
+    # OHOS adaptation: CMake ships no Platform/OHOS (or Platform/HarmonyOS)
+    # module in the versions used here, so the VERSION/SOVERSION properties
+    # don't emit an ELF DT_SONAME.  Without a SONAME, ld.lld records the
+    # build-tree path (e.g. ../../release/libarrow.so) in dependent libraries'
+    # DT_NEEDED entries and the installed package fails at load time.
+    # Accept both spellings: the Conan OHOS profile sets
+    # CMAKE_SYSTEM_NAME=OHOS, while the earlier hand-rolled toolchain in this
+    # archive used HarmonyOS.
+    if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS" OR CMAKE_SYSTEM_NAME STREQUAL "OHOS")
+      set(_arrow_ohos_soname
+          "${CMAKE_SHARED_LIBRARY_PREFIX}${LIB_NAME}${CMAKE_SHARED_LIBRARY_SUFFIX}")
+      set(ARG_SHARED_LINK_FLAGS "${ARG_SHARED_LINK_FLAGS} -Wl,-soname,${_arrow_ohos_soname}")
+    endif()
+
     set_target_properties(${LIB_NAME}_shared
                           PROPERTIES LIBRARY_OUTPUT_DIRECTORY "${OUTPUT_PATH}"
                                      RUNTIME_OUTPUT_DIRECTORY "${OUTPUT_PATH}"
