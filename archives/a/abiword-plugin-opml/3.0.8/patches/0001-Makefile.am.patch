--- a/Makefile.am
+++ b/Makefile.am
@@ -1,89 +1,67 @@
+# Makefile.am — abiword-plugin-opml 3.0.8 (OHOS 平台适配)
+#
+# minimal 构建方案：仅构建 OPML 导入插件（不构建 AbiWord 核心）。
+# 与上游 plugins/opml/Makefile.am 对齐：-module -avoid-version 可加载插件模块，
+# 安装到 AbiWord 插件目录 $(libdir)/abiword-3.0/plugins。
+# AbiWord 运行时 API 由 compat/ shim 提供（dependency-free，无 libxml2）。
+AUTOMAKE_OPTIONS = foreign subdir-objects
 
-ACLOCAL_AMFLAGS = -I .
+plugindir = $(libdir)/abiword-3.0/plugins
+plugin_LTLIBRARIES = libabiword-plugin-opml.la
 
-DIST_SUBDIRS = goffice-bits goffice-bits2 src plugins po user icons tools
+libabiword_plugin_opml_la_SOURCES = \
+	plugins/opml/xp/ie_imp_OPML.cpp \
+	plugins/opml/xp/ie_imp_OPML.h \
+	compat/abiword_shim.cpp \
+	compat/glib.h \
+	compat/ut_types.h \
+	compat/ut_assert.h \
+	compat/ut_debugmsg.h \
+	compat/ut_string.h \
+	compat/ut_string_class.h \
+	compat/ie_types.h \
+	compat/ie_imp.h \
+	compat/ie_imp_XML.h \
+	compat/pd_Document.h \
+	compat/pt_Types.h \
+	compat/fl_AutoNum.h \
+	compat/xap_Module.h \
+	compat/gsf/gsf-input.h
 
-if WITH_GOFFICE_BUILTIN
+libabiword_plugin_opml_la_CPPFLAGS = \
+	-I$(top_srcdir)/compat \
+	-I$(top_srcdir)/plugins/opml/xp
 
-if TOOLKIT_GTK2
-SUBDIRS = goffice-bits2
-else
-SUBDIRS = goffice-bits
-endif
+libabiword_plugin_opml_la_LDFLAGS = \
+	-avoid-version \
+	-module \
+	-no-undefined \
+	-stdlib=libc++ \
+	-lc++
 
-else 
-SUBDIRS =
-endif
-SUBDIRS += src plugins po user icons
+# ---- 测试 (make check) ----
+# 端到端功能测试：dlopen 插件 → abi_plugin_register → sniffer 识别 <opml 头 →
+# 真实 OPML 2.0 文档 → importFile → 校验提取文本/超链接/列表/元数据
+check_PROGRAMS = test_opml_plugin
 
-if TOOLKIT_GTK_ALL
+test_opml_plugin_SOURCES = tests/test_opml_plugin.cpp
+test_opml_plugin_CPPFLAGS = -I$(top_srcdir)/compat
+# link against the plugin module itself so the test shares the single
+# compat shim copy embedded in the module (deterministic symbol binding)
+test_opml_plugin_LDADD = libabiword-plugin-opml.la -ldl
+# clang-15 as CXX does not auto-add the C++ runtime for the link:
+# pull libc++ explicitly (same runtime the module was built with)
+test_opml_plugin_LDFLAGS = -stdlib=libc++ -lc++ -Wl,-rpath,$(abs_builddir)/.libs
 
-if !EMBEDDED_HILDON
-desktopdir = $(datadir)/applications
-desktop_DATA = abiword.desktop
-endif
+# OHOS 内核禁止 shebang 脚本执行（E###），libtool 生成的 shell 包装器
+# (./test_opml_plugin) 无法直接执行，因此绕过 automake TESTS 机制，
+# 在 check-local 中直接运行真实 ELF 二进制 (.libs/test_opml_plugin)。
+# 通过 LD_LIBRARY_PATH 指向 .libs，使测试二进制能解析同目录的插件模块
+# （与 dlopen 的 PLUGIN_SO 为同一文件，保证 importer registry 共享）。
+check-local:
+	cd $(abs_builddir) && \
+	LD_LIBRARY_PATH=$(abs_builddir)/.libs:$$LD_LIBRARY_PATH \
+	PLUGIN_SO=$(abs_builddir)/.libs/libabiword-plugin-opml.so \
+	$(abs_builddir)/.libs/test_opml_plugin
 
-mimedir = @ABIWORD_DATADIR@/mime-info
-mime_DATA = abiword.keys
-
-appdatadir = $(datarootdir)/appdata
-appdata_DATA = abiword.appdata.xml
-
-pkgconfigdir = $(libdir)/pkgconfig
-pkgconfig_DATA = abiword-$(ABIWORD_SERIES).pc
-
-dist_man1_MANS = abiword.1
-
-endif
-
-if TOOLKIT_GTK
-# we disable introspection for distcheck as it fails because of
-# installation needing sudo
-DISTCHECK_CONFIGURE_FLAGS = \
-	--enable-introspection=no \
-	--with-gir-dir=\$${datadir}/gir-1.0 \
-	--with-typelib-dir=\$${libdir}/girepository-1.0
-endif
-
-EXTRA_DIST = \
-	AUTHORS \
-	BiDiReadme.txt \
-	BUILD.TXT \
-	COPYING	\
-	COPYRIGHT.TXT \
-	INSTALL \
-	NEWS \
-	README \
-	ChangeLog \
-	abiword.desktop \
-	$(appdata_DATA) \
-	abiword.keys \
-	abiword.png \
-	libabiword.pc.in \
-	compile-resource \
-	lt-compile-resource
-
-DISTCLEANFILES = \
-	abiword-$(ABIWORD_SERIES).pc \
-	plugin-builtin.m4 \
-	plugin-configure.m4 \
-	plugin-list.m4 \
-	plugin-makefiles.m4
-
-abiword-$(ABIWORD_SERIES).pc: libabiword.pc
-	cp $< $@
-
-if TOOLKIT_WIN
-zip:
-	rm -rf $(PACKAGE)-$(VERSION)
-	make DESTDIR=$(abs_builddir)/zip install
-	mv zip$(prefix) $(PACKAGE)-$(VERSION)
-	cd $(PACKAGE)-$(VERSION)
-	zip -r $(PACKAGE)-$(VERSION).zip $(PACKAGE)-$(VERSION) -x \*.a \*.la
-	rm -rf $(PACKAGE)-$(VERSION) ./zip
-endif
-
-# needed to make sure we don't include .svn directories.
-dist-hook:
-	rm -rf `find $(distdir) -name .svn`
-
+CLEANFILES = test_opml_plugin
