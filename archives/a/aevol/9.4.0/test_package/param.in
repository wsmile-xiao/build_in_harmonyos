###################################
#         AEVOL PARAMETERS        #
###################################

########## Size of the initial random chromosome to generate ##########
CHROMOSOME_INITIAL_LENGTH   5000

########## Random generator setup (for reproducibility) ##########
SEED    7250909

########## Population Structure and Selection ##########
GRID_SIZE           32 32
SELECTION_SCOPE     local 3 3
SELECTION_SCHEME    fitness_proportionate   1000

########## Mutation rates ##########
POINT_MUTATION_RATE     1e-6
SMALL_INSERTION_RATE    1e-6
SMALL_DELETION_RATE     1e-6
MAX_INDEL_SIZE          6

########## Rearrangement rates ##########
DUPLICATION_RATE        1e-6
DELETION_RATE           1e-6
TRANSLOCATION_RATE      1e-6
INVERSION_RATE          1e-6

########## Genomic constraints ##########
MIN_GENOME_LENGTH       1
MAX_GENOME_LENGTH       10000000

########## Phenotype ##########
DOSAGE_EFFECT       absolute

########## Target function ##########
ENV_ADD_GAUSSIAN  1.2   0.52  0.12
ENV_ADD_GAUSSIAN -1.4   0.5   0.07
ENV_ADD_GAUSSIAN  0.3   0.8   0.03
MAX_TRIANGLE_WIDTH      0.033333333

########## Recording ##########
CHECKPOINT_STEP 1000
RECORD_TREE     ON 1000
STATS_BEST      ON 100
STATS_POP       ON 100
