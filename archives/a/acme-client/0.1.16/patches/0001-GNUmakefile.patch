+# Support static linking for OpenHarmony (musl libc)
+# Dynamic libraries may fail to load even after ELF signing
+# Static linking is the most reliable approach
+ifeq ($(STATIC),1)
+LDFLAGS_STATIC = $(PREFIX)/lib/libtls.a $(PREFIX)/lib/libssl.a $(PREFIX)/lib/libcrypto.a -lpthread -ldl
+endif
+
 acme-client: $(OBJS)
+ifdef STATIC
+	$(CC) -o $@ $(OBJS) $(LDFLAGS_STATIC) $(LIBADD)
+else
 	$(CC) -o $@ $(OBJS) $(LDFLAGS) -ltls -lssl -lcrypto $(LIBADD)
+endif
 
