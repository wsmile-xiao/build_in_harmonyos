diff --git a/algobox_qtextcodec_compat.h b/algobox_qtextcodec_compat.h
new file mode 100644
index 0000000..00d7370
--- /dev/null
+++ b/algobox_qtextcodec_compat.h
@@ -0,0 +1,59 @@
+#ifndef ALGOBOX_QTEXTCODEC_COMPAT_H
+#define ALGOBOX_QTEXTCODEC_COMPAT_H
+
+#include <QtGlobal>
+
+#if QT_VERSION < QT_VERSION_CHECK(6, 0, 0)
+#include <QtCore/QTextCodec>
+#else
+#include <QStringConverter>
+
+#if __has_include(<QtCore5Compat/QTextCodec>)
+#include <QtCore5Compat/QTextCodec>
+#elif __has_include(<QtCore5Compat/qtextcodec.h>)
+#include <QtCore5Compat/qtextcodec.h>
+#elif __has_include(<QTextCodec>)
+#include <QTextCodec>
+#elif __has_include(<qtextcodec.h>)
+#include <qtextcodec.h>
+#else
+#include <QByteArray>
+#include <QString>
+
+class QTextCodec
+{
+public:
+    static QTextCodec *codecForName(const char *name)
+    {
+        static QTextCodec utf8(QStringConverter::Encoding::Utf8);
+        static QTextCodec latin1(QStringConverter::Encoding::Latin1);
+        QByteArray codecName(name ? name : "");
+        codecName = codecName.toLower();
+        if (codecName == "iso-8859-1" || codecName == "latin1" ||
+            codecName == "latin-1") {
+            return &latin1;
+        }
+        return &utf8;
+    }
+
+    QString toUnicode(const QByteArray &bytes) const
+    {
+        QStringDecoder decoder(m_encoding);
+        return decoder(bytes);
+    }
+
+    QByteArray fromUnicode(const QString &text) const
+    {
+        QStringEncoder encoder(m_encoding);
+        return encoder(text);
+    }
+
+private:
+    explicit QTextCodec(QStringConverter::Encoding encoding) : m_encoding(encoding) {}
+
+    QStringConverter::Encoding m_encoding;
+};
+#endif
+#endif
+
+#endif
