set(CMAKE_SYSTEM_NAME OHOS CACHE STRING "OpenHarmony target platform")
set(CMAKE_SYSTEM_PROCESSOR aarch64 CACHE STRING "OpenHarmony target architecture")

function(_ohos_input output cache_name env_name)
  if(DEFINED ${cache_name} AND NOT "${${cache_name}}" STREQUAL "")
    set(_value "${${cache_name}}")
  elseif(DEFINED ENV{${env_name}} AND NOT "$ENV{${env_name}}" STREQUAL "")
    set(_value "$ENV{${env_name}}")
  else()
    set(_value "")
  endif()
  set(${output} "${_value}" PARENT_SCOPE)
endfunction()

_ohos_input(_ohos_cc OHOS_C_COMPILER OHOS_C_COMPILER)
if(NOT _ohos_cc AND DEFINED CMAKE_C_COMPILER)
  set(_ohos_cc "${CMAKE_C_COMPILER}")
endif()
if(NOT _ohos_cc AND DEFINED ENV{CC})
  set(_ohos_cc "$ENV{CC}")
endif()
_ohos_input(_ohos_cxx OHOS_CXX_COMPILER OHOS_CXX_COMPILER)
if(NOT _ohos_cxx AND DEFINED CMAKE_CXX_COMPILER)
  set(_ohos_cxx "${CMAKE_CXX_COMPILER}")
endif()
if(NOT _ohos_cxx AND DEFINED ENV{CXX})
  set(_ohos_cxx "$ENV{CXX}")
endif()
if(NOT _ohos_cc OR NOT EXISTS "${_ohos_cc}")
  message(FATAL_ERROR "Set OHOS_C_COMPILER (or CC/CMAKE_C_COMPILER) to an existing OHOS clang")
endif()
if(NOT _ohos_cxx OR NOT EXISTS "${_ohos_cxx}")
  message(FATAL_ERROR "Set OHOS_CXX_COMPILER (or CXX/CMAKE_CXX_COMPILER) to an existing OHOS clang++")
endif()
get_filename_component(_ohos_cc_real "${_ohos_cc}" REALPATH)
get_filename_component(_ohos_cxx_real "${_ohos_cxx}" REALPATH)
get_filename_component(_ohos_llvm_bin "${_ohos_cc_real}" DIRECTORY)
get_filename_component(_ohos_cxx_bin "${_ohos_cxx_real}" DIRECTORY)
if(NOT _ohos_llvm_bin STREQUAL _ohos_cxx_bin)
  message(FATAL_ERROR "OHOS C and C++ compilers must come from the same LLVM bin directory")
endif()
set(CMAKE_C_COMPILER "${_ohos_cc}" CACHE FILEPATH "OpenHarmony C compiler" FORCE)
set(CMAKE_CXX_COMPILER "${_ohos_cxx}" CACHE FILEPATH "OpenHarmony C++ compiler" FORCE)

_ohos_input(_ohos_sysroot OHOS_SYSROOT OHOS_SYSROOT)
if(NOT _ohos_sysroot)
  get_filename_component(_ohos_llvm_root "${_ohos_llvm_bin}" DIRECTORY)
  get_filename_component(_ohos_native_root "${_ohos_llvm_root}" DIRECTORY)
  set(_ohos_sysroot "${_ohos_native_root}/sysroot")
endif()
if(NOT IS_DIRECTORY "${_ohos_sysroot}/usr/include")
  message(FATAL_ERROR "OHOS_SYSROOT is invalid (missing usr/include): ${_ohos_sysroot}")
endif()
set(CMAKE_SYSROOT "${_ohos_sysroot}" CACHE PATH "OpenHarmony SDK sysroot" FORCE)

_ohos_input(_ohos_ar OHOS_LLVM_AR OHOS_LLVM_AR)
if(NOT _ohos_ar)
  set(_ohos_ar "${_ohos_llvm_bin}/llvm-ar")
endif()
_ohos_input(_ohos_ranlib OHOS_LLVM_RANLIB OHOS_LLVM_RANLIB)
if(NOT _ohos_ranlib)
  set(_ohos_ranlib "${_ohos_llvm_bin}/llvm-ranlib")
endif()
foreach(_tool IN ITEMS _ohos_ar _ohos_ranlib)
  if(NOT EXISTS "${${_tool}}")
    message(FATAL_ERROR "Configured OHOS LLVM tool does not exist: ${${_tool}}")
  endif()
  get_filename_component(_tool_real "${${_tool}}" REALPATH)
  get_filename_component(_tool_bin "${_tool_real}" DIRECTORY)
  if(NOT _tool_bin STREQUAL _ohos_llvm_bin)
    message(FATAL_ERROR "Configured OHOS LLVM tool does not match compiler directory: ${${_tool}}")
  endif()
endforeach()
set(CMAKE_C_COMPILER_TARGET aarch64-unknown-linux-ohos CACHE STRING "OpenHarmony C target")
set(CMAKE_CXX_COMPILER_TARGET aarch64-unknown-linux-ohos CACHE STRING "OpenHarmony C++ target")
set(CMAKE_AR "${_ohos_ar}" CACHE FILEPATH "OpenHarmony archiver" FORCE)
set(CMAKE_RANLIB "${_ohos_ranlib}" CACHE FILEPATH "OpenHarmony ranlib" FORCE)
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}" CACHE STRING "OpenHarmony target roots")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER CACHE STRING "Host tools")
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY CACHE STRING "Target libraries")
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY CACHE STRING "Target includes")
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY CACHE STRING "Target packages")
