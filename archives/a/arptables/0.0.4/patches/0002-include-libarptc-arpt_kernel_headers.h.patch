--- a/include/libarptc/arpt_kernel_headers.h
+++ b/include/libarptc/arpt_kernel_headers.h
@@ -7,20 +7,37 @@
 
 #if defined(__GLIBC__) && __GLIBC__ == 2
 #include <netinet/ip.h>
 #include <netinet/in.h>
 #include <netinet/ip_icmp.h>
 #include <netinet/tcp.h>
 #include <netinet/udp.h>
 #include <netinet/ether.h>
 #include <net/if.h>
 #include <sys/types.h>
+#elif defined(__OHOS__)
+/* HarmonyOS uses musl libc. <sys/socket.h> and <linux/socket.h> both define
+   sockaddr_storage, causing a redefinition error. We include <sys/socket.h>
+   first, then define the <linux/socket.h> guard to prevent it from being
+   re-included via the <linux/netfilter.h> → <linux/in.h> → <linux/socket.h>
+   chain. */
+#include <sys/socket.h>
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+#endif
+#include <sys/types.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <netinet/udp.h>
+#include <netinet/ether.h>
+#include <net/if.h>
+#include <linux/types.h>
 #else
 #include <sys/socket.h>
 #include <linux/ip.h>
 #include <linux/in.h>
 #include <linux/if.h>
 #include <linux/icmp.h>
 #include <linux/tcp.h>
 #include <linux/udp.h>
 #include <linux/types.h>
 #include <linux/in6.h>
