     gio-unix-2.0>=2.36
 )
 
+# HarmonyOS 修复：glib 为静态库（.a），其 pkg-config Libs 展开的
+# -lintl/-lffi 库名会被 OHOS 工具链系统同名库抢占（系统库符号为 intl_*/ffi_*，
+# glib 需要 g_libintl_*）→ ld.lld: undefined symbol: g_libintl_gettext 等。
+# 从 PROJECT_DEPS_LIBRARIES 移除库名，改用 glib 包内 libintl.a/libffi.a 的
+# 绝对路径（conan generate() 注入 INTL_LIB_ABS/FFI_LIB_ABS；src/ 与
+# libmessaging-menu/ 的 target_link_libraries 均消费该列表，全局生效）。
+set(_IM_DEPS_FIXED "")
+foreach(_IM_D IN LISTS PROJECT_DEPS_LIBRARIES)
+    if(NOT _IM_D STREQUAL "intl" AND NOT _IM_D STREQUAL "ffi")
+        list(APPEND _IM_DEPS_FIXED "${_IM_D}")
+    endif()
+endforeach()
+set(PROJECT_DEPS_LIBRARIES ${_IM_DEPS_FIXED})
+list(APPEND PROJECT_DEPS_LIBRARIES ${INTL_LIB_ABS} ${FFI_LIB_ABS})
+
 # accountsservice 在 HarmonyOS 无制品仓配方；ENABLE_ACCOUNTS_SERVICE=OFF 时
 # 不 REQUIRED，src/ 用 stub（im-accounts-service.c 以 HAVE_ACCOUNTS_SERVICE 编译开关裁剪）。
