diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5435454..0743830 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -17,6 +17,9 @@ endif(CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT)
 option(ENABLE_TESTS "Enable all tests and checks" OFF)
 option(ENABLE_COVERAGE "Enable coverage reports (includes enabling all tests and checks)" OFF)
 option(ENABLE_WERROR "Treat all build warnings as errors" OFF)
+option(ENABLE_ACCOUNTS_SERVICE "Build with libaccountsservice (draws-attention/greeter integration)" ON)
+option(SKIP_DATA_PO "Skip data/ and po/ subdirectories (HarmonyOS lacks GSettings/Intltool CMake modules)" OFF)
+option(SKIP_DOC "Skip doc/ subdirectory (HarmonyOS lacks gtk-doc tooling)" OFF)
 
 if(ENABLE_COVERAGE)
     set(ENABLE_TESTS ON)
@@ -46,9 +49,17 @@ pkg_check_modules(
     REQUIRED
     glib-2.0>=2.36
     gio-unix-2.0>=2.36
-    accountsservice
 )
 
+# accountsservice 在 HarmonyOS 无制品仓配方；ENABLE_ACCOUNTS_SERVICE=OFF 时
+# 不 REQUIRED，src/ 用 stub（im-accounts-service.c 以 HAVE_ACCOUNTS_SERVICE 编译开关裁剪）。
+if(ENABLE_ACCOUNTS_SERVICE)
+    pkg_check_modules(ACCOUNTS_SERVICE REQUIRED accountsservice)
+    list(APPEND PROJECT_DEPS_INCLUDE_DIRS ${ACCOUNTS_SERVICE_INCLUDE_DIRS})
+    list(APPEND PROJECT_DEPS_LIBRARIES ${ACCOUNTS_SERVICE_LIBRARIES})
+    add_definitions(-DHAVE_ACCOUNTS_SERVICE=1)
+endif()
+
 # Cppcheck
 
 add_custom_target(
@@ -67,9 +78,17 @@ add_custom_target(
 
 add_subdirectory(src)
 add_subdirectory(libmessaging-menu)
-add_subdirectory(data)
-add_subdirectory(po)
-add_subdirectory(doc)
+if(SKIP_DATA_PO)
+    message(STATUS "SKIP_DATA_PO=ON: skip data/ and po/ subdirectories (no GSettings/Intltool CMake modules on HarmonyOS)")
+else()
+    add_subdirectory(data)
+    add_subdirectory(po)
+endif()
+if(SKIP_DOC)
+    message(STATUS "SKIP_DOC=ON: skip doc/ subdirectory (no gtk-doc tooling on HarmonyOS)")
+else()
+    add_subdirectory(doc)
+endif()
 
