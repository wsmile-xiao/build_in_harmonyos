@@ -131,6 +131,18 @@

 #else

+// OHOS sysroot byteswap.h defines bswap_16/bswap_32 as macros expanding to
+// __bswap_16/__bswap_32; undef them so the functions below keep their names.
+#ifdef bswap_16
+#undef bswap_16
+#endif
+#ifdef bswap_32
+#undef bswap_32
+#endif
+#ifdef bswap_64
+#undef bswap_64
+#endif
+
 static inline uint16 bswap_16(uint16 x) {
   return static_cast<uint16>(((x & 0xFF) << 8) | ((x & 0xFF00) >> 8));
 }
