+# R05/E537: relocatable linkage for OHOS. The KF6 dependency libraries are
+# published without a DT_SONAME, so linking them by absolute Conan cache path
+# makes the linker record that machine-private path in DT_NEEDED (cf. the
+# kpackage/6.18.0.x DT_NEEDED relocatability fix, knewstuff 6.29.0.1 patch
+# 0004). Link the KF6 deps by their SONAME-style basenames through a PRIVATE
+# -L set injected via ALKIMIA_DEP_LIB_DIRS, and stamp an explicit SONAME so
+# executables linked against this in-tree target record `libalkimia6.so`.
+if(ALKIMIA_DEP_LIB_DIRS)
+    target_link_directories(alkimia PRIVATE ${ALKIMIA_DEP_LIB_DIRS})
+    target_link_options(alkimia PRIVATE "-Wl,-soname,libalkimia${ALKIMIA_LIB_SUFFIX}.so")
+    target_link_libraries(alkimia PRIVATE
+        ${QT_NETWORK_LIB}
+        Qt${QT_MAJOR_VERSION}::DBus
+        Qt${QT_MAJOR_VERSION}::Core
+        Qt${QT_MAJOR_VERSION}::Gui
+        Qt${QT_MAJOR_VERSION}::Widgets
+        -lKF6Codecs
+        -lKF6Completion
+        -lKF6I18n
+        -lKF6IconThemes
+        -lKF6WidgetsAddons
+        -lKF6NewStuffWidgets
+        -lKF6NewStuffCore
+        -lKF6ConfigCore
+        -lKF6ConfigGui
+    )
+else()
+    target_link_libraries(alkimia PRIVATE
+        ${KF_NEWSTUFF_LIB}
+        KF${QT_MAJOR_VERSION}::Codecs
+        KF${QT_MAJOR_VERSION}::Completion
+        KF${QT_MAJOR_VERSION}::I18n
+        KF${QT_MAJOR_VERSION}::IconThemes
+        KF${QT_MAJOR_VERSION}::WidgetsAddons
+        PUBLIC
+        KF${QT_MAJOR_VERSION}::ConfigCore
+    )
+endif()
 
 add_definitions(-DTRANSLATION_DOMAIN=\"alkimia\")
 
