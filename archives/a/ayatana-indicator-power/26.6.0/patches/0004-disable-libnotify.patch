--- a/src/notifier.c
+++ b/src/notifier.c
@@ -34,7 +34,16 @@
 #include "notifier.h"
 #include "utils.h"
 
+#ifdef DISABLE_NOTIFY
+/* libnotify 在 OHOS 上不可用：无 D-Bus 通知守护进程；且 libnotify→gdk-pixbuf
+   依赖链内嵌的静态 glib 会与 libayatana-common 的 glib 符号互操作，导致进程
+   启动即崩溃（cannot register existing type 'gchar'）。此处以最小桩类型/宏维持
+   notifier 的 GObject 结构完整，全部通知 API 由下方空操作桩替代。 */
+typedef struct _NotifyNotification NotifyNotification;
+#define NOTIFY_EXPIRES_NEVER 0
+#else
 #include <libnotify/notify.h>
+#endif
 
 #include <glib/gi18n.h>
 
@@ -64,7 +73,9 @@
 
 static GParamSpec * properties[LAST_PROP];
 
+#ifndef DISABLE_NOTIFY
 static int instance_count = 0;
+#endif
 
 /**
 ***
@@ -219,6 +230,8 @@
 ****  Notifications
 ***/
 
+#ifndef DISABLE_NOTIFY
+
 static void
 on_notify_notification_finalized (gpointer gself, GObject * dead)
 {
@@ -410,6 +423,23 @@
   g_free (body);
 }
 
+#else /* DISABLE_NOTIFY：libnotify 不可用，以下为空操作桩。
+         电池警告（is-warning）仅在通知展示/清除时翻转，无通知则恒为 FALSE。 */
+static void
+notification_clear (IndicatorPowerNotifier * self)
+{
+  priv_t * const p = get_priv (self);
+  p->notify_notification = NULL;
+  dbus_battery_set_is_warning (p->dbus_battery, FALSE);
+}
+
+static void
+notification_show (IndicatorPowerNotifier * self)
+{
+  (void) self;
+}
+#endif /* DISABLE_NOTIFY */
+
 /***
 ****
