+# libnotify 不可用：OHOS 无 D-Bus 通知守护进程；且 libnotify→gdk-pixbuf 依赖链
+# 内嵌静态 glib 会与 libayatana-common 的 glib 符号互操作导致进程崩溃。
+# 关闭通知功能，notifier.c 以 DISABLE_NOTIFY 桩替代全部 libnotify 调用。
+add_definitions(-DDISABLE_NOTIFY)
 
 find_package (PkgConfig REQUIRED)
 include (CheckIncludeFile)
