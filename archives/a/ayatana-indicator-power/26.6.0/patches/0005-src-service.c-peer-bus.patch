--- a/src/service.c
+++ b/src/service.c
@@ -1215,6 +1215,7 @@
 {
   priv_t * p;
   int i;
+  const gchar * test_bus_addr;
 
   p = indicator_power_service_get_instance_private(self);
   self->priv = p;
@@ -1248,14 +1249,44 @@
   g_signal_connect_swapped(p->brightness, "notify::auto-brightness-supported",
                            G_CALLBACK(on_auto_brightness_supported_changed), self);
 
-  p->own_id = g_bus_own_name(G_BUS_TYPE_SESSION,
-                             BUS_NAME,
-                             G_BUS_NAME_OWNER_FLAGS_ALLOW_REPLACEMENT,
-                             on_bus_acquired,
-                             NULL,
-                             on_name_lost,
-                             self,
-                             NULL);
+  /* HarmonyOS test support: OHOS PC has no dbus-daemon/session bus, so the
+     test_package consumer drives the real service over a private GDBusServer
+     peer connection instead. When AIP_TEST_BUS_ADDR is set, connect to that
+     peer socket and export all objects on it (no name ownership — there is no
+     message bus). Unset → original session-bus behavior, unchanged. */
+  test_bus_addr = g_getenv ("AIP_TEST_BUS_ADDR");
+  if (test_bus_addr != NULL && test_bus_addr[0] != '\0')
+    {
+      GError * error = NULL;
+      GDBusConnection * conn = g_dbus_connection_new_for_address_sync (
+          test_bus_addr,
+          G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT,
+          NULL, NULL, &error);
+      if (conn == NULL)
+        {
+          g_critical ("AIP_TEST_BUS_ADDR: cannot connect to %s: %s",
+                      test_bus_addr, (error != NULL) ? error->message : "unknown");
+          g_clear_error (&error);
+        }
+      else
+        {
+          /* emulate session-bus acquisition: export menus/actions, set the
+             "bus" property (Testing/Battery skeletons follow via notify) */
+          on_bus_acquired (conn, BUS_NAME, self);
+          g_object_unref (conn);
+        }
+    }
+  else
+    {
+      p->own_id = g_bus_own_name(G_BUS_TYPE_SESSION,
+                                 BUS_NAME,
+                                 G_BUS_NAME_OWNER_FLAGS_ALLOW_REPLACEMENT,
+                                 on_bus_acquired,
+                                 NULL,
+                                 on_name_lost,
+                                 self,
+                                 NULL);
+    }
 }
 
