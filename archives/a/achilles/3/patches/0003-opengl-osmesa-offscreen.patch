+  if ( (surface=SDL_SetVideoMode(SCREEN_W, SCREEN_H, 32, SDL_SWSURFACE)) == NULL ) {
+    fprintf(stderr, "Unable to create SDL software surface: %s\n", SDL_GetError());
+    SDL_Quit();
+    exit(2);
+  }
+  glbuffer = new unsigned char[SCREEN_W * SCREEN_H * 4];
+  if(glbuffer == NULL) {
+    fprintf(stderr, "Unable to allocate %dx%d render buffer\n", SCREEN_W, SCREEN_H);
+    SDL_Quit();
+    exit(2);
+  }
+  memset(glbuffer, 0, (size_t)SCREEN_W * SCREEN_H * 4);
+  /* 16-bit depth buffer, no stencil/accum -- matches what the fixed
+     function pipeline below and the screenshot path need. */
+  ctx = OSMesaCreateContextExt(OSMESA_RGBA, 16, 0, 0, NULL);
+  if ( ctx == NULL ) {
+    fprintf(stderr, "Unable to create OSMesa context\n");
+    SDL_Quit();
+    exit(2);
+  }
+  if ( !OSMesaMakeCurrent(ctx, glbuffer, GL_UNSIGNED_BYTE, SCREEN_W, SCREEN_H) ) {
+    fprintf(stderr, "Unable to make OSMesa context current\n");
+    OSMesaDestroyContext(ctx);
+    SDL_Quit();
+    exit(2);
+  }
