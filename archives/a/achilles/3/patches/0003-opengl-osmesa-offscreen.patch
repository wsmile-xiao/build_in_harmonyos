 bool OpenGLClass::SwapBuffers() {
+#ifdef OSMESA_RENDER
+  int x,y;
+  unsigned char *dst0;
+
+  /* There is no on-screen buffer to swap: the frame just rendered by the
+     OSMesa softpipe backend is copied onto the SDL software surface so the
+     rest of the application (and anything holding the surface) can see it. */
+  glFinish();
+  if ( surface != NULL ) {
+    if ( SDL_MUSTLOCK(surface) && SDL_LockSurface(surface) < 0 ) {
+      return false;
+    }
+    dst0 = (unsigned char *)surface->pixels;
+    for(y=0;y<SCREEN_H;y++) {
+      Uint32 *dst = (Uint32 *)(dst0 + (size_t)y * surface->pitch);
+      const unsigned char *src = glbuffer + (size_t)y * SCREEN_W * 4;
+      for(x=0;x<SCREEN_W;x++) {
+        dst[x] = SDL_MapRGBA(surface->format, src[0], src[1], src[2], src[3]);
+        src += 4;
+      }
+    }
+    if ( SDL_MUSTLOCK(surface) ) {
+      SDL_UnlockSurface(surface);
+    }
+    SDL_UpdateRect(surface, 0, 0, 0, 0);
+  }
+#else
   SDL_GL_SwapBuffers();
+#endif
   return true;
 }
 
