--- a/test/test-airdecap-ng.sh
+++ b/test/test-airdecap-ng.sh
@@ -9,7 +9,10 @@
     if test -f /etc/alpine-release; then
         tmpdir="$(mktemp -d -t acng.XXXXXX)"
     else
-	tmpdir="$(mktemp -d -t acng.XXXX)"
+	# HarmonyOS toybox mktemp rejects -t templates with fewer than six
+	# X's ("need XXXXXX: Not supported"); an absolute template works on
+	# both GNU coreutils and toybox.
+	tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/acng.XXXXXX")"
     fi
 fi
 
