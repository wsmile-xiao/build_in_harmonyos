--- a/test/test-airolib-sqlite.sh
+++ b/test/test-airolib-sqlite.sh
@@ -6,7 +6,10 @@
 if test -f /etc/alpine-release -o "$(uname -s)" = "OpenBSD"; then
     tmpfile="$(mktemp -u -t acng.XXXXXX)"
 else
-    tmpfile="$(mktemp -u -t acng.XXXX)"
+    # HarmonyOS toybox mktemp rejects -t templates with fewer than six
+    # X's ("need XXXXXX: Not supported"); an absolute template works on
+    # both GNU coreutils and toybox.
+    tmpfile="$(mktemp -u "${TMPDIR:-/tmp}/acng.XXXXXX")"
 fi
 # Clean on exit
 trap "rm -fr "${tmpdir}"" INT QUIT SEGV PIPE ALRM TERM EXIT
