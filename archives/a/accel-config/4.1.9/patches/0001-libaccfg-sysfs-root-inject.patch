-#define IDXD_DRIVER_BIND_PATH "/sys/bus/dsa/drivers/idxd"
+/*
+ * sysfs_root() returns the sysfs mount point.  Production behavior uses
+ * "/sys"; for test/consumer purposes the ACCFG_SYSFS_ROOT environment
+ * variable allows redirecting all sysfs access to a mock directory so that
+ * read-only enumeration and attribute parsing can be validated without
+ * touching real hardware.  Unset or empty keeps the default "/sys".
+ */
+static const char *sysfs_root(void)
+{
+	static char root[PATH_MAX];
+	const char *env = getenv("ACCFG_SYSFS_ROOT");
+
+	if (env && env[0] && strlen(env) < PATH_MAX) {
+		strcpy(root, env);
+		while (strlen(root) > 1 && root[strlen(root) - 1] == '/')
+			root[strlen(root) - 1] = '\0';
+		return root;
+	}
+	return "/sys";
+}
+
+/* Path of the idxd driver bind directory under the sysfs root. */
+static const char *sysfs_driver_bind_path(void)
+{
+	static char path[PATH_MAX];
+
+	snprintf(path, sizeof(path), "%s/bus/dsa/drivers/idxd",
+		 sysfs_root());
+	return path;
+}
