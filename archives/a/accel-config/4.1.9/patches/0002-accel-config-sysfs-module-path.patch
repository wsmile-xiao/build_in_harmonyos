--- a/accfg/accel-config.c	2026-08-13 12:41:44.873157656 +0800
+++ b/accfg/accel-config.c	2026-08-13 12:41:44.897156875 +0800
@@ -9,6 +9,29 @@
 #include <sys/types.h>
 #include <builtin.h>
 #include <accfg/libaccel_config.h>
+
+/*
+ * Path of the idxd kernel module directory under the sysfs root.
+ * The ACCFG_SYSFS_ROOT environment variable (see libaccfg.c) allows
+ * test/consumer redirect of sysfs access to a mock directory; unset keeps
+ * the default "/sys".
+ */
+static const char *accfg_sysfs_module_path(void)
+{
+	static char path[PATH_MAX];
+	static char root[PATH_MAX];
+	const char *env = getenv("ACCFG_SYSFS_ROOT");
+
+	if (env && env[0] && strlen(env) < PATH_MAX) {
+		strcpy(root, env);
+		while (strlen(root) > 1 && root[strlen(root) - 1] == '/')
+			root[strlen(root) - 1] = '\0';
+	} else {
+		strcpy(root, "/sys");
+	}
+	snprintf(path, sizeof(path), "%s/module/idxd", root);
+	return path;
+}
 #include <ccan/array_size/array_size.h>
 #include <util/parse-options.h>
 #include <util/strbuf.h>
@@ -50,7 +73,7 @@
 	main_handle_options(argv, argc, accfg_usage_string, commands,
 			    ARRAY_SIZE(commands));
 
-	if (access("/sys/module/idxd", F_OK)) {
+	if (access(accfg_sysfs_module_path(), F_OK)) {
 		fprintf(stderr, "idxd kernel module not loaded\n");
 		return EXIT_FAILURE;
 	}
