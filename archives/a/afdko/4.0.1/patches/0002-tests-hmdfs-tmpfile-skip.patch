+# -*- coding: utf-8 -*-
+"""afdko upstream test-suite HarmonyOS(HMDFS) platform adaptation.
+
+On HMDFS /tmp is a read-only filesystem, so C executables (tx/spot/
+detype1 etc.) fail with Permission denied when calling tmpfile() at
+runtime (verified: setting TMPDIR has no effect). The cases below
+depend on in-tool tmpfile capability and cannot run on HMDFS; they
+are marked as platform-limited skip (active only on this platform).
+"""
+import os
+import pytest
+
+
+def _hmdfs_tmpfile_restricted():
+    """HMDFS feature probe: /tmp read-only means platform limited."""
+    probe = os.path.join("/tmp", ".afdko_probe")
+    try:
+        with open(probe, "w") as f:
+            f.write("x")
+        os.unlink(probe)
+        return False
+    except OSError:
+        return True
+
+
+HMDFS_TMPFILE_RESTRICTED = _hmdfs_tmpfile_restricted()
