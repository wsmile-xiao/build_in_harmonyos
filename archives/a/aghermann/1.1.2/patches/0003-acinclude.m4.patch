--- a/acinclude.m4
+++ b/acinclude.m4
@@ -791,10 +791,56 @@
 AC_DEFUN([AX_LUA_READLINE],
 [
   AX_LIB_READLINE
   AS_IF([test "x$ac_cv_header_readline_readline_h" != 'x' &&
          test "x$ac_cv_header_readline_history_h" != 'x'],
     [ LUA_LIBS_CFLAGS="-DLUA_USE_READLINE $LUA_LIBS_CFLAGS"
       $1
     ],
     [$2])
 ])
+
+dnl =========================================================================
+dnl AX_PATH_GSL([MIN-VERSION], [ACTION-IF-FOUND], [ACTION-IF-NOT-FOUND])
+dnl =========================================================================
+dnl Missing from this distro's bundled macros (removed from modern
+dnl autoconf-archive); re-implemented using pkg-config so configure.ac's
+dnl AX_PATH_GSL([2.0], [AC_DEFINE([HAVE_GSL_20]...)], []) works.
+AC_DEFUN([AX_PATH_GSL],
+[
+  AC_ARG_WITH([gsl],
+    [AS_HELP_STRING([--with-gsl=<can be a path or yes or no>],
+        [specify the gsl directory])],
+    [], [with_gsl=yes])
+
+  AC_REQUIRE([PKG_PROG_PKG_CONFIG])
+
+  GSL_CFLAGS=""
+  GSL_LIBS=""
+  ax_path_gsl_found=no
+  if test "x$with_gsl" != "xno" ; then
+    if $PKG_CONFIG --exists gsl 2>/dev/null ; then
+      GSL_CFLAGS=`$PKG_CONFIG --cflags gsl`
+      GSL_LIBS=`$PKG_CONFIG --libs gsl`
+      ax_path_gsl_version=`$PKG_CONFIG --modversion gsl 2>/dev/null`
+      ax_path_gsl_found=yes
+      AC_MSG_NOTICE([found GSL version $ax_path_gsl_version])
+    fi
+  fi
+
+  m4_ifval([$1], [
+  if test "x$ax_path_gsl_found" = "xyes" ; then
+    if ! $PKG_CONFIG --atleast-version=[$1] gsl 2>/dev/null ; then
+      ax_path_gsl_found=no
+      AC_MSG_WARN([GSL version $ax_path_gsl_version does not satisfy minimum version $1])
+    fi
+  fi])
+
+  if test "x$ax_path_gsl_found" = "xyes" ; then
+    ifelse([$2], [], [:], [$2])
+  else
+    ifelse([$3], [], [:], [$3])
+  fi
+
+  AC_SUBST([GSL_CFLAGS])
+  AC_SUBST([GSL_LIBS])
+])
