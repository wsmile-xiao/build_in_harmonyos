--- a/abuild-tar.c
+++ b/abuild-tar.c
@@ -313,6 +313,17 @@
 			}
 
 			buf_add_ext_header_hexdump(&pax, checksumhdr, digest, EVP_MD_size(md));
+			/* The pax extended header is only filled in from an 'x' header
+			 * present in the input stream.  A plain ustar input (e.g. toybox
+			 * tar, which lacks --format=posix) leaves paxhdr all-zero except
+			 * size/checksum: typeflag 0 with an empty name reads as
+			 * end-of-archive, so the synthesized APK-TOOLS.checksum header
+			 * would be dropped.  Fill in a proper 'x' header in that case. */
+			if (paxhdr.typeflag != 'x') {
+				memset(&paxhdr, 0, sizeof(paxhdr));
+				paxhdr.typeflag = 'x';
+				memcpy(paxhdr.name, hdr.name, sizeof(paxhdr.name));
+			}
 			PUT_OCTAL(paxhdr.size, pax.size);
 			tarhdr_checksum(&paxhdr);
 		}
