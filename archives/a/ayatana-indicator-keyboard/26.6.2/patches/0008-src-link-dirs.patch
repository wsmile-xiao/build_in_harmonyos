--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -1,5 +1,10 @@
 cmake_minimum_required(VERSION 3.13)
 
+# Conan/OHOS: conan 包库不在编译器默认搜索路径（Ubuntu /usr/lib 则在），
+# pkg_check 的 -l 需要 -L 配合；上游仅在文件后部声明 SERVICE_DEPS 目录，
+# 两个后端 SHARED 建在声明之前故链接找不到所有依赖。此处前置声明。
+link_directories(${SERVICE_DEPS_LIBRARY_DIRS} ${X11_DEPS_LIBRARY_DIRS})
+
 # libayatana-keyboard-backend-x11.so
 
 add_library("ayatana-keyboard-x11" SHARED keyboard-x11.c)
