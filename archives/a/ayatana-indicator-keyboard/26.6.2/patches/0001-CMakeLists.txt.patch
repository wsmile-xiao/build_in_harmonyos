--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,6 +10,7 @@
 # Options
 option(ENABLE_WERROR "Treat all build warnings as errors" OFF)
 option(ENABLE_UBUNTU_ACCOUNTSSERVICE "Build with Ubuntu's fork of accountsservice" OFF)
+option(SKIP_DATA_PO "Skip data/ and po/ subdirectories (HarmonyOS lacks GSettings/Intltool CMake modules)" OFF)

 set(CMAKE_BUILD_TYPE "Release")

@@ -52,8 +52,12 @@
 include_directories (${CMAKE_CURRENT_SOURCE_DIR}/include)
 include_directories (${CMAKE_CURRENT_BINARY_DIR}/include)
 add_subdirectory(src)
-add_subdirectory(data)
-add_subdirectory(po)
+if(SKIP_DATA_PO)
+    message(STATUS "SKIP_DATA_PO=ON: skip data/ and po/ subdirectories (no GSettings/Intltool CMake modules on HarmonyOS)")
+else()
+    add_subdirectory(data)
+    add_subdirectory(po)
+endif()

 # Display config info
 message(STATUS "Install prefix: ${CMAKE_INSTALL_PREFIX}")
