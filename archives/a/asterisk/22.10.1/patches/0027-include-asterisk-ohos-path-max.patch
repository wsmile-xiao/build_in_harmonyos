--- a/include/asterisk.h
+++ b/include/asterisk.h
@@ -39,6 +39,13 @@
 #ifndef PATH_MAX
 #define PATH_MAX 4096
 #endif
+/* HarmonyOS headers may expose a 32-byte PATH_MAX even though the device
+ * filesystem accepts normal POSIX paths.  Asterisk stores complete paths in
+ * PATH_MAX-sized public buffers, so retain the portable internal bound. */
+#if PATH_MAX < 4096
+#undef PATH_MAX
+#define PATH_MAX 4096
+#endif
 
 
