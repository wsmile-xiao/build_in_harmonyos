--- a/main/Makefile
+++ b/main/Makefile
@@ -52,6 +52,8 @@ AST_LIBS+=$(JANSSON_LIB)
 # OHOS 适配：libuuid 来自 conan 静态包，链接行需显式补 -luuid；
 # musl 无 pthread_cancel（E085），补 libohosshim 存根
 AST_LIBS+=-luuid -lohosshim
+# OHOS clang -fblocks runtime supplied by the Conan recipe.
+AST_LIBS+=-L$(ASTTOPDIR)/ohos-shim -Wl,-rpath,$(ASTTOPDIR)/ohos-shim -lBlocksRuntime
 AST_LIBS+=$(URIPARSER_LIB)
 AST_LIBS+=$(UUID_LIB)
 AST_LIBS+=$(CRYPT_LIB)
--- a/Makefile.moddir_rules
+++ b/Makefile.moddir_rules
@@ -82,6 +82,10 @@ endif
 
 # For loadable modules, pass _LIB and _LDFLAGS from menuselect.
 $(LOADABLE_MODS:%=%.so): LIBS+=$(foreach dep,$(MENUSELECT_DEPENDS_$*),$(value $(dep)_LIB))
+# OHOS modules use BlocksRuntime, pthread compatibility, and uuid directly.
+# The variable is empty for non-OHOS builds and therefore preserves upstream
+# module link behavior there.
+$(LOADABLE_MODS:%=%.so): LIBS+=$(OHOS_MODULE_LIBS)
 $(LOADABLE_MODS:%=%.so): _ASTLDFLAGS+=$(foreach dep,$(MENUSELECT_DEPENDS_$*),$(value $(dep)_LDFLAGS))
 
 $(addsuffix .so,$(filter $(LOADABLE_MODS),$(C_MODS))): %.so: %.o
