--- a/include/asterisk/lock.h
+++ b/include/asterisk/lock.h
@@ -73,9 +73,19 @@
 #define AST_PTHREADT_NULL (pthread_t) -1
 #define AST_PTHREADT_STOP (pthread_t) -2
 
-#if (defined(SOLARIS) || defined(BSD))
+/*
+ * AST_USE_MUTEX_CONSTRUCTOR_INIT is a capability switch provided by the
+ * build for platforms whose C library has no recursive static mutex
+ * initializer (e.g. musl, where PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP is
+ * unavailable and PTHREAD_MUTEX_INITIALIZER yields a normal mutex).
+ * Without it, statically initialized mutexes are not recursive while
+ * Asterisk requires recursive mutexes; the module loader locks
+ * module_list and then re-locks it from ast_module_register(), which
+ * self-deadlocks and stops startup at "Asterisk Dynamic Loader Starting:".
+ */
+#if (defined(SOLARIS) || defined(BSD) || defined(AST_USE_MUTEX_CONSTRUCTOR_INIT))
 #define AST_MUTEX_INIT_W_CONSTRUCTORS
 #endif /* SOLARIS || BSD */
 
 /* Asterisk REQUIRES recursive (not error checking) mutexes
    and will not run without them. */
