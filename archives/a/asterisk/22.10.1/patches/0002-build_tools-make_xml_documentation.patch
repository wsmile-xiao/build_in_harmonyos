--- a/build_tools/make_xml_documentation
+++ b/build_tools/make_xml_documentation
@@ -1,16 +1,17 @@
 #!/bin/sh
 # shellcheck disable=SC2154
 
 PROGNAME="${0##*/}"
 
-tmp_output_file=/tmp/xmldoc.$$.xml
+# OHOS 适配：/tmp 只读（HMDFS），临时文件改用 TMPDIR
+tmp_output_file="${TMPDIR:-/tmp}/xmldoc.$$.xml"
 
 cleanup() {
     [ -f "$tmp_output_file" ] && rm "$tmp_output_file"
 }
 
 trap cleanup EXIT
 
 # Fail on errors
 set -e
 
