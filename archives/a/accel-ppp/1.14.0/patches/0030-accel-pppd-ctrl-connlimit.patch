diff --git a/accel-pppd/ctrl/pppoe/CMakeLists.txt b/accel-pppd/ctrl/pppoe/CMakeLists.txt
index b6f4a98..6944f0f 100644
--- a/accel-pppd/ctrl/pppoe/CMakeLists.txt
+++ b/accel-pppd/ctrl/pppoe/CMakeLists.txt
@@ -13,12 +13,15 @@ SET(sources ${sources} tr101.c)
 ENDIF(RADIUS)
 
 ADD_LIBRARY(pppoe SHARED ${sources})
-# if MUSL is set then we need to link with the connlimit library
-IF (MUSL)
-	TARGET_LINK_LIBRARIES(pppoe vlan-mon connlimit)
-ELSE (MUSL)
-	TARGET_LINK_LIBRARIES(pppoe vlan-mon)
-ENDIF (MUSL)
+IF (RADIUS)
+	# tr101.c references radius module symbols (rad_register_plugin); under
+	# OHOS musl these must be an explicit DT_NEEDED dependency.
+	TARGET_LINK_LIBRARIES(pppoe radius)
+ENDIF (RADIUS)
+# OHOS musl has no main-program global scope for dlopen()ed modules, so
+# connlimit must be an explicit DT_NEEDED dependency (upstream only did this
+# under MUSL, which is not detected for clang/OHOS).
+TARGET_LINK_LIBRARIES(pppoe vlan-mon connlimit ${crypto_lib})
 set_property(TARGET pppoe PROPERTY CMAKE_BUILD_WITH_INSTALL_RPATH FALSE)
 set_property(TARGET pppoe PROPERTY INSTALL_RPATH ${CMAKE_INSTALL_PREFIX}/lib${LIB_SUFFIX}/accel-ppp)
 
