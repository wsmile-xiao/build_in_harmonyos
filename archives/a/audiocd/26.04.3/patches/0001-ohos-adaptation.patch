+/*
+    SPDX-FileCopyrightText: 2004-2005 Benjamin Meyer <ben at meyerhome dot net>
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#ifndef AUDIOCDCDIO_H
+#define AUDIOCDCDIO_H
+
+/*
+ * OHOS adaptation: upstream pulls the raw CD frame size constants from
+ * cdparanoia's cdda_interface.h (via the sed-mangled cdda_interface.hpp copy
+ * that the top-level CMakeLists.txt generates). The KIO worker that actually
+ * talks to the drive is trimmed on this platform (no /dev/sr0 style device
+ * and no KIO worker daemon), and the conan package intentionally avoids the
+ * unpublished cdparanoia dependency just for two compile-time constants.
+ * The values below are the fixed on-disc constants from the CD-DA standard
+ * (identical to the cdparanoia definitions, Red Book / IEC 60908):
+ *   - CD_FRAMESIZE_RAW: bytes of raw audio data per CD frame (2352)
+ *   - CD_FRAMESAMPLES:  16-bit stereo samples per frame (2352/4 = 588)
+ */
+#define CD_FRAMESIZE_RAW 2352
+#define CD_FRAMESAMPLES (CD_FRAMESIZE_RAW / 4)
+
+#endif // AUDIOCDCDIO_H
