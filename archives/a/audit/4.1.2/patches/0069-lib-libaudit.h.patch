+ * __kernel_sa_family_t type that linux/netlink.h depends on. */
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+#endif
+#ifndef __kernel_sa_family_t
+#define __kernel_sa_family_t unsigned short
+#endif
+#endif
