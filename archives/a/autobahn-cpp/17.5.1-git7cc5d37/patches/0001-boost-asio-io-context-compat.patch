-static const msgpack::object EMPTY_KW_ARGUMENTS(wamp_kw_arguments(), nullptr);
+inline msgpack::object make_empty_array()
+{
+    msgpack::object result;
+    result.type = msgpack::type::ARRAY;
+    result.via.array.ptr = nullptr;
+    result.via.array.size = 0;
+    return result;
+}
+
+inline msgpack::object make_empty_map()
+{
+    msgpack::object result;
+    result.type = msgpack::type::MAP;
+    result.via.map.ptr = nullptr;
+    result.via.map.size = 0;
+    return result;
+}
+
+static const msgpack::object EMPTY_ARGUMENTS = make_empty_array();
+static const msgpack::object EMPTY_KW_ARGUMENTS = make_empty_map();
