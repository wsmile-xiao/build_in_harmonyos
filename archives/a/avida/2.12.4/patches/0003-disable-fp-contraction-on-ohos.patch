--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -16,6 +16,18 @@
 )
 
 
+# aarch64 would otherwise contract a*b+c into a single-rounding fma, which
+# makes floating-point results diverge from the x86 builds that upstream's
+# consistency-test expected files were generated with.  Upstream tries to
+# prevent this in avida-core/CMakeLists.txt, but that logic sits inside an
+# IF(UNIX) block: CMake reports CMAKE_SYSTEM_NAME=HarmonyOS for the OHOS
+# toolchain, so UNIX is not set, the whole block is skipped, and its
+# -mno-fused-madd probe (a GCC-only flag that clang rejects anyway) never runs.
+# Set the flag here instead, before any subdirectory is added.
+IF(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+  SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -ffp-contract=off")
+ENDIF(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+
 ADD_SUBDIRECTORY(libs/apto)
 IF(NOT WIN32)
   # Skipped on OHOS/aarch64: tcmalloc's atomicops-internals-x86.h uses x86-only inline asm
