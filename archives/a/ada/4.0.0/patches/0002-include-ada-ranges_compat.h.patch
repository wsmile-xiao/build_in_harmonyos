--- /dev/null
+++ b/include/ada/ranges_compat.h
@@ -0,0 +1,96 @@
+/**
+ * @file ranges_compat.h
+ * @brief Polyfill for C++20 ranges algorithms not available in this platform's libc++.
+ *
+ * clang 15.0.4 on OHOS ships with a libc++ that lacks std::ranges algorithm
+ * overloads (all_of, any_of, binary_search, find_if, find_if_not, lower_bound,
+ * replace, stable_sort). This header provides minimal compatible
+ * implementations that delegate to the classic iterator-based algorithms.
+ *
+ * This mirrors the ranges_compat.h polyfill introduced for ada 3.3.0 and
+ * extends it with the binary_search / lower_bound (with projection) overloads
+ * required by ada 4.0.0's IDNA implementation.
+ */
+#ifndef ADA_RANGES_COMPAT_H
+#define ADA_RANGES_COMPAT_H
+
+#include <algorithm>
+#include <functional>
+#include <iterator>
+#include <utility>
+
+namespace std::ranges {
+
+template <typename R, typename Pred>
+auto any_of(R&& r, Pred pred) -> bool {
+  return std::any_of(std::begin(r), std::end(r), pred);
+}
+
+template <typename R, typename Pred>
+auto all_of(R&& r, Pred pred) -> bool {
+  return std::all_of(std::begin(r), std::end(r), pred);
+}
+
+template <typename R, typename T>
+auto replace(R& r, const T& old_value, const T& new_value) -> void {
+  std::replace(std::begin(r), std::end(r), old_value, new_value);
+}
+
+template <typename R, typename Pred>
+auto find_if(R&& r, Pred pred) {
+  return std::find_if(std::begin(r), std::end(r), pred);
+}
+
+template <typename R, typename Pred>
+auto find_if_not(R&& r, Pred pred) {
+  return std::find_if_not(std::begin(r), std::end(r), pred);
+}
+
+template <typename R, typename Pred>
+auto stable_sort(R& r, Pred pred) -> void {
+  std::stable_sort(std::begin(r), std::end(r), pred);
+}
+
+// lower_bound(range, value, comp, proj) — project to the range-high element.
+template <typename R, typename T, typename Comp = std::less<>, typename Proj = std::identity>
+auto lower_bound(R&& r, const T& value, Comp comp = {}, Proj proj = {}) {
+  auto first = std::begin(r);
+  const auto last = std::end(r);
+  using Diff = decltype(last - first);
+  Diff count = last - first;
+  while (count > 0) {
+    Diff step = count / 2;
+    auto it = first + step;
+    if (comp(std::invoke(proj, *it), value)) {
+      first = ++it;
+      count -= step + 1;
+    } else {
+      count = step;
+    }
+  }
+  return first;
+}
+
+// binary_search(range, value) — assumes a sorted range, default less comparator.
+template <typename R, typename T>
+auto binary_search(R&& r, const T& value) -> bool {
+  auto first = std::begin(r);
+  const auto last = std::end(r);
+  using Diff = decltype(last - first);
+  Diff count = last - first;
+  while (count > 0) {
+    Diff step = count / 2;
+    auto it = first + step;
+    if (*it < value) {
+      first = ++it;
+      count -= step + 1;
+    } else {
+      count = step;
+    }
+  }
+  return first != last && !(value < *first);
+}
+
+}  // namespace std::ranges
+
+#endif  // ADA_RANGES_COMPAT_H
