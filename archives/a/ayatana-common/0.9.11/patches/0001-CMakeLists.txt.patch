@@ -57,21 +57,28 @@
 
 pkg_check_modules (DEPS REQUIRED ${DEPS})
 include_directories (${DEPS_INCLUDE_DIRS})
 
 # for GIR and Vala bindings
 find_package (GObjectIntrospection QUIET)
 find_package (Vala QUIET)
 
 add_subdirectory(src)
 add_subdirectory(data)
-add_subdirectory(po)
+
+# Translations require the Intltool CMake module (part of Ubuntu's
+# cmake-extras, not shipped on HarmonyOS). Skip po/ when the module is
+# unavailable so the build does not break on such platforms.
+find_package(Intltool QUIET)
+if(INTLTOOL_FOUND)
+    add_subdirectory(po)
+endif()
 
