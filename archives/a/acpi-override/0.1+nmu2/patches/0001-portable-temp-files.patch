--- acpi-override-0.1+nmu2/acpi-override
+++ acpi-override-0.1+nmu2/acpi-override
@@ -15,6 +15,18 @@
-ACPI="$(mktemp -d "${TMPDIR:-/var/tmp}/initramfs_acpi_XXXXXX")" || exit 1
-ACPI_CPIO="$(mktemp "${TMPDIR:-/var/tmp}/initramfs_acpi_XXXXXX_cpio")" || exit 1
+ACPI_BASE="${TMPDIR:-/var/tmp}/initramfs_acpi_$$"
+ACPI="$ACPI_BASE"
+ACPI_CPIO="${ACPI_BASE}_cpio"
+ACPI_SUFFIX=0
+while [ -e "$ACPI" ] || [ -e "$ACPI_CPIO" ]; do
+  ACPI_SUFFIX=$((ACPI_SUFFIX + 1))
+  ACPI="${ACPI_BASE}_$ACPI_SUFFIX"
+  ACPI_CPIO="${ACPI}_cpio"
+done
+mkdir "$ACPI" || exit 1
+: > "$ACPI_CPIO" || {
+  rmdir "$ACPI" 2>/dev/null || true
+  exit 1
+}
 mkdir -p "$ACPI/kernel/firmware/acpi/"
