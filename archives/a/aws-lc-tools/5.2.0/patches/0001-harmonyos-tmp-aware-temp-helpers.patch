diff --git a/crypto/test/test_util.cc b/crypto/test/test_util.cc
--- a/crypto/test/test_util.cc
+++ b/crypto/test/test_util.cc
@@ -412,7 +412,14 @@ size_t createTempFILEpath(char buffer[PATH_MAX]) {
 }
 
 size_t createTempDirPath(char buffer[PATH_MAX]) {
-  snprintf(buffer, PATH_MAX, "/tmp/awslcTestDirXXXXXX");
+  // Some platforms (e.g. HarmonyOS/OHOS) expose a read-only /tmp. Honor TMPDIR
+  // first so the temporary directory lands on a writable filesystem, falling
+  // back to the current working directory.
+  const char *tmpdir = getenv("TMPDIR");
+  if (tmpdir == NULL || *tmpdir == '\0') {
+    tmpdir = ".";
+  }
+  snprintf(buffer, PATH_MAX, "%s/awslcTestDirXXXXXX", tmpdir);
   if (mkdtemp(buffer) == NULL) {
     return 0;
   }
@@ -420,7 +427,34 @@ size_t createTempDirPath(char buffer[PATH_MAX]) {
 }
 
 FILE* createRawTempFILE() {
-  return tmpfile();
+  FILE *file = tmpfile();
+  if (file != NULL) {
+    return file;
+  }
+  // tmpfile() hardcodes /tmp and fails on read-only /tmp mounts (HarmonyOS).
+  // Fall back to an unlinked mkstemp file under TMPDIR (or the current working
+  // directory); the caller only needs an anonymous read/write FILE handle.
+  const char *tmpdir = getenv("TMPDIR");
+  if (tmpdir == NULL || *tmpdir == '\0') {
+    tmpdir = ".";
+  }
+  char path[PATH_MAX];
+  int written = snprintf(path, sizeof(path), "%s/awslcTestTmpFileXXXXXX", tmpdir);
+  if (written < 0 || written >= (int)sizeof(path)) {
+    return NULL;
+  }
+  int fd = mkstemp(path);
+  if (fd == -1) {
+    return NULL;
+  }
+  file = fdopen(fd, "w+b");
+  if (file == NULL) {
+    close(fd);
+    unlink(path);
+    return NULL;
+  }
+  unlink(path);
+  return file;
 }
 #endif
 
