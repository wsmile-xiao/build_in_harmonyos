--- a/configure
+++ b/configure
@@ -50,6 +50,12 @@ export as_nl
 IFS=" ""	$as_nl"

+# Define PKG_CHECK_MODULES as a fallback function if pkg.m4 is missing
+PKG_CHECK_MODULES() {
+  # Simple stub: skip pkg-config checks
+  return 1
+}
+
 # Reset variables that may have inherited troublesome values from
 # the environment.

@@ -13650,11 +13656,11 @@ esac
 # Create a (secure) tmp directory for tmp files.

 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 077 && mktemp -d "$HOME/tmp/confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
+  tmp=$HOME/tmp/conf$$-$RANDOM
   (umask 077 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp