diff -ruN a/scripts/embed.sh b/scripts/embed.sh
--- a/scripts/embed.sh
+++ b/scripts/embed.sh
@@ -7,12 +7,6 @@
     exit 1
 }
 
-# Ensure xxd is available
-if ! command -v xxd > /dev/null 2>&1; then
-    echo "Error: xxd is not installed or not found in PATH."
-    exit 1
-fi
-
 # Parse arguments
 SOURCE=""
 HEADER=""
@@ -49,9 +43,19 @@
 xxd -i "$SOURCE" | \
     sed "s/unsigned char [^ ]*/unsigned char ${ARRAY_NAME}[]/" | \
     sed "s/unsigned int [^ ]*/unsigned int ${ARRAY_NAME}_len/" > "$HEADER"
+status=$?
+
+# toybox xxd supports -i but emits only raw hex bytes without the
+# 'unsigned char NAME[] = {' wrapper that GNU xxd adds for file input.
+# If the wrapper is missing, regenerate via embed.py (same CLI) so the
+# generated header still declares NAME and NAME_len.
+if [ $status -eq 0 ] && ! grep -q "unsigned char" "$HEADER"; then
+    "${HMBS_PYTHON3:-python3}" "$(dirname "$0")/embed.py" --source "$SOURCE" --header "$HEADER" --array-name "$ARRAY_NAME"
+    status=$?
+fi
 
 # Check for success
-if [ $? -eq 0 ]; then
+if [ $status -eq 0 ]; then
     echo "Successfully generated header '$HEADER' with array name '${ARRAY_NAME}'"
 else
     echo "Error generating header '$HEADER'"
