 /**
+ * asc_media_supports_image_format:
+ * @media: an #AscMedia instance.
+ * @format: lower-case format name, e.g. "jxl" or "png".
+ *
+ * Check whether the running media worker can actually process (load and save)
+ * the given image format. The worker reports the formats its libvips build
+ * provides during the handshake.
+ *
+ * Returns: %TRUE if the format is supported, %FALSE if not or if the answer
+ * is not known yet (no worker running).
+ */
+gboolean
+asc_media_supports_image_format (AscMedia *media, const gchar *format)
+{
+	AscMediaPrivate *priv = GET_PRIVATE (media);
+	if (priv->worker_image_formats == NULL || format == NULL)
+		return FALSE;
+	for (guint i = 0; priv->worker_image_formats[i] != NULL; i++) {
+		if (g_str_equal (priv->worker_image_formats[i], format))
+			return TRUE;
+	}
+	return FALSE;
+}
+
