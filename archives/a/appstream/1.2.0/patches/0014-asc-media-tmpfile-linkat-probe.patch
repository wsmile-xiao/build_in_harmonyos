--- a/compose/asc-media.c	2026-09-25 06:40:41.117032344 +0800
+++ b/compose/asc-media.c	2026-09-25 06:40:48.381033750 +0800
@@ -1633,8 +1633,28 @@
 
 	if (g_once_init_enter (&initialized)) {
 		gboolean found = g_file_test ("/proc/self/fd", G_FILE_TEST_IS_DIR);
+		if (found) {
+			/* Publishing an O_TMPFILE inode requires linkat() through
+			 * /proc/self/fd. Some platforms (OHOS) mount /proc but deny the
+			 * linkat() with EACCES, which would make every rendition fail at
+			 * commit time — verify the linkat actually works once and fall
+			 * back to named temporary files where it does not. */
+			gint probe_fd = openat (AT_FDCWD, ".", O_TMPFILE | O_WRONLY | O_CLOEXEC, 0644);
+			if (probe_fd >= 0) {
+				g_autofree gchar *proc_path = g_strdup_printf ("/proc/self/fd/%i", probe_fd);
+				g_autofree gchar *probe_name = asc_media_make_tmp_name ();
+				if (linkat (AT_FDCWD, proc_path, AT_FDCWD, probe_name, AT_SYMLINK_FOLLOW) != 0) {
+					found = FALSE;
+				} else {
+					unlinkat (AT_FDCWD, probe_name, 0);
+				}
+				close (probe_fd);
+			} else {
+				found = FALSE;
+			}
+		}
 		if (!found)
-			g_debug ("No /proc available, using named temporary media files.");
+			g_debug ("O_TMPFILE can not be published via /proc on this platform, using named temporary media files.");
 		have_proc_fd = found;
 		g_once_init_leave (&initialized, 1);
 	}
