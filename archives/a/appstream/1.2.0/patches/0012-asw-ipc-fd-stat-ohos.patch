--- a/compose/worker/asw-ipc.c	2026-09-25 06:30:07.989032656 +0800
+++ b/compose/worker/asw-ipc.c	2026-09-25 06:30:24.625032500 +0800
@@ -54,7 +54,7 @@
 	struct stat st;
 	gint seals;
 
-	if (fstat (fd, &st) != 0) {
+	if (fstat (fd, &st) != 0 && errno != EACCES) {
 		g_set_error (error,
 			     ASC_MEDIA_ERROR,
 			     ASC_MEDIA_ERROR_PROTOCOL,
@@ -62,7 +62,11 @@
 			     g_strerror (errno));
 		return FALSE;
 	}
-	if (!S_ISREG (st.st_mode)) {
+	/* OHOS denies fstat() on file descriptors received via SCM_RIGHTS
+	 * (EACCES). The sealfd is still a memfd, and the F_GET_SEALS check below
+	 * is the actual security gate; the regular-file check and the size read
+	 * are only skipped/derived differently in that case. */
+	if (errno != EACCES && !S_ISREG (st.st_mode)) {
 		g_set_error_literal (error,
 				     ASC_MEDIA_ERROR,
 				     ASC_MEDIA_ERROR_PROTOCOL,
@@ -88,8 +92,24 @@
 		return FALSE;
 	}
 
-	if (size_out != NULL)
-		*size_out = st.st_size;
+	if (size_out != NULL) {
+		if (errno == EACCES) {
+			/* fstat is denied on SCM_RIGHTS-received fds under OHOS:
+			 * derive the size via seek instead. */
+			off_t sz = lseek (fd, 0, SEEK_END);
+			if (sz < 0) {
+				g_set_error (error,
+					     ASC_MEDIA_ERROR,
+					     ASC_MEDIA_ERROR_PROTOCOL,
+					     "Unable to determine size of received fd: %s",
+					     g_strerror (errno));
+				return FALSE;
+			}
+			*size_out = (gsize) sz;
+		} else {
+			*size_out = st.st_size;
+		}
+	}
 	return TRUE;
 }
 
