 /**
+ * asw_font_memfd_unmap_cb:
+ *
+ * Free the mmap'ed font data once its #GBytes wrapper is released.
+ */
+static void
+asw_font_memfd_unmap_cb (gpointer data)
+{
+	gpointer *closure = data;
+	munmap (closure[0], GPOINTER_TO_SIZE (closure[1]));
+	g_free (closure);
+}
+
+/**
  * asw_font_new_from_fd:
  * @fd: A (sealed) file descriptor containing the font data.
