+# OHOS (clang 15 / libc++ 15004) 默认不暴露 std::ranges 算法、ranges 视图与
+# <format>：libc++ 需要 _LIBCPP_ENABLE_EXPERIMENTAL 才可用，std::format 的运行时
+# 符号位于 libc++experimental.a。上游源码未改动；默认 OFF，仅由配方在 OHOS 上显式开启。
+option(ASYNCPP_LIBCXX_EXPERIMENTAL "Enable libc++ experimental ranges/format support (OHOS libc++ 15)" OFF)
+if (ASYNCPP_LIBCXX_EXPERIMENTAL)
+	add_compile_definitions(_LIBCPP_ENABLE_EXPERIMENTAL)
+	add_link_options(-lc++experimental)
+endif()
+
 if (${ASYNCPP_BUILD_TESTS})
 	add_compile_definitions(ASYNCPP_BUILD_TESTS=1)
 endif()
 
 add_subdirectory(include/asyncpp)
 add_subdirectory(src)
