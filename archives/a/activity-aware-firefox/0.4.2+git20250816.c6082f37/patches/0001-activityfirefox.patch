+COPY_TYPE_OVERRIDE="${ACTIVITY_AWARE_COPY_TYPE:-}"
+PROBE_CONTEXT=0
+FOREGROUND=0
+FIREFOX_ARGS=()
+while [ "$#" -gt 0 ]; do
+	case "$1" in
+		--activity-id)
+			[ "$#" -ge 2 ] || { echo ">>> Error! --activity-id requires a value" >&2; exit 2; }
+			ACTIVITY_ID_OVERRIDE="$2"; shift 2 ;;
+		--activity-name)
+			[ "$#" -ge 2 ] || { echo ">>> Error! --activity-name requires a value" >&2; exit 2; }
+			ACTIVITY_NAME_OVERRIDE="$2"; shift 2 ;;
+		--copy-type)
+			[ "$#" -ge 2 ] || { echo ">>> Error! --copy-type requires a value" >&2; exit 2; }
+			COPY_TYPE_OVERRIDE="$2"; shift 2 ;;
+		--probe-context)
+			PROBE_CONTEXT=1; shift ;;
+		--foreground)
+			FOREGROUND=1; shift ;;
+		-x)
+			set -x; shift ;;
+		--)
+			shift; FIREFOX_ARGS+=("$@"); break ;;
+		*)
+			FIREFOX_ARGS+=("$1"); shift ;;
+	esac
+done
+set -- "${FIREFOX_ARGS[@]}"
