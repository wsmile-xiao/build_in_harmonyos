+function f_ResolveActivity()
+{
+	if [ -n "${ACTIVITY_ID_OVERRIDE}" ] || [ -n "${ACTIVITY_NAME_OVERRIDE}" ]; then
+		if [ -z "${ACTIVITY_ID_OVERRIDE}" ] || [ -z "${ACTIVITY_NAME_OVERRIDE}" ]; then
+			echo ">>> Error! Explicit activity context requires both ID and name." >&2
+			exit 2
+		fi
+		ACTIVITY_PROVIDER="explicit"
+		ACTIVITY_UUID="${ACTIVITY_ID_OVERRIDE}"
+		ACTIVITY_NAME="${ACTIVITY_NAME_OVERRIDE}"
+	elif [ -n "${ACTIVITY_CLI}" ]; then
+		ACTIVITY_PROVIDER="kde"
+		ACTIVITY_UUID=$("${ACTIVITY_CLI}" --current-activity | cut --fields 2 --delimiter ' ')
+		ACTIVITY_NAME=$("${ACTIVITY_CLI}" --activity-property name "${ACTIVITY_UUID}")
+	else
+		echo ">>> Error! No activity context provider. Set ACTIVITY_AWARE_ID and ACTIVITY_AWARE_NAME, or pass --activity-id and --activity-name." >&2
+		exit 1
+	fi
+
+	if [ -z "${ACTIVITY_UUID}" ] || [ -z "${ACTIVITY_NAME}" ]; then
+		echo ">>> Error! Activity provider returned an empty ID or name." >&2
+		exit 1
+	fi
+	case "${ACTIVITY_UUID}" in
+		[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*)
+			echo ">>> Error! Activity ID must start with an alphanumeric character and contain only A-Z, a-z, 0-9, dot, underscore, or hyphen." >&2
+			exit 2 ;;
+	esac
+	if [ "${#ACTIVITY_UUID}" -gt 128 ]; then
+		echo ">>> Error! Activity ID must not exceed 128 characters." >&2
+		exit 2
+	fi
+	ACTIVITY_NAME_CURATED=$(printf '%s' "${ACTIVITY_NAME}" | LC_ALL=C tr -cd '[:alnum:]-')
+	[ -n "${ACTIVITY_NAME_CURATED}" ] || ACTIVITY_NAME_CURATED="activity"
+}
+
+
+f_ResolveActivity
