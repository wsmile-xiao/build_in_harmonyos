+		"${ACTIVITY_PROVIDER}" "${ACTIVITY_UUID}" "${ACTIVITY_NAME}" \
+		"${ACTIVITY_NAME_CURATED}" "${ACTIVITY_UUID}"
+	exit 0
+fi
 
 
