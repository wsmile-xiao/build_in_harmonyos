--- a/Makefile.good	2026-07-14 22:06:39.206063906 +0800
+++ b/Makefile.good	2026-07-14 22:06:39.234064062 +0800
@@ -1,23 +1,32 @@
-CXX		= g++
-LD		= g++
+CXX		?= g++
+LD		?= $(CXX)
 CXXFILES	= parser.cc lexer.cc expr.cc canvas.cc aamath.cc
-OBJS		= $(CXXFILES:.cc=.o) 
+OBJS		= $(CXXFILES:.cc=.o)
 TARGET		= aamath
-CFLAGS		= -Wall -O2 -g -DUSE_READLINE
-LFLAGS		= -g
-LIBS		= -lreadline -ltermcap
+CXXFLAGS	?= -Wall -O2 -g -DUSE_READLINE
+LFLAGS		?=
+LIBS		?= -lreadline -ltermcap
+PREFIX		?= /usr/local
+DESTDIR		?=
 
 $(TARGET): $(OBJS)
 	$(LD) $(LFLAGS) $(OBJS) -o $@ $(LIBS)
 
 parser.cc parser.h: parser.y
