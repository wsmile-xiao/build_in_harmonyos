diff -ruN a/Makefile.good b/Makefile.good
--- a/Makefile.good
+++ b/Makefile.good
@@ -1,23 +1,31 @@
-CXX		= g++
-LD		= g++
+CXX		= clang++
+LD		= clang++
 CXXFILES	= parser.cc lexer.cc expr.cc canvas.cc aamath.cc
-OBJS		= $(CXXFILES:.cc=.o) 
+OBJS		= $(CXXFILES:.cc=.o)
 TARGET		= aamath
-CFLAGS		= -Wall -O2 -g -DUSE_READLINE
-LFLAGS		= -g
-LIBS		= -lreadline -ltermcap
+CXXFLAGS	= -Wall -O2 -fPIC -DUSE_READLINE -I/storage/Users/currentUser/usr/local/include
+LFLAGS		= -L/storage/Users/currentUser/usr/local/lib
+LIBS		= -lreadline -lncurses
+PREFIX		= /storage/Users/currentUser/usr/local
+DESTDIR		=
 
 $(TARGET): $(OBJS)
 	$(LD) $(LFLAGS) $(OBJS) -o $@ $(LIBS)
 
 parser.cc parser.h: parser.y
-	yacc -d parser.y && mv y.tab.c parser.cc && mv y.tab.h parser.h
+	bison -d parser.y && mv y.tab.c parser.cc && mv y.tab.h parser.h
 
 lexer.cc: lexer.l parser.h
