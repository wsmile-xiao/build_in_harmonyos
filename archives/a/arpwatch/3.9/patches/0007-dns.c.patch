 /* Return the canonical name of the host (NULL if not found) */
 char *
 gethname(u_int32_t a)
 {
+#ifdef NO_RES_STATE
+	/* Musl libc/OHOS: _res not available, use gethostbyaddr directly */
+	struct hostent *hp;
+	hp = gethostbyaddr((char *)&a, sizeof(a), AF_INET);
+	if (hp == NULL)
+		return (NULL);
+	return (hp->h_name);
+#else
 	int32_t options;
 	struct hostent *hp;
 
 	options = _res.options;
 	_res.options |= RES_AAONLY;
 	_res.options &= ~(RES_DEFNAMES | RES_DNSRCH);
 	hp = gethostbyaddr((char *)&a, sizeof(a), AF_INET);
 	_res.options = options;
 	if (hp == NULL)
 		return (NULL);
 	return (hp->h_name);
+#endif
 }
 
