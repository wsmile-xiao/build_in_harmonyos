--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,18 +1,24 @@
 
 cmake_minimum_required(VERSION 3.9...3.31)
 project(aws-c-auth C)
 
 if (NOT IN_SOURCE_BUILD)
     # this is required so we can use aws-c-common's CMake modules
     find_package(aws-c-common REQUIRED)
 endif()
+
+# HarmonyOS: CMAKE_SYSTEM_NAME=HarmonyOS is not recognized as UNIX by CMake,
+# so aws-c-common's cmake config skips find_package(Threads). Add it here
+# so Threads::Threads target exists before aws_use_package loads deps that
+# reference it (aws-c-cal, aws-lc crypto).
+find_package(Threads REQUIRED)
 
 include(AwsCFlags)
 include(AwsCheckHeaders)
 include(AwsSharedLibSetup)
 include(AwsSanitizers)
 include(AwsFindPackage)
 include(GNUInstallDirs)
 
 option(BUILD_RELOCATABLE_BINARIES
         "Build Relocatable Binaries, this will turn off features that will fail on older kernels than used for the build."
