--- a/afl-tmin.c
+++ b/afl-tmin.c
@@ -40,7 +40,7 @@
 #include <sys/fcntl.h>
 #include <sys/wait.h>
 #include <sys/time.h>
-#include <sys/shm.h>
+#include <sys/mman.h>
 #include <sys/stat.h>
 #include <sys/types.h>
 #include <sys/resource.h>
@@ -67,6 +67,7 @@
 
 static u64 mem_limit = MEM_LIMIT;     /* Memory limit (MB)                 */
 
+static u8* shm_name;                  /* Name of the SHM region (mmap)    */
 static s32 shm_id,                    /* ID of the SHM region              */
            dev_null_fd = -1;          /* FD to /dev/null                   */
 
@@ -142,8 +143,12 @@
 
 static void remove_shm(void) {
 
-  unlink(prog_in); /* Ignore errors */
-  shmctl(shm_id, IPC_RMID, NULL);
+  if (shm_id >= 0) {
+
+    close(shm_id);
+    shm_unlink(shm_name);
+
+  }
 
 }
 
@@ -154,21 +159,30 @@
 
   u8* shm_str;
 
-  shm_id = shmget(IPC_PRIVATE, MAP_SIZE, IPC_CREAT | IPC_EXCL | 0600);
-
-  if (shm_id < 0) PFATAL("shmget() failed");
+  shm_name = alloc_printf("/__afl_%d", getpid());
+
+  /* OHOS port: SysV shared memory (shmget/shmat) is blocked by the
+     sandbox (SIGSYS). Use POSIX shared memory (shm_open + ftruncate +
+     mmap) instead - the same approach AFL++ takes with USEMMAP. */
+
+  shm_id = shm_open(shm_name, O_RDWR | O_CREAT | O_EXCL, 0600);
+
+  if (shm_id < 0) PFATAL("shm_open() failed");
+
+  if (ftruncate(shm_id, MAP_SIZE) < 0) PFATAL("ftruncate() failed");
 
   atexit(remove_shm);
 
-  shm_str = alloc_printf("%d", shm_id);
+  shm_str = alloc_printf("%s", shm_name);
 
   setenv(SHM_ENV_VAR, shm_str, 1);
 
   ck_free(shm_str);
 
-  trace_bits = shmat(shm_id, NULL, 0);
-  
-  if (!trace_bits) PFATAL("shmat() failed");
+  trace_bits = mmap(NULL, MAP_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED,
+                    shm_id, 0);
+
+  if (trace_bits == MAP_FAILED) PFATAL("mmap() failed");
 
 }
 
