--- /dev/null
+++ b/cmake/FindGSettings.cmake
@@ -0,0 +1,41 @@
+# - Try to find GSettings
+#
+# Minimal drop-in replacement for Ubuntu's cmake-extras FindGSettings.cmake
+# (the module is not shipped on HarmonyOS).
+#
+# Once done this will define
+#
+#  GSETTINGS_FOUND                 - system has GSettings
+#  GLIB_COMPILE_SCHEMAS_EXECUTABLE - the glib-compile-schemas executable
+#  GSETTINGS_SCHEMAS_INSTALL_DIR   - directory where schemas are installed
+#
+# Provides the macro:
+#  add_schema(<filename>)          - install a GSettings schema XML file
+#
+# The schema XML is installed as-is; it is compiled on the target with
+# glib-compile-schemas (see the gsettings-desktop-schemas package).
+
+find_program(GLIB_COMPILE_SCHEMAS_EXECUTABLE glib-compile-schemas)
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(GSettings DEFAULT_MSG
+    GLIB_COMPILE_SCHEMAS_EXECUTABLE)
+
+if(GSETTINGS_FOUND)
+    if(NOT DEFINED GSETTINGS_SCHEMAS_INSTALL_DIR)
+        set(GSETTINGS_SCHEMAS_INSTALL_DIR
+            "${CMAKE_INSTALL_FULL_DATADIR}/glib-2.0/schemas"
+            CACHE PATH "The directory where schemas should be installed")
+    endif()
+
+    macro(add_schema _schema_file)
+        install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/${_schema_file}"
+                DESTINATION "${GSETTINGS_SCHEMAS_INSTALL_DIR}")
+        # Mirror upstream cmake-extras: copy the schema into the build tree
+        # so tests can reference it.
+        configure_file(
+            "${CMAKE_CURRENT_SOURCE_DIR}/${_schema_file}"
+            "${CMAKE_CURRENT_BINARY_DIR}/${_schema_file}"
+            COPYONLY)
+    endmacro()
+endif()
