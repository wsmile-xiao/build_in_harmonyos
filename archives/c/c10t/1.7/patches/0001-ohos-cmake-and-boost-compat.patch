             continue;
           }
           
diff --git a/src/image/CMakeLists.txt b/src/image/CMakeLists.txt
index 111264d50..652a91861 100644
--- a/src/image/CMakeLists.txt
+++ b/src/image/CMakeLists.txt
@@ -1,9 +1,20 @@
-add_library(c10t-image 
+add_library(c10t-image
   image_operations.cpp
   image_base.cpp
   memory_image.cpp
   cached_image.cpp
   color.cpp
-  ${ZLIB_LIBRARIES} ${PNG_LIBRARIES})
+)
+
+# Conan CMakeDeps expands ZLIB/PNG_LIBRARIES to imported-target
+# names (ZLIB::ZLIB, ...), which add_library rejects as sources.
+target_link_libraries(c10t-image PUBLIC ${ZLIB_LIBRARIES} ${PNG_LIBRARIES})
+# OHOS/Conan CONFIG-mode: the legacy vars above stay empty, so link the
+# imported targets directly when available.
+foreach(_c10t_img_lib IN ITEMS ZLIB::ZLIB PNG::PNG png::png png_shared::png_shared libpng::libpng)
+  if(TARGET ${_c10t_img_lib})
+    target_link_libraries(c10t-image PUBLIC ${_c10t_img_lib})
+  endif()
+endforeach()
 
 set_target_properties(c10t-image PROPERTIES COMPILE_FLAGS "-O3 -Wall -pedantic -g")
