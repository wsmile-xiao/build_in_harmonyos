From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OHOS adaptation <ohos@example.com>
Date: Sat, 6 Sep 2026 00:00:00 +0000
Subject: [PATCH] OHOS/CMake4/Boost>=1.85 compatibility

- cmake_minimum_required 2.6 -> 3.5 (CMake 4.x removed <3.5 compat).
- git rev-list version probe falls back to "1.7" (conan source trees
  carry no .git directory).
- Drop the `system` Boost component: Boost.System is header-only since
  Boost 1.85 and no longer exists as a findable component.
- Migrate removed Boost.Filesystem APIs (basename/extension/is_regular)
  to path::stem()/.extension()/is_regular_file().

Generated against the upstream 1.7 release tarball
(https://github.com/udoprog/c10t/archive/refs/tags/1.7.tar.gz).

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3f1531ab5..e67b1a8b7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.5)
 project(c10t)
 
 set(CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake/modules;${CMAKE_MODULE_PATH}")
@@ -6,7 +6,11 @@ set(CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake/modules;${CMAKE_MODULE_PATH}")
 # attempt to find out which revision we are building from
 execute_process(COMMAND git rev-list HEAD -n1 --abbrev-commit
 				OUTPUT_STRIP_TRAILING_WHITESPACE
-				OUTPUT_VARIABLE C10T_REVISION)
+				OUTPUT_VARIABLE C10T_REVISION
+				ERROR_QUIET)
+if(NOT C10T_REVISION)
+  set(C10T_REVISION "1.7")
+endif()
 set(C10T_VERSION "git ${C10T_REVISION}")
 set(C10T_SITE "http://github.com/udoprog/c10t")
 set(C10T_CONTACT "Udoprog <johnjohn.tedro@gmail.com> et. al (see README)")
@@ -23,7 +27,7 @@ find_package(ZLIB REQUIRED)
 find_package(PNG REQUIRED)
 find_package(FreeType REQUIRED)
 find_package(Threads REQUIRED)
-find_package(Boost COMPONENTS thread filesystem system REQUIRED)
+find_package(Boost COMPONENTS thread filesystem REQUIRED)
 
 include_directories(${ZLIB_INCLUDE_DIR})
 include_directories(${PNG_INCLUDE_DIR})
@@ -31,8 +35,44 @@ include_directories(${FREETYPE_INCLUDE_DIR_freetype2})
 include_directories(${FREETYPE_INCLUDE_DIR_ft2build})
 include_directories(${Boost_INCLUDE_DIR})
 
+# OHOS/Conan CONFIG-mode (CMakeDeps) provides imported targets instead of
+# legacy *_INCLUDE_DIR variables, which stay empty and break intermediate
+# static libs (c10t-mc etc, which do not link Boost themselves).
+foreach(_c10t_tgt IN ITEMS Boost::headers boost::boost Boost::filesystem boost::filesystem Boost::thread boost::thread ZLIB::ZLIB PNG::PNG png::png libpng::libpng Freetype::Freetype freetype::freetype)
+  if(TARGET ${_c10t_tgt})
+    get_target_property(_c10t_inc ${_c10t_tgt} INTERFACE_INCLUDE_DIRECTORIES)
+    if(_c10t_inc AND NOT _c10t_inc MATCHES "NOTFOUND")
+      include_directories(${_c10t_inc})
+    endif()
+  endif()
+endforeach()
+
 set(c10t_LIBRARIES ${ZLIB_LIBRARIES} ${PNG_LIBRARIES} ${CMAKE_THREAD_LIBS_INIT})
 set(c10t_LIBRARIES ${c10t_LIBRARIES} ${Boost_LIBRARIES} ${FREETYPE_LIBRARY})
+# OHOS/Conan: append config targets when legacy vars are empty
+# (CMakeDeps CONFIG mode leaves ZLIB/PNG/Boost/FREETYPE legacy vars empty;
+# without this the final link misses boost_filesystem and freetype symbols).
+foreach(_c10t_lib IN ITEMS Boost::filesystem boost::filesystem Boost::thread boost::thread Boost::headers boost::headers ZLIB::ZLIB PNG::PNG png::png png_shared::png_shared libpng::libpng Freetype::Freetype freetype::freetype Threads::Threads)
+  if(TARGET ${_c10t_lib})
+    list(APPEND c10t_LIBRARIES ${_c10t_lib})
+  endif()
+endforeach()
+# OHOS/Conan: absolute-path Boost libs discovered by the recipe from the
+# real package lib dir (covers imported targets that carry no library).
+if(DEFINED C10T_BOOST_LINK_LIBS)
+  list(APPEND c10t_LIBRARIES ${C10T_BOOST_LINK_LIBS})
+endif()
+message(STATUS "C10T c10t_LIBRARIES=${c10t_LIBRARIES}")
+message(STATUS "C10T C10T_BOOST_FS184_LIB=${C10T_BOOST_FS184_LIB}")
+
+# OHOS/Conan: host Boost 1.91 is a subset build whose package omits
+# header-only dirs (e.g. boost/ptr_container for src/nbt/nbt.hpp).
+# C10T_BOOST_INCLUDE_DIRS comes from the recipe generate() step and lists
+# the host include dir first and the complete-header fallback
+# (boost/1.84.0 build context, autodock-vina 1.2.7 precedent) second.
+if(DEFINED C10T_BOOST_INCLUDE_DIRS)
+  include_directories(${C10T_BOOST_INCLUDE_DIRS})
+endif()
 
 # set(Boost_DEBUG TRUE)
 include_directories("${CMAKE_SOURCE_DIR}/src/")
