diff --git a/src/mc/CMakeLists.txt b/src/mc/CMakeLists.txt
--- a/src/mc/CMakeLists.txt
+++ b/src/mc/CMakeLists.txt
@@ -1,10 +1,19 @@
 add_library(
   c10t-mc
   blocks.cpp
   level.cpp
   utils.cpp
   world.cpp
   region.cpp
 )

+# OHOS/Conan: link the version-consistent Boost.Filesystem static lib.
+# Host 1.91 libboost_filesystem.so exports the directory_options ABI while
+# the shadowed headers declare the 1.84 unsigned-int ABI, so filesystem
+# comes wholly from 1.84 (see top-level note). PUBLIC puts the archive
+# after the static convenience libs on the final link line.
+if(DEFINED C10T_BOOST_FS184_LIB AND EXISTS "${C10T_BOOST_FS184_LIB}")
+  target_link_libraries(c10t-mc PUBLIC "${C10T_BOOST_FS184_LIB}")
+endif()
+
 set_target_properties(c10t-mc PROPERTIES COMPILE_FLAGS "-O3 -Wall -pedantic -g")
