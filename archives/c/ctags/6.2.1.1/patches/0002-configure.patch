 # Create a (secure) tmp directory for tmp files.
-
-{
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
-  test -d "$tmp"
-}  ||
+#
+# OpenHarmony/HMDFS: 'mktemp -d' creates a 0700 directory whose owner is
+# the filesystem service account, so the calling user cannot write into
+# it.  chmod is an effective no-op on HMDFS and 'test -w' wrongly reports
+# the directory as writable.  Plain mkdir yields a group-writable
+# directory, so use that path.
 {
   tmp=./conf$$-$RANDOM
   (umask 077 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
