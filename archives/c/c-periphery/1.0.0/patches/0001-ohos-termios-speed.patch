diff --git a/src/serial.c b/src/serial.c
index bfa4a93..b3c1455 100644
--- a/src/serial.c
+++ b/src/serial.c
@@ -119,6 +119,24 @@ static int _serial_bits_to_baudrate(uint32_t bits) {
     }
 }
 
+static int _serial_set_termios_speed(struct termios *t, int baudrate_bits) {
+    if (baudrate_bits > 0) {
+        /* Standard rate: let cfset*() set both the CBAUD c_cflag bits and the
+         * ispeed/ospeed members portably - this avoids naming the baudrate
+         * members directly, which vary across libc implementations. */
+        if (cfsetispeed(t, (speed_t)baudrate_bits) < 0 ||
+            cfsetospeed(t, (speed_t)baudrate_bits) < 0)
+            return -1;
+        return 0;
+    }
+    /* Non-standard (custom) rate, e.g. 128000 / 135000: the portable POSIX
+     * termios API only accepts standard B* rates,
+     * so there is no platform-independent way to program an arbitrary rate.
+     * Fail explicitly instead of emitting a non-portable / non-POSIX write. */
+    (void)t;
+    return -2;
+}
+
 int serial_open(serial_t *serial, const char *path, uint32_t baudrate) {
     return serial_open_advanced(serial, path, baudrate, 8, PARITY_NONE, 1, false, false);
 }
@@ -188,14 +206,12 @@ int serial_open_advanced(serial_t *serial, const char *path, uint32_t baudrate,
 
     /* Baudrate */
     baudrate_bits = _serial_baudrate_to_bits(baudrate);
-    if (baudrate_bits > 0) {
