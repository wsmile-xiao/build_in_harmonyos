--- /dev/null
+++ b/ohos-compat.c
@@ -0,0 +1,365 @@
+/*
+ * Compatibility implementations for BSD libc helpers used by csh.
+ *
+ * The implementation is intentionally small and follows the documented
+ * OpenBSD interfaces.  It is compiled only as part of the csh package build.
+ */
+#include "ohos-compat.h"
+
+#include <ctype.h>
+#include <errno.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <string.h>
+
+size_t
+ohos_strlcpy(char *dst, const char *src, size_t dstsize)
+{
+    size_t len = strlen(src);
+    size_t copy = len;
+
+    if (dstsize == 0)
+        return len;
+    if (copy >= dstsize)
+        copy = dstsize - 1;
+    memcpy(dst, src, copy);
+    dst[copy] = '\0';
+    return len;
+}
+
+size_t
+ohos_strlcat(char *dst, const char *src, size_t dstsize)
+{
+    size_t dlen = 0;
+    size_t slen = strlen(src);
+    size_t copy;
+
+    while (dlen < dstsize && dst[dlen] != '\0')
+        dlen++;
+    if (dlen == dstsize)
+        return dstsize + slen;
+    copy = dstsize - dlen - 1;
+    if (copy > slen)
+        copy = slen;
+    memcpy(dst + dlen, src, copy);
+    dst[dlen + copy] = '\0';
+    return dlen + slen;
+}
+
+void *
+ohos_reallocarray(void *ptr, size_t nmemb, size_t size)
+{
+    if (nmemb != 0 && size > (size_t)-1 / nmemb) {
+        errno = ENOMEM;
+        return NULL;
+    }
+    return realloc(ptr, nmemb * size);
+}
+
+long long
+ohos_strtonum(const char *number, long long minval, long long maxval,
+    const char **errstrp)
+{
+    static const char invalid[] = "invalid";
+    static const char too_small[] = "too small";
+    static const char too_large[] = "too large";
+    char *end;
+    long long value;
+
+    if (errstrp != NULL)
+        *errstrp = NULL;
+    if (number == NULL) {
+        if (errstrp != NULL)
+            *errstrp = invalid;
+        return 0;
+    }
+    errno = 0;
+    end = NULL;
+    value = strtoll(number, &end, 10);
+    if (end == number || *end != '\0' || errno == ERANGE) {
+        if (errstrp != NULL)
+            *errstrp = invalid;
+        return 0;
+    }
+    if (value < minval) {
+        if (errstrp != NULL)
+            *errstrp = too_small;
+        return 0;
+    }
+    if (value > maxval) {
+        if (errstrp != NULL)
+            *errstrp = too_large;
+        return 0;
+    }
+    return value;
+}
+
+/*
+ * OpenBSD exposes short signal names through sys_signame.  OHOS exposes
+ * strsignal(), but its descriptions are not valid names for the csh kill
+ * builtin (for example, "Interrupt" is not the name "INT").  Keep the
+ * portable, non-alias signal names needed by that builtin locally.
+ */
+const char *
+ohos_sigabbrev(int signum)
+{
+    switch (signum) {
+#ifdef SIGHUP
+    case SIGHUP: return "HUP";
+#endif
+#ifdef SIGINT
+    case SIGINT: return "INT";
+#endif
+#ifdef SIGQUIT
+    case SIGQUIT: return "QUIT";
+#endif
+#ifdef SIGILL
+    case SIGILL: return "ILL";
+#endif
+#ifdef SIGTRAP
+    case SIGTRAP: return "TRAP";
+#endif
+#ifdef SIGABRT
+    case SIGABRT: return "ABRT";
+#endif
+#ifdef SIGBUS
+    case SIGBUS: return "BUS";
+#endif
+#ifdef SIGFPE
+    case SIGFPE: return "FPE";
+#endif
+#ifdef SIGKILL
+    case SIGKILL: return "KILL";
+#endif
+#ifdef SIGUSR1
+    case SIGUSR1: return "USR1";
+#endif
+#ifdef SIGSEGV
+    case SIGSEGV: return "SEGV";
+#endif
+#ifdef SIGUSR2
+    case SIGUSR2: return "USR2";
+#endif
+#ifdef SIGPIPE
+    case SIGPIPE: return "PIPE";
+#endif
+#ifdef SIGALRM
+    case SIGALRM: return "ALRM";
+#endif
+#ifdef SIGTERM
+    case SIGTERM: return "TERM";
+#endif
+#ifdef SIGCHLD
+    case SIGCHLD: return "CHLD";
+#endif
+#ifdef SIGCONT
+    case SIGCONT: return "CONT";
+#endif
+#ifdef SIGSTOP
+    case SIGSTOP: return "STOP";
+#endif
+#ifdef SIGTSTP
+    case SIGTSTP: return "TSTP";
+#endif
+#ifdef SIGTTIN
+    case SIGTTIN: return "TTIN";
+#endif
+#ifdef SIGTTOU
+    case SIGTTOU: return "TTOU";
+#endif
+#ifdef SIGURG
+    case SIGURG: return "URG";
+#endif
+#ifdef SIGXCPU
+    case SIGXCPU: return "XCPU";
+#endif
+#ifdef SIGXFSZ
+    case SIGXFSZ: return "XFSZ";
+#endif
+#ifdef SIGVTALRM
+    case SIGVTALRM: return "VTALRM";
+#endif
+#ifdef SIGPROF
+    case SIGPROF: return "PROF";
+#endif
+#ifdef SIGWINCH
+    case SIGWINCH: return "WINCH";
+#endif
+#ifdef SIGIO
+    case SIGIO: return "IO";
+#endif
+#ifdef SIGPWR
+    case SIGPWR: return "PWR";
+#endif
+#ifdef SIGSYS
+    case SIGSYS: return "SYS";
+#endif
+    default:
+        return NULL;
+    }
+}
+
+static int
+ohos_isvisible(int c, int flags)
+{
+    unsigned char uc = (unsigned char)c;
+    int vis_all = flags & VIS_ALL;
+    int vis_glob = flags & VIS_GLOB;
+
+    if (c == '\\' || !vis_all) {
+        if (uc < 0x80 && isgraph(uc) &&
+            ((c != '*' && c != '?' && c != '[' && c != '#') || !vis_glob))
+            return 1;
+        if (!(flags & VIS_SP) && c == ' ')
+            return 1;
+        if (!(flags & VIS_TAB) && c == '\t')
+            return 1;
+        if (!(flags & VIS_NL) && c == '\n')
+            return 1;
+        if ((flags & VIS_SAFE) &&
+            (c == '\b' || c == '\a' || c == '\r' || isgraph(uc)))
+            return 1;
+    }
+    return 0;
+}
+
+static int
+ohos_isoctal(int c)
+{
+    unsigned char uc = (unsigned char)c;
+    return uc >= '0' && uc <= '7';
+}
+
+char *
+ohos_vis(char *dst, int c, int flags, int nextc)
+{
+    int no_slash = flags & VIS_NOSLASH;
+
+    if (ohos_isvisible(c, flags)) {
+        if ((c == '"' && (flags & VIS_DQ)) || (c == '\\' && !no_slash))
+            *dst++ = '\\';
+        *dst++ = (char)c;
+        *dst = '\0';
+        return dst;
+    }
+
+    if (flags & VIS_CSTYLE) {
+        const char *escape = NULL;
+        switch (c) {
+        case '\n': escape = "n"; break;
+        case '\r': escape = "r"; break;
+        case '\b': escape = "b"; break;
+        case '\a': escape = "a"; break;
+        case '\v': escape = "v"; break;
+        case '\t': escape = "t"; break;
+        case '\f': escape = "f"; break;
+        case ' ':  escape = "s"; break;
+        case '\0':
+            *dst++ = '\\';
+            *dst++ = '0';
+            if (ohos_isoctal(nextc)) {
+                *dst++ = '0';
+                *dst++ = '0';
+            }
+            goto done;
+        default: break;
+        }
+        if (escape != NULL) {
+            *dst++ = '\\';
+            *dst++ = escape[0];
+            goto done;
+        }
+    }
+
+    if (((c & 0177) == ' ') || (flags & VIS_OCTAL) ||
+        ((flags & VIS_GLOB) &&
+         (c == '*' || c == '?' || c == '[' || c == '#'))) {
+        *dst++ = '\\';
+        *dst++ = ((unsigned char)c >> 6 & 07) + '0';
+        *dst++ = ((unsigned char)c >> 3 & 07) + '0';
+        *dst++ = ((unsigned char)c & 07) + '0';
+        goto done;
+    }
+
+    if (!no_slash)
+        *dst++ = '\\';
+    if (c & 0200) {
+        c &= 0177;
+        *dst++ = 'M';
+    }
+    if (iscntrl((unsigned char)c)) {
+        *dst++ = '^';
+        *dst++ = c == 0177 ? '?' : (char)(c + '@');
+    } else {
+        *dst++ = '-';
+        *dst++ = (char)c;
+    }
+
+done:
+    *dst = '\0';
+    return dst;
+}
+
+int
+ohos_strvis(char *dst, const char *src, int flags)
+{
+    char *start = dst;
+    int c;
+
+    while ((c = (unsigned char)*src) != '\0') {
+        dst = ohos_vis(dst, c, flags, (unsigned char)src[1]);
+        src++;
+    }
+    *dst = '\0';
+    return (int)(dst - start);
+}
+
+int
+ohos_strnvis(char *dst, const char *src, size_t size, int flags)
+{
+    char *start = dst;
+    char *end;
+    char tmp[5];
+    int c;
+    int encoded = 0;
+
+    if (size == 0)
+        return 0;
+    end = start + size - 1;
+    while ((c = (unsigned char)*src) != '\0' && dst < end) {
+        if (ohos_isvisible(c, flags)) {
+            if ((c == '"' && (flags & VIS_DQ)) ||
+                (c == '\\' && !(flags & VIS_NOSLASH))) {
+                if (dst + 1 >= end) {
+                    encoded = 2;
+                    break;
+                }
+                *dst++ = '\\';
+            }
+            encoded = 1;
+            *dst++ = (char)c;
+            src++;
+        } else {
+            int n = (int)(ohos_vis(tmp, c, flags,
+                (unsigned char)src[1]) - tmp);
+            encoded = n;
+            if (dst + n <= end) {
+                memcpy(dst, tmp, (size_t)n);
+                dst += n;
+                src++;
+            } else {
+                break;
+            }
+        }
+    }
+    *dst = '\0';
+    if (dst + encoded > end) {
+        while (*src != '\0') {
+            dst += ohos_vis(tmp, (unsigned char)*src, flags,
+                (unsigned char)src[1]) - tmp;
+            src++;
+        }
+    }
+    return (int)(dst - start);
+}
