+        void get(std::istream& in, Timespan& ts, uint64_t res)
+        {
+            // OHOS libc++ portability: `in >> double` leaves the stream
+            // in fail state for a trailing 'd' (Days suffix) while the
+            // 'u'/'ms'/'s'/'m'/'mi'/'h' suffixes parse fine, so only the
+            // "823d" case of istreamunits fails. The SI path for the same
+            // values uses cxxtools::getFloat (which accepts only 'e'/'E'
+            // as exponent) and handles 'd' correctly, so parse the
+            // iostream token the same way instead of relying on the
+            // stdlib double extractor. Behaviour for all previously
+            // passing inputs is unchanged; the whole token is consumed
+            // via `in >> token`, leaving the stream good as before.
+            std::string token;
+            in >> token;
+            if (!in)
+                return;
+            bool ok = false;
+            double value = 0;
+            std::string::const_iterator end = getFloat(token.begin(), token.end(), ok, value);
+            if (!ok)
+            {
+                in.setstate(std::ios::failbit);
+                return;
+            }
+            std::string::size_type pos = end - token.begin();
+            std::string suffix = token.substr(pos);
+            if (suffix == "u")
+            {
+                ts = Microseconds(value);
+                return;
+            }
+            else if (suffix == "ms")
+            {
+                ts = Milliseconds(value);
+                return;
+            }
+            else if (suffix == "mi" || suffix == "m")
+            {
+                ts = Minutes(value);
+                return;
+            }
+            else if (suffix == "s")
+            {
+                ts = Seconds(value);
+                return;
+            }
+            else if (suffix == "h")
+            {
+                ts = Hours(value);
+                return;
+            }
+            else if (suffix == "d")
+            {
+                ts = Days(value);
+                return;
+            }
+            else if (suffix.empty())
+            {
+                ts = Timespan(value * res);
+                return;
+            }
+            ts = Timespan(value * res);
+        }
