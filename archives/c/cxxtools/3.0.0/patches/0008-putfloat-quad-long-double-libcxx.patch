+// OHOS libc++ portability (quad long double): on ARM64 long double is IEEE
+// binary128 (digits10=33) while upstream only validated 80-bit/64-bit
+// paths. The generic log10/pow/division algorithm accumulates
+// binary-decimal error over 32 digits and emits trailing garbage
+// (e.g. 48.<garbage>) so convert<long double>(48-string) != 48 while the
+// brief reporter prints both sides as 48 (default 6-digit ostream).
+// Use libc correctly-rounded conversion instead; float/double keep the
+// generic path unchanged.
+template <typename OutIterT>
+inline OutIterT putFloat(OutIterT it, long double value)
+{
+    const int precision = std::numeric_limits<long double>::digits10 - 1;
+    char buf[128];
+    int n = std::snprintf(buf, sizeof(buf), "%.*Lg", precision, value);
+    if (n < 0 || n >= static_cast<int>(sizeof(buf)))
+    {
+        FloatFormat<char> fmt;
+        return putFloat(it, value, fmt, precision);
+    }
+    for (int i = 0; i < n; ++i)
+        *it++ = buf[i];
+    return it;
+}
