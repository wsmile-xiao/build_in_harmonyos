 const std::string tmpFileName = "file-test.tmp";
 const std::string tmpFileName2 = "file-test-2.tmp";
+
+// Probe whether the current directory supports hardlinks, using raw
+// ::link() directly so a bug in cxxtools::File::link can never be masked
+// as "unsupported". Returns true when hardlinks work (or when the probe
+// itself cannot run, so the original error is rethrown instead of hidden).
+static bool hardlinksSupported()
+{
+    const char* probe = "file-test-hardlink-probe.tmp";
+    const char* probe2 = "file-test-hardlink-probe-2.tmp";
+    ::unlink(probe);
+    ::unlink(probe2);
+    int fd = ::open(probe, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    if (fd < 0)
+        return true;
+    ::close(fd);
+    bool ok = (::link(probe, probe2) == 0);
+    ::unlink(probe);
+    ::unlink(probe2);
+    return ok;
+}
 
 class FileTest : public cxxtools::unit::TestSuite
 {
