diff --git a/cmd_cdcd.c b/cmd_cdcd.c
--- a/cmd_cdcd.c
+++ b/cmd_cdcd.c
@@ -1266,7 +1266,14 @@
 void
 cmd_cdcd_mainloop ()
 {
+#if defined(RL_READLINE_VERSION) && (RL_READLINE_VERSION >= 0x0600)
+  /* readline >= 6 removed the CPPFunction typedef; rl_completion_func_t is
+     the modern equivalent (const char * first parameter -- the explicit
+     cast keeps the original char * signature working).  */
+  rl_attempted_completion_function = (rl_completion_func_t *) cdcd_completion;
+#else
   rl_attempted_completion_function = (CPPFunction *) cdcd_completion;
+#endif
   cmd_mainloop (&cdcd_command_matcher, "cdcd> ", cmds);
 }
 
