--- a/src/cairo-misc.c
+++ b/src/cairo-misc.c
@@ -51,6 +51,9 @@
 #if HAVE_FCNTL_H
 #include <fcntl.h>
 #endif
+#if HAVE_UNISTD_H
+#include <unistd.h>
+#endif
 
 COMPILE_TIME_ASSERT ((int)CAIRO_STATUS_LAST_STATUS < (int)CAIRO_INT_STATUS_UNSUPPORTED);
 COMPILE_TIME_ASSERT (CAIRO_INT_STATUS_LAST_STATUS <= 127);
@@ -1092,6 +1095,31 @@
     /* Fallback */
 #endif /* O_TMPFILE */
 
+    /* If O_TMPFILE fails (e.g. EOPNOTSUPP on OHOS), try mkstemp in TMPDIR */
+    {
+	const char *tmpdir = getenv("TMPDIR");
+	const char *dir = (tmpdir && tmpdir[0] != '\0') ? tmpdir : P_tmpdir;
+	char *template;
+	int mkfd;
+
+	template = malloc (strlen (dir) + 32);
+	if (template) {
+	    sprintf (template, "%s/cairo-tmp-XXXXXX", dir);
+	    mkfd = mkstemp (template);
+	    if (mkfd != -1) {
+		unlink (template);
+		free (template);
+		file = fdopen (mkfd, "wb+");
+		if (file != NULL)
+		    return file;
+		close (mkfd);
+	    } else {
+		free (template);
+	    }
+	}
+    }
+
+    /* Last resort: tmpfile() (may fail on read-only /tmp) */
     file = tmpfile();
 
 #if defined(HAVE_FCNTL_H) && defined(FD_CLOEXEC)
