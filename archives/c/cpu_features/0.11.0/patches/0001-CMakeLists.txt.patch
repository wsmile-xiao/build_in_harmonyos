+  # Use an external GoogleTest (provided by Conan) instead of downloading
+  # googletest from GitHub at configure time (GitHub is unreachable on the
+  # OHOS CI network).  Map the bare gtest/gmock_main target names that the
+  # test suite links against onto the namespaced targets exported by the
+  # Conan gtest package.
+  find_package(GTest CONFIG REQUIRED)
+  if(NOT TARGET gtest)
+    add_library(gtest INTERFACE IMPORTED)
+    set_target_properties(gtest PROPERTIES INTERFACE_LINK_LIBRARIES GTest::gtest)
+  endif()
+  if(NOT TARGET gmock_main)
+    add_library(gmock_main INTERFACE IMPORTED)
+    set_target_properties(gmock_main PROPERTIES INTERFACE_LINK_LIBRARIES GTest::gmock_main)
