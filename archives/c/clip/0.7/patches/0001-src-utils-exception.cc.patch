diff -ruN a/src/utils/exception.cc b/src/utils/exception.cc
--- a/src/utils/exception.cc
+++ b/src/utils/exception.cc
@@ -70,23 +70,25 @@
 Exception Exception::setTypeName(const char* type_name) {
   type_name_ = type_name;
