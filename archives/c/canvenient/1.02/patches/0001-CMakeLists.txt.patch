--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,54 +1,76 @@
 cmake_minimum_required(VERSION 3.16)
 project(CANvenient C)
 
 set(PROJECT_VERSION "1.0.1")
 set(PROJECT_VERSION_MAJOR "1")
 
 include(${CMAKE_ROOT}/Modules/ExternalProject.cmake)
 
 set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
 
+# OHOS adaptation: the upstream build links the external "socketcan" library
+# (libsocketcan), which is not published to the ohpcd registry.  Its single
+# used symbol, can_set_bitrate(), is provided by the vendored copy under
+# deps/libsocketcan (LGPL-2.1, https://github.com/linux-can/libsocketcan),
+# compiled directly into the CANvenient target so no external dependency is
+# required.
+# NOTE: use NOT WIN32 instead of UNIX: the OHOS CMake profile sets
+# CMAKE_SYSTEM_NAME=HarmonyOS, for which CMake leaves UNIX=OFF, while the
+# SocketCAN driver is still compiled (guarded by __linux__, which OHOS clang
+# defines).
+if(NOT WIN32)
+  set(CANVENIENT_EXTRA_SOURCES
+    ${CMAKE_CURRENT_SOURCE_DIR}/deps/libsocketcan/src/libsocketcan.c
+  )
+else()
+  set(CANVENIENT_EXTRA_SOURCES "")
+endif()
+
 add_library(
   ${PROJECT_NAME}
   SHARED
   ${CMAKE_CURRENT_SOURCE_DIR}/src/CANvenient.c
   ${CMAKE_CURRENT_SOURCE_DIR}/src/drivers/CANvenient_Ixxat.c
   ${CMAKE_CURRENT_SOURCE_DIR}/src/drivers/CANvenient_Kvaser.c
   ${CMAKE_CURRENT_SOURCE_DIR}/src/drivers/CANvenient_PEAK.c
   ${CMAKE_CURRENT_SOURCE_DIR}/src/drivers/CANvenient_SocketCAN.c
   ${CMAKE_CURRENT_SOURCE_DIR}/src/drivers/CANvenient_Softing.c
+  ${CANVENIENT_EXTRA_SOURCES}
 )
 
 set_property(TARGET ${PROJECT_NAME} PROPERTY C_STANDARD 99)
+
+if(NOT WIN32)
+  target_include_directories(${PROJECT_NAME} PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/deps/libsocketcan/include
+  )
+endif()
+
 include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/deps.cmake)
 
 target_link_libraries(
   ${PROJECT_NAME}
   PRIVATE
   ${PLATFORM_LIBS}
 )
 
 if(WIN32 AND MSVC)
   # Ensure the library can be loaded without vciapi.dll present.
   # vciapi.dll will only be loaded when an Ixxat (VCI) function is called.
   target_link_options(${PROJECT_NAME} PRIVATE /DELAYLOAD:vciapi.dll)
   target_link_libraries(${PROJECT_NAME} PRIVATE delayimp)
 endif()
 
-if(UNIX)
-  target_link_libraries(
-    ${PROJECT_NAME}
-    PRIVATE
-    socketcan
-  )
-
+if(NOT WIN32)
+  # libsocketcan is compiled into the target (see CANVENIENT_EXTRA_SOURCES);
+  # no external "socketcan" link target is required on OHOS.
   set_target_properties(
     ${PROJECT_NAME}
     PROPERTIES VERSION ${PROJECT_VERSION} SOVERSION ${PROJECT_VERSION_MAJOR})
 endif()
 
 if (CMAKE_C_COMPILER_ID STREQUAL "MSVC")
   target_compile_options(
     ${PROJECT_NAME}
     PUBLIC
     /W4
