+/*
+ * OHOS/bionic adaptation (minimal):
+ * - _GNU_SOURCE makes <net/if.h> expose struct ifreq and the IFF_* constants.
+ * - <sys/socket.h> must be included BEFORE <linux/can.h>: the kernel header
+ *   <linux/socket.h> (pulled in by <linux/can.h>) redefines struct
+ *   sockaddr_storage, which collides with the bionic definition in
+ *   <sys/socket.h>.
+ * - <linux/socket.h> only defines the __kernel_sa_family_t type, not the
+ *   struct, when it is skipped; pre-declare the type so <linux/can.h>
+ *   (struct sockaddr_can) still compiles.
+ */
+#define _GNU_SOURCE
+#include <sys/socket.h>
+#include <sys/time.h>
+#ifndef __kernel_sa_family_t_defined
+#define __kernel_sa_family_t_defined
+typedef unsigned short __kernel_sa_family_t;
+#endif
+#define _UAPI_LINUX_SOCKET_H
