+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
@@ -17744,5 +17744,5 @@
 cat >>$CONFIG_STATUS <<_ACEOF || ac_write_fail=1
