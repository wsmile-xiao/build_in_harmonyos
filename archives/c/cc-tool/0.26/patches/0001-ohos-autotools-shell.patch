+  ECHO='printf %s\n'
 elif test "X`printf %s $ECHO 2>/dev/null`" = "X$ECHO"; then
@@ -17687,9 +17687,9 @@
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
