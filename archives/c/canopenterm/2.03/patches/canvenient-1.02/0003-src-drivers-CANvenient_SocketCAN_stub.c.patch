--- a/src/drivers/CANvenient_SocketCAN_stub.c	1970-01-01 08:00:00.000000000 +0800
+++ b/src/drivers/CANvenient_SocketCAN_stub.c	2026-09-13 12:37:36.186577812 +0800
@@ -0,0 +1,68 @@
+/** @file CANvenient_SocketCAN_stub.c
+ *
+ *  HarmonyOS (OpenHarmony) does not provide the Linux SocketCAN stack
+ *  (no /dev/socketcan, no linux/can.h, no libsocketcan). The SocketCAN
+ *  driver is therefore replaced by a stub that satisfies the 7 hard
+ *  references from CANvenient.c while reporting that no CAN interface
+ *  is available. All other CAN vendors (Ixxat/Kvaser/PEAK/Softing)
+ *  remain Windows-only and are no-ops off Windows.
+ *
+ *  Copyright (c) 2026, Michael Fitzmayer. All rights reserved.
+ *  SPDX-License-Identifier: MIT
+ *
+ **/
+
+#include "CANvenient.h"
+#include "CANvenient_internal.h"
+
+int socketcan_find_interfaces(void)
+{
+    return 0;
+}
+
+int socketcan_open(int index)
+{
+    if (index < 0 || index >= CAN_MAX_INTERFACES)
+    {
+        set_error_reason("Channel index is out-of-range.");
+        return -1;
+    }
+
+    set_error_reason("SocketCAN is not available on HarmonyOS.");
+    return -1;
+}
+
+void socketcan_close(int index)
+{
+    if (index < 0 || index >= CAN_MAX_INTERFACES)
+    {
+        return;
+    }
+
+    can_interface[index].opened = 0;
+}
+
+int socketcan_update(int index)
+{
+    return 0;
+}
+
+int socketcan_set_baudrate(int index, enum can_baudrate baud)
+{
+    (void)baud;
+    return 0;
+}
+
+int socketcan_send(int index, const struct can_frame* frame)
+{
+    (void)frame;
+    set_error_reason("SocketCAN is not available on HarmonyOS.");
+    return -1;
+}
+
+int socketcan_recv(int index, struct can_frame* frame, u64* timestamp)
+{
+    (void)frame;
+    (void)timestamp;
+    return 0;
+}
