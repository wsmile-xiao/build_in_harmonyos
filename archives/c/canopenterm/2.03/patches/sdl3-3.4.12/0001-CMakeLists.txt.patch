--- a/CMakeLists.txt	2026-07-02 00:20:42.000000000 +0800
+++ b/CMakeLists.txt	2026-09-13 00:54:02.903518750 +0800
@@ -128,14 +128,25 @@
 # Get the platform
 SDL_DetectCMakePlatform()
 
+# HarmonyOS platform detection
+if(CMAKE_SYSTEM_NAME MATCHES "HarmonyOS|OpenHarmony")
+  set(OHOS TRUE)
+  add_definitions(-DSDL_PLATFORM_OHOS)
+  # HarmonyOS does not support Gtk tray
+  set(SDL_TRAY OFF CACHE BOOL "Disable tray on HarmonyOS" FORCE)
+endif()
+
 # Don't mistake macOS for unix
 if(UNIX AND NOT ANDROID AND NOT APPLE AND NOT RISCOS)
   set(UNIX_SYS ON)
+elseif(OHOS)
+  # HarmonyOS is a Unix-like system
+  set(UNIX_SYS ON)
 else()
   set(UNIX_SYS OFF)
 endif()
 
-if(UNIX OR APPLE)
+if(UNIX OR APPLE OR OHOS)
   set(UNIX_OR_MAC_SYS ON)
 else()
   set(UNIX_OR_MAC_SYS OFF)
