--- a/cmake/patch_sdl3.cmake	1970-01-01 08:00:00.000000000 +0800
+++ b/cmake/patch_sdl3.cmake	2026-09-13 14:48:55.947999062 +0800
@@ -0,0 +1,45 @@
+cmake_minimum_required(VERSION 3.16)
+
+# Apply the OHOS/HarmonyOS patches to the freshly-downloaded SDL3 source.
+# Invoked from the SDL3 ExternalProject PATCH_COMMAND:
+#   PATCH_COMMAND ${CMAKE_COMMAND} -DSRC_DIR=<SOURCE_DIR> -P <this file>
+if(NOT DEFINED SRC_DIR)
+  message(FATAL_ERROR "SRC_DIR is not defined")
+endif()
+
+set(PATCH_DIR ${CMAKE_CURRENT_LIST_DIR}/../patches/sdl3-3.4.12)
+
+set(PATCHES
+  0001-CMakeLists.txt.patch
+  0002-include-SDL3-SDL_platform_defines.h.patch
+  0003-src-SDL.c.patch
+  0004-src-thread-pthread-SDL_systhread.c.patch)
+
+# Idempotent (see DRAFT-8959): PATCH_COMMAND can re-run in an incremental
+# build, and the minimal OHOS toolchain `patch` has no -N. For each patch,
+# probe with a reverse dry-run; if it would succeed the patch is already
+# present, so skip the forward apply instead of failing on an already-applied
+# hunk.
+# Idempotent (see DRAFT-8959): PATCH_COMMAND can re-run in an incremental
+# build, and the minimal OHOS toolchain `patch` has no -N. For each patch,
+# probe with a reverse dry-run; if it would succeed the patch is already
+# present, so skip the forward apply instead of failing on an already-applied
+# hunk.
+foreach(p ${PATCHES})
+  execute_process(
+    COMMAND patch -p1 -d ${SRC_DIR} -R --dry-run -i ${PATCH_DIR}/${p}
+    RESULT_VARIABLE probe OUTPUT_QUIET ERROR_QUIET)
+  if(probe EQUAL 0)
+    message(STATUS "SDL3 patch already applied (skipped): ${p}")
+  else()
+    execute_process(
+      COMMAND patch -p1 -d ${SRC_DIR} -i ${PATCH_DIR}/${p}
+      RESULT_VARIABLE rc
+      OUTPUT_VARIABLE out
+      ERROR_VARIABLE err)
+    if(NOT rc EQUAL 0)
+      message(FATAL_ERROR "SDL3 patch ${p} failed (rc=${rc}):\n${out}\n${err}")
+    endif()
+    message(STATUS "SDL3 patch applied: ${p}")
+  endif()
+endforeach()
