--- a/cmake/patch_cmocka.cmake	2026-07-03 02:31:51.000000000 +0800
+++ b/cmake/patch_cmocka.cmake	2026-09-13 16:37:02.303998905 +0800
@@ -9,3 +9,27 @@
 string(REPLACE "                \"\${cmocka_SOURCE_DIR}/compile_commands.json\"" "#                \"\${cmocka_SOURCE_DIR}/compile_commands.json\"" _contents "${_contents}")
 string(REPLACE "execute_process(COMMAND cmake -E create_symlink" "# execute_process(COMMAND cmake -E create_symlink" _contents "${_contents}")
 file(WRITE "${CMocka_PATH}/CMakeLists.txt" "${_contents}")
+
+# OHOS: cmocka.h would re-define uintptr_t (its __WORDSIZE heuristic only
+# knows x86_64/sparc, so aarch64 is assumed 32-bit) and clash with the
+# already-defined OHOS newlib uintptr_t when consumers include it. Apply the
+# guard patch so the redefinition is skipped on aarch64.
+#
+# Idempotent (see DRAFT-8959): the minimal OHOS toolchain `patch` has no -N,
+# so probe with a reverse dry-run and skip the forward apply if the patch is
+# already present.
+set(_cmocka_patch ${CMAKE_CURRENT_LIST_DIR}/../patches/cmocka-1.1.7/0001-include-cmocka.h.patch)
+execute_process(
+  COMMAND patch -p1 -d ${CMocka_PATH} -R --dry-run -i ${_cmocka_patch}
+  RESULT_VARIABLE _probe OUTPUT_QUIET ERROR_QUIET)
+if(_probe EQUAL 0)
+  message(STATUS "cmocka patch already applied (skipped): 0001-include-cmocka.h.patch")
+else()
+  execute_process(
+    COMMAND patch -p1 -d ${CMocka_PATH} -i ${_cmocka_patch}
+    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
+  if(NOT _rc EQUAL 0)
+    message(FATAL_ERROR "cmocka.h patch failed (rc=${_rc}):\n${_out}\n${_err}")
+  endif()
+  message(STATUS "cmocka patch applied: 0001-include-cmocka.h.patch")
+endif()
