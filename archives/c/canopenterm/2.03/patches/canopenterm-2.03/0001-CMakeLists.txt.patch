--- a/CMakeLists.txt	2026-07-03 02:31:51.000000000 +0800
+++ b/CMakeLists.txt	2026-09-13 12:51:59.042578281 +0800
@@ -9,16 +9,32 @@
 option(ENABLE_ADDRESS_SANITIZER "Enable address sanitizer (Clang)"     OFF)
 option(ENABLE_VALGRIND_SUPPORT  "Build with Valgrind support"          OFF)
 
+# HarmonyOS/OpenHarmony cross-compilation
+if(CMAKE_SYSTEM_NAME MATCHES "HarmonyOS|OpenHarmony")
+  set(OHOS TRUE)
+endif()
+
+# icon.rc is a Windows resource script that the resource compiler ignores on
+# non-Windows platforms; on HarmonyOS it is omitted to avoid an unbuildable
+# resource target.
+if(OHOS)
+  set(CONSOLE_ICON "")
+else()
+  set(CONSOLE_ICON ${CMAKE_CURRENT_SOURCE_DIR}/src/icon.rc)
+endif()
+
 add_executable(
   ${PROJECT_NAME}
-  ${CMAKE_CURRENT_SOURCE_DIR}/src/main.c ${CMAKE_CURRENT_SOURCE_DIR}/src/icon.rc
+  ${CMAKE_CURRENT_SOURCE_DIR}/src/main.c
+  ${CONSOLE_ICON}
 )
 
 include(${CMAKE_ROOT}/Modules/ExternalProject.cmake)
 
 if(WIN32)
   set(PLATFORM "windows")
-elseif(UNIX)
+elseif(UNIX OR OHOS)
+  # HarmonyOS uses the same POSIX/SDL "linux" platform sources.
   set(PLATFORM "linux")
 
   if (ENABLE_VALGRIND_SUPPORT)
