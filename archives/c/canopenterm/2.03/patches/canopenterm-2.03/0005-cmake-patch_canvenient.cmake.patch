--- a/cmake/patch_canvenient.cmake	1970-01-01 08:00:00.000000000 +0800
+++ b/cmake/patch_canvenient.cmake	2026-09-13 14:48:55.947999062 +0800
@@ -0,0 +1,43 @@
+cmake_minimum_required(VERSION 3.16)
+
+# Apply the OHOS/HarmonyOS patches to the freshly-downloaded CANvenient source.
+# Invoked from the CANvenient ExternalProject PATCH_COMMAND:
+#   PATCH_COMMAND ${CMAKE_COMMAND} -DSRC_DIR=<SOURCE_DIR> -P <this file>
+if(NOT DEFINED SRC_DIR)
+  message(FATAL_ERROR "SRC_DIR is not defined")
+endif()
+
+set(PATCH_DIR ${CMAKE_CURRENT_LIST_DIR}/../patches/canvenient-1.02)
+
+set(PATCHES
+  0002-CMakeLists.txt.patch
+  0003-src-drivers-CANvenient_SocketCAN_stub.c.patch)
+
+# Idempotent (see DRAFT-8959): PATCH_COMMAND can re-run in an incremental
+# build, and the minimal OHOS toolchain `patch` has no -N. For each patch,
+# probe with a reverse dry-run; if it would succeed the patch is already
+# present, so skip the forward apply instead of failing on an already-applied
+# hunk.
+# Idempotent (see DRAFT-8959): PATCH_COMMAND can re-run in an incremental
+# build, and the minimal OHOS toolchain `patch` has no -N. For each patch,
+# probe with a reverse dry-run; if it would succeed the patch is already
+# present, so skip the forward apply instead of failing on an already-applied
+# hunk.
+foreach(p ${PATCHES})
+  execute_process(
+    COMMAND patch -p1 -d ${SRC_DIR} -R --dry-run -i ${PATCH_DIR}/${p}
+    RESULT_VARIABLE probe OUTPUT_QUIET ERROR_QUIET)
+  if(probe EQUAL 0)
+    message(STATUS "CANvenient patch already applied (skipped): ${p}")
+  else()
+    execute_process(
+      COMMAND patch -p1 -d ${SRC_DIR} -i ${PATCH_DIR}/${p}
+      RESULT_VARIABLE rc
+      OUTPUT_VARIABLE out
+      ERROR_VARIABLE err)
+    if(NOT rc EQUAL 0)
+      message(FATAL_ERROR "CANvenient patch ${p} failed (rc=${rc}):\n${out}\n${err}")
+    endif()
+    message(STATUS "CANvenient patch applied: ${p}")
+  endif()
+endforeach()
