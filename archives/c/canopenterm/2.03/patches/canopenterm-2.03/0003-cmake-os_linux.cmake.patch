 set(CJSON_INCLUDE_DIR ${CJSON_PATH})
-set(CJSON_LIBRARY     ${CJSON_PATH}_build/libcjson.so.${CJSON_VERSION})
+if(OHOS)
+  # HarmonyOS cross builds do not produce cJSON's versioned soname
+  # symlinks (libcjson.so.1.7.19); only the unversioned libcjson.so
+  # exists, so reference it directly and build it unversioned below.
+  set(CJSON_LIBRARY ${CJSON_PATH}_build/libcjson.so)
+  set(CJSON_OHOS_ARGS
+    -DENABLE_CUSTOM_COMPILER_FLAGS=OFF
+    -DENABLE_CJSON_VERSION_SO=OFF
+    -DCMAKE_SHARED_LINKER_FLAGS=-Wl,-soname,libcjson.so)
+else()
+  # Linux native keeps cJSON's defaults: versioned libcjson.so.1.7.19 with
+  # soname libcjson.so.1, matching CJSON_LIBRARY above.
+  set(CJSON_LIBRARY ${CJSON_PATH}_build/libcjson.so.${CJSON_VERSION})
+  set(CJSON_OHOS_ARGS "")
+endif()
 
