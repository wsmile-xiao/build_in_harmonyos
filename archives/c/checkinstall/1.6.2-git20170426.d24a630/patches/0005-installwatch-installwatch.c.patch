+/* ==================== musl (OHOS) standard-symbol interposers ====================
+ * glibc implements stat() as forwarding to the versioned __xstat(_STAT_VER,...);
+ * installwatch therefore exports __xstat/__lxstat/__xmknod/__fxstatat/__xmknodat
+ * to interpose them.  musl has NO versioned stat ABI - apps call stat/lstat/mknod
+ * (and fstatat/mknodat) directly.  We must export those public names (no version
+ * argument) so LD_PRELOAD interception keeps working under musl.
+ */
+#if !defined(__GLIBC__)
+
+int stat(const char *pathname, struct stat *info)
+{
+	int result;
+	instw_t instw;
+	int status;
+
+	if (!libc_handle)
+		initialize();
+
+	if (!(__instw.gstatus & INSTW_INITIALIZED) ||
+	    !(__instw.gstatus & INSTW_OKWRAP)) {
+		return true_statfn(pathname, info);
+	}
+
+	instw_new(&instw);
+	instw_setpath(&instw, pathname);
+	instw_getstatus(&instw, &status);
+
+	if (status & INSTW_TRANSLATED) {
+		result = true_statfn(instw.translpath, info);
+	} else {
+		result = true_statfn(instw.path, info);
+	}
+	instw_delete(&instw);
+	return result;
+}
+
+int lstat(const char *pathname, struct stat *info)
+{
+	int result;
+	instw_t instw;
+	int status;
+
+	if (!libc_handle)
+		initialize();
+
+	if (!(__instw.gstatus & INSTW_INITIALIZED) ||
+	    !(__instw.gstatus & INSTW_OKWRAP)) {
+		return true_lstatfn(pathname, info);
+	}
+
+	instw_new(&instw);
+	instw_setpath(&instw, pathname);
+	instw_getstatus(&instw, &status);
+
+	if (status & INSTW_TRANSLATED) {
+		result = true_lstatfn(instw.translpath, info);
+	} else {
+		result = true_lstatfn(instw.path, info);
+	}
+	instw_delete(&instw);
+	return result;
+}
+
+int mknod(const char *pathname, mode_t mode, dev_t dev)
+{
+	int result;
+	instw_t instw;
+
+	if (!libc_handle)
+		initialize();
+
+	if (!(__instw.gstatus & INSTW_INITIALIZED) ||
+	    !(__instw.gstatus & INSTW_OKWRAP)) {
+		return true_mknodfn(pathname, mode, dev);
+	}
+
+	instw_new(&instw);
+	instw_setpath(&instw, pathname);
+	instw_apply(&instw);
+
+	result = true_mknodfn(instw.translpath, mode, dev);
+
+	instw_delete(&instw);
+	return result;
+}
+
+int fstatat(int dirfd, const char *path, struct stat *s, int flags)
+{
+	int result;
+	instw_t instw;
+
+	if (dirfd == AT_FDCWD || *path == '/') {
+		if (flags & AT_SYMLINK_NOFOLLOW)
+			return true_lstatfn(path, s);
+		else
+			return true_statfn(path, s);
+	}
+
+	if (!libc_handle)
+		initialize();
+
+	if (!(__instw.gstatus & INSTW_INITIALIZED) ||
+	    !(__instw.gstatus & INSTW_OKWRAP)) {
+		if (flags & AT_SYMLINK_NOFOLLOW)
+			return true_lstatfn(path, s);
+		else
+			return true_statfn(path, s);
+	}
+
+	instw_new(&instw);
+	instw_setpathrel(&instw, dirfd, path);
+
+	if (flags & AT_SYMLINK_NOFOLLOW)
+		result = true_lstatfn(instw.path, s);
+	else
+		result = true_statfn(instw.path, s);
+
+	instw_delete(&instw);
+	return result;
+}
+
+int mknodat(int dirfd, const char *path, mode_t mode, dev_t dev)
+{
+	int result;
+	instw_t instw;
+
+	if (!libc_handle)
+		initialize();
+
+	if (!(__instw.gstatus & INSTW_INITIALIZED) ||
+	    !(__instw.gstatus & INSTW_OKWRAP)) {
+		return true_mknodatfn(dirfd, path, mode, dev);
+	}
+
+	instw_new(&instw);
+	instw_setpathrel(&instw, dirfd, path);
+
+	result = true_mknodatfn(dirfd, instw.path, mode, dev);
+
+	instw_delete(&instw);
+	return result;
+}
