--- a/installwatch/create-localdecls
+++ b/installwatch/create-localdecls
@@ -8,20 +8,35 @@
 #
 # Uhm... time to learn GNU autoconf :-)
 
 OUTFILE='localdecls.h'
 
 echo '/* This file is automatically generated     *' > $OUTFILE
 echo ' * Modify create-localdecls instead of this */' >> $OUTFILE
 echo >> $OUTFILE
 echo '#ifndef __LOCALDECLS_H_' > $OUTFILE
 echo '#define __LOCALDECLS_H_' >> $OUTFILE
+
+# --- OHOS/musl fast path: no gcc, no /usr/include/unistd.h (E037/E051) ---
+# musl libc: truncate uses off_t, readlinkat returns ssize_t, libc is libc.so.
+if ! command -v gcc >/dev/null 2>&1 || ! test -r /usr/include/unistd.h ; then
+	echo 'musl (no gcc probe)'
+	echo '#define TRUNCATE_T off_t' >> $OUTFILE
+	echo '#define READLINKAT_T ssize_t' >> $OUTFILE
+	echo "#define LIBC_FILE \"libc.so\"" >> $OUTFILE
+	echo '#define GLIBC_MAJOR 2' >> $OUTFILE
+	echo '#define GLIBC_MINOR 10' >> $OUTFILE
+	echo >> $OUTFILE
+	echo '#endif' >> $OUTFILE
+	exit 0
+fi
+
 echo >> $OUTFILE
 
 ###
 ###
 ###
 
 echo -n 'Checking truncate argument type... '
 if grep -q 'truncate.*size_t' /usr/include/unistd.h ; then
 	echo 'size_t'
 	echo '#define TRUNCATE_T size_t' >> $OUTFILE
