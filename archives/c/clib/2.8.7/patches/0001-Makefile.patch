diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,12 +1,13 @@
 CC     ?= cc
 PREFIX ?= /usr/local
+DESTDIR ?=
 
 BINS = clib clib-install clib-search clib-init clib-configure clib-build clib-update clib-upgrade clib-uninstall
 
 ifdef EXE
 	BINS := $(addsuffix .exe,$(BINS))
 endif
 
 CP      = cp -f
 RM      = rm -f
 MKDIR   = mkdir -p
@@ -60,25 +61,25 @@
 	$(CC) $< -c -o $@ $(CFLAGS) -MMD
 
 clean:
 	$(foreach c, $(BINS), $(RM) $(c);)
 	$(RM) $(OBJS)
 	$(RM) $(AUTODEPS)
 	cd test/cache && make clean
 	cd test/package && make clean
 
 install: $(BINS)
-	$(MKDIR) $(PREFIX)/bin
-	$(foreach c, $(BINS), $(INSTALL) $(c) $(PREFIX)/bin/$(c);)
+	$(MKDIR) $(DESTDIR)$(PREFIX)/bin
+	$(foreach c, $(BINS), $(INSTALL) $(c) $(DESTDIR)$(PREFIX)/bin/$(c);)
 
 uninstall:
-	$(foreach c, $(BINS), $(RM) $(PREFIX)/bin/$(c);)
+	$(foreach c, $(BINS), $(RM) $(DESTDIR)$(PREFIX)/bin/$(c);)
 
 test: $(BINS)
 	@./test.sh
 
 # create a list of auto dependencies
 AUTODEPS:= $(patsubst %.c,%.d, $(DEPS)) $(patsubst %.c,%.d, $(SRC))
 
 # include by auto dependencies
 -include $(AUTODEPS)
 
