+// libc++ (OHOS SDK) declares std::unique_ptr inside an inline ABI namespace,
+// so a guide written directly in namespace std is a different scope and the
+// compiler rejects it: "deduction guide must be declared in the same scope as
+// template 'std::unique_ptr'". The guides are not used by this library (the
+// only unique_ptr use site passes explicit template arguments), so they are
+// skipped on libc++.
+#if !defined(_LIBCPP_VERSION)
 namespace std {
 
 // deduction guides for std::unique_ptr
 template <typename T>
 unique_ptr(T* p) -> unique_ptr<T>;
 template <typename T, typename D>
 unique_ptr(T* p, D&& d) -> unique_ptr<T, std::decay_t<D>>;
 
 } // namespace std
+#endif /* !defined(_LIBCPP_VERSION) */
 
