--- a/configure
+++ b/configure
@@ -46074,12 +46074,21 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  case "${CPIO_HMDFS_UMASK-}" in
+    022) tmp_umask=022 ;;
+    *)
+      case "${host_os-}" in
+        *ohos*) tmp_umask=022 ;;
+        *) tmp_umask=077 ;;
+      esac
+      ;;
+  esac
+  tmp=`(umask "$tmp_umask" && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask "$tmp_umask" && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
