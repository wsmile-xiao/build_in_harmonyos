diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,39 @@
+#!/bin/sh
+# HarmonyOS compatibility wrapper: translate autotools-style configure to cmake
+# Reuses pre-downloaded deps from the work build directory to avoid network downloads
+
+set -e
+
+PREFIX=""
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*) PREFIX="${arg#--prefix=}" ;;
+    esac
+done
+
+if [ -z "$PREFIX" ]; then
+    PREFIX="/usr/local"
+fi
+
+echo "configure wrapper: PREFIX=$PREFIX" >&2
+echo "configure wrapper: PWD=$PWD" >&2
+
+# Point to pre-downloaded deps to avoid cmake FetchContent downloads
+DEPS_BASE="b/build/_deps"
+CMAKE_EXTRA=""
+if [ -d "$DEPS_BASE/xxhash-src" ]; then
+    CMAKE_EXTRA="$CMAKE_EXTRA -DFETCHCONTENT_SOURCE_DIR_XXHASH=$DEPS_BASE/xxhash-src"
+fi
+if [ -d "$DEPS_BASE/zstd-src" ]; then
+    CMAKE_EXTRA="$CMAKE_EXTRA -DFETCHCONTENT_SOURCE_DIR_ZSTD=$DEPS_BASE/zstd-src"
+fi
+if [ -d "$DEPS_BASE/hiredis-src" ]; then
+    CMAKE_EXTRA="$CMAKE_EXTRA -DFETCHCONTENT_SOURCE_DIR_HIREDIS=$DEPS_BASE/hiredis-src"
+fi
+
+echo "configure wrapper: CMAKE_EXTRA=$CMAKE_EXTRA" >&2
+
+mkdir -p build
+cd build
+echo "configure wrapper: running cmake from $PWD" >&2
+cmake .. -DCMAKE_INSTALL_PREFIX="${PREFIX}" $CMAKE_EXTRA
