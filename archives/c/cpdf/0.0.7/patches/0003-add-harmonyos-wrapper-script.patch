--- /dev/null
+++ bin/cpdf
@@ -0,0 +1,12 @@
+#!/bin/sh
+# cpdf wrapper script for HarmonyOS
+# Python cpdf 0.0.7 - PDF command line tool wrapper
+
+SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
+PYTHON_SITE="${SELF_DIR}/../lib/python3.12/site-packages"
+
+# Set PYTHONPATH to include our packaged cpdf module
+export PYTHONPATH="${PYTHON_SITE}:${PYTHONPATH:-}"
+
+# Execute cpdf via python3
+exec python3 -m cpdf "$@"