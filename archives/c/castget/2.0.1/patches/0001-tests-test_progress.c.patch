 static void test_progress_bar_cb()
 {
   char *old_columns = getenv("COLUMNS");
   progress_bar *pb;
 
   setenv("COLUMNS", "78", 1);
   pb = progress_bar_new(0);
-  /* Silence progress bar output by directing it to a temporary file */
-  pb->f = tmpfile();
+  /* Silence progress bar output by directing it to a temporary file.
+   * tmpfile() hard-codes /tmp on musl (read-only on OHOS), so use
+   * mkstemp under TMPDIR instead. */
+  {
+    const char *tmpdir_ = getenv("TMPDIR");
+    char *tmpl_;
+    int tfd_;
+    if (tmpdir_ == NULL || *tmpdir_ == 0)
+      tmpdir_ = "/tmp";
+    tmpl_ = g_strdup_printf("%s/castget-test-XXXXXX", tmpdir_);
+    tfd_ = mkstemp(tmpl_);
+    g_assert_cmpint(tfd_, >=, 0);
+    unlink(tmpl_);
+    g_free(tmpl_);
+    pb->f = fdopen(tfd_, "w+");
+    g_assert(pb->f != NULL);
+  }
 
   progress_bar_cb(pb, 300, 0, 0, 0);
   g_assert_cmpstr(pb->buffer, ==, "                                                                         ");
   progress_bar_cb(pb, 300, 150, 0, 0);
   g_assert_cmpstr(pb->buffer, ==, "####################################                                     ");
   progress_bar_cb(pb, 300, 450, 0, 0);
   g_assert_cmpstr(pb->buffer, ==, "#########################################################################");
   progress_bar_cb(pb, 300, -1, 0, 0);
   g_assert_cmpstr(pb->buffer, ==, "                                                                         ");
   pb->resume_from = 150;
