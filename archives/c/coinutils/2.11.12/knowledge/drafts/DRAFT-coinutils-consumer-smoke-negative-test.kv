#====================================================================
# DRAFT-coinutils-consumer-smoke-negative-test
# Numeric utility libraries need a real consumer target plus negative-link evidence
#====================================================================

id:                     DRAFT-coinutils-consumer-smoke-negative-test
trigger_tool:           conan|cmake|test_package|shadow-ci
phase:                  l1|consumer-validation
error_signature:        find_package\\(coinutils|coinutils::coinutils|CoinPackedMatrix|getNumElements|Negative test confirmed
severity:               2
category:               test-package|consumer-contract|numeric-library|harmonyos
match_keywords:         CoinUtils, CMakeDeps, coinutils::coinutils, CoinPackedMatrix, smoke test, negative test, static library, include coin
title:                  CoinUtils consumer validation should compile a real C++ API user and prove the test links through coinutils

root_cause:             CoinUtils is primarily a library, not a CLI. Version-only or file-existence checks do not prove the exported headers,
                        CMake target, static archive, transitive zlib/bzip2 links, or OHOS executable signing path. A useful L1 test must
                        compile and run a consumer that includes public headers and links the exported target.

affected_scope:         Numeric or solver foundation libraries with small public APIs and no primary command-line interface. Applies to packages
                        where downstream users consume CMakeDeps targets rather than running packaged binaries.

verification_cmd:       CI_PACKAGES=archives/c/coinutils/2.11.12 zsh -f ci/conan/build_and_test.sh archives/c/coinutils/2.11.12

rec_priority:           1
rec_approach:           cmakedeps-api-smoke-plus-negative-link
rec_description:        Build a CMake test_package that find_package()s coinutils, links coinutils::coinutils, includes a public CoinUtils
                        header, constructs a simple object such as CoinPackedMatrix, and runs on the signed target executable. Pair the
                        positive smoke with CI's destructive negative test so a missing link to coinutils is detected.
rec_command:            cmake --build . && ./coinutils_smoke
rec_auto_fix:           false
rec_impl:               conan-test-package

fallback_priority:      2
fallback_approach:      compile-only-consumer-when-cannot-run
fallback_description:   If can_run() is false in a host-only preflight, keep the build/link consumer test and record runtime as pending target CI.
                        Do not replace it with package file listing.
fallback_command:       conan test test_package coinutils/2.11.12
fallback_auto_fix:      false

forbid_1_pattern:       test_package.*only.*exists|ls libCoinUtils|--version
forbid_1_reason:        File presence or version output does not validate the library consumer contract.
forbid_1_consequence:   Broken include directories or missing transitive link flags can escape CI.

forbid_2_pattern:       can_run.*return.*passed
forbid_2_reason:        Cross-host inability to run is not a target runtime pass.
forbid_2_consequence:   The package can be marked built without signed target execution.

doc_file:               archives/c/coinutils/2.11.12/knowledge/drafts/DRAFT-coinutils-consumer-smoke-negative-test.md
last_updated:           2026-09-08
source_event:           coinutils/2.11.12 HarmonyOS PC shadow CI adaptation
source_package:         archives/c/coinutils/2.11.12
evidence:               test_package/coinutils_smoke.cpp, test_package/conanfile.py, shadow CI run manual-coinutils-2.11.12-min-20260908T025816Z-22719
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.90
draft:                  true
