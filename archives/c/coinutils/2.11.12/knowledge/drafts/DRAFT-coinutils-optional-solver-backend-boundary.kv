#====================================================================
# DRAFT-coinutils-optional-solver-backend-boundary
# COIN-OR optional numeric backends must be disabled or split as dependencies
#====================================================================

id:                     DRAFT-coinutils-optional-solver-backend-boundary
trigger_tool:           autotools|conan|dependency-analysis
phase:                  configure|w0-dependency-check
error_signature:        checking for.*blas|checking for.*lapack|checking for.*glpk|checking for.*asl|--with-blas|--without-blas
severity:               2
category:               dependency-boundary|numeric-library|coin-or|harmonyos
match_keywords:         CoinUtils, COIN-OR, BLAS, LAPACK, GLPK, ASL, zlib, bzip2, optional dependency, W0, dependency split
title:                  CoinUtils optional BLAS/LAPACK/GLPK/ASL probes should be disabled unless those libraries have their own adapted Conan packages

root_cause:             CoinUtils can optionally use several numeric or solver-adjacent backends, but the core sparse matrix and utility library
                        does not require them. Enabling configure auto-detection on OHOS risks linking to undeclared system libraries or mixing
                        missing dependency adaptations into the CoinUtils PR. The correct W0 boundary is to keep only already adapted bzip2/zlib
                        as requirements and disable optional BLAS, LAPACK, GLPK, and ASL probes.

affected_scope:         COIN-OR base packages and downstream solver libraries where optional math or solver dependencies are auto-detected by
                        configure. Applies when the adaptation rule requires missing dependencies to be split into their own PRs.

verification_cmd:       rg -n "without-blas|without-lapack|without-glpk|without-asl|requires\\(" archives/c/coinutils/2.11.12/conanfile.py

rec_priority:           1
rec_approach:           freeze-core-dependency-graph
rec_description:        During W0, classify dependencies as mandatory or optional. Require existing adapted packages for mandatory bzip2/zlib.
                        Pass --without-blas, --without-lapack, --without-glpk, and --without-asl for optional backends. Record disabled features
                        in manifest.yaml so downstream packages do not assume those integrations are available.
rec_command:            conan create archives/c/coinutils/2.11.12 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
rec_auto_fix:           false
rec_impl:               conan-recipe-configure-args

fallback_priority:      2
fallback_approach:      split-missing-backend-package
fallback_description:   If a downstream package requires one of the optional backends, adapt that backend as its own library first and then
                        reopen CoinUtils feature enablement in a separate change. Do not bundle backend adaptation into the CoinUtils PR.
fallback_command:       create separate archives/<letter>/<dependency>/<version> adaptation
fallback_auto_fix:      false

forbid_1_pattern:       --with-blas|--with-lapack|--with-glpk|--with-asl
forbid_1_reason:        These switches pull optional libraries into CoinUtils without confirmed adapted packages.
forbid_1_consequence:   CI may link to system libraries or require untracked dependencies.

forbid_2_pattern:       apt install|harmonybrew install|system.*blas|system.*glpk
forbid_2_reason:        System package installation violates the reproducible Conan dependency boundary.
forbid_2_consequence:   The package may pass on one worker but fail in clean CI.

doc_file:               archives/c/coinutils/2.11.12/knowledge/drafts/DRAFT-coinutils-optional-solver-backend-boundary.md
last_updated:           2026-09-08
source_event:           coinutils/2.11.12 HarmonyOS PC shadow CI adaptation
source_package:         archives/c/coinutils/2.11.12
evidence:               conanfile.py requirements() and generate(), manifest.yaml build.disabled, shadow CI run manual-coinutils-2.11.12-min-20260908T025816Z-22719
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.88
draft:                  true
