#====================================================================
# DRAFT-coinutils-generated-configure-umask-install-sh
# Generated autotools scripts may need target-side umask and install-sh fixes on OHOS
#====================================================================

id:                     DRAFT-coinutils-generated-configure-umask-install-sh
trigger_tool:           autotools|configure|make-install
phase:                  build|package
error_signature:        umask 077.*mkdir|mktemp -d|Permission denied|install_sh_DATA.*config_coinutils.h|cannot execute.*install-sh
severity:               2
category:               autotools|hmdfs|install|generated-files|harmonyos
match_keywords:         CoinUtils, configure, umask 077, umask 002, mktemp, install-sh, install_sh_DATA, config_coinutils.h, HMDFS, OHOS
title:                  Generated configure and Makefile.in fixes may be required together: relax secure temp umask and call install-sh through SHELL

root_cause:             CoinUtils 2.11.12 generated configure scripts create temporary directories through umask 077 patterns. On the OHOS
                        true-machine filesystem this can interact badly with package build directories and permission propagation. The generated
                        nested Makefile.in also invokes install_sh_DATA directly for config_coinutils.h; using $(SHELL) makes the helper invocation
                        stable when execute bits or shell association differ in the staged source tree.

affected_scope:         Autotools release archives that rely on generated configure files and install-sh helpers on HarmonyOS PC or HMDFS-backed
                        build locations. Especially relevant when the project should not run autoreconf on the target.

verification_cmd:       rg -n "umask 077|install_sh_DATA config_coinutils.h" configure CoinUtils/configure CoinUtils/src/Makefile.in && CI_PACKAGES=archives/c/coinutils/2.11.12 zsh -f ci/conan/build_and_test.sh archives/c/coinutils/2.11.12

rec_priority:           1
rec_approach:           mutate-generated-files-in-recipe-for-ohos
rec_description:        In build(), replace known generated configure temp-directory patterns from umask 077 to umask 002 for both root and
                        nested configure scripts, and route install_sh_DATA through $(SHELL). Keep these edits OHOS-scoped in the recipe so
                        other platforms keep upstream behavior.
rec_command:            replace_in_file configure "(umask 077 && mkdir $tmp)" "(umask 002 && mkdir $tmp)"
rec_auto_fix:           false
rec_impl:               ohos-scoped-conanfile-generated-file-edit

fallback_priority:      2
fallback_approach:      patch-generated-files-directly
fallback_description:   If recipe-time replacement is rejected by CI policy, carry versioned patches for configure and Makefile.in. Do not run
                        autoreconf unless all autotools build requirements are already adapted for the target workflow.
fallback_command:       git diff -- configure CoinUtils/configure CoinUtils/src/Makefile.in
fallback_auto_fix:      false

forbid_1_pattern:       autoreconf|aclocal|automake.*tool_requires
forbid_1_reason:        CoinUtils release archives already ship generated files; pulling autotools tools into the OHOS package adds unrelated dependencies.
forbid_1_consequence:   CI can fail on tool registry reachability or mix a separate tool adaptation into the package PR.

forbid_2_pattern:       chmod -R 777|disable.*permission.*check
forbid_2_reason:        Broad permission workarounds hide filesystem behavior and alter unrelated files.
forbid_2_consequence:   Package reproducibility and patch review become weaker.

doc_file:               archives/c/coinutils/2.11.12/knowledge/drafts/DRAFT-coinutils-generated-configure-umask-install-sh.md
last_updated:           2026-09-08
source_event:           coinutils/2.11.12 HarmonyOS PC shadow CI adaptation
source_package:         archives/c/coinutils/2.11.12
evidence:               conanfile.py build() OHOS branch, shadow CI run manual-coinutils-2.11.12-min-20260908T025816Z-22719
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.80
draft:                  true
