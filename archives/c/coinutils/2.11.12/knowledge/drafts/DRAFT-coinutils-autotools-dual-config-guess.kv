#====================================================================
# DRAFT-coinutils-autotools-dual-config-guess
# COIN-OR nested autotools source trees need all config.guess copies patched
#====================================================================

id:                     DRAFT-coinutils-autotools-dual-config-guess
trigger_tool:           autotools|configure|conan
phase:                  configure|cross-compilation
error_signature:        config.guess.*HarmonyOS|config.guess.*HongMeng|cannot guess build type|aarch64.*unknown-linux.*ohos
severity:               2
category:               autotools|platform-detection|harmonyos|coin-or
match_keywords:         CoinUtils, COIN-OR, autotools, recursive configure, config.guess, HarmonyOS, HongMeng, musl, aarch64, linux-ohos
title:                  COIN-OR nested autotools packages may carry root and component config.guess copies; patch both for HarmonyOS/HongMeng

root_cause:             CoinUtils 2.11.12 contains a top-level configure/config.guess and a nested CoinUtils/configure/config.guess.
                        The package configure path can enter both layers, so patching only one copy leaves a version-dependent failure window.
                        HarmonyOS true-machine uname can expose HarmonyOS or HongMeng strings while the old generated config.guess scripts
                        only classify Linux/GNU style systems. Without explicit mapping, configure cannot derive the expected
                        aarch64-unknown-linux-musl style triplet used by the OHOS Conan profile.

affected_scope:         COIN-OR autotools packages with nested component directories, especially CoinUtils and downstream packages that
                        import the same BuildTools/autotools layout. Similar packages should inventory all config.guess copies before
                        deciding patch scope.

verification_cmd:       git apply --check patches/*config-guess*.patch && CI_PACKAGES=archives/c/coinutils/2.11.12 zsh -f ci/conan/build_and_test.sh archives/c/coinutils/2.11.12

rec_priority:           1
rec_approach:           patch-all-generated-config-guess-copies
rec_description:        Add a HarmonyOS/HongMeng branch near the UNAME_SYSTEM normalization and map aarch64 Linux/HongMeng forms to
                        "$UNAME_MACHINE-unknown-linux-$LIBC". Keep the patch version-local and verify it against the extracted release
                        tarball because COIN-OR release archives vendor generated autotools files.
rec_command:            rg -n "config.guess$|HarmonyOS|HongMeng" . && git apply --check patches/*config-guess*.patch
rec_auto_fix:           false
rec_impl:               versioned-conan-patches

fallback_priority:      2
fallback_approach:      pass-explicit-build-host-triplets
fallback_description:   Passing explicit --build/--host triplets can reduce configure ambiguity, but it does not repair nested scripts that
                        are invoked independently. Use it only as a supplement, not as the only fix.
fallback_command:       ./configure --build=aarch64-unknown-linux-musl --host=aarch64-unknown-linux-musl
fallback_auto_fix:      false

forbid_1_pattern:       patch.*only.*CoinUtils/config.guess|patch.*only.*root.*config.guess
forbid_1_reason:        CoinUtils 2.11.12 has two generated config.guess copies in the source tree.
forbid_1_consequence:   One configure layer can pass while the other still fails on the target platform string.

forbid_2_pattern:       set.*CMAKE_SYSTEM_NAME.*Linux|pretend.*Linux
forbid_2_reason:        This is an autotools package; changing CMake system identity does not address generated configure scripts.
forbid_2_consequence:   The real platform detection bug remains and may resurface in CI or downstream recipes.

doc_file:               archives/c/coinutils/2.11.12/knowledge/drafts/DRAFT-coinutils-autotools-dual-config-guess.md
last_updated:           2026-09-08
source_event:           coinutils/2.11.12 HarmonyOS PC shadow CI adaptation
source_package:         archives/c/coinutils/2.11.12
evidence:               patches/0002-coinutils-config-guess.patch, patches/0003-root-config-guess.patch, shadow CI run manual-coinutils-2.11.12-min-20260908T025816Z-22719
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.86
draft:                  true
