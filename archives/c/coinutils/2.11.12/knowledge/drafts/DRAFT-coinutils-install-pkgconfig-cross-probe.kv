#====================================================================
# DRAFT-coinutils-install-pkgconfig-cross-probe
# Install-time pkg-config probes in generated autotools hooks are unsafe in target packaging
#====================================================================

id:                     DRAFT-coinutils-install-pkgconfig-cross-probe
trigger_tool:           autotools|pkg-config|make-install|conan
phase:                  package|install
error_signature:        install-data-hook.*PKG_CONFIG_PATH|pkg-config --libs coinutils|coinutils_addlibs.txt|DESTDIR.*pkgconfig
severity:               2
category:               autotools|pkg-config|cross-packaging|coin-or
match_keywords:         CoinUtils, coinutils_addlibs.txt, install-data-hook, pkg-config, PKG_CONFIG_PATH, DESTDIR, cross build, Conan package
title:                  COIN-OR generated install hooks may execute pkg-config --libs during DESTDIR packaging and should be neutralized for cross packages

root_cause:             CoinUtils Makefile.in runs an install-data-hook that invokes pkg-config --libs coinutils while DESTDIR packaging is still in progress.
                        In a cross or target-package environment, that probe can see an incomplete staged pkgconfig directory, leak host/system paths,
                        or fail even though the static library and headers installed correctly. The generated addlibs file is legacy metadata and is
                        not the Conan consumer contract.

affected_scope:         COIN-OR autotools releases that generate *_addlibs.txt through install-data-hook and derive it by running pkg-config inside
                        the staged package tree. Applies especially when packaging with Conan CMakeDeps/pkg-config metadata generated by the recipe.

verification_cmd:       rg -n "install-data-hook|pkg-config --libs|addlibs" CoinUtils/Makefile.in && conan create archives/c/coinutils/2.11.12 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64

rec_priority:           1
rec_approach:           disable-install-time-pkgconfig-probe
rec_description:        Patch the generated Makefile.in so install-data-hook does not execute pkg-config --libs during DESTDIR install.
                        Keep Conan package_info as the authoritative consumer contract: cmake target, pkg_config_name, libs, includedirs,
                        and system libs.
rec_command:            patch CoinUtils/Makefile.in to comment the PKG_CONFIG_PATH/pkg-config --libs coinutils lines
rec_auto_fix:           false
rec_impl:               versioned-generated-file-patch

fallback_priority:      2
fallback_approach:      generate-addlibs-from-known-conan-link-interface
fallback_description:   If a downstream COIN-OR package explicitly consumes *_addlibs.txt, write the file from the known Conan dependency graph
                        rather than executing pkg-config against the partial DESTDIR tree.
fallback_command:       printf '%s\n' "-lCoinUtils -lbz2 -lz -lm" > coinutils_addlibs.txt
fallback_auto_fix:      false

forbid_1_pattern:       PKG_CONFIG_PATH=.*DESTDIR.*pkg-config --libs
forbid_1_reason:        Running pkg-config against a partially installed target package can capture transient or host paths.
forbid_1_consequence:   The package can pass install but expose non-reproducible link metadata to downstream consumers.

forbid_2_pattern:       delete.*pkgconfig.*contract|remove.*package_info
forbid_2_reason:        The fix is not to remove consumer metadata entirely; Conan still needs precise CMake and pkg-config properties.
forbid_2_consequence:   Downstream packages lose a stable target and fall back to ad-hoc link flags.

doc_file:               archives/c/coinutils/2.11.12/knowledge/drafts/DRAFT-coinutils-install-pkgconfig-cross-probe.md
last_updated:           2026-09-08
source_event:           coinutils/2.11.12 HarmonyOS PC shadow CI adaptation
source_package:         archives/c/coinutils/2.11.12
evidence:               patches/0001-no-check-pkgconfig.patch, conanfile.py package_info, shadow CI run manual-coinutils-2.11.12-min-20260908T025816Z-22719
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.84
draft:                  true
