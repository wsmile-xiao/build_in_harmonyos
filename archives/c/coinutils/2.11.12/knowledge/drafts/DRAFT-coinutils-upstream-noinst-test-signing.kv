#====================================================================
# DRAFT-coinutils-upstream-noinst-test-signing
# Autotools noinst unit tests need target-side signing before OHOS execution
#====================================================================

id:                     DRAFT-coinutils-upstream-noinst-test-signing
trigger_tool:           autotools|make|conan|shadow-ci
phase:                  build|upstream-validation|target-runtime
error_signature:        unitTest|Permission denied|binary-sign-tool|upstream.*test
severity:               1
category:               autotools|upstream-tests|elf-signing|harmonyos|coin-or
match_keywords:         CoinUtils, unitTest, noinst_PROGRAMS, make test, binary-sign-tool, llvm-objcopy, OHOS, target runtime
title:                  Sign autotools noinst upstream test executables before running them on HarmonyOS

root_cause:             COIN-OR autotools packages can define upstream tests as noinst_PROGRAMS.
                        The library build succeeds, but the generated test executable is not installed or signed.
                        HarmonyOS target execution can reject the unsigned ELF even when the test binary and its
                        dependencies are otherwise correct.

affected_scope:         C/C++ autotools packages with test or unitTest targets that build noinst executables,
                        especially COIN-OR packages using recursive component test directories. This does not apply
                        to host-only cross builds where the target executable cannot run on the build machine.

verification_cmd:       make -C CoinUtils/test unitTest && sign CoinUtils/test/unitTest && make -C CoinUtils/test test

rec_priority:           1
rec_approach:           build-sign-run-upstream-test
rec_description:        Build the noinst test target explicitly, locate the generated executable in the recursive
                        component test directory, remove any stale .codesign section with llvm-objcopy, sign it with
                        binary-sign-tool -selfSign 1, then invoke the upstream make test target. Keep Sample/Netlib
                        data arguments explicit and document data-gated coverage separately.
rec_command:            make -C CoinUtils/test unitTest -j1 && make -C CoinUtils/test test -j1
rec_auto_fix:           false
rec_impl:               ohos-signed-upstream-test

fallback_priority:      2
fallback_approach:      record-cross-build-skip
fallback_description:   When the build machine is not OHOS, do not claim a target runtime pass. Record that the
                        executable was not run because cross-built target binaries cannot execute on the host, and
                        require native OHOS shadow CI for the runtime result.
fallback_command:       conan create . -pr:h=ohos-aarch64 -pr:b=linux-x86_64
fallback_auto_fix:      false

forbid_1_pattern:       make test.*without.*sign|unitTest.*run.*unsigned
forbid_1_reason:        An unsigned target ELF can fail before the upstream test logic starts.
forbid_1_consequence:   The package may be incorrectly reported as upstream-tested while the target runtime path is unverified.

forbid_2_pattern:       can_run.*return.*passed|skip.*upstream.*test.*passed
forbid_2_reason:        A host-side skip is not evidence that the target executable ran.
forbid_2_consequence:   Cross-build limitations become hidden as false-positive test results.

doc_file:               archives/c/coinutils/2.11.12/knowledge/drafts/DRAFT-coinutils-upstream-noinst-test-signing.md
last_updated:           2026-09-09
source_event:           coinutils/2.11.12 upstream unitTest integration during HarmonyOS PC self-check
source_package:         archives/c/coinutils/2.11.12
evidence:               conanfile.py::_run_ohos_upstream_tests, conanfile.py::_sign_ohos_executable, test_package/conanfile.py
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.88
draft:                  true
