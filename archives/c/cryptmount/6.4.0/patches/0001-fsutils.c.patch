+
+/* Stub implementations for missing mntent functions on HarmonyOS */
+#ifndef HAVE_ADDMNTENT
+
+FILE *setmntent(const char *filename, const char *type) {
+    /* On HarmonyOS, /etc/mtab may not exist or be read-only */
+    return fopen(filename, type);
+}
+
+int addmntent(FILE *fp, const struct mntent *mnt) {
+    /* Stub: write mntent entry to file */
+    if (fp == NULL || mnt == NULL) return 1;
+    fprintf(fp, "%s %s %s %s %d %d\n",
+            mnt->mnt_fsname, mnt->mnt_dir, mnt->mnt_type,
+            mnt->mnt_opts, mnt->mnt_freq, mnt->mnt_passno);
+    return 0;
+}
+
+int endmntent(FILE *fp) {
+    if (fp != NULL) fclose(fp);
+    return 1;
+}
+
+struct mntent *getmntent(FILE *fp) {
+    /* Stub: read mntent entry from file */
+    static struct mntent mnt;
+    static char line[512];
+    char *p;
+    
+    if (fp == NULL) return NULL;
+    if (fgets(line, sizeof(line), fp) == NULL) return NULL;
+    
+    /* Simple parsing */
+    p = line;
+    mnt.mnt_fsname = p;
+    p = strchr(p, ' '); if (!p) return NULL; *p++ = '\0';
+    mnt.mnt_dir = p;
+    p = strchr(p, ' '); if (!p) return NULL; *p++ = '\0';
+    mnt.mnt_type = p;
+    p = strchr(p, ' '); if (!p) return NULL; *p++ = '\0';
+    mnt.mnt_opts = p;
+    p = strchr(p, ' '); if (!p) return NULL; *p++ = '\0';
+    mnt.mnt_freq = atoi(p);
+    p = strchr(p, ' '); if (!p) return NULL; *p++ = '\0';
+    mnt.mnt_passno = atoi(p);
+    
+    return &mnt;
+}
+
+#endif /* HAVE_ADDMNTENT */
