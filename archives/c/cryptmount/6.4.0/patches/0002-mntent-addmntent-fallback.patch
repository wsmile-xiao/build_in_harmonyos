+#if !HAVE_ADDMNTENT
+static int cm_write_mntent_field(FILE *fp, const char *field)
+{
+    const unsigned char *p = (const unsigned char *)field;
+    for (; *p; ++p) {
+        const char *escape = NULL;
+        switch (*p) {
+        case ' ':  escape = "\\040"; break;
+        case '\t': escape = "\\011"; break;
+        case '\n': escape = "\\012"; break;
+        case '\\': escape = "\\134"; break;
+        default:
+            if (fputc(*p, fp) == EOF) return -1;
+            continue;
+        }
+        if (fputs(escape, fp) == EOF) return -1;
+    }
+    return 0;
+}
+
+static int cm_addmntent(FILE *fp, const struct mntent *mnt)
+{
+    if (cm_write_mntent_field(fp, mnt->mnt_fsname) != 0 || fputc(' ', fp) == EOF ||
+        cm_write_mntent_field(fp, mnt->mnt_dir) != 0 || fputc(' ', fp) == EOF ||
+        cm_write_mntent_field(fp, mnt->mnt_type) != 0 || fputc(' ', fp) == EOF ||
+        cm_write_mntent_field(fp, mnt->mnt_opts) != 0 ||
+        fprintf(fp, " %d %d\n", mnt->mnt_freq, mnt->mnt_passno) < 0)
+        return 1;
+    return ferror(fp) ? 1 : 0;
+}
+#define addmntent cm_addmntent
+#endif
 
 
