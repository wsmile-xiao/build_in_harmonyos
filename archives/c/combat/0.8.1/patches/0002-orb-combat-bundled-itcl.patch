# make orb/combat.tcl discover the itcl/ library shipped next to it
#
# OHOS (aarch64/musl/clang) porting patch for Combat 0.8.1.
# Generated from the pristine combat-0.8.1 tarball
# (SHA256 1923fa19f55a03f720f0444d6edffe7dad246c2c4be82453b8d2c5b4922d99a8).

--- a/orb/combat.tcl
+++ b/orb/combat.tcl
@@ -28,6 +28,8 @@
 #
 
 if {[catch {
+    # OHOS: prefer the itcl/ directory bundled next to this file.
+    lappend auto_path [file join [file dirname [info script]] itcl]
     package require Itcl
 }]} {
     #
