diff -ruN a/inc/crnlib.h b/inc/crnlib.h
--- a/inc/crnlib.h
+++ b/inc/crnlib.h
@@ -14,6 +14,14 @@
 #ifndef CRNLIB_H
 #define CRNLIB_H
 
+// OHOS/clang hardening: this header uses NULL and size_t (CRNLIB_MIN_ALLOC_ALIGNMENT,
+// crn_realloc_func/crn_msize_func, default args = NULL) but included nothing.
+// Older libstdc++ pulled <cstddef> transitively; strict clang/libc++ with
+// -std=c++11 does not, so a standalone #include <crnlib.h> fails with
+// "use of undeclared identifier 'NULL'" / "unknown type name 'size_t'".
+// Explicit include fixes consumers without changing any API.
+#include <stddef.h>
+
 #ifdef _MSC_VER
 #pragma warning(disable : 4127)  //  conditional expression is constant
 #endif
