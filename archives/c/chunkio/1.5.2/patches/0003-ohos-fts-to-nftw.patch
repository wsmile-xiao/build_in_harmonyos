+#elif !defined(_MSC_VER)
+/*
+ * HarmonyOS / musl libc does not ship <fts.h>, so the fts(3) walk above
+ * cannot be compiled.  Fall back to the POSIX nftw(3) traversal with the
+ * same semantics: FTW_DEPTH visits a directory after its contents
+ * (children are removed first), FTW_PHYS does not follow symbolic links.
+ */
+static int cio_nftw_unlink(const char *path, const struct stat *st, int type,
+                           struct FTW *entry)
+{
+    (void) st;
+    (void) entry;
+
+    if (type == FTW_DNR || type == FTW_NS) {
+        fprintf(stderr, "%s: cannot traverse: %s\n", path, strerror(errno));
+        return 0;
+    }
+
+    if (type == FTW_F || type == FTW_SL || type == FTW_DP) {
+        if (remove(path) < 0) {
+            fprintf(stderr, "%s: Failed to remove: %s\n", path,
+                    strerror(errno));
+            return 1;
+        }
+    }
+
+    return 0;
+}
+
+int cio_utils_recursive_delete(const char *dir)
+{
+    int ret;
+    struct stat st;
+
+    ret = stat(dir, &st);
+    if (ret == -1) {
+        return -1;
+    }
+
+    ret = nftw(dir, cio_nftw_unlink, 16, FTW_DEPTH | FTW_PHYS);
+    if (ret != 0) {
+        return -1;
+    }
+
+    return 0;
+}
 #else
