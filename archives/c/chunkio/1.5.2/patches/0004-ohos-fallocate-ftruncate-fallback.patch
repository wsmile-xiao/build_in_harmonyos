--- a/src/cio_file_unix.c
+++ b/src/cio_file_unix.c
@@ -532,11 +532,13 @@
            errno = EOPNOTSUPP;
 #endif
 
-           if (result == -1 && errno == EOPNOTSUPP) {
+           if (result == -1 && errno != ENOSPC) {
                /*
                 * If fallocate fails with an EOPNOTSUPP try operation using
                 * posix_fallocate. Required since some filesystems do not support
                 * the fallocate operation e.g. ext3 and reiserfs.
+                * HarmonyOS additionally rejects fallocate(2) with EACCES, so
+                * any error other than a real "no space left" is retried.
                 */
                cf->allocate_strategy = CIO_FILE_LINUX_POSIX_FALLOCATE;
                goto retry;
@@ -545,6 +547,16 @@
        else if (cf->allocate_strategy == CIO_FILE_LINUX_POSIX_FALLOCATE) {
 #if defined(CIO_HAVE_POSIX_FALLOCATE)
             result = posix_fallocate(cf->fd, 0, new_size);
+            if (result != 0 &&
+                (result == EACCES || result == EPERM || result == EOPNOTSUPP ||
+                 result == ENOSYS || result == EINVAL || result == ENOTSUP)) {
+                /*
+                 * posix_fallocate() returns the error number directly.
+                 * HarmonyOS rejects file pre-allocation with EACCES, so fall
+                 * back to a plain ftruncate() which the filesystem accepts.
+                 */
+                result = ftruncate(cf->fd, new_size);
+            }
 #else
             goto fallback;
 #endif
