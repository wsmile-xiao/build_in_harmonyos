@@ -94,6 +94,17 @@
   if (fp->state == 4 /* WR */ || fp->rp >= fp->wp)
     return 0;
   return fp->wp - fp->rp;
+#elif defined __OHOS__ || (defined __linux__ && !defined __GLIBC__)
+  /* HarmonyOS uses musl libc with opaque FILE structure.
+     musl provides __fwriting in <stdio_ext.h> to check write mode.
