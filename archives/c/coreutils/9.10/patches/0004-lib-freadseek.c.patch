--- a/lib/freadseek.c
+++ b/lib/freadseek.c
@@ -27,21 +27,27 @@
 
 #include "stdio-impl.h"
 
 /* Increment the in-memory pointer.  INCREMENT must be at most the buffer size
    returned by freadptr().
    This is very cheap (no system calls).  */
 static void
 freadptrinc (FILE *fp, size_t increment)
 {
   /* Keep this code in sync with freadptr!  */
-#if HAVE___FREADPTRINC              /* OpenBSD >= 7.6, musl libc, Haiku >= hrev58760 */
+#if defined __linux__ && !defined __GLIBC__
+  /* HarmonyOS uses musl libc with opaque FILE structure.
+     Cannot increment the in-memory pointer directly.
+     This function is only called when freadptr returns non-NULL,
+     which won't happen for musl (see freadptr.c).  */
+  abort ();
+#elif HAVE___FREADPTRINC              /* OpenBSD >= 7.6, musl libc, Haiku >= hrev58760 */
   __freadptrinc (fp, increment);
 #elif defined _IO_EOF_SEEN || defined _IO_ftrylockfile || __GNU_LIBRARY__ == 1
   /* GNU libc, BeOS, Haiku < hrev58760, Linux libc5 */
   fp->_IO_read_ptr += increment;
 #elif defined __sferror || defined __DragonFly__ || defined __ANDROID__
   /* FreeBSD, NetBSD, OpenBSD < 7.6, DragonFly, Mac OS X, Cygwin, Minix 3, Android */
   fp_->_p += increment;
   fp_->_r -= increment;
 #elif defined __EMX__               /* emx+gcc */
   fp->_ptr += increment;
