From: OpenDesk AI <ai@opendesk.dev>
Date: Wed, 8 Apr 2026 19:15:00 +0800
Subject: [PATCH 3/3] Fix od.c fstat/lseek EACCES on HarmonyOS pipes

od's skip() function calls fstat() to determine file size before seeking.
On HarmonyOS, fstat() returns EACCES for pipes/terminals/sockets (same root
cause as patch 0002). This caused traditional offset formats (+1., +1.b)
to fail with "Permission denied" instead of falling back to read-based skip.

This is the same class of bug fixed in patch 0002 for cat/dd/head/sort/tail,
but od.c was missed in the original patch.

Fix: Add #ifdef __OHOS__ guard in the fstat failure path of skip(),
falling back to fread-based skipping when errno == EACCES || EPERM.

Tests verified:
  - tests/od/od.pl trad-dot1: FAIL → PASS (exit 1 → exit 0)
  - tests/od/od.pl trad-dot512: FAIL → PASS (exit 1 → exit 0)
  - Normal od operation unaffected (verified with `echo hello | od -c`)

--- a/src/od.c
+++ b/src/od.c
@@ -1193,6 +1193,23 @@ skip (intmax_t n_skip)
         }

+#ifdef __OHOS__
+      /* HarmonyOS returns EACCES for fstat on pipes/terminals/sockets.
+         Treat as non-seekable and fall through to read-based skip. */
+      else if (errno == EACCES || errno == EPERM)
+        {
+          char buf[BUFSIZ];
+          idx_t n_bytes_read, n_bytes_to_read = BUFSIZ;
+
+          while (0 < n_skip)
+            {
+              if (n_skip < n_bytes_to_read)
+                n_bytes_to_read = n_skip;
+              n_bytes_read = fread (buf, 1, n_bytes_to_read, in_stream);
+              n_skip -= n_bytes_read;
+              if (n_bytes_read != n_bytes_to_read)
+                {
+                  if (ferror (in_stream))
+                    {
+                      in_errno = errno;
+                      ok = false;
+                      n_skip = 0;
+                      break;
+                    }
+                  if (feof (in_stream))
+                    break;
+                }
+            }
+          if (n_skip == 0)
+            break;
+        }
+#endif
+
       else   /* cannot fstat() file */
         {
           error (0, errno, "%s", quotef (input_filename));
