# coreutils 9.10 - HarmonyOS 打包排除列表 (14个)
# 
# 类别 A: SELinux 软链接权限限制 (12个)
#   GNU 二进制运行在 u:object_r:hmdfs:s0，无法操作软链接
#   应使用 toybox 提供的替代版本

ln
link
unlink
realpath
readlink
ls
cp
mv
rm
stat
chmod
chown
chgrp

# 类别 B: HarmonyOS 系统兼容性 (2个)

# chroot: HarmonyOS 不支持 chroot syscall, Signal 31 core dump
chroot

# tac: >16KB 单行输入触发 double-free (musl libc xrealloc 兼容性问题)
#      常规用法正常, 可用 tail -r 替代
tac
