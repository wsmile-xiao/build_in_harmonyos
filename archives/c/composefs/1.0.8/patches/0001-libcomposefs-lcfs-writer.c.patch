--- a/libcomposefs/lcfs-writer.c
+++ b/libcomposefs/lcfs-writer.c
@@ -471,20 +471,26 @@
 
 	for (const char *it = list; it < list + list_size; it += strlen(it) + 1) {
 		ssize_t value_size;
 		cleanup_free char *value = NULL;
 
 		if (user_xattr && !str_has_prefix(it, "user."))
 			continue;
 
