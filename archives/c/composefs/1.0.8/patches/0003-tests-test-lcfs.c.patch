 static ssize_t write_cb(void *_file, void *buf, size_t count)
 {
 	FILE *file = _file;
 
 	return fwrite(buf, 1, count, file);
 }
 
 static int testwrite_node(struct lcfs_node_s *node)
 {
-	char *bufp = NULL;
-	size_t bufsz = 0;
-	FILE *buf = open_memstream(&bufp, &bufsz);
+	// open_memstream deterministically crashes the test binary on the
+	// HarmonyOS PC toolchain (clang 15, SIGSEGV/SIGILL at every -O level);
+	// write to a real temp file instead, preserving the EROFS write semantics.
+	const char *tmpdir = getenv("TMPDIR");
+	char tmpname[512];
+
+	if (tmpdir == NULL)
+		tmpdir = "/tmp";
+	snprintf(tmpname, sizeof(tmpname), "%s/lcfs-write.XXXXXX", tmpdir);
+	int tmpfd = mkstemp(tmpname);
+	if (tmpfd < 0)
+		return -1;
+	FILE *buf = fdopen(tmpfd, "w");
+	if (buf == NULL)
+		return -1;
 
 	struct lcfs_write_options_s options = { 0 };
 	options.format = LCFS_FORMAT_EROFS;
 	options.version = 1;
 	options.max_version = 1;
 	options.file = buf;
 	options.file_write_cb = write_cb;
 
 	int r = lcfs_write_to(node, &options);
 	int saved_errno = errno;
 	fclose(buf);
-	free(bufp);
+	unlink(tmpname);
 	errno = saved_errno;
 	return r;
 }
 
 static void test_basic(void)
