 # This must be Linux ELF.
-linux-gnu*)
+# OHOS is Linux ELF as far as libtool is concerned: its triplet is
+# <arch>-<vendor>-linux-ohos, which libtool 1.4.3 does not know about, so
+# without this pattern can_build_shared ends up "no" and the dlopen()ed
+# plugins of src/plugins/ would be built as static archives.
+linux-gnu* | linux-ohos*)
