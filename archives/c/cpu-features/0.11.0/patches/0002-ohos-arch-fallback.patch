--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -71,6 +71,27 @@
 set(PROCESSOR_IS_RISCV FALSE)
 set(PROCESSOR_IS_LOONGARCH FALSE)
 
+# OHOS/HarmonyOS: CMAKE_SYSTEM_NAME=HarmonyOS 无 CMake 平台模块，
+# CMAKE_SYSTEM_PROCESSOR 为 unknown；设备 CMake 的 host 探测在沙箱
+# /proc 受限时同样返回 unknown（CI #43920 实测回落 host 无效）。
+# 改用 uname -m 兜底，仍失败则按本包唯一目标平台定 aarch64。
+if(NOT CMAKE_SYSTEM_PROCESSOR OR CMAKE_SYSTEM_PROCESSOR STREQUAL "unknown")
+  execute_process(COMMAND uname -m OUTPUT_VARIABLE _ohos_arch
+                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
+  if(NOT _ohos_arch OR _ohos_arch STREQUAL "unknown")
+    set(_ohos_arch "aarch64")
+  endif()
+  set(CMAKE_SYSTEM_PROCESSOR "${_ohos_arch}")
+endif()
+
+# 同根因：HarmonyOS 无平台模块 → UNIX 变量未置位，if(UNIX) 守护的
+# unix_based_hardware_detection(hwcaps.c) 不进构建，链接报
+# CpuFeatures_GetHardwareCapabilities/IsHwCapsSet 未定义（CI #43951 实测）。
+# OHOS 设备是 musl/clang 的 Unix 环境，显式置位。
+if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+  set(UNIX TRUE)
+endif()
+
 if(CMAKE_SYSTEM_PROCESSOR MATCHES "^mips")
   set(PROCESSOR_IS_MIPS TRUE)
 elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "(^aarch64)|(^arm64)|(^ARM64)")
