+static gchar *
+phodav_uuid_string_random (void)
+{
+  const guint32 first = g_random_int ();
+  const guint32 second = g_random_int ();
+  const guint32 third = g_random_int ();
+  const guint32 fourth = g_random_int ();
+
+  return g_strdup_printf ("%08x-%04x-%04x-%04x-%04x%08x",
+                          first,
+                          (second >> 16) & 0xffff,
+                          (second & 0x0fff) | 0x4000,
+                          (third & 0x3fff) | 0x8000,
+                          (third >> 16) & 0xffff,
+                          fourth);
+}
