+++ cryptominisat-5.14.4.work/src/alg.h	2026-05-20 16:52:46.581787031 +0800
@@ -32,7 +32,12 @@
 template<class V, class T>
 static inline void remove(V& ts, const T& t)
 {
+    /* HarmonyOS: libcxx (clang 15) 不完整支持 std::ranges::find */
+#ifdef __OHOS__
+    auto it = std::find(ts.begin(), ts.end(), t);
+#else
     auto it = std::ranges::find(ts, t);
+#endif
     assert(it != ts.end());
     std::move(it + 1, ts.end(), it);
     ts.resize(ts.size() - 1);
