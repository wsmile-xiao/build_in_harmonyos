--- a/auth.c
+++ b/auth.c
@@ -17,6 +17,80 @@
                         /* fichier de configuration */
 #include "conf.h"
 
+#ifndef HAVE_GETPASSPHRASE
+/*
+ * Fallback for libc without getpass(3) (e.g. musl-based OHOS).
+ *
+ * get_user_passwd() in this file calls getpass() exactly when
+ * HAVE_GETPASSPHRASE is undefined, so the fallback must exist in
+ * that case: the guard therefore tracks the call site, not the
+ * function name. Marked weak: if the platform libc provides a
+ * strong getpass() symbol, the linker prefers it and this body is
+ * only used when the symbol is absent.
+ */
+#include <termios.h>
+
+__attribute__((weak))
+char * getpass (const char * prompt)
+{
+    static char buffer[256];
+    static char line[512];
+    size_t line_len = 0;
+    int fd, ok = 1;
+    struct termios saved, noecho;
+
+    if (prompt != NULL)
+        fprintf (stderr, "%s", prompt);
+    fflush (stderr);
+
+    fd = open ("/dev/tty", O_RDONLY | O_NOCTTY);
+    if (fd >= 0)
+    {
+        if (tcgetattr (fd, &saved) == 0)
+        {
+            noecho = saved;
+            noecho.c_lflag &= ~((tcflag_t) ECHO);
+            if (tcsetattr (fd, TCSAFLUSH, &noecho) != 0)
+                ok = 0;
+        }
+        else
+            ok = 0;
+    }
+    else
+    {
+        fd = 0;
+        ok = 0;
+    }
+
+    while (line_len < sizeof (line) - 1)
+    {
+        char c;
+        ssize_t r = read (fd, &c, 1);
+        if (r <= 0)
+            break;
+        if (c == '\n' || c == '\r')
+            break;
+        line [line_len++] = c;
+    }
+    line [line_len] = '\0';
+
+    if (ok)
+    {
+        tcsetattr (fd, TCSAFLUSH, &saved);
+        fprintf (stderr, "\n");
+        close (fd);
+    }
+
+    if (line_len == 0)
+        return NULL;
+
+    strncpy (buffer, line, sizeof (buffer) - 1);
+    buffer [sizeof (buffer) - 1] = '\0';
+    memset (line, '\0', sizeof (line));
+    return buffer;
+}
+#endif /* !HAVE_GETPASSPHRASE */
+
 static int  pam_pwcheck (struct passwd *calife, char * user_to_be, \
                          char * user_pass, int l_size);
 static int  local_pwcheck (struct passwd *calife, char * user_to_be, \
