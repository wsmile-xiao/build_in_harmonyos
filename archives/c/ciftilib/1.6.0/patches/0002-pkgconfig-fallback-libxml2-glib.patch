diff --git a/cmake/Modules/Findglib.cmake b/cmake/Modules/Findglib.cmake
index 725586e..4dc3ec3 100644
--- a/cmake/Modules/Findglib.cmake
+++ b/cmake/Modules/Findglib.cmake
@@ -1,6 +1,16 @@
 
 #use pkg-config
 FIND_PACKAGE(PkgConfig)
+IF(NOT GLIB_FOUND)
+    PKG_CHECK_MODULES(PC_GLIB QUIET glib-2.0)
+    IF(PC_GLIB_FOUND)
+        FIND_PATH(glib_INCLUDE_DIR NAMES glib.h HINTS ${PC_GLIB_INCLUDEDIR} ${PC_GLIB_INCLUDE_DIRS})
+        FIND_PATH(glib_config_INCLUDE_DIR NAMES glibconfig.h HINTS ${PC_GLIB_INCLUDEDIR} ${PC_GLIB_INCLUDE_DIRS})
+        FIND_LIBRARY(glib_LIBRARY NAMES glib glib-2.0 HINTS ${PC_GLIB_LIBDIR} ${PC_GLIB_LIBRARY_DIRS})
+        INCLUDE(FindPackageHandleStandardArgs)
+        FIND_PACKAGE_HANDLE_STANDARD_ARGS(glib DEFAULT_MSG glib_LIBRARY glib_INCLUDE_DIR)
+    ENDIF()
+ENDIF()
 PKG_CHECK_MODULES(PC_GLIB glib-2.0)
 
 FIND_PATH(glib_INCLUDE_DIR NAMES glib.h HINTS ${PC_GLIB_INCLUDEDIR} ${PC_GLIB_INCLUDE_DIRS})
diff --git a/cmake/Modules/Findglibmm.cmake b/cmake/Modules/Findglibmm.cmake
index c9b9bef..819fc72 100644
--- a/cmake/Modules/Findglibmm.cmake
+++ b/cmake/Modules/Findglibmm.cmake
@@ -1,10 +1,62 @@
 
 IF(glibmm_FIND_REQUIRED)
-    FIND_PACKAGE(glib REQUIRED)
-    FIND_PACKAGE(sigc++ REQUIRED)
+    FIND_PACKAGE(glib QUIET)
+    IF(NOT GLIB_FOUND)
+        FIND_PACKAGE(PkgConfig QUIET)
+        IF(PKG_CONFIG_FOUND)
+            PKG_CHECK_MODULES(PC_GLIB_FALLBACK QUIET glib-2.0)
+            IF(PC_GLIB_FALLBACK_FOUND)
+                FIND_PATH(glib_INCLUDE_DIR NAMES glib.h HINTS ${PC_GLIB_FALLBACK_INCLUDEDIR} ${PC_GLIB_FALLBACK_INCLUDE_DIRS})
+                FIND_PATH(glib_config_INCLUDE_DIR NAMES glibconfig.h HINTS ${PC_GLIB_FALLBACK_INCLUDEDIR} ${PC_GLIB_FALLBACK_INCLUDE_DIRS})
+                FIND_LIBRARY(glib_LIBRARY NAMES glib glib-2.0 HINTS ${PC_GLIB_FALLBACK_LIBDIR} ${PC_GLIB_FALLBACK_LIBRARY_DIRS})
+                INCLUDE(FindPackageHandleStandardArgs)
+                FIND_PACKAGE_HANDLE_STANDARD_ARGS(glib DEFAULT_MSG glib_LIBRARY glib_INCLUDE_DIR)
+            ENDIF()
+        ENDIF()
+    ENDIF()
+    IF(NOT GLIB_FOUND)
+        FIND_PACKAGE(glib REQUIRED)
+    ENDIF()
+    FIND_PACKAGE(sigc++ QUIET)
+    IF(NOT sigc++_FOUND)
+        FIND_PACKAGE(PkgConfig QUIET)
+        IF(PKG_CONFIG_FOUND)
+            PKG_CHECK_MODULES(PC_SIGCXX_FALLBACK QUIET sigc++-2.0)
+            IF(PC_SIGCXX_FALLBACK_FOUND)
+                FIND_PATH(sigc++_INCLUDE_DIR NAMES sigc++/sigc++.h HINTS ${PC_SIGCXX_FALLBACK_INCLUDEDIR} ${PC_SIGCXX_FALLBACK_INCLUDE_DIRS})
+                FIND_LIBRARY(sigc++_LIBRARY NAMES sigc sigc-2.0 HINTS ${PC_SIGCXX_FALLBACK_LIBDIR} ${PC_SIGCXX_FALLBACK_LIBRARY_DIRS})
+            ENDIF()
+        ENDIF()
+    ENDIF()
+    IF(NOT sigc++_FOUND)
+        FIND_PACKAGE(sigc++ REQUIRED)
+    ENDIF()
 ELSE(glibmm_FIND_REQUIRED)
     FIND_PACKAGE(glib)
     FIND_PACKAGE(sigc++)
+    IF(NOT GLIB_FOUND)
+        FIND_PACKAGE(PkgConfig QUIET)
+        IF(PKG_CONFIG_FOUND)
+            PKG_CHECK_MODULES(PC_GLIB_FALLBACK QUIET glib-2.0)
+            IF(PC_GLIB_FALLBACK_FOUND)
+                FIND_PATH(glib_INCLUDE_DIR NAMES glib.h HINTS ${PC_GLIB_FALLBACK_INCLUDEDIR} ${PC_GLIB_FALLBACK_INCLUDE_DIRS})
+                FIND_PATH(glib_config_INCLUDE_DIR NAMES glibconfig.h HINTS ${PC_GLIB_FALLBACK_INCLUDEDIR} ${PC_GLIB_FALLBACK_INCLUDE_DIRS})
+                FIND_LIBRARY(glib_LIBRARY NAMES glib glib-2.0 HINTS ${PC_GLIB_FALLBACK_LIBDIR} ${PC_GLIB_FALLBACK_LIBRARY_DIRS})
+                INCLUDE(FindPackageHandleStandardArgs)
+                FIND_PACKAGE_HANDLE_STANDARD_ARGS(glib DEFAULT_MSG glib_LIBRARY glib_INCLUDE_DIR)
+            ENDIF()
+        ENDIF()
+    ENDIF()
+    IF(NOT sigc++_FOUND AND NOT SIGCXX_FOUND)
+        FIND_PACKAGE(PkgConfig QUIET)
+        IF(PKG_CONFIG_FOUND)
+            PKG_CHECK_MODULES(PC_SIGCXX_FALLBACK QUIET sigc++-2.0)
+            IF(PC_SIGCXX_FALLBACK_FOUND)
+                FIND_PATH(sigc++_INCLUDE_DIR NAMES sigc++/sigc++.h HINTS ${PC_SIGCXX_FALLBACK_INCLUDEDIR} ${PC_SIGCXX_FALLBACK_INCLUDE_DIRS})
+                FIND_LIBRARY(sigc++_LIBRARY NAMES sigc sigc-2.0 HINTS ${PC_SIGCXX_FALLBACK_LIBDIR} ${PC_SIGCXX_FALLBACK_LIBRARY_DIRS})
+            ENDIF()
+        ENDIF()
+    ENDIF()
 ENDIF(glibmm_FIND_REQUIRED)
 
 IF(GLIB_FOUND)
