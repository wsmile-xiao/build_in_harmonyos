+    if (!pool->is_packed && pool->alignment_boundary > 1) {
+        /* Keep free_ptr on the alignment boundary after this block so the
+           next allocation starts aligned. The naive `size % boundary`
+           padding does NOT guarantee alignment for arbitrary sizes. */
+        size_t mis = ((uintptr_t)(ptr + size)) % pool->alignment_boundary;
+        if (mis != 0) {
