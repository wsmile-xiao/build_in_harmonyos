# 上游 contribs-lib 无 install 规则且 EXCLUDE_FROM_ALL（chimera
# install_contribs_lib 同源）：补公共头与库安装、纳入默认构建；
# 另修 src/test 在 contribs-lib 之前 add_subdirectory 导致
# clucene-contribs-lib_SOURCE_DIR 未定义、contribs 测试 include 为空的
# 上游顺序缺陷（用顶层 clucene_SOURCE_DIR 显式指路径）。
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -163,7 +163,7 @@
   SET(BUILD_CONTRIBS_LIB 1)
 ENDIF ( BUILD_CONTRIBS )
 IF ( BUILD_CONTRIBS_LIB )
-  ADD_SUBDIRECTORY (src/contribs-lib EXCLUDE_FROM_ALL)
+  ADD_SUBDIRECTORY (src/contribs-lib)
 ENDIF ( BUILD_CONTRIBS_LIB )
 
 
--- a/src/test/CMakeLists.txt
+++ b/src/test/CMakeLists.txt
@@ -21,7 +21,7 @@
     SET(test_contribs_lib_files ./contribs-lib/analysis/de/TestGermanStemFilter.cpp)
     SET(EXTRA_LIBS ${EXTRA_LIBS} clucene-contribs-lib)
     ADD_DEFINITIONS(-DTEST_CONTRIB_LIBS)
-    INCLUDE_DIRECTORIES(${clucene-test_SOURCE_DIR} ${clucene-contribs-lib_SOURCE_DIR})
+    INCLUDE_DIRECTORIES(${clucene-test_SOURCE_DIR} ${clucene_SOURCE_DIR}/src/contribs-lib)
 	
     SOURCE_GROUP("contribs-lib" REGULAR_EXPRESSION ./contribs-lib/*)
     SOURCE_GROUP("contribs-lib\\analysis" REGULAR_EXPRESSION ./contribs-lib/analysis/*)
--- a/src/contribs-lib/CMakeLists.txt
+++ b/src/contribs-lib/CMakeLists.txt
@@ -112,3 +112,20 @@
     SOVERSION ${CLUCENE_SOVERSION}
     COMPILE_DEFINITIONS_DEBUG _DEBUG
 )
+
+#install public headers.
+FOREACH(file ${HEADERS})
+	get_filename_component(apath ${file} PATH)
+	get_filename_component(aname ${file} NAME)
+	file(RELATIVE_PATH relpath ${CMAKE_SOURCE_DIR}/src/contribs-lib ${apath})
+	IF ( NOT aname MATCHES "^_.*" )
+		install(FILES ${file}
+		        DESTINATION include/${relpath}
+		        COMPONENT development)
+	ENDIF ( NOT aname MATCHES "^_.*" )
+ENDFOREACH(file)
+
+#and install library
+install(TARGETS clucene-contribs-lib
+        DESTINATION ${LIB_DESTINATION}
+        COMPONENT runtime )
