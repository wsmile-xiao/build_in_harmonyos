 # endif
     memset (buffer, 0, sizeof (buffer));
-    strncpy (buffer, "/tmp/czmq_zfile.XXXXXX", sizeof(buffer)-1);
+    //  Honour TMPDIR when the platform has no writable /tmp (OHOS HMDFS
