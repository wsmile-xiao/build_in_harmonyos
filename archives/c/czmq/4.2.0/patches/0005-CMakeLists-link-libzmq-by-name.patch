--- a/CMakeLists.txt	2019-02-11 01:50:37.000000000 +0800
+++ b/CMakeLists.txt	2026-10-04 23:11:33.420857812 +0800
@@ -123,7 +123,14 @@
 find_package(libzmq REQUIRED)
 IF (LIBZMQ_FOUND)
     include_directories(${LIBZMQ_INCLUDE_DIRS})
-    list(APPEND MORE_LIBRARIES ${LIBZMQ_LIBRARIES})
+    #  Link libzmq by name (-lzmq) plus -L instead of by absolute path: the
+    #  OHOS libzmq package ships no DT_SONAME, so linking the full .so path
+    #  records an absolute DT_NEEDED entry and makes CMake export
+    #  IMPORTED_NO_SONAME TRUE into the installed czmqTargets.cmake, both of
+    #  which break downstream consumers (CI L5b/L5c gates).
+    get_filename_component (LIBZMQ_LIBRARY_DIR "${LIBZMQ_LIBRARIES}" DIRECTORY)
+    link_directories (${LIBZMQ_LIBRARY_DIR})
+    list(APPEND MORE_LIBRARIES zmq)
   IF (PC_LIBZMQ_FOUND)
       set(pkg_config_names_private "${pkg_config_names_private} libzmq")
       list(APPEND OPTIONAL_LIBRARIES_STATIC ${PC_LIBZMQ_STATIC_LDFLAGS})
