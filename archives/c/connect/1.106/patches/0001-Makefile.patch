diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,25 +1,27 @@
-### Makefile 
+### Makefile
 ###
 ### Create:   2009-12-17
 ### Updated:  2012-06-21
-### 
+###
 
 ifeq ($(OS), Windows_NT)
     UNAME := Windows
 else
     UNAME := $(shell uname -s)
 endif
 
-CC=gcc
-CFLAGS=-DSOCKLEN_T=unsigned
+CC?=clang
+CFLAGS?=-DSOCKLEN_T=unsigned -fPIC -O2
 LDLIBS=
+PREFIX ?= /usr/local
+DESTDIR ?=
 
 ## for Mac OS X environment, use one of options
 ifeq ($(UNAME), Darwin)
 	CFLAGS=-DBIND_8_COMPAT=1 -DSOCKLEN_T=socklen_t
 	LDLIBS=-lresolv
 endif
 
 ## for Solaris
 ifeq ($(UNAME), SunOS)
 	LDLIBS=-lresolv -lsocket -lnsl
@@ -40,11 +42,16 @@
 connect.o: connect.c
 
 ##
 
 clean:
 	rm -f connect.o *~
 veryclean: clean
 	rm -f connect connect.exe
 rebuild: veryclean all
 
+install: connect
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	cp connect $(DESTDIR)$(PREFIX)/bin/connect
+	chmod 755 $(DESTDIR)$(PREFIX)/bin/connect
+
 ### End of Makefile
