#!/bin/sh
# connect has no configure script — this is a no-op wrapper for clean-verify
# connect uses a simple Makefile without autotools/configure
# Build command: make CC=clang CFLAGS="-DSOCKLEN_T=unsigned -fPIC -O2"
# Install: make install DESTDIR=...
echo "Note: connect uses Makefile with install target, no configure needed"
exit 0