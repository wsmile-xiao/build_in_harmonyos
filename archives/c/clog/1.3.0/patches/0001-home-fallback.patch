+    // Locate $HOME. getpwuid() returns NULL for users without a passwd
+    // entry (seen on HarmonyOS preflight: every invocation, including
+    // --version/--help, aborted with "Could not determine the home
+    // directory."). Fall back to $HOME so --version/--help and -f <rc>
+    // keep working; only the default ~/.clogrc path needs one of them.
+    std::string rcFile;
+    {
+      struct passwd* pw = getpwuid (getuid ());
+      if (pw)
+      {
+        rcFile = pw->pw_dir;
+        rcFile += "/.clogrc";
+      }
+      else
+      {
+        const char* home = getenv ("HOME");
+        if (home && *home)
+        {
+          rcFile = home;
+          rcFile += "/.clogrc";
+        }
+      }
+    }
 
