From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NebulaAGI <gyccc@gitcode.com>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] 0001 cmake ohos minimal build without c4Project

Replace upstream CMakeLists that depends on ext/c4core/cmake/c4Project.cmake
with a minimal standalone CMake that builds c4core and c4log directly.
This avoids recursive submodule fetches (c4core/cmake -> biojppm/cmake)
and enables native OHOS aarch64 build.

---
 CMakeLists.txt | 83 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 83 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1111111..2222222 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,26 +1,83 @@
-cmake_minimum_required(VERSION 3.12)
-project(c4log
-    DESCRIPTION "C++ logging utilities"
-    HOMEPAGE_URL "https://github.com/biojppm/c4log/")
-include(./ext/c4core/cmake/c4Project.cmake)
-c4_project(VERSION 0.0.1
-    AUTHOR "Joao Paulo Magalhaes <dev@jpmag.me>")
-
-c4_require_subproject(c4core
-    SUBDIRECTORY ${C4LOG_EXT_DIR}/c4core)
-
-c4_add_library(c4log
-    SOURCE_ROOT ${C4LOG_SRC_DIR}
-    SOURCES
-      c4/log/export.hpp
-      c4/log/log.hpp
-      c4/log/log.cpp
-    LIBS c4core
-    INC_DIRS
-       $<BUILD_INTERFACE:${C4LOG_SRC_DIR}> $<INSTALL_INTERFACE:include>
-    )
-
-c4_install_target(c4log)
-c4_install_exports()
-
-c4_add_dev_targets()
+cmake_minimum_required(VERSION 3.15)
+project(c4log VERSION 1.0.0 LANGUAGES CXX)
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+# --- c4core sources (header + compiled) ---
+set(C4CORE_SRC_DIR ${CMAKE_CURRENT_SOURCE_DIR}/ext/c4core/src)
+set(C4CORE_SOURCES
+    ${C4CORE_SRC_DIR}/c4/base64.cpp
+    ${C4CORE_SRC_DIR}/c4/char_traits.cpp
+    ${C4CORE_SRC_DIR}/c4/error.cpp
+    ${C4CORE_SRC_DIR}/c4/format.cpp
+    ${C4CORE_SRC_DIR}/c4/language.cpp
+    ${C4CORE_SRC_DIR}/c4/memory_resource.cpp
+    ${C4CORE_SRC_DIR}/c4/memory_util.cpp
+    ${C4CORE_SRC_DIR}/c4/utf.cpp
+    ${C4CORE_SRC_DIR}/c4/version.cpp
+)
+
+add_library(c4core ${C4CORE_SOURCES})
+target_include_directories(c4core PUBLIC
+    $<BUILD_INTERFACE:${C4CORE_SRC_DIR}>
+    $<INSTALL_INTERFACE:include>
+)
+target_compile_features(c4core PUBLIC cxx_std_17)
+set_target_properties(c4core PROPERTIES
+    CXX_VISIBILITY_PRESET hidden
+    VISIBILITY_INLINES_HIDDEN ON
+)
+
+# --- c4log ---
+set(C4LOG_SRC_DIR ${CMAKE_CURRENT_SOURCE_DIR}/src)
+add_library(c4log ${C4LOG_SRC_DIR}/c4/log/log.cpp)
+target_include_directories(c4log PUBLIC
+    $<BUILD_INTERFACE:${C4LOG_SRC_DIR}>
+    $<BUILD_INTERFACE:${C4CORE_SRC_DIR}>
+    $<INSTALL_INTERFACE:include>
+)
+target_link_libraries(c4log PUBLIC c4core)
+target_compile_features(c4log PUBLIC cxx_std_17)
+set_target_properties(c4log PROPERTIES
+    CXX_VISIBILITY_PRESET hidden
+    VISIBILITY_INLINES_HIDDEN ON
+)
+
+# --- install ---
+include(GNUInstallDirs)
+install(TARGETS c4core c4log
+    EXPORT c4logTargets
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+)
+install(DIRECTORY ${C4LOG_SRC_DIR}/c4
+    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+    FILES_MATCHING PATTERN "*.hpp" PATTERN "*.h"
+)
+install(DIRECTORY ${C4CORE_SRC_DIR}/c4
+    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+    FILES_MATCHING PATTERN "*.hpp" PATTERN "*.h"
+)
+install(EXPORT c4logTargets
+    FILE c4logTargets.cmake
+    NAMESPACE c4log::
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/c4log
+)
+include(CMakePackageConfigHelpers)
+write_basic_package_version_file(
+    "${CMAKE_CURRENT_BINARY_DIR}/c4logConfigVersion.cmake"
+    VERSION ${PROJECT_VERSION}
+    COMPATIBILITY SameMajorVersion
+)
+# Generate minimal c4logConfig.cmake so find_package(c4log CONFIG) works without Conan
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/c4logConfig.cmake"
+"@PACKAGE_INIT@\n"
+"include(\"\${CMAKE_CURRENT_LIST_DIR}/c4logTargets.cmake\")\n"
+"check_required_components(c4log)\n"
+)
+install(FILES
+    "${CMAKE_CURRENT_BINARY_DIR}/c4logConfig.cmake"
+    "${CMAKE_CURRENT_BINARY_DIR}/c4logConfigVersion.cmake"
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/c4log
+)
