@@ -19,6 +19,7 @@

 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 #include <unistd.h>
 #ifdef HAVE_GETOPT_H
 #include <getopt.h>
@@ -44,6 +45,22 @@ static struct option long_options[] =
 #  define GETOPT_LONG(argc,argv,optstr,lopts,lidx) getopt(argc,argv,optstr)
 #endif /* not HAVE_GETOPT_LONG */

+#ifndef HAVE_GETOPT_LONG
+/* OHOS libc may provide getopt but not the complete struct option API. */
+static char *
+normalize_long_option(const char *option)
+{
+  if (strcmp(option, "--convert") == 0) return "-c";
+  if (strcmp(option, "--delete") == 0) return "-d";
+  if (strcmp(option, "--help") == 0) return "-h";
+  if (strcmp(option, "--keepgoing") == 0) return "-k";
+  if (strcmp(option, "--list") == 0) return "-l";
+  if (strcmp(option, "--replace") == 0) return "-r";
+  if (strcmp(option, "--version") == 0) return "-v";
+  return (char *)option;
+}
+#endif
+
 static void
 usage(char *progname)
 {
@@ -77,6 +94,17 @@ main(int argc, char * const argv[])
   int keep_going = 0;   /* Break on first error, or keep going? */
   char *newpath = NULL; /* insert this path */
   int opt;
+  char * const *parse_argv = argv;
+#ifndef HAVE_GETOPT_LONG
+  char **normalized_argv = calloc((size_t)argc + 1, sizeof(*normalized_argv));
+  int arg_index;
+  if (normalized_argv == NULL)
+    return 2;
+  for (arg_index = 0; arg_index < argc; ++arg_index)
+    normalized_argv[arg_index] = normalize_long_option(argv[arg_index]);
+  normalized_argv[argc] = NULL;
+  parse_argv = normalized_argv;
+#endif
