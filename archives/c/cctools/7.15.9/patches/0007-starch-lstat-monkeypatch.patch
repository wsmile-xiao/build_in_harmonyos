@@ -11,6 +11,18 @@
 import platform
 import sys
 
+# HarmonyOS: lstat() on /system/bin/* returns EACCES (SELinux policy).
+# tarfile.gettarinfo() internally calls os.lstat(name). Patch os.lstat to
+# fall back to os.stat when lstat raises PermissionError, so that
+# self-extraction of system binaries (date, etc.) still works.
+_os_lstat_orig = os.lstat
+def _os_lstat_safe(name, *args, **kwargs):
+    try:
+        return _os_lstat_orig(name, *args, **kwargs)
+    except PermissionError:
+        return os.stat(name, *args, **kwargs)
+os.lstat = _os_lstat_safe
+
 from optparse   import OptionParser
