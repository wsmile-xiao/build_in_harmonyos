--- a/configure	2025-10-02 20:41:41.000000000 +0800
+++ b/configure	2026-09-01 10:00:00.000000000 +0800
@@ -48,6 +48,11 @@
 BUILD_DATE="$NOW"
 BUILD_HOST="$(uname -n)"
 BUILD_SYS="$(uname -s | tr \[a-z\] \[A-Z\] | awk -F_ '{print $1}')"
+# HarmonyOS is Linux-compatible (glibc/musl, aarch64). Treat as LINUX.
+if [ "$BUILD_SYS" = "HARMONYOS" ]
+then
+	BUILD_SYS=LINUX
+fi
 BUILD_USER="$USER"
 
 if [ "$BUILD_CPU" = UNKNOWN ]
@@ -97,6 +102,15 @@
 
 ccompiler=${CC:-gcc}
 cxxcompiler=${CXX:-g++}
+# Fall back to clang/clang++ when the default gcc/g++ is not on PATH.
+# HarmonyOS ships clang at /data/service/hnp/bin/clang and has no gcc.
+# $CC/$CXX (if set, e.g. by the Conan toolchain env) take priority.
+if ! command -v "$ccompiler" >/dev/null 2>&1 && command -v clang >/dev/null 2>&1; then
+	ccompiler=clang
+fi
+if ! command -v "$cxxcompiler" >/dev/null 2>&1 && command -v clang++ >/dev/null 2>&1; then
+	cxxcompiler=clang++
+fi
 linker="${ccompiler}"
 
 ccflags="${CFLAGS} -D__EXTENSIONS__ -D_LARGEFILE64_SOURCE -D__LARGE64_FILES -Wall -Wextra -Wno-unused-result -fPIC"
@@ -444,7 +458,7 @@
 
 		# Building in Conda generates a whole lot of spurious warnings while finding the right library.
 		# Suppress those warnings.
-		ldflags="${ldflags} -Wl,--no-warn-search-mismatch"
+		# ldflags="${ldflags} -Wl,--no-warn-search-mismatch"  # disabled: LLD does not support this flag
 
 elif [ $BUILD_SYS != DARWIN ]
 then
