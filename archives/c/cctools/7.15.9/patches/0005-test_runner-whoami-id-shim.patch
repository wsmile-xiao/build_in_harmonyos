--- a/dttools/test/test_runner_common.sh	2025-10-02 20:41:41.000000000 +0800
+++ b/dttools/test/test_runner_common.sh	2026-08-31 23:05:43.876039531 +0800
@@ -2,6 +2,24 @@
 
 export CC=${CC:-gcc}
 
+# HarmonyOS compatibility shims:
+# - `whoami` not available -> fall back to $USER (sh builtin)
+# - `id -u`/`id -un` not available -> fall back to $UID / $USER
+# - `/tmp` read-only (E002) -> tests should use the current dir or $TMPDIR
+if ! command -v whoami >/dev/null 2>&1; then
+    whoami() { printf '%s\n' "${USER:-nobody}"; }
+fi
+if ! command -v id >/dev/null 2>&1; then
+    id() {
+        case "$1" in
+            -u)  printf '%s\n' "${UID:-65534}" ;;
+            -un) printf '%s\n' "${USER:-nobody}" ;;
+            "")  printf '%s\n' "${UID:-65534}" ;;
+            *)   printf '%s\n' "${UID:-65534}" ;;
+        esac
+    }
+fi
+
 # Tests sometimes chdir, so we get the full path now. `pwd` is annoying to portable.
 WORK_QUEUE_WORKER=$(cd "$(dirname "$0")/../../work_queue/src/"; pwd)/work_queue_worker
 TASKVINE_WORKER=$(cd "$(dirname "$0")/../../taskvine/src/worker"; pwd)/vine_worker
