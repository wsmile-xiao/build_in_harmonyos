 chirp_start() {
-	if [ "$(id -u)" -eq 0 ]; then
-		test_dir=`mktemp -d /tmp/chirp.test_dir.XXXXXX`
+	# HarmonyOS: `id`/`whoami` unavailable, `/tmp` read-only.
+	# Use $UID (sh builtin) for root check, $USER for ACL subject,
+	# and create test_dir in the current working directory (writable).
+	_uid="${UID:-$(id -u 2>/dev/null || echo 65534)}"
+	_user="${USER:-$(whoami 2>/dev/null || echo nobody)}"
+	if [ "$_uid" = 0 ]; then
+		test_dir=`mktemp -d chirp.test_dir.XXXXXX`
 	else
 		test_dir=`mktemp -d chirp.test_dir.XXXXXX`
 	fi
@@ -42,7 +47,7 @@
 	mkdir -p "$transient"
 	shift
 
-	if [ "$(id -u)" -eq 0 ]; then
+	if [ "$_uid" = 0 ]; then
 		verbose chown -R 9999 "$test_dir"
 		user_opt="--user=9999"
 	fi
@@ -53,7 +58,7 @@
 		cat "${DEFAULT_ACL}" >> "$acl"
 	else
 		cat >> "$acl" <<EOF
-unix:$(whoami) rwlda
+unix:$_user rwlda
 unix:root rwlda
 address:127.0.0.1 rl
 EOF
@@ -89,7 +94,7 @@
 
 chirp_clean() {
 	set +e
-	for pid in ./chirp.test_dir.*/chirp.pid /tmp/chirp.test_dir.*/chirp.pid; do
+	for pid in ./chirp.test_dir.*/chirp.pid; do
 		if [ -e "$pid" ]
 		then
 			pid=$(cat "$pid")
@@ -99,7 +104,7 @@
 			fi
 		fi
 	done
-	verbose rm -rf ./chirp.test_dir.* /tmp/chirp.test_dir.*
+	verbose rm -rf ./chirp.test_dir.*
 	return 0
 }
 
