diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,49 @@
+#!/bin/sh
+# Configure script for cowsay Node.js package
+# This script creates a minimal configuration for the Makefile
+
+PREFIX="/storage/Users/currentUser/usr/local"
+
+# Parse arguments
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*)
+            PREFIX="${1#--prefix=}"
+            ;;
+        --help)
+            echo "Usage: ./configure [OPTIONS]"
+            echo ""
+            echo "Options:"
+            echo "  --prefix=PREFIX    Installation prefix (default: /storage/Users/currentUser/usr/local)"
+            echo ""
+            echo "This is a Node.js package that requires Node.js runtime to execute."
+            echo "The installation will place files in lib/node_modules/cowsay/"
+            exit 0
+            ;;
+        *)
+            echo "Warning: Unknown option $1"
+            ;;
+    esac
+    shift
+done
+
+echo "Configuring cowsay 1.5.0..."
+echo ""
+echo "Installation prefix: $PREFIX"
+echo ""
+
+# Create config.status file
+cat > config.status << EOF
+#!/bin/sh
+# Configuration status
+PREFIX='$PREFIX'
+EOF
+
+echo "✅ Configuration complete"
+echo ""
+echo "Next steps:"
+echo "  make        - Build the package"
+echo "  make install - Install to $PREFIX"
+echo "  make check   - Run tests (requires Node.js)"
+echo ""
+echo "Note: This package requires Node.js runtime to execute."