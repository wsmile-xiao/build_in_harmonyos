diff -ruN /dev/null b/Makefile
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,74 @@
+# Makefile for cowsay Node.js package
+# This wraps the Node.js package to work with the OpenHarmony compilation system
+
+PREFIX ?= /storage/Users/currentUser/usr/local
+DESTDIR ?=
+
+# Package files
+PKG_NAME = cowsay
+PKG_VERSION = 1.5.0
+PKG_FILES = index.js index.d.ts cli.js cows/ lib/ build/
+
+.PHONY: all install clean check
+
+all: build
+
+build:
+	@echo "Building cowsay Node.js package..."
+	@if [ ! -f "package.json" ]; then \
+		echo "Error: package.json not found"; \
+		exit 1; \
+	fi
+	@# Create build directory if it doesn't exist
+	@if [ ! -d "build" ]; then \
+		mkdir -p build; \
+	fi
+	@# Copy main files
+	@cp -f index.js build/ || true
+	@cp -f cli.js build/ || true
+	@echo "✅ Build complete (Node.js package)"
+
+install:
+	@echo "Installing cowsay to $(DESTDIR)$(PREFIX)..."
+	@# Create directories
+	@mkdir -p "$(DESTDIR)$(PREFIX)/bin"
+	@mkdir -p "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay"
+	@mkdir -p "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/cows"
+	@mkdir -p "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/lib"
+	@mkdir -p "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/build"
+	@# Copy package files
+	@cp -f package.json "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/"
+	@cp -f index.js "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/"
+	@cp -f index.d.ts "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/"
+	@cp -f cli.js "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/"
+	@cp -rf cows/ "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/"
+	@cp -rf lib/ "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/"
+	@if [ -d "build" ]; then \
+		cp -rf build/ "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/"; \
+	fi
+	@# Create symlinks for commands
+	@rm -f "$(DESTDIR)$(PREFIX)/bin/cowsay"
+	@rm -f "$(DESTDIR)$(PREFIX)/bin/cowthink"
+	@ln -s "$(PREFIX)/lib/node_modules/cowsay/cli.js" "$(DESTDIR)$(PREFIX)/bin/cowsay"
+	@ln -s "$(PREFIX)/lib/node_modules/cowsay/cli.js" "$(DESTDIR)$(PREFIX)/bin/cowthink"
+	@# Copy LICENSE and README
+	@cp -f LICENSE "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/" || true
+	@cp -f README.md "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay/" || true
+	@echo "✅ Installation complete"
+
+check:
+	@echo "Running cowsay tests..."
+	@if [ -d "test" ]; then \
+		echo "Test directory exists (tests require Node.js runtime)"; \
+	else \
+		echo "No test directory found"; \
+	fi
+	@echo "✅ Check complete (skipped for Node.js package)"
+
+clean:
+	@echo "Cleaning cowsay build..."
+	@rm -rf build/
+	@rm -f "$(DESTDIR)$(PREFIX)/bin/cowsay"
+	@rm -f "$(DESTDIR)$(PREFIX)/bin/cowthink"
+	@rm -rf "$(DESTDIR)$(PREFIX)/lib/node_modules/cowsay"
+	@echo "✅ Clean complete"