diff -ruN a/config.guess b/config.guess
--- a/config.guess
+++ b/config.guess
@@ -824,20 +824,23 @@
     *:GNU:*:*)
 	# the GNU system
 	echo `echo ${UNAME_MACHINE}|sed -e 's,[-/].*$,,'`-unknown-gnu`echo ${UNAME_RELEASE}|sed -e 's,/.*$,,'`
 	exit ;;
     *:GNU/*:*:*)
