--- a/tests/101_test_qemubuilder_dumpconfig.sh
+++ b/tests/101_test_qemubuilder_dumpconfig.sh
@@ -1,10 +1,15 @@
 #!/usr/bin/env bash
 # check qemubuilder commnad-line option parsing.
 #
-# Apparently, this test requires config files to exist in order not to
-# die of error, so we need to have qemubuilder installed.
+# This test requires pbuilder config files to exist (BUILDPLACE + qemu options),
+# otherwise qemubuilder aborts with "Couldn't load any valid config file."
 set -ex
 
-[ "$(./qemubuilder --dumpconfig --inputfile one --inputfile two | grep inputfile)" = \
+# create a temporary HOME with a minimal pbuilderrc so qemubuilder can parse
+TMPHOME=$(mktemp -d)
+trap 'rm -rf "$TMPHOME"' EXIT
+printf 'BUILDPLACE="/tmp/qemubuilder-build"\nARCHITECTURE="amd64"\n' > "$TMPHOME/.pbuilderrc"
+
+[ "$(HOME="$TMPHOME" ./qemubuilder --dumpconfig --inputfile one --inputfile two | grep inputfile)" = \
 "  inputfile[0]: one
   inputfile[1]: two" ]
