@@ -8,9 +8,18 @@
 #include <sys/types.h>
 #include "file.h"
 #include "parameter.h"
+#include <stdio.h>
+
+/* OHOS: /tmp is read-only erofs; use $TMPDIR when available (POSIX). */
+#define TMPDIR_TEMPLATE(base, suffix) \
+	do { const char *_td = getenv("TMPDIR"); \
+	     snprintf((base), sizeof(base), "%s/" suffix, \
+	              (_td && *_td) ? _td : "/tmp"); } while (0)
+
 
 void test_copy_file() {
-	char *temp = strdupa("/tmp/testfileXXXXXX");
+	char temp[256];
+	TMPDIR_TEMPLATE(temp, "testfileXXXXXX");
 	mkstemp(temp);
 	assert(copy_file("/proc/mounts", temp) == 0);
 	assert(forkexeclp("diff", "diff", "-u", "/proc/mounts", temp, NULL) == 0);
@@ -18,7 +27,8 @@
 }
 
 void test_create_sparse_file() {
-	char *temp = strdupa("/tmp/sparseXXXXXX");
+	char temp[256];
+	TMPDIR_TEMPLATE(temp, "sparseXXXXXX");
 	mkstemp(temp);
 	assert(create_sparse_file(temp, 18UL * 1UL << 30UL) == 0);
 }
