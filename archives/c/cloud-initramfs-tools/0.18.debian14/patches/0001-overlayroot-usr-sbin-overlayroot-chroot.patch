+# Resolve and run a command portably.
+# On systems whose userland is provided by a multi-call binary (e.g. the
+# Toybox/HarmonyOS PC userland ships no standalone install(1)/umount(1)/
+# chroot(1) entries), the plain command name may not exist even though the
+# applet is available.  Prefer the plain command -- identical behaviour to
+# upstream on a complete system -- and fall back to the busybox multi-call
+# form when the name is not exposed.
+xcmd() {
+	local _cmd="$1"
+	shift
+	if command -v "${_cmd}" >/dev/null 2>&1; then
+		"${_cmd}" "$@"
+	elif command -v busybox >/dev/null 2>&1; then
+		busybox "${_cmd}" "$@"
+	else
+		fail "Required command not available: ${_cmd}"
+	fi
+}
