diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,16 +1,17 @@
 # Makefile for CSPICE Toolkit - cross-platform build
 # Based on NAIF standard Makefile structure
 
 CC ?= cc
 AR ?= ar
-CFLAGS ?= -O2 -ansi -I./include
+CFLAGS ?= -O2 -ansi
+INCLUDES = -I./include
 ARFLAGS = r
 
 SRC_DIR = src
 INCLUDE_DIR = include
 LIB_DIR = lib
 BIN_DIR = bin
 
 # Collect all .c files from src/
 SRCS = $(wildcard $(SRC_DIR)/*.c)
 OBJS = $(SRCS:.c=.o)
@@ -20,21 +21,21 @@
 .PHONY: all clean install check
 
 all: $(LIB)
 
 $(LIB): $(OBJS)
 	@mkdir -p $(LIB_DIR)
 	$(AR) $(ARFLAGS) $@ $^
 	ranlib $@
 
 %.o: %.c
-	$(CC) $(CFLAGS) -c $< -o $@
+	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@
 
 install:
 	@mkdir -p $(DESTDIR)$(PREFIX)/lib
 	@mkdir -p $(DESTDIR)$(PREFIX)/include
 	cp $(LIB) $(DESTDIR)$(PREFIX)/lib/
 	cp $(INCLUDE_DIR)/*.h $(DESTDIR)$(PREFIX)/include/
 
 check:
 	@echo "No standard test suite for cspice; building a smoke test..."
 	@echo "Build successful - cspice.a created"
