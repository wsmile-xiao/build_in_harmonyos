diff -ruN a/makefiles/install.zuo b/makefiles/install.zuo
--- a/makefiles/install.zuo
+++ b/makefiles/install.zuo
@@ -173,23 +173,23 @@
   (define (I . args)
     (apply shell/wait*
            (list* (at-source* "./installsh")
                   "-o" (quoted* InstallOwner) "-g" (quoted* InstallGroup)
                   args)))
   (define (rm-f f)
     (shell/wait* "rm" "-f" f))
   (define (rm-rf d)
     (shell/wait* "rm" "-rf" d))
   (define (ln-f from to)
-    (shell/wait* "ln" "-f" from to))
+    (shell/wait* "cp" from to))
   (define (ln-s from to)
-    (shell/wait* "ln" "-s" from to))
+    (shell/wait* "cp" from to))
 
   (when (or (not uninstall?) script-to)
     (when script-to (out "\ninstall:"))
     (for-each (lambda (d)
                 (I "-d" "-m" "755" d))
               (list Lib LibBin LibExamples Bin Man))
 
     ;; bin
     (rm-f SchemePath)
     (rm-f PetitePath)
