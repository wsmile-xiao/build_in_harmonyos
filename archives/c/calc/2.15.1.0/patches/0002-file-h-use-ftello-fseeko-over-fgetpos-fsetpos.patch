--- a/file.h
+++ b/file.h
@@ -73,7 +73,12 @@
  */
 #if defined(HAVE_FGETSETPOS)

-#define f_seek_set(stream, loc) fsetpos((FILE*)(stream), (FILEPOS*)(loc))
-#define f_tell(stream, loc) fgetpos((FILE*)(stream), (FILEPOS*)(loc))
+/* Use ftello/fseeko with off_t* instead of fgetpos/fsetpos with fpos_t*.
+   fpos_t is a struct on musl libc (HarmonyOS), causing huge garbage values
+   when interpreted as integer.  FILEPOS is typedef'd as off_t, which is
+   always a 64-bit integer. */
+#define f_seek_set(stream, loc) \
+        (fseeko((FILE*)(stream), *((off_t*)(loc)), SEEK_SET) < 0 ? -1 : 0)
+#define f_tell(stream, loc) (*((off_t*)(loc)) = ftello((FILE*)(stream)))

 #else
