/*
 * test_fpos.cal — 通用文件位置跟踪测试
 *
 * 覆盖 calc 语言的 fopen / fputs / rewind / ftell / 定位读取 / fclose
 * 全链路，断言：
 *   1. 初始重绕后 ftell() == 0
 *   2. 写入后定位与读取内容一致
 *   3. 拒绝巨大乱码整数（musl fpos_t 结构体被按整数解释时的典型症状）
 *
 * 用法:   calc -q -f test_fpos.cal
 * 成功:   输出 "ALL_N" 断言计数并以 exit 0 结束
 * 失败:   输出首个失败断言并以非零退出码结束
 */

a = config("display", 20);            /* 常规显示精度 */

fail_count = 0;
pass_count = 0;

define check(name, cond)
{
    global pass_count, fail_count;
    if (cond) {
        ++pass_count;
        print "PASS:", name;
    } else {
        ++fail_count;
        print "FAIL:", name;
    }
}

/* 清理旧测试文件 */
x = rm("-f", "test_fpos.dat");

/* 1. 打开、写入、重绕，ftell 必须为 0 */
f = fopen("test_fpos.dat", "w+b");
check("fopen w+b", !iserror(f));

r = fputs(f, "abcdefghijklmnopqrstuvwxyz\n", "0123456789\n");
check("fputs 写入", !iserror(r));

r = rewind(f);
check("rewind", !iserror(r));

p = ftell(f);
check("rewind 后 ftell == 0", ((isnum(p)) && (p == 0)));

/*
 * 2. 上游已证实 musl fpos_t 被按整数解释时 ftell 返回巨大乱码。
 *    这里显式拒绝任何"巨大"位置值（>= 2^48），防止把乱码当通过。
 */
check("ftell 不为巨大乱码 (p < 2^48)", (p >= 0) && (p < 281474976710656));

/* 3. 写入后：从文件头读取内容必须与写入一致 */
r = rewind(f);
s = fgetline(f);
check("读取第一行 == abcdefghijklmnopqrstuvwxyz", strcmp(s, "abcdefghijklmnopqrstuvwxyz") == 0);
p = ftell(f);
check("第一行后 ftell == 27", (isnum(p)) && (p == 27));

s = fgetline(f);
check("读取第二行 == 0123456789", strcmp(s, "0123456789") == 0);
p = ftell(f);
check("第二行后 ftell == 38", (isnum(p)) && (p == 38));

/* 4. 绝对定位：fseek 到偏移 16 再读取，内容必须为 "qrstuvwxyz" */
r = fseek(f, 16);
check("fseek 16", !iserror(r));
s = fgetline(f);
check("偏移 16 处读取 == qrstuvwxyz", strcmp(s, "qrstuvwxyz") == 0);

/* 5. 资源清理 */
r = fclose(f);
check("fclose", !iserror(r));
x = rm("-f", "test_fpos.dat");
check("清理 test_fpos.dat", isfile("test_fpos.dat") == 0);

/* 结果输出 */
print "RESULT: PASS", : pass_count, : " FAIL", : fail_count;
if (fail_count > 0) {
    /* quit "message"; 使 calc 以非零退出码结束（quit; 恒为 0） */
    print "TEST_FPOS_FAILED";
    quit "TEST_FPOS_FAILED";
} else {
    print "TEST_FPOS_PASSED";
    quit;
}