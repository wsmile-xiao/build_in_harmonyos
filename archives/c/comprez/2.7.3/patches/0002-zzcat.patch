--- a/zzcat
+++ b/zzcat
@@ -2,21 +2,23 @@
 umask 077
 
 # zzcat - uncompress stdin and/or files to stdout
 # Steve Kinzler, steve@kinzler.com, Nov 11
 # http://kinzler.com/me/home.html#unix
 
 case "$#" in
 0)	set x -; shift;;
 esac
 
-tmp=/tmp/zzcat$$
+tmpdir="${TMPDIR:-${HOME:-/tmp}/tmp}"
+mkdir -p "$tmpdir" 2>/dev/null || tmpdir=/tmp
+tmp=$tmpdir/zzcat$$
 trap "rm -f $tmp; exit" 0 1 2 13 15
 
 for file
 do
 	in="$file"
 	case "$file" in
 	-)	cat > $tmp
 		in=$tmp
 		case "`file $tmp`" in	# warning, heuristic
 		*gzip*)		file=.gz;;
