--- a/confu_json/CMakeLists.txt
+++ b/confu_json/CMakeLists.txt
@@ -15,24 +15,30 @@
 find_package(Boost)
 
 # Get the include directories for the target.
 
 
 # Construct the compiler string for the include directories.
 
 
 target_link_libraries(confu_json INTERFACE
         magic_enum::magic_enum
-        Boost::headers
         )
 
-target_include_directories(confu_json INTERFACE $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>
+# OHOS adaptation: boost is consumed header-only (boost::json is compiled from
+# <boost/json/src.hpp> in the test TU; Boost.System is header-only since 1.85).
+# Linking Boost::boost drags libboost_unit_test_framework, which provides its own
+# main() and conflicts with Catch2::Catch2WithMain at link time. SYSTEM marks the
+# boost headers as system headers so the project's -Werror/-Wold-style-cast/
+# -Wsign-conversion (myproject_warnings) do not fire on third-party headers.
+target_include_directories(confu_json SYSTEM INTERFACE ${Boost_INCLUDE_DIRS}
+        $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>
         $<BUILD_INTERFACE:${PROJECT_BINARY_DIR}/include>)
 
 target_compile_features(confu_json INTERFACE cxx_std_20)
 
 install(FILES
         concept.hxx
         confu_json.hxx
         to_json.hxx
         to_object.hxx
         util.hxx
