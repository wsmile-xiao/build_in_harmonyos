+# OHOS adaptation: the compile_commands.json copy target breaks header-only
+# builds — when no target compiles, ${CMAKE_BINARY_DIR}/compile_commands.json
+# is never produced and `make` fails on the unconditional custom target.
+# Guard it so packaging builds pass; on build configs with real compile
+# rules the file exists at configure time and the copy works as intended.
+if (EXISTS ${CMAKE_BINARY_DIR}/compile_commands.json)
+  add_custom_target(copy_compile_commands_json ALL
+                    DEPENDS ${CMAKE_SOURCE_DIR}/compile_commands.json)
 
-add_custom_command(
-  OUTPUT ${CMAKE_SOURCE_DIR}/compile_commands.json
-  COMMAND ${CMAKE_COMMAND} -E copy ${CMAKE_BINARY_DIR}/compile_commands.json
-          ${CMAKE_SOURCE_DIR}/compile_commands.json
-  COMMENT
-    "copy compile_commands.json build to compile_commands.json project root so tools can find it more easily"
-)
