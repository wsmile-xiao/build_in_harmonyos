diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -20,7 +20,7 @@ INSTALL_EXE  := $(INSTALL)
 INSTALL_EXE  := $(INSTALL)
 INSTALL_DATA := $(INSTALL) -m 0644
 
-all: ctpv
+all: ctpv ctpvclear
 
 options:
 	@echo "CC      = $(CC)"
@@ -40,9 +40,9 @@ uninstall:
 uninstall:
 	$(RM) $(BINPREFIX)/ctpv $(BINPREFIX)/ctpvquit $(BINPREFIX)/ctpvclear \
 		$(MANPREFIX)/ctpv.1
 
 clean:
-	$(RM) ctpv $(OBJ) $(DEP) $(GEN)
+	$(RM) ctpv ctpvclear $(OBJ) $(DEP) $(GEN)
 	$(MAKE) -C embed clean
 	$(MAKE) -C quit clean
 
@@ -52,8 +52,11 @@ docs: README.md doc/ctpv.1
 	./genhelp.sh doc/ctpv.1 > help.txt
 
 ctpv: $(OBJ)
 	$(CC) -o $@ $+ $(ALL_LDFLAGS)
 
+ctpvclear: ctpvclear.c
+	$(CC) -o $@ $< $(ALL_CFLAGS) $(LDFLAGS)
+
 .c.o:
 	$(CC) -o $@ $< -c $(ALL_CFLAGS)
 
diff --git a/ctpvclear b/ctpvclear
deleted file mode 100755
--- a/ctpvclear
+++ /dev/null
@@ -1,5 +0,0 @@
-#!/bin/sh
-
-[ -z "$id" ] && id="$1"
-
-exec ctpv -c "$id"
diff --git a/ctpvclear.c b/ctpvclear.c
new file mode 100644
--- /dev/null
+++ b/ctpvclear.c
@@ -0,0 +1,26 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+int main(int argc, char **argv)
+{
+    const char *id = getenv("id");
+
+    if (id == NULL || id[0] == '\0') {
+        if (argc < 2 || argv[1][0] == '\0') {
+            fputs("id not given\n", stderr);
+            return EXIT_FAILURE;
+        }
+        id = argv[1];
+    }
+
+    char *const child_argv[] = {
+        "ctpv",
+        "-c",
+        (char *)id,
+        NULL,
+    };
+    execvp(child_argv[0], child_argv);
+    perror("execvp");
+    return EXIT_FAILURE;
+}
