--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -21,6 +21,19 @@
 	PUBLIC_HEADER DESTINATION include
 )
 
+# OHOS adaptation: build+run the upstream smoke suite (test/, utest.h)
+# on demand so the Conan build actually exercises it.  OFF by default
+# keeps the upstream behaviour unchanged.
+option(XDB_BUILD_TESTS "Build the upstream smoke test suite (test/)" OFF)
+if (XDB_BUILD_TESTS)
+	enable_testing()
+	add_executable(xdb_smoke_test test/xdb_smoke_test.c)
+	target_include_directories(xdb_smoke_test PRIVATE
+		${CMAKE_CURRENT_SOURCE_DIR}/include)
+	target_link_libraries(xdb_smoke_test crossdb pthread)
+	add_test(NAME xdb_smoke_test COMMAND xdb_smoke_test)
+endif()
+
