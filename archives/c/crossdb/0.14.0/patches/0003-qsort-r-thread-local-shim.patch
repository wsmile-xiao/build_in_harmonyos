 }
 
+#if !defined(__GLIBC__) && !defined(_WIN32) && !defined(__FreeBSD__) && !defined(__APPLE__)
+/* musl (OHOS) libc exports no glibc-style qsort_r(base,n,size,compar,arg).
+ * Provide a local shim over qsort() with thread-local context so that the
+ * per-connection worker threads cannot race on it (knowledge E531). */
+static __thread int (*_crossdb_qsort_r_compar)(const void *, const void *, void *);
+static __thread void *_crossdb_qsort_r_arg;
+static int _crossdb_qsort_r_wrap (const void *a, const void *b)
+{
+	return _crossdb_qsort_r_compar (a, b, _crossdb_qsort_r_arg);
+}
+static void qsort_r (void *base, size_t nmemb, size_t size,
+                     int (*compar)(const void *, const void *, void *), void *arg)
+{
+	_crossdb_qsort_r_compar = compar;
+	_crossdb_qsort_r_arg = arg;
+	qsort (base, nmemb, size, _crossdb_qsort_r_wrap);
+}
+#endif
