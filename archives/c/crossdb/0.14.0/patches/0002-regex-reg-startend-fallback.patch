--- a/src/lib/xdb_str.c
+++ b/src/lib/xdb_str.c
@@ -142,7 +142,23 @@
 
 int xdb_str_regexec (const char *string, int len, void *pRegExp)
 {
+#ifdef REG_STARTEND
 	regmatch_t match = {.rm_so = 0, .rm_eo = len};
 	return 0 == regexec (pRegExp, string, 0, &match, REG_STARTEND);
+#else
+	/* musl (OHOS) regex.h has no REG_STARTEND, so regexec cannot be told
+	 * the subject length.  Subjects here are length-prefixed slices that
+	 * are not NUL-terminated, so bound them with a NUL-terminated copy. */
+	char *buf = xdb_malloc (len + 1);
+	int ret;
+	if (NULL == buf) {
+		return 0;
+	}
+	memcpy (buf, string, (size_t)len);
+	buf[len] = '\0';
+	ret = regexec (pRegExp, buf, 0, NULL, 0);
+	xdb_free (buf);
+	return 0 == ret;
+#endif
 }
 
