+void QPdfWidget::renderCurrentPage()
+{
+    if (!m->pDocument) {
+        m->pPageLabel->clear();
+        return;
+    }
+
+    if (m->currentPage < 0 || m->currentPage >= m->totalPages) {
+        m->pPageLabel->clear();
+        return;
+    }
+
+    std::unique_ptr<poppler::page> p(m->pDocument->create_page(m->currentPage));
+    if (!p) {
+        qWarning() << "Unable to render page" << m->currentPage;
+        m->pPageLabel->clear();
+        return;
+    }
+
+    // Convert rotation to poppler-cpp enum (global scope in poppler-global.h)
+    poppler::rotation_enum popplerRotation = poppler::rotate_0;
+    switch (m->rotation) {
+        case 90:  popplerRotation = poppler::rotate_90; break;
+        case 180: popplerRotation = poppler::rotate_180; break;
+        case 270: popplerRotation = poppler::rotate_270; break;
+        default:  popplerRotation = poppler::rotate_0; break;
+    }
+
+    // Render at 72 DPI * scale factor via page_renderer
+    double dpi = 72.0 * m->scale;
+    poppler::page_renderer renderer;
+    poppler::image img = renderer.render_page(p.get(), dpi, dpi, -1, -1, -1, -1, popplerRotation);
+
+    if (!img.is_valid()) {
+        qWarning() << "Rendered image is not valid for page" << m->currentPage;
+        m->pPageLabel->clear();
+        return;
+    }
+
+    // Convert poppler::image to QImage
+    QImage::Format qFormat = QImage::Format_RGB888;
+    if (img.format() == poppler::image::format_argb32) {
+        qFormat = QImage::Format_ARGB32;
+    }
+
+    m->currentImage = QImage(reinterpret_cast<const uchar*>(img.data()),
+                             img.width(), img.height(),
+                             img.bytes_per_row(), qFormat).copy();
+
+    if (m->currentImage.isNull()) {
+        qWarning() << "Failed to convert poppler image to QImage for page" << m->currentPage;
+        m->pPageLabel->clear();
+        return;
+    }
+
+    m->pPageLabel->setPixmap(QPixmap::fromImage(m->currentImage));
+    m->pPageLabel->adjustSize();
+    updateView();
+}
+
+void QPdfWidget::updateView()
+{
+    // Ensure scroll area updates its viewport
+    m->pScrollArea->ensureVisible(0, 0);
+    update();
+}
