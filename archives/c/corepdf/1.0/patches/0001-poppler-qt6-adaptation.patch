diff -ruN corepdf-1.0.orig/CMakeLists.txt corepdf-1.0.work/CMakeLists.txt
--- corepdf-1.0.orig/CMakeLists.txt	1970-01-01 08:00:00.000000000 +0800
+++ corepdf-1.0.work/CMakeLists.txt	2026-05-29 10:57:50.827869374 +0800
@@ -0,0 +1,60 @@
+cmake_minimum_required(VERSION 3.16)
+project(corepdf VERSION 1.0 LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 11)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_AUTOMOC ON)
+
+# Find Qt6
+find_package(Qt6 REQUIRED COMPONENTS Widgets)
+
+# Find poppler-qt6 for PDF rendering
+# poppler-qt6 headers are at /usr/local/include/poppler/qt6/ and /usr/local/include/poppler/
+set(POPPLER_QT6_INCLUDE_DIR "/storage/Users/currentUser/usr/local/include/poppler/qt6")
+set(POPPLER_INCLUDE_DIR "/storage/Users/currentUser/usr/local/include/poppler")
+find_library(POPPLER_QT6_LIBRARY
+    NAMES poppler-qt6
+    PATHS /storage/Users/currentUser/usr/local/lib
+)
+
+if(NOT POPPLER_QT6_LIBRARY)
+    message(FATAL_ERROR "poppler-qt6 library not found")
+endif()
+
+message(STATUS "Found poppler-qt6: ${POPPLER_QT6_LIBRARY}")
+
+# qpdflib - static library using poppler-qt6
+add_library(qpdf STATIC
+    qpdflib/qpdfwidget.cpp
+    qpdflib/qpdfwidget.h
+)
+target_include_directories(qpdf PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/qpdflib
+    ${POPPLER_QT6_INCLUDE_DIR}
+    ${POPPLER_INCLUDE_DIR}
+)
+target_link_libraries(qpdf PUBLIC
+    Qt6::Widgets
+    ${POPPLER_QT6_LIBRARY}
+)
+target_compile_definitions(qpdf PRIVATE QPDFLIB_BUILD)
+
+# corepdf - application
+add_executable(corepdf
+    corepdf/corepdf.cpp
+    corepdf/corepdf.h
+    corepdf/main.cpp
+)
+target_include_directories(corepdf PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/corepdf
+    ${CMAKE_CURRENT_SOURCE_DIR}/qpdflib
+    ${POPPLER_QT6_INCLUDE_DIR}
+    ${POPPLER_INCLUDE_DIR}
+)
+target_link_libraries(corepdf PRIVATE
+    qpdf
+    Qt6::Widgets
+    ${POPPLER_QT6_LIBRARY}
+)
+
+install(TARGETS corepdf DESTINATION bin)
\ No newline at end of file
