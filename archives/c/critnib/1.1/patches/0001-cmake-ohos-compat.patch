diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.8.12)
+cmake_minimum_required(VERSION 3.16)
 project(critnib C)
 
 set(THREADS_PREFER_PTHREAD_FLAG TRUE)
@@ -10,8 +10,16 @@
 
 set(CMAKE_C_FLAGS "-Wall -Werror=format-security ${CMAKE_C_FLAGS}")
 
-add_library(critnib SHARED critnib.c)
-set(libs critnib ${CMAKE_THREAD_LIBS_INIT} -latomic)
+# Respect BUILD_SHARED_LIBS (Conan drives ON/OFF); default static.
+add_library(critnib critnib.c)
+# -latomic is not available on all targets (e.g. OHOS aarch64 where
+# word-sized __atomic builtins are inline). Link it only when found.
+find_library(ATOMIC_LIB atomic)
+if(ATOMIC_LIB)
+	set(libs critnib ${CMAKE_THREAD_LIBS_INIT} ${ATOMIC_LIB})
+else()
+	set(libs critnib ${CMAKE_THREAD_LIBS_INIT})
+endif()
 add_executable(m main.c)
 target_link_libraries(m ${libs})
 
@@ -22,21 +30,31 @@
 include(GNUInstallDirs)
 install(TARGETS critnib
 	PUBLIC_HEADER DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+	ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
 	LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
 	RUNTIME DESTINATION ${CMAKE_INSTALL_LIBDIR}/)
 install(FILES critnib.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
-install(FILES
-	${CMAKE_CURRENT_BINARY_DIR}/libcritnib.3
-	critnib.3
-	DESTINATION ${CMAKE_INSTALL_MANDIR}/man3)
 
 enable_testing()
 add_subdirectory(tests)
 
-add_custom_command(OUTPUT libcritnib.3
-	DEPENDS libcritnib.pod
-	COMMAND pod2man -c critnib -s 3 -n libcritnib
-		<${CMAKE_CURRENT_SOURCE_DIR}/libcritnib.pod
-		>${CMAKE_CURRENT_BINARY_DIR}/libcritnib.3)
-add_custom_target(man ALL
-	DEPENDS libcritnib.3)
+# pod2man (perl) is often missing on device/CI builders; make the
+# generated man page optional instead of failing the whole build.
+find_program(POD2MAN pod2man)
+if(POD2MAN)
+	add_custom_command(OUTPUT libcritnib.3
+		DEPENDS libcritnib.pod
+		COMMAND ${POD2MAN} -c critnib -s 3 -n libcritnib
+			<${CMAKE_CURRENT_SOURCE_DIR}/libcritnib.pod
+			>${CMAKE_CURRENT_BINARY_DIR}/libcritnib.3)
+	add_custom_target(man ALL
+		DEPENDS libcritnib.3)
+	install(FILES
+		${CMAKE_CURRENT_BINARY_DIR}/libcritnib.3
+		critnib.3
+		DESTINATION ${CMAKE_INSTALL_MANDIR}/man3)
+else()
+	install(FILES
+		critnib.3
+		DESTINATION ${CMAKE_INSTALL_MANDIR}/man3)
+endif()
