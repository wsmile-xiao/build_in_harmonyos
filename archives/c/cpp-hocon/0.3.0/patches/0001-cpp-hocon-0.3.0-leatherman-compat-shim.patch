+#pragma once
+//
+// Minimal leatherman/util/scope_exit.hpp shim (cpp-hocon 0.3.0 OHOS port).
+//
+// Only leatherman::util::scope_exit(fn) is used by cpp-hocon
+// (parseable.cc include stack unwinding). RAII implementation.
+//
+#include <functional>
+#include <utility>
+
+namespace leatherman { namespace util {
+
+    namespace detail {
+        class scope_exit_impl {
+        public:
+            explicit scope_exit_impl(std::function<void()> fn) : fn_(std::move(fn)), armed_(true) {}
+            ~scope_exit_impl() { if (armed_ && fn_) { fn_(); } }
+            scope_exit_impl(scope_exit_impl&& other) noexcept
+                : fn_(std::move(other.fn_)), armed_(other.armed_) { other.armed_ = false; }
+            scope_exit_impl(scope_exit_impl const&) = delete;
+            scope_exit_impl& operator=(scope_exit_impl const&) = delete;
+            void disarm() { armed_ = false; }
+        private:
+            std::function<void()> fn_;
+            bool armed_;
+        };
+    }
+
+    /** Run fn() when the returned object goes out of scope. */
+    inline detail::scope_exit_impl scope_exit(std::function<void()> fn) {
+        return detail::scope_exit_impl(std::move(fn));
+    }
+
+}}  // namespace leatherman::util
