@@ -0,0 +1,112 @@
+#pragma once
+//
+// Minimal leatherman/locale/locale.hpp shim (cpp-hocon 0.3.0 OHOS port).
+//
+// Upstream cpp-hocon pulls in puppetlabs/leatherman for i18n formatting
+// only: _(fmt, args...), translate(str) and format(fmt, args...). The
+// full leatherman library is not published for OHOS, so this shim
+// implements the exact subset cpp-hocon uses on top of boost::format.
+//
+// Placeholders keep leatherman semantics: {1}, {2}, ... map to %1%, %2%.
+//
+#include <string>
+#include <boost/format.hpp>
+
+namespace leatherman { namespace locale {
+
+    namespace detail {
+        inline std::string to_boost_format(std::string const& fmt) {
+            std::string out;
+            out.reserve(fmt.size() + 8);
+            for (size_t i = 0; i < fmt.size(); ++i) {
+                if (fmt[i] == '{' && i + 1 < fmt.size() && fmt[i + 1] >= '1' && fmt[i + 1] <= '9') {
+                    size_t j = i + 1;
+                    while (j < fmt.size() && fmt[j] >= '0' && fmt[j] <= '9') {
+                        ++j;
+                    }
+                    if (j < fmt.size() && fmt[j] == '}') {
+                        out += '%';
+                        out.append(fmt, i + 1, j - i - 1);
+                        out += '%';
+                        i = j;
+                        continue;
+                    }
+                }
+                // boost::format treats lone '%' as a directive start; escape.
+                if (fmt[i] == '%') {
+                    out += "%%";
+                    continue;
+                }
+                out += fmt[i];
+            }
+            return out;
+        }
+    }
+
+    /** Translate a literal string (no placeholders). With the shim the
+     *  message catalogue is a no-op: the input is returned unchanged. */
+    inline std::string translate(std::string const& message) {
+        return message;
+    }
+
+    /** Format with positional {N} placeholders (leatherman semantics).
+     *  Zero-argument call: run the escaped string through boost::format
+     *  so literal '%%' collapses back to '%' (returning the raw escaped
+     *  string would leak doubled percent signs / '%N%' placeholders into
+     *  messages — review note 2026-09-10). */
+    inline std::string format(std::string const& fmt) {
+        boost::format f(detail::to_boost_format(fmt));
+        return f.str();
+    }
+
+    template <typename T1>
+    std::string format(std::string const& fmt, T1 const& a1) {
+        boost::format f(detail::to_boost_format(fmt));
+        return (f % a1).str();
+    }
+
+    template <typename T1, typename T2>
+    std::string format(std::string const& fmt, T1 const& a1, T2 const& a2) {
+        boost::format f(detail::to_boost_format(fmt));
+        return (f % a1 % a2).str();
+    }
+
+    template <typename T1, typename T2, typename T3>
+    std::string format(std::string const& fmt, T1 const& a1, T2 const& a2, T3 const& a3) {
+        boost::format f(detail::to_boost_format(fmt));
+        return (f % a1 % a2 % a3).str();
+    }
+
+    template <typename T1, typename T2, typename T3, typename T4>
+    std::string format(std::string const& fmt, T1 const& a1, T2 const& a2, T3 const& a3, T4 const& a4) {
+        boost::format f(detail::to_boost_format(fmt));
+        return (f % a1 % a2 % a3 % a4).str();
+    }
+
+    /** Mark a string for translation and format it in one step (upstream
+     *  alias: `using leatherman::locale::_;`). */
+    inline std::string _(std::string const& fmt) {
+        return format(fmt);
+    }
+
+    template <typename T1>
+    std::string _(std::string const& fmt, T1 const& a1) {
+        return format(fmt, a1);
+    }
+
+    template <typename T1, typename T2>
+    std::string _(std::string const& fmt, T1 const& a1, T2 const& a2) {
+        return format(fmt, a1, a2);
+    }
+
+    template <typename T1, typename T2, typename T3>
+    std::string _(std::string const& fmt, T1 const& a1, T2 const& a2, T3 const& a3) {
+        return format(fmt, a1, a2, a3);
+    }
+
+    template <typename T1, typename T2, typename T3, typename T4>
+    std::string _(std::string const& fmt, T1 const& a1, T2 const& a2, T3 const& a3, T4 const& a4) {
+        return format(fmt, a1, a2, a3, a4);
+    }
+
+}}  // namespace leatherman::locale
