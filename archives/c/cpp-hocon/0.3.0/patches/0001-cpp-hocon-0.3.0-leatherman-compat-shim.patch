+#pragma once
+//
+// Minimal leatherman/util/environment.hpp shim (cpp-hocon 0.3.0 OHOS port).
+//
+// Only leatherman::util::environment::each() is used by cpp-hocon
+// (config::env_variables_as_config_object). POSIX implementation.
+//
+#include <functional>
+#include <string>
+#include <cstdlib>
+#include <cstring>
+
+extern "C" char** environ;
+
+namespace leatherman { namespace util { namespace environment {
+
+    /** Invoke callback(k, v) for every environment variable. The callback
+     *  returns true to continue, false to stop early (upstream contract). */
+    inline void each(std::function<bool(std::string&, std::string&)> callback) {
+        if (!callback) {
+            return;
+        }
+        for (char** e = environ; e && *e; ++e) {
+            const char* eq = strchr(*e, '=');
+            if (!eq) {
+                continue;
+            }
+            std::string k(*e, eq - *e);
+            std::string v(eq + 1);
+            if (!callback(k, v)) {
+                break;
+            }
+        }
+    }
+
+    inline bool get(std::string const& name, std::string& value) {
+        const char* v = std::getenv(name.c_str());
+        if (!v) {
+            return false;
+        }
+        value = v;
+        return true;
+    }
+
+    inline std::string get(std::string const& name) {
+        const char* v = std::getenv(name.c_str());
+        return v ? std::string(v) : std::string();
+    }
+
+}}}  // namespace leatherman::util::environment
