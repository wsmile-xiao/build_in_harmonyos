+# Dependency lookup: Conan CMakeDeps targets.
+#
+# boost1.84 (main package: full boost include tree + filesystem/
+# program_options/regex/iostreams static libs) and boost1.84-thread
+# (libboost_thread) both export cmake_file_name "Boost". The Conan recipe
+# renames the thread package config to "hocon-boost-thread"
+# (deps.set_property in generate()) so both coexist in one generator
+# folder:
+#   * find_package(Boost)              -> boost1.84 components
+#   * find_package(hocon-boost-thread) -> boost1.84-thread (Boost::thread)
+find_package(Boost 1.84.0 CONFIG REQUIRED COMPONENTS headers filesystem program_options regex)
+find_package(hocon-boost-thread 1.84.0 CONFIG REQUIRED)
+find_package(Threads REQUIRED)
 
