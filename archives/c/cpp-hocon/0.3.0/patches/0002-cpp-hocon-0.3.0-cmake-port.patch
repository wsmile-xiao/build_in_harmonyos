+# lib/CMakeLists.txt — cpp-hocon 0.3.0 OHOS port.
+#
+# The upstream file drives compilation through leatherman macros
+# (leatherman_install/symbol_exports/logging namespace). This port keeps
+# the same source list and layout, plus:
+#   * lib/compat/ ships minimal leatherman/locale + leatherman/util
+#     header shims (boost::format based) — see patches/0001.
+#   * export.h.in / version.h.in are configured here without leatherman.
+configure_file("export.h.in" "${CMAKE_CURRENT_LIST_DIR}/inc/hocon/export.h" @ONLY)
+configure_file("version.h.in" "${CMAKE_CURRENT_LIST_DIR}/inc/hocon/version.h" @ONLY)
 
