--- a/tools/run-tests.sh
+++ b/tools/run-tests.sh
@@ -4,8 +4,22 @@
 
 LOG=run-tests.log
 FRONTEND=./cpdb-text-frontend
-
-export LD_LIBRARY_PATH=`pwd`/cpdb/.libs
+if test -f ./.libs/cpdb-text-frontend; then
+    FRONTEND=./.libs/cpdb-text-frontend
+fi
+
+export LD_LIBRARY_PATH="$(pwd)/../cpdb/.libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+
+run_frontend() {
+    if command -v dbus-run-session >/dev/null 2>&1; then
+        dbus-run-session -- "$FRONTEND"
+    else
+        # HarmonyOS does not provide a session-bus daemon.  The frontend
+        # must still handle that condition and shut down cleanly on "stop".
+        unset DBUS_SESSION_BUS_ADDRESS
+        "$FRONTEND"
+    fi
+}
 
 cleanup() {
     # Show log
@@ -24,7 +38,7 @@
 ( \
   sleep 1; \
   echo stop \
-) | dbus-run-session -- $FRONTEND > $LOG 2>&1 &
+) | run_frontend > $LOG 2>&1 &
 
 # Give the frontend a maximum of 5 seconds to run and then kill it, to avoid
 # the script getting stuck if stopping it fails.
