--- /dev/null
+++ b/harmony/project/entry/src/main/cpp/curtain_napi.cpp
@@ -0,0 +1,171 @@
+#include <napi/native_api.h>
+
+#include "curtain_core.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace {
+
+curtain_core *g_core = nullptr;
+
+napi_value MakeBool(napi_env env, bool value) {
+  napi_value result;
+  napi_get_boolean(env, value, &result);
+  return result;
+}
+
+napi_value Init(napi_env env, napi_callback_info info) {
+  size_t argc = 2;
+  napi_value args[2];
+  int32_t width = 0;
+  int32_t height = 0;
+  napi_get_cb_info(env, info, &argc, args, nullptr, nullptr);
+  if (argc != 2 || napi_get_value_int32(env, args[0], &width) != napi_ok ||
+      napi_get_value_int32(env, args[1], &height) != napi_ok || width <= 0 || height <= 0) {
+    napi_throw_type_error(env, nullptr, "init requires positive screen width and height");
+    return nullptr;
+  }
+  if (g_core) {
+    curtain_core_destroy(g_core);
+    g_core = nullptr;
+  }
+  g_core = curtain_core_create(width, height);
+  return MakeBool(env, g_core != nullptr);
+}
+
+napi_value SetSource(napi_env env, napi_callback_info info) {
+  size_t argc = 3;
+  napi_value args[3];
+  void *data = nullptr;
+  size_t length = 0;
+  int32_t source_width = 0;
+  int32_t source_height = 0;
+  napi_get_cb_info(env, info, &argc, args, nullptr, nullptr);
+  if (argc != 3 || !g_core ||
+      napi_get_arraybuffer_info(env, args[0], &data, &length) != napi_ok ||
+      napi_get_value_int32(env, args[1], &source_width) != napi_ok ||
+      napi_get_value_int32(env, args[2], &source_height) != napi_ok ||
+      source_width <= 0 || source_height <= 0) {
+    return MakeBool(env, false);
+  }
+  if (length < static_cast<size_t>(source_width) * static_cast<size_t>(source_height) * 4) {
+    return MakeBool(env, false);
+  }
+  return MakeBool(env,
+                  curtain_core_set_source(g_core, static_cast<const uint8_t *>(data),
+                                          source_width, source_height) != 0);
+}
+
+napi_value Press(napi_env env, napi_callback_info info) {
+  size_t argc = 2;
+  napi_value args[2];
+  double x = 0.0;
+  double y = 0.0;
+  napi_get_cb_info(env, info, &argc, args, nullptr, nullptr);
+  if (argc == 2 && g_core && napi_get_value_double(env, args[0], &x) == napi_ok &&
+      napi_get_value_double(env, args[1], &y) == napi_ok) {
+    curtain_core_press(g_core, x, y);
+  }
+  return nullptr;
+}
+
+napi_value Release(napi_env env, napi_callback_info info) {
+  size_t argc = 2;
+  napi_value args[2];
+  double x = 0.0;
+  double y = 0.0;
+  curtain_rect rect = {0.0, 0.0, 0.0, 0.0};
+  int changed = 0;
+  napi_value result;
+  napi_value values[5];
+  napi_get_cb_info(env, info, &argc, args, nullptr, nullptr);
+  if (g_core && argc == 2 && napi_get_value_double(env, args[0], &x) == napi_ok &&
+      napi_get_value_double(env, args[1], &y) == napi_ok) {
+    changed = curtain_core_release(g_core, x, y);
+  }
+  if (g_core) {
+    curtain_core_get_rect(g_core, &rect);
+  }
+  napi_create_array_with_length(env, 5, &result);
+  napi_create_double(env, rect.min_x, &values[0]);
+  napi_create_double(env, rect.min_y, &values[1]);
+  napi_create_double(env, rect.max_x, &values[2]);
+  napi_create_double(env, rect.max_y, &values[3]);
+  napi_create_int32(env, changed, &values[4]);
+  for (uint32_t i = 0; i < 5; i++) {
+    napi_set_element(env, result, i, values[i]);
+  }
+  return result;
+}
+
+napi_value ShouldQuit(napi_env env, napi_callback_info info) {
+  (void)info;
+  return MakeBool(env, g_core != nullptr && curtain_core_should_quit(g_core) != 0);
+}
+
+napi_value GetPixels(napi_env env, napi_callback_info info) {
+  (void)info;
+  napi_value value;
+  if (!g_core) {
+    napi_get_null(env, &value);
+    return value;
+  }
+  const uint8_t *pixels = curtain_core_pixels(g_core);
+  if (!pixels) {
+    napi_get_null(env, &value);
+    return value;
+  }
+  size_t length = static_cast<size_t>(curtain_core_width(g_core)) *
+                  static_cast<size_t>(curtain_core_height(g_core)) * 4;
+  void *data = nullptr;
+  if (napi_create_arraybuffer(env, length, &data, &value) != napi_ok || data == nullptr) {
+    napi_get_null(env, &value);
+    return value;
+  }
+  memcpy(data, pixels, length);
+  return value;
+}
+
+napi_value ScreenSize(napi_env env, napi_callback_info info) {
+  (void)info;
+  napi_value result;
+  napi_value value;
+  const int width = g_core ? curtain_core_width(g_core) : 0;
+  const int height = g_core ? curtain_core_height(g_core) : 0;
+  napi_create_array_with_length(env, 2, &result);
+  napi_create_int32(env, width, &value);
+  napi_set_element(env, result, 0, value);
+  napi_create_int32(env, height, &value);
+  napi_set_element(env, result, 1, value);
+  return result;
+}
+
+napi_value RegisterMethods(napi_env env, napi_value exports) {
+  napi_property_descriptor methods[] = {
+      {"init", nullptr, Init, nullptr, nullptr, nullptr, napi_default, nullptr},
+      {"setSource", nullptr, SetSource, nullptr, nullptr, nullptr, napi_default, nullptr},
+      {"press", nullptr, Press, nullptr, nullptr, nullptr, napi_default, nullptr},
+      {"release", nullptr, Release, nullptr, nullptr, nullptr, napi_default, nullptr},
+      {"shouldQuit", nullptr, ShouldQuit, nullptr, nullptr, nullptr, napi_default, nullptr},
+      {"getPixels", nullptr, GetPixels, nullptr, nullptr, nullptr, napi_default, nullptr},
+      {"screenSize", nullptr, ScreenSize, nullptr, nullptr, nullptr, napi_default, nullptr},
+  };
+  napi_define_properties(env, exports, sizeof(methods) / sizeof(methods[0]), methods);
+  napi_add_env_cleanup_hook(env, [](void *) {
+    if (g_core) {
+      curtain_core_destroy(g_core);
+      g_core = nullptr;
+    }
+  }, nullptr);
+  return exports;
+}
+
+napi_module curtainModule = {1, 0, nullptr, RegisterMethods, "curtain", nullptr, {0}};
+
+}  // namespace
+
+extern "C" __attribute__((constructor)) void RegisterCurtainModule(void) {
+  napi_module_register(&curtainModule);
+}
