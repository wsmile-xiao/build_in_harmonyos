--- /dev/null
+++ b/harmony/CMakeLists.txt
@@ -0,0 +1,27 @@
+cmake_minimum_required(VERSION 3.20)
+project(curtain_harmony LANGUAGES C CXX)
+
+set(CMAKE_C_STANDARD 99)
+set(CURTAIN_CPP ${CMAKE_CURRENT_SOURCE_DIR}/project/entry/src/main/cpp)
+include(GNUInstallDirs)
+
+add_library(curtain_core STATIC ${CURTAIN_CPP}/curtain_core.c)
+target_include_directories(curtain_core PUBLIC ${CURTAIN_CPP})
+target_link_libraries(curtain_core PUBLIC m)
+
+add_library(curtain SHARED ${CURTAIN_CPP}/curtain_napi.cpp)
+target_link_libraries(curtain PRIVATE curtain_core ace_napi.z)
+target_compile_features(curtain PRIVATE cxx_std_17)
+target_link_options(curtain PRIVATE "-Wl,-soname,libcurtain.so")
+
+add_executable(curtain_check ${CURTAIN_CPP}/check/curtain_check.c)
+target_link_libraries(curtain_check PRIVATE curtain_core)
+
+enable_testing()
+add_test(NAME curtain_core_checks COMMAND curtain_check)
+
+install(TARGETS curtain curtain_core curtain_check
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
+install(FILES ${CURTAIN_CPP}/curtain_core.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/curtain)
