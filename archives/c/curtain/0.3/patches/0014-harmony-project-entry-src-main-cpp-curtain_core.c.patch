--- /dev/null
+++ b/harmony/project/entry/src/main/cpp/curtain_core.c
@@ -0,0 +1,266 @@
+#include "curtain_core.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define MIN_CURTAIN_SIZE 25.0
+
+struct curtain_core {
+  double min_x;
+  double min_y;
+  double max_x;
+  double max_y;
+  double press_x;
+  double press_y;
+  int screen_w;
+  int screen_h;
+  int should_quit;
+  uint8_t *pixels;
+  int stride;
+  int width;
+  int height;
+};
+
+static int reflect_index(int v, int n) {
+  int max;
+  if (n <= 1) {
+    return 0;
+  }
+  max = n - 1;
+  while (v < 0 || v > max) {
+    if (v < 0) {
+      v = -v;
+    }
+    if (v > max) {
+      v = 2 * max - v;
+    }
+  }
+  return v;
+}
+
+static void sample_bilinear(const uint8_t *src, int sw, int sh, double fx, double fy,
+                            uint8_t *out) {
+  double x = fx - 0.5;
+  double y = fy - 0.5;
+  int x0 = (int)floor(x);
+  int y0 = (int)floor(y);
+  double dx = x - (double)x0;
+  double dy = y - (double)y0;
+  int xi0 = reflect_index(x0, sw);
+  int xi1 = reflect_index(x0 + 1, sw);
+  int yi0 = reflect_index(y0, sh);
+  int yi1 = reflect_index(y0 + 1, sh);
+  int c;
+  for (c = 0; c < 4; c++) {
+    double v00 = (double)src[(yi0 * sw + xi0) * 4 + c];
+    double v10 = (double)src[(yi0 * sw + xi1) * 4 + c];
+    double v01 = (double)src[(yi1 * sw + xi0) * 4 + c];
+    double v11 = (double)src[(yi1 * sw + xi1) * 4 + c];
+    double top = v00 + (v10 - v00) * dx;
+    double bot = v01 + (v11 - v01) * dx;
+    double v = top + (bot - top) * dy;
+    if (v < 0.0) {
+      v = 0.0;
+    }
+    if (v > 255.0) {
+      v = 255.0;
+    }
+    out[c] = (uint8_t)(v + 0.5);
+  }
+}
+
+curtain_core *curtain_core_create(int screen_w, int screen_h) {
+  curtain_core *core;
+  if (screen_w <= 0 || screen_h <= 0) {
+    return NULL;
+  }
+  core = (curtain_core *)calloc(1, sizeof(curtain_core));
+  if (!core) {
+    return NULL;
+  }
+  core->screen_w = screen_w;
+  core->screen_h = screen_h;
+  core->min_x = 0.0;
+  core->min_y = 0.0;
+  core->max_x = (double)screen_w;
+  core->max_y = (double)screen_h;
+  core->stride = screen_w * 4;
+  core->width = screen_w;
+  core->height = screen_h;
+  return core;
+}
+
+void curtain_core_destroy(curtain_core *core) {
+  if (!core) {
+    return;
+  }
+  free(core->pixels);
+  free(core);
+}
+
+int curtain_core_set_source(curtain_core *core, const uint8_t *rgba, int src_w, int src_h) {
+  uint8_t *dst;
+  int x;
+  int y;
+  if (!core || !rgba || src_w <= 0 || src_h <= 0) {
+    return 0;
+  }
+  dst = (uint8_t *)malloc((size_t)core->screen_w * (size_t)core->screen_h * 4);
+  if (!dst) {
+    return 0;
+  }
+  for (y = 0; y < core->screen_h; y++) {
+    double fy = ((double)y + 0.5) * (double)src_h / (double)core->screen_h;
+    for (x = 0; x < core->screen_w; x++) {
+      double fx = ((double)x + 0.5) * (double)src_w / (double)core->screen_w;
+      sample_bilinear(rgba, src_w, src_h, fx, fy, dst + (size_t)y * (size_t)core->stride + (size_t)x * 4);
+    }
+  }
+  free(core->pixels);
+  core->pixels = dst;
+  return 1;
+}
+
+void curtain_core_press(curtain_core *core, double x, double y) {
+  if (!core) {
+    return;
+  }
+  if ((x > (core->max_x - MIN_CURTAIN_SIZE)) && (y < (core->min_y + MIN_CURTAIN_SIZE))) {
+    core->should_quit = 1;
+  }
+  core->press_x = x;
+  core->press_y = y;
+}
+
+int curtain_core_release(curtain_core *core, double x, double y) {
+  double old_min_x;
+  double old_min_y;
+  double old_max_x;
+  double old_max_y;
+  double min_x;
+  double min_y;
+  double max_x;
+  double max_y;
+  double delta_x;
+  double delta_y;
+  if (!core) {
+    return 0;
+  }
+  old_min_x = core->min_x;
+  old_min_y = core->min_y;
+  old_max_x = core->max_x;
+  old_max_y = core->max_y;
+  min_x = core->min_x;
+  min_y = core->min_y;
+  max_x = core->max_x;
+  max_y = core->max_y;
+  delta_x = fabs(core->press_x - x);
+  delta_y = fabs(core->press_y - y);
+
+  if (delta_y <= delta_x) {
+    if (x >= core->press_x) {
+      if ((core->press_x < (max_x + min_x) / 2) && (x <= max_x)) {
+        if (x > min_x) {
+          min_x = x;
+          if (min_x > max_x - MIN_CURTAIN_SIZE) {
+            min_x = max_x - MIN_CURTAIN_SIZE;
+          }
+        }
+      } else {
+        if (x > max_x) {
+          max_x = x;
+          if (max_x > (double)core->screen_w) {
+            max_x = (double)core->screen_w;
+          }
+        }
+      }
+    } else {
+      if ((core->press_x > (max_x + min_x) / 2) && (x >= min_x)) {
+        if (x < max_x) {
+          max_x = x;
+          if (max_x - min_x < MIN_CURTAIN_SIZE) {
+            max_x = min_x + MIN_CURTAIN_SIZE;
+          }
+        }
+      } else {
+        if (x < min_x) {
+          min_x = x;
+          if ((max_x - min_x) < MIN_CURTAIN_SIZE) {
+            max_x = min_x + MIN_CURTAIN_SIZE;
+          }
+        }
+      }
+    }
+  } else {
+    if (y >= core->press_y) {
+      if ((core->press_y < (max_y + min_y) / 2) && (y <= max_y)) {
+        if (y > min_y) {
+          min_y = y;
+          if (min_y > (max_y - MIN_CURTAIN_SIZE)) {
+            min_y = max_y - MIN_CURTAIN_SIZE;
+          }
+        }
+      } else {
+        if (y > max_y) {
+          max_y = y;
+          if (max_y > (double)core->screen_h) {
+            max_y = (double)core->screen_h;
+          }
+        }
+      }
+    } else {
+      if ((core->press_y < (max_y + min_y) / 2) || (y < min_y)) {
+        if (y < min_y) {
+          min_y = y;
+          if (min_y > (max_y - MIN_CURTAIN_SIZE)) {
+            min_y = max_y - MIN_CURTAIN_SIZE;
+          }
+        }
+      } else {
+        if (y < max_y) {
+          max_y = y;
+          if ((max_y - min_y) < MIN_CURTAIN_SIZE) {
+            max_y = min_y + MIN_CURTAIN_SIZE;
+          }
+        }
+      }
+    }
+  }
+
+  core->min_x = min_x;
+  core->min_y = min_y;
+  core->max_x = max_x;
+  core->max_y = max_y;
+
+  return (min_x != old_min_x || min_y != old_min_y || max_x != old_max_x ||
+          max_y != old_max_y)
+             ? 1
+             : 0;
+}
+
+void curtain_core_get_rect(const curtain_core *core, curtain_rect *out) {
+  if (!core || !out) {
+    return;
+  }
+  out->min_x = core->min_x;
+  out->min_y = core->min_y;
+  out->max_x = core->max_x;
+  out->max_y = core->max_y;
+}
+
+int curtain_core_should_quit(const curtain_core *core) {
+  return core ? core->should_quit : 0;
+}
+
+const uint8_t *curtain_core_pixels(const curtain_core *core) {
+  return core ? core->pixels : NULL;
+}
+
+int curtain_core_width(const curtain_core *core) {
+  return core ? core->width : 0;
+}
+
+int curtain_core_height(const curtain_core *core) {
+  return core ? core->height : 0;
+}
