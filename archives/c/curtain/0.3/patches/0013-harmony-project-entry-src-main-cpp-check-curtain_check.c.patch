--- /dev/null
+++ b/harmony/project/entry/src/main/cpp/check/curtain_check.c
@@ -0,0 +1,189 @@
+#include "curtain_core.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int g_checks = 0;
+static int g_failures = 0;
+
+static void expect_int(int actual, int expected, const char *name) {
+  g_checks++;
+  if (actual == expected) {
+    printf("PASS %s (got %d)\n", name, actual);
+  } else {
+    printf("FAIL %s (got %d, expected %d)\n", name, actual, expected);
+    g_failures++;
+  }
+}
+
+static void expect_rect(const curtain_core *core, double min_x, double min_y, double max_x,
+                        double max_y, const char *name) {
+  curtain_rect rect;
+  curtain_core_get_rect(core, &rect);
+  g_checks++;
+  if (rect.min_x == min_x && rect.min_y == min_y && rect.max_x == max_x && rect.max_y == max_y) {
+    printf("PASS %s (%.0f,%.0f,%.0f,%.0f)\n", name, rect.min_x, rect.min_y, rect.max_x, rect.max_y);
+  } else {
+    printf("FAIL %s (got %.0f,%.0f,%.0f,%.0f expected %.0f,%.0f,%.0f,%.0f)\n", name, rect.min_x,
+           rect.min_y, rect.max_x, rect.max_y, min_x, min_y, max_x, max_y);
+    g_failures++;
+  }
+}
+
+static void test_right_peel(void) {
+  curtain_core *core = curtain_core_create(1000, 800);
+  curtain_core_press(core, 990, 400);
+  curtain_core_release(core, 600, 400);
+  expect_rect(core, 0, 0, 600, 800, "right_peel");
+  curtain_core_destroy(core);
+}
+
+static void test_left_peel(void) {
+  curtain_core *core = curtain_core_create(1000, 800);
+  curtain_core_press(core, 10, 400);
+  curtain_core_release(core, 400, 400);
+  expect_rect(core, 400, 0, 1000, 800, "left_peel");
+  curtain_core_destroy(core);
+}
+
+static void test_right_recover(void) {
+  curtain_core *core = curtain_core_create(1000, 800);
+  curtain_core_press(core, 990, 400);
+  curtain_core_release(core, 600, 400);
+  curtain_core_press(core, 300, 400);
+  curtain_core_release(core, 700, 400);
+  expect_rect(core, 0, 0, 700, 800, "right_recover");
+  curtain_core_destroy(core);
+}
+
+static void test_top_reveal(void) {
+  curtain_core *core = curtain_core_create(1000, 800);
+  curtain_core_press(core, 500, 100);
+  curtain_core_release(core, 500, 300);
+  expect_rect(core, 0, 300, 1000, 800, "top_reveal");
+  curtain_core_destroy(core);
+}
+
+static void test_bottom_peel(void) {
+  curtain_core *core = curtain_core_create(1000, 800);
+  curtain_core_press(core, 500, 790);
+  curtain_core_release(core, 500, 300);
+  expect_rect(core, 0, 0, 1000, 300, "bottom_peel");
+  curtain_core_destroy(core);
+}
+
+static void test_min_size_clamp(void) {
+  curtain_core *core = curtain_core_create(1000, 800);
+  curtain_core_press(core, 990, 400);
+  curtain_core_release(core, 5, 400);
+  expect_rect(core, 0, 0, 25, 800, "min_size_clamp");
+  curtain_core_destroy(core);
+}
+
+static void test_close_hot_zone(void) {
+  curtain_core *core = curtain_core_create(1000, 800);
+  curtain_core_press(core, 990, 10);
+  expect_int(curtain_core_should_quit(core), 1, "close_hot_zone");
+  curtain_core_destroy(core);
+}
+
+static void test_press_not_quit(void) {
+  curtain_core *core = curtain_core_create(1000, 800);
+  curtain_core_press(core, 500, 400);
+  expect_int(curtain_core_should_quit(core), 0, "press_not_quit");
+  curtain_core_destroy(core);
+}
+
+static void test_release_reports_change(void) {
+  curtain_core *core = curtain_core_create(1000, 800);
+  int changed;
+  curtain_core_press(core, 990, 400);
+  changed = curtain_core_release(core, 600, 400);
+  expect_int(changed, 1, "release_change_first");
+  curtain_core_press(core, 300, 400);
+  changed = curtain_core_release(core, 300, 400);
+  expect_int(changed, 0, "release_change_none");
+  curtain_core_destroy(core);
+}
+
+static void test_scale_uniform(void) {
+  curtain_core *core = curtain_core_create(200, 100);
+  uint8_t source[40 * 30 * 4];
+  size_t i;
+  int ok;
+  for (i = 0; i < sizeof(source); i += 4) {
+    source[i] = 200;
+    source[i + 1] = 100;
+    source[i + 2] = 50;
+    source[i + 3] = 255;
+  }
+  ok = curtain_core_set_source(core, source, 40, 30);
+  expect_int(ok, 1, "scale_uniform_set_source");
+  expect_int(curtain_core_width(core), 200, "scale_uniform_width");
+  expect_int(curtain_core_height(core), 100, "scale_uniform_height");
+  {
+    const uint8_t *pixels = curtain_core_pixels(core);
+    expect_int(pixels != NULL, 1, "scale_uniform_pixels_not_null");
+    expect_int(pixels[0], 200, "scale_uniform_pixel_r");
+    expect_int(pixels[1], 100, "scale_uniform_pixel_g");
+    expect_int(pixels[2], 50, "scale_uniform_pixel_b");
+    expect_int(pixels[3], 255, "scale_uniform_pixel_a");
+    expect_int(pixels[(99 * 200 + 199) * 4 + 3], 255, "scale_uniform_last_alpha");
+  }
+  curtain_core_destroy(core);
+}
+
+static void test_scale_same_size_exact(void) {
+  curtain_core *core = curtain_core_create(4, 1);
+  uint8_t source[16] = {255, 0,   0,   255, 0,   255, 0,   255,
+                        0,   0,   255, 255, 255, 255, 255, 255};
+  int ok = curtain_core_set_source(core, source, 4, 1);
+  const uint8_t *pixels;
+  expect_int(ok, 1, "scale_exact_set_source");
+  pixels = curtain_core_pixels(core);
+  expect_int(pixels != NULL, 1, "scale_exact_pixels_not_null");
+  expect_int(memcmp(pixels, source, sizeof(source)), 0, "scale_exact_bytes");
+  curtain_core_destroy(core);
+}
+
+static void test_scale_mirror_edges(void) {
+  curtain_core *core = curtain_core_create(8, 1);
+  uint8_t source[8] = {255, 0, 0, 255, 0, 255, 0, 255};
+  int ok = curtain_core_set_source(core, source, 2, 1);
+  const uint8_t *pixels;
+  expect_int(ok, 1, "scale_mirror_set_source");
+  pixels = curtain_core_pixels(core);
+  expect_int(pixels != NULL, 1, "scale_mirror_pixels_not_null");
+  expect_int(pixels[3], 255, "scale_mirror_alpha");
+  expect_int(pixels[(8 * 4) - 1], 255, "scale_mirror_last_alpha");
+  curtain_core_destroy(core);
+}
+
+static void test_invalid_inputs(void) {
+  expect_int(curtain_core_create(0, 100) == NULL, 1, "create_rejects_zero_width");
+  {
+    curtain_core *core = curtain_core_create(100, 100);
+    expect_int(curtain_core_set_source(core, NULL, 10, 10), 0, "set_source_rejects_null");
+    curtain_core_destroy(core);
+  }
+}
+
+int main(void) {
+  printf("curtain_check: upstream geometry port + scaling\n");
+  test_right_peel();
+  test_left_peel();
+  test_right_recover();
+  test_top_reveal();
+  test_bottom_peel();
+  test_min_size_clamp();
+  test_close_hot_zone();
+  test_press_not_quit();
+  test_release_reports_change();
+  test_scale_uniform();
+  test_scale_same_size_exact();
+  test_scale_mirror_edges();
+  test_invalid_inputs();
+  printf("curtain_check: %d checks, %d failures\n", g_checks, g_failures);
+  return g_failures == 0 ? 0 : 1;
+}
