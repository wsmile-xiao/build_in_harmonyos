@@ -0,0 +1,90 @@
+import { AbilityConstant, ConfigurationConstant, UIAbility, Want } from '@kit.AbilityKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { display, window } from '@kit.ArkUI';
+
+const DOMAIN = 0x2843;
+const TAG = 'CurtainHost';
+
+export default class EntryAbility extends UIAbility {
+  private mainWindow: window.Window | null = null;
+
+  onCreate(want: Want, launchParam: AbilityConstant.LaunchParam): void {
+    this.context.getApplicationContext().setColorMode(
+      ConfigurationConstant.ColorMode.COLOR_MODE_NOT_SET);
+    hilog.info(DOMAIN, TAG, 'onCreate');
+  }
+
+  onWindowStageCreate(windowStage: window.WindowStage): void {
+    windowStage.loadContent('pages/Curtain', (err) => {
+      if (err.code) {
+        hilog.error(DOMAIN, TAG, 'loadContent failed code=%{public}d', err.code);
+        return;
+      }
+      hilog.info(DOMAIN, TAG, 'loadContent Curtain ok');
+      this.setupWindow(windowStage);
+    });
+  }
+
+  private async setupWindow(windowStage: window.WindowStage): Promise<void> {
+    let win: window.Window | null = null;
+    try {
+      win = windowStage.getMainWindowSync();
+    } catch (e) {
+      hilog.error(DOMAIN, TAG, 'getMainWindowSync ERR %{public}s', JSON.stringify(e));
+    }
+    if (!win) {
+      hilog.error(DOMAIN, TAG, 'main window unavailable');
+      return;
+    }
+    const w: window.Window = win;
+    this.mainWindow = w;
+    try {
+      const d = display.getDefaultDisplaySync();
+      hilog.info(DOMAIN, TAG, 'display %{public}dx%{public}d density=%{public}f',
+        d.width, d.height, d.densityPixels);
+    } catch (e) {
+      hilog.error(DOMAIN, TAG, 'display ERR %{public}s', JSON.stringify(e));
+    }
+    try {
+      hilog.info(DOMAIN, TAG, 'freeWindowMode=%{public}s', String(w.isInFreeWindowMode()));
+    } catch (e) {
+      hilog.error(DOMAIN, TAG, 'freeWindowMode ERR %{public}s', JSON.stringify(e));
+    }
+    await this.tryAsync('layoutFullScreen', () => w.setWindowLayoutFullScreen(true));
+    await this.tryAsync('systemBarEnable', () => w.setWindowSystemBarEnable([]));
+    this.trySync('bgTransparent', () => w.setWindowBackgroundColor('#00000000'));
+    this.trySync('decorInvisible', () => w.setWindowDecorVisible(false));
+    await this.tryAsync('maximize', () => w.maximize());
+    await this.tryAsync('topmost', () => w.setWindowTopmost(true));
+    this.logRect('main.rect', w);
+  }
+
+  private logRect(name: string, win: window.Window): void {
+    try {
+      const p = win.getWindowProperties();
+      hilog.info(DOMAIN, TAG,
+        '%{public}s=(%{public}d,%{public}d,%{public}d,%{public}d)',
+        name, p.windowRect.left, p.windowRect.top, p.windowRect.width, p.windowRect.height);
+    } catch (e) {
+      hilog.error(DOMAIN, TAG, '%{public}s ERR %{public}s', name, JSON.stringify(e));
+    }
+  }
+
+  private async tryAsync(name: string, fn: () => Promise<void>): Promise<void> {
+    try {
+      await fn();
+      hilog.info(DOMAIN, TAG, '%{public}s OK', name);
+    } catch (e) {
+      hilog.error(DOMAIN, TAG, '%{public}s ERR %{public}s', name, JSON.stringify(e));
+    }
+  }
+
+  private async trySync(name: string, fn: () => void): Promise<void> {
+    try {
+      fn();
+      hilog.info(DOMAIN, TAG, '%{public}s OK', name);
+    } catch (e) {
+      hilog.error(DOMAIN, TAG, '%{public}s ERR %{public}s', name, JSON.stringify(e));
+    }
+  }
+}
