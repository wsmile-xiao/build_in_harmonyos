+static int make_temp_template(char *buffer, size_t size, const char *stem)
+{
+	const char *tmpdir = getenv("TMPDIR");
+	int written;
+
+	if (tmpdir == NULL || tmpdir[0] == '\0') tmpdir = "/tmp";
+	written = snprintf(buffer, size, "%s%s%sXXXXXX", tmpdir,
+			tmpdir[strlen(tmpdir)-1] == '/' ? "" : "/", stem);
+	if (written < 0 || (size_t)written >= size)
+	{
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	return 0;
+}
 
