+                                             std::uint_least32_t line = __builtin_LINE(),
+                                             std::uint_least32_t col = 0) noexcept
+    {
+        source_location sl{};
+        sl.file_ = file;
+        sl.func_ = func;
+        sl.line_ = line;
+        sl.col_ = col;
