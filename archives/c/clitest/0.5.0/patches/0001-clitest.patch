 tt_make_temp_dir() {
     # Create private temporary dir and sets global $tt_temp_dir.
     # http://mywiki.wooledge.org/BashFAQ/062
 
+    # Default base dir when $TMPDIR is unset: /tmp when writable, else $HOME.
+    # Some systems mount /tmp read-only, so it is not a safe hardcoded default.
+    # An explicitly set $TMPDIR is always honored as-is (invalid values must
+    # still fail loudly).
+    if test -n "${TMPDIR:-}"; then
+        tt_temp_base="$TMPDIR"
+    elif test -d /tmp && test -w /tmp; then
+        tt_temp_base='/tmp'
+    else
+        tt_temp_base="${HOME:-.}"
+    fi
+
     # Prefer mktemp when available
-    tt_temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/clitest.XXXXXX" 2> /dev/null) && return 0
+    tt_temp_dir=$(mktemp -d "$tt_temp_base/clitest.XXXXXX" 2> /dev/null) && return 0
 
     # No mktemp, let's create the dir manually
     # shellcheck disable=SC2015
-    tt_temp_dir="${TMPDIR:-/tmp}/clitest.$(awk 'BEGIN { srand(); print rand() }').$$" &&
+    tt_temp_dir="$tt_temp_base/clitest.$(awk 'BEGIN { srand(); print rand() }').$$" &&
         mkdir -m 700 "$tt_temp_dir" ||
         tt_error "cannot create temporary dir: $tt_temp_dir"
 }
 
