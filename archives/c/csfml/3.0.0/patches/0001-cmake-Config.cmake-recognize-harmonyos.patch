--- a/cmake/Config.cmake
+++ b/cmake/Config.cmake
@@ -1,7 +1,9 @@
 # detect the OS
 if(${CMAKE_SYSTEM_NAME} MATCHES "Windows")
     set(SFML_OS_WINDOWS 1)
-elseif(${CMAKE_SYSTEM_NAME} MATCHES "Linux")
+# OpenHarmony PC reports CMAKE_SYSTEM_NAME "HarmonyOS"; CMake has no Platform/HarmonyOS
+# module, so route it into the Linux branch (bionic/musl-compatible libc).
+elseif(${CMAKE_SYSTEM_NAME} MATCHES "Linux|HarmonyOS|OHOS")
     set(SFML_OS_LINUX 1)
 elseif(${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD")
     set(SFML_OS_FREEBSD 1)
