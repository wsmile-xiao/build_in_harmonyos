--- a/bundled/sfml-src/cmake/Config.cmake
+++ b/bundled/sfml-src/cmake/Config.cmake
@@ -16,7 +16,10 @@ if(${CMAKE_SYSTEM_NAME} STREQUAL "Windows")
         message(FATAL_ERROR "Unsupported architecture")
         return()
     endif()
-elseif(${CMAKE_SYSTEM_NAME} STREQUAL "Linux")
+# OpenHarmony PC reports CMAKE_SYSTEM_NAME "HarmonyOS" (SDK triple aarch64-unknown-linux-ohos),
+# which is the same bionic-compatible libc path this branch selects.
+elseif(${CMAKE_SYSTEM_NAME} STREQUAL "Linux" OR ${CMAKE_SYSTEM_NAME} STREQUAL "HarmonyOS"
+       OR ${CMAKE_SYSTEM_NAME} STREQUAL "OHOS")
     set(SFML_OS_UNIX 1)
 
     if(ANDROID)
