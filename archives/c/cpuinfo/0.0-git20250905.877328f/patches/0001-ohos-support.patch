--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -4,7 +4,25 @@
 PROJECT(
     cpuinfo
     LANGUAGES C
     )
+
+# OHOS (HongMeng Kernel) is Linux-compatible for cpuinfo's purposes
+# (/proc/cpuinfo, sysfs, pthreads, ARM Linux sources). Remap to Linux so
+# all Linux branches (sources, unit tests, tools, Threads) apply and
+# CPUINFO_SUPPORTED_PLATFORM stays TRUE. Must run before any
+# CMAKE_SYSTEM_NAME checks below. Conan generate() already forces
+# CMAKE_SYSTEM_NAME=Linux / CMAKE_SYSTEM_PROCESSOR=aarch64 on OHOS
+# (repo precedent: zxc/expected-lite); this is the fallback for direct
+# CMake builds. Cover all known OHOS spellings; some toolchains report
+# HarmonyOS/OpenHarmony instead of OHOS, and PROCESSOR may be "unknown".
+IF(CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR CMAKE_SYSTEM_NAME MATCHES "^(HarmonyOS|OpenHarmony|HarmonyOSNEXT)$")
+  SET(CMAKE_SYSTEM_NAME "Linux")
+ENDIF()
+IF(CMAKE_SYSTEM_PROCESSOR STREQUAL "unknown" OR NOT CMAKE_SYSTEM_PROCESSOR)
+  IF(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
+    SET(CMAKE_SYSTEM_PROCESSOR "aarch64")
+  ENDIF()
+ENDIF()
 
 # ---[ Options.
 SET(CPUINFO_LIBRARY_TYPE "default" CACHE STRING "Type of cpuinfo library (shared, static, or default) to build")
