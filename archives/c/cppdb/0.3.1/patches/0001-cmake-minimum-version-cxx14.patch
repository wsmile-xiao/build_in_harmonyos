--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,12 @@
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.5)
 project(cppdb)
+
+# OHOS port: this 2013-era code uses std::auto_ptr (removed in C++17)
+# and the OHOS Conan profile defaults to C++17. Pin C++14 here so the
+# setting applies regardless of the toolchain's own cppstd handling
+# (a later normal-variable set wins over the toolchain file).
+set(CMAKE_CXX_STANDARD 14)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
 set(CPPDB_MAJOR 0)
 set(CPPDB_MINOR 3)
