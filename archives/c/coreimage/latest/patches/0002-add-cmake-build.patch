--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,65 @@
+cmake_minimum_required(VERSION 3.16)
+project(coreimage VERSION 4.0 LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+set(CMAKE_AUTOMOC ON)
+set(CMAKE_AUTOUIC ON)
+set(CMAKE_AUTORCC ON)
+
+find_package(Qt6 REQUIRED COMPONENTS Core Gui Widgets Concurrent)
+
+# Find libcprime
+find_library(CPRIME_LIBRARY cprime PATHS /storage/Users/currentUser/usr/local/lib)
+set(CPRIME_INCLUDE_DIR /storage/Users/currentUser/usr/local/include/cprime)
+
+set(SOURCES
+    main.cpp
+    coreimage.cpp
+)
+
+set(HEADERS
+    coreimage.h
+)
+
+set(FORMS
+    coreimage.ui
+)
+
+set(RESOURCES
+    icons.qrc
+)
+
+add_executable(coreimage ${SOURCES} ${HEADERS} ${FORMS} ${RESOURCES})
+
+target_include_directories(coreimage PRIVATE ${CPRIME_INCLUDE_DIR})
+
+target_link_libraries(coreimage PRIVATE
+    Qt6::Core
+    Qt6::Gui
+    Qt6::Widgets
+    Qt6::Concurrent
+    ${CPRIME_LIBRARY}
+)
+
+# Define COREAPPS_THEME_FOLDER
+set(THEME_FOLDER "${CMAKE_INSTALL_PREFIX}/share/coreapps/theme")
+target_compile_definitions(coreimage PRIVATE
+    HAVE_POSIX_OPENPT
+    QT_DEPRECATED_WARNINGS
+    COREAPPS_THEME_FOLDER="${THEME_FOLDER}"
+)
+
+install(TARGETS coreimage
+    RUNTIME DESTINATION bin
+)
+
+install(FILES coreimage.desktop
+    DESTINATION share/applications
+)
+
+install(DIRECTORY icons/
+    DESTINATION share/coreapps/icons
+    FILES_MATCHING PATTERN "coreimage.svg"
+)
