+/* OHOS portability: tempnam(NULL) on OHOS ignores $TMPDIR and uses read-only
+ * /tmp, breaking tests that create temporary hosts files.  When $TMPDIR is
+ * set, pass it explicitly as the directory so temporary files land in the
+ * writable location; keep the upstream fallback (NULL) when unset. */
 std::string TempNam(const char *dir, const char *prefix) {
+  std::string envdir;
+  if (dir == nullptr) {
+    const char *tmpdir = getenv("TMPDIR");
+    if (tmpdir != nullptr && tmpdir[0] != '\0') {
+      envdir.assign(tmpdir);
+      dir = envdir.c_str();
+    }
+  }
   char *p = tempnam(dir, prefix);
   std::string result(p);
   free(p);
