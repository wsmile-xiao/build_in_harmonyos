@@ -0,0 +1,44 @@
+package main
+
+import (
+	"net"
+	"testing"
+	"time"
+)
+
+// TestUDPSmoke verifies that a connected UDP socket can round-trip a packet
+// on this platform. If this fails, the DNS-over-UDP tests cannot pass
+// regardless of wire format.
+func TestUDPSmoke(t *testing.T) {
+	server, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("server listen: %v", err)
+	}
+	defer server.Close()
+	go func() {
+		buf := make([]byte, 64)
+		n, peer, err := server.ReadFrom(buf)
+		if err != nil {
+			return
+		}
+		server.WriteTo(buf[:n], peer) // echo
+	}()
+
+	client, err := net.Dial("udp", server.LocalAddr().String())
+	if err != nil {
+		t.Fatalf("client dial: %v", err)
+	}
+	defer client.Close()
+	client.SetDeadline(time.Now().Add(3 * time.Second))
+	if _, err := client.Write([]byte("hello-udp")); err != nil {
+		t.Fatalf("client write: %v", err)
+	}
+	buf := make([]byte, 64)
+	n, err := client.Read(buf)
+	if err != nil {
+		t.Fatalf("client read: %v", err)
+	}
+	if string(buf[:n]) != "hello-udp" {
+		t.Fatalf("echo mismatch: %q", buf[:n])
+	}
+}
