+func TestUpstreamResolver_ResolvesThroughUpstream(t *testing.T) {
+	f := startFakeDNSServer(t, net.ParseIP("192.0.2.1"), nil)
+	res := newUpstreamResolverWithPort("127.0.0.1", &net.Dialer{}, f.port)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	_, ip, err := res.Resolve(ctx, "example.com")
+	if err != nil {
+		t.Fatalf("Resolve failed: %v", err)
+	}
+	if want := net.ParseIP("192.0.2.1"); !ip.Equal(want) {
+		t.Fatalf("Resolve = %v, want %v", ip, want)
+	}
+	if f.queries.Load() == 0 {
+		t.Fatal("expected the resolver to dial the upstream DNS server")
+	}
+}
