+// TestUpstreamResolver_NonLoopbackUpstream verifies that resolveA works when
+// the upstream DNS server is reached via a non-loopback address — the
+// production path, where the DHCP DNS server is a LAN router rather than
+// 127.0.0.1. The fake server listens on 0.0.0.0 and the resolver dials it
+// through the host's first non-loopback IPv4 address, exercising the kernel's
+// source-address selection instead of a hard-coded loopback source.
+func TestUpstreamResolver_NonLoopbackUpstream(t *testing.T) {
+	hostIP := firstNonLoopbackIPv4(t)
+	if hostIP == nil {
+		t.Skip("no non-loopback IPv4 address available on this host")
+	}
+	// Listen on all interfaces so the query can reach the fake server via
+	// the host's non-loopback address.
+	f := startFakeDNSServerOn(t, "0.0.0.0:0", net.ParseIP("192.0.2.7"), nil)
+	res := newUpstreamResolverWithPort(hostIP.String(), &net.Dialer{}, f.port)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	ip, err := res.resolveA(ctx, "example.com")
+	if err != nil {
+		t.Fatalf("resolveA via non-loopback upstream %s failed: %v", hostIP, err)
+	}
+	if want := net.ParseIP("192.0.2.7"); !ip.Equal(want) {
+		t.Fatalf("resolveA via non-loopback upstream = %v, want %v", ip, want)
+	}
+	if f.queries.Load() == 0 {
+		t.Fatal("expected the fake DNS server to receive at least one query")
+	}
+}
+
+// firstNonLoopbackIPv4 returns the first non-loopback IPv4 address of the
+// host, or nil if there is none (e.g. a loopback-only environment).
+func firstNonLoopbackIPv4(t *testing.T) net.IP {
+	t.Helper()
+	addrs, err := net.InterfaceAddrs()
+	if err != nil {
+		t.Fatalf("enumerating interfaces: %v", err)
+	}
+	for _, a := range addrs {
+		ipnet, ok := a.(*net.IPNet)
+		if !ok {
+			continue
+		}
+		ip4 := ipnet.IP.To4()
+		if ip4 == nil || ip4.IsLoopback() {
+			continue
+		}
+		return ip4
+	}
+	return nil
+}
