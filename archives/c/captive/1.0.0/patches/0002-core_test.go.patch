+// ─── Fake DNS server (DNS wire protocol) ─────────────────────────────────────
+
+type fakeDNS struct {
+	queries atomic.Int64
+	port    int
+}
+
+// startFakeDNSServer starts a minimal UDP DNS server that answers every query
+// with the given A and/or AAAA record. It returns the bound port.
+func startFakeDNSServer(t *testing.T, a, aaaa net.IP) *fakeDNS {
+	t.Helper()
+	return startFakeDNSServerOn(t, "127.0.0.1:0", a, aaaa)
+}
+
+// startFakeDNSServerOn is like startFakeDNSServer but listens on the given
+// address, so tests can place the fake DNS server on a non-loopback address.
+func startFakeDNSServerOn(t *testing.T, listenAddr string, a, aaaa net.IP) *fakeDNS {
+	t.Helper()
+	conn, err := net.ListenPacket("udp", listenAddr)
+	if err != nil {
+		t.Fatalf("listening for fake DNS: %v", err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	f := &fakeDNS{port: conn.LocalAddr().(*net.UDPAddr).Port}
+	go func() {
+		buf := make([]byte, 512)
+		for {
+			n, peer, err := conn.ReadFrom(buf)
+			if err != nil {
+				return // listener closed
+			}
+			if n < 12 {
+				continue
+			}
+			f.queries.Add(1)
+			// Answer with the record type matching the first question's QTYPE
+			// (Go's resolver sends separate A and AAAA queries).
+			qtype := uint16(0)
+			if pos := skipName(buf, 12); pos >= 0 && pos+2 <= n {
+				qtype = binary.BigEndian.Uint16(buf[pos : pos+2])
+			}
+			conn.WriteTo(dnsResponse(buf[:n], a, aaaa, qtype), peer)
+		}
+	}()
+	return f
+}
+
+// dnsResponse builds a DNS response for the given query: it echoes the ID and
+// the question section verbatim, answers the first question with the record
+// matching its QTYPE (A → A record, AAAA → AAAA record; Go's resolver sends
+// separate A and AAAA queries), and deliberately omits the additional section
+// (replying without the client's EDNS0 OPT record is valid per RFC 6891 and
+// avoids re-serializing the OPT RDATA).
+func dnsResponse(query []byte, a, aaaa net.IP, qtype uint16) []byte {
+	// DNS header layout (RFC 1035):
+	//   [0:2] ID  [2:4] FLAGS  [4:6] QDCOUNT  [6:8] ANCOUNT
+	//   [8:10] NSCOUNT  [10:12] ARCOUNT
+	if len(query) < 12 {
+		return nil
+	}
+	qdcount := binary.BigEndian.Uint16(query[4:6])
+	flags := binary.BigEndian.Uint16(query[2:4])
+
+	// Echo the question section verbatim.
+	pos := 12
+	var questions []byte
+	for i := uint16(0); i < qdcount; i++ {
+		start := pos
+		pos = skipName(query, pos)
+		if pos < 0 || pos+4 > len(query) {
+			return nil
+		}
+		pos += 4 // QTYPE + QCLASS
+		questions = append(questions, query[start:pos]...)
+	}
+
+	var rdata []byte
+	switch qtype {
+	case 1: // A
+		if a != nil {
+			rdata = a.To4()
+		}
+	case 28: // AAAA
+		if aaaa != nil {
+			rdata = aaaa.To16()
+		}
+	}
+
+	resp := make([]byte, 0, len(query)+64)
+	resp = append(resp, query[:2]...) // ID
+	resp = binary.BigEndian.AppendUint16(resp, flags|0x8000) // QR=1 (bit 15)
+	resp = binary.BigEndian.AppendUint16(resp, qdcount)
+	if rdata != nil {
+		resp = binary.BigEndian.AppendUint16(resp, 1) // ANCOUNT
+	} else {
+		resp = binary.BigEndian.AppendUint16(resp, 0)
+	}
+	resp = binary.BigEndian.AppendUint16(resp, 0) // NSCOUNT
+	resp = binary.BigEndian.AppendUint16(resp, 0) // ARCOUNT (drop OPT)
+	resp = append(resp, questions...)
+
+	if rdata != nil {
+		resp = append(resp, 0xC0, 0x0C) // name pointer to first question
+		resp = binary.BigEndian.AppendUint16(resp, qtype)
+		resp = binary.BigEndian.AppendUint16(resp, 1) // class IN
+		resp = binary.BigEndian.AppendUint32(resp, 60) // TTL (4 bytes)
+		resp = binary.BigEndian.AppendUint16(resp, uint16(len(rdata)))
+		resp = append(resp, rdata...)
+	}
+	return resp
+}
+
+// skipName returns the offset just past the (uncompressed) name starting at
+// pos in a DNS wire message.
+func skipName(msg []byte, pos int) int {
+	for {
+		l := int(msg[pos])
+		pos++
+		if l&0xC0 != 0 {
+			return pos + 1 // compression pointer
+		}
+		if l == 0 {
+			return pos
+		}
+		pos += l
+	}
+}
