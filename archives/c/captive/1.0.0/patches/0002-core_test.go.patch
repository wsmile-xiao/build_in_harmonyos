+// ─── SOCKS5 proxy end-to-end ─────────────────────────────────────────────────
+
+func readExact(t *testing.T, r io.Reader, n int) []byte {
+	t.Helper()
+	buf := make([]byte, n)
+	if _, err := io.ReadFull(r, buf); err != nil {
+		t.Fatalf("reading %d bytes: %v", n, err)
+	}
+	return buf
+}
+
+// TestSocksProxy_EndToEnd verifies the full data path: a SOCKS5 client
+// connects to the proxy, the proxy resolves the target host through the
+// (fake) upstream DNS server, and bytes are tunneled to the target.
+func TestSocksProxy_EndToEnd(t *testing.T) {
+	// Fake upstream DNS: every name resolves to 127.0.0.1, where the target
+	// HTTP server listens. This proves the proxy redirects DNS to upstream.
+	f := startFakeDNSServer(t, net.ParseIP("127.0.0.1"), nil)
+
+	// Fake captive-portal target.
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		fmt.Fprintf(w, "portal-ok path=%s", r.URL.Path)
+	}))
+	defer target.Close()
+	targetURL, err := url.Parse(target.URL)
+	if err != nil {
+		t.Fatalf("parsing target URL: %v", err)
+	}
+	// The CONNECT target must be a DOMAIN NAME, not an IP literal: Go's
+	// resolver never queries DNS for IP literals, so only a domain exercises
+	// the proxy's upstream-DNS redirection. The fake DNS maps every name to
+	// 127.0.0.1, where the target server listens.
+	host := "captive-portal.test"
+
+	// Start the SOCKS5 proxy exactly like StartSocksProxy does, but with a
+	// test DNS port (StartSocksProxy hardcodes port 53).
+	dialer := &net.Dialer{}
+	srv, err := socks5.New(&socks5.Config{
+		Resolver: newUpstreamResolverWithPort("127.0.0.1", dialer, f.port),
+		Dial:     dialer.DialContext,
+		Logger:   log.New(io.Discard, "", 0),
+	})
+	if err != nil {
+		t.Fatalf("socks5.New: %v", err)
+	}
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listening for proxy: %v", err)
+	}
+	defer l.Close()
+	go srv.Serve(l)
+
+	// Client handshake (RFC 1928): version + zero auth methods.
+	c, err := net.Dial("tcp", l.Addr().String())
+	if err != nil {
+		t.Fatalf("dialing proxy: %v", err)
+	}
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(15 * time.Second))
+
+	c.Write([]byte{0x05, 0x01, 0x00}) // 1 auth method: no-auth
+	reply := readExact(t, c, 2)
+	if reply[0] != 0x05 || reply[1] != 0x00 {
+		t.Fatalf("auth reply = % x, want 05 00 (no-auth accepted)", reply)
+	}
+
+	// CONNECT request: domain-name addressing of the target host.
+	port := targetURL.Port()
+	if port == "" {
+		port = "80"
+	}
+	request := []byte{0x05, 0x01, 0x00, 0x03, byte(len(host))}
+	request = append(request, host...)
+	request = binary.BigEndian.AppendUint16(request, uint16(mustAtoi(t, port)))
+	c.Write(request)
+
+	// Reply: VER REP RSV ATYP + bound address + port.
+	header := readExact(t, c, 4)
+	if header[0] != 0x05 || header[1] != 0x00 {
+		t.Fatalf("connect reply = % x, want 05 00 .. (success)", header)
+	}
+	switch header[3] {
+	case 1: // IPv4
+		readExact(t, c, 4+2)
+	case 3: // domain
+		l := int(readExact(t, c, 1)[0])
+		readExact(t, c, l+2)
+	case 4: // IPv6
+		readExact(t, c, 16+2)
+	default:
+		t.Fatalf("unexpected bound address type %d", header[3])
+	}
+
+	// Tunnel an HTTP request through the proxy.
+	fmt.Fprintf(c, "GET /login HTTP/1.0\r\nHost: %s\r\n\r\n", host)
+	body, err := io.ReadAll(c)
+	if err != nil {
+		t.Fatalf("reading tunneled response: %v", err)
+	}
+	if !strings.Contains(string(body), "portal-ok path=/login") {
+		t.Fatalf("tunneled response missing payload: %q", string(body))
+	}
+	if f.queries.Load() == 0 {
+		t.Fatal("expected the proxy to resolve the target through the upstream DNS server")
+	}
+}
