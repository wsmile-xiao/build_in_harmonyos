+func TestExecute_BrowserReceivesProxyEnv(t *testing.T) {
+	port := freePort(t)
+	outFile := filepath.Join(t.TempDir(), "proxy-out.txt")
+
+	conf := &Config{
+		SOCKS5Addr: fmt.Sprintf("127.0.0.1:%d", port),
+		Browser:    fmt.Sprintf("echo PROXY=$PROXY > %s", outFile),
+		DHCP:       "echo 192.0.2.53",
+	}
+	if err := Execute(conf, "192.0.2.53"); err != nil {
+		t.Fatalf("Execute: %v", err)
+	}
+
+	data, err := os.ReadFile(outFile)
+	if err != nil {
+		t.Fatalf("reading browser output: %v", err)
+	}
+	want := fmt.Sprintf("PROXY=127.0.0.1:%d\n", port)
+	if string(data) != want {
+		t.Fatalf("browser saw %q, want %q", string(data), want)
+	}
+}
+
+func TestExecute_BrowserFailurePropagates(t *testing.T) {
+	port := freePort(t)
+	conf := &Config{
+		SOCKS5Addr: fmt.Sprintf("127.0.0.1:%d", port),
+		Browser:    "exit 3",
+		DHCP:       "echo 192.0.2.53",
+	}
+	if err := Execute(conf, "192.0.2.53"); err == nil {
+		t.Fatal("expected Execute to report the browser failure")
+	}
+}
