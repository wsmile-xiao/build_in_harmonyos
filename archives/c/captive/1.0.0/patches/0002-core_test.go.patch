+func TestSocksProxy_RejectsBadVersion(t *testing.T) {
+	srv, err := socks5.New(&socks5.Config{
+		Resolver: &upstreamResolverForReject{},
+		Dial:     (&net.Dialer{}).DialContext,
+		Logger:   log.New(io.Discard, "", 0),
+	})
+	if err != nil {
+		t.Fatalf("socks5.New: %v", err)
+	}
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listening: %v", err)
+	}
+	defer l.Close()
+	go srv.Serve(l)
+
+	c, err := net.Dial("tcp", l.Addr().String())
+	if err != nil {
+		t.Fatalf("dialing: %v", err)
+	}
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(5 * time.Second))
+	c.Write([]byte{0x04, 0x00}) // SOCKS4 is not supported
+	_, _ = c.Read(make([]byte, 1))
+	// The server closes the connection; we only require the connection to be
+	// closed (EOF or reset) without panicking.
+	if _, err := c.Read(make([]byte, 1)); err == nil {
+		t.Fatal("expected the server to close the connection for a bad version")
+	}
+}
