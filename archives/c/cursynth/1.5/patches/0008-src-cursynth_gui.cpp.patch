+/* cursynth: no-NLS fallback for gettext.  Systems without message catalogue
+   support (no libintl implementation) may still ship <libintl.h> without the
+   gettext()/textdomain() prototypes; fall back to untranslated strings and
+   no-op catalogue setup when NLS is disabled. */
+#if !defined(ENABLE_NLS)
+/* no-NLS fallback for gettext (undef-based): some libc ports ship a
+   <libintl.h> that renames gettext to g_libintl_gettext without providing
+   the implementation; with NLS disabled, discard any such definition and
+   fall back to the untranslated strings. */
+#ifdef gettext
+#undef gettext
+#endif
+#ifdef bindtextdomain
+#undef bindtextdomain
+#endif
+#ifdef textdomain
+#undef textdomain
+#endif
+#define gettext(String) (String)
+#define bindtextdomain(Domain, Dir) ((char *) (Dir))
+#define textdomain(Domain) ((char *) (Domain))
+#endif
