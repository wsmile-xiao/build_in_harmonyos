--- a/src/file.cc
+++ b/src/file.cc
@@ -279,7 +279,15 @@
   struct passwd *p = getpwuid(getuid());
   if (0 == p)
     {
-      fatal_quit(-1, "UID %d not found in password file.", getuid());
+      /* Some environments (e.g. HarmonyOS application sandboxes) have
+       * UIDs with no entry in the password file; getpwuid() then
+       * returns NULL.  Fall back to the USER environment variable
+       * (or "unknown"), like the !CONFIG_UIDS variant of this
+       * function does, instead of aborting. */
+      const char *s = getenv("USER");
+      if (s && *s)
+        return s;
+      return "unknown";
     }
   return p->pw_name;
 }
