--- a/unit-tests/googletest/src/gtest-port.cc
+++ b/unit-tests/googletest/src/gtest-port.cc
@@ -932,7 +932,16 @@
     // use /sdcard.
     char name_template[] = "/sdcard/gtest_captured_stream.XXXXXX";
 #  else
-    char name_template[] = "/tmp/captured_stream.XXXXXX";
+    // Honour $TMPDIR when set: P_tmpdir (/tmp) may be read-only on
+    // some platforms (e.g. HarmonyOS).
+    char name_template[4096];
+    {
+      const char *td = getenv("TMPDIR");
+      if (NULL == td || !*td)
+        td = "/tmp";
+      snprintf(name_template, sizeof(name_template),
+               "%s/captured_stream.XXXXXX", td);
+    }
 #  endif  // GTEST_OS_LINUX_ANDROID
     const int captured_fd = mkstemp(name_template);
     filename_ = name_template;
