--- a/src/sccs.c
+++ b/src/sccs.c
@@ -1944,6 +1944,29 @@
   tfp = tmpfile();
   if (tfp == NULL)
     {
+      /* tmpfile() uses P_tmpdir (/tmp), which may be read-only (e.g.
+       * on HarmonyOS); fall back to an unlinked mkstemp file in
+       * $TMPDIR. */
+      char tmpl[4096];
+      const char *dir = getenv ("TMPDIR");
+      int tfd;
+      if (dir == NULL || !*dir)
+        dir = "/tmp";
+      snprintf (tmpl, sizeof (tmpl), "%s/sccs-pfile-XXXXXX", dir);
+      tfd = mkstemp (tmpl);
+      if (tfd >= 0)
+        {
+          tfp = fdopen (tfd, "w+b");
+          if (tfp == NULL)
+            {
+              /* fdopen failed: do not leak the descriptor. */
+              close (tfd);
+            }
+          unlink (tmpl);
+        }
+    }
+  if (tfp == NULL)
+    {
       usrerr ("cannot create temporary file");
       fclose(pfp);
       free(pfn);
@@ -2334,10 +2357,14 @@
   pw = getpwuid (getuid ());
   if (pw == NULL)
     {
-      syserr ("Who are you?\n"
-              "You don't seem to have an entry in the user database "
-              "(/etc/passwd) (uid=%d)", (int)getuid ());
-      exit (CSSC_EX_OSERR);
+      /* Some environments (e.g. HarmonyOS application sandboxes) have
+       * UIDs with no entry in the user database; fall back to the
+       * USER environment variable (or "unknown") instead of
+       * aborting. */
+      const char *u = getenv ("USER");
+      if (u != NULL && *u != '\0')
+        return u;
+      return "unknown";
     }
   return (pw->pw_name);
 }
