+/* tmpfile() with a fallback: P_tmpdir (/tmp) may be read-only (e.g.
+ * on HarmonyOS), in which case retry with an unlinked mkstemp file
+ * in $TMPDIR. */
+static FILE *make_temp_file(void)
+{
+  FILE *fp = tmpfile();
+  if (NULL == fp)
+    {
+      char tmpl[4096];
+      const char *dir = getenv("TMPDIR");
+      int fd;
+      if (NULL == dir || !*dir)
+        dir = "/tmp";
+      snprintf(tmpl, sizeof(tmpl), "%s/test_linebuf-XXXXXX", dir);
+      fd = mkstemp(tmpl);
+      if (fd >= 0)
+        {
+          fp = fdopen(fd, "w+b");
+          if (NULL == fp)
+            {
+              /* fdopen failed: do not leak the descriptor. */
+              close(fd);
+            }
+          unlink(tmpl);
+        }
+    }
+  return fp;
+}
+
