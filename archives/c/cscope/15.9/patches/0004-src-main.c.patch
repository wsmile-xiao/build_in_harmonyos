+    orig_umask = umask(S_IRWXO);
     pid = getpid();
     snprintf(tempdirpv, sizeof(tempdirpv), "%s/cscope.%d", tmpdir, pid);
     if(mkdir(tempdirpv,S_IRWXU)) {
 	fprintf(stderr, "\
 cscope: Could not create private temp dir %s\n",
 		tempdirpv);
 	myexit(1);
     }
     umask(orig_umask);
 
