--- a/src/processManager.cc	2026-06-11 19:23:57.000000000 +0800
+++ b/src/processManager.cc	2026-09-12 18:54:35.993177483 +0800
@@ -192,8 +192,15 @@
   {
     if (threadID != pthread_self())
     {
+#if defined(__GLIBC__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__NetBSD__) || defined(__OpenBSD__) || defined(__DragonFly__)
       pthread_cancel(threadID);
       Debug(PROCESS_MANAGER, "process killed: %ld", threadID);
+#else
+      /* libc without pthread cancellation (musl): kill_processes() is only
+       * reached from cdo_exit(), which calls std::exit(EXIT_FAILURE) right
+       * afterwards, so the worker threads end together with the process. */
+      Debug(PROCESS_MANAGER, "process terminated by exit: %ld", threadID);
+#endif
     }
   }
 }
