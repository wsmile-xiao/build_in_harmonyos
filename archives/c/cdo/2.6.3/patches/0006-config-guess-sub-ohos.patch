@@ -163,6 +163,10 @@
 				basic_machine=$field1-unknown
 				basic_os=linux-android
 				;;
+	ohos-linux)
+				basic_machine=$field1-unknown
+				basic_os=linux-ohos
+				;;
 			*)
 				basic_machine=$field1-$field2
 				basic_os=$field3
