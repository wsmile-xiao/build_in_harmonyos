diff -ruN a/Release/cmake-platforms/ohos-toolchain.cmake b/Release/cmake-platforms/ohos-toolchain.cmake
--- a/Release/cmake-platforms/ohos-toolchain.cmake
+++ b/Release/cmake-platforms/ohos-toolchain.cmake
@@ -0,0 +1,19 @@
+# CMake toolchain file for HarmonyOS native compilation
+# Addresses missing libc++ headers and sysroot configuration
+# Uses -I for includes (higher priority than -isystem from Boost)
+# Uses --sysroot for linker (so system libs like libc, libm, libpthread are found)
+set(OHOS_SDK_ROOT "/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native")
+set(CXX_LIBCXX_INC "${OHOS_SDK_ROOT}/llvm/include/libcxx-ohos/include/c++/v1")
+set(OHOS_SYSROOT "${OHOS_SDK_ROOT}/sysroot")
+set(OHOS_SYSROOT_INC "${OHOS_SYSROOT}/usr/include")
+set(CXX_LIBCXX_LIB "${OHOS_SDK_ROOT}/llvm/lib/aarch64-linux-ohos")
+
+# Use -I for sysroot includes (higher priority than -isystem from Boost)
+# This ensures pthread.h from sysroot (with pthread_cond_clockwait) is found first
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -I${CXX_LIBCXX_INC} -I${OHOS_SYSROOT_INC}" CACHE STRING "" FORCE)
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -I${OHOS_SYSROOT_INC}" CACHE STRING "" FORCE)
+
+# Use --sysroot for linker flags (so system libs like libc, libm, libpthread are found)
+# Also add libc++ and libc++abi library paths
+set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} --sysroot=${OHOS_SYSROOT} -L${CXX_LIBCXX_LIB} -L${OHOS_SYSROOT}/usr/lib/aarch64-linux-ohos" CACHE STRING "" FORCE)
+set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} --sysroot=${OHOS_SYSROOT} -L${CXX_LIBCXX_LIB} -L${OHOS_SYSROOT}/usr/lib/aarch64-linux-ohos" CACHE STRING "" FORCE)
