@@ -25,10 +25,29 @@
     = { "open", "openat",   "read",     "write",  "execve", "execveat",
         "mmap", "mprotect", "sendfile", "ptrace", "fork" };
 
+static FILE *
+open_trace_tmpfile (void)
+{
+  const char *td = getenv ("TMPDIR");
+  if (td == NULL || *td == '\0')
+    td = "/tmp";
+  char *tpl = malloc (strlen (td) + sizeof ("/ceccomp-trace-XXXXXX"));
+  if (tpl == NULL)
+    return NULL;
+  strcpy (tpl, td);
+  strcat (tpl, "/ceccomp-trace-XXXXXX");
+  int fd = mkstemp (tpl);
+  unlink (tpl);
+  free (tpl);
+  if (fd < 0)
+    return NULL;
+  return fdopen (fd, "w+");
+}
+
 static uint32_t
 fetch_text_from_trace (FILE **text, char *argv[], bool quiet)
 {
-  *text = tmpfile ();
+  *text = open_trace_tmpfile ();
   if (*text == NULL)
     error (M_REQUEST_TMPFILE_FAILED, strerror (errno));
   fcntl (fileno (*text), F_SETFD, FD_CLOEXEC);
