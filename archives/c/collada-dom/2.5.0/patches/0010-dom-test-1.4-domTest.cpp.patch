 daeArray* getSkewArray(daeElement* node, const string& sid) {
     if (!node)
         return NULL;
 
     daeElement* skew = resolveSid(sid, *node);
     if (!skew || strcmp(skew->getTypeName(), COLLADA_TYPE_SKEW) )
         return NULL;
 
     return (daeArray*)skew->getCharDataObject()->get(skew);
 }
 
