+
+// Minimal in-library gzip support: the upstream zipFile test loads
+// cube.dae.gz (gzip magic 0x1f 0x8b), but neither this library nor the
+// bundled libxml2 (built without runtime zlib) decompresses gzip, so the
+// raw stream reaches the XML parser as garbage. Decompress it here with the
+// bundled zlib before parsing.
+static std::string readGzipFile(const daeURI& uri)
+{
+    std::string path = cdom::uriToNativePath(uri.getURI());
+    std::ifstream in(path.c_str(), std::ios::binary);
+    unsigned char m[2] = { 0, 0 };
+    if (!in.read((char*)m, 2) || m[0] != 0x1f || m[1] != 0x8b)
+        return ""; // not a gzip stream
+    in.close();
+    gzFile gz = gzopen(path.c_str(), "rb");
+    if (!gz)
+        return "";
+    std::string out;
+    char buf[65536];
+    int n = 0;
+    while ((n = gzread(gz, buf, sizeof(buf))) > 0)
+        out.append(buf, n);
+    gzclose(gz);
+    return out;
 }
 
