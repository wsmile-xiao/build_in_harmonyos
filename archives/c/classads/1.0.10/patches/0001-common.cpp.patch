+// emit undefined references. Provide the symbol with the exact libc++
+// ABI via an asm alias to a hand-written forwarder.
+#include <ostream>
+#include <string>
+std::basic_ostream<char, std::char_traits<char> >&
+__attribute__((weak)) __cnats_ohos_os_string_out(std::basic_ostream<char, std::char_traits<char> >& os,
+                           const std::basic_string<char>& s)
+    __asm__("_ZNSt4__n1lsIcNS_11char_traitsIcEENS_9allocatorIcEEEERNS_13basic_ostreamIT_T0_EES9_RKNS_12basic_stringIS6_S7_T1_EE");
+std::basic_ostream<char, std::char_traits<char> >&
+__attribute__((weak)) __cnats_ohos_os_string_out(std::basic_ostream<char, std::char_traits<char> >& os,
+                           const std::basic_string<char>& s)
+{
+    return os.write(s.data(), static_cast<std::streamsize>(s.size()));
