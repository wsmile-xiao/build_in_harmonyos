--- a/cmake/CompileOptions.cmake
+++ b/cmake/CompileOptions.cmake
@@ -1,32 +1,37 @@
 
 #
 # Platform and architecture setup
 #
 
 # Get upper case system name
 string(TOUPPER ${CMAKE_SYSTEM_NAME} SYSTEM_NAME_UPPER)
+# HarmonyOS is Linux-userland compatible (musl, /proc/self/exe, dladdr,
+# getpwuid): map OHOS/HarmonyOS to the SYSTEM_LINUX code paths.
+if(SYSTEM_NAME_UPPER MATCHES "^(OHOS|HARMONYOS)$")
+    set(SYSTEM_NAME_UPPER "LINUX")
+endif()
 
 # Determine architecture (32/64 bit)
 set(X64 OFF)
 if(CMAKE_SIZEOF_VOID_P EQUAL 8)
     set(X64 ON)
 endif()
 
 
 #
 # Project options
 #
 
 set(DEFAULT_PROJECT_OPTIONS
     DEBUG_POSTFIX             "d"
-    CXX_STANDARD              11 # Not available before CMake 3.1; see below for manual command line argument addition
+    CXX_STANDARD              11
     C_STANDARD                11
     LINKER_LANGUAGE           "CXX"
     POSITION_INDEPENDENT_CODE ON
     CXX_VISIBILITY_PRESET     "hidden"
     CXX_EXTENSIONS            Off
 )
 
 
 #
 # Include directories
