--- a/test/option_test.c
+++ b/test/option_test.c
@@ -6,5 +6,36 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <unistd.h>
+
+/* Preserve tmpfile() where available and fall back to a writable directory. */
+static FILE *portable_tmpfile(void)
+{
+  const char *tmpdir;
+  char template[256];
+  FILE *file;
+  int fd;
+
+  file = tmpfile();
+  if (file != NULL) {
+    return file;
+  }
+
+  tmpdir = getenv("TMPDIR");
+  if (tmpdir == NULL || tmpdir[0] == '\0') {
+    tmpdir = getenv("HOME");
+  }
+  if (tmpdir == NULL || tmpdir[0] == '\0') {
+    tmpdir = "/tmp";
+  }
+  snprintf(template, sizeof(template), "%s/cargs_test_XXXXXX", tmpdir);
+  fd = mkstemp(template);
+  if (fd < 0) {
+    return NULL;
+  }
+  unlink(template);
+  return fdopen(fd, "w+");
+}
+#define tmpfile portable_tmpfile
 
