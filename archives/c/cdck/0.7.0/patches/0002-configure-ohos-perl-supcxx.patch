diff --git a/configure b/configure
--- a/configure
+++ b/configure
@@ -9041,15 +9041,25 @@
 
 echo $_echo_n "checking perl version ... $_echo_c"
 (perl -version 2> /dev/null | grep 'perl' > /dev/null 2>&1) || {
-	echo "not found"
-	echo "*** You must have perl version 5 or higher to compile $PACKAGE."
-   	echo "*** (available at ftp://ftp.perl.org/pub/CPAN/src/stable.tar.gz)"
-   	exit 1
+	echo "not found -- continuing without perl (OHOS port: compiler version probe skipped)"
+	HAVE_PERL=no
 }
+if test "x$HAVE_PERL" != "xno"; then
 echo "ok"
+fi
 
 test "$prefix" = "NONE" && prefix='/usr/local'
 
+# OHOS port: the 2001-era gcc version probe below uses `exec 15>` plus a
+# perl gcc-version parse. Under OHOS /bin/sh it dies with
+# `configure[9073]: 15: inaccessible or not found` (exit 127) and the check
+# is meaningless for clang (assumed new enough); skip it for clang.
+case "${CC:-}" in
+*clang*) HAVE_PERL=no ;;
+esac
+if test "x$HAVE_PERL" = "xno"; then
+echo "skipped (OHOS port: assuming the compiler is new enough)"
+else
 echo $_echo_n "checking version of ${CC} ... $_echo_c"
 exec 15> ./.gcc.test
 cat >&15 <<EOF
@@ -9067,6 +9077,7 @@
 echo " - ok, good enough"
 fi
 rm -f ./.gcc.test
+fi
 
 echo "$as_me:$LINENO: checking for ANSI C header files" >&5
 echo $ECHO_N "checking for ANSI C header files... $ECHO_C" >&6
@@ -9262,7 +9266,14 @@
    CXXFLAGS="$CXXFLAGS -Wall -Wwrite-strings -Woverloaded-virtual -fno-exceptions -fno-rtti -export-dynamic "
 fi
 
-SUPCXX=`gcc -print-file-name=libsupc++.a`
+# OHOS port: the C++ runtime comes from the toolchain (clang+libc++),
+# not gcc's libsupc++.a. Resolve via $CC and keep it only when it is a
+# real absolute file path; otherwise link without it.
+SUPCXX=`${CC:-gcc} -print-file-name=libsupc++.a 2>/dev/null`
+case "$SUPCXX" in
+  /*) test -f "$SUPCXX" || SUPCXX="" ;;
+  *) SUPCXX="" ;;
+esac
 
 LIBS="$SUPCXX $LIBS"
 
