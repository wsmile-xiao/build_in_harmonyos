--- a/cmake/FindLLVM.cmake
+++ b/cmake/FindLLVM.cmake
@@ -98,20 +98,37 @@
     OUTPUT_STRIP_TRAILING_WHITESPACE
   )
 
   execute_process(
     COMMAND ${LLVM_CONFIG_EXECUTABLE} --libfiles
     OUTPUT_VARIABLE LLVM_LIBS
     OUTPUT_STRIP_TRAILING_WHITESPACE
   )
   string(REPLACE " " ";" LLVM_LIBS ${LLVM_LIBS}) # Make it consistent with --libs
 
+  # Filter out non-existent library files; use monolithic libLLVM.so as fallback
+  # (OHOS SDK LLVM ships only libLLVM.so, not individual component .so files)
+  set(LLVM_LIBS_FILTERED "")
+  set(LLVM_NEEDS_MONOLITHIC FALSE)
+  foreach(lib_file ${LLVM_LIBS})
+    if(EXISTS "${lib_file}")
+      list(APPEND LLVM_LIBS_FILTERED "${lib_file}")
+    else()
+      set(LLVM_NEEDS_MONOLITHIC TRUE)
+    endif()
+  endforeach()
+  if(LLVM_NEEDS_MONOLITHIC)
+    set(LLVM_LIBS "${LLVM_LIBRARY_DIRS}/libLLVM.so")
+  else()
+    set(LLVM_LIBS ${LLVM_LIBS_FILTERED})
+  endif()
+
   execute_process(
     COMMAND ${LLVM_CONFIG_EXECUTABLE} --system-libs
     OUTPUT_VARIABLE LLVM_SYSTEM_LIBS
     OUTPUT_STRIP_TRAILING_WHITESPACE
   )
 
   execute_process(
     COMMAND ${LLVM_CONFIG_EXECUTABLE} --prefix
     OUTPUT_VARIABLE LLVM_INSTALL_PREFIX
     OUTPUT_STRIP_TRAILING_WHITESPACE
