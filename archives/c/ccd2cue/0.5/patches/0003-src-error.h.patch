--- /dev/null
+++ b/src/error.h
@@ -0,0 +1,33 @@
+/* error.h - Minimal GNU error.h compatibility for musl/OHOS. */
+#ifndef CCD2CUE_OHOS_ERROR_H
+#define CCD2CUE_OHOS_ERROR_H
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static inline void
+ccd2cue_error (int status, int errnum, const char *format, ...)
+  __attribute__ ((format (printf, 3, 4)));
+
+static inline void
+ccd2cue_error (int status, int errnum, const char *format, ...)
+{
+  va_list ap;
+
+  fflush (stdout);
+  va_start (ap, format);
+  vfprintf (stderr, format, ap);
+  va_end (ap);
+  if (errnum)
+    fprintf (stderr, ": %s", strerror (errnum));
+  fputc ('\n', stderr);
+  if (status)
+    exit (status);
+}
+
+#define error ccd2cue_error
+
+#endif /* CCD2CUE_OHOS_ERROR_H */
