diff --git a/lib/colord/cd-icc.c b/lib/colord/cd-icc.c
index 9c62d49..ad1a37d 100644
--- a/lib/colord/cd-icc.c
+++ b/lib/colord/cd-icc.c
@@ -397,7 +397,21 @@ cd_icc_to_string (CdIcc *icc)
 			continue;
 		}
 		g_string_append_printf (str, "  size\t%i\n", tag_size);
-		cmsReadRawTag (priv->lcms_profile, sig, &tmp, 4);
+		/* cmsReadRawTag() can only return the first bytes of a tag that has
+		 * not been decoded yet; for a tag that was already read (e.g. the
+		 * dictType 'meta' tag decoded by cd_icc_load_metadata()) it has to
+		 * re-serialize the whole object and FAILS when the supplied buffer
+		 * is smaller than the whole tag.  In that failure case @tmp would
+		 * keep the stale 4-byte type from the previous iteration, which
+		 * makes us treat a dictionary as an MLU and crashes lcms.  Allocate
+		 * a buffer big enough for the whole tag and only use the first 4
+		 * bytes for the type signature. */
+		g_autofree guint8 *tag_data = g_malloc (tag_size);
+		if (cmsReadRawTag (priv->lcms_profile, sig, tag_data, tag_size) < 4) {
+			g_string_append_printf (str, "  type\t<unknown>\n");
+			continue;
+		}
+		memcpy (&tmp, tag_data, 4);
 
 		cd_icc_uint32_to_str (tmp, tag_str);
 		tag_type = GUINT32_FROM_BE (tmp);
@@ -2476,13 +2490,18 @@ cd_icc_get_created (CdIcc *icc)
 
 	created_tm.tm_isdst = -1;
 
-	/* convert to UNIX time */
-	created_t = mktime (&created_tm);
+	/* convert to UNIX time: the ICC header stores the creation time in
+	 * UTC, so use timegm() rather than mktime() (which would interpret
+	 * the fields as local time).  This also avoids a glib GDateTime bug
+	 * on OHOS where g_date_time_new_from_unix_local() does not apply the
+	 * system timezone offset (no /etc/localtime), which made the upstream
+	 * /colord/icc creation-time assertion fail. */
+	created_t = timegm (&created_tm);
 	if (created_t == (time_t) -1)
 		return NULL;
 
-	/* instantiate object */
-	return g_date_time_new_from_unix_local (created_t);
+	/* instantiate object in UTC */
+	return g_date_time_new_from_unix_utc (created_t);
 }
 
