diff --git a/lib/colord/cd-test-shared.c b/lib/colord/cd-test-shared.c
index 1706b0a..ae1af42 100644
--- a/lib/colord/cd-test-shared.c
+++ b/lib/colord/cd-test-shared.c
@@ -63,6 +63,16 @@ cd_test_get_filename (const gchar *filename)
 	return NULL;
 }
 
+
+gchar *
+cd_test_get_tmp_filename (const gchar *filename)
+{
+	/* The OHOS /tmp filesystem is read-only, so use the platform temp
+	 * dir (g_get_tmp_dir() honours the TMPDIR environment variable,
+	 * which the build sets to a writable directory). */
+	return g_build_filename (g_get_tmp_dir (), filename, NULL);
+}
+
 static GMainLoop *_test_loop = NULL;
 static guint _test_loop_timeout_id = 0;
 
@@ -102,17 +112,23 @@ gboolean
 cd_test_compare_lines (const gchar *txt1, const gchar *txt2, GError **error)
 {
 	g_autofree gchar *output = NULL;
+	g_autofree gchar *tmpa = NULL;
+	g_autofree gchar *tmpb = NULL;
+	g_autofree gchar *cmd = NULL;
 
 	/* exactly the same */
 	if (g_strcmp0 (txt1, txt2) == 0)
 		return TRUE;
 
 	/* save temp files and diff them */
-	if (!g_file_set_contents ("/tmp/a", txt1, -1, error))
+	tmpa = g_build_filename (g_get_tmp_dir (), "cd-test-a", NULL);
+	tmpb = g_build_filename (g_get_tmp_dir (), "cd-test-b", NULL);
+	if (!g_file_set_contents (tmpa, txt1, -1, error))
 		return FALSE;
-	if (!g_file_set_contents ("/tmp/b", txt2, -1, error))
+	if (!g_file_set_contents (tmpb, txt2, -1, error))
 		return FALSE;
-	if (!g_spawn_command_line_sync ("diff -urNp /tmp/b /tmp/a",
+	cmd = g_strdup_printf ("diff -urNp %s %s", tmpb, tmpa);
+	if (!g_spawn_command_line_sync (cmd,
 					&output, NULL, NULL, error))
 		return FALSE;
 
