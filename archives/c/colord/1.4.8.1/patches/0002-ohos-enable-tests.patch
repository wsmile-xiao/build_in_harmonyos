diff --git a/lib/colord/meson.build b/lib/colord/meson.build
index 318412f..f471daa 100644
--- a/lib/colord/meson.build
+++ b/lib/colord/meson.build
@@ -85,7 +85,14 @@ if libudev.found()
 endif
 
 mapfile = 'colord.map'
-vflag = '-Wl,--version-script,@0@/@1@'.format(meson.current_source_dir(), mapfile)
+# 1.4.8.1: the upstream colord.map (`local: *`) hides the statically linked
+# glib2 symbols, so colord-test-private pulls its OWN glib2 copy -> a second
+# pointer-encoded GType registry -> SIGSEGV whenever the test binary directly
+# g_object_unref()s a colord object (e.g. /colord/edid). Use a custom map that
+# keeps glib (g_*) and colord (cd_*) global so the test resolves glib through
+# libcolordprivate.so (single registry), and only localizes the zlib symbols
+# so the non-PIC static libz.a links into the .so.
+vflag = '-Wl,--version-script,@0@/@1@'.format(meson.current_source_dir(), 'colord-ohos.map')
 colordprivate = shared_library(
   'colordprivate',
   sources : shared_src,
@@ -282,5 +285,7 @@ if get_option('tests')
     install : get_option('installed_tests'),
     install_dir : join_paths(libexecdir, 'installed-tests', 'colord'),
   )
-  test('colord-test-daemon', e, env : testdatadir)
+  if get_option('daemon')
+    test('colord-test-daemon', e, env : testdatadir)
+  endif
 endif
