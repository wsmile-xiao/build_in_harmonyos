 /*
  * '_cupsThreadCancel()' - Cancel (kill) a thread.
  */
 
 void
 _cupsThreadCancel(_cups_thread_t thread)/* I - Thread ID */
 {
+#ifdef __OHOS__
+  // pthread_cancel is not available on musl/OHOS; detach instead
+  pthread_detach(thread);
+#else
   pthread_cancel(thread);
+#endif /* __OHOS__ */
 }
 
 
