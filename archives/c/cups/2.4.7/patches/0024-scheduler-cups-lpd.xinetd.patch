diff -ruN a/scheduler/cups-lpd.xinetd b/scheduler/cups-lpd.xinetd
--- a/scheduler/cups-lpd.xinetd
+++ b/scheduler/cups-lpd.xinetd
@@ -0,0 +1,12 @@
+service printer
+{
+	disable = yes
+	socket_type = stream
+	protocol = tcp
+	wait = no
+	user = nobody
+	group = nobody
+	passenv =
+	server = /storage/Users/currentUser/usr/local/lib/cups/daemon/cups-lpd
+	server_args = -o document-format=application/octet-stream
+}
