diff -ruN a/scheduler/cups.service b/scheduler/cups.service
--- a/scheduler/cups.service
+++ b/scheduler/cups.service
@@ -0,0 +1,15 @@
+[Unit]
+Description=CUPS Scheduler
+Documentation=man:cupsd(8)
+After=network.target nss-user-lookup.target nslcd.service
+Requires=cups.socket
+
+[Service]
+ExecStart=/storage/Users/currentUser/usr/local/sbin/cupsd -l
+Type=notify
+Restart=on-failure
+
+
+[Install]
+Also=cups.socket cups.path
+WantedBy=printer.target multi-user.target
