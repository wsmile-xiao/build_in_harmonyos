diff -ruN a/Makedefs b/Makedefs
--- a/Makedefs
+++ b/Makedefs
@@ -0,0 +1,275 @@
+#
+# Common makefile definitions for CUPS.
+#
+# Copyright © 2021 by OpenPrinting.
+# Copyright © 2007-2019 by Apple Inc.
+# Copyright © 1997-2007 by Easy Software Products, all rights reserved.
+#
+# Licensed under Apache License v2.0.  See the file "LICENSE" for more
+# information.
+#
+
+#
+# CUPS version...
+#
+
+CUPS_VERSION    =       2.4.7
+
+
+#
+# Programs...
+#
+
+AR		=	/data/service/hnp/bin/ar
+AWK		=	gawk
+CC		=	 /data/storage/el2/base/cache/cc-wrapper.sh
+CHMOD		=	/usr/bin/chmod
+CXX		=	 clang++
+DSO		=	$(CC)
+DSOXX		=	$(CXX)
+GZIPPROG	=	/usr/bin/gzip
+INSTALL		=	b/install-sh
+LD		=	/storage/Users/currentUser/usr/local/bin/ld
+LD_CC		=	$(CC)
+LD_CXX		=	$(CXX)
+LIBTOOL		=	
+LN		=	/usr/bin/ln -sf
+MKDIR           =       /storage/Users/currentUser/usr/local/bin/mkdir -p
+MV		=	/usr/bin/mv -f
+RANLIB		=	llvm-ranlib
+RM		=	/usr/bin/rm -f
+RMDIR		=	/storage/Users/currentUser/usr/local/bin/rmdir
+SED		=	/usr/bin/sed
+SHELL		=	/bin/sh
+
+#
+# Installation programs...
+#
+
+INSTALL_BIN	=	 $(INSTALL) -c -m 755
+INSTALL_COMPDATA =	$(INSTALL) -c -m 444 -z
+INSTALL_CONFIG	=	$(INSTALL) -c -m 640
+INSTALL_DATA	=	$(INSTALL) -c -m 444
+INSTALL_DIR	=	$(INSTALL) -d
+INSTALL_LIB	=	 $(INSTALL) -c -m 755
+INSTALL_MAN	=	$(INSTALL) -c -m 444
+INSTALL_SCRIPT	=	$(INSTALL) -c -m 755
+
+#
+# Default user, group, and system groups for the scheduler...
+#
+
+CUPS_USER	=	nobody
+CUPS_GROUP	=	nobody
+CUPS_SYSTEM_GROUPS =	system root
+CUPS_PRIMARY_SYSTEM_GROUP =	system
+
+#
+# Default permissions...
+#
+
+CUPS_CONFIG_FILE_PERM = 640
+CUPS_CUPSD_FILE_PERM = 700
+CUPS_LOG_FILE_PERM = 644
+
+#
+# Languages to install...
+#
+
+LANGUAGES	=	ca cs da de en es fr it ja pt_BR ru zh_CN 
+INSTALL_LANGUAGES =	install-languages
+UNINSTALL_LANGUAGES =	uninstall-languages
+
+#
+# Cross-compilation support: "local" target is used for any tools that are
+# built and run locally.
+#
+
+LOCALTARGET     =       local
+
+
+#
+# Libraries...
+#
+
+LIBCUPS		=	libcups.so.2
+LIBCUPSIMAGE	=	libcupsimage.so.2
+LIBCUPSOBJS	=	$(COREOBJS) $(DRIVEROBJS)
+LIBCUPSSTATIC	=	libcups.a
+LIBGSSAPI	=	
+LIBHEADERS	=	$(COREHEADERS) $(DRIVERHEADERS)
+LIBHEADERSPRIV	=	$(COREHEADERSPRIV) $(DRIVERHEADERSPRIV)
+LIBMALLOC	=	
+LIBPAPER	=	
+LIBUSB		=	-L/storage/Users/currentUser/usr/local/lib -lusb-1.0
+LIBWRAP		=	
+LIBZ		=	-lz
+
+#
+# Install static libraries?
+#
+
+INSTALLSTATIC	=	
+
+#
+# IPP backend aliases...
+#
+
+IPPALIASES	=	http https ipps
+
+
+#
+# ippeveprinter commands...
+#
+
+IPPEVECOMMANDS	=	ippevepcl ippeveps
+
+
+#
+# Install XPC backends?
+#
+
+INSTALLXPC	=	
+
+#
+# Code signing...
+#
+
+CODE_SIGN	=	/storage/Users/currentUser/usr/local/bin/true
+CODE_SIGN_IDENTITY = -
+
+#
+# Program options...
+#
+# ARCHFLAGS     Defines the default architecture build options.
+# OPTIM         Defines the common compiler optimization/debugging options
+#               for all architectures.
+# OPTIONS       Defines other compile-time options (currently only -DDEBUG
+#               for extra debug info)
+#
+
+ALL_CFLAGS	=	-I.. -D_CUPS_SOURCE $(CFLAGS) \
+			$(TLSFLAGS) -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_THREAD_SAFE -D_REENTRANT \
+			$(ONDEMANDFLAGS) $(OPTIONS)
+ALL_CXXFLAGS	=	-I.. -D_CUPS_SOURCE $(CXXFLAGS) \
+			$(TLSFLAGS) -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_THREAD_SAFE -D_REENTRANT \
+			$(ONDEMANDFLAGS) $(OPTIONS)
+ALL_DSOFLAGS	=	-L../cups   $(DSOFLAGS) $(OPTIM)
+ALL_LDFLAGS	=	-L../cups   $(LDFLAGS)  \
+			-fPIE -pie $(OPTIM)
+ARCHFLAGS	=	
+ARFLAGS		=	crvs
+BACKLIBS	=	
+BUILDDIRS	=	tools filter backend berkeley cgi-bin monitor notifier ppdc scheduler systemv conf data desktop locale man doc examples templates
+CFLAGS		=	-I/storage/Users/currentUser/usr/local/include -fPIC -O2 -I/storage/Users/currentUser/usr/local/include/libusb-1.0 -I/storage/Users/currentUser/usr/local/lib/pkgconfig/../../include/dbus-1.0 -I/storage/Users/currentUser/usr/local/lib/pkgconfig/../../lib/dbus-1.0/include -DDBUS_API_SUBJECT_TO_CHANGE -D_FORTIFY_SOURCE=3
+COMMONLIBS	=	-lpthread   -liconv  -lz
+CXXFLAGS	=	-I/storage/Users/currentUser/usr/local/include -fPIC -O2 -D_FORTIFY_SOURCE=3
+CXXLIBS		=	
+DBUS_NOTIFIER	=	dbus
+DBUS_NOTIFIERLIBS =	-L/storage/Users/currentUser/usr/local/lib/pkgconfig/../../lib -ldbus-1
+DNSSD_BACKEND	=	
+DSOFLAGS	=	-Wl,-rpath,/storage/Users/currentUser/usr/local/lib  -Wl,-soname,`basename $@` -shared
+DNSSDLIBS	=	
+IPPFIND_BIN	=	
+IPPFIND_MAN	=	
+LDFLAGS		=	-L/storage/Users/currentUser/usr/local/lib -Wl,-rpath,/storage/Users/currentUser/usr/local/lib
+LINKCUPS	=	-L../cups -lcups
+LINKCUPSSTATIC	=	../cups/$(LIBCUPSSTATIC) $(LIBS)
+LIBS		=	$(LIBGSSAPI) $(DNSSDLIBS) $(TLSLIBS) $(LIBZ) $(COMMONLIBS)
+ONDEMANDFLAGS	=	
+ONDEMANDLIBS	=	
+OPTIM		=	-fPIC -Os -g -fstack-protector-strong -D_GNU_SOURCE
+OPTIONS		=	-Wall -Wunused -Wno-char-subscripts -Wno-deprecated-declarations -Wno-format-y2k -Wno-switch -Wno-unused-result
+PAMLIBS		=	
+SERVERLIBS	=	  -L/storage/Users/currentUser/usr/local/lib/pkgconfig/../../lib -ldbus-1  
+TLSFLAGS	=	
+TLSLIBS		=	-L/storage/Users/currentUser/usr/local/lib -lssl -lcrypto
+UNITTESTS	=	
+
+
+#
+# Directories...
+#
+# The first section uses the GNU names (which are *extremely*
+# difficult to find in a makefile because they are lowercase...)
+# We have to define these first because autoconf uses ${prefix}
+# and ${exec_prefix} for most of the other directories...
+#
+# The "datarootdir" variable may not get defined if you are using
+# a version of autoconf prior to 2.60.
+#
+# This is immediately followed by definition in ALL CAPS for the
+# needed directories...
+#
+
+bindir		=	/storage/Users/currentUser/usr/local/bin
+datadir		=	/storage/Users/currentUser/usr/local/share
+datarootdir	=	/storage/Users/currentUser/usr/local/share
+exec_prefix	=	/storage/Users/currentUser/usr/local
+includedir	=	${prefix}/include
+infodir		=	${datarootdir}/info
+libdir		=	/storage/Users/currentUser/usr/local/lib
+libexecdir	=	${exec_prefix}/libexec
+localstatedir	=	/storage/Users/currentUser/usr/local/var
+mandir		=	${datarootdir}/man
+oldincludedir	=	/usr/include
+prefix		=	/storage/Users/currentUser/usr/local
+sbindir		=	/storage/Users/currentUser/usr/local/sbin
+sharedstatedir	=	${prefix}/com
+srcdir		=	.
+sysconfdir	=	/storage/Users/currentUser/usr/local/etc
+top_srcdir	=	.
+
+BUILDROOT	=	$(DSTROOT)$(DESTDIR)
+
+BINDIR		=	$(BUILDROOT)/storage/Users/currentUser/usr/local/bin
+BUNDLEDIR	=	
+CACHEDIR	=	$(BUILDROOT)/storage/Users/currentUser/usr/local/var/cache/cups
+DATADIR		=	$(BUILDROOT)/storage/Users/currentUser/usr/local/share/cups
+DOCDIR		=	$(BUILDROOT)/storage/Users/currentUser/usr/local/share/doc/cups
+CUPS_PKGCONFPATH =	$(BUILDROOT)/storage/Users/currentUser/usr/local/lib/pkgconfig
+ICONDIR		=	/usr/share/icons
+INCLUDEDIR	=	$(BUILDROOT)$(includedir)
+LIBDIR		=	$(BUILDROOT)$(libdir)
+LOCALEDIR	= 	$(BUILDROOT)/storage/Users/currentUser/usr/local/share/locale
+LOGDIR		= 	$(BUILDROOT)/storage/Users/currentUser/usr/local/var/log/cups
+MANDIR		=	$(BUILDROOT)${datarootdir}/man
+MENUDIR		=	/usr/share/applications
+RCLEVELS	=	2 3 5
+RCSTART		=	81
+RCSTOP		=	36
+REQUESTS	= 	$(BUILDROOT)/storage/Users/currentUser/usr/local/var/spool/cups
+RESOURCEDIR	=	
+SBINDIR		=	$(BUILDROOT)/storage/Users/currentUser/usr/local/sbin
+SERVERBIN	= 	$(BUILDROOT)/storage/Users/currentUser/usr/local/lib/cups
+SERVERROOT	= 	$(BUILDROOT)/storage/Users/currentUser/usr/local/etc/cups
+STATEDIR	=	$(BUILDROOT)/storage/Users/currentUser/usr/local/var/run/cups
+
+PAMDIR		=	
+PAMFILE		=	pam.std
+
+DBUSDIR		=	
+INITDIR		=	/etc/rc.d
+INITDDIR	=	
+LAUNCHD_DIR	=	
+SMFMANIFESTDIR	= 	
+SYSTEMD_DIR	=	
+XINETD		=	
+
+USBQUIRKS	=	$(DATADIR)/usb
+
+
+#
+# Rules...
+#
+
+.SILENT:
+.SUFFIXES:	.a .c .cxx .h .o
+
+.c.o:
+	echo Compiling $<...
+	$(CC) $(ARCHFLAGS) $(OPTIM) $(ALL_CFLAGS) -c -o $@ $<
+
+.cxx.o:
+	echo Compiling $<...
+	$(CXX) $(ARCHFLAGS) $(OPTIM) $(ALL_CXXFLAGS) -c -o $@ $<
