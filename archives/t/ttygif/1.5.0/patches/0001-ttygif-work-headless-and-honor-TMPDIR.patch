+    /* Upstream hardcoded "/tmp/ttygif.XXXXXX".  On HarmonyOS PC /tmp lives
+     * on a read-only mount, so mkdtemp() always failed here and ttygif
+     * aborted before it looked at anything else -- even `ttygif --version`
+     * returned non-zero.  Take the scratch root from TMPDIR (the POSIX
+     * override, and the remedy recorded as knowledge entry E002) and keep
+     * /tmp as the fallback when TMPDIR is unset or empty, which leaves the
+     * previous behaviour on Linux and macOS untouched.  A trailing slash in
+     * TMPDIR is harmless: POSIX collapses repeated separators inside a path. */
+    char dir_template[PATH_MAX];
+    const char *scratch_root = getenv("TMPDIR");
+
+    if (scratch_root == NULL || scratch_root[0] == '\0') {
+        scratch_root = "/tmp";
+    }
+    if (snprintf(dir_template, sizeof(dir_template), "%s/ttygif.XXXXXX",
+                 scratch_root) >= (int)sizeof(dir_template)) {
+        fatalf("Error: TMPDIR value is too long to build a template.");
+    }
     options.img_dir = mkdtemp(dir_template);
