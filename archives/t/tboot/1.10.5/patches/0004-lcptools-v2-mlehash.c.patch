 /*
+ * open_scratch_stream
+ *
+ * Open an unnamed scratch stream for the decompression buffer.  tmpfile()
+ * always creates its file under /tmp, which is a read-only mount on OHOS and
+ * other immutable-root systems, so the TMPDIR directory is honoured when it
+ * is set.
+ */
+static FILE *open_scratch_stream(void)
+{
+    const char *tmpdir = getenv("TMPDIR");
+    char path[1024];
+    int fd;
+
+    if ( tmpdir == NULL || *tmpdir == '\0' )
+        tmpdir = "/tmp";
+    if ( snprintf(path, sizeof(path), "%s/tboot-mlehash-XXXXXX", tmpdir)
+                                                            >= (int)sizeof(path) )
+        return NULL;
+    fd = mkstemp(path);
+    if ( fd == -1 )
+        return NULL;
+    if ( unlink(path) != 0 ) {
+        close(fd);
+        return NULL;
+    }
+    return fdopen(fd, "w+b");
+}
