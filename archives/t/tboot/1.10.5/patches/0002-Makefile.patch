--- a/Makefile
+++ b/Makefile
@@ -7,21 +7,29 @@
 # Grand Unified Makefile for tboot
 #
 
 # define ROOTDIR
 export ROOTDIR=$(CURDIR)
 
 # import global build config
 include Config.mk
 
 # (txt-test is not included because it requires pathing to Linux src)
+# The 'tboot' sub-project is the measured-launch boot module: freestanding
+# x86-32 firmware (tboot/Config.mk, -melf_i386, -m32).  It cannot be produced
+# for other targets, where only the portable host-side tools (lcptools-v2,
+# tb_polgen, utils) and their helpers are built.
+ifneq (,$(filter $(TARGET_ARCH),x86_32 x86_64))
 SUBDIRS := tboot safestringlib lcptools-v2 tb_polgen utils docs
+else
+SUBDIRS := safestringlib lcptools-v2 tb_polgen utils docs
+endif
 
 #
 # build rules
 #
 
 #
 #    manifest
 #
 .PHONY: manifest
 manifest : build
