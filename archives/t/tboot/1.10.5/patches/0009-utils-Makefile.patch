--- a/utils/Makefile
+++ b/utils/Makefile
@@ -4,21 +4,28 @@
 # -*- mode: Makefile; -*-
 
 #
 # utils makefile
 #
 
 ROOTDIR ?= $(CURDIR)/..
 
 include $(ROOTDIR)/Config.mk
 
+# txt-acminfo reads the Intel TXT ACM information out of x86 MSRs and IO
+# ports (../tboot/include/processor.h, ../tboot/include/io.h), so it can only
+# be built on x86 targets.
+ifneq (,$(filter $(TARGET_ARCH),x86_32 x86_64))
 TARGETS := txt-stat txt-parse_err txt-acminfo
+else
+TARGETS := txt-stat txt-parse_err
+endif
 
 CFLAGS += -D_LARGEFILE64_SOURCE
 LIBS += $(ROOTDIR)/safestringlib/libsafestring.a
 
 #
 # universal targets
 #
 build : $(TARGETS)
 
 
