--- a/src/FindIconv.cmake
+++ b/src/FindIconv.cmake
@@ -23,7 +23,29 @@ FIND_LIBRARY(ICONV_LIBRARIES NAMES iconv libiconv libiconv-2 c)
 IF(ICONV_INCLUDE_DIR AND ICONV_LIBRARIES) 
    SET(ICONV_FOUND TRUE) 
 ENDIF(ICONV_INCLUDE_DIR AND ICONV_LIBRARIES) 
 
+# OpenHarmony musl provides iconv inside libc. The compiler finds iconv.h
+# through its built-in sysroot, but find_path/find_library do not search
+# that sysroot when the toolchain leaves CMAKE_SYSROOT unset.
+IF(NOT ICONV_FOUND)
+  set(CMAKE_REQUIRED_INCLUDES)
+  set(CMAKE_REQUIRED_LIBRARIES)
+  check_c_source_compiles("
+    #include <iconv.h>
+    int main(void) {
+      iconv_t conv = iconv_open(\"UTF-8\", \"UTF-8\");
+      return conv == (iconv_t)-1;
+    }
+  " ICONV_IN_LIBC)
+  if(ICONV_IN_LIBC)
+    set(ICONV_FOUND TRUE)
+    set(ICONV_INCLUDE_DIR "")
+    set(ICONV_LIBRARIES "")
+    set(ICONV_INCLUDE_DIR "" CACHE PATH "iconv.h comes from the compiler sysroot" FORCE)
+    set(ICONV_LIBRARIES "" CACHE STRING "iconv is provided by libc" FORCE)
+  endif()
+ENDIF(NOT ICONV_FOUND)
+
 set(CMAKE_REQUIRED_INCLUDES ${ICONV_INCLUDE_DIR})
 set(CMAKE_REQUIRED_LIBRARIES ${ICONV_LIBRARIES})
 IF(ICONV_FOUND)
