   @tmpdir     = nil # temporary test directory
   @blankfiles = Dir[File.join(ProjectRoot, 'test', 'files', '*')]
 
+  class ShellStatus
+    def initialize(code)
+      @code = code
+    end
+
+    def exitstatus
+      @code
+    end
+
+    def success?
+      @code == 0
+    end
+  end
+
+  # Ruby 3.4.5 on the CI worker aborts inside Open3/Process.spawn
+  # (posix_spawn file actions) with "ILL received in SEGV handler".
+  # libc system() still runs the same shell command and returns its status.
+  def self.libc_system(command)
+    @libc_system ||= Fiddle::Function.new(
+      Fiddle.dlopen(nil)['system'],
+      [Fiddle::TYPE_VOIDP],
+      Fiddle::TYPE_INT)
+    @libc_system.call(command)
+  end
+
+  def self.shell_capture(env, cmd, stdin: nil)
+    stamp = "#{Process.pid}-#{rand(1 << 20)}"
+    base = @tmpdir || Dir.tmpdir
+    outfile = File.join(base, "tagutil-out-#{stamp}")
+    infile = nil
+    if stdin
+      infile = File.join(base, "tagutil-in-#{stamp}")
+      File.write(infile, stdin)
+    end
+    prefix = env.map { |key, value|
+      "#{key}=#{Shellwords.escape(value.to_s)} "
+    }.join
+    redirect_in = infile ? " <#{Shellwords.escape(infile)}" : ""
+    script = "#{prefix}#{cmd}#{redirect_in} >#{Shellwords.escape(outfile)} 2>&1"
+    raw = libc_system(script)
+    output = File.file?(outfile) ? File.read(outfile) : ""
+    FileUtils.rm_f(outfile)
+    FileUtils.rm_f(infile) if infile
+    if raw < 0
+      code = 127
+    elsif (raw & 0xff) != 0
+      code = 128 + (raw & 0x7f)
+    else
+      code = (raw >> 8) & 0xff
+    end
+    [output, ShellStatus.new(code)]
+  end
+
