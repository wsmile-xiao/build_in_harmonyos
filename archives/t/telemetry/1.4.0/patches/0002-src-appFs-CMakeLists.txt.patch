--- a/src/appFs/CMakeLists.txt
+++ b/src/appFs/CMakeLists.txt
@@ -1,20 +1,38 @@
 list(APPEND APPFS_SOURCE_FILES
 	appFs.cpp
 )
 
 if (TELEMETRY_BUILD_SHARED)
 	add_library(appFs SHARED ${APPFS_SOURCE_FILES})
+	set_target_properties(appFs PROPERTIES
+		VERSION ${PROJECT_VERSION}
+		SOVERSION ${VERSION_MAJOR})
 else()
 	add_library(appFs STATIC ${APPFS_SOURCE_FILES})
 endif()
 
 add_library(telemetry::appFs ALIAS appFs)
 
 target_compile_definitions(appFs PUBLIC FUSE_USE_VERSION=30 _FILE_OFFSET_BITS=64)
-target_link_libraries(appFs PUBLIC telemetry PkgConfig::fuse stdc++fs)
+# stdc++fs is the GCC runtime library for std::filesystem (< 9); other standard
+# libraries (e.g. libc++) implement it in the main C++ runtime.
+if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+	target_link_libraries(appFs PUBLIC telemetry PkgConfig::fuse stdc++fs)
+else()
+	target_link_libraries(appFs PUBLIC telemetry PkgConfig::fuse)
+endif()
 target_include_directories(appFs PUBLIC ${CMAKE_SOURCE_DIR}/include)
+
+# A static libfuse3.a is built with a symbol version script (FUSE_3.x version
+# nodes). Those nodes are only emitted when linking libfuse itself, so hide the
+# archived symbols from the dynamic symbol table of this shared library;
+# otherwise the linker reports the FUSE_3.x versions as undefined.
+get_target_property(_appFs_fuse_libraries PkgConfig::fuse INTERFACE_LINK_LIBRARIES)
+if (_appFs_fuse_libraries MATCHES "\\.a($|;)")
+	target_link_options(appFs PRIVATE "-Wl,--exclude-libs,libfuse3.a")
+endif()
 
 if (TELEMETRY_INSTALL_TARGETS)
 	install(TARGETS appFs LIBRARY DESTINATION ${INSTALL_DIR_LIB})
 	install(DIRECTORY ${CMAKE_SOURCE_DIR}/include/ DESTINATION ${INSTALL_DIR_INCLUDE})
 endif()
