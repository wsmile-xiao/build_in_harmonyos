--- /dev/null
+++ b/GNUmakefile
@@ -0,0 +1,38 @@
+# GNU make build for tradcpp.
+#
+# The upstream Makefile is a NetBSD makefile (it ends with
+# ".include <bsd.prog.mk>") and needs bmake; GNU make cannot read it at all.
+# GNU make prefers GNUmakefile over Makefile, so this file is picked up
+# automatically and the upstream Makefile is left untouched for NetBSD users.
+#
+# CC/CPPFLAGS/CFLAGS/LDFLAGS come from the Conan toolchain environment;
+# the defaults below only apply when building by hand.
+
+CC ?= cc
+CFLAGS ?= -O2
+
+# bool.h does "typedef int bool;" (traditional pre-C99 style).  C23 made bool
+# a keyword, so that typedef is a hard error from -std=c23 onwards -- GCC 15
+# defaults to gnu23 and rejects the build outright:
+#   bool.h:36:13: error: 'bool' cannot be defined via 'typedef'
+# Pin the dialect.  clang 15 (the OHOS worker) defaults to gnu17 and is fine
+# either way; this only stops the build from breaking on a newer default.
+CSTD ?= -std=gnu17
+
+PROG = tradcpp
+SRCS = main.c files.c directive.c eval.c macro.c output.c place.c array.c utils.c
+OBJS = $(SRCS:.c=.o)
+
+all: $(PROG)
+
+$(PROG): $(OBJS)
+	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)
+
+.SUFFIXES: .c .o
+.c.o:
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(CSTD) -c -o $@ $<
+
+clean:
+	rm -f $(PROG) $(OBJS)
+
+.PHONY: all clean
