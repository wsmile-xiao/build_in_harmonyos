diff -ruN a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -1,18 +1,19 @@
 dnl Process this file with autoconf to produce a configure script.
 AC_INIT([TRE], [0.9.0])
 AC_CONFIG_SRCDIR([lib/regcomp.c])
 AC_CONFIG_AUX_DIR([utils])
 AC_CANONICAL_TARGET
 AM_INIT_AUTOMAKE([foreign])
 AC_PREREQ([2.63])
-AM_GNU_GETTEXT_VERSION(0.17)
+dnl AM_GNU_GETTEXT_VERSION(0.17) -- disabled for OHOS (no libintl)
+dnl We use --disable-nls instead
 
 dnl Checks for programs.
 AC_PROG_CC
 AC_PROG_CPP
 AC_PROG_INSTALL
 
 dnl Checks for compiler characteristics.
 AC_USE_SYSTEM_EXTENSIONS
 AC_C_CONST
 AC_C_INLINE
@@ -508,33 +509,51 @@
 if test "$tre_multibyte" = "yes"; then
   AM_CONDITIONAL(TRE_MULTIBYTE, true)
   AC_DEFINE(TRE_MULTIBYTE, 1,
     [ Define to enable multibyte character set support. ])
 else
   AM_CONDITIONAL(TRE_MULTIBYTE, false)
 fi
 
 AC_SYS_LARGEFILE
 
-AM_GNU_GETTEXT([external])
+dnl AM_GNU_GETTEXT([external]) -- disabled for OHOS (no libintl)
+dnl Provide stubs for NLS variables used in tre.pc.in and Makefiles
+AC_SUBST([LIBINTL], [""])
+AC_SUBST([LTLIBINTL], [""])
+AC_SUBST([POSUB], [""])
+dnl AC_DEFINE([ENABLE_NLS], [0], [NLS disabled on OHOS]) -- skipped to avoid #ifdef triggering
+LIBINTL=""
+LTLIBINTL=""
+LIBINTL0=""
+LTLIBINTL0=""
+USE_INCLUDED_LIBINTL=no
+BUILD_INCLUDED_LIBINTL=no
+AC_SUBST([LIBINTL])
+AC_SUBST([LTLIBINTL])
+AC_SUBST([LIBINTL0])
+AC_SUBST([LTLIBINTL0])
+AC_SUBST([USE_INCLUDED_LIBINTL])
+AC_SUBST([BUILD_INCLUDED_LIBINTL])
+AM_CONDITIONAL([USE_INCLUDED_LIBINTL], [false])
+AM_CONDITIONAL([BUILD_INCLUDED_LIBINTL], [false])
 LT_INIT([win32-dll, disable-static])
 
 dnl Output files
 AC_CONFIG_HEADERS([config.h local_includes/tre-config.h])
 AC_CONFIG_FILES([
 Makefile
 doc/Makefile
 doc/agrep.1
 local_includes/Makefile
 lib/Makefile
 m4/Makefile
-po/Makefile.in
 python/setup.py
 src/Makefile
 tests/Makefile
 tests/agrep/Makefile
 tre.pc
 tre.spec
 utils/Makefile
 win32/config.h
 win32/tre-config.h
 ])
