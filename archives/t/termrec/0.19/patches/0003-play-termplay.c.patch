--- a/play/termplay.c
+++ b/play/termplay.c
@@ -121,8 +121,20 @@
     tadd(lt, *delay);
 }
 
+#ifndef HAVE_PTHREAD_CANCEL
+/* Without POSIX thread cancellation (musl-derived libcs, eg. OpenHarmony)
+   the loader is stopped cooperatively: the main thread raises loader_stop
+   and exits immediately, so the loader must not touch the timeline once
+   the flag is up. See notes.md. */
+static volatile int loader_stop;
+#endif
+
 static void loader_print(const char *data, int len, void *arg)
 {
+#ifndef HAVE_PTHREAD_CANCEL
+    if (loader_stop)
+        return;
+#endif
     ttyrec_add_frame(tr, &lt, data, len);
     lt.tv_sec=lt.tv_usec=0;
     mutex_lock(waitm);
@@ -200,9 +212,17 @@
     if (thread_create_joinable(&loadth, loader, (intptr_t)fd))
         die("Cannot create thread");
     replay();
+#ifdef HAVE_PTHREAD_CANCEL
     pthread_cancel(loadth);
     thread_join(loadth);
     ttyrec_free(tr);
+#else
+    /* Cooperative stop: the loader can be blocked in a read (follow mode,
+       pipes, network streams), so joining it could hang forever. Raise the
+       flag and fall through to _exit(0), which tears every thread down. The
+       timeline is intentionally not freed: the loader may still be running. */
+    loader_stop=1;
+#endif
     kbd_restore();
 
     // Need to kill termcast/etc threads.
