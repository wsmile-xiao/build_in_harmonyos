OHOS/HMDFS: do not create the config.status scratch directory with umask 077.
HMDFS forces the setgid bit on new directories, so "umask 077 && mktemp -d" yields a
drwx--S--- directory that even its owner cannot write into; config.status then dies
with "./confXXXXXX/subs1.awk: Permission denied". Building the scratch directory with
the default umask keeps it writable on OHOS while staying correct on regular filesystems.
Apply the same change to the fallback mkdir path for the same reason.

--- a/configure
+++ b/configure
@@ -6083,12 +6083,12 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`mktemp -d "./confXXXXXX" 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  mkdir "$tmp" 2>/dev/null
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
