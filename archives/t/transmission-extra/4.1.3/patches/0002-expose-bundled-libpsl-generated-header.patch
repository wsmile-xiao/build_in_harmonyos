From b73362ca4247f73ca3f1387531ac57b222544795 Mon Sep 17 00:00:00 2001
From: wingsluo <noreply@atomgit.com>
Date: Tue, 18 Aug 2026 20:55:00 +0800
Subject: [PATCH] cmake: expose bundled libpsl generated header

The bundled libpsl ExternalProject generates libpsl.h in its build tree,
but its imported interface target only advertises the later install
prefix. Export the known build-tree location so libtransmission can use
the header after the recipe builds the psl target.
---
 CMakeLists.txt | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -551,6 +551,10 @@ tr_add_external_auto_library(DHT dht dht
 
 tr_add_external_auto_library(PSL libpsl psl
     TARGET psl::psl)
+if(NOT USE_SYSTEM_PSL)
+    target_include_directories(psl::psl INTERFACE
+        "${PROJECT_BINARY_DIR}/third-party/libpsl.bld/src/psl-build")
+endif()
 
 if(ENABLE_UTP)
     tr_add_external_auto_library(UTP libutp utp
-- 
