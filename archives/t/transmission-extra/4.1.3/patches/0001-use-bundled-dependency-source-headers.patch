From 54cf79128460793f76b5aa01df8617f69dbaf886 Mon Sep 17 00:00:00 2001
From: wingsluo <noreply@atomgit.com>
Date: Tue, 18 Aug 2026 20:20:00 +0800
Subject: [PATCH] cmake: use bundled dependency source headers

Bundled DHT and NAT-PMP are ExternalProjects whose install include
prefixes are unavailable while libtransmission compiles in parallel.
Use paths relative to Transmission's existing project-root include path.
This also avoids adding libnatpmp's source directory globally, where its
unqualified `version` file would shadow the C++ standard <version> header.
---
 libtransmission/port-forwarding-natpmp.cc | 2 +-
 libtransmission/port-forwarding-natpmp.h  | 2 +-
 libtransmission/port-forwarding-upnp.cc   | 4 ++--
 libtransmission/tr-dht.h                  | 2 +-
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/libtransmission/port-forwarding-natpmp.cc b/libtransmission/port-forwarding-natpmp.cc
--- a/libtransmission/port-forwarding-natpmp.cc
+++ b/libtransmission/port-forwarding-natpmp.cc
@@ -17,7 +17,7 @@
 #include <fmt/format.h>
 
 #define ENABLE_STRNATPMPERR
-#include "natpmp.h"
+#include "third-party/libnatpmp/natpmp.h"
 
 #define LIBTRANSMISSION_PORT_FORWARDING_MODULE
 
diff --git a/libtransmission/port-forwarding-natpmp.h b/libtransmission/port-forwarding-natpmp.h
--- a/libtransmission/port-forwarding-natpmp.h
+++ b/libtransmission/port-forwarding-natpmp.h
@@ -12,7 +12,7 @@
 #include <ctime> // time_t
 #include <cstdint>
 
-#include "natpmp.h"
+#include "third-party/libnatpmp/natpmp.h"
 
 #include "libtransmission/transmission.h" // tr_port_forwarding_state
 
diff --git a/libtransmission/port-forwarding-upnp.cc b/libtransmission/port-forwarding-upnp.cc
--- a/libtransmission/port-forwarding-upnp.cc
+++ b/libtransmission/port-forwarding-upnp.cc
@@ -15,8 +15,8 @@
 
 #include <fmt/format.h>
 
-#include <miniupnpc/miniupnpc.h>
-#include <miniupnpc/upnpcommands.h>
+#include "third-party/miniupnp/miniupnpc/include/miniupnpc.h"
+#include "third-party/miniupnp/miniupnpc/include/upnpcommands.h"
 
 #define LIBTRANSMISSION_PORT_FORWARDING_MODULE
 
diff --git a/libtransmission/tr-dht.h b/libtransmission/tr-dht.h
--- a/libtransmission/tr-dht.h
+++ b/libtransmission/tr-dht.h
@@ -20,7 +20,7 @@
 #include <sys/socket.h>
 #endif
 
-#include <dht/dht.h>
+#include "third-party/dht/dht.h"
 
 #include "libtransmission/transmission.h"
 
-- 
2.43.0
