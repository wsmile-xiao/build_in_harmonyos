From c4aa69f3cce1515b5fbd35c80af76233cb393ffc Mon Sep 17 00:00:00 2001
From: wingsluo <noreply@atomgit.com>
Date: Tue, 18 Aug 2026 21:35:00 +0800
Subject: [PATCH] tests: use bundled dht source header

The bundled DHT ExternalProject installs its header after the main test
target begins compiling. Use the project-root-relative source header just
as libtransmission does during the same build.
---
 tests/libtransmission/dht-test.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/libtransmission/dht-test.cc b/tests/libtransmission/dht-test.cc
--- a/tests/libtransmission/dht-test.cc
+++ b/tests/libtransmission/dht-test.cc
@@ -26,7 +26,7 @@
 #include <sys/socket.h> // AF_INET, AF_INET6, AF_UN...
 #endif
 
-#include <dht/dht.h> // dht_callback_t
+#include "third-party/dht/dht.h" // dht_callback_t
 
 #include <event2/event.h>
 
