--- a/tests/c-tests/tdb_cons_setopt.c
+++ b/tests/c-tests/tdb_cons_setopt.c
@@ -29,15 +29,37 @@
     assert(tdb_cons_set_opt(c, TDB_OPT_CONS_OUTPUT_FORMAT, val) ==
            TDB_ERR_INVALID_OPTION_VALUE);

+    /* Portability (OHOS, no libarchive): PACKAGE output requires
+       HAVE_ARCHIVE_H. Without it tdb_cons_set_opt(PACKAGE) correctly
+       returns TDB_ERR_INVALID_OPTION_VALUE and the cons stays in
+       directory mode (tdb_cons_init falls back to directory mode).
+       Keep the explicit-PACKAGE assertion when libarchive is present,
+       otherwise verify the error and continue in directory mode so the
+       rest of the test (add/finalize/open/cursor) still exercises the
+       supported configuration. */
+#ifdef HAVE_ARCHIVE_H
     assert(tdb_cons_set_opt(c,
                             TDB_OPT_CONS_OUTPUT_FORMAT,
                             opt_val(TDB_OPT_CONS_OUTPUT_FORMAT_PACKAGE)) == 0);
+#else
+    assert(tdb_cons_set_opt(c,
+                            TDB_OPT_CONS_OUTPUT_FORMAT,
+                            opt_val(TDB_OPT_CONS_OUTPUT_FORMAT_PACKAGE)) ==
+           TDB_ERR_INVALID_OPTION_VALUE);
+    assert(tdb_cons_set_opt(c,
+                            TDB_OPT_CONS_OUTPUT_FORMAT,
+                            opt_val(TDB_OPT_CONS_OUTPUT_FORMAT_DIR)) == 0);
+#endif

     assert(tdb_cons_get_opt(c, TDB_OPT_ONLY_DIFF_ITEMS, &val) ==
            TDB_ERR_UNKNOWN_OPTION);

     assert(tdb_cons_get_opt(c, TDB_OPT_CONS_OUTPUT_FORMAT, &val) == 0);
+#ifdef HAVE_ARCHIVE_H
     assert(val.value == TDB_OPT_CONS_OUTPUT_FORMAT_PACKAGE);
+#else
+    assert(val.value == TDB_OPT_CONS_OUTPUT_FORMAT_DIR);
+#endif

     for (i = 0; i < NUM_EVENTS; i++)
        assert(tdb_cons_add(c, uuid, i, values, lengths) == 0);
