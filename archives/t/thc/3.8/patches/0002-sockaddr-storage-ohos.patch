--- a/thc-ipv6-lib.c	2026-09-22 01:09:11.310865782 +0800
+++ b/thc-ipv6-lib.c	2026-09-22 01:09:11.758861719 +0800
@@ -69,7 +69,23 @@
   #include <netinet/if_ether.h>
 #else
   #include <linux/if_ether.h>
+/*
+ * Feature detection (R8): sys/socket.h (included above, line 30) defines
+ * sockaddr_storage. On OHOS musl, linux/socket.h -- pulled in transitively by
+ * linux/netlink.h -- uses the _UAPI_LINUX_SOCKET_H include guard and would
+ * redefine sockaddr_storage. Pre-defining that guard skips the conflicting
+ * definition; __kernel_sa_family_t is provided because the now-skipped
+ * linux/socket.h would normally define it (asm/types.h does not on OHOS).
+ * On standard Linux the guard name differs, so this is a no-op there.
+ */
+#ifdef _SYS_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+typedef unsigned short __kernel_sa_family_t;
+#endif
   #include <linux/netlink.h>
+#ifdef _SYS_SOCKET_H
+#undef _UAPI_LINUX_SOCKET_H
+#endif
 #endif
 
 #include "thc-ipv6.h"
