Propagate XXHASH_INCLUDE_DIR (filled in by find_path) to the parent
scope instead of the never-assigned XXHASH_INCLUDE_DIRS.

include/xxhash/CMakeLists.txt sets XXHASH_INCLUDE_DIRS from itself, so
the value find_path() just computed in XXHASH_INCLUDE_DIR is dropped and
src/{state,dom,transfuse}.cpp cannot resolve #include <xxhash.h>.

--- a/include/xxhash/CMakeLists.txt
+++ b/include/xxhash/CMakeLists.txt
@@ -1,7 +1,7 @@
 if(NOT BUNDLED_XXHASH)
 	find_path(XXHASH_INCLUDE_DIR xxhash.h)
 	find_library(XXHASH_LIBRARIES xxhash)
-	set(XXHASH_INCLUDE_DIRS ${XXHASH_INCLUDE_DIRS} PARENT_SCOPE)
+	set(XXHASH_INCLUDE_DIRS ${XXHASH_INCLUDE_DIR} PARENT_SCOPE)
 	set(XXHASH_LIBRARIES ${XXHASH_LIBRARIES} PARENT_SCOPE)
 else()
 	add_library(xxhash STATIC
