From: OpenDesk <opendesk@openharmony.cn>
Date: Tue, 18 Mar 2026 23:46:00 +0800
Subject: [PATCH] Port GNU tar 1.35 for OpenHarmony

Add support for OpenHarmony/HarmonyOS operating system:
- Add HarmonyOS detection in config.guess
- Add ohos OS support in config.sub
- Enable linux-ohos kernel-OS combination

Signed-off-by: OpenDesk <opendesk@openharmony.cn>
---
 build-aux/config.guess | 8 ++++++++
 build-aux/config.sub   | 9 ++++++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/build-aux/config.guess b/build-aux/config.guess
index 1234567..abcdefg 100755
--- a/build-aux/config.guess
+++ b/build-aux/config.guess
@@ -150,6 +150,10 @@ UNAME_VERSION=\`(uname -v) 2>/dev/null\` || UNAME_VERSION=unknown
 
 case \$UNAME_SYSTEM in
+HarmonyOS)
+	# OpenHarmony/HarmonyOS uses musl libc
+	LIBC=musl
+	;;
 Linux|GNU|GNU/*)
 	LIBC=unknown
 
@@ -975,6 +979,10 @@ case \$UNAME_MACHINE:\$UNAME_SYSTEM:\$UNAME_RELEASE:\$UNAME_VERSION in
     *:Minix:*:*)
 	GUESS=\$UNAME_MACHINE-unknown-minix
 	;;
+    aarch64:HarmonyOS:*:*)
+	GUESS=\$UNAME_MACHINE-unknown-linux-ohos
+	;;
     aarch64:Linux:*:*)
 	GUESS=\$UNAME_MACHINE-unknown-linux-\$LIBC
 	;;
diff --git a/build-aux/config.sub b/build-aux/config.sub
index 1234567..abcdefg 100755
--- a/build-aux/config.sub
+++ b/build-aux/config.sub
@@ -1341,6 +1341,10 @@ case \$basic_os in
 		kernel=linux
 		os=\`echo "\$basic_os" | sed -e 's|linux|gnu|'\`
 		;;
+	ohos*)
+		kernel=linux
+		os=ohos
+		;;
 	managarm*)
 		kernel=managarm
 		os=\`echo "\$basic_os" | sed -e 's|managarm|mlibc|'\`
@@ -1727,7 +1731,7 @@ case \$os in
 	# Now accept the basic system types.
 	# The portable systems comes first.
 	# Each alternative MUST end in a * to match a version number.
-	gnu* | android* | bsd* | mach* | minix* | genix* | ultrix* | irix* \
+	ohos* | gnu* | android* | bsd* | mach* | minix* | genix* | ultrix* | irix* \
 	     | *vms* | esix* | aix* | cnk* | sunos | sunos[34]* \
 	     | hpux* | unos* | osf* | luna* | dgux* | auroraux* | solaris* \
 	     | sym* |  plan9* | psp* | sim* | xray* | os68k* | v88r* \
@@ -1779,7 +1783,8 @@ esac
 # (given a valid OS), if there is a kernel.
 case \$kernel-\$os in
 	linux-gnu* | linux-dietlibc* | linux-android* | linux-newlib* \
-		   | linux-musl* | linux-relibc* | linux-uclibc* | linux-mlibc* )
+		   | linux-musl* | linux-relibc* | linux-uclibc* | linux-mlibc* \
+		   | linux-ohos* )
 		;;
 	uclinux-uclibc* )
 		;;
-- 
