diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -47681,21 +47681,21 @@
               tmp=`(umask 077 && mktemp -d /tmp/gtXXXXXX) 2>/dev/null` &&
               test -n "$tmp" && test -d "$tmp"
             } ||
             {
               # Use a simple mkdir command. It is guaranteed to fail if the directory
               # already exists.  $RANDOM is bash specific and expands to empty in shells
               # other than bash, ksh and zsh.  Its use does not increase security;
               # rather, it minimizes the probability of failure in a very cluttered /tmp
               # directory.
               tmp=/tmp/gt$$-$RANDOM
-              (umask 077 && mkdir "$tmp")
+              (umask 007 && mkdir "$tmp")
             }; then
            mkdir "$tmp/subdir"
            GL_SUBDIR_FOR_UNLINK="$tmp/subdir"
            export GL_SUBDIR_FOR_UNLINK
            if test "$cross_compiling" = yes
 then :
   # If we don't know, obey --enable-cross-guesses.
               gl_cv_func_unlink_parent_fails="$gl_cross_guess_normal"
 
 else $as_nop
@@ -55506,26 +55506,26 @@
   tmp= ac_tmp=
   trap 'exit_status=$?
   : "${ac_tmp:=$tmp}"
   { test ! -d "$ac_tmp" || rm -fr "$ac_tmp"; } && exit $exit_status
 ' 0
   trap 'as_fn_exit 1' 1 2 13 15
 }
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 007 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 007 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
 # Set up the scripts for CONFIG_FILES section.
 # No need to generate them if there are no CONFIG_FILES.
 # This happens for instance with `./config.status config.h'.
 if test -n "$CONFIG_FILES"; then
 
 
 ac_cr=`echo X | tr X '\015'`
