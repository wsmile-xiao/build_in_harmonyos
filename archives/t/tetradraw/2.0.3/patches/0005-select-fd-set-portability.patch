@@ -42,6 +42,20 @@
 
 #include "multidraw.h"
 
+/* OHOS ships a non-POSIX <sys/select.h>: its FD_SET/FD_CLR macros call the
+   private libc helper __fd_chk(), which is exported only by the OHOS
+   sysroot libc.  A binary linked against any other libc (a cross-execution
+   sandbox, a generic container image, a glibc/musl host) then fails to load
+   with "Error relocating ...: __fd_chk: symbol not found".  The only two
+   descriptors monitored here are STDIN and an accepted socket, so the OHOS
+   fd<1024 bounds check can never trigger; restore the classic POSIX FD_SET
+   so the binaries depend on nothing beyond the standard select() ABI. */
+#ifdef FD_SET
+#undef FD_SET
+#endif
+#define FD_SET(d, s) do { (s)->fds_bits[(d) / (8 * sizeof(long))] |= \
+                                      1UL << ((d) % (8 * sizeof(long))); } while (0)
+
