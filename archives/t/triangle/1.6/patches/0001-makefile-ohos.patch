--- a/makefile
+++ b/makefile
@@ -18,7 +18,7 @@
 
 # CC should be set to the name of your favorite C compiler.
 
-CC = cc
+CC ?= cc
 
 # CSWITCHES is a list of all switches passed to the C compiler.  I strongly
 #   recommend using the best level of optimization.  I also strongly
@@ -73,7 +73,20 @@
 #
 #   CSWITCHES = -O -DNO_TIMER -DLINUX -I/usr/X11R6/include -L/usr/X11R6/lib
 
-CSWITCHES = -O -DLINUX -I/usr/X11R6/include -L/usr/X11R6/lib
+# ---- HarmonyOS / modern-compiler port -------------------------------------
+# -DLINUX is dropped: it makes triangle.c include <fpu_control.h> and call
+#   _FPU_SETCW(), which exist only on glibc/x86.  aarch64 has IEEE double
+#   arithmetic natively, so the FPU control word adjustment that -DLINUX
+#   enables is not needed there.
+# -I/usr/X11R6/include -L/usr/X11R6/lib only mattered for the optional
+#   Show Me viewer, which requires X11 and is not built by this recipe.
+# Real optimisation/PIC flags arrive from the Conan toolchain through
+#   $(CPPFLAGS) and $(CFLAGS).
+# CSTD pins the C dialect: triangle.c is 1990s K&R C with 124 old-style
+#   function definitions, which C23 removed; compilers defaulting to
+#   -std=gnu23 otherwise reject the source outright.
+CSTD = -std=gnu17
+CSWITCHES = $(CPPFLAGS) $(CFLAGS) $(CSTD)
 
