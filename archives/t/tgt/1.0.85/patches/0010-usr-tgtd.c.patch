--- a/usr/tgtd.c
+++ b/usr/tgtd.c
@@ -110,6 +110,19 @@
 
 static void signal_catch(int signo)
 {
+	/*
+	 * Upstream tgt 1.0.85 leaves SIGTERM/SIGINT as a no-op, stopping the
+	 * daemon only via the mgmt channel (system_active = 0). On HarmonyOS a
+	 * daemon must honour SIGTERM, so trigger the SAME graceful shutdown path
+	 * the mgmt interface uses. (AI review #12277 items [8]/[9]: the prior
+	 * test masked the missing handler by counting a SIGKILL fallback as pass.)
+	 */
+	switch (signo) {
+	case SIGTERM:
+	case SIGINT:
+		system_active = 0;
+		break;
+	}
 }
 
 static int oom_adjust(void)
