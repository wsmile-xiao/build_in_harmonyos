 void concat_buf_init(struct concat_buf *b)
 {
+	/* POSIX leaves the buffer pointer and size unspecified until the stream is flushed,
+	 * and open_memstream() does not reset them when it fails. Start from a
+	 * known state so concat_buf_release() can never free a stale pointer. */
+	b->buf = NULL;
+	b->size = 0;
 	b->streamf = open_memstream(&b->buf, &b->size);
 	b->err = b->streamf ? 0 : errno;
 	b->used = 0;
 }
 
