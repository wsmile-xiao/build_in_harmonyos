 int concat_buf_finish(struct concat_buf *b)
 {
 	if (b->streamf) {
+		/* fflush() is what publishes b->buf/b->size on implementations
+		 * that buffer the memstream (e.g. musl); fclose() flushes too,
+		 * but callers rely on b->size being valid right after finish(). */
+		fflush(b->streamf);
 		fclose(b->streamf);
 		b->streamf = NULL;
 		if (b->size)
 			b->size++; /* account for trailing NULL char */
 	}
 	return b->err;
 }
 
