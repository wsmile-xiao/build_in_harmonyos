+    for(size_t i = 0; i < _blocks_per_chunk; ++i) {
+      void* block = base + i * _block_size;
+      *reinterpret_cast<void**>(block) = _free_head;
+      _free_head = block;
+    }
+  }
+
+  size_t _block_size;
+  size_t _block_alignment;
+  size_t _blocks_per_chunk;
+
+  std::mutex _mutex;
+  void* _free_head {nullptr};
+  std::vector<void*> _chunks;
+};
