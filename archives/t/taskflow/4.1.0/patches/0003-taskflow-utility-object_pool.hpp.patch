+    // growth can raise std::bad_alloc), release it instead of leaking. The
+    // chunk is deliberately recorded before any block is linked into the free
+    // list, so release() always sees every allocation this pool owns.
+    try {
+      _chunks.push_back(chunk);
+    }
+    catch(...) {
