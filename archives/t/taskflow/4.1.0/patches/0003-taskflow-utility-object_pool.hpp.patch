+
+  public:
+
+  SynchronizedBlockPool(
+    size_t block_size, size_t block_alignment, size_t blocks_per_chunk
+  ) :
+    _block_size      {block_size},
+    _block_alignment {block_alignment},
+    _blocks_per_chunk{blocks_per_chunk == 0 ? 1 : blocks_per_chunk} {
+  }
+
+  SynchronizedBlockPool(const SynchronizedBlockPool&) = delete;
+  SynchronizedBlockPool& operator=(const SynchronizedBlockPool&) = delete;
