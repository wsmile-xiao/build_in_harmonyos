+  void* allocate(size_t bytes, size_t alignment) {
+    if(bytes > _block_size || alignment > _block_alignment) {
+      // bypass the pool, mirroring polymorphic_allocator's upstream fallback
+      return ::operator new(bytes, std::align_val_t{alignment});
+    }
+    std::lock_guard<std::mutex> lock(_mutex);
+    if(_free_head == nullptr) {
+      _grow();
+    }
+    void* block = _free_head;
+    _free_head = *reinterpret_cast<void**>(block);
+    return block;
+  }
+
+  void deallocate(void* p, size_t bytes, size_t alignment) {
+    if(p == nullptr) {
+      return;
+    }
+    if(bytes > _block_size || alignment > _block_alignment) {
+      ::operator delete(p, bytes, std::align_val_t{alignment});
+      return;
+    }
+    std::lock_guard<std::mutex> lock(_mutex);
+    *reinterpret_cast<void**>(p) = _free_head;
+    _free_head = p;
+  }
+
+  void release() {
+    std::lock_guard<std::mutex> lock(_mutex);
+    for(void* chunk : _chunks) {
+      ::operator delete(chunk, std::align_val_t{_block_alignment});
+    }
+    _chunks.clear();
+    _free_head = nullptr;
+  }
+
+  private:
+
+  void _grow() {
+    void* chunk = ::operator new(
+      _block_size * _blocks_per_chunk, std::align_val_t{_block_alignment}
+    );
