diff -ruN a/libnetbsd/getpass.c b/libnetbsd/getpass.c
--- a/libnetbsd/getpass.c
+++ b/libnetbsd/getpass.c
@@ -0,0 +1,60 @@
+/* $NetBSD$ */
+
+/*
+ * getpass() replacement for musl/OHOS
+ * musl libc does not provide getpass(), so we provide a simple replacement
+ * using fgets() on /dev/tty.
+ */
+
+#ifndef HAVE_GETPASS
+
+#include <stdio.h>
+#include <string.h>
+#include <termios.h>
+#include <unistd.h>
+
+char *
+getpass(const char *prompt)
+{
+    FILE *tty;
+    struct termios old, new;
+    char *buf;
+    static char pbuf[128];
+    size_t len;
+    int tc_changed = 0;
+
+    tty = fopen("/dev/tty", "r+");
+    if (tty == NULL)
+        tty = stdin;
+
+    fprintf(tty, "%s", prompt);
+    fflush(tty);
+
+    if (tty == stdin) {
+        buf = fgets(pbuf, sizeof(pbuf), stdin);
+    } else {
+        if (tcgetattr(fileno(tty), &old) == 0) {
+            new = old;
+            new.c_lflag &= ~(ECHO | ECHOE | ECHOK | ECHONL);
+            if (tcsetattr(fileno(tty), TCSAFLUSH, &new) == 0)
+                tc_changed = 1;
+        }
+        buf = fgets(pbuf, sizeof(pbuf), tty);
+        if (tc_changed)
+            tcsetattr(fileno(tty), TCSAFLUSH, &old);
+        fprintf(tty, "\n");
+        fflush(tty);
+        fclose(tty);
+    }
+
+    if (buf == NULL)
+        return NULL;
+
+    len = strlen(pbuf);
+    if (len > 0 && pbuf[len - 1] == '\n')
+        pbuf[len - 1] = '\0';
+
+    return pbuf;
+}
+
+#endif /* !HAVE_GETPASS */
