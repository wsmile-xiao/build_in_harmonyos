+/*
+ * std::tmpnam() always builds its name below /tmp, and /tmp is read-only on
+ * HarmonyOS (HMDFS), which made every comparison fail with
+ *   sh: can't create /tmp/tmpnam_XXXXXX: Read-only file system
+ * Generate the temporary file below $TMPDIR instead (current directory as a
+ * fallback); the comparison logic itself is unchanged.
+ */
+static std::string makeTempName() {
+  const char *dir = std::getenv("TMPDIR");
+  std::string base = (dir != NULL && dir[0] != '\0') ? std::string(dir)
+                                                     : std::string(".");
+  char tmpl[4096];
+  std::snprintf(tmpl, sizeof(tmpl), "%s/tclap-test-XXXXXX", base.c_str());
+  int fd = ::mkstemp(tmpl);
+  if (fd >= 0) {
+    ::close(fd);
+  }
+  return std::string(tmpl);
+}
 
