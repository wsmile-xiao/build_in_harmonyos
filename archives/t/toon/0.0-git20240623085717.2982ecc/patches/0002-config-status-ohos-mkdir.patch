--- a/configure
+++ b/configure
@@ -3768,13 +3768,17 @@
 }
 # Create a (secure) tmp directory for tmp files.
 
+# The OHOS recipe opts into mkdir for the observed mktemp-path read failure.
+# Publish the cleanup path only after creating a directory owned by this run.
 {
+  test "x${TOON_CONFIG_STATUS_MKDIR-}" != x1 &&
   tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  ac_tmp_candidate=./conf$$-${RANDOM-}
+  (umask 077 && mkdir "$ac_tmp_candidate") &&
+  tmp=$ac_tmp_candidate
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
