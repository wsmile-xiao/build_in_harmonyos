--- a/tests/LinuxSmokeTest/common.sh
+++ b/tests/LinuxSmokeTest/common.sh
@@ -1,29 +1,37 @@
 function check_available() {
     if ! command -v "$1" > /dev/null; then
         echo "$1 is required."
         exit 1
     fi
 }
 
 function wait_port() {
-    until nc -z 127.0.0.1 "$1"; do
+    # nc is not part of the OHOS build image; bash /dev/tcp is equivalent.
+    # 60s timeout: a dead server must fail fast instead of hanging the CI job.
+    local tries=0
+    until (echo > /dev/tcp/127.0.0.1/"$1") 2>/dev/null; do
         sleep 0.1
+        tries=$((tries + 1))
+        if [ "$tries" -ge 600 ]; then
+            echo "wait_port $1: timeout after 60s" >&2
+            return 1
+        fi
     done
 }
 
 if [[ "$#" != "1" ]]; then
     echo "usage: $0 path_to_trojan"
     exit 1
 fi
 
 check_available curl
-check_available nc
 check_available openssl
 check_available python3
 
 SCRIPTDIR="$(dirname "$0")"
-TMPDIR="$(mktemp -d)"
+# /tmp is read-only on the target device; create the scratch dir under cwd.
+TMPDIR="$(mktemp -d "$PWD/trojan-smoke.XXXXXX")"
 
 echo "$TMPDIR"
 cp "$1" "$TMPDIR/trojan"
 cd "$SCRIPTDIR"
