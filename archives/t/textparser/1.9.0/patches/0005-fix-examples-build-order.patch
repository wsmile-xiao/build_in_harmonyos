--- a/Examples/CMakeLists.txt
+++ b/Examples/CMakeLists.txt
@@ -265,3 +265,25 @@
 endif(enable_fapi)
 
 endif(with_MPI)
+
+# Parallel-build fix: the Example executables link the TP library via the
+# `-lTP` linker flag plus link_directories(), which creates no CMake-level
+# target dependency. Parallel make may therefore link the examples before
+# libTP.a is built (ld.lld: unable to find library -lTP); serial builds
+# happen to succeed. Enforce the build order explicitly.
+if(NOT with_MPI)
+  add_dependencies(Example1_cpp TP)
+  add_dependencies(Example2_cpp TP)
+  add_dependencies(Example3_cpp TP)
+  add_dependencies(Example4_cpp TP)
+  add_dependencies(Example5_cpp TP)
+  add_dependencies(Example6_cpp TP)
+  add_dependencies(Example7_cpp TP)
+  add_dependencies(Example8_cpp TP)
+  add_dependencies(Example1_c TP)
+  add_dependencies(Example2_c TP)
+  add_dependencies(Example3_c TP)
+  add_dependencies(Example4_c TP)
+  add_dependencies(Example5_c TP)
+  add_dependencies(Example7_c TP)
+endif()
