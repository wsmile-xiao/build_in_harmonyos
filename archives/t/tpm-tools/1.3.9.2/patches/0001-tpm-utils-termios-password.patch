Read passwords with a termios fallback instead of getpass()
getpass() is a BSD/glibc extension: the musl-based HarmonyOS C library
neither declares nor exports it, so tpm_utils.c failed to compile
("incompatible integer to pointer conversion").  The password prompt now
uses a small termios helper that disables echo while reading, keeps the
same static-buffer contract as getpass() and works on any POSIX libc.
--- a/lib/tpm_utils.c
+++ b/lib/tpm_utils.c
@@ -158,41 +158,82 @@
  * You must free the memory passed back to you when you are finished.
  * Loop will always terminate by the second pass.
  * Safest use of getpass is to zero the memory as soon as possible.
  */
 char *getPlainPasswd(const char *a_pszPrompt, BOOL a_bConfirm) {
 	int len;
 	return _getPasswd(a_pszPrompt, &len, a_bConfirm, FALSE);
 }
 
 #ifndef TSS_LIB_IS_12
 char *getPasswd(const char *a_pszPrompt, int* a_iLen, 
 		BOOL a_bConfirm) {
 	return _getPasswd( a_pszPrompt, a_iLen, a_bConfirm, useUnicode);
 }
 #endif
+#include <termios.h>
+
+/*
+ * Read a password from the terminal without echoing it.
+ *
+ * getpass() is a BSD/glibc extension that not every C library provides
+ * (musl-based HarmonyOS neither declares it nor exports it), so the terminal
+ * handling is done here directly with termios.  Like getpass(), the returned
+ * pointer refers to a static buffer owned by this module.
+ */
+static char passwd_buffer[256];
+
+static char *read_passwd_noecho(const char *prompt) {
+	struct termios old_term, new_term;
+	int have_term = (tcgetattr(STDIN_FILENO, &old_term) == 0);
+	size_t len;
+
+	fputs(prompt, stdout);
+	fflush(stdout);
+
+	if (have_term) {
+		new_term = old_term;
+		new_term.c_lflag &= ~ECHO;
+		tcsetattr(STDIN_FILENO, TCSANOW, &new_term);
+	}
+
+	if (fgets(passwd_buffer, sizeof(passwd_buffer), stdin) == NULL)
+		passwd_buffer[0] = '\0';
+
+	if (have_term)
+		tcsetattr(STDIN_FILENO, TCSANOW, &old_term);
+
+	fputc('\n', stdout);
+
+	len = strlen(passwd_buffer);
+	if (len > 0 && passwd_buffer[len - 1] == '\n')
+		passwd_buffer[len - 1] = '\0';
+
+	return passwd_buffer;
+}
+
