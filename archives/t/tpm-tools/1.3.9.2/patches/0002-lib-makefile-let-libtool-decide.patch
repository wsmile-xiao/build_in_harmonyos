Let libtool decide whether libtpm_unseal is built shared or static
lib/Makefile.am forced '-shared' into libtpm_unseal_la_LDFLAGS, which
makes libtool abort ("cannot build a shared library") as soon as the
package is configured for a static build.  libtool already derives the
artifact kind from the configure options, so the hard-coded flag is
dropped and both shared and static configurations work.
--- a/lib/Makefile.am
+++ b/lib/Makefile.am
@@ -76,8 +76,8 @@
 #   5. If any interfaces have been added since the last public release, then increment age.
 #   6. If any interfaces have been removed since the last public release, then set age to 0.  
 
 #
 # Unseal library - for addition to existing apps, counter part of seal cmd
 libtpm_unseal_la_SOURCES =	tpm_unseal.c
-libtpm_unseal_la_LDFLAGS =	-shared -version-info 1:0:0
+libtpm_unseal_la_LDFLAGS =	-version-info 1:0:0
 libtpm_unseal_la_LIBADD  =	-ltspi  libtpm_tspi.la -lcrypto @INTLLIBS@
