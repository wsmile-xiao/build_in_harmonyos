+/* Portable password reading: write the prompt to stderr, read one line
+** from stdin, strip the trailing newline.  Returns buf; on EOF or error
+** buf is an empty string.  (getpass() is not available everywhere, so
+** plain POSIX stdio is used instead - no platform-specific macros.)
+** When stdin is a terminal, echo is suppressed while the line is read
+** (tcgetattr/tcsetattr, ECHO cleared and restored afterwards), matching
+** the no-echo behaviour of the getpass() this replaces. */
 
-char *getpass(const char *prompt) {
-
-static char password[81];
-
-fputs(prompt,stderr);
-gets((char *)&password);
-
-if (strlen((char *)&password) > 8) {
-  password[8]='\0';
-}
-
-return (char *)&password;
-}
-#endif
+static char *
+read_password( const char* prompt, char* buf, size_t buf_size )
+    {
+    struct termios saved_tio;
+    char* nl;
+    int echo_off = 0;
+
+    if ( prompt != (char*) 0 )
+	(void) fputs( prompt, stderr );
+    if ( isatty( fileno( stdin ) ) )
+	{
+	if ( tcgetattr( fileno( stdin ), &saved_tio ) == 0 )
+	    {
+	    struct termios tio = saved_tio;
+	    tio.c_lflag &= ~ECHO;
+	    if ( tcsetattr( fileno( stdin ), TCSAFLUSH, &tio ) == 0 )
+		echo_off = 1;
+	    }
+	}
+    if ( fgets( buf, (int) buf_size, stdin ) == (char*) 0 )
+	{
+	buf[0] = '\0';
+	if ( echo_off )
+	    (void) tcsetattr( fileno( stdin ), TCSAFLUSH, &saved_tio );
+	return buf;
+	}
+    if ( echo_off )
+	{
+	(void) tcsetattr( fileno( stdin ), TCSAFLUSH, &saved_tio );
+	(void) fputc( '\n', stderr );
+	}
+    nl = strchr( buf, '\n' );
+    if ( nl != (char*) 0 )
+	*nl = '\0';
+    return buf;
+    }
 
