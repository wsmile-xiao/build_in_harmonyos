 AC_LANG(C)

 # Checks for header files.
-AC_CHECK_HEADERS([fcntl.h stdint.h stdlib.h string.h sys/param.h unistd.h])
+AC_CHECK_HEADERS([error.h fcntl.h stdint.h stdlib.h string.h sys/param.h unistd.h])

 # Checks for typedefs, structures, and compiler characteristics.
 AC_TYPE_SSIZE_T
--- a/src/main.c
+++ b/src/main.c
@@ -31,7 +31,27 @@
 #include <stdlib.h>
 #include <errno.h>
 #include <string.h>
-#include <error.h>
+#include "config.h"
+#ifdef HAVE_ERROR_H
+#include <error.h>
+#else
+#include <stdarg.h>
+/* Portable fallback for musl-based systems (e.g. HarmonyOS) which lack
+ * glibc <error.h>. Same semantics used by tegrarcm: print MESSAGE plus
+ * errno string to stderr, exit(STATUS) when STATUS is non-zero. */
+static void error(int status, int errnum, const char *format, ...)
+{
+    va_list ap;
+    va_start(ap, format);
+    vfprintf(stderr, format, ap);
+    va_end(ap);
+    if (errnum)
+        fprintf(stderr, ": %s", strerror(errnum));
+    fprintf(stderr, "\n");
+    if (status)
+        exit(status);
+}
+#endif
 #include <sys/types.h>
 #include <sys/stat.h>
 #include <fcntl.h>
