diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,37 @@
+#!/bin/sh
+# Dummy configure script for teensy_loader_cli 2.3
+# This is a pure Makefile project with no autotools support.
+# The configure script simply records the prefix for the install target.
+
+PREFIX="/usr/local"
+
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            ;;
+        --help)
+            echo "Usage: ./configure [OPTIONS]"
+            echo "Options:"
+            echo "  --prefix=PREFIX   Installation prefix [default: /usr/local]"
+            echo ""
+            echo "This is a simple Makefile project. configure only sets PREFIX."
+            exit 0
+            ;;
+        *)
+            echo "Warning: Unknown option: $arg"
+            ;;
+    esac
+done
+
+echo "Configuring teensy_loader_cli 2.3..."
+echo "PREFIX=$PREFIX"
+echo ""
+
+# Write prefix to a config file that Makefile can read
+echo "PREFIX=$PREFIX" > Makefile.conf
+# Create a simple config.mk that Makefile can include
+echo "# Auto-generated by configure" > config.mk
+echo "PREFIX = $PREFIX" >> config.mk
+echo "Configuration complete. Run 'make' to build."
+exit 0
