-if(UNIX)
+# OHOS/HarmonyOS reports uname "HarmonyOS", so CMake leaves UNIX=FALSE and the
+# libpcap/POSIX capture backend would be dropped from the static caputils lib.
+# It is POSIX + libpcap, so take the same capture sources as other non-Windows.
+if(NOT WIN32)
 	set(PLATFORM_CAPUTILS_SRC
 		capture-pcap-util-unix.c
 	)
 endif()
 
 if(WIN32)
 	set(PLATFORM_CAPUTILS_SRC
 		capture_win_ifnames.c
 		capture-wpcap.c
 	)
