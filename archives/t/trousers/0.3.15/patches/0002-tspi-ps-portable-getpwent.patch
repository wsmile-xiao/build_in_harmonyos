Resolve the user home directory with the portable getpwent() iterator
get_user_ps_path() used the non-POSIX reentrant getpwent_r(), which the
musl-based HarmonyOS C library does not export, so anything linking
libtspi failed with "undefined symbol: getpwent_r".  The BSD branch of
the same function already used the portable setpwent/getpwent/endpwent
iterator; the Linux branch now does the same.
--- a/src/tspi/ps/tspps.c
+++ b/src/tspi/ps/tspps.c
@@ -57,27 +57,24 @@
 static struct flock fl;
 
 
 /*
  * Determine the default path to the persistent storage file and create it if it doesn't exist.
  */
 TSS_RESULT
 get_user_ps_path(char **file)
 {
 	TSS_RESULT result;
 	char *file_name = NULL, *home_dir = NULL;
 	struct passwd *pwp;
-#if (defined (__linux) || defined (linux) || defined(__GLIBC__))
-	struct passwd pw;
-#endif
 	struct stat stat_buf;
 	char buf[PASSWD_BUFSIZE];
 	uid_t euid;
 	int rc;
 
 	if ((file_name = getenv("TSS_USER_PS_FILE"))) {
 		*file = strdup(file_name);
 		return (*file) ? TSS_SUCCESS : TSPERR(TSS_E_OUTOFMEMORY);
 	}
 #if (defined (__FreeBSD__) || defined (__OpenBSD__))
 	MUTEX_LOCK(user_ps_path);
 #endif
@@ -87,42 +84,39 @@
 #if defined (SOLARIS)
 	/*
          * Solaris keeps user PS in a local directory instead of
          * in the user's home directory, which may be shared
          * by multiple systems.
          *
          * The directory path on Solaris is /var/tpm/userps/[EUID]/
          */
         rc = snprintf(buf, sizeof (buf), "%s/%d", TSS_USER_PS_DIR, euid);
 #else
 	setpwent();
 	while (1) {
-#if (defined (__linux) || defined (linux) || defined(__GLIBC__))
-		rc = getpwent_r(&pw, buf, PASSWD_BUFSIZE, &pwp);
-		if (rc) {
-			LogDebugFn("USER PS: Error getting path to home directory: getpwent_r: %s",
-				   strerror(rc));
-			endpwent();
-			return TSPERR(TSS_E_INTERNAL_ERROR);
-		}
-
-#elif (defined (__FreeBSD__) || defined (__OpenBSD__))
+		/*
+		 * Walk the passwd database with the portable getpwent() iterator.
+		 * The reentrant getpwent_r() used before is not POSIX and is
+		 * missing from some C libraries (musl-based HarmonyOS), while
+		 * setpwent/getpwent/endpwent are available everywhere.
+		 */
 		if ((pwp = getpwent()) == NULL) {
 			LogDebugFn("USER PS: Error getting path to home directory: getpwent: %s",
-                                   strerror(rc));
+				   strerror(errno));
 			endpwent();
+#if (defined (__FreeBSD__) || defined (__OpenBSD__))
 			MUTEX_UNLOCK(user_ps_path);
+#endif
 			return TSPERR(TSS_E_INTERNAL_ERROR);
 		}
-#endif
 		if (euid == pwp->pw_uid) {
                         home_dir = strdup(pwp->pw_dir);
                         break;
                 }
         }
         endpwent();
 
 	if (!home_dir)
 		return TSPERR(TSS_E_OUTOFMEMORY);
 
 	/* Tack on TSS_USER_PS_DIR and see if it exists */
 	rc = snprintf(buf, sizeof (buf), "%s/%s", home_dir, TSS_USER_PS_DIR);
