Use portable C library entry points in tcsd
tcsd uses two entry points that are not available in every C library:
  * rindex() is the legacy BSD spelling of strrchr();
  * getutid() is missing from the musl-based HarmonyOS C library (the
    utmp scanning functions setutent/getutent/endutent are present), so
    the runlevel lookup now filters RUN_LVL records itself, which is the
    same query the old code expressed through getutid().
Both changes are plain POSIX portability fixes and keep the behaviour on
libraries that provide the original entry points.
--- a/src/tcsd/platform.c
+++ b/src/tcsd/platform.c
@@ -46,37 +46,46 @@
 
 	MUTEX_LOCK(utmp_lock);
 
 	memset(&ut, 0, sizeof(struct utmp));
 	memset(&save, 0, sizeof(struct utmp));
 	memset(&tv, 0, sizeof(struct timeval));
 
 	ut.ut_type = RUN_LVL;
 
 	setutent();
-	next = getutid(&ut);
 
-	while (next != NULL) {
+	/*
+	 * Scan the utmp database directly instead of using getutid(): the lookup
+	 * key would be the record type, and not every C library exports that
+	 * entry point (musl-based HarmonyOS does not), while setutent/getutent/
+	 * endutent are available everywhere.
+	 */
+	while ((next = getutent()) != NULL) {
+		if (next->ut_type != RUN_LVL)
+			continue;
+
 		if (next->ut_tv.tv_sec > tv.tv_sec) {
 			memcpy(&save, next, sizeof(*next));
 			flag = 1;
 		} else if (next->ut_tv.tv_sec == tv.tv_sec) {
 			if (next->ut_tv.tv_usec > tv.tv_usec) {
 				memcpy(&save, next, sizeof(*next));
 				flag = 1;
 			}
 		}
 
 		counter++;
-		next = getutid(&ut);
 	}
 
+	endutent();
+
 	if (flag) {
 		//printf("prev_runlevel=%c, runlevel=%c\n", save.ut_pid / 256, save.ut_pid % 256);
 		runlevel = save.ut_pid % 256;
 	} else {
 		//printf("unknown\n");
 		runlevel = 'u';
 	}
 
 	MUTEX_UNLOCK(utmp_lock);
 
