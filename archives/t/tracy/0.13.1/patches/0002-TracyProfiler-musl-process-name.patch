diff --git a/public/client/TracyProfiler.cpp b/public/client/TracyProfiler.cpp
index 0691f78..bf75883 100644
--- a/public/client/TracyProfiler.cpp
+++ b/public/client/TracyProfiler.cpp
@@ -438,8 +438,25 @@ static const char* GetProcessName()
     auto buf = getprogname();
     if( buf ) processName = buf;
 #  endif
-#elif defined __linux__ && defined _GNU_SOURCE
+#elif defined __linux__ && defined __GLIBC__
     if( program_invocation_short_name ) processName = program_invocation_short_name;
+#elif defined __linux__
+    // musl-based C libraries (OHOS) get _GNU_SOURCE predefined by the clang
+    // driver and provide no glibc program_invocation_short_name, so read the
+    // process name from procfs instead of degrading to "unknown".
+    static char procName[256];
+    const int fd = open( "/proc/self/comm", O_RDONLY );
+    if( fd >= 0 )
+    {
+        const ssize_t len = read( fd, procName, sizeof( procName ) - 1 );
+        close( fd );
+        if( len > 0 )
+        {
+            procName[len] = '\0';
+            if( len > 1 && procName[len-1] == '\n' ) procName[len-1] = '\0';
+            processName = procName;
+        }
+    }
 #elif defined __APPLE__ || defined BSD
     auto buf = getprogname();
     if( buf ) processName = buf;
@@ -457,8 +474,18 @@ static const char* GetProcessExecutablePath()
     return buf;
 #elif defined __ANDROID__
     return nullptr;
-#elif defined __linux__ && defined _GNU_SOURCE
+#elif defined __linux__ && defined __GLIBC__
     return program_invocation_name;
+#elif defined __linux__
+    // Same musl/OHOS gap as in GetProcessName(): resolve /proc/self/exe.
+    static char exePath[PATH_MAX];
+    const ssize_t len = readlink( "/proc/self/exe", exePath, sizeof( exePath ) - 1 );
+    if( len > 0 )
+    {
+        exePath[len] = '\0';
+        return exePath;
+    }
+    return nullptr;
 #elif defined __APPLE__
     static char buf[1024];
     uint32_t size = 1024;
