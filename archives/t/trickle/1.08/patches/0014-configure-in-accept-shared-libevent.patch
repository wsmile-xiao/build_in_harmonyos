Description: Accept shared-only libevent installs in --with-libevent check

Upstream configure.in requires <dir>/lib/libevent.a to exist; the conan
libevent/2.1.13 package ships only shared libraries (libevent.so etc.),
so `--with-libevent=<pkg>` always fails with "event.h or libevent.a not
found". Accept either the static archive or the shared object. Link
behavior is unchanged (the linker resolves -levent against whatever is
present).

--- a/configure.in
+++ b/configure.in
@@ -104,12 +104,12 @@
      ;;
   *)
      AC_MSG_RESULT($withval)
-     if test -f $withval/include/event.h -a -f $withval/lib/libevent.a; then
+     if test -f $withval/include/event.h -a \( -f $withval/lib/libevent.a -o -f $withval/lib/libevent.so \); then
         owd=`pwd`
         if cd $withval; then withval=`pwd`; cd $owd; fi
         EVENTINC="-I$withval/include"
         EVENTLIB="-L$withval/lib -levent"
-     elif test -f $withval/event.h -a -f $withval/libevent.a; then
+     elif test -f $withval/event.h -a \( -f $withval/libevent.a -o -f $withval/libevent.so \); then
         owd=`pwd`
         if cd $withval; then withval=`pwd`; cd $owd; fi
         EVENTINC="-I$withval"
