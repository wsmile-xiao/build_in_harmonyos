Description: Use $(LTLIBOBJS) instead of @LTLIBOBJS@ in Makefile.am

Automake requires that the LIBOBJS/LTLIBOBJS substitutions be
referenced through the variables, not the literal @...@ spelling;
modern automake diagnoses direct @LTLIBOBJS@ usage. The generated
value is identical.

--- a/Makefile.am
+++ b/Makefile.am
@@ -1,6 +1,6 @@
 include $(top_srcdir)/Makefile.am.inc
 
-TRICKLEOVERLOADFILES = @LTLIBOBJS@ trickle-overload.lo bwstat.lo trickledu.lo \
+TRICKLEOVERLOADFILES = $(LTLIBOBJS) trickle-overload.lo bwstat.lo trickledu.lo \
                        atomicio.lo xdr.lo schedule.lo
 trickle-overload.so: $(TRICKLEOVERLOADFILES)
 	$(LIBTOOL) --mode=link $(CC) $(CFLAGS) -o libtmp$@.la                \
