Use the tl-parser package instead of the missing git submodule
Upstream builds its own tl-parser from a git submodule that the release
tarball does not contain.  The tl-parser package provides the same tool, so
link it into the build directory and leave the rest of the Makefile alone.
--- a/Makefile.tl-parser
+++ b/Makefile.tl-parser
@@ -1,7 +1,7 @@
-TL_PARSER_OBJECTS=${OBJ}/tl-parser.o ${OBJ}/tlc.o
+# tl-parser is provided by the separate "tl-parser" package and is passed in
+# as an absolute path (TL_PARSER=...).  Upstream builds its own copy from the
+# "tl-parser" git submodule, which the release tarball does not contain.
+TL_PARSER ?= $(shell command -v tl-parser)
 
-${TL_PARSER_OBJECTS}: ${OBJ}/%.o: ${srcdir}/tl-parser/%.c | create_dirs
-	${CC} ${INCLUDE} ${COMPILE_FLAGS} -iquote ${srcdir}/tl-parser -c -MP -MD -MF ${DEP}/$*.d -MQ ${OBJ}/$*.o -o $@ $<
-
-${EXE}/tl-parser: ${TL_PARSER_OBJECTS}
-	${CC} $^ ${LINK_FLAGS} -o $@
+${EXE}/tl-parser: | create_dirs
+	ln -sf "$(TL_PARSER)" $@
