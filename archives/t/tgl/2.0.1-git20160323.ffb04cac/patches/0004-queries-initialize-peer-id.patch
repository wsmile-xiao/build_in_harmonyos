Initialize the whole tgl_peer_id_t in tgl_do_send_document
Only peer_id was set, leaving the other members uninitialized; the struct is
copied into the message later, which is undefined behaviour.
Adapted from Debian's 0004_ppc64el_uninitialized.patch (upstream PR
https://github.com/vysheng/tgl/pull/150).
--- a/queries.c
+++ b/queries.c
@@ -2183,8 +2183,7 @@
       flags |= TGLDF_AUDIO;
     }
   }
-  tgl_peer_id_t x;
-  x.peer_id = 0;
+  tgl_peer_id_t x = { .peer_id=0 };
   _tgl_do_send_photo (TLS, to_id, file_name, x, 100, 100, 100, 0, 0, caption, caption_len, flags, callback, callback_extra);
 }
 
