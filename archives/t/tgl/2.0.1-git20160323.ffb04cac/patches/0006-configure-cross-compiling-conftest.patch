Continue in cross-compile mode when a conftest cannot be executed
HarmonyOS only runs signed executables, so the probe program the compiler check
just linked cannot be run from the Conan build tree.  The compiler itself was
already validated, so aborting here would be wrong; keep cross_compiling=yes
and say why (same fix as the at/atd recipe, E064).
--- a/configure
+++ b/configure
@@ -2828,11 +2828,12 @@
     if test "$cross_compiling" = maybe; then
 	cross_compiling=yes
     else
-	{ { $as_echo "$as_me:${as_lineno-$LINENO}: error: in \`$ac_pwd':" >&5
-$as_echo "$as_me: error: in \`$ac_pwd':" >&2;}
-as_fn_error $? "cannot run C compiled programs.
-If you meant to cross compile, use \`--host'.
-See \`config.log' for more details" "$LINENO" 5; }
+	# HarmonyOS only runs signed executables, so a freshly linked conftest
+	# cannot be executed here.  Keep going in cross-compile mode instead of
+	# aborting: the compiler itself was already verified above.
+	cross_compiling=yes
+	{ $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: cannot run C compiled programs (HarmonyOS), continuing in cross-compile mode" >&5
+$as_echo "$as_me: WARNING: cannot run C compiled programs (HarmonyOS), continuing in cross-compile mode" >&2; }
     fi
   fi
 fi
