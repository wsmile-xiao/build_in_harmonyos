Package the library properly and keep the generator buildable
Upstream has no install target, so the library and the public headers could not
be packaged; the one added here installs the file set the Debian package ships
(all headers keep the <tgl/...> layout their relative includes assume).

Two compiler flags need adjusting for a modern toolchain:
  * -Werror is dropped: this 2016 code base was warning clean for gcc 5, while
    clang 15 reports additional diagnostics in the generated code paths.
  * -UNDEBUG is added after ${CFLAGS}: the TL code generator drives its schema
    reader through asserts with side effects ("assert (get_int () ==
    TLS_SCHEMA_V2)"), so a Release build (-DNDEBUG) makes bin/generate read a
    misaligned schema and die with SIGSEGV.
--- a/Makefile.in
+++ b/Makefile.in
@@ -4,7 +4,15 @@
 LDFLAGS=@LDFLAGS@ @OPENSSL_LDFLAGS@
 CPPFLAGS=@CPPFLAGS@ @OPENSSL_INCLUDES@
 DEFS=@DEFS@
-COMPILE_FLAGS=${CFLAGS} ${CPFLAGS} ${CPPFLAGS} ${DEFS} -Wall -Wextra -Werror -Wno-deprecated-declarations -fno-strict-aliasing -fno-omit-frame-pointer -ggdb -Wno-unused-parameter -fPIC
+# -Werror is dropped: this 2016 code base was warning clean for gcc 5, while
+# clang 15 (the OHOS toolchain) reports additional diagnostics in the
+# generated code paths.
+# -UNDEBUG is appended because the TL code generator drives its schema reader
+# through asserts with side effects ("assert (get_int () == TLS_SCHEMA_V2)"):
+# compiled with NDEBUG those calls vanish and bin/generate dies with SIGSEGV
+# on a misaligned schema.  It has to come after ${CFLAGS}, which is where
+# Release builds put -DNDEBUG.
+COMPILE_FLAGS=${CFLAGS} ${CPFLAGS} ${CPPFLAGS} ${DEFS} -UNDEBUG -Wall -Wextra -Wno-deprecated-declarations -fno-strict-aliasing -fno-omit-frame-pointer -ggdb -Wno-unused-parameter -fPIC
 
 EXTRA_LIBS=@LIBS@ @EXTRA_LIBS@ @OPENSSL_LIBS@
 LOCAL_LDFLAGS=-rdynamic -ggdb ${EXTRA_LIBS}
@@ -90,6 +98,16 @@
 ${EXE}/dump-tl-file: ${OBJ}/auto/auto.o ${TLD_OBJECTS}
 	${CC} ${OBJ}/auto/auto.o ${TLD_OBJECTS} ${LINK_FLAGS} -o $@
 
+# Upstream has no install target; this one installs the same file set the
+# Debian package ships (library plus every public header, keeping the
+# <tgl/...> include layout the headers assume for their relative includes).
+install: all
+	mkdir -p "${DESTDIR}${prefix}/lib" "${DESTDIR}${prefix}/include/tgl/crypto" "${DESTDIR}${prefix}/include/tgl/auto"
+	cp -f ${LIB_LIST} "${DESTDIR}${prefix}/lib/"
+	cp -f ${srcdir}/*.h "${DESTDIR}${prefix}/include/tgl/"
+	cp -f ${srcdir}/crypto/*.h "${DESTDIR}${prefix}/include/tgl/crypto/"
+	cp -f ${AUTO}/*.h "${DESTDIR}${prefix}/include/tgl/auto/"
+
 clean:
 	rm -rf ${DIR_LIST}
 
