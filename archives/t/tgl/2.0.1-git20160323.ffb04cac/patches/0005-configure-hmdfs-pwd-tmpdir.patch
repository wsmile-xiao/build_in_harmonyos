Make configure work inside the Conan cache on HMDFS
getcwd() can fail there even though the shell does have a working directory, so
fall back to the logical path pinned in $PWD instead of aborting, and create
the config.status scratch directory with umask 022: HMDFS forces the setgid bit
on new directories, which makes a umask-077 directory unwritable even for its
owner.
--- a/configure
+++ b/configure
@@ -1160,7 +1160,11 @@
 test "$silent" = yes && exec 6>/dev/null
 
 
-ac_pwd=`pwd` && test -n "$ac_pwd" &&
+# HMDFS: getcwd() can fail inside the Conan cache even though the shell does
+# have a working directory; fall back to the logical path the caller pinned in
+# $PWD (same workaround as the adms recipe).
+ac_pwd=`pwd` 2>/dev/null || ac_pwd=$PWD
+test -n "$ac_pwd" &&
 ac_ls_di=`ls -di .` &&
 ac_pwd_ls_di=`cd "$ac_pwd" && ls -di .` ||
   as_fn_error $? "working directory cannot be determined"
@@ -5223,12 +5228,12 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 022 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
