+/* Paths compiled in from config.h may be overridden through the environment,
+   so the programs stay usable where /etc and /var are read-only.  The
+   override is ignored when running privileged or set-id: a root login
+   wrapper started by telnetd/getty keeps the fixed upstream paths. */
+
+const char *conf_path (const char *name, const char *dflt)
+{
+	const char *val;
+
+	if (geteuid() == 0 || getuid() != geteuid() || getgid() != getegid())
+		return (dflt);
+
+	val = getenv(name);
+	return ((val != NULL && *val != 0) ? val : dflt);
 }
 
