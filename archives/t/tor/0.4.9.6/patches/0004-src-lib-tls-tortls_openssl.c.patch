 /** Return true iff this TLS connection is authenticated.
  */
 int
 tor_tls_peer_has_cert(tor_tls_t *tls)
 {
   X509 *cert;
+  /* HarmonyOS: OpenSSL 3.x uses SSL_get0_peer_certificate instead of SSL_get_peer_certificate */
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+  cert = SSL_get0_peer_certificate(tls->ssl);
+#else
   cert = SSL_get_peer_certificate(tls->ssl);
+#endif
   tls_log_errors(tls, LOG_WARN, LD_HANDSHAKE, "getting peer certificate");
   if (!cert)
     return 0;
+#if OPENSSL_VERSION_NUMBER < 0x30000000L
   X509_free(cert);
+#endif
   return 1;
 }
 
 /** Return a newly allocated copy of the peer certificate, or NULL if there
  * isn't one. */
 MOCK_IMPL(tor_x509_cert_t *,
 tor_tls_get_peer_cert,(tor_tls_t *tls))
 {
   X509 *cert;
+  /* HarmonyOS: OpenSSL 3.x uses SSL_get0_peer_certificate instead of SSL_get_peer_certificate */
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+  cert = SSL_get1_peer_certificate(tls->ssl);
+#else
   cert = SSL_get_peer_certificate(tls->ssl);
+#endif
   tls_log_errors(tls, LOG_WARN, LD_HANDSHAKE, "getting peer certificate");
   if (!cert)
     return NULL;
   return tor_x509_cert_new(cert);
 }
 
 /** Return a newly allocated copy of the cerficate we used on the connection,
  * or NULL if somehow we didn't use one. */
 MOCK_IMPL(tor_x509_cert_t *,
 tor_tls_get_own_cert,(tor_tls_t *tls))
