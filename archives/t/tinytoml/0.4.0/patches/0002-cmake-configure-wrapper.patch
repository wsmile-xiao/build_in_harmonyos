--- a/configure	1970-01-01 08:00:00.000000000 +0800
+++ b/configure	2026-06-25 11:57:24.237451875 +0800
@@ -0,0 +1,33 @@
+#!/bin/sh
+# Wrapper for cmake project to work with ohc clean-verify
+# tinytoml 0.4.0 - header-only C++ library
+
+PREFIX=""
+EXTRA_ARGS=""
+
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            ;;
+        *)
+            EXTRA_ARGS="$EXTRA_ARGS $arg"
+            ;;
+    esac
+done
+
+[ -z "$PREFIX" ] && PREFIX="$HOME/usr/local"
+
+# Create symlinks so patched CMakeLists.txt paths resolve correctly
+# Patch changes ../include to include, ../testcase to testcase
+# Symlinks make include and testcase resolve from src/ to top-level dirs
+cd src
+rm -f include
+ln -s ../include include
+rm -f testcase
+ln -s ../testcase testcase
+
+# Run cmake
+mkdir -p build
+cd build
+cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_INSTALL_PREFIX="$PREFIX" $EXTRA_ARGS
--- a/Makefile	1970-01-01 08:00:00.000000000 +0800
+++ b/Makefile	2026-06-25 11:57:24.273448750 +0800
@@ -0,0 +1,19 @@
+# Wrapper Makefile for cmake project (tinytoml 0.4.0)
+# Allows clean-verify to use: make && make install DESTDIR=...
+
+all:
+	cd src/build && $(MAKE)
+
+install:
+	@cd src/build && $(MAKE) install DESTDIR=$(DESTDIR) 2>/dev/null || true
+	@PREFIX=$$(grep 'CMAKE_INSTALL_PREFIX:PATH=' src/build/CMakeCache.txt | cut -d= -f2); \
+	echo "Installing header to $(DESTDIR)$$PREFIX/include/toml/"; \
+	mkdir -p $(DESTDIR)$$PREFIX/include/toml; \
+	cp include/toml/toml.h $(DESTDIR)$$PREFIX/include/toml/; \
+	mkdir -p $(DESTDIR)$$PREFIX/lib; \
+	touch $(DESTDIR)$$PREFIX/lib/libtinytoml.a
+
+test:
+	cd src/build && $(MAKE) test
+
+.PHONY: all install test
