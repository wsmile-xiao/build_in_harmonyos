--- a/src/demo/xmake.sh
+++ b/src/demo/xmake.sh
@@ -100,20 +100,33 @@
     # add the source files for the charset module
     if has_config "charset"; then
         add_files "other/charset.c"
     fi
 
     # add the source files for the database module
     if has_config "database"; then
         add_files "database/sql.c"
     fi
 
+    # link the sqlite3 package for the database module
+    # (see src/tbox/xmake.sh: the shell front-end has no package detection)
+    if has_config "database"; then
+        if test_nz "${TB_SQLITE3_INCLUDEDIR}"; then
+            add_defines "TB_CONFIG_PACKAGE_HAVE_SQLITE3=1"
+            add_includedirs "${TB_SQLITE3_INCLUDEDIR}"
+        fi
+        if test_nz "${TB_SQLITE3_LIBDIR}"; then
+            add_linkdirs "${TB_SQLITE3_LIBDIR}"
+        fi
+        add_links "sqlite3"
+    fi
+
     # link mingw/libgcc
     if is_plat "mingw" "msys" "cygwin"; then
         add_ldflags "-static-libgcc"
     fi
 
     # link backtrace/execinfo for bsd
     if is_plat "freebsd" "bsd"; then
         add_syslinks "execinfo"
     fi
 
