--- a/src/tbox/xmake.sh
+++ b/src/tbox/xmake.sh
@@ -238,13 +238,32 @@
     if has_config "zip"; then
         add_files "zip/zip.c"
         add_files "stream/impl/filter/zip.c"
     fi
 
     # add the source files for the database module
     if has_config "database"; then
         add_files "database/*.c"
     fi
 
+    # add the sqlite3 package for the database module
+    #
+    # the shell build front-end has no add_packages()/has_package() detection
+    # (that only exists in xmake.lua), so TB_CONFIG_PACKAGE_HAVE_* is never
+    # defined and the database module would be compiled with no backend at all.
+    # the header/library paths are injected by the packager through the
+    # TB_SQLITE3_INCLUDEDIR / TB_SQLITE3_LIBDIR environment variables.
+    if has_config "database"; then
+        if test_nz "${TB_SQLITE3_INCLUDEDIR}"; then
+            add_defines "TB_CONFIG_PACKAGE_HAVE_SQLITE3=1"
+            add_includedirs "${TB_SQLITE3_INCLUDEDIR}"
+            add_files "database/impl/sqlite3.c"
+        fi
+        if test_nz "${TB_SQLITE3_LIBDIR}"; then
+            add_linkdirs "${TB_SQLITE3_LIBDIR}"
+        fi
+        add_links "sqlite3"
+    fi
+
     # check interfaces
     check_interfaces
 
