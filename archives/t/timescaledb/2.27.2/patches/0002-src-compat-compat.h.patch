diff -ruN a/src/compat/compat.h b/src/compat/compat.h
--- a/src/compat/compat.h
+++ b/src/compat/compat.h
@@ -52,22 +52,24 @@
 
 #define PG15_LT (PG_VERSION_NUM < 150000)
 #define PG15_GE (PG_VERSION_NUM >= 150000)
