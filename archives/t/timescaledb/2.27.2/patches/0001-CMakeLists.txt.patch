diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -368,31 +368,47 @@
 )
 
 # Ensure that PostgreSQL version is supported and consistent with src/compat.h
 # version check
 if((${PG_VERSION_MAJOR} LESS "15")
    OR (${PG_VERSION_MAJOR} GREATER "18")
    AND NOT (${EXPERIMENTAL}))
   message(FATAL_ERROR "TimescaleDB only supports PostgreSQL 15, 16, 17 and 18")
 endif()
 
+# Pass EXPERIMENTAL flag to C compiler for compat.h
+if(EXPERIMENTAL)
+  add_definitions(-DEXPERIMENTAL)
+endif()
+
 # Get PostgreSQL configuration from pg_config
 get_pg_config(PG_INCLUDEDIR --includedir)
 get_pg_config(PG_INCLUDEDIR_SERVER --includedir-server)
 get_pg_config(PG_LIBDIR --libdir)
 get_pg_config(PG_PKGLIBDIR --pkglibdir)
 get_pg_config(PG_SHAREDIR --sharedir)
 get_pg_config(PG_BINDIR --bindir)
 get_pg_config(PG_CFLAGS --cflags)
 get_pg_config(PG_CFLAGS_SL --cflags_sl)
 get_pg_config(PG_CPPFLAGS --cppflags)
 get_pg_config(PG_LDFLAGS --ldflags)
+
+# Extract include paths from PG_CPPFLAGS and add them to include directories
+# This is needed for OpenSSL headers which are in ~/usr/local/include
+separate_arguments(PG_CPPFLAGS_SEPARATED UNIX_COMMAND "${PG_CPPFLAGS}")
+foreach(flag ${PG_CPPFLAGS_SEPARATED})
+  if(flag MATCHES "^-I(.+)$")
+    set(include_path "${CMAKE_MATCH_1}")
+    include_directories(SYSTEM ${include_path})
+    message(STATUS "Added include directory from pg_config: ${include_path}")
+  endif()
+endforeach()
 
 # Strip any -Wl,-rpath,... entries that pg_config may have emitted so the
 # resulting shared modules do not bake in a hardcoded library search path.
 string(REGEX REPLACE "-Wl,-rpath,[^ ]+" "" PG_LDFLAGS "${PG_LDFLAGS}")
 get_pg_config(PG_LIBS --libs)
 
 separate_arguments(PG_CFLAGS)
 foreach(option ${PG_CFLAGS})
   if(NOT ${option} MATCHES ^-W)
     set(filtered "${filtered} ${option}")
