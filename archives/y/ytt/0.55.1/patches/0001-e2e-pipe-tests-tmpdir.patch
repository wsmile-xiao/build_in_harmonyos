diff --git a/test/e2e/assets/test_pipe_redirect.sh b/test/e2e/assets/test_pipe_redirect.sh
index 8cb4f2a..b8467f4 100644
--- a/test/e2e/assets/test_pipe_redirect.sh
+++ b/test/e2e/assets/test_pipe_redirect.sh
@@ -1,6 +1,12 @@
-#!/bin/bash
+#!/usr/bin/env bash
 
 set -e -x
 
 # test pipe redirect (on Linux, pipe is symlinked)
-diff <(../../ytt -f pipe.yml=<(cat ../../examples/k8s-relative-rolling-update/config.yml)) ../../examples/k8s-relative-rolling-update/expected.txt
\ No newline at end of file
+# OHOS: /tmp is read-only, so the outer process substitution for diff fails.
+# Keep the inner <(...) (the feature under test: ytt reading a /dev/fd pipe)
+# and only redirect the outer comparison through a TMPDIR-backed temp file.
+tmp="${TMPDIR:-${TMP:-/tmp}}"
+actual="$tmp/ytt-pipe-redirect-$$.txt"
+../../ytt -f pipe.yml=<(cat ../../examples/k8s-relative-rolling-update/config.yml) > "$actual"
+diff "$actual" ../../examples/k8s-relative-rolling-update/expected.txt
diff --git a/test/e2e/assets/test_pipe_stdin.sh b/test/e2e/assets/test_pipe_stdin.sh
