--- a/test/e2e/assets/test_pipe_stdin.sh
+++ b/test/e2e/assets/test_pipe_stdin.sh
@@ -1,5 +1,11 @@
-#!/bin/bash
+#!/usr/bin/env bash
 
 set -e -x
 
-diff <(cat ../../examples/k8s-relative-rolling-update/config.yml | ../../ytt -f-) ../../examples/k8s-relative-rolling-update/expected.txt
\ No newline at end of file
+# OHOS: /tmp is read-only, so bash process substitution for the outer diff
+# fails (can't create temporary file /tmp/sh*.tmp). Use a TMPDIR-backed
+# temp file for the comparison only; the piped-stdin intent is unchanged.
+tmp="${TMPDIR:-${TMP:-/tmp}}"
+actual="$tmp/ytt-pipe-stdin-$$.txt"
+cat ../../examples/k8s-relative-rolling-update/config.yml | ../../ytt -f- > "$actual"
+diff "$actual" ../../examples/k8s-relative-rolling-update/expected.txt
