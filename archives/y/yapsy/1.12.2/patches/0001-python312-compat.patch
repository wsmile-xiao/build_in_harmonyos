+"""Strict dotted versions used by Yapsy's versioned plugin manager.
+
+This keeps the small subset of ``distutils.version.StrictVersion`` that Yapsy
+uses, without depending on distutils (removed from Python 3.12) or an optional
+third-party package.
+"""
+
+import re
+
+
+_VERSION_RE = re.compile(r"^([0-9]+)\.([0-9]+)(?:\.([0-9]+))?([ab])?([0-9]+)?$")
+
+
+class StrictVersion(object):
+    """Parse and compare ``major.minor[.patch][aN|bN]`` versions."""
+
+    def __init__(self, vstring):
+        match = _VERSION_RE.match(vstring)
+        if match is None or (match.group(4) is None) != (match.group(5) is None):
+            raise ValueError("invalid version number '%s'" % vstring)
+        self.vstring = vstring
+        self.version = tuple(int(part or 0) for part in match.group(1, 2, 3))
+        self.prerelease = ((match.group(4), int(match.group(5)))
+                           if match.group(4) is not None else None)
+
+    def __str__(self):
+        return self.vstring
+
+    def __repr__(self):
+        return "StrictVersion ('%s')" % self
+
+    def _compare(self, other):
+        if not isinstance(other, StrictVersion):
+            other = StrictVersion(other)
+        if self.version != other.version:
+            return (self.version > other.version) - (self.version < other.version)
+        if self.prerelease is None:
+            return 0 if other.prerelease is None else 1
+        if other.prerelease is None:
+            return -1
+        return (self.prerelease > other.prerelease) - (self.prerelease < other.prerelease)
+
+    def __eq__(self, other):
+        result = self._compare(other)
+        return NotImplemented if result is NotImplemented else result == 0
+
+    def __lt__(self, other):
+        result = self._compare(other)
+        return NotImplemented if result is NotImplemented else result < 0
+
+    def __le__(self, other):
+        result = self._compare(other)
+        return NotImplemented if result is NotImplemented else result <= 0
+
+    def __gt__(self, other):
+        result = self._compare(other)
+        return NotImplemented if result is NotImplemented else result > 0
+
+    def __ge__(self, other):
+        result = self._compare(other)
+        return NotImplemented if result is NotImplemented else result >= 0
+
+    def __cmp__(self, other):
+        return self._compare(other)
