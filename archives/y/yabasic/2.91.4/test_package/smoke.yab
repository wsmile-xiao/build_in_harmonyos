rem consumer smoke test for yabasic on OHOS:
rem exercises arithmetic, strings, arrays, subroutines and control flow;
rem any broken expectation aborts through error (non-zero exit),
rem same assertion style as the upstream tests/*.yab suite.

a = 21
if a * 2 <> 42 error "math1"
if 2 ^ 10 <> 1024 error "math2"
if min(3, -7) <> -7 error "math3"
if len("hello") <> 5 error "str1"
if upper$("ohos") <> "OHOS" error "str2"
if mid$("yabasic", 1, 2) <> "ya" error "str3"
if instr("hello world", "world") <> 7 error "str4"

dim m(3)
for i = 1 to 3
  m(i) = i * i
next i
if m(3) <> 9 error "arr1"

dim list$(2)
list$(0) = "x"
list$(1) = "y"
list$(2) = "z"
if list$(1) + list$(2) <> "yz" error "arr2"

total = 0
for i = 10 to 1 step -2
  total = total + i
next i
if total <> 30 error "flow1"

c = 0
repeat
  c = c + 1
until c >= 4
if c <> 4 error "flow2"

print "smoke ok"
exit 0
