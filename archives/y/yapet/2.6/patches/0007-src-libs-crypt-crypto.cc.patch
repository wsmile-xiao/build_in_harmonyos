--- a/src/libs/crypt/crypto.cc
+++ b/src/libs/crypt/crypto.cc
@@ -91,28 +91,38 @@
 EVP_CIPHER_CTX* Crypto::initializeOrThrow(MODE mode) {
     EVP_CIPHER_CTX* context = createContext();
 
     auto success = EVP_CipherInit_ex(context, getCipher(), nullptr,
                                      *_key->key(), *_key->ivec(), mode);
     if (success != SSL_SUCCESS) {
         destroyContext(context);
         throw CipherError{_("Error initializing cipher")};
     }
 
-    success = EVP_CIPHER_CTX_set_key_length(context, _key->keySize());
-    if (success != SSL_SUCCESS) {
-        destroyContext(context);
-        char msg[YAPET::Consts::EXCEPTION_MESSAGE_BUFFER_SIZE];
-        std::snprintf(msg, YAPET::Consts::EXCEPTION_MESSAGE_BUFFER_SIZE,
-                      _("Cannot set key length on context to %d"),
-                      _key->keySize());
-        throw CipherError{msg};
+    // The key schedule is derived from EVP_CIPHER_CTX_key_length() at init
+    // time.  EVP_CipherInit_ex() above therefore built it for the cipher's
+    // default length, and this package must keep byte-for-byte compatibility
+    // with files written by OpenSSL 1.1.x builds (tests/crypt/foreign.cc
+    // decodes fixtures generated on the author's machine).  On OpenSSL 3's
+    // legacy provider, changing the key length AFTER the key was supplied
+    // invalidates that schedule and EVP_CipherUpdate() fails outright, so the
+    // call may only remain when it is a no-op (length unchanged).
+    if (_key->keySize() == EVP_CIPHER_CTX_key_length(context)) {
+        success = EVP_CIPHER_CTX_set_key_length(context, _key->keySize());
+        if (success != SSL_SUCCESS) {
+            destroyContext(context);
+            char msg[YAPET::Consts::EXCEPTION_MESSAGE_BUFFER_SIZE];
+            std::snprintf(msg, YAPET::Consts::EXCEPTION_MESSAGE_BUFFER_SIZE,
+                          _("Cannot set key length on context to %d"),
+                          _key->keySize());
+            throw CipherError{msg};
+        }
     }
 
     return context;
 }
 
 int Crypto::cipherBlockSize() const {
     return EVP_CIPHER_block_size(getCipher());
 }
 
 int Crypto::cipherIvecSize() const { return EVP_CIPHER_iv_length(getCipher()); }
