--- a/YUViewLib/YUViewLib.pro
+++ b/YUViewLib/YUViewLib.pro
@@ -1,11 +1,18 @@
-QT += core gui widgets opengl xml concurrent network
+QT += core gui widgets xml concurrent network
+
+# Qt configurations built without the OpenGL module (headless or embedded
+# platform builds) cannot resolve it, so link it only when the configured Qt
+# provides the module. On Qt builds that ship OpenGL this is a no-op.
+qtHaveModule(opengl) {
+    QT += opengl
+}
 
 TEMPLATE = lib
 CONFIG += staticlib
 CONFIG += c++1z
 CONFIG -= debug_and_release
 CONFIG += object_parallel_to_source
 
 SOURCES += $$files(src/*.cpp, true)
 HEADERS += $$files(src/*.h, true)
 
@@ -23,20 +30,27 @@
 
 SVNN = $$system("git describe --tags")
 LASTHASH = $$system("git rev-parse HEAD")
 isEmpty(LASTHASH) {
     LASTHASH = 0
 }
 isEmpty(SVNN) {
     SVNN = 0
 }
 
+# Release archives are not git checkouts, so `git describe` cannot report a
+# version there. Let the build system hand in the version instead; when it does
+# not, the value derived above is kept unchanged.
+!isEmpty(VERSION) {
+    SVNN = $$VERSION
+}
+
 win32 {
     DEFINES += NOMINMAX
 }
 
 win32-msvc* {
     HASHSTRING = '\\"$${LASTHASH}\\"'
     DEFINES += YUVIEW_HASH=$${HASHSTRING}
 }
 win32-g++ | linux | macx {
     HASHSTRING = '\\"$${LASTHASH}\\"'
