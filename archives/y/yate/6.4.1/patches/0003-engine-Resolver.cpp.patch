 // Initialize the resolver in the current thread
 bool Resolver::init(int timeout, int retries)
 {
     if (!available())
 	return false;
 #ifdef _WINDOWS
     return true;
 #elif defined(__RES)
+#if defined(YATE_RES_NO_GLOBAL_STATE)
+    // no glibc-style resolver global state (_res) on this toolchain
+    // (per-thread resolver): nothing to initialize or tweak
+    (void) timeout;
+    (void) retries;
+    return true;
+#else
     if ((_res.options & RES_INIT) == 0) {
 	// need to initialize in current thread
 	if (res_init())
 	    return false;
     }
     // always set variables
     if (timeout >= 0)
 	_res.retrans = timeout;
     if (retries >= 0)
 	_res.retry = retries;
     return true;
+#endif
 #endif
     return false;
 }
 
