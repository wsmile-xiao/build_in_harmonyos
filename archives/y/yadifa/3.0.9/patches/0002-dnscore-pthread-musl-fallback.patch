--- a/lib/dnscore/CMakeLists.txt
+++ b/lib/dnscore/CMakeLists.txt
@@ -586,7 +586,13 @@
     PATH_SUFFIXES
         lib
 )
 
+if(NOT PTHREAD_LIB)
+    # musl/OHOS: no standalone libpthread outside the sysroot; "pthread"
+    # resolves there at link time (libc contains the pthread symbols).
+    set(PTHREAD_LIB "pthread")
+endif()
+
 if(NOT PTHREAD_LIB EQUAL "PTHREAD_LIB-NOTFOUND")
     kvstatus("pthread" "${PTHREAD_LIB}")
     set(DNSCORE_LIBRARIES_DEPS ${DNSCORE_LIBRARIES_DEPS} "${PTHREAD_LIB}")
