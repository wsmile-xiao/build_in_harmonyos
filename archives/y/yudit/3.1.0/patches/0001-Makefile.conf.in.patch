--- a/Makefile.conf.in
+++ b/Makefile.conf.in
@@ -20,22 +20,23 @@
 CXX = @CXX@
 CXXFLAGS = @CXXFLAGS@
 CFLAGS = @CFLAGS@
 LDFLAGS = @LDFLAGS@
 LIBS = @LIBS@
 TRANSLATE_LFLAGS = @GETTEXT_LFLAGS@
 CPPFLAGS = -I$(TOPDIR) @CPPFLAGS@ -Wall -DHAVE_MMAP $(CFLAGS)
