 AC_HEADER_STDC([])
 
+dnl Thread-cancellation availability probe: the OHOS libc neither declares
+dnl nor defines pthread_cancel/pthread_setcancelstate/pthread_setcanceltype
+dnl (measured: "call to undeclared function" + "undefined symbol"), so the
+dnl sources must be compiled without those calls (see src/thread-util.h and
+dnl src/thread-util.c). Keep -lpthread in LIBS for the probe itself.
+save_LIBS="$LIBS"; LIBS="$LIBS -lpthread"
+AC_CHECK_FUNCS([pthread_cancel pthread_setcancelstate pthread_setcanceltype])
+LIBS="$save_LIBS"
+
 AC_SUBST(CFLAGS)
 AC_SUBST(CPPFLAGS)
 AC_SUBST(LDFLAGS)
