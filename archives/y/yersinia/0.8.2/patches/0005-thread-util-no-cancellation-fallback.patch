diff --git a/src/thread-util.c b/src/thread-util.c
index 7fd177f..5f5b3a3 100644
--- a/src/thread-util.c
+++ b/src/thread-util.c
@@ -107,6 +107,7 @@ thread_destroy_cancel(pthread_t thread_id)
 {
    pthread_t id = thread_id;
    
+#ifdef HAVE_PTHREAD_CANCEL
    if (pthread_cancel(id) != 0) {
       thread_error(" thread_destroy_cancel pthread_cancel",errno);
       return -1;
@@ -116,6 +117,16 @@ thread_destroy_cancel(pthread_t thread_id)
       thread_error(" thread_destroy_cancel pthread_join",errno);
       return -1;
    }
+#else
+   /* No cancellation support: the only caller (yersinia.c shutdown path) uses
+      this on the periodic uptime thread, which has no cleanup handler to run,
+      so detaching it is the equivalent outcome at process teardown. */
+   if (pthread_detach(id) != 0) {
+      thread_error(" thread_destroy_cancel pthread_detach",errno);
+      return -1;
+   }
+   return 0;
+#endif
 
    return 0;
 }
diff --git a/src/thread-util.h b/src/thread-util.h
index 4d44e84..b5a6b95 100644
--- a/src/thread-util.h
+++ b/src/thread-util.h
@@ -29,6 +29,24 @@
 #include <pthread.h>
 #endif
 
+/*
+ * The OHOS libc has no thread-cancellation API (configure.in probes it with
+ * AC_CHECK_FUNCS; measured: pthread_cancel is neither declared nor defined).
+ * The uptime helper thread only toggles cancellation around its own loop, so
+ * keep those call sites source-compatible as no-ops; the actual cancellation
+ * in thread_destroy_cancel() falls back to pthread_detach().
+ */
+#ifdef HAVE_PTHREAD_H
+#ifndef HAVE_PTHREAD_SETCANCELSTATE
+static inline int pthread_setcancelstate(int state, int *oldstate)
+{ (void)state; (void)oldstate; return 0; }
+#endif
+#ifndef HAVE_PTHREAD_SETCANCELTYPE
+static inline int pthread_setcanceltype(int type, int *oldtype)
+{ (void)type; (void)oldtype; return 0; }
+#endif
+#endif
+
 #define THREAD_TIMEOUT -2
 
 struct condsem {
