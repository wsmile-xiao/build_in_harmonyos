+#include <string.h>
 #include <stdlib.h>
+
+/* GNU strdupa() (alloca-based stack copy) is a glibc extension that
+   musl libc, as used by HarmonyOS, does not provide.  Define the
+   equivalent so the copy keeps upstream's stack lifetime. */
+#ifndef strdupa
+# define strdupa(s)								\
+  (__extension__								\
+   ({										\
+     const char *__old = (s);							\
+     size_t __len = strlen (__old) + 1;						\
+     char *__new = (char *) __builtin_alloca (__len);				\
+     (char *) memcpy (__new, __old, __len);					\
+   }))
+#endif
