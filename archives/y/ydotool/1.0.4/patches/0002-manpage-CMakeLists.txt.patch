--- a/manpage/CMakeLists.txt
+++ b/manpage/CMakeLists.txt
@@ -1,9 +1,17 @@
+# scdoc is optional: only build and install the man pages when it is
+# available, so the rest of the project still builds on systems without it.
+find_program(SCDOC_EXECUTABLE scdoc)
+
 function(man_page section page)
+  if (NOT SCDOC_EXECUTABLE)
+    message(STATUS "scdoc not found, skipping man page ${page}.${section}")
+    return()
+  endif()
   set(src "${CMAKE_CURRENT_SOURCE_DIR}/${page}.${section}.scd")
   set(bin "${CMAKE_CURRENT_BINARY_DIR}/${page}.${section}")
-  add_custom_target(${page}.${section} ALL COMMAND scdoc < ${src} > ${bin})
+  add_custom_target(${page}.${section} ALL COMMAND ${SCDOC_EXECUTABLE} < ${src} > ${bin})
   install(FILES ${bin} DESTINATION ${CMAKE_INSTALL_MANDIR}/man${section}/)
 endfunction(man_page)
 
 man_page(1 ydotool)
 man_page(8 ydotoold)
