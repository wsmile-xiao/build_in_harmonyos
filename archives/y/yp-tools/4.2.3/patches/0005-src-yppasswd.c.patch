--- a/src/yppasswd.c
+++ b/src/yppasswd.c
@@ -41,20 +41,82 @@
 #include <sys/stat.h>
 #include <sys/types.h>
 #include <fcntl.h>
 #include <rpcsvc/yp_prot.h>
 #include <rpcsvc/ypclnt.h>
 #include <rpcsvc/yppasswd.h>
 
 #ifndef _
 #define _(String) gettext (String)
 #endif
+
+/* Some libcs (musl based, e.g. OHOS) neither declare getpass() in <unistd.h>
+   nor export it from their shared libc.  configure probes for it; provide a
+   replacement reading from the controlling terminal with echo disabled. */
+#ifndef HAVE_GETPASS
+#include <termios.h>
+
+char *
+getpass (const char *prompt)
+{
+  static char buf[128];
+  struct termios tio, tio_orig;
+  FILE *tty;
+  char *line = NULL;
+  size_t cap = 0;
+  ssize_t nread;
+  int fd, echo_off = 0;
+  size_t len;
+
+  tty = fopen ("/dev/tty", "r+");
+  if (tty == NULL)
+    tty = stdin;
+  if (tty == NULL)
+    return NULL;
+
+  fputs (prompt, tty);
+  fflush (tty);
+
+  fd = fileno (tty);
+  if (tcgetattr (fd, &tio_orig) == 0)
+    {
+      tio = tio_orig;
+      tio.c_lflag &= ~ECHO;
+      echo_off = (tcsetattr (fd, TCSAFLUSH, &tio) == 0);
+    }
+
+  nread = getline (&line, &cap, tty);
+  if (nread > 0)
+    {
+      if ((size_t) nread > sizeof (buf) - 1)
+        nread = (ssize_t) (sizeof (buf) - 1);
+      memcpy (buf, line, (size_t) nread);
+      buf[nread] = '\0';
+    }
+  else
+    buf[0] = '\0';
+  free (line);
+
+  if (echo_off)
+    tcsetattr (fd, TCSAFLUSH, &tio_orig);
+
+  fputc ('\n', tty);
+  if (tty != stdin)
+    fclose (tty);
+
+  len = strlen (buf);
+  if (len > 0 && buf[len - 1] == '\n')
+    buf[len - 1] = '\0';
+
+  return buf;
+}
+#endif /* !HAVE_GETPASS */
 
