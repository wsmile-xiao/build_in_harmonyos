Add --version / --help to yaku-ns and yaku-getzone.

Neither upstream binary answers --version: the option parser is plain
getopt() over a short-only option string, and -h prints the usage and
exits 1.  Switch both to getopt_long() with two long-only options added.
Every existing short option keeps its exact behaviour.

The reported version is YAKUNS_PKG_VERSION when the build system defines
it, otherwise the in-tree ENS_VERSION.  Upstream never bumped
ENS_VERSION for the 0.2 release (tunable.h still reads 0.1.6), so the
recipe injects the real release number through an include path; a plain
upstream build still prints ENS_VERSION.

--- a/core.c
+++ b/core.c
@@ -12,6 +12,8 @@
 #include "ens.h"
 #include "aht.h"
 
+#include <getopt.h>
+
 #include <sys/types.h>
 #include <netinet/in.h>
 #include <arpa/inet.h>
@@ -79,13 +81,57 @@
 void *tl_ptr;
 #endif
 
+/* --version / --help support.
+ *
+ * Upstream only offers short options: -h prints the usage and exits 1, and
+ * there is no way at all to print the program version.  The packaging smoke
+ * test and the usual CLI convention both expect --version and --help to
+ * succeed, so they are added here.
+ *
+ * The version string comes from YAKUNS_PKG_VERSION when the build system
+ * defines it (the Conan recipe passes the release number); otherwise the
+ * in-tree ENS_VERSION is used.  ENS_VERSION is stale upstream -- it still
+ * reads 0.1.6 in the 0.2 release -- which is why the release number is
+ * injected rather than reported from tunable.h. */
+#if defined(__has_include)
+#  if __has_include("yaku-version.h")
+#    include "yaku-version.h"
+#  endif
+#endif
+#ifndef YAKUNS_PKG_VERSION
+#define YAKUNS_PKG_VERSION ENS_VERSION
+#endif
+
+enum {
+	OPT_VERSION = 256,
+	OPT_HELP
+};
+
+static struct option const long_options[] = {
+	{"version", no_argument, NULL, OPT_VERSION},
+	{"help",    no_argument, NULL, OPT_HELP},
+	{NULL,      0,           NULL, 0}
+};
+
+static void print_usage(void)
+{
+	printf(
+"usage: yaku-ns [-p <port>] [-P <port>] [-f <port>] [-C <max>] [-F <max>]\n"
+"               [-T <forward_timeout>] [-c <config_file>]\n"
+"               [-l <logfile>] [-r <chroot jail>] [-u owner]\n"
+"               [-b <addr>] [-xdhV]\n"
+	);
+}
+
 int main(int argc, char **argv)
 {
 	int c;
+	int option_index = 0;
 
 	/* default is to logs to standard output */
 	logfp = stdout;
-	while ((c = getopt(argc, argv, "p:P:f:C:F:T:c:u:l:r:b:xdhV")) != EOF) {
+	while ((c = getopt_long(argc, argv, "p:P:f:C:F:T:c:u:l:r:b:xdhV", long_options,
+						 &option_index)) != EOF) {
 		switch(c) {
 		case 'p':
 			opt_udp_port = atoi(optarg);
@@ -136,14 +182,17 @@
 		case 'V':
 			opt_verbose++;
 			break;
+		case OPT_VERSION:
+			printf("yaku-ns %s\n", YAKUNS_PKG_VERSION);
+			exit(0);
+		case OPT_HELP:
+			print_usage();
+			exit(0);
 		case 'h':
+			print_usage();
+			exit(0);
 		default:
-			printf(
-"usage: yaku-ns [-p <port>] [-P <port>] [-f <port>] [-C <max>] [-F <max>]\n"
-"               [-T <forward_timeout>] [-c <config_file>]\n"
-"               [-l <logfile>] [-r <chroot jail>] [-u owner]\n"
-"               [-b <addr>] [-xdhV]\n"
-			);
+			print_usage();
 			exit(1);
 		}
 	}
