nameser.h: include <sys/cdefs.h> and <sys/types.h> explicitly.

This is a standalone copy of the 1993 BSD arpa/nameser.h.  It uses
__BEGIN_DECLS/__END_DECLS/__P() and the u_char/u_int16_t typedefs but
never includes the headers that provide them.  glibc happens to drag in
<sys/cdefs.h> via <features.h>; musl (the OHOS libc) does not, so the
build fails with "unknown type name '__BEGIN_DECLS'" and
"expected ';' after top level declarator" on every translation unit.
Declaring the dependency explicitly makes the header self-contained and
is correct on both libcs; no upstream logic changes.

--- a/nameser.h
+++ b/nameser.h
@@ -248,6 +248,15 @@
 #define CONV_BADBUFLEN	(-4)
 
 /* Include endianess info in mostly portable way */
+/* Pull in the BSD compiler-visibility and legacy typedef helpers this
+ * header relies on (__BEGIN_DECLS/__END_DECLS/__P and the u_char /
+ * u_int16_t typedefs).  glibc exposes them from <sys/cdefs.h> and
+ * musl does too, but neither is included transitively in a way this
+ * standalone header may rely on: glibc only reaches <sys/cdefs.h>
+ * through <features.h>, and musl does not do that at all.  Without
+ * the explicit includes this header does not compile on either libc. */
+#include <sys/cdefs.h>
+#include <sys/types.h>
 #include "yakuendian.h"
 
 __BEGIN_DECLS
