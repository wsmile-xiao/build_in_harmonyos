+dnl
+dnl PKG_CHECK_MODULES(MODULE, PACKAGE, [ACTION-IF-FOUND], [ACTION-IF-NOT-FOUND])
+dnl Check for PACKAGE using pkg-config
+AC_DEFUN([PKG_CHECK_MODULES],
+[
+  AC_REQUIRE([PKG_CONFIG])
+  
+  AC_MSG_CHECKING([for $2])
+  
+  if $PKG_CONFIG --exists "$2"; then
+    AC_MSG_RESULT([yes])
+    $1_CFLAGS=`$PKG_CONFIG --cflags "$2"`
+    $1_LIBS=`$PKG_CONFIG --libs "$2"`
+    AC_SUBST([$1_CFLAGS])
+    AC_SUBST([$1_LIBS])
+    ifelse([$3], , :, [$3])
+  else
+    AC_MSG_RESULT([no])
+    ifelse([$4], , AC_MSG_ERROR([Package requirements ($2) were not met.]), [$4])
+  fi
+])
+
+dnl PKG_CONFIG
+dnl Check for pkg-config program
+AC_DEFUN([PKG_CONFIG],
+[
+  AC_PATH_PROG([PKG_CONFIG], [pkg-config], [no])
+])
