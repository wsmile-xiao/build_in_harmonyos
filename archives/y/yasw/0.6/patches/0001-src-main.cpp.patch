 #include <QApplication>
+#include <cstdio>
+#include <cstring>
 #include "mainwindow.h"
+
+#ifndef YASW_VERSION
+#define YASW_VERSION "0.6"
+#endif
 
 int main(int argc, char *argv[])
 {
+    /* Answer --version / --help before QApplication is constructed, so the
+       query works on systems where no Qt platform plugin is available
+       (headless builds, packaging scripts and smoke tests). */
+    for (int i = 1; i < argc; ++i) {
+        if (std::strcmp(argv[i], "--version") == 0) {
+            std::printf("YASW %s\n", YASW_VERSION);
+            return 0;
+        }
+        if (std::strcmp(argv[i], "--help") == 0) {
+            std::printf("YASW %s - Yet Another Scan Wizard\n\n", YASW_VERSION);
+            std::printf("Usage: %s [options]\n\n", argv[0]);
+            std::printf("Options:\n");
+            std::printf("  --version    print version information and exit\n");
+            std::printf("  --help       print this help message and exit\n");
+            return 0;
+        }
+    }
+
     QApplication a(argc, argv);
     MainWindow w;
     w.show();
     return a.exec();
 }
