 /** @} */
+
+/*
+ * OHOS (musl libc) compatibility shim.
+ * musl does not provide pthread_cancel(); requesters only use it to
+ * tear down helper threads asynchronously. Returning 0 lets the caller
+ * proceed with its normal join-based cleanup path.
+ * Guarded by libc probe (musl has no __GLIBC__) so glibc/Android keep
+ * the platform implementation.
+ */
+#if defined(__linux__) && !defined(__GLIBC__) && !defined(__ANDROID__)
+#include <pthread.h>
+int pthread_cancel(pthread_t thread);
+int pthread_cancel(pthread_t thread)
+{
+    (void)thread;
+    return 0;
+}
+#endif
