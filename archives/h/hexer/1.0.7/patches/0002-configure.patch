diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,18 @@
+#!/bin/bash
+# Simple configure wrapper for hexer makefile-only project
+# Parses --prefix and stores it for the Makefile
+for arg in "$@"; do
+  case "$arg" in
+    --prefix=*)
+      PREFIX="${arg#--prefix=}"
+      ;;
+  esac
+done
+
+# Write a config.mk that the Makefile can include if desired
+# For hexer, PREFIX is handled by Makefile's ?= operator
+echo "# Auto-generated by configure wrapper" > config.mk
+echo "PREFIX ?= ${PREFIX:-/usr/local}" >> config.mk
+
+echo "hexer configured. PREFIX=${PREFIX:-/usr/local}"
+exit 0
