diff -ruN a/config.guess b/config.guess
--- a/config.guess
+++ b/config.guess
@@ -969,6 +969,14 @@
     *:Minix:*:*)
 	GUESS=$UNAME_MACHINE-unknown-minix
 	;;
+    aarch64:HarmonyOS:*:* | aarch64:OHOS:*:*)
+	# CI worker uname 报 OHOS/HarmonyOS(本机报 Linux)。此时 LIBC 为空
+	# (LIBC 检测只在 UNAME_SYSTEM=Linux|GNU 分支设置), 用 $LIBC 会输出
+	# aarch64-unknown-linux- 尾随空 libc(fake uname 实测), config.sub
+	# 报 OS 空。硬编码 gnu——鸿蒙是 Linux 内核, linux-gnu config.sub
+	# 原生识别。
+	GUESS=$UNAME_MACHINE-unknown-linux-gnu
+	;;
     aarch64:Linux:*:*)
 	GUESS=$UNAME_MACHINE-unknown-linux-$LIBC
 	;;
