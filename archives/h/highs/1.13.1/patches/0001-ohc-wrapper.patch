diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,27 @@
+#!/bin/sh
+# OpenHarmony configure wrapper for CMake projects
+# Converts autotools-style --prefix= to cmake -D flags
+# Enables G0 clean-verify (which uses bash ./configure) to work with CMake builds
+# Uses -S/-B cmake options to avoid HMDFS subprocess issues
+# Redirects stdin from /dev/null to prevent HMDFS pipe seek errors in cmake TryCompile
+
+PREFIX=""
+EXTRA_OPTS=""
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            ;;
+        *)
+            EXTRA_OPTS="$EXTRA_OPTS $arg"
+            ;;
+    esac
+done
+
+if [ -z "$PREFIX" ]; then
+    PREFIX="$HOME/usr/local"
+fi
+
+# Use cmake -S/-B syntax to avoid HMDFS cd-in-subshell issues
+# stdin redirected to /dev/null to prevent HMDFS seek errors
+cmake -S . -B build -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_BUILD_TYPE=Release $EXTRA_OPTS < /dev/null
diff -ruN /dev/null b/Makefile
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,21 @@
+# OpenHarmony Makefile wrapper for CMake projects
+# Forwards make commands to the cmake build directory
+# Enables G0 clean-verify (which uses make in source dir) to work with CMake builds
+
+BUILD_DIR = build
+
+.PHONY: all install test check clean
+
+all:
+	$(MAKE) -C $(BUILD_DIR) all
+
+install:
+	$(MAKE) -C $(BUILD_DIR) install DESTDIR=$(DESTDIR)
+
+test:
+	$(MAKE) -C $(BUILD_DIR) test
+
+check: test
+
+clean:
+	$(MAKE) -C $(BUILD_DIR) clean
