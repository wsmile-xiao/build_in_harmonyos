 hellwal: hellwal.c
 	$(CC) $(CFLAGS) hellwal.c -o hellwal $(LDFLAGS) -DVERSION=\"$(VERSION)\"
 
 debug: hellwal.c
 	$(CC) $(CFLAGS) -ggdb hellwal.c -o hellwal $(LDFLAGS) -DVERSION=\"$(VERSION)\"
 
 clean:
-	rm hellwal
+	rm -f hellwal
 
 install: hellwal
-	mkdir -p $(DESTDIR)
