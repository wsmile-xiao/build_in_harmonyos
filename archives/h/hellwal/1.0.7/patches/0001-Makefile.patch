+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	cp -f hellwal $(DESTDIR)$(PREFIX)/bin
+	chmod 755 $(DESTDIR)$(PREFIX)/bin/hellwal
 
 uninstall:
-	rm -f $(DESTDIR)/hellwal
+	rm -f $(DESTDIR)$(PREFIX)/bin/hellwal
 
 release: hellwal
 	tar czf hellwal-v$(VERSION).tar.gz hellwal
 
-.PHONY: hellwal debug release clean install uninstall
+.PHONY: hellwal debug release clean install uninstall