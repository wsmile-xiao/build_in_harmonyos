diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,28 +1,28 @@
 VERSION := $(shell cat VERSION)
 
-CFLAGS = -Wall -Wextra -O3
-LDFLAGS = -lm
-
-DESTDIR = /usr/local/bin
+PREFIX ?= /usr/local
+EXTRA_CFLAGS = -Wall -Wextra -O3
+CFLAGS += $(EXTRA_CFLAGS) -fPIC
