diff -ruN a/suid.c b/suid.c
--- a/suid.c
+++ b/suid.c
@@ -60,40 +60,48 @@
 
   suid_disable();
 }
 
 /*
  * NAME:	suid->enable()
  * DESCRIPTION:	engage any setuid privileges
  */
 void suid_enable(void)
 {
-# ifdef HAVE_SETREUID
+# ifdef __OHOS__
+  /* OpenHarmony: setreuid is unimplemented syscall (E051) */
+  setuid(euid);
+  setgid(egid);
+# elif defined(HAVE_SETREUID)
 
   setreuid(-1, euid);
   setregid(-1, egid);
 
 # else
 
   setuid(euid);
   setgid(egid);
 
 # endif
 }
 
 /*
  * NAME:	suid->disable()
  * DESCRIPTION:	revoke all setuid privileges
  */
 void suid_disable(void)
 {
-# ifdef HAVE_SETREUID
+# ifdef __OHOS__
+  /* OpenHarmony: setreuid is unimplemented syscall (E051) */
+  setuid(uid);
+  setgid(gid);
+# elif defined(HAVE_SETREUID)
 
   setreuid(-1, uid);
   setregid(-1, gid);
 
 # else
 
   setuid(uid);
   setgid(gid);
 
 # endif
