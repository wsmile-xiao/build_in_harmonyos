--- a/host/libhackrf/src/CMakeLists.txt
+++ b/host/libhackrf/src/CMakeLists.txt
@@ -43,34 +43,34 @@
 
 # Dependencies
 target_link_libraries(hackrf ${LIBUSB_LIBRARIES} ${CMAKE_THREAD_LIBS_INIT})
    
 # For cygwin just force UNIX OFF and WIN32 ON
 if( ${CYGWIN} )
   SET(UNIX OFF)
   SET(WIN32 ON)
 endif( ${CYGWIN} )
 
-if( ${UNIX} )
+if(UNIX OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
    install(TARGETS hackrf
            LIBRARY DESTINATION lib${LIB_SUFFIX}
            COMPONENT sharedlibs
            )
    install(TARGETS hackrf-static
            ARCHIVE DESTINATION lib${LIB_SUFFIX}
            COMPONENT staticlibs
            )
    install(FILES ${c_headers}
            DESTINATION include/${PROJECT_NAME}
            COMPONENT headers
            )
-endif( ${UNIX} )
+endif()
 
 if( ${WIN32} )
    install(TARGETS hackrf
            DESTINATION bin
            COMPONENT sharedlibs
            )
    install(TARGETS hackrf-static
            DESTINATION bin
            COMPONENT staticlibs
            )
