--- /dev/null
+++ b/contrib/libass/A01-config-guess-ohos.patch
@@ -0,0 +1,22 @@
+--- a/config.guess
++++ b/config.guess
+@@ -197,6 +197,19 @@
+ # Note: order is significant - the case branches are not exclusive.
+ 
+ case $UNAME_MACHINE:$UNAME_SYSTEM:$UNAME_RELEASE:$UNAME_VERSION in
++
++        *:HarmonyOS:*:*)
++    	# HarmonyOS (OpenHarmony) - HarmonyOS PC arm64
++    	case $UNAME_MACHINE in
++    	    aarch64|arm64) machine=aarch64-unknown ;;
++    	    armv7*|armv8*) machine=arm-unknown ;;
++    	    x86_64|amd64)  machine=x86_64-unknown ;;
++    	    i?86)          machine=i686-unknown ;;
++    	    *)             machine=$UNAME_MACHINE-unknown ;;
++    	esac
++    	GUESS=$machine-linux-ohos
++    	;;
++    
+     *:NetBSD:*:*)
+ 	# NetBSD (nbsd) targets should (where applicable) match one or
+ 	# more of the tuples: *-*-netbsdelf*, *-*-netbsdaout*,
