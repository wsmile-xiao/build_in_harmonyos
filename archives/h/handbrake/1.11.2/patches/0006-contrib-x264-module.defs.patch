--- a/contrib/x264/module.defs
+++ b/contrib/x264/module.defs
@@ -30,5 +30,24 @@
 endif
 
 ifeq (1,$(FEATURE.flatpak))
     X264.CONFIGURE.extra += --enable-pic
 endif
+
+# HarmonyOS clang defaults to PIE; x264 asm must be PIC or the CLI link fails
+# with R_AARCH64_ABS64 against local symbols. HandBrake reports HOST.system=linux
+# for OHOS, so enable PIC on linux hosts too.
+ifeq (linux,$(HOST.system))
+    X264.CONFIGURE.extra += --enable-pic
+endif
+
+# HarmonyOS worker has no /bin/bash, while x264 configure uses that shebang.
+# Run it through POSIX sh and use a Linux aarch64 tuple: x264's config.sub
+# rejects the OHOS tuple but maps this to the same SYS=LINUX/AARCH64 path.
+ifneq (,$(filter $(HOST.systemf),HarmonyOS))
+    X264.CONFIGURE.exe = /bin/sh ./configure
+    X264.CONFIGURE.host = aarch64-unknown-linux-gnu
+    X264.CONFIGURE.prefix = $(patsubst %/,%,$(call fn.ABSOLUTE,$(CONTRIB.build/)))
+    X264.CONFIGURE.extra += --disable-asm
+    X264.BUILD.extra += SHELL=/bin/sh
+    X264.INSTALL.extra += SHELL=/bin/sh
+endif
