--- a/contrib/ffmpeg/module.defs
+++ b/contrib/ffmpeg/module.defs
@@ -86,10 +86,20 @@
 ifeq (size-aggressive,$(GCC.O))
 FFMPEG.CONFIGURE.extra += \
     --enable-small
 endif
 
+# HarmonyOS: uname -s returns "HarmonyOS" -> ffmpeg target_os=harmonyos (unknown).
+# Only on OHOS force ffmpeg to linux target (HOST.systemf=HarmonyOS, same
+# filter as make/include/main.defs); real Linux builds are left untouched.
+# OHOS sysroot vulkan.h lacks vulkan_beta.h, so disable vulkan.
+ifneq (,$(filter $(HOST.system) $(HOST.systemf),HarmonyOS))
+FFMPEG.CONFIGURE.extra += \
+    --target-os=linux \
+    --disable-vulkan
+endif
+
 ifeq (on,$(GCC.lto))
     FFMPEG.CONFIGURE.extra += --enable-lto
 else ifeq (thin,$(GCC.lto))
     FFMPEG.CONFIGURE.extra += --enable-lto=thin
 endif
