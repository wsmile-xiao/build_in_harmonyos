--- a/test/module.defs
+++ b/test/module.defs
@@ -13,5 +13,16 @@
 TEST.exe = $(BUILD/)$(call TARGET.exe,$(HB.name)CLI)

 TEST.GCC.L = $(CONTRIB.build/)lib

+ifneq (,$(filter $(HOST.system) $(HOST.systemf),HarmonyOS))
+    # The OHOS worker profile injects $HOME/usr/local/lib through LDFLAGS.
+    # Keep the final CLI link self-contained by making the in-tree contrib
+    # library directory the first -L entry, before any worker-local libraries.
+    # TEST.GCC.EXE++ consumes ?extra.exe++; use := to prepend before the
+    # inherited $(LDFLAGS) value.
+    TEST.GCC.args.extra.exe++ := \
+        -L$(call fn.ABSOLUTE,$(CONTRIB.build/))lib \
+        $(TEST.GCC.args.extra.exe++)
+endif
+
 TEST.libs = $(LIBHB.a)
