From 88d20a173db4bdb67fd52896ab07ef372717264a Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sat, 19 Sep 2026 01:02:28 +0800
Subject: [PATCH] fix musl compat

---
 handy/logging.cc   | 5 +++++
 handy/port_posix.h | 7 +++++++
 2 files changed, 12 insertions(+)

diff --git a/handy/logging.cc b/handy/logging.cc
index d22eacd..30eee3e 100644
--- a/handy/logging.cc
+++ b/handy/logging.cc
@@ -14,6 +14,11 @@
 #include <utility>
 #include "port_posix.h"
 
+// musl (OHOS) does not define glibc's DEFFILEMODE; use POSIX mode bits.
+#ifndef DEFFILEMODE
+#define DEFFILEMODE (S_IRUSR | S_IWUSR | S_IRGRP | S_IWGRP | S_IROTH | S_IWOTH)
+#endif
+
 using namespace std;
 
 namespace handy {
diff --git a/handy/port_posix.h b/handy/port_posix.h
index 81c748c..a81d8bd 100644
--- a/handy/port_posix.h
+++ b/handy/port_posix.h
@@ -1,6 +1,13 @@
 #pragma once
 #include <netinet/in.h>
 #include <string>
+// musl (OHOS) <netinet/in.h> does not define glibc's LITTLE_ENDIAN macro;
+// derive the runtime endianness from <endian.h> instead.
+#include <endian.h>
+#if defined(LITTLE_ENDIAN) && !defined(__OHOS_ENDIAN_FALLBACK__)
+#elif defined(__BYTE_ORDER__) && defined(__ORDER_LITTLE_ENDIAN__)
+#define LITTLE_ENDIAN __ORDER_LITTLE_ENDIAN__
+#endif
 namespace handy {
 namespace port {
 static const int kLittleEndian = LITTLE_ENDIAN;
-- 
