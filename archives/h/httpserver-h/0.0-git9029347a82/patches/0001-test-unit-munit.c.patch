--- a/test/unit/munit.c
+++ b/test/unit/munit.c
@@ -1322,20 +1322,38 @@
     while (output_l++ < MUNIT_TEST_NAME_LEN) {
       fputc(' ', MUNIT_OUTPUT_FILE);
     }
   }
 
   fflush(MUNIT_OUTPUT_FILE);
 
   stderr_buf = NULL;
 #if !defined(_WIN32) || defined(__MINGW32__)
   stderr_buf = tmpfile();
+  /* OHOS libc 的 tmpfile() 固定落在只读系统临时路径（忽略 TMPDIR），
+     此处回退到 TMPDIR 下的 mkstemp 匿名文件，保证 stderr 缓冲可用。
+     仅在本地运行上游测试时生效，不进入归档配方/补丁。 */
+  if (stderr_buf == NULL) {
+    const char *tdir = getenv("TMPDIR");
+    if (tdir == NULL || *tdir == '\0') {
+      tdir = "/storage/Users/currentUser/tmp";
+    }
+    char tpath[512];
+    snprintf(tpath, sizeof tpath, "%s/munit-stderr-XXXXXX", tdir);
+    int tfd = mkstemp(tpath);
+    if (tfd >= 0) {
+      stderr_buf = fdopen(tfd, "w+");
+      if (stderr_buf != NULL) {
+        remove(tpath);
+      }
+    }
+  }
 #else
   tmpfile_s(&stderr_buf);
 #endif
   if (stderr_buf == NULL) {
     munit_log_errno(MUNIT_LOG_ERROR, stderr, "unable to create buffer for stderr");
     result = MUNIT_ERROR;
     goto print_result;
   }
 
 #if !defined(MUNIT_NO_FORK)
