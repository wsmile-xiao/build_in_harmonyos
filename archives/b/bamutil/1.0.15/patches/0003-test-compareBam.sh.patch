--- /dev/null
+++ test/compareBam.sh
@@ -0,0 +1,13 @@
+#!/bin/sh
+# Compare BAM records after decoding, independent of BGZF/zlib byte layout.
+set -e
+
+actual=$1
+expected=$2
+tmpdir=${TMPDIR:-/tmp}/bamutil-compare-$$
+mkdir -p "$tmpdir"
+trap 'rm -rf "$tmpdir"' EXIT
+
+../bin/bam convert --in "$actual" --out "$tmpdir/actual.sam" --noph
+../bin/bam convert --in "$expected" --out "$tmpdir/expected.sam" --noph
+diff "$tmpdir/actual.sam" "$tmpdir/expected.sam"
