+
+/*
+ * Missing libc GNU/BSD extension functions.
+ *
+ * gethostid(), strverscmp() and sigisemptyset() are non-POSIX extensions
+ * present in glibc but absent from several minimal libc implementations
+ * (e.g. musl).  BusyBox references them unconditionally.
+ *
+ * The definitions below are declared weak and compiled unconditionally:
+ * when the linked libc exports a strong definition (glibc and friends),
+ * the linker prefers it and these stubs are inert; when the libc lacks
+ * the symbol (musl-based environments such as OHOS), the weak
+ * definitions bind at link time.  This is a functional detection
+ * mechanism and requires no platform-specific conditionals.
+ */
+#include <unistd.h>
+#include <string.h>
+#include <signal.h>
+#include <ctype.h>
+
+/* gethostid — return 0 (safe default; /etc/hostid may be absent) */
+__attribute__((weak)) long gethostid(void)
+{
+	return 0;
+}
+
+/* strverscmp — GNU version-string comparison (glibc-compatible).
+ *
+ * Semantics: at the first differing character, if both are digits, the
+ * digit runs are compared.  A run that begins with '0' sorts before one
+ * that does not; otherwise the longer run is larger; runs of equal
+ * length are compared digit-by-digit (no integer accumulation, so
+ * arbitrarily long digit strings cannot overflow or reverse ordering).
+ * Non-digit differing characters fall back to plain byte comparison.
+ */
+__attribute__((weak)) int strverscmp(const char *l0, const char *r0)
+{
+	const unsigned char *l = (const unsigned char *)l0;
+	const unsigned char *r = (const unsigned char *)r0;
+	size_t llen, rlen;
+
+	/* Find the first differing character. */
+	while (*l == *r) {
+		if (*l == '\0')
+			return 0;
+		++l;
+		++r;
+	}
+
+	if (isdigit(*l) && isdigit(*r)) {
+		/* Leading-zero rule: the run starting with '0' sorts first. */
+		if ((*l == '0') != (*r == '0'))
+			return (*l == '0') ? -1 : 1;
+
+		/* Skip the common leading zeros, then compare runs. */
+		while (*l == '0')
+			++l;
+		while (*r == '0')
+			++r;
+
+		/* Compare remaining digit-run lengths (no overflow). */
+		llen = 0;
+		while (isdigit(l[llen]))
+			++llen;
+		rlen = 0;
+		while (isdigit(r[rlen]))
+			++rlen;
+		if (llen != rlen)
+			return llen > rlen ? 1 : -1;
+
+		/* Equal lengths: compare digit-by-digit. */
+		while (llen-- > 0) {
+			if (*l != *r)
+				return (*l < *r) ? -1 : 1;
+			++l;
+			++r;
+		}
+		/* Digit runs equal; fall through to plain byte comparison. */
+	}
+
+	return (int)*l - (int)*r;
+}
+
+/* sigisemptyset — check whether a signal set has no members */
+__attribute__((weak)) int sigisemptyset(const sigset_t *set)
+{
+	int i;
+
+	for (i = 1; i < _NSIG; i++) {
+		if (sigismember(set, i))
+			return 0;
+	}
+	return 1;
+}
