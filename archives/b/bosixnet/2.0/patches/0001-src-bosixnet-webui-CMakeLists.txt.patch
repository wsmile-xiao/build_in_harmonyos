--- a/src/bosixnet-webui/CMakeLists.txt
+++ b/src/bosixnet-webui/CMakeLists.txt
@@ -3,14 +3,25 @@
 
 include_directories(${CMAKE_BINARY_DIR})
 
+# External dependency: FastCGI Developer Kit (fcgi).
+# FCGI_INCLUDE_DIR / FCGI_LIBRARY are injected by the Conan recipe
+# (see archives/b/bosixnet/2.0/conanfile.py build()).  FCGI_LIBRARY points
+# at the prebuilt libfcgi.a so the webui is linked statically: on OHOS the
+# musl ldso cannot reliably resolve $ORIGIN RPATH / LD_LIBRARY_PATH for a
+# side-loaded libfcgi.so.0 (E019/E088/E207), and the packaged binary must
+# run without any fcgi shared library at runtime.
+if (FCGI_INCLUDE_DIR)
+    include_directories(${FCGI_INCLUDE_DIR})
+endif (FCGI_INCLUDE_DIR)
+
 add_executable (${PROJECT_NAME} bosixnet-webui.cpp)
 
-target_link_libraries (${PROJECT_NAME} fcgi)
+if (FCGI_LIBRARY)
+    target_link_libraries (${PROJECT_NAME} ${FCGI_LIBRARY} m)
+else ()
+    target_link_libraries (${PROJECT_NAME} fcgi)
+endif (FCGI_LIBRARY)
 
-execute_process (COMMAND gzip -9
-                 INPUT_FILE ${PROJECT_NAME}.1
-                 OUTPUT_FILE ${PROJECT_BINARY_DIR}/${PROJECT_NAME}.1.gz
-                 WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/)
 
 install (TARGETS ${PROJECT_NAME}
          RUNTIME DESTINATION "${CMAKE_INSTALL_PREFIX}/bin/")
@@ -18,9 +29,7 @@
          DESTINATION "${CMAKE_INSTALL_PREFIX}/lib/bosixnet/"
          PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
 install (FILES bosixnet-webui.conf
-         DESTINATION "/etc/bosixnet/")
-install (FILES ${PROJECT_BINARY_DIR}/${PROJECT_NAME}.1.gz
-         DESTINATION "${CMAKE_INSTALL_PREFIX}/share/man/man1")
+         DESTINATION "${CMAKE_INSTALL_PREFIX}/etc/bosixnet/")
 
 if (WITH_SYSVINIT_SUPPORT)
     install (FILES bosixnet-webui
