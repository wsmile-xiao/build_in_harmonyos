all: all-recursive

.SUFFIXES:
.SUFFIXES: .cpp .lo .log .o .obj .test .test$(EXEEXT) .trs
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am $(top_srcdir)/src/Makefile.common.inc $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign tests/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign tests/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;
$(top_srcdir)/src/Makefile.common.inc $(am__empty):

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-noinstPROGRAMS:
	@list='$(noinst_PROGRAMS)'; test -n "$$list" || exit 0; \
	echo " rm -f" $$list; \
	rm -f $$list || exit $$?; \
	test -n "$(EXEEXT)" || exit 0; \
	list=`for p in $$list; do echo "$$p"; done | sed 's/$(EXEEXT)$$//'`; \
	echo " rm -f" $$list; \
	rm -f $$list
cpp-common/$(am__dirstamp):
	@$(MKDIR_P) cpp-common
	@: >>cpp-common/$(am__dirstamp)
cpp-common/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) cpp-common/$(DEPDIR)
	@: >>cpp-common/$(DEPDIR)/$(am__dirstamp)
cpp-common/test-c-string-view.$(OBJEXT): cpp-common/$(am__dirstamp) \
	cpp-common/$(DEPDIR)/$(am__dirstamp)

cpp-common/test-c-string-view$(EXEEXT): $(cpp_common_test_c_string_view_OBJECTS) $(cpp_common_test_c_string_view_DEPENDENCIES) $(EXTRA_cpp_common_test_c_string_view_DEPENDENCIES) cpp-common/$(am__dirstamp)
	@rm -f cpp-common/test-c-string-view$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(cpp_common_test_c_string_view_OBJECTS) $(cpp_common_test_c_string_view_LDADD) $(LIBS)
cpp-common/test-unicode-conv.$(OBJEXT): cpp-common/$(am__dirstamp) \
	cpp-common/$(DEPDIR)/$(am__dirstamp)

cpp-common/test-unicode-conv$(EXEEXT): $(cpp_common_test_unicode_conv_OBJECTS) $(cpp_common_test_unicode_conv_DEPENDENCIES) $(EXTRA_cpp_common_test_unicode_conv_DEPENDENCIES) cpp-common/$(am__dirstamp)
	@rm -f cpp-common/test-unicode-conv$(EXEEXT)
