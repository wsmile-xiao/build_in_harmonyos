@ENABLE_BUILT_IN_PLUGINS_TRUE@plugins_flt_utils_muxer_test_clock_compatibility_LDFLAGS = $(call pluginarchive,utils)
TESTS_PLUGINS = plugins/src.ctf.fs/fail/test-fail.sh \
