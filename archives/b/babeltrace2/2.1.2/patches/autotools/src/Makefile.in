pdf: pdf-recursive

pdf-am:

ps: ps-recursive

ps-am:

uninstall-am: uninstall-libLTLIBRARIES uninstall-pkgconfigDATA \
	uninstall-pluginLTLIBRARIES \
	uninstall-pluginproviderLTLIBRARIES

.MAKE: $(am__recursive_targets) all check install install-am \
	install-exec install-strip

.PHONY: $(am__recursive_targets) CTAGS GTAGS TAGS all all-am all-local \
	am--depfiles check check-am clean clean-generic \
	clean-libLTLIBRARIES clean-libtool clean-noinstLTLIBRARIES \
	clean-pluginLTLIBRARIES clean-pluginproviderLTLIBRARIES \
	cscopelist-am ctags ctags-am distclean distclean-compile \
	distclean-generic distclean-libtool distclean-tags distdir dvi \
	dvi-am html html-am info info-am install install-am \
	install-data install-data-am install-dvi install-dvi-am \
	install-exec install-exec-am install-html install-html-am \
	install-info install-info-am install-libLTLIBRARIES \
	install-man install-pdf install-pdf-am install-pkgconfigDATA \
	install-pluginLTLIBRARIES install-pluginproviderLTLIBRARIES \
	install-ps install-ps-am install-strip installcheck \
	installcheck-am installdirs installdirs-am maintainer-clean \
	maintainer-clean-generic mostlyclean mostlyclean-compile \
	mostlyclean-generic mostlyclean-libtool pdf pdf-am ps ps-am \
	tags tags-am uninstall uninstall-am uninstall-libLTLIBRARIES \
	uninstall-pkgconfigDATA uninstall-pluginLTLIBRARIES \
	uninstall-pluginproviderLTLIBRARIES

.PRECIOUS: Makefile


common/version.i:
	$(version_verbose)GREP=$(GREP) SED=$(SED) TOP_SRCDIR="$(top_srcdir)" $(SHELL) $(srcdir)/gen-version-i.sh

.PHONY: common/version.i
# Create target used to stop the build if we want to build the parser,
# but we don't have the necessary tool to do so
@HAVE_BISON_FALSE@plugins/ctf/common/src/metadata/tsdl/parser.cpp plugins/ctf/common/src/metadata/tsdl/parser.hpp: plugins/ctf/common/src/metadata/tsdl/parser.ypp
@HAVE_BISON_FALSE@	@echo "Error: Cannot build target because bison is missing."
@HAVE_BISON_FALSE@	@echo "Make sure bison is installed and run the configure script again."
@HAVE_BISON_FALSE@	@false
# Create target used to stop the build if we want to build the lexer,
# but we don't have the necessary tool to do so
@HAVE_FLEX_FALSE@plugins/ctf/common/src/metadata/tsdl/lexer.cpp: plugins/ctf/common/src/metadata/tsdl/lexer.lpp
@HAVE_FLEX_FALSE@	@echo "Error: Cannot build target because flex is missing."
@HAVE_FLEX_FALSE@	@echo "Make sure flex is installed and run the configure script again."
@HAVE_FLEX_FALSE@	@false

all-local: $(ALL_LOCAL)

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:
