From: OpenHarmony PC Developer Community
Subject: [PATCH] boxes 2.3.1 HarmonyOS compatibility

Adapts the boxes 2.3.1 Makefile for HarmonyOS PC:
- Allow the C compiler to be overridden from the build environment (CC ?=),
  so the Conan recipe can point it at the OHOS clang toolchain.
- Link against the wide ncurses variant (-lncursesw) that the OHOS conan
  ncurses package ships; the vanilla -lncurses library does not exist on
  HarmonyOS.

diff --git a/src/Makefile b/src/Makefile
--- a/src/Makefile
+++ b/src/Makefile
@@ -13,7 +13,7 @@
 #====================================================================================================================


-CC         = gcc
+CC         ?= gcc

 OUT_DIR    = ../out
 SRC_DIR    = ../src
@@ -64,7 +64,7 @@
 	    CFLAGS_ADDTL="-ggdb3 $(CFLAGS_ADDTL)" flags_$(BOXES_PLATFORM) $(BOXES_EXECUTABLE_NAME)

 boxes: $(ALL_OBJ) | check_dir
-	$(CC) $(LDFLAGS) $^ -o $@ -lunistring -lpcre2-32 -lncurses
+	$(CC) $(LDFLAGS) $^ -o $@ -lunistring -lpcre2-32 -lncursesw
 	if [ "$(STRIP)" = "true" ] ; then strip $@ ; fi

 boxes.static: $(ALL_OBJ) | check_dir
