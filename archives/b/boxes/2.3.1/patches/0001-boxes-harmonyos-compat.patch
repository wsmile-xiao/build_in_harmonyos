From: OpenHarmony PC Developer Community
Subject: [PATCH] boxes 2.3.1 HarmonyOS compatibility patch

This patch adds HarmonyOS compatibility to boxes 2.3.1:
- Modify Makefile to allow CC override via environment variable
- Remove ncurses library dependency (use stub functions)
- Add include/library paths for vendored dependencies
- Add __OHOS__ preprocessor flag

diff --git a/src/Makefile b/src/Makefile
--- a/src/Makefile
+++ b/src/Makefile
@@ -13,7 +13,7 @@
 #====================================================================================================================
 
 
-CC         = gcc
+CC         ?= gcc
 
 OUT_DIR    = ../out
 SRC_DIR    = ../src
@@ -64,7 +64,7 @@
 	    CFLAGS_ADDTL="-ggdb3 $(CFLAGS_ADDTL)" flags_$(BOXES_PLATFORM) $(BOXES_EXECUTABLE_NAME)
 
 boxes: $(ALL_OBJ) | check_dir
-	$(CC) $(LDFLAGS) $^ -o $@ -lunistring -lpcre2-32 -lncurses
+	$(CC) $(LDFLAGS) $^ -o $@ -lunistring -lpcre2-32
 	if [ "$(STRIP)" = "true" ] ; then strip $@ ; fi
 
 boxes.static: $(ALL_OBJ) | check_dir
@@ -77,8 +77,8 @@
 
 
 flags_unix:
-	$(eval CFLAGS := -I. -I$(SRC_DIR) -Wall -W $(CFLAGS_ADDTL))
-	$(eval LDFLAGS := $(LDFLAGS) $(LDFLAGS_ADDTL))
+	$(eval CFLAGS := -I. -I$(SRC_DIR) -I../vendor/libunistring-1.0/ohos-install/include -I../vendor/pcre2-10.40/ohos-install/include -Wall -W -D__OHOS__ $(CFLAGS_ADDTL))
+	$(eval LDFLAGS := -L../vendor/libunistring-1.0/ohos-install/lib -L../vendor/pcre2-10.40/ohos-install/lib $(LDFLAGS) $(LDFLAGS_ADDTL))
 	$(eval BOXES_EXECUTABLE_NAME := boxes)
 	$(eval ALL_OBJ := $(GEN_SRC:.c=.o) $(ORIG_NORM:.c=.o))
 	echo $(filter-out boxes.o,$(ALL_OBJ)) > $(OUT_DIR)/modules.txt
diff --git a/src/boxes.c b/src/boxes.c
--- a/src/boxes.c
+++ b/src/boxes.c
@@ -16,8 +16,17 @@
 #include "config.h"
 
 #ifndef __MINGW32__
+#if defined(__OHOS__) || defined(__HARMONYOS__)
+/* HarmonyOS does not have ncurses, stub the functions */
+#define OK 0
+#define NCURSES_CONST const
+#define NCURSES_EXPORT(x) x
+static int setupterm(NCURSES_CONST char *term, int fd, int *err) { return OK; }
+static int tigetnum(NCURSES_CONST char *capname) { return 256; } /* Assume color support */
+#else
 #include <ncurses.h>
 #endif
+#endif
 #include <locale.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -404,11 +413,17 @@
 
 
 
+#if defined(__OHOS__) || defined(__HARMONYOS__)
+    /* HarmonyOS stub functions */
+    extern int setupterm(const char *, int, int *);
+    extern int tigetnum(const char *);
+#else
 #ifndef __MINGW32__
     /* These two functions are actually declared in term.h, but for some reason, that can't be included. */
     extern NCURSES_EXPORT(int) setupterm(NCURSES_CONST char *, int, int *);
     extern NCURSES_EXPORT(int) tigetnum(NCURSES_CONST char *);
 #endif
+#endif
 
 static int terminal_has_colors()
 {