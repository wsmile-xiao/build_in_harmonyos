+
+/* HarmonyOS: get_current_dir_name() is a GNU extension not available on this platform */
+#ifndef HAVE_GET_CURRENT_DIR_NAME
+#include <unistd.h>
+#include <stdlib.h>
+#include <limits.h>
+static char *
+get_current_dir_name_fallback (void)
+{
+  char *buf = malloc (PATH_MAX);
+  if (buf == NULL)
+    return NULL;
+  if (getcwd (buf, PATH_MAX) == NULL)
+    {
+      free (buf);
+      return NULL;
+    }
+  return buf;
+}
+#define get_current_dir_name get_current_dir_name_fallback
+#endif
 
 #ifndef CLONE_NEWCGROUP
