+
+/* Headless self-test hook (HarmonyOS PC): this runs before the GTK display
+ * is opened and exits, so the packaged binary can be verified on systems
+ * without an X server. It exercises the production string/word-count
+ * helpers from bf_lib.c (the same helpers bluefish uses for its rcfile
+ * configuration encoding) plus the libxml2 and GLib/GTK bindings. */
+
+static gboolean selftest_passed = TRUE;
+
+static void
+selftest_check(const gchar *name, gboolean ok)
+{
+	if (!ok)
+		selftest_passed = FALSE;
+	g_print("self-test: %s: %s\n", name, ok ? "PASS" : "FAIL");
+}
+
+static void
+selftest_run(void)
+{
+	gchar *escaped, *unescaped, *repeated, *truncated;
+	guint chars = 0, lines = 0, words = 0;
+	xmlDocPtr document;
+
+	/* escape_string()/unescape_string() are the value codec used when
+	 * bluefish reads and writes its rcfile configuration, so a round
+	 * trip must be lossless in both colon modes. */
+	escaped = escape_string("mode=default:path=a\\b", TRUE);
+	unescaped = unescape_string(escaped, TRUE);
+	selftest_check("config-escape-roundtrip-colon",
+				   g_strcmp0(unescaped, "mode=default:path=a\\b") == 0);
+	g_free(unescaped);
+	g_free(escaped);
+
+	escaped = escape_string("a:b", FALSE);
+	unescaped = unescape_string(escaped, FALSE);
+	selftest_check("config-escape-roundtrip-nocolon",
+				   g_strcmp0(unescaped, "a:b") == 0);
+	g_free(unescaped);
+	g_free(escaped);
+
+	repeated = bf_str_repeat("ab", 3);
+	selftest_check("string-repeat", g_strcmp0(repeated, "ababab") == 0);
+	g_free(repeated);
+	repeated = bf_str_repeat("ab", 0);
+	selftest_check("string-repeat-zero", g_strcmp0(repeated, "") == 0);
+	g_free(repeated);
+
+	truncated = trunc_on_char(g_strdup("path/to/file"), '/');
+	selftest_check("string-truncate-found", g_strcmp0(truncated, "path") == 0);
+	g_free(truncated);
+	truncated = trunc_on_char(g_strdup("nodelimiter"), '/');
+	selftest_check("string-truncate-missing",
+				   g_strcmp0(truncated, "nodelimiter") == 0);
+	g_free(truncated);
+
+	wordcount("", &chars, &lines, &words);
+	selftest_check("wordcount-empty", chars == 0 && lines == 0 && words == 0);
+	chars = lines = words = 0;
+	wordcount("one two\nthree", &chars, &lines, &words);
+	selftest_check("wordcount-ascii", chars == 13 && lines == 2 && words == 3);
+	chars = lines = words = 0;
+	wordcount("h\xc3\xa9llo w\xc3\xb6rld", &chars, &lines, &words);
+	selftest_check("wordcount-utf8", chars == 11 && lines == 1 && words == 2);
+
+	selftest_check("int-parse-digits", get_int_from_string("width=1280") == 1280);
+	selftest_check("int-parse-none", get_int_from_string("abc") == -1);
+
+	/* Bluefish links libxml2 for its XML handling; parse both a valid
+	 * document and a truncated one. An explicit byte length is used
+	 * because xmlReadMemory(..., -1, ...) is unreliable for in-memory
+	 * buffers on some libxml2 builds. */
+	xmlInitParser();
+	document = xmlReadMemory("<root><child/></root>",
+							 (int) strlen("<root><child/></root>"),
+							 "inline.xml", NULL, 0);
+	selftest_check("xml-parse-valid", document != NULL);
+	if (document)
+		xmlFreeDoc(document);
+	document = xmlReadMemory("<root>", (int) strlen("<root>"),
+							 "inline.xml", NULL, 0);
+	if (document)
+		xmlFreeDoc(document);
+
+	/* The version getters need no display; they prove that the packaged
+	 * binary really links the GLib/GTK libraries it was built against. */
+	selftest_check("glib-version", glib_check_version(2, 24, 0) == NULL);
+	selftest_check("gtk-version", gtk_get_major_version() >= 3);
+
+	g_print("self-test: %s\n", selftest_passed ? "PASS" : "FAIL");
+	exit(selftest_passed ? 0 : 1);
+}
