+// GNU qsort_r / scandirat / scandirat64 are absent from OHOS musl (neither the
+// SDK sysroot nor the device runtime export them) while box64 calls them
+// directly.  Provide local implementations.
+typedef int (*__compar_d_fn_t)(const void*, const void*, void*);
+
+static void ohos_qsort_r_swap(unsigned char* a, unsigned char* b, size_t size)
+{
+    unsigned char t;
+    while(size--) { t = *a; *a++ = *b; *b++ = t; }
+}
+static void ohos_qsort_r_rec(unsigned char* base, size_t nmemb, size_t size, __compar_d_fn_t compar, void* arg)
+{
+    while(nmemb > 16) {
+        size_t mid = nmemb/2;
+        unsigned char* a = base;
+        unsigned char* b = base + mid*size;
+        unsigned char* c = base + (nmemb-1)*size;
+        if(compar(a, b, arg) > 0) ohos_qsort_r_swap(a, b, size);
+        if(compar(b, c, arg) > 0) ohos_qsort_r_swap(b, c, size);
+        if(compar(a, b, arg) > 0) ohos_qsort_r_swap(a, b, size);
+        ohos_qsort_r_swap(b, c, size);  // pivot (median) to the last slot
+        size_t store = 0;
+        for(size_t i = 0; i < nmemb-1; ++i)
+            if(compar(base + i*size, c, arg) < 0) {
+                ohos_qsort_r_swap(base + store*size, base + i*size, size);
+                ++store;
+            }
+        ohos_qsort_r_swap(base + store*size, c, size);
+        if(store < nmemb-store-1) {
+            ohos_qsort_r_rec(base, store, size, compar, arg);
+            base += (store+1)*size;
+            nmemb -= store+1;
+        } else {
+            ohos_qsort_r_rec(base + (store+1)*size, nmemb-store-1, size, compar, arg);
+            nmemb = store;
+        }
+    }
+    for(size_t i = 1; i < nmemb; ++i) {
+        size_t j = i;
+        while(j > 0 && compar(base + (j-1)*size, base + j*size, arg) > 0) {
+            ohos_qsort_r_swap(base + (j-1)*size, base + j*size, size);
+            --j;
+        }
+    }
+}
+void qsort_r(void* base, size_t nmemb, size_t size, __compar_d_fn_t compar, void* arg)
+{
+    if(nmemb > 1 && size)
+        ohos_qsort_r_rec((unsigned char*)base, nmemb, size, compar, arg);
+}
+
+int scandirat(int dirfd, const char* dirp, struct dirent*** namelist,
+              int (*filter)(const struct dirent*),
+              int (*compar)(const struct dirent**, const struct dirent**))
+{
+    if(dirfd == AT_FDCWD)
+        return scandir(dirp, namelist, filter, compar);
+    int fd = openat(dirfd, dirp, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if(fd < 0)
+        return -1;
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/self/fd/%d", fd);
+    int ret = scandir(path, namelist, filter, compar);
+    close(fd);
+    return ret;
+}
+int scandirat64(int dirfd, const char* dirp, struct dirent64*** namelist,
+                int (*filter)(const struct dirent64*),
+                int (*compar)(const struct dirent64**, const struct dirent64**))
+{
+    return scandirat(dirfd, dirp, (struct dirent***)namelist,
+                     (int (*)(const struct dirent*))filter,
+                     (int (*)(const struct dirent**, const struct dirent**))compar);
+}
