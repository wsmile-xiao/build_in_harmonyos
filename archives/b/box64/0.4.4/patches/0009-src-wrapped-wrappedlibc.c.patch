+// dlinfo/glob64 are exported by the device runtime but not by the sysroot.
+int dlinfo(void* handle, int request, void* info)
+{
+    static int (*real)(void*, int, void*) = NULL;
+    if(!real) real = (int (*)(void*, int, void*))dlsym(RTLD_NEXT, "dlinfo");
+    if(!real) { errno = ENOSYS; return -1; }
+    return real(handle, request, info);
+}
+int glob64(const char* pattern, int flags, int (*errfunc)(const char*, int), glob_t* pglob)
