+// Remaining glibc-isms used by box64 and absent from OHOS musl.
+// __libc_* are glibc's internal allocators that bypass the interposing hooks;
+// resolve the real libc allocators with dlsym(RTLD_NEXT) here as well.
+static void* (*ohos_libc_malloc)(size_t) = NULL;
+static void* (*ohos_libc_calloc)(size_t, size_t) = NULL;
+static void* (*ohos_libc_realloc)(void*, size_t) = NULL;
+static void  (*ohos_libc_free)(void*) = NULL;
+static void* (*ohos_libc_memalign)(size_t, size_t) = NULL;
+
+void* __libc_malloc(size_t size)
+{
+    if(!ohos_libc_malloc) ohos_libc_malloc = (void* (*)(size_t))dlsym(RTLD_NEXT, "malloc");
+    return ohos_libc_malloc ? ohos_libc_malloc(size) : NULL;
+}
+void* __libc_calloc(size_t nmemb, size_t size)
+{
+    if(!ohos_libc_calloc) ohos_libc_calloc = (void* (*)(size_t, size_t))dlsym(RTLD_NEXT, "calloc");
+    return ohos_libc_calloc ? ohos_libc_calloc(nmemb, size) : NULL;
+}
+void* __libc_realloc(void* ptr, size_t size)
+{
+    if(!ohos_libc_realloc) ohos_libc_realloc = (void* (*)(void*, size_t))dlsym(RTLD_NEXT, "realloc");
+    return ohos_libc_realloc ? ohos_libc_realloc(ptr, size) : NULL;
+}
+void __libc_free(void* ptr)
+{
+    if(!ohos_libc_free) ohos_libc_free = (void (*)(void*))dlsym(RTLD_NEXT, "free");
+    if(ohos_libc_free) ohos_libc_free(ptr);
+}
+void* __libc_memalign(size_t alignment, size_t size)
+{
+    if(!ohos_libc_memalign) ohos_libc_memalign = (void* (*)(size_t, size_t))dlsym(RTLD_NEXT, "memalign");
+    return ohos_libc_memalign ? ohos_libc_memalign(alignment, size) : NULL;
+}
