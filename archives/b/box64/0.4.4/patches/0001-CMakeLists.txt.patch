+# OHOS/musl: detect the HarmonyOS/musl target.  Conan maps os=OHOS to
+# CMAKE_SYSTEM_NAME=HarmonyOS; a plain native CMake run is recognised through
+# the __OHOS__ macro the OHOS clang driver always defines.
+if(NOT DEFINED BOX64_OHOS)
+    if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+        set(BOX64_OHOS TRUE)
+    else()
+        include(CheckCSourceCompiles)
+        check_c_source_compiles("#ifndef __OHOS__\n#error not OHOS\n#endif\nint main(void){return 0;}" BOX64_CC_IS_OHOS)
+        set(BOX64_OHOS ${BOX64_CC_IS_OHOS})
+    endif()
+endif()
+if(BOX64_OHOS)
+    message(STATUS "OHOS/musl target: enabling musl-compat link flags")
+endif()
+
+# OHOS/musl: fts.h and fts_* are not provided by musl libc.  Conan injects
+# BOX64_FTS_LIBRARY/BOX64_FTS_INCLUDE_DIR with exact dependency paths; a plain
+# build can also resolve them through find_library/find_path.
+if(NOT BOX64_FTS_LIBRARY)
+    find_library(BOX64_FTS_LIBRARY NAMES fts)
+endif()
+if(BOX64_FTS_LIBRARY)
+    target_link_libraries(${BOX64} "${BOX64_FTS_LIBRARY}")
+endif()
+if(NOT BOX64_FTS_INCLUDE_DIR)
+    find_path(BOX64_FTS_INCLUDE_DIR NAMES fts.h)
+endif()
+if(BOX64_FTS_INCLUDE_DIR)
+    target_include_directories(mainobj PRIVATE "${BOX64_FTS_INCLUDE_DIR}")
+endif()
+
+# OHOS/musl: GNU obstack is not part of musl libc.
+if(NOT BOX64_OBSTACK_LIBRARY)
+    find_library(BOX64_OBSTACK_LIBRARY NAMES obstack)
+endif()
+if(BOX64_OBSTACK_LIBRARY)
+    target_link_libraries(${BOX64} "${BOX64_OBSTACK_LIBRARY}")
+endif()
+if(NOT BOX64_OBSTACK_INCLUDE_DIR)
+    find_path(BOX64_OBSTACK_INCLUDE_DIR NAMES obstack.h)
+endif()
+if(BOX64_OBSTACK_INCLUDE_DIR)
+    target_include_directories(mainobj PRIVATE "${BOX64_OBSTACK_INCLUDE_DIR}")
+endif()
+
+if(BOX64_OHOS)
+    # box64's malloc/mmap/dlopen wrappers must not be visible in .dynsym:
+    # OHOS musl libc resolves its own PLT through the executable and would call
+    # the not-yet-initialised wrappers, crashing the loader before main().
+    # glibc avoids this with symbol versioning, musl has no symbol versions.
+    set(BOX64_OHOS_HIDE_MAP "${CMAKE_CURRENT_BINARY_DIR}/box64-ohos-hide.map")
+    file(WRITE "${BOX64_OHOS_HIDE_MAP}" "{\n  local: *;\n};\n")
+    # -no-pie (ET_EXEC) is required for a stable start on this toolchain: the
+    # OHOS clang links PIE by default and the PIE build was not startable.
+    target_link_options(${BOX64} PRIVATE
+        -no-pie
+        "-Wl,--version-script=${BOX64_OHOS_HIDE_MAP}")
+    # Keep packages self-contained: resolve the musl-compat libraries
+    # (musl-fts / musl-obstack) from <prefix>/lib next to bin/box64.
+    # CMake has no Platform/HarmonyOS module, so CMAKE_SHARED_LIBRARY_RUNTIME_C_FLAG
+    # is empty and the INSTALL_RPATH machinery is silently a no-op; pass the
+    # runtime path to the linker explicitly instead.
+    target_link_options(${BOX64} PRIVATE "LINKER:-rpath,\$ORIGIN/../lib")
+endif()
+
