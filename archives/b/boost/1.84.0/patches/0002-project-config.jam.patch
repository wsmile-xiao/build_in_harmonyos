diff -ruN a/project-config.jam b/project-config.jam
--- a/project-config.jam
+++ b/project-config.jam
@@ -0,0 +1,29 @@
+# B2 Configuration
+# Modified for OpenHarmony - using gcc toolset as workaround
+
+import option ;
+import feature ;
+
+# Compiler configuration - use gcc toolset which calls clang++
+if ! gcc in [ feature.values <toolset> ]
+{
+    using gcc : 15.0 : clang++ ;
+}
+
+project : default-build <toolset>gcc ;
+
+# List of --with-<library> and --without-<library>
+# options. If left empty, all libraries will be built.
+# Options specified on the command line completely
+# override this variable.
+libraries =  ;
+
+# These settings are equivalent to corresponding command-line
+# options.
+option.set prefix : /storage/Users/currentUser/usr/local ;
+option.set exec-prefix : /storage/Users/currentUser/usr/local ;
+option.set libdir : /storage/Users/currentUser/usr/local/lib ;
+option.set includedir : /storage/Users/currentUser/usr/local/include ;
+
+# Stop on first error
+option.set keep-going : false ;
