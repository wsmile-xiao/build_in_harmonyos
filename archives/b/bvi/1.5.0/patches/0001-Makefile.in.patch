 installdirs:
 	$(SHELL) ${srcdir}/mkinstalldirs $(bindir) $(helpdir) $(man1dir)
 
 uninstall:
 	@echo "Uninstalling bvi"
 	@if [ -f $(bindir)/bview ]; then rm $(bindir)/bview; fi
