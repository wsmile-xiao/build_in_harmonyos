 namespace Core2
 {
+#include <algorithm>
+#include <compare>
+
+// libc++ 15 (the HarmonyOS clang 15 toolchain) does not implement the C++20
+// three-way comparison operators for std::string, std::vector and
+// std::variant (they arrived in LLVM 17). BAli-Phy 4.1 targets C++20 and
+// uses <=> on such types; provide portable equivalents here. The helper
+// semantics match what the standard operators would do (lexicographic order).
+inline std::strong_ordering compare_string(const std::string& a, const std::string& b)
+{
+    const int c = a.compare(b);
+    return c < 0 ? std::strong_ordering::less
+         : c > 0 ? std::strong_ordering::greater
+                 : std::strong_ordering::equal;
+}
+
+template <typename T>
+std::strong_ordering compare_vector(const std::vector<T>& a, const std::vector<T>& b)
+{
+    const std::size_t n = std::min(a.size(), b.size());
+    for (std::size_t k = 0; k < n; ++k)
+    {
+        auto c = a[k] <=> b[k];
+        if (c != std::strong_ordering::equivalent)
+            return c;
+    }
+    return a.size() < b.size() ? std::strong_ordering::less
+         : a.size() > b.size() ? std::strong_ordering::greater
+                               : std::strong_ordering::equal;
+}
+
