@@ -0,0 +1,11 @@
+// Boost.JSON header-only implementation translation unit.
+//
+// The ohpcd boost packages only install a curated subset of boost headers
+// and do not export the Boost.JSON component (header-only) nor a compiled
+// libboost_json. bali-phy hard-requires <boost/json.hpp>, so the missing
+// Boost.JSON headers are vendored in patches/boost-extra and the official
+// header-only instantiation (<boost/json/src.hpp> in exactly one TU) is
+// compiled here once (as a libutil source so every executable and builtins
+// module that links libutil gets the symbols), exactly as Boost.JSON
+// documents for header-only use.
+#include <boost/json/src.hpp>
