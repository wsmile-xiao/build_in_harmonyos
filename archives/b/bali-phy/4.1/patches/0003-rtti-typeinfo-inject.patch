+// rtti-inject.cc - force emission of Box<T> typeinfo in the main executable.
+//
+// OHOS/aarch64 (musl) does not unify typeinfo across the dlopen boundary:
+// each builtins .so defines its own WEAK _ZTI3BoxI... symbol while the main
+// executable does not define (or export) the same Box<T> typeinfo at all.
+// Cross-module dynamic_cast therefore compares two different typeinfo
+// pointers and fails (upstream issue #23, fixed upstream only in 4.2).
+//
+// Probe (rtti-probe3): when the executable defines+exports a weak _ZTI3Box...
+// symbol, musl binds the dlopen'd module's reference to the executable's
+// definition, unifying the typeinfo pointers and making dynamic_cast succeed.
+//
+// This TU explicitly instantiates every Box<T> that the builtins .so's
+// define but the executable does not, so the main "bali-phy" executable
+// (built with export_dynamic: true) exports them and unifies cross-module
+// RTTI for these types. Headers are the same ones the builtins use.
+#include "computation/object.H"
+#include "sequence/alphabet.H"
+#include "sequence/sequence.H"
+#include "sequence/genetic_code.H"
+#include "alignment/alignment.H"
+#include "util/bounds.H"
+#include "util/matrix.H"
+#include "util/math/log-double.H"
+#include "computation/expression/expression_ref.H"
+#include <Eigen/Eigenvalues>
+#include <boost/dynamic_bitset.hpp>
+#include <map>
+#include <optional>
+#include <memory>
+#include <string>
+#include <iostream>
+
+template class Box<Genetic_Code>;
+template class Box<bounds<double>>;
+template class Box<bounds<int>>;
+template class Box<sequence>;
+template class Box<alignment>;
+template class Box<Eigen::SelfAdjointEigenSolver<Eigen::Matrix<double, -1, -1, 0, -1, -1>>>;
+template class Box<boost::dynamic_bitset<unsigned long>>;
+template class Box<bali_phy::matrix<log_double_t>>;
+template class Box<bali_phy::matrix<double>>;
+template class Box<bali_phy::matrix<int>>;
+template class Box<std::shared_ptr<const alphabet>>;
+template class Box<std::shared_ptr<std::basic_iostream<char>>>;
+template class Box<std::map<std::string, int>>;
+template class Box<std::optional<expression_ref>>;
