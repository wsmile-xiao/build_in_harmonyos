--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,72 @@
+cmake_minimum_required(VERSION 3.20)
+project(boulder VERSION 1.02 LANGUAGES C CXX)
+include(GNUInstallDirs)
+include(CTest)
+find_package(SDL2 CONFIG REQUIRED)
+set(COMMON
+ src/graph/bmp.cpp src/graph/targa.cpp src/graph/jpeg.cpp
+ src/graph/converter.cpp src/graph/image.cpp src/graph/font.cpp
+ src/graph/graph.cpp src/graph/imagediskop.cpp
+ src/common/tileset.cpp src/common/global.cpp src/common/fileresource.cpp
+ src/common/timer.cpp src/common/input.cpp src/common/gui.cpp)
+set(GAME src/boulder/game_object.cpp src/boulder/game_world.cpp
+ src/boulder/hiscorelist.cpp src/common/common.cpp src/common/soundfx.cpp
+ ext_include/pa/stb_vorbis.c ext_include/pa/pa_ringbuffer.c)
+set(EDITOR src/editor/editor_object.cpp src/editor/editor_world.cpp)
+function(boulder_target target)
+ target_compile_features(${target} PRIVATE cxx_std_17)
+ target_include_directories(${target} PRIVATE src/common src/graph
+   src/boulder src/editor ext_include/pa)
+ target_link_libraries(${target} PRIVATE SDL2::SDL2)
+endfunction()
+
+add_executable(boulder-check harmony/check.cpp ${COMMON} ${EDITOR} ext_include/pa/stb_vorbis.c)
+boulder_target(boulder-check)
+install(TARGETS boulder-check RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+install(DIRECTORY exe/data DESTINATION ${CMAKE_INSTALL_DATADIR}/boulder)
+install(FILES license.txt DESTINATION licenses)
+install(FILES ext_include/pa/LICENSE.txt DESTINATION licenses/portaudio)
+
+# Native libraries are loaded inside an ArkUI XComponent application. A shell
+# process cannot create an OHOS desktop window without an application surface.
+if(CMAKE_SYSTEM_NAME MATCHES "^(OHOS|HarmonyOS)$")
+ # Application namespaces cannot load the shell's system libc++_shared.so.
+ # Use the runtime belonging to the compiler that built these modules.
+ set(_runtime_query "${CMAKE_CXX_COMPILER}")
+ if(CMAKE_CXX_COMPILER_TARGET)
+  list(APPEND _runtime_query "--target=${CMAKE_CXX_COMPILER_TARGET}")
+ endif()
+ execute_process(COMMAND ${_runtime_query} -print-file-name=libc++_shared.so
+   OUTPUT_VARIABLE BOULDER_CXX_RUNTIME OUTPUT_STRIP_TRAILING_WHITESPACE
+   RESULT_VARIABLE _runtime_result)
+ if(NOT _runtime_result EQUAL 0 OR NOT IS_ABSOLUTE "${BOULDER_CXX_RUNTIME}" OR NOT EXISTS "${BOULDER_CXX_RUNTIME}")
+  message(FATAL_ERROR "The OHOS compiler did not provide libc++_shared.so")
+ endif()
+ get_filename_component(_compiler_real "${CMAKE_CXX_COMPILER}" REALPATH)
+ get_filename_component(_compiler_bin "${_compiler_real}" DIRECTORY)
+ get_filename_component(_native_root "${_compiler_bin}/../.." ABSOLUTE)
+ if(NOT EXISTS "${_native_root}/NOTICE.txt")
+  message(FATAL_ERROR "The OHOS SDK native runtime NOTICE.txt is missing")
+ endif()
+ install(FILES "${BOULDER_CXX_RUNTIME}"
+   DESTINATION ${CMAKE_INSTALL_DATADIR}/boulder/harmony-project/entry/libs/arm64-v8a)
+ install(FILES "${_native_root}/NOTICE.txt" DESTINATION licenses/ohos-native-runtime)
+ add_library(boulderhost SHARED harmony/host.cpp harmony/game_runner.cpp ${COMMON} ${GAME})
+ add_library(editorhost SHARED harmony/host.cpp harmony/editor_runner.cpp ${COMMON} ${EDITOR})
+ target_compile_definitions(editorhost PRIVATE HOST_MODULE_NAME="editorhost")
+ foreach(target boulderhost editorhost)
+  boulder_target(${target})
+  set_target_properties(${target} PROPERTIES CXX_VISIBILITY_PRESET hidden C_VISIBILITY_PRESET hidden)
+  target_link_libraries(${target} PRIVATE ace_napi.z hilog_ndk.z)
+  install(TARGETS ${target} LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/boulder)
+ endforeach()
+ install(DIRECTORY harmony/project/ DESTINATION ${CMAKE_INSTALL_DATADIR}/boulder/harmony-project)
+endif()
+
+if(BUILD_TESTING)
+ add_test(NAME assets COMMAND boulder-check assets "${CMAKE_CURRENT_SOURCE_DIR}/exe/data")
+ add_test(NAME map-roundtrip COMMAND boulder-check roundtrip
+   "${CMAKE_CURRENT_SOURCE_DIR}/exe/data" "${CMAKE_CURRENT_BINARY_DIR}/roundtrip.map")
+ add_test(NAME missing-assets COMMAND boulder-check assets "${CMAKE_CURRENT_BINARY_DIR}/does-not-exist")
+ set_tests_properties(missing-assets PROPERTIES WILL_FAIL TRUE)
+endif()
