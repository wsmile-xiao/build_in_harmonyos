--- /dev/null
+++ b/harmony/editor_runner.cpp
@@ -0,0 +1,27 @@
+#define main boulder_editor_desktop_main
+#include "../src/editor/mapedit.cpp"
+#undef main
+#include <atomic>
+#include <string>
+#include <unistd.h>
+extern void HostReport(const std::string &);
+
+void RunBoulder(const std::string &files, std::atomic<bool> &running) {
+    if (chdir(files.c_str()) != 0) { HostReport("Cannot enter app files directory"); return; }
+    C_Global::Init("tiledesc.txt", "Boulder");
+    snprintf(C_Global::szAppDataPath, sizeof(C_Global::szAppDataPath), "%s", files.c_str());
+    if (!C_Global::szDataPath[0]) { HostReport("Editor resources not found"); return; }
+    g_bLButton = g_bRButton = g_bRedraw = false;
+    g_dAccTime = 0;
+    g_pControl = new C_Control();
+    g_pEditor = new C_Editor();
+    const std::string map = files + "/newlevel.map";
+    if (g_pEditor->IsInited() && g_pEditor->Open(map.c_str())) {
+        g_pEditor->RedrawScreen();
+        HostReport("Map editor running; S saves newlevel.map");
+        while (running && !HandleEvents()) { Update(); mssleep(10); }
+    } else HostReport(std::string("Editor initialization failed: ") + SDL_GetError());
+    delete g_pEditor; g_pEditor = nullptr;
+    delete g_pControl; g_pControl = nullptr;
+    SDL_Quit();
+}
