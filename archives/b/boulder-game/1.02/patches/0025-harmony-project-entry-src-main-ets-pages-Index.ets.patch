--- /dev/null
+++ b/harmony/project/entry/src/main/ets/pages/Index.ets
@@ -0,0 +1,59 @@
+import nativeHost from 'libboulderhost.so';
+import { common } from '@kit.AbilityKit';
+import { prepareAssets } from './PrepareAssets';
+class SurfaceController extends XComponentController {
+  filesDir: string = '';
+  onSurfaceCreated(surfaceId: string): void {
+    nativeHost.start(surfaceId, 1024, 768, this.filesDir);
+  }
+  onSurfaceDestroyed(surfaceId: string): void {
+    nativeHost.stop();
+  }
+}
+@Entry
+@Component
+struct Index {
+  private controller: SurfaceController = new SurfaceController();
+  private timer: number = -1;
+  @State statusText: string = 'Waiting for native window';
+  aboutToAppear(): void {
+    const context = this.getUIContext().getHostContext() as common.UIAbilityContext;
+    prepareAssets(context);
+    this.controller.filesDir = context.filesDir;
+    this.timer = setInterval(() => { this.statusText = nativeHost.status(); }, 500);
+  }
+  aboutToDisappear(): void {
+    clearInterval(this.timer);
+    nativeHost.stop();
+  }
+  build() {
+    Column({ space: 12 }) {
+      Button('Back to home').onClick(() => {
+        nativeHost.stop();
+        this.getUIContext().getRouter().back();
+      })
+      Text('Boulder v1.02').fontSize(22)
+      Text(this.statusText).fontSize(14)
+      XComponent({ id: 'boulder-surface', type: XComponentType.SURFACE, controller: this.controller })
+        .width('1024px').height('768px')
+        .focusable(true).defaultFocus(true)
+        .onBlur(() => { nativeHost.releaseInput(); })
+        .onTouch((event: TouchEvent) => {
+          if (event.touches.length > 0) {
+            const point = event.touches[0];
+            const action = event.type === TouchType.Down ? 1 : event.type === TouchType.Move ? 0 : 2;
+            nativeHost.pointer(action, 1, Math.round(this.getUIContext().vp2px(point.x)), Math.round(this.getUIContext().vp2px(point.y)));
+          }
+        })
+        .onKeyEvent((event: KeyEvent) => {
+          nativeHost.key(event.keyCode, event.type === KeyType.Down);
+          event.stopPropagation();
+        })
+        .onMouse((event: MouseEvent) => {
+          const action = event.action === MouseAction.Press ? 1 : event.action === MouseAction.Release ? 2 : 0;
+          const button = event.button === MouseButton.Right ? 3 : event.button === MouseButton.Middle ? 2 : 1;
+          nativeHost.pointer(action, button, Math.round(this.getUIContext().vp2px(event.x)), Math.round(this.getUIContext().vp2px(event.y)));
+        })
+    }.width('100%').height('100%').padding(20)
+  }
+}
