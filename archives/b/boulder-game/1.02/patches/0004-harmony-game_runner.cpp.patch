--- /dev/null
+++ b/harmony/game_runner.cpp
@@ -0,0 +1,26 @@
+#define main boulder_desktop_main
+#include "../src/boulder/boulder.cpp"
+#undef main
+#include <atomic>
+#include <string>
+#include <unistd.h>
+extern void HostReport(const std::string &);
+
+void RunBoulder(const std::string &files, std::atomic<bool> &running) {
+    if (chdir(files.c_str()) != 0) { HostReport("Cannot enter app files directory"); return; }
+    C_Global::Init("gui_desc0.txt", "Boulder");
+    snprintf(C_Global::szAppDataPath, sizeof(C_Global::szAppDataPath), "%s", files.c_str());
+    if (!C_Global::szDataPath[0]) { HostReport("Boulder resources not found"); return; }
+    HostReport(std::string("Boulder resources: ") + C_Global::szDataPath);
+    g_pGame = new C_Game();
+    if (g_pGame->IsInited()) {
+        HostReport("Boulder v1.02 running");
+        while (running && !g_pGame->Update()) {
+            g_pGame->DrawScreen();
+            mssleep(1);
+        }
+    } else HostReport(std::string("Boulder initialization failed: ") + SDL_GetError());
+    delete g_pGame;
+    g_pGame = nullptr;
+    SDL_Quit();
+}
