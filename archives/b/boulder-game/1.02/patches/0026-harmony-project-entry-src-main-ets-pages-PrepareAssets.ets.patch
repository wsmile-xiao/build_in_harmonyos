+import { common } from '@kit.AbilityKit';
+import { fileIo as fs } from '@kit.CoreFileKit';
+
+export function prepareAssets(context: common.UIAbilityContext): void {
+  const encoded = context.resourceManager.getRawFileContentSync('boulder-files.json');
+  let manifest = '';
+  encoded.forEach((value: number) => { manifest += String.fromCharCode(value); });
+  const paths: string[] = JSON.parse(manifest) as string[];
+  const root = context.filesDir + '/data';
+  if (!fs.accessSync(root)) fs.mkdirSync(root);
+  paths.forEach((path: string) => {
+    const target = root + '/' + path;
+    const slash = target.lastIndexOf('/');
+    const directory = target.substring(0, slash);
+    if (!fs.accessSync(directory)) fs.mkdirSync(directory, true);
+    const bytes = context.resourceManager.getRawFileContentSync('boulder/' + path);
+    const file = fs.openSync(target, fs.OpenMode.CREATE | fs.OpenMode.WRITE_ONLY | fs.OpenMode.TRUNC);
+    try { fs.writeSync(file.fd, bytes.buffer); } finally { fs.closeSync(file); }
+  });
+}
