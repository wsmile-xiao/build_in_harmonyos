diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,39 +1,40 @@
 all: bchunk
 
-# For systems with GCC (Linux, and others with GCC installed):
-CC = gcc
-LD = gcc
-CFLAGS = -Wall -Wstrict-prototypes -O2
+# For OpenHarmony (use clang instead of gcc)
+CC = clang
+LD = clang
+CFLAGS = -Wall -Wstrict-prototypes -O2 -fPIC
+LDFLAGS = -L$(PREFIX)/lib
 
-# For systems with a legacy CC:
-#CC = cc
-#LD = cc
-#CFLAGS = -O
+# Installation prefix (can be overridden)
+PREFIX ?= /usr/local
+BIN_DIR = $(PREFIX)/bin
+MAN_DIR = $(PREFIX)/share/man
 
-# For BSD install: Which install to use and where to put the files
-INSTALL = install
-PREFIX  = /usr/local
-BIN_DIR = $(PREFIX)/bin
-MAN_DIR = $(PREFIX)/man
+# Use cp instead of install command (OpenHarmony doesn't have install)
+INSTALL = cp
 
 .c.o:
 	$(CC) $(CFLAGS) -c $<
 
 clean:
 	rm -f *.o *~ *.bak core
 distclean: clean
 	rm -f bchunk
 
 install: installbin installman
 installbin:
-	$(INSTALL) -m 755 -s -o root -g root bchunk		$(BIN_DIR)
+	mkdir -p $(DESTDIR)$(BIN_DIR)
+	$(INSTALL) bchunk $(DESTDIR)$(BIN_DIR)/bchunk
+	chmod 755 $(DESTDIR)$(BIN_DIR)/bchunk
 installman:
-	$(INSTALL) -m 644 -o bin -g bin bchunk.1	 	$(MAN_DIR)/man1
+	mkdir -p $(DESTDIR)$(MAN_DIR)/man1
+	$(INSTALL) bchunk.1 $(DESTDIR)$(MAN_DIR)/man1/bchunk.1
+	chmod 644 $(DESTDIR)$(MAN_DIR)/man1/bchunk.1
 
 BITS = bchunk.o
 
 bchunk: $(BITS)
 	$(LD) $(LDFLAGS) -o bchunk $(BITS)
 
-bchunk.o:	bchunk.c
-
+bchunk.o: bchunk.c
