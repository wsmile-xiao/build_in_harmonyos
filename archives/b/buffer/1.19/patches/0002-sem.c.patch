 /* IMPORTS */
 
 /* Used to print error messages */
 extern void report_proc();
 
 /* Used to end the program - on error */
 extern void byee();
 
+/* 共享的信号量数组；交给调用方的 id 只是句柄，数组本身必须在进程间共享。 */
+static sem_t *sem_table = NULL;
+static int sem_table_size = 0;
 
+static sem_t *
+sem_lookup( sem_id, semn )
+	int sem_id;
+	int semn;
+{
+	if( sem_table == NULL || semn < 0 || semn >= sem_table_size ){
+		report_proc();
+		fprintf( stderr, "internal error, bad semaphore number %d\n", semn );
+		byee( -1 );
+	}
+	return &sem_table[ semn ];
+}
 
