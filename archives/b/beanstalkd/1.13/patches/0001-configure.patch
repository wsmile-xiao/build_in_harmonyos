diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,18 @@
+#!/bin/sh
+# beanstalkd has no configure script — this is a no-op wrapper for clean-verify
+# beanstalkd uses a simple Makefile without autotools/configure
+#
+# HarmonyOS platform adaptation:
+# - Create harmonyos.c symlink pointing to linux.c
+# - HarmonyOS is based on Linux kernel, supports epoll API
+
+echo "Note: beanstalkd uses Makefile directly, no configure step needed"
+echo "Creating harmonyos.c symlink for HarmonyOS platform..."
+
+# Create harmonyos.c symlink if it doesn't exist
+if [ ! -e harmonyos.c ]; then
+    ln -s linux.c harmonyos.c
+    echo "Created: harmonyos.c -> linux.c"
+fi
+
+exit 0
