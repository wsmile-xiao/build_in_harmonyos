+
+#if !defined(HAVE_MBEDTLS)
+/*
+ * No crypto backend is compiled in (mbedtls disabled): bctbx_clean() is declared
+ * BCTBX_PUBLIC in bctoolbox/crypto.h and referenced by the core (vfs.c), but its
+ * only upstream definitions live in the mbedtls backend files. Provide the same
+ * zeroization fallback used by upstream before mbedtls v2.10.
+ */
+void bctbx_clean(void *buffer, size_t size) {
+	volatile uint8_t *p = buffer;
+	while (size--)
+		*p++ = 0;
+}
