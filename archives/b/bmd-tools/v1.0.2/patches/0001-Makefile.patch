diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,16 +1,30 @@
-LIBUSB_CFLAGS += $(shell pkg-config --cflags libusb-1.0)
-LIBUSB_LDFLAGS += $(shell pkg-config --libs libusb-1.0)
-CFLAGS = -g -O3 #-Wall
+PREFIX ?= /usr/local
+DESTDIR ?=
+PKG_CONFIG ?= pkg-config
+
+LIBUSB_CFLAGS += $(shell $(PKG_CONFIG) --cflags libusb-1.0)
+LIBUSB_LDFLAGS += $(shell $(PKG_CONFIG) --libs libusb-1.0)
+
+CC ?= gcc
+CFLAGS ?= -g -O3
+CFLAGS += #-Wall
 
 TOOLS = bmd-streamer bmd-extractfw
 
 all: $(TOOLS)
 
 bmd-streamer: CFLAGS+=$(LIBUSB_CFLAGS)
 bmd-streamer: LDFLAGS+=$(LIBUSB_LDFLAGS) -lpthread -lm
 
 %: %.c
-	gcc $(CFLAGS) $< -o $@  $(LDFLAGS)
+	$(CC) $(CFLAGS) $< -o $@  $(LDFLAGS)
+
+install: all
+	$(INSTALL) -d $(DESTDIR)$(PREFIX)/bin
+	$(INSTALL) -m 755 bmd-streamer $(DESTDIR)$(PREFIX)/bin/
+	$(INSTALL) -m 755 bmd-extractfw $(DESTDIR)$(PREFIX)/bin/
 
 clean:
 	rm -f $(TOOLS)
+
+.PHONY: all install clean
