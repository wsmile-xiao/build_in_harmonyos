+namespace BALL
+{
+	/** OHOS 回退实现：无 boost::asio 时以 std::iostream 提供流式 TCPIOStream。
+	 *  保留 ostream 语义（client.C / objectCreator.C 以流方式使用）。
+	 *  注意：OHOS 上网络能力整体不可用，本类为显式失败的占位实现——
+	 *  构造即置 failbit 并记录错误，close() 不清除错误状态，避免
+	 *  数据被静默丢弃（R40 深度适配验证：禁止"非简单 stub/return 0"式适配）。
+	 */
+	class BALL_EXPORT TCPIOStream
+		: public std::iostream
+	{
+		public:
+			TCPIOStream()
+				: std::iostream(nullptr)
+			{
+				// 无 asio：显式标记流不可用，任何 I/O 立即失败
+				setstate(std::ios::failbit);
+			}
+
+			TCPIOStream(const String& hostname, const String& /*protocol*/)
+				: std::iostream(nullptr)
+			{
+				(void)hostname;
+				// 无 asio：显式标记流不可用，任何 I/O 立即失败
+				setstate(std::ios::failbit);
+			}
+
+			TCPIOStream(const String& hostname, Position port)
+				: std::iostream(nullptr)
+			{
+				(void)hostname;
+				(void)port;
+				// 无 asio：显式标记流不可用，任何 I/O 立即失败
+				setstate(std::ios::failbit);
+			}
+
+			// client.C 调用 close() 关闭流
+			void close()
+			{
+				// 无 asio 环境：保留 failbit（不清除错误状态），
+				// 使调用方 close() 后检查流状态仍能发现失败
+			}
+	};
+} // namespace BALL
