{
  "name": "bitcoin",
  "version": "31.1.1",
  "description": "Bitcoin Core - consensus engine / full node / wallet",
  "homepage": "https://bitcoincore.org/",
  "upstream_repo": "https://github.com/bitcoin/bitcoin",
  "license": "MIT",
  "type": "library",
  "build_system": "cmake",
  "cxx_standard": 20,
  "dependencies": {
    "sqlite3": "3.49.1",
    "libevent": "2.1.13",
    "boost": "1.84.0"
  },
  "build_options": {
    "BUILD_GUI": "OFF",
    "WITH_ZMQ": "OFF",
    "ENABLE_IPC": "OFF",
    "ENABLE_EXTERNAL_SIGNER": "OFF",
    "BUILD_BENCH": "OFF",
    "BUILD_FUZZ_BINARY": "OFF",
    "ENABLE_WALLET": "ON",
    "BUILD_TESTS": "ON"
  },
  "commands": {
    "conan_create": {
      "description": "Build and package bitcoin 31.1.1 for OHOS aarch64",
      "command": "conan create archives/b/bitcoin/31.1.1 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing",
      "env": [
        "export PATH=/storage/Users/currentUser/usr/local/bin:/data/service/hnp/bin:$PATH",
        "export TMPDIR=$HOME/tmp"
      ],
      "cwd": "/storage/Users/currentUser/build_in_harmonyos"
    },
    "build_and_test_sh": {
      "description": "Standard CI entrypoint via build_and_test.sh",
      "command": "CI_PACKAGES=archives/b/bitcoin/31.1.1 /usr/bin/zsh ci/conan/build_and_test.sh",
      "env": [
        "export PATH=/storage/Users/currentUser/usr/local/bin:/data/service/hnp/bin:$PATH",
        "export TMPDIR=$HOME/tmp"
      ],
      "cwd": "/storage/Users/currentUser/build_in_harmonyos"
    },
    "test_bitcoin_full": {
      "description": "Run full upstream test_bitcoin (734 cases, test_package test() phase)",
      "command": "<package_folder>/bin/test_bitcoin -- -testdatadir=$HOME/tmp/btc-test",
      "env": [
        "export TMPDIR=$HOME/tmp"
      ]
    },
    "test_bitcoin_isolated": {
      "description": "Run isolated upstream test suites (sandbox-safe)",
      "command": "<package_folder>/bin/test_bitcoin --run_test=addrman_tests -- -testdatadir=$HOME/tmp/btc-test",
      "env": [
        "export TMPDIR=$HOME/tmp"
      ],
      "alternative_suites": [
        "util_tests/parse_hex",
        "allocator_tests",
        "span_tests"
      ]
    }
  },
  "patches": {
    "count": 46,
    "type": "portability",
    "directory": "patches/",
    "numbering": "non-contiguous (0005-0055, gaps at 0001-0004/0015-0016/0028-0030)"
  },
  "test_package": {
    "assertion_count": 3,
    "upstream_test_in_build": true,
    "upstream_cases": 734,
    "test_binary": "test_bitcoin"
  }
}
