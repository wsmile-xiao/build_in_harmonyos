diff -ruN a/src/ohos-pthread-compat.c b/src/ohos-pthread-compat.c
--- a/src/ohos-pthread-compat.c	1970-01-01 00:00:00.000000000 +0000
+++ b/src/ohos-pthread-compat.c	2026-05-29 18:16:00.000000000 +0000
@@ -0,0 +1,33 @@
+/*
+ * OHOS pthread cancellation stubs
+ * OpenHarmony does not implement pthread_cancel() and pthread_setcancelstate().
+ * These stubs provide safe fallbacks for bluez-alsa compilation on OHOS.
+ *
+ * pthread_setcancelstate: No-op stub. Since thread cancellation is not
+ * supported on OHOS, the cancel state is irrelevant. We store/return
+ * PTHREAD_CANCEL_ENABLE as the "oldstate" for API compatibility.
+ *
+ * pthread_cancel: Returns ESRCH (no such thread) since cancellation
+ * is not supported. The bluez-alsa code already handles ESRCH gracefully.
+ */
+
+#ifdef __OHOS__
+
+#include <pthread.h>
+#include <errno.h>
+
+int pthread_setcancelstate(int state, int *oldstate) {
+	if (oldstate != NULL)
+		*oldstate = PTHREAD_CANCEL_ENABLE;
+	return 0;
+}
+
+int pthread_cancel(pthread_t thread) {
+	return ESRCH;
+}
+
+#endif /* __OHOS__ */