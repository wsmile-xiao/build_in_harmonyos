#====================================================================
# DRAFT-buildah-hongmeng-syscall-probe-sigsys
# HongMeng kernel kills Go binaries probing unimplemented syscalls (SIGSYS)
#====================================================================

id:                     DRAFT-buildah-hongmeng-syscall-probe-sigsys
trigger_tool:           go|runtime
phase:                  runtime
error_signature:        SIGSYS: bad system call|syscall\.Syscall\(0x1ac|unix\.OpenTree|HasNewMountAPI|HasOpenat2|open_tree|openat2
severity:               2
category:               go|kernel-syscall|harmonyos|containers
match_keywords:         SIGSYS, bad system call, OpenTree, openat2, HasNewMountAPI, HasOpenat2, pathrs-lite, filepath-securejoin, go-selinux, procfs.OpenProcRoot, GetRuntimeDir, buildah, podman, containers-storage
title:                  HongMeng kernel delivers SIGSYS (kills process) for unimplemented syscall numbers; Go syscall availability probes crash at startup

root_cause:             The HongMeng kernel delivers SIGSYS (killing the Go process) when an unimplemented syscall number such as open_tree(2)=428 or openat2(2)=437 is invoked, instead of returning -ENOSYS like Linux. Containers-ecosystem Go libraries (filepath-securejoin/pathrs-lite, go-selinux via config.Default) probe syscall availability by actually calling them, so the probe itself kills the process at startup. Synchronous SIGSYS cannot be safely caught by signal.Notify. Affects the buildah/podman/containers-storage family on HarmonyOS PC.

affected_scope:         Go containers ecosystem (buildah, podman, skopeo, cri-o and anything vendoring containers-storage or filepath-securejoin/pathrs-lite, or calling go-selinux CurrentLabel) on HarmonyOS PC.

verification_cmd:       buildah --version 2>&1 | head -3  # pre-patch: 'SIGSYS: bad system call' + Go panic trace; post-patch: 'buildah version 1.44.0 (image-spec 1.1.1, runtime-spec 1.3.0)'

rec_priority:           1
rec_approach:           runtime-uname-guard-legacy-path
rec_description:        Detect the HongMeng kernel at runtime (uname release contains 'HongMeng') and skip the syscall probes, taking the upstream legacy path (pathrs-lite HasNewMountAPI=false -> unsafeHostProcRoot; HasOpenat2=false -> openat fallback). Runtime capability detection, not a compile-time __OHOS__ macro (R8 compliant); plain-Linux behaviour unchanged.
rec_command:            git apply --check patches/0003-pathrs-lite-hongmeng-syscall-probes.patch && conan create . --build=missing
rec_auto_fix:           false
rec_impl:               none

fallback_priority:      2
fallback_approach:      force-legacy-vendor-patch
fallback_description:   When a runtime guard is undesirable, patch the vendored probe to unconditionally return the legacy path; document the security trade-off (loses new-mount-api hardening on real Linux 5.2+ hosts too).
fallback_command:       sed -n '1,20p' vendor/github.com/cyphar/filepath-securejoin/pathrs-lite/internal/linux/mount_linux.go
fallback_auto_fix:      false
