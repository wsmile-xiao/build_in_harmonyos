+package linux
+
+import (
+	"bytes"
+
+	"golang.org/x/sys/unix"
+)
+
+// hongMengKernel reports whether we are running on the HarmonyOS HongMeng
+// kernel. The HongMeng kernel delivers SIGSYS (killing the process) when an
+// unimplemented syscall number is invoked, instead of returning -ENOSYS the
+// way Linux does. Syscall availability probes (open_tree(2), openat2(2), ...)
+// therefore cannot be executed safely on it.
+func hongMengKernel() bool {
+	var uts unix.Utsname
+	if err := unix.Uname(&uts); err != nil {
+		return false
+	}
+	release := make([]byte, 0, len(uts.Release))
+	for _, c := range uts.Release {
+		if c == 0 {
+			break
+		}
+		release = append(release, byte(c))
+	}
+	return bytes.Contains(release, []byte("HongMeng"))
+}
