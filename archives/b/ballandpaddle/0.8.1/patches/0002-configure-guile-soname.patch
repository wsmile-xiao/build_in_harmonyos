# 0002-configure-guile-soname.patch — AC_CHECK_LIB 里写死的 guile soname 与
# 已发布的 guile/2.2.7 对不上
#
# 上游 configure.ac:29 是
#   AC_CHECK_LIB(guile, scm_boot_guile, LIBS="-lguile $LIBS", AC_MSG_ERROR(...))
# 即按 `-lguile` 去找库。Guile 1.8 时代的 soname 是 libguile.so，而 Guile 2.x
# 改成随 minor 走的 libguile-2.2.so（已发布的 guile/2.2.7 包的
# cpp_info.libs = ["guile-2.2"]，包内没有 libguile.so）。
#
# 结果：探针在 `checking for scm_boot_guile in -lguile` 处报
# "can't find guile. This software REQUIRES guile." 直接终止 configure ——
# 尽管 guile 已经通过 Conan 依赖链正确注入（-L / -I / -lguile-2.2 都在
# AutotoolsDeps 生成的 flags 里）。
#
# 源码本身用的就是 Guile 2.x 的 API（scm_to_locale_string / scm_from_int /
# scm_c_eval_string，见 src/extension.cpp、src/ball.cpp），所以这里只是把探针的
# 库名改成与 Guile 2.2 一致的 soname，不改任何行为。
#
# configure.ac 与生成的 configure 同步修改：本包不需要 autoreconf（官方 dist
# tarball 自带 configure），改 configure.ac 与 configure 一致只为让「源」与
# 「生成物」不脱节。
#
--- a/configure	2026-09-21 08:02:47.310388800 +0800
+++ b/configure	2026-09-21 08:02:47.048971300 +0800
@@ -6532,13 +6532,13 @@
 fi


-{ echo "$as_me:$LINENO: checking for scm_boot_guile in -lguile" >&5
-echo $ECHO_N "checking for scm_boot_guile in -lguile... $ECHO_C" >&6; }
+{ echo "$as_me:$LINENO: checking for scm_boot_guile in -lguile-2.2" >&5
+echo $ECHO_N "checking for scm_boot_guile in -lguile-2.2... $ECHO_C" >&6; }
 if test "${ac_cv_lib_guile_scm_boot_guile+set}" = set; then
   echo $ECHO_N "(cached) $ECHO_C" >&6
 else
   ac_check_lib_save_LIBS=$LIBS
-LIBS="-lguile  $LIBS"
+LIBS="-lguile-2.2  $LIBS"
 cat >conftest.$ac_ext <<_ACEOF
 /* confdefs.h.  */
 _ACEOF
@@ -6594,7 +6594,7 @@
 { echo "$as_me:$LINENO: result: $ac_cv_lib_guile_scm_boot_guile" >&5
 echo "${ECHO_T}$ac_cv_lib_guile_scm_boot_guile" >&6; }
 if test $ac_cv_lib_guile_scm_boot_guile = yes; then
-  LIBS="-lguile $LIBS"
+  LIBS="-lguile-2.2 $LIBS"
 else
   { { echo "$as_me:$LINENO: error: can't find guile. This software REQUIRES guile." >&5
 echo "$as_me: error: can't find guile. This software REQUIRES guile." >&2;}
--- a/configure.ac	2026-09-21 08:02:47.152458900 +0800
+++ b/configure.ac	2026-09-21 08:02:44.079638400 +0800
@@ -26,8 +26,8 @@
             LIBS="-lSDL_ttf $LIBS",
             AC_MSG_ERROR([library SDL_ttf not found]))

-AC_CHECK_LIB(guile, scm_boot_guile,
-            LIBS="-lguile $LIBS",
+AC_CHECK_LIB(guile-2.2, scm_boot_guile,
+            LIBS="-lguile-2.2 $LIBS",
             AC_MSG_ERROR(can't find guile. This software REQUIRES guile.))

 AC_CHECK_TOOL(WINDRES, windres)
