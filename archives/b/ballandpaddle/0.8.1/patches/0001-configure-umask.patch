# 0001-configure-umask.patch — configure 用 umask 077 造临时目录，HMDFS 下写不进去
#
# configure 把这段文本原样写进它生成的 config.status，而 config.status 用
#   (umask 077 && mktemp -d "./confXXXXXX")
# 建临时目录。HarmonyOS PC 的 HMDFS 挂载下 0700 目录对构建进程不可写
# （chmod 不生效，属主位形同虚设），表现为 configure 打印成功但 Makefile 从未
# 生成，或后续 `./confXXXXXX/subs-1.sed: Permission denied`。
#
# 纯可移植性修复：把两处 077 改成 022，不含任何平台宏。同仓库先例：
# archives/s/sdl_image/1.2.12 的 0001-configure.patch、archives/s/sdl-image/1.2.12。
#
--- a/configure	2026-09-21 08:02:43.212392900 +0800
+++ b/configure	2026-09-21 08:02:47.310388800 +0800
@@ -7360,12 +7360,12 @@
 # Create a (secure) tmp directory for tmp files.

 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 022 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -n "$tmp" && test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 022 && mkdir "$tmp")
 } ||
 {
    echo "$me: cannot create a temporary directory in ." >&2
