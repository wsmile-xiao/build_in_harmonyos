+/* Some systems enforce code-page integrity (XPM): making an executable
+   page writable is rejected outright (mprotect R|W|X fails with EINVAL,
+   mprotect R|W on an executable page kills the process), writes through
+   /proc/self/mem fail with EPERM, and MAP_FIXED over an executable
+   mapping is fatal. The self-exec + main-text-patchup handshake
+   (patch_main) requires exactly such a write, so it cannot work there.
+
+   Probe writability once, in a disposable child (the failure mode on
+   enforcing systems kills the process, so the parent must not probe
+   directly): the child makes the page of this very function writable and
+   rewrites the first byte with its own value. If the probe child exits
+   normally the handshake can run; if it dies on the way, the sandbox
+   runs its function directly in the forked child instead. */
+static int bxfi_probe_text_writable(void)
+{
+    long page = sysconf(_SC_PAGESIZE);
+
+    pid_t pid = fork();
+    if (pid == 0) {
+        uintptr_t fn = (uintptr_t) &bxfi_probe_text_writable;
+        void *base = (void *) (fn & ~((uintptr_t) page - 1));
+
+        if (mprotect(base, (size_t) page,
+                PROT_READ | PROT_WRITE | PROT_EXEC) == 0)
+            goto write_ok;
+
+        if (mprotect(base, (size_t) page, PROT_READ | PROT_WRITE) == 0) {
+write_ok:
+            /* volatile so the write cannot be optimized away: the probe
+               must actually exercise a store to the code page */
+            *(volatile unsigned char *) fn = *(volatile unsigned char *) fn;
+            _exit(0);
+        }
+        _exit(1);
+    }
+
+    int status;
+    pid_t rc;
+    do {
+        rc = waitpid(pid, &status, 0);
+    } while (rc == -1 && errno == EINTR);
+
+    return rc == pid && WIFEXITED(status) && WEXITSTATUS(status) == 0;
+}
