+
+# ifndef _WIN32
+/* Some systems (e.g. OpenHarmony) cap user-space VA well below the default
+   window: MAP_FIXED there fails with EINVAL, which made every arena
+   creation fail. Probe the default base once at runtime and fall back to
+   a low window when it is rejected; on systems where the default window
+   works nothing changes. The fallback spans [4 GiB, ~259 GiB) with a
+   16 MiB stride and 16384 slots, so every random draw stays in range. */
+static void bxfi_probe_mmap_window(void)
+{
+    long page = sysconf(_SC_PAGESIZE);
+
+    void *p = mmap(mmap_base, (size_t) page, PROT_READ | PROT_WRITE,
+            MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+    if (p == MAP_FAILED) {
+        mmap_base = (void *) 0x100000000;
+        mmap_max  = (void *) 0x4100000000;
+        mmap_off = (intptr_t) 1 << 24;
+        mmap_off_mask = 0x3fff;
+        return;
+    }
+    munmap(p, (size_t) page);
+}
+# endif
 #else
 # error Platform not supported
