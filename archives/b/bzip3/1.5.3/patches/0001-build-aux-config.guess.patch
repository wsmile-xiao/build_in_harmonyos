diff -ruN a/build-aux/config.guess b/build-aux/config.guess
--- a/build-aux/config.guess
+++ b/build-aux/config.guess
@@ -1,17 +1,24 @@
 #! /bin/sh
 # Attempt to guess a canonical system name.
 #   Copyright 1992-2022 Free Software Foundation, Inc.
 
 # shellcheck disable=SC2006,SC2268 # see below for rationale
 
 timestamp='2022-01-09'
+
+# HarmonyOS / OpenHarmony detection
+# Return aarch64-unknown-linux-gnu for HarmonyOS to avoid config.guess failures
+if test "x`uname -s 2>/dev/null`" = "xHarmonyOS" ; then
+    echo "aarch64-unknown-linux-gnu"
+    exit 0
+fi
 
