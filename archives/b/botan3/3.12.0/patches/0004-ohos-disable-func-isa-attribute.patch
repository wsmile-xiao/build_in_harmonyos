-#if BOTAN_COMPILER_HAS_ATTRIBUTE(target) && !defined(BOTAN_COMPILER_DOES_NOT_HAVE_TARGET_ATTRIBUTE)
+// OHOS clang-15 misparses multi-feature target attributes on AArch64: a
+// function tagged target("+crypto+aes+simd") is still treated as lacking
+// "+simd" (breaking the always_inline SIMD kernels), and arch=-prefixed
+// attribute strings are rejected outright. The global -march flag already
+// enables every feature these functions need, so disable the attribute
+// path entirely on this toolchain.
+#if 0
    #define BOTAN_FUNC_ISA(isa) BOTAN_COMPILER_ATTRIBUTE(target(isa))
 #else
    #define BOTAN_FUNC_ISA(isa)
