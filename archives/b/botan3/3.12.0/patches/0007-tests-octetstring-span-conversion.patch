--- a/src/tests/test_octetstring.cpp
+++ b/src/tests/test_octetstring.cpp
@@ -9,6 +9,16 @@
 #include <botan/rng.h>
 #include <botan/symkey.h>
 
+namespace {
+// OHOS libc++15's std::span container constructor only accepts containers
+// that expose .data(); Botan::OctetString provides begin()/end() and only
+// converts through the C++20 ranges-based constructor that newer libcs
+// implement. Bridge explicitly so test_bin_eq overload resolution works.
+std::span<const uint8_t> as_span(const Botan::OctetString& os) {
+   return std::span<const uint8_t>(os.begin(), os.end());
+}
+}  // namespace
+
 namespace Botan_Tests {
 
 namespace {
@@ -50,12 +60,12 @@
    Botan::OctetString os("FFFFFFFFFFFFFFFF");
    os.set_odd_parity();
    const Botan::OctetString expected("FEFEFEFEFEFEFEFE");
-   result.test_bin_eq("odd parity set correctly", os, expected);
+   result.test_bin_eq("odd parity set correctly", as_span(os), as_span(expected));
 
    Botan::OctetString os2("EFCBDA4FAA997F63");
    os2.set_odd_parity();
    const Botan::OctetString expected2("EFCBDA4FAB987F62");
-   result.test_bin_eq("odd parity set correctly", os2, expected2);
+   result.test_bin_eq("odd parity set correctly", as_span(os2), as_span(expected2));
 
    return result;
 }
