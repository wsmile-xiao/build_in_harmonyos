diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -1,5 +1,23 @@
 #!/bin/sh
 # Wrapper configure script for berkeley-db
-# This wrapper was placed by init-build to prevent _promote_nested_source from
-# incorrectly promoting the dist/ directory contents to the root level.
-exec "$(dirname "$0")/dist/configure" "$@"
+# Berkeley DB requires running configure from the build_unix directory.
+# This wrapper creates build_unix if needed, then runs dist/configure from there.
+# Also sets CC/CXX with -fuse-ld=bfd and adds --host to skip cross-compile detection,
+# because HMDFS requires ELF-signed binaries (unsigned binaries can't execute).
+
+# Set linker to ld.bfd (ld.lld fails due to libxml2.so.16 loading issue on HMDFS)
+export LD="ld.bfd"
+
+# Add -fuse-ld=bfd to CC/CXX so clang uses ld.bfd instead of ld.lld
+export CC="${CC:-clang} -fuse-ld=bfd"
+export CXX="${CXX:-clang++} -fuse-ld=bfd"
+
+# Get the directory where this script resides
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+
+# Create build_unix directory if it doesn't exist
+mkdir -p "$SCRIPT_DIR/build_unix" 2>/dev/null
+
+# Run dist/configure from build_unix directory with --host=aarch64-unknown-linux-ohos
+# to skip cross-compile detection (HMDFS unsigned binaries can't execute)
+cd "$SCRIPT_DIR/build_unix" && exec "$SCRIPT_DIR/dist/configure" --host=aarch64-unknown-linux-ohos "$@"
