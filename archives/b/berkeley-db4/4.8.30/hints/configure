#!/bin/sh
# berkeley-db configure wrapper for G0 clean-verify
# Berkeley DB needs to run configure from build_unix/ directory
# Also sets LD=ld.bfd to avoid lld's libxml2.so.16 dependency issue on HMDFS

# Set linker to ld.bfd (ld.lld fails due to libxml2.so.16 loading issue on HMDFS)
export LD="ld.bfd"

# Get the directory where this script resides
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Create build_unix directory if it doesn't exist
mkdir -p "$SCRIPT_DIR/build_unix" 2>/dev/null

# Run dist/configure from build_unix directory
cd "$SCRIPT_DIR/build_unix" && exec "$SCRIPT_DIR/dist/configure" "$@"
