--- a/Makefile
+++ b/Makefile
@@ -1,17 +1,44 @@
 #	$OpenBSD: Makefile,v 1.13 2020/12/15 00:50:01 daniel Exp $
+# Adapted for GNU make + HarmonyOS (OHOS) build.
+# The original uses bsd.prog.mk (OpenBSD). This version is GNU-make
+# compatible and does not require liblockfile/libbsd.
 
 PROG=	mail
+CC ?=	clang
+
+CFLAGS += -D_DEFAULT_SOURCE -D_BSD_SOURCE -g -Wall -O2
+
 SRCS=	version.c cmd1.c cmd2.c cmd3.c cmdtab.c collect.c \
 	edit.c fio.c head.c v7.local.c lex.c list.c main.c names.c \
-	popen.c quit.c send.c strings.c temp.c tty.c util.c vars.c
+	popen.c quit.c send.c strings.c temp.c tty.c util.c vars.c \
+	vis.c
+
+OBJS=$(SRCS:%.c=%.o)
+
 SFILES=	mail.help mail.tildehelp
 EFILES=	mail.rc
-LINKS=	${BINDIR}/mail ${BINDIR}/Mail ${BINDIR}/mail ${BINDIR}/mailx
+MFILES=	mail.1
 
-distribution:
-	cd ${.CURDIR}/misc; ${INSTALL} ${INSTALL_COPY} -o root -g wheel \
-	    -m 644 ${EFILES} ${DESTDIR}/etc
-	cd ${.CURDIR}/misc; ${INSTALL} ${INSTALL_COPY} -o ${BINOWN} -g ${BINGRP} \
-	    -m 444 ${SFILES} ${DESTDIR}/usr/share/misc
+BINDIR ?= bin
+MANDIR ?= share/man
+SYSCONFDIR ?= etc
+DATADIR ?= share/bsd-mailx
 
-.include <bsd.prog.mk>
+all: $(PROG)
+
+$(PROG): $(OBJS)
+	$(CC) $(LDFLAGS) -o $@ $(OBJS)
+
+.c.o:
+	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@
+
+clean:
+	rm -f $(PROG) $(OBJS) *~ core
+
+install:
+	mkdir -p $(DESTDIR)/$(BINDIR) $(DESTDIR)/$(MANDIR)/man1 $(DESTDIR)/$(SYSCONFDIR) $(DESTDIR)/$(DATADIR)
+	install -m 755 $(PROG) $(DESTDIR)/$(BINDIR)/bsd-mailx
+	install -m 644 $(MFILES) $(DESTDIR)/$(MANDIR)/man1/bsd-mailx.1
+	cd misc && install -m 644 $(EFILES) $(DESTDIR)/$(SYSCONFDIR)/
+	cd misc && install -m 644 mail.help $(DESTDIR)/$(DATADIR)/
+	cd misc && install -m 644 mail.tildehelp $(DESTDIR)/$(DATADIR)/
