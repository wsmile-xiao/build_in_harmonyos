+
+/* warnc() is BSD-specific; provide a compatible fallback */
+#ifndef HAVE_WARNC
+#include <stdarg.h>
+static void
+warnc(int code, const char *fmt, ...)
+{
+	va_list ap;
+	int serrno = errno;
+
+	errno = code;
+	va_start(ap, fmt);
+	vwarn(fmt, ap);
+	va_end(ap);
+	errno = serrno;
+}
+#endif
 
