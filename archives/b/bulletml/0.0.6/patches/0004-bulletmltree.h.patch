+// std::auto_ptr was removed in C++17.  This header is a public, consumer-visible
+// API header and the OHOS profile builds consumers with compiler.cppstd=17, so
+// provide a minimal layout-compatible shim (BULLETML_AUTO_PTR) for C++17
+// consumers.  The library itself is still built with the upstream C++98 flags,
+// where BULLETML_AUTO_PTR resolves to std::auto_ptr, keeping the ABI unchanged.
+// Bundled boost headers included afterwards (via bulletmlrunner.h) rely on this
+// macro instead of a separate compat header.
+#if __cplusplus >= 201703L
+namespace bulletml_compat {
+template <class T_>
+class auto_ptr {
+public:
+    auto_ptr() : ptr_(0) {}
+    explicit auto_ptr(T_* p) : ptr_(p) {}
+    auto_ptr(auto_ptr& o) : ptr_(o.release()) {}
+    ~auto_ptr() { delete ptr_; }
+    auto_ptr& operator=(auto_ptr& o) { reset(o.release()); return *this; }
+    T_* release() { T_* p = ptr_; ptr_ = 0; return p; }
+    void reset(T_* p = 0) { if (p != ptr_) { delete ptr_; ptr_ = p; } }
+    T_* get() const { return ptr_; }
+    T_* operator->() const { return ptr_; }
+    T_& operator*() const { return *ptr_; }
+private:
+    T_* ptr_;
+};
+}  // namespace bulletml_compat
+#define BULLETML_AUTO_PTR bulletml_compat::auto_ptr
+#else
+#define BULLETML_AUTO_PTR std::auto_ptr
+#endif
 
