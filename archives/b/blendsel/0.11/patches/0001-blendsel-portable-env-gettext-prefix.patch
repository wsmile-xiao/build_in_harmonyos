 use 5.014;
-use Locale::gettext;
 use Getopt::Long;
+# Locale::gettext is an XS module packaged by Debian
+# (liblocale-gettext-perl) and is not present on every platform
+# (e.g. OHOS).  Load it when available and fall back to
+# untranslated (English) output otherwise.
+my $have_gettext = 0;
+eval { require Locale::gettext; Locale::gettext->import();
+	$have_gettext = 1; };
+if (! $have_gettext) {
+	no strict 'refs';
+	*textdomain = sub { return 1; };
+	*gettext = sub { my $t = shift; return $t; };
+	*dgettext = sub { my ($d, $t) = @_; return $t; };
+}
 use warnings;
 use strict;
 textdomain('blendsel');
@@ -16,6 +28,19 @@
 my $localdescdir="/usr/local/share/blendsel/descs";
 my $statusfile="/var/lib/dpkg/status";
 my $infodir="/usr/lib/blendsel/info";
+# When blendsel is installed under a custom prefix (bin/.. layout,
+# e.g. a Conan package on OHOS), derive the data directories from the
+# script location so that the tool is relocation-free.  The standard
+# Debian layout (script in /usr/bin, data under /usr) is unchanged.
+if ($0 =~ m{^(.*)/bin/blendsel$}) {
+	my $prefix = $1;
+	$debconf_helper = "$prefix/lib/blendsel/blendsel-debconf";
+	$testdir = "$prefix/lib/blendsel/tests";
+	$packagesdir = "$prefix/lib/blendsel/packages";
+	$descdir = "$prefix/share/blendsel/descs";
+	$localdescdir = "$prefix/local/share/blendsel/descs";
+	$infodir = "$prefix/lib/blendsel/info";
+}
 
