diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,15 +1,18 @@
-CFLAGS		+=	-O3 -lbz2
+CFLAGS		?=	-O2 -Wall -fPIC
+LDFLAGS		=	-fuse-ld=bfd
 
 PREFIX		?=	/usr/local
-INSTALL_PROGRAM	?=	${INSTALL} -c -s -m 555
-INSTALL_MAN	?=	${INSTALL} -c -m 444
+DESTDIR		?=	
 
 all:		bsdiff bspatch
+
 bsdiff:		bsdiff.c
+	$(CC) $(CFLAGS) -I$(HOME)/usr/local/include bsdiff.c -o bsdiff $(LDFLAGS) -L$(HOME)/usr/local/lib -lbz2
+
 bspatch:	bspatch.c
+	$(CC) $(CFLAGS) -I$(HOME)/usr/local/include bspatch.c -o bspatch $(LDFLAGS) -L$(HOME)/usr/local/lib -lbz2
 
 install:
-	${INSTALL_PROGRAM} bsdiff bspatch ${PREFIX}/bin
-.ifndef WITHOUT_MAN
-	${INSTALL_MAN} bsdiff.1 bspatch.1 ${PREFIX}/man/man1
-.endif
+	mkdir -p ${DESTDIR}${PREFIX}/bin ${DESTDIR}${PREFIX}/man/man1
+	cp -f bsdiff bspatch ${DESTDIR}${PREFIX}/bin
+	cp -f bsdiff.1 bspatch.1 ${DESTDIR}${PREFIX}/man/man1
