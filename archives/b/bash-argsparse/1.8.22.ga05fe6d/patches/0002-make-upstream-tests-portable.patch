 	set | \
-		grep -vE '^(FIRST|SECOND|SHELLOPTS|FUNCNAME|_|LINENO|BASH_(ARG[CV]|LINENO|SOURCE|REMATCH)|PIPESTATUS)=' | \
+		grep -vE '^(FIRST|SECOND|SHELLOPTS|FUNCNAME|_|LINENO|BASH_(ARG[CV]|LINENO|SOURCE|REMATCH|TRAPSIG)|PIPESTATUS)=' | \
 		grep -vE '^before=' | \
 		grep -vE '^__argsparse_(options_descriptions|short_options|tmp_identifiers)=' | \
 		grep -vE '^argsparse_usage_description=' | \
@@ -322,12 +322,35 @@ declare -A types=(
 	[hexa]="0x123abc 71234 abc"
 	[ipv4]="192.168.40.254 127.0.0.1 1.2.3.4"
 	[ipv6]="2001:7a8:b018::1 ::1 2001:7a8:b018:0:21f:c6ff:fe59:71fd"
-	[username]=$(whoami)
-	[group]=$(id -gn)
-	[port]="ssh 80"
 	[portnumber]=1234
 )
 
+# NSS-backed checks are optional because minimal targets such as HarmonyOS PC
+# do not provide getent. Keep the numeric port case, which is self-contained.
+types[port]=80
+if command -v getent >/dev/null 2>&1
+then
+	if getent passwd "$(whoami)" >/dev/null 2>&1
+	then
+		types[username]=$(whoami)
+	else
+		: $((disabled++))
+	fi
+	if getent group "$(id -gn)" >/dev/null 2>&1
+	then
+		types[group]=$(id -gn)
+	else
+		: $((disabled++))
+	fi
+	if getent services ssh >/dev/null 2>&1
+	then
+		types[port]+=" ssh"
+	fi
+else
+	printf "getent unavailable: not testing username/group types.\n"
+	: $((disabled+=2))
+fi
+
 fifo="$dir/fifo"
 if mkfifo "$fifo"
 then
