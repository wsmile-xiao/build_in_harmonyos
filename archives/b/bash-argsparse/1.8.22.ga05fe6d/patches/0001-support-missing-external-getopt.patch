+## @fn __argsparse_normalize_arguments()
+## @private
+## @brief Normalize command-line arguments without the external getopt tool.
+## @details Produces the same option/value/--/parameter shape consumed by
+## __argsparse_parse_options_no_usage and stores it in
+## __argsparse_normalized_argv.
+__argsparse_normalize_arguments() {
+	local token long short cluster value has_inline_value
+	local -a normalized_options=()
+	local -a normalized_parameters=()
+
+	while [[ $# -gt 0 ]]
+	do
+		token=$1
+		shift
+		case "$token" in
+			--)
+				normalized_parameters+=( "$@" )
+				set --
+				;;
+			--?*)
+				long=${token#--}
+				has_inline_value=no
+				if [[ "$long" = *=* ]]
+				then
+					value=${long#*=}
+					long=${long%%=*}
+					has_inline_value=yes
+				fi
+				if ! __argsparse_has_array_item \
+					__argsparse_options_descriptions "$long"
+				then
+					printf >&2 "%s: unrecognized option '--%s'\n" \
+						"$argsparse_pgm" "$long"
+					return 1
+				fi
+				if argsparse_has_option_property "$long" value
+				then
+					if [[ "$has_inline_value" = no ]]
+					then
+						if [[ $# -eq 0 ]]
+						then
+							printf >&2 "%s: option '--%s' requires an argument\n" \
+								"$argsparse_pgm" "$long"
+							return 1
+						fi
+						value=$1
+						shift
+					fi
+					normalized_options+=( "--$long" "$value" )
+				elif [[ "$has_inline_value" = yes ]]
+				then
+					printf >&2 "%s: option '--%s' does not allow an argument\n" \
+						"$argsparse_pgm" "$long"
+					return 1
+				else
+					normalized_options+=( "--$long" )
+				fi
+				unset value
+				;;
+			-?*)
+				cluster=${token#-}
+				while [[ -n "$cluster" ]]
+				do
+					short=${cluster:0:1}
+					cluster=${cluster:1}
+					if ! __argsparse_has_array_item __argsparse_short_options "$short"
+					then
+						printf >&2 "%s: invalid option -- '%s'\n" \
+							"$argsparse_pgm" "$short"
+						return 1
+					fi
+					long=${__argsparse_short_options["$short"]}
+					if argsparse_has_option_property "$long" value
+					then
+						if [[ -n "$cluster" ]]
+						then
+							value=$cluster
+							cluster=
+						elif [[ $# -gt 0 ]]
+						then
+							value=$1
+							shift
+						else
+							printf >&2 "%s: option requires an argument -- '%s'\n" \
+								"$argsparse_pgm" "$short"
+							return 1
+						fi
+						normalized_options+=( "-$short" "$value" )
+						unset value
+					else
+						normalized_options+=( "-$short" )
+					fi
+				done
+				;;
+			*)
+				normalized_parameters+=( "$token" )
+				;;
+		esac
+	done
+
+	__argsparse_normalized_argv=(
+		"${normalized_options[@]}" -- "${normalized_parameters[@]}"
+	)
+}
+
 
