diff -ruN a/core/src/include/baconfig.h b/core/src/include/baconfig.h
--- a/core/src/include/baconfig.h
+++ b/core/src/include/baconfig.h
@@ -86,11 +86,14 @@
 #else    /* !ENABLE_NLS */
 #  undef T_
 #  undef textdomain
 #  undef bindtextdomain
 #  undef setlocale
 
 #  define T_(s) (s)
 #  define textdomain(d)
 #  define bindtextdomain(p, d)
-#  define setlocale(p, d)
+/* OHOS: no empty setlocale stub. An empty setlocale macro rewrites the
+   declaration in <locale.h> (char *setlocale(int, const char *)) and breaks
+   every TU that includes <locale> via libcxx __locale. OHOS provides real
+   setlocale(), which is harmless when NLS is off. */
 #endif /* ENABLE_NLS */
