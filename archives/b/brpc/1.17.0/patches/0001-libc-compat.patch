 void TaskControl::bind_thread_to_cpu(pthread_t pthread, unsigned cpu_id) {
-#if defined(OS_LINUX)
+#if defined(OS_LINUX) && !defined(__GLIBC__)
+        // pthread_setaffinity_np 是 glibc 的 GNU 扩展；musl 等仅提供
+        // sched_setaffinity(pid, ...) + pthread_gettid_np（_GNU_SOURCE），
+        // 组合实现等价的线程绑核。
+        cpu_set_t cs;
+        CPU_ZERO(&cs);
+        CPU_SET(cpu_id, &cs);
+        auto r = sched_setaffinity(pthread_gettid_np(pthread), sizeof(cs), &cs);
+        if (r != 0) {
+            LOG(WARNING) << "Failed to bind thread to cpu: " << cpu_id;
+        }
+        (void)r;
+#elif defined(OS_LINUX)
         cpu_set_t cs;
         CPU_ZERO(&cs);
         CPU_SET(cpu_id, &cs);
