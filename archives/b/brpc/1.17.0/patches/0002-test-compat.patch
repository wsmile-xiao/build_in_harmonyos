+# 追加回显式配置的原 flags（由 -DCMAKE_CXX_FLAGS 传入的初始值保存在 BRPC_EXTRA_CXX_FLAGS）。
+if(BRPC_EXTRA_CXX_FLAGS)
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${BRPC_EXTRA_CXX_FLAGS}")
+endif()
