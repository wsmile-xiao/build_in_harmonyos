 set(KF_VERSION "6.25.0") # handled by release scripts
-set(KF_DEP_VERSION "6.25.0") # handled by release scripts
+set(KF_DEP_VERSION "6.14.0") # OHOS patch 0001: floor lowered to published KF baseline
 
