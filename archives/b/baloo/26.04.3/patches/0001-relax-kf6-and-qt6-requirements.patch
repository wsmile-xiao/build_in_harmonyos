+if (TARGET Qt6::Qml)
+    add_subdirectory(qml)
+endif()
 
 if (BUILD_KINOTIFY)
     add_subdirectory(file)
-    add_subdirectory(kioworkers)
     add_subdirectory(tools)
 endif()
 
+# kio_baloo* workers (timeline/tags/search/kded) are the only KIO users;
+# KIO is an OPTIONAL component (not published for OHOS), so skip the
+# directory when the KF6 KIO component was not found.
+if (BUILD_KINOTIFY AND KF6_KIO_FOUND)
+    add_subdirectory(kioworkers)
+endif()
+
 add_subdirectory(dbus)
 
 ecm_qt_install_logging_categories(
diff -ruN a/src/engine/andpostingiterator.cpp b/src/engine/andpostingiterator.cpp
--- a/src/engine/andpostingiterator.cpp	2026-04-04 01:06:54.000000000 +0800
+++ b/src/engine/andpostingiterator.cpp	2026-09-05 23:08:35.454272656 +0800
@@ -16,9 +16,10 @@
     : m_iterators(std::move(iterators))
     , m_docId(0)
 {
-    if (std::ranges::any_of(m_iterators, [](const auto &e) {
-            return e == nullptr;
-        })) {
+    // OHOS: libc++15 disables std::ranges algorithms
+    // (_LIBCPP_HAS_NO_INCOMPLETE_RANGES); use C++11 std::any_of instead.
+    if (std::any_of(m_iterators.begin(), m_iterators.end(),
+                    [](const auto &e) { return e == nullptr; })) {
         m_iterators.clear();
     }
 }
