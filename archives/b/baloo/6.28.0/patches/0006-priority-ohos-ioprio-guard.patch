--- a/src/file/priority.cpp
+++ b/src/file/priority.cpp
@@ -17,13 +17,25 @@
 #include <sys/syscall.h>
 #include <unistd.h>
 
-#ifdef SYS_ioprio_set
-#include <linux/ioprio.h>
+// OHOS adaptation: the musl-based OHOS sysroot defines SYS_ioprio_set but
+// does not ship the glibc-specific <linux/ioprio.h> header (which provides
+// IOPRIO_WHO_PROCESS / ioprio_value). Guard the include on header
+// availability so the ioprio path compiles only where the full API exists;
+// on OHOS lowerIOPriority() degrades to returning false (best-effort
+// hinting only, callers treat failure as non-fatal).
+#if defined(SYS_ioprio_set) && defined(__has_include)
+#  if __has_include(<linux/ioprio.h>)
+#    include <linux/ioprio.h>
+#    define BALOO_HAVE_IOPRIO 1
+#  endif
+#elif defined(SYS_ioprio_set)
+#  include <linux/ioprio.h>
+#  define BALOO_HAVE_IOPRIO 1
 #endif
 
 bool lowerIOPriority()
 {
-#ifdef SYS_ioprio_set
+#ifdef BALOO_HAVE_IOPRIO
     if (syscall(SYS_ioprio_set, IOPRIO_WHO_PROCESS, 0, ioprio_value(IOPRIO_CLASS_IDLE, 0, IOPRIO_HINT_NONE)) >= 0) {
         return true;
     }
