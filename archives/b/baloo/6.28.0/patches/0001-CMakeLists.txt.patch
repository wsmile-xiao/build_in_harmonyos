@@ -63,7 +70,49 @@
 # set up build dependencies
 find_package(Qt6 ${REQUIRED_QT_VERSION} REQUIRED NO_MODULE COMPONENTS Core DBus Widgets Qml Quick Test)
 
-find_package(KF6 ${KF_DEP_VERSION} REQUIRED COMPONENTS CoreAddons Config DBusAddons I18n IdleTime Solid FileMetaData Crash KIO)
+# OHOS adaptation: drop KIO from the required component set (only the
+# kioworkers link KF6::KIOCore and the kioworkers are not built on
+# OHOS - kio is not published to the ohpcd registry).
+find_package(KF6 ${KF_DEP_VERSION} REQUIRED COMPONENTS CoreAddons Config DBusAddons I18n IdleTime Solid FileMetaData Crash)
+
+# R05/E537: relocatable linkage. The KF6 dependency libraries published on
+# ohpcd carry no DT_SONAME, so linking baloo's libraries against their
+# absolute Conan cache paths would record machine-private paths in DT_NEEDED
+# (non-consumable on a different cache layout, kpackage 6.18.0.1 precedent).
+# Stamp an IMPORTED_SONAME on each SONAME-less KF6 dependency and clear both
+# the generic and per-config IMPORTED_NO_SONAME so CMake links by
+# -L<dir> -l:libKF6*.so and ld records the basename. KF6::FileMetaData ships
+# a proper SONAME (libKF6FileMetaData.so.3) and needs no treatment.
+foreach(kf6dep
+    KF6::CoreAddons KF6::ConfigCore KF6::DBusAddons KF6::I18n
+    KF6::IdleTime KF6::Solid KF6::Crash
+)
+    if(TARGET ${kf6dep})
+        set_property(TARGET ${kf6dep} PROPERTY IMPORTED_NO_SONAME FALSE)
+        set_property(TARGET ${kf6dep} PROPERTY IMPORTED_NO_SONAME_RELEASE FALSE)
+    endif()
+endforeach()
+if(TARGET KF6::CoreAddons)
+    set_property(TARGET KF6::CoreAddons PROPERTY IMPORTED_SONAME "libKF6CoreAddons.so")
+endif()
+if(TARGET KF6::ConfigCore)
+    set_property(TARGET KF6::ConfigCore PROPERTY IMPORTED_SONAME "libKF6ConfigCore.so")
+endif()
+if(TARGET KF6::DBusAddons)
+    set_property(TARGET KF6::DBusAddons PROPERTY IMPORTED_SONAME "libKF6DBusAddons.so")
+endif()
+if(TARGET KF6::I18n)
+    set_property(TARGET KF6::I18n PROPERTY IMPORTED_SONAME "libKF6I18n.so")
+endif()
+if(TARGET KF6::IdleTime)
+    set_property(TARGET KF6::IdleTime PROPERTY IMPORTED_SONAME "libKF6IdleTime.so")
+endif()
+if(TARGET KF6::Solid)
+    set_property(TARGET KF6::Solid PROPERTY IMPORTED_SONAME "libKF6Solid.so")
+endif()
+if(TARGET KF6::Crash)
+    set_property(TARGET KF6::Crash PROPERTY IMPORTED_SONAME "libKF6Crash.so")
+endif()
 
 find_package(LMDB)
 set_package_properties(LMDB
