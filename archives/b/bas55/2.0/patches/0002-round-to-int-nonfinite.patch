@@ -11,6 +11,7 @@
 #include <assert.h>
 #include <ctype.h>
 #include <limits.h>
+#include <math.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -107,6 +108,12 @@
 
 int round_to_int(double d)
 {
+	/* (int) 对 inf/nan 是未定义行为：glibc 上 (int)inf 得 INT_MIN，
+	 * 但其他 libc（如 OHOS）结果不同，导致 TAB(溢出值) 的警告分支
+	 * 缺失。这里显式返回 INT_MIN，与 glibc 行为一致并消除 UB。 */
+	if (!isfinite(d)) {
+		return INT_MIN;
+	}
 	return (int) m_round(d);
 }
 
