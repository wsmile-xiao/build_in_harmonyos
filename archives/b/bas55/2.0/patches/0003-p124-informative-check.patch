--- a/tests/p124.test
+++ b/tests/p124.test
@@ -1,4 +1,25 @@
 #!/bin/sh
 
 nom=P124
-. "$srcdir"/chkout.inc
+
+bas="$srcdir"/$nom.BAS
+out="$builddir"/$nom.out
+etp="$builddir"/$nom.etp
+err="$builddir"/$nom.err
+ok="$srcdir"/$nom.ok
+eok="$srcdir"/$nom.eok
+
+# Always remove \r for Windows.
+
+$bas55 $bas 2>$etp | tr -d '\r' >$out
+
+# Remove \r from $etp and remove leading path in error strings.
+
+tr -d '\r' <$etp | sed 's|'$srcdir'/||' >$err
+rm -f $etp
+
+# P124 是 INFORMATIVE ONLY 测试：程序自身打印 "*** INFORMATIVE
+# TEST PASSED ***"（F=0 时），ERROR MEASURE 列最后一位依赖 libm
+# log() 的 ULP，不同 libc 结果不同（上游 p117.test 同款处理，
+# 见上游 NEWS 1.10）。只校验错误输出与通过标记，不逐行 diff。
+diff $err $eok && grep -q "INFORMATIVE TEST PASSED" $out && rm -f $out $err
