diff -ruN a/hidapi/libusb/hid.c b/hidapi/libusb/hid.c
--- a/hidapi/libusb/hid.c
+++ b/hidapi/libusb/hid.c
@@ -0,0 +1,170 @@
+/*******************************************************
+ * HIDAPI stub for HarmonyOS
+ * All USB HID functions return error / NULL.
+ * This allows blink1-tool to compile and run its
+ * non-USB features (--version, --help, etc.).
+ * USB device access is not available on this platform.
+ *******************************************************/
+
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Provide export/call macros if not defined by header */
+#ifndef HID_API_EXPORT
+#define HID_API_EXPORT
+#endif
+#ifndef HID_API_CALL
+#define HID_API_CALL
+#endif
+/* HID_API_EXPORT_CALL is defined by hidapi.h itself; do not redefine */
+
+#include "../hidapi/hidapi.h"
+
+int hid_init(void) {
+    return 0; /* success */
+}
+
+int hid_exit(void) {
+    return 0; /* success */
+}
+
+struct hid_device_info *hid_enumerate(unsigned short vendor_id,
+                                      unsigned short product_id) {
+    (void)vendor_id;
+    (void)product_id;
+    return NULL; /* no devices */
+}
+
+void hid_free_enumeration(struct hid_device_info *devs) {
+    (void)devs;
+}
+
+hid_device *hid_open(unsigned short vendor_id, unsigned short product_id,
+                     const wchar_t *serial_number) {
+    (void)vendor_id;
+    (void)product_id;
+    (void)serial_number;
+    return NULL;
+}
+
+hid_device *hid_open_path(const char *path) {
+    (void)path;
+    return NULL;
+}
+
+int hid_write(hid_device *device, const unsigned char *data, size_t length) {
+    (void)device;
+    (void)data;
+    (void)length;
+    return -1;
+}
+
+int hid_read_timeout(hid_device *device, unsigned char *data,
+                     size_t length, int milliseconds) {
+    (void)device;
+    (void)data;
+    (void)length;
+    (void)milliseconds;
+    return 0;
+}
+
+int hid_read(hid_device *device, unsigned char *data, size_t length) {
+    (void)device;
+    (void)data;
+    (void)length;
+    return 0;
+}
+
+int hid_set_nonblocking(hid_device *device, int nonblock) {
+    (void)device;
+    (void)nonblock;
+    return -1;
+}
+
+int hid_send_feature_report(hid_device *device, const unsigned char *data,
+                             size_t length) {
+    (void)device;
+    (void)data;
+    (void)length;
+    return -1;
+}
+
+int hid_get_feature_report(hid_device *device, unsigned char *data,
+                           size_t length) {
+    (void)device;
+    (void)data;
+    (void)length;
+    return -1;
+}
+
+int hid_send_output_report(hid_device *device, const unsigned char *data,
+                           size_t length) {
+    (void)device;
+    (void)data;
+    (void)length;
+    return -1;
+}
+
+int hid_get_input_report(hid_device *device, unsigned char *data,
+                          size_t length) {
+    (void)device;
+    (void)data;
+    (void)length;
+    return -1;
+}
+
+void hid_close(hid_device *device) {
+    (void)device;
+}
+
+int hid_get_manufacturer_string(hid_device *device, wchar_t *string,
+                                size_t maxlen) {
+    (void)device;
+    (void)string;
+    (void)maxlen;
+    return -1;
+}
+
+int hid_get_product_string(hid_device *device, wchar_t *string,
+                           size_t maxlen) {
+    (void)device;
+    (void)string;
+    (void)maxlen;
+    return -1;
+}
+
+int hid_get_serial_number_string(hid_device *device, wchar_t *string,
+                                 size_t maxlen) {
+    (void)device;
+    (void)string;
+    (void)maxlen;
+    return -1;
+}
+
+struct hid_device_info *hid_get_device_info(hid_device *device) {
+    (void)device;
+    return NULL;
+}
+
+int hid_get_indexed_string(hid_device *device, int string_index,
+                           wchar_t *string, size_t maxlen) {
+    (void)device;
+    (void)string_index;
+    (void)string;
+    (void)maxlen;
+    return -1;
+}
+
+int hid_get_report_descriptor(hid_device *device, unsigned char *buf,
+                               size_t buf_size) {
+    (void)device;
+    (void)buf;
+    (void)buf_size;
+    return -1;
+}
+
+const wchar_t *hid_error(hid_device *device) {
+    (void)device;
+    return L"USB HID not available on this platform";
+}
