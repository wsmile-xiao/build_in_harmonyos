# Exercise the same DejaGNU execution path used by the upstream suites.
set shell sh
if {[info exists env(CONFIG_SHELL)]} {
    set shell $env(CONFIG_SHELL)
}

set result [remote_exec host $shell [list -c {printf transport-ok}]]
if {[lindex $result 0] == 0 && [lindex $result 1] eq "transport-ok"} {
    pass "local command stdout"
} else {
    fail "local command stdout: $result"
}

set result [remote_exec host $shell [list -c {printf transport-error >&2; exit 7}]]
if {[lindex $result 0] > 0 && [string match "*transport-error*" [lindex $result 1]]} {
    pass "local command stderr and negative exit"
} else {
    fail "local command stderr and negative exit: $result"
}

set failed 0
for {set i 0} {$i < 256} {incr i} {
    set result [remote_exec host $shell [list -c {printf cycle-ok}]]
    if {[lindex $result 0] != 0 || [lindex $result 1] ne "cycle-ok"} {
        set failed 1
        verbose -log "pipe cycle $i failed: $result"
        break
    }
}
if {$failed} {
    fail "256 local command lifecycles"
} else {
    pass "256 local command lifecycles"
}

set result [remote_exec host mkdir [list -p transport-tmpdir]]
if {[lindex $result 0] == 0 && [file isdirectory transport-tmpdir]} {
    pass "local mkdir for compiler probes"
} else {
    fail "local mkdir for compiler probes: $result"
}

set fd [open transport-output.txt w]
puts $fd "gas output fixture"
close $fd
spawn -open [open transport-output.txt r]
set matched 0
expect {
    -re "gas output fixture\r?\n" { set matched 1; exp_continue }
    eof {}
    timeout { set matched 0 }
}
catch {close}
catch {wait}
if {$matched} {
    pass "GAS output-file Expect channel"
} else {
    fail "GAS output-file Expect channel"
}
