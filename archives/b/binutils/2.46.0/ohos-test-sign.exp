# Native OHOS only: use the platform signer immediately before test execution.
proc binutils_prepare_program {program} {
    if {![file isfile $program]} {return}
    set path [file normalize $program]
    set temporary [file normalize tmpdir]
    if {![string match "$temporary/*" $path]} {return}
    _binutils_unsigned_exec python3 $::env(BINUTILS_OHOS_SIGNER) $path
}

proc binutils_prepare_command {words} {
    set program [lindex $words 0]
    if {[file tail $program] in {sh bash zsh} && [lindex $words 1] eq "-c"} {
        # run_host_cmd uses a shell with one simple leading program, followed
        # by arguments/redirections. Read that pathname without evaluating it.
        if {![regexp {^([^ \t;|&]+)} [lindex $words 2] -> program]} {return}
    }
    binutils_prepare_program $program
}

rename exec _binutils_unsigned_exec
proc exec {args} {
    set index 0
    while {$index < [llength $args] && [string match -* [lindex $args $index]]} {incr index}
    binutils_prepare_command [lrange $args $index end]
    return [uplevel 1 [list _binutils_unsigned_exec {*}$args]]
}
rename remote_exec _binutils_unsigned_remote_exec
proc remote_exec {destination commandline args} {
    binutils_prepare_command $commandline
    return [uplevel 1 [list _binutils_unsigned_remote_exec $destination $commandline {*}$args]]
}
rename remote_load _binutils_unsigned_remote_load
proc remote_load {destination program args} {
    binutils_prepare_program $program
    return [uplevel 1 [list _binutils_unsigned_remote_load $destination $program {*}$args]]
}
rename spawn _binutils_unsigned_spawn
proc spawn {args} {
    set index 0
    while {$index < [llength $args] && [string match -* [lindex $args $index]]} {incr index}
    binutils_prepare_command [lrange $args $index end]
    return [uplevel 1 [list _binutils_unsigned_spawn {*}$args]]
}
puts "OHOS-TEST: native test ELF signing enabled"
