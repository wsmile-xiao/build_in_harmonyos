# HarmonyOS DejaGNU site configuration: avoid unavailable terminal setup.
if {[info commands _binutils_orig_spawn] eq ""} {
    rename spawn _binutils_orig_spawn
    proc spawn {args} {
        # SFrame's host_execute consumes output records from a batch program;
        # unlike local_exec, it invokes spawn itself rather than remote_exec.
        if {[info exists ::env(BINUTILS_OHOS_TEST_PIPES)]
            && $::env(BINUTILS_OHOS_TEST_PIPES) eq "1"
            && [lindex $args 0] eq "-noecho"
            && [string match "*testsuite/libsframe.*" [lindex $args 1]]} {
            set channel [open [concat [list |] [lrange $args 1 end] [list 2>@1]] r]
            try {
                return [uplevel 1 [list _binutils_orig_spawn -open $channel]]
            } on error {message options} {
                catch {close $channel}
                return -options $options $message
            }
        }
        if {[lsearch -exact $args -nottyinit] == -1} {
            set args [linsert $args 0 -nottyinit]
        }
        return [uplevel 1 [list _binutils_orig_spawn {*}$args]]
    }
    puts "SITE-FIX: spawn wrapped with -nottyinit"
}

# Use DejaGNU's own pipe transport for non-interactive local commands.
# It already handles stderr, timeouts, close/wait and failing exit statuses.
if {[info exists env(BINUTILS_OHOS_TEST_PIPES)]
    && $env(BINUTILS_OHOS_TEST_PIPES) eq "1"
    && [info commands _binutils_orig_local_exec] eq ""} {
    load_lib remote.exp
    rename local_exec _binutils_orig_local_exec
    proc local_exec {commandline inp outp timeout} {
        if {$inp eq "" && $outp eq ""} {
            set inp /dev/null
        }
        return [_binutils_orig_local_exec $commandline $inp $outp $timeout]
    }
    puts "SITE-FIX: local non-interactive commands use DejaGNU pipes"
}

if {[info exists env(BINUTILS_OHOS_SIGNER)]
    && [info commands _binutils_unsigned_exec] eq ""} {
    source [file join [file dirname $env(BINUTILS_OHOS_SIGNER)] ohos-test-sign.exp]
}
