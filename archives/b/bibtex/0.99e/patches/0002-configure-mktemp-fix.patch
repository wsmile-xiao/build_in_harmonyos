--- a/texk/kpathsea/configure	2026-08-24 17:46:16.381656875 +0800
+++ b/texk/kpathsea/configure	2026-08-24 17:46:16.805655469 +0800
@@ -17539,11 +17539,11 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
-  test -d "$tmp"
+  tmp=./conf$$-$$
+  (umask 077 && mkdir "$tmp") && test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
+  tmp=./conf$$-$$
   (umask 077 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
