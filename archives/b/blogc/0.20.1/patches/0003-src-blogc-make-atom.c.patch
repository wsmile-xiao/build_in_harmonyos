--- a/src/blogc-make/atom.c
+++ b/src/blogc-make/atom.c
@@ -91,47 +91,53 @@
     if (settings == NULL || err == NULL || *err != NULL)
         return NULL;
 
     if (NULL != bc_trie_lookup(settings->settings, "atom_legacy_entry_id")) {
         *err = bc_error_new_printf(BLOGC_MAKE_ERROR_ATOM,
