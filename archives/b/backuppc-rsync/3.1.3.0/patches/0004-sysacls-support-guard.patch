--- a/lib/sysacls.c
+++ b/lib/sysacls.c
@@ -23,6 +23,15 @@
 
 #include "rsync.h"
 #include "sysacls.h"
+
+/* rsync >= 3.2 wraps this whole file in SUPPORT_ACLS: Makefile.in compiles
+ * lib/sysacls.o unconditionally, so platforms without any ACL API (e.g.
+ * HarmonyOS/musl, where configure finds no POSIX ACL functions) would hit
+ * the "#error No ACL functions defined" fallback below. When SUPPORT_ACLS
+ * is undefined, acls.c provides its own no-op stubs and nothing else
+ * references the helpers here (verified: SAFE_FREE/no_acl_syscall_error
+ * are used only within this file). Same approach as upstream rsync. */
+#ifdef SUPPORT_ACLS
 
 #ifdef DEBUG
 #undef DEBUG
@@ -2790,3 +2799,5 @@
 	}
 	return 0;
 }
+
+#endif /* SUPPORT_ACLS */
