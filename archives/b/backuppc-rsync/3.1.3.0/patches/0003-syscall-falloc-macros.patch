+/* HarmonyOS portability: configure probes FALLOC_FL_* via <linux/falloc.h>,
+ * but rsync-bpc disabled that include in rsync.h ("#if 0" around the fallocate
+ * preallocation block) and the platform libc fcntl.h does not declare
+ * FALLOC_FL_ZERO_RANGE, so do_punch_hole() failed to compile. Include the
+ * kernel UAPI header here like upstream rsync >= 3.2 does, and require the
+ * FALLOC_FL_* macros to be truly visible before using them so that the
+ * zero-writing fallback below stays available when they are not. */
+#ifdef HAVE_LINUX_FALLOC_H
+#include <linux/falloc.h>
+#endif
+
 extern int dry_run;
 extern int am_root;
 extern int am_sender;
