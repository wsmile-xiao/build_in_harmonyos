diff -ruN a/ohos-toolchain.cmake b/ohos-toolchain.cmake
--- a/ohos-toolchain.cmake
+++ b/ohos-toolchain.cmake
@@ -0,0 +1,26 @@
+# HarmonyOS CMake Toolchain File
+# 用于为 HarmonyOS/OpenHarmony 平台编译三方库
+
+set(CMAKE_SYSTEM_NAME OHOS)
+set(CMAKE_SYSTEM_PROCESSOR aarch64)
+
+# 编译器设置
+set(CMAKE_C_COMPILER clang)
+set(CMAKE_CXX_COMPILER clang++)
+
+# 工具设置
+set(CMAKE_AR llvm-ar)
+set(CMAKE_RANLIB llvm-ranlib)
+
+# 编译标志
+set(CMAKE_C_FLAGS "-fPIC -O2" CACHE STRING "C flags")
+set(CMAKE_CXX_FLAGS "-fPIC -O2" CACHE STRING "CXX flags")
+
+# 不搜索主机系统的程序和库
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
+
+# 设置搜索路径
+set(CMAKE_FIND_ROOT_PATH "$ENV{DEFAULT_PREFIX}")