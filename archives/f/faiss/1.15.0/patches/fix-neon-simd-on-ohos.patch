--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -78,6 +78,15 @@
   DESCRIPTION "A library for efficient similarity search and clustering of dense vectors."
   HOMEPAGE_URL "https://github.com/facebookresearch/faiss"
   LANGUAGES ${FAISS_LANGUAGES})
+# HarmonyOS (CMAKE_SYSTEM_NAME=HarmonyOS) has no CMake Platform module, so
+# project() above leaves CMAKE_SYSTEM_PROCESSOR as "unknown".  The faiss SIMD
+# source selection at the bottom of faiss/CMakeLists.txt regex-matches
+# CMAKE_SYSTEM_PROCESSOR against (aarch64|arm64|ARM64) to decide whether the
+# 10 ARM NEON translation units are compiled into libfaiss.a.  Without this
+# override the NEON branch is never taken and the TUs are silently dropped.
+if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS" AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "(aarch64|arm64|ARM64)")
+  set(CMAKE_SYSTEM_PROCESSOR "aarch64")
+endif()
 include(GNUInstallDirs)
 
 set(CMAKE_CXX_STANDARD 20)
