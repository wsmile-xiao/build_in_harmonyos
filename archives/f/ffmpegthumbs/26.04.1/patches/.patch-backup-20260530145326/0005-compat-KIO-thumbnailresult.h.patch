--- /dev/null
+++ compat/KIO/thumbnailresult.h
@@ -0,0 +1,71 @@
+/*
+    SPDX-FileCopyrightText: OpenHarmony compatibility shim
+    SPDX-License-Identifier: LGPL-2.0-or-later
+
+    Compatibility header for KIO::ThumbnailResult and KIO::ThumbnailRequest
+    Provides minimal interface for FFmpeg thumbnailer plugin
+*/
+
+#ifndef KIO_THUMBNAILRESULT_H
+#define KIO_THUMBNAILRESULT_H
+
+#include <QImage>
+#include <QUrl>
+#include <QSize>
+
+namespace KIO
+{
+
+class ThumbnailRequest
+{
+public:
+    ThumbnailRequest() : m_url(), m_targetSize(128, 128), m_sequenceIndex(0) {}
+    ThumbnailRequest(const QUrl &url, const QSize &targetSize, int sequenceIndex)
+        : m_url(url), m_targetSize(targetSize), m_sequenceIndex(sequenceIndex) {}
+
+    QUrl url() const { return m_url; }
+    QSize targetSize() const { return m_targetSize; }
+    float sequenceIndex() const { return static_cast<float>(m_sequenceIndex); }
+
+private:
+    QUrl m_url;
+    QSize m_targetSize;
+    int m_sequenceIndex;
+};
+
+class ThumbnailResult
+{
+public:
+    static ThumbnailResult pass(const QImage &image) {
+        ThumbnailResult r;
+        r.m_image = image;
+        r.m_valid = true;
+        return r;
+    }
+
+    static ThumbnailResult fail() {
+        ThumbnailResult r;
+        r.m_valid = false;
+        return r;
+    }
+
+    QImage image() const { return m_image; }
+    bool isValid() const { return m_valid; }
+    bool isNull() const { return m_image.isNull(); }
+
+    void setSequenceIndexWraparoundPoint(float point) {
+        m_sequenceIndexWraparoundPoint = point;
+    }
+
+    float sequenceIndexWraparoundPoint() const {
+        return m_sequenceIndexWraparoundPoint;
+    }
+
+private:
+    ThumbnailResult() : m_valid(false), m_sequenceIndexWraparoundPoint(0.0f) {}
+    QImage m_image;
+    bool m_valid;
+    float m_sequenceIndexWraparoundPoint;
+};
+
+} // namespace KIO
+
+#endif // KIO_THUMBNAILRESULT_H