+++ compat/ffmpeg_compat.h	2026-05-30 11:50:34.929890000 +0800
@@ -0,0 +1,33 @@
+/*
+    SPDX-FileCopyrightText: OpenHarmony compatibility shim
+    SPDX-License-Identifier: LGPL-2.0-or-later
+
+    Compatibility macros for FFmpeg API differences between version 4.x and 6.x
+*/
+
+#ifndef FFMPEG_COMPAT_H
+#define FFMPEG_COMPAT_H
+
+#include <libavcodec/avcodec.h>
+#include <libavutil/frame.h>
+
+/* AV_FRAME_FLAG_KEY was introduced in FFmpeg 6.x (AVCODEC 60.x) */
+#if LIBAVCODEC_VERSION_MAJOR < 60
+#define AV_FRAME_FLAG_KEY (1 << 0)
+#endif
+
+/* AV_FRAME_FLAG_INTERLACED was introduced in FFmpeg 6.x */
+#if LIBAVCODEC_VERSION_MAJOR < 60
+#define AV_FRAME_FLAG_INTERLACED (1 << 1)
+#endif
+
+/* nb_coded_side_data and coded_side_data were introduced in FFmpeg 6.x
+   In FFmpeg 4.x, side data on codec parameters is not available through this API.
+   The display matrix side data was stored differently. */
+#if LIBAVCODEC_VERSION_MAJOR < 60
+#define HAVE_OLD_SIDE_DATA_API 1
+#else
+#define HAVE_OLD_SIDE_DATA_API 0
+#endif
+
+#endif /* FFMPEG_COMPAT_H */
