 #elif FOONATHAN_HOSTED_IMPLEMENTATION
 #include <cstdlib>
 #include <memory>
 
 void* foonathan::memory::heap_alloc(std::size_t size) noexcept
 {
+#if defined(__unix__)
+    void* memory = nullptr;
+    auto allocation_size = size != 0 ? size : 1;
+    if (posix_memalign(&memory, detail::max_alignment, allocation_size) != 0)
+        return nullptr;
+    return memory;
+#else
     return std::malloc(size);
+#endif
 }
 
 void foonathan::memory::heap_dealloc(void* ptr, std::size_t) noexcept
 {
     std::free(ptr);
 }
 
