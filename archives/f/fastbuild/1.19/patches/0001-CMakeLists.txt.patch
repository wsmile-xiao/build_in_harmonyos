diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -0,0 +1,187 @@
+cmake_minimum_required(VERSION 3.16)
+project(fastbuild VERSION 1.19 LANGUAGES C CXX)
+
+# Release build by default
+if(NOT CMAKE_BUILD_TYPE)
+    set(CMAKE_BUILD_TYPE Release)
+endif()
+
+# C++17 standard (as per fastbuild's .bff config)
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+# Core compiler flags adapted from Clang15.bff for ARM64/musl
+# -fno-rtti, -fno-exceptions as per fastbuild config
+# -D__LINUX__ for platform detection
+# -DRELEASE for Release config
+# NO -m64 (x86_64 only)
+# NO -Wl,--wrap=__libc_start_main (glibc compat, not needed on musl)
+
+# Common definitions
+add_compile_definitions(__LINUX__)
+
+if(CMAKE_BUILD_TYPE STREQUAL "Release")
+    add_compile_definitions(RELEASE)
+elseif(CMAKE_BUILD_TYPE STREQUAL "Profile")
+    add_compile_definitions(RELEASE PROFILING_ENABLED)
+elseif(CMAKE_BUILD_TYPE STREQUAL "Debug")
+    add_compile_definitions(DEBUG PROFILING_ENABLED)
+endif()
+
+# C++ compiler options (from .bff - adapted for ARM64)
+add_compile_options(
+    $<$<COMPILE_LANGUAGE:CXX>:-fno-rtti>
+    $<$<COMPILE_LANGUAGE:CXX>:-fno-exceptions>
+    -g
+)
+
+# Warning options (from .bff)
+add_compile_options(
+    -Wall
+    -Wextra
+    -Werror
+    -Wfatal-errors
+)
+
+# Suppressed warnings (from .bff)
+add_compile_options(
+    -Wno-c++98-compat-pedantic
+    -Wno-disabled-macro-expansion
+    -Wno-exit-time-destructors
+    -Wno-global-constructors
+    -Wno-gnu-line-marker
+    -Wno-gnu-zero-variadic-macro-arguments
+    -Wno-invalid-offsetof
+    -Wno-missing-prototypes
+    -Wno-missing-variable-declarations
+    -Wno-padded
+    -Wno-switch-enum
+    -Wno-documentation-unknown-command
+    -Wno-atomic-implicit-seq-cst
+    -Wno-cast-align
+    -Wno-cast-qual
+    -Wno-deprecated-copy-dtor
+    -Wno-missing-noreturn
+    -Wno-old-style-cast
+    -Wno-reserved-identifier
+    -Wno-shorten-64-to-32
+    -Wno-weak-vtables
+)
+
+# Source directories (relative to Code/)
+set(CODE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/Code)
+
+# ============================================================
+# External libraries
+# ============================================================
+
+# LZ4 library (only lz4.c, lz4hc.c, xxhash.c as per .bff)
+add_library(lz4 STATIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/External/LZ4/lz4-1.10.0/lib/lz4.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/External/LZ4/lz4-1.10.0/lib/lz4hc.c
+    ${CMAKE_CURRENT_SOURCE_DIR}/External/LZ4/lz4-1.10.0/lib/xxhash.c
+)
+target_include_directories(lz4 PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/External/LZ4/lz4-1.10.0/lib
+)
+# LZ4 compiled with -O2 even in debug (as per .bff) + suppress all warnings
+target_compile_options(lz4 PRIVATE -O2 -w)
+
+# xxHash library (only xxhash.c; skip xxh_x86dispatch.c on ARM64 as per .bff)
+add_library(xxhash STATIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/External/xxHash/0.8.2/xxhash.c
+)
+target_include_directories(xxhash PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/External/xxHash/0.8.2
+)
+# xxHash definitions: namespace prefix + disable static_assert (as per .bff)
+# Note: XXH_STATIC_ASSERT(x)= is a function-style macro, must use compile_options
+target_compile_options(xxhash PRIVATE
+    -O2 -w
+    "-DXXH_NAMESPACE=xxHashLib_"
+    "-DXXH_STATIC_ASSERT(x)="
+)
+
+# Zstd library
+set(ZSTD_DIR ${CMAKE_CURRENT_SOURCE_DIR}/External/Zstd/zstd-1.5.7/lib)
+add_library(zstd STATIC
+    # common
+    ${ZSTD_DIR}/common/debug.c
+    ${ZSTD_DIR}/common/entropy_common.c
+    ${ZSTD_DIR}/common/error_private.c
+    ${ZSTD_DIR}/common/fse_decompress.c
+    ${ZSTD_DIR}/common/pool.c
+    ${ZSTD_DIR}/common/threading.c
+    ${ZSTD_DIR}/common/xxhash.c
+    ${ZSTD_DIR}/common/zstd_common.c
+    # compress
+    ${ZSTD_DIR}/compress/fse_compress.c
+    ${ZSTD_DIR}/compress/hist.c
+    ${ZSTD_DIR}/compress/huf_compress.c
+    ${ZSTD_DIR}/compress/zstd_compress.c
+    ${ZSTD_DIR}/compress/zstd_compress_literals.c
+    ${ZSTD_DIR}/compress/zstd_compress_sequences.c
+    ${ZSTD_DIR}/compress/zstd_compress_superblock.c
+    ${ZSTD_DIR}/compress/zstd_double_fast.c
+    ${ZSTD_DIR}/compress/zstd_fast.c
+    ${ZSTD_DIR}/compress/zstd_lazy.c
+    ${ZSTD_DIR}/compress/zstd_ldm.c
+    ${ZSTD_DIR}/compress/zstd_opt.c
+    ${ZSTD_DIR}/compress/zstd_preSplit.c
+    ${ZSTD_DIR}/compress/zstdmt_compress.c
+    # decompress
+    ${ZSTD_DIR}/decompress/huf_decompress.c
+    ${ZSTD_DIR}/decompress/zstd_ddict.c
+    ${ZSTD_DIR}/decompress/zstd_decompress.c
+    ${ZSTD_DIR}/decompress/zstd_decompress_block.c
+)
+target_include_directories(zstd PUBLIC
+    ${ZSTD_DIR}
+    ${ZSTD_DIR}/common
+)
+# Zstd compiled with -O2 + ZSTD_DISABLE_ASM + ZSTD_MULTITHREAD (as per .bff) + suppress warnings
+target_compile_definitions(zstd PRIVATE ZSTD_DISABLE_ASM ZSTD_MULTITHREAD)
+target_compile_options(zstd PRIVATE -O2 -w)
+
+# ============================================================
+# Core library
+# ============================================================
+file(GLOB_RECURSE CORE_SOURCES ${CODE_DIR}/Core/*.cpp)
+# Exclude CoreTest
+list(FILTER CORE_SOURCES EXCLUDE REGEX "CoreTest")
+
+add_library(core STATIC ${CORE_SOURCES})
+target_include_directories(core PUBLIC ${CODE_DIR})
+target_compile_definitions(core PRIVATE __LINUX__ RELEASE)
+
+# ============================================================
+# FBuildCore library
+# ============================================================
+file(GLOB_RECURSE FBUILD_CORE_SOURCES ${CODE_DIR}/Tools/FBuild/FBuildCore/*.cpp)
+# Exclude test data and fuzzer
+list(FILTER FBUILD_CORE_SOURCES EXCLUDE REGEX "FBuildTest")
+list(FILTER FBUILD_CORE_SOURCES EXCLUDE REGEX "BFFFuzzer")
+
+add_library(fbuildcore STATIC ${FBUILD_CORE_SOURCES})
+target_include_directories(fbuildcore PUBLIC
+    ${CODE_DIR}
+    ${CMAKE_CURRENT_SOURCE_DIR}/External/LZ4/lz4-1.10.0/lib
+    ${CMAKE_CURRENT_SOURCE_DIR}/External/Zstd/zstd-1.5.7/lib
+    ${CMAKE_CURRENT_SOURCE_DIR}/External/VSProjTypeExtractor
+)
+target_compile_definitions(fbuildcore PRIVATE __LINUX__ RELEASE)
+target_link_libraries(fbuildcore PUBLIC core lz4 xxhash zstd)
+
+# ============================================================
+# fbuild executable
+# ============================================================
+add_executable(fbuild ${CODE_DIR}/Tools/FBuild/FBuild/Main.cpp)
+target_include_directories(fbuild PRIVATE ${CODE_DIR})
+target_compile_definitions(fbuild PRIVATE __LINUX__ RELEASE)
+target_link_libraries(fbuild PRIVATE fbuildcore core lz4 xxhash zstd)
+# Linux linker options from .bff (no --wrap=__libc_start_main on musl)
+target_link_options(fbuild PRIVATE -pthread)
+target_link_libraries(fbuild PRIVATE dl rt)
+
+# Install
+install(TARGETS fbuild DESTINATION bin)
