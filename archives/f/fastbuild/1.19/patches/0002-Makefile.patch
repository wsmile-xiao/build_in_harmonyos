diff -ruN /dev/null b/Makefile
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,16 @@
+# Makefile wrapper — delegates to CMake build directory
+# This allows standard `make` and `make install` commands to work with CMake
+
+BUILD_DIR = build-cmake
+DESTDIR ?=
+
+all:
+	$(MAKE) -C $(BUILD_DIR)
+
+install:
+	$(MAKE) -C $(BUILD_DIR) install DESTDIR=$(DESTDIR)
+
+clean:
+	$(MAKE) -C $(BUILD_DIR) clean
+
+.PHONY: all install clean
