diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,74 @@
+#!/bin/bash
+# configure wrapper for CMake-based build
+# Translates autotools-style configure arguments to cmake arguments
+#
+# This wrapper allows the project to work with standard build conventions
+# while using CMake underneath.
+
+CMAKE_ARGS=""
+BUILD_DIR="build-cmake"
+PREFIX="/usr/local"
+
+# Parse configure-style arguments
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*)
+            PREFIX="${1#--prefix=}"
+            CMAKE_ARGS="$CMAKE_ARGS -DCMAKE_INSTALL_PREFIX=$PREFIX"
+            ;;
+        --prefix)
+            shift
+            PREFIX="$1"
+            CMAKE_ARGS="$CMAKE_ARGS -DCMAKE_INSTALL_PREFIX=$PREFIX"
+            ;;
+        -DCMAKE*)
+            CMAKE_ARGS="$CMAKE_ARGS $1"
+            ;;
+        *)
+            # Pass other arguments as cmake definitions
+            CMAKE_ARGS="$CMAKE_ARGS -D$1"
+            ;;
+    esac
+    shift
+done
+
+# Default prefix if not specified
+if [ -z "$CMAKE_ARGS" ]; then
+    CMAKE_ARGS="-DCMAKE_INSTALL_PREFIX=$PREFIX"
+fi
+
+# Ensure build type is Release
+CMAKE_ARGS="$CMAKE_ARGS -DCMAKE_BUILD_TYPE=Release"
+
+mkdir -p "$BUILD_DIR"
+
+echo "Configuring with cmake..."
+cd "$BUILD_DIR"
+cmake .. $CMAKE_ARGS
+CONFIGURE_RC=$?
+
+cd ..
+
+# Create Makefile wrapper in source root
+if [ $CONFIGURE_RC -eq 0 ]; then
+    cat > Makefile << 'MAKEFILE_EOF'
+# Makefile wrapper — delegates to CMake build directory
+# This allows standard `make` and `make install` commands to work with CMake
+
+BUILD_DIR = build-cmake
+DESTDIR ?=
+
+all:
+	$(MAKE) -C $(BUILD_DIR)
+
+install:
+	$(MAKE) -C $(BUILD_DIR) install DESTDIR=$(DESTDIR)
+
+clean:
+	$(MAKE) -C $(BUILD_DIR) clean
+
+.PHONY: all install clean
+MAKEFILE_EOF
+fi
+
+exit $CONFIGURE_RC
