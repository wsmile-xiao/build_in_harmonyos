+++ b/Code/Core/Env/Assert.h
@@ -13,7 +13,13 @@
 #elif defined( __APPLE__ )
     #define BREAK_IN_DEBUGGER __builtin_trap();
 #elif defined( __LINUX__ )
-    #define BREAK_IN_DEBUGGER __asm__ __volatile__("int $3")
+    #if defined( __i386__ ) || defined( __x86_64__ )
+        #define BREAK_IN_DEBUGGER __asm__ __volatile__("int $3")
