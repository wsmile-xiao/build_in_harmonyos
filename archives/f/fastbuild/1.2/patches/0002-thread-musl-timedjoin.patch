diff --git a/Code/Core/Process/Thread.cpp b/Code/Core/Process/Thread.cpp
index 866cd5c..3839752 100644
--- a/Code/Core/Process/Thread.cpp
+++ b/Code/Core/Process/Thread.cpp
@@ -228,6 +228,7 @@ public:
         (void)timeoutMS; // TODO:MAC Implement timeout support
         return WaitForThread( handle );
     #elif defined( __LINUX__ )
+    #if defined( __GLIBC__ )
         // timeout is specified in absolute time
         // - get current time
         struct timespec abstime;
@@ -244,7 +245,7 @@ public:
             abstime.tv_sec += 1;
         }
 
-        // join thread with timeout
+        // join thread with timeout (glibc GNU extension)
         void * ret;
         int retVal = pthread_timedjoin_np( (pthread_t)handle, &ret, &abstime );
         if ( ( retVal == EBUSY ) || ( retVal == ETIMEDOUT ) )
@@ -261,6 +262,17 @@ public:
         ASSERT( false ); // a non-timeout error indicates usage failure
         timedOut = false;
         return 0;
+    #else
+        // libc without pthread_timedjoin_np (e.g. musl on OHOS, which also
+        // lacks pthread_tryjoin_np): fall back to a blocking join, mirroring
+        // the Apple path below (timeout unsupported there too).
+        // All in-tree timed waits assert timedOut == false; the only true
+        // timeout consumer (DNS lookup in Network.cpp) degrades to waiting
+        // for completion, which stays correct. TODO:MUSL timeout support.
+        timedOut = false;
+        (void)timeoutMS;
+        return WaitForThread( handle );
+    #endif
     #else
         #error Unknown platform
     #endif
