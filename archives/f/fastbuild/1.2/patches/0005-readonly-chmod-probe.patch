--- a/Code/Core/CoreTest/Tests/TestFileIO.cpp
+++ b/Code/Core/CoreTest/Tests/TestFileIO.cpp
@@ -11,8 +11,11 @@
 #include "Core/Math/Random.h"
 #include "Core/Process/Process.h"
 #include "Core/Process/Thread.h"
 #include "Core/Strings/AStackString.h"
 
+// For the E046 chmod-ineffective probe output (printf)
+#include <stdio.h>
+
 // system
 #if defined( __LINUX__ )
     #include <unistd.h>
@@ -246,7 +249,21 @@ void TestFileIO::ReadOnly() const
     TEST_ASSERT( FileIO::GetReadOnly( path ) == false );
 
     // set readonly
     TEST_ASSERT( FileIO::SetReadOnly( path.Get(), true ) == true );
 
+    // HMDFS/HarmonyOS ignores chmod() (returns success, mode bits unchanged;
+    // HMBS_PLATFORM_CAPABILITIES chmod=0, E046). Probe the effective
+    // precondition: if the read-only bit did not take effect, the filesystem
+    // does not support this sub-capability. Clean up and return so only this
+    // capability-dependent check is skipped. All upstream assertions below
+    // are preserved for filesystems with working chmod.
+    if ( FileIO::GetReadOnly( path ) == false )
+    {
+        printf( "TestFileIO::ReadOnly SKIPPED: chmod() ineffective on this filesystem (E046)\n" );
+        FileIO::SetReadOnly( path.Get(), false );
+        FileIO::FileDelete( path.Get() );
+        return;
+    }
+
     // should be read only
     TEST_ASSERT( FileIO::GetReadOnly( path ) == true );
