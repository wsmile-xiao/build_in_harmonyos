diff --git a/src/qsieve.h b/src/qsieve.h
index 7f65824..4542e4b 100644
--- a/src/qsieve.h
+++ b/src/qsieve.h
@@ -179,6 +179,10 @@ typedef struct
    FLINT_FILE * siqs;           /* pointer to file for storing relations */
    char * fname;          /* name of file used for relations */
 
+/* Buffer size for the qsieve temp file path (TMPDIR may be longer
+   than /tmp, e.g. on OHOS). */
+#define QSIEVE_FNAME_SIZE 1024
+
    slong full_relation;   /* number of full relations */
    slong num_cycles;      /* number of possible full relations from partials */
 
diff --git a/src/qsieve/factor.c b/src/qsieve/factor.c
index 93930ef..0c59638 100644
--- a/src/qsieve/factor.c
+++ b/src/qsieve/factor.c
@@ -234,7 +234,13 @@ void qsieve_factor_with_tune(fmpz_factor_t factors, const fmpz_t n,
     if (qs_inf->siqs == NULL)
         flint_throw(FLINT_ERROR, "fopen failed\n");
 #else
-    strcpy(qs_inf->fname, "/tmp/siqsXXXXXX"); /* must be shorter than fname_alloc_size in init.c */
+    /* Honor TMPDIR: on OHOS /tmp is read-only, so the relations file
+       must live in the user-writable temp directory. */
+    {
+        const char * td = getenv("TMPDIR");
+        snprintf(qs_inf->fname, QSIEVE_FNAME_SIZE, "%s/siqsXXXXXX",
+                 (td != NULL && td[0] != '\0') ? td : "/tmp");
+    }
     fd = mkstemp(qs_inf->fname);
     if (fd == -1)
         flint_throw(FLINT_ERROR, "mkstemp failed\n");
diff --git a/src/qsieve/init.c b/src/qsieve/init.c
index ccee618..e32da1e 100644
--- a/src/qsieve/init.c
+++ b/src/qsieve/init.c
@@ -25,7 +25,7 @@ void qsieve_init_with_tune(qs_t qs_inf, const fmpz_t n, ulong ks_primes,
 #if (defined(__WIN32) && !defined(__CYGWIN__)) || defined(_MSC_VER)
     fname_alloc_size = MAX_PATH;
 #else
-    fname_alloc_size = 20;
+    fname_alloc_size = QSIEVE_FNAME_SIZE;
 #endif
     qs_inf->fname = (char *) flint_malloc(fname_alloc_size); /* space for filename */
 
