@@ -191,6 +191,17 @@ esac
 # Note: order is significant - the case branches are not exclusive.
 
 case $UNAME_MACHINE:$UNAME_SYSTEM:$UNAME_RELEASE:$UNAME_VERSION in
+    *:HarmonyOS:*:*)
+	# HarmonyOS (OpenHarmony / HarmonyOS PC): the libc is musl-derived,
+	# not glibc. Match machines the OHOS SDK supports.
+	case "$UNAME_MACHINE" in
+	    aarch64|arm64) UNAME_MACHINE=aarch64 ;;
+	    armv7*|armv8*) UNAME_MACHINE=arm ;;
+	    x86_64|amd64) UNAME_MACHINE=x86_64 ;;
+	    i?86) UNAME_MACHINE=i686 ;;
+	esac
+	echo "$UNAME_MACHINE"-unknown-linux-ohos
+	exit ;;
     *:NetBSD:*:*)
 	# NetBSD (nbsd) targets should (where applicable) match one or
 	# more of the tuples: *-*-netbsdelf*, *-*-netbsdaout*,
