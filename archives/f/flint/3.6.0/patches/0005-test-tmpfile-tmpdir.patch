index e0fe42e..b91f2f4 100644
--- a/src/test_helpers.h
+++ b/src/test_helpers.h
@@ -13,12 +13,15 @@
 #ifndef TEST_HELPERS_H
 #define TEST_HELPERS_H
 
+#include <stdio.h> /* FILE, fdopen */
 #include <time.h> /* clock */
 #include <string.h> /* strlen, strcmp, strncmp */
 #include <stdlib.h> /* strtol */
 #include <limits.h> /* LONG_MIN */
 #include "templates.h"
 #include "flint.h"
+#include <stdlib.h>
+#include <unistd.h>
 
 #if FLINT_WANT_PRETTY_TESTS
 # define _RED "\033[0;31m"
@@ -58,6 +61,30 @@ test_struct;
 
 #define TEST_FUNCTION(label) { CAT(test, label), #label }
 
+/* musl hides these POSIX declarations under strict -std=c11; declare
+   them explicitly so FLINT_TEST_TMPFILE works in the test builds. */
+int mkstemp(char *);
+FILE * fdopen(int, const char *);
+
+/* tmpfile() fails on read-only /tmp platforms (OHOS); this portable
+   equivalent honors TMPDIR and unlinks immediately like tmpfile(). */
+#define FLINT_TEST_TMPFILE(fp)                                             \
+    do {                                                                    \
+        const char * _td = getenv("TMPDIR");                              \
+        char _fname[1024];                                                  \
+        int _fd;                                                            \
+        snprintf(_fname, sizeof(_fname), "%s/flint-test-XXXXXX",          \
+                 (_td != NULL && _td[0] != '\0') ? _td : "/tmp");        \
+        _fd = mkstemp(_fname);                                              \
+        if (_fd == -1)                                                      \
+            (fp) = NULL;                                                    \
+        else                                                                \
+        {                                                                   \
+            unlink(_fname);                                                 \
+            (fp) = fdopen(_fd, "w+b");                                    \
+        }                                                                   \
+    } while (0)
+
 #define TEST_FUNCTION_START(label, state)               \
 int CAT(test, label)(void)                              \
 {                                                       \
