--- a/external/KDSingleApplication/CMakeLists.txt
+++ b/external/KDSingleApplication/CMakeLists.txt
@@ -111,7 +111,12 @@
     find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Test)
 endif()
 
-include(KDQtInstallPaths) #to set QT_INSTALL_FOO variables
+# KDQtInstallPaths requires a Qt5::qmake/qtpaths target that Conan
+# CMakeDeps does not export for qt5-qtbase. QT_INSTALL_* variables are not
+# used by KDSingleApplication's install rules, so skip the qmake probe.
+set(QT_INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}" CACHE PATH "Qt install prefix")
+set(QT_INSTALL_LIBS "${CMAKE_INSTALL_PREFIX}/lib" CACHE PATH "Qt install libs")
+set(QT_INSTALL_HEADERS "${CMAKE_INSTALL_PREFIX}/include" CACHE PATH "Qt install headers")
 
 add_definitions(
     -DQT_NO_CAST_TO_ASCII
