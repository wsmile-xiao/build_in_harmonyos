 namespace Fastor {
 
 class CPUID {
   uint32_t regs[4];
 
 public:
   explicit CPUID(unsigned i) {
 #ifdef _WIN32
     __cpuid((int *)regs, (int)i);
 
-#else
+#elif defined(__x86_64__) || defined(__i386__)
     asm volatile
       ("cpuid" : "=a" (regs[0]), "=b" (regs[1]), "=c" (regs[2]), "=d" (regs[3])
        : "a" (i), "c" (0));
     // ECX is set to zero for CPUID function 4
+#else
+    // Non-x86 architectures (e.g. AArch64) do not implement the x86 CPUID
+    // instruction; leave all registers zeroed.
+    regs[0] = regs[1] = regs[2] = regs[3] = 0;
 #endif
   }
 
   const uint32_t& EAX() const {return regs[0];} // cpu base frequency
   const uint32_t& EBX() const {return regs[1];} // cpu max frequency
   const uint32_t& ECX() const {return regs[2];} // bus (reference) frequency
   const uint32_t& EDX() const {return regs[3];}
 };
 
