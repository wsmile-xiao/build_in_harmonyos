Description: Guard the out-of-range std::tuple_element completeness assertion against hardened standard libraries
Origin: https://github.com/facebook/fatal/tree/v2026.09.14.00
Upstream: not submitted; upstream test case kept, one expectation guarded because libc++/libstdc++ now hard-error on out-of-range std::tuple_element
Source-Commit: 26502c39b02609ccec7d5373c4351eac1fcc3277
Modification-Layer: 1 (upstream test source: fatal/type/test/deprecated_transform_test.cpp)
Knowledge-Ref: DRAFT-fatal-v2026.09.14.00-libcxx-tuple-element-static-assert, P005, P007

--- a/fatal/type/test/deprecated_transform_test.cpp
+++ b/fatal/type/test/deprecated_transform_test.cpp
@@ -131,7 +131,14 @@
   using pair = std::pair<void, void>;
   FATAL_EXPECT_TRUE((is_complete<std::tuple_element<0, pair>>::value));
   FATAL_EXPECT_TRUE((is_complete<std::tuple_element<1, pair>>::value));
+#if !defined(_LIBCPP_VERSION)
+  // Recent libc++ guards std::tuple_element with a static_assert for
+  // out-of-range indices, so the type is no longer an SFINAE-friendly
+  // incomplete type -- instantiating it is a hard error instead of a
+  // substitution failure. Keep the expectation for implementations that
+  // are still SFINAE friendly.
   FATAL_EXPECT_FALSE((is_complete<std::tuple_element<2, pair>>::value));
+#endif
 }
 
