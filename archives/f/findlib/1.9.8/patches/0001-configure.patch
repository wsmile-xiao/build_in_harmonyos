 get_stdlib () {
     # Older versions of ocamlc do not accept -where, so there is a fallback
     # method:
     ocamlc -where 2>/dev/null | tr -d '\r' || {
 	ocamlc -v | sed -n -e "/Standard library directory/s/.*: \(.*\)/\1/p"; }
+}
+
+# HarmonyOS/OHOS: hmmac refuses to exec interpreter-script binaries directly
+# (EACCES), and the bytecode OCaml tools carry a shebang pointing at ocamlrun.
+# Running them explicitly through ocamlrun works.  No-op on other platforms.
+ocaml_run () {
+    if test -n "$OCAMLRUN" ; then
+	"$OCAMLRUN" "$@"
+    else
+	"$@"
+    fi
+}
+
+# HarmonyOS: the bytecode tools' shebang references a stale ocamlrun path, so
+# the shared stublibs directory must be injected explicitly for dynlinked
+# primitives (dllunix.so, dllstr.so, ...).
+ocaml_setup_runenv () {
+    if test -n "$OCAMLRUN" && test -d "$ocaml_core_stdlib/stublibs" ; then
+	CAML_LD_LIBRARY_PATH="$ocaml_core_stdlib/stublibs${CAML_LD_LIBRARY_PATH:+:$CAML_LD_LIBRARY_PATH}"
+	export CAML_LD_LIBRARY_PATH
+    fi
 }
 
 
 get_lib () {
     # $1: name of a library to search for
     # $2...: places to test
     libname="$1"
     while [ "$#" != "0" ]; do
 	if [ -f "$1/lib${libname}.so" ] || [ -f "$1/lib${libname}.a" ]; then
 	    echo "$1"
