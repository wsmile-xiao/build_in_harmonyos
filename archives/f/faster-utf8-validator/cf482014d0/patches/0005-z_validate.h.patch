--- /dev/null
+++ b/z_validate.h
@@ -0,0 +1,24 @@
+// Public API for faster-utf8-validator.
+//
+// Upstream ships the validator as a single C file (z_validate.c) that
+// exposes z_validate_utf8_avx2 / z_validate_utf8_sse4 when built with
+// -DAVX2 / -DSSE4, and z_validate_utf8 (scalar fallback) otherwise.
+// This header declares the portable entry point used by the scalar
+// build, which is the one produced for HarmonyOS OHOS aarch64.
+#ifndef Z_VALIDATE_H
+#define Z_VALIDATE_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Returns 1 if [data, data+len) is valid UTF-8, 0 otherwise.
+int z_validate_utf8(const char *data, size_t len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* Z_VALIDATE_H */
