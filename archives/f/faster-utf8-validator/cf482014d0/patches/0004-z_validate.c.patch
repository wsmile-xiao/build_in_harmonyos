+// Scalar fallback for targets without AVX2/SSE4 (e.g. aarch64 / OHOS).
+// Implements the same UTF-8 acceptance semantics: rejects overlong
+// encodings, surrogate code points, and values above U+10FFFF.
+
+int z_validate_utf8(const char *data, size_t len) {
+    const unsigned char *s = (const unsigned char *)data;
+    size_t i = 0;
+
+    while (i < len) {
+        unsigned char c = s[i];
+        if (c < 0x80) {
+            // ASCII
+            i++;
+            continue;
+        }
+        int n;
+        unsigned int cp;
+        if ((c & 0xE0) == 0xC0) {
+            // 2-byte sequence: 110xxxxx 10xxxxxx
+            n = 2;
+            cp = c & 0x1F;
+            if (cp < 0x02)  // C0/C1 are overlong
+                return 0;
+        } else if ((c & 0xF0) == 0xE0) {
+            // 3-byte sequence: 1110xxxx 10xxxxxx 10xxxxxx
+            n = 3;
+            cp = c & 0x0F;
+        } else if ((c & 0xF8) == 0xF0) {
+            // 4-byte sequence: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
+            n = 4;
+            cp = c & 0x07;
+            if (cp > 0x04)  // F5..F7 are above U+10FFFF
+                return 0;
+        } else {
+            // stray continuation byte or invalid prefix
+            return 0;
+        }
+        if (i + (size_t)n > len)
+            return 0;  // truncated sequence at end of input
+        for (int j = 1; j < n; j++) {
+            unsigned char cc = s[i + j];
+            if ((cc & 0xC0) != 0x80)
+                return 0;  // expected continuation byte
+            cp = (cp << 6) | (cc & 0x3F);
+        }
+        // Range checks
+        if (n == 3 && cp < 0x800)   // E0 80..9F overlong
+            return 0;
+        if (n == 4 && cp < 0x10000) // F0 80..8F overlong
+            return 0;
+        if (cp >= 0xD800 && cp <= 0xDFFF)
+            return 0;  // UTF-16 surrogate
+        if (cp > 0x10FFFF)
+            return 0;
+        i += (size_t)n;
+    }
+    return 1;
+}
