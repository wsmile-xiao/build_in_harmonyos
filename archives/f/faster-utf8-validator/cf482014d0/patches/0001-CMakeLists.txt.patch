--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,26 @@
+cmake_minimum_required(VERSION 3.16)
+project(faster-utf8-validator VERSION 0.1.0 LANGUAGES C)
+
+# The upstream library is a single C file. On x86 targets with
+# AVX2/SSE4 the file exposes z_validate_utf8_avx2/_sse4; on other
+# targets (e.g. aarch64 / HarmonyOS OHOS) the embedded scalar
+# fallback provides z_validate_utf8. Build the scalar path by
+# default so the package works everywhere.
+
+add_library(zval z_validate.c)
+target_include_directories(zval PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+    $<INSTALL_INTERFACE:include>)
+set_target_properties(zval PROPERTIES POSITION_INDEPENDENT_CODE ON)
+
+include(GNUInstallDirs)
+install(TARGETS zval
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
+install(FILES z_validate.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
+
+# Tests (built when tests are enabled; wired into CTest)
+enable_testing()
+add_executable(test_ohos_special test_ohos_special.c)
+target_link_libraries(test_ohos_special zval)
+add_test(NAME test_ohos_special COMMAND test_ohos_special)
