diff -ruN a/Makefile-options b/Makefile-options
--- a/Makefile-options
+++ b/Makefile-options
@@ -80,26 +80,28 @@
 
 ifneq ($(findstring MINGW,$(UNAME)),)
 #	Set executable and shared object extensions
 	EXECUTABLE = .exe
 	SHARED = .dll
 
 #	Build on Win32
 	BUILD_WIN32 = True
 else
 #	Set executable and shared object extensions
-	EXECUTABLE = 
+	EXECUTABLE =
 	SHARED = .so
 
 	BUILD_UNIX = True
 
 	ifeq ($(UNAME),Linux)
+		BUILD_LINUX = True
+	else ifeq ($(UNAME),HarmonyOS)
 		BUILD_LINUX = True
 	else ifeq ($(UNAME),FreeBSD)
 		BUILD_FREEBSD = True
 	else ifeq ($(UNAME),OpenBSD)
 		BUILD_OPENBSD = True
 	else ifeq ($(UNAME),NetBSD)
 		BUILD_NETBSD = True
 	else ifeq ($(UNAME),SunOS)
 		BUILD_SOLARIS = True
 	else ifeq ($(UNAME),Haiku)
@@ -336,10 +338,18 @@
 # Flags needed for Windows ARM64 toolchain
 ifeq ($(BUILD_WIN32),True)
 	ifeq ($(BUILD_ARM64),True)
 		override CFLAGS	 += -target aarch64-w64-mingw32
 		override LDFLAGS += -target aarch64-w64-mingw32
 	endif
 endif
 
 # Clear config variable
 config =
+
+# HarmonyOS-specific: add system and installed library paths
+ifeq ($(UNAME),HarmonyOS)
+	override CFLAGS     += -I/storage/Users/currentUser/usr/local/include -I/storage/Users/currentUser/usr/local/include/libxml2
+	override CXXFLAGS   += -I/storage/Users/currentUser/usr/local/include -I/storage/Users/currentUser/usr/local/include/libxml2
+	override LDFLAGS    += -L/storage/Users/currentUser/usr/local/lib
+	override LD         = clang++
+endif
