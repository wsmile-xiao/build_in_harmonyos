--- a/scripts/jpeg-version.sh
+++ b/scripts/jpeg-version.sh
@@ -1,2 +1,9 @@
 #!/bin/sh
-echo JPEG_LIB_VERSION | cpp $CFLAGS -include jpeglib.h | tail -1
+# Detect JPEG_LIB_VERSION — fallback for platforms without cpp
+if command -v cpp >/dev/null 2>&1; then
+    echo JPEG_LIB_VERSION | cpp $CFLAGS -include jpeglib.h | tail -1
+else
+    # Fallback: output default version number for libjpeg-turbo
+    # libjpeg-turbo 2.x = 62, libjpeg-turbo 3.x = 80
+    echo "62"
+fi