--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -223,6 +223,16 @@
     SET(FREEGLUT_BUILD_SHARED_LIBS OFF)
     # Only used in fg_window.c, to declare support for double buffering
     ADD_DEFINITIONS(-DEGL_VERSION_1_0)
+
+ELSEIF(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    # OpenHarmony/HarmonyOS: 无 X11/Wayland，使用 EGL + OHOS 原生平台层
+    # 平台标识由构建系统注入（TARGET_HOST_OHOS），源码侧不再引入平台宏探测。
+    ADD_DEFINITIONS(-DTARGET_HOST_OHOS)
+    LIST(APPEND FREEGLUT_SRCS
+        src/ohos/fg_internal_ohos.h
+        src/ohos/fg_ohos.c
+        src/ohos/fg_gl_dispatch_ohos.c
+    )
 
 ELSE()
     # UNIX (Wayland)
@@ -294,7 +304,7 @@
 ENDIF()
 
 INCLUDE(CheckIncludeFiles)
-IF(UNIX AND NOT(ANDROID OR BLACKBERRY OR FREEGLUT_WAYLAND OR OGC))
+IF(UNIX AND NOT(ANDROID OR BLACKBERRY OR FREEGLUT_WAYLAND OR OGC OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS"))
     FIND_PACKAGE(X11 REQUIRED)
     INCLUDE_DIRECTORIES(${X11_X11_INCLUDE_PATH})
     LIST(APPEND LIBS ${X11_X11_LIB})
@@ -330,10 +340,28 @@
 IF(FREEGLUT_GLES)
     LIST(APPEND PUBLIC_DEFINITIONS -DFREEGLUT_GLES)
     if(NOT CMAKE_VERSION VERSION_LESS "3.27")
-      FIND_PACKAGE(OpenGL REQUIRED COMPONENTS EGL GLES2 OpenGL)
+      IF(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+        FIND_PACKAGE(OpenGL REQUIRED COMPONENTS EGL GLES2)
+      ELSE()
+        FIND_PACKAGE(OpenGL REQUIRED COMPONENTS EGL GLES2 OpenGL)
+      ENDIF()
       CMAKE_PATH(GET OPENGL_gles2_LIBRARY PARENT_PATH _OPENGL_LIBDIR)
-      FIND_LIBRARY(GLES1_LIBRARY GLESv1_CM HINTS ${_OPENGL_LIBDIR} REQUIRED)
-      LIST(APPEND LIBS ${GLES1_LIBRARY} OpenGL::EGL OpenGL::GLES2 OpenGL::OpenGL)
+      IF(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+        # OHOS ships only GLESv2/GLESv3 -- there is no GLESv1_CM to link.
+        SET(GLES1_LIBRARY "")
+      ELSE()
+        FIND_LIBRARY(GLES1_LIBRARY GLESv1_CM HINTS ${_OPENGL_LIBDIR} REQUIRED)
+      ENDIF()
+      IF(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+        LIST(APPEND LIBS OpenGL::EGL OpenGL::GLES2)
+        # On OHOS the GL symbols exported by libGLESv2.so are dispatcher stubs;
+        # the real functions come from eglGetProcAddress().  fg_gl_dispatch_ohos.c
+        # provides wrappers, and -Bsymbolic makes freeglut's internal GL calls
+        # bind to those wrappers instead of resolving to libGLESv2's stubs.
+        LIST(APPEND LIBS "-Wl,-Bsymbolic")
+      ELSE()
+        LIST(APPEND LIBS ${GLES1_LIBRARY} OpenGL::EGL OpenGL::GLES2 OpenGL::OpenGL)
+      ENDIF()
     elseif(NOT CMAKE_VERSION VERSION_LESS "3.10")
       FIND_PACKAGE(OpenGL REQUIRED COMPONENTS EGL OpenGL)
       GET_FILENAME_COMPONENT(_OPENGL_LIBDIR ${OPENGL_egl_LIBRARY} DIRECTORY)
