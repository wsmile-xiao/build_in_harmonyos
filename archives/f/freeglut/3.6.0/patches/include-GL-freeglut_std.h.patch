--- a/include/GL/freeglut_std.h
+++ b/include/GL/freeglut_std.h
@@ -134,8 +134,33 @@
    (e.g. GL_ES_VERSION_2_0) for all other needs */
 #ifdef FREEGLUT_GLES
 #   include <EGL/egl.h>
-#   include <GLES/gl.h>
+/* GLES1 (GLES/gl.h) is optional: some platforms ship only the ES2/ES3 headers.
+   Detect the header itself rather than testing a platform macro, so this works
+   for any toolchain that lacks it (and keeps this public header free of
+   platform conditionals, which consumers cannot see anyway). */
+#   if defined(__has_include)
+#       if __has_include(<GLES/gl.h>)
+#           include <GLES/gl.h>
+#       else
+#           define FREEGLUT_NO_GLES1_HEADER 1
+#       endif
+#   else
+#       include <GLES/gl.h>
+#   endif
 #   include <GLES2/gl2.h>
+#   if defined(FREEGLUT_NO_GLES1_HEADER)
+/* Without GLES/gl.h a few ES1-era constants that the freeglut core still
+   references are unavailable; supply them here. */
+#       ifndef GL_CURRENT_COLOR
+#           define GL_CURRENT_COLOR 0x0B00
+#       endif
+#       ifndef GL_CURRENT_NORMAL
+#           define GL_CURRENT_NORMAL 0x0B02
+#       endif
+#       ifndef GL_CURRENT_TEXTURE_COORDS
+#           define GL_CURRENT_TEXTURE_COORDS 0x0B03
+#       endif
+#   endif
 #elif __APPLE__
 /* stop MacOSX GL headers for complaining that OpenGL is deprecated */
 #   ifndef GL_SILENCE_DEPRECATION
