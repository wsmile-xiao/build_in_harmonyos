+/* ------------------------------------------------------------------------- */
+/* GLUT state queries                                                        */
+/* ------------------------------------------------------------------------- */
+
+int fgPlatformGlutDeviceGet ( GLenum eWhat )
+{
+    switch( eWhat )
+    {
+    case GLUT_HAS_KEYBOARD:
+        /* Input arrives through the host application; assume present. */
+        return 1;
+
+    case GLUT_HAS_MOUSE:
+        return 1;
+
+    case GLUT_NUM_MOUSE_BUTTONS:
+        return 1;
+
+    default:
+        fgWarning( "glutDeviceGet(): missing enum handle %d", eWhat );
+        break;
+    }
+
+    /* And now -- the failure. */
+    return -1;
+}
+
+int fgPlatformGlutGet ( GLenum eWhat )
+{
+    switch (eWhat) {
+    case GLUT_WINDOW_X:
+    case GLUT_WINDOW_Y:
+    case GLUT_WINDOW_BORDER_WIDTH:
+    case GLUT_WINDOW_HEADER_HEIGHT:
+        return 0;
+
+    case GLUT_WINDOW_WIDTH:
+    case GLUT_WINDOW_HEIGHT:
+        if ( fgStructure.CurrentWindow == NULL )
+            return 0;
+        return ( eWhat == GLUT_WINDOW_WIDTH )
+                 ? fgStructure.CurrentWindow->State.Width
+                 : fgStructure.CurrentWindow->State.Height;
+
+    default:
+        break;
+    }
+
+    return fghPlatformGlutGetEGL( eWhat );
+}
