+/* ------------------------------------------------------------------------- */
+/* Main loop                                                                 */
+/* ------------------------------------------------------------------------- */
+
+fg_time_t fgPlatformSystemTime( void )
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (fg_time_t)ts.tv_sec * 1000000ULL + (fg_time_t)( ts.tv_nsec / 1000 );
+}
+
+void fgPlatformSleepForEvents( fg_time_t msec )
+{
+    if( msec > 0 )
+    {
+        /*
+         * Use nanosleep() rather than usleep(): usleep() takes useconds_t
+         * (32-bit), so (useconds_t)(msec * 1000) truncates for waits above
+         * ~4295 s, and POSIX additionally requires the argument to be below
+         * 1000000 (values >= 1 s are implementation-defined).  nanosleep()
+         * takes a 64-bit seconds field and has no such limit, so an idle main
+         * loop with a large computed wait behaves correctly instead of busy-
+         * waiting or sleeping for an unintended duration.
+         */
+        struct timespec ts;
+        ts.tv_sec  = (time_t)( msec / 1000 );
+        ts.tv_nsec = (long)( ( msec % 1000 ) * 1000000 );
+
+        while( nanosleep( &ts, &ts ) == -1 && errno == EINTR )
+            ;   /* interrupted: ts now holds the remaining time, keep sleeping */
+    }
+}
