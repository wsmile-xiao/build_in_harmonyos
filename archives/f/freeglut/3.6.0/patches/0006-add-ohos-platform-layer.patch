+/* ------------------------------------------------------------------------- */
+/* Display / library lifecycle                                               */
+/* ------------------------------------------------------------------------- */
+
+/* Forward declarations: these are defined below / in the egl backend and are
+   called before their definitions appear. */
+void fgPlatformInitialiseInputDevices( void );
+void fgPlatformCloseInputDevices( void );
+
+void fgPlatformInitialize( const char* displayName )
+{
+    (void)displayName;   /* OHOS always uses EGL_DEFAULT_DISPLAY */
+    fghPlatformInitializeEGL();
+
+    /* Get start time */
+    fgState.Time = fgSystemTime();
+
+    /* Every platform init routine must flag the library as initialised, since
+       glutCreateWindow() and friends bail out with "called without first
+       calling 'glutInit'" otherwise (see fg_window.c). Input devices also
+       require this to be TRUE before they may use GlutTimerFunc(). */
+    fgState.Initialised = GL_TRUE;
+
+    atexit(fgDeinitialize);
+
+    fgPlatformInitialiseInputDevices();
+}
+
+void fgPlatformCloseDisplay( void )
+{
+    fghPlatformCloseDisplayEGL();
+}
+
