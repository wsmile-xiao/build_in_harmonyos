+/*
+ * fg_ohos.c
+ *
+ * OpenHarmony / HarmonyOS platform layer for freeglut.
+ *
+ * Design
+ * ------
+ * OHOS provides neither X11 nor Wayland nor the Android app-glue.  What it does
+ * provide, in every plain native process, is EGL reachable through
+ * EGL_DEFAULT_DISPLAY, together with pbuffer configs and
+ * EGL_KHR_surfaceless_context.  freeglut is therefore implemented on top of
+ * **EGL pbuffer surfaces**, i.e. headless/offscreen rendering.
+ *
+ * Consequence for GLUT semantics: there is no window manager, so
+ * glutCreateWindow() creates an offscreen render target of the requested size
+ * instead of an on-screen window.  Window-position/title/iconify/cursor/game
+ * mode/spaceball/joystick requests are accepted and stored but have no visual
+ * effect (there is no compositor to honour them).
+ *
+ * GL entry points
+ * ---------------
+ * On OHOS the symbols exported directly by libGLESv2.so are dispatcher stubs:
+ * a direct glGetString() returns NULL and direct drawing has no effect, whereas
+ * the very same entry points fetched through eglGetProcAddress() are the real
+ * driver functions (verified: GL_VERSION="OpenGL ES 3.2 B301",
+ * GL_RENDERER="Maleoon 916", glClear+glReadPixels yields the cleared colour).
+ * fgPlatformGetProcAddress() consequently routes through eglGetProcAddress().
+ */
+#include <errno.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <EGL/egl.h>
+
+#include <GL/freeglut.h>
+#include "fg_internal.h"
+#include "egl/fg_init_egl.h"
+#include "egl/fg_window_egl.h"
+#include "egl/fg_state_egl.h"
+
+/* fgSystemTime() is declared in fg_internal.h */
+
