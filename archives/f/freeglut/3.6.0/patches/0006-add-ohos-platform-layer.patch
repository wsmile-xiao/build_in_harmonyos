+/*
+ * Really opens a window: choose an EGL config, create a GLES context and bind
+ * it to a pbuffer surface of the requested size (fghPlatformOpenWindowEGL
+ * creates the pbuffer on OHOS).
+ */
+void fgPlatformOpenWindow( SFG_Window* window, const char* title,
+                           GLboolean positionUse, int x, int y,
+                           GLboolean sizeUse, int w, int h,
+                           GLboolean gameMode, GLboolean isSubWindow )
+{
+    (void)title; (void)gameMode; (void)isSubWindow;
+
+    /* Save the display mode if we are creating a menu window */
+    if( window->IsMenu && ( ! fgStructure.MenuContext ) )
+        fgState.DisplayMode = GLUT_DOUBLE | GLUT_RGB ;
+
+    fghChooseConfig( &window->Window.pContext.egl.Config );
+
+    if( ! window->Window.pContext.egl.Config )
+    {
+        /*
+         * The "fghChooseConfig" returned a null meaning that the visual
+         * context is not available.
+         * Try a couple of variations to see if they will work.
+         */
+        if( fgState.DisplayMode & GLUT_MULTISAMPLE )
+        {
+            fgState.DisplayMode &= ~GLUT_MULTISAMPLE ;
+            fghChooseConfig( &window->Window.pContext.egl.Config );
+            fgState.DisplayMode |= GLUT_MULTISAMPLE;
+        }
+    }
+
+    FREEGLUT_INTERNAL_ERROR_EXIT( window->Window.pContext.egl.Config != NULL,
+                                  "EGL configuration with necessary capabilities "
+                                  "not found", "fgOpenWindow" );
+
+    if( ! positionUse )
+        x = y = -1;      /* no compositor: position is advisory only */
+    if( ! sizeUse )
+        w = h = 300;     /* default window size */
+
+    if( w <= 0 ) w = 300;
+    if( h <= 0 ) h = 300;
+
+    /* The pbuffer surface is sized from these, see fghPlatformOpenWindowEGL. */
+    window->State.Width   = w;
+    window->State.Height  = h;
+    window->State.Xpos    = x;
+    window->State.Ypos    = y;
+
+    window->Window.Context = fghCreateNewContextEGL( window );
+
+    fghPlatformOpenWindowEGL( window );
+
+    /* Bind context to the current thread if it's lost */
+    if (eglGetCurrentContext() == EGL_NO_CONTEXT &&
+        eglMakeCurrent(fgDisplay.pDisplay.egl.Display,
+               window->Window.pContext.egl.Surface,
+               window->Window.pContext.egl.Surface,
+               window->Window.Context) == EGL_FALSE)
+      fgError("eglMakeCurrent: err=%x\n", eglGetError());
+
+    window->State.Visible = GL_TRUE;
+}
+
+void fgPlatformCloseWindow( SFG_Window* window )
+{
+    fghPlatformCloseWindowEGL( window );
+}
+
+/*
+ * On OHOS a "resize" means reallocating the offscreen render target, because
+ * an EGL pbuffer surface has a fixed size.
+ */
+void fgPlatformReshapeWindow ( SFG_Window *window, int width, int height )
+{
+    EGLDisplay display = fgDisplay.pDisplay.egl.Display;
+
+    if( width  <= 0 ) width  = 300;
+    if( height <= 0 ) height = 300;
+
+    if( window->Window.pContext.egl.Surface != EGL_NO_SURFACE )
+    {
+        if( fgStructure.CurrentWindow == window )
+            eglMakeCurrent( display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT );
+        eglDestroySurface( display, window->Window.pContext.egl.Surface );
+        window->Window.pContext.egl.Surface = EGL_NO_SURFACE;
+    }
+
+    window->State.Width  = width;
+    window->State.Height = height;
+
+    {
+        EGLConfig config = window->Window.pContext.egl.Config;
+        EGLint pbattr[5];
+        pbattr[0] = EGL_WIDTH;  pbattr[1] = width;
+        pbattr[2] = EGL_HEIGHT; pbattr[3] = height;
+        pbattr[4] = EGL_NONE;
+
+        window->Window.pContext.egl.Surface =
+            eglCreatePbufferSurface( display, config, pbattr );
+        if( window->Window.pContext.egl.Surface == EGL_NO_SURFACE )
+            fgError( "Cannot recreate EGL pbuffer surface, err=%x\n", eglGetError() );
+    }
+
+    /*
+     * Rebind explicitly.  The shared EGL helper fgPlatformSetWindow() only calls
+     * eglMakeCurrent() when the window it is handed is NOT fgStructure.CurrentWindow
+     * (see src/egl/fg_window_egl.c), so for a reshape of the *current* window it
+     * would do nothing: we would have released the old surface via
+     * eglMakeCurrent(EGL_NO_SURFACE) above and never bind the new one, leaving the
+     * thread with no current context — every subsequent GL call would be a no-op
+     * with no error reported.
+     */
+    if( fgStructure.CurrentWindow == window )
+    {
+        if( eglMakeCurrent( display, window->Window.pContext.egl.Surface,
+                            window->Window.pContext.egl.Surface,
+                            window->Window.Context ) == EGL_FALSE )
+            fgError( "eglMakeCurrent after reshape: err=%x\n", eglGetError() );
+    }
+}
