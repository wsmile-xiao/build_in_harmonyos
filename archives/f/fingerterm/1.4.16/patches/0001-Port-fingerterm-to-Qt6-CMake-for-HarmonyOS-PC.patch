@@ -20,11 +20,13 @@
 #ifndef PTYIFACE_H
 #define PTYIFACE_H
 
+#include <memory>
 #include <QObject>
 #include <QSocketNotifier>
 #include <QByteArray>
 #include <QSize>
-#include <QTextCodec>
+#include <QStringDecoder>
+#include <QStringEncoder>
 
 class Terminal;
 
@@ -55,7 +57,13 @@ private:
 
     QSocketNotifier *iReadNotifier;
 
-    QTextCodec *iTextCodec;
+    // QTextCodec was removed in Qt 6. Terminal charset conversion uses the
+    // Qt6 QStringDecoder / QStringEncoder pair instead (stateful, UTF-8 by
+    // default — same semantics as the previous QTextCodec::codecForName
+    // fall-back chain). QStringConverter deletes copy-assignment, so the
+    // codecs are held by unique_ptr and selected once at construction.
+    std::unique_ptr<QStringDecoder> iDecoder;
+    std::unique_ptr<QStringEncoder> iEncoder;
 };
 
 #endif // PTYIFACE_H
