diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..4c34b24
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,120 @@
+cmake_minimum_required(VERSION 3.16)
+project(fingerterm VERSION 1.4.16 LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_AUTOMOC ON)
+set(CMAKE_AUTORCC ON)
+
+# Upstream ships a qmake .pro file (Sailfish OS). This CMake project builds
+# the exact same sources for the Qt6 stack published in the ohpcd registry.
+# Qt resource compilation (resources.qrc -> :/data/english.layout fallback
+# layout) is kept via CMAKE_AUTORCC.
+
+# Deployment data path: QML UI files, keyboard layouts and icons are loaded
+# at runtime from this directory (DEPLOYMENT_PATH in upstream fingerterm.pro).
+# With conan packaging the files install into <package>/share/fingerterm and
+# the macro is defined relative to the install prefix at build time.
+if(NOT DEFINED FINGERTERM_DEPLOYMENT_PATH)
+    set(FINGERTERM_DEPLOYMENT_PATH "${CMAKE_INSTALL_PREFIX}/share/fingerterm")
+endif()
+if(NOT DEFINED FINGERTERM_DEFAULT_FONT)
+    set(FINGERTERM_DEFAULT_FONT "monospace")
+endif()
+
+find_package(Qt6 REQUIRED COMPONENTS Core Gui Qml Quick)
+
+set(FINGERTERM_SOURCES
+    main.cpp
+    terminal.cpp
+    textrender.cpp
+    ptyiface.cpp
+    util.cpp
+    keyloader.cpp
+)
+
+set(FINGERTERM_HEADERS
+    ptyiface.h
+    terminal.h
+    textrender.h
+    util.h
+    keyloader.h
+)
+
+add_executable(fingerterm
+    ${FINGERTERM_SOURCES}
+    ${FINGERTERM_HEADERS}
+    resources.qrc
+)
+
+target_compile_definitions(fingerterm PRIVATE
+    DEPLOYMENT_PATH="${FINGERTERM_DEPLOYMENT_PATH}"
+    DEFAULT_FONTFAMILY="${FINGERTERM_DEFAULT_FONT}"
+    # Translation catalogs are not generated in this build (upstream drives
+    # lupdate/lrelease from the qmake project); point the loader at the
+    # deployment share dir so a user-supplied catalog still loads.
+    TRANSLATIONS_PATH="${FINGERTERM_DEPLOYMENT_PATH}/translations"
+    VERSION_STRING="${PROJECT_VERSION}"
+)
+
+target_link_libraries(fingerterm PRIVATE
+    Qt6::Core
+    Qt6::Gui
+    Qt6::Qml
+    Qt6::Quick
+)
+
+# forkpty()/openpty() are declared in <pty.h> of the OHOS musl sysroot and
+# provided by libc (musl); the sysroot additionally ships a stub libutil.a
+# for compatibility with glibc-era link lines. Link it when present.
+find_library(UTIL_LIB util)
+if(UTIL_LIB)
+    target_link_libraries(fingerterm PRIVATE ${UTIL_LIB})
+endif()
+
+set(FINGERTERM_QML
+    qml/Main.qml
+    qml/Keyboard.qml
+    qml/Key.qml
+    qml/Lineview.qml
+    qml/Button.qml
+    qml/SectionHeader.qml
+    qml/MenuFingerterm.qml
+    qml/NotifyWin.qml
+    qml/UrlWindow.qml
+    qml/LayoutWindow.qml
+    qml/AboutWindow.qml
+    qml/PopupWindow.qml
+)
+
+set(FINGERTERM_ICONS
+    icons/backspace.png
+    icons/down.png
+    icons/enter.png
+    icons/left.png
+    icons/menu.png
+    icons/right.png
+    icons/scroll-indicator.png
+    icons/shift.png
+    icons/tab.png
+    icons/up.png
+)
+
+set(FINGERTERM_DATA
+    data/menu.xml
+    data/english.layout
+    data/finnish.layout
+    data/french.layout
+    data/german.layout
+    data/qwertz.layout
+)
+
+install(TARGETS fingerterm DESTINATION bin)
+install(FILES ${FINGERTERM_QML} DESTINATION share/fingerterm)
+install(FILES ${FINGERTERM_DATA} DESTINATION share/fingerterm/data)
+install(FILES ${FINGERTERM_ICONS} DESTINATION share/fingerterm/icons)
+install(FILES fingerterm.png DESTINATION share/fingerterm)
+
+if(UNIX)
+    install(FILES fingerterm.desktop DESTINATION share/applications)
+endif()
