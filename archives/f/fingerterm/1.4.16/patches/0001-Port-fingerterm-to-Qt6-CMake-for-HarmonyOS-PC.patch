diff --git a/ptyiface.cpp b/ptyiface.cpp
index d11a104..4cf05ab 100644
--- a/ptyiface.cpp
+++ b/ptyiface.cpp
@@ -57,7 +57,6 @@ PtyIFace::PtyIFace(int pid, int masterFd, Terminal *term, QString charset, QObje
     , iMasterFd(masterFd)
     , iFailed(false)
     , iReadNotifier(0)
-    , iTextCodec(nullptr)
 {
     childProcessPid = iPid;
 
@@ -77,11 +76,20 @@ PtyIFace::PtyIFace(int pid, int masterFd, Terminal *term, QString charset, QObje
     signal(SIGCHLD,&sighandler);
     fcntl(iMasterFd, F_SETFL, O_NONBLOCK); // reads from the descriptor should be non-blocking
 
-    if (!charset.isEmpty())
-        iTextCodec = QTextCodec::codecForName(charset.toLatin1());
-    if (!iTextCodec)
-        iTextCodec = QTextCodec::codecForName("UTF-8");
-    if (!iTextCodec)
+    // QTextCodec was removed in Qt 6. The terminal charset is honoured via
+    // QStringDecoder/QStringEncoder; unknown names fall back to UTF-8 (the
+    // same default QTextCodec::codecForName() used to converge on).
+    // QStringConverter deletes copy assignment, so the codecs are
+    // constructed in place.
+    const QByteArray requested = charset.isEmpty() ? QByteArrayLiteral("UTF-8")
+                                                   : charset.toLatin1();
+    iDecoder = std::make_unique<QStringDecoder>(requested);
+    if (!iDecoder->isValid())
+        iDecoder = std::make_unique<QStringDecoder>(QStringDecoder::Utf8);
+    iEncoder = std::make_unique<QStringEncoder>(requested);
+    if (!iEncoder->isValid())
+        iEncoder = std::make_unique<QStringEncoder>(QStringEncoder::Utf8);
+    if (!iDecoder->isValid() || !iEncoder->isValid())
         qFatal("No valid text codec");
 }
 
@@ -101,7 +109,7 @@ void PtyIFace::readActivated()
     QByteArray data;
     readTerm(data);
     if (iTerm)
-        iTerm->insertInBuffer(iTextCodec->toUnicode(data));
+        iTerm->insertInBuffer((*iDecoder)(data));
 }
 
 void PtyIFace::resize(int rows, int columns)
@@ -118,7 +126,7 @@ void PtyIFace::resize(int rows, int columns)
 
 void PtyIFace::writeTerm(const QString &chars)
 {
-    writeTerm(iTextCodec->fromUnicode(chars));
+    writeTerm((*iEncoder)(chars));
 }
 
 void PtyIFace::writeTerm(const QByteArray &chars)
