+QUrl Terminal::userMenuXmlUrl()
+{
+    // Qt6 XmlListModel dropped the inline `xml` string property in favour
+    // of the `source` URL; expose the user menu XML as a data: URL so the
+    // QML model can consume it without a temp file.
+    const QString xml = getUserMenuXml();
+    if (xml.isEmpty())
+        return QUrl();
+    return QUrl("data:text/xml;charset=utf-8," + QUrl::toPercentEncoding(xml));
+}
