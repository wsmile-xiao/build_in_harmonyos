--- a/vtkext/private/module/vtkF3DRenderer.cxx
+++ b/vtkext/private/module/vtkF3DRenderer.cxx
@@ -105,6 +105,21 @@
 #include <vtk_glew.h>
 #endif
 
+// GLES platform compatibility: the GPU frame-timer query below uses the
+// desktop-GL API (GL_TIME_ELAPSED / glGetQueryObjectiv) which GLES does
+// not provide. GLES exposes the timer query through the
+// GL_EXT_disjoint_timer_query extension (GLES2/gl2ext.h). The EXT
+// prototypes are only declared when GL_GLEXT_PROTOTYPES is defined
+// before including gl2ext.h, so define it locally (gl3.h has already
+// been included by vtk_glad.h at this point, and gl2ext.h's own guard
+// makes the double include harmless).
+#if defined(GL_ES_VERSION_3_0) && !defined(GL_TIME_ELAPSED) && !defined(GLAD_VERSION_MAJOR)
+#define GL_GLEXT_PROTOTYPES 1
+#include <GLES2/gl2ext.h>
+#define GL_TIME_ELAPSED GL_TIME_ELAPSED_EXT
+#define glGetQueryObjectiv glGetQueryObjectivEXT
+#endif
+
 #include <cctype>
 #include <chrono>
 #include <sstream>
