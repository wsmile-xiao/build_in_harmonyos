--- a/library/CMakeLists.txt
+++ b/library/CMakeLists.txt
@@ -220,6 +220,15 @@
   endif ()
 endif ()
 
+# HarmonyOS/OHOS: without an explicit SONAME the OHOS linker records the
+# build-tree relative path ("../lib/libf3d.so") in DT_NEEDED of consumers,
+# which only resolves when the process CWD is the binary output directory.
+# A bare SONAME makes the dependency resolvable via LD_LIBRARY_PATH, which
+# is how the conan recipe runs the upstream test suite.
+if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+  set_target_properties(libf3d PROPERTIES LINK_FLAGS "-Wl,-soname,libf3d.so")
+endif()
+
 if(UNIX AND NOT APPLE)
   option(F3D_LINUX_LIBRARY_LINK_ATOMIC "Link with libatomic" OFF)
   mark_as_advanced(F3D_LINUX_LIBRARY_LINK_ATOMIC)
