--- a/vtkext/public/module/CMakeLists.txt
+++ b/vtkext/public/module/CMakeLists.txt
@@ -39,3 +39,10 @@
   SOURCES ${sources}
   PRIVATE_HEADERS ${private_headers}
   )
+
+# HarmonyOS/OHOS: same rationale as libf3d in library/CMakeLists.txt —
+# without an explicit SONAME the linker records the build-tree relative
+# path in consumers' DT_NEEDED, which ctest cannot resolve.
+if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+  set_target_properties(vtkext PROPERTIES LINK_FLAGS "-Wl,-soname,libvtkext.so")
+endif()
