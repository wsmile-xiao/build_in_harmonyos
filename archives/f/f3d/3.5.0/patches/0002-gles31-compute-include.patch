--- a/vtkext/public/module/vtkF3DBitonicSort.cxx
+++ b/vtkext/public/module/vtkF3DBitonicSort.cxx
@@ -18,6 +18,15 @@
 #include <vtk_glad.h>
 #else
 #include <vtk_glew.h>
+#endif
+
+// VTK's vtk_glad.h in GLES3 mode only includes <GLES3/gl3.h>, but the
+// bitonic sort uses GLES 3.1 compute shader APIs (glDispatchCompute,
+// glMemoryBarrier, GL_SHADER_STORAGE_BARRIER_BIT) declared in gl31.h.
+// The full glad loader header (desktop-GL VTK profile) already declares
+// every GL API and macro-renames them — guard with GLAD_VERSION_MAJOR.
+#if defined(GL_ES_VERSION_3_0) && !defined(GLAD_VERSION_MAJOR)
+#include <GLES3/gl31.h>
 #endif
 
 #include <sstream>
--- a/vtkext/private/module/vtkF3DPointSplatMapper.cxx
+++ b/vtkext/private/module/vtkF3DPointSplatMapper.cxx
@@ -34,6 +34,12 @@
 #include <vtk_glew.h>
 #endif
 
+// See vtkF3DBitonicSort.cxx: vtk_glad.h GLES3 mode stops at gl3.h while
+// the splat sort path uses GLES 3.1 compute APIs declared in gl31.h.
+#if defined(GL_ES_VERSION_3_0) && !defined(GLAD_VERSION_MAJOR)
+#include <GLES3/gl31.h>
+#endif
+
 #include <algorithm>
