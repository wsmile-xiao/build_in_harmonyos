#!/bin/sh
# coreutils `install` subset for OHOS device (no coreutils install present).
# usage: install [-c] [-m MODE] src... dst
mode=""
args=""
for a in "$@"; do
  case "$a" in
    -c) ;;
    -m) mode="next" ;;
    -m*) mode="${a#-m}" ;;
    -*) echo "install-shim: unsupported opt $a" >&2; exit 1 ;;
    *) if [ "$mode" = "next" ]; then mode="$a"; else args="$args $a"; fi ;;
  esac
done
set -e
n=0
for a in $args; do n=$((n+1)); done
i=0; dst=""; srcs=""
for a in $args; do
  i=$((i+1))
  if [ "$i" -eq "$n" ]; then dst="$a"; else srcs="$srcs $a"; fi
done
if [ "$n" -gt 2 ]; then
  mkdir -p "$dst"
elif [ ! -d "$dst" ]; then
  mkdir -p "$(dirname "$dst")"
fi
for s in $srcs; do
  if [ -d "$dst" ]; then
    cp -f "$s" "$dst/"
    t="$dst/$(basename "$s")"
  else
    cp -f "$s" "$dst"
    t="$dst"
  fi
  [ -n "$mode" ] && chmod "$mode" "$t" 2>/dev/null
done
exit 0
