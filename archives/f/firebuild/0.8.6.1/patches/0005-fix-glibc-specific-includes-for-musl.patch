From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HarmonyOS PC Porting <porting@example.com>
Date: Mon, 18 Aug 2026 00:00:00 +0800
Subject: [PATCH] Fix glibc-specific includes for musl libc

interceptors.h includes <error.h> and <bits/timex.h> which are
glibc-internal headers not available in musl libc (used by OHOS).

Guard <error.h> with __GLIBC__ (musl does not provide error.h).
Guard <bits/timex.h> with __GLIBC__, falling back to <sys/timex.h>
on musl-based Linux systems.

--- a/src/interceptor/interceptors.h
+++ b/src/interceptor/interceptors.h
@@ -34,7 +34,7 @@
 #include <mach/error.h>
 #include <mach-o/dyld.h>
 #include <netdb.h>
-#else
+#elif defined(__GLIBC__)
 #include <error.h>
 #endif
 #include <fcntl.h>
@@ -63,8 +63,10 @@
 #include <sys/syscall.h>
 #include <sys/time.h>
 #include <sys/timeb.h>
-#ifdef __linux__
+#if defined(__linux__) && defined(__GLIBC__)
 #include <bits/timex.h>
+#elif defined(__linux__)
+#include <sys/timex.h>
 #endif
 // #include <sys/timex.h>
 struct ntptimeval;
