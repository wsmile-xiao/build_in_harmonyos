From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HarmonyOS PC Porting <porting@example.com>
Date: Mon, 18 Aug 2026 00:00:00 +0800
Subject: [PATCH] Fix glibc-internal types in generate_interceptors for musl

The generate_interceptors Python script generates C declarations
(gen_decl.h) that reference glibc-internal types not available in
musl libc (used by OHOS):

1. __off_t: glibc-internal name for off_t. musl only provides off_t
   (POSIX standard). Replace __off_t with off_t -- they are equivalent
   typedefs in glibc.

2. __GLIBC_PREREQ: glibc-only macro. When used directly in #if guards
   generated into gen_decl.h, it causes a preprocessor error on musl
   ("token is not a valid binary operator"). Replace with
   FB_GLIBC_PREREQ, which is already defined in common/platform.h as
   a safe macro that evaluates to 0 on non-glibc systems.

3. Lmid_t: glibc-only type for dlmopen() first parameter, defined
   as long int in glibc. musl does not provide dlmopen() or Lmid_t.
   Replace Lmid_t with long -- semantically identical, and the
   interceptor does not use the lmid parameter value (it is in
   msg_skip_fields).

These changes are portable: they work on both glibc and musl without
platform-specific #ifdefs.

--- a/src/interceptor/generate_interceptors
+++ b/src/interceptor/generate_interceptors
@@ -820,7 +820,7 @@
          tpl="read",
          is_pread="true",
          msg_skip_fields=["buf", "count", "offset"])
-generate("ssize_t", "__pread_chk", "int fd, void *buf, size_t count, __off_t offset, size_t fortify_size",
+generate("ssize_t", "__pread_chk", "int fd, void *buf, size_t count, off_t offset, size_t fortify_size",
          tpl="read",
          is_pread="true",
          msg_skip_fields=["buf", "count", "offset", "fortify_size"])
@@ -1312,7 +1312,7 @@
     skip(c1 + v + "asprintf" + c2)

 for func_guard in [(["send", "SYS_send"], None),
-                   ("__send", "#if !defined(__aarch64__) || (defined(__linux__) && !__GLIBC_PREREQ(2, 34))")]:
+                   ("__send", "#if !defined(__aarch64__) || (defined(__linux__) && !FB_GLIBC_PREREQ(2, 34))")]:
   (func, ifdef_guard) = func_guard
   generate("ssize_t", func, "int fd, const void *buf, size_t len, int flags",
            platforms=(["linux"] if func == "__send" else ["darwin", "linux"]),
@@ -1935,7 +1935,7 @@
          ack_condition="new_libs_count > 0",
          # msg_add_fields is set in the template
          msg_skip_fields=["filename", "error_no"])
-generate("void *", "dlmopen", "Lmid_t lmid, const char *filename, int flag",
+generate("void *", "dlmopen", "long lmid, const char *filename, int flag",
          platforms=['linux'],
          tpl="dlopen",
          msg="dlopen",
