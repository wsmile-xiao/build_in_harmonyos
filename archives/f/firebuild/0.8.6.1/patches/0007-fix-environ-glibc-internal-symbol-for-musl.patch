From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HarmonyOS PC Porting <porting@example.com>
Date: Tue, 18 Aug 2026 21:00:00 +0800
Subject: [PATCH] Fix __environ glibc-internal symbol for musl libc

firebuild's intercept.c uses __environ, a glibc-internal symbol that
is an alias for the POSIX-standard environ global variable. musl libc
(used by OHOS) does not export __environ, causing compilation failures:

  intercept.c:874: error: use of undeclared identifier '__environ';
  did you mean 'environ'?

The code previously had #ifdef __APPLE__ branches that used environ on
macOS and __environ elsewhere. Since environ is POSIX-standard and
available on all platforms (glibc, musl, darwin), this patch unifies
both code paths to use environ directly, removing the platform-specific
#ifdef __APPLE__ guards.

This is a portable change: environ has identical semantics to
__environ on glibc (both point to the same environment pointer array),
and is the correct POSIX symbol to use.

--- a/src/interceptor/intercept.c
+++ b/src/interceptor/intercept.c
@@ -867,22 +867,19 @@
  * mpicc the constructor is called first, thus this heuristics is not used.
  */
 static void init_argc_argv() {
-#ifdef __APPLE__
-  char** __environ = environ;
-#endif
   if (ic_argv == NULL) {
-    char* arg = *(__environ - 2);
+    char* arg = *(environ - 2);
     unsigned long int argc_guess = 0;
 
     /* argv is NULL terminated */
-    assert(*(__environ - 1) == NULL);
+    assert(*(environ - 1) == NULL);
     /* walk back on argv[] to find the first value matching the counted argument number */
     while (argc_guess != (unsigned long int)arg) {
       argc_guess++;
-      arg = *(__environ - 2 - argc_guess);
+      arg = *(environ - 2 - argc_guess);
     }
     ic_argc = argc_guess;
-    ic_argv = __environ - 1 - argc_guess;
+    ic_argv = environ - 1 - argc_guess;
   }
 }
 
@@ -989,11 +986,7 @@
   fbbcomm_builder_scproc_query_set_umask(&ic_msg, initial_umask);
 
   /* make a sorted and filtered copy of env */
-#ifdef __APPLE__
   char **env = environ;
-#else
-  char **env = __environ;
-#endif
   int env_len = 0, env_copy_len = 0;
   for (char** cursor = env; *cursor != NULL; cursor++) {
     env_len++;
