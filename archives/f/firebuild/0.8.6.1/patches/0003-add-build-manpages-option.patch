From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HarmonyOS PC Porting <porting@example.com>
Date: Mon, 18 Aug 2026 00:00:00 +0800
Subject: [PATCH] Add BUILD_MANPAGES option to skip man page generation

Man page generation requires xsltproc and DocBook XSL stylesheets
loaded from http://docbook.sourceforge.net/. On HarmonyOS PC, the
network is restricted and DocBook XSL is not installed.

Add a BUILD_MANPAGES CMake option (default ON) so the Conan recipe
can pass -DBUILD_MANPAGES=OFF to skip man page generation.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -111,7 +111,11 @@
 
 enable_testing()
 add_subdirectory(test)
-add_subdirectory(man)
+# Skip man page generation on HarmonyOS PC (requires DocBook XSL)
+option(BUILD_MANPAGES "Build man pages with xsltproc" ON)
+if(BUILD_MANPAGES)
+  add_subdirectory(man)
+endif()
 
 # add a target to generate API documentation with Doxygen
 find_package(Doxygen)
