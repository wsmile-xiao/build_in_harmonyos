diff -ruN a/CMake/FindLibEvent.cmake b/CMake/FindLibEvent.cmake
--- a/CMake/FindLibEvent.cmake
+++ b/CMake/FindLibEvent.cmake
@@ -0,0 +1,41 @@
+# FindLibEvent.cmake - OpenHarmony adapted
+#
+# Find the libevent library
+#
+# This module defines:
+#  LIBEVENT_FOUND - True if libevent found
+#  LIBEVENT_INCLUDE_DIR - Include directories
+#  LIBEVENT_LIB - Libraries to link
+
+# Try pkg-config first
+find_package(PkgConfig QUIET)
+if(PkgConfig_FOUND)
+  pkg_check_modules(LIBEVENT_PKG libevent QUIET)
+endif()
+
+if(LIBEVENT_PKG_FOUND)
+  set(LIBEVENT_FOUND TRUE)
+  set(LIBEVENT_INCLUDE_DIR ${LIBEVENT_PKG_INCLUDE_DIRS})
+  set(LIBEVENT_LIB ${LIBEVENT_PKG_LIBRARIES})
+  message(STATUS "Found libevent via pkg-config: ${LIBEVENT_LIB}")
+else()
+  # Fallback to manual search
+  find_path(LIBEVENT_INCLUDE_DIR
+    NAMES event.h
+    HINTS ${CMAKE_PREFIX_PATH}/include
+    PATH_SUFFIXES event2
+  )
+
+  find_library(LIBEVENT_LIB
+    NAMES event event-2.1
+    HINTS ${CMAKE_PREFIX_PATH}/lib
+  )
+
+  include(FindPackageHandleStandardArgs)
+  find_package_handle_standard_args(LibEvent
+    DEFAULT_MSG
+    LIBEVENT_LIB LIBEVENT_INCLUDE_DIR
+  )
+endif()
+
+mark_as_advanced(LIBEVENT_INCLUDE_DIR LIBEVENT_LIB)