diff -ruN a/CMake/FindDoubleConversion.cmake b/CMake/FindDoubleConversion.cmake
--- a/CMake/FindDoubleConversion.cmake
+++ b/CMake/FindDoubleConversion.cmake
@@ -0,0 +1,39 @@
+# FindDoubleConversion.cmake - OpenHarmony adapted
+#
+# Find the double-conversion library
+#
+# This module defines:
+#  DOUBLE_CONVERSION_FOUND - True if double-conversion found
+#  DOUBLE_CONVERSION_INCLUDE_DIR - Include directories
+#  DOUBLE_CONVERSION_LIBRARY - Libraries to link
+
+# Use CMake Config mode first (CMAKE_PREFIX_PATH)
+find_package(double-conversion CONFIG QUIET)
+
+if(double-conversion_FOUND)
+  set(DOUBLE_CONVERSION_FOUND TRUE)
+  # For imported targets, we need to use the target directly
+  # The include dir and library are handled by the target
+  set(DOUBLE_CONVERSION_INCLUDE_DIR "${CMAKE_PREFIX_PATH}/include")
+  set(DOUBLE_CONVERSION_LIBRARY "double-conversion")
+  message(STATUS "Found double-conversion via Config")
+else()
+  # Fallback to manual search
+  find_path(DOUBLE_CONVERSION_INCLUDE_DIR
+    NAMES double-conversion/double-conversion.h
+    HINTS ${CMAKE_PREFIX_PATH}/include
+  )
+
+  find_library(DOUBLE_CONVERSION_LIBRARY
+    NAMES double-conversion
+    HINTS ${CMAKE_PREFIX_PATH}/lib
+  )
+
+  include(FindPackageHandleStandardArgs)
+  find_package_handle_standard_args(DoubleConversion
+    DEFAULT_MSG
+    DOUBLE_CONVERSION_LIBRARY DOUBLE_CONVERSION_INCLUDE_DIR
+  )
+endif()
+
+mark_as_advanced(DOUBLE_CONVERSION_INCLUDE_DIR DOUBLE_CONVERSION_LIBRARY)