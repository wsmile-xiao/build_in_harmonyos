diff -ruN a/CMake/FindGlog.cmake b/CMake/FindGlog.cmake
--- a/CMake/FindGlog.cmake
+++ b/CMake/FindGlog.cmake
@@ -0,0 +1,37 @@
+# FindGlog.cmake - OpenHarmony adapted
+#
+# Find the glog library
+#
+# This module defines:
+#  GLOG_FOUND - True if glog found
+#  GLOG_INCLUDE_DIR - Include directories
+#  GLOG_LIBRARY - Libraries to link
+
+# Use CMake Config mode first
+find_package(glog CONFIG QUIET)
+
+if(glog_FOUND)
+  set(GLOG_FOUND TRUE)
+  set(GLOG_INCLUDE_DIR "${CMAKE_PREFIX_PATH}/include")
+  set(GLOG_LIBRARY "glog")
+  message(STATUS "Found glog via Config")
+else()
+  # Fallback to manual search
+  find_path(GLOG_INCLUDE_DIR
+    NAMES glog/logging.h
+    HINTS ${CMAKE_PREFIX_PATH}/include
+  )
+
+  find_library(GLOG_LIBRARY
+    NAMES glog
+    HINTS ${CMAKE_PREFIX_PATH}/lib
+  )
+
+  include(FindPackageHandleStandardArgs)
+  find_package_handle_standard_args(Glog
+    DEFAULT_MSG
+    GLOG_LIBRARY GLOG_INCLUDE_DIR
+  )
+endif()
+
+mark_as_advanced(GLOG_INCLUDE_DIR GLOG_LIBRARY)