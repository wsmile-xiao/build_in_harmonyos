 #elif defined(__ANDROID__)
 #define FOLLY_ELF_NATIVE_CLASS __WORDSIZE
+#elif defined(__OHOS__)
+// OHOS 不定义 __ELF_NATIVE_CLASS（musl 风格 libc），亦不属 FreeBSD/Android；
+// 且 OHOS 下 __WORDSIZE 未定义（Android 分支依赖它，此处不可沿用）。
+// aarch64-ohos 为 LP64，__LP64__ 由 clang 为标准内置宏，按 FreeBSD 同款判定。
+#if defined(__LP64__)
+#define FOLLY_ELF_NATIVE_CLASS 64
+#else
+#define FOLLY_ELF_NATIVE_CLASS 32
+#endif
 #endif // __ELF_NATIVE_CLASS
 
