diff -ruN a/CMake/folly-deps.cmake b/CMake/folly-deps.cmake
--- a/CMake/folly-deps.cmake	2026-07-27 22:27:17.000000000 +0800
+++ b/CMake/folly-deps.cmake	2026-09-25 23:23:57.349586250 +0800
@@ -40,7 +40,6 @@
 # add them to their EXTERNAL_DEPS (e.g., Boost::regex, Boost::context).
 # Boost::thread is needed by Windows pthread compatibility layer.
 set(FOLLY_BOOST_COMPONENTS
-    context
     filesystem
     program_options
     regex
@@ -53,6 +52,10 @@
   COMPONENTS
     ${FOLLY_BOOST_COMPONENTS}
 )
+# OHOS: 整合 boost 均不提供 Boost::context 组件（context 与主 boost 互斥）。
+# context 由拆分包 boost1.84-context（cmake_file_name=Boost.Context）另行提供，
+# 经 cmake_target_name 暴露 Boost::context，fibers 的 EXTERNAL_DEPS 引用可解析。
+find_package(Boost.Context REQUIRED CONFIG)
 # Only add include directories globally, not libraries
 # Per-target Boost dependencies are specified via EXTERNAL_DEPS
 list(APPEND FOLLY_INCLUDE_DIRECTORIES ${Boost_INCLUDE_DIRS})