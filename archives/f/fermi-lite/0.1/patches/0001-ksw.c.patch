+kswr_t ksw_u8(kswq_t *q, int tlen, const uint8_t *target, int _gapo, int _gape, int xtra) // the first gap costs -(_o+_e)
+{
+	int i, j, k, qlen = q->qlen, m_b = 0, n_b = 0, te = -1, gmax = 0, minsc, endsc;
+	uint64_t *b = 0;
+	uint8_t *H0 = (uint8_t*)q->H0, *H1 = (uint8_t*)q->H1, *E = (uint8_t*)q->E, *Hmax = (uint8_t*)q->Hmax;
+	uint8_t *qp = (uint8_t*)q->qp;
+	int gapoe = _gapo + _gape, gape = _gape;
+	kswr_t r = g_defr;
+
+	minsc = (xtra&KSW_XSUBO)? xtra&0xffff : 0x10000;
+	endsc = (xtra&KSW_XSTOP)? xtra&0xffff : 0x10000;
+	for (i = 0; i < qlen; ++i) E[i] = H0[i] = Hmax[i] = 0;
+	for (i = 0; i < tlen; ++i) {
+		int imax = 0, maxv = 0, f = 0;
+		uint8_t *S = qp + target[i] * qlen;
+		for (j = 0; j < qlen; ++j) {
+			// H(i,j) = max{H(i-1,j-1)+S(i,j), E(i,j), F(i,j)}
+			int h = KSW_CLAMP8((j == 0? 0 : (int)H0[j-1]) + (int)S[j] - q->shift);
+			int e = E[j];
+			if (h < e) h = e;
+			if (h < f) h = f;
+			H1[j] = (uint8_t)h;
+			if (h > maxv) maxv = h;
+			// E(i+1,j) = max{H(i,j)-gapo, E(i,j)-gape}
+			e = KSW_CLAMP8(h - gapoe);
+			int e2 = KSW_CLAMP8((int)E[j] - gape);
+			if (e2 > e) e = e2;
+			E[j] = (uint8_t)e;
+			// F(i,j+1) = max{H(i,j)-gapo, F(i,j)-gape}
+			f = KSW_CLAMP8(f - gape);
+			int f2 = KSW_CLAMP8(h - gapoe);
+			if (f2 > f) f = f2;
+		}
+		// lazy-F loop: propagate F to the right (mirrors the SSE2 SWPS3 block)
+		for (k = 0; k < 16; ++k) {
+			int allstop = 1, prev = 0;
+			for (j = 0; j < qlen; ++j) {
+				int fv = prev; prev = f; // f shifted by one position
+				(void)fv;
+			}
+			break;
+		}
+		// note: the scalar core above already propagates F fully; the extra
+		// SSE2 SWPS3 lazy-F block is a lane-parallelism artifact and is not
+		// needed here.
+		imax = maxv;
+		if (imax >= minsc) {
+			if (n_b == 0 || (int32_t)b[n_b-1] + 1 != i) {
+				if (n_b == m_b) {
+					m_b = m_b? m_b<<1 : 8;
+					b = (uint64_t*)realloc(b, 8 * m_b);
+				}
+				b[n_b++] = (uint64_t)imax<<32 | i;
+			} else if ((int)(b[n_b-1]>>32) < imax) b[n_b-1] = (uint64_t)imax<<32 | i;
+		}
+		if (imax > gmax) {
+			gmax = imax; te = i;
+			memcpy(Hmax, H1, qlen);
+			if (gmax + q->shift >= 255 || gmax >= endsc) break;
+		}
+		{ uint8_t *t = H0; H0 = H1; H1 = t; } // swap H0 and H1
+	}
+	r.score = gmax + q->shift < 255? gmax : 255;
+	r.te = te;
+	if (r.score != 255) {
+		int max = -1, low, high;
+		uint8_t *t = (uint8_t*)Hmax;
+		for (i = 0; i < qlen; ++i, ++t)
+			if ((int)*t > max) max = *t, r.qe = i;
+		if (b) {
+			i = (r.score + q->max - 1) / q->max;
+			low = te - i; high = te + i;
+			for (i = 0; i < n_b; ++i) {
+				int e = (int32_t)b[i];
+				if ((e < low || e > high) && b[i]>>32 > (uint32_t)r.score2)
+					r.score2 = b[i]>>32, r.te2 = e;
+			}
+		}
+	}
+	free(b);
+	return r;
+}
