+	int16_t *qp = (int16_t*)q->qp;
+	int gapoe = _gapo + _gape, gape = _gape;
+	kswr_t r = g_defr;
+
+	minsc = (xtra&KSW_XSUBO)? xtra&0xffff : 0x10000;
+	endsc = (xtra&KSW_XSTOP)? xtra&0xffff : 0x10000;
+	for (i = 0; i < qlen; ++i) E[i] = H0[i] = Hmax[i] = 0;
+	for (i = 0; i < tlen; ++i) {
+		int imax, maxv = 0, f = 0;
+		int16_t *S = qp + target[i] * qlen;
+		for (j = 0; j < qlen; ++j) {
+			// H(i,j) = max{H(i-1,j-1)+S(i,j), E(i,j), F(i,j)}
+			int h = KSW_CLAMP16((j == 0? 0 : (int)H0[j-1]) + (int)S[j]);
+			int e = E[j];
+			if (h < e) h = e;
+			if (h < f) h = f;
+			H1[j] = (int16_t)h;
+			if (h > maxv) maxv = h;
+			// E(i+1,j) = max{H(i,j)-gapo, E(i,j)-gape}
+			e = KSW_CLAMP16(h - gapoe);
+			int e2 = KSW_CLAMP16((int)E[j] - gape);
+			if (e2 > e) e = e2;
+			E[j] = (int16_t)e;
+			// F(i,j+1) = max{H(i,j)-gapo, F(i,j)-gape}
+			f = KSW_CLAMP16(f - gape);
+			int f2 = KSW_CLAMP16(h - gapoe);
+			if (f2 > f) f = f2;
+		}
