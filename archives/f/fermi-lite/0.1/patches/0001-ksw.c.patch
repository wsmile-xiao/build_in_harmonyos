+			} else if ((int)(b[n_b-1]>>32) < imax) b[n_b-1] = (uint64_t)imax<<32 | i;
+		}
+		if (imax > gmax) {
+			gmax = imax; te = i;
+			memcpy(Hmax, H1, qlen * sizeof(int16_t));
+			if (gmax >= endsc) break;
+		}
+		{ int16_t *t = H0; H0 = H1; H1 = t; } // swap H0 and H1
+	}
