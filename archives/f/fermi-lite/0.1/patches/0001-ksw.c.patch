+kswq_t *ksw_qinit(int size, int qlen, const uint8_t *query, int m, const int8_t *mat)
+{
+	kswq_t *q;
+	int a, tmp;
+	size = size > 1? 2 : 1;
+	q = (kswq_t*)calloc(1, sizeof(kswq_t) + 256 + qlen * (m + 4) * (size == 1 ? 1 : 2));
+	q->qp = (void*)(((size_t)q + sizeof(kswq_t) + 15) >> 4 << 4);
+	q->H0 = (uint8_t*)q->qp + qlen * m * (size == 1 ? 1 : 2);
+	q->H1 = (uint8_t*)q->H0 + qlen * (size == 1 ? 1 : 2);
+	q->E  = (uint8_t*)q->H1 + qlen * (size == 1 ? 1 : 2);
+	q->Hmax = (uint8_t*)q->E + qlen * (size == 1 ? 1 : 2);
+	q->slen = qlen; q->qlen = qlen; q->size = size;
+	// compute shift
+	tmp = m * m;
+	for (a = 0, q->shift = 127, q->mdiff = 0; a < tmp; ++a) { // find the minimum and maximum score
+		if (mat[a] < (int8_t)q->shift) q->shift = mat[a];
+		if (mat[a] > (int8_t)q->mdiff) q->mdiff = mat[a];
+	}
+	q->max = q->mdiff;
+	q->shift = 256 - q->shift; // NB: q->shift is uint8_t
+	q->mdiff += q->shift; // this is the difference between the min and max scores
+	if (size == 1) {
+		int8_t *t = (int8_t*)q->qp;
+		for (a = 0; a < m; ++a) {
+			int k;
+			const int8_t *ma = mat + a * m;
+			for (k = 0; k < qlen; ++k)
+				*t++ = (k >= qlen? 0 : ma[query[k]]) + q->shift;
+		}
+	} else {
+		int16_t *t = (int16_t*)q->qp;
+		for (a = 0; a < m; ++a) {
+			int k;
+			const int8_t *ma = mat + a * m;
+			for (k = 0; k < qlen; ++k)
+				*t++ = (k >= qlen? 0 : ma[query[k]]);
+		}
+	}
+	return q;
+}
