+#define KSW_CLAMP8(x) ((x) > 255 ? 255 : ((x) < 0 ? 0 : (x)))
+#define KSW_CLAMP16(x) ((x) > 32767 ? 32767 : ((x) < -32768 ? -32768 : (x)))
