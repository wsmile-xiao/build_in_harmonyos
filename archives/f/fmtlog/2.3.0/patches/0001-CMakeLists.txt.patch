--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,31 +1,42 @@
 cmake_minimum_required(VERSION 3.15)
 
 project(fmtlog CXX)
+
+# OHOS/HarmonyOS 适配：默认不构建测试子目录（conan 包装模式用），
+# 需要上游测试时以 -DFMTLOG_BUILD_TEST=ON 显式开启。
+option(FMTLOG_BUILD_TEST "Build fmtlog tests" OFF)
 
 if(MSVC)
     add_compile_options(/std:c++latest)
 else()
     add_compile_options(-Wall -O3 -std=c++17)
     #add_compile_options(-Wall -Ofast -std=c++2a -DNDEBUG -march=skylake -flto -fno-exceptions -fno-rtti -fno-unwind-tables -fno-asynchronous-unwind-tables -DFMTLOG_NO_CHECK_LEVEL=1)
     #SET(CMAKE_AR  "gcc-ar")
     #SET(CMAKE_RANLIB  "gcc-ranlib")
     link_libraries(pthread)
 endif()
 
 link_directories(.)
 include_directories(fmt/include)
 
 add_library(fmtlog-shared SHARED fmtlog.cc)
-if(MSVC)
-  target_link_libraries(fmtlog-shared fmt)
+target_link_libraries(fmtlog-shared fmt)
+install(TARGETS fmtlog-shared
+        LIBRARY DESTINATION lib
+        RUNTIME DESTINATION bin)
+
+add_library(fmtlog-static STATIC fmtlog.cc)
+target_link_libraries(fmtlog-static fmt)
+install(TARGETS fmtlog-static
+        ARCHIVE DESTINATION lib)
+
+# 安装公共头文件（原 CMakeLists 未安装；上游用法为 #include "fmtlog/fmtlog.h"）
+install(FILES fmtlog.h fmtlog-inl.h DESTINATION include/fmtlog)
+
+# fmtlog-shared 链接 fmt 静态库，需 -fPIC（fmt 子模块默认无 PIC 开关，
+# 故用全局 CMAKE_POSITION_INDEPENDENT_CODE 强制）
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+add_subdirectory(fmt)
+if(FMTLOG_BUILD_TEST)
+  add_subdirectory(test)
 endif()
-install(TARGETS fmtlog-shared)
-
-add_library(fmtlog-static fmtlog.cc)
-if(MSVC)
-  target_link_libraries(fmtlog-static fmt)
-endif()
-install(TARGETS fmtlog-static)
-
-add_subdirectory(fmt)
-add_subdirectory(test)
