Description: Guard the optional debug configuration before lowercasing
 AppConfig returns an undefined value when debug is omitted. Treat that
 optional setting as disabled instead of passing undef to lc.
Author: OpenHarmony PC adaptation
Forwarded: no

--- a/bin/flamethrowerd
+++ b/bin/flamethrowerd
@@ -88,21 +88,22 @@
 if($version) {
     print qq($version_info);
     exit 0;
 }
 
 # Read the config file and update the directory
 read_config_file($conf_file);
 
 # Turn on in flamethrower.conf file to see debug output.
 my $debug;
-if ( lc $ft_config->debug() eq "on" ) {
+my $debug_config = $ft_config->debug();
+if ( defined $debug_config && lc($debug_config) eq "on" ) {
     $debug = 1;
     print "Flamethrower debug output turned on\n" if($debug);
 }
 
 # Should we start up?
 if ( $ft_config->start_flamethrower_daemon() ne "yes" ) {
     exit 0;
 }
 
 # Warn if specified interface doesn't exist.
