Description: Load Flamethrower.pm from the package-provided library path
 The installed package wrapper exports FLAMETHROWER_LIBDIR before invoking
 the real Perl script. Do not probe the inaccessible system path on HMDFS.
Author: OpenHarmony PC adaptation
Forwarded: no

Index: flamethrower-0.1.8/bin/flamethrower
===================================================================
--- bin/flamethrower
+++ bin/flamethrower
@@ -10,8 +10,12 @@ use strict;
 use strict;
 use File::Path;
 use File::Temp;
 use Getopt::Long;
 
-use lib "/usr/lib/flamethrower";
+BEGIN {
+    unshift @INC, $ENV{FLAMETHROWER_LIBDIR}
+        if defined $ENV{FLAMETHROWER_LIBDIR}
+        && length $ENV{FLAMETHROWER_LIBDIR};
+}
 use Flamethrower;
 
 use vars qw($config $ft_config $VERSION);
