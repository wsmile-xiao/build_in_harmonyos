Description: Avoid File::Which runtime dependency and fix global TTL argv
 Debian's udpcast-stop patch converted the sender command to argv form but
 introduced File::Which only to find udp-sender. Flamethrower.pm already has
 a local PATH check, and Perl can exec "udp-sender" through PATH in list form.
 The same Debian patch also left a leading space in the global --ttl argv
 entry; remove it so global TTL matches module-specific TTL.
Author: 2301_80739235 <2047361658@qq.com>
Forwarded: no

Index: flamethrower-0.1.8/bin/flamethrowerd
===================================================================
--- bin/flamethrowerd
+++ bin/flamethrowerd
@@ -12,7 +12,6 @@ $0 = "flamethrowerd";
 
 use strict;
 use File::stat;
-use File::Which;
 use Getopt::Long;
 use POSIX qw(setsid);
 
@@ -249,7 +248,7 @@ sub build_udp_sender_cmd {
     
     my @ttl;
     if ( $ft_config->get("ttl") ) {
-        @ttl = (" --ttl", $ft_config->get("ttl"));
+        @ttl = ("--ttl", $ft_config->get("ttl"));
     }
     #
     ############################################################################
@@ -310,7 +309,7 @@ sub build_udp_sender_cmd {
     #
     # -S, --sparse / handle sparse files efficiently
     #
-    my @cmd = (which("udp-sender"), qq(--pipe), qq(tar -B -S -cpf - -C $dir .));
+    my @cmd = (qq(udp-sender), qq(--pipe), qq(tar -B -S -cpf - -C $dir .));
     #my $cmd = qq(udp-sender --pipe 'tar -czpf - -C $dir .');
     @cmd = (@cmd, @portbase)               if(@portbase);
     @cmd = (@cmd, @min_clients)            if(@min_clients);
