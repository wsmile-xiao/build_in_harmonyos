 static void dns_resolve_cb(struct ns_dns_message *msg, void *data) {
   struct ns_dns_resource_record *rr;
   char cname[256];
   struct in_addr got_addr;
   in_addr_t want_addr = inet_addr("52.16.170.74");
+
+  /*
+   * ns_resolve_async_eh() calls this callback with msg == NULL when the query
+   * timed out or the reply carries no answer (fossa.c:7068, fossa.c:7084), and
+   * ns_dns_next_record() dereferences msg unconditionally (fossa.c:6510).
+   * Upstream's own dns_resolve_timeout_cb() has the same guard; without it a
+   * failed lookup crashes this test instead of making it fail.
+   */
+  if (msg == NULL) {
+    *(int *) data = 2; /* Error */
+    return;
+  }
+
+  /* Both locals are only written when the matching record is present. */
+  memset(cname, 0, sizeof(cname));
+  memset(&got_addr, 0, sizeof(got_addr));
 
   rr = ns_dns_next_record(msg, NS_DNS_A_RECORD, NULL);
   if (rr != NULL) {
     ns_dns_parse_record_data(msg, rr, &got_addr, sizeof(got_addr));
   }
 
   rr = ns_dns_next_record(msg, NS_DNS_CNAME_RECORD, NULL);
   if (rr != NULL) {
     ns_dns_parse_record_data(msg, rr, cname, sizeof(cname));
   }
