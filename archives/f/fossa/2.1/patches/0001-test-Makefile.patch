--- a/test/Makefile
+++ b/test/Makefile
@@ -1,11 +1,19 @@
 SOURCES=unit_test.c test_util.c ../fossa.c
 CFLAGS = -W -Wall -I../.. -pthread -DNS_ENABLE_COAP -DNS_ENABLE_IPV6 -DNS_ENABLE_THREADS -DNS_ENABLE_MQTT_BROKER -DNS_ENABLE_DNS_SERVER \
-	       -DNS_INTERNAL="" -DNS_MODULE_LINES -include unit_test.h -DNS_MALLOC=test_malloc -DNS_CALLOC=test_calloc -lssl $(CFLAGS_EXTRA)
+	       -DNS_INTERNAL="" -DNS_MODULE_LINES -include unit_test.h -DNS_MALLOC=test_malloc -DNS_CALLOC=test_calloc $(CFLAGS_EXTRA)
+
+# OpenSSL is only required when TLS support is compiled in. The default
+# test build leaves NS_ENABLE_SSL undefined and therefore contains no SSL
+# code at all, yet -lssl was linked unconditionally: on systems without
+# OpenSSL development files the test binary cannot be linked.
+ifneq (,$(findstring NS_ENABLE_SSL,$(CFLAGS)))
+CFLAGS += -lssl
+endif
 
 all: test
 
 unit_test: $(SOURCES) ../fossa.h
 	@$(CC) $(SOURCES) -o $@ $(CFLAGS)
 
 test: unit_test
 	@MallocLogFile=/dev/null ./unit_test $(TEST_FILTER)
