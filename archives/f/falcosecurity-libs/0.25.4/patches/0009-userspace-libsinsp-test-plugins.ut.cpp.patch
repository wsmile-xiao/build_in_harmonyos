 	ASSERT_GT(m_inspector.get_machine_info()->num_cpus, 0);
 #endif
 
 	auto evt = next_event();
 	ASSERT_NE(evt, nullptr);
 	ASSERT_EQ(evt->get_type(), PPME_SYSCALL_OPEN_X);
