@@ -64,10 +68,21 @@ TEST_LIST = {
     NULL, NULL}
 };
 
-void set_output(char *val)
+void set_output(char *val, size_t size)
 {
     pthread_mutex_lock(&result_mutex);
-    output = val;
+
+    if (output != NULL) {
+        flb_free(output);
+        output = NULL;
+    }
+
