-    /*Check that the message go throught engine without modification */
-    TEST_CHECK(strncmp(result, message, strlen(result)) == 0);
+    /* Check that the message goes through the engine without modification. */
+    if (TEST_CHECK(result != NULL)) {
+        TEST_CHECK(compare_json_records(result, message) == FLB_TRUE);
+        flb_free(result);
+    }
 }
 
