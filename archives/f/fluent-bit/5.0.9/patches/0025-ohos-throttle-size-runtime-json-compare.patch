     pthread_mutex_unlock(&result_mutex);
 }
 
@@ -87,11 +102,59 @@ int callback_test(void *data, size_t size, void *cb_data)
 {
     if (size > 0) {
         flb_debug("[test_filter_throttle_size] received message: %s", data);
