     }
     return 0;
 }
 
+static int compare_json_records(const char *result, const char *message)
+{
+    int ret;
+    int matched = FLB_FALSE;
+    int result_type = -1;
+    int message_type = -1;
+    char *result_msgpack = NULL;
+    char *message_msgpack = NULL;
+    size_t result_msgpack_size = 0;
+    size_t message_msgpack_size = 0;
+    flb_sds_t result_json = NULL;
+    flb_sds_t message_json = NULL;
+
+    ret = flb_pack_json(result, strlen(result), &result_msgpack,
+                        &result_msgpack_size, &result_type, NULL);
+    if (ret != 0) {
+        goto cleanup;
+    }
+
+    ret = flb_pack_json(message, strlen(message), &message_msgpack,
+                        &message_msgpack_size, &message_type, NULL);
+    if (ret != 0) {
+        goto cleanup;
+    }
+
+    if (result_type != message_type) {
+        goto cleanup;
+    }
+
+    result_json = flb_msgpack_raw_to_json_sds(result_msgpack,
+                                              result_msgpack_size, FLB_TRUE);
+    message_json = flb_msgpack_raw_to_json_sds(message_msgpack,
+                                               message_msgpack_size, FLB_TRUE);
+    if (result_json == NULL || message_json == NULL) {
+        goto cleanup;
+    }
+
+    matched = (strcmp(result_json, message_json) == 0);
+
+cleanup:
+    flb_sds_destroy(result_json);
+    flb_sds_destroy(message_json);
+    flb_free(result_msgpack);
+    flb_free(message_msgpack);
+
+    return matched;
+}
+
