+static char *make_test_store_dir(const char *postfix)
+{
+    static char store_dir[2048];
+    char *tmp;
+
+    tmp = flb_test_tmpdir_cat(postfix);
+    if (!TEST_CHECK(tmp != NULL)) {
+        return NULL;
+    }
+
+    if (!TEST_CHECK(strlen(tmp) < sizeof(store_dir))) {
+        flb_free(tmp);
+        return NULL;
+    }
+
+    strcpy(store_dir, tmp);
+    flb_free(tmp);
+
+    if (!TEST_CHECK(mkdtemp(store_dir) != NULL)) {
+        return NULL;
+    }
+
+    return store_dir;
+}
