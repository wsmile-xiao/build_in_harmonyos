diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2f545f5..fa3fb10 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,6 +1,16 @@
 cmake_minimum_required(VERSION 3.12)
 project(fluent-bit C)
 
+# HarmonyOS adaptation: ensure generated monkey headers are resolvable via
+# angle-bracket includes used throughout lib/monkey (e.g. <monkey/mk_info.h>
+# in mk_scheduler.h and <mk_core/mk_core_info.h> in mk_getopt.h).
+include_directories(BEFORE "${CMAKE_BINARY_DIR}/include/")
+include_directories(BEFORE "${CMAKE_BINARY_DIR}/include/monkey/")
+
+if(FTS_INCLUDE_DIR)
+  include_directories(BEFORE "${FTS_INCLUDE_DIR}")
+endif()
+
 include(CheckCCompilerFlag)
 
 # CMP0069 ensures that LTO is enabled for all compilers
@@ -873,6 +883,17 @@ if(FLB_TLS)
 
   # find OpenSSL (our preferred choice now)
   find_package(OpenSSL)
+  if(OpenSSL_FOUND AND NOT OPENSSL_FOUND)
+    set(OPENSSL_FOUND ${OpenSSL_FOUND})
+  endif()
+  if(OpenSSL_INCLUDE_DIRS)
+    include_directories(${OpenSSL_INCLUDE_DIRS})
+  elseif(OPENSSL_INCLUDE_DIRS)
+    include_directories(${OPENSSL_INCLUDE_DIRS})
+  elseif(OPENSSL_INCLUDE_DIR)
+    include_directories(${OPENSSL_INCLUDE_DIR})
+  endif()
+
   if(OPENSSL_FOUND)
     FLB_DEFINITION(FLB_HAVE_OPENSSL)
   endif()
