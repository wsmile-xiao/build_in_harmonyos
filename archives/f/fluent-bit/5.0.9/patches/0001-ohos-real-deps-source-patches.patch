+static int ra_is_identifier_start(char c)
+{
+    if (c == '_' || (c >= 'A' && c <= 'Z') ||
+        (c >= 'a' && c <= 'z')) {
+        return FLB_TRUE;
+    }
+
+    return FLB_FALSE;
+}
+
+static int ra_is_identifier_char(char c)
+{
+    if (ra_is_identifier_start(c) || (c >= '0' && c <= '9') ||
+        c == '.' || c == '-' || c == '/') {
+        return FLB_TRUE;
+    }
+
+    return FLB_FALSE;
+}
+
+static int ra_add_string_subkey(struct flb_ra_parser *rp, char *str,
+                                int *pos, int len)
+{
+    int i;
+    int ret;
+    flb_sds_t tmp;
+    flb_sds_t subkey;
+
+    i = *pos + 2;
+    subkey = flb_sds_create_size(len - i + 1);
+    if (!subkey) {
+        flb_errno();
+        return -1;
+    }
+
+    while (i < len) {
+        if (str[i] == '\'') {
+            if (i + 1 < len && str[i + 1] == '\'') {
+                tmp = flb_sds_cat(subkey, "'", 1);
+                if (!tmp) {
+                    flb_sds_destroy(subkey);
+                    return -1;
+                }
+                subkey = tmp;
+                i += 2;
+                continue;
+            }
+
+            if (i + 1 >= len || str[i + 1] != ']') {
+                flb_sds_destroy(subkey);
+                return -1;
+            }
+
+            ret = flb_ra_parser_subentry_add_string(rp, subkey);
+            flb_sds_destroy(subkey);
+            if (ret == -1) {
+                return -1;
+            }
+            *pos = i + 2;
+            return 0;
+        }
+
+        tmp = flb_sds_cat(subkey, str + i, 1);
+        if (!tmp) {
+            flb_sds_destroy(subkey);
+            return -1;
+        }
+        subkey = tmp;
+        i++;
+    }
+
+    flb_sds_destroy(subkey);
+    return -1;
+}
+
+static int ra_add_array_subkey(struct flb_ra_parser *rp, char *str,
+                               int *pos, int len)
+{
+    int i;
+    int id = 0;
+
+    i = *pos + 1;
+    if (i >= len || str[i] < '0' || str[i] > '9') {
+        return -1;
+    }
+
+    if (str[i] == '0' && i + 1 < len && str[i + 1] >= '0' && str[i + 1] <= '9') {
+        return -1;
+    }
+
+    while (i < len && str[i] >= '0' && str[i] <= '9') {
+        if (id > (2147483647 - (str[i] - '0')) / 10) {
+            return -1;
+        }
+        id = (id * 10) + (str[i] - '0');
+        i++;
+    }
+
+    if (i >= len || str[i] != ']') {
+        return -1;
+    }
+
+    if (flb_ra_parser_subentry_add_array_id(rp, id) == -1) {
+        return -1;
+    }
+
+    *pos = i + 1;
+    return 0;
+}
