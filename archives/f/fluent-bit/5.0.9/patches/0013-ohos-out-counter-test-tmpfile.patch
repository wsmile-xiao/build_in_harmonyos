 #include <string.h>
 
 #ifdef _WIN32
@@ -24,6 +26,37 @@
 #include "data/common/json_long.h"    /* JSON_LONG    */
 #include "data/common/json_small.h"   /* JSON_SMALL   */
 
+static FILE *flb_test_counter_tmpfile(void)
+{
+#ifdef _WIN32
+    return tmpfile();
+#else
+    int fd;
+    FILE *fp;
+    char *path;
+
+    path = flb_test_tmpdir_cat("/flb-out-counter-capture-XXXXXX");
+    if (path == NULL) {
+        return NULL;
+    }
+
+    fd = mkstemp(path);
+    if (fd == -1) {
+        flb_free(path);
+        return NULL;
+    }
+
+    unlink(path);
+    fp = fdopen(fd, "w+");
+    if (fp == NULL) {
+        close(fd);
+    }
+
+    flb_free(path);
+    return fp;
+#endif
+}
