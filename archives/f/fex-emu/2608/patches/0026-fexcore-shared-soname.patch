--- a/FEXCore/Source/CMakeLists.txt
+++ b/FEXCore/Source/CMakeLists.txt
@@ -289,6 +289,13 @@
 AddLibrary(${PROJECT_NAME} STATIC)
 AddLibrary(${PROJECT_NAME}_shared SHARED)
 
+if (CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+  # CMake has no Platform/HarmonyOS module, so it never emits the linker flag
+  # that records a DT_SONAME for shared libraries. Without it libFEXCore.so is
+  # unusable by downstream linkers and fails the packaging SONAME gate.
+  target_link_options(${PROJECT_NAME}_shared PRIVATE "-Wl,-soname,lib${PROJECT_NAME}.so")
+endif()
+
 if (NOT MINGW AND NOT BUILD_STEAM_SUPPORT)
   install(TARGETS ${PROJECT_NAME}_shared LIBRARY
     DESTINATION ${CMAKE_INSTALL_LIBDIR}
