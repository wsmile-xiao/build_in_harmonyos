 private:
+  // libc++ 16 and newer advertise a conditional noexcept on std::function's
+  // converting constructor, which lets the compiler prove that small callables
+  // are stored without allocating. libc++ 15 (shipped with the OHOS SDK) does
+  // not, so fall back to the inline buffer criterion directly: libc++ stores
+  // callables up to three pointers wide (see __functional/function.h,
+  // aligned_storage<3 * sizeof(void*)>) without an allocation.
+  template<typename F>
+  static constexpr bool FitsStdFunctionInlineBuffer() {
+#if defined(_LIBCPP_VERSION)
+    using Functor = std::remove_reference_t<F>;
+    return sizeof(Functor) <= 3 * sizeof(void*) && alignof(Functor) <= alignof(void*);
+#else
+    return false;
+#endif
+  }
