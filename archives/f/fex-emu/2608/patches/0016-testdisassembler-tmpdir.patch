+namespace {
+// OHOS mounts the C library temporary directory (P_tmpdir, usually "/tmp")
+// read-only, which makes tmpfile() return nullptr there. Create the scratch
+// file in TMPDIR (the standard user writable temporary directory) instead.
+inline FILE* FEXUnitTestTmpFile() {
+  const char* Dir = getenv("TMPDIR");
+  if (Dir == nullptr || *Dir == '\0') {
+    Dir = "/tmp";
+  }
+  fextl::string Template = fextl::string {Dir} + "/fexunittestXXXXXX";
+  const int FD = mkstemp(Template.data());
+  if (FD == -1) {
+    return nullptr;
+  }
+  // Unlink immediately to match tmpfile()'s anonymous file semantics.
+  unlink(Template.c_str());
+  return fdopen(FD, "w+");
+}
+} // namespace
 
