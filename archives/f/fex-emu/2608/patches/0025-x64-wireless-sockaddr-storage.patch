--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/x64/Ioctl/wireless.h
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/x64/Ioctl/wireless.h
@@ -3,7 +3,15 @@
 #include "LinuxSyscalls/x64/Ioctl/HelperDefines.h"
 
 #include <cstdint>
+
+// The OHOS kernel uapi <linux/socket.h> defines struct sockaddr_storage without
+// a header guard, so including it after the libc <sys/socket.h> (which already
+// provided the struct) is a redefinition. <linux/wireless.h> and <linux/if.h>
+// only need struct sockaddr, which comes from <sys/socket.h>, so skip the uapi
+// copy to avoid the clash.
+#define _UAPI_LINUX_SOCKET_H
 #include <linux/wireless.h>
+#undef _UAPI_LINUX_SOCKET_H
 #include <sys/ioctl.h>
 
 namespace FEX::HLE::x64 {
