--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -61,12 +61,19 @@
   message(FATAL_ERROR "Unsupported pointer size ${CMAKE_SIZEOF_VOID_P}."
     " FEX only supports 64-bit (8-byte pointer) systems."
     " If you believe this is in error, file an issue.")
-elseif (NOT (WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux"))
+elseif (NOT (WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS"))
   message(FATAL_ERROR "Unsupported system type ${CMAKE_SYSTEM_NAME}."
-    " FEX only supports Linux and Windows."
+    " FEX only supports Linux, Windows and HarmonyOS."
     " If you believe this is in error, file an issue.")
 endif()
 
+# The libc++ shipped with the OpenHarmony SDK (LLVM 15.0.4) hides the C++20
+# ranges algorithms behind _LIBCPP_ENABLE_EXPERIMENTAL; libc++ 16 enables them
+# unconditionally. FEXCore relies on std::ranges algorithms, so opt in here.
+if (CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+  add_compile_definitions(_LIBCPP_ENABLE_EXPERIMENTAL)
+endif()
+
 ## Compiler Checks ##
 # GCC and MSVC are unsupported
 if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
@@ -87,6 +94,18 @@
 
 ## Architecture Handling ##
 string(TOLOWER ${CMAKE_SYSTEM_PROCESSOR} processor)
+if (processor STREQUAL "" OR processor STREQUAL "unknown")
+  # CMake has no Platform/HarmonyOS module, so the OHOS toolchain leaves
+  # CMAKE_SYSTEM_PROCESSOR as "unknown". Fall back to the compiler's own
+  # target triple (e.g. aarch64-unknown-linux-ohos).
+  execute_process(
+    COMMAND ${CMAKE_CXX_COMPILER} -dumpmachine
+    OUTPUT_VARIABLE FEX_COMPILER_MACHINE
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+    ERROR_QUIET)
+  string(TOLOWER "${FEX_COMPILER_MACHINE}" processor)
+  message(STATUS "CMAKE_SYSTEM_PROCESSOR unknown, using compiler triple '${processor}'")
+endif()
 if (processor MATCHES "x86|amd64")
   option(ENABLE_X86_HOST_DEBUG "Enables compiling on x86_64 host" FALSE)
   if (NOT ENABLE_X86_HOST_DEBUG)
@@ -246,6 +265,13 @@
   return program_invocation_name == nullptr;
   }"
   HAS_PROGRAM_INVOCATION_NAME)
+
+# A failed check leaves the variable empty, which would emit a bare
+# "-DHAS_PROGRAM_INVOCATION_NAME=" and break the #if in ELFCodeLoader.h
+# (program_invocation_name is a glibc extension, absent from the OHOS libc).
+if (NOT HAS_PROGRAM_INVOCATION_NAME)
+  set(HAS_PROGRAM_INVOCATION_NAME 0)
+endif()
 add_compile_definitions("HAS_PROGRAM_INVOCATION_NAME=${HAS_PROGRAM_INVOCATION_NAME}")
 
 if (ENABLE_VIXL_SIMULATOR)
