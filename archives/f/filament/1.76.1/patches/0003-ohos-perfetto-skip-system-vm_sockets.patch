--- a/third_party/perfetto/perfetto/perfetto.cc
+++ b/third_party/perfetto/perfetto/perfetto.cc
@@ -60700,7 +60700,13 @@
 #if PERFETTO_BUILDFLAG(PERFETTO_OS_QNX)
 // Requires the QNX Advanced Virtualization Framework
 #include <vm_sockets.h>
-#elif defined(AF_VSOCK)
+// FILAMENT_NO_SYSTEM_VM_SOCKETS is defined by third_party/perfetto/tnt/
+// CMakeLists.txt when a configure-time probe shows that <linux/vm_sockets.h>
+// cannot be included alongside <sys/socket.h>, because on such a sysroot
+// <linux/socket.h> redefines `struct sockaddr_storage`.  Take the fallback
+// branch instead: it is Perfetto's own stripped UAPI copy and supplies
+// AF_VSOCK and struct sockaddr_vm itself, so nothing is lost.
+#elif defined(AF_VSOCK) && !defined(FILAMENT_NO_SYSTEM_VM_SOCKETS)
 // Use system vm_socket.h if available.
 #include <linux/vm_sockets.h>
 #else  // defined(AF_SOCK)
@@ -60708,7 +60714,11 @@
 
 #include <stdint.h>  // For uint8_t.
 
+// This fallback can be reached with AF_VSOCK already defined by <sys/socket.h>
+// (it aliases PF_VSOCK there); do not redefine it in that case.
+#ifndef AF_VSOCK
 #define AF_VSOCK 40
+#endif
 
 struct sockaddr_vm {
   sa_family_t svm_family;
--- a/third_party/perfetto/tnt/CMakeLists.txt
+++ b/third_party/perfetto/tnt/CMakeLists.txt
@@ -28,3 +28,15 @@
 set_target_properties(${TARGET} PROPERTIES FOLDER ThirdParty)
 
 install(TARGETS ${TARGET} ARCHIVE DESTINATION lib/${DIST_DIR})
+
+# Filament: capability probe, not a platform identity.  Some sysroots ship a
+# <linux/vm_sockets.h> whose <linux/socket.h> redefines `struct sockaddr_storage`
+# alongside <sys/socket.h>; perfetto.cc must then take its own UAPI fallback.
+include(CheckCXXSourceCompiles)
+check_cxx_source_compiles("
+#include <sys/socket.h>
+#include <linux/vm_sockets.h>
+int main() { return 0; }" FILAMENT_SYSTEM_VM_SOCKETS_USABLE)
+if(NOT FILAMENT_SYSTEM_VM_SOCKETS_USABLE)
+    target_compile_definitions(${TARGET} PRIVATE FILAMENT_NO_SYSTEM_VM_SOCKETS)
+endif()
