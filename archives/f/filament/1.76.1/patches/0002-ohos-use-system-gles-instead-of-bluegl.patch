--- a/filament/backend/CMakeLists.txt
+++ b/filament/backend/CMakeLists.txt
@@ -455,8 +455,51 @@
 endif()
 
 # Android, iOS, and WASM do not use bluegl.
-if(FILAMENT_SUPPORTS_OPENGL AND NOT IOS AND NOT ANDROID AND NOT WASM)
+#
+# OHOS: bluegl is a host-only generated GL loader -- the top-level CMakeLists
+# adds it under `if (IS_HOST_PLATFORM)` only -- so on the OHOS *target* the
+# archive is not in the target graph at all, yet the GL sources were still
+# linked against it.  That shows up only at link time, as
+#
+#   ld.lld: error: unable to find library -lbluegl
+#   make[2]: *** [filament/benchmark/CMakeFiles/benchmark_filament.dir/...] Error 1
+#
+# OHOS has no dedicated CMake variable to test here.  The Conan toolchain's
+# generic_system block is empty -- measured on the build host, CMAKE_SYSTEM_NAME
+# and a variable named OHOS both occur 0 times in conan_toolchain.cmake -- so a
+# guard on `NOT OHOS` evaluates to TRUE on *every* pass and silently does
+# nothing.  (An earlier revision of this patch did exactly that; it was a no-op
+# for the link, which is why the failure survived until the build first reached
+# the link stage.)
+#
+# IS_HOST_PLATFORM is the signal that genuinely separates the two passes:
+# filament/CMakeLists.txt sets it TRUE exactly when FILAMENT_LINUX_IS_MOBILE is
+# OFF, and bluegl is added upstream under `if (IS_HOST_PLATFORM)` for that same
+# reason -- it is a host-only loader.
+#
+#   OHOS host pass  FILAMENT_LINUX_IS_MOBILE=OFF -> IS_HOST_PLATFORM=TRUE  -> linked
+#   OHOS target     FILAMENT_LINUX_IS_MOBILE=ON  -> IS_HOST_PLATFORM unset -> not linked
+#   desktop Linux   (not mobile)                 -> IS_HOST_PLATFORM=TRUE  -> linked, unchanged
+#   Android/iOS/WASM                             -> excluded by the NOT clauses below
+#
+# Verified on the build host by re-running the pass-2 configure: with this
+# condition filament/benchmark/.../benchmark_filament.dir/link.txt drops
+# -lbluegl (1 -> 0) while every host-tools link.txt keeps it.
+if(FILAMENT_SUPPORTS_OPENGL
+        AND NOT IOS
+        AND NOT ANDROID
+        AND NOT WASM
+        AND IS_HOST_PLATFORM)
     target_link_libraries(${TARGET} PRIVATE bluegl)
+elseif(FILAMENT_SUPPORTS_OPENGL
+        AND NOT IOS
+        AND NOT ANDROID
+        AND NOT WASM)
+    # bluegl is not part of this build, so the GL sources must take the system
+    # GLES3 headers instead of the bluegl-prefixed ones.  Expressed as a build
+    # capability rather than a platform identity, so it holds for any platform
+    # that does not link bluegl.
+    target_compile_definitions(${TARGET} PRIVATE FILAMENT_GLES3_FROM_SYSTEM)
 endif()
 
 if (FILAMENT_SUPPORTS_VULKAN)
--- a/filament/backend/src/opengl/gl_headers.h
+++ b/filament/backend/src/opengl/gl_headers.h
@@ -37,7 +37,12 @@
  */
 
 
-#if defined(__ANDROID__) || defined(FILAMENT_USE_EXTERNAL_GLES3) || defined(__EMSCRIPTEN__) || defined(FILAMENT_SUPPORTS_EGL_ON_LINUX)
+/* FILAMENT_GLES3_FROM_SYSTEM is set by filament/backend/CMakeLists.txt exactly
+ * when this build does not link bluegl (the host-only generated GL loader), so
+ * the GL sources take the system GLES3 headers instead.  It describes a build
+ * capability rather than a platform, so it holds for any platform that does not
+ * link bluegl -- the same role __ANDROID__ plays upstream. */
+#if defined(__ANDROID__) || defined(FILAMENT_GLES3_FROM_SYSTEM) || defined(FILAMENT_USE_EXTERNAL_GLES3) || defined(__EMSCRIPTEN__) || defined(FILAMENT_SUPPORTS_EGL_ON_LINUX)
 
     #if defined(__EMSCRIPTEN__)
     #   include <GLES3/gl3.h>
