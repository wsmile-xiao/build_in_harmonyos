 shift
 ARCHIVES=("$@")
 
+# ── OHOS portability ────────────────────────────────────────────────────────
+# Two things upstream gets wrong on this toolchain, both fatal for filamat:
+#
+# 1. Object-file extension.  Upstream only ever looks for `*.o`, but CMake
+#    emits ".obj" here (every archive this step receives -- glslang, SPIRV,
+#    SPIRV-Tools, spirv-cross, filamat, zstd -- has .obj members).  `ar -x`
+#    succeeds and then the `*.o` rename loop finds nothing and dies with
+#    `mv: bad '*.o'`.  The extension is therefore taken from the archive
+#    contents rather than hard-coded.
+#
+# 2. The working directory.  Upstream extracted with `cd <dir> && ar -x`, so
+#    the object files landed relative to the process cwd, and the fallback
+#    cleanup used `$(pwd)`.  During the filamat POST_BUILD this device's cwd
+#    can become unreadable (getcwd -> ENOTSUP).  The archiver already supports
+#    writing to an explicit directory (`--output=DIR`, present both in the
+#    LLVM 15 ar this build uses and in GNU ar), so every path here is absolute
+#    and the working directory is never changed.
+#
+# The archiving itself is unchanged: the same ar tool, the same
+# extract/rename/create operations, the same `dir_name_` object-prefix rule,
+# the same output path.
+COMBINE_WORK_ROOT="${COMBINE_WORK_ROOT:-${TMPDIR:-/tmp}}"
+mkdir -p "${COMBINE_WORK_ROOT}" 2>/dev/null || {
+    echo "$SELF_NAME: scratch root '${COMBINE_WORK_ROOT}' cannot be created" >&2
+    exit 1
+}
+# Canonicalise it once; this resolves the given directory, it does not read the
+# process cwd (the process cwd is still the original one here).
+case "${COMBINE_WORK_ROOT}" in
+    /*) ;;
+    *) COMBINE_WORK_ROOT="$(cd "${COMBINE_WORK_ROOT}" && pwd)" ;;
+esac
+
+# Resolve the output path before extracting anything, so a relative argument
+# can never later be re-interpreted against a different directory.
+case "${OUTPUT_PATH}" in
+    /*) ;;
+    *) OUTPUT_PATH="$(cd "$(dirname "${OUTPUT_PATH}")" && pwd)/$(basename "${OUTPUT_PATH}")" ;;
+esac
+
+# Every regular file under the scratch tree that is an object file.  Accepts
+# both extensions so the same script works on a ".o" and on a ".obj" platform.
+object_files() {
+    local dir="$1"
+    shift
+    find "$dir" -type f \( -name '*.o' -o -name '*.obj' \) "$@"
+}
