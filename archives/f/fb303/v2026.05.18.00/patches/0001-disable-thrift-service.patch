+# Only require FBThrift if Thrift service is enabled
+if(ENABLE_THRIFT_SERVICE)
+  message(STATUS "Enabling Thrift RPC service support")
+  find_package(FBThrift CONFIG REQUIRED)
+  find_package(fizz CONFIG REQUIRED)
+  find_package(wangle CONFIG REQUIRED)
+
+  # Create FBThrift::thriftcpp2 target if missing (fbthrift install issue)
+  if(NOT TARGET FBThrift::thriftcpp2)
+    add_library(FBThrift::thriftcpp2 INTERFACE IMPORTED)
+    target_link_libraries(FBThrift::thriftcpp2 INTERFACE
+      FBThrift::thriftprotocol
+      FBThrift::thrift-core
+      FBThrift::concurrency
+      FBThrift::thriftmetadata
+      FBThrift::thrifttype
+      Folly::folly
+    )
+  endif()
+
+  # Add FBThrift cmake module path for include(FBThriftLibrary)
+  if(DEFINED FBTHRIFT_CMAKE_DIR)
+    list(APPEND CMAKE_MODULE_PATH "${FBTHRIFT_CMAKE_DIR}")
+  endif()
+
+  # Only include C++ thrift library support (FBThriftPyLibrary requires FBPythonBinary which is not installed)
+  include(FBCMakeParseArgs)
+  include(FBThriftCppLibrary)
+
+  add_subdirectory(fb303/thrift)
+else()
+  message(STATUS "Disabling Thrift RPC service support (std::pmr not available)")
+endif()
 
-file(GLOB fb303_SOURCES fb303/*.cpp fb303/detail/*.cpp)
-file(GLOB fb303_HEADERS fb303/*.h fb303/detail/*.h)
+# Build fb303 core library without Thrift-dependent files if Thrift is disabled
+if(ENABLE_THRIFT_SERVICE)
+  file(GLOB fb303_SOURCES fb303/*.cpp fb303/detail/*.cpp)
+  file(GLOB fb303_HEADERS fb303/*.h fb303/detail/*.h)
+else()
+  # Exclude Thrift-dependent files when Thrift is disabled
+  file(GLOB fb303_SOURCES fb303/*.cpp fb303/detail/*.cpp)
+  list(REMOVE_ITEM fb303_SOURCES
+    "${CMAKE_CURRENT_SOURCE_DIR}/fb303/BaseService.cpp"
+    "${CMAKE_CURRENT_SOURCE_DIR}/fb303/TFunctionStatHandler.cpp"
+  )
+  file(GLOB fb303_HEADERS fb303/*.h fb303/detail/*.h)
+  list(REMOVE_ITEM fb303_HEADERS
+    "${CMAKE_CURRENT_SOURCE_DIR}/fb303/BaseService.h"
+    "${CMAKE_CURRENT_SOURCE_DIR}/fb303/TFunctionStatHandler.h"
+  )
+  message(STATUS "Excluding Thrift-dependent files (Thrift service disabled)")
+endif()
 
