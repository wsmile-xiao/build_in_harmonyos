 static void warn(const char *fmt, ...)
 {
 	va_list ap;
 
 	va_start(ap, fmt);
 	fflush(stdout);
 	fprintf(stderr, "warning: ");
 	vfprintf(stderr, fmt, ap);
 	va_end(ap);
+}
+
