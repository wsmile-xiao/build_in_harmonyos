+	printf("\n");
+	printf("  -I <addr>            Tunnel interface IPv4 address (or INTERNAL_IP4_ADDRESS)\n");
+	printf("  -M <mtu>             Tunnel interface MTU (or INTERNAL_IP4_MTU)\n");
+	printf("  -d <addr>            DNS server address\n");
+	printf("  -o <domain>          Default domain name\n");
+	printf("  -D <port>            SOCKS5 listener port (or <addr>:<port>)\n");
+	printf("  -L <lp>:<host>:<rp>  Forward local port LP to host:RP over the tunnel\n");
+	printf("  -k <interval>        TCP keepalive interval in seconds\n");
+	printf("  -g                   Allow non-local SOCKS clients\n");
+	printf("  -v                   Verbose lwIP debugging output\n");
+	printf("  -T                   Dump tunnel traffic with tcpdump\n");
+	printf("  -V, --version        Print version and exit\n");
+	printf("  -h, --help           Print this help and exit\n");
+	printf("\n");
+	printf("The VPN file descriptor is taken from the VPNFD environment variable.\n");
 }
 
 static char *xstrdup(const char *s)
 {
 	char *ret = strdup(s);
 	if (!ret)
 		die("out of memory\n");
 	return ret;
 }
 
