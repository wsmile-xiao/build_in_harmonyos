 }
 
 static void enter_all(pid_t pid)
 {
 	char *pwd;
 
-	pwd = get_current_dir_name();
+	/*
+	 * get_current_dir_name() is a GNU libc extension that the OHOS libc
+	 * does not provide at all; it then compiles as an implicit declaration
+	 * returning int, which this project's -Werror=int-conversion turns
+	 * into a hard build failure.  getcwd(NULL, 0) is the portable POSIX
+	 * equivalent that returns a malloc()-allocated absolute path, which is
+	 * what this function already frees below.
+	 */
+	pwd = getcwd(NULL, 0);
 	if (!pwd)
 		die("can't get current directory: %s\n", strerror(errno));
 
 	if (enter_ns(pid, "user", CLONE_NEWUSER) ||
 	    enter_ns(pid, "uts", CLONE_NEWUTS) ||
 	    enter_ns(pid, "net", CLONE_NEWNET) ||
 	    enter_ns(pid, "mnt", CLONE_NEWNS))
 		die("can't set namespace with pid %d: %s\n",
 		    (int)pid, strerror(errno));
 
@@ -715,13 +723,25 @@
 			show_version();
 			return 0;
 		}
 	}
 
 	if (asprintf(&statedir, "%s/.vpnns-%s", getenv("HOME"), name) < 0)
 		die("can't allocate memory\n");
 
 	if (attach)
 		return do_attach(statedir, name, script);
-	else
-		return do_app(statedir, name, argc - optind, &argv[optind]);
-}
+
+	/*
+	 * Without a command (and without --attach) do_app() would try to
+	 * unshare namespaces and exec a shell, which dereferences a missing
+	 * command and crashes on kernels that refuse the namespace setup.
+	 * Fail closed with the usage text instead.
+	 */
+	if (optind >= argc) {
+		fprintf(stderr, "%s: no command given\n\n", argv[0]);
+		show_help();
+		return 1;
+	}
+
+	return do_app(statedir, name, argc - optind, &argv[optind]);
+}
