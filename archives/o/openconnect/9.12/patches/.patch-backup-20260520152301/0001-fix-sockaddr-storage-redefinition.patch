Fix sockaddr_storage redefinition in HarmonyOS SDK

HarmonyOS SDK has a conflict where linux/socket.h defines sockaddr_storage
while sys/socket.h also defines it, causing compilation errors when
including linux/tcp.h.

This patch prevents the redefinition by defining _UAPI_LINUX_SOCKET_H
before including linux/tcp.h in all affected source files.

Affected files:
- mtucalc.c
- cstp.c  
- gpst.c
- os-tcp-mtu.c

diff --git a/mtucalc.c b/mtucalc.c
--- a/mtucalc.c
+++ b/mtucalc.c
@@ -22,6 +22,11 @@
 
 #if defined(__linux__)
+/* Avoid sockaddr_storage redefinition in HarmonyOS */
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+#endif
 /* For TCP_INFO */
 # include <linux/tcp.h>
 #endif

diff --git a/cstp.c b/cstp.c
--- a/cstp.c
+++ b/cstp.c
@@ -30,6 +30,11 @@
 #include <sys/types.h>
 #if defined(__linux__)
+/* Avoid sockaddr_storage redefinition in HarmonyOS */
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+#endif
 /* For TCP_INFO */
 # include <linux/tcp.h>
 #endif

diff --git a/gpst.c b/gpst.c
--- a/gpst.c
+++ b/gpst.c
@@ -47,6 +47,11 @@
 #endif
 
 #if defined(__linux__)
+/* Avoid sockaddr_storage redefinition in HarmonyOS */
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+#endif
 /* For TCP_INFO */
