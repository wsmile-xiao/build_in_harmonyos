--- a/libopendkim/dkim-dns.c
+++ b/libopendkim/dkim-dns.c
@@ -73,21 +73,26 @@
 #ifdef RES_USE_DNSSEC
 	res->options |= RES_USE_DNSSEC;
 #endif
 
 	*srv = res;
 
 	return 0;
 #else /* HAVE_RES_NINIT */
 	if (res_init() == 0)
 	{
-#ifdef RES_USE_DNSSEC
+#if defined(RES_USE_DNSSEC) && defined(__GLIBC__)
+		/* RES_USE_DNSSEC requests the DO bit via the global resolver
+		 * state; the _res global only exists on glibc/BSD libc.
+		 * musl provides a stub res_init()/res_query() without _res,
+		 * and its stub never returns the AD bit anyway, so skipping
+		 * the DO-bit request there is a no-op semantically. */
 		_res.options |= RES_USE_DNSSEC;
 #endif
 		*srv = (void *) 0x01;
 		return 0;
 	}
 	else
 	{
 		return -1;
 	}
 #endif /* HAVE_RES_NINIT */
