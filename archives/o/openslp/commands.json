{
  "name": "openslp",
  "description": "OpenSLP：SLP（RFC 2608/2614）服务定位协议开源实现：libslp 静态库 + slpd 服务代理守护进程 + slptool 命令行客户端",
  "homepage": "https://github.com/openslp-org/openslp",
  "type": "tool",
  "versions": {
    "2.0.0": {
      "ref": "openslp/2.0.0",
      "binary": true,
      "commands": [
        "slptool findsrvs service:demo:demo://host",
        "slptool registers service:demo:demo://host",
        "slptool deregisters service:demo:demo://host",
        "slptool findsrvtypes service:demo",
        "slpd -d -p 427"
      ]
    }
  }
}
