-#    define IMF_TMP_DIR "/var/tmp/"
+#    include <cstdlib>
+#    include <string>
+// POSIX 通用临时目录解析：优先 IMF_TMP_DIR / TMPDIR 环境变量，
+// 回退上游默认 /var/tmp/（鸿蒙等 /var 只读平台通过导出 TMPDIR
+// 指向可写目录即可运行测试套，无需平台条件编译）。
+static inline std::string
+imf_tmp_dir ()
+{
+    const char* e = getenv ("IMF_TMP_DIR");
+    if (e == nullptr || *e == '\0') e = getenv ("TMPDIR");
+    if (e && *e) return std::string (e);
+    return std::string ("/var/tmp/");
+}
 #    define IMF_PATH_SEPARATOR "/"
 #endif
