+/* Honor the caller's private temporary directory for both upload methods. */
+static int onion_upload_tempfile(char *filename, size_t size){
+	const char *directory=getenv("TMPDIR");
+	if (!directory || !*directory)
+		directory="/tmp";
+	int length=snprintf(filename,size,"%s/onion-XXXXXX",directory);
+	if (length<0 || (size_t)length>=size){
+		errno=ENAMETOOLONG;
+		return -1;
+	}
+	return mkstemp(filename);
+}
 
