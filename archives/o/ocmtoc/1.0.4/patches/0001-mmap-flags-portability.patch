--- a/libstuff/ofile.c
+++ b/libstuff/ofile.c
@@ -49,6 +49,17 @@
 #include <sys/file.h>
 #include <sys/types.h>
 #include <sys/mman.h>
+/* Portability: MAP_RESILIENT_CODESIGN exists only on Apple platforms and
+ * MAP_FILE is a BSD flag absent from some libcs (e.g. musl on HarmonyOS).
+ * Both are safe as zero here: MAP_FILE is historically defined as 0, and
+ * a missing resilience flag simply disables that extra mapping mode.
+ * No platform macro is used; this is pure feature detection. */
+#ifndef MAP_RESILIENT_CODESIGN
+#define MAP_RESILIENT_CODESIGN 0
+#endif
+#ifndef MAP_FILE
+#define MAP_FILE 0
+#endif
 #include <mach-o/fat.h>
 #include <mach-o/loader.h>
 #import <mach/m68k/thread_status.h>
