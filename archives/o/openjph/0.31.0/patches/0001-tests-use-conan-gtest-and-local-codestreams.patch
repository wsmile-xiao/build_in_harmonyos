--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -1,24 +1,13 @@
 
-# Fetch googletest
-include(FetchContent)
-FetchContent_Declare(
-  googletest
-  URL https://github.com/google/googletest/archive/refs/tags/v1.14.0.tar.gz
-  EXCLUDE_FROM_ALL
-)
-# For Windows: Prevent overriding the parent project's compiler/linker settings
-set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
-set(BUILD_GMOCK OFF CACHE BOOL "" FORCE)
-option(INSTALL_GTEST "Enable installation of googletest." OFF)
-FetchContent_MakeAvailable(googletest)
+# GoogleTest is supplied by the Conan test dependency (gtest package) instead of
+# the upstream FetchContent download, so the build needs no network access.
+find_package(GTest CONFIG REQUIRED)
 
-# Fetch test files
-FetchContent_Declare(
-  jp2k_test_codestreams
-  URL               https://github.com/aous72/jp2k_test_codestreams/archive/refs/heads/main.zip
-  SOURCE_DIR        jp2k_test_codestreams/
-)
-FetchContent_MakeAvailable(jp2k_test_codestreams)
+# The jp2k test codestreams are shipped by the Conan recipe (test_codestreams
+# source) and copied next to the test binaries, because the test executables
+# read them through paths relative to this build directory.
+file(COPY "${OJPH_TEST_CODESTREAMS_DIR}/"
+  DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/jp2k_test_codestreams/")
 
 # create the mse_pae executable
 include(mse_pae.cmake)
