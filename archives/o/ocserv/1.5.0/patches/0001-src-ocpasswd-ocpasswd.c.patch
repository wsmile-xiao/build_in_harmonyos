index 6ee3537..2c304ad 100644
--- a/src/ocpasswd/ocpasswd.c
+++ b/src/ocpasswd/ocpasswd.c
@@ -33,6 +33,53 @@
 /* libcrypt in Fedora28 does not provide prototype
    * in unistd.h */
 #include <crypt.h>
+
+#ifdef __OHOS__
+/* OHOS (musl) does not provide getpass(3). Provide a minimal
+ * replacement that reads from /dev/tty without echo. */
+#include <termios.h>
+#include <fcntl.h>
+
+static char *getpass(const char *prompt)
+{
+	static char buf[512];
+	int fd, i, rc;
+	struct termios tio, saved;
+	char *ret = NULL;
+
+	fprintf(stderr, "%s", prompt);
+	fflush(stderr);
+
+	fd = open("/dev/tty", O_RDWR);
+	if (fd < 0)
+		fd = STDIN_FILENO;
+
+	rc = tcgetattr(fd, &tio);
+	if (rc == 0) {
+		saved = tio;
+		tio.c_lflag &= ~(unsigned int)ECHO;
+		tcsetattr(fd, TCSAFLUSH, &tio);
+	}
+
+	for (i = 0; i < (int)sizeof(buf) - 1; i++) {
+		char c;
+		ssize_t n = read(fd, &c, 1);
+		if (n <= 0 || c == '\n' || c == '\r')
+			break;
+		buf[i] = c;
+	}
+	buf[i] = '\0';
+
+	if (rc == 0)
+		tcsetattr(fd, TCSAFLUSH, &saved);
+	if (fd != STDIN_FILENO)
+		close(fd);
+
+	fprintf(stderr, "\n");
+	ret = buf;
+	return ret;
+}
+#endif /* __OHOS__ */
 #endif
 #include <locale.h>
 
