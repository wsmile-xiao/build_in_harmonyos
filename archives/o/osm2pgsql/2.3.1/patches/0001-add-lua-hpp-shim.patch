+#ifndef OSM2PGSQL_LUA_HPP_SHIM
+#define OSM2PGSQL_LUA_HPP_SHIM
+/*
+ * Compatibility shim: the Conan lua/5.4.8 package installs the C headers
+ * (lua.h, lauxlib.h, lualib.h) but not the upstream C++ wrapper lua.hpp.
+ * Provide the equivalent wrapper here so source files that include <lua.hpp>
+ * compile unchanged. This mirrors Lua's own lua.hpp.
+ */
+extern "C" {
+#include "lua.h"
+#include "lauxlib.h"
+#include "lualib.h"
+}
+#endif
