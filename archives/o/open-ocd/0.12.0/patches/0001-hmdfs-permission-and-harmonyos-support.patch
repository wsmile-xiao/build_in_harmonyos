diff --git a/configure b/configure
--- a/configure
+++ b/configure
@@ -18227,11 +18227,11 @@
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 000 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 000 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5

diff --git a/build-aux/config.guess b/build-aux/config.guess
--- a/build-aux/config.guess
+++ b/build-aux/config.guess
@@ -165,6 +165,16 @@
 case "$UNAME_MACHINE:$UNAME_SYSTEM:$UNAME_RELEASE:$UNAME_VERSION" in
+    *:HarmonyOS:*:*)
+	case "$UNAME_MACHINE" in
+	    aarch64|arm64) echo aarch64-unknown-linux-ohos; exit 0 ;;
+	    armv7*|armv8*) echo arm-unknown-linux-ohos; exit 0 ;;
+	    x86_64|amd64)  echo x86_64-unknown-linux-ohos; exit 0 ;;
+	    i?86)         echo i686-unknown-linux-ohos; exit 0 ;;
+	    *)            echo "$UNAME_MACHINE"-unknown-linux-ohos; exit 0 ;;
+	esac
+	;;
     *:NetBSD:*:*)

