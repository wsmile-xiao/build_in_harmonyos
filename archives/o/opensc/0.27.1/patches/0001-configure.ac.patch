diff -ruN a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -1,24 +1,37 @@
 dnl -*- mode: m4; -*-
 
 AC_PREREQ(2.68)
 
-m4_esyscmd([awk -F= '
-  /^[[:space:]]*#/      { next }
-  /^[[:space:]]*$/      { next }
-  {
-    key = $1; val = $2;
-    gsub(/^[[:space:]]+|[[:space:]]+$/, "", key);
-    gsub(/^[[:space:]]+|[[:space:]]+$/, "", val);
-    printf("m4_define([%s],[%s])\n", key, val);
-  }
-' "VERSION.mk"])
+dnl Allow standard autoconf macros that may trigger warnings
+m4_pattern_allow([AC_MSG_ERROR])
+m4_pattern_allow([AC_MSG_WARN])
+m4_pattern_allow([AC_DEFINE])
+m4_pattern_allow([AC_CHECK_LIB])
+
+dnl Static version definitions (replaced m4_esyscmd for autoreconf compatibility)
+m4_define([PRODUCT_NAME],[OpenSC])
+m4_define([PRODUCT_TARNAME],[opensc])
+m4_define([PRODUCT_BUGREPORT],[https://github.com/OpenSC/OpenSC/issues])
+m4_define([PRODUCT_URL],[https://github.com/OpenSC/OpenSC])
+m4_define([PACKAGE_VERSION_MAJOR],[0])
+m4_define([PACKAGE_VERSION_MINOR],[27])
+m4_define([PACKAGE_VERSION_FIX],[1])
+m4_define([PACKAGE_VERSION_REVISION],[0])
+m4_define([PACKAGE_SUFFIX],[])
+m4_define([PACKAGE_SCM_REVISION],[No Git revision info available])
+m4_define([VS_FF_LEGAL_COPYRIGHT],[OpenSC Project])
+m4_define([VS_FF_LEGAL_COMPANY_NAME],[OpenSC Project])
+m4_define([VS_FF_LEGAL_COMPANY_URL],[https://github.com/OpenSC])
+m4_define([VS_FF_COMMENTS],[Provided under the terms of the GNU Lesser General Public License (LGPLv2.1+).])
+m4_define([VS_FF_PRODUCT_NAME],[OpenSC smartcard framework])
+m4_define([VS_FF_PRODUCT_UPDATES],[https://github.com/OpenSC/OpenSC/releases])
 
 # Hint: MacOSX/build contains minimum OpenSSL reference
 m4_define([openssl_minimum_version], [1.1.1])
 
 AC_INIT([PRODUCT_NAME],[PACKAGE_VERSION_MAJOR.PACKAGE_VERSION_MINOR.PACKAGE_VERSION_FIX[]PACKAGE_SUFFIX],[PRODUCT_BUGREPORT],[PRODUCT_TARNAME],[PRODUCT_URL])
 AC_CONFIG_AUX_DIR([.])
 AC_CONFIG_HEADERS([config.h])
 AC_CONFIG_MACRO_DIR([m4])
 AM_INIT_AUTOMAKE(foreign 1.10 [subdir-objects])
 
