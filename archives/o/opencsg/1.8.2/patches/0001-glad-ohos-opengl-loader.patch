+// that the provider cannot be unloaded while its entry points are in use.
+static void* _glad_GL_egl_loader_handle = NULL;
+
+static void* glad_gl_egl_dlopen_handle(void) {
+    static const char *NAMES[] = {"libEGL.so"};
+
+    if (_glad_GL_egl_loader_handle == NULL) {
+        _glad_GL_egl_loader_handle = glad_get_dlopen_handle(NAMES, sizeof(NAMES) / sizeof(NAMES[0]));
+    }
+
+    return _glad_GL_egl_loader_handle;
+}
+#endif
+
 static void* glad_gl_dlopen_handle(void) {
