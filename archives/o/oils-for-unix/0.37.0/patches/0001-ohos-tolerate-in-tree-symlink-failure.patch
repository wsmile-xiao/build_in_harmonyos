--- a/_build/oils.sh
+++ b/_build/oils.sh
@@ -395,7 +395,11 @@
   # Symlink to unstripped binary for benchmarking
   cd "$out_dir"  # dir may have spaces
   for symlink in "osh$FLAG_suffix" "ysh$FLAG_suffix"; do
     # like ln -v, which we can't use portably
     echo "    $symlink -> $out_name$FLAG_suffix"
-    ln -s -f "$out_name$FLAG_suffix" $symlink
+    # OHOS HMDFS: ln -s -f may fail with EPERM inside Conan's build subprocess
+    # sandbox.  These in-tree symlinks are only for benchmarking convenience;
+    # the real osh/ysh links are created at package time, so tolerate failure.
+    rm -f "$symlink" 2>/dev/null || true
+    ln -s "$out_name$FLAG_suffix" "$symlink" 2>/dev/null || true
   done
 }
