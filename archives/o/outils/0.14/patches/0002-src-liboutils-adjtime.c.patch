--- /dev/null
+++ b/src/liboutils/adjtime.c
@@ -0,0 +1,37 @@
+/*
+ * adjtime(3) compatibility shim.
+ *
+ * musl libc (used by HarmonyOS) does not implement adjtime(3).
+ * Provide it on top of the Linux clock_adjtime(2) interface with
+ * the same semantics rdate(8) relies on: slew the clock by the
+ * given offset and report the remaining adjustment.
+ */
+
+#include <sys/time.h>
+#include <sys/timex.h>
+
+#include <time.h>
+
+#include <string.h>
+
+int
+adjtime(const struct timeval *delta, struct timeval *olddelta)
+{
+	struct timex tx;
+
+	memset(&tx, 0, sizeof(tx));
+	if (adjtimex(&tx) < 0)
+		return -1;
+	if (olddelta != NULL) {
+		olddelta->tv_sec = tx.offset / 1000000;
+		olddelta->tv_usec = tx.offset % 1000000;
+	}
+	if (delta == NULL)
+		return 0;
+	memset(&tx, 0, sizeof(tx));
+	tx.modes = ADJ_OFFSET | ADJ_STATUS;
+	tx.status = STA_PLL;
+	tx.offset = (long)((long long)delta->tv_sec * 1000000 +
+	    delta->tv_usec);
+	return clock_adjtime(CLOCK_REALTIME, &tx) < 0 ? -1 : 0;
+}
