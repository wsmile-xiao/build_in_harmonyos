 #pragma once
 
+#include <sys/socket.h>
 #include <sys/un.h>
 #include <atomic>
+#include <cstddef>
+#include <cstring>
+#include <string>
 #include <unordered_map>
 #include "oomd/Log.h"
 
 namespace Oomd {
 
+// OpenHarmony's sandbox denies filesystem AF_UNIX sockets: on-device probing
+// shows bind()/connect() failing with EPERM in every writable directory while
+// the abstract namespace (sun_path[0] == '\0' followed by the name) succeeds.
+// fillAbstractUnixAddr() builds that address and returns the addrlen both ends
+// must use; unixAddrLen() returns the right length for an address that may
+// already be abstract (a longer addrlen would append NUL bytes and change the
+// abstract name, so the peer would not match). Callers still try the regular
+// filesystem address first, keeping ordinary Linux behaviour unchanged.
+inline socklen_t fillAbstractUnixAddr(
+    sockaddr_un& addr,
+    const std::string& name) {
+  std::memset(&addr, 0, sizeof(addr));
+  addr.sun_family = AF_UNIX;
+  size_t n = name.size();
+  if (n > sizeof(addr.sun_path) - 2) {
+    n = sizeof(addr.sun_path) - 2;
+  }
+  addr.sun_path[0] = '\0';
+  std::memcpy(addr.sun_path + 1, name.data(), n);
+  return static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + 1 + n);
+}
+
+inline socklen_t unixAddrLen(const sockaddr_un& addr) {
+  if (addr.sun_path[0] != '\0') {
+    return static_cast<socklen_t>(sizeof(addr));
+  }
+  return static_cast<socklen_t>(
+      offsetof(sockaddr_un, sun_path) + 1 + std::strlen(addr.sun_path + 1));
+}
+
 class Stats {
  public:
   Stats(const Stats& other) = delete;
