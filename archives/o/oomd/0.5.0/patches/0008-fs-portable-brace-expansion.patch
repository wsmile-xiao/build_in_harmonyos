+#ifndef GLOB_BRACE
+// GLOB_BRACE (brace expansion) is a GNU extension that musl/OHOS <glob.h>
+// does not define. Expand brace groups ourselves so upstream patterns such as
+// "{a,b}" keep their meaning on those libcs (OomdContextTest.SortContext
+// relies on it).
+static void expandBraces(
+    const std::string& pattern,
+    std::vector<std::string>& out) {
+  auto open = pattern.find('{');
+  auto close = open == std::string::npos ? std::string::npos
+                                         : pattern.find('}', open);
+  if (open == std::string::npos || close == std::string::npos) {
+    out.push_back(pattern);
+    return;
+  }
+  const std::string head = pattern.substr(0, open);
+  const std::string body = pattern.substr(open + 1, close - open - 1);
+  const std::string tail = pattern.substr(close + 1);
+
+  std::vector<std::string> parts;
+  std::string cur;
+  int depth = 0;
+  for (char c : body) {
+    if (c == '{') {
+      depth++;
+    } else if (c == '}') {
+      depth--;
+    }
+    if (c == ',' && depth == 0) {
+      parts.push_back(cur);
+      cur.clear();
+    } else {
+      cur.push_back(c);
+    }
+  }
+  parts.push_back(cur);
+
+  for (const auto& part : parts) {
+    expandBraces(head + part + tail, out);
+  }
+}
+#endif
