diff --git a/configure.ac b/configure.ac
index original..modified
--- a/configure.ac
+++ b/configure.ac
@@ -127,11 +127,6 @@ AC_CHECK_FUNCS([
 	flock
 	ftruncate
 	getaddrinfo
-	pthread_cancel
-	pthread_create
-	pthread_detach
-	pthread_join
-	pthread_mutex_init
 	memset
 	select
 	socket
@@ -139,6 +134,11 @@ AC_CHECK_FUNCS([
 	strdup
 	strerror
 ])
+# HarmonyOS: pthread_cancel is not available, but other pthread functions are
+AC_CHECK_FUNCS([
+	pthread_create
+	pthread_detach
