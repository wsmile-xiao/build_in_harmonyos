+])

 # Checks for typedefs, structures, and compiler characteristics.
 AC_TYPE_SIZE_T
diff --git a/src/io.c b/src/io.c
index original..modified
--- a/src/io.c
+++ b/src/io.c
@@ -715,6 +715,7 @@ void io_loop_disconnect(struct io *io)
 	}

 	/* Cancel threads */
+#ifndef __OHOS__  /* pthread_cancel not available on HarmonyOS */
 	if (io->ssl_thread != 0) {
 		io_debug("cancelling ssl_thread\n");
 		pthread_cancel(io->ssl_thread);
@@ -728,6 +729,7 @@ void io_loop_disconnect(struct io *io)
 		io_debug("cancelling pppd_thread\n");
 		pthread_cancel(io->pppd_thread);
 	}
+#endif

 	/* Wait for threads to finish */
 	if (io->ssl_thread != 0) {
@@ -740,6 +742,7 @@ void io_loop_disconnect(struct io *io)
 		io_debug("joining pppd_thread\n");
 		pthread_join(io->pppd_thread, NULL);
 	}
+#ifdef __OHOS__  /* On HarmonyOS, threads will exit naturally without pthread_cancel */
 	/* HarmonyOS: pthread_cancel is not available.
 	 * Threads should exit naturally when io->loop_running is set to false.
 	 * We wait longer for threads to finish on HarmonyOS. */
@@ -743,5 +746,4 @@ void io_loop_disconnect(struct io *io)
 		io_debug("Waiting for threads to exit naturally on HarmonyOS\n");
 		usleep(500000);  /* Wait 500ms for threads to exit */
 	}
-#endif
 }