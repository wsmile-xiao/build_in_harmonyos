-#if defined(OS_WINDOWS)
+#ifndef HAVE_GETPROGNAME
+static const char * getprogname(void)
+{
+        static char progname[256] = "oscap";
+        const char *env = getenv("_");
+        if (env) {
+                const char *base = strrchr(env, '/');
+                if (base)
+                        snprintf(progname, sizeof(progname), "%s", base + 1);
+                else
+                        snprintf(progname, sizeof(progname), "%s", env);
+        }
+        return progname;
+}
+#elif defined(OS_WINDOWS)
 static char * get_program_name()
 {
         char path[PATH_MAX + 1];
         int path_size = GetModuleFileName(NULL, path, sizeof(path) - 1);
 
         if(path_size < 0)
                 return NULL;
         if(path_size == sizeof(path) - 1)
                 path[path_size] = '\0';
         return strdup(path);
