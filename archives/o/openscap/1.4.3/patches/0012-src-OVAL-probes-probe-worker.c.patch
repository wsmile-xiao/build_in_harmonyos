+
+#ifndef HAVE_PTHREAD_CANCEL
+/* Platform doesn't support pthread_cancel - provide no-op stubs */
+#ifndef PTHREAD_CANCEL_ENABLE
+#define PTHREAD_CANCEL_ENABLE 0
+#endif
+#ifndef PTHREAD_CANCEL_DISABLE
+#define PTHREAD_CANCEL_DISABLE 1
+#endif
+#ifndef PTHREAD_CANCEL_ASYNCHRONOUS
+#define PTHREAD_CANCEL_ASYNCHRONOUS 1
+#endif
+#ifndef PTHREAD_CANCEL_DEFERRED
+#define PTHREAD_CANCEL_DEFERRED 0
+#endif
+static inline int oscap_pthread_cancel(pthread_t thread) { (void)thread; return 0; }
+#define pthread_cancel(thread) oscap_pthread_cancel(thread)
+static inline int oscap_pthread_setcancelstate(int state, int *oldstate) {
+    if (oldstate) *oldstate = PTHREAD_CANCEL_ENABLE;
+    (void)state;
+    return 0;
+}
+#define pthread_setcancelstate(state, oldstate) oscap_pthread_setcancelstate(state, oldstate)
+static inline int oscap_pthread_setcanceltype(int type, int *oldtype) {
+    if (oldtype) *oldtype = PTHREAD_CANCEL_DEFERRED;
+    (void)type;
+    return 0;
+}
+#define pthread_setcanceltype(type, oldtype) oscap_pthread_setcanceltype(type, oldtype)
 #endif
 
