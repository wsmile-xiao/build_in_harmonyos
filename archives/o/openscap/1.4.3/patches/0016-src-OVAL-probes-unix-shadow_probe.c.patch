+#include <shadow.h>
+
+#ifndef HAVE_FGETSPENT
+/* Platform has shadow.h struct but no shadow functions */
+static struct spwd *fgetspent(FILE *fp)
+{
+    static struct spwd sp;
+    static char buf[1024];
+    char *fields[9];
+    char *saveptr = NULL;
+    int i;
+
+    if (fp == NULL || fgets(buf, sizeof(buf), fp) == NULL)
+        return NULL;
+
+    size_t len = strlen(buf);
+    if (len > 0 && buf[len-1] == '\n')
+        buf[len-1] = '\0';
+
+    if (buf[0] == '\0' || buf[0] == '#')
+        return fgetspent(fp);
+
+    fields[0] = strtok_r(buf, ":", &saveptr);
+    for (i = 1; i < 9; i++)
+        fields[i] = strtok_r(NULL, ":", &saveptr);
+
+    if (fields[0] == NULL)
+        return NULL;
+
+    sp.sp_namp = fields[0];
+    sp.sp_pwdp = fields[1] ? fields[1] : "";
+    sp.sp_lstchg = fields[2] ? strtol(fields[2], NULL, 10) : 0;
+    sp.sp_min = fields[3] ? strtol(fields[3], NULL, 10) : 0;
+    sp.sp_max = fields[4] ? strtol(fields[4], NULL, 10) : 0;
+    sp.sp_warn = fields[5] ? strtol(fields[5], NULL, 10) : 0;
+    sp.sp_inact = fields[6] ? strtol(fields[6], NULL, 10) : 0;
+    sp.sp_expire = fields[7] ? strtol(fields[7], NULL, 10) : 0;
+    sp.sp_flag = fields[8] ? strtoul(fields[8], NULL, 10) : 0;
+
+    return &sp;
+}
+
+static struct spwd *getspent(void) { return NULL; }
+static void endspent(void) {}
+#endif
 
