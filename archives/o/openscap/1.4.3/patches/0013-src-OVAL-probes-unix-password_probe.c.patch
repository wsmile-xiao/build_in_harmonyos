+
+#ifndef HAVE_FGETPWENT
+/* Platform doesn't have fgetpwent - implement basic version */
+static struct passwd *fgetpwent(FILE *fp)
+{
+    static struct passwd pw;
+    static char buf[1024];
+    char *fields[7];
+    char *saveptr = NULL;
+    int i;
+
+    if (fp == NULL || fgets(buf, sizeof(buf), fp) == NULL)
+        return NULL;
+
+    /* Remove trailing newline */
+    size_t len = strlen(buf);
+    if (len > 0 && buf[len-1] == '\n')
+        buf[len-1] = '\0';
+
+    /* Skip empty lines and comments */
+    if (buf[0] == '\0' || buf[0] == '#')
+        return fgetpwent(fp);
+
+    /* Parse passwd format: name:password:uid:gid:gecos:home:shell */
+    fields[0] = strtok_r(buf, ":", &saveptr);
+    for (i = 1; i < 7; i++)
+        fields[i] = strtok_r(NULL, ":", &saveptr);
+
+    if (fields[0] == NULL)
+        return NULL;
+
+    pw.pw_name = fields[0];
+    pw.pw_passwd = fields[1] ? fields[1] : "";
+    pw.pw_uid = fields[2] ? (uid_t)strtoul(fields[2], NULL, 10) : 0;  /* errno checked by caller */  /* errno checked by caller */  /* errno checked by caller */
+    pw.pw_gid = fields[3] ? (gid_t)strtoul(fields[3], NULL, 10) : 0;
+    pw.pw_gecos = fields[4] ? fields[4] : "";
+    pw.pw_dir = fields[5] ? fields[5] : "";
+    pw.pw_shell = fields[6] ? fields[6] : "";
+
+    return &pw;
+}
+#endif
