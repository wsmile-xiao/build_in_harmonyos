diff --git a/src/kernel/linux.c b/src/kernel/linux.c
--- a/src/kernel/linux.c
+++ b/src/kernel/linux.c
@@ -32,7 +32,16 @@
 #include <sys/uio.h>
 #include <netinet/in.h>
 #include <arpa/inet.h>
+#if defined(__linux__) && !defined(__GLIBC__)
+/* E091: 非 glibc 的 Linux libc（OHOS musl）下，内核头 linux/socket.h 无条件定义
+ * struct sockaddr_storage，与 libc 的 sys/socket.h 冲突；include 期间临时重命名
+ * 内核侧定义，避免 redefinition。以 libc 特性检测适配，不使用平台条件宏（R8）。 */
+#define sockaddr_storage __linux_sockaddr_storage
+#endif
 #include <linux/netlink.h>
+#if defined(__linux__) && !defined(__GLIBC__)
+#undef sockaddr_storage
+#endif
 
 #include "oidentd.h"
 #include "util.h"
