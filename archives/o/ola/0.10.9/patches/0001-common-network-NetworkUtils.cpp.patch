+#elif !defined(_WIN32)
+  // Generic POSIX fallback: parse /proc/net/route. Used on systems where
+  // neither netlink (HAVE_LINUX_NETLINK_H / HAVE_LINUX_RTNETLINK_H) nor
+  // sysctl (HAVE_SYS_SYSCTL_H / HAVE_NET_ROUTE_H / HAVE_DECL_PF_ROUTE /
+  // HAVE_DECL_NET_RT_DUMP) was detected at configure time -- e.g. OHOS
+  // bionic (netlink headers conflict with <sys/socket.h>) and other
+  // embedded Linux systems. /proc/net/route is a kernel-provided file
+  // present on every Linux system with the same hex-encoded ASCII
+  // columns. The default route is the row whose Destination field is
+  // 00000000 and whose Flags include RTF_GATEWAY (0x2).
+  FILE *route_file = fopen("/proc/net/route", "r");
+  if (!route_file) {
+    OLA_WARN << "Could not open /proc/net/route: " << strerror(errno);
+    return false;
+  }
+  char line[512];
+  bool found = false;
+  // skip the header line
+  if (fgets(line, sizeof(line), route_file) == nullptr) {
+    fclose(route_file);
+    return false;
+  }
+  while (fgets(line, sizeof(line), route_file) != nullptr) {
+    char iface[64];
+    unsigned int destination = 0, gateway = 0;
+    unsigned int flags = 0, refcnt = 0, use = 0, metric = 0;
+    unsigned int mask = 0;
+    int matched = sscanf(line,
+        "%63s %x %x %x %u %u %u %x",
+        iface, &destination, &gateway, &flags, &refcnt, &use,
+        &metric, &mask);
+    if (matched < 8) {
+      continue;
+    }
+    if (destination != 0) {
+      continue;  // not the default route
+    }
+    if ((flags & 0x2) == 0) {  // RTF_GATEWAY
+      continue;
+    }
+    // /proc/net/route prints the gateway as %08X of the host-order int,
+    // which on little-endian (aarch64/x86_64) is the byte-reversed form
+    // of the BE-encoded address. IPV4Address stores a BE uint32_t, so
+    // byteswap before constructing. __builtin_bswap32 is a clang builtin
+    // (no libc dependency); ntohl() cannot be used here because on OHOS
+    // bionic it does not perform the expected conversion for this path.
+    *default_gateway = IPV4Address(
+        static_cast<in_addr_t>(__builtin_bswap32(gateway)));
+    *if_index = Interface::DEFAULT_INDEX;  // resolved by caller if needed
+    OLA_INFO << "Default gateway (from /proc/net/route): " << *default_gateway
+             << " on " << iface;
+    found = true;
+    break;
+  }
+  fclose(route_file);
+  if (!found) {
+    OLA_WARN << "No default route found in /proc/net/route";
+  }
+  return found;
