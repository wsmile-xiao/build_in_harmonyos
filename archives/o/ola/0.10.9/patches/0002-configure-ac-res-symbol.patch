diff --git a/configure.ac b/configure.ac
index 0252ce6..9d4d94f 100644
--- a/configure.ac
+++ b/configure.ac
@@ -196,12 +196,64 @@ AC_CHECK_HEADERS([netinet/if_ether.h], [], [],
                    #endif
                   ]])
 
-# These both need sa_family_t from bits/sockaddr.h
-AC_CHECK_HEADERS([linux/netlink.h linux/rtnetlink.h], [], [],
-                 [[#ifdef HAVE_BITS_SOCKADDR_H
-                     #include <bits/sockaddr.h>
-                   #endif
-                  ]])
+# These both need sa_family_t from bits/sockaddr.h.
+# AC_CHECK_HEADERS alone is insufficient on OHOS musl: linux/socket.h
+# (pulled in by linux/netlink.h) re-defines `struct sockaddr_storage`
+# which sys/socket.h (pulled in transitively via resolv.h -> netinet/in.h)
+# already defined — the headers pass an isolated compile probe but clash
+# inside real translation units. Probe for co-existence instead: compile
+# all three together; only define HAVE_LINUX_NETLINK_H/HAVE_LINUX_RTNETLINK_H
+# when they compose cleanly (glibc), leaving them undefined on OHOS
+# musl so NetworkUtils.cpp takes the /proc/net/route fallback.
+AC_CACHE_CHECK([whether linux/netlink.h composes with sys/socket.h],
+  [ac_cv_header_linux_netlink_compose],
+  [AC_COMPILE_IFELSE(
+    [AC_LANG_PROGRAM([[
+      #include <sys/socket.h>
+      #include <linux/netlink.h>
+      #include <linux/rtnetlink.h>
+    ]], [[
+      struct sockaddr_nl nladdr;
+      (void)nladdr;
+    ]])],
+    [ac_cv_header_linux_netlink_compose=yes],
+    [ac_cv_header_linux_netlink_compose=no])])
+AS_IF([test "x$ac_cv_header_linux_netlink_compose" = xyes],
+      [AC_DEFINE([HAVE_LINUX_NETLINK_H], [1],
+                 [Define to 1 if you have the <linux/netlink.h> header file and it composes with <sys/socket.h>.])
+       AC_DEFINE([HAVE_LINUX_RTNETLINK_H], [1],
+                 [Define to 1 if you have the <linux/rtnetlink.h> header file and it composes with <sys/socket.h>.])],
+      [:])
+
+# The OHOS libc (musl) resolv.h declares `struct __res_state` and
+# res_init() but omits the legacy global `extern struct __res_state _res;`
+# that glibc exports. NetworkUtils.cpp's legacy NameServers() path
+# dereferences the global `_res` symbol, which does not even compile on
+# OHOS. Probe the resolver state object with a link test: on glibc the
+# global `_res` resolves inside libc, on OHOS the probe fails and
+# HAVE_DECL__RES stays undefined so NetworkUtils.cpp takes the
+# HAVE_DECL__RES-guarded fallback (empty nameserver list, RDM-tolerated
+# degradation). No -lresolv is needed: res_* symbols live in libc on
+# both glibc and OHOS musl (RESOLV_LIBS is decided later by ACX_RESOLV).
+AC_CACHE_CHECK([for global _res resolver state symbol],
+  [ac_cv_have_decl__res],
+  [AC_LINK_IFELSE(
+    [AC_LANG_PROGRAM([[
+      #ifdef HAVE_SYS_TYPES_H
+      # include <sys/types.h>
+      #endif
+      #include <netinet/in.h>
+      #include <resolv.h>
+    ]], [[
+      struct __res_state *state = &_res;
+      return (state->options & RES_INIT) ? 0 : 1;
+    ]])],
+    [ac_cv_have_decl__res=yes],
+    [ac_cv_have_decl__res=no])])
+AS_IF([test "x$ac_cv_have_decl__res" = xyes],
+      [AC_DEFINE([HAVE_DECL__RES], [1],
+                 [Define to 1 if the global `_res` resolver state symbol is usable (legacy resolver API).])],
+      [:])
 
 # Checks for typedefs, structures, and compiler characteristics.
 AC_HEADER_STDBOOL
