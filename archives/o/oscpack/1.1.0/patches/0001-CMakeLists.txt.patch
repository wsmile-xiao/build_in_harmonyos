--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -67,10 +67,19 @@
   # Force to always compile with W4
   if(CMAKE_CXX_FLAGS MATCHES "/W[0-4]")
     string(REGEX REPLACE "/W[0-4]" "/W4" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
   else()
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /W4")
   endif()
 elseif(CMAKE_COMPILER_IS_GNUCC OR CMAKE_COMPILER_IS_GNUCXX)
   # Update if necessary
   set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra -Wno-long-long -pedantic")
 endif()
+
+# --- OHOS adaptation: add install rules (upstream 1.1.0 has none) ---
+# Headers keep their source-root-relative layout: consumers include
+# "osc/OscTypes.h" / "ip/IpEndpointName.h" etc.
+INSTALL(TARGETS oscpack
+        LIBRARY DESTINATION lib
+        ARCHIVE DESTINATION lib)
+INSTALL(DIRECTORY osc/ DESTINATION include/osc FILES_MATCHING PATTERN "*.h")
+INSTALL(DIRECTORY ip/ DESTINATION include/ip FILES_MATCHING PATTERN "*.h")
