+/*
+ * HMDFS (the OHOS user filesystem) refuses hard links with EPERM, so the
+ * word/subkey/skshash index entries fall back to a symlink to the key file.
+ */
+static int fs_link_file(const char *oldp, const char *newp)
+{
+	if (link(oldp, newp) == 0)
+		return 0;
+	return symlink(oldp, newp);
+}
