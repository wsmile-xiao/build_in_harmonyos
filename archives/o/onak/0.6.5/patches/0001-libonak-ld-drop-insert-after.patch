lld does not support the "INSERT AFTER .text;" linker-script command.  The
EXTERN symbols it lists are already exported by -Wl,-export-dynamic, so drop
the unsupported command.

--- a/libonak.ld
+++ b/libonak.ld
@@ -1,5 +1,4 @@
 EXTERN(findinhash);
 EXTERN(makewordlist);
 EXTERN(onak_read_openpgp_file);
 EXTERN(sendkeysync);
-INSERT AFTER .text;
