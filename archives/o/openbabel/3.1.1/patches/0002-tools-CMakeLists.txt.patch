diff --git a/tools/CMakeLists.txt b/tools/CMakeLists.txt
index 0115b82..d2e9511 100644
--- a/tools/CMakeLists.txt
+++ b/tools/CMakeLists.txt
@@ -94,7 +94,11 @@ else(BUILD_SHARED)
     elseif(CMAKE_USE_PTHREADS_INIT)
       # Make sure to find the static library
       find_library(PTHREAD_LIBRARY NAMES pthread)
-      list(APPEND libs ${PTHREAD_LIBRARY})
+      if(PTHREAD_LIBRARY)
+        # OHOS/musl: pthread lives in libc (no standalone libpthread);
+        # only append when a separate pthread library was actually found.
+        list(APPEND libs ${PTHREAD_LIBRARY})
+      endif()
     endif()
 
     if(BUILD_MIXED)
@@ -121,8 +125,11 @@ else(BUILD_SHARED)
       #
       # Default static build using GNU-like compiler.
       #
-      if (NOT APPLE)
-            set(CMAKE_CXX_FLAGS "-static ${CMAKE_CXX_FLAGS}")
+      if (NOT APPLE AND NOT OHOS_BUILD_PARTIAL_STATIC)
+        # OHOS: keep partial static linking (libopenbabel.a) — a full
+        # '-static' link is incompatible with the shared libxml2 that the
+        # Conan-provided dependency ships.
+        set(CMAKE_CXX_FLAGS "-static ${CMAKE_CXX_FLAGS}")
       endif()
       # APPLE doesn't use -static
     endif(BUILD_MIXED)
@@ -132,10 +139,10 @@ else(BUILD_SHARED)
   add_executable(obabel obabel.cpp)
   target_link_libraries(obabel ${libs})
 
-  if(NOT BUILD_MIXED)
+  if(NOT BUILD_MIXED AND NOT OHOS_BUILD_PARTIAL_STATIC)
     # Prevent -Wl,-Bdynamic from being added to the end of the link line.
     set_target_properties(obabel PROPERTIES LINK_SEARCH_END_STATIC TRUE)
-  endif(NOT BUILD_MIXED)
+  endif(NOT BUILD_MIXED AND NOT OHOS_BUILD_PARTIAL_STATIC)
 
   install(TARGETS obabel
           RUNTIME DESTINATION bin
