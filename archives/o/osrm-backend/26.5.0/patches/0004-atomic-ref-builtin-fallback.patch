--- a/include/util/packed_vector.hpp	2026-09-11 08:22:03.958276094 +0800
+++ b/include/util/packed_vector.hpp	2026-09-11 08:22:04.214277188 +0800
@@ -117,9 +117,16 @@
 
 inline bool compare_and_swap(uint64_t *ptr, uint64_t old_value, uint64_t new_value)
 {
-    // Use std::atomic_ref for lock-free atomic compare-and-swap
+    // std::atomic_ref is unavailable in some standard libraries (libc++ 15
+    // ships without it); __atomic_compare_exchange_n provides the identical
+    // lock-free compare-and-swap on gcc/clang.
+#if defined(__cpp_lib_atomic_ref) && __cpp_lib_atomic_ref >= 201806L
     std::atomic_ref<uint64_t> atomic_ref(*ptr);
     return atomic_ref.compare_exchange_strong(old_value, new_value, std::memory_order_seq_cst);
+#else
+    return __atomic_compare_exchange_n(
+        ptr, &old_value, new_value, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+#endif
 }
 
 template <typename T, std::size_t Bits, storage::Ownership Ownership> class PackedVector
