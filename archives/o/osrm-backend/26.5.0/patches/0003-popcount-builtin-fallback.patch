diff -ru a/include/util/bit_range.hpp b/include/util/bit_range.hpp
--- a/include/util/bit_range.hpp	2026-09-11 08:09:24.722276563 +0800
+++ b/include/util/bit_range.hpp	2026-09-11 08:09:24.902275625 +0800
@@ -55,7 +55,17 @@
     explicit BitRange(T v) : value(v) {}
     BitIterator<T> begin() const { return BitIterator<T>(value); }
     BitIterator<T> end() const { return BitIterator<T>(0); }
-    std::size_t size() const { return std::popcount(static_cast<std::make_unsigned_t<T>>(value)); }
+    std::size_t size() const
+    {
+        // Some standard libraries ship <bit> without std::popcount; the
+        // gcc/clang builtin computes the same value on the unsigned type.
+#if defined(__GNUC__) || defined(__clang__)
+        return __builtin_popcountll(
+            static_cast<unsigned long long>(static_cast<std::make_unsigned_t<T>>(value)));
+#else
+        return std::popcount(static_cast<std::make_unsigned_t<T>>(value));
+#endif
+    }
     bool empty() const { return value == 0; }
     std::size_t front() const { return msb(value); }
     T value;
