index 08f3415..25b087b 100644
--- a/unit_tests/storage/shared_memory.cpp
+++ b/unit_tests/storage/shared_memory.cpp
@@ -103,6 +103,28 @@ BOOST_AUTO_TEST_CASE(get_lock_dir_uses_dev_shm_on_linux)
     EnvGuard::unset("SHM_LOCK_DIR");
 
     auto lock_dir = getLockDir();
+    // OHOS/HMDFS: /dev/shm is a namefs-managed tmpfs where unprivileged
+    // processes cannot create entries; getLockDir() then falls back to the
+    // home directory by design. Only assert the /dev/shm layout when the
+    // probe actually succeeds (standard Linux).
+    {
+        std::error_code probe_ec;
+        std::filesystem::path probe = std::filesystem::path("/dev/shm") / "osrm-lock-dir-probe";
+        std::filesystem::create_directories(probe, probe_ec);
+        if (!probe_ec)
+        {
+            std::error_code rm_ec;
+            std::filesystem::remove(probe, rm_ec);
+        }
+        if (probe_ec)
+        {
+            BOOST_TEST_MESSAGE("SKIP: /dev/shm not writable on this platform ("
+                               << probe_ec.message() << "); lock_dir="
+                               << lock_dir.string());
+            std::filesystem::remove(lock_dir, probe_ec);
+            return;
+        }
+    }
     // Should be under /dev/shm/osrm-<uid>/
     BOOST_CHECK(lock_dir.string().find("/dev/shm/osrm-") != std::string::npos);
     BOOST_CHECK(std::filesystem::exists(lock_dir));
