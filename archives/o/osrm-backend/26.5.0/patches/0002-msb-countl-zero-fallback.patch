diff -ru a/include/util/msb.hpp b/include/util/msb.hpp
--- a/include/util/msb.hpp	2026-09-11 07:45:41.838276875 +0800
+++ b/include/util/msb.hpp	2026-09-11 07:45:42.066276094 +0800
@@ -15,7 +15,17 @@
     static_assert(std::is_integral<T>::value && !std::is_signed<T>::value, "Integer required.");
     constexpr auto MSB_INDEX = std::numeric_limits<unsigned char>::digits * sizeof(T) - 1;
 
+    // Some standard libraries ship <bit> without the C++20 bit utilities
+    // (no std::countl_zero); __builtin_clzll covers the same semantics on
+    // gcc/clang, and a plain loop keeps other compilers working.
+#if defined(__GNUC__) || defined(__clang__)
+    using U = unsigned long long;
+    return MSB_INDEX - (value == 0 ? int(sizeof(T) * 8)
+                                   : __builtin_clzll(static_cast<U>(value)) -
+                                         int(sizeof(U) * 8 - sizeof(T) * 8));
+#else
     return MSB_INDEX - std::countl_zero(value);
+#endif
 }
 
 } // namespace osrm::util
