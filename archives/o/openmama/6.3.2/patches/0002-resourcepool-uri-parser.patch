 #include "mama/regexchannelfilter.h"
 #include "strutils.h"
 #include <apr_pools.h>
-#include <apr_uri.h>
+#include <ctype.h>
 #include <mama/resourcepool.h>
 #include <wombat/wtable.h>
 
+int
+mamaResourcePoolUri_parse (
+    apr_pool_t* pool,
+    const char* uri,
+    mamaResourcePoolUri* parsed
+)
+{
+    const char* cursor = NULL;
+    const char* end    = NULL;
+    const char* limit  = NULL;
+    char*       scheme = NULL;
+    char*       lower  = NULL;
+
+    if (NULL == pool || NULL == uri || NULL == parsed)
+    {
+        return -1;
+    }
+
+    memset (parsed, 0, sizeof (mamaResourcePoolUri));
+
+    /* Everything from the fragment delimiter on is not used by the resource
+     * pool, but it does bound the query when the two are both present. */
+    limit = strchr (uri, '#');
+    if (NULL == limit)
+    {
+        limit = uri + strlen (uri);
+    }
+
+    /* The scheme must be present and non empty. Like apr_uri_parse it is
+     * reported lower case (RFC 3986 section 3.1). */
+    cursor = strchr (uri, ':');
+    if (NULL == cursor || cursor == uri || cursor > limit)
+    {
+        return -1;
+    }
+
+    scheme = apr_pstrmemdup (pool, uri, cursor - uri);
+    if (NULL == scheme)
+    {
+        return -1;
+    }
+    for (lower = scheme; '\0' != *lower; lower++)
+    {
+        *lower = (char) tolower ((unsigned char) *lower);
+    }
+    parsed->mScheme = scheme;
+    cursor++;
+
+    /* An authority is only present for "<scheme>://<authority>"; it runs up
+     * to the path, the query or the end of the URI. As with apr_uri_parse
+     * every component is its own copy of the pool, so the delimiters stay
+     * where they are instead of being overwritten in place. */
+    if ('/' == cursor[0] && '/' == cursor[1])
+    {
+        const char* authority = cursor + 2;
+
+        end = strpbrk (authority, "/?");
+        if (NULL != end && end > limit)
+        {
+            end = limit;
+        }
+        parsed->mAuthority = apr_pstrmemdup (pool, authority,
+                                             (NULL == end ? limit : end) - authority);
+        cursor = (NULL == end) ? limit : end;
+    }
+
+    /* The path is always set, but empty when the URI has none: it may end
+     * with the authority, or carry a query straight away. */
+    end = strchr (cursor, '?');
+    if (NULL != end && end > limit)
+    {
+        end = NULL;
+    }
+    parsed->mPath = apr_pstrmemdup (pool, cursor,
+                                    (NULL == end ? limit : end) - cursor);
+
+    if (NULL != end)
+    {
+        parsed->mQuery = apr_pstrmemdup (pool, end + 1, limit - (end + 1));
+    }
+
+    return 0;
+}
+
