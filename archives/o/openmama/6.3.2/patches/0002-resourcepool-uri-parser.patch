+/* Minimal URI parser standing in for APR-util's apr_uri_parse.
+ *
+ * APR-util is not published for this platform, and the resource pool only
+ * needs the scheme, authority, path and query of URIs of the form
+ *
+ *     <scheme>://<authority>/<path>?<query>
+ *
+ * so a small local implementation replaces the whole library. As with
+ * apr_uri_parse the members below are owned by the given APR pool and stay
+ * valid for as long as it does. Members that the URI does not carry are
+ * NULL, except mPath which is always set (empty when there is no path).
+ */
+typedef struct mamaResourcePoolUri_
+{
+    char* mScheme;    /* e.g. "mama"        - NULL when absent              */
+    char* mAuthority; /* e.g. "transport"   - NULL when absent              */
+    char* mPath;      /* leading '/', e.g. "/topic" - "" when absent        */
+    char* mQuery;     /* e.g. "option=value" - NULL when absent             */
+} mamaResourcePoolUri;
+
+/* Returns 0 on success and non-zero when the URI has no usable scheme. */
+MAMAExpDLL
+extern int
+mamaResourcePoolUri_parse (
+    apr_pool_t* pool,
+    const char* uri,
+    mamaResourcePoolUri* parsed
+);
+
 #if defined(__cplusplus)
 }
 #endif
