--- a/mama/c_cpp/src/testtools/performance/c/CMakeLists.txt
+++ b/mama/c_cpp/src/testtools/performance/c/CMakeLists.txt
@@ -16,7 +16,14 @@
 endif()
 
 mamac_binary(mamaconsumerc ${RTLIB})
-mamac_binary(mamaconsumerc_v2 ${RTLIB})
-mamac_binary(mamapingpongc ${RTLIB})
 mamac_binary(mamaproducerc ${RTLIB})
-mamac_binary(mamaproducerc_v2 ${RTLIB})
+
+# These three measure latency with the x86 time stamp counter (inline "rdtsc"
+# asm) and tune glibc's allocator through M_TRIM_THRESHOLD/M_MMAP_MAX, neither
+# of which exists off x86, so they are only buildable there.  The portable
+# performance tools are unaffected.
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|i[3-6]86)$")
+	mamac_binary(mamaconsumerc_v2 ${RTLIB})
+	mamac_binary(mamaproducerc_v2 ${RTLIB})
+	mamac_binary(mamapingpongc ${RTLIB})
+endif()
