--- a/common/c_cpp/src/c/linux/wombat/port.h
+++ b/common/c_cpp/src/c/linux/wombat/port.h
@@ -59,8 +59,24 @@
 
 /* PTHREAD static locks are easy */
 typedef pthread_mutex_t wthread_static_mutex_t;
+/* This libc has no static initialiser for a recursive mutex, but its
+ * normal initialiser is the zero filled mutex with the type field first,
+ * so the recursive one is that same initialiser carrying
+ * PTHREAD_MUTEX_RECURSIVE. Recursion is required: the property lexer lock
+ * and several of the MAMA locks are taken re-entrantly, and a plain mutex
+ * deadlocks the thread on the second acquisition. */
+#ifdef PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP
 #define WSTATIC_MUTEX_INITIALIZER PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP
+#else
+#define WSTATIC_MUTEX_INITIALIZER {{{PTHREAD_MUTEX_RECURSIVE}}}
+#endif
+/* As above: the _NP name is a GNU libc extension, the portable name is
+ * PTHREAD_MUTEX_RECURSIVE. */
+#ifdef PTHREAD_MUTEX_RECURSIVE_NP
 #define WTHREAD_MUTEX_RECURSIVE PTHREAD_MUTEX_RECURSIVE_NP
+#else
+#define WTHREAD_MUTEX_RECURSIVE PTHREAD_MUTEX_RECURSIVE
+#endif
 #define wthread_static_mutex_lock(x) pthread_mutex_lock((x))
 #define wthread_static_mutex_unlock(x) pthread_mutex_unlock((x))
 
@@ -125,7 +141,9 @@
 #define CPU_AFFINITY_SET 				cpu_set_t
 
 /* Use pthreads for linux */
-#define INVALID_THREAD (-1)
+/* wthread_t is pthread_t, which is an opaque pointer type rather than an
+ * integer on this platform, so -1 is not a valid value for it. */
+#define INVALID_THREAD NULL
 
 #define wthread_mutex_t         pthread_mutex_t    
 #define wthread_mutex_init      pthread_mutex_init
@@ -142,7 +160,15 @@
 #define wthread_join		pthread_join
 #define wthread_create		pthread_create
 #define wthread_exit            pthread_exit
+#ifdef __GLIBC__
 #define wthread_set_affinity_mask pthread_setaffinity_np
+#else
+/* libcs other than glibc leave out that _np wrapper, but they do provide
+ * the two calls it is made of: the kernel thread id of a pthread_t and
+ * sched_setaffinity() itself, so affinity keeps working through those. */
+#define wthread_set_affinity_mask(thread, size, mask) \
+        sched_setaffinity (pthread_gettid_np (thread), (size), (mask))
+#endif
 
 #define wthread_cond_t	        pthread_cond_t
 #define wthread_cond_init       pthread_cond_init
