--- a/common/c_cpp/src/gunittest/c/CMakeLists.txt
+++ b/common/c_cpp/src/gunittest/c/CMakeLists.txt
@@ -1,3 +1,11 @@
+# The suite links against the C++17 GoogleTest package while the top level
+# CMakeLists builds the libraries as C++11, so the standard is raised for the
+# unit test targets only. CMake's GoogleTest module, which provides the
+# gtest_discover_tests() called below, is included here as well.
+set (CMAKE_CXX_STANDARD 17)
+set (CMAKE_CXX_STANDARD_REQUIRED ON)
+include (GoogleTest)
+
 enable_testing()
 include_directories(${GTEST_INCLUDE_DIRS})
 
