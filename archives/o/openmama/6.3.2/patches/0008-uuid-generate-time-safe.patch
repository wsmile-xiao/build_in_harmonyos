--- a/common/c_cpp/src/c/linux/wombat/wUuid.h
+++ b/common/c_cpp/src/c/linux/wombat/wUuid.h
@@ -36,7 +36,12 @@
 
 #define wUuid_generate              uuid_generate
 #define wUuid_generate_time         uuid_generate_time
-#define wUuid_generate_time_safe    uuid_generate_time_safe
+/* util-linux's libuuid adds uuid_generate_time_safe on top of the shared
+ * API; the libuuid built for this platform (e2fsprogs) stops at
+ * uuid_generate_time, so that entry point is used instead. It produces the
+ * same kind of uuid, only without the "no concurrent reuse" promise the
+ * _safe variant adds. */
+#define wUuid_generate_time_safe    uuid_generate_time
 #define wUuid_generate_random       uuid_generate_random
 
 #define wUuid_unparse uuid_unparse
