--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -14,10 +14,26 @@
 LIST(APPEND CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake")
 SET(SHARE_DIR "${CMAKE_INSTALL_PREFIX}/share/osm2pgrouting")
 
-find_package(PostgreSQL REQUIRED)
-find_package(PQXX REQUIRED)
+# --- OHOS adaptation: take the three C dependencies from the CMake config
+# packages that Conan's CMakeDeps generator writes.  The bundled
+# cmake/FindPostgreSQL.cmake shells out to `pg_config` and then scans
+# /usr/include/postgresql*, and cmake/FindPQXX.cmake scans /usr/include:
+# both describe the BUILD HOST, so on an OHOS worker they either pick up the
+# host's PostgreSQL (wrong ABI, wrong sysroot) or nothing at all.  The
+# explicit CONFIG keyword keeps the bundled modules in CMAKE_MODULE_PATH
+# from being consulted again.
+find_package(libpq CONFIG REQUIRED)
+find_package(libpqxx CONFIG REQUIRED)
+find_package(EXPAT CONFIG REQUIRED)
+
+# The rest of this file links against ${POSTGRESQL_LIBRARIES} and friends;
+# map the Conan imported targets onto those legacy variable names so the
+# transitive include directories and link flags travel with them.
+set(POSTGRESQL_LIBRARIES libpq::libpq)
+set(PQXX_LIBRARIES libpqxx::pqxx)
+set(EXPAT_LIBRARIES expat::expat)
+set(PQXX_VERSION ${libpqxx_VERSION})
 include_directories(${PQXX_INCLUDE_DIR})
-find_package(EXPAT REQUIRED)
 
 
 FILE(GLOB osm2pgrouting_lib_SOURCES "${CMAKE_SOURCE_DIR}/src/*/*.cpp")
@@ -31,7 +47,7 @@
 # Boost
 #---------------------------------------------
 #---------------------------------------------
-find_package(Boost ${BOOST_MINIMUM_VERSION} REQUIRED COMPONENTS program_options)
+find_package(Boost CONFIG REQUIRED COMPONENTS program_options)
 if (NOT Boost_VERSION_MACRO)
   set(Boost_VERSION_MACRO ${Boost_VERSION})
 endif()
@@ -41,12 +57,13 @@
 
 
 message(STATUS "PQXX_VERSION=${PQXX_VERSION}")
-if (PQXX_VERSION VERSION_GREATER_EQUAL "7.0.0")
-  set(CMAKE_CXX_STANDARD 17)
-else()
-  add_definitions(-DPQXX_DISCONNECT)
-  set(CMAKE_CXX_STANDARD 14)
-endif()
+# libpqxx 8.x requires C++20 (upstream requirements.json) and its headers use
+# concepts and std::format, so the original ">= 7.0.0 -> C++17" branch is not
+# enough.  The shared OHOS profile pins compiler.cppstd=17, and a plain set()
+# here shadows the cache variable the Conan toolchain writes, so this is the
+# place the standard has to be raised.
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
 set (CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -D_FILE_OFFSET_BITS=64")
 set (CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} -Wall -Wconversion -pedantic -Wextra  -frounding-math -Wno-deprecated")
