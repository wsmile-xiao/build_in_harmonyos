+#pragma once
+
+// OHOS toolchain ships libc++ 15 without C++20 <source_location>.
+// Provide a std::source_location polyfill backed by clang builtins
+// (__builtin_FILE / __builtin_LINE / __builtin_FUNCTION, available since clang 9).
+#if __has_include(<source_location>)
+    #include <source_location>
+#else
+    #include <cstdint>
+
+namespace std
+{
+    class source_location
+    {
+    public:
+        constexpr source_location() = default;
+
+        static constexpr source_location current(
+            const char* fileName = __builtin_FILE(),
+            std::uint_least32_t line = __builtin_LINE(),
+            std::uint_least32_t column = 0,
+            const char* functionName = __builtin_FUNCTION()) noexcept
+        {
+            return source_location(fileName, line, column, functionName);
+        }
+
+        constexpr const char* file_name() const noexcept
+        {
+            return _fileName;
+        }
+
+        constexpr std::uint_least32_t line() const noexcept
+        {
+            return _line;
+        }
+
+        constexpr std::uint_least32_t column() const noexcept
+        {
+            return _column;
+        }
+
+        constexpr const char* function_name() const noexcept
+        {
+            return _functionName;
+        }
+
+    private:
+        constexpr source_location(
+            const char* fileName, std::uint_least32_t line, std::uint_least32_t column, const char* functionName)
+            : _fileName(fileName)
+            , _line(line)
+            , _column(column)
+            , _functionName(functionName)
+        {
+        }
+
+        const char* _fileName = "";
+        std::uint_least32_t _line = 0;
+        std::uint_least32_t _column = 0;
+        const char* _functionName = "";
+    };
+} // namespace std
+#endif
