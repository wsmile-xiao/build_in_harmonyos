diff -ruN a/mkinstalldirs b/mkinstalldirs
--- a/mkinstalldirs
+++ b/mkinstalldirs
@@ -0,0 +1,33 @@
+#!/bin/sh
+# mkinstalldirs - create directory hierarchy
+# Simple replacement for install-sh/mkinstalldirs
+
+while test $# -gt 0; do
+  dir="$1"
+  shift
+
+  if test -d "$dir"; then
+    # Directory already exists
+    continue
+  fi
+
+  # Create directory
+  if mkdir -p "$dir" 2>/dev/null; then
+    continue
+  fi
+
+  # mkdir -p failed, try creating parent directories first
+  parent=`echo "$dir" | sed -e 's|/[^/]*$||'`
+  if test -n "$parent" && test ! -d "$parent"; then
+    $0 "$parent"
+  fi
+
+  if mkdir "$dir" 2>/dev/null; then
+    continue
+  fi
+
+  echo "ERROR: Cannot create directory $dir"
+  exit 1
+done
+
+exit 0