// OHOS PC 工具链兼容垫片：libc++ 15（clang 15.0.4 / omath 5.6.0 的 CI 同款 SDK）未提供
// <print>（C++23，libc++ 18 才落地）。本文件以同名头文件挂进 -I 搜索路径，使 omath 上游的
// #include <print> 落到本实现，不改动上游源码。
// 实现复用本构建已开启的 <format>（-fexperimental-library + -lc++experimental，
// 同 ladybug 0.18.2 / poppler 25.12.0.2 先例）。
#pragma once

#include <format>
#include <cstdio>
#include <utility>

namespace std
{
inline namespace omath_compat
{

template<class... Args>
void print(format_string<Args...> fmt, Args&&... args)
{
    const string text = format(fmt, std::forward<Args>(args)...);
    (void)std::fwrite(text.data(), 1, text.size(), stdout);
}

template<class... Args>
void println(format_string<Args...> fmt, Args&&... args)
{
    const string text = format(fmt, std::forward<Args>(args)...);
    (void)std::fwrite(text.data(), 1, text.size(), stdout);
    (void)std::fputc('\n', stdout);
}

}  // namespace omath_compat
}  // namespace std
