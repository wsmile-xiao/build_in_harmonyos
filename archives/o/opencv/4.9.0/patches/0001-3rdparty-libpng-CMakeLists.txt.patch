diff -ruN a/3rdparty/libpng/CMakeLists.txt b/3rdparty/libpng/CMakeLists.txt
--- a/3rdparty/libpng/CMakeLists.txt
+++ b/3rdparty/libpng/CMakeLists.txt
@@ -21,20 +21,27 @@
   # not needed on windows
   set(M_LIBRARY "")
 endif()
 
 ocv_include_directories("${CMAKE_CURRENT_SOURCE_DIR}" ${ZLIB_INCLUDE_DIRS})
 
 file(GLOB lib_srcs *.c)
 file(GLOB lib_hdrs *.h)
 
 
+# Force disable NEON for HarmonyOS cross-compilation (processor detected as 'unknown')
+# Original condition: ARM OR AARCH64 - not triggered on HarmonyOS
+# Always add PNG_ARM_NEON_OPT=0 to prevent undefined NEON symbols
+add_definitions(-DPNG_ARM_NEON_OPT=0)
+message(STATUS "libpng: NEON disabled for cross-compilation (PNG_ARM_NEON_OPT=0)")
+
+# Keep original logic for reference
 if(ARM OR AARCH64)
   if(ENABLE_NEON)
     if(NOT AARCH64)
       list(APPEND lib_srcs arm/filter_neon.S)
     endif()
     list(APPEND lib_srcs arm/arm_init.c arm/filter_neon_intrinsics.c arm/palette_neon_intrinsics.c)
     add_definitions(-DPNG_ARM_NEON_OPT=2)
   else()
     add_definitions(-DPNG_ARM_NEON_OPT=0) # NEON assembler is not supported
   endif()
