--- a/cmake/OpenfastFortranOptions.cmake
+++ b/cmake/OpenfastFortranOptions.cmake
@@ -43,7 +43,8 @@
   # Abort if we do not have gfortran or Intel Fortran Compiler.
   if (NOT (${CMAKE_Fortran_COMPILER_ID} STREQUAL "GNU" OR
         ${CMAKE_Fortran_COMPILER_ID} MATCHES "^Intel" OR
-        ${CMAKE_Fortran_COMPILER_ID} STREQUAL "Flang"))
+        ${CMAKE_Fortran_COMPILER_ID} STREQUAL "Flang" OR
+        ${CMAKE_Fortran_COMPILER_ID} STREQUAL "LLVMFlang"))
     message(FATAL_ERROR "OpenFAST requires GFortran, Intel, or Flang Compiler. Compiler detected by CMake: ${FCNAME}.")
   endif()
 
@@ -71,7 +72,7 @@
     set_fast_gfortran()
   elseif(${CMAKE_Fortran_COMPILER_ID} MATCHES "^Intel")
     set_fast_intel_fortran()
-  elseif(${CMAKE_Fortran_COMPILER_ID} STREQUAL "Flang")
+  elseif(${CMAKE_Fortran_COMPILER_ID} STREQUAL "Flang" OR ${CMAKE_Fortran_COMPILER_ID} STREQUAL "LLVMFlang")
     set_fast_flang()
   endif()
 
--- a/modules/nwtc-library/CMakeLists.txt
+++ b/modules/nwtc-library/CMakeLists.txt
@@ -47,7 +47,7 @@
     set(NWTC_SYS_FILE src/SysIVF.f90)
     set(NWTC_SYS_FILE_MATLAB ${CMAKE_CURRENT_SOURCE_DIR}/src/SysMatlabWindows.f90)
   endif (NOT WIN32)
-elseif (${CMAKE_Fortran_COMPILER_ID} STREQUAL "Flang")
+elseif (${CMAKE_Fortran_COMPILER_ID} STREQUAL "Flang" OR ${CMAKE_Fortran_COMPILER_ID} STREQUAL "LLVMFlang")
   if(NOT WIN32)
     set(NWTC_SYS_FILE src/SysFlangLinux.f90)
   endif()
