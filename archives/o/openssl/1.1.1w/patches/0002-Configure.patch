@@ -1099,6 +1099,44 @@
     }
 }
 
+
+    
+    # OpenHarmony (HarmonyOS/OpenHarmony) automatic platform detection
+    # This allows users to run ./Configure without specifying a target on OpenHarmony systems
+    # Detection is performed only if the target is not found in the target table
+    if (!$table{$target}) {
+        # Detect system information
+        my $sysname = `uname -s 2>/dev/null` || "unknown";
+        my $machine = `uname -m 2>/dev/null` || "unknown";
+        my $kernel = `uname -r 2>/dev/null` || "unknown";
+        
+        # Check if this is an OpenHarmony system
+        my $is_openharmony = 0;
+        if ($sysname =~ m/harmonyos|openharmony/i) {
+            $is_openharmony = 1;
+        } elsif ($kernel =~ m/harmonyos|openharmony/i) {
+            $is_openharmony = 1;
+        }
+        
+        # If it's OpenHarmony, map to appropriate target
+        if ($is_openharmony) {
+            if ($machine =~ m/x86_64/i) {
+                $target = "openharmony-x86_64";
+            } elsif ($machine =~ m/x86/i) {
+                $target = "openharmony-x86";
+            } elsif ($machine =~ m/aarch64/i) {
+                $target = "openharmony-aarch64";
+            } elsif ($machine =~ m/armv[78]/i) {
+                $target = "openharmony-arm";
+            } elsif ($machine =~ m/riscv64/i) {
+                $target = "openharmony-riscv64";
+            } else {
+                # Default to ARM64 for OpenHarmony
+                $target = "openharmony-aarch64";
+            }
+            print "Auto-detected OpenHarmony system, using target: $target\n";
+        }
+    }
 &usage if !$table{$target} || $table{$target}->{template};
 
 $config{target} = $target;
