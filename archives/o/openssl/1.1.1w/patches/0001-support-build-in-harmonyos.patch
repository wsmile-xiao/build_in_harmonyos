From fe86778ce5ace37d3a8a592f1dec37fc7003bdda Mon Sep 17 00:00:00 2001
From: goblinrs <goblinrs@yeah.net>
Date: Wed, 4 Mar 2026 19:09:35 +0800
Subject: [PATCH] support build in harmonyos

Signed-off-by: goblinrs <goblinrs@yeah.net>
---
 Configurations/15-openharmony.conf | 49 ++++++++++++++++++++++++++++++
 Configure                          | 40 +++++++++++++++++++++++-
 2 files changed, 88 insertions(+), 1 deletion(-)
 create mode 100644 Configurations/15-openharmony.conf

diff --git a/Configurations/15-openharmony.conf b/Configurations/15-openharmony.conf
new file mode 100644
index 0000000000..860e751965
--- /dev/null
+++ b/Configurations/15-openharmony.conf
@@ -0,0 +1,49 @@
+# -*- mode: perl; -*-
+## OpenHarmony (HarmonyOS/OpenHarmony) Configuration
+# OpenHarmony is a HarmonyOS/OpenHarmony distribution based on OpenHarmony with LLVM toolchain
+
+{
+    use File::Spec::Functions;
+
+    my %targets = (
+        "openharmony" => {
+            inherit_from     => [ "linux-generic32.0" ],
+            template         => 1,
+            cflags           => add("-D__OHOS__"),
+            cppflags         => add("-D__OHOS__"),
+            cxxflags         => add("-D__OHOS__"),
+            bn_ops           => "BN_LLONG RC4_CHAR",
+            thread_scheme    => "pthreads",
+            dso_scheme       => "dlfcn",
+            shared_target    => "linux-shared",
+            shared_cflag     => "-fPIC",
+            shared_ldflag    => sub { $disabled{pinshared} ? () : "-Wl,-znodelete" },
+            shared_extension => ".so.\$(SHLIB_VERSION_NUMBER)",
+            enable           => [ "afalgeng" ],
+        },
+        "openharmony-aarch64" => {
+            inherit_from     => [ "openharmony", asm("aarch64_asm") ],
+            bn_ops           => add("RC4_CHAR"),
+            perlasm_scheme   => "linux64",
+        },
+        "openharmony-arm" => {
+            inherit_from     => [ "openharmony", asm("armv4_asm") ],
+            bn_ops           => add("RC4_CHAR"),
+        },
+        "openharmony-x86_64" => {
+            inherit_from     => [ "openharmony", asm("x86_64_asm") ],
+            bn_ops           => "SIXTY_FOUR_BIT_LONG RC4_CHAR",
+            perlasm_scheme   => "elf",
+        },
+        "openharmony-x86" => {
+            inherit_from     => [ "openharmony", asm("x86_asm") ],
+            bn_ops           => "BN_LLONG RC4_CHAR",
+            perlasm_scheme   => "elf",
+        },
+        "openharmony-riscv64" => {
+            inherit_from     => [ "openharmony" ],
+            bn_ops           => "SIXTY_FOUR_BIT_LONG RC4_CHAR",
+            perlasm_scheme   => "linux64",
+        },
+    );
+}
diff --git a/Configure b/Configure
index 78cc15d184..907152530b 100755
--- a/Configure
+++ b/Configure
@@ -1,4 +1,4 @@
-#! /usr/bin/env perl
+#! /bin/env perl
 # -*- mode: perl; -*-
 # Copyright 2016-2023 The OpenSSL Project Authors. All Rights Reserved.
 #
@@ -1099,6 +1099,44 @@ if ($d) {
     }
 }
 
+
+    
+    # OpenHarmony (HarmonyOS/OpenHarmony) automatic platform detection
+    # This allows users to run ./Configure without specifying a target on OpenHarmony systems
+    # Detection is performed only if the target is not found in the target table
+    if (!$table{$target}) {
+        # Detect system information
+        my $sysname = `uname -s 2>/dev/null` || "unknown";
+        my $machine = `uname -m 2>/dev/null` || "unknown";
+        my $kernel = `uname -r 2>/dev/null` || "unknown";
+        
+        # Check if this is an OpenHarmony system
+        my $is_openharmony = 0;
+        if ($sysname =~ m/harmonyos|openharmony/i) {
+            $is_openharmony = 1;
+        } elsif ($kernel =~ m/harmonyos|openharmony/i) {
+            $is_openharmony = 1;
+        }
+        
+        # If it's OpenHarmony, map to appropriate target
+        if ($is_openharmony) {
+            if ($machine =~ m/x86_64/i) {
+                $target = "openharmony-x86_64";
+            } elsif ($machine =~ m/x86/i) {
+                $target = "openharmony-x86";
+            } elsif ($machine =~ m/aarch64/i) {
+                $target = "openharmony-aarch64";
+            } elsif ($machine =~ m/armv[78]/i) {
+                $target = "openharmony-arm";
+            } elsif ($machine =~ m/riscv64/i) {
+                $target = "openharmony-riscv64";
+            } else {
+                # Default to ARM64 for OpenHarmony
+                $target = "openharmony-aarch64";
+            }
+            print "Auto-detected OpenHarmony system, using target: $target\n";
+        }
+    }
 &usage if !$table{$target} || $table{$target}->{template};
 
 $config{target} = $target;
-- 
