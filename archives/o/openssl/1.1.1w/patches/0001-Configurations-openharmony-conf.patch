+# -*- mode: perl; -*-
+## OpenHarmony (HarmonyOS/OpenHarmony) Configuration
+# OpenHarmony is a HarmonyOS/OpenHarmony distribution based on OpenHarmony with LLVM toolchain
+
+{
+    use File::Spec::Functions;
+
+    my %targets = (
+        "openharmony" => {
+            inherit_from     => [ "linux-generic32.0" ],
+            template         => 1,
+            cflags           => add("-D__OHOS__"),
+            cppflags         => add("-D__OHOS__"),
+            cxxflags         => add("-D__OHOS__"),
+            bn_ops           => "BN_LLONG RC4_CHAR",
+            thread_scheme    => "pthreads",
+            dso_scheme       => "dlfcn",
+            shared_target    => "linux-shared",
+            shared_cflag     => "-fPIC",
+            shared_ldflag    => sub { $disabled{pinshared} ? () : "-Wl,-znodelete" },
+            shared_extension => ".so.\$(SHLIB_VERSION_NUMBER)",
+            enable           => [ "afalgeng" ],
+        },
+        "openharmony-aarch64" => {
+            inherit_from     => [ "openharmony", asm("aarch64_asm") ],
+            bn_ops           => add("RC4_CHAR"),
+            perlasm_scheme   => "linux64",
+        },
+        "openharmony-arm" => {
+            inherit_from     => [ "openharmony", asm("armv4_asm") ],
+            bn_ops           => add("RC4_CHAR"),
+        },
+        "openharmony-x86_64" => {
+            inherit_from     => [ "openharmony", asm("x86_64_asm") ],
+            bn_ops           => "SIXTY_FOUR_BIT_LONG RC4_CHAR",
+            perlasm_scheme   => "elf",
+        },
+        "openharmony-x86" => {
+            inherit_from     => [ "openharmony", asm("x86_asm") ],
+            bn_ops           => "BN_LLONG RC4_CHAR",
+            perlasm_scheme   => "elf",
+        },
+        "openharmony-riscv64" => {
+            inherit_from     => [ "openharmony" ],
+            bn_ops           => "SIXTY_FOUR_BIT_LONG RC4_CHAR",
+            perlasm_scheme   => "linux64",
+        },
+    );
+}
