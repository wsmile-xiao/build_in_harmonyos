--- a/src/openvpn/syshead.h
+++ b/src/openvpn/syshead.h
@@ -108,5 +108,16 @@
 #include <time.h>

 #ifdef HAVE_SYS_SOCKET_H
 #include <sys/socket.h>
+/* OHOS musl sysroot: linux/socket.h (pulled in by linux/netlink.h,
+ * linux/if.h etc. in netlink/route consumers) redefines struct
+ * sockaddr_storage that sys/socket.h already provides and carries
+ * no guard against the libc definition. Define the uapi header's
+ * own include guard up front so it becomes a no-op; the kernel
+ * typedef it would have provided is defined here for netlink
+ * consumers. Feature-level fix: no platform macros involved. */
+#define _UAPI_LINUX_SOCKET_H
+#ifndef __kernel_sa_family_t
+typedef unsigned short __kernel_sa_family_t;
+#endif
 #endif

 #ifdef HAVE_SYS_UN_H
