diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -82,7 +82,10 @@ elseif(CMAKE_SYSTEM_NAME MATCHES "Linux")
 	add_definitions(-D_DEFAULT_SOURCE)
 	add_definitions(-DHAVE_UDPENCAP6)
 	add_definitions(-DSPT_TYPE=SPT_REUSEARGV)
-	set(HAVE_VROUTE_NETLINK ON)
+	# OHOS SDK: <linux/socket.h> redefines sockaddr_storage already
+	# provided by <sys/socket.h> (sysroot header hygiene) — the netlink
+	# vroute backend cannot compile there; disable until fixed.
+	set(HAVE_VROUTE_NETLINK OFF)
 endif()
 if (NOT DEFINED CMAKE_INSTALL_MANDIR)
 	set (CMAKE_INSTALL_MANDIR ${CMAKE_INSTALL_PREFIX}/man)
diff --git a/iked/proc.c b/iked/proc.c
--- a/iked/proc.c
+++ b/iked/proc.c
@@ -30,6 +30,11 @@
 #include <errno.h>
 #include <signal.h>
 #include <paths.h>
+
+/* musl/OHOS: WAIT_ANY is a BSD macro (-1), absent from musl wait.h */
+#ifndef WAIT_ANY
+#define WAIT_ANY (-1)
+#endif
 #include <pwd.h>
 #include <event.h>
 #include <imsg.h>
