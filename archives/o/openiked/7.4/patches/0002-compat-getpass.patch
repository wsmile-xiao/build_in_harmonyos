diff --git a/tmp/pw2/b/compat/getpass.c b/compat/getpass.c
new file mode 100644
--- /dev/null
+++ b/compat/getpass.c
@@ -0,0 +1,36 @@
+/*
+ * Minimal getpass(3) for platforms whose libc omits it (e.g. musl).
+ * Reads a passphrase from the controlling terminal with echo disabled.
+ * Returns a pointer to a static buffer, or NULL on terminal failure.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <termios.h>
+#include <unistd.h>
+
+char *
+getpass(const char *prompt)
+{
+	struct termios term, oterm;
+	static char buf[128];
+	size_t len = 0;
+	int c;
+
+	if (tcgetattr(STDIN_FILENO, &term) != 0)
+		return NULL;
+	oterm = term;
+	term.c_lflag &= ~(ECHO);
+	if (tcsetattr(STDIN_FILENO, TCSANOW, &term) != 0)
+		return NULL;
+	if (prompt != NULL)
+		fputs(prompt, stderr);
+	while ((c = fgetc(stdin)) != EOF && c != '\n') {
+		if (len + 1 < sizeof(buf))
+			buf[len++] = (char)c;
+	}
+	tcsetattr(STDIN_FILENO, TCSANOW, &oterm);
+	fputc('\n', stderr);
+	buf[len] = '\0';
+	return buf;
+}
