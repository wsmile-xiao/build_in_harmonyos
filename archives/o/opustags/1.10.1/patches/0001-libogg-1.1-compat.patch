@@ -27,7 +27,35 @@
 #include <config.h>
 
 #include <iconv.h>
+
+// libogg < 1.3 compatibility shim (see conandata patches/0001 note).
+// The ohpcd artifact repository ships libogg 1.1.1, which predates the
+// ogg_{stream,sync}_check error-detection API (added in libogg 1.3) and
+// declares the ogg_page accessors without const qualification. Provided
+// here with byte-identical semantics to libogg 1.3.5 framing.c; safe
+// either way (inline definitions take precedence at link time).
 #include <ogg/ogg.h>
+
+inline int ogg_stream_check(ogg_stream_state *os)
+{
+	if (os == nullptr || os->body_data == nullptr)
+		return -1;
+	return 0;
+}
+
+inline int ogg_sync_check(ogg_sync_state *oy)
+{
+	if (oy->storage < 0)
+		return -1;
+	return 0;
+}
+
+inline long ogg_page_pageno(const ogg_page *og) { return ::ogg_page_pageno(const_cast<ogg_page *>(og)); }
+inline int  ogg_page_version(const ogg_page *og) { return ::ogg_page_version(const_cast<ogg_page *>(og)); }
+inline int  ogg_page_continued(const ogg_page *og) { return ::ogg_page_continued(const_cast<ogg_page *>(og)); }
+inline int  ogg_page_bos(const ogg_page *og) { return ::ogg_page_bos(const_cast<ogg_page *>(og)); }
+inline int  ogg_page_eos(const ogg_page *og) { return ::ogg_page_eos(const_cast<ogg_page *>(og)); }
+
 #include <stdio.h>
 #include <time.h>
 
