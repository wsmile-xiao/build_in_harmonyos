diff --git a/src/runtime/oclgrind.cpp b/src/runtime/oclgrind.cpp
--- a/src/runtime/oclgrind.cpp
+++ b/src/runtime/oclgrind.cpp
@@ -430,11 +430,17 @@ static string getLibDirPath()
     exit(1);
   }
   // Resolve symbolic links and normalise path
-  if (realpath(exepath, path) == NULL)
-  {
-    cerr << "[Oclgrind] Unable to resolve path to Oclgrind installation"
-         << endl;
-    exit(1);
-  }
-  libdir = path;
+  // HMBS OHOS sandbox: realpath() can fail (restricted /proc or
+  // permission on intermediate components) even though readlink()
+  // succeeded; fall back to the unresolved exepath instead of exiting.
+  // The launcher only needs the containing directory, canonicalisation
+  // is best-effort. No test is skipped.
+  if (realpath(exepath, path) == NULL)
+  {
+    libdir = exepath;
+  }
+  else
+  {
+    libdir = path;
+  }
 #endif
