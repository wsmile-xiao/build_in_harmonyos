+/**
+  \file    vvencohoscapptest.c
+  \brief   HarmonyOS/OHOS consumer use case test (added by the OpenHarmony PC adaptation).
+
+  This test is registered in the regular upstream ctest suite as
+  "Test_vvencohoscapptest" and covers the two properties of the OHOS port that
+  the other upstream tests cannot observe:
+
+    1. Runtime linkage integrity of the shared library.
+       CMake describes versioned shared libraries with a symlink chain
+       (libvvenc.so -> libvvenc.so.<abi> -> libvvenc.so.<abi>.<patch>).  HMDFS,
+       the HarmonyOS file system, cannot reliably create or follow such
+       symlinks, so the loader failed to resolve the recorded
+       DT_NEEDED="libvvenc.so.<abi>" entry and every consumer aborted before
+       main() with "Error loading shared library libvvenc.so.1.14".  The port
+       therefore builds a single, unversioned real artifact.  This test asserts
+       that the library the process actually mapped is a plain regular file and
+       that it was reachable under its own runtime name.  (Knowledge-Ref: E050)
+    2. A consumer use case: the public encoder API is driven end to end - a
+       synthetic YUV420 frame is encoded and a non-empty VVC bitstream is
+       retrieved - proving the packaged library is usable, not merely loadable.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#include "vvenc/vvenc.h"
+#include "vvenc/vvencCfg.h"
+#include "vvenc/version.h"
+
+#if defined( VVENC_UNVERSIONED_SONAME )
+#include <dlfcn.h>
+#include <sys/stat.h>
+#include <libgen.h>
+#endif
+
+static int g_checks   = 0;
+static int g_failures = 0;
+
+static void check( int condition, const char* description )
+{
+  g_checks++;
+  if( !condition )
+  {
+    g_failures++;
+  }
+  printf( "%-4s %s\n", condition ? "PASS" : "FAIL", description );
+}
+
+static void msgFnc( void* ctx, int level, const char* fmt, va_list args )
+{
+  (void)ctx;
+  vfprintf( level == 1 ? stderr : stdout, fmt, args );
+}
+
+/* ---------------------------------------------------------------------------
+   1) runtime linkage integrity
+   --------------------------------------------------------------------------- */
+static void check_runtime_linkage( void )
+{
+  printf( "\n--- runtime linkage integrity ---\n" );
+
+#if defined( VVENC_UNVERSIONED_SONAME )
+  Dl_info info;
+  memset( &info, 0, sizeof( info ) );
+
+  if( dladdr( (const void*)&vvenc_encoder_create, &info ) == 0 || info.dli_fname == NULL )
+  {
+    check( 0, "libvvenc is resolvable through dladdr()" );
+    return;
+  }
+
+  printf( "     mapped from: %s\n", info.dli_fname );
+
+  struct stat lst;
+  struct stat st;
+  const int have_lstat = ( lstat( info.dli_fname, &lst ) == 0 );
+  const int have_stat  = ( stat(  info.dli_fname, &st  ) == 0 );
+
+  check( have_stat && S_ISREG( st.st_mode ),
+         "libvvenc maps to a regular file" );
+
+  /* This is the regression guard for the HMDFS limitation: a versioned layout
+     would expose the library through a symlink here. */
+  check( have_lstat && !S_ISLNK( lst.st_mode ),
+         "libvvenc is a real file, not a symlink (HMDFS cannot follow symlinks, E050)" );
+
+  {
+    char path_copy[4096];
+    const char* runtime_name = NULL;
+    size_t n = strlen( info.dli_fname );
+    if( n < sizeof( path_copy ) )
+    {
+      memcpy( path_copy, info.dli_fname, n + 1 );
+      runtime_name = basename( path_copy );
+    }
+    check( runtime_name != NULL && strncmp( runtime_name, "libvvenc.so", 11 ) == 0,
+           "libvvenc is reachable under its unversioned runtime name" );
+  }
+#else
+  printf( "     (versioned shared-library layout: single-file linkage checks not applicable)\n" );
+#endif
+}
+
+/* ---------------------------------------------------------------------------
+   2) consumer use case: encode a synthetic clip through the public C API
+   --------------------------------------------------------------------------- */
+static int consumer_encode( int width, int height, int fps, int qp, int maxFrames,
+                            int* auCountOut, long long* bitstreamBytesOut )
+{
+  int  iRet = -1;
+  int  auCount = 0;
+  long long bitstreamBytes = 0;
+
+  vvenc_config    cCfg;
+  vvencEncoder*   enc = NULL;
+
+  vvencYUVBuffer  cYUVInputBuffer;
+  vvencAccessUnit cAU;
+
+  bool encodeDone = false;
+
+  *auCountOut        = 0;
+  *bitstreamBytesOut = 0;
+
+  vvenc_init_default( &cCfg, width, height, fps, 0, qp, VVENC_FASTER );
+  cCfg.m_verbosity = VVENC_WARNING;
+  vvenc_set_msg_callback( &cCfg, NULL, &msgFnc );
+  cCfg.m_numThreads = 0;
+
+  enc = vvenc_encoder_create();
+  if( NULL == enc )
+  {
+    printf( "cannot create encoder\n" );
+    return -1;
+  }
+
+  iRet = vvenc_encoder_open( enc, &cCfg );
+  if( 0 != iRet )
+  {
+    printf( "cannot open encoder. ret: %d, %s\n", iRet, vvenc_get_last_error( enc ) );
+    vvenc_encoder_close( enc );
+    return iRet;
+  }
+
+  /* pick up the parameters that were finalised during vvenc_encoder_open() */
+  vvenc_get_config( enc, &cCfg );
+
+  printf( "     %dx%d, %d frames, preset VVENC_FASTER, qp %d\n",
+          cCfg.m_SourceWidth, cCfg.m_SourceHeight, maxFrames, qp );
+
+  vvenc_YUVBuffer_default( &cYUVInputBuffer );
+  vvenc_YUVBuffer_alloc_buffer( &cYUVInputBuffer, cCfg.m_internChromaFormat,
+                                cCfg.m_SourceWidth, cCfg.m_SourceHeight );
+
+  for( int comp = 0; comp < 3; comp++ )
+  {
+    memset( cYUVInputBuffer.planes[comp].ptr, 512,
+            cYUVInputBuffer.planes[comp].width * cYUVInputBuffer.planes[comp].height * sizeof( int16_t ) );
+  }
+
+  vvenc_accessUnit_default( &cAU );
+  vvenc_accessUnit_alloc_payload( &cAU, cCfg.m_SourceWidth * cCfg.m_SourceHeight );
+
+  for( int frame = 0; frame < maxFrames; frame++ )
+  {
+    for( int comp = 0; comp < 3; comp++ )
+    {
+      const unsigned iWhere = ( frame % cYUVInputBuffer.planes[comp].height ) * cYUVInputBuffer.planes[comp].stride;
+      const int      iMax   = cCfg.m_internalBitDepth[0] == 8 ? 255 : 1023;
+      const uint16_t val    = (uint16_t)( ( frame * 37 ) % ( iMax + 1 ) );
+      for( int x = 0; x < cYUVInputBuffer.planes[comp].width; x++ )
+      {
+        cYUVInputBuffer.planes[comp].ptr[iWhere + x] = val;
+      }
+    }
+    cYUVInputBuffer.sequenceNumber = frame;
+
+    iRet = vvenc_encode( enc, &cYUVInputBuffer, &cAU, &encodeDone );
+    if( 0 != iRet )
+    {
+      printf( "encoding failed. ret: %d, %s\n", iRet, vvenc_get_last_error( enc ) );
+      goto cleanup;
+    }
+
+    if( cAU.payloadUsedSize > 0 )
+    {
+      auCount++;
+      bitstreamBytes += cAU.payloadUsedSize;
+    }
+  }
+
+  /* flush the encoder */
+  for( int guard = 0; !encodeDone && guard < 10000; guard++ )
+  {
+    iRet = vvenc_encode( enc, NULL, &cAU, &encodeDone );
+    if( 0 != iRet )
+    {
+      printf( "flushing failed. ret: %d, %s\n", iRet, vvenc_get_last_error( enc ) );
+      goto cleanup;
+    }
+    if( cAU.payloadUsedSize > 0 )
+    {
+      auCount++;
+      bitstreamBytes += cAU.payloadUsedSize;
+    }
+  }
+
+  if( !encodeDone )
+  {
+    printf( "encoder did not flush within the guard limit\n" );
+    iRet = -1;
+    goto cleanup;
+  }
+
+  if( cCfg.m_verbosity >= VVENC_INFO )
+  {
+    vvenc_print_summary( enc );
+  }
+
+cleanup:
+
+  vvenc_YUVBuffer_free_buffer( &cYUVInputBuffer );
+  vvenc_accessUnit_free_payload( &cAU );
+
+  if( 0 != vvenc_encoder_close( enc ) )
+  {
+    printf( "close encoder failed\n" );
+    return -1;
+  }
+
+  if( 0 == iRet )
+  {
+    *auCountOut        = auCount;
+    *bitstreamBytesOut = bitstreamBytes;
+  }
+
+  return iRet;
+}
+
+int main( void )
+{
+  printf( "vvenc HarmonyOS/OHOS consumer test\n" );
+  printf( "     vvenc_get_version() = %s, VVENC_VERSION = %s\n",
+          vvenc_get_version() ? vvenc_get_version() : "(null)", VVENC_VERSION );
+
+  check( vvenc_get_version() != NULL && strcmp( vvenc_get_version(), VVENC_VERSION ) == 0,
+         "vvenc_get_version() matches the VVENC_VERSION build macro" );
+
+  check_runtime_linkage();
+
+  printf( "\n--- consumer use case: public encoder API round trip ---\n" );
+
+  {
+    int       auCount        = 0;
+    long long bitstreamBytes = 0;
+    const int iRet = consumer_encode( 176, 144, 30, 32, 8, &auCount, &bitstreamBytes );
+
+    printf( "     access units produced = %d, bitstream bytes = %lld\n", auCount, bitstreamBytes );
+
+    check( iRet == 0,          "encoder API round trip returns 0" );
+    check( auCount > 0,        "at least one access unit was produced" );
+    check( bitstreamBytes > 0, "the produced VVC bitstream is non-empty" );
+  }
+
+  printf( "\n%s: %d of %d check(s) failed\n",
+          g_failures == 0 ? "RESULT PASS" : "RESULT FAIL", g_failures, g_checks );
+
+  return g_failures == 0 ? 0 : 1;
+}
