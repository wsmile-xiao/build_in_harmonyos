--- /dev/null
+++ b/test/vvencohoscapptest/CMakeLists.txt
@@ -0,0 +1,47 @@
+# executable
+set( EXE_NAME vvencohoscapptest )
+
+# get source files
+file( GLOB SRC_FILES CONFIGURE_DEPENDS "*.c" )
+
+# get include files
+file( GLOB INC_FILES CONFIGURE_DEPENDS "*.h" )
+
+# set resource file for MSVC compilers
+if( MSVC )
+  set( RESOURCE_FILE ${EXE_NAME}.rc )
+endif()
+
+# add executable
+add_executable( ${EXE_NAME} ${SRC_FILES} ${INC_FILES} ${RESOURCE_FILE} )
+set_target_properties( ${EXE_NAME} PROPERTIES RELEASE_POSTFIX        "${CMAKE_RELEASE_POSTFIX}" )
+set_target_properties( ${EXE_NAME} PROPERTIES DEBUG_POSTFIX          "${CMAKE_DEBUG_POSTFIX}" )
+set_target_properties( ${EXE_NAME} PROPERTIES RELWITHDEBINFO_POSTFIX "${CMAKE_RELWITHDEBINFO_POSTFIX}" )
+set_target_properties( ${EXE_NAME} PROPERTIES MINSIZEREL_POSTFIX     "${CMAKE_MINSIZEREL_POSTFIX}" )
+if( VVENC_LIBRARY_ONLY )
+  set_target_properties( ${EXE_NAME} PROPERTIES EXCLUDE_FROM_ALL TRUE )
+endif()
+
+target_compile_options( ${EXE_NAME} PRIVATE $<$<OR:$<C_COMPILER_ID:Clang>,$<C_COMPILER_ID:AppleClang>>:-Wall>
+                                            $<$<C_COMPILER_ID:GNU>:-Wall -fdiagnostics-show-option>
+                                            $<$<C_COMPILER_ID:MSVC>:/W4 /WX /wd4100 /wd4244 /wd4996>)
+
+# The single-file runtime linkage checks use dladdr()/lstat(), provided by libc on
+# POSIX systems; no extra library has to be linked here.
+target_link_libraries( ${EXE_NAME} Threads::Threads vvenc )
+
+# When the versioned shared-library layout is disabled - the recommended setting on
+# file systems that cannot follow the symlink chain - the consumer test additionally
+# asserts the single-file runtime linkage contract.  Keyed on the build configuration
+# instead of a platform macro so that the check states a portable contract.
+if( NOT VVENC_ENABLE_VERSIONED_SONAME )
+  target_compile_definitions( ${EXE_NAME} PRIVATE VVENC_UNVERSIONED_SONAME=1 )
+endif()
+
+# example: place header files in different folders
+source_group( "Header Files"   FILES ${INC_FILES} )
+source_group( "Resource Files" FILES ${RESOURCE_FILE} )
+
+
+# set the folder where to place the projects
+set_target_properties( ${EXE_NAME}  PROPERTIES FOLDER test )
