--- a/source/Lib/vvenc/CMakeLists.txt
+++ b/source/Lib/vvenc/CMakeLists.txt
@@ -204,15 +204,27 @@
 else()
   target_link_libraries( ${LIB_NAME} PRIVATE Threads::Threads )
 endif()
 
 if( CMAKE_USE_PTHREADS_INIT )
   target_compile_definitions( ${LIB_NAME} PRIVATE HAVE_PTHREADS )
 endif()
 
 # set the folder where to place the projects
 set_target_properties( ${LIB_NAME} PROPERTIES
-                                   VERSION ${PROJECT_VERSION}
-                                   SOVERSION ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}
                                    INSTALL_NAME_DIR ${CMAKE_INSTALL_PREFIX}/lib
                                    MACOSX_RPATH FALSE
                                    FOLDER lib )
+
+# VERSION/SOVERSION make CMake emit a symlink chain next to the real artifact
+# (libvvenc.so -> libvvenc.so.<abi> -> libvvenc.so.<abi>.<patch>).  On
+# HarmonyOS/OHOS the HMDFS file system cannot reliably create or follow those
+# symlinks, so the dynamic loader fails to resolve DT_NEEDED="libvvenc.so.<abi>"
+# and every consumer of the shared library aborts before main().  Omitting both
+# properties (do not set them to an empty string, that yields "libvvenc.so.")
+# keeps a single, unversioned real artifact whose SONAME is "libvvenc.so".
+# See Knowledge-Ref E050 (HMDFS does not follow symlinks) and E092.
+if( VVENC_ENABLE_VERSIONED_SONAME )
+  set_target_properties( ${LIB_NAME} PROPERTIES
+                                     VERSION ${PROJECT_VERSION}
+                                     SOVERSION ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR} )
+endif()
