--- a/vc-dwim.pl	2020-01-05 12:32:08.000000000 +0800
+++ b/vc-dwim.pl	2026-09-21 15:30:39.610673907 +0800
@@ -37,7 +37,16 @@
 
 BEGIN
 {
-  my $perllibdir = $ENV{'perllibdir'} || '@datadir@/@PACKAGE@';
+  my $perllibdir = $ENV{'perllibdir'};
+  if (!defined $perllibdir)
+    {
+      # Relocatable: resolve perl module dir relative to the script itself
+      # (<bindir>/../share/vc-dwim) when the baked-in absolute datadir does
+      # not exist (e.g. Conan package installed to a different prefix).
+      my $selfdir = dirname $0;
+      my $datadir = '@datadir@/@PACKAGE@';
+      $perllibdir = -d $datadir ? $datadir : "$selfdir/../share/@PACKAGE@";
+    }
   unshift @INC, (split '@PATH_SEPARATOR@', $perllibdir);
   unshift @INC, dirname $0; # DELETE_ME upon installation
 
