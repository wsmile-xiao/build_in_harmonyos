--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,120 @@
+cmake_minimum_required(VERSION 3.16)
+project(vprerex LANGUAGES CXX)
+
+# OHOS PC (aarch64) build for vprerex 6.5.1.
+#
+# Replaces the upstream qmake project (vprerex.pro), which hard-codes
+# /usr/include/poppler/qt5, /usr/include/qt5 and `-L/usr/lib64 -lpoppler-qt5`.
+#
+# Qt5 comes from conan qt5-qtbase/5.15.2.2 (Core/Gui/Widgets). The poppler-Qt5
+# binding is supplied by the compatibility shim poppler-qt5.h/.cpp built here
+# on top of the poppler core library shipped by the conan poppler package —
+# the registry poppler is published with ENABLE_QT5=OFF and there is no
+# poppler-qt5 package. See poppler-qt5.h for the API mapping.
+#
+# Qt5 and poppler include/lib/bin directories are injected by conanfile.py
+# (VPREX_QT5_* / VPREX_POPPLER_*) because qt5-qtbase is consumed without
+# CMakeDeps configuration.
+
+set(CMAKE_CXX_STANDARD 14)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_INCLUDE_CURRENT_DIR ON)
+
+set(VPREX_SOURCES
+    documentwidget.cpp
+    main.cpp
+    window.cpp)
+
+# poppler's core headers (used by the poppler-qt5 shim) require C++20+
+# (std::span/std::variant/concepts); poppler itself is built with
+# CMAKE_CXX_STANDARD 23. The upstream vprerex sources only need C++14, so the
+# shim is built as its own static library with the raised standard.
+add_library(vprerex_popplerqt5 STATIC poppler-qt5.cpp)
+set_target_properties(vprerex_popplerqt5 PROPERTIES
+    CXX_STANDARD 23
+    CXX_STANDARD_REQUIRED ON)
+target_include_directories(vprerex_popplerqt5 PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${VPREX_POPPLER_INCLUDE_DIR}
+    ${VPREX_POPPLER_INCLUDE_DIR}/poppler)
+target_include_directories(vprerex_popplerqt5 PRIVATE
+    ${VPREX_QT5_INCLUDE_DIRS})
+
+set(VPREX_MOC_HEADERS
+    documentwidget.h
+    window.h)
+
+# ---- uic: window.ui -> ui_window.h ---------------------------------------
+find_program(VPREX_UIC_EXE uic HINTS "${VPREX_QT5_BIN_DIR}")
+if(NOT VPREX_UIC_EXE)
+    message(FATAL_ERROR "uic not found (looked in VPREX_QT5_BIN_DIR=${VPREX_QT5_BIN_DIR})")
+endif()
+
+set(_ui_out "${CMAKE_CURRENT_BINARY_DIR}/ui_window.h")
+add_custom_command(
+    OUTPUT "${_ui_out}"
+    COMMAND ${CMAKE_COMMAND} -E env
+            "LD_LIBRARY_PATH=${VPREX_QT5_LIB_DIR}"
+            "${VPREX_UIC_EXE}"
+            "${CMAKE_CURRENT_SOURCE_DIR}/window.ui"
+            -o "${_ui_out}"
+    DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/window.ui"
+    COMMENT "uic window.ui")
+
+# ---- moc: Q_OBJECT headers ----------------------------------------------
+find_program(VPREX_MOC_EXE moc HINTS "${VPREX_QT5_BIN_DIR}")
+if(NOT VPREX_MOC_EXE)
+    message(FATAL_ERROR "moc not found (looked in VPREX_QT5_BIN_DIR=${VPREX_QT5_BIN_DIR})")
+endif()
+
+set(_moc_includes
+    "-I${CMAKE_CURRENT_SOURCE_DIR}"
+    "-I${CMAKE_CURRENT_BINARY_DIR}"
+    ${VPREX_QT5_MOC_INCLUDES}
+    "-I${VPREX_POPPLER_INCLUDE_DIR}")
+
+set(_moc_out "")
+foreach(_hdr ${VPREX_MOC_HEADERS})
+    get_filename_component(_base "${_hdr}" NAME_WE)
+    set(_out "${CMAKE_CURRENT_BINARY_DIR}/moc_${_base}.cpp")
+    add_custom_command(
+        OUTPUT "${_out}"
+        COMMAND ${CMAKE_COMMAND} -E env
+                "LD_LIBRARY_PATH=${VPREX_QT5_LIB_DIR}"
+                "${VPREX_MOC_EXE}"
+                ${_moc_includes}
+                "${CMAKE_CURRENT_SOURCE_DIR}/${_hdr}"
+                -o "${_out}"
+        DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${_hdr}"
+        COMMENT "moc ${_hdr}")
+    list(APPEND _moc_out "${_out}")
+endforeach()
+
+add_executable(vprerex ${VPREX_SOURCES} ${_ui_out} ${_moc_out})
+
+target_include_directories(vprerex PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${CMAKE_CURRENT_BINARY_DIR}
+    ${VPREX_QT5_INCLUDE_DIRS}
+    ${VPREX_POPPLER_INCLUDE_DIR}
+    ${VPREX_POPPLER_INCLUDE_DIR}/poppler)
+
+target_link_directories(vprerex PRIVATE
+    ${VPREX_QT5_LIB_DIR}
+    ${VPREX_POPPLER_LIB_DIR})
+
+target_link_libraries(vprerex_popplerqt5 PUBLIC
+    ${VPREX_POPPLER_LIBRARY})
+target_link_directories(vprerex_popplerqt5 PUBLIC
+    ${VPREX_POPPLER_LIB_DIR})
+
+target_link_libraries(vprerex PRIVATE
+    vprerex_popplerqt5
+    Qt5Widgets
+    Qt5Gui
+    Qt5Core)
+
+install(TARGETS vprerex DESTINATION bin)
+install(FILES vprerex.1 DESTINATION share/man/man1)
+install(FILES vprerex.desktop DESTINATION share/applications)
+install(FILES vprerex.png DESTINATION share/icons/hicolor/48x48/apps)
