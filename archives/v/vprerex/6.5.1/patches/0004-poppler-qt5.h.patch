--- /dev/null
+++ b/poppler-qt5.h
@@ -0,0 +1,124 @@
+/****************************************************************************
+** poppler-qt5.h — HarmonyOS PC compatibility shim for the poppler-Qt5
+** bindings used by vprerex.
+**
+** Upstream vprerex includes <poppler-qt5.h> and links -lpoppler-qt5, but the
+** ohpcd conan registry publishes poppler with ENABLE_QT5=OFF (no Qt bindings)
+** and there is no standalone poppler-qt5 package. Enabling the Qt5 binding
+** would require rebuilding the poppler package, which is out of scope for
+** this recipe.
+**
+** This header re-implements the small poppler-qt5 surface that vprerex
+** actually uses (Document / Page / Link / LinkBrowse) on top of the
+** *poppler core* library (libpoppler.so + the headers under include/poppler)
+** that the registry poppler package DOES ship. The implementation lives in
+** poppler-qt5.cpp; the upstream vprerex sources are not modified.
+**
+** API mapping (poppler-qt5 -> poppler core):
+**   Document::load(path)          -> PDFDoc(std::make_unique<GooString>(path))
+**   Document::numPages()          -> PDFDoc::getNumPages()
+**   Document::page(i)             -> PDFDoc::getPage(i+1)
+**   Document::setRenderHint(h)    -> stored, applied as SplashOutputDev
+**                                    font/vector antialiasing flags
+**   Page::renderToImage(xres,yres)-> SplashOutputDev(splashModeXBGR8) +
+**                                    PDFDoc::displayPageSlice() -> QImage
+**                                    (Format_RGB32, native little-endian)
+**   Page::links()                 -> PDFDoc::getLinks(page) -> LinkBrowse
+**                                    (normalised annotation rect + URI)
+**
+** This shim is part of the OHOS adaptation and is GPL-2.0-or-later, like
+** upstream vprerex.
+****************************************************************************/
+
+#ifndef POPPLER_QT5_H
+#define POPPLER_QT5_H
+
+#include <QImage>
+#include <QList>
+#include <QRectF>
+#include <QString>
+
+class QMatrix;
+
+namespace Poppler {
+
+class DocumentData;
+
+/* A link annotation. vprerex casts every link to LinkBrowse and calls
+ * url(); a LinkBrowse is therefore produced for every annotation. */
+class Link
+{
+public:
+    enum LinkType { None, Goto, Execute, Browse, Action, Sound, Movie, Rendition, JavaScript, OCGState, Hide, ResetForm, SubmitForm };
+
+    explicit Link(const QRectF &linkArea) : m_area(linkArea) { }
+    virtual ~Link() { }
+
+    QRectF linkArea() const { return m_area; }
+    virtual QString url() const { return QString(); }
+    virtual LinkType linkType() const { return None; }
+
+private:
+    QRectF m_area;
+};
+
+class LinkBrowse : public Link
+{
+public:
+    LinkBrowse(const QRectF &linkArea, const QString &url)
+        : Link(linkArea), m_url(url) { }
+
+    QString url() const override { return m_url; }
+    LinkType linkType() const override { return Browse; }
+
+private:
+    QString m_url;
+};
+
+class Page
+{
+public:
+    ~Page();
+
+    QImage renderToImage(qreal xres, qreal yres) const;
+    QList<Link *> links() const;
+
+private:
+    friend class Document;
+    Page(DocumentData *doc, int index);
+    Page(const Page &) = delete;
+    Page &operator=(const Page &) = delete;
+
+    DocumentData *m_doc;
+    int m_index;
+};
+
+class Document
+{
+public:
+    enum RenderHint {
+        Antialiasing = 0x00000001,
+        TextAntialiasing = 0x00000002,
+        TextHinting = 0x00000004,
+        TextSlightHinting = 0x00000008
+    };
+
+    static Document *load(const QString &filePath);
+    ~Document();
+
+    Document(const Document &) = delete;
+    Document &operator=(const Document &) = delete;
+
+    int numPages() const;
+    Page *page(int index) const;
+    void setRenderHint(RenderHint hint, bool on = true);
+    bool isLocked() const { return false; }
+
+private:
+    explicit Document(DocumentData *d);
+    DocumentData *d;
+};
+
+} // namespace Poppler
+
+#endif // POPPLER_QT5_H
