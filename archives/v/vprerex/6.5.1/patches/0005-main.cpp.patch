     printBanner();
 
+    // OHOS adaptation: real GUI-path self-test. Unlike --check-pdf (which only
+    // drives the poppler-qt5 shim), this constructs the *real* application
+    // chain - QApplication (initialising the Qt platform plugin, offscreen on
+    // a headless worker), the real Window (ui_window.h) and the real
+    // DocumentWidget (QLabel) - loads a PDF through the shim, runs the Qt
+    // event loop and grabs the rendered widget tree, so the adaptation can be
+    // verified end-to-end on a machine with no display.
+    if ( Argv.contains("--check-gui") )
+    {
+      const int idx = Argv.indexOf("--check-gui");
+      if ( idx + 1 >= Argv.size() )
+      {
+        puts ("Error: --check-gui requires a PDF file argument.");
+        return 2;
+      }
+      const QString pdfPath = Argv.at(idx + 1);
+      Window gui;
+      gui.setFileNames(pdfPath, QString());
+      gui.show();
+      for ( int i = 0; i < 10; ++i )
+        QApplication::processEvents();
+
+      const QPixmap shot = gui.grab();
+      const int pages = gui.pageSpinBox->maximum();
+      const QImage img = shot.toImage();
+      long long nonwhite = 0;
+      long long rgbsum = 0;
+      for ( int y = 0; y < img.height(); ++y )
+        for ( int x = 0; x < img.width(); ++x )
+        {
+          const QRgb p = img.pixel(x, y);
+          rgbsum += qRed(p) + qGreen(p) + qBlue(p);
+          if ( qRed(p) != 255 || qGreen(p) != 255 || qBlue(p) != 255 )
+            ++nonwhite;
+        }
+      printf ("vprerex-gui: pages=%d\n", pages);
+      printf ("vprerex-gui: grab=%dx%d\n", shot.width(), shot.height());
+      printf ("vprerex-gui: pixels=%lld nonwhite=%lld rgbsum=%lld\n",
+              (long long) img.width() * img.height(), nonwhite, rgbsum);
+      if ( shot.isNull() || shot.width() <= 0 || shot.height() <= 0 )
+      {
+        puts ("vprerex-gui: FAIL widget grab is empty");
+        return 1;
+      }
+      printf ("vprerex-gui: ok pages=%d grab=%dx%d nonwhite=%lld\n",
+              pages, shot.width(), shot.height(), nonwhite);
+      return 0;
+    }
+
