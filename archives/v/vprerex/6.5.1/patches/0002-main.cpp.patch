+// Headless verification of the poppler-qt5 compatibility shim: load a PDF
+// through the shim, render every page and report the extracted links, so
+// test_package can validate the adaptation on a machine without a display.
+static int checkPdf(const QString &path)
+{
+  Poppler::Document *doc = Poppler::Document::load(path);
+  if ( doc == 0 )
+  {
+    printf ("vprerex-check: cannot load %s\n", path.toUtf8().constData());
+    return 1;
+  }
+  doc->setRenderHint(Poppler::Document::Antialiasing);
+  doc->setRenderHint(Poppler::Document::TextAntialiasing);
+
+  const int nPages = doc->numPages();
+  int nLinks = 0;
+  for (int i = 0; i < nPages; ++i)
+  {
+    Poppler::Page *page = doc->page(i);
+    if ( page == 0 )
+    {
+      printf ("vprerex-check: page %d missing\n", i + 1);
+      delete doc;
+      return 1;
+    }
+    const QImage image = page->renderToImage(72.0, 72.0);
+    if ( image.isNull() )
+    {
+      printf ("vprerex-check: page %d render failed\n", i + 1);
+      delete doc;
+      return 1;
+    }
+    printf ("vprerex-check: page=%d image=%dx%d\n", i + 1, image.width(), image.height());
+
+    const QList<Poppler::Link *> links = page->links();
+    for (int j = 0; j < links.size(); ++j)
+    {
+      Poppler::LinkBrowse *browse = static_cast<Poppler::LinkBrowse *>(links.at(j));
+      printf ("vprerex-check: page=%d link=%s\n", i + 1, browse->url().toUtf8().constData());
+      delete links.at(j);
+    }
+    nLinks += links.size();
+  }
+  printf ("vprerex-check: ok pages=%d links=%d\n", nPages, nLinks);
+  delete doc;
+  return 0;
+}
