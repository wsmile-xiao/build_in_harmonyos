From: HarmonyOS PC adaptation team
Subject: [PATCH] Recognize native HarmonyOS AArch64 in bundled GNU config scripts
Source-Commit: volpack_1.0b3.orig.tar.gz (SHA256 dce3d892ad34b2810fc80b0592c7224a4606f8ebfb8206421e24288753f230d7)
Modification-Layer: config.guess/config.sub
Knowledge-Ref: E007

The 2007 config scripts predate both aarch64 and HarmonyOS. Preserve the
actual native platform tuple instead of describing the target as glibc Linux.

--- a/config.guess
+++ b/config.guess
@@ -144,2 +144,5 @@
 case "${UNAME_MACHINE}:${UNAME_SYSTEM}:${UNAME_RELEASE}:${UNAME_VERSION}" in
+    aarch64:HarmonyOS:*:*)
+	echo aarch64-unknown-linux-ohos
+	exit ;;
     *:NetBSD:*:*)
--- a/config.sub
+++ b/config.sub
@@ -120,7 +120,7 @@ case $# in
 # Here we must recognize all the valid KERNEL-OS combinations.
 maybe_os=`echo $1 | sed 's/^\(.*\)-\([^-]*-[^-]*\)$/\2/'`
 case $maybe_os in
-  nto-qnx* | linux-gnu* | linux-dietlibc | linux-newlib* | linux-uclibc* | \
+  nto-qnx* | linux-gnu* | linux-ohos* | linux-dietlibc | linux-newlib* | linux-uclibc* | \
   uclinux-uclibc* | uclinux-gnu* | kfreebsd*-gnu* | knetbsd*-gnu* | netbsd*-gnu* | \
   storm-chaos* | os2-emx* | rtmk-nova*)
     os=-$maybe_os
@@ -1218,6 +1218,6 @@ case $os in
 	      | -udi* | -eabi* | -lites* | -ieee* | -go32* | -aux* \
 	      | -chorusos* | -chorusrdb* \
 	      | -cygwin* | -pe* | -psos* | -moss* | -proelf* | -rtems* \
-	      | -mingw32* | -linux-gnu* | -linux-newlib* | -linux-uclibc* \
+	      | -mingw32* | -linux-gnu* | -linux-ohos* | -linux-newlib* | -linux-uclibc* \
 	      | -uxpv* | -beos* | -mpeix* | -udk* \
 	      | -interix* | -uwin* | -mks* | -rhapsody* | -darwin* | -opened* \
