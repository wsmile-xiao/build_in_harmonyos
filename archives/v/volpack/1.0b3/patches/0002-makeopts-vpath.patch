From: HarmonyOS PC adaptation team
Subject: [PATCH] Resolve makeopts from the source tree for VPATH builds
Source-Commit: volpack_1.0b3.orig.tar.gz (SHA256 dce3d892ad34b2810fc80b0592c7224a4606f8ebfb8206421e24288753f230d7)
Modification-Layer: Makefile.am and generated Makefile.in
Knowledge-Ref: E007

Conan separates source and build trees. The original ./makeopts invocation
only works for an in-tree build. Keep the generated Makefile.in in sync because
the OHOS worker does not have automake installed.

--- a/Makefile.am
+++ b/Makefile.am
@@ -25,5 +25,5 @@
 nodist_libvolpack_la_SOURCES =  $(COMP_SRCS) $(WARP_SRCS)
 
 vp_opts.c: makeopts Makefile
-	./makeopts vp_opts.c $(CFLAGS)
+	$(srcdir)/makeopts vp_opts.c $(CFLAGS)
 
--- a/Makefile.in
+++ b/Makefile.in
@@ -829,6 +829,6 @@
 
 
 vp_opts.c: makeopts Makefile
-	./makeopts vp_opts.c $(CFLAGS)
+	$(srcdir)/makeopts vp_opts.c $(CFLAGS)
 
 $(COMP_SRCS): $(COMP_IN)
