+	IF(NOT VMIME_BUILD_SHARED_LIBRARY)
+		# Static-only build: consumers do not define VMIME_STATIC, so the
+		# shared export header must still exist for #include to resolve.
+		CONFIGURE_FILE(${CMAKE_CURRENT_BINARY_DIR}/export-static.hpp
+			${CMAKE_BINARY_DIR}/src/vmime/export-shared.hpp COPYONLY)
+		LIST(APPEND VMIME_LIBRARY_GENERATED_INCLUDE_FILES "${CMAKE_BINARY_DIR}/src/vmime/export-shared.hpp")
+	ENDIF()
+
 	SET_TARGET_PROPERTIES(
 		${VMIME_LIBRARY_NAME}-static
