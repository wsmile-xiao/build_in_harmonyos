+	// C++11 "magic static" guarantees thread-safe one-time initialization:
+	// the BIO_METHOD is fully populated before it is ever published, so a
+	// concurrent caller can never observe a partially initialized method.
+	// The single allocation intentionally lives for the whole process,
+	// matching the lifetime semantics of the upstream static struct.
+	static BIO_METHOD* const method = []() -> BIO_METHOD* {
+		BIO_METHOD* m = BIO_meth_new(100 | BIO_TYPE_SOURCE_SINK, "vmime::socket glue");
+		if (m == NULL)
+			return NULL;
+
+		BIO_meth_set_write(m, TLSSocket_OpenSSL::bio_write);
+		BIO_meth_set_read(m, TLSSocket_OpenSSL::bio_read);
+		BIO_meth_set_puts(m, TLSSocket_OpenSSL::bio_puts);
+		BIO_meth_set_ctrl(m, TLSSocket_OpenSSL::bio_ctrl);
+		BIO_meth_set_create(m, TLSSocket_OpenSSL::bio_create);
+		BIO_meth_set_destroy(m, TLSSocket_OpenSSL::bio_destroy);
+
+		return m;
+	}();
+	if (method == NULL)
+		throw exceptions::tls_exception("Cannot create custom BIO_METHOD");
+
+	sm_customBIOMethod = method;
+}
 
 
