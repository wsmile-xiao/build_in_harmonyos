diff -ruN /dev/null b/cmake/Platform/HarmonyOS.cmake
--- /dev/null
+++ b/cmake/Platform/HarmonyOS.cmake
@@ -0,0 +1,26 @@
+# Platform/HarmonyOS.cmake
+#
+# CMake platform module for HarmonyOS (OpenHarmony) system.
+# Suppresses "Unknown system" warning and sets system-specific properties.
+#
+# HarmonyOS is a POSIX/Linux-like OS using musl libc and clang compiler.
+# Binary format: ELF, same conventions as Linux for library naming.
+
+set(CMAKE_SYSTEM_NAME HarmonyOS)
+set(CMAKE_SYSTEM_VERSION 1)
+set(CMAKE_SYSTEM_PROCESSOR aarch64)
+
+# HarmonyOS follows POSIX/Linux conventions for binary naming
+set(CMAKE_SHARED_LIBRARY_PREFIX "lib")
+set(CMAKE_SHARED_LIBRARY_SUFFIX ".so")
+set(CMAKE_STATIC_LIBRARY_PREFIX "lib")
+set(CMAKE_STATIC_LIBRARY_SUFFIX ".a")
+set(CMAKE_SHARED_MODULE_PREFIX "lib")
+set(CMAKE_SHARED_MODULE_SUFFIX ".so")
+set(CMAKE_EXECUTABLE_SUFFIX "")
+
+# HarmonyOS supports dlopen() for dynamic loading
+set(CMAKE_DL_LIBS "dl")
+
+# Include Generic as base platform for remaining defaults
+include(Platform/Generic)
