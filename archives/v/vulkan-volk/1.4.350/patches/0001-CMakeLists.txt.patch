diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,10 +1,24 @@
+# Add project cmake modules to search path for Platform/HarmonyOS.cmake
+# This suppresses the "Unknown system" CMake warning when cross-building for HarmonyOS
+# CMAKE_MODULE_PATH must be set before project() so CMakeDetermineSystem can find it
+list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
+
+# Automatically set VK_USE_PLATFORM_OHOS when building for HarmonyOS
+# This enables vulkan/vulkan_ohos.h inclusion through volk.h header-only mode
+# and activates VK_OHOS_surface / VK_OHOS_external_memory in volk.c
+# Uses CMAKE_HOST_SYSTEM_NAME (available before project()) since CMAKE_SYSTEM_NAME
+# is only set during project() call
+if(CMAKE_HOST_SYSTEM_NAME STREQUAL "HarmonyOS")
+    set(VOLK_STATIC_DEFINES "VK_USE_PLATFORM_OHOS")
+endif()
+
 cmake_minimum_required(VERSION 3.5...3.30)
 
 project(volk VERSION
 # VOLK_GENERATE_VERSION
 350
 # VOLK_GENERATE_VERSION
   LANGUAGES C
 )
 
 # CMake 3.12 changes the default behaviour of option() to leave local variables
