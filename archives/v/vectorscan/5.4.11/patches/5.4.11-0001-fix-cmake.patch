diff --git a/cmake/boost.cmake b/cmake/boost.cmake
index 44b4e8b..94b5101 100644
--- a/cmake/boost.cmake
+++ b/cmake/boost.cmake
@@ -1,3 +1,8 @@
-# Various checks related to Boost
+# Boost checks and the OHOS pthread-cancellation workaround
+# Boost 1.84 uses pthread cancellation helpers that are unavailable on
+# OHOS/HarmonyOS; use the dependency's feature-detection escape hatch.
+if (CMAKE_SYSTEM_NAME MATCHES "^(OHOS|HarmonyOS)$")
+    add_compile_definitions(BOOST_SP_NO_PTHREAD_SETCANCELSTATE)
+endif()
 
 set(BOOST_USE_STATIC_LIBS OFF)
