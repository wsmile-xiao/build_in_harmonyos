diff -ruN a/bin/varnishtest/vtc_syslog.c b/bin/varnishtest/vtc_syslog.c
--- a/bin/varnishtest/vtc_syslog.c
+++ b/bin/varnishtest/vtc_syslog.c
@@ -490,21 +490,25 @@
  * Force stop the syslog thread
  */
 
 static void
 syslog_stop(struct syslog_srv *s)
 {
 	void *res;
 
 	CHECK_OBJ_NOTNULL(s, SYSLOG_SRV_MAGIC);
 	vtc_log(s->vl, 2, "Stopping for syslog server");
-	(void)pthread_cancel(s->tp);
+	#ifdef __OHOS__
+		/* pthread_cancel not implemented on OHOS */
+#else
+		(void)pthread_cancel(s->tp);
+#endif
 	PTOK(pthread_join(s->tp, &res));
 	s->tp = 0;
 	s->run = 0;
 }
 
 /**********************************************************************
  * Wait for syslog thread to stop
  */
 
 static void
@@ -570,21 +574,25 @@
 		/* Reset and free */
 		do {
 			PTOK(pthread_mutex_lock(&syslog_mtx));
 			s = VTAILQ_FIRST(&syslogs);
 			CHECK_OBJ_ORNULL(s, SYSLOG_SRV_MAGIC);
 			if (s != NULL)
 				VTAILQ_REMOVE(&syslogs, s, list);
 			PTOK(pthread_mutex_unlock(&syslog_mtx));
 			if (s != NULL) {
 				if (s->run) {
-					(void)pthread_cancel(s->tp);
+					#ifdef __OHOS__
+		/* pthread_cancel not implemented on OHOS */
+#else
+		(void)pthread_cancel(s->tp);
+#endif
 					syslog_wait(s);
 				}
 				if (s->sock >= 0)
 					VUDP_close(&s->sock);
 				syslog_delete(s);
 			}
 		} while (s != NULL);
 		return;
 	}
 
