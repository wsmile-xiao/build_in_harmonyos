diff -ruN a/bin/varnishtest/vtc_server.c b/bin/varnishtest/vtc_server.c
--- a/bin/varnishtest/vtc_server.c
+++ b/bin/varnishtest/vtc_server.c
@@ -388,21 +388,25 @@
  * Force stop the server thread
  */
 
 static void
 server_break(struct server *s)
 {
 	void *res;
 
 	CHECK_OBJ_NOTNULL(s, SERVER_MAGIC);
 	vtc_log(s->vl, 2, "Breaking for server");
-	(void)pthread_cancel(s->tp);
+	#ifdef __OHOS__
+		/* pthread_cancel not implemented on OHOS */
+#else
+		(void)pthread_cancel(s->tp);
+#endif
 	PTOK(pthread_join(s->tp, &res));
 	VTCP_close(&s->sock);
 	s->tp = 0;
 	s->run = 0;
 }
 
 /**********************************************************************
  * Wait for server thread to stop
  */
 
@@ -497,21 +501,25 @@
 		while (1) {
 			PTOK(pthread_mutex_lock(&server_mtx));
 			s = VTAILQ_FIRST(&servers);
 			CHECK_OBJ_ORNULL(s, SERVER_MAGIC);
 			if (s != NULL)
 				VTAILQ_REMOVE(&servers, s, list);
 			PTOK(pthread_mutex_unlock(&server_mtx));
 			if (s == NULL)
 				break;
 			if (s->run) {
-				(void)pthread_cancel(s->tp);
+				#ifdef __OHOS__
+		/* pthread_cancel not implemented on OHOS */
+#else
+		(void)pthread_cancel(s->tp);
+#endif
 				server_wait(s);
 			}
 			if (s->sock >= 0)
 				VTCP_close(&s->sock);
 			server_delete(s);
 		}
 		return;
 	}
 
 	AZ(strcmp(av[0], "server"));
