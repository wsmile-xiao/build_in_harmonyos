--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3,18 +3,29 @@
 
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_EXTENSIONS OFF)
 
 add_library(vosk
   src/language_model.cc
   src/model.cc
   src/recognizer.cc
   src/spk_model.cc
   src/vosk_api.cc
+  src/postprocessor.cc
 )
 
+# Conan delivers Kaldi and the OpenFst NGramFst extension as Conan packages, so
+# the CMake link interface comes from CMakeDeps (kaldi::kaldi /
+# libfstngram::libfstngram) instead of an installed "kaldi-config.cmake"
+# exporting kaldi-base/kaldi-online2/kaldi-rnnlm plus a bare `fstngram` name.
 find_package(kaldi REQUIRED)
-target_link_libraries(vosk PUBLIC kaldi-base kaldi-online2 kaldi-rnnlm fstngram)
+find_package(libfstngram REQUIRED)
+target_link_libraries(vosk PUBLIC kaldi::kaldi libfstngram::libfstngram)
+
+# Upstream sets neither VERSION nor SOVERSION, so the shared library is emitted
+# without DT_SONAME and downstream linkers would record a build-time path in
+# DT_NEEDED.  Emit a plain, relative SONAME instead.
+target_link_options(vosk PRIVATE "-Wl,-soname,libvosk.so")
 
 include(GNUInstallDirs)
 install(TARGETS vosk DESTINATION ${CMAKE_INSTALL_LIBDIR})
 install(FILES src/vosk_api.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
