--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -889,8 +889,26 @@
                                "src/common/memory/*.cc"
                                "src/common/util/*.cc"
                                "src/common/memory/gpu/*.cc"
-                               "src/common/rdma/*.cc"
     )
+    # RDMA/RPC rely on libfabric which v6d only builds on Linux (the whole
+    # libfabric block above is gated on ${CMAKE_SYSTEM_NAME} STREQUAL "Linux").
+    # This OHOS adaptation never builds libfabric, so exclude the RDMA sources
+    # and rpc_client.cc (which wraps the Linux-only RDMA classes) from the
+    # client library. NOTE: file(GLOB ...) always returns ABSOLUTE paths, so we
+    # must filter by basename -- a relative-path list(REMOVE_ITEM ...) would
+    # never match the absolute paths and rpc_client.cc would still be compiled
+    # and fail on the missing <rdma/fi_errno.h>.
+    set(_VINEYARD_EXCLUDED_SRC)
+    foreach(_vf ${CLIENT_SRC_FILES})
+        get_filename_component(_vname "${_vf}" NAME)
+        if(_vname STREQUAL "rpc_client.cc" OR _vname MATCHES "rdma")
+            list(APPEND _VINEYARD_EXCLUDED_SRC ${_vf})
+        endif()
+    endforeach()
+    if(_VINEYARD_EXCLUDED_SRC)
+        list(REMOVE_ITEM CLIENT_SRC_FILES ${_VINEYARD_EXCLUDED_SRC})
+        message(STATUS "vineyard: excluded RDMA/RPC sources from vineyard_client (no libfabric on this platform): ${_VINEYARD_EXCLUDED_SRC}")
+    endif()
     # the vineyard_client can only be a shared library, since the ObjectFactory
     # is a singleton.
     add_library(vineyard_client ${CLIENT_SRC_FILES})
