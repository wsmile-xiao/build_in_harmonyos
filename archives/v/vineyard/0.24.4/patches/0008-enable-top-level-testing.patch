--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -30,6 +30,12 @@
 
 project(vineyard LANGUAGES C CXX VERSION ${VINEYARD_VERSION})
 
+# Enable ctest at the top level so a CTestTestfile.cmake is generated
+# in the root build directory. Upstream only calls enable_testing() inside
+# test/CMakeLists.txt; CMake then generates CTestTestfile.cmake only there,
+# and `ctest` run from the top-level build dir reports 'No tests were found'.
+enable_testing()
+
 option(BUILD_SHARED_LIBS "Build shared libraries" ON)
 option(USE_STATIC_BOOST_LIBS "Build with static-linked boost libraries" OFF)
 option(USE_EXTERNAL_ETCD_LIBS "Build with external etcd-cpp-apiv3 library rather than the submodule one" OFF)
