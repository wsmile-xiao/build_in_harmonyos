--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -44,6 +44,20 @@
         continue()
     endif()
 
+    # The RPC/RDMA unit tests depend on the RPC (rpc_client) and RDMA
+    # (libfabric + src/common/rdma/*) sources which, like the client library,
+    # are only built on Linux. On other platforms (HarmonyOS also defines
+    # __linux__ via its clang toolchain but has no libfabric) gate them out.
+    if(NOT ${CMAKE_SYSTEM_NAME} STREQUAL "Linux")
+        if(testname MATCHES "^(rpc_test|rpc_delete_test|rpc_get_object_test|rdma_test|rdma_blob_perf_test|remote_buffer_test|remote_buffer_with_rdma_test|invalid_connect_test|lru_spill_test|concurrent_lru_spill_test)$")
+            if(NOT DEFINED VINEYARD_TEST_SKIP_RPC_RDMA_INFO)
+                message(STATUS "Skipping RPC/RDMA unit test on non-Linux: " ${testname})
+                set(VINEYARD_TEST_SKIP_RPC_RDMA_INFO TRUE)
+            endif()
+            continue()
+        endif()
+    endif()
+
     message(STATUS "Found unit_test - " ${testname})
     add_test_case(${testname} ${testfile})
 
