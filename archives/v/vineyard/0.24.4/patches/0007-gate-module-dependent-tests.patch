--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -58,6 +58,32 @@
         endif()
     endif()
 
+    # Core-client-only round: only the modules built in this round (vineyard_
+    # client core + common + compression + glog/zstd) are available, and no
+    # vineyardd server is built/started during package build. So only tests
+    # that are (a) compilable with the built headers and (b) self-contained (no
+    # running vineyardd) can actually execute and pass under ctest. Every other
+    # upstream test either pulls in headers from OFF modules (basic/ds -> MPI/
+    # boost, io/io -> BUILD_VINEYARD_IO, server/* -> BUILD_VINEYARD_SERVER,
+    # malloc/* -> BUILD_VINEYARD_MALLOC, boost/process.hpp, DataFrame,
+    # hosseinmoein-dataframe) or requires an ipc_socket to a running vineyardd
+    # (version/custom_vector/concurrent_id core tests), so it cannot pass here.
+    # Build only the core-compilable, self-contained subset and gate the rest;
+    # gated-out tests are accounted as ohos_feature gaps (unbuilt module stack /
+    # no vineyardd server) in the conanfile upstream-test accounting.
+    if(NOT ${CMAKE_SYSTEM_NAME} STREQUAL "Linux")
+        set(VINEYARD_CORE_BUILDABLE_TESTS
+            compressor_test concurrent_memcpy_test signature_test)
+        list(FIND VINEYARD_CORE_BUILDABLE_TESTS ${testname} _core_idx)
+        if(_core_idx EQUAL -1)
+            if(NOT DEFINED VINEYARD_TEST_SKIP_MODULE_ONLY_INFO)
+                message(STATUS "Skipping module/server-dependent unit test: " ${testname})
+                set(VINEYARD_TEST_SKIP_MODULE_ONLY_INFO TRUE)
+            endif()
+            continue()
+        endif()
+    endif()
+
     message(STATUS "Found unit_test - " ${testname})
     add_test_case(${testname} ${testfile})
 
