--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -28,7 +28,15 @@
         target_link_libraries(${testname} PRIVATE ${LIBUNWIND_LIBRARIES})
     endif()
 
-    add_test(${testname} ${testname})
+    # The test executables are EXCLUDE_FROM_ALL (BUILD_VINEYARD_TESTS_ALL=OFF)
+    # with CMAKE_RUNTIME_OUTPUT_DIRECTORY=${PROJECT_BINARY_DIR}/bin, so an
+    # old-style `add_test(name name)` leaves a bare command that ctest cannot
+    # resolve to the built binary and reports every test as "Not Run" (0
+    # assertions actually execute). Use new-style add_test with the TARGET_FILE
+    # generator expression, which yields the absolute path to the linked
+    # executable regardless of EXCLUDE_FROM_ALL / output directory, so ctest
+    # actually launches each unit test and detects its real result.
+    add_test(NAME ${testname} COMMAND $<TARGET_FILE:${testname}>)
     add_dependencies(vineyard_tests ${testname})
 endmacro()
 
