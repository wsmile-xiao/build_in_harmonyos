+      picking->GetFieldAssociation() == vtkDataObject::FIELD_ASSOCIATION_POINTS;
+    cellBO.Program->SetUniformf("glyphPointSize",
+      pointSelection ? 6.0f : static_cast<float>(actor->GetProperty()->GetPointSize()));
+  }
+#endif
 
