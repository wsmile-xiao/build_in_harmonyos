 void vtkBatchedSurfaceLICMapper::AppendOneBufferObject(vtkRenderer* ren, vtkActor* act,
   GLBatchElement* glBatchElement, vtkIdType& voffset, std::vector<unsigned char>& newColors,
   std::vector<float>& newNorms)
 {
   vtkPolyData* poly = glBatchElement->Parent.PolyData;
   vtkDataArray* vectors = this->GetInputArrayToProcess(0, poly);
+#ifndef GL_ES_VERSION_3_0
   if (vectors)
   {
     this->VBOs->AppendDataArray("vecsMC", vectors, VTK_FLOAT);
   }
-
+#else
+  size_t first[PrimitiveEnd];
+  for (int primitive = 0; primitive < PrimitiveEnd; ++primitive)
+  {
+    first[primitive] = this->PrimitiveIndexArrays[primitive].size();
+  }
+#endif
   this->Superclass::AppendOneBufferObject(ren, act, glBatchElement, voffset, newColors, newNorms);
+#ifdef GL_ES_VERSION_3_0
+  if (vectors)
+  {
+    for (int primitive = 0; primitive < PrimitiveEnd; ++primitive)
+    {
+      const auto& indices = this->PrimitiveIndexArrays[primitive];
+      vtkNew<vtkFloatArray> expanded;
+      const int components = vectors->GetNumberOfComponents();
+      expanded->SetNumberOfComponents(components);
+      expanded->SetNumberOfTuples(indices.size() - first[primitive]);
+      for (size_t i = first[primitive]; i < indices.size(); ++i)
+      {
+        for (int c = 0; c < components; ++c)
+        {
+          expanded->SetComponent(i - first[primitive], c, vectors->GetComponent(indices[i], c));
+        }
+      }
+      this->PrimitiveVBOGroup[primitive]->AppendDataArray("vecsMC", expanded, VTK_FLOAT);
+    }
+  }
+#endif
 }
