 // Mapping from DepthTextureCompareFunction values to OpenGL values.
 //------------------------------------------------------------------------------
 VTK_ABI_NAMESPACE_BEGIN
+#ifdef GL_ES_VERSION_3_0
+namespace
+{
+// ES lacks normalized 16-bit texture formats. Convert only the transfer data,
+// preserving the logical scalar type used by GetShiftAndScale and Download.
+class vtkGLESRawTextureInput
+{
+public:
+  vtkGLESRawTextureInput(vtkOpenGLState* state, unsigned int width, unsigned int height,
+    unsigned int depth, int components, int dataType, bool expandRGB,
+    unsigned int& internalFormat, unsigned int& format, unsigned int& uploadType, void*& data)
+    : State(state)
+  {
+    const bool floatStorage = internalFormat == GL_R32F || internalFormat == GL_RG32F ||
+      internalFormat == GL_RGB32F || internalFormat == GL_RGBA32F ||
+      internalFormat == GL_R16F || internalFormat == GL_RG16F ||
+      internalFormat == GL_RGB16F || internalFormat == GL_RGBA16F;
+    const bool normalized16 = floatStorage &&
+      (dataType == VTK_SHORT || dataType == VTK_UNSIGNED_SHORT);
+    const bool rgba = expandRGB && components == 3 &&
+      (dataType == VTK_FLOAT || normalized16) &&
+      (internalFormat == GL_RGB32F || internalFormat == GL_RGBA32F);
+    if (!normalized16 && !rgba)
+    {
+      return;
+    }
+    if (rgba)
+    {
+      internalFormat = GL_RGBA32F;
+      format = GL_RGBA;
+    }
+    uploadType = GL_FLOAT;
+    if (!data)
+    {
+      return;
+    }
+    GLint unpackBuffer = 0;
+    glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpackBuffer);
+    if (unpackBuffer != 0)
+    {
+      this->Valid = false;
+      return;
+    }
+    for (int i = 0; i < 6; ++i)
+    {
+      glGetIntegerv(this->Names[i], &this->Values[i]);
+    }
+    const size_t rowLength = this->Values[1] ? this->Values[1] : width;
+    const size_t imageHeight = this->Values[2] ? this->Values[2] : height;
+    const size_t first = (static_cast<size_t>(this->Values[5]) * imageHeight + this->Values[3]) *
+        rowLength + this->Values[4];
+    const int outputComponents = rgba ? 4 : components;
+    this->Pixels.resize(static_cast<size_t>(width) * height * depth * outputComponents);
+    for (size_t z = 0; z < depth; ++z)
+    {
+      for (size_t y = 0; y < height; ++y)
+      {
+        for (size_t x = 0; x < width; ++x)
+        {
+          const size_t source = (first + (z * imageHeight + y) * rowLength + x) * components;
+          const size_t target = ((z * height + y) * width + x) * outputComponents;
+          for (int c = 0; c < components; ++c)
+          {
+            this->Pixels[target + c] = dataType == VTK_UNSIGNED_SHORT
+              ? static_cast<const unsigned short*>(data)[source + c] / 65535.0f
+              : dataType == VTK_SHORT
+              ? std::max(-1.0f, static_cast<const short*>(data)[source + c] / 32767.0f)
+              : static_cast<const float*>(data)[source + c];
+          }
+          if (rgba)
+          {
+            this->Pixels[target + 3] = 1.0f;
+          }
+        }
+      }
+    }
+    for (int i = 0; i < 6; ++i)
+    {
+      this->State->vtkglPixelStorei(this->Names[i], i == 0 ? 1 : 0);
+    }
+    this->Active = true;
+    data = this->Pixels.data();
+  }
+
+  ~vtkGLESRawTextureInput()
+  {
+    if (this->Active)
+    {
+      for (int i = 0; i < 6; ++i)
+      {
+        this->State->vtkglPixelStorei(this->Names[i], this->Values[i]);
+      }
+    }
+  }
+
+  bool Valid = true;
+
+private:
+  vtkOpenGLState* State;
+  bool Active = false;
+  const GLenum Names[6] = { GL_UNPACK_ALIGNMENT, GL_UNPACK_ROW_LENGTH, GL_UNPACK_IMAGE_HEIGHT,
+    GL_UNPACK_SKIP_ROWS, GL_UNPACK_SKIP_PIXELS, GL_UNPACK_SKIP_IMAGES };
+  GLint Values[6] = {};
+  std::vector<float> Pixels;
+};
+}
