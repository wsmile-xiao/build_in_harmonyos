diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,33 @@
+#!/bin/sh
+# voro++ configure wrapper for OpenHarmony clean-verify compatibility
+# This script modifies config.mk based on --prefix and environment variables.
+# voro++ uses a custom Makefile + config.mk system (no autotools).
+
+PREFIX="/storage/Users/currentUser/usr/local"
+
+# Parse arguments
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            ;;
+        *)
+            # Ignore other arguments
+            ;;
+    esac
+done
+
+# Update config.mk with the new PREFIX and compiler settings
+CXX="${CXX:-clang++}"
+CFLAGS="${CFLAGS:--Wall -ansi -pedantic -O2 -fPIC}"
+
+sed -i "s|^CXX=.*|CXX=${CXX}|" config.mk
+sed -i "s|^CFLAGS=.*|CFLAGS=${CFLAGS}|" config.mk
+sed -i "s|^PREFIX=.*|PREFIX=${PREFIX}|" config.mk
+
+echo "Configuration complete:"
+echo "  CXX=${CXX}"
+echo "  CFLAGS=${CFLAGS}"
+echo "  PREFIX=${PREFIX}"
+echo ""
+echo "Now run 'make' to build voro++."
