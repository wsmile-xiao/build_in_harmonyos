diff -ruN a/src/forkpty_ohos.h b/src/forkpty_ohos.h
--- a/src/forkpty_ohos.h
+++ b/src/forkpty_ohos.h
@@ -0,0 +1,27 @@
+/*
+ * forkpty_ohos.h - OpenHarmony pty functions implementation
+ * Provides openpty() and forkpty() using /dev/ptmx
+ * Required because OpenHarmony lacks <pty.h> and libutil
+ * 
+ * Copyright (c) 2024, OpenHarmony PC Developer
+ * BSD-2-Clause License
+ */
+#ifndef _FORKPTY_OHOS_H_
+#define _FORKPTY_OHOS_H_
+
+#ifdef __OHOS__
+
+#include <sys/types.h>
+#include <termios.h>
+
+/* openpty - open a pseudo-terminal pair using /dev/ptmx */
+int openpty(int *amaster, int *aslave, char *name,
+            const struct termios *termp, const struct winsize *winp);
+
+/* forkpty - fork with new pseudo-terminal as controlling tty */
+pid_t forkpty(int *amaster, char *name,
+              const struct termios *termp, const struct winsize *winp);
+
+#endif /* __OHOS__ */
+
+#endif /* _FORKPTY_OHOS_H_ */
