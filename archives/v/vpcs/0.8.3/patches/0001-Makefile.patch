diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -0,0 +1,15 @@
+# Top-level Makefile for vpcs on OpenHarmony
+# Delegates to src/Makefile.ohos
+
+.PHONY: all install clean
+
+PREFIX?=/storage/Users/currentUser/usr/local
+
+all:
+	cd src && make -f Makefile.ohos CCOPT="" PREFIX=$(PREFIX)
+
+install:
+	cd src && make -f Makefile.ohos CCOPT="" install PREFIX=$(PREFIX) DESTDIR=$(DESTDIR)
+
+clean:
+	cd src && make -f Makefile.ohos CCOPT="" clean
