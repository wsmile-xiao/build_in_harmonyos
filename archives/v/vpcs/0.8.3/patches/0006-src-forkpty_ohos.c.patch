diff -ruN a/src/forkpty_ohos.c b/src/forkpty_ohos.c
--- a/src/forkpty_ohos.c
+++ b/src/forkpty_ohos.c
@@ -0,0 +1,135 @@
+/*
+ * forkpty_ohos.c - OpenHarmony compatibility functions
+ * Provides openpty(), forkpty() using /dev/ptmx
+ * Provides pthread_cancel() stub using pthread_kill(SIGTERM)
+ * Required because OpenHarmony lacks <pty.h>, libutil, and pthread_cancel
+ *
+ * Copyright (c) 2024, OpenHarmony PC Developer
+ * BSD-2-Clause License
+ */
+
+#ifdef __OHOS__
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <signal.h>
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <termios.h>
+#include <pthread.h>
+
+#include "forkpty_ohos.h"
+
+/* openpty - open a pseudo-terminal pair using /dev/ptmx */
+int openpty(int *amaster, int *aslave, char *name,
+            const struct termios *termp, const struct winsize *winp)
+{
+    int master, slave;
+    char *pts;
+
+    master = open("/dev/ptmx", O_RDWR | O_NOCTTY);
+    if (master < 0) {
+        return -1;
+    }
+
+    /* Unlock the slave side */
+    int unlock = 0;
+    if (ioctl(master, TIOCSPTLCK, &unlock) < 0) {
+        close(master);
+        return -1;
+    }
+
+    /* Get slave PTY name */
+    pts = ptsname(master);
+    if (pts == NULL) {
+        close(master);
+        return -1;
+    }
+
+    /* Open slave side */
+    slave = open(pts, O_RDWR | O_NOCTTY);
+    if (slave < 0) {
+        close(master);
+        return -1;
+    }
+
+    /* Set terminal attributes if provided */
+    if (termp) {
+        tcsetattr(slave, TCSAFLUSH, termp);
+    }
+
+    /* Set window size if provided */
+    if (winp) {
+        ioctl(slave, TIOCSWINSZ, winp);
+    }
+
+    *amaster = master;
+    *aslave = slave;
+
+    if (name) {
+        strcpy(name, pts);
+    }
+
+    return 0;
+}
+
+/* forkpty - fork with new pseudo-terminal as controlling tty */
+pid_t forkpty(int *amaster, char *name,
+              const struct termios *termp, const struct winsize *winp)
+{
+    int master, slave;
+    pid_t pid;
+
+    if (openpty(&master, &slave, name, termp, winp) < 0) {
+        return -1;
+    }
+
+    pid = fork();
+    if (pid < 0) {
+        close(master);
+        close(slave);
+        return -1;
+    }
+
+    if (pid == 0) {
+        /* Child process */
+        close(master);
+
+        /* Create new session and acquire controlling terminal */
+        setsid();
+        ioctl(slave, TIOCSCTTY, 0);
+
+        /* Redirect standard I/O to slave PTY */
+        dup2(slave, STDIN_FILENO);
+        dup2(slave, STDOUT_FILENO);
+        dup2(slave, STDERR_FILENO);
+
+        if (slave > STDERR_FILENO) {
+            close(slave);
+        }
+
+        return 0;
+    }
+
+    /* Parent process */
+    close(slave);
+    *amaster = master;
+
+    return pid;
+}
+
+/* pthread_cancel stub for OpenHarmony/musl
+ * musl libc does not implement pthread_cancel; this stub uses
+ * pthread_kill(SIGTERM) as a rough equivalent for vpcs usage.
+ * Not a perfect POSIX replacement but sufficient for hv.c thread cancellation.
+ */
+int pthread_cancel(pthread_t thread)
+{
+    return pthread_kill(thread, SIGTERM);
+}
+
+#endif /* __OHOS__ */
