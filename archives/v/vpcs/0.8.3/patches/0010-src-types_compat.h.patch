diff -ruN a/src/types_compat.h b/src/types_compat.h
--- a/src/types_compat.h
+++ b/src/types_compat.h
@@ -0,0 +1,19 @@
+/*
+ * types_compat.h - BSD type compatibility definitions for OpenHarmony
+ * OpenHarmony uses musl libc which does not define u_char, u_short, u_int, u_long
+ * These types are used extensively in vpcs source code
+ *
+ * Copyright (c) 2024, OpenHarmony PC Developer
+ * BSD-2-Clause License
+ */
+#ifndef _TYPES_COMPAT_H_
+#define _TYPES_COMPAT_H_
+
+#ifdef __OHOS__
+typedef unsigned char u_char;
+typedef unsigned short u_short;
+typedef unsigned int u_int;
+typedef unsigned long u_long;
+#endif /* __OHOS__ */
+
+#endif /* _TYPES_COMPAT_H_ */
