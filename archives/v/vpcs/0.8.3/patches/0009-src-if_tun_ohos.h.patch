diff -ruN a/src/if_tun_ohos.h b/src/if_tun_ohos.h
--- a/src/if_tun_ohos.h
+++ b/src/if_tun_ohos.h
@@ -0,0 +1,26 @@
+/*
+ * if_tun_ohos.h - TUN/TAP device constants for OpenHarmony
+ * Provides definitions normally found in <linux/if_tun.h>
+ * Required because OpenHarmony lacks this header
+ *
+ * Copyright (c) 2024, OpenHarmony PC Developer
+ * BSD-2-Clause License
+ */
+#ifndef _IF_TUN_OHOS_H_
+#define _IF_TUN_OHOS_H_
+
+#ifdef __OHOS__
+
+#include <linux/ioctl.h>
+
+/* TUNSETIFF ioctl */
+#define TUNSETIFF _IOW('T', 202, int)
+
+/* Interface flags */
+#define IFF_TUN   0x0001
+#define IFF_TAP   0x0002
+#define IFF_NO_PI 0x1000
+
+#endif /* __OHOS__ */
+
+#endif /* _IF_TUN_OHOS_H_ */
