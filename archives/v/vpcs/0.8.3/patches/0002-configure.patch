diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,20 @@
+#!/bin/sh
+# Dummy configure script for vpcs on OpenHarmony
+# vpcs uses platform-specific Makefiles, not autotools
+# This script accepts standard configure options but does nothing
+# The actual build is done via: make -f src/Makefile.ohos
+
+prefix=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*) prefix="${1#--prefix=}" ;;
+        -h|--help) echo "vpcs configure (dummy)"; exit 0 ;;
+        *) ;;
+    esac
+    shift
+done
+
+echo "vpcs 0.8.3 configure (OpenHarmony wrapper)"
+echo "Build will use: make -f src/Makefile.ohos"
+echo "PREFIX=$prefix"
+exit 0
