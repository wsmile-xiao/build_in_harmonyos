--- /dev/null
+++ b/include/FlexLexer.h
@@ -0,0 +1,189 @@
+// FlexLexer.h - from flex 2.6.4
+
+// C++ interface to flex scanner
+#ifndef __FLEX_LEXER_H
+#define __FLEX_LEXER_H
+
+#ifndef FLEX_STD_NAMESPACE
+#define FLEX_STD_NAMESPACE std
+#endif
+
+namespace FLEX_STD_NAMESPACE {
+    class istream;
+    class ostream;
+}
+
+class FlexLexer {
+public:
+    virtual ~FlexLexer() {}
+
+    virtual const char* YYText() { return yytext; }
+    virtual int YYLeng()    { return yyleng; }
+
+    virtual void switch_streams( FLEX_STD_NAMESPACE::istream* new_in,
+                                 FLEX_STD_NAMESPACE::ostream* new_out = 0 ) = 0;
+
+    virtual int yylex() = 0;
+
+protected:
+    char* yytext;
+    int yyleng;
+};
+
+#endif // __FLEX_LEXER_H
