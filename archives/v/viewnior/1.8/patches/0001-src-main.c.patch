+    /* Headless early --version (HarmonyOS PC): print the version string
+     * before the GOptionContext's gtk_get_option_group(TRUE) opens the
+     * default X display.  Build/CI workers have no X server, so the display
+     * path would otherwise fail with "Cannot open display" before reaching
+     * the version branch (l3afpad/xsane precedent).  The output is identical
+     * to the display path — PACKAGE_STRING, e.g. "viewnior 1.8" — so a
+     * --version invocation still behaves exactly like the upstream binary on
+     * a machine with a display. */
+    {
+        int i;
+        for (i = 1; i < argc; i++)
+            if (strcmp (argv[i], "--version") == 0)
+            {
+                printf ("%s\n", PACKAGE_STRING);
+                return 0;
+            }
+    }
 
