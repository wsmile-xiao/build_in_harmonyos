--- a/configure.ac
+++ b/configure.ac
@@ -3147,28 +3147,34 @@
 AM_CONDITIONAL([HAVE_EGL], [test "${have_egl}" = "yes"])
 
 have_gl="no"
-PKG_CHECK_MODULES([GL], [gl], [
-  have_gl="yes"
-], [
-  AC_MSG_CHECKING([for OpenGL])
-  AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[
+AS_IF([test "${SYS}" != "linux" -o -n "${with_ohos_gl}"], [
+  PKG_CHECK_MODULES([GL], [gl], [
+    have_gl="yes"
+  ], [
+    AC_MSG_CHECKING([for OpenGL])
+    AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[
 #ifdef _WIN32
 # include <GL/glew.h>
 #endif
 #include <GL/gl.h>
 ]], [
     [int t0 = GL_TEXTURE0;]])
-  ], [
-    GL_CFLAGS=""
-    have_gl="yes"
-    AS_IF([test "${SYS}" != "mingw32"], [
-      GL_LIBS="-lGL"
+    ], [
+      GL_CFLAGS=""
+      have_gl="yes"
+      AS_IF([test "${SYS}" != "mingw32"], [
+        GL_LIBS="-lGL"
     ], [
       GL_LIBS="-lopengl32"
     ])
   ])
   AC_MSG_RESULT([${have_gl}])
 ])
+])
+dnl On OHOS the classic OpenGL stack (GLX, fixed-function pipeline) is not
+dnl available (libGLv4.so only exports a GLES-compatible symbol subset), so
+dnl the GL probe above is skipped entirely and have_gl stays "no".
+
 AM_CONDITIONAL([HAVE_GL], [test "${have_gl}" = "yes"])
 AS_IF([test "${have_gl}" = "yes"], [
   AC_DEFINE([HAVE_GL], 1, [Defined if having OpenGL])
