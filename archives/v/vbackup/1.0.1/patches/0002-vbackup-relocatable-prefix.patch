diff -ru a/scripts/bin/common.in b/scripts/bin/common.in
--- a/scripts/bin/common.in	2016-02-07 06:21:09.000000000 +0800
+++ b/scripts/bin/common.in	2026-09-19 03:59:21.479435156 +0800
@@ -21,17 +21,20 @@
 #
 
 # autoconf directories
-prefix="@prefix@"
-exec_prefix="@exec_prefix@"
-bindir="@bindir@"
-sbindir="@sbindir@"
-libexecdir="@libexecdir@"
-localstatedir="@localstatedir@"
-libdir="@libdir@"
-sysconfdir="@sysconfdir@"
-datarootdir="@datarootdir@"
-datadir="@datadir@"
-mybindir="@mybindir@"
+# OHOS adaptation: this library is sourced by the entry scripts; derive the
+# installation layout from this file's own location (<prefix>/
+# share/vbackup/helpers/common) so the package stays relocatable.
+prefix=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd -P)
+exec_prefix="$prefix"
+bindir="$prefix/bin"
+sbindir="$prefix/sbin"
+libexecdir="$prefix/libexec"
+localstatedir="$prefix/var"
+libdir="$prefix/lib"
+sysconfdir="$prefix/etc"
+datarootdir="$prefix/share"
+datadir="$datarootdir"
+mybindir="$datadir/vbackup/bin"
 myscriptdir="@myscriptdir@"
 myconfdir="@myconfdir@"
 myhelperdir="@myhelperdir@"
diff -ru a/scripts/bin/run.in b/scripts/bin/run.in
--- a/scripts/bin/run.in	2016-02-07 06:21:09.000000000 +0800
+++ b/scripts/bin/run.in	2026-09-19 03:59:21.479435156 +0800
@@ -22,10 +22,14 @@
 # The second argument is the configuration file
 #
 
-prefix="@prefix@"
-datarootdir="@datarootdir@"
-datadir="@datadir@"
-myhelperdir="@myhelperdir@"
+# OHOS adaptation: resolve the installation prefix from the script location
+# (relocatable package) instead of a compile-time absolute path.  This script
+# lives at <prefix>/share/vbackup/{bin,scripts}/, so the prefix is three
+# levels up from $0.
+prefix=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
+datarootdir="$prefix/share"
+datadir="$datarootdir"
+myhelperdir="$datarootdir/vbackup/helpers"
 
 . $myhelperdir/common
 
