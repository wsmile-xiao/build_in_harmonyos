diff -ruN a/libvips/iofuncs/meson.build b/libvips/iofuncs/meson.build
--- a/libvips/iofuncs/meson.build
+++ b/libvips/iofuncs/meson.build
@@ -37,27 +37,48 @@
     'window.c',
     'vector.cpp',
     'system.c',
     'buffer.c',
 )
 
 iofuncs_headers = files(
     'sink.h',
 )
 
-vipsmarshal = gnome.genmarshal(
-    'vipsmarshal',
-    prefix: 'vips',
-    sources: 'vipsmarshal.list',
+# HarmonyOS: Use python3 to call glib-genmarshal since scripts cannot be executed directly
+# Get python3 from pymod imported in root meson.build
+py3 = pymod.find_installation('python3')
+vipsmarshal_h = custom_target('vipsmarshal_h',
+    output: 'vipsmarshal.h',
+    input: 'vipsmarshal.list',
+    command: [py3, '/storage/Users/currentUser/usr/local/bin/glib-genmarshal',
+              '--quiet', '--prefix', 'vips',
+              '--output', '@OUTPUT@',
+              '--header', '@INPUT@',
+              '--pragma-once'],
+    capture: false,
+)
+
+vipsmarshal_c = custom_target('vipsmarshal_c',
+    output: 'vipsmarshal.c',
+    input: 'vipsmarshal.list',
+    depends: vipsmarshal_h,
+    command: [py3, '/storage/Users/currentUser/usr/local/bin/glib-genmarshal',
+              '--quiet', '--prefix', 'vips',
+              '--output', '@OUTPUT@',
+              '--body', '@INPUT@',
+              '--include-header', 'vipsmarshal.h'],
+    capture: false,
 )
 
 libvips_sources += iofuncs_sources
 
 iofuncs_lib = static_library('iofuncs',
     iofuncs_sources,
     iofuncs_headers,
-    vipsmarshal,
+    vipsmarshal_h,
+    vipsmarshal_c,
     dependencies: libvips_deps,
     gnu_symbol_visibility: 'hidden',
 )
 
 libvips_components += iofuncs_lib
