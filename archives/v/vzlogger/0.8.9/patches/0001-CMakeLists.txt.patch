 if(ENABLE_GOOGLEMOCK)
 
   include(FindGTest)
-  if (NOT GTest_FOUND AND GIT_FOUND) 
+  if(GTest_FOUND)
+    # conan GTestConfig (config mode) exposes the include dir via the
+    # imported target rather than the GTest_INCLUDE_DIRS variable, so
+    # propagate it to the whole project (tests + mocks need gtest/gmock.h).
+    get_target_property(_gtest_inc GTest::gtest INTERFACE_INCLUDE_DIRECTORIES)
+    if(_gtest_inc)
+      include_directories(${_gtest_inc})
+    endif()
+    unset(_gtest_inc)
+  endif()
+  if (NOT GTest_FOUND AND GIT_FOUND)
     # Download and unpack googletest at configure time
     configure_file(gtest/CMakeLists.txt.in gtest-download/CMakeLists.txt)
     execute_process(COMMAND ${CMAKE_COMMAND} -G "${CMAKE_GENERATOR}" .
     RESULT_VARIABLE result
     WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/gtest-download )
     if(result)
         message(FATAL_ERROR "CMake step for googletest failed: ${result}")
     endif()
     execute_process(COMMAND ${CMAKE_COMMAND} --build .
     RESULT_VARIABLE result
     WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/gtest-download )
     if(result)
         message(FATAL_ERROR "Build step for googletest failed: ${result}")
     endif()
-  
+
     # Prevent overriding the parent project's compiler/linker
     # settings on Windows
     set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
-  
+
     # Add googletest directly to our build. This defines
     # the gtest and gtest_main targets.
     add_subdirectory(${CMAKE_CURRENT_BINARY_DIR}/gtest-src
                      ${CMAKE_CURRENT_BINARY_DIR}/gtest-build
                      EXCLUDE_FROM_ALL)
