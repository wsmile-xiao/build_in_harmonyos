diff -ruN a/cmake/VISPModule.cmake b/cmake/VISPModule.cmake
--- a/cmake/VISPModule.cmake
+++ b/cmake/VISPModule.cmake
@@ -858,28 +858,39 @@
   if(NOT (CMAKE_VERSION VERSION_LESS "3.11.0"))  # https://gitlab.kitware.com/cmake/cmake/-/merge_requests/1264 : eliminates "Cannot specify compile definitions for imported target" error message
     target_include_directories(${the_module} SYSTEM INTERFACE "$<BUILD_INTERFACE:${inc}>")
   else()
     set_target_properties(${the_module} PROPERTIES
         INTERFACE_INCLUDE_DIRECTORIES "$<BUILD_INTERFACE:${inc}>"
         INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "$<BUILD_INTERFACE:${inc}>"
     )
   endif()
 
   # For dynamic link numbering convenions
-  if(NOT ANDROID)
-    # Android SDK build scripts can include only .so files into final .apk
-    # As result we should not set version properties for Android
+  # OHOS: Always set VERSION and SOVERSION to ensure proper SONAME in shared libraries
+  # This prevents IMPORTED_NO_SONAME in generated export files
+  set_target_properties(${the_module} PROPERTIES
+    VERSION ${VISP_VERSION}
+    SOVERSION ${VISP_SOVERSION}
+  )
+
+  # OHOS: On HarmonyOS, CMake may not automatically set SONAME even with VERSION/SOVERSION
+  # Force SONAME using linker options
+  if(BUILD_SHARED_LIBS AND NOT WIN32)
+    # Get the library output name
+    get_target_property(lib_output_name ${the_module} OUTPUT_NAME)
+    # Add linker flag to set SONAME (ensure lib prefix is included)
     set_target_properties(${the_module} PROPERTIES
-      VERSION ${VISP_VERSION}
-      SOVERSION ${VISP_SOVERSION}
+      LINK_FLAGS "-Wl,-soname,lib${lib_output_name}.so.${VISP_SOVERSION}"
     )
   endif()
+
+
 
   if((NOT DEFINED VISP_MODULE_TYPE AND BUILD_SHARED_LIBS)
       OR (DEFINED VISP_MODULE_TYPE AND VISP_MODULE_TYPE STREQUAL SHARED))
     set_target_properties(${the_module} PROPERTIES COMPILE_DEFINITIONS visp_EXPORTS)
     set_target_properties(${the_module} PROPERTIES DEFINE_SYMBOL visp_EXPORTS)
   endif()
 
   if(MSVC)
     if(CMAKE_CROSSCOMPILING)
       set_target_properties(${the_module} PROPERTIES LINK_FLAGS "/NODEFAULTLIB:secchk")
