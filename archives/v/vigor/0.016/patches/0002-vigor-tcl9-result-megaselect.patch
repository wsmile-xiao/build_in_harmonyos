-		if (exceptfds && FD_ISSET(fd, exceptfds))
-			mask |= TK_EXCEPTION;
-		if (mask)
-			Tk_CreateFileHandler(fd, mask, tk_file_ev,
-					     (ClientData) NULL);
-	}
-
-	waiting_for_input = 1;
-	if (timeout) {
