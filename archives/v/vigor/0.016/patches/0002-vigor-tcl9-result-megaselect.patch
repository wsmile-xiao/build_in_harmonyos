-			cookie = Tk_CreateTimerHandler(ms, tk_timer_ev,
-						       (ClientData) NULL);
-			while (waiting_for_input)
-				Tk_DoOneEvent(0);
-			Tk_DeleteTimerHandler(cookie);
-		} else {
-			/* A zero timeout */
-			while (Tk_DoOneEvent(TK_DONT_WAIT)
-			       && waiting_for_input)
