  * This section handles the select overrides.  In particular, we need
  * to replace select, so that Tk's timers can run.  This is used for
  * animation and the random popups.
+ *
+ * The upstream implementation drives Tk's X11-style event loop here
+ * (Tk_DoOneEvent / Tk_CreateFileHandler / Tk_CreateTimerHandler /
+ * Tk_DeleteTimerHandler / Tk_DeleteFileHandler).  The HarmonyOS Tk
+ * port (native-window based) does not expose these event-loop
+ * primitives, so we fall back to plain select() and keep only the
+ * "vigor_randomness" Tcl evaluation that runs the GUI popup timer.
  */
 
-static int waiting_for_input;
-
-static void
-tk_file_ev(clientData, mask)
-	ClientData clientData;
-	int mask;
-{
-	waiting_for_input = 0;
-}
-
-static void
-tk_timer_ev(clientData)
-	ClientData clientData;
-{
-	waiting_for_input = 0;
-}
-
 int
 mega_select(nfds, readfds, writefds, exceptfds, timeout)
 	int nfds;
