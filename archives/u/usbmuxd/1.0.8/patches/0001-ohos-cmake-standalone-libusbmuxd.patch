diff --git a/daemon/CMakeLists.txt b/daemon/CMakeLists.txt
--- a/daemon/CMakeLists.txt
+++ b/daemon/CMakeLists.txt
@@ -1,3 +1,8 @@
+# OHOS adaptation: libusb (USB) and libplist (PLIST) are provided as Conan
+# packages (CMakeDeps). Their find modules probe the build host via
+# pkg-config, which cannot see the cross sysroot; the recipe injects
+# USB_INCLUDE_DIRS / USB_LIBRARY / PLIST_INCLUDE_DIRS / PLIST_LIBRARY (and
+# PLIST_FOUND/USB_FOUND) through the CMake toolchain cache instead.
 find_package(USB REQUIRED)
 include_directories(${USB_INCLUDE_DIRS})
 include_directories(${OPT_INCLUDES})
