diff --git a/tools/CMakeLists.txt b/tools/CMakeLists.txt
--- a/tools/CMakeLists.txt
+++ b/tools/CMakeLists.txt
@@ -1,11 +1,23 @@
+# OHOS adaptation: iproxy links against the standalone libusbmuxd package
+# (libusbmuxd-2.0, published on the ohpcd registry) instead of the in-tree
+# libusbmuxd shared library (which is not built on this platform; it also
+# relies on pthread_cancel, not declared in the OHOS musl sysroot).
+#
+# USBMUXD_INCLUDE_DIRS / USBMUXD_LIBRARIES are injected by the Conan recipe
+# (CMakeDeps of libusbmuxd/2.0.2) — no pkg-config lookup is needed here.
+#
+# The three private sock_stuff helpers iproxy uses (create_socket,
+# recv_buf_timeout, send_buf) are not exported by the standalone
+# libusbmuxd-2.0 library, so the in-tree libusbmuxd/sock_stuff.c is
+# compiled directly into iproxy.
+include_directories (${USBMUXD_INCLUDE_DIRS})
 include_directories (${CMAKE_SOURCE_DIR}/libusbmuxd)
-link_directories (${CMAKE_BINARY_DIR}/libusbmuxd)
 
-add_executable(iproxy iproxy.c)
+add_executable(iproxy iproxy.c ${CMAKE_SOURCE_DIR}/libusbmuxd/sock_stuff.c)
 if(WIN32)
-  target_link_libraries(iproxy libusbmuxd pthread ws2_32)
+  target_link_libraries(iproxy ${USBMUXD_LIBRARIES} ${OPT_LIBS} pthread ws2_32)
 else()
-  target_link_libraries(iproxy libusbmuxd pthread)
+  target_link_libraries(iproxy ${USBMUXD_LIBRARIES} ${OPT_LIBS} pthread)
 endif()
 
 install(TARGETS iproxy RUNTIME DESTINATION bin)
