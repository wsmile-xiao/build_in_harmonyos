 cmake_minimum_required(VERSION 3.16)
 
 project(
   utfcpp20
   VERSION 0.3
   DESCRIPTION "A C++ 20 library for working with Unicode strings"
   LANGUAGES CXX)
 
 add_subdirectory(src)
 
-enable_testing()
-add_subdirectory(tests)
+# The upstream test suite pulls nemtrif/ftest via FetchContent (ftest is not
+# published in the Conan registry and the build environment has no network
+# access). Gate it behind an explicit option; pass -DUTF20_BUILD_TESTS=ON
