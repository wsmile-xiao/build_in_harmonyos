-                               PRIVATE ${CMAKE_BINARY_DIR} ${CMOCKA_INCLUDE_DIR})
+                               PRIVATE ${CMAKE_BINARY_DIR})
     set_property(
         TEST
             test_uwrap_disabled
         PROPERTY
             ENVIRONMENT LD_PRELOAD=${UID_WRAPPER_LOCATION})
+
+    if (CMAKE_SYSTEM_NAME MATCHES "HarmonyOS")
+        # OHOS seccomp terminates a real (non-wrapped) privileged-id syscall
+        # from an unprivileged process with SIGSYS instead of returning
+        # -1/EPERM, so the "wrapper disabled" expectation cannot hold.
+        # Keep the target built but exclude it from the test registration.
+        set_tests_properties(test_uwrap_disabled PROPERTIES DISABLED TRUE)
+    endif ()
 endif ()
 
