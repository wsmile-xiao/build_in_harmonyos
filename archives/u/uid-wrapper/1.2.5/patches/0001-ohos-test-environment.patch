@@ -136,8 +140,13 @@
                 LINK_LIBRARIES ${TESTSUITE_LIBRARIES} uwrap_enabled
                 LINK_OPTIONS ${DEFAULT_LINK_FLAGS})
 target_include_directories(test_uwrap_enabled
-                           PRIVATE ${CMAKE_BINARY_DIR} ${CMOCKA_INCLUDE_DIR})
-add_cmocka_test_environment(test_uwrap_enabled)
+                           PRIVATE ${CMAKE_BINARY_DIR})
+# On musl-based systems like OHOS the dynamic loader does not search the
+# executable directory for DT_NEEDED libraries, so the helper library
+# libuwrap_enabled.so placed next to the test binary is not found. Point
+# LD_LIBRARY_PATH at the build tree to make it resolvable.
+add_cmocka_test_environment(test_uwrap_enabled
+                            LD_LIBRARY_PATH=${CMAKE_CURRENT_BINARY_DIR})
 
