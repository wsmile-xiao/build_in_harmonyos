diff --git a/doc/CMakeLists.txt b/doc/CMakeLists.txt
--- a/doc/CMakeLists.txt
+++ b/doc/CMakeLists.txt
@@ -1,3 +1,10 @@
+# Upstream never defines MAN_INSTALL_DIR, which makes the man page land
+# in a root-level /man1 directory for in-prefix installs. Default it to
+# the standard share/man location instead.
+if (NOT MAN_INSTALL_DIR)
+    set(MAN_INSTALL_DIR "${CMAKE_INSTALL_DATADIR}/man")
+endif ()
+
 install(FILES
             uid_wrapper.1
         DESTINATION
