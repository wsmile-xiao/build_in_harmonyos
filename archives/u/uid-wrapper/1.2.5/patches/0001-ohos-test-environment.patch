-set(TESTSUITE_LIBRARIES ${UWRAP_REQUIRED_LIBRARIES} ${CMOCKA_LIBRARY})
+# The Conan CMakeDeps generator exposes cmocka as the imported target
+# cmocka::cmocka and does not define the legacy uppercase CMOCKA_LIBRARY /
+# CMOCKA_INCLUDE_DIR variables that upstream expects from a FindCMOCKA
+# module. Use the target so include dirs and the library travel together.
+set(TESTSUITE_LIBRARIES ${UWRAP_REQUIRED_LIBRARIES} cmocka::cmocka)
 
