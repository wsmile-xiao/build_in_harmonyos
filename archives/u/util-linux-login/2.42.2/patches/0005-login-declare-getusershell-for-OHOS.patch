+ * on OHOS, so declare the prototypes here (matching the stubs lib/shells.c
+ * provides) to avoid implicit-int declarations that are hard errors. */
+char *getusershell(void);
+void  setusershell(void);
+void  endusershell(void);
+#endif
 #if defined (HAVE_LIBECONF) && defined (USE_VENDORDIR)
 # include "shells.h"
 #endif
