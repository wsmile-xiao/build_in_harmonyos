 #include "uhub.h"
+#include <signal.h>
 
 #ifdef POSIX_THREAD_SUPPORT
 
 struct pthread_data
 {
 	pthread_t handle;
 };
+
+/*
+ * OHOS 的 libc 未提供 pthread_cancel()（sysroot 头文件无声明，libc.so 中亦无该符号），
+ * 这里用 SIGUSR1 + pthread_exit() 实现等价的“中断目标线程”语义：
+ * 信号经 pthread_kill() 定向投递到目标线程，处理函数在该线程上下文中执行并退出该线程。
+ */
+static pthread_once_t uhub_cancel_once = PTHREAD_ONCE_INIT;
+
+static void uhub_thread_cancel_handler(int signum)
+{
+	(void) signum;
+	pthread_exit(NULL);
+}
+
+static void uhub_thread_install_cancel_handler(void)
+{
+	struct sigaction sa;
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_handler = uhub_thread_cancel_handler;
+	sigemptyset(&sa.sa_mask);
+	sa.sa_flags = 0;
+	sigaction(SIGUSR1, &sa, NULL);
+}
 
 void uhub_mutex_init(uhub_mutex_t* mutex)
 {
 	pthread_mutex_init(mutex, NULL);
 }
 
 void uhub_mutex_destroy(uhub_mutex_t* mutex)
 {
 	pthread_mutex_destroy(mutex);
 }
