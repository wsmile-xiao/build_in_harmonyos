+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+/* OpenBSD-derived: allocate nmemb * size, refusing to hand back a size that
+ * wrapped.  Some libcs ship neither a declaration nor a symbol for it, and
+ * this header is included by both the C and the C++ units.  
+ */
+static inline void *
+uv_reallocarray(void *ptr, size_t nmemb, size_t size) {
+	if(nmemb && size && nmemb > SIZE_MAX / size) {
+		errno = ENOMEM;
+		return NULL;
+	}
+	return realloc(ptr, nmemb * size);
+}
+#define reallocarray uv_reallocarray
 
 
