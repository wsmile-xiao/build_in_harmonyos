index 0000000..1fed13800eeb94111eafbc19ecbb02c2218b71e1
--- /dev/null
+++ b/ohos_compat.h
@@ -0,0 +1,72 @@
+/*
+ * ohos_compat.h — HarmonyOS/OpenHarmony (musl) BSD-style type compatibility.
+ * E113: OHOS system headers lack BSD-style typedefs (u_int/u_long/u_char/
+ * u_short/caddr_t) which POSIX does not mandate.
+ * Guard with platform detection per E113: inject globally via -include.
+ */
+#if !defined(__FreeBSD__) && !defined(__APPLE__) && !defined(_WIN32) && !defined(_OHOS_COMPAT_H_)
+#define _OHOS_COMPAT_H_
+
+/* musl guards full struct ifreq (net/if.h) and BSD typedefs behind
+ * _GNU_SOURCE/_DEFAULT_SOURCE; usrsctp builds with -std=c99 -pedantic
+ * which suppresses them. Enable before any system header. */
+#if !defined(_GNU_SOURCE)
+#define _GNU_SOURCE 1
+#endif
+
+#include <sys/types.h>
+#include <sys/time.h>
+
+#ifndef u_int
+typedef unsigned int u_int;
+#endif
+#ifndef u_long
+typedef unsigned long u_long;
+#endif
+#ifndef u_short
+typedef unsigned short u_short;
+#endif
+#ifndef u_char
+typedef unsigned char u_char;
+#endif
+#ifndef caddr_t
+typedef char *caddr_t;
+#endif
+
+#include <net/if.h>
+#ifndef IFNAMSIZ
+#define IFNAMSIZ 16
+#endif
+
+/* timercmp/timeradd/timersub are GNU extensions absent from musl */
+#ifndef timeradd
+#define timeradd(a, b, result)                                                 \
+	do {                                                                   \
+		(result)->tv_sec = (a)->tv_sec + (b)->tv_sec;                  \
+		(result)->tv_usec = (a)->tv_usec + (b)->tv_usec;               \
+		if ((result)->tv_usec >= 1000000) {                            \
+			(result)->tv_sec++;                                    \
+			(result)->tv_usec -= 1000000;                          \
+		}                                                              \
+	} while (0)
+#endif
+#ifndef timersub
+#define timersub(a, b, result)                                                 \
+	do {                                                                   \
+		(result)->tv_sec = (a)->tv_sec - (b)->tv_sec;                  \
+		(result)->tv_usec = (a)->tv_usec - (b)->tv_usec;               \
+		if ((result)->tv_usec < 0) {                                   \
+			(result)->tv_sec--;                                    \
+			(result)->tv_usec += 1000000;                          \
+		}                                                              \
+	} while (0)
+#endif
+/* timercmp must be defined after timersub (it expands to timersub) */
+#ifndef timercmp
+#define timercmp(a, b, CMP)                                                    \
+	(((a)->tv_sec == (b)->tv_sec)                                           \
+		 ? ((a)->tv_usec CMP(b)->tv_usec)                               \
+		 : ((a)->tv_sec CMP(b)->tv_sec))
+#endif
+
+#endif /* !__FreeBSD__ && !__APPLE__ && !_WIN32 && !_OHOS_COMPAT_H_ */
