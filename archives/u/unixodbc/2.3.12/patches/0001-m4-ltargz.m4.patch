diff -ruN a/m4/ltargz.m4 b/m4/ltargz.m4
--- a/m4/ltargz.m4
+++ b/m4/ltargz.m4
@@ -1,22 +1,25 @@
 # Portability macros for glibc argz.                    -*- Autoconf -*-
 #
-#   Copyright (C) 2004-2007, 2011-2015 Free Software Foundation, Inc.
+#   Copyright (C) 2004-2007, 2011-2019, 2021-2022 Free Software
