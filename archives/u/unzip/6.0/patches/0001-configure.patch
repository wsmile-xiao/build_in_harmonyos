diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,78 @@
+#!/bin/sh
+# Configure wrapper for unzip 6.0
+# This script calls unix/configure and generates a Makefile wrapper
+
+echo "unzip configure wrapper: calling unix/configure"
+
+# Parse arguments
+PREFIX=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*)
+            PREFIX="${1#--prefix=}"
+            ;;
+        *)
+            # Ignore other arguments
+            ;;
+    esac
+    shift
+done
+
+# Set default prefix if not specified
+if [ -z "$PREFIX" ]; then
+    PREFIX="/usr/local"
+fi
+
+# Set default compiler
+CC=${CC:-clang}
+CFLAGS=${CFLAGS:-}
+IZ_BZIP2=${IZ_BZIP2:-}
+
+echo "Using prefix: $PREFIX"
+echo "Using CC: $CC"
+
+# Call unix/configure
+if [ -d unix ] && [ -f unix/configure ]; then
+    cd unix
+    sh ./configure "$CC" "$CFLAGS" "$IZ_BZIP2"
+    cd ..
+    if [ $? -ne 0 ]; then
+        echo "Error: unix/configure failed"
+        exit 1
+    fi
+    echo "unix/configure completed successfully"
+    
+    # Generate Makefile wrapper with DESTDIR support for clean-verify
+    # Note: unzip's unix/Makefile doesn't support DESTDIR, so we handle it manually
+    cat > Makefile << 'MAKE_EOF'
+# Makefile wrapper generated by configure for unzip 6.0
+# Supports DESTDIR for clean-verify compatibility
+
+.PHONY: all clean install
+
+all:
+	@echo "Building unzip..."
+	$(MAKE) -f unix/Makefile generic CC=clang
+
+clean:
+	$(MAKE) -f unix/Makefile clean
+
+install:
+	@echo "Installing unzip..."
+	@if [ -n "$(DESTDIR)" ]; then \
+		echo "DESTDIR mode: installing to $(DESTDIR)$(PREFIX)"; \
+		mkdir -p $(DESTDIR)$(PREFIX)/bin $(DESTDIR)$(PREFIX)/man/man1; \
+		cp unzip funzip unzipsfx $(DESTDIR)$(PREFIX)/bin/; \
+		cp man/*.1 $(DESTDIR)$(PREFIX)/man/man1/; \
+	else \
+		echo "Normal mode: installing to $(PREFIX)"; \
+		$(MAKE) -f unix/Makefile install prefix=$(PREFIX) BINDIR=$(PREFIX)/bin MANDIR=$(PREFIX)/man/man1; \
+	fi
+MAKE_EOF
+    
+    echo "Generated Makefile wrapper with prefix=$PREFIX and DESTDIR support"
+    exit 0
+else
+    echo "Error: unix/configure not found"
+    exit 1
+fi
