--- a/unzoo.c
+++ b/unzoo.c
@@ -244,6 +244,17 @@
 *H
 */
 #include        <stdio.h>
+/* OHOS/musl port: the SYS_IS_UNIX branch below calls these but includes
+** none of them, so every call was an implicit declaration.  GCC 14+
+** treats -Wimplicit-function-declaration as an error and C23 removed
+** the construct entirely, so the package does not build on a modern
+** compiler at all. */
+#include        <stdlib.h>
+#include        <string.h>
+#include        <sys/types.h>
+#include        <sys/stat.h>
+#include        <utime.h>
+#include        <unistd.h>
 
 
 /****************************************************************************
@@ -613,8 +624,14 @@
 **  members with the correct time as stored in the archive.
 */
 #ifdef  SYS_IS_UNIX
-unsigned int   Secs [2];
-#define SETF_TIME(patl,secs)    (Secs[0]=Secs[1]=(secs),!utime((patl),Secs))
+/* OHOS/musl port: this used to hand 'unsigned int Secs[2]' straight to
+** utime(), relying on the ancient V7 prototype.  POSIX utime() takes a
+** struct utimbuf { time_t actime, modtime; }, and time_t is 64 bits on
+** LP64 targets (x86_64, aarch64/OHOS) while unsigned int is 32, so
+** utime() read 16 bytes out of an 8-byte object and stored a bogus
+** timestamp.  Use the real struct, as the OS2_EMX branch below does. */
+struct  utimbuf Secs;
+#define SETF_TIME(patl,secs)    (Secs.actime=Secs.modtime=(secs),!utime((patl),&Secs))
 #endif
 #ifdef  SYS_IS_DOS_DJGPP
 unsigned long   Secs [2];
