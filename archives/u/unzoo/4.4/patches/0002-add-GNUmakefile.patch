--- /dev/null
+++ b/GNUmakefile
@@ -0,0 +1,29 @@
+# GNU make build for unzoo.
+#
+# unzoo 4.4 is distributed as a single C file (unzoo.c) with the build
+# instruction written in its header:
+#
+#     cc  -o unzoo  -DSYS_IS_UNIX   -O  unzoo.c
+#     (add -DSYS_HAS_MKDIR if your UNIX has mkdir(2))
+#
+# There is no makefile, configure script or CMake in the distribution, so this
+# file provides the equivalent GNU make rule.
+#
+# CC/CPPFLAGS/CFLAGS/LDFLAGS come from the Conan toolchain environment; the
+# defaults below only apply when building by hand.
+
+CC ?= cc
+CFLAGS ?= -O2
+
+PROG = unzoo
+DEFS = -DSYS_IS_UNIX -DSYS_HAS_MKDIR
+
+all: $(PROG)
+
+$(PROG): unzoo.c
+	$(CC) $(CPPFLAGS) $(DEFS) $(CFLAGS) -o $@ unzoo.c $(LDFLAGS)
+
+clean:
+	rm -f $(PROG)
+
+.PHONY: all clean
