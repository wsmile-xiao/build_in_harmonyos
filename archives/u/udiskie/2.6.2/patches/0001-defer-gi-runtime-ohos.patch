+"""udiskie — removable disk automounter based on udisks2."""
+
 __version__ = '2.6.2'
+
+
+def __getattr__(name):
+    """Lazily import udiskie sub-modules (PEP 562).
+
+    Keeps `import udiskie` free of the gi (PyGObject) runtime so that
+    `udiskie --version` / `udiskie --help` work on OHOS even when the gi C
+    extension or the GLib/Gio typelibs cannot be loaded (see udiskie/cli.py).
+    """
+    if name.startswith('_'):
+        raise AttributeError(
+            'module {!r} has no attribute {!r}'.format(__name__, name))
+    import importlib
+    try:
+        return importlib.import_module('{}.{}'.format(__name__, name))
+    except ImportError:
+        raise AttributeError(
+            'module {!r} has no attribute {!r}'.format(__name__, name)) from None
