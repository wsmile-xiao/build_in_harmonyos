--- /dev/null
+++ b/GNUmakefile
@@ -0,0 +1,27 @@
+# GNU make build for unlzx.
+#
+# unlzx 1.1 is distributed as a bare C file (unlzx.c.gz on Aminet); the only
+# build instruction upstream gives is a comment at the top of the source:
+#
+#     /* Compile with: gcc unlzx.c -ounlzx -O6 */
+#
+# There is no makefile, no configure script and no CMake in the distribution,
+# so this file provides the equivalent GNU make rule.
+#
+# CC/CPPFLAGS/CFLAGS/LDFLAGS come from the Conan toolchain environment; the
+# defaults below only apply when building by hand.
+
+CC ?= cc
+CFLAGS ?= -O2
+
+PROG = unlzx
+
+all: $(PROG)
+
+$(PROG): unlzx.c
+	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ unlzx.c $(LDFLAGS)
+
+clean:
+	rm -f $(PROG)
+
+.PHONY: all clean
