+	}
+	if (written < 0 || (size_t) written >= sizeof (file_path_buf)) {
+		/* TMPDIR unset, snprintf() error, or path too long: fall back to /tmp. */
+		(void) snprintf(file_path_buf, sizeof (file_path_buf), "/tmp/cwgen_args_test.txt");
+	}
+	file_path = file_path_buf;
