diff --git a/test/Test/HUnit.hs b/test/Test/HUnit.hs
new file mode 100644
index 0000000..ef0b602
--- /dev/null
+++ b/test/Test/HUnit.hs
@@ -0,0 +1,62 @@
+module Test.HUnit
+  ( Test,
+    test,
+    (~:),
+    (~=?),
+    runTestTTAndExit
+  )
+where
+
+import Control.Exception (SomeException, try)
+import System.Exit (exitFailure, exitSuccess)
+
+data Test
+  = TestCase String (IO ())
+  | TestList [Test]
+
+test :: [Test] -> Test
+test = TestList
+
+infixr 0 ~:
+(~:) :: String -> Test -> Test
+label ~: TestCase _ action = TestCase label action
+label ~: TestList tests = TestCase label (runAll tests)
+
+infix 1 ~=?
+(~=?) :: (Eq a, Show a) => a -> a -> Test
+expected ~=? actual =
+  TestCase "" $
+    if actual == expected
+      then pure ()
+      else fail ("expected: " ++ show expected ++ "\n but got: " ++ show actual)
+
+runTestTTAndExit :: Test -> IO ()
+runTestTTAndExit tests = do
+  failures <- run tests
+  if failures == 0
+    then exitSuccess
+    else exitFailure
+
+run :: Test -> IO Int
+run (TestList tests) = sum <$> mapM run tests
+run (TestCase label action) = do
+  result <- try action
+  case result of
+    Right () -> do
+      putStrLn ("PASS: " ++ displayLabel label)
+      pure 0
+    Left e -> do
+      putStrLn ("FAIL: " ++ displayLabel label)
+      putStrLn (show (e :: SomeException))
+      pure 1
+
+runAll :: [Test] -> IO ()
+runAll tests = do
+  failures <- run (TestList tests)
+  if failures == 0
+    then pure ()
+    else fail (show failures ++ " nested test(s) failed")
+
+displayLabel :: String -> String
+displayLabel "" = "<unnamed>"
+displayLabel label = label
