--- a/undertime
+++ b/undertime
@@ -802,7 +802,22 @@ def parse_date_dateparser(date, local_zone):
     try:
         import dateparser
     except ImportError:
-        return False
+        # OHOS CI 沙箱（HNP python）无法加载 dateparser 依赖的 regex
+        # C 扩展时，回退到上游已依赖的纯 Python python-dateutil。
+        # astimezone(local_zone) 对齐 dateparser 的
+        # settings TIMEZONE=local_zone 语义（带偏移输入统一转本地时区）。
+        from dateutil import parser as _du
+        try:
+            parsed = _du.parse(date, fuzzy=False)
+        except (ValueError, OverflowError):
+            return False
+        if parsed is None:
+            return False
+        if parsed.tzinfo is None:
+            parsed = parsed.replace(tzinfo=local_zone)
+        else:
+            parsed = parsed.astimezone(local_zone)
+        return parsed
     return dateparser.parse(
         date,
         settings={"TIMEZONE": str(local_zone), "RETURN_AS_TIMEZONE_AWARE": True},
