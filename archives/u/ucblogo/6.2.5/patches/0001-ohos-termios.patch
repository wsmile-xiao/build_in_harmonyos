--- a/term.c
+++ b/term.c
@@ -33,6 +33,10 @@
 #include <console.h>
 #endif
 
+#ifdef HAVE_TERMIOS_H
+#include <termios.h>
+#include <sys/ioctl.h>
+#else
 #ifdef HAVE_TERMIO_H
 #ifdef HAVE_WX
 #include <termios.h>
@@ -44,6 +48,7 @@
 #include <sgtty.h>
 #endif
 #endif
+#endif
 
 #undef TRUE
 #undef FALSE
@@ -81,6 +86,9 @@
 char so_arr[40];
 char se_arr[40];
 
+#ifdef HAVE_TERMIOS_H
+struct termios tty_cooked, tty_cbreak;
+#else
 #ifdef HAVE_TERMIO_H
 struct termio tty_cooked, tty_cbreak;
 #else
@@ -88,6 +96,7 @@
 struct sgttyb tty_cooked, tty_cbreak;
 #endif
 #endif
+#endif
 
 int interactive, tty_charmode;
 
@@ -137,6 +146,13 @@
 #endif /* WIN32 */
 #else
     if (interactive) {
+#ifdef HAVE_TERMIOS_H
+	ioctl(0,TCGETS,(char *)(&tty_cooked));
+	tty_cbreak = tty_cooked;
+	tty_cbreak.c_cc[VMIN] = '\01';
+	tty_cbreak.c_cc[VTIME] = '\0';
+	tty_cbreak.c_lflag &= ~(ECHO|ICANON);
+#else
 #ifdef HAVE_TERMIO_H
 	ioctl(0,TCGETA,(char *)(&tty_cooked));
 	tty_cbreak = tty_cooked;
@@ -149,6 +165,7 @@
 	tty_cbreak.sg_flags |= CBREAK;
 	tty_cbreak.sg_flags &= ~ECHO;
 #endif
+#endif
     }
     tty_charmode = 0;
 
@@ -200,11 +217,15 @@
 void charmode_on() {
 #ifdef unix
     if ((readstream == stdin) && interactive && !tty_charmode) {
+#ifdef HAVE_TERMIOS_H
+	ioctl(0,TCSETS,(char *)(&tty_cbreak));
+#else
 #ifdef HAVE_TERMIO_H
 	ioctl(0,TCSETA,(char *)(&tty_cbreak));
 #else /* !HAVE_TERMIO_H */
 	ioctl(0,TIOCSETP,(char *)(&tty_cbreak));
 #endif /* HAVE_TERMIO_H */
+#endif
 	tty_charmode++;
     }
 #endif /* unix */
@@ -216,11 +237,15 @@
 void charmode_off() {
 #ifdef unix
     if (tty_charmode) {
+#ifdef HAVE_TERMIOS_H
+	ioctl(0,TCSETS,(char *)(&tty_cooked));
+#else
 #ifdef HAVE_TERMIO_H
 	ioctl(0,TCSETA,(char *)(&tty_cooked));
 #else /* !HAVE_TERMIO_H */
 	ioctl(0,TIOCSETP,(char *)(&tty_cooked));
 #endif /* HAVE_TERMIO_H */
+#endif
 	tty_charmode = 0;
     }
 #endif /* unix */
