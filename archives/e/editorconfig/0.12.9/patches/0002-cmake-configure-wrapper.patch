diff --git a/configure b/configure
new file mode 100755
--- /dev/null
+++ b/configure
@@ -0,0 +1,33 @@
+#!/bin/sh
+# CMake configure wrapper for clean-verify
+# This script wraps cmake for projects that don't have a ./configure script
+
+set -e
+
+# Parse common configure arguments
+PREFIX=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*)
+            PREFIX="${1#--prefix=}"
+            ;;
+        *)
+            # Pass other arguments to cmake
+            shift
+            ;;
+    esac
+done
+
+# Set default prefix if not specified
+if [ -z "$PREFIX" ]; then
+    PREFIX="$HOME/usr/local"
+fi
+
+# Create build directory
+mkdir -p build
+cd build
+
+# Run cmake with PCRE2 paths
+cmake \
+    -DCMAKE_INSTALL_PREFIX="$PREFIX" \
+    -DBUILD_DOCUMENTATION=OFF \
+    -DBUILD_STATICALLY_LINKED_EXE=ON \
+    -DPCRE2_INCLUDE_DIR="$PREFIX/include" \
+    -DPCRE2_LIBRARY_RELEASE="$PREFIX/lib/libpcre2-8.a" \
+    ..