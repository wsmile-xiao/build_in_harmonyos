diff -ruN a/exp_tty.c b/exp_tty.c
--- a/exp_tty.c
+++ b/exp_tty.c
@@ -315,0 +315,15 @@
+/* Resolve the stty binary path:
+ *   1. Use EXP_STTY environment variable if set.
+ *   2. Fall back to compile-time STTY_BIN.
+ *   3. If the resolved path does not exist, return NULL (skip stty).
+ */
+static const char *
+get_stty_bin(void)
+{
+    const char *env = getenv("EXP_STTY");
+    if (env && env[0] != '\0') {
+        return env;
+    }
+    return STTY_BIN;
+}
+
@@ -329 +344,8 @@
-	Tcl_AppendStringsToObj(cmdObj,STTY_BIN,(char *)0);
+
+	const char *stty_bin = get_stty_bin();
+	if (stty_bin == NULL || access(stty_bin, X_OK) != 0) {
+	    /* stty binary not available - skip stty initialization */
+	    Tcl_DecrRefCount(cmdObj);
+	    return TCL_OK;
+	}
+	Tcl_AppendStringsToObj(cmdObj,stty_bin,(char *)0);
