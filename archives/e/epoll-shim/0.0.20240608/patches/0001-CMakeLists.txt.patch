--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,6 +1,23 @@
 cmake_minimum_required(VERSION 3.14)
 project(epoll-shim LANGUAGES C)
 
+include(CheckSymbolExists)
+check_symbol_exists(pthread_setcancelstate "pthread.h" HAVE_PTHREAD_SETCANCELSTATE)
+check_symbol_exists(dlinfo "dlfcn.h" HAVE_DLINFO)
+
+# OHOS: the dynamic linker does not resolve $ORIGIN in RPATH (E007/HMDFS limitation).
+# Use absolute build directory paths so test binaries find libmicroatf-c.so.
+set(CMAKE_SKIP_BUILD_RPATH FALSE)
+set(CMAKE_BUILD_WITH_INSTALL_RPATH FALSE)
+set(CMAKE_INSTALL_RPATH "$ORIGIN")
+# OHOS: the dynamic linker does not resolve relative NEEDED paths or $ORIGIN.
+# Route shared libs to a single output directory and use -Wl,-rpath with
+# absolute paths + --disable-new-dtags (DT_RPATH) so test binaries find them.
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
+set(_build_libdir "${CMAKE_BINARY_DIR}/lib")
+set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -Wl,--disable-new-dtags -Wl,-rpath,${_build_libdir} -L${_build_libdir}")
+set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,--disable-new-dtags -Wl,-rpath,${_build_libdir}")
+
 option(BUILD_SHARED_LIBS "build libepoll-shim as shared lib" ON)
 option(ENABLE_COMPILER_WARNINGS "enable compiler warnings" OFF)
 
@@ -30,6 +47,16 @@
   add_definitions(-Derrno_t=int)
 endif()
 
+# OHOS (HarmonyOS) provides the same epoll/eventfd/timerfd/signalfd
+# syscalls as Linux (it defines __linux__), so treat it as Linux-like:
+# use header-only INTERFACE libraries that pass through to the native
+# kernel implementation instead of the kqueue-based shim.
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+  set(_IS_LINUX_LIKE TRUE)
+else()
+  set(_IS_LINUX_LIKE FALSE)
+endif()
+
 add_subdirectory(src)
 
 if(PROJECT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
@@ -43,7 +70,7 @@
     add_subdirectory(test)
   endif()
 
-  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+  if(_IS_LINUX_LIKE)
     return()
   endif()
 
