--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -179,22 +179,34 @@
   set(EC_SRC ${EC_SRC} missing/basename.c)
 endif()
 
 if(NOT HAVE_STRNDUP)
   set(EC_SRC ${EC_SRC} missing/strndup.c)
 endif()
 
 if(NOT HAVE_GETOPT_LONG AND NOT HAVE_GETOPT_H)
   set(EC_SRC ${EC_SRC} missing/getopt.c)
 endif()
 
-add_library(lib_ettercap SHARED ${EC_SRC})
+# OHOS: pthread_cancel and related functions not in libc.so
+if(OS_LINUX AND ${CMAKE_SYSTEM_NAME} MATCHES "HarmonyOS")
+    set(EC_SRC ${EC_SRC} ohos_pthread_cancel.c)
+endif()
+
+add_library(lib_ettercap STATIC ${EC_SRC})
+if(OS_LINUX AND ${CMAKE_SYSTEM_NAME} MATCHES "HarmonyOS")
+    # pthread_cancel is a no-op stub (ohos_pthread_cancel.c); pthread_join
+    # after a no-op cancel would block forever on a joinable thread. Use
+    # upstream's BROKEN_PTHREAD_JOIN to skip the join — threads are reaped
+    # by the runtime on process exit.
+    target_compile_definitions(lib_ettercap PRIVATE BROKEN_PTHREAD_JOIN)
+endif()
 add_dependencies(lib_ettercap libnet)
 target_link_libraries(lib_ettercap ec_interfaces ${EC_LIBS})
 
 if(CURL_FOUND)
   target_link_libraries(lib_ettercap ${CURL_LIBRARY})
 endif()
 
 if(NOT LIBRARY_BUILD)
   add_subdirectory(interfaces)
   include_directories(interfaces/daemon interfaces/text)
