 find_package(OpenSSL REQUIRED)
-set(EC_LIBS ${EC_LIBS} ${OPENSSL_LIBRARIES})
-set(EC_INCLUDE ${EC_INCLUDE} ${OPENSSL_INCLUDE_DIR})
+# Handle both CMake FindOpenSSL (OPENSSL_LIBRARIES) and Conan CMakeDeps (openssl_LIBRARIES)
+if(OPENSSL_LIBRARIES)
+    set(EC_LIBS ${EC_LIBS} ${OPENSSL_LIBRARIES})
+    set(EC_INCLUDE ${EC_INCLUDE} ${OPENSSL_INCLUDE_DIR})
+elseif(openssl_LIBRARIES)
+    # Conan CMakeDeps: openssl_LIBRARIES is just names (ssl crypto), need full paths
+    foreach(_lib ${openssl_LIBS_RELEASE})
+        find_library(_OPENSSL_LIB_${_lib} ${_lib} PATHS ${openssl_LIB_DIRS_RELEASE} NO_DEFAULT_PATH)
+        if(_OPENSSL_LIB_${_lib})
+            set(EC_LIBS ${EC_LIBS} ${_OPENSSL_LIB_${_lib}})
+        endif()
+    endforeach()
+    set(EC_INCLUDE ${EC_INCLUDE} ${openssl_INCLUDE_DIRS})
+endif()
 
 find_package(ZLIB REQUIRED)
-set(EC_LIBS ${EC_LIBS} ${ZLIB_LIBRARIES})
-set(EC_INCLUDE ${EC_INCLUDE} ${ZLIB_INCLUDE_DIRS})
+if(ZLIB_LIBRARIES)
+    set(EC_LIBS ${EC_LIBS} ${ZLIB_LIBRARIES})
+    set(EC_INCLUDE ${EC_INCLUDE} ${ZLIB_INCLUDE_DIRS})
+elseif(zlib_LIBRARIES)
+    # Conan CMakeDeps: zlib_LIBRARIES is just names (z), need full paths
+    foreach(_lib ${zlib_LIBS_RELEASE})
+        find_library(_ZLIB_LIB_${_lib} ${_lib} PATHS ${zlib_LIB_DIRS_RELEASE} NO_DEFAULT_PATH)
+        if(_ZLIB_LIB_${_lib})
+            set(EC_LIBS ${EC_LIBS} ${_ZLIB_LIB_${_lib}})
+        endif()
+    endforeach()
+    set(EC_INCLUDE ${EC_INCLUDE} ${zlib_INCLUDE_DIRS})
+endif()
 
