 target_include_directories(EAThread PUBLIC include)
 
 #-------------------------------------------------------------------------------------------
 # Package Dependencies
 #-------------------------------------------------------------------------------------------
-FetchContent_Declare(
-  EABase
-  GIT_REPOSITORY https://github.com/electronicarts/EABase.git
-  GIT_TAG        521cb053d9320636f53226ffc616216cf532f0ef
-  GIT_SUBMODULES "" # This should be temporary until we update the cyclic submodule dependencies in EABase.
-)
-
-FetchContent_MakeAvailable(EABase)
-
-target_link_libraries(EAThread EABase)
+# OHOS adaptation: EABase is provided by the published conan `eabase`
+# package (header-only) instead of a network FetchContent checkout.
+find_package(eabase REQUIRED)
+target_link_libraries(EAThread eabase::eabase)
 
 if(EATHREAD_BUILD_TESTS)
     add_subdirectory(test)
 endif()
+
+#-------------------------------------------------------------------------------------------
+# Feature detection (R8: capability-based adaptation, no platform macros)
+#-------------------------------------------------------------------------------------------
+include(CheckSymbolExists)
+# pthread_setcancelstate — present on glibc; absent from OHOS musl sysroot headers.
+check_symbol_exists(pthread_setcancelstate "pthread.h" EATHREAD_HAVE_PTHREAD_SETCANCELSTATE)
+# pthread_setaffinity_np — GNU extension; absent from OHOS musl. When unavailable the
+# source falls back to the syscall path (same approach as the upstream Android branch).
+check_symbol_exists(pthread_setaffinity_np "pthread.h" EATHREAD_HAVE_PTHREAD_SETAFFINITY_NP)
+if(EATHREAD_HAVE_PTHREAD_SETCANCELSTATE)
+    target_compile_definitions(EAThread PUBLIC EATHREAD_HAVE_PTHREAD_SETCANCELSTATE)
+endif()
+if(EATHREAD_HAVE_PTHREAD_SETAFFINITY_NP)
+    target_compile_definitions(EAThread PUBLIC EATHREAD_HAVE_PTHREAD_SETAFFINITY_NP)
+endif()
+
+#-------------------------------------------------------------------------------------------
+# Installation (upstream has no install rules; required for conan packaging)
+#-------------------------------------------------------------------------------------------
+include(GNUInstallDirs)
+install(TARGETS EAThread
+        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR})
+install(DIRECTORY include/eathread DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
+install(FILES 3RDPARTYLICENSES.TXT LICENSE DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/EAThread)
