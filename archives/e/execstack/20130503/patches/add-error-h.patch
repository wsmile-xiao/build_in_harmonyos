--- /dev/null
+++ b/src/error.h
@@ -0,0 +1,45 @@
+/* error.h - Minimal GNU error.h replacement for musl/OHOS
+ * Provides error() function compatible with GNU libc's error.h
+ * GNU libc provides error.h with error() function; musl libc does not.
+ * This minimal replacement provides the same interface.
+ */
+#ifndef _ERROR_H
+#define _ERROR_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+#include <errno.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+static inline const char *_ohos_program_name(void)
+{
+    return "execstack";
+}
+
+static inline void error(int status, int errnum, const char *format, ...)
+{
+    va_list ap;
+    fflush(stdout);
+    fprintf(stderr, "%s: ", _ohos_program_name());
+    if (format) {
+        va_start(ap, format);
+        vfprintf(stderr, format, ap);
+        va_end(ap);
+    }
+    if (errnum)
+        fprintf(stderr, ": %s", strerror(errnum));
+    fprintf(stderr, "\n");
+    if (status)
+        exit(status);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _ERROR_H */
