+/**
+ * main.h — OHOS 宿主平台模拟 STM32 HAL 层（ee EEPROM Emulation 库适配）
+ *
+ * 本文件为 ee 3.2.2 提供缺失的 STM32 HAL 接口，使 EEPROM 模拟库的
+ * 初始化/格式化/读/写算法可以在 AArch64 OHOS 宿主上真实编译、链接与运行。
+ * Flash 语义由一块内存缓冲区（ee_sim_flash）完整模拟：
+ *   - 擦除 = 整段置 0xFF
+ *   - 编程 = 按半字写入数据
+ *   - 直接寻址读取 = 读取缓冲区字节
+ * 这不是空壳 stub：EE_Write 的写入后逐字节校验、EE_Format 的擦除结果校验
+ * 都会对这块模拟 Flash 产生真实可观察的副作用。
+ */
+#ifndef _MAIN_H_
+#define _MAIN_H_
+
+#include <stdint.h>
+#include <string.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ---- STM32 HAL 基础类型 ---- */
+#define __IO volatile
+
+#ifndef NULL
+#define NULL ((void *)0)
+#endif
+
+/* ---- STM32 MCU 型号选择：F7 → EE_ERASE_SECTOR_NUMBER，且不在 ee.c 重定义 FLASH_SIZE ---- */
+#define STM32F7
+
+/* ---- 模拟 Flash 存储（16 KiB，0xFF 初始态，映射在固定低地址） ---- */
+#define EE_SIM_FLASH_SIZE (16U * 1024U)
+
+/* Flash 基址固定为低地址 0x20000000（见 ee_sim_flash.c 的 mmap 说明），
+   保证 ee 库内部 uint32_t 直接解引用在 64 位宿主上不与 PIE 冲突 */
+#define FLASH_BASE     (0x20000000UL)
+#define FLASH_SIZE     ((uint32_t)EE_SIM_FLASH_SIZE)
+#define FLASH_PAGE_SIZE (1024U)
+#define FLASH_SECTOR_SIZE (1024U)
+
+/* ---- HAL 状态 ---- */
+typedef int32_t HAL_StatusTypeDef;
+#define HAL_OK      ((HAL_StatusTypeDef)0)
+#define HAL_ERROR   ((HAL_StatusTypeDef)1)
+#define HAL_BUSY    ((HAL_StatusTypeDef)2)
+#define HAL_TIMEOUT ((HAL_StatusTypeDef)3)
+
+/* ---- ICACHE（模拟平台无此硬件，定义为未启用） ---- */
+/* 不定义 HAL_ICACHE_MODULE_ENABLED，跳过 ICACHE 调用路径 */
+
+/* ---- Flash 擦除初始化结构（EE_Format 使用） ---- */
+typedef struct
+{
+    uint32_t TypeErase;      /* FLASH_TYPEERASE_PAGES / FLASH_TYPEERASE_SECTORS */
+    uint32_t PageAddress;    /* 待擦除页地址（PAGE_ADDRESS 模式） */
+    uint32_t Page;           /* 待擦除页编号（PAGE_NUMBER 模式） */
+    uint32_t NbPages;        /* 页数 */
+    uint32_t Sector;         /* 待擦除扇区编号（SECTOR 模式） */
+    uint32_t NbSectors;      /* 扇区数 */
+    uint32_t Banks;          /* 存储体编号（仅定义了 FLASH_BANK_1/2 时使用） */
+    uint32_t VoltageRange;   /* 电压范围（仅定义了 FLASH_VOLTAGE_RANGE_3 时使用） */
+} FLASH_EraseInitTypeDef;
+
+#define FLASH_TYPEERASE_PAGES    0x00U
+#define FLASH_TYPEERASE_SECTORS  0x01U
+#define FLASH_VOLTAGE_RANGE_3    0x03U
+
+/* EE_Write 编程宽度取半字路径（FLASH_TYPEPROGRAM_HALFWORD） */
+#define FLASH_TYPEPROGRAM_HALFWORD 0x01U
+
+/* ---- HAL Flash 函数 ---- */
+HAL_StatusTypeDef HAL_FLASH_Unlock(void);
+HAL_StatusTypeDef HAL_FLASH_Lock(void);
+HAL_StatusTypeDef HAL_FLASHEx_Erase(FLASH_EraseInitTypeDef *pEraseInit, uint32_t *PageError);
+HAL_StatusTypeDef HAL_FLASH_Program(uint32_t TypeProgram, uint32_t Address, uint64_t Data);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* _MAIN_H_ */
