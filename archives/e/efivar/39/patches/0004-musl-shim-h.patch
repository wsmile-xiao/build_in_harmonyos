--- a/src/musl_shim.h	1970-01-01 08:00:00.000000000 +0800
+++ b/src/musl_shim.h	2026-08-17 19:00:57.532792656 +0800
@@ -0,0 +1,19 @@
+#ifndef MUSL_SHIM_H
+#define MUSL_SHIM_H
+
+/* Provide declarations for GNU extensions not available in musl libc */
+
+#include <stddef.h>
+
+/* qsort_r - GNU signature */
+void qsort_r(void *base, size_t nmemb, size_t size,
+             int (*compar)(const void *, const void *, void *),
+             void *arg);
+
+/* secure_getenv - HarmonyOS has no setuid/setgid, so getenv is safe */
+#define secure_getenv getenv
+
+/* program_invocation_short_name - glibc extension, musl provides __progname */
+extern const char *program_invocation_short_name;
+
+#endif /* MUSL_SHIM_H */
