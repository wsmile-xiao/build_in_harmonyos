--- a/src/musl_shim.c	1970-01-01 08:00:00.000000000 +0800
+++ b/src/musl_shim.c	2026-09-18 03:05:00.000000000 +0800
@@ -0,0 +1,48 @@
+/* musl_shim.c — Provide GNU extensions for musl libc (HarmonyOS)
+ *
+ * musl libc does not provide these GNU extensions:
+ * - qsort_r: wraps qsort with thread-local context variables
+ * - secure_getenv: HarmonyOS has no setuid/setgid, so getenv is safe (via #define in header)
+ * - program_invocation_short_name: derived from musl's __progname
+ *
+ * Reentrancy note: the qsort_r context is _Thread_local, so concurrent
+ * qsort_r calls on different threads are safe. Nested qsort_r calls on the
+ * SAME thread (a comparator that itself calls qsort_r) would clobber the
+ * context; no such nesting exists in efivar's comparators (secdb/esl-iter
+ * compare plain GUID/data buffers).
+ */
+
+#include <stddef.h>
+#include <stdlib.h>
+
+extern const char *__progname;
+
+static __thread void *_qsort_r_arg;
+static __thread int (*_qsort_r_cmp)(const void *, const void *, void *);
+
+static int _qsort_r_wrapper(const void *a, const void *b)
+{
+    return _qsort_r_cmp(a, b, _qsort_r_arg);
+}
+
+void qsort_r(void *base, size_t nmemb, size_t size,
+             int (*compar)(const void *, const void *, void *),
+             void *arg)
+{
+    _qsort_r_arg = arg;
+    _qsort_r_cmp = compar;
+    qsort(base, nmemb, size, _qsort_r_wrapper);
+}
+
+/* program_invocation_short_name: basename of the running program.
+ * musl provides __progname which is already the basename. */
+const char *program_invocation_short_name = NULL;
+
+/* Constructor to initialize program_invocation_short_name from __progname */
+__attribute__((constructor))
+static void _init_program_invocation_short_name(void)
+{
+    program_invocation_short_name = __progname;
+    if (!program_invocation_short_name)
+        program_invocation_short_name = "unknown";
+}
