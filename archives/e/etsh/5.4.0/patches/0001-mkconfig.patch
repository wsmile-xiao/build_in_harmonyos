--- a/mkconfig
+++ b/mkconfig
@@ -195,21 +195,21 @@
 
 EOI
 
 >$BSDSTYLE_H
 
 case "$UNAME_S" in
 *BSD|Darwin|DragonFly)
 	echo "/* $UNAME_S: No need for _XOPEN_SOURCE or _DEFAULT_SOURCE */" >>$CONFIG_H
 	>>$BSDSTYLE_H
 	;;
-Linux)
+Linux|HarmonyOS)
 	# Check if building on Ubuntu 16.xx or 17.xx.
 	egrep '^(DISTRIB_ID=Ubuntu|DISTRIB_RELEASE=(16\.(04|10)|17\.04))$' /etc/lsb-release 2>/dev/null | wc -l | tr -d ' ' | grep '^2$' >/dev/null
 	if test $? -eq 0 ; then
 		# Ubuntu 16.xx or Ubuntu 17.xx
 		( echo '#define	CONFIG_BROKEN' ; echo ) >>$CONFIG_H
 	fi
 	( echo '#define	CONFIG_LINUX' ; echo ) >>$CONFIG_H
 	echo '#define	_XOPEN_SOURCE	700'   >>$CONFIG_H
 	echo '#define	_DEFAULT_SOURCE'       >>$CONFIG_H
 	echo '#define	_XOPEN_SOURCE	700'   >>$BSDSTYLE_H
