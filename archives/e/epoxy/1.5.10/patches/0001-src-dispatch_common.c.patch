+static bool
+get_dlopen_handle_posix_fallback(void **handle, const char *lib_name, bool exit_on_fail, bool load)
+{
+    if (get_dlopen_handle(handle, lib_name, false, load))
+        return true;
+    const char *fallback = NULL;
+    if (lib_name) {
+        if (0 == strcmp(lib_name, "libEGL.so.1")) fallback = "libEGL.so";
+        else if (0 == strcmp(lib_name, "libGLESv2.so.2")) fallback = "libGLESv2.so";
+        else if (0 == strcmp(lib_name, "libGLESv1_CM.so.1")) fallback = "libGLESv1_CM.so";
+        else if (0 == strcmp(lib_name, "libGL.so.1")) fallback = "libGL.so";
+        else if (0 == strcmp(lib_name, "libOpenGL.so.0")) fallback = "libOpenGL.so";
+    }
+    if (fallback && get_dlopen_handle(handle, fallback, false, load))
+        return true;
+    if (fallback) {
+        if (0 == strcmp(lib_name, "libGL.so.1") || 0 == strcmp(lib_name, "libOpenGL.so.0")) {
+            if (get_dlopen_handle(handle, "libGLESv3.so", false, load)) return true;
+        }
+    }
+    if (exit_on_fail) get_dlopen_handle(handle, lib_name, true, load);
+    return *handle != NULL;
+}
