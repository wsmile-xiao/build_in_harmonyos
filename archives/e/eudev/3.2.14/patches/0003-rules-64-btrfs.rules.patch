diff -ruN a/rules/64-btrfs.rules b/rules/64-btrfs.rules
--- a/rules/64-btrfs.rules
+++ b/rules/64-btrfs.rules
@@ -5,13 +5,13 @@
 ENV{ID_FS_TYPE}!="btrfs", GOTO="btrfs_end"
 ENV{SYSTEMD_READY}=="0", GOTO="btrfs_end"
 
 # let the kernel know about this btrfs filesystem, and check if it is complete
 IMPORT{builtin}="btrfs ready $devnode"
 
 # mark the device as not ready to be used by the system
 ENV{ID_BTRFS_READY}=="0", ENV{SYSTEMD_READY}="0"
 
 # reconsider pending devices in case when multidevice volume awaits
-ENV{ID_BTRFS_READY}=="1", RUN+="/usr/bin/udevadm trigger -s block -p ID_BTRFS_READY=0"
+ENV{ID_BTRFS_READY}=="1", RUN+="/storage/Users/currentUser/usr/local/bin/udevadm trigger -s block -p ID_BTRFS_READY=0"
 
 LABEL="btrfs_end"
