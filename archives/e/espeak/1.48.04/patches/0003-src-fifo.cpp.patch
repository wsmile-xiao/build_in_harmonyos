 void fifo_terminate()
 {
   ENTER("fifo_terminate");
 
+#ifdef __OHOS__
+  // OpenHarmony: pthread_cancel not supported (E051)
+  // Wake thread by posting start semaphore, then join gracefully
+  my_stop_is_required = 1;
+  sem_post(&my_sem_start_is_required);
+  pthread_join(my_thread,NULL);
+#else
   pthread_cancel(my_thread);
   pthread_join(my_thread,NULL);
+#endif
   pthread_mutex_destroy(&my_mutex);
   sem_destroy(&my_sem_start_is_required);
   sem_destroy(&my_sem_stop_is_acknowledged);
 
   init(0); // purge fifo
 }
 
 #endif
