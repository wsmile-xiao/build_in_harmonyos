 //>
 //<event_terminate
 void event_terminate()
 {
 ENTER("event_terminate");
 
 	if (thread_inited)
 	{
+#ifdef __OHOS__
+		// OpenHarmony: pthread_cancel not supported (E051)
+		// Wake thread by posting stop semaphore, then join gracefully
+		sem_post(&my_sem_stop_is_required);
+		pthread_join(my_thread,NULL);
+#else
 		pthread_cancel(my_thread);
 		pthread_join(my_thread,NULL);
+#endif
 		pthread_mutex_destroy(&my_mutex);
 		sem_destroy(&my_sem_start_is_required);
 		sem_destroy(&my_sem_stop_is_required);
 		sem_destroy(&my_sem_stop_is_acknowledged);
 		init(); // purge event
 		thread_inited = 0;
 	}
 }
 
 #endif
