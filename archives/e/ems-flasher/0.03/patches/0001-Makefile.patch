--- a/Makefile
+++ b/Makefile
@@ -1,13 +1,23 @@
 PROG = ems-flasher
 OBJS = ems.o main.o
 
-CFLAGS  = -g -Wall -Werror
-CFLAGS += `pkg-config --cflags libusb-1.0`
+# Allow override via environment (for cross-compilation without pkg-config)
+# Defaults retain pkg-config so native builds still resolve libusb headers/libs
+CFLAGS  ?= -g -Wall -Werror `pkg-config --cflags libusb-1.0`
+LIBS    ?= `pkg-config --libs libusb-1.0`
+LDFLAGS ?=
+
+PREFIX  ?= /usr/local
+DESTDIR ?=
 
 all: $(PROG)
 
 $(PROG): $(OBJS)
-	$(CC) -o $(PROG) $(OBJS) `pkg-config --libs libusb-1.0`
+	$(CC) -o $(PROG) $(OBJS) $(LDFLAGS) $(LIBS)
 
 clean:
 	rm -f $(PROG) $(OBJS)
+
+install: $(PROG)
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	cp $(PROG) $(DESTDIR)$(PREFIX)/bin/
