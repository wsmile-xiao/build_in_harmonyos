+/* ── HarmonyOS (OHOS) adaptations ─────────────────────────────── */
+
+/* OHOS NDK headers do not provide <linux/ip.h>, so struct ip_options (used by
+   the GLIBC_IP_OPTIONS path for IPv4 source-route logging/rejection) is an
+   incomplete type.  Disable that path entirely: undef GLIBC_IP_OPTIONS and
+   define NO_IP_OPTIONS so smtp_in.c skips IP-options handling.  This is a
+   deprecated IPv4 feature; OHOS does not surface IP socket options this way. */
+#undef GLIBC_IP_OPTIONS
+#define NO_IP_OPTIONS
+
+
+/* OHOS libc does not export the traditional global `_res` resolver-state
+   symbol nor the `__res_state()` accessor.  Exim's generic src/os.c uses
+   `return &_res;` in os_get_dns_resolver_res(), which fails to link.
+   Define OS_GET_DNS_RESOLVER_RES so the generic implementation is skipped,
+   and provide our own implementation in os.c-OHOS using a process-wide
+   static struct __res_state (Exim manages a single resolver context). */
+#define OS_GET_DNS_RESOLVER_RES
+
+/* /usr/include/linux/ip.h is not shipped with the OHOS NDK headers, so the
+   MUSL/IP_OPTIONS fudge in Configure-os.h is irrelevant; the OHOS os.h
+   simply does not define GLIBC_IP_OPTIONS (we keep the Linux set of defines
+   above as-is). */

