 	 */
-	fendcore = (line *) sbrk(0);
-	endcore = fendcore - 2;
+	/*
+	 * Modern systems (including musl libc on OHOS) ship a sbrk() that
+	 * reports the current break (sbrk(0) works) but may refuse to grow
+	 * it (sbrk(n>0) returns -1 / ENOMEM). ex grows its line-pointer arena
+	 * (fendcore..endcore) with sbrk() in morelines(), which can fail with
+	 * "Out of memory - too many lines in file". Allocate a single large
+	 * arena with mmap() instead; morelines() (ex_subr.c) bumps endcore
+	 * within this fixed region on demand. 16 MB == ~4M line slots
+	 * (line == int), far beyond ex's normal use.
+	 */
+	{
+		size_t arenabytes = (size_t)16 * 1024 * 1024;
+		line_arena = (line *)mmap(NULL, arenabytes,
+			PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS,
+			-1, (off_t)0);
+		if (line_arena == (line *)MAP_FAILED) {
+			line_arena = NULL;
+			line_arena_nlines = 0;
+		} else {
+			line_arena_nlines = arenabytes / sizeof(line);
+		}
+		fendcore = line_arena;
+		endcore = fendcore;  /* grown on demand by morelines() */
+	}
 
