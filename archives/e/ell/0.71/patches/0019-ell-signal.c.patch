+/*
+ * sigisemptyset() is glibc 2.36+ / POSIX.1-2024 and is absent from the
+ * OHOS musl libc.  Test the opaque sigset_t bitmap directly instead
+ * (all-zero == empty signal set).
+ */
+#ifndef HAVE_SIGISEMPTYSET
+static inline bool sigisemptyset(const sigset_t *set)
+{
+	const unsigned char *p = (const unsigned char *) set;
+	size_t i;
+
+	for (i = 0; i < sizeof(sigset_t); i++)
+		if (p[i])
+			return false;
+
+	return true;
+}
+#endif
 
