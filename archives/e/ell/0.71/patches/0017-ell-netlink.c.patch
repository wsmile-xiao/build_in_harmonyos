+/* musl's CMSG_NXTHDR() compares a size_t against a ptrdiff_t inside the macro
+ * (__CMSG_LEN(...) >= __MHDR_END(mhdr) - (unsigned char *)(cmsg)), which trips
+ * -Wsign-compare and becomes fatal under -Werror.  The defect is in the system
+ * header macro, not in this file's code: a whole-tree syntax scan with
+ * -Wall -Wextra found exactly these CMSG_NXTHDR expansion sites and no other
+ * sign-compare diagnostic, so ignoring the group for this translation unit
+ * hides nothing real. */
+#pragma GCC diagnostic ignored "-Wsign-compare"
+#ifdef __OHOS__
+#define sockaddr_storage __linux_sockaddr_storage
+#endif
 #include <linux/netlink.h>
