 #ifndef HAVE_RAWMEMCHR
 static inline void *rawmemchr(const void *s, int c)
 {
+/* -Wstringop-overflow is a GCC-only warning group: clang does not know it and
+ * rejects it as -Wunknown-warning-option (fatal under -Werror).  Guard on the
+ * compiler rather than on the platform so the pragma stays active for GCC. */
+#if defined(__GNUC__) && !defined(__clang__)
 _Pragma("GCC diagnostic push")
 _Pragma("GCC diagnostic ignored \"-Wstringop-overflow=\"")
+#endif
 	return memchr(s, c, PTRDIFF_MAX);
+#if defined(__GNUC__) && !defined(__clang__)
 _Pragma("GCC diagnostic pop")
+#endif
 }
 #endif
