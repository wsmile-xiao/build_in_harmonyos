--- a/Makefile
+++ b/Makefile
@@ -1,21 +1,24 @@
 SRCS   = $(wildcard src/*.cpp)
 OBJS   = $(SRCS:.cpp=.o)

-PREFIX = /usr/local
+PREFIX ?= /usr/local
+DESTDIR ?=
 BINDIR = $(PREFIX)/bin
 SHARE  = $(PREFIX)/share
 MAPDIR = $(SHARE)/pacvim-maps

-CXX    = g++
-CFLAGS = -std=c++11 -DMAPS_LOCATION='"$(MAPDIR)"'
-LFLAGS = -lncurses
+CXX    ?= clang++
+EXTRA_INC ?=
+EXTRA_LIB ?=
+CFLAGS = -std=c++11 -I$(EXTRA_INC) -DMAPS_LOCATION='"$(MAPDIR)"'
+LFLAGS = -L$(EXTRA_LIB) -lncursesw

 TARGET = pacvim
 MAPS   = maps
 DEPS   = .deps

 ifneq ($(shell uname -s 2>/dev/null || echo nop),Darwin)
 # OS has POSIX threads in libc
 CFLAGS += -pthread
 endif

@@ -27,19 +30,19 @@
 %.o: %.cpp
 	$(CXX) $(CFLAGS) -c -o $@ $<

 $(DEPS):
-	$(CXX) -M $(SRCS) >| $@
+	$(CXX) -I$(EXTRA_INC) -M $(SRCS) >| $@

 clean:
 	$(RM) $(OBJS) $(DEPS)

 install: $(TARGET)
-	install -d $(BINDIR) $(SHARE)
-	install -m 755 $(TARGET) $(BINDIR)/
-	cp -r $(MAPS) $(MAPDIR)
+	install -d $(DESTDIR)$(BINDIR) $(DESTDIR)$(SHARE)
+	install -m 755 $(TARGET) $(DESTDIR)$(BINDIR)/
+	cp -r $(MAPS) $(DESTDIR)$(MAPDIR)

 uninstall:
 	$(RM) $(BINDIR)/$(TARGET)
 	$(RM) -r $(MAPDIR)

 -include $(DEPS)
