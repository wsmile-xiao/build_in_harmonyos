diff -ruN a/Foundation/src/Thread_POSIX.cpp b/Foundation/src/Thread_POSIX.cpp
--- a/Foundation/src/Thread_POSIX.cpp
+++ b/Foundation/src/Thread_POSIX.cpp
@@ -520,33 +520,43 @@
 {
 #if POCO_OS == POCO_OS_LINUX
 	int numCores = sysconf(_SC_NPROCESSORS_ONLN);
 	if (coreID < 0 || coreID >= numCores)
 		return false;
 
 	cpu_set_t cpuset;
 	CPU_ZERO(&cpuset);
 	CPU_SET(coreID, &cpuset);
 
+#ifdef __OHOS__
+	// musl/OHOS lacks pthread_setaffinity_np, use sched_setaffinity with tid
+	return 0 == sched_setaffinity(::syscall(SYS_gettid), sizeof(cpu_set_t), &cpuset);
+#else
 	return 0 == pthread_setaffinity_np(_pData->thread, sizeof(cpu_set_t), &cpuset);
+#endif
 #else
 	return false;
 #endif
 }
 
 
 int ThreadImpl::getAffinityImpl() const
 {
 #if POCO_OS == POCO_OS_LINUX
 	cpu_set_t cpuset;
 	CPU_ZERO(&cpuset);
+#ifdef __OHOS__
+	// musl/OHOS lacks pthread_getaffinity_np, use sched_getaffinity with tid
+	if (0 == sched_getaffinity(::syscall(SYS_gettid), sizeof(cpu_set_t), &cpuset))
+#else
 	if (0 == pthread_getaffinity_np(_pData->thread, sizeof(cpu_set_t), &cpuset))
+#endif
 	{
 		for (int i = 0; i < CPU_SETSIZE; ++i)
 		{
 			if (CPU_ISSET(i, &cpuset)) return i;
 		}
 	}
 #endif
 	return -1;
 }
 
