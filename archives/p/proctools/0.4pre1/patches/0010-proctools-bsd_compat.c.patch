--- /dev/null
+++ b/proctools/bsd_compat.c
@@ -0,0 +1,204 @@
+/**
+ * bsd_compat.c -- BSD libc extensions used by proctools that are not
+ * provided by musl (Linux/OHOS):
+ *
+ *   strvis()     (NetBSD vis(3))       -- used by fmt.c
+ *   sys_signame[] (BSD <signal.h>)     -- used by proctools.c/pfind.c
+ *   __progname    (BSD crt0)           -- used by all frontends
+ */
+
+#if defined(__linux__)
+
+#include <ctype.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ------------------------------------------------------------------ */
+/* vis(3)                                                              */
+/* ------------------------------------------------------------------ */
+
+#define VIS_OCTAL	0x0001	/* use octal \ddd format */
+#define VIS_CSTYLE	0x0002	/* use \[nrftbv a] if possible */
+#define VIS_SP		0x0004	/* also encode space */
+#define VIS_TAB		0x0008	/* also encode tab */
+#define VIS_NL		0x0010	/* also encode newline */
+
+/*
+ * strvis -- encode a string so that it is safe to print, following the
+ * NetBSD vis(3) semantics for the flags above: graphic characters are
+ * copied verbatim, control characters that have a C-style escape are
+ * rendered as such (when the corresponding flag is set), and everything
+ * else becomes a three-digit octal escape.
+ *
+ * Returns the number of characters written to dst, excluding the final
+ * NUL.  dst must have room for 4 * strlen(src) + 1 bytes.
+ */
+int
+strvis(dst, src, flag)
+	char *dst;
+	const char *src;
+	int flag;
+{
+	char *start = dst;
+	unsigned char c;
+
+	if (dst == NULL || src == NULL)
+		return (0);
+
+	while ((c = (unsigned char)*src++) != '\0') {
+		if (isgraph(c) || (c == ' ' && (flag & VIS_SP) == 0)) {
+			*dst++ = (char)c;
+			continue;
+		}
+
+		switch (c) {
+		case '\n':
+			if (flag & (VIS_NL | VIS_CSTYLE)) {
+				*dst++ = '\\'; *dst++ = 'n';
+				continue;
+			}
+			break;
+		case '\r':
+			if (flag & VIS_CSTYLE) {
+				*dst++ = '\\'; *dst++ = 'r';
+				continue;
+			}
+			break;
+		case '\b':
+			if (flag & VIS_CSTYLE) {
+				*dst++ = '\\'; *dst++ = 'b';
+				continue;
+			}
+			break;
+		case '\a':
+			if (flag & VIS_CSTYLE) {
+				*dst++ = '\\'; *dst++ = 'a';
+				continue;
+			}
+			break;
+		case '\v':
+			if (flag & VIS_CSTYLE) {
+				*dst++ = '\\'; *dst++ = 'v';
+				continue;
+			}
+			break;
+		case '\f':
+			if (flag & VIS_CSTYLE) {
+				*dst++ = '\\'; *dst++ = 'f';
+				continue;
+			}
+			break;
+		case '\t':
+			if (flag & (VIS_TAB | VIS_CSTYLE)) {
+				*dst++ = '\\'; *dst++ = 't';
+				continue;
+			}
+			break;
+		default:
+			break;
+		}
+
+		/* octal escape */
+		*dst++ = '\\';
+		*dst++ = (char)('0' + ((c >> 6) & 07));
+		*dst++ = (char)('0' + ((c >> 3) & 07));
+		*dst++ = (char)('0' + (c & 07));
+	}
+
+	*dst = '\0';
+	return ((int)(dst - start));
+}
+
+/* ------------------------------------------------------------------ */
+/* sys_signame (BSD <signal.h>)                                        */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Signal names without the "SIG" prefix, indexed by signal number.
+ * Matches this platform's musl: NSIG == 65, SIGRTMIN == 35,
+ * SIGRTMAX == 64 (signals 32-34 are reserved).
+ *
+ * Used by signameToSignum() (proctools.c) and the -s help output.
+ */
+const char *const sys_signame[NSIG] = {
+	/*  0 */ "",
+	/*  1 */ "HUP",
+	/*  2 */ "INT",
+	/*  3 */ "QUIT",
+	/*  4 */ "ILL",
+	/*  5 */ "TRAP",
+	/*  6 */ "ABRT",
+	/*  7 */ "BUS",
+	/*  8 */ "FPE",
+	/*  9 */ "KILL",
+	/* 10 */ "USR1",
+	/* 11 */ "SEGV",
+	/* 12 */ "USR2",
+	/* 13 */ "PIPE",
+	/* 14 */ "ALRM",
+	/* 15 */ "TERM",
+	/* 16 */ "STKFLT",
+	/* 17 */ "CHLD",
+	/* 18 */ "CONT",
+	/* 19 */ "STOP",
+	/* 20 */ "TSTP",
+	/* 21 */ "TTIN",
+	/* 22 */ "TTOU",
+	/* 23 */ "URG",
+	/* 24 */ "XCPU",
+	/* 25 */ "XFSZ",
+	/* 26 */ "VTALRM",
+	/* 27 */ "PROF",
+	/* 28 */ "WINCH",
+	/* 29 */ "IO",
+	/* 30 */ "PWR",
+	/* 31 */ "SYS",
+	/* 32 */ "",		/* reserved by musl */
+	/* 33 */ "",		/* reserved by musl */
+	/* 34 */ "",		/* reserved by musl */
+	/* 35 */ "RTMIN",
+	/* 36 */ "RTMIN+1",
+	/* 37 */ "RTMIN+2",
+	/* 38 */ "RTMIN+3",
+	/* 39 */ "RTMIN+4",
+	/* 40 */ "RTMIN+5",
+	/* 41 */ "RTMIN+6",
+	/* 42 */ "RTMIN+7",
+	/* 43 */ "RTMIN+8",
+	/* 44 */ "RTMIN+9",
+	/* 45 */ "RTMIN+10",
+	/* 46 */ "RTMIN+11",
+	/* 47 */ "RTMIN+12",
+	/* 48 */ "RTMIN+13",
+	/* 49 */ "RTMIN+14",
+	/* 50 */ "RTMIN+15",
+	/* 51 */ "RTMIN+16",
+	/* 52 */ "RTMIN+17",
+	/* 53 */ "RTMIN+18",
+	/* 54 */ "RTMIN+19",
+	/* 55 */ "RTMIN+20",
+	/* 56 */ "RTMIN+21",
+	/* 57 */ "RTMIN+22",
+	/* 58 */ "RTMIN+23",
+	/* 59 */ "RTMIN+24",
+	/* 60 */ "RTMIN+25",
+	/* 61 */ "RTMIN+26",
+	/* 62 */ "RTMIN+27",
+	/* 63 */ "RTMIN+28",
+	/* 64 */ "RTMAX"
+};
+
+/* ------------------------------------------------------------------ */
+/* __progname (BSD crt0)                                               */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The BSDs export __progname from crt0; musl does not, and unlike
+ * glibc it also does not pass (argc, argv, envp) to constructors, so
+ * the value cannot be captured here.  Instead, each frontend sets it
+ * from argv[0] at the top of main().
+ */
+char *__progname = "proctools";
+
+#endif /* __linux__ */
