--- a/Makefile.inc
+++ b/Makefile.inc
@@ -1,6 +1,23 @@
+# Common variables for the GNU make build of proctools.
+# Kept as a separate file so the original include structure of the
+# package (Makefile + Makefile.inc) is preserved.
+#
+# Note: on Linux/OHOS the man pages are installed raw under
+# MANDIR/man1 with their `.so' companions under MANDIR/proctools
+# (see the top-level Makefile), so MANDIR points at the man tree
+# root rather than the BSD catman directory used upstream.
+
 PREFIX?=	/usr/local
-BINDIR?=	${PREFIX}/bin
-MANDIR?=	${PREFIX}/man/cat
-DOCDIR?=	${PREFIX}/share/doc
-MAKEOBJDIR?=	${PWD}/../proctools
-MANFILTER=	soelim
+BINDIR?=	$(PREFIX)/bin
+MANDIR?=	$(PREFIX)/share/man
+DOCDIR?=	$(PREFIX)/share/doc
+
+DESTDIR?=
+
+CC?=		cc
+AR?=		ar
+CFLAGS?=	-O2
+CPPFLAGS?=
+LDFLAGS?=
+
+INSTALL?=	install
