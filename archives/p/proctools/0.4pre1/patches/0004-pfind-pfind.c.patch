+
+#if !defined(REG_NOSPEC)
+/*
+ * OpenBSD's regcomp(3) understands REG_NOSPEC, which compiles the
+ * pattern as a plain literal string (no metacharacters).  musl does
+ * not have this extension, so the literal mode is emulated by escaping
+ * every POSIX ERE metacharacter before handing the pattern to
+ * regcomp() -- a regex without metacharacters is a literal substring
+ * match, which is exactly what REG_NOSPEC provides.
+ */
+static char *
+regcomp_escape(pattern)
+	const char *pattern;
+{
+	char *escaped, *e;
+	const char *p;
+
+	escaped = malloc(2 * strlen(pattern) + 1);
+	if (escaped == NULL)
+		err(EX_OSERR, NULL);
+	e = escaped;
+	for (p = pattern; *p != '\0'; p++) {
+		if (strchr("\\.^$|()[]*+?{}", *p) != NULL)
+			*e++ = '\\';
+		*e++ = *p;
+	}
+	*e = '\0';
+	return (escaped);
+}
+#endif
 
