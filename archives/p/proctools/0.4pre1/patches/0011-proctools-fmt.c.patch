+#if defined(USE_PROCFS)
+/*
+ * Linux/OHOS: read /proc/<pid>/cmdline (NUL-separated argv) and print
+ * the arguments space-separated, mirroring the kvm_getargv() code path
+ * below.  When argv is unavailable or its basename does not match the
+ * process comm, the comm is appended in parentheses -- same as BSD ps.
+ */
+void
+fmt_argv(baton, proctoolslist)
+	struct baton *baton;
+	const struct proctoolslist *proctoolslist;
+{
+	int left = -1; /* no termwidth! */
+	char path[64];
+	char buf[262144];
+	char *p, *arg0 = NULL;
+	int fd;
+	ssize_t n;
+
+	(void)baton; /* cmdline is read straight from /proc */
+
+	snprintf(path, sizeof(path), "/proc/%ld/cmdline", (long)proctoolslist->pid);
+	fd = open(path, O_RDONLY);
+	if (fd != -1) {
+		n = read(fd, buf, sizeof(buf) - 1);
+		(void)close(fd);
+		if (n > 1) {
+			buf[n] = '\0';
+			p = buf;
+			while (p < buf + n) {
+				char *next = p + strlen(p) + 1;
+
+				if (arg0 == NULL)
+					arg0 = p;
+				fmt_puts(p, &left);
+				if (next < buf + n)
+					fmt_putc(' ', &left);
+				p = next;
+			}
+		}
+	}
+	if (arg0 == NULL || *arg0 == '\0' ||
+		strcmp(cmdpart(arg0), proctoolslist->kp->kp_proc.p_comm)) {
+		fmt_putc('(', &left);
+		fmt_puts(proctoolslist->kp->kp_proc.p_comm, &left);
+		fmt_putc(')', &left);
+	}
+}
