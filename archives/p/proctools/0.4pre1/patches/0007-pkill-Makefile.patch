--- a/pkill/Makefile
+++ b/pkill/Makefile
@@ -1,11 +1,7 @@
-PROG=   pkill
-DPADD+= ../proctools/libproctools.a
-LDADD= -L${MAKEOBJDIR} -lproctools -lkvm
-CLEANFILES+= pkill.cat1
-
-.if defined(OLDKVM)
-BINGRP= kmem
-BINMODE= 2555
-.endif
-
-.include <bsd.prog.mk>
+# GNU make wrapper: the real rules live in the top-level Makefile.
+# `all' is the default goal, so a bare `make' forwards to the
+# top-level build; the program name maps to the real file target
+# so `make pkill' still honors dependencies.
+all install clean:
+	@cd .. && $(MAKE) $@
+pkill:
+	@cd .. && $(MAKE) pkill/pkill
