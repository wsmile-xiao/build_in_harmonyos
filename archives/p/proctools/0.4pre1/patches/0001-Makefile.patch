--- a/Makefile
+++ b/Makefile
@@ -1,21 +1,65 @@
-SUBDIR=	proctools pgrep pkill pfind
-DOCS=	LICENSE README
-DIR=	proctools
+# GNU make rewrite of the original BSD (bsd.prog.mk/bsd.lib.mk/bsd.subdir.mk)
+# build for proctools.
+#
+# The upstream package is built with BSD make and installs pre-formatted
+# catman pages produced by soelim(1).  This GNU makefile keeps the same
+# program/layout but:
+#   - builds libproctools.a from proctools/{fmt,proctools,procfs,bsd_compat}.c
+#     (procfs.c and bsd_compat.c are the Linux/OHOS port additions),
+#   - installs raw man(1) pages into MANDIR/man1 and the shared `.so'
+#     companion pages into MANDIR/proctools (groff resolves the relative
+#     `../proctools/...' references from MANDIR/man1), so the build does
+#     not depend on soelim being installed,
+#   - drops the -lkvm link and the OLDKVM/kmem install modes, which only
+#     apply to BSD systems with libkvm.
+#
+# All key variables (CC/AR/CFLAGS/CPPFLAGS/LDFLAGS/PREFIX/DESTDIR/...) can
+# be overridden from the environment or the make command line.
 
-.include "Makefile.inc"
+include Makefile.inc
 
-beforeinstall: ${DESTDIR}${BINDIR} ${DESTDIR}${MANDIR}1
+LIB= proctools/libproctools.a
+LIB_SRCS= proctools/fmt.c proctools/proctools.c proctools/procfs.c proctools/bsd_compat.c
+LIB_OBJS= $(LIB_SRCS:.c=.o)
 
-${DESTDIR}${BINDIR}:
-	${INSTALL} -d -o ${BINOWN} -g ${BINGRP} -m ${BINMODE} ${DESTDIR}${BINDIR}
+PROGS= pgrep/pgrep pkill/pkill pfind/pfind
+PROG_OBJS= pgrep/pgrep.o pkill/pkill.o pfind/pfind.o
 
-${DESTDIR}${MANDIR}1:
-	${INSTALL} -d -o ${MANOWN} -g ${MANGRP} -m ${MANMODE} ${DESTDIR}${MANDIR}1
+MAN_PAGES= pgrep/pgrep.1 pkill/pkill.1 pfind/pfind.1
+MAN_SO= proctools/man.authors proctools/man.bugs proctools/man.exits proctools/man.notes
+DOCS= LICENSE README
 
-afterinstall:
-	${INSTALL} -d -o ${DOCOWN} -g ${DOCGRP} -m ${DOCMODE} \
-		${DESTDIR}${DOCDIR}/${DIR}
-	${INSTALL} ${INSTALL_COPY} -o ${DOCOWN} -g ${DOCGRP} -m ${DOCMODE} \
-		${DOCS} ${DESTDIR}${DOCDIR}/${DIR}
+.PHONY: all install clean
 
-.include <bsd.subdir.mk>
+all: $(LIB) $(PROGS)
+
+$(LIB): $(LIB_OBJS)
+	$(AR) rcs $@ $(LIB_OBJS)
+
+pgrep/pgrep: pgrep/pgrep.o $(LIB)
+	$(CC) $(LDFLAGS) -o $@ pgrep/pgrep.o $(LIB)
+
+pkill/pkill: pkill/pkill.o $(LIB)
+	$(CC) $(LDFLAGS) -o $@ pkill/pkill.o $(LIB)
+
+pfind/pfind: pfind/pfind.o $(LIB)
+	$(CC) $(LDFLAGS) -o $@ pfind/pfind.o $(LIB)
+
+%.o: %.c
+	$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<
+
+# every translation unit depends on the shared header
+$(LIB_OBJS) $(PROG_OBJS): proctools/proctools.h
+
+install: all
+	$(INSTALL) -d $(DESTDIR)$(BINDIR) \
+		$(DESTDIR)$(MANDIR)/man1 \
+		$(DESTDIR)$(MANDIR)/proctools \
+		$(DESTDIR)$(DOCDIR)/proctools
+	$(INSTALL) -m 755 $(PROGS) $(DESTDIR)$(BINDIR)
+	$(INSTALL) -m 644 $(MAN_PAGES) $(DESTDIR)$(MANDIR)/man1
+	$(INSTALL) -m 644 $(MAN_SO) $(DESTDIR)$(MANDIR)/proctools
+	$(INSTALL) -m 644 $(DOCS) $(DESTDIR)$(DOCDIR)/proctools
+
+clean:
+	rm -f $(LIB) $(LIB_OBJS) $(PROG_OBJS) $(PROGS)
