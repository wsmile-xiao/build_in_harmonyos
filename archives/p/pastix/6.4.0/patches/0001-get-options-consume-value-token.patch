diff --git a/common/get_options.c b/common/get_options.c
index bcbbe51..41fea89 100644
--- a/common/get_options.c
+++ b/common/get_options.c
@@ -309,6 +309,12 @@ pastixGetOptions( int argc, char **argv,
                 goto unknown_option;
             }
             iparam[iparm_idx] = iparm_val;
+            /* The value is a separate token that getopt() does not consume
+             * (it is not the option argument); advance optind past it so that
+             * the next iteration resumes on the following option. Leaving it
+             * to getopt() is not portable: a permuting getopt_long() may
+             * place previously seen non-option tokens before it. */
+            optind += 1;
         }
         break;

@@ -327,6 +333,8 @@ pastixGetOptions( int argc, char **argv,
             /* Get iparm value */
             dparm_val = atof( argv[optind] );
             dparam[dparm_idx] = dparm_val;
+            /* Same as for -i: consume the separate value token. */
+            optind += 1;
         }
         break;

