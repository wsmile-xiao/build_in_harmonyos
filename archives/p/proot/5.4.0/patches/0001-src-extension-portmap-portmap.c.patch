 #include <sys/socket.h>	    /* AF_UNIX, AF_INET */
 #include <arpa/inet.h>      /* inet_ntop */
+#if defined(__linux__) && !defined(__GLIBC__)
+/* <linux/net.h> pulls in <linux/socket.h> which defines the
+ * kernel-side struct sockaddr_storage; on musl-based systems (such
+ * as the OHOS libc) <sys/socket.h> (included above) defines the
+ * same struct and the two definitions collide.  Rename the
+ * kernel-side struct while the UAPI headers are included; glibc
+ * builds are unaffected. */
+#define sockaddr_storage __kernel_sockaddr_storage
 #include <linux/net.h>   	/* SYS_*, */
+#undef sockaddr_storage
+#else
+#include <linux/net.h>   	/* SYS_*, */
+#endif
