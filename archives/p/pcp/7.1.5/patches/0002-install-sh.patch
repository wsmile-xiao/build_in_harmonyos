--- a/install-sh
+++ b/install-sh
@@ -168,20 +168,25 @@
 OWNER=`$ID -u 2>/dev/null`
 GROUP=`$ID -g 2>/dev/null`
 if [ -z "$OWNER" -o -z "$GROUP" ]
 then
     # do it the hardway
     #
     OWNER=`$ID | sed -e 's/.*uid=[^(]*(//' -e 's/).*//'`
     GROUP=`$ID | sed -e 's/.*gid=[^(]*(//' -e 's/).*//'`
 fi
 REAL_UID=$OWNER
+# OHOS has no id command (and chown), so REAL_UID may be empty which
+# breaks the "test $REAL_UID -ne 0" non-root detection below; fall back
+# to non-root so the chown step is skipped (files keep the natural
+# ownership, which is what OHOS hmdfs wants).
+[ -n "$REAL_UID" ] || REAL_UID=1
 
 # default is to install and don't append manifest/tmpfiles
 INSTALL=true
 MANIFEST=:
 TMPFILES=:
 
 [ -n "$DIST_MANIFEST" -a -z "$DIST_ROOT" ] && INSTALL=false
 [ -n "$DIST_MANIFEST" ] && MANIFEST="_manifest"
 [ -n "$DIST_TMPFILES" ] && TMPFILES="_tmpfiles"
 
