--- a/src/pmdas/bind2/mk.rewrite
+++ b/src/pmdas/bind2/mk.rewrite
@@ -29,21 +29,23 @@
 inlist == 1		{ print }' \
   | tee $tmp.list \
   | sed \
     -e '/UNASSIGNED/d' \
     -e "s/'//g" \
     -e 's/,//g' \
     -e 's/^  */metric /' \
     -e 's/[ 	][ 	]*\([0-9][0-9]*\)/ { pmid -> BIND2.0.\1 }/' \
 ) >$tmp.tmp
 
-if PCP_CONF=../../include/pcp.conf ../../pmcpp/pmcpp.static -P <$tmp.tmp >>rewrite.conf
+# pmcpp.static is not built when cross-compiling (static link infeasible
+# on OHOS); use the dynamic pmcpp with the in-tree libpcp on the loader path
+if PCP_CONF=../../include/pcp.conf LD_LIBRARY_PATH=../../libpcp/src:$LD_LIBRARY_PATH ../../pmcpp/pmcpp -P <$tmp.tmp >>rewrite.conf
 then
     :
 else
     echo "Error: pmcpp failed"
     status=1
     exit
 fi
 
 cat <<'End-of-File' >>rewrite.conf
 
