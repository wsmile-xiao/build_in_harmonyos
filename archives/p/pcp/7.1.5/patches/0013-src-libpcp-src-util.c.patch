-		outstream = dupoldstream;
+		/*
+		 * Portable replacement for the glibc-only struct copy
+		 * `*dupoldstream = *oldstream`: on OHOS (and Bionic/musl-style
+		 * libcs) FILE is an opaque/incomplete type, so copying the
+		 * struct is not portable. The recovered stream (oldstream, from
+		 * fdopen above) shares the same fd/state, so use it directly
+		 * as the output stream returned to the caller.
+		 */
+		outstream = oldstream;
 	    }
 #ifdef HAVE_STRERROR_R_PTR
