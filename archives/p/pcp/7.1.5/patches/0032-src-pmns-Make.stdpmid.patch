 # source the PCP configuration environment variables
 . $PCP_DIR/etc/pcp.env
 
 if [ -n "$PCP_TMPFILE_DIR" -a -d "$PCP_TMPFILE_DIR" ]
 then
     tmp=`mktemp -d "$PCP_TMPFILE_DIR/pmns_stdpmid.XXXXXXXXX"` || exit 1
 else
     # assume run during a build and /tmp is a safe bet
     #
