diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,24 @@
+#!/bin/sh
+# Dummy configure script for pdfcrack (makefile project)
+# Accepts standard autotools arguments for build system compatibility
+
+PREFIX="/usr/local"
+
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            ;;
+        --help)
+            echo "Usage: configure [options]"
+            echo "  --prefix=DIR   Installation prefix [$PREFIX]"
+            exit 0
+            ;;
+        *)
+            # Ignore unknown options
+            ;;
+    esac
+done
+
+echo "Configuration complete (makefile project, prefix=$PREFIX)"
+exit 0
