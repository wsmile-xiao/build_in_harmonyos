 use PgCommon;
 
 # determine encoding of an .aff file
 sub get_encoding {
     open F, $_[0] or die "cannot open $_[0]: $!";
     while (<F>) {
         if (/^SET ([\w-]+)\s*$/) { return $1; }
     }
