 # Check write cache setting for given drive.
 # Arguments: <device>
 # Returns: 0 = disabled, 1 = enabled, -1: could not determine
 sub get_device_write_cache {
     open DRV, $_[0] or return -1;
     sub HDIO_GET_WCACHE () {0x30e;}
