 bool PWSRun::runcmd(const StringX &runcommand, const bool &bAutotype) const
 {
   UNREFERENCED_PARAMETER(bAutotype);
   if (runcommand.empty())
     return false;
+#ifndef NO_WX
   ::wxExecute(runcommand.c_str());
+#else
+  // Use system() as fallback when wxWidgets is not available
+  // Convert wide string to narrow string
+  std::string narrowCmd;
+  for (const auto &wc : runcommand) {
+    if (wc >= 0 && wc <= 127) narrowCmd += static_cast<char>(wc);
+    else narrowCmd += '?'; // fallback for non-ASCII
+  }
+  system(narrowCmd.c_str());
+#endif
   return true;
 }
 
