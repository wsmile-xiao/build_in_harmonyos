# 归档局部 .gitignore — 构建产物忽略规则（R19：禁止提交预编译二进制）
# 本包的 test_package 探针产物名为 test_pinentry，与根 .gitignore 的
# `**/test_package/test_probe` 规则**名称不匹配**，故需在此显式忽略
# （对照：同批 libksba 的探针恰好叫 test_probe，被根规则拦住了）。

# test_package 本地编译的消费者探针（由 conanfile.py build()/test() 现场生成）
test_pinentry

# test() 里 run_upstream_tests.py 的输出日志（conanfile.py 重定向到此）
upstream_tests.log

# conan test_package 生成的构建/运行环境脚本
conanbuild*.sh
conanrun*.sh
deactivate_conan*.sh
conanbuildenv-*.sh
conanrunenv-*.sh

# conan 构建目录与元数据
build/
metadata/

# Python 缓存
__pycache__/
*.pyc
