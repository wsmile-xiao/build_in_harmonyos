{
  "name": "polyglot",
  "description": "PolyGlot — UCI 与 XBoard 协议适配器及国际象棋开局库工具",
  "homepage": "https://www.gnu.org/software/xboard/",
  "type": "tool",
  "versions": {
    "2.0.4": {
      "ref": "polyglot/2.0.4",
      "binary": false
    }
  },
  "commands": {
    "polyglot": {
      "description": "主命令：作为引擎适配器需 polyglot.ini 配置；亦含三个开局库工具子命令",
      "usage": [
        "polyglot make-book -pgn <input.pgn> -bin <output.bin> [-min-game N]",
        "polyglot merge-book -in1 <a.bin> -in2 <b.bin> -out <merged.bin>",
        "polyglot dump-book -bin <book.bin> -color <white|black> [-out <lines.txt>]"
      ]
    }
  }
}
