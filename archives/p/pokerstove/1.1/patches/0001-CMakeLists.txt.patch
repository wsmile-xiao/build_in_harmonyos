--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,13 +1,23 @@
 cmake_minimum_required(VERSION 3.0)
 
 project(pokerstove)
+
+# OHOS (HarmonyOS) musl libc does not provide pthread_setcancelstate.
+# Boost 1.84 headers (boost/core/detail/sp_thread_sleep.hpp, pulled in by
+# smart_ptr) need this feature-detection macro to skip that code path.
+# The conan boost/1.84.0 package only propagates the define to targets that
+# link Boost components, so define it globally for library sources that
+# merely include boost headers.
+if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    add_definitions(-DBOOST_SP_NO_PTHREAD_SETCANCELSTATE)
+endif()
 
 # TODO: This flags only works for GCC compatible compilers (Clang, Intel).
 # TODO: This, ideally, should be per library requirement,
 #       but since all of them require C++11, the flag is set globally.
 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -std=c++14")
 
 # TODO: Remove the deprecated register keywords
 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wno-deprecated-register")
 
