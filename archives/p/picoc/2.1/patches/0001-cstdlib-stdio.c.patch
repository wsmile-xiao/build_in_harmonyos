--- a/cstdlib/stdio.c
+++ b/cstdlib/stdio.c
@@ -1,13 +1,26 @@
 /* stdio.h library for large systems - small embedded systems use clibrary.c instead */
 #include <errno.h>
 #include "../interpreter.h"
+
+/* FILE is an opaque, incomplete type on musl (and other non-glibc libcs), so
+ * sizeof(FILE) is not a valid constant expression there. picoc only stores the
+ * value below as the byte size of its interpreter-side __FILEStruct and
+ * __va_listStruct pseudo-types (all real FILE stream and va_list traffic goes
+ * through pointers whose size is unrelated), so a sufficiently large fixed
+ * upper bound is safe on libcs that hide the struct.
+ */
+#if defined(__GLIBC__)
+#define PICOC_SYSTEM_FILE_SIZE ((int)sizeof(FILE))
+#else
+#define PICOC_SYSTEM_FILE_SIZE 512
+#endif
 
 #ifndef BUILTIN_MINI_STDLIB
 
 #define MAX_FORMAT 80
 #define MAX_SCANF_ARGS 10
 
 FILE *CStdOut;
 
 static int ZeroValue = 0;
 static int EOFValue = EOF;
