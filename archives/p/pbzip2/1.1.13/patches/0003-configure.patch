diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,7 @@
+#!/bin/sh
+# pbzip2 configure wrapper — no-op for Makefile-only projects
+# This project uses a simple Makefile, no autotools/configure needed.
+# Build directly with: make CXXFLAGS="..." LDFLAGS="..." LDLIBS="-lbz2 -lpthread"
+echo "pbzip2: No configure step needed (Makefile-only project)"
+echo "Build with: make CXXFLAGS='-O2 -fPIC -pthread -D_POSIX_PTHREAD_SEMANTICS -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_STACKSIZE_CUSTOMIZATION -I${PREFIX:-/storage/Users/currentUser/usr/local}/include' LDFLAGS='-L${PREFIX:-/storage/Users/currentUser/usr/local}/lib' LDLIBS='-lbz2 -lpthread'"
+exit 0
