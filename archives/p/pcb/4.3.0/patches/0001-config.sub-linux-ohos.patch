--- a/config.sub	2026-09-05 09:28:54.734437813 +0800
+++ b/config.sub	2026-09-05 09:28:54.826441250 +0800
@@ -111,6 +111,15 @@
     exit 1;;
 esac
 
+# HarmonyOS OHOS: recognize the aarch64-unknown-linux-ohos triplet used by
+# the HarmonyOS PC (OpenHarmony) toolchain without full canonicalization.
+case $1 in
+  *-linux-ohos*)
+    echo "$1"
+    exit 0
+    ;;
+esac
+
 # Separate what the user gave into CPU-COMPANY and OS or KERNEL-OS (if any).
 # Here we must recognize all the valid KERNEL-OS combinations.
 maybe_os=`echo $1 | sed 's/^\(.*\)-\([^-]*-[^-]*\)$/\2/'`
