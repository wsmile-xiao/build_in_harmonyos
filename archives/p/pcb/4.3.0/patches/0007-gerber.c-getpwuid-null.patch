--- a/src/hid/gerber/gerber.c	2026-09-05 17:00:00.000000000 +0800
+++ b/src/hid/gerber/gerber.c	2026-09-05 17:00:00.000000000 +0800
@@ -933,7 +933,17 @@ gerber_set_layer (const char *name, int group, int empty)
 #ifdef HAVE_GETPWUID
       /* ID the user. */
       pwentry = getpwuid (getuid ());
-      fprintf (f, "G04 For: %s *\r\n", pwentry->pw_name);
+      /* OHOS-PC sandbox has no passwd entries: getpwuid() may return NULL
+       * (same upstream defect class as pcb_author() in misc.c, see patch
+       * 0006).  The unconditional deref below SIGSEGVs every gerber export
+       * right at the RS-274X header; fall back to $USER / empty string. */
+      if (pwentry != NULL)
+	fprintf (f, "G04 For: %s *\r\n", pwentry->pw_name);
+      else
+	{
+	  const char *user = getenv ("USER");
+	  fprintf (f, "G04 For: %s *\r\n", user ? user : "");
+	}
 #endif
 
       fprintf (f, "G04 Format: Gerber/RS-274X *\r\n");
