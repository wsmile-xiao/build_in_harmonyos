--- a/PC6001VX.pro
+++ b/PC6001VX.pro
@@ -86,8 +86,14 @@
 
     !android:!ios {
         #Configuration for X11(XCB)
-        DEFINES += USE_X11
-        PKGCONFIG += x11
+        #HarmonyOS: the harmonyos-clang mkspec reuses linux.conf, so neither an
+        #`ohos` scope nor QMAKE_PLATFORM can distinguish this target from Linux.
+        #The Conan recipe passes P6VX_NO_X11 for targets without an X server and
+        #without the Qt xcb platform plugin.
+        !contains(DEFINES, P6VX_NO_X11) {
+            DEFINES += USE_X11
+            PKGCONFIG += x11
+        }
     }
 }
 
@@ -117,7 +123,16 @@
 }
 
 !contains(DEFINES, NOSOUND) {
-    QT += multimedia
+    #OHOS: Qt Multimedia is installed in its own Conan package, so the qmake
+    #module files below the qtbase prefix cannot resolve `QT += multimedia`
+    #(split-prefix install). The Conan recipe passes the real include and
+    #library directories on the qmake command line instead of the module name.
+    isEmpty(P6VX_QTMULTIMEDIA_INCDIR) {
+        QT += multimedia
+    } else {
+        INCLUDEPATH += $$P6VX_QTMULTIMEDIA_INCDIR $$P6VX_QTMULTIMEDIA_INCDIR/QtMultimedia
+        LIBS += -L$$P6VX_QTMULTIMEDIA_LIBDIR -lQt6Multimedia
+    }
     SOURCES += \
         src/Qt/wavfile.cpp
 }
