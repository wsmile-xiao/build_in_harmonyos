diff --git a/pppd/plugins/pppoe/plugin.c b/pppd/plugins/pppoe/plugin.c
--- a/pppd/plugins/pppoe/plugin.c
+++ b/pppd/plugins/pppoe/plugin.c
@@ -43,4 +43,23 @@
 #include <signal.h>
 #include <net/if_arp.h>
 #include <linux/ppp_defs.h>
+
+/*
+ * Some Linux UAPI header variants use __packed as a declarator without
+ * defining the usual macro. Keep the fallback scoped to the affected header.
+ */
+#ifndef __packed
+#define PPP_DEFINED_PACKED 1
+#define __packed __attribute__((packed))
+#endif
+#if defined(__linux__) && !defined(__GLIBC__)
+#define sockaddr_storage __linux_sockaddr_storage
+#endif
 #include <linux/if_pppox.h>
+#if defined(__linux__) && !defined(__GLIBC__)
+#undef sockaddr_storage
+#endif
+#ifdef PPP_DEFINED_PACKED
+#undef __packed
+#undef PPP_DEFINED_PACKED
+#endif
