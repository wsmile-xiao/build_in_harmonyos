--- a/src/Makefile
+++ b/src/Makefile
@@ -35,35 +35,35 @@
 LDFLAGS = -lpthread
 TARGET = playumidi
 HEADERS = playumidi.h smf.h config.h
 OBJS = main.o \
 		read_smf.o \
 		midievent.o \
 		play_event.o \
 		micro_sleep.o \
 		midi_device.o
 
-.ifdef WITH_VERIFY
+ifdef WITH_VERIFY
 OBJS += verify_event.o
 CFLAGS += -DVERIFY_EVENT
-.endif
+endif
 
-.ifdef WITH_ICONV
+ifdef WITH_ICONV
 CFLAGS += -DSUPPORT_ICONV -I/usr/local/include
 LDFLAGS += -liconv -L/usr/local/lib
-.endif
+endif
 
-.ifdef WITH_DEBUG
+ifdef WITH_DEBUG
 CFLAGS += -g
-.else
+else
 CFLAGS += -DNDEBUG -O2
-.endif
+endif
 
 
 all: $(TARGET)
 
 $(TARGET): $(OBJS)
 	$(CC) -o $(TARGET) $(LDFLAGS) $(OBJS)
 
 verify_event.o: verify_event.c $(HEADERS)
 	$(CC) -c -o verify_event.o $(CFLAGS) verify_event.c
 midi_device.o: midi_device.c $(HEADERS)
