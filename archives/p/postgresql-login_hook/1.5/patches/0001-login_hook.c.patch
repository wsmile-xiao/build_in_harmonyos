diff -ruN a/login_hook.c b/login_hook.c
--- a/login_hook.c
+++ b/login_hook.c
@@ -67,22 +67,22 @@
 void _PG_init(void);
 /* Module entry point */
 void _PG_init(void)
 {
 	char* dbName;
 	Oid loginHookNamespaceOid;
