+# HarmonyOS / OpenHarmony PC platform support.
+#
+# HarmonyOS PC does not ship a GTK+ toolkit, so the GTK front end is
+# not usable.  The OHOS build instead uses the headless front end
+# (ohos.c), which provides the same standalone command-line modes that
+# the GTK front end supports without a display (--list-presets,
+# --generate, --test-solve, --time-generation, --save).  All puzzle
+# binaries are therefore command-line tools, and the standalone
+# solver/test programs build as usual; the GUI-only helper programs
+# (which require a GUI front end) are not built.
+set(build_individual_puzzles TRUE)
+set(build_cli_programs TRUE)
+set(build_gui_programs FALSE)
+set(build_icons FALSE)
+set(need_c_icons FALSE)
+set(NAME_PREFIX "")
+
+set(platform_common_sources ohos.c)
+set(platform_gui_libs )
+set(platform_libs -lm)
+
+function(get_platform_puzzle_extra_source_files OUTVAR NAME AUXILIARY)
+  set(${OUTVAR} ${PUZZLES_ROOT_DIR}/no-icon.c PARENT_SCOPE)
+endfunction()
+
+function(set_platform_gui_target_properties TARGET)
+endfunction()
+
+# Install the playable puzzles as command-line tools into bin/ (same
+# layout as the unix platform).  The unofficial targets (nullgame,
+# unfinished/ puzzles) are built but not installed, matching the
+# upstream unix behaviour.
+function(set_platform_puzzle_target_properties NAME TARGET)
+  set(binary_name ${NAME_PREFIX}${NAME})
+  set_target_properties(${TARGET} PROPERTIES OUTPUT_NAME ${binary_name})
+  get_target_property(official ${TARGET} official)
+  if(official)
+    install(TARGETS ${TARGET} RUNTIME DESTINATION bin)
+  endif()
+endfunction()
+
+function(build_platform_extras)
+endfunction()
