diff -ruN /dev/null b/cmake/platforms/ohos.cmake
--- /dev/null
+++ b/cmake/platforms/ohos.cmake
@@ -0,0 +1,45 @@
+# OpenHarmony (headless/CLI-only) platform support for Simon Tatham's Puzzles
+# No GTK available - build only CLI programs
+
+# Override: disable GUI programs since GTK is not available
+set(build_gui_programs FALSE)
+set(build_icons FALSE)
+set(need_c_icons FALSE)
+
+# Use ohos_fe.c as the minimal frontend (includes null stubs + main())
+set(platform_common_sources ohos_fe.c)
+set(platform_gui_libs)
+set(platform_libs -lm)
+
+# Add compile definitions for headless mode
+add_compile_definitions(NO_GUI HELP_DIR="${CMAKE_INSTALL_PREFIX}/share/sgt-puzzles/help")
+
+# Platform functions required by setup.cmake
+function(get_platform_puzzle_extra_source_files OUTVAR NAME AUXILIARY)
+  # No icon or platform-specific source files needed for CLI build
+  set(${OUTVAR} PARENT_SCOPE)
+endfunction()
+
+function(set_platform_gui_target_properties TARGET)
+  # No GUI properties needed for CLI build
+endfunction()
+
+function(set_platform_puzzle_target_properties NAME TARGET)
+  # For official puzzles, set install target
+  get_target_property(official ${TARGET} official)
+  get_target_property(exename ${TARGET} exename)
+  get_target_property(displayname ${TARGET} displayname)
+  get_target_property(description ${TARGET} description)
+  set(binary_name ${NAME_PREFIX}${NAME})
+
+  set_target_properties(${TARGET} PROPERTIES
+    OUTPUT_NAME ${binary_name})
+
+  if(${official})
+    install(TARGETS ${TARGET} RUNTIME DESTINATION bin)
+  endif()
+endfunction()
+
+function(build_platform_extras)
+  # No platform-specific extras needed
+endfunction()
