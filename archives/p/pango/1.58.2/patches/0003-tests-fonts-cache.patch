--- a/tests/fonts/fonts.conf
+++ b/tests/fonts/fonts.conf
@@ -1,7 +1,12 @@
 <?xml version="1.0"?>
 <!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
 <fontconfig>
-  <cachedir>/tmp/cache</cachedir>
+  <!-- OHOS adaptation: /tmp is read-only on HarmonyOS, so the upstream
+       hardcoded /tmp/cache makes every fontset case fail with
+       "Fontconfig error: No writable cache directories /tmp/cache".
+       Use the XDG cache home instead (the packager points
+       XDG_CACHE_HOME at a writable task tmp dir); test logic untouched. -->
+  <cachedir prefix="xdg">fontconfig</cachedir>
 
   <match target="font">
     <test name="outline" compare="eq">
