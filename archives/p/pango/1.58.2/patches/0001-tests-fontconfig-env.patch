--- a/tests/meson.build
+++ b/tests/meson.build
@@ -17,7 +17,13 @@
 test_env.set('G_TEST_SRCDIR', meson.current_source_dir())
 test_env.set('G_TEST_BUILDDIR', meson.current_build_dir())
 test_env.set('LC_ALL', 'en_US.UTF-8')
-test_env.set('FONTCONFIG_FILE', '/etc/fonts/fonts.conf')
+# OHOS adaptation: do not pin FONTCONFIG_FILE to /etc/fonts/fonts.conf
+# (that path does not exist on OHOS, so every font-dependent case fails
+# with "Cannot load default config file"). Inherit the process
+# environment instead: the packager points it at a generated fonts.conf
+# (system fonts plus vendored reference fonts). On systems with a
+# standard /etc/fonts layout fontconfig falls back to it by default,
+# so behavior elsewhere is unchanged. No test logic touched.

 tests = [
   [ 'test-coverage' ],
