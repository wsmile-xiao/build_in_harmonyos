--- a/storage/myisam/mi_create.cc
+++ b/storage/myisam/mi_create.cc
@@ -49,5 +49,15 @@
 #include "mysql/strings/m_ctype.h"
 
+static unsigned int ohos_compat_bit_ceil(unsigned int value) {
+#if defined(__cpp_lib_int_pow2) && __cpp_lib_int_pow2 >= 202002L
+  return std::bit_ceil(value);
+#else
+  if (value <= 1) return 1;
+  if (value > 0x80000000U) return 0;
+  return 1U << (32U - __builtin_clz(value - 1U));
+#endif
+}
+
 /*
   Old options is used when recreating database, from myisamchk
 */
@@ -405,2 +415,2 @@
-    block_length = std::clamp(std::bit_ceil(block_length),
+    block_length = std::clamp(ohos_compat_bit_ceil(block_length),
                               MI_MIN_KEY_BLOCK_LENGTH, MI_MAX_KEY_BLOCK_LENGTH);
@@ -502,2 +512,2 @@
-  aligned_key_start = std::bit_ceil(max_key_block_length ? max_key_block_length
+  aligned_key_start = ohos_compat_bit_ceil(max_key_block_length ? max_key_block_length
                                                          : myisam_block_size);
