+#include <cctype>
 #include <boost/graph/properties.hpp>
 #include <memory>
 #include <new>
@@ -93,7 +94,6 @@
 
 #include <algorithm>
 #include <functional>
-#include <regex>
 #include <unordered_map>
 #include <utility>
 #include <vector>
@@ -1503,29 +1503,51 @@ static bool setup_utility_user_dynamic_privileges() {
   }
 
   std::string privileges(utility_user_dynamic_privileges);
+  std::vector<std::string> parsed_privileges;
+  size_t pos = 0;
 
-  // check if the string is valid
-  std::regex validate_regex("(\\s*[A-Za-z0-9_]+\\s*,*)*\\s*[A-Za-z0-9_]+\\s*",
-                            std::regex::nosubs);
-  if (!std::regex_match(privileges, validate_regex)) {
+  const auto is_space = [](char c) {
+    return std::isspace(static_cast<unsigned char>(c)) != 0;
+  };
+  const auto is_privilege_char = [](char c) {
+    const auto value = static_cast<unsigned char>(c);
+    return std::isalnum(value) != 0 || c == '_';
+  };
+  const auto wrong_format = [&]() {
     sql_print_error(
         "Wrong format of --utility-user-dynamic-privileges parameter value: %s",
         utility_user_dynamic_privileges);
     return true;
-  }
+  };
+
+  while (pos < privileges.size() && is_space(privileges[pos])) ++pos;
+  if (pos == privileges.size()) return wrong_format();
 
-  // split it into tokens and trim
-  std::regex split_regex("[^,\\s][^,]*[^,\\s]");
-  for (auto it = std::sregex_iterator(privileges.begin(), privileges.end(),
-                                      split_regex);
-       it != std::sregex_iterator(); ++it) {
-    // Unfortunately there is a bug related to std::regex_constants::icase
-    // https://stackoverflow.com/questions/37757863/c11-regexicase-inconsistent-behavior
-    auto s = it->str();
-    std::for_each(s.begin(), s.end(), [](char &c) { c = ::toupper(c); });
-    uu_dynamic_privileges.push_back(s);
+  while (pos < privileges.size()) {
+    const size_t token_begin = pos;
+    while (pos < privileges.size() && is_privilege_char(privileges[pos])) {
+      ++pos;
+    }
+    if (token_begin == pos) return wrong_format();
+
+    auto privilege = privileges.substr(token_begin, pos - token_begin);
+    std::for_each(privilege.begin(), privilege.end(),
+                  [](char &c) { c = ::toupper(c); });
+    parsed_privileges.push_back(std::move(privilege));
+
+    while (pos < privileges.size() && is_space(privileges[pos])) ++pos;
+    if (pos == privileges.size()) break;
+    if (privileges[pos] != ',') return wrong_format();
+
+    while (pos < privileges.size() && privileges[pos] == ',') ++pos;
+    while (pos < privileges.size() && is_space(privileges[pos])) ++pos;
+    if (pos == privileges.size()) return wrong_format();
   }
 
+  uu_dynamic_privileges.insert(uu_dynamic_privileges.end(),
+                               parsed_privileges.begin(),
+                               parsed_privileges.end());
+
   return false;
 }
 
