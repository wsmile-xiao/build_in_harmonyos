diff --git a/mysql-test/suite/percona/t/processlist_tid.test b/mysql-test/suite/percona/t/processlist_tid.test
index 0cff6d4fb4fc33bc0d425d3e401306f28a60f8c4..b1df15a2bd8ad6a637136e5220f9d7c52f585c41 100644
--- a/mysql-test/suite/percona/t/processlist_tid.test
+++ b/mysql-test/suite/percona/t/processlist_tid.test
@@ -19,12 +19,11 @@ CREATE TABLE lwp_table(lwp_no INT);
 --let $pid_file=`SELECT @@pid_file`
 
 # filling lwp_table with values returned from "ps" system call
-# "--no-header" means omitting column names in output (just plain numbers)
-# "-L" means include lightweight threads
+# "-o tid=" requests only thread ids; some ps implementations still emit a blank heading
+# "-T" means include threads
 # "-p $mysqld_pid" means only output LWPs which belolng to the specified process id
-# "-o lwp" means output only LWP id
 --let $ps_result_file=$MYSQLTEST_VARDIR/percona_ps_result
---exec ps --no-headers -L -p `cat $pid_file` -o lwp > $ps_result_file
+--exec ps -T -p `cat $pid_file` -o tid= | grep -E '^[[:space:]]*[0-9]+[[:space:]]*$' > $ps_result_file
 --eval LOAD DATA LOCAL INFILE '$ps_result_file' INTO TABLE lwp_table
 
 --enable_query_log
