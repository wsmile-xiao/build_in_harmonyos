 --source include/count_sessions.inc
 
+perl;
+  use strict;
+
+  my $version_count = (-f "/proc/version" && -r _) ? 1 : 0;
+  my $irq_count = 0;
+  for my $path (glob("/proc/irq/0/*")) {
+    ++$irq_count if -f $path && -r _;
+  }
+
+  my $output = "$ENV{MYSQL_TMP_DIR}/procfs_expected_counts.inc";
+  open(my $fh, ">", $output) or die "Cannot create $output: $!";
+  print {$fh} "--let \$expected_proc_version_count= $version_count\n";
+  print {$fh} "--let \$expected_irq_0_count= $irq_count\n";
+  close($fh) or die "Cannot close $output: $!";
+EOF
+--source $MYSQL_TMP_DIR/procfs_expected_counts.inc
+--remove_file $MYSQL_TMP_DIR/procfs_expected_counts.inc
+
 let $MYSQLD_DATADIR= `select @@datadir`;
 INSTALL PLUGIN procfs SONAME 'procfs.so';
 
