+/* Copyright (c) 2026, Oracle and/or its affiliates. */
+
+#include "thread_attrs_api.h"
+
+#include <unistd.h>
+
+#include "my_thread_os_id.h"
+
+namespace resourcegroups {
+namespace platform {
+
+bool is_platform_supported() { return false; }
+
+bool bind_to_cpu(cpu_id_t, my_thread_os_id_t) { return false; }
+bool bind_to_cpu(cpu_id_t cpu_id) {
+  return bind_to_cpu(cpu_id, my_thread_os_id());
+}
+
+bool bind_to_cpus(const std::vector<cpu_id_t> &, my_thread_os_id_t) {
+  return false;
+}
+bool bind_to_cpus(const std::vector<cpu_id_t> &cpu_ids) {
+  return bind_to_cpus(cpu_ids, my_thread_os_id());
+}
+
+bool unbind_thread(my_thread_os_id_t) { return false; }
+bool unbind_thread() { return unbind_thread(my_thread_os_id()); }
+
+int thread_priority(my_thread_os_id_t) { return 0; }
+int thread_priority() { return 0; }
+bool set_thread_priority(int, my_thread_os_id_t) { return false; }
+bool set_thread_priority(int priority) {
+  return set_thread_priority(priority, my_thread_os_id());
+}
+
+uint32_t num_vcpus_using_affinity() { return 0; }
+uint32_t num_vcpus_using_config() {
+  const long count = sysconf(_SC_NPROCESSORS_ONLN);
+  return count > 0 ? static_cast<uint32_t>(count) : 0;
+}
+bool can_thread_priority_be_set() { return false; }
+
+}  // namespace platform
+}  // namespace resourcegroups
