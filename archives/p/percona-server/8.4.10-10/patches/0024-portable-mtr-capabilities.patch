diff --git a/mysql-test/lib/mtr_unzip.pl b/mysql-test/lib/mtr_unzip.pl
new file mode 100644
index 0000000000000000000000000000000000000000..afa6a58b47749e4292d929fcba996d70378847d7
--- /dev/null
+++ b/mysql-test/lib/mtr_unzip.pl
@@ -0,0 +1,55 @@
+#!/usr/bin/env perl
+use strict;
+use warnings;
+
+use File::Basename qw(dirname);
+use File::Path qw(make_path);
+use IO::Uncompress::Unzip qw($UnzipError);
+
+my ($archive, $destination);
+while (@ARGV) {
+  my $arg = shift @ARGV;
+  if ($arg eq '-d') {
+    $destination = shift @ARGV;
+  } elsif ($arg =~ /^-/) {
+    next;
+  } elsif (!defined $archive) {
+    $archive = $arg;
+  } else {
+    die "unexpected argument: $arg\n";
+  }
+}
+
+die "usage: mtr_unzip.pl [-qo] ARCHIVE -d DESTINATION\n"
+    unless defined $archive && defined $destination;
+
+my $zip = IO::Uncompress::Unzip->new($archive)
+    or die "cannot open $archive: $UnzipError\n";
+
+for (;;) {
+  my $header = $zip->getHeaderInfo();
+  my $name = $header->{Name};
+  $name =~ tr{\\}{/};
+  die "unsafe archive path: $name\n"
+      if $name =~ m{^/} || $name =~ m{(?:^|/)\.\.(?:/|$)};
+
+  my $output = "$destination/$name";
+  if ($name =~ m{/$}) {
+    make_path($output);
+  } else {
+    make_path(dirname($output));
+    open(my $file, '>:raw', $output) or die "cannot create $output: $!\n";
+    my $buffer;
+    while (1) {
+      my $read = $zip->read($buffer);
+      die "cannot read $name: $UnzipError\n" if !defined $read || $read < 0;
+      last if $read == 0;
+      print {$file} $buffer or die "cannot write $output: $!\n";
+    }
+    close($file) or die "cannot close $output: $!\n";
+  }
+
+  last unless $zip->nextStream();
+}
+
+exit 0;
