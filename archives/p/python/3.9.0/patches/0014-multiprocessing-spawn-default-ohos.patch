From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-27
Subject: [PATCH] multiprocessing: HarmonyOS defaults to spawn start method

Add HarmonyOS-specific branch returning only 'spawn' as
available start method, and default to spawn context.

Applies to: CPython 3.9.0
---
--- a/Lib/multiprocessing/context.py	2020-10-05 23:07:58.000000000 +0800
+++ b/Lib/multiprocessing/context.py	2026-03-27 10:17:25.768162813 +0800
@@ -256,6 +256,9 @@
     def get_all_start_methods(self):
         if sys.platform == 'win32':
             return ['spawn']
+        elif sys.platform.startswith(('ohos', 'harmonyos')):
+            # HarmonyOS lacks fork(), only spawn is available
+            return ['spawn']
         else:
             methods = ['spawn', 'fork'] if sys.platform == 'darwin' else ['fork', 'spawn']
             if reduction.HAVE_SEND_HANDLE:
@@ -314,6 +317,10 @@
         # bpo-33725: running arbitrary code after fork() is no longer reliable
         # on macOS since macOS 10.14 (Mojave). Use spawn by default instead.
         _default_context = DefaultContext(_concrete_contexts['spawn'])
+    elif sys.platform.startswith(('ohos', 'harmonyos')):
+        # HarmonyOS: fork() is available but prefer spawn for safety
+        # under seccomp. Users can switch to fork explicitly if needed.
+        _default_context = DefaultContext(_concrete_contexts['spawn'])
     else:
         _default_context = DefaultContext(_concrete_contexts['fork'])
 
