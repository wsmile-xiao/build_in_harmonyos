From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-27
Subject: [PATCH] Python/thread_pthread.h: implement native thread ID for HarmonyOS

Add __OHOS__ to native thread ID implementation using gettid().

Applies to: CPython 3.9.0
---
--- a/Python/thread_pthread.h	2020-10-05 23:07:58.000000000 +0800
+++ b/Python/thread_pthread.h	2026-03-26 11:54:59.851167657 +0800
@@ -13,7 +13,7 @@
 #endif
 #include <signal.h>
 
-#if defined(__linux__)
+#if defined(__linux__) || defined(__OHOS__)
 #   include <sys/syscall.h>     /* syscall(SYS_gettid) */
 #elif defined(__FreeBSD__)
 #   include <pthread_np.h>      /* pthread_getthreadid_np() */
@@ -332,7 +332,7 @@
 #ifdef __APPLE__
     uint64_t native_id;
     (void) pthread_threadid_np(NULL, &native_id);
-#elif defined(__linux__)
+#elif defined(__linux__) || defined(__OHOS__)
     pid_t native_id;
     native_id = syscall(SYS_gettid);
 #elif defined(__FreeBSD__)
