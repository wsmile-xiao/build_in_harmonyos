From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-27
Subject: [PATCH] distutils.util: get_platform() returns ohos-* for HarmonyOS

Add HarmonyOS as a recognized platform in get_platform().

Applies to: CPython 3.9.0
---
--- a/Lib/distutils/util.py	2020-10-05 23:07:58.000000000 +0800
+++ b/Lib/distutils/util.py	2026-03-27 01:19:10.556390469 +0800
@@ -92,6 +92,8 @@
         osname, release, machine = _osx_support.get_platform_osx(
                                         distutils.sysconfig.get_config_vars(),
                                         osname, release, machine)
+    elif osname.startswith("harmonyos"):
+        return "ohos-%s" % (machine,)
 
     return "%s-%s-%s" % (osname, release, machine)
 
