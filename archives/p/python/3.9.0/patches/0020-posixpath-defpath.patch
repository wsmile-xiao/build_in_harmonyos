From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-27
Subject: [PATCH] posixpath.py: HarmonyOS-specific default PATH

Add platform-conditional defpath for HarmonyOS (/system/bin first).
Original default preserved for all other POSIX platforms.

Applies to: CPython 3.9.0
---
--- a/Lib/posixpath.py	2020-10-05 23:07:58.000000000 +0800
+++ b/Lib/posixpath.py	2026-03-27 01:35:23.620397657 +0800
@@ -18,12 +18,16 @@
 extsep = '.'
 sep = '/'
 pathsep = ':'
-defpath = '/bin:/usr/bin'
 altsep = None
 devnull = '/dev/null'
 
 import os
 import sys
+
+if sys.platform.startswith(('ohos', 'harmonyos')):
+    defpath = '/system/bin:/bin:/usr/bin:/usr/local/bin'
+else:
+    defpath = '/bin:/usr/bin'
 import stat
 import genericpath
 from genericpath import *
