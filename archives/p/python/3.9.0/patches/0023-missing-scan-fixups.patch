From: OpenHarmony PC Developer <dev@example.com>
Subject: [PATCH 23/23] HarmonyOS: fix remaining MISSING_ADAPTATION_SCAN items

This patch addresses the remaining unfixed items from the MISSING_ADAPTATION_SCAN
report (P0-4, P1-2, P1-9, P1-10, P2-3):

- P0-4: Python/pylifecycle.c - Add __OHOS__ to dup() fd validation path
  (same corner case as Linux bpo-32849)
- P1-2: Lib/shutil.py - Enable sendfile zero-copy optimization on HarmonyOS
- P1-9: Lib/tempfile.py - Add HarmonyOS-specific temp directory candidates
- P1-10: configure + configure.ac - Skip lchmod detection for HarmonyOS
- P2-3: Lib/uuid.py - Add /system/bin and /bin to MAC address lookup paths

Verified items (no change needed):
- P1-5: multiprocessing/heap.py - /dev/shm doesn't exist, correctly falls
  back to tempfile.gettempdir()
- P2-8: asyncio/unix_events.py - HarmonyOS uses same path as other POSIX

Skipped items (no practical impact):
- P1-6: pidfd_open - HarmonyOS kernel doesn't support
- P1-7: abstract sockets - needs kernel capability verification
- P2-1: ossaudiodev - not needed
- P2-2: mimetypes - silently skips, no impact
- P2-4: pty - no PTY on HarmonyOS
- P2-6: getpass - no terminal in current env
- P2-7: _decimal - works fine via autoconf fallback
---
 Python/pylifecycle.c | 2 +-
 Lib/shutil.py         | 2 +-
 Lib/tempfile.py       | 5 ++++-
 Lib/uuid.py           | 2 ++
 configure             | 2 +-
 configure.ac          | 2 +-
 6 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/Python/pylifecycle.c b/Python/pylifecycle.c
index 1234567..abcdefg 100644
--- a/Python/pylifecycle.c
+++ b/Python/pylifecycle.c
@@ -1754,7 +1754,7 @@
 
    Only use dup() on platforms where dup() is enough to detect invalid FD in
    corner cases: on Linux and Windows (bpo-32849). */
-#if defined(__linux__) || defined(MS_WINDOWS)
+#if defined(__linux__) || defined(__OHOS__) || defined(MS_WINDOWS)
     if (fd < 0) {
         return 0;
     }
diff --git a/Lib/shutil.py b/Lib/shutil.py
index 1234567..abcdefg 100644
--- a/Lib/shutil.py
+++ b/Lib/shutil.py
@@ -50,7 +50,7 @@
     import nt
 
 COPY_BUFSIZE = 1024 * 1024 if _WINDOWS else 64 * 1024
-_USE_CP_SENDFILE = hasattr(os, "sendfile") and sys.platform.startswith("linux")
+_USE_CP_SENDFILE = hasattr(os, "sendfile") and sys.platform.startswith(("linux", "ohos"))
 _HAS_FCOPYFILE = posix and hasattr(posix, "_fcopyfile")  # macOS
 
 __all__ = ["copyfileobj", "copyfile", "copymode", "copystat", "copy", "copy2",
diff --git a/Lib/tempfile.py b/Lib/tempfile.py
index 1234567..abcdefg 100644
--- a/Lib/tempfile.py
+++ b/Lib/tempfile.py
@@ -164,8 +164,11 @@
         dirlist.extend([ _os.path.expanduser(r'~\AppData\Local\Temp'),
                          _os.path.expandvars(r'%SYSTEMROOT%\Temp'),
                          r'c:\temp', r'c:\tmp', r'\temp', r'\tmp' ])
+    elif _sys.platform.startswith(('ohos', 'harmonyos')):
+        # HarmonyOS: /tmp is available; /data/local/tmp is common on devices
+        dirlist.extend(['/tmp', '/data/local/tmp', '/var/tmp'])
     else:
-        dirlist.extend([ '/tmp', '/var/tmp', '/usr/tmp' ])
+        dirlist.extend(['/tmp', '/var/tmp', '/usr/tmp'])
 
     # As a last resort, the current directory.
     try:
diff --git a/Lib/uuid.py b/Lib/uuid.py
index 1234567..abcdefg 100644
--- a/Lib/uuid.py
+++ b/Lib/uuid.py
@@ -362,6 +362,8 @@
     try:
         path_dirs = os.environ.get('PATH', os.defpath).split(os.pathsep)
         path_dirs.extend(['/sbin', '/usr/sbin'])
+        if sys.platform.startswith(('ohos', 'harmonyos')):
+            path_dirs.extend(['/system/bin', '/bin'])
         executable = shutil.which(command, path=os.pathsep.join(path_dirs))
         if executable is None:
             return None
diff --git a/configure b/configure
index 1234567..abcdefg 100755
--- a/configure
+++ b/configure
@@ -14258,7 +14258,7 @@
 # Force lchmod off for Linux. Linux disallows changing the mode of symbolic
 # links. Some libc implementations have a stub lchmod implementation that always
 # returns an error.
-if test "$MACHDEP" != linux; then
+if test "$MACHDEP" != linux && test "$MACHDEP" != ohos; then
   ac_fn_c_check_func "$LINENO" "lchmod" "ac_cv_func_lchmod"
 if test "x$ac_cv_func_lchmod" = xyes
 then :
diff --git a/configure.ac b/configure.ac
index 1234567..abcdefg 100644
--- a/configure.ac
+++ b/configure.ac
@@ -3694,7 +3694,7 @@
 # Force lchmod off for Linux. Linux disallows changing the mode of symbolic
 # links. Some libc implementations have a stub lchmod implementation that always
 # returns an error.
-if test "$MACHDEP" != linux; then
+if test "$MACHDEP" != linux && test "$MACHDEP" != ohos; then
   AC_CHECK_FUNCS(lchmod)
 fi
 
