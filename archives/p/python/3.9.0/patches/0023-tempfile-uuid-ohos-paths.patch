From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-27
Subject: [PATCH] tempfile.py + uuid.py: HarmonyOS temp/search paths

Add HarmonyOS-specific default temp directories and
platform detection in uuid.py.

Applies to: CPython 3.9.0
---
--- a/Lib/tempfile.py	2020-10-05 23:07:58.000000000 +0800
+++ b/Lib/tempfile.py	2026-03-26 21:04:43.179169375 +0800
@@ -164,8 +164,11 @@
         dirlist.extend([ _os.path.expanduser(r'~\AppData\Local\Temp'),
                          _os.path.expandvars(r'%SYSTEMROOT%\Temp'),
                          r'c:\temp', r'c:\tmp', r'\temp', r'\tmp' ])
+    elif _sys.platform.startswith(('ohos', 'harmonyos')):
+        # HarmonyOS: /tmp is available; /data/local/tmp is common on devices
+        dirlist.extend(['/tmp', '/data/local/tmp', '/var/tmp'])
     else:
-        dirlist.extend([ '/tmp', '/var/tmp', '/usr/tmp' ])
+        dirlist.extend(['/tmp', '/var/tmp', '/usr/tmp'])
 
     # As a last resort, the current directory.
     try:
--- a/Lib/uuid.py	2020-10-05 23:07:58.000000000 +0800
+++ b/Lib/uuid.py	2026-03-26 21:04:49.163164688 +0800
@@ -362,6 +362,8 @@
     try:
         path_dirs = os.environ.get('PATH', os.defpath).split(os.pathsep)
         path_dirs.extend(['/sbin', '/usr/sbin'])
+        if sys.platform.startswith(('ohos', 'harmonyos')):
+            path_dirs.extend(['/system/bin', '/bin'])
         executable = shutil.which(command, path=os.pathsep.join(path_dirs))
         if executable is None:
             return None
