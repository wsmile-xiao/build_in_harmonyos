From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-27
Subject: [PATCH] shutil: enable sendfile on HarmonyOS

Extend _USE_CP_SENDFILE platform check to include 'ohos'.

Applies to: CPython 3.9.0
---
--- a/Lib/shutil.py	2020-10-05 23:07:58.000000000 +0800
+++ b/Lib/shutil.py	2026-03-26 21:03:30.935171407 +0800
@@ -50,7 +50,7 @@
     import nt
 
 COPY_BUFSIZE = 1024 * 1024 if _WINDOWS else 64 * 1024
-_USE_CP_SENDFILE = hasattr(os, "sendfile") and sys.platform.startswith("linux")
+_USE_CP_SENDFILE = hasattr(os, "sendfile") and sys.platform.startswith(("linux", "ohos"))
 _HAS_FCOPYFILE = posix and hasattr(posix, "_fcopyfile")  # macOS
 
 __all__ = ["copyfileobj", "copyfile", "copymode", "copystat", "copy", "copy2",
