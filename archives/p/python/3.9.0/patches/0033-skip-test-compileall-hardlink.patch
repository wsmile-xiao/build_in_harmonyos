 from test import support
 from test.support import script_helper
 
+# Check if the filesystem supports hardlinks at runtime.
+# On HarmonyOS HMDFS, hardlink(2) returns EPERM.
+def _check_hardlink():
+    tmpdir = tempfile.mkdtemp()
+    try:
+        src = os.path.join(tmpdir, 'src')
+        dst = os.path.join(tmpdir, 'dst')
+        with open(src, 'w') as f:
+            f.write('test')
+        try:
+            os.link(src, dst)
+            return True
+        except OSError:
+            return False
+    finally:
+        shutil.rmtree(tmpdir)
+
+_can_hardlink = _check_hardlink()
+
