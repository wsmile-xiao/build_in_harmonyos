From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-27
Subject: [PATCH] _posixsubprocess.c: use /dev/fd on HarmonyOS

Add __OHOS__ to FD_DIR platform detection.

Applies to: CPython 3.9.0
---
--- a/Modules/_posixsubprocess.c	2020-10-05 23:07:58.000000000 +0800
+++ b/Modules/_posixsubprocess.c	2026-03-25 10:44:03.869046718 +0800
@@ -46,7 +46,7 @@
 # endif
 #endif
 
-#if defined(__FreeBSD__) || (defined(__APPLE__) && defined(__MACH__))
+#if defined(__FreeBSD__) || (defined(__APPLE__) && defined(__MACH__)) || defined(__OHOS__)
 # define FD_DIR "/dev/fd"
 #else
 # define FD_DIR "/proc/self/fd"
