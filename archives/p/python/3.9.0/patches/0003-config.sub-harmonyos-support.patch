From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-27
Subject: [PATCH] config.sub: add HarmonyOS OS validation

Add harmonyos and linux-ohos to recognized OS names.

Applies to: CPython 3.9.0
---
--- a/config.sub	2020-10-05 23:07:58.000000000 +0800
+++ b/config.sub	2026-03-25 10:42:56.105046562 +0800
@@ -114,7 +114,7 @@
 # Here we must recognize all the valid KERNEL-OS combinations.
 maybe_os=`echo "$1" | sed 's/^\(.*\)-\([^-]*-[^-]*\)$/\2/'`
 case $maybe_os in
-  nto-qnx* | linux-gnu* | linux-android* | linux-dietlibc | linux-newlib* | \
+  nto-qnx* | linux-ohos* | linux-gnu* | linux-android* | linux-dietlibc | linux-newlib* | \
   linux-musl* | linux-uclibc* | uclinux-uclibc* | uclinux-gnu* | kfreebsd*-gnu* | \
   knetbsd*-gnu* | netbsd*-gnu* | netbsd*-eabi* | \
   kopensolaris*-gnu* | cloudabi*-eabi* | \
@@ -1421,6 +1421,9 @@
 	-linux-dietlibc)
 		os=-linux-dietlibc
 		;;
+	-linux-ohos)
+		os=-linux-ohos
+		;;
 	-linux*)
 		os=`echo $os | sed -e 's|linux|linux-gnu|'`
 		;;
@@ -1528,6 +1531,9 @@
 		;;
 	-none)
 		;;
+	-harmonyos)
+		os=-linux-ohos
+		;;
 	*)
 		# Get rid of the `-' at the beginning of $os.
 		os=`echo $os | sed 's/[^-]*-//'`
