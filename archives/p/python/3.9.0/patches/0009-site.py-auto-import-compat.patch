From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-27
Subject: [PATCH] site.py: auto-import HarmonyOS compatibility layer

Import _harmonyos_compat on HarmonyOS at Python startup.

Applies to: CPython 3.9.0
---
--- a/Lib/site.py	2020-10-05 23:07:58.000000000 +0800
+++ b/Lib/site.py	2026-03-27 10:22:28.380163125 +0800
@@ -562,6 +562,18 @@
     """
     global ENABLE_USER_SITE
 
+    # HarmonyOS compatibility layer - must be applied first
+    # This patches subprocess calls to work around SELinux restrictions
+    try:
+        import _harmonyos_compat
+        _harmonyos_compat._apply_compat_layer()
+    except ImportError:
+        pass  # Module not available (non-HarmonyOS build)
+    except Exception as e:
+        # Don't let compat layer break Python startup
+        if os.environ.get('HARMONYOS_SUBPROCESS_DEBUG') == '1':
+            print(f"[HarmonyOS-Compat] Error: {e}", file=sys.stderr)
+
     orig_path = sys.path[:]
     known_paths = removeduppaths()
     if orig_path != sys.path:
