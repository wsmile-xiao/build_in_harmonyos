+def _python_fork_exec(process_args, executable_list, close_fds, fds_to_keep,
+                      cwd, env_list,
+                      p2cread, p2cwrite, c2pread, c2pwrite,
+                      errread, errwrite,
+                      errpipe_read, errpipe_write,
+                      restore_signals, start_new_session,
+                      gid, gids, uid, child_umask,
