+            # -- Change working directory --
+            if cwd_bytes:
+                os.chdir(cwd_bytes)
+
+            # -- Set umask --
+            if child_umask >= 0:
+                os.umask(child_umask)
+
+            # -- Restore signals to SIG_DFL --
+            if restore_signals:
+                import signal as _sig
+                for sig_num in range(1, _sig.NSIG):
+                    try:
+                        _sig.signal(sig_num, _sig.SIG_DFL)
+                    except (OSError, ValueError):
+                        pass
+
+            # -- Start new session --
+            if start_new_session:
+                os.setsid()
+
+            # -- Set credentials --
+            if gids is not None:
+                os.setgroups(gids)
+            if gid is not None:
+                os.setgid(gid)
+            if uid is not None:
+                os.setuid(uid)
+
+            # -- Call preexec_fn --
+            reached_preexec = True
+            if preexec_fn is not None:
+                preexec_fn()
+
+            # -- Close all fds >= 3 except fds_to_keep --
+            if close_fds:
+                _py_close_open_fds(3, fds_to_keep)
+
+            # -- Try exec for each executable in the list --
+            saved_errno = 0
+            for exec_path in executable_list:
+                try:
+                    if env_list is not None:
+                        os.execve(exec_path, argv, env_list)
+                    else:
+                        os.execv(exec_path, argv)
+                except OSError as e:
+                    if e.errno not in (errno.ENOENT, errno.ENOTDIR) and saved_errno == 0:
+                        saved_errno = e.errno
+
+            # If we get here, all exec attempts failed.
+            # Write error info to errpipe_write (format matches C code).
+            if saved_errno:
+                hex_errno = format(saved_errno, 'x')
+                try:
+                    os.write(errpipe_write, b"OSError:" + hex_errno.encode() + b":noexec")
+                except OSError:
+                    pass
+            else:
+                try:
+                    os.write(errpipe_write, b"SubprocessError:0:")
+                except OSError:
+                    pass
+
+            os._exit(255)  # exec failed
+
+        except BaseException:
+            # Catch-all: write a generic error and exit
+            try:
+                os.write(errpipe_write, b"SubprocessError:0:Unexpected error in child")
+            except OSError:
+                pass
+            os._exit(255)
+
+    # ==================== Parent process ====================
+    if gc_was_enabled:
+        _gc.enable()
+
+    if pid == -1:
+        err = OSError('fork() failed')
+        err.errno = errno
+        raise err
+
+    return pid
