+    # executable_list is already a tuple of bytes (from _execute_child)
+    # env_list is already a list of bytes or None
+    # cwd will be encoded below
+
+    if cwd is not None:
+        cwd_bytes = os.fsencode(cwd)
+    else:
+        cwd_bytes = None
+
+    fds_to_keep = tuple(sorted(fds_to_keep))
+
+    # Disable GC before fork when preexec_fn is set (matches C gc.disable())
+    gc_was_enabled = False
+    if preexec_fn is not None:
+        import gc as _gc
+        gc_was_enabled = _gc.isenabled()
+        if gc_was_enabled:
+            _gc.disable()
+
+    try:
+        pid = os.fork()
+    except:
+        if gc_was_enabled:
+            _gc.enable()
+        raise
+
+    if pid == 0:
+        # ==================== Child process ====================
+        try:
+            # -- Make fds_to_keep inheritable --
+            for fd in fds_to_keep:
+                if fd != errpipe_write:
+                    try:
+                        os.set_inheritable(fd, True)
+                    except OSError:
+                        pass
+
+            # -- Close parent's pipe ends --
+            if p2cwrite != -1:
+                os.close(p2cwrite)
+            if c2pread != -1:
+                os.close(c2pread)
+            if errread != -1:
+                os.close(errread)
+            os.close(errpipe_read)
+
+            # -- Avoid dup2 overwriting stdin/stdout/stderr --
+            if c2pwrite == 0:
+                c2pwrite = os.dup(c2pwrite)
+                os.set_inheritable(c2pwrite, False)
+            while errwrite == 0 or errwrite == 1:
+                errwrite = os.dup(errwrite)
+                os.set_inheritable(errwrite, False)
+
+            # -- Dup fds for child: p2cread→0, c2pwrite→1, errwrite→2 --
+            if p2cread == 0:
+                os.set_inheritable(p2cread, True)
+            elif p2cread != -1:
+                os.dup2(p2cread, 0)
+
+            if c2pwrite == 1:
+                os.set_inheritable(c2pwrite, True)
+            elif c2pwrite != -1:
+                os.dup2(c2pwrite, 1)
+
+            if errwrite == 2:
+                os.set_inheritable(errwrite, True)
+            elif errwrite != -1:
+                os.dup2(errwrite, 2)
+
+            # On HarmonyOS, fd 1/2 may point to sockets (from the OpenDesk
+            # runtime) if not explicitly redirected. External programs like
+            # clang fail silently when writing to such fds. Redirect to
+            # /dev/null when the caller did not request redirection.
+            if _OHOS_PIPE_WORKAROUND:
+                devnull_fd = os.open(os.devnull, os.O_WRONLY)
+                devnull_r = os.open(os.devnull, os.O_RDONLY)
+                if p2cread == -1:
+                    os.dup2(devnull_r, 0)
+                os.close(devnull_r)
+                if c2pwrite == -1:
+                    os.dup2(devnull_fd, 1)
+                if errwrite == -1:
+                    os.dup2(devnull_fd, 2)
+                os.close(devnull_fd)
