+# HarmonyOS/OHOS platform detection for pipe workaround.
+# On HarmonyOS, pipes have a kernel-level bug where data written by a
+# child process (especially large programs like clang) can be silently
+# lost. Additionally, fd 1/2 may point to sockets (from the OpenDesk
+# runtime) which causes external programs to fail silently.
+# We work around this by using temporary files instead of pipes.
+_OHOS_PIPE_WORKAROUND = sys.platform.startswith(('ohos', 'harmonyos'))
+
+def _ohos_make_temp_pair(suffix=''):
+        """Create a temp file and return (read_fd, write_fd, cleanup_func).
+
+        Returns two fds: one for reading (parent side) and one for writing
+        (child side). They point to the same underlying file. The child
+        writes to write_fd, and after the child exits, the parent reads
+        from read_fd. cleanup_func() removes the temp file.
+
+        NOTE: tempfile module may not be available during Python build,
+        so we use a simple approach with os.open + a PID-based name.
+        """
+        import errno as _errno
+        tmpdir = os.environ.get('TMPDIR', '/tmp') or '/tmp'
+        # Try TMPDIR first, fall back to CWD if TMPDIR is read-only
+        path = os.path.join(tmpdir, 'py_sub_%d%s' % (os.getpid(), suffix))
+        try:
+            write_fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        except OSError:
+            # TMPDIR may be read-only on HarmonyOS, use CWD
+            path = 'py_sub_%d%s' % (os.getpid(), suffix)
+            write_fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        read_fd = os.open(path, os.O_RDONLY)
+        def cleanup():
+            try:
+                os.unlink(path)
+            except OSError:
+                pass
+        return read_fd, write_fd, cleanup
+
 
