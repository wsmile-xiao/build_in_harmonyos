+HARMONY_SDK_ROOT = None
+
+def ohos_sdk_root():
+    """Return the sysroot path of the HarmonyOS SDK (mirrors macosx_sdk_root logic)."""
+    global HARMONY_SDK_ROOT
+    if HARMONY_SDK_ROOT:
+        return HARMONY_SDK_ROOT
+
+    # Method 1: extract --sysroot from CFLAGS
+    cflags = sysconfig.get_config_var('CFLAGS') or ''
+    m = re.search(r'--sysroot=(\S+)', cflags)
+    if m is not None:
+        HARMONY_SDK_ROOT = m.group(1)
+        return HARMONY_SDK_ROOT
+
+    # Method 2: probe sysroot by invoking the Clang command (fallback)
+    cc = sysconfig.get_config_var('CC') or 'clang'
+    tmpfile = './setup_harmony_sysroot.%d' % os.getpid()
+    try:
+        os.unlink(tmpfile)
+    except OSError:
+        pass
+    # Execute Clang command and capture output
+    cmd = f'{cc} -v -E - </dev/null 2>{tmpfile} 1>/dev/null'
+    ret = run_command(cmd)
+    if ret == 0:
+        with open(tmpfile) as fp:
+            for line in fp.readlines():
+                # Match HarmonyOS sysroot characteristic path
+                if '../../sysroot/usr/include' in line and 'ignoring' not in line:
+                    # Extract the sysroot directory
+                    sysroot_rel = re.search(r'(\S+/llvm/bin/../../sysroot)', line)
+                    if sysroot_rel:
+                        HARMONY_SDK_ROOT = os.path.abspath(sysroot_rel.group(1))
+                        break
+    # Clean up temporary file
+    try:
+        os.unlink(tmpfile)
+    except OSError:
+        pass
+    
+    return HARMONY_SDK_ROOT
+
+def get_ohos_arch():
+    """Determine the HarmonyOS target architecture (pure builtins, no external deps)."""
+    try:
+        # Prefer os.uname (natively supported on HarmonyOS/Unix-like systems)
+        arch = os.uname().machine.lower()
+    except AttributeError:
+        # Fallback for non-Unix systems (should not be reached on HarmonyOS)
+        arch = platform.machine().lower()
+
+    # Architecture mapping (extend as needed for your SDK directories)
+    arch_map = {
+        "aarch64": "aarch64",
+        "arm64": "aarch64",
+        "armv8": "aarch64",
+        "armv8l": "aarch64",
+        "armv7": "arm32",
+        "armv7l": "arm32",
+        "arm": "arm32",
+        "x86_64": "x86_64",
+        "amd64": "x86_64"
+    }
+    return arch_map.get(arch, "aarch64")
+
 
