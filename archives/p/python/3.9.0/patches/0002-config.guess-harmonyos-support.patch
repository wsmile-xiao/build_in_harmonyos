From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-27
Subject: [PATCH] config.guess: add HarmonyOS system detection

Add HarmonyOS detection for aarch64/arm/x86_64 targets.

Applies to: CPython 3.9.0
---
--- a/config.guess	2020-10-05 23:07:58.000000000 +0800
+++ b/config.guess	2026-03-25 10:42:56.025048124 +0800
@@ -897,6 +897,27 @@
     i*86:Minix:*:*)
 	echo "$UNAME_MACHINE"-pc-minix
 	exit ;;
+    *:HarmonyOS:*:*)
+	# HarmonyOS/OpenHarmony detection
+	# Output triplet: {MACHINE}-unknown-linux-ohos (per SKILL.md convention)
+	case "$UNAME_MACHINE" in
+		aarch64|arm64)
+			echo "aarch64-unknown-linux-ohos"
+			;;
+		armv7*|arm*)
+			echo "arm-unknown-linux-ohos"
+			;;
+		x86_64|amd64)
+			echo "x86_64-unknown-linux-ohos"
+			;;
+		i?86)
+			echo "i686-unknown-linux-ohos"
+			;;
+		*)
+			echo "$UNAME_MACHINE-unknown-linux-ohos"
+			;;
+	esac
+	exit ;;
     aarch64:Linux:*:*)
 	echo "$UNAME_MACHINE"-unknown-linux-"$LIBC"
 	exit ;;
