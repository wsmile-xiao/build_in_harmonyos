+def _py_close_open_fds(start_fd, fds_to_keep):
+    """Close all open file descriptors >= start_fd except those in fds_to_keep.
+
+    Pure Python implementation equivalent to _posixsubprocess.c:_close_open_fds().
+    Uses /proc/self/fd on Linux/OHOS; falls back to brute-force otherwise.
+    """
+    keep_set = set(fds_to_keep)
+    try:
+        # Use /proc/self/fd for efficient fd enumeration (works on Linux/OHOS)
+        for fd_name in os.listdir('/proc/self/fd'):
+            try:
+                fd = int(fd_name)
+            except ValueError:
+                continue
+            if fd >= start_fd and fd not in keep_set:
+                try:
+                    os.close(fd)
+                except OSError:
+                    pass
+    except OSError:
+        # Fallback: brute-force close from start_fd to sysconf(_SC_OPEN_MAX)
+        try:
+            max_fd = os.sysconf('SC_OPEN_MAX')
+        except (OSError, AttributeError):
+            max_fd = 256
+        for fd in range(start_fd, max_fd):
+            if fd not in keep_set:
+                try:
+                    os.close(fd)
+                except OSError:
+                    pass
+
