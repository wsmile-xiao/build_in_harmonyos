+def _python_fork_exec(process_args, executable_list, close_fds, fds_to_keep,
+                      cwd, env_list, env,
+                      p2cread, p2cwrite, c2pread, c2pwrite,
+                      errread, errwrite,
+                      errpipe_read, errpipe_write,
+                      restore_signals, start_new_session,
+                      gid, gids, uid, child_umask,
+                      preexec_fn):
+    """Pure Python fallback for _posixsubprocess.fork_exec().
+
+    Implements the same contract: fork a child, set up fds/signals/credentials
+    in the child, exec the target program, and write errors to errpipe on
+    failure.  Returns the child PID in the parent; raises OSError if fork()
+    itself fails.
+
+    The errpipe error format is identical to the C implementation so that the
+    existing parent-side errpipe reading code in Popen._execute_child() works
+    without modification.
+    """
+    # --- Prepare data in the parent (matches C code: convert before fork) ---
+    # Convert process_args to bytes argv list
+    if process_args is not None:
+        argv = [os.fsencode(a) for a in process_args]
+    else:
+        argv = None
+
+    # executable_list is already a tuple of bytes (from _execute_child)
+    # env is the original env dict (or None) passed by the caller; env_list
+    # is the C-compatible list-of-bytes form (only used by the C
+    # _posixsubprocess.fork_exec).  We pass the dict to os.execve() because
+    # Python's os.execve() requires a mapping, not a list.
+    # cwd will be encoded below
+
+    if cwd is not None:
+        cwd_bytes = os.fsencode(cwd)
+    else:
+        cwd_bytes = None
+
+    fds_to_keep = tuple(sorted(fds_to_keep))
+
+    # Disable GC before fork when preexec_fn is set (matches C gc.disable())
+    gc_was_enabled = False
+    if preexec_fn is not None:
+        import gc as _gc
+        gc_was_enabled = _gc.isenabled()
+        if gc_was_enabled:
+            _gc.disable()
+
+    try:
+        pid = os.fork()
+    except OSError:
+        if gc_was_enabled:
+            _gc.enable()
+        raise
+
+    if pid == 0:
+        # ==================== Child process ====================
+        try:
+            # -- Make fds_to_keep inheritable --
+            for fd in fds_to_keep:
+                if fd != errpipe_write:
+                    try:
+                        os.set_inheritable(fd, True)
+                    except OSError:
+                        pass
+
+            # -- Close parent's pipe ends --
+            if p2cwrite != -1:
+                os.close(p2cwrite)
+            if c2pread != -1:
+                os.close(c2pread)
+            if errread != -1:
+                os.close(errread)
+            os.close(errpipe_read)
+
+            # -- Avoid dup2 overwriting stdin/stdout/stderr --
+            if c2pwrite == 0:
+                c2pwrite = os.dup(c2pwrite)
+                os.set_inheritable(c2pwrite, False)
+            while errwrite == 0 or errwrite == 1:
+                errwrite = os.dup(errwrite)
+                os.set_inheritable(errwrite, False)
+
+            # -- Dup fds for child: p2cread→0, c2pwrite→1, errwrite→2 --
+            if p2cread == 0:
+                os.set_inheritable(p2cread, True)
+            elif p2cread != -1:
+                os.dup2(p2cread, 0)
+
+            if c2pwrite == 1:
+                os.set_inheritable(c2pwrite, True)
+            elif c2pwrite != -1:
+                os.dup2(c2pwrite, 1)
+
+            if errwrite == 2:
+                os.set_inheritable(errwrite, True)
+            elif errwrite != -1:
+                os.dup2(errwrite, 2)
+
+            # -- Change working directory --
+            if cwd_bytes:
+                os.chdir(cwd_bytes)
+
+            # -- Set umask --
+            if child_umask >= 0:
+                os.umask(child_umask)
+
+            # -- Restore signals to SIG_DFL --
+            if restore_signals:
+                import signal as _sig
+                for sig_num in range(1, _sig.NSIG):
+                    try:
+                        _sig.signal(sig_num, _sig.SIG_DFL)
+                    except (OSError, ValueError):
+                        pass
+
+            # -- Start new session --
+            if start_new_session:
+                os.setsid()
+
+            # -- Set credentials --
+            if gids is not None:
+                os.setgroups(gids)
+            if gid is not None:
+                os.setgid(gid)
+            if uid is not None:
+                os.setuid(uid)
+
+            # -- Call preexec_fn --
+            reached_preexec = True
+            if preexec_fn is not None:
+                preexec_fn()
+
+            # -- Close all fds >= 3 except fds_to_keep --
+            if close_fds:
+                _py_close_open_fds(3, fds_to_keep)
+
+            # -- Try exec for each executable in the list --
+            saved_errno = 0
+            for exec_path in executable_list:
+                try:
+                    if env is not None:
+                        os.execve(exec_path, argv, env)
+                    else:
+                        os.execv(exec_path, argv)
+                except OSError as e:
+                    if e.errno not in (errno.ENOENT, errno.ENOTDIR) and saved_errno == 0:
+                        saved_errno = e.errno
+
+            # If we get here, all exec attempts failed.
+            # Write error info to errpipe_write (format matches C code).
+            if saved_errno:
+                hex_errno = format(saved_errno, 'x')
+                try:
+                    os.write(errpipe_write, b"OSError:" + hex_errno.encode() + b":noexec")
+                except OSError:
+                    pass
+            else:
+                try:
+                    os.write(errpipe_write, b"SubprocessError:0:")
+                except OSError:
+                    pass
+
+            os._exit(255)  # exec failed
+
+        except BaseException:
+            # Catch-all: write a generic error and exit
+            try:
+                os.write(errpipe_write, b"SubprocessError:0:Unexpected error in child")
+            except OSError:
+                pass
+            os._exit(255)
+
+    # ==================== Parent process ====================
+    if gc_was_enabled:
+        _gc.enable()
+
+    return pid
+
+
 # Exception classes used by this module.
 class SubprocessError(Exception): pass
 
