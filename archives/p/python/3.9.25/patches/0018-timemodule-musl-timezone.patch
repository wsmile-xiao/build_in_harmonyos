From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-28
Subject: [PATCH] HarmonyOS support: Modules/timemodule.c

Applies to: CPython 3.9.25
---
--- Modules/timemodule.c	2025-11-01 02:40:52.000000000 +0800
+++ Modules/timemodule.c	2026-03-28 16:00:35.794597031 +0800
@@ -534,7 +534,7 @@
 #endif
 }
 
-#if defined(__linux__) && !defined(__GLIBC__)
+#if (defined(__linux__) || defined(__OHOS__)) && !defined(__GLIBC__)
 static const char *utc_string = NULL;
 #endif
 
@@ -585,7 +585,7 @@
             if (p->tm_zone == NULL) {
                 return 0;
             }
-#if defined(__linux__) && !defined(__GLIBC__)
+#if (defined(__linux__) || defined(__OHOS__)) && !defined(__GLIBC__)
             // Make an attempt to return the C library's own timezone strings to
             // it. musl refuses to process a tm_zone field unless it produced
             // it. See issue #34672.
@@ -1974,7 +1974,7 @@
     }
     initialized = 1;
 
-#if defined(__linux__) && !defined(__GLIBC__)
+#if (defined(__linux__) || defined(__OHOS__)) && !defined(__GLIBC__)
     struct tm tm;
     const time_t zero = 0;
     if (gmtime_r(&zero, &tm) != NULL)
