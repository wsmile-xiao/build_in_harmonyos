From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-28
Subject: [PATCH] HarmonyOS support: Lib/test/test_compileall.py

Applies to: CPython 3.9.25
---
--- Lib/test/test_compileall.py	2025-11-01 02:40:52.000000000 +0800
+++ Lib/test/test_compileall.py	2026-03-28 16:00:36.034598437 +0800
@@ -867,6 +867,7 @@
         # only for more than one optimization level
         self.assertRunNotOK(self.directory, "-o 1", "--hardlink-dupes")
 
+    @skipUnless(_can_hardlink, 'Filesystem does not support hardlinks')
     def test_hardlink(self):
         # 'a = 0' code produces the same bytecode for the 3 optimization
         # levels. All three .pyc files must have the same inode (hardlinks).
@@ -908,6 +909,8 @@
     # Test hardlink_dupes parameter of compileall.compile_dir()
 
     def setUp(self):
+        if not _can_hardlink:
+            self.skipTest('Filesystem does not support hardlinks')
         self.path = None
 
     @contextlib.contextmanager
