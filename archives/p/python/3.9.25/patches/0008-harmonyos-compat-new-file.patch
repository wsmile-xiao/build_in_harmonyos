From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-28
Subject: [PATCH] HarmonyOS support: Lib/_harmonyos_compat.py

Applies to: CPython 3.9.25
---
--- /dev/null	2026-03-26 09:26:33.352284687 +0800
+++ Lib/_harmonyos_compat.py	2026-03-28 16:00:35.482605156 +0800
@@ -0,0 +1,136 @@
+"""
+HarmonyOS Subprocess Compatibility Layer
+
+This module provides compatibility utilities for subprocess execution
+on HarmonyOS/OpenHarmony systems where SELinux domain transitions prevent
+child processes from executing SDK binaries directly.
+
+subprocess.Popen is NOT patched because CPython's subprocess module already
+uses posix_spawn on HarmonyOS (patch 0011), which works correctly.
+Only os.system is patched for _bootsubprocess.py build-time use.
+
+Debug: Set HARMONYOS_SUBPROCESS_DEBUG=1 to enable logging.
+"""
+
+import os
+import sys
+
+_DEBUG = os.environ.get('HARMONYOS_SUBPROCESS_DEBUG', '0') == '1'
+
+
+def _log(msg):
+    if _DEBUG:
+        print(f"[HarmonyOS-Compat] {msg}", file=sys.stderr)
+
+
+def _is_harmonyos():
+    platform = sys.platform.lower()
+    return 'harmonyos' in platform or 'ohos' in platform
+
+
+def _wrap_with_pipe(cmd_str):
+    """
+    Wrap command with pipe syntax to bypass SELinux restrictions.
+    Format: set -o pipefail; {cmd} 2>&1 | cat
+    NOTE: Only use for commands that do NOT need stdin interaction.
+    """
+    return f"set -o pipefail; {cmd_str} 2>&1 | cat"
+
+
+def _apply_compat_layer():
+    """
+    Apply HarmonyOS compatibility patches.
+
+    Only os.system is patched because:
+    - It is used by _bootsubprocess.py during setup.py builds
+    - os.system() calls never need stdin interaction
+    - subprocess.Popen is NOT patched because posix_spawn works correctly
+      on HarmonyOS (see patch 0011), and patching it would break
+      stdin-dependent operations (e.g., interactive tests).
+    """
+    if not _is_harmonyos():
+        _log("Not HarmonyOS, skipping compatibility layer")
+        return
+
+    _log("Detected HarmonyOS, applying compatibility layer")
+
+    _original_os_system = os.system
+
+    def _wrapped_os_system(cmd):
+        if cmd:
+            wrapped_cmd = _wrap_with_pipe(cmd)
+            _log(f"os.system: '{cmd[:60]}...' -> pipe wrapped")
+            return _original_os_system(wrapped_cmd)
+        return _original_os_system(cmd)
+
+    os.system = _wrapped_os_system
+    _log("Patched: os.system")
+    _log("Compatibility layer applied successfully")
