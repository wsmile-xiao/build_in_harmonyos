 from test.support import skip_if_buggy_ucrt_strfptime
 
+# === HarmonyOS (OHOS) Compatibility ===
+# HarmonyOS kernel does not support certain clock_gettime variants
+# (CLOCK_PROCESS_CPUTIME_ID, CLOCK_THREAD_CPUTIME_ID) and clock_settime.
+# Calling these triggers SIGSYS (signal 31) which kills the process.
+# Detect at import time which functions work to avoid crashing tests.
+_is_ohos = sys.platform == 'ohos'
+_process_time_works = True
+_thread_time_works = True
+if _is_ohos:
+    try:
+        time.process_time()
+    except (OSError, AttributeError):
+        _process_time_works = False
+    if hasattr(time, 'thread_time'):
+        try:
+            time.thread_time()
+        except (OSError, AttributeError):
+            _thread_time_works = False
+
 # Max year is only limited by the size of C int.
 SIZEOF_INT = sysconfig.get_config_var('SIZEOF_INT') or 4
 TIME_MAXYEAR = (1 << 8 * SIZEOF_INT - 1) - 1
@@ -64,6 +83,9 @@
