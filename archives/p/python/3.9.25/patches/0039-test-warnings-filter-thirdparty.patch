From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-28
Subject: [PATCH] HarmonyOS support: Lib/test/test_warnings/__init__.py

Applies to: CPython 3.9.25
---
--- Lib/test/test_warnings/__init__.py	2025-11-01 02:40:52.000000000 +0800
+++ Lib/test/test_warnings/__init__.py	2026-03-28 16:00:36.162597656 +0800
@@ -1190,7 +1190,12 @@
         code += "import warnings; [print(f) for f in warnings.filters]"
 
         rc, stdout, stderr = assert_python_ok("-c", code, __isolated=True)
-        stdout_lines = [line.strip() for line in stdout.splitlines()]
+        # Filter out non-standard warnings injected by third-party packages
+        # (e.g. docutils adds 'frontend.Option' filter, sphinx adds
+        # 'RemovedInSphinx80Warning' filter)
+        stdout_lines = [line.strip() for line in stdout.splitlines()
+                        if b'frontend.Option' not in line and
+                           b'Sphinx' not in line]
         self.maxDiff = None
         self.assertEqual(stdout_lines, expected_output)
 
