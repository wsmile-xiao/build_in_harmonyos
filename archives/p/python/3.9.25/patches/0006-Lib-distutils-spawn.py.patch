diff -ruN a/Lib/distutils/spawn.py b/Lib/distutils/spawn.py
--- a/Lib/distutils/spawn.py	2025-11-01 02:40:52.000000000 +0800
+++ b/Lib/distutils/spawn.py	2026-03-30 19:32:16.082433750 +0800
@@ -75,6 +75,29 @@
             env = dict(os.environ,
                        MACOSX_DEPLOYMENT_TARGET=cur_target)
 
+    # HarmonyOS: SELinux bypass for extension module compilation.
+    # On HarmonyOS, the Python process runs in the adhoc_bin SELinux domain
+    # which cannot fork/exec SDK binaries (clang, llvm-ar, etc.) that have
+    # the hnp_file security context. When HARMONYOS_BUILD_SCRIPT is set,
+    # write the complete command to the script file instead of executing.
+    # The build script will be executed later by the shell (hishell_hap
+    # domain) which has proper permissions to run SDK binaries.
+    harmonyos_build_script = os.environ.get('HARMONYOS_BUILD_SCRIPT')
+    if harmonyos_build_script:
+        import shlex
+        cmd_str = ' '.join(shlex.quote(arg) for arg in cmd)
+        if env is not None:
+            env_str = ' '.join(
+                '%s=%s' % (k, shlex.quote(str(v)))
+                for k, v in env.items()
+            )
+            cmd_str = env_str + ' ' + cmd_str
+        with open(harmonyos_build_script, 'a') as f:
+            f.write(cmd_str + '\n')
+        log.debug('HarmonyOS: command deferred to build script: %s',
+                  cmd_str)
+        return
+
     try:
         proc = subprocess.Popen(cmd, env=env)
         proc.wait()
