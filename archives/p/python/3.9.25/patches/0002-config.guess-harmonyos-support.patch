From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-28
Subject: [PATCH] HarmonyOS support: config.guess

Applies to: CPython 3.9.25
---
--- config.guess	2025-11-01 02:40:52.000000000 +0800
+++ config.guess	2026-03-28 16:01:43.274596406 +0800
@@ -1738,6 +1738,19 @@
 EOF
 fi
 
+
+# HarmonyOS detection
+case "$UNAME_SYSTEM" in
+    HarmonyOS)
+        # HarmonyOS uses musl libc and LLVM/Clang toolchain
+        case "$UNAME_MACHINE" in
+            aarch64)  echo "$UNAME_MACHINE-unknown-linux-ohos" ;;
+            arm*)     echo "$UNAME_MACHINE-unknown-linux-ohos" ;;
+            x86_64)   echo "$UNAME_MACHINE-unknown-linux-ohos" ;;
+            *)        echo "$UNAME_MACHINE-unknown-linux-ohos" ;;
+        esac
+        exit ;;
+esac
 exit 1
 
 # Local variables:
