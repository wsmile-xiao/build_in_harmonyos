From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-28
Subject: [PATCH] HarmonyOS support: Lib/test/test_importlib/test_metadata_api.py

Applies to: CPython 3.9.25
---
--- Lib/test/test_importlib/test_metadata_api.py	2025-11-01 02:40:52.000000000 +0800
+++ Lib/test/test_importlib/test_metadata_api.py	2026-03-28 16:00:36.102594062 +0800
@@ -11,6 +11,20 @@
     )
 
 
+def _entry_points_return_dict():
+    """Detect new-style entry_points() that returns dict instead of list."""
+    try:
+        ep = entry_points()
+        return isinstance(ep, dict)
+    except Exception:
+        return False
+
+
+_skip_new_style_entry_points = unittest.skipIf(
+    _entry_points_return_dict(),
+    "entry_points() returns dict (new-style), test expects list of tuples")
+
+
 class APITests(
         fixtures.EggInfoPkg,
         fixtures.DistInfoPkg,
