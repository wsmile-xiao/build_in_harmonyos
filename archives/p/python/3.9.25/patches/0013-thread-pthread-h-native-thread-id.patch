From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-28
Subject: [PATCH] HarmonyOS support: Python/thread_pthread.h

Applies to: CPython 3.9.25
---
--- Python/thread_pthread.h	2025-11-01 02:40:52.000000000 +0800
+++ Python/thread_pthread.h	2026-03-28 16:00:35.634596562 +0800
@@ -13,7 +13,7 @@
 #endif
 #include <signal.h>
 
-#if defined(__linux__)
+#if defined(__linux__) || defined(__OHOS__)
 #   include <sys/syscall.h>     /* syscall(SYS_gettid) */
 #elif defined(__FreeBSD__)
 #   include <pthread_np.h>      /* pthread_getthreadid_np() */
@@ -341,7 +341,7 @@
 #ifdef __APPLE__
     uint64_t native_id;
     (void) pthread_threadid_np(NULL, &native_id);
-#elif defined(__linux__)
+#elif defined(__linux__) || defined(__OHOS__)
     pid_t native_id;
     native_id = syscall(SYS_gettid);
 #elif defined(__FreeBSD__)
