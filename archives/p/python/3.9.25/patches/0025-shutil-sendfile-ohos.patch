From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-28
Subject: [PATCH] HarmonyOS support: Lib/shutil.py

Applies to: CPython 3.9.25
---
--- Lib/shutil.py	2025-11-01 02:40:52.000000000 +0800
+++ Lib/shutil.py	2026-03-28 16:00:36.006602656 +0800
@@ -50,7 +50,7 @@
     import nt
 
 COPY_BUFSIZE = 1024 * 1024 if _WINDOWS else 64 * 1024
-_USE_CP_SENDFILE = hasattr(os, "sendfile") and sys.platform.startswith("linux")
+_USE_CP_SENDFILE = hasattr(os, "sendfile") and sys.platform.startswith(("linux", "ohos"))
 _HAS_FCOPYFILE = posix and hasattr(posix, "_fcopyfile")  # macOS
 
 # CMD defaults in Windows 10
