From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-28
Subject: [PATCH] HarmonyOS support: Lib/sysconfig.py

Applies to: CPython 3.9.25
---
--- Lib/sysconfig.py	2025-11-01 02:40:52.000000000 +0800
+++ Lib/sysconfig.py	2026-03-28 16:00:35.450595937 +0800
@@ -667,6 +667,10 @@
         # i386, etc.
         # XXX what about Alpha, SPARC, etc?
         return  "%s-%s" % (osname, machine)
+    elif osname.startswith("harmonyos") or osname.startswith("ohos"):
+        # HarmonyOS/OpenHarmony: similar to Linux, release contains spaces
+        # which breaks build directory paths, so we skip it
+        return "ohos-%s" % (machine,)
     elif osname[:5] == "sunos":
         if release[0] >= "5":           # SunOS 5 == Solaris 2
             osname = "solaris"
