From: OpenHarmony PC Developer Community <dev@openharmony.org>
Date: 2026-03-28
Subject: [PATCH] HarmonyOS support: Lib/multiprocessing/util.py

Applies to: CPython 3.9.25
---
--- Lib/multiprocessing/util.py	2025-11-01 02:40:52.000000000 +0800
+++ Lib/multiprocessing/util.py	2026-03-28 16:00:35.702596875 +0800
@@ -106,7 +106,7 @@
 # Abstract socket support
 
 def _platform_supports_abstract_sockets():
-    if sys.platform == "linux":
+    if sys.platform == "linux" or sys.platform.startswith(("ohos", "harmonyos")):
         return True
     if hasattr(sys, 'getandroidapilevel'):
         return True
