+def _ptmx_available():
+    """Check if /dev/ptmx is accessible (may be blocked by MAC policy)."""
+    try:
+        fd = os.open('/dev/ptmx', os.O_RDWR)
+        os.close(fd)
+        return True
+    except OSError:
+        return False
+
+_skip_no_ptmx = unittest.skipIf(not _ptmx_available(),
+                                 "/dev/ptmx not accessible (MAC policy)")
+
