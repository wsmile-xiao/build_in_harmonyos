--- Python-3.12.9.orig/config.guess	2026-03-27 11:33:24.288163282 +0800
+++ Python-3.12.9/config.guess	2026-03-27 11:33:45.028165469 +0800
@@ -966,6 +966,27 @@
     *:Minix:*:*)
 	GUESS=$UNAME_MACHINE-unknown-minix
 	;;
+    *:HarmonyOS:*:*)
+	# HarmonyOS/OpenHarmony detection
+	# Output triplet: {MACHINE}-unknown-linux-ohos (per SKILL.md convention)
+	case "$UNAME_MACHINE" in
+		aarch64|arm64)
+			GUESS=aarch64-unknown-linux-ohos
+			;;
+		armv7*|arm*)
+			GUESS=arm-unknown-linux-ohos
+			;;
+		x86_64|amd64)
+			GUESS=x86_64-unknown-linux-ohos
+			;;
+		i?86)
+			GUESS=i686-unknown-linux-ohos
+			;;
+		*)
+			GUESS=$UNAME_MACHINE-unknown-linux-ohos
+			;;
+	esac
+	;;
     aarch64:Linux:*:*)
 	GUESS=$UNAME_MACHINE-unknown-linux-$LIBC
 	;;
