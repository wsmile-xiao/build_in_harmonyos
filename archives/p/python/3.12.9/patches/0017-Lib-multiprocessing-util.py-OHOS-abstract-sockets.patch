From: OpenDesk <opendesk@openharmony.org>
Date: Thu, 27 Mar 2026 03:20:00 +0800
Subject: [PATCH] Lib/multiprocessing/util.py: HarmonyOS abstract sockets

Add HarmonyOS platform detection to _platform_supports_abstract_sockets().

Files modified:
  -3.12.9.orig/Lib/multiprocessing/util.py	2025-02-04 22:38:38.000000000 +0800
---
--- Python-3.12.9.orig/Lib/multiprocessing/util.py	2025-02-04 22:38:38.000000000 +0800
+++ Python-3.12.9/Lib/multiprocessing/util.py	2026-03-27 11:41:34.040162969 +0800
@@ -106,7 +106,7 @@
 # Abstract socket support
 
 def _platform_supports_abstract_sockets():
-    if sys.platform == "linux":
+    if sys.platform == "linux" or sys.platform.startswith(("ohos", "harmonyos")):
         return True
     if hasattr(sys, 'getandroidapilevel'):
         return True

