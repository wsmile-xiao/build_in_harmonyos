From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HarmonyOS Porting <porting@harmonyos.org>
Date: Fri, 27 Mar 2026 12:00:00 +0800
Subject: [PATCH 19/21] Modules/posixmodule.c: enable fallocate on HarmonyOS

HarmonyOS provides fallocate() via its Linux-based kernel. Enable the
os_fallocate_impl function's Linux code path for __OHOS__.

Adapted from Python 3.9 port patch 0018.
---
 Modules/posixmodule.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Modules/posixmodule.c b/Modules/posixmodule.c
--- a/Modules/posixmodule.c
+++ b/Modules/posixmodule.c
@@ -11069,7 +11069,7 @@
     #endif
 
 #else
-#ifdef __linux__
+#if defined(__linux__) || defined(__OHOS__)
     if (offobj == Py_None) {
         do {
             Py_BEGIN_ALLOW_THREADS
