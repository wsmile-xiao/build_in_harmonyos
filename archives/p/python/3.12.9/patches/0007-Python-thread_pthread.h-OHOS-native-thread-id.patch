From: HarmonyOS Python Porting <porting@harmonyos.com>
Date: Thu, 27 Mar 2026 11:00:00 +0800
Subject: [PATCH 07/10] Python/thread_pthread.h: Add __OHOS__ native thread
 ID support

HarmonyOS provides the same syscall(SYS_gettid) interface as Linux
for obtaining the native thread ID. Add __OHOS__ alongside __linux__
in both the syscall header include block and the
PyThread_get_thread_native_id() implementation.

Upstream-Status: Inappropriate [HarmonyOS specific]
---
 Python/thread_pthread.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Python/thread_pthread.h b/Python/thread_pthread.h
index xxxxxxxx..xxxxxxx 100644
--- a/Python/thread_pthread.h
+++ b/Python/thread_pthread.h
@@ -15,7 +15,7 @@
 #endif
 #include <signal.h>
 
-#if defined(__linux__)
+#if defined(__linux__) || defined(__OHOS__)
 #   include <sys/syscall.h>     /* syscall(SYS_gettid) */
 #elif defined(__FreeBSD__)
 #   include <pthread_np.h>      /* pthread_getthreadid_np() */
@@ -332,7 +332,7 @@ PyThread_get_thread_native_id(void)
 #ifdef __APPLE__
     uint64_t native_id;
     (void) pthread_threadid_np(NULL, &native_id);
-#elif defined(__linux__)
+#elif defined(__linux__) || defined(__OHOS__)
     pid_t native_id;
     native_id = syscall(SYS_gettid);
 #elif defined(__FreeBSD__)
