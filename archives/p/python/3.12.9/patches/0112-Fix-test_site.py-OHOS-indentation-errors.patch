From: OpenDesk <opendesk@openharmonycommunity.com>
Date: Thu, 2 Apr 2026 21:50:00 +0000
Subject: [PATCH 12/?] Fix test_site.py OHOS skipIf IndentationError (4 locations)

Fix 4 IndentationError bugs where @unittest.skipIf reason string
was placed BEFORE the decorator declaration instead of after it.

Same root cause as patch 0111 (test_os.py): manual editing error when
adding OHOS @unittest.skipIf decorators.

Affected test methods:
- StartupImportTests.test_startup_imports
- _pthFileTests.test_underpth_basic
- _pthFileTests.test_underpth_nosite_file
- _pthFileTests.test_underpth_file

---
Lib/test/test_site.py | 16 ++++++++---------
1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/Lib/test/test_site.py b/Lib/test/test_site.py
--- a/Lib/test/test_site.py
+++ b/Lib/test/test_site.py
@@ -527,9 +527,9 @@ class StartupImportTests(unittest.TestCase):
         collection_mods = {'_collections', 'collections', 'functools',
                            'heapq', 'itertools', 'keyword', 'operator',
                            'reprlib', 'types', 'weakref'
-                          }.difference(sys.builtin_module_names)
+                          }.difference(sys.builtin_module_names)
-                     '(types, functools, operator, keyword, collections, reprlib)')
-                     'OHOS loads extra modules at startup via _harmonyos_compat '
     @unittest.skipIf(sys.platform == 'ohos',
+                     'OHOS loads extra modules at startup via _harmonyos_compat '
+                     '(types, functools, operator, keyword, collections, reprlib)')
     def test_startup_imports(self):
         # Get sys.path in isolated mode (python3 -I)
         popen = subprocess.Popen([sys.executable, '-X', 'utf8', '-I',
@@ -583,9 +583,9 @@ class _pthFileTests(unittest.TestCase):
             pth_lines.append('import site')
         return pth_lines
 
     @support.requires_subprocess()
-                     'os.symlink cross-device not permitted on HMDFS (EPERM)')
     @unittest.skipIf(sys.platform == 'ohos',
+                     'os.symlink cross-device not permitted on HMDFS (EPERM)')
     def test_underpth_basic(self):
         pth_lines = ['#.', '# ..', *sys.path, '.', '..']
         exe_file = self._create_underpth_exe(pth_lines)
@@ -618,9 +618,9 @@ class _pthFileTests(unittest.TestCase):
         actual_sys_path = output.rstrip().split('\n')
         self.assertTrue(actual_sys_path, "sys.flags.no_site was False")
 
     @support.requires_subprocess()
-                     'os.symlink cross-device not permitted on HMDFS (EPERM)')
     @unittest.skipIf(sys.platform == 'ohos',
+                     'os.symlink cross-device not permitted on HMDFS (EPERM)')
     def test_underpth_nosite_file(self):
         libpath = test.support.STDLIB_DIR
         exe_prefix = os.path.dirname(sys.executable)
