From: OpenDesk <opendesk@openharmony.org>
Date: Thu, 27 Mar 2026 03:20:00 +0800
Subject: [PATCH] Lib/subprocess.py: HarmonyOS posix_spawn support

Force posix_spawn() on HarmonyOS by: (1) adding _IS_HARMONYOS flag, (2) making _use_posix_spawn() return True on HarmonyOS/musl, (3) widening the posix_spawn fast path to allow close_fds=True and executables without directory components, (4) using /system/bin/sh as default shell.

Files modified:
  -3.12.9.orig/Lib/subprocess.py	2025-02-04 22:38:38.000000000 +0800
---
--- Python-3.12.9.orig/Lib/subprocess.py	2025-02-04 22:38:38.000000000 +0800
+++ Python-3.12.9/Lib/subprocess.py	2026-03-27 11:41:56.392163125 +0800
@@ -73,6 +73,10 @@
     _mswindows = True
 
 # wasm32-emscripten and wasm32-wasi do not support processes
+
+# HarmonyOS platform detection for subprocess workarounds
+_IS_HARMONYOS = sys.platform.startswith(('ohos', 'harmonyos'))
+
 _can_fork_exec = sys.platform not in {"emscripten", "wasi"}
 
 if _mswindows:
@@ -716,6 +720,12 @@
         # and properly reports errors
         return True
 
+    if _IS_HARMONYOS:
+        # HarmonyOS: fork+exec is broken due to SELinux domain transitions.
+        # posix_spawn() (vfork-based) is explicitly allowed by the
+        # SELinux policy and is the only viable subprocess mechanism.
+        return True
+
     # Check libc name and runtime libc version
     try:
         ver = os.confstr('CS_GNU_LIBC_VERSION')
@@ -736,7 +746,9 @@
         # to the parent process).
     except (AttributeError, ValueError, OSError):
         # os.confstr() or CS_GNU_LIBC_VERSION value not available
-        pass
+        # This likely means musl libc (Alpine Linux, HarmonyOS, OpenWrt, etc.).
+        # musl's posix_spawn() properly reports errors and is safe to use.
+        return True
 
     # By default, assume that posix_spawn() does not properly report errors.
     return False
@@ -1819,8 +1831,12 @@
 
             if shell:
                 # On Android the default shell is at '/system/bin/sh'.
-                unix_shell = ('/system/bin/sh' if
-                          hasattr(sys, 'getandroidapilevel') else '/bin/sh')
+                if hasattr(sys, 'getandroidapilevel'):
+                    unix_shell = '/system/bin/sh'
+                elif _IS_HARMONYOS:
+                    unix_shell = '/system/bin/sh' if os.path.exists('/system/bin/sh') else '/bin/sh'
+                else:
+                    unix_shell = '/bin/sh'
                 args = [unix_shell, "-c"] + args
                 if executable:
                     args[0] = executable
@@ -1831,9 +1847,10 @@
             sys.audit("subprocess.Popen", executable, args, cwd, env)
 
             if (_USE_POSIX_SPAWN
-                    and os.path.dirname(executable)
+                    and (os.path.dirname(executable)
+                         or _IS_HARMONYOS)
                     and preexec_fn is None
-                    and not close_fds
+                    and (not close_fds or _IS_HARMONYOS)
                     and not pass_fds
                     and cwd is None
                     and (p2cread == -1 or p2cread > 2)

-- 
