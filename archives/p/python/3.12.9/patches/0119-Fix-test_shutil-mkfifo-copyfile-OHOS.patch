From: OHOS Dev <dev@ohos.com>
Subject: [PATCH 0119] Fix test_shutil mkfifo/rmtree/copyfile failures on OHOS

Two fixes in test_shutil.py:

1. test_rmtree_on_named_pipe: os.mkfifo() is blocked by SELinux/HMAC on
   OHOS (PermissionError). The sibling test_copyfile_named_pipe already
   has a try/except skipTest pattern; add an equivalent skipIf decorator.

2. test_copyfile_nonexistent_dir: HMDFS silently ignores trailing slash
   in paths, so open('does_not_exist/', 'wb') succeeds instead of raising
   FileNotFoundError. Add OHOS to the existing platform skip list.

---
 Lib/test/test_shutil.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Lib/test/test_shutil.py b/Lib/test/test_shutil.py
index abcdef..1234567 100644
--- a/Lib/test/test_shutil.py
+++ b/Lib/test/test_shutil.py
@@ -673,6 +673,8 @@ class TestRmTree(BaseTest, unittest.TestCase):
     @unittest.skipUnless(hasattr(os, "mkfifo"), 'requires os.mkfifo()')
     @unittest.skipIf(sys.platform == "vxworks",
                     "fifo requires special path on VxWorks")
+    @unittest.skipIf(sys.platform == "ohos",
+                    "mkfifo() blocked by SELinux/HMAC on OHOS")
     def test_rmtree_on_named_pipe(self):
         os.mkfifo(TESTFN)
         try:
@@ -1537,7 +1539,7 @@ class TestCopy(BaseTest):
     # gh-92670: The test uses a trailing slash to force the OS consider
     # the path as a directory, but on AIX the trailing slash has no effect
     # and is considered as a file.
-    @unittest.skipIf(MACOS or SOLARIS or _winapi, 'On MACOS, Solaris and Windows the errors are not confusing (though different)')
+    @unittest.skipIf(MACOS or SOLARIS or _winapi or sys.platform == "ohos", 'On MACOS, Solaris, Windows and OHOS the errors are not confusing')
     @unittest.skipIf(AIX, 'Not valid on AIX, see gh-92670')
     def test_copyfile_nonexistent_dir(self):

