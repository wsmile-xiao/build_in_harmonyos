From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HarmonyOS Porting <porting@harmonyos.org>
Date: Fri, 27 Mar 2026 12:00:00 +0800
Subject: [PATCH 20/21] HarmonyOS: fix remaining MISSING_ADAPTATION_SCAN items

This patch addresses remaining unfixed items from the missing adaptation
scan for HarmonyOS:

- Python/pylifecycle.c: Add __OHOS__ to is_valid_fd() preprocessor
  conditions so fd validation uses fcntl(F_GETFD) or dup() on HarmonyOS
  (same approach as Linux).
- Lib/shutil.py: Enable sendfile zero-copy optimization on HarmonyOS.
- Lib/tempfile.py: Add HarmonyOS-specific temp directory candidates
  (/tmp, /data/local/tmp, /var/tmp).
- Lib/uuid.py: Add /system/bin and /bin to MAC address lookup paths
  (HarmonyOS stores network tools in /system/bin).
- configure.ac: Skip lchmod detection for HarmonyOS (MACHDEP=ohos),
  since HarmonyOS disallows changing the mode of symbolic links.
- configure: Same lchmod skip for generated configure script.

Adapted from Python 3.9 port patch 0023.
---
 Python/pylifecycle.c | 4 ++++-
 Lib/shutil.py         | 2 +-
 Lib/tempfile.py       | 2 ++
 Lib/uuid.py           | 2 ++
 configure             | 2 +-
 configure.ac          | 2 +-
 6 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/Python/pylifecycle.c b/Python/pylifecycle.c
--- a/Python/pylifecycle.c
+++ b/Python/pylifecycle.c
@@ -2335,9 +2335,10 @@
 #if defined(F_GETFD) && ( \
         defined(__linux__) || \
         defined(__APPLE__) || \
+        defined(__OHOS__) || \
         defined(__wasm__))
     return fcntl(fd, F_GETFD) >= 0;
-#elif defined(__linux__)
+#elif defined(__linux__) || defined(__OHOS__)
     int fd2 = dup(fd);
     if (fd2 >= 0) {
         close(fd2);
diff --git a/Lib/shutil.py b/Lib/shutil.py
--- a/Lib/shutil.py
+++ b/Lib/shutil.py
@@ -48,7 +48,7 @@
 COPY_BUFSIZE = 1024 * 1024 if _WINDOWS else 64 * 1024
 # This should never be removed, see rationale in:
 # https://bugs.python.org/issue43743#msg393429
-_USE_CP_SENDFILE = hasattr(os, "sendfile") and sys.platform.startswith("linux")
+_USE_CP_SENDFILE = hasattr(os, "sendfile") and sys.platform.startswith(("linux", "ohos"))
 _HAS_FCOPYFILE = posix and hasattr(posix, "_fcopyfile")  # macOS
 
 # CMD defaults in Windows 10
diff --git a/Lib/tempfile.py b/Lib/tempfile.py
--- a/Lib/tempfile.py
+++ b/Lib/tempfile.py
@@ -169,6 +169,8 @@
         dirlist.extend([ _os.path.expanduser(r'~\AppData\Local\Temp'),
                          _os.path.expandvars(r'%SYSTEMROOT%\Temp'),
                          r'c:\temp', r'c:\tmp', r'\temp', r'\tmp' ])
+    elif _sys.platform.startswith(('ohos', 'harmonyos')):
+        dirlist.extend(['/tmp', '/data/local/tmp', '/var/tmp'])
     else:
         dirlist.extend([ '/tmp', '/var/tmp', '/usr/tmp' ])
 
diff --git a/Lib/uuid.py b/Lib/uuid.py
--- a/Lib/uuid.py
+++ b/Lib/uuid.py
@@ -363,6 +363,8 @@
     try:
         path_dirs = os.environ.get('PATH', os.defpath).split(os.pathsep)
         path_dirs.extend(['/sbin', '/usr/sbin'])
+        if sys.platform.startswith(('ohos', 'harmonyos')):
+            path_dirs.extend(['/system/bin', '/bin'])
         executable = shutil.which(command, path=os.pathsep.join(path_dirs))
         if executable is None:
             return None
diff --git a/configure b/configure
--- a/configure
+++ b/configure
@@ -18660,7 +18660,7 @@
 # Force lchmod off for Linux. Linux disallows changing the mode of symbolic
 # links. Some libc implementations have a stub lchmod implementation that always
 # returns an error.
-if test "$MACHDEP" != linux; then
+if test "$MACHDEP" != linux && test "$MACHDEP" != ohos; then
   ac_fn_c_check_func "$LINENO" "lchmod" "ac_cv_func_lchmod"
 if test "x$ac_cv_func_lchmod" = xyes
 then :
diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -4948,7 +4948,7 @@
 # Force lchmod off for Linux. Linux disallows changing the mode of symbolic
 # links. Some libc implementations have a stub lchmod implementation that always
 # returns an error.
-if test "$MACHDEP" != linux; then
+if test "$MACHDEP" != linux && test "$MACHDEP" != ohos; then
   AC_CHECK_FUNCS([lchmod])
 fi
 
