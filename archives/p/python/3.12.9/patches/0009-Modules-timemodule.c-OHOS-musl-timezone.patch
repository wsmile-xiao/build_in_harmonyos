From: HarmonyOS Python Porting <porting@harmonyos.com>
Date: Thu, 27 Mar 2026 11:00:00 +0800
Subject: [PATCH 09/10] Modules/timemodule.c: Add __OHOS__ to musl timezone
 handling

HarmonyOS uses musl libc which has the same tm_zone behavior as
Linux musl: it refuses to process a tm_zone field unless it was
produced by the C library itself (see bpo-34672). Extend all three
occurrences of the condition `defined(__linux__) && !defined(__GLIBC__)`
to also include `defined(__OHOS__)`, enabling the musl-specific
timezone string workarounds for HarmonyOS.

Modified locations:
- utc_string declaration (line 613)
- gettmarg() tm_zone workaround (line 665)
- time_exec() utc_string initialization (line 2116)

Upstream-Status: Inappropriate [HarmonyOS specific]
---
 Modules/timemodule.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Modules/timemodule.c b/Modules/timemodule.c
index xxxxxxxx..xxxxxxx 100644
--- a/Modules/timemodule.c
+++ b/Modules/timemodule.c
@@ -610,7 +610,7 @@ time_localtime(PyObject *module, PyObject *args)
 #endif
 }
 
-#if defined(__linux__) && !defined(__GLIBC__)
+#if (defined(__linux__) || defined(__OHOS__)) && !defined(__GLIBC__)
 static const char *utc_string = NULL;
 #endif
 
@@ -662,7 +662,7 @@ gettmarg(time_module_state *state, PyObject *args,
             if (p->tm_zone == NULL) {
                 return 0;
             }
-#if defined(__linux__) && !defined(__GLIBC__)
+#if (defined(__linux__) || defined(__OHOS__)) && !defined(__GLIBC__)
             // Make an attempt to return the C library's own timezone strings to
             // it. musl refuses to process a tm_zone field unless it produced
             // it. See issue #34672.
@@ -2113,7 +2113,7 @@ time_exec(PyObject *module)
     }
     initialized = 1;
 
-#if defined(__linux__) && !defined(__GLIBC__)
+#if (defined(__linux__) || defined(__OHOS__)) && !defined(__GLIBC__)
     struct tm tm;
     const time_t zero = 0;
     if (gmtime_r(&zero, &tm) != NULL)
