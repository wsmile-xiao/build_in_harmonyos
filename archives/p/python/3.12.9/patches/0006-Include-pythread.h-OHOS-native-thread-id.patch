From: HarmonyOS Python Porting <porting@harmonyos.com>
Date: Thu, 27 Mar 2026 11:00:00 +0800
Subject: [PATCH 06/10] Include/pythread.h: Add __OHOS__ to
 PY_HAVE_THREAD_NATIVE_ID

HarmonyOS supports thread native IDs via syscall(SYS_gettid) on
musl libc, identical to Linux. Add __OHOS__ to the preprocessor
condition so that PY_HAVE_THREAD_NATIVE_ID is defined and
PyThread_get_thread_native_id() is declared for HarmonyOS.

Upstream-Status: Inappropriate [HarmonyOS specific]
---
 Include/pythread.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Include/pythread.h b/Include/pythread.h
index xxxxxxxx..xxxxxxx 100644
--- a/Include/pythread.h
+++ b/Include/pythread.h
@@ -21,7 +21,7 @@ PyAPI_FUNC(void) _Py_NO_RETURN PyThread_exit_thread(void);
 PyAPI_FUNC(unsigned long) PyThread_get_thread_ident(void);
 
 #if (defined(__APPLE__) || defined(__linux__) || defined(_WIN32) \
-     || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__) \
+     || defined(__OHOS__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__NetBSD__) \
      || defined(__DragonFly__) || defined(_AIX))
 #define PY_HAVE_THREAD_NATIVE_ID
 PyAPI_FUNC(unsigned long) PyThread_get_thread_native_id(void);
