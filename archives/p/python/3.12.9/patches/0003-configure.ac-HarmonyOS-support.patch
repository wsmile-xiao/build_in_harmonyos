@@ -3383,6 +3427,15 @@
 	Emscripten*|WASI*)
 		LDSHARED='$(CC) -shared'
 		LDCXXSHARED='$(CXX) -shared';;
+	HarmonyOS*)
+		# HarmonyOS uses musl libc with BIND_NOW by default.
+		# Extension modules must link against libpython for symbol resolution.
+		# BLDSHARED (for libpython.so) does NOT include -lpython.
+		# LDSHARED (for extension modules) includes -lpython.
+		BLDSHARED='$(CC) -shared'
+		LDSHARED='$(CC) -shared -L. -lpython$(LDVERSION)'
+		LDCXXSHARED='$(CXX) -shared'
+		;;
