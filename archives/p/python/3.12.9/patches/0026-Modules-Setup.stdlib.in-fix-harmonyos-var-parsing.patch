From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HarmonyOS Porting <porting@harmonyos.org>
Date: Wed, 1 Apr 2026 15:00:00 +0800
Subject: [PATCH 26/26] Modules/Setup.stdlib.in: fix HARMONYOS_* variable
 parsing

Patch 0005 added Make variable definitions (HARMONYOS_ARCH,
HARMONYOS_SYSROOT, etc.) at the top of Setup.stdlib.in. These are
misinterpreted by makesetup as module definitions, causing
check_extension_modules.py to report errors like:
  "HARMONYOS_ARCH is not a built-in module"

Fix: Remove the bare variable definitions and $(HARMONYOS_SDK_*) flags
references. Users should pass SDK paths via CFLAGS/LDFLAGS instead.
---
 Modules/Setup.stdlib.in | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/Modules/Setup.stdlib.in b/Modules/Setup.stdlib.in
--- a/Modules/Setup.stdlib.in
+++ b/Modules/Setup.stdlib.in
@@ -34,10 +34,6 @@
 #
 # HARMONYOS_ARCH defaults to the build machine architecture.
 # Set HARMONYOS_SYSROOT if the compiler does not pass --sysroot automatically.
-HARMONYOS_ARCH = aarch64
-HARMONYOS_SYSROOT =
-HARMONYOS_SDK_CFLAGS = $(if $(HARMONYOS_SYSROOT),-I$(HARMONYOS_SYSROOT)/usr/include -I$(HARMONYOS_SYSROOT)/usr/include/$(HARMONYOS_ARCH)-linux-ohos)
-HARMONYOS_SDK_LDFLAGS = $(if $(HARMONYOS_SYSROOT),-L$(HARMONYOS_SYSROOT)/usr/lib/$(HARMONYOS_ARCH)-linux-ohos)
 # Build modules statically or as shared extensions
 # *shared* / *static*
 *@MODULE_BUILDTYPE@*
@@ -152,21 +148,21 @@ HARMONYOS_SDK_LDFLAGS = $(if $(HARMONYOS
 #
 
 # needs -lffi and -ldl
-@MODULE__CTYPES_TRUE@_ctypes _ctypes/_ctypes.c _ctypes/callbacks.c _ctypes/callproc.c _ctypes/stgdict.c _ctypes/cfield.c @MODULE__CTYPES_MALLOC_CLOSURE@ $(HARMONYOS_SDK_CFLAGS) $(HARMONYOS_SDK_LDFLAGS)
+@MODULE__CTYPES_TRUE@_ctypes _ctypes/_ctypes.c _ctypes/callbacks.c _ctypes/callproc.c _ctypes/stgdict.c _ctypes/cfield.c @MODULE__CTYPES_MALLOC_CLOSURE@
 
 # needs -lncurses[w], sometimes -ltermcap/tinfo
 @MODULE__CURSES_TRUE@_curses _cursesmodule.c
 # needs -lncurses[w] and -lpanel[w]
 @MODULE__CURSES_PANEL_TRUE@_curses_panel _curses_panel.c
 
-@MODULE__SQLITE3_TRUE@_sqlite3 _sqlite/blob.c _sqlite/connection.c _sqlite/cursor.c _sqlite/microprotocols.c _sqlite/module.c _sqlite/prepare_protocol.c _sqlite/row.c _sqlite/statement.c _sqlite/util.c $(HARMONYOS_SDK_CFLAGS) $(HARMONYOS_SDK_LDFLAGS)
+@MODULE__SQLITE3_TRUE@_sqlite3 _sqlite/blob.c _sqlite/connection.c _sqlite/cursor.c _sqlite/microprotocols.c _sqlite/module.c _sqlite/prepare_protocol.c _sqlite/row.c _sqlite/statement.c _sqlite/util.c
 
 # needs -lssl and -lcrypt
-@MODULE__SSL_TRUE@_ssl _ssl.c $(HARMONYOS_SDK_CFLAGS) $(HARMONYOS_SDK_LDFLAGS)
+@MODULE__SSL_TRUE@_ssl _ssl.c
 # needs -lcrypt
-@MODULE__HASHLIB_TRUE@_hashlib _hashopenssl.c $(HARMONYOS_SDK_CFLAGS) $(HARMONYOS_SDK_LDFLAGS)
+@MODULE__HASHLIB_TRUE@_hashlib _hashopenssl.c
 
 # Linux: -luuid, BSD/AIX: libc's uuid_create()
-@MODULE__UUID_TRUE@_uuid _uuidmodule.c $(HARMONYOS_SDK_CFLAGS) $(HARMONYOS_SDK_LDFLAGS)
+@MODULE__UUID_TRUE@_uuid _uuidmodule.c
 
 @MODULE__TKINTER_TRUE@_tkinter _tkinter.c tkappinit.c
