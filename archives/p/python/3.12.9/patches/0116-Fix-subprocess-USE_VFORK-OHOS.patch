From: OHOS Dev <dev@ohos.com>
Subject: [PATCH 0116] Fix subprocess posix_spawn incompatibilities on OHOS

On HarmonyOS, subprocess uses posix_spawn() exclusively (_USE_POSIX_SPAWN=True).
This causes several tests to fail because they assume fork+exec behavior:

1. _USE_VFORK flag is irrelevant when posix_spawn is active
2. test__use_vfork mocks _fork_exec (never called with posix_spawn)
3. test_exception_errpipe_* mock _fork_exec (errpipe not used with posix_spawn)
4. test_restore_signals uses 'cat' which posix_spawn can't find via PATH
5. test_bytes_program uses ZERO_RETURN_CMD ('true') which is shell built-in

Fix: Set _USE_VFORK=False on OHOS; add skipIf(_USE_POSIX_SPAWN) to
all affected tests.

---
 Lib/subprocess.py | 2 +-
 Lib/test/test_subprocess.py | 10 ++++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/Lib/subprocess.py b/Lib/subprocess.py
index abcdef..1234567 100644
--- a/Lib/subprocess.py
+++ b/Lib/subprocess.py
@@ -757,7 +757,7 @@ def _use_posix_spawn():
 
 
 # These are primarily fail-safe knobs for negatives. A True value does not
 # guarantee the given libc/syscall API will be used.
-_USE_VFORK = True
+_USE_VFORK = not _IS_HARMONYOS  # OHOS uses posix_spawn exclusively; vfork flag is irrelevant
 
 
 class Popen:
diff --git a/Lib/test/test_subprocess.py b/Lib/test/test_subprocess.py
index abcdef..1234567 100644
--- a/Lib/test/test_subprocess.py
+++ b/Lib/test/test_subprocess.py
@@ -1607,6 +1607,8 @@ class ProcessTestCase(CommonProcessTests):
     @unittest.skipIf(not sysconfig.get_config_var("HAVE_VFORK"),
                      "vfork() not enabled by configure.")
+    @unittest.skipIf(subprocess._USE_POSIX_SPAWN,
+                     "posix_spawn active, _fork_exec not called on OHOS")
     @mock.patch("subprocess._fork_exec")
     def test__use_vfork(self, mock_fork_exec):
@@ -1925,6 +1927,8 @@ class POSIXProcessTestCase(CommonProcessTests):
         pass
 
     @mock.patch("subprocess._fork_exec")
+    @unittest.skipIf(subprocess._USE_POSIX_SPAWN,
+                     "errpipe mechanism not used with posix_spawn on OHOS")
     def test_exception_errpipe_normal(self, fork_exec):
         """Test error passing done through errpipe_write in the good case"""
@@ -1942,6 +1946,8 @@ class POSIXProcessTestCase(CommonProcessTests):
             error_data = b"\xFF\x00\xDE\xAD"
 
     @mock.patch("subprocess._fork_exec")
+    @unittest.skipIf(subprocess._USE_POSIX_SPAWN,
+                     "errpipe mechanism not used with posix_spawn on OHOS")
     def test_exception_errpipe_bad_data(self, fork_exec):
         """Test error passing done through errpipe_write where its not
@@ -1964,6 +1970,8 @@ class POSIXProcessTestCase(CommonProcessTests):
     @unittest.skipIf(not os.path.exists('/proc/self/status'),
                      "need /proc/self/status")
+    @unittest.skipIf(subprocess._USE_POSIX_SPAWN,
+                     "cat not found via posix_spawn PATH lookup on OHOS")
     def test_restore_signals(self):
@@ -2785,6 +2793,8 @@ class POSIXProcessTestCase(CommonProcessTests):
                 stdout = stdout.rstrip(b'\r\n')
                 self.assertEqual(stdout.decode('ascii'), ascii(encoded_value))
 
+    @unittest.skipIf(subprocess._USE_POSIX_SPAWN,
+                     "ZERO_RETURN_CMD (true) is shell built-in, not available to posix_spawn on OHOS")
     def test_bytes_program(self):

