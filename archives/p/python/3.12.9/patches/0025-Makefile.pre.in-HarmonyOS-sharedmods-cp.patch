From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HarmonyOS Porting <porting@harmonyos.org>
Date: Wed, 1 Apr 2026 15:00:00 +0800
Subject: [PATCH 25/26] Makefile.pre.in: use cp for sharedmods on HMDFS

HMDFS does not support symbolic links. os.path.exists() returns False
for symlinks, causing Python's import system to be unable to find any
shared extension modules (.so files).

Fix: Change sharedmods target from $(LN_FORCE) to $(HARDLINK) (cp -p
on HarmonyOS) and adjust path from ../../$mod to $mod, since cp
resolves paths relative to CWD while ln -sf resolves relative to
the symlink location.
---
 Makefile.pre.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile.pre.in b/Makefile.pre.in
--- a/Makefile.pre.in
+++ b/Makefile.pre.in
@@ -1002,6 +1002,6 @@ sharedmods: $(SHAREDMODS) pybuilddir.txt
 	for mod in X $(SHAREDMODS); do \
 		if test $$mod != X; then \
 			rm -f $$target/`basename $$mod`; \
-			$(LN_FORCE) ../../$$mod $$target/`basename $$mod`; \
+			test -f $$mod && $(HARDLINK) $$mod $$target/`basename $$mod`; \
 		fi; \
 	done
