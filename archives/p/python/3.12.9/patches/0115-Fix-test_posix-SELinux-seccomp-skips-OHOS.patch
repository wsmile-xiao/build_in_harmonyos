From: OHOS Dev <dev@ohos.com>
Subject: [PATCH 0115] Fix test_posix SELinux/seccomp blocked syscalls skips on OHOS

Several posix syscall tests fail on OHOS due to SELinux or seccomp filters:
- getgroups(2): blocked by SELinux (PermissionError/OSError)
- getgrouplist(2): same as above
- sched_setscheduler/sched_setparam: blocked by seccomp (EPERM/SIGSYS)
- unshare/setns: blocked by seccomp (ENOSYS/EPERM)
- readlink with dir_fd: HMDFS does not fully support dir_fd operations

This patch adds @unittest.skipIf decorators for each affected test method.

---
 Lib/test/test_posix.py | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/Lib/test/test_posix.py b/Lib/test/test_posix.py
index abcdef..1234567 100644
--- a/Lib/test/test_posix.py
+++ b/Lib/test/test_posix.py
@@ -838,6 +838,8 @@ class PosixTester(unittest.TestCase):
     @unittest.skipUnless(hasattr(os, 'getegid'), "test needs os.getegid()")
     @unittest.skipUnless(hasattr(os, 'popen'), "test needs os.popen()")
     @support.requires_subprocess()
+    @unittest.skipIf(sys.platform == 'ohos',
+                     'getgroups(2) blocked by SELinux on OHOS')
     def test_getgroups(self):
 
@@ -863,6 +865,8 @@ class PosixTester(unittest.TestCase):
     @unittest.skipUnless(hasattr(posix, 'getgrouplist'), "test needs posix.getgrouplist()")
     @unittest.skipUnless(hasattr(pwd, 'getpwuid'), "test needs pwd.getpwuid()")
     @unittest.skipUnless(hasattr(os, 'getuid'), "test needs os.getuid()")
+    @unittest.skipIf(sys.platform == 'ohos',
+                     'getgrouplist(2) blocked by SELinux on OHOS')
     def test_getgrouplist(self):
@@ -1047,6 +1051,8 @@ class PosixTester(unittest.TestCase):
 
     @requires_sched
+    @unittest.skipIf(sys.platform == 'ohos',
+                     'sched_setscheduler/sched_setparam blocked by seccomp on OHOS')
     def test_get_and_set_scheduler_and_param(self):
@@ -1660,6 +1666,8 @@ class TestPosixDirFd(unittest.TestCase):
     @unittest.skipUnless(hasattr(os, 'readlink') and (os.readlink in os.supports_dir_fd),
                          "test needs dir_fd support in os.readlink()")
+    @unittest.skipIf(sys.platform == 'ohos',
+                     'readlink with dir_fd not fully supported on HMDFS')
     def test_readlink_dir_fd(self):
@@ -2382,6 +2390,8 @@ class _PosixSpawnMixin:
     @unittest.skipUnless(os.path.exists('/proc/self/ns/uts'), 'need /proc/self/ns/uts')
     @support.requires_linux_version(3, 0, 0)
+    @unittest.skipIf(sys.platform == 'ohos',
+                     'unshare/setns blocked by seccomp on OHOS')
     def test_unshare_setns(self):

