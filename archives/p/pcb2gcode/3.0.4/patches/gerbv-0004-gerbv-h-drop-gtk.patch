+/*
+ * GTK/GDK-free build of libgerbv.  This build provides the Gerber/Excellon
+ * parsing library only: the GTK-2.0 GUI application and the GDK rendering
+ * backend are not compiled.  The single GDK type that is still part of the
+ * public data structures (the layer/background colour) is provided as a
+ * minimal stand-in so that gerbv.h stays self-contained.
+ *
+ * <stdio.h> is included explicitly: it used to be pulled in transitively
+ * through the GTK/GDK headers, which are gone now.
+ */
+#include <stdio.h>
+typedef struct _GdkColor {
+    guint32 pixel;
+    guint16 red;
+    guint16 green;
+    guint16 blue;
+} GdkColor;
+typedef struct _GdkPixmap GdkPixmap;
 
