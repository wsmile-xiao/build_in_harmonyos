-pkg_check_modules(RSVG REQUIRED IMPORTED_TARGET librsvg-2.0>=2.0)
+
+# The gerberimporter_tests rasterise the imported gerber onto Cairo surfaces and
+# compare against golden PNG/SVG images, which needs the GTK/GNOME imaging stack
+# (glibmm, gdkmm, librsvg).  That stack is optional: when it is unavailable the
+# imaging test is simply not registered and the remaining unit tests are built
+# without the extra pkg-config modules.
+pkg_check_modules(GLIBMM IMPORTED_TARGET glibmm-2.4>=2.8)
+pkg_check_modules(GDKMM IMPORTED_TARGET gdkmm-2.4>=2.8)
+pkg_check_modules(RSVG IMPORTED_TARGET librsvg-2.0>=2.0)
+set(PCB2GCODE_HAVE_IMAGING_TESTS OFF)
+if(GLIBMM_FOUND AND GDKMM_FOUND AND RSVG_FOUND)
+  set(PCB2GCODE_HAVE_IMAGING_TESTS ON)
+endif()
