--- a/gerbv/CMakeLists.txt
+++ b/gerbv/CMakeLists.txt
@@ -7,7 +7,9 @@
 
 set(CMAKE_C_STANDARD 23)
 set(CMAKE_C_STANDARD_REQUIRED ON)
-set(CMAKE_C_EXTENSIONS OFF)
+# Keep the GNU dialect (-std=gnu2x) as the former autotools build did.
+# The strict ISO dialect (-std=c2x) hides POSIX declarations such as fileno().
+set(CMAKE_C_EXTENSIONS ON)
 set(CMAKE_CXX_STANDARD 23)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CXX_EXTENSIONS OFF)
@@ -15,13 +17,23 @@
 list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
 set(CMAKE_EXPORT_COMPILE_COMMANDS "ON")
 
-## Glib-2.0 and GTK-2.0
+## Glib-2.0 (required).  GTK-2.0 is only needed by the GUI application and by
+## the GDK rendering backend; both are optional and off by default so that the
+## library can be built on platforms without GTK.
 find_package(PkgConfig REQUIRED)
-pkg_check_modules(GTK REQUIRED IMPORTED_TARGET gtk+-2.0)
 pkg_check_modules(GLIB REQUIRED IMPORTED_TARGET glib-2.0>=2.6)
+# cairo is part of the libgerbv public API (gerbv.h exposes cairo_t / cairo
+# calls); it used to be pulled in transitively through gtk+-2.0, so declare it
+# explicitly now that GTK is optional.
+pkg_check_modules(CAIRO REQUIRED IMPORTED_TARGET cairo)
+option(GERBV_WITH_GUI "Build the GTK-2.0 GUI application and the GDK rendering backend" OFF)
+option(GERBV_BUILD_SHARED "Build the shared version of libgerbv (libgerbv.so)" ON)
+if(GERBV_WITH_GUI)
+    pkg_check_modules(GTK REQUIRED IMPORTED_TARGET gtk+-2.0)
+endif()
 
 ## Gettext and intl
-find_package(Gettext REQUIRED) # https://cmake.org/cmake/help/latest/module/FindGettext.html
+find_package(Gettext) # https://cmake.org/cmake/help/latest/module/FindGettext.html
 find_package(Intl) # Removed REQUIRED since it will fail on Mingw where it seems to be part of Gettext
 
 include(GNUInstallDirs)
@@ -33,7 +45,10 @@
 add_library(compilation-flags INTERFACE)
 target_compile_options(compilation-flags INTERFACE -Wall -Wimplicit-fallthrough -O3 -Wno-deprecated-declarations)
 target_compile_options(compilation-flags INTERFACE $<$<CONFIG:Debug>:-g3>)
-target_link_libraries(compilation-flags INTERFACE PkgConfig::GLIB PkgConfig::GTK m)
+target_link_libraries(compilation-flags INTERFACE PkgConfig::GLIB PkgConfig::CAIRO m)
+if(GERBV_WITH_GUI)
+    target_link_libraries(compilation-flags INTERFACE PkgConfig::GTK)
+endif()
 if(Intl_FOUND)
     target_link_libraries(compilation-flags INTERFACE Intl::Intl)
 endif()
@@ -80,17 +95,18 @@
 
 # Note: config must happen before locale, since locale uses config for authors.c/bugs.c 
 add_subdirectory(config)
-add_subdirectory(locale)
 add_subdirectory(src)
-add_subdirectory(man)
-add_subdirectory(desktop)
 add_subdirectory(thirdparty)
 
-install(DIRECTORY example TYPE DOC) # Rename to examples
-install(DIRECTORY share/ TYPE DATA)
-
-enable_testing()
-add_subdirectory(test)
+if(GERBV_WITH_GUI)
+    add_subdirectory(locale)
+    add_subdirectory(man)
+    add_subdirectory(desktop)
+    install(DIRECTORY example TYPE DOC) # Rename to examples
+    install(DIRECTORY share/ TYPE DATA)
+    enable_testing()
+    add_subdirectory(test)
+endif()
 
 # where to find our CMake modules
 include(InstallWindowsDLLs)
