diff --git a/configure b/configure
--- a/configure
+++ b/configure
@@ -4973,7 +4973,7 @@
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 022 && mktemp -d "${TMPDIR:-.}/confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  tmp=${TMPDIR:-.}/conf$$-$RANDOM
+  (umask 022 && mkdir "$tmp")
