+# Top-level Makefile for pacparser.
+# Modified for OpenHarmony: default target delegates to src/Makefile.
 -include version.mk
 
-VERSION ?= $(shell git describe --always --tags --candidate=100)
+VERSION ?= v1.5.0
+PREFIX ?= /usr
+DESTDIR ?=
 
-GIT_TAG := $(shell git describe --exact-match --exclude tip --tags HEAD 2>/dev/null || /bin/true)
-GIT_COMMIT = $(strip $(shell git rev-parse --short HEAD))
+# Default target: build C library and pactester
+all: build
 
+build:
+	make -C src VERSION=$(VERSION) PREFIX=$(PREFIX) pactester libpacparser.so.1
+
+install:
+	make -C src VERSION=$(VERSION) DESTDIR=$(DESTDIR) install
+
+clean:
+	make -C src clean
+
+.PHONY: all build install clean
+
+# Docker targets (not default)
 DOCKER_IMAGE ?= manugarg/pactester
