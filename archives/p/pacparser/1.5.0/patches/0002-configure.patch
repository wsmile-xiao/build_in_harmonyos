diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,38 @@
+#!/bin/sh
+# Minimal configure script for pacparser (custom Makefile project)
+# This script accepts standard configure arguments and creates version.mk
+# It's needed for build system compatibility (G0 clean-verify expects ./configure)
+
+PREFIX="/usr"
+VERSION="v1.5.0"
+
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            ;;
+        --version)
+            echo "$VERSION"
+            exit 0
+            ;;
+        --help|-h)
+            echo "Usage: ./configure [options]"
+            echo "Options:"
+            echo "  --prefix=DIR    Installation prefix [$PREFIX]"
+            echo "  --help          Display this help"
+            echo "  --version       Display version"
+            exit 0
+            ;;
+        *)
+            echo "configure: warning: unrecognized option: $arg"
+            ;;
+    esac
+done
+
+# Create version.mk for the Makefile
+echo "VERSION=$VERSION" > src/version.mk
+
+echo "Configuration for pacparser $VERSION:"
+echo "  Prefix: $PREFIX"
+echo ""
+echo "Now run: make -C src PREFIX=$PREFIX"