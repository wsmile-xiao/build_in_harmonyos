+# Upstream drives test/*.cpp through the Ruby Rakefile in test/; the in-tree
+# CMake hooks for those very same sources were left commented out. This option
+# enables them so the unchanged upstream test sources can also be built and
+# executed by a plain CMake/Conan build (the Rakefile needs a Ruby toolchain).
+#
+# encodings.cpp is filtered out for the same reason upstream's Rakefile
+# filters it (SOURCES.delete("encodings.test")): it does not compile as a
+# translation unit of its own (test/testhelpers.hpp needs <fstream> and
+# Pathie::Path, which that TU never includes).
+option(PATHIE_BUILD_TESTS "Build the upstream test executables from test/." OFF)
+if (PATHIE_BUILD_TESTS)
+  set(pathie_test_sources ${test_sources})
+  list(FILTER pathie_test_sources EXCLUDE REGEX "encodings\\.cpp$")
+  foreach(testfile ${pathie_test_sources})
+    get_filename_component(testtargetname "${testfile}" NAME_WE)
+    set(testtargetname "${testtargetname}.test")
+    add_executable(${testtargetname} ${testfile})
+    # The suite needs C++11 (lambdas in test/testhelpers.hpp) although the
+    # library itself is built as C++98 (CMAKE_CXX_STANDARD above).
+    set_target_properties(${testtargetname} PROPERTIES
+      CXX_STANDARD 11
+      CXX_STANDARD_REQUIRED ON
+      CXX_EXTENSIONS OFF
+      RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/upstream-tests")
+    target_link_libraries(${testtargetname} pathie)
+  endforeach()
+endif()
 
