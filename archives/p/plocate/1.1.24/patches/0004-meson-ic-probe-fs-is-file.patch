--- a/meson.build	2026-09-25 12:41:43.318517657 +0800
+++ b/meson.build	2026-09-25 12:41:43.434517188 +0800
@@ -98,7 +98,11 @@
 # of calling into that directory to run make, and we're not
 # replicating their build system, so it has to be manual.
 pfordir = meson.source_root() + '/TurboPFor-Integer-Compression'
-if run_command('[', '-r', pfordir + '/libic.a', ']', check: false).returncode() == 0
+# HarmonyOS/OHOS workers expose no standalone '[' external program on PATH,
+# so run_command('[', ...) hard-fails at configure time ('Program or command [
+# not found or not executable'). The predicate is a plain file check, which
+# Meson answers natively through the fs module already imported above.
+if fs.is_file(pfordir + '/libic.a')
 	turbopfordep = declare_dependency(
 		include_directories: include_directories('TurboPFor-Integer-Compression'),
 		dependencies: meson.get_compiler('cpp').find_library('ic', dirs: pfordir))
