--- a/src/utmp.c
+++ b/src/utmp.c
@@ -42,7 +42,29 @@
 # if HAVE_UPDWTMP
 #  define pies_updwtmpx updwtmp
 # endif
-# define GETUTXID getutid
+/* getutid() is not part of the POSIX utmp interface and some libcs
+   (e.g. the HarmonyOS libc) do not provide it.  Implement the same
+   lookup on top of the portable setutent()/getutent() pair instead of
+   introducing a platform conditional. */
+static UTMPX *
+pies_getutid (const UTMPX *id)
+{
+  UTMPX *ut;
+
+  setutent ();
+  while ((ut = getutent ()) != NULL)
+    {
+      if (ut->ut_type != id->ut_type)
+	continue;
+      if (id->ut_type == RUN_LVL || id->ut_type == BOOT_TIME
+	  || id->ut_type == OLD_TIME || id->ut_type == NEW_TIME)
+	return ut;
+      if (memcmp (ut->ut_id, id->ut_id, sizeof (id->ut_id)) == 0)
+	return ut;
+    }
+  return NULL;
+}
+# define GETUTXID(ut) pies_getutid (ut)
 # define setutxent setutent
 # define pututxline pututline
 # define endutxent endutent
