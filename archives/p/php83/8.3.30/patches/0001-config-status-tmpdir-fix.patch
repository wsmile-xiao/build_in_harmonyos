--- a/config.status
+++ b/config.status
@@ -632,7 +632,8 @@
-tmp=./conf$$-$$
+tmp=/storage/Users/currentUser/tmp/php83-build-tmp
+mkdir -p "$tmp"
 
 This patch fixes the config.status temporary directory creation failure
 on HarmonyOS where /tmp is read-only (E002 variant).
 
 The original code uses hardcoded ./confXXXXXX pattern which ignores TMPDIR.
