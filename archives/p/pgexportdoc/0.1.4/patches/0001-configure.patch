diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,24 @@
+#!/bin/sh
+# Minimal configure wrapper for PGXS-based pgexportdoc
+# PGXS projects use pg_config to determine build settings
+# This script sets up the environment for make-based builds
+
+PREFIX="${1:-}"
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            export PREFIX
+            ;;
+        *)
+            ;;
+    esac
+done
+
+echo "pgexportdoc configure: Using PGXS build system"
+echo "  PREFIX=${PREFIX}"
+if [ -n "${PREFIX}" ]; then
+    echo "  Note: PGXS uses pg_config for installation paths"
+fi
+echo "Configuration complete. Run 'make' to build."
+exit 0
