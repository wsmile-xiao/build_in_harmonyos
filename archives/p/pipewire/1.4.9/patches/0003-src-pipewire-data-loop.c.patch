 SPA_EXPORT
 int pw_data_loop_stop(struct pw_data_loop *loop)
 {
 	pw_log_debug("%p stopping", loop);
 	if (loop->running) {
 		struct spa_thread_utils *utils;
 		if (loop->cancel) {
 			pw_log_debug("%p cancel", loop);
+#ifdef HAVE_PTHREAD_CANCEL
 			pthread_cancel(loop->thread);
+#else
+			/* HarmonyOS libc does not provide pthread_cancel();
+			 * fall back to delivering SIGUSR1 to the loop thread
+			 * (handler installed in do_loop), which exits the
+			 * thread through pthread_exit() so the cleanup
+			 * handlers run and the join below succeeds. */
+			if (fallback_cancel_thread(loop->thread) < 0)
+				pw_log_warn("%p: cancel signal failed: %m", loop);
+#endif
 		} else {
 			pw_log_debug("%p signal", loop);
 			pw_loop_invoke(loop->loop, do_stop, 1, NULL, 0, false, loop);
 		}
 		pw_log_debug("%p join", loop);
 		if ((utils = loop->thread_utils) == NULL)
 			utils = pw_thread_utils_get();
 		spa_thread_utils_join(utils, (struct spa_thread*)loop->thread, NULL);
 		pw_log_debug("%p joined", loop);
 	}
