--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,60 @@
+# Build layer for the OHOS adaptation of PhysUnits-CT (C++98).
+#
+# Upstream v0.1.0 ships no build system: the library is header-only and the
+# tests under projects/Test/ are compiled through ad-hoc makefiles that expect
+# an externally provided Catch single header.  This CMakeLists.txt packages
+# that same layout for CMake consumers without modifying any upstream file:
+#
+# - the INTERFACE library exposes the source root so that "phys/units/*.hpp"
+#   is reachable exactly as upstream documents it;
+# - when PHYS_UNITS_OPT_BUILD_TESTS is ON, the upstream Catch test programs
+#   are built and registered with CTest (Catch v1 "catch.hpp" is provided in
+#   the source root by the packaging, mirroring the upstream CATCH_INCLUDE
+#   usage);
+# - install exports the phys/ header tree under <prefix>/include.
+
+cmake_minimum_required(VERSION 3.15)
+
+project(PhysUnits-CT VERSION 0.1.0 LANGUAGES CXX)
+
+option(PHYS_UNITS_OPT_BUILD_TESTS    "Build and perform the PhysUnits-CT tests" OFF)
+option(PHYS_UNITS_OPT_BUILD_EXAMPLES "Build the PhysUnits-CT examples" OFF)
+
+add_library(physunits INTERFACE)
+target_include_directories(physunits INTERFACE
+  $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+  $<INSTALL_INTERFACE:include>
+)
+add_library(PhysUnits::PhysUnits ALIAS physunits)
+
+include(GNUInstallDirs)
+
+install(DIRECTORY phys/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/phys)
+
+if( PHYS_UNITS_OPT_BUILD_TESTS )
+    enable_testing()
+
+    # TestCompile.cpp mirrors the upstream makefile object list: it is linked
+    # into every test program even though it registers no test cases, because
+    # it exercises the API surface at compile time.
+    set( PHYS_UNITS_TEST_COMPILE_SRC ${CMAKE_CURRENT_SOURCE_DIR}/projects/Test/TestCompile.cpp )
+
+    foreach( name TestArithmetic TestComparison TestFunction TestOutput TestPrefix TestUnit )
+        add_executable( ${name}
+            projects/Test/${name}.cpp
+            projects/Test/Test.cpp
+            ${PHYS_UNITS_TEST_COMPILE_SRC}
+        )
+        # catch.hpp (provided in the source root) and phys/ headers both live
+        # at the source root, so reuse the INTERFACE include directory.
+        target_link_libraries( ${name} PRIVATE physunits )
+        add_test( NAME ${name} COMMAND ${name} )
+    endforeach()
+endif()
+
+if( PHYS_UNITS_OPT_BUILD_EXAMPLES )
+    add_executable( example-doxygen-hello projects/Doxygen/examples/hello.cpp )
+    target_link_libraries( example-doxygen-hello PRIVATE physunits )
+endif()
+
+# End of file
