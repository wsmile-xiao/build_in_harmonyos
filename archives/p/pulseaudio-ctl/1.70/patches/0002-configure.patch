diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,15 @@
+#!/bin/sh
+# pulseaudio-ctl configure wrapper
+# This is a simple Makefile project (shell script), no actual configure needed
+# Accept --prefix and exit successfully for build framework compatibility
+
+PREFIX=/usr/local
+for arg in "$@"; do
+  case "$arg" in
+    --prefix=*) PREFIX="${arg#--prefix=}" ;;
+    *) ;;
+  esac
+done
+echo "pulseaudio-ctl: Simple Makefile project (no configure needed)"
+echo "  PREFIX = $PREFIX"
+exit 0
