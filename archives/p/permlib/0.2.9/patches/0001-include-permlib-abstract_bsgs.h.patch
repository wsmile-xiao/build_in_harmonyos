 template <class TRANS>
 void AbstractBSGS<TRANS>::transversalSizes(std::vector<unsigned long>& sizes) const {
 	sizes.clear();
 	sizes.reserve(m_bsgs->U.size());
 	BOOST_FOREACH(const TRANS &Ui, m_bsgs->U) {
 		sizes.push_back(Ui.size());
