+#ifndef PUGL_OHOS_H_INCLUDED
+#define PUGL_OHOS_H_INCLUDED
+
+#include "pugl.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Replace the ArkUI/XComponent OHNativeWindow used by this view.
+
+    A null window selects an EGL pbuffer, which is useful for background
+    rendering and deterministic tests. */
+PUGL_API PuglStatus
+puglSetNativeWindow(PuglView* view, PuglNativeWindow window);
+
+/** Queue input received from the ArkUI host for dispatch by
+    puglProcessEvents(). */
+PUGL_API void
+puglSendMotion(PuglView* view, int x, int y, int mods);
+
+PUGL_API void
+puglSendMouse(PuglView* view, int button, bool press, int x, int y, int mods);
+
+PUGL_API void
+puglSendScroll(PuglView* view, float dx, float dy, int mods);
+
+PUGL_API void
+puglSendSpecial(PuglView* view, bool press, PuglKey key, int mods);
+
+PUGL_API void
+puglSendKeyboard(PuglView* view, bool press, uint32_t key, int mods);
+
+PUGL_API void
+puglSendClose(PuglView* view);
+
+/** Read the current EGL drawable as tightly packed RGBA pixels. */
+PUGL_API int
+puglGrabFrame(PuglView* view, int* width, int* height, unsigned char* rgba);
+
+#ifdef __cplusplus
+}  /* extern "C" */
+#endif
+
