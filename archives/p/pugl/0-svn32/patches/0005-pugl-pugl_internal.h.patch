 void
 puglDefaultReshape(PuglView* view, int width, int height)
 {
+	(void)view;
+
+	/* OpenGL ES has no fixed-function matrix stack.  The application owns
+	   projection state, while Pugl still establishes the drawable viewport. */
+	#ifdef PUGL_GLES_BACKEND
+	glViewport(0, 0, width, height);
+	#else
 	glMatrixMode(GL_PROJECTION);
 	glLoadIdentity();
 	glOrtho(0, width, height, 0, 0, 1);
 	glViewport(0, 0, width, height);
 
 	glMatrixMode(GL_MODELVIEW);
 	glLoadIdentity();
+	#endif
 }
 
