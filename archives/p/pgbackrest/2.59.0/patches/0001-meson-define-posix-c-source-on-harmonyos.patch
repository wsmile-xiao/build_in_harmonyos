--- a/meson.build
+++ b/meson.build
@@ -48,6 +48,11 @@
 ####################################################################################################################################
 if host_machine.system() == 'linux'
     add_global_arguments('-D_POSIX_C_SOURCE=200809L', language: 'c')
+elif host_machine.system() == 'harmonyos'
+    # HarmonyOS exposes the POSIX 2008 interfaces the sources rely on (gmtime_r(),
+    # localtime_r(), nanosleep(), ...) only when _POSIX_C_SOURCE is defined; meson
+    # reports the OHOS target as 'harmonyos' rather than 'linux'.
+    add_global_arguments('-D_POSIX_C_SOURCE=200809L', language: 'c')
 elif host_machine.system() == 'darwin'
     add_global_arguments('-D_DARWIN_C_SOURCE', language: 'c')
 endif
