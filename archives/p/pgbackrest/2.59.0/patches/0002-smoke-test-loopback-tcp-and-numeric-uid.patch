+# PostgreSQL port. A free port is requested so the smoke test never collides with a PostgreSQL already listening on the host.
+def free_port():
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+        sock.bind(("127.0.0.1", 0))
+        return sock.getsockname()[1]
+
+
+# HarmonyOS denies bind() on unix domain sockets with EPERM even though the filesystem supports them. Probe once so PostgreSQL
+# can listen on loopback TCP when a private unix socket cannot be created.
+def unix_socket_supported(path):
+    try:
+        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
+            sock.bind(path)
+        os.unlink(path)
+        return True
+    except OSError:
+        return False
+
+
+PG_PORT = free_port()
 
