Honour $TMPDIR for the driver's intermediate files.  Upstream hardcodes
/tmp, but HarmonyOS mounts /tmp read-only (erofs), which makes every
non -E compilation fail.  The newer, unused driver in cc/driver/driver.c
already reads $TMPDIR; this brings the active driver in line with it.
--- a/cc/cc/cc.c
+++ b/cc/cc/cc.c
@@ -1581,8 +1581,14 @@
 char *
 gettmp(void)
 {
-	char *sfn = xstrdup("/tmp/ctm.XXXXXX");
+	const char *dir = getenv("TMPDIR");
+	char *sfn;
 	int fd = -1;
+
+	if (dir == NULL || *dir == '\0')
+		dir = "/tmp";
+	sfn = xmalloc(strlen(dir) + sizeof("/ctm.XXXXXX"));
+	snprintf(sfn, strlen(dir) + sizeof("/ctm.XXXXXX"), "%s/ctm.XXXXXX", dir);
 
 	if ((fd = mkstemp(sfn)) == -1)
 		errorx(8, "%s: %s\n", sfn, strerror(errno));
