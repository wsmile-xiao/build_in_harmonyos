Guard the x87 FPU control-word setup with __i386__/__x86_64__ so the
amd64 back end can be built by a non-x86 host compiler (pcc builds one
host-native compiler that can target amd64).
--- a/arch/amd64/code.c
+++ b/arch/amd64/code.c
@@ -533,7 +533,8 @@
 	NODE *p, *q;
 	char *c;
 
-#if defined(__GNUC__) || defined(__PCC__)
+#if (defined(__GNUC__) || defined(__PCC__)) && \
+    (defined(__i386__) || defined(__x86_64__))
 	/* Be sure that the compiler uses full x87 */
 	/* XXX cross-compiling will fail here */
 	int fcw = 0;
