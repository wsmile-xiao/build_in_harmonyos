--- a/lib/bpf/src/netlink.c
+++ b/lib/bpf/src/netlink.c
@@ -8,8 +8,17 @@
 #include <linux/bpf.h>
 #include <linux/if_ether.h>
 #include <linux/pkt_cls.h>
+#if defined(__linux__) && !defined(__GLIBC__)
+/* E091: 非 glibc 的 Linux libc（OHOS musl）下，内核头 linux/socket.h 无条件定义
+ * struct sockaddr_storage，与 libc 的 sys/socket.h 冲突；include 期间重命名避免
+ * redefinition。用 libc 特性检测而非平台宏适配（R8）。 */
+#define sockaddr_storage __linux_sockaddr_storage
+#endif
 #include <linux/rtnetlink.h>
 #include <linux/netdev.h>
+#if defined(__linux__) && !defined(__GLIBC__)
+#undef sockaddr_storage
+#endif
 #include <sys/socket.h>
 #include <errno.h>
 #include <time.h>
--- a/lib/bpf/src/nlattr.c
+++ b/lib/bpf/src/nlattr.c
@@ -9,7 +9,15 @@
 #include <errno.h>
 #include <string.h>
 #include <stdio.h>
+#if defined(__linux__) && !defined(__GLIBC__)
+/* E091: 同 netlink.c，非 glibc 的 Linux libc 下 linux/socket.h 与
+ * sys/socket.h 均定义 struct sockaddr_storage */
+#define sockaddr_storage __linux_sockaddr_storage
+#endif
 #include <linux/rtnetlink.h>
+#if defined(__linux__) && !defined(__GLIBC__)
+#undef sockaddr_storage
+#endif
 #include "nlattr.h"
 #include "libbpf_internal.h"
 
