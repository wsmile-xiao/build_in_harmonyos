diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,38 @@
+#!/bin/sh
+# Configure wrapper for perltidy (Perl ExtUtils::MakeMaker project)
+# This script wraps 'perl Makefile.PL' for build compatibility
+
+# Parse arguments
+PREFIX=""
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            ;;
+        PREFIX=*)
+            PREFIX="${arg#PREFIX=}"
+            ;;
+        INSTALLMAN1DIR=*)
+            MANDIR1="${arg#INSTALLMAN1DIR=}"
+            ;;
+        INSTALLMAN3DIR=*)
+            MANDIR3="${arg#INSTALLMAN3DIR=}"
+            ;;
+    esac
+done
+
+# Default prefix
+if [ -z "$PREFIX" ]; then
+    PREFIX="${DEFAULT_PREFIX:-/storage/Users/currentUser/usr/local}"
+fi
+
+MAN1DIR="${MANDIR1:-$PREFIX/share/man/man1}"
+MAN3DIR="${MANDIR3:-$PREFIX/share/man/man3}"
+
+# Run perl Makefile.PL with equivalent configure options
+echo "Configuring perltidy with PREFIX=$PREFIX"
+perl Makefile.PL PREFIX="$PREFIX" \
+    INSTALLMAN1DIR="$MAN1DIR" \
+    INSTALLMAN3DIR="$MAN3DIR"
+
+exit $?