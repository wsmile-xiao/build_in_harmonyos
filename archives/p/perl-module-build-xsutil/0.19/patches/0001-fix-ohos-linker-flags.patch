+# OpenHarmony platform fix: Override cbuilder() to fix linker flags
+# ld.lld does not support -fstack-protector-strong (a compiler flag in ldflags)
+# and system libraries (libc, libunwind) need explicit -L paths.
+sub cbuilder {
+    my $self = shift;
+    my $s = $self->{stash};
+    return $s->{_cbuilder} if $s->{_cbuilder};
+
+    require ExtUtils::CBuilder;
+    require Config;
+
+    # Start with a copy of Perl's Config
+    my %config = %Config::Config;
+
+    # Fix OpenHarmony linker flags if needed
+    if ($config{ldflags} =~ /-fstack-protector-strong/ ||
+        $config{lddlflags} =~ /-fstack-protector-strong/) {
+        $config{ldflags} =~ s/-fstack-protector-strong//g;
+        $config{lddlflags} =~ s/-fstack-protector-strong//g;
+        $config{lddlflags} .= ' -L/system/lib64 -L'
+            . ($ENV{HOME} || '/data') . '/usr/local/lib -lunwind -lc';
+        # Add musl headers include path for system headers (sys/types.h, etc.)
+        $config{ccflags} .= ' -I' . ($ENV{HOME} || '/data') . '/usr/local/include';
+    }
+
+    return $s->{_cbuilder} = ExtUtils::CBuilder->new(
+        config => \%config,
+        ($self->quiet ? (quiet => 1 ) : ()),
+    );
+}
