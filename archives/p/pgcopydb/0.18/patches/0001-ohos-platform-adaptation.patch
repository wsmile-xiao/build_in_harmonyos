+/*
+ * The platform rejects the System V message queue system calls (msgget,
+ * msgsnd, msgrcv and msgctl) with SIGSYS, so the queues are rebuilt on an
+ * anonymous shared memory ring buffer protected by a process-shared POSIX
+ * semaphore. The queues are created by the orchestrating process before it
+ * forks its workers, and MAP_SHARED anonymous memory is inherited by the
+ * children, so every user of a queue sees the same buffer.
+ *
+ * The recipe defines HAVE_BROKEN_SYSV_MSG for the affected platform only; the
+ * portable System V implementation is kept in the #else branch below.
+ */
+
+/* one message slot; must be large enough for struct QMessage.data */
+#define OHOS_QUEUE_SLOT_SIZE 256
+#define OHOS_QUEUE_CAPACITY 1024
+#define OHOS_QUEUE_MAX 64
+
+typedef struct OhosQueueSlot
+{
+	long type;
+	unsigned char data[OHOS_QUEUE_SLOT_SIZE];
+} OhosQueueSlot;
+
+typedef struct OhosQueueShm
+{
+	int head;                   /* index of the first message in the ring */
+	int count;                  /* number of messages in the ring */
+	uint64_t usedBytes;         /* bytes of message payload in the ring */
+	pid_t lastSender;           /* pid of the last successful queue_send() */
+	pid_t lastReceiver;         /* pid of the last successful queue_receive() */
+	sem_t mutex;                /* process-shared lock of the ring */
+	OhosQueueSlot slots[OHOS_QUEUE_CAPACITY];
+} OhosQueueShm;
+
+/* compile-time check that a message fits in a slot */
+typedef char ohos_queue_slot_size_check
+	[(sizeof(((QMessage *) 0)->data) <= OHOS_QUEUE_SLOT_SIZE) ? 1 : -1];
+
+/*
+ * The queues of this process, indexed by qId - 1; the array is inherited by
+ * fork(2) children, which are the processes driving the queues.
+ */
+static OhosQueueShm *ohosQueues[OHOS_QUEUE_MAX] = { 0 };
+
+static OhosQueueShm *
+ohos_queue_lookup(Queue *queue)
+{
+	if (queue->qId <= 0 || OHOS_QUEUE_MAX < queue->qId)
+	{
+		return NULL;
+	}
+
+	return ohosQueues[queue->qId - 1];
+}
+
+static bool
+ohos_queue_lock(OhosQueueShm *shm)
+{
+	int errStatus = 0;
+
+	do {
+		errStatus = sem_wait(&(shm->mutex));
+	} while (errStatus < 0 && errno == EINTR);
+
+	return errStatus == 0;
+}
+
+static void
+ohos_queue_unlock(OhosQueueShm *shm)
+{
+	(void) sem_post(&(shm->mutex));
+}
+
+
+/*
+ * queue_create creates a new message queue.
+ */
+bool
+queue_create(Queue *queue, char *name)
+{
+	queue->name = name;
+	queue->owner = getpid();
+
+	int qId = 0;
+
+	for (int i = 0; i < OHOS_QUEUE_MAX; i++)
+	{
+		if (ohosQueues[i] == NULL)
+		{
+			qId = i + 1;
+			break;
+		}
+	}
+
+	if (qId == 0)
+	{
+		log_fatal("Failed to create message queue: too many queues");
+		return false;
+	}
+
+	void *memory = mmap(NULL, sizeof(OhosQueueShm),
+						PROT_READ | PROT_WRITE,
+						MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+
+	if (memory == MAP_FAILED)
+	{
+		log_fatal("Failed to create message queue: %m");
+		return false;
+	}
+
+	OhosQueueShm *shm = (OhosQueueShm *) memory;
+
+	memset(shm, 0, sizeof(OhosQueueShm));
+
+	if (sem_init(&(shm->mutex), 1, 1) != 0)
+	{
+		log_fatal("Failed to initialise the message queue lock: %m");
+		(void) munmap(memory, sizeof(OhosQueueShm));
+		return false;
+	}
+
+	ohosQueues[qId - 1] = shm;
+	queue->qId = qId;
+
+	/* register the queue to the resources clean-up array */
+	if (!copydb_register_sysv_queue(&system_res_array, queue))
+	{
+		/* errors have already been logged */
+		return false;
+	}
+
+	log_debug("Created message %s queue %d", queue->name, queue->qId);
+
+	return true;
+}
+
+
+/*
+ * queue_unlink removes an existing message queue.
+ */
+bool
+queue_unlink(Queue *queue)
+{
+	OhosQueueShm *shm = ohos_queue_lookup(queue);
+
+	log_debug("unlink message queue %d (%s)", queue->qId, queue->name);
+
+	if (shm != NULL)
+	{
+		(void) sem_destroy(&(shm->mutex));
+		(void) munmap((void *) shm, sizeof(OhosQueueShm));
+
+		ohosQueues[queue->qId - 1] = NULL;
+	}
+
+	/* mark the queue as unlinked to the resources clean-up array */
+	if (!copydb_unlink_sysv_queue(&system_res_array, queue))
+	{
+		/* errors have already been logged */
+		return false;
+	}
+
+	return true;
+}
+
+
+/*
+ * queue_send sends a message on the queue.
+ */
+bool
+queue_send(Queue *queue, QMessage *msg)
+{
+	OhosQueueShm *shm = ohos_queue_lookup(queue);
+	int errStatus = -1;
+	bool firstLoop = true;
+
+	if (shm == NULL)
+	{
+		log_error("Failed to send a message to %s queue (%d): "
+				  "the queue is not known in this process",
+				  queue->name,
+				  queue->qId);
+		return false;
+	}
+
+	do {
+		if (asked_to_stop || asked_to_stop_fast || asked_to_quit)
+		{
+			return false;
+		}
+
+		if (firstLoop)
+		{
+			firstLoop = false;
+		}
+		else
+		{
+			pg_usleep(10 * 1000); /* 10 ms */
+		}
+
+		if (!ohos_queue_lock(shm))
+		{
+			continue;
+		}
+
+		if (shm->count < OHOS_QUEUE_CAPACITY)
+		{
+			OhosQueueSlot *slot =
+				&(shm->slots[(shm->head + shm->count) % OHOS_QUEUE_CAPACITY]);
+
+			slot->type = msg->type;
+			memcpy(slot->data, &(msg->data), sizeof(msg->data));
+
+			++(shm->count);
+			shm->usedBytes += sizeof(msg->data);
+			shm->lastSender = getpid();
+
+			errStatus = 0;
+		}
+		else
+		{
+			/* the queue is full, try again later */
+			errno = EAGAIN;
+			errStatus = -1;
+		}
+
+		ohos_queue_unlock(shm);
+	} while (errStatus < 0 && (errno == EINTR || errno == EAGAIN));
+
+	if (errStatus < 0)
+	{
+		log_error("Failed to send a message to %s queue (%d) "
+				  "with type %ld: %m",
+				  queue->name,
+				  queue->qId,
+				  msg->type);
+		return false;
+	}
+
+	return true;
+}
