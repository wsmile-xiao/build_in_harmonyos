+
+/*
+ * queue_receive receives a message from the queue.
+ */
+bool
+queue_receive(Queue *queue, QMessage *msg)
+{
+	OhosQueueShm *shm = ohos_queue_lookup(queue);
+	int errStatus = -1;
+	bool firstLoop = true;
+
+	if (shm == NULL)
+	{
+		log_error("Failed to receive a message from %s queue (%d): "
+				  "the queue is not known in this process",
+				  queue->name,
+				  queue->qId);
+		return false;
+	}
+
+	do {
+		if (asked_to_stop || asked_to_stop_fast || asked_to_quit)
+		{
+			return false;
+		}
+
+		if (firstLoop)
+		{
+			firstLoop = false;
+		}
+		else
+		{
+			pg_usleep(10 * 1000); /* 10 ms */
+		}
+
+		if (!ohos_queue_lock(shm))
+		{
+			continue;
+		}
+
+		if (shm->count > 0)
+		{
+			OhosQueueSlot *slot = &(shm->slots[shm->head]);
+
+			msg->type = slot->type;
+			memcpy(&(msg->data), slot->data, sizeof(msg->data));
+
+			shm->head = (shm->head + 1) % OHOS_QUEUE_CAPACITY;
+			--(shm->count);
+			shm->usedBytes -= sizeof(msg->data);
+			shm->lastReceiver = getpid();
+
+			errStatus = 0;
+		}
+		else
+		{
+			/* the queue is empty, try again later */
+			errno = ENOMSG;
+			errStatus = -1;
+		}
+
+		ohos_queue_unlock(shm);
+	} while (errStatus < 0 && (errno == EINTR || errno == ENOMSG));
+
+	if (errStatus < 0)
+	{
+		log_error("Failed to receive a message from %s queue (%d): %m",
+				  queue->name,
+				  queue->qId);
+		return false;
+	}
+
+	return true;
+}
+
+
+/*
+ * queue_stats retrieves statistics from the queue.
+ */
+bool
+queue_stats(Queue *queue, QueueStats *stats)
+{
+	OhosQueueShm *shm = ohos_queue_lookup(queue);
+
+	if (shm == NULL)
+	{
+		log_error("Failed to get stats for %s message queue %d: "
+				  "the queue is not known in this process",
+				  queue->name,
+				  queue->qId);
+		return false;
+	}
+
+	if (!ohos_queue_lock(shm))
+	{
+		return false;
+	}
+
+	stats->msg_cbytes = shm->usedBytes;
+	stats->msg_qnum = shm->count;
+	stats->msg_lspid = shm->lastSender;
+	stats->msg_lrpid = shm->lastReceiver;
+
+	ohos_queue_unlock(shm);
+
+	return true;
+}
