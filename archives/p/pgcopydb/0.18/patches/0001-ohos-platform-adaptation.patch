+/*
+ * The platform rejects the System V semaphore system calls (semget, semctl
+ * and semop) with SIGSYS, so the locking facility is rebuilt on POSIX named
+ * semaphores instead: every slot of a semaphore set is a named semaphore
+ * whose name is derived from the (process-unique) semaphore id, which means
+ * that forked children -- and any process that re-opens the semaphore from
+ * the PGCOPYDB_LOG_SEMAPHORE environment variable -- address it by name.
+ *
+ * The recipe defines HAVE_BROKEN_SYSV_SEM for the affected platform only; the
+ * portable System V implementation is kept in the #else branch below.
+ */
+
+/* room for the longest POSIX semaphore name, including the leading slash */
+#define SEMAPHORE_NAME_SIZE 64
+
+static int semaphore_seq = 0;
+
+/*
+ * semaphore_posix_name computes the POSIX name of the given slot.
+ */
+static void
+semaphore_posix_name(int semId, int index, char *name, size_t size)
+{
+	snprintf(name, size, "/pgcopydb-sem-%d-%d", semId, index);
+}
+
+
+/*
+ * semaphore_posix_create creates the named semaphore of one slot. The handle
+ * is closed right away: what the other processes need is the name, and
+ * handles are re-opened on demand by semaphore_posix_handle().
+ */
+static bool
+semaphore_posix_create(int semId, int index, int value)
+{
+	char name[SEMAPHORE_NAME_SIZE] = { 0 };
+	sem_t *sem = SEM_FAILED;
+
+	semaphore_posix_name(semId, index, name, sizeof(name));
+
+	sem = sem_open(name, O_CREAT | O_EXCL, 0600, (unsigned int) value);
+
+	if (sem == SEM_FAILED && errno == EEXIST)
+	{
+		/* stale semaphore left behind by a process that did not cleanup */
+		(void) sem_unlink(name);
+
+		sem = sem_open(name, O_CREAT | O_EXCL, 0600, (unsigned int) value);
+	}
+
+	if (sem == SEM_FAILED)
+	{
+		log_error("Failed to create semaphore \"%s\": %m", name);
+		return false;
+	}
+
+	(void) sem_close(sem);
+
+	return true;
+}
+
+
+/*
+ * semaphore_posix_handle returns a handle on the slot currently addressed by
+ * the semaphore, opening it by name when necessary.
+ */
+static sem_t *
+semaphore_posix_handle(Semaphore *semaphore)
+{
+	char name[SEMAPHORE_NAME_SIZE] = { 0 };
+
+	if (semaphore->posixSem != NULL &&
+		semaphore->posixSemIndex == semaphore->semIndex)
+	{
+		return semaphore->posixSem;
+	}
+
+	if (semaphore->posixSem != NULL)
+	{
+		(void) sem_close(semaphore->posixSem);
+		semaphore->posixSem = NULL;
+	}
+
+	semaphore_posix_name(semaphore->semId, semaphore->semIndex,
+						 name, sizeof(name));
+
+	semaphore->posixSem = sem_open(name, 0);
+	semaphore->posixSemIndex = semaphore->semIndex;
+
+	if (semaphore->posixSem == SEM_FAILED)
+	{
+		semaphore->posixSem = NULL;
+
+		log_error("Failed to open semaphore \"%s\": %m", name);
+		return NULL;
+	}
+
+	return semaphore->posixSem;
+}
+
+
+/*
+ * semaphore_create creates a new semaphore with the value 1, or the value
+ * semaphore->initValue when it's not zero.
+ */
+bool
+semaphore_create(Semaphore *semaphore)
+{
+	semaphore->owner = getpid();
+	semaphore->semIndex = 0;
+
+	/* a process-unique id, used to derive the POSIX names */
+	semaphore->semId = (int) (((getpid() & 0x7FFFFF) << 8) |
+							  (++semaphore_seq & 0xFF));
+
+	/* by default the Semaphore struct is initialized to { 0 }, fix it */
+	semaphore->initValue = semaphore->initValue == 0 ? 1 : semaphore->initValue;
+
+	if (!semaphore_posix_create(semaphore->semId, 0, semaphore->initValue))
+	{
+		return false;
+	}
+
+	log_debug("Created semaphore %d", semaphore->semId);
+
+	/* register the semaphore to the resources clean-up array */
+	if (!copydb_register_sysv_semaphore(&system_res_array, semaphore))
+	{
+		/* errors have already been logged */
+		return false;
+	}
+
+	return true;
+}
+
+
+/*
+ * semaphore_create_set creates a set of `count` independent slots, all
+ * initialised to 1 (unlocked). With POSIX named semaphores, each slot simply
+ * is its own named semaphore.
+ */
+bool
+semaphore_create_set(Semaphore *semaphore, int count)
+{
+	semaphore->owner = getpid();
+	semaphore->semIndex = 0;
+
+	/* a process-unique id, used to derive the POSIX names */
+	semaphore->semId = (int) (((getpid() & 0x7FFFFF) << 8) |
+							  (++semaphore_seq & 0xFF));
+
+	for (int i = 0; i < count; i++)
+	{
+		if (!semaphore_posix_create(semaphore->semId, i, 1))
+		{
+			log_error("Failed to create semaphore set of %d slots", count);
+			return false;
+		}
+	}
+
+	log_debug("Created semaphore set %d with %d slots", semaphore->semId, count);
+
+	/* register the set to the resources clean-up array */
+	if (!copydb_register_sysv_semaphore(&system_res_array, semaphore))
+	{
+		/* errors have already been logged */
+		return false;
+	}
+
+	return true;
+}
+
+
+/*
+ * semaphore_open opens our semaphore. We share the semaphore identifier in
+ * the environment and the POSIX names are derived from it, so there is
+ * nothing else to do here.
+ */
+bool
+semaphore_open(Semaphore *semaphore)
+{
+	char semIdString[BUFSIZE] = { 0 };
+
+	/* ensure the owner is set to zero when we re-open an existing semaphore */
+	semaphore->owner = 0;
+
+	if (!get_env_copy(PGCOPYDB_LOG_SEMAPHORE, semIdString, BUFSIZE))
+	{
+		/* errors have already been logged */
+		return false;
+	}
+
+	if (!stringToInt(semIdString, &semaphore->semId))
+	{
+		/* errors have already been logged */
+		return false;
+	}
+
+	semaphore->semIndex = 0;
+	semaphore->posixSem = NULL;
+
+	log_debug("Using semaphore %d", semaphore->semId);
+
+	return true;
+}
+
+
+/*
+ * semaphore_unlink removes an existing semaphore: all the slots of the set.
+ */
+bool
+semaphore_unlink(Semaphore *semaphore)
+{
+	char name[SEMAPHORE_NAME_SIZE] = { 0 };
+
+	log_debug("sem unlink %d", semaphore->semId);
+
+	if (semaphore->posixSem != NULL)
+	{
+		(void) sem_close(semaphore->posixSem);
+		semaphore->posixSem = NULL;
+	}
+
+	/*
+	 * Sets are always created starting from slot 0, so remove slots 0, 1, ...
+	 * up to the first one that does not exist.
+	 */
+	for (int index = 0; index < INT_MAX; index++)
+	{
+		sem_t *sem = SEM_FAILED;
+
+		semaphore_posix_name(semaphore->semId, index, name, sizeof(name));
+
+		sem = sem_open(name, 0);
+
+		if (sem == SEM_FAILED)
+		{
+			if (errno == ENOENT)
+			{
+				break;
+			}
+
+			fformat(stderr, "Failed to remove semaphore %d slot %d: %m\n",
+					semaphore->semId, index);
+			return false;
+		}
+
+		(void) sem_close(sem);
+
+		if (sem_unlink(name) != 0)
+		{
+			fformat(stderr, "Failed to remove semaphore %d slot %d: %m\n",
+					semaphore->semId, index);
+			return false;
+		}
+	}
+
+	/* mark the semaphore as unlinked to the resources clean-up array */
+	if (!copydb_unlink_sysv_semaphore(&system_res_array, semaphore))
+	{
+		/* errors have already been logged */
+		return false;
+	}
+
+	return true;
+}
+
+
+/*
+ * semaphore_cleanup is used when we find a stale PID file, to remove a
+ * possibly left behind semaphore. The user could also use ipcs and ipcrm to
+ * figure that out, if the stale pidfile does not exist anymore.
+ */
+bool
+semaphore_cleanup(const char *pidfile)
+{
+	Semaphore semaphore;
+
+	long fileSize = 0L;
+	char *fileContents = NULL;
+
+	if (!file_exists(pidfile))
+	{
+		return false;
+	}
+
+	if (!read_file(pidfile, &fileContents, &fileSize))
+	{
+		return false;
+	}
+
+	LinesBuffer lbuf = { 0 };
+
+	if (!splitLines(&lbuf, fileContents))
+	{
+		/* errors have already been logged */
+		return false;
+	}
+
+	if (lbuf.count < PIDFILE_LINE_SEM_ID)
+	{
+		log_debug("Failed to cleanup the semaphore from stale pid file \"%s\": "
+				  "it contains %lld lines, semaphore id is expected in line %d",
+				  pidfile,
+				  (long long) lbuf.count,
+				  PIDFILE_LINE_SEM_ID);
+		return false;
+	}
+
+	if (!stringToInt(lbuf.lines[PIDFILE_LINE_SEM_ID], &(semaphore.semId)))
+	{
+		/* errors have already been logged */
+		return false;
+	}
+
+	log_trace("Read semaphore id %d from stale pidfile", semaphore.semId);
+
+	return semaphore_unlink(&semaphore);
+}
+
+
+/*
+ * semaphore_lock locks a semaphore (decrement count), blocking if count would
+ * be < 0
+ */
+bool
+semaphore_lock(Semaphore *semaphore)
+{
+	sem_t *sem = NULL;
+
+	/* semId == 0: no semaphore allocated (e.g. read-only catalog) — no-op */
+	if (semaphore->semId == 0)
+	{
+		return true;
+	}
+
+	/* a child process must not inherit the lock depth of its parent */
+	if (semaphore->depthOwner != getpid())
+	{
+		semaphore->depth = 0;
+		semaphore->depthOwner = getpid();
+	}
+
+	/*
+	 * Some semaphores are used in a re-entrant way: when this very process
+	 * already holds the lock, only account for the extra nesting level.
+	 */
+	if (semaphore->reentrant && semaphore->depth > 0)
+	{
+		++semaphore->depth;
+		return true;
+	}
+
+	sem = semaphore_posix_handle(semaphore);
+
+	if (sem == NULL)
+	{
+		return false;
+	}
+
+	/*
+	 * Note: if errStatus is -1 and errno == EINTR then it means we returned
+	 * from the operation prematurely because we were sent a signal. So we
+	 * try and lock the semaphore again.
+	 */
+	int errStatus = 0;
+
+	do {
+		if (errStatus < 0 &&
+			(asked_to_stop || asked_to_stop_fast || asked_to_quit))
+		{
+			return false;
+		}
+
+		errStatus = sem_wait(sem);
+	} while (errStatus < 0 && errno == EINTR);
+
+	if (errStatus < 0)
+	{
+		fformat(stderr,
+				"%d Failed to acquire a lock with semaphore %d: %m\n",
+				getpid(),
+				semaphore->semId);
+		return false;
+	}
+
+	/* always maintain the depth, even for non-reentrant semaphores */
+	++semaphore->depth;
+
+	return true;
+}
+
+
+/*
+ * semaphore_unlock unlocks a semaphore (increment count)
+ */
+bool
+semaphore_unlock(Semaphore *semaphore)
+{
+	sem_t *sem = NULL;
+
+	/* semId == 0: no semaphore allocated (e.g. read-only catalog) — no-op */
+	if (semaphore->semId == 0)
+	{
+		return true;
+	}
+
+	/* a child process must not inherit the lock depth of its parent */
+	if (semaphore->depthOwner != getpid())
+	{
+		semaphore->depth = 0;
+		semaphore->depthOwner = getpid();
+	}
+
+	/* unlocking a reentrant semaphore skips an actual sem_post() call */
+	if (semaphore->reentrant && semaphore->depth > 1)
+	{
+		--semaphore->depth;
+		return true;
+	}
+
+	sem = semaphore_posix_handle(semaphore);
+
+	if (sem == NULL)
+	{
+		return false;
+	}
+
+	int errStatus = 0;
+
+	do {
+		if (errStatus < 0 &&
+			(asked_to_stop || asked_to_stop_fast || asked_to_quit))
+		{
+			return false;
+		}
+
+		errStatus = sem_post(sem);
+	} while (errStatus < 0 && errno == EINTR);
+
+	if (errStatus < 0)
+	{
+		fformat(stderr,
+				"Failed to release a lock with semaphore %d: %m\n",
+				semaphore->semId);
+		return false;
+	}
+
+	--semaphore->depth;
+
+	return true;
+}
