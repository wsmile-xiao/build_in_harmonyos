 inline uint64 RDTSC()
 {
         uint64 result = 0;
-#ifdef _MSC_VER
+#if defined(_MSC_VER)
         // Windows
         #if _MSC_VER>= 1600
         result = static_cast<uint64>(__rdtsc());
