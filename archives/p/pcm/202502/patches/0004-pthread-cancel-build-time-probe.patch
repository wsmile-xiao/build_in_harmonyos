--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -3,6 +3,25 @@
 
 include(FindOpenSSL)
 
+#######################
+# pthread_cancel availability
+#######################
+
+# pthread_cancel() is a POSIX cancellation point that several C libraries,
+# musl derivatives in particular, do not implement.  Probe for it instead of
+# assuming it, so that AsynchronCounterState can report the limitation rather
+# than fail to build.
+include(CheckSymbolExists)
+set(CMAKE_REQUIRED_LIBRARIES ${CMAKE_THREAD_LIBS_INIT})
+check_symbol_exists(pthread_cancel "pthread.h" PCM_HAVE_PTHREAD_CANCEL)
+unset(CMAKE_REQUIRED_LIBRARIES)
+if(PCM_HAVE_PTHREAD_CANCEL)
+    message(STATUS "pthread_cancel() is available: asynchronous counter threads can be cancelled")
+else()
+    message(STATUS "pthread_cancel() is not provided by the C library of this platform")
+endif()
+add_compile_definitions(PCM_HAVE_PTHREAD_CANCEL=$<BOOL:${PCM_HAVE_PTHREAD_CANCEL}>)
+
 # All pcm-* executables
 set(PROJECT_NAMES pcm pcm-numa pcm-latency pcm-power pcm-msr pcm-memory pcm-tsx pcm-pcie pcm-core pcm-iio pcm-lspci pcm-pcicfg pcm-mmio pcm-tpmi pcm-raw pcm-accel)
 
