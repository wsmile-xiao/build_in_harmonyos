--- a/src/types.h
+++ b/src/types.h
@@ -1657,23 +1657,40 @@
 
 inline void pcm_cpuid(int leaf, PCM_CPUID_INFO& info)
 {
-#ifdef _MSC_VER
+#if defined(_MSC_VER)
     // version for Windows
     __cpuid(info.array, leaf);
-#else
+#elif defined(__x86_64__) || defined(__i386__)
     __asm__ __volatile__("cpuid" : \
         "=a" (info.reg.eax), "=b" (info.reg.ebx), "=c" (info.reg.ecx), "=d" (info.reg.edx) : "a" (leaf));
+#else
+    // CPUID is an x86-only instruction.  Other architectures have no
+    // architectural equivalent, so report the reserved zero leaf instead of
+    // fabricating an x86 CPU identification.
+    (void)leaf;
+    info.array[0] = 0;
+    info.array[1] = 0;
+    info.array[2] = 0;
+    info.array[3] = 0;
 #endif
 }
 
 /* Adding the new version of cpuid with leaf and subleaf as an input */
 inline void pcm_cpuid(const unsigned leaf, const unsigned subleaf, PCM_CPUID_INFO & info)
 {
-    #ifdef _MSC_VER
+    #if defined(_MSC_VER)
     __cpuidex(info.array, leaf, subleaf);
-    #else
+    #elif defined(__x86_64__) || defined(__i386__)
     __asm__ __volatile__ ("cpuid" : \
                           "=a" (info.reg.eax), "=b" (info.reg.ebx), "=c" (info.reg.ecx), "=d" (info.reg.edx) : "a" (leaf), "c" (subleaf));
+    #else
+    // See pcm_cpuid() above: no CPUID outside x86, report the zero leaf.
+    (void)leaf;
+    (void)subleaf;
+    info.array[0] = 0;
+    info.array[1] = 0;
+    info.array[2] = 0;
+    info.array[3] = 0;
     #endif
 }
 
