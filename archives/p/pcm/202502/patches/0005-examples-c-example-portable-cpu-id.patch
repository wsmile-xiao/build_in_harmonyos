--- a/examples/c_example.c
+++ b/examples/c_example.c
@@ -2,9 +2,13 @@
 #include <dlfcn.h>
 #include <stdint.h>
 #include <stdlib.h>
+#if !defined(__x86_64__) && !defined(__i386__)
+#include <sched.h>
+#endif
 
 int pcm_getcpu()
 {
+#if defined(__x86_64__) || defined(__i386__)
 	int id = -1;
 	asm volatile (
 		"rdtscp\n\t"
@@ -14,6 +18,12 @@
 	// Linux encodes the NUMA node starting at bit 12, so remove the NUMA
 	// bits when returning the CPU integer by masking with 0xFFF.
 	return id & 0xFFF;
+#else
+	// RDTSCP is an x86 instruction and has no architectural equivalent.
+	// sched_getcpu() is the POSIX interface for the same question and every
+	// libc provides it.
+	return sched_getcpu();
+#endif
 }
 
