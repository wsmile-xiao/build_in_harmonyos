diff -ruN /dev/null b/lib/Class/MOP/PurePerl.pm
--- /dev/null
+++ b/lib/Class/MOP/PurePerl.pm
@@ -0,0 +1,136 @@
+package Class::MOP::PurePerl;
+# OpenHarmony: Pure Perl fallback for Class::MOP when XS Moose.so cannot be loaded
+# Provides implementations of all XS-installed simple reader methods
+
+use strict;
+use warnings;
+no warnings 'redefine';
+
+use Scalar::Util qw(blessed);
+
+my %_reexport_flags;
+
+sub install {
+    # Class::MOP::Package: name reads from 'package' key
+    *Class::MOP::Package::name = sub { $_[0]->{package} };
+
+    # Class::MOP::Class: simple readers
+    *Class::MOP::Class::instance_metaclass = sub { $_[0]->{instance_metaclass} };
+    *Class::MOP::Class::immutable_trait = sub { $_[0]->{immutable_trait} };
+    *Class::MOP::Class::constructor_class = sub { $_[0]->{constructor_class} };
+    *Class::MOP::Class::constructor_name = sub { $_[0]->{constructor_name} };
+    *Class::MOP::Class::destructor_class = sub { $_[0]->{destructor_class} };
+
+    # Class::MOP::Instance: simple readers
+    *Class::MOP::Instance::associated_metaclass = sub { $_[0]->{associated_metaclass} };
+
+    # Class::MOP::Attribute: simple readers
+    *Class::MOP::Attribute::associated_class = sub { $_[0]->{associated_class} };
+    *Class::MOP::Attribute::associated_methods = sub { $_[0]->{associated_methods} };
+
+    # Class::MOP::Mixin::AttributeCore: simple readers (all installed by bootstrap)
+    for my $attr (qw(name accessor reader writer predicate clearer builder
+                      init_arg initializer definition_context insertion_order)) {
+        no strict 'refs';
+        *{"Class::MOP::Mixin::AttributeCore::$attr"} = sub { $_[0]->{$attr} };
+    }
+
+    # Class::MOP::Mixin::HasAttributes: simple readers
+    *Class::MOP::Mixin::HasAttributes::attribute_metaclass = sub { $_[0]->{attribute_metaclass} };
+    *Class::MOP::Mixin::HasAttributes::_attribute_map = sub { $_[0]->{attributes} };
+
+    # Class::MOP::Mixin::HasMethods: simple readers
+    *Class::MOP::Mixin::HasMethods::method_metaclass = sub { $_[0]->{method_metaclass} };
+    *Class::MOP::Mixin::HasMethods::wrapped_method_metaclass = sub { $_[0]->{wrapped_method_metaclass} };
+    *Class::MOP::Mixin::HasMethods::_method_map = sub {
+        $_[0]->{_methods} ||= {}
+    };
+
+    # Class::MOP::Method: simple readers + is_stub
+    *Class::MOP::Method::name = sub { $_[0]->{name} };
+    *Class::MOP::Method::package_name = sub { $_[0]->{package_name} };
+    *Class::MOP::Method::body = sub { $_[0]->{body} };
+    *Class::MOP::Method::is_stub = sub {
+        my $self = shift;
+        my $body = $self->{body};
+        return 0 unless ref($body) eq 'CODE';
+        require B;
+        my $cv = B::svref_2object($body);
+        return 0 if $cv->XSUB;
+        my $root = $cv->ROOT;
+        return ref($root) eq 'B::NULL';
+    };
+
+    # Class::MOP::Method::Generated: simple readers
+    *Class::MOP::Method::Generated::is_inline = sub { $_[0]->{is_inline} };
+    *Class::MOP::Method::Generated::definition_context = sub { $_[0]->{definition_context} };
+
+    # Class::MOP::Method::Inlined: simple readers
+    *Class::MOP::Method::Inlined::_expected_method_class = sub { $_[0]->{_expected_method_class} };
+
+    # Provide _new that processes attribute defaults from metaclass
+    *Class::MOP::Object::_new = sub {
+        my $class = ref($_[0]) || $_[0];
+        my $args = @_ > 1 ? ($_[1] || {}) : {};
+        $args = {@_} if ref($args) ne 'HASH' && @_ > 1;
+        my $instance = bless { %{$args} }, $class;
+        # Process attribute defaults from metaclass
+        my $meta = Class::MOP::class_of($class);
+        if ($meta && $meta->can('get_all_attributes')) {
+            for my $attr ($meta->get_all_attributes) {
+                my $init_arg = $attr->can('init_arg') ? $attr->init_arg : $attr->name;
+                next unless defined $init_arg;
+                next if exists $instance->{$init_arg};
+                if ($attr->can('has_default') && $attr->has_default) {
+                    my $default = $attr->default;
+                    if (ref($default) eq 'CODE') {
+                        $instance->{$init_arg} = $default->($instance);
+                    } else {
+                        $instance->{$init_arg} = $default;
+                    }
+                }
+            }
+        }
+        return $instance;
+    };
+
+    # Provide new method (delegates to MOP new_object when available, else _new)
+    *Class::MOP::Object::new = sub {
+        my $class = shift;
+        my $meta = Class::MOP::class_of($class);
+        if ($meta && $meta->can('new_object')) {
+            return $meta->new_object(@_);
+        }
+        return $class->_new(@_);
+    };
+
+    # Provide meta method for bootstrap (auto-create metaclass)
+    *Class::MOP::Object::meta = sub {
+        my $class = blessed($_[0]) || $_[0];
+        Class::MOP::class_of($class)
+            || Class::MOP::Class->initialize($class);
+    };
+
+    # Provide get_code_info as pure Perl (using B module)
+    *Class::MOP::get_code_info = sub {
+        my ($coderef) = @_;
+        require B;
+        my $cv = B::svref_2object($coderef);
+        my $pkg = $cv->GV->STASH->NAME;
+        my $name = $cv->GV->NAME;
+        return ($pkg, $name) if $pkg && $name;
+        return ();
+    };
+
+    # Moose::Exporter XS functions - proper reexport tracking
+    *Moose::Exporter::_flag_as_reexport = sub {
+        my ($gv) = @_;
+        $_reexport_flags{"$gv"} = 1;
+    };
+    *Moose::Exporter::_export_is_flagged = sub {
+        my ($gv) = @_;
+        return $_reexport_flags{"$gv"} ? 1 : 0;
+    };
+}
+
+1;
