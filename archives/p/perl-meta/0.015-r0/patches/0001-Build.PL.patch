diff -ruN a/Build.PL b/Build.PL
--- a/Build.PL
+++ b/Build.PL
@@ -1,28 +1,41 @@
 use v5;
 use strict;
 use warnings;
 
 use Module::Build;
 
 my @extra_compiler_flags;
 
 push @extra_compiler_flags, qw( -DDEBUGGING=-g ) if $^X =~ m|/debugperl|;
+
+# __OHOS__: Override compiler config to use the system cc (clang 15 with proper sysroot)
+# instead of perl's default clang (clang 18 without sysroot).
+# This fixes: (1) missing libc/libcrt during linking, (2) ld.lld rejecting -fstack-protector-strong
+my %ohos_config_override;
+if ($^O eq 'linux' && $ENV{OHOS_SDK_ROOT} || -e '/data/service/hnp/ohos-sdk.org') {
+   %ohos_config_override = (
+      cc => 'cc',
+      ld => 'cc',
+      lddlflags => '-shared -O2',
+   );
+}
 
 my $build = Module::Build->new(
    module_name => 'meta',
    configure_requires => {
       'Module::Build' => "0.4004", # test_requires
    },
    requires => {
       'perl' => '5.014',
    },
    test_requires => {
       'Test2::V0' => 0,
    },
    license => 'perl',
    create_license => 1,
    create_readme  => 1,
    extra_compiler_flags => \@extra_compiler_flags,
+   (%ohos_config_override ? (config => \%ohos_config_override) : ()),
 );
 
 $build->create_build_script;
