From: OpenHarmony Compile Agent
Subject: [PATCH] picorbc: use mkstemp+TMPDIR instead of tmpfile() on OpenHarmony

On OpenHarmony, /tmp is read-only (E002). The C library tmpfile()
function tries to create files in /tmp and fails. This patch replaces
tmpfile() with a wrapper using mkstemp() + $TMPDIR environment variable.

This file is from the gem "mruby-bin-picorbc" (branch 3.0.0),
cloned from https://github.com/hasumikin/mruby-bin-picorbc during build.

diff --git a/tools/picorbc/picorbc.c b/tools/picorbc/picorbc.c
--- a/tools/picorbc/picorbc.c
+++ b/tools/picorbc/picorbc.c
@@ -12,6 +12,22 @@
 #include <dump.h>
 #include <context.h>
 
+#ifdef __OHOS__
+#include <unistd.h>
+#include <fcntl.h>
+/* OpenHarmony: /tmp is read-only, use TMPDIR instead of tmpfile() */
+static FILE *ohos_tmpfile(void) {
+  const char *tmpdir = getenv("TMPDIR");
+  if (!tmpdir || !tmpdir[0]) tmpdir = getenv("HOME");
+  if (!tmpdir || !tmpdir[0]) tmpdir = ".";
+  char template[512];
+  snprintf(template, sizeof(template), "%s/.picorbc_XXXXXX", tmpdir);
+  int fd = mkstemp(template);
+  if (fd < 0) return NULL;
+  unlink(template);
+  return fdopen(fd, "w+b");
+}
+#define tmpfile ohos_tmpfile
+#endif
+
 int loglevel;
 
 struct picorbc_args {
