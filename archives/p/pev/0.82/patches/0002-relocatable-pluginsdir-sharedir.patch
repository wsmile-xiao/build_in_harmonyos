--- a/include/config.h
+++ b/include/config.h
@@ -53,6 +53,13 @@
 
 const char *pev_plugins_path(void);
 
+// Resolve a compile-time-baked installation path (PLUGINSDIR / SHAREDIR) to
+// its runtime location. Returns a malloc'd copy of `baked` itself when it
+// exists; otherwise, on Linux (/proc/self/exe), a malloc'd copy of
+// "<executable dir>/<exe_relative>" when that exists; otherwise a malloc'd
+// copy of `baked` again. Keeps DESTDIR/staging/relocatable installs usable.
+char *pev_config_baked_or_relocatable(const char *baked, const char *exe_relative);
+
 int pev_load_config(pev_config_t * const config);
 void pev_cleanup_config(pev_config_t * const config);
 
