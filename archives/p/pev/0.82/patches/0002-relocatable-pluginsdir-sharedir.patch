@@ -40,8 +40,10 @@
 #include <stdlib.h>
 #include <string.h>
 #include <stdarg.h>
+#include <sys/stat.h>
 #if defined(__linux__)
 #include <linux/limits.h>	// FIXME: Why?
+#include <unistd.h>		// readlink
 #elif defined(__APPLE__) || defined(__OpenBSD__) || defined(__FreeBSD__) || defined(__NetBSD__) || defined(__CYGWIN__)
 #include <limits.h>
 #endif
