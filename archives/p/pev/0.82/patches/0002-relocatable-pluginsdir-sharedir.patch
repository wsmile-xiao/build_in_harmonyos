 	return 0;
 }
 
+// The tools dlopen their output plugins from PLUGINSDIR and read
+// SHAREDIR "/userdb.txt", both baked at compile time. When the install is
+// relocated (DESTDIR/staging/relocatable prefixes, e.g. a Conan package
+// cache), the baked absolute path does not exist; fall back to the same
+// trailing path relative to the running executable (<exedir>/../…).
+char *pev_config_baked_or_relocatable(const char *baked, const char *exe_relative)
+{
+	struct stat st;
+
+	if (baked && stat(baked, &st) == 0)
+		return strdup(baked);
+
+#if defined(__linux__)
+	char exedir[PATH_MAX];
+	ssize_t len = readlink("/proc/self/exe", exedir, sizeof(exedir) - 1);
+	if (len > 0) {
+		exedir[len] = '\0';
+		char *last_slash = strrchr(exedir, '/');
+		if (last_slash != NULL && exe_relative != NULL) {
+			last_slash[1] = '\0';
+			char *candidate = malloc(strlen(exedir) + strlen(exe_relative) + 1);
+			if (candidate != NULL) {
+				strcpy(candidate, exedir);
+				strcat(candidate, exe_relative);
+				if (stat(candidate, &st) == 0)
+					return candidate;
+				free(candidate);
+			}
+		}
+	}
+#else
+	(void)exe_relative;
+#endif
+
+	return strdup(baked ? baked : ".");
+}
+
 void pev_cleanup_config(pev_config_t * const config) {
 	if (config == NULL)
 		return;
