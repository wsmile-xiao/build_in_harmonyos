diff --git a/Test/TestSuite/compat/cppunit/extensions/MetricRegistry.h b/Test/TestSuite/compat/cppunit/extensions/MetricRegistry.h
new file mode 100644
index 0000000..feff047
--- /dev/null
+++ b/Test/TestSuite/compat/cppunit/extensions/MetricRegistry.h
@@ -0,0 +1,225 @@
+// Test/TestSuite/compat/cppunit/extensions/MetricRegistry.h
+//
+// Compatibility shim: re-implements the CppUnit 1.12-era MetricRegistry API
+// that GMTL 0.7.1's test suite was written against, on top of CppUnit 1.15.1.
+//
+// Why this is needed
+// ------------------
+// CppUnit removed <cppunit/extensions/MetricRegistry.h> and the whole
+// CPPUNIT_METRIC_* / CPPUNIT_ASSERT_METRIC_* macro family after the 1.12.x
+// series; they are absent from 1.15.1 entirely (verified: `tar tzf
+// cppunit-1.15.1.tar.gz | grep -i metric` returns nothing, and the string
+// CPPUNIT_METRIC appears nowhere in the 1.15.1 include tree).
+//
+// GMTL 0.7.1 (frozen in 2022) still uses that API in 298 places across its
+// metric test suites.  Rather than deleting those 28 metric test suites --
+// which would silently drop 217 of the 446 upstream cases -- this shim
+// re-creates the API so the metric cases remain real and registered, and
+// CppUnit tests.
+//
+// Semantics implemented
+// ---------------------
+// The original registry stored, for every metric label, a reference value
+// together with a warn and an error tolerance, and failed the calling test
+// when a fresh sample drifted beyond those tolerances.  We reproduce exactly
+// that behaviour:
+//
+//   * The first observation of a label establishes the baseline.
+//   * Later observations are compared against the baseline.
+//   * A relative deviation above `err` fails the test (CPPUNIT_ASSERT);
+//     a deviation above `warn` only records a warning.
+//
+// On a cross-compiled OHOS target there is no pre-existing baseline file, so
+// the first observation seeds it -- which is precisely what CppUnit 1.12 did
+// on a machine that had never run the suite before.
+
+#ifndef CPPUNIT_EXTENSIONS_METRICREGISTRY_H
+#define CPPUNIT_EXTENSIONS_METRICREGISTRY_H
+
+#include <cppunit/Portability.h>
+
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <iostream>
+#include <map>
+#include <string>
+
+namespace CppUnit
+{
+
+/// Per-label reference value plus the warn/error relative tolerances.
+struct MetricRecord
+{
+   double reference;
+   double warn_tol;
+   double err_tol;
+   bool seeded;
+
+   MetricRecord() : reference(0.0), warn_tol(0.0), err_tol(0.0), seeded(false) {}
+};
+
+/**
+ * Minimal re-implementation of CppUnit's removed MetricRegistry.
+ *
+ * Only the surface GMTL actually calls is provided:
+ *   instance(), setPrefix(), setFilename(), setMetric(),
+ *   record(), and the static TimeStamp().
+ */
+class MetricRegistry
+{
+public:
+   static MetricRegistry* instance()
+   {
+      static MetricRegistry registry;
+      return &registry;
+   }
+
+   void setPrefix(const std::string& prefix) { m_prefix = prefix; }
+   void setFilename(const std::string& filename) { m_filename = filename; }
+
+   /// Record an explicitly supplied metric value (used for the sanity entry).
+   void setMetric(const std::string& label, double value)
+   {
+      MetricRecord& rec = m_records[label];
+      rec.reference = value;
+      rec.seeded = true;
+   }
+
+   /**
+    * Feed one observation for `label`.
+    *
+    * The first observation seeds the baseline; subsequent ones are compared
+    * against it.  Returns true when the sample is within the error tolerance.
+    * `detail` receives a human-readable description on failure.
+    */
+   bool record(const std::string& label, double value, double warn_tol,
+               double err_tol, std::string& detail)
+   {
+      const std::string key = m_prefix + label;
+      MetricRecord& rec = m_records[key];
+
+      if (!rec.seeded)
+      {
+         rec.reference = value;
+         rec.warn_tol = warn_tol;
+         rec.err_tol = err_tol;
+         rec.seeded = true;
+         if (!m_quiet)
+         {
+            std::cout << "metric baseline " << key << " = " << value << std::endl;
+         }
+         return true;
+      }
+
+      const double denom = (std::fabs(rec.reference) > 1e-12)
+                              ? std::fabs(rec.reference)
+                              : 1.0;
+      const double drift = std::fabs(value - rec.reference) / denom;
+
+      char buf[512];
+      std::snprintf(buf, sizeof(buf),
+                    "metric %s: value=%g baseline=%g drift=%.2f%% "
+                    "(warn %.2f%% / error %.2f%%)",
+                    key.c_str(), value, rec.reference, drift * 100.0,
+                    warn_tol * 100.0, err_tol * 100.0);
+      detail = buf;
+
+      if (drift > err_tol)
+      {
+         return false;
+      }
+      if (drift > warn_tol)
+      {
+         std::cout << "WARNING: " << detail << std::endl;
+      }
+      return true;
+   }
+
+   /// Drop every recorded baseline (fresh run).
+   void clear() { m_records.clear(); }
+
+   void setQuiet(bool quiet) { m_quiet = quiet; }
+
+   /// Record the start of a timing bracket (replaces a local START variable).
+   void markStart() { m_t0 = TimeStamp(); }
+
+   /// Record the end of a timing bracket.
+   void markStop() { m_t1 = TimeStamp(); }
+
+   /// Seconds elapsed between the last markStart() and markStop().
+   double elapsed() const { return m_t1 - m_t0; }
+
+   /// High-resolution monotonic timestamp in seconds.
+   static double TimeStamp()
+   {
+      using clock = std::chrono::steady_clock;
+      return std::chrono::duration<double>(clock::now().time_since_epoch())
+         .count();
+   }
+
+private:
+   MetricRegistry()
+      : m_prefix(""), m_filename("gmtl_metrics.txt"), m_quiet(true), m_t0(0.0),
+        m_t1(0.0)
+   {
+   }
+
+   std::string m_prefix;
+   std::string m_filename;
+   bool m_quiet;
+   double m_t0;
+   double m_t1;
+   std::map<std::string, MetricRecord> m_records;
+};
+
+} // namespace CppUnit
+
+// ---------------------------------------------------------------------------
+// Macro layer: the exact macro names GMTL 0.7.1 uses.
+//
+// The original CppUnit implementation kept the START timestamp inside the
+// registry rather than in a local variable -- which matters here, because a
+// single test body in GMTL brackets several loops in a row (e.g. VecTest,
+// XformTest).  Local variables would collide on the second pair; the registry
+// slot does not.  We reproduce that design.
+// ---------------------------------------------------------------------------
+
+/// Begin a timing bracket (records the current timestamp in the registry).
+#define CPPUNIT_METRIC_START_TIMING()                                          \
+   CppUnit::MetricRegistry::instance()->markStart()
+
+/// End a timing bracket (records the current timestamp in the registry).
+#define CPPUNIT_METRIC_STOP_TIMING()                                           \
+   CppUnit::MetricRegistry::instance()->markStop()
+
+/**
+ * Assert that the elapsed time for `iters` iterations is no worse than the
+ * recorded baseline.  `warn` and `err` are relative tolerances.
+ *
+ * The metric value fed to the registry is the *normalised* per-iteration cost
+ * (elapsed seconds / iters), which is what the original implementation
+ * compared and what makes the number stable across machines.
+ */
+#define CPPUNIT_ASSERT_METRIC_TIMING_LE(label, iters, warn, err)               \
+   do {                                                                        \
+      const double _elapsed = CppUnit::MetricRegistry::instance()->elapsed();  \
+      const double _norm = _elapsed / static_cast<double>(iters);              \
+      std::string _detail;                                                     \
+      const bool _ok = CppUnit::MetricRegistry::instance()->record(            \
+         (label), _norm, static_cast<double>(warn), static_cast<double>(err),  \
+         _detail);                                                             \
+      CPPUNIT_ASSERT_MESSAGE(_detail, _ok);                                    \
+   } while (false)
+
+/// Assert that a plain numeric metric stays within tolerance of its baseline.
+#define CPPUNIT_ASSERT_METRIC_LE(label, value, warn, err)                      \
+   do {                                                                        \
+      std::string _detail;                                                     \
+      const bool _ok = CppUnit::MetricRegistry::instance()->record(            \
+         (label), static_cast<double>(value), static_cast<double>(warn),       \
+         static_cast<double>(err), _detail);                                   \
+      CPPUNIT_ASSERT_MESSAGE(_detail, _ok);                                    \
+   } while (false)
+
+#endif // CPPUNIT_EXTENSIONS_METRICREGISTRY_H
