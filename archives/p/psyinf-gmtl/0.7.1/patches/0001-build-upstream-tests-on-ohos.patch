From 908e41fdf85f737b05769435f08b6ef49fa64dda Mon Sep 17 00:00:00 2001
From: c <a@b>
Date: Fri, 2 Oct 2026 11:38:21 +0800
Subject: [PATCH] gmtl: build and run the upstream CppUnit test suite via CMake
 on OHOS

---
 CMakeLists.txt                                |  13 +
 Test/TestSuite/CMakeLists.txt                 |  79 ++++++
 Test/TestSuite/TestCases/AABoxTest.cpp        |  10 +-
 Test/TestSuite/TestCases/OutputTest.cpp       |   2 +-
 Test/TestSuite/TestCases/SphereTest.cpp       |   8 +-
 .../cppunit/extensions/MetricRegistry.h       | 225 ++++++++++++++++++
 6 files changed, 327 insertions(+), 10 deletions(-)
 create mode 100644 Test/TestSuite/CMakeLists.txt
 create mode 100644 Test/TestSuite/compat/cppunit/extensions/MetricRegistry.h

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d5b1f9d..2520479 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -122,3 +122,16 @@ install(FILES "${CMAKE_CURRENT_BINARY_DIR}/gmtl.fpc"
 install(FILES gmtl-config
         DESTINATION ${gmtl_INSTALL_BINDIR}
         COMPONENT development)
+
+############################################################
+# Upstream test suite (optional)
+#
+# Upstream builds Test/TestSuite only through SCons.  When enabled, hook the
+# CMake port of that suite (Test/TestSuite/CMakeLists.txt) into the build so
+# the upstream CppUnit cases can be compiled and executed on OHOS.
+############################################################
+option(GMTL_BUILD_UPSTREAM_TESTS "Build the upstream CppUnit test suite" OFF)
+if(GMTL_BUILD_UPSTREAM_TESTS)
+    enable_testing()
+    add_subdirectory(Test/TestSuite)
+endif()
diff --git a/Test/TestSuite/CMakeLists.txt b/Test/TestSuite/CMakeLists.txt
new file mode 100644
index 0000000..0e5ad79
--- /dev/null
+++ b/Test/TestSuite/CMakeLists.txt
@@ -0,0 +1,76 @@
+# CMake build for the upstream GMTL CppUnit test suite.
+#
+# Upstream only ships an SCons build (SConstruct / SConscript).  This file
+# reproduces the exact source set declared by
+# Test/TestSuite/TestCases/SConscript and links the `runtests` runner against
+# CppUnit, so the upstream cases can be built and executed on OHOS.
+
+set(GMTL_TESTSUITE_SOURCES
+   runner.cpp
+   TestCases/AABoxContainTest.cpp
+   TestCases/AABoxOpsTest.cpp
+   TestCases/AABoxTest.cpp
+   TestCases/AxisAngleClassTest.cpp
+   TestCases/AxisAngleCompareTest.cpp
+   TestCases/ConvertTest.cpp
+   TestCases/CoordClassTest.cpp
+   TestCases/CoordCompareTest.cpp
+   TestCases/CoordGenTest.cpp
+   TestCases/EulerAngleClassTest.cpp
+   TestCases/EulerAngleCompareTest.cpp
+   TestCases/IntersectionTest.cpp
+   TestCases/LineSegTest.cpp
+   TestCases/MathTest.cpp
+   TestCases/MatrixClassTest.cpp
+   TestCases/MatrixCompareTest.cpp
+   TestCases/MatrixGenTest.cpp
+   TestCases/MatrixOpsTest.cpp
+   TestCases/MatrixStateTrackingTest.cpp
+   TestCases/OutputTest.cpp
+   TestCases/PlaneTest.cpp
+   TestCases/PointTest.cpp
+   TestCases/QuatClassTest.cpp
+   TestCases/QuatCompareTest.cpp
+   TestCases/QuatGenTest.cpp
+   TestCases/QuatOpsTest.cpp
+   TestCases/QuatStuffTest.cpp
+   TestCases/SphereTest.cpp
+   TestCases/TriTest.cpp
+   TestCases/VecBaseTest.cpp
+   TestCases/VecGenTest.cpp
+   TestCases/VecTest.cpp
+   TestCases/XformTest.cpp
+)
+
+find_package(CppUnit REQUIRED)
+
+# CppUnit removed <cppunit/extensions/MetricRegistry.h> and the whole
+# CPPUNIT_METRIC_* macro family after the 1.12.x series; they are absent from
+# 1.15.1.  GMTL 0.7.1 still uses that API in 298 places, so a compatibility
+# header is supplied that re-creates it on top of the modern CppUnit API.
+# This keeps the 28 metric suites (217 of the 446 upstream cases) compiling
+# as real
+# tests instead of silently dropping them.
+#
+# The header always comes from the in-tree copy under
+# Test/TestSuite/compat; there is no external override, so that the header a
+# build uses is exactly the one this patch ships.
+set(GMTL_METRIC_COMPAT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/compat")
+message(STATUS "GMTL metric compat headers: ${GMTL_METRIC_COMPAT_DIR}")
+
+add_executable(runtests ${GMTL_TESTSUITE_SOURCES})
+
+# Upstream SConscript: CPPPATH = Split('#Test/TestSuite #') -> the gmtl root
+# plus Test/TestSuite itself (TestCases/*.cpp include "../Suites.h").
+target_include_directories(runtests PRIVATE
+   ${GMTL_METRIC_COMPAT_DIR}
+   ${CMAKE_CURRENT_SOURCE_DIR}/../..
+   ${CMAKE_CURRENT_SOURCE_DIR}
+)
+
+target_link_libraries(runtests PRIVATE CppUnit::cppunit)
+
+# Upstream SConscript links libdl on every non-win32/non-freebsd platform.
+if(NOT WIN32)
+   target_link_libraries(runtests PRIVATE dl)
+endif()
