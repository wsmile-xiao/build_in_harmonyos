diff --git a/lib/IO/Socket/INET6.pm b/lib/IO/Socket/INET6.pm
--- a/lib/IO/Socket/INET6.pm
+++ b/lib/IO/Socket/INET6.pm
@@ -41,13 +41,85 @@ use Socket (qw
     )
 );

-# IO::Socket and Socket already import stuff here - possibly AF_INET6
-# and PF_INET6 so selectively import things from Socket6.
-use Socket6 (
-    qw(AI_PASSIVE getaddrinfo
-    sockaddr_in6 unpack_sockaddr_in6_all pack_sockaddr_in6_all in6addr_any)
+# Socket6 compatibility layer using Perl 5.42+ built-in Socket module
+# This provides Socket6 API functions that Socket module lacks
+BEGIN {
+    # Check if Socket6 is available
+    eval { require Socket6; Socket6->import(qw(AI_PASSIVE getaddrinfo sockaddr_in6 unpack_sockaddr_in6_all pack_sockaddr_in6_all in6addr_any)); };
+    if ($@) {
+        # Socket6 not available, use Socket with compatibility functions
+        no strict 'refs';
+        # Import from Socket what's available
+        Socket->import(qw(AI_PASSIVE getaddrinfo sockaddr_in6 inet_pton inet_ntop IN6ADDR_ANY));
+
+        # Define compatibility functions that Socket lacks
+        *in6addr_any = sub { return IN6ADDR_ANY; };
+
+        # pack_sockaddr_in6_all - pack full sockaddr_in6 with flowinfo and scopeid
+        *pack_sockaddr_in6_all = sub {
+            my ($port, $flowinfo, $addr, $scopeid) = @_;
+            $flowinfo ||= 0;
+            $scopeid ||= 0;
+            # Build sockaddr_in6 structure: family(2) + port(2) + flowinfo(4) + addr(16) + scopeid(4)
+            return pack('S S L a16 L', AF_INET6, $port, $flowinfo, $addr, $scopeid);
+        };
+
+        # unpack_sockaddr_in6_all - unpack full sockaddr_in6
+        *unpack_sockaddr_in6_all = sub {
+            my ($name) = @_;
+            # Parse sockaddr_in6: family(2) + port(2) + flowinfo(4) + addr(16) + scopeid(4)
+            my (undef, $port, $flowinfo, $addr, $scopeid) = unpack('S S L a16 L', $name);
+            return ($port, $flowinfo, $addr, $scopeid);
+        };
+
+        # Socket6::inet_pton and Socket6::inet_ntop aliases
+        *Socket6::inet_pton = \&Socket::inet_pton;
+        *Socket6::inet_ntop = \&Socket::inet_ntop;
+    }
 }

 use Carp;