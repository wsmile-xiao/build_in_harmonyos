diff --git a/configure b/configure
new file mode 100644
--- /dev/null
+++ b/configure
@@ -0,0 +1,19 @@
+#!/bin/sh
+set -eu
+prefix="${HOME}/usr/local"
+while [ "$#" -gt 0 ]; do
+    case "$1" in
+        --prefix=*) prefix=${1#--prefix=} ;;
+        --prefix)
+            if [ "$#" -lt 2 ]; then
+                printf '%s\n' 'configure: --prefix requires a path' >&2
+                exit 2
+            fi
+            shift
+            prefix=$1
+            ;;
+    esac
+    shift
+done
+sed "s|@PREFIX@|$prefix|g" Makefile.in > Makefile
+printf 'Configured pure Python install prefix: %s\n' "$prefix"
diff --git a/Makefile.in b/Makefile.in
new file mode 100644
--- /dev/null
+++ b/Makefile.in
@@ -0,0 +1,14 @@
+PREFIX = @PREFIX@
+PYTHON ?= python3
+PYTHON_VERSION := $(shell $(PYTHON) -c 'import sys; print("%d.%d" % sys.version_info[:2])')
+SITE_PACKAGES = $(DESTDIR)$(PREFIX)/lib/python$(PYTHON_VERSION)/site-packages
+LICENSE_DIR = $(DESTDIR)$(PREFIX)/share/licenses/parso
+
+.PHONY: all install
+all:
+	$(PYTHON) -m compileall -q parso
+
+install:
+	install -d "$(SITE_PACKAGES)" "$(LICENSE_DIR)"
+	cp -R parso "$(SITE_PACKAGES)/"
+	install -m 644 LICENSE.txt "$(LICENSE_DIR)/LICENSE.txt"
