@@ -13,6 +13,24 @@
 
 if(MSVC AND NOT BUILD_SHARED_LIBS)
   set(Protobuf_USE_STATIC_LIBS ON)
+endif()
+
+# The published protobuf/3.17.3 Conan package records `zlib::zlib` -- Conan's
+# default imported-target name for protobuf's own zlib dependency -- in the
+# link interface of protobuf::libprotobuf. That target only exists in a tree
+# where Conan's CMakeDeps generated zlib's config, so create it here from the
+# ZLIB_ROOT the recipe passes in.
+if(NOT TARGET zlib::zlib)
+  find_library(PC_ZLIB_LIBRARY NAMES z PATHS "${ZLIB_ROOT}/lib" "${ZLIB_ROOT}"
+               NO_DEFAULT_PATH)
+  find_path(PC_ZLIB_INCLUDE_DIR NAMES zlib.h PATHS "${ZLIB_ROOT}/include"
+            NO_DEFAULT_PATH)
+  if(PC_ZLIB_LIBRARY)
+    add_library(zlib::zlib UNKNOWN IMPORTED)
+    set_target_properties(zlib::zlib PROPERTIES IMPORTED_LOCATION
+                        "${PC_ZLIB_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES
+                        "${PC_ZLIB_INCLUDE_DIR}")
+  endif()
 endif()
 
 find_package(Protobuf CONFIG)
