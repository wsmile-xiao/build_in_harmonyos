diff -ruN a/src/libply-splash-core/ply-device-manager.c b/src/libply-splash-core/ply-device-manager.c
--- a/src/libply-splash-core/ply-device-manager.c
+++ b/src/libply-splash-core/ply-device-manager.c
@@ -707,20 +707,30 @@
 stop_watching_for_udev_events (ply_device_manager_t *manager)
 {
         if (manager->fd_watch == NULL)
                 return;
 
         ply_event_loop_stop_watching_fd (manager->loop, manager->fd_watch);
         manager->fd_watch = NULL;
 }
 #endif
 
+/* HarmonyOS: stub for add_input_devices_to_renderer when udev is not available */
+#ifndef HAVE_UDEV
+static void
+add_input_devices_to_renderer (ply_device_manager_t *manager,
+                               ply_renderer_t       *renderer)
+{
+        /* No input device management without udev */
+}
+#endif
+
 static void
 free_terminal (char                 *device,
                ply_terminal_t       *terminal,
                ply_device_manager_t *manager)
 {
         ply_hashtable_remove (manager->terminals, device);
 
         ply_terminal_free (terminal);
 }
 
