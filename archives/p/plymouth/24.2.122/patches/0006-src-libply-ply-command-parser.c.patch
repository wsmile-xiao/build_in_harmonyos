+/* HarmonyOS: rpmatch is a GNU extension not available in musl */
+#ifdef __OHOS__
+static int
+rpmatch (const char *response)
+{
+        if (response == NULL || response[0] == '\0')
+                return -1;
+        switch (response[0]) {
+        case 'y': case 'Y':
+                return 1;
+        case 'n': case 'N':
+                return 0;
+        default:
+                return -1;
+        }
+}
+#endif
