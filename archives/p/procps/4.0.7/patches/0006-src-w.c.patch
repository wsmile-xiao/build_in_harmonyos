+ * HAVE_UTMPX_H merely because the header exists; drop it so the code below
+ * uses the utmp API. getutent() returns NULL on OHOS (_PATH_UTMP is
+ * /dev/null/utmp), so the utmp scan reports no sessions — consistent with
+ * musl-based systems that do not maintain a utmp database. */
+#undef HAVE_UTMPX_H
+#endif
 
