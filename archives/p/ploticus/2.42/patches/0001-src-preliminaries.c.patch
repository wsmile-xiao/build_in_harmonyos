-strcpy( TDH_tmpdir, TMPDIR );
+/* ---- temp file directory selection (runtime, portable) ---- */
+/* Honour the standard $TMPDIR environment variable when it designates a
+ * usable directory; otherwise use the compiled-in default (the TMPDIR
+ * macro); if that is not usable either, fall back to the current working
+ * directory.  The directory is probed by actually creating a file in it,
+ * because a platform may mount the compiled-in default read-only
+ * (OpenHarmony/HarmonyOS PC mounts /tmp read-only, so the temp files
+ * written by proc drawcommands, processdata and cgi diagnostics could
+ * otherwise not be created at all). */
+{
+char *envtmp = getenv( "TMPDIR" );
+char *chosen = NULL;
+FILE *tmpfp;
+
+GL_make_unique_string( uniq, 0 );
+
+if( envtmp != NULL && envtmp[0] != '\0' ) {
+	sprintf( buf, "%s%cploP%s", envtmp, PATH_SLASH, uniq );
+	tmpfp = fopen( buf, "w" );
+	if( tmpfp != NULL ) { fclose( tmpfp ); remove( buf ); chosen = envtmp; }
+	}
+
+if( chosen == NULL ) {
+	sprintf( buf, "%s%cploP%s", TMPDIR, PATH_SLASH, uniq );
+	tmpfp = fopen( buf, "w" );
+	if( tmpfp != NULL ) { fclose( tmpfp ); remove( buf ); chosen = TMPDIR; }
+	}
+
+if( chosen == NULL ) chosen = ".";
+
+strcpy( TDH_tmpdir, chosen );
+}
+
 pathslash = PATH_SLASH;
 
 /* set this now, but it might be updated depending on what's in config file.. */
 GL_make_unique_string( uniq, 0 );
 sprintf( PLS.tmpname, "%s%cplo%s", TDH_tmpdir, pathslash, uniq ); 
 
 /* make cgierrfile (default /tmp/plcgi_err) for cgi errors */
 sprintf( cgierrfile, "%s%cplcgi_err", TDH_tmpdir, PATH_SLASH );
 
 
