--- a/src/host/os_getpass.c	2026-08-15 14:00:32.950825001 +0800
+++ b/src/host/os_getpass.c	2026-08-15 14:01:32.738823594 +0800
@@ -6,6 +6,10 @@
 
 #include "premake.h"
 
+#if defined(__OHOS__)
+#include <termios.h>
+#endif
+
 
 int os_getpass(lua_State* L)
 {
@@ -35,6 +39,28 @@
 		(void)prompt;
 		luaL_error(L, "Not supported by this platform");
 		return 0;
+	#elif PLATFORM_OHOS
+		/* OHOS lacks getpass(); read from stdin with echo disabled via termios */
+		{
+			struct termios tio, tio_old;
+			char buffer[1024];
+			fputs(prompt, stderr);
+			fflush(stderr);
+			if (tcgetattr(0, &tio) == 0) {
+				tio_old = tio;
+				tio.c_lflag &= ~ECHO;
+				tcsetattr(0, TCSAFLUSH, &tio);
+			}
+			if (fgets(buffer, sizeof(buffer), stdin) == NULL) {
+				buffer[0] = '\0';
+			}
+			if (tcgetattr(0, &tio) == 0) {
+				tcsetattr(0, TCSAFLUSH, &tio_old);
+			}
+			buffer[strcspn(buffer, "\r\n")] = '\0';
+			lua_pushstring(L, buffer);
+			return 1;
+		}
 	#elif PLATFORM_POSIX
 		lua_pushstring(L, getpass(prompt));
 		return 1;
