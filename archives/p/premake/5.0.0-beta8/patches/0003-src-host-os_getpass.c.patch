diff -ruN a/src/host/os_getpass.c b/src/host/os_getpass.c
--- a/src/host/os_getpass.c
+++ b/src/host/os_getpass.c
@@ -1,17 +1,18 @@
 /**
  * \file   os_getpass.c
  * \brief  Prompt and retrieve a password from the user.
  * \author Copyright (c) 2002-2008 Jess Perkins and the Premake project
  */
 
 #include "premake.h"
+#include <string.h>
 
 
 int os_getpass(lua_State* L)
 {
 	const char* prompt = luaL_checkstring(L, 1);
 
 	#if PLATFORM_WINDOWS
 		HANDLE hstdout = GetStdHandle(STD_OUTPUT_HANDLE);
 		HANDLE hstdin = GetStdHandle(STD_INPUT_HANDLE);
 		DWORD read_chars, mode, written_chars;
@@ -28,17 +29,30 @@
 		WriteConsoleA(hstdout, newline, (DWORD)strlen(newline), &written_chars, NULL);
 
 		buffer[strcspn(buffer, "\r\n")] = '\0';
 
 		lua_pushstring(L, buffer);
 		return 1;
 	#elif PLATFORM_COSMO
 		(void)prompt;
 		luaL_error(L, "Not supported by this platform");
 		return 0;
-	#elif PLATFORM_POSIX
+	#elif PLATFORM_POSIX && !defined(__OHOS__)
 		lua_pushstring(L, getpass(prompt));
+		return 1;
+	#elif defined(__OHOS__)
+		/* HarmonyOS: no getpass(), read from stdin */
+		size_t len;
+		char buffer[1024];
+		fprintf(stdout, "%s", prompt);
+		fflush(stdout);
+		if (fgets(buffer, sizeof(buffer), stdin) == NULL)
+			return 0;
+		len = strlen(buffer);
+		if (len > 0 && buffer[len-1] == '\n')
+			buffer[len-1] = '\0';
+		lua_pushstring(L, buffer);
 		return 1;
 	#else
 		#error Not implemented yet for this platform
 	#endif
 }
