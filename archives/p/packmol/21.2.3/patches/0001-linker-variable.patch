--- Makefile.orig	2026-09-05 22:34:58.289157188 +0800
+++ Makefile	2026-09-05 22:34:58.353156251 +0800
@@ -15,6 +15,13 @@
 # change the line below to the path of your fortran compiler. 
 #
 FORTRAN=/usr/bin/gfortran
+# Final linker driver.  packmol is pure Fortran and links with $(FORTRAN) by
+# default, so upstream semantics are unchanged.  HarmonyOS builds override
+# LINKER with the platform clang driver and LIBS with the static Fortran
+# runtime, because the flang-ohos tool package ships only the Fortran
+# frontend (no OHOS CRT / sysroot).
+LINKER ?= $(FORTRAN)
+LIBS ?=
 #
 # Change the flags of the compilation if you want:
 #
@@ -95,7 +102,7 @@
 	@echo " Compiling packmol with $(FORTRAN) " 
 	@echo " Flags: $(FLAGS) " 
 	@echo " ------------------------------------------------------ " 
-	@$(FORTRAN) -o packmol $(oall) $(FLAGS) 
+	@$(LINKER) -o packmol $(oall) $(FLAGS) $(LIBS) 
 	@\rm -f *.mod *.o
 	@echo " ------------------------------------------------------ " 
 	@echo " Packmol succesfully built." 
