--- a/Makefile
+++ b/Makefile
@@ -1,16 +1,20 @@
-# ehaupt: Makefile for ppmd
-#
+# GNU make Makefile for ppmd (upstream ships a FreeBSD pmake-only Makefile
+# using .for loops and :C variable substitution; this rewrite is portable).
+CXX	?=	clang++
+CXXFLAGS ?=	-O2
 
 OBJS=		PPMd.o Model.o
 TARGET=		ppmd
 
-all: build
+all: $(TARGET)
 
-build:
-.for f in $(OBJS)
-	$(CXX) $(CXXFLAGS) -c -o $(f) $(f:C/\.o/.cpp/)
-.endfor
+$(TARGET): $(OBJS)
 	$(CXX) $(CXXFLAGS) $(OBJS) -o $(TARGET)
 
+%.o: %.cpp
+	$(CXX) $(CXXFLAGS) -c -o $@ $<
+
 clean:
 	rm -f $(OBJS) $(TARGET)
+
+.PHONY: all clean
