  ****************************************************************************/
 
-enum { UNIT_SIZE=12, N1=4, N2=4, N3=4, N4=(128+3-1*N1-2*N2-3*N3)/4,
+/* A "unit" is the allocator granule: every allocation is a whole number of
+ * units and the structures cast onto unit memory must fit inside it:
+ *   MEM_BLK     = Stamp(DWORD) + next(ptr) + NU(DWORD)  = 3*sizeof(DWORD)
+ *   PPM_CONTEXT = 4 header bytes + Stats(ptr) + Suffix(ptr)         (packed)
+ * With 32-bit pointers (ILP32) both are exactly 12 bytes; with 64-bit
+ * pointers (LP64) MEM_BLK is 24 and PPM_CONTEXT is 20, so the granule must
+ * grow to 24 (a context keeps 4 bytes of slack, and two packed STATEs are
+ * 2*(2+sizeof(ptr))=20 <= 24, preserving the "2 states per unit" invariant).
+ * Upstream shipped i386-only builds and overflows every unit on LP64. */
+#if defined(__LP64__) || defined(_LP64) || defined(_WIN64)
+enum { UNIT_SIZE=24 };
+#else
+enum { UNIT_SIZE=12 };
+#endif
+enum { N1=4, N2=4, N3=4, N4=(128+3-1*N1-2*N2-3*N3)/4,
         N_INDEXES=N1+N2+N3+N4 };
 
