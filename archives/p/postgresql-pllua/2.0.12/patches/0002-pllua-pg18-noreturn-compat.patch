+#ifndef pg_attribute_noreturn
+/* Compatibility: PostgreSQL 18 removed pg_attribute_noreturn() (suffix
+ * attribute) in favor of pg_noreturn (C11 _Noreturn function specifier).
+ * pllua uses the old suffix style; redefine as __attribute__((noreturn))
+ * which works as a suffix on GCC/clang. */
+#define pg_attribute_noreturn() __attribute__((noreturn))
+#endif
+
 LUA_API int   (lua_error) (lua_State *L) pg_attribute_noreturn();
 LUALIB_API int (luaL_argerror) (lua_State *L, int arg, const char *extramsg) pg_attribute_noreturn();
 LUALIB_API int (luaL_typeerror) (lua_State *L, int arg, const char *tname) pg_attribute_noreturn();
