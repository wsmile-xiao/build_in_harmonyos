prefix=/test
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: pkgconf-fixture
Description: A well-formed package used by the Conan consumer test
Version: 1.2.3
URL: https://example.org/pkgconf-fixture
Maintainer: pkgconf test maintainer <maintainer@example.org>
Source: https://example.org/pkgconf-fixture-1.2.3.tar.xz
License: ISC
Cflags: -I${includedir}
Libs: -L${libdir} -lpkgconf_fixture
