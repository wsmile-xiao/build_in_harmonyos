@@ -172,8 +172,54 @@
 #define TEST_RUN(name, fn)	\
-	do {	\
+	do {	\
-		fprintf(stderr, "%s -> %s:", name, #fn);	\
+		fprintf(stderr, "%s -> %s:", name, #fn);	\
-		fn();	\
+		fn();	\
-		fprintf(stderr, " PASS\n");	\
+		fprintf(stderr, " PASS\n");	\
-	} while (0)
+	} while (0)
-
+
+static inline FILE *
+test_tmpfile(void)
+{
+#ifdef _WIN32
+	return tmpfile();
+#else
+	const char *tmpdir = getenv("TMPDIR");
+	char path[PKGCONF_ITEM_SIZE];
+	FILE *stream;
+	int fd;
+	int written;
+
+	if (tmpdir == NULL || tmpdir[0] == '\0')
+		return tmpfile();
+
+	written = snprintf(path, sizeof path, "%s/pkgconf-api-XXXXXX", tmpdir);
+	if (written < 0 || (size_t) written >= sizeof path)
+	{
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+
+	fd = mkstemp(path);
+	if (fd < 0)
+		return NULL;
+
+	if (unlink(path) != 0)
+	{
+		int saved_errno = errno;
+		close(fd);
+		errno = saved_errno;
+		return NULL;
+	}
+
+	stream = fdopen(fd, "w+b");
+	if (stream == NULL)
+	{
+		int saved_errno = errno;
+		close(fd);
+		errno = saved_errno;
+	}
+
+	return stream;
+#endif
+}
