+static int
+create_temp_parser_file(char *path)
+{
+#if defined(_WIN32)
+	size_t path_length = strlen(path);
+	if (path_length <= 3 || strcmp(path + path_length - 3, ".pc") != 0)
+	{
+		errno = EINVAL;
+		return -1;
+	}
+
+	path[path_length - 3] = '\0';
+	int temp_error = _mktemp_s(path, PKGCONF_ITEM_SIZE);
+	if (temp_error != 0)
+	{
+		errno = temp_error;
+		return -1;
+	}
+	if (strlen(path) + 3 >= PKGCONF_ITEM_SIZE)
+	{
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	strcat(path, ".pc");
+	return _open(path, _O_CREAT | _O_EXCL | _O_RDWR | _O_BINARY,
+	    _S_IREAD | _S_IWRITE);
+#else
+	return mkstemps(path, 3);  // keep ".pc"
+#endif
+}
