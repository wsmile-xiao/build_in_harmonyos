--- /dev/null
+++ b/tests/api/reallocarray-shim.c
@@ -0,0 +1,19 @@
+/* Test-only reallocarray replacement for targets whose libc lacks the API. */
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+void *reallocarray(void *ptr, size_t nmemb, size_t size);
+
+void *
+reallocarray(void *ptr, size_t nmemb, size_t size)
+{
+	if (size != 0 && nmemb > SIZE_MAX / size)
+	{
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	return realloc(ptr, nmemb * size);
+}
