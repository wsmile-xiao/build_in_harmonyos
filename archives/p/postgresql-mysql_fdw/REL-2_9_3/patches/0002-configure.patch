diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Dummy configure script for PGXS-based PostgreSQL extensions
+# PGXS extensions do not require a configure step; they build directly
+# with make USE_PGXS=1 using pg_config for build parameters.
+# This script exists to satisfy build verification tools that expect
+# a configure step before make.
+
+# Accept and ignore all standard configure arguments
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*) PREFIX="$1" ;;
+        --help) echo "Usage: ./configure [options]"; echo "Options: --prefix=DIR (ignored, pg_config provides paths)"; exit 0 ;;
+        *) ;;
+    esac
+    shift
+done
+
+# Create a minimal config.status-like marker for compatibility
+echo "# PGXS configure stub - no configuration needed" > config.status
+echo "configure: stub for PGXS build (prefix=${PREFIX:-default})"
+exit 0