 #include <unistd.h>
+
+/* tmpfile() is hardcoded to /tmp on musl, which is read-only on HarmonyOS.
+ * Create the temporary file in $TMPDIR (or a portable fallback dir) instead. */
+static FILE* make_temp_file(void)
+{
+    static char tmpl[PATH_MAX];
+    const char* tmpdir = getenv("TMPDIR");
+    if (tmpdir == NULL || *tmpdir == '\0') {
+        const char* home = getenv("HOME");
+        tmpdir = (home != NULL && *home != '\0') ? home : ".";
+    }
+    snprintf(tmpl, sizeof(tmpl), "%s/postsrsd-test-XXXXXX", tmpdir);
+    int fd = mkstemp(tmpl);
+    if (fd < 0)
+        return NULL;
+    FILE* f = fdopen(fd, "w+");
+    if (f == NULL) {
+        close(fd);
+        unlink(tmpl);
+    }
+    return f;
+}
 
