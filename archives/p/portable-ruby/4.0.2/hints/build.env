# Build environment hints for portable-ruby 4.0.2
# These hints are used by the G0 clean-verify process

# CC must include the ld-wrapper path for OHOS ELF signing
CC="clang -B/storage/Users/currentUser/tmp/ld-wrapper/"

# CONFIG_SHELL must be bash (not toybox sh)
CONFIG_SHELL=/storage/Users/currentUser/usr/local/bin/bash

# SHELL must be bash for Ruby's build system
SHELL=/storage/Users/currentUser/usr/local/bin/bash

# Prefix
PREFIX=/storage/Users/currentUser/usr/local

# Use install-nodoc instead of install (psych not available on OHOS)
INSTALL_TARGET=install-nodoc
