Fix nested declarations that shadow an enclosing loop variable

Three translation units declare a container iterator whose name collides with
an `int` loop counter that is still in scope in the enclosing block. Modern
C++ compilers reject this as a hard error:

    sets.cpp:771:37: error: redefinition of 'i' with a different type:
        'vector<Individual *>::iterator' vs 'int'
    sets.cpp:703:12: note: previous definition is here
      for (int i=0; i<snpset.size(); i++)

The same pattern occurs in elf.cpp (`map<int,int>::iterator i` shadowing
`int i`) and idhelp.cpp (`set<IDField*>::iterator j` shadowing `int j`).

This is not specific to HarmonyOS: any toolchain newer than gcc 3.x fails
here, which is why PLINK 1.07 needs this to build on any current system.
It is the fix Debian carries in debian/patches/gcc-4.7.patch ("Fix nested
declaration which fails in gcc-4.7", Bug-Closed: http://bugs.debian.org/667325),
authored by Rodolfo Garcia Penas, Dmitry Nezhevenko and Fernando Lemos
(2012-04-22) and forwarded to plink@chgr.mgh.harvard.edu.

Only the shadowing iterator variables are renamed (i -> i_iter, j -> j_iter).
No algorithm, control flow or output changes: the loops feed the set score
association result, the per-chromosome allele counters and the joint-field
name listing, all byte-identical.

--- a/sets.cpp
+++ b/sets.cpp
@@ -768,11 +768,11 @@
       //////////////////////////////////////////////
       // Reset original missing status
 
-      vector<Individual*>::iterator i = PP->sample.begin();
-      while ( i != PP->sample.end() )
+      vector<Individual*>::iterator i_iter = PP->sample.begin();
+      while ( i_iter != PP->sample.end() )
 	{
-	  (*i)->missing = (*i)->flag;
-	  ++i;
+	  (*i_iter)->missing = (*i_iter)->flag;
+	  ++i_iter;
 	}
 
       ////////////////////////////////////////////////
--- a/elf.cpp
+++ b/elf.cpp
@@ -1175,10 +1175,10 @@
 	  << setw(8) << gcnt << " "
 	  << setw(8) << (double)cnt / (double)gcnt << "\n";
 
-      map<int,int>::iterator i = chr_cnt.begin();
-      while ( i != chr_cnt.end() )
+      map<int,int>::iterator i_iter = chr_cnt.begin();
+      while ( i_iter != chr_cnt.end() )
 	{
-	  int c = i->first;
+	  int c = i_iter->first;
 	  int x = chr_cnt.find( c )->second;
 	  int y = chr_gcnt.find( c )->second;
 	  
@@ -1189,7 +1189,7 @@
 	      << setw(8) << y << " "
 	      << setw(8) << (double)x / (double)y << "\n";
 	  
-	  ++i;
+	  ++i_iter;
 	}
       
     }
--- a/idhelp.cpp
+++ b/idhelp.cpp
@@ -772,12 +772,12 @@
       for (int j = 0 ; j < jointField.size(); j++ )
 	{
 	  set<IDField*> & jf = jointField[j];
-	  set<IDField*>::iterator j = jf.begin();
+	  set<IDField*>::iterator j_iter = jf.begin();
 	  PP->printLOG(" { ");
-	  while ( j != jf.end() )
+	  while ( j_iter != jf.end() )
 	    {
-	      PP->printLOG( (*j)->name + " " );
-	      ++j;
+	      PP->printLOG( (*j_iter)->name + " " );
+	      ++j_iter;
 	    }
 	  PP->printLOG(" }");
 	}
