diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,22 +1,24 @@
 # Makefile for phoon
 
-BINDIR =	/usr/local/bin
-MANDIR =	/usr/local/man/man1
+PREFIX =	/storage/Users/currentUser/usr/local
+DESTDIR =
+BINDIR =	$(DESTDIR)$(PREFIX)/bin
+MANDIR =	$(DESTDIR)$(PREFIX)/share/man/man1
 
 DEFINES =	-DOS_BSD
 #DEFINES =	-DOS_SYSV
 
-CC =		cc
-CFLAGS =	-O $(DEFINES) -ansi -pedantic -U__STRICT_ANSI__ -Wall -Wpointer-arith -Wshadow -Wcast-qual -Wcast-align -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wredundant-decls -Wno-long-long
+CC =		clang
+CFLAGS =	-fPIC -O2 $(DEFINES) -ansi -pedantic -U__STRICT_ANSI__ -Wall -Wpointer-arith -Wshadow -Wcast-qual -Wcast-align -Wstrict-prototypes -Wmissing-prototypes -Wmissing-declarations -Wredundant-decls -Wno-long-long
 
-LDFLAGS =	-s
+LDFLAGS =
 
 
 all:		phoon
 
 phoon:		phoon.o date_parse.o astro.o
 	$(CC) $(LDFLAGS) -o phoon phoon.o date_parse.o astro.o -lm
 
 .c.o:
 	$(CC) $(CFLAGS) -c $<
 
