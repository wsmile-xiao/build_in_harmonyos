--- a/configure.ac
+++ b/configure.ac
@@ -385,6 +385,10 @@ AC_SEARCH_LIBS([pthread_create], [pthread pthreadGC2 pthreadGC1 pthreadGC], [],
 AC_SEARCH_LIBS([pthread_join], [pthread pthreadGC2 pthreadGC1 pthreadGC], [],
                AC_MSG_WARN([pthreads required]))
 
+# Gate PortAudio's thread-cancellation path on the actual libc capability:
+# some libcs define PTHREAD_CANCELED without providing pthread_cancel.
+AC_CHECK_FUNCS([pthread_cancel], [PD_CFLAGS="$PD_CFLAGS -DHAVE_PTHREAD_CANCEL"])
+
 # Illumos needs to link against libsocket for 'sendto' and friends
 AC_SEARCH_LIBS([sendto], [socket])
 
--- a/portaudio/portaudio/src/os/unix/pa_unix_util.c
+++ b/portaudio/portaudio/src/os/unix/pa_unix_util.c
@@ -205,14 +205,14 @@ PaError PaUtil_CancelThreading( PaUtilThreading *threading, int wait, PaError *e
        working thread (callbackThread) has'n received any stop signals from outside, please keep
        this in mind when considering using PaUtil_CancelThreading
     */
-#ifdef PTHREAD_CANCELED
+#if defined(PTHREAD_CANCELED) && defined(HAVE_PTHREAD_CANCEL)
     /* Only kill the thread if it isn't in the process of stopping (flushing adaptation buffers) */
     if( !wait )
         pthread_cancel( threading->callbackThread );   /* XXX: Safe to call this if the thread has exited on its own? */
 #endif
     pthread_join( threading->callbackThread, &pret );
 
-#ifdef PTHREAD_CANCELED
+#if defined(PTHREAD_CANCELED) && defined(HAVE_PTHREAD_CANCEL)
     if( pret && PTHREAD_CANCELED != pret )
 #else
     /* !wait means the thread may have been canceled */
@@ -449,14 +449,14 @@ PaError PaUnixThread_Terminate( PaUnixThread* self, int wait, PaError* exitResul
     {
         PA_DEBUG(( "%s: Canceling thread %d\n", __FUNCTION__, self->thread ));
         /* XXX: Safe to call this if the thread has exited on its own? */
-#ifdef PTHREAD_CANCELED
+#if defined(PTHREAD_CANCELED) && defined(HAVE_PTHREAD_CANCEL)
         pthread_cancel( self->thread );
 #endif
     }
     PA_DEBUG(( "%s: Joining thread %d\n", __FUNCTION__, self->thread ));
     PA_ENSURE_SYSTEM( pthread_join( self->thread, &pret ), 0 );
 
-#ifdef PTHREAD_CANCELED
+#if defined(PTHREAD_CANCELED) && defined(HAVE_PTHREAD_CANCEL)
     if( pret && PTHREAD_CANCELED != pret )
 #else
     /* !wait means the thread may have been canceled */
