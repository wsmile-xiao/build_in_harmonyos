--- a/src/polkitbackend/polkitbackendduktapeauthority.c	2025-12-18 00:14:53.000000000 +0800
+++ b/src/polkitbackend/polkitbackendduktapeauthority.c	2026-09-02 21:22:37.707483126 +0800
@@ -23,6 +23,24 @@
 
 #include <pthread.h>
 
+/* OHOS musl 不实现 POSIX 线程取消族（E085，同 asterisk 的 libohosshim 场景）：
+ * pthread_cancel/pthread_setcanceltype/pthread_setcancelstate/pthread_testcancel
+ * 无符号——提供存根（返回 ENOSYS），使 runaway-killer 线程机制可编译链接。
+ * OHOS 上线程终止需用其他机制（本适配不依赖该 daemon 运行）。 */
+#include <errno.h>
+int pthread_cancel(pthread_t thread) { (void) thread; return ENOSYS; }
+int pthread_setcanceltype(int type, int *oldtype) {
+  (void) type;
+  if (oldtype) { *oldtype = PTHREAD_CANCEL_DEFERRED; }
+  return 0;
+}
+int pthread_setcancelstate(int state, int *oldstate) {
+  (void) state;
+  if (oldstate) { *oldstate = PTHREAD_CANCEL_ENABLE; }
+  return 0;
+}
+void pthread_testcancel(void) { }
+
 #include "polkitbackendcommon.h"
 
 #include "duktape.h"
