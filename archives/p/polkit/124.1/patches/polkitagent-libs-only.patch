diff --git a/src/meson.build b/src/meson.build
index 985d0b0..ed8133b 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -4,7 +4,15 @@ symbol_map = meson.current_source_dir() / 'symbol.map'
 ldflags = cc.get_supported_link_arguments('-Wl,--version-script,@0@'.format(symbol_map))
 
 subdir('polkit')
-if not get_option('libs-only')
+if get_option('libs-only')
+  # Downstream authentication agents (e.g. Lomiri's polkit agent, whose
+  # CMake asks for the polkit-agent-1 pkg-config module) link
+  # libpolkit-agent-1, which upstream only builds in the full configuration.
+  # Build the agent library in libs-only mode as well, so the package ships
+  # libpolkit-agent-1 + polkit-agent-1.pc while polkitbackend/programs
+  # (polkitd and friends) stay skipped.
+  subdir('polkitagent')
+else
   subdir('polkitbackend')
   subdir('polkitagent')
   subdir('programs')
diff --git a/src/polkitagent/meson.build b/src/polkitagent/meson.build
index bee3820..fbe04d4 100644
--- a/src/polkitagent/meson.build
+++ b/src/polkitagent/meson.build
@@ -108,12 +108,20 @@ sources = files(
 
 deps = auth_deps + [libpolkit_gobject_dep]
 
-executable(
-  '@0@-agent-helper-@1@'.format(meson.project_name(), pk_api_version),
-  sources,
-  include_directories: top_inc,
-  dependencies: deps,
-  c_args: '-D_POLKIT_COMPILATION',
-  install: true,
-  install_dir: pk_libprivdir,
-)
+if not get_option('libs-only')
+  # The privileged helper authenticates against the system password database
+  # (shadow authfw via getspnam(), pam authfw via libpam). Some libc
+  # implementations — e.g. the musl-based OHOS libc — provide no shadow
+  # password API at all, so the helper cannot be built there. A libs-only
+  # package ships the agent library only; the setuid helper stays part of a
+  # full build.
+  executable(
+    '@0@-agent-helper-@1@'.format(meson.project_name(), pk_api_version),
+    sources,
+    include_directories: top_inc,
+    dependencies: deps,
+    c_args: '-D_POLKIT_COMPILATION',
+    install: true,
+    install_dir: pk_libprivdir,
+  )
+endif
