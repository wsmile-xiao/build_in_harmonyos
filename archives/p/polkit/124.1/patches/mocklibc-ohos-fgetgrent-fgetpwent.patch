--- a/subprojects/mocklibc-1.0/src/grp.c
+++ b/subprojects/mocklibc-1.0/src/grp.c
@@ -23,6 +23,48 @@
 #include <string.h>
 #include <sys/types.h>
 
+/* OHOS (musl-based) libc has no fgetgrent(); implement it locally so the
+ * LD_PRELOAD mock works without the glibc-provided function. */
+struct group *fgetgrent(FILE *stream) {
+  static struct group entry;
+  static char line[1024];
+  static char name[256], passwd[256];
+  static char *members[256];
+  unsigned int gid;
+  int n;
+
+  while (fgets(line, sizeof(line), stream)) {
+    if (line[0] == '\n' || line[0] == '#')
+      continue;
+    n = sscanf(line, "%255[^:]:%255[^:]:%u:", name, passwd, &gid);
+    if (n < 3)
+      continue;
+    entry.gr_name = name;
+    entry.gr_passwd = passwd;
+    entry.gr_gid = gid;
+    entry.gr_mem = members;
+    /* members: comma-separated list after the third ':' */
+    char *p = line;
+    int colons = 0;
+    while (colons < 3 && (p = strchr(p, ':'))) {
+      p++;
+      colons++;
+    }
+    int i = 0;
+    if (colons == 3 && p) {
+      char *save = NULL;
+      char *tok = strtok_r(p, ",\n", &save);
+      while (tok && i < 255) {
+        members[i++] = tok;
+        tok = strtok_r(NULL, ",\n", &save);
+      }
+    }
+    members[i] = NULL;
+    return &entry;
+  }
+  return NULL;
+}
+
 #define GROUP_CONFIG_KEY "MOCK_GROUP"
 
 static FILE *global_stream = NULL;
--- a/subprojects/mocklibc-1.0/src/pwd.c
+++ b/subprojects/mocklibc-1.0/src/pwd.c
@@ -23,6 +23,34 @@
 #include <string.h>
 #include <sys/types.h>
 
+/* OHOS (musl-based) libc has no fgetpwent(); implement it locally so the
+ * LD_PRELOAD mock works without the glibc-provided function. */
+struct passwd *fgetpwent(FILE *stream) {
+  static struct passwd entry;
+  static char line[1024];
+  static char name[256], passwd[256], gecos[256], dir[256], shell[256];
+  unsigned int uid, gid;
+  int n;
+
+  while (fgets(line, sizeof(line), stream)) {
+    if (line[0] == '\n' || line[0] == '#')
+      continue;
+    n = sscanf(line, "%255[^:]:%255[^:]:%u:%u:%255[^:]:%255[^:]:%255[^\n]",
+               name, passwd, &uid, &gid, gecos, dir, shell);
+    if (n < 4)
+      continue;
+    entry.pw_name = name;
+    entry.pw_passwd = passwd;
+    entry.pw_uid = uid;
+    entry.pw_gid = gid;
+    entry.pw_gecos = gecos;
+    entry.pw_dir = dir;
+    entry.pw_shell = shell;
+    return &entry;
+  }
+  return NULL;
+}
+
 #define PASSWD_CONFIG_KEY "MOCK_PASSWD"
 
 static FILE *global_stream = NULL;
