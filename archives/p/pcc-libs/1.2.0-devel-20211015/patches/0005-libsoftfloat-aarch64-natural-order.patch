diff --git a/libsoftfloat/arch/aarch64/aarch64-gcc.h b/libsoftfloat/arch/aarch64/aarch64-gcc.h
--- a/libsoftfloat/arch/aarch64/aarch64-gcc.h
+++ b/libsoftfloat/arch/aarch64/aarch64-gcc.h
@@ -105,7 +105,13 @@
 -------------------------------------------------------------------------------
 */
 #if defined(SOFTFLOAT_FOR_GCC)
-#if defined(__VFP_FP__) || defined(__ARMEB__)
+/*
+ * __VFP_FP__ and __ARMEB__ are 32-bit ARM macros: AArch64 compilers define
+ * neither, which wrongly selected the FPA word-swap and corrupted every
+ * double-precision bit pattern.  AArch64 always stores doubles in the natural
+ * (low word first) VFP order, so it must take the no-mangle branch.
+ */
+#if defined(__aarch64__) || defined(__VFP_FP__) || defined(__ARMEB__)
 #define FLOAT64_DEMANGLE(a)	(a)
 #define FLOAT64_MANGLE(a)	(a)
 #else
