+/*
+ * binary128 flavour of the two long-double helpers.  The x87 versions below
+ * build the exponent and an explicit integer bit by hand, which has no
+ * binary128 equivalent, so these operate on the packed q[] view instead.
+ */
+static long double
+pcc_copysignl(long double x, long double y)
+{
+	union ul ux, uy;
+
+	ux.f = x;
+	uy.f = y;
+
+	ux.q[1] = (ux.q[1] & LDBL_MANTEXP) | (uy.q[1] & LDBL_SIGN);
+	return ux.f;
+}
+
+/*
+ * Rescale by a power of two by rewriting the binary128 exponent field
+ * directly, so no libm long-double helper is needed.  Out-of-range results
+ * clamp to the nearest representable exponent, matching the tolerance of the
+ * x87 implementation below.
+ */
+static long double
+pcc_scalbnl(long double x, int exp)
+{
+	union ul x1, z1;
+	unsigned int biased;
+
+	x1.f = x;
+	if (LDBL_ISINF(x1) || LDBL_ISNAN(x1) || x1.f == 0.0L)
+		return x;
+
+	biased = (unsigned int)((x1.q[1] & LDBL_EXP) >> 48);
+	if (biased == 0)
+		return x;
 
+	exp += (int)biased;
+	if (exp <= 0)
+		exp = 1;
+	else if (exp >= 0x7fff)
+		exp = 0x7ffe;
+
+	z1 = x1;
+	z1.q[1] = (x1.q[1] & ~LDBL_EXP) | ((unsigned long long)exp << 48);
+	return z1.f;
+}
