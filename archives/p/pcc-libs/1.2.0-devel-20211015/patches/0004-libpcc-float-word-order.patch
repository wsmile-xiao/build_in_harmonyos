diff --git a/libpcc/signbit.c b/libpcc/signbit.c
--- a/libpcc/signbit.c
+++ b/libpcc/signbit.c
@@ -11,6 +11,21 @@
 	unsigned u[4];
 };
 
+/*
+ * clang does not define __FLOAT_WORD_ORDER__ (only __BYTE_ORDER__), and an
+ * undefined identifier compares as 0 against __ORDER_LITTLE_ENDIAN__ (1234),
+ * which silently selected the big-endian branches below.  Prefer the real
+ * macro, fall back to the byte order - for the IEEE formats pcc-libs targets,
+ * words are ordered like bytes - and only then assume little-endian.
+ */
+#if defined(__FLOAT_WORD_ORDER__)
+#define	PCC_FLOAT_WORD_ORDER	__FLOAT_WORD_ORDER__
+#elif defined(__BYTE_ORDER__)
+#define	PCC_FLOAT_WORD_ORDER	__BYTE_ORDER__
+#else
+#define	PCC_FLOAT_WORD_ORDER	__ORDER_LITTLE_ENDIAN__
+#endif
+
 int
 __signbitf(float x)
 {
@@ -26,7 +41,7 @@
 	union sbit s;
 
 	s.d = x;
-#if __FLOAT_WORD_ORDER__ == __ORDER_LITTLE_ENDIAN__
+#if PCC_FLOAT_WORD_ORDER == __ORDER_LITTLE_ENDIAN__
 	return s.u[1] >> 31;
 #else
 	return s.u[0] >> 31;
@@ -39,10 +54,10 @@
 	union sbit s;
 
 	s.l = x;
-#if __FLOAT_WORD_ORDER__ == __ORDER_LITTLE_ENDIAN__
+#if PCC_FLOAT_WORD_ORDER == __ORDER_LITTLE_ENDIAN__
 #if __i386__ || __amd64__
 	return (s.u[2] >> 15) & 1;
-#else 
+#else
 	return s.u[3] >> 31;
 #endif
 #else
