@@ -285,9 +297,13 @@ InternalIpcMemoryCreate(IpcMemoryKey memKey, Size size)
 static void
 IpcMemoryDetach(int status, Datum shmaddr)
 {
+#ifdef HAVE_BROKEN_SHMGET
+	/* No SysV shared memory to detach, using mmap-based DSM */
+#else
 	/* Detach System V shared memory block. */
 	if (shmdt(DatumGetPointer(shmaddr)) < 0)
