diff --git a/src/backend/utils/init/miscinit.c b/src/backend/utils/init/miscinit.c
index df18257..47cd399 100644
--- a/src/backend/utils/init/miscinit.c
+++ b/src/backend/utils/init/miscinit.c
@@ -381,12 +381,41 @@ checkDataDir(void)
 	 * XXX can we safely enable this check on Windows?
 	 */
 #if !defined(WIN32) && !defined(__CYGWIN__)
+#ifdef HAVE_BROKEN_UMASK
+	/*
+	 * HAVE_BROKEN_UMASK: on such filesystems the directory owner may not
+	 * match our UID due to how the filesystem handles permissions. Instead,
+	 * check if the directory's group matches any of our groups (relaxed
+	 * ownership check).
+	 */
+	if (stat_buf.st_uid != geteuid())
+	{
+		gid_t dir_gid = stat_buf.st_gid;
+		gid_t my_gids[64];
+		int ngroups;
+		bool same_group = false;
+		int i;
+
+		ngroups = getgroups(64, my_gids);
+		for (i = 0; i < ngroups && !same_group; i++)
+			if (my_gids[i] == dir_gid)
+				same_group = true;
+
+		if (!same_group)
+			ereport(FATAL,
+					(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
+					 errmsg("data directory \"%s\" has wrong ownership",
+							DataDir),
+					 errhint("The server must be started by the user that owns the data directory or belongs to its group.")));
+	}
+#else
 	if (stat_buf.st_uid != geteuid())
 		ereport(FATAL,
 				(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
 				 errmsg("data directory \"%s\" has wrong ownership",
 						DataDir),
 				 errhint("The server must be started by the user that owns the data directory.")));
+#endif /* HAVE_BROKEN_UMASK */
 #endif
 
 	/*
@@ -401,12 +430,27 @@ checkDataDir(void)
 	 * reasonable check to apply on Windows.
 	 */
 #if !defined(WIN32) && !defined(__CYGWIN__)
+#ifdef HAVE_BROKEN_UMASK
+	/*
+	 * HAVE_BROKEN_UMASK: such filesystems don't handle permissions properly,
+	 * causing S-bit issues and abnormal group permissions. Relax the check:
+	 * only verify that the user has full rwx access. The S-bit and extra
+	 * group/other permissions imposed by the filesystem are harmless here.
+	 */
+	if ((stat_buf.st_mode & S_IRWXU) != S_IRWXU)
+		ereport(FATAL,
+				(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
+				 errmsg("data directory \"%s\" has invalid permissions",
+						DataDir),
+				 errdetail("Permissions for owner should include read, write, and execute.")));
+#else
 	if (stat_buf.st_mode & PG_MODE_MASK_GROUP)
 		ereport(FATAL,
 				(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
 				 errmsg("data directory \"%s\" has invalid permissions",
 						DataDir),
 				 errdetail("Permissions should be u=rwx (0700) or u=rwx,g=rx (0750).")));
+#endif /* HAVE_BROKEN_UMASK */
 #endif
 
 	/*
