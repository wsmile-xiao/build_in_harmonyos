--- a/src/common/username.c
+++ b/src/common/username.c
@@ -40,10 +40,20 @@ get_user_name(char **errstr)
 	pw = getpwuid(user_id);
 	if (!pw)
 	{
+#ifdef HAVE_BROKEN_GETPWUID
+		/*
+		 * HAVE_BROKEN_GETPWUID: getpwuid may fail for users not in
+		 * /etc/passwd. Fall back to the numeric UID as the user name.
+		 */
+		static char uid_name[32];
+		snprintf(uid_name, sizeof(uid_name), "%ld", (long) user_id);
+		return uid_name;
+#else
 		*errstr = psprintf(_("could not look up effective user ID %ld: %s"),
 						   (long) user_id,
 						   errno ? strerror(errno) : _("user does not exist"));
 		return NULL;
+#endif
 	}
 
 	return pw->pw_name;
