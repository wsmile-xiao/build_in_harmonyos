 	void	   *requestedAddress = NULL;
 	void	   *memAddress;
 
+#ifdef HAVE_BROKEN_SHMGET
+	/*
+	 * Broken-shmget build: the shmget syscall raises SIGSYS (unimplemented
+	 * syscall). For mmap-based shared memory the SysV segment is only needed
+	 * for interlocking; skip that requirement and rely on file-based locking.
+	 * Return a fake address to be overwritten later.
+	 */
+	static PGShmemHeader fake_header;
+	memset(&fake_header, 0, sizeof(PGShmemHeader));
+	return &fake_header;
+#else
 	/*
 	 * Normally we just pass requestedAddress = NULL to shmat(), allowing the
 	 * system to choose where the segment gets mapped.  But in an EXEC_BACKEND
@@ -275,6 +286,7 @@ InternalIpcMemoryCreate(IpcMemoryKey memKey, Size size)
 	}
 
 	return memAddress;
+#endif /* HAVE_BROKEN_SHMGET */
 }
 
