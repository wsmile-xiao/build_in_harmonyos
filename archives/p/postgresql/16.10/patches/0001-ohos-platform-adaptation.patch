--- a/src/backend/storage/file/fd.c
+++ b/src/backend/storage/file/fd.c
@@ -2342,8 +2342,21 @@ retry:
 	 * Return in cases of a "real" failure, if fallocate is not supported,
 	 * fall through to the FileZero() backed implementation.
 	 */
+#ifdef HAVE_BROKEN_FALLOCATE
+	/*
+	 * HAVE_BROKEN_FALLOCATE: on some filesystems (e.g. hmdfs on OHOS)
+	 * posix_fallocate() is refused with EACCES/EPERM even though the
+	 * filesystem is writable. Treat that like an unsupported-fallocate
+	 * signal (EINVAL/EOPNOTSUPP) and fall back to the FileZero()-backed
+	 * implementation instead of failing relation extension.
+	 */
+	if (returnCode != EINVAL && returnCode != EOPNOTSUPP &&
+		returnCode != EACCES && returnCode != EPERM)
+		return -1;
+#else
 	if (returnCode != EINVAL && returnCode != EOPNOTSUPP)
 		return -1;
+#endif /* HAVE_BROKEN_FALLOCATE */
 #endif
 
 	return FileZero(file, offset, amount, wait_event_info);
