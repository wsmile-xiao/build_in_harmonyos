 ## GetText
--- /dev/null
+++ b/cmake/GettextCreateTranslations.cmake
@@ -0,0 +1,42 @@
+# GettextCreateTranslations.cmake — OHOS 适配补充模块（conan 配方注入）
+#
+# 上游 CMakeLists.txt 调用的 gettext_create_translations() 宏来自旧版
+# CMake 内置 FindGettext 模块，CMake 4.x 已移除该宏。本文件按上游语义
+# 提供最小实现：对每个 .po 用 msgfmt 生成 .gmo 并注册 ALL 目标。
+# msgfmt 路径经 GETTEXT_MSGFMT_EXECUTABLE 变量注入（OHOS hnp gettext）。
+#
+# 注意：这是构建期翻译文件编译工具，非平台 API 替代。
+
+if (NOT GETTEXT_MSGFMT_EXECUTABLE)
+  find_program(GETTEXT_MSGFMT_EXECUTABLE NAMES msgfmt)
+endif ()
+
+macro (GETTEXT_CREATE_TRANSLATIONS _potFile _firstPoArg)
+  set (_gmoFiles)
+  set (_allArg "")
+  set (_pos)
+  # 兼容上游调用形态：gettext_create_translations (<pot> ALL <po...>)
+  foreach (_arg ${_firstPoArg} ${ARGN})
+    if (_arg STREQUAL "ALL")
+      set (_allArg "ALL")
+    else ()
+      list (APPEND _pos ${_arg})
+    endif ()
+  endforeach ()
+
+  foreach (_currentPoFile ${_pos})
+    get_filename_component (_lang ${_currentPoFile} NAME_WE)
+    set (_gmoFile ${CMAKE_CURRENT_BINARY_DIR}/${_lang}.gmo)
+    add_custom_command (
+      OUTPUT ${_gmoFile}
+      COMMAND ${GETTEXT_MSGFMT_EXECUTABLE} -o ${_gmoFile} ${_currentPoFile}
+      DEPENDS ${_currentPoFile}
+      COMMENT "Compiling translation ${_currentPoFile} -> ${_lang}.gmo"
+    )
+    list (APPEND _gmoFiles ${_gmoFile})
+  endforeach ()
+
+  if (_gmoFiles)
+    add_custom_target (translations ${_allArg} DEPENDS ${_gmoFiles})
+  endif ()
+endmacro ()
