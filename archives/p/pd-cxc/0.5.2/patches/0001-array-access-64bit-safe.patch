 #include <stdlib.h>
 
 
+/* --- LP64 array access (OHOS adaptation) ---------------------------------
+ * garray_getfloatarray() casts the array's t_word storage to t_float* and hands
+ * it to the caller.  That is only valid when sizeof(t_word) == sizeof(t_float),
+ * which never holds on an LP64 target: t_word is an 8-byte union (it has
+ * pointer members) while t_float is 4 bytes.  Pd itself reports the mismatch:
+ *     "an operation on the array 'buf' in the patch 'buf'"
+ *     "failed since it uses garray_getfloatarray while running 64-bit"
+ * and then hands back the words array anyway (g_array.c), so every external
+ * that strides through it with t_float* reads interleaved garbage.
+ * Measured on this platform before the fix: a [table buf 8] holding 1..8 made
+ * [cxmean buf] report 1.25 instead of 4.5.
+ *
+ * garray_getfloatwords() is the LP64-safe accessor and exists since Pd 0.44, so
+ * it is used unconditionally here -- the same change Debian makes in
+ * debian/patches/array64.patch ("make array-access 64bit safe",
+ * Last-Update 2018-02-01).  A compile-time switch on PD_FLOATSIZE would not
+ * work: this build system (upstream's "Pd library template 1.0.11" Makefile)
+ * never defines it, so m_pd.h falls back to its 32-bit default and the branch
+ * would always be taken the wrong way, and the property that matters
+ * (sizeof(t_word) vs sizeof(t_float)) belongs to the *hosting* Pd process, not
+ * to the external.
+ */
+typedef t_word cxc_sample;
+# define CXC_ARRAY_GET(garray, n, vec) \
+    garray_getfloatwords((garray), (n), (t_word **)(vec))
+# define CXC_SAMPLE(p) ((p)->w_float)
+
 /* cx.mean: calculate the mean from a table */
 /* as defined by: add all samples together and divide by number of samples */
 t_class *cxmean_class;
