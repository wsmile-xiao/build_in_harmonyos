diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Configure wrapper for progress — pure Makefile project
+# No actual configuration needed; just accept --prefix and exit successfully
+prefix=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*) prefix="${1#--prefix=}" ;;
+        *) ;;
+    esac
+    shift
+done
+if [ -n "$prefix" ]; then
+    echo "Configuring progress for prefix: $prefix"
+else
+    echo "Configuring progress with default prefix"
+fi
+echo "Pure Makefile project — no configure script needed"
+exit 0
