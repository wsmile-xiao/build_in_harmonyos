diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,32 +1,39 @@
 OBJ = progress
+# Use DEFAULT_PREFIX from environment (set by build system), fall back to /usr/local
+DEFAULT_PREFIX ?= /usr/local
+PREFIX ?= $(DEFAULT_PREFIX)
 CFLAGS ?= -g
 override CFLAGS += -Wall -D_FILE_OFFSET_BITS=64
 override LDFLAGS += -lm
 UNAME := $(shell uname)
 PKG_CONFIG ?= pkg-config
 ifeq ($(UNAME), Linux)
     ifeq (, $(shell which $(PKG_CONFIG) 2> /dev/null))
     $(error "pkg-config command not found")
     endif
     ifeq (, $(shell $(PKG_CONFIG) ncursesw --libs 2> /dev/null))
     $(error "ncurses package not found")
     endif
     override LDFLAGS += $(shell $(PKG_CONFIG) ncursesw --libs)
 endif
+# HarmonyOS (OHOS) — Linux-based kernel, ncursesw available as static lib
+ifeq ($(UNAME), HarmonyOS)
+    override CFLAGS += -I$(PREFIX)/include
+    override LDFLAGS += -L$(PREFIX)/lib -lncursesw
+endif
 ifeq ($(UNAME), Darwin)
     override LDFLAGS += -lncurses
 endif
 ifeq ($(UNAME), FreeBSD)
     override LDFLAGS += -lncurses -lprocstat
 endif
-PREFIX ?= /usr/local
 BINDIR = $(PREFIX)/bin
 MANDIR = $(PREFIX)/share/man/man1
 ZSHDIR = $(PREFIX)/share/zsh/site-functions
 
 $(OBJ) : progress.o sizes.o hlist.o
 	$(CC) -Wall $^ -o $@ $(LDFLAGS)
 %.o : %.c
 	$(CC) $(CFLAGS) -c $^
 clean :
 	rm -f *.o $(OBJ)
