+# Override CC and LINK for fuzzing targets to use AFL++ for both compilation and linking
+@ENABLE_FUZZING_TRUE@$(src_fuzz_filterdiff_OBJECTS): CC = $(AFL_CC)
+@ENABLE_FUZZING_TRUE@$(src_fuzz_interdiff_OBJECTS): CC = $(AFL_CC)
+@ENABLE_FUZZING_TRUE@$(src_fuzz_rediff_OBJECTS): CC = $(AFL_CC)
+
+# Create fuzzing symlinks (like regular tools)
+@ENABLE_FUZZING_TRUE@src/fuzz-combinediff$(EXEEXT): src/fuzz-interdiff$(EXEEXT)
+@ENABLE_FUZZING_TRUE@	ln -sf $(notdir $<) $@
+
+@ENABLE_FUZZING_TRUE@src/fuzz-flipdiff$(EXEEXT): src/fuzz-interdiff$(EXEEXT)
+@ENABLE_FUZZING_TRUE@	ln -sf $(notdir $<) $@
+
+@ENABLE_FUZZING_TRUE@src/fuzz-lsdiff$(EXEEXT): src/fuzz-filterdiff$(EXEEXT)
+@ENABLE_FUZZING_TRUE@	ln -sf $(notdir $<) $@
+
+@ENABLE_FUZZING_TRUE@src/fuzz-grepdiff$(EXEEXT): src/fuzz-filterdiff$(EXEEXT)
+@ENABLE_FUZZING_TRUE@	ln -sf $(notdir $<) $@
+
+@ENABLE_FUZZING_TRUE@src/fuzz-patchview$(EXEEXT): src/fuzz-filterdiff$(EXEEXT)
+@ENABLE_FUZZING_TRUE@	ln -sf $(notdir $<) $@
+
+# Fuzzing targets - use instrumented binaries when available
+@ENABLE_FUZZING_TRUE@fuzz-help fuzz-corpus fuzz-test fuzz-analyze fuzz-clean fuzz-check fuzz-ci fuzz-stats:
+@ENABLE_FUZZING_TRUE@	@if [ -f Makefile.fuzz ]; then \
+@ENABLE_FUZZING_TRUE@		$(MAKE) -f Makefile.fuzz FUZZ_BINDIR="$(top_builddir)/src" $@; \
+@ENABLE_FUZZING_TRUE@	else \
+@ENABLE_FUZZING_TRUE@		echo "Fuzzing not available - Makefile.fuzz not found"; \
+@ENABLE_FUZZING_TRUE@	fi
+
+@ENABLE_FUZZING_TRUE@fuzz-filterdiff fuzz-interdiff fuzz-rediff fuzz-grepdiff fuzz-lsdiff: src/fuzz-filterdiff src/fuzz-interdiff src/fuzz-rediff src/fuzz-lsdiff$(EXEEXT) src/fuzz-grepdiff$(EXEEXT)
+@ENABLE_FUZZING_TRUE@	@if [ -f Makefile.fuzz ]; then \
+@ENABLE_FUZZING_TRUE@		$(MAKE) -f Makefile.fuzz FUZZ_BINDIR="$(top_builddir)/src" $@; \
+@ENABLE_FUZZING_TRUE@	else \
+@ENABLE_FUZZING_TRUE@		echo "Fuzzing not available - Makefile.fuzz not found"; \
+@ENABLE_FUZZING_TRUE@	fi
+
+# Fuzzing targets - delegate to separate makefile (non-instrumented fallback)
+@ENABLE_FUZZING_FALSE@fuzz-help fuzz-corpus fuzz-test fuzz-analyze fuzz-clean fuzz-check fuzz-ci fuzz-stats:
+@ENABLE_FUZZING_FALSE@	@if [ -f Makefile.fuzz ]; then \
+@ENABLE_FUZZING_FALSE@		echo "Warning: Using non-instrumented binaries - configure with --enable-fuzzing for better results"; \
+@ENABLE_FUZZING_FALSE@		$(MAKE) -f Makefile.fuzz $@; \
+@ENABLE_FUZZING_FALSE@	else \
+@ENABLE_FUZZING_FALSE@		echo "Fuzzing not available - Makefile.fuzz not found"; \
+@ENABLE_FUZZING_FALSE@	fi
+
+@ENABLE_FUZZING_FALSE@fuzz-filterdiff fuzz-interdiff fuzz-rediff fuzz-grepdiff fuzz-lsdiff:
+@ENABLE_FUZZING_FALSE@	@if [ -f Makefile.fuzz ]; then \
+@ENABLE_FUZZING_FALSE@		echo "Warning: Using non-instrumented binaries - configure with --enable-fuzzing for better results"; \
+@ENABLE_FUZZING_FALSE@		$(MAKE) -f Makefile.fuzz $@; \
+@ENABLE_FUZZING_FALSE@	else \
+@ENABLE_FUZZING_FALSE@		echo "Fuzzing not available - Makefile.fuzz not found"; \
