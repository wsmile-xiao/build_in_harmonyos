diff -ruN a/Makefile.PL b/Makefile.PL
--- a/Makefile.PL	2023-07-04 00:15:07.000000000 +0800
+++ b/Makefile.PL	2026-07-06 14:54:02.698631249 +0800
@@ -10,14 +10,24 @@

 use Config;
 use File::Spec;
-use Crypt::OpenSSL::Guess;
+# Bypass Crypt::OpenSSL::Guess (not available on OHOS), detect OpenSSL inline
 my %args;

-my ($major, $minor, $patch) = openssl_version();
-print "Installed OpenSSL: $major.$minor.$patch\n";
+my $openssl_prefix = $ENV{OPENSSL_PREFIX} || '/usr/local';

-$args{INC} =  openssl_inc_paths();
-$args{LIBS} = [openssl_lib_paths() . ' -lssl -lcrypto'];
+my ($major, $minor, $patch) = (3, 0, 0);
+if (open my $fh, '-|', "openssl version 2>/dev/null") {
+    my $ver = <$fh>;
+    close $fh;
+    if ($ver =~ /OpenSSL\s+(\d+)\.(\d+)\.(\d+)/) {
+        ($major, $minor, $patch) = ($1, $2, $3);
+    }
+}
+print "Installed OpenSSL: $major.$minor.$patch (prefix: $openssl_prefix)\n";
+
+$args{INC} = "-I$openssl_prefix/include";
+$args{LIBS} = ["-L$openssl_prefix/lib -lssl -lcrypto"];
+$args{LDFLAGS} = '-Wl,-z,noexecstack -Wl,-z,relro -Wl,-z,now';

 my $cc_option_flags = $major ge 3 ? ' -DOPENSSL_API_COMPAT=30000' : ' -DOPENSSL_API_COMPAT=10100';

@@ -56,7 +66,6 @@
   "ABSTRACT" => "OpenSSL Verify certificate verification in XS.",
   "AUTHOR" => "Timothy Legge <timlegge\@cpan.org>, Wesley Schwengle <waterkip\@cpan.org>",
   "CONFIGURE_REQUIRES" => {
-    "Crypt::OpenSSL::Guess" => 0,
     "ExtUtils::MakeMaker" => 0
   },
   "DISTNAME" => "Crypt-OpenSSL-Verify",
