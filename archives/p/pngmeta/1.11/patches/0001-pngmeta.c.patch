+/* Quote a string for use as an XML element name: whitespace is not
+   allowed there, so drop it (PNG keywords may contain spaces). */
+void html_quote_element(FILE *fd, const char *string)
+{
+  char c;
+  char const * p=string;
+  while ((c = *p++))
+    if (!isspace((unsigned char)c))
+      fputc(c, fd);
+}
