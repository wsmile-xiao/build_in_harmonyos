 attribute_hidden
 struct ebb_thread_info_t __paf_ebb_thread_info = { 0, NULL };
 
+#if !defined(__powerpc__) && !defined(__powerpc64__)
+/* ---- OHOS/aarch64 EBB emulation -----------------------------------------
+   There is no Event-Based Branching facility and OHOS denies perf_event_open
+   (EACCES) for every event type, so no hardware PMU event can trigger a
+   branch.  As a functional substitute event source we use a process interval
+   timer (setitimer/SIGALRM) whose period comes from the requested sample
+   period.  When it fires, the per-thread EBB handler registered through the
+   public API is invoked with its context, reproducing the observable
+   behaviour of the API (register/enable/disable/reset/close + callback).  */
+static struct sigaction __paf_ebb_saved_sigalrm;
+static int __paf_ebb_sigalrm_installed = 0;
+static int __paf_ebb_timer_armed = 0;
+static uint32_t __paf_ebb_period_us = 1000;
+
+static void
+__paf_ebb_sigalrm (int sig)
+{
+  ebbhandler_t handler;
+  (void) sig;
+  handler = __paf_ebb_get_thread_handler ();
+  if (handler != NULL && handler != EBB_REG_ERR)
+    handler (__paf_ebb_get_thread_context ());
+}
+
+static void
+__paf_ebb_install_sigalrm (void)
+{
+  if (!__paf_ebb_sigalrm_installed)
+    {
+      struct sigaction sa;
+      memset (&sa, 0, sizeof (sa));
+      sa.sa_handler = __paf_ebb_sigalrm;
+      sa.sa_flags = SA_RESTART;
+      sigemptyset (&sa.sa_mask);
+      if (sigaction (SIGALRM, &sa, &__paf_ebb_saved_sigalrm) == 0)
+        __paf_ebb_sigalrm_installed = 1;
+    }
+}
+
+static int
+__paf_ebb_arm_timer (uint32_t period_us)
+{
+  struct itimerval it;
+  if (period_us == 0)
+    period_us = 1000;
+  __paf_ebb_period_us = period_us;
+  __paf_ebb_install_sigalrm ();
+  memset (&it, 0, sizeof (it));
+  it.it_interval.tv_sec = period_us / 1000000;
+  it.it_interval.tv_usec = period_us % 1000000;
+  it.it_value = it.it_interval;
+  __paf_ebb_timer_armed = (setitimer (ITIMER_REAL, &it, NULL) == 0);
+  return __paf_ebb_timer_armed ? 0 : -1;
+}
+
+static void
+__paf_ebb_disarm_timer (void)
+{
+  struct itimerval it;
+  memset (&it, 0, sizeof (it));
+  setitimer (ITIMER_REAL, &it, NULL);
+  __paf_ebb_timer_armed = 0;
+}
+#endif
