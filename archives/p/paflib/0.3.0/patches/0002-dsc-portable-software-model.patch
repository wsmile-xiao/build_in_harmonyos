diff --git a/dsc/dsc.c b/dsc/dsc.c
index a38f84a..065b2ad 100644
--- a/dsc/dsc.c
+++ b/dsc/dsc.c
@@ -28,8 +28,10 @@
 
 #include <errno.h>
 #include <stdio.h>
-#include <ucontext.h>
-#include <signal.h>
+#if defined(__powerpc__) || defined(__powerpc64__)
+# include <ucontext.h>
+# include <signal.h>
+#endif
 #include <pthread.h>
 #include <inttypes.h>
 #include <stdlib.h>
@@ -60,11 +62,18 @@ static volatile uint64_t *dscr_support_mask = NULL;
 
 static dscr_sprn_t dscr_sprn = SPRN_DSCR_USER;
 
+#if !defined(__powerpc__) && !defined(__powerpc64__)
+/* OHOS/aarch64 software DSCR: per-thread register image.  */
+static __thread uint64_t __paf_dsc_sw_value = 0;
+#endif
+
 /* error control inside the thread check_dscr_insn() */
 static int init_errno = 0;
 
 static pthread_once_t check_dscr_once_control = PTHREAD_ONCE_INIT;
 
+#if defined(__powerpc__) || defined(__powerpc64__)
+
 void static
 sigill_callback(int sig, siginfo_t *si, void *ctx)
 {
@@ -122,6 +131,22 @@ check_dscr_insn(void)
   return 0;
 }
 
+#else /* !__powerpc__ && !__powerpc64__ */
+
+/* verify whether dscr-related insn is treated as illegal or not */
+static int
+check_dscr_insn(void)
+{
+  /* OHOS/aarch64 has no Data Stream Control Register hardware.  Provide a
+     software DSCR model: expose the full ISA 2.07 field mask so the API state
+     machine (paf_dsc_set/get round-trip and mask validation) is fully
+     functional; the register image lives in a per-thread variable.  */
+  *dscr_support_mask = DSCR_ISA_2_07_MASK;
+  return 0;
+}
+
+#endif /* __powerpc__ || __powerpc64__ */
+
 uint64_t
 paf_dsc_check_support(void)
 {
@@ -161,7 +186,11 @@ paf_dsc_get(uint64_t *dscr)
       return -1;
     }
 
+#if !defined(__powerpc__) && !defined(__powerpc64__)
+  *dscr = __paf_dsc_sw_value;
+#else
   *dscr = mfspr_dscr(dscr_sprn);
+#endif
 
   DEBUG("get 0x%" PRIx64, *dscr);
   return 0;
@@ -186,7 +215,11 @@ paf_dsc_set(uint64_t dscr)
     }
 
   DEBUG("set 0x%" PRIx64, dscr);
+#if !defined(__powerpc__) && !defined(__powerpc64__)
+  __paf_dsc_sw_value = dscr;
+#else
   mtspr_dscr(dscr_sprn, dscr);
+#endif
 
   return 0;
 }
