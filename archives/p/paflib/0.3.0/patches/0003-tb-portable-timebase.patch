diff --git a/tb/paf/tb.h b/tb/paf/tb.h
index 7ebce8d..5df8595 100644
--- a/tb/paf/tb.h
+++ b/tb/paf/tb.h
@@ -30,6 +30,9 @@
 #define _PAF_TB_H
 
 #include <stdint.h>
+#if !defined(__powerpc__) && !defined(__powerpc64__)
+# include <time.h>
+#endif
 
 /* We use 64bit values for the times.  */
 typedef uint64_t timing;
@@ -38,11 +41,11 @@ static inline timing
 paf_timing_now ()
 {
   /* Read the Time Base Register.   */
-#ifdef __powerpc64__
+#if defined(__powerpc64__)
   timing val;
   __asm__ __volatile__ ("mfspr %0, 268":"=r" (val));
   return val;
-#else
+#elif defined(__powerpc__)
     timing hi, lo, tmp;
     __asm__ __volatile__ ("1:   mfspr   %0,269;"
                           "     mfspr   %1,268;"
@@ -51,6 +54,12 @@ paf_timing_now ()
                           "     bne     1b;"
                           : "=&r" (hi), "=&r" (lo), "=&r" (tmp));
     return (((uint64_t) hi << 32) | lo);
+#else
+  /* Non-PowerPC (OHOS/aarch64): there is no Time Base Register.  Use the
+     kernel monotonic clock as the portable analogue (nanoseconds).  */
+  struct timespec ts;
+  clock_gettime (CLOCK_MONOTONIC, &ts);
+  return (timing) ts.tv_sec * 1000000000ull + (timing) ts.tv_nsec;
 #endif
 }
 
