diff --git a/common/paf-common.h b/common/paf-common.h
index 0bd1e07..d318d8f 100644
--- a/common/paf-common.h
+++ b/common/paf-common.h
@@ -43,6 +43,8 @@ typedef unsigned long int spr_t;
 #define __stringify_1(x)	#x
 #define __stringify(x)		__stringify_1(x)
 
+#if defined(__powerpc__) || defined(__powerpc64__)
+
 #define mfspr(rn)					\
   ({ spr_t __spr; 					\
      asm volatile("mfspr %0," __stringify(rn)		\
@@ -58,6 +60,18 @@ typedef unsigned long int spr_t;
 #define mb()                                            \
   asm volatile("sync" : : : "memory");
 
+#else /* !__powerpc__ && !__powerpc64__ */
+
+/* Non-PowerPC (e.g. OHOS/aarch64): the Power Architecture SPRs and the
+   "sync" barrier do not exist.  These fallbacks keep the shared headers
+   compiling; every Power-specific call site is guarded so they are never
+   evaluated on this architecture.  mb() maps to a full compiler barrier.  */
+#define mfspr(rn)      ((spr_t) 0)
+#define mtspr(rn, v)   ((void) (rn), (void) (v))
+#define mb()           __sync_synchronize()
+
+#endif
+
 
 #ifdef ENABLE_DEBUG
 # define DEBUG(fmt, args...) fprintf(stderr, "%s:%d: debug: " fmt "\n", \
