+
 typedef void (*auxv_callback)(ElfW(auxv_t) *, void *);
 
 static inline int
@@ -104,11 +108,19 @@ __paf_get_hwcap_callback (ElfW(auxv_t) *auxv, void *arg)
     strncpy (hwcap->platform, (const char*)(auxv->a_un.a_val), PAFPLATLEN);
 }
 
+#endif /* __powerpc__ || __powerpc64__ */
+
 int
 attribute_hidden
 __paf_get_hwcap (struct hwcap_t *hwcap)
 {
+#if defined(__powerpc__) || defined(__powerpc64__)
   if (__paf_walk_auxv (__paf_get_hwcap_callback, (void*)(hwcap)) != 0)
     return 1;
   return 0;
+#else
+  /* No Power Architecture facilities on this architecture.  */
+  (void) hwcap;
+  return 1;
+#endif
 }
