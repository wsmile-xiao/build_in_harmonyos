+void ebb_clobber_fpr (void *arg) { ebb_clobber_call ((struct test *) arg); }
+void ebb_clobber_vr  (void *arg) { ebb_clobber_call ((struct test *) arg); }
+void ebb_clobber_vsr (void *arg) { ebb_clobber_call ((struct test *) arg); }
