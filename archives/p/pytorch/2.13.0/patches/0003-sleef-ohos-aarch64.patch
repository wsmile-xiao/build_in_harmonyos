--- a/third_party/sleef/Configure.cmake
+++ b/third_party/sleef/Configure.cmake
@@ -104,6 +104,18 @@
 if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_OSX_ARCHITECTURES MATCHES "^(x86_64|arm64)$")
   set(SLEEF_TARGET_PROCESSOR "${CMAKE_OSX_ARCHITECTURES}")
 endif()
+# HarmonyOS/OHOS: the conan CMakeToolchain does not reliably set
+# CMAKE_SYSTEM_PROCESSOR; fall back to the compiler target triple so sleef
+# enables the AArch64 (ADVSIMD/SVE) dispatch. `clang -dumpmachine` reports
+# e.g. `aarch64-unknown-linux-ohos` for the OHOS cross toolchain.
+if(NOT SLEEF_TARGET_PROCESSOR MATCHES "aarch64|arm64" AND CMAKE_C_COMPILER)
+  execute_process(COMMAND "${CMAKE_C_COMPILER}" -dumpmachine
+                  OUTPUT_VARIABLE SLEEF_COMPILER_MACHINE
+                  OUTPUT_STRIP_TRAILING_WHITESPACE)
+  if(SLEEF_COMPILER_MACHINE MATCHES "aarch64")
+    set(SLEEF_TARGET_PROCESSOR "aarch64")
+  endif()
+endif()
 
 # PLATFORM DETECTION
 if(CMAKE_SIZEOF_VOID_P EQUAL 4)
