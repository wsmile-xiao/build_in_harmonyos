--- a/c10/test/CMakeLists.txt
+++ b/c10/test/CMakeLists.txt
@@ -6,6 +6,14 @@
     get_filename_component(test_file_name ${test_src} NAME_WE)
     set(test_name "c10_${test_file_name}")
     add_executable(${test_name} "${test_src}")
+    # OHOS: the toolchain pins CMAKE_CXX_STANDARD to the profile value (17),
+    # and the project-wide set(CMAKE_CXX_STANDARD 20 CACHE ...) cannot override
+    # it, while the upstream tests are written for the C++20 baseline (e.g.
+    # std::unordered_set::contains). Ask for C++20 on the test targets only, so
+    # the library targets keep the toolchain standard and are not rebuilt.
+    set_target_properties(${test_name} PROPERTIES
+      CXX_STANDARD 20
+      CXX_STANDARD_REQUIRED ON)
     if(NOT MSVC)
       target_compile_options(${test_name} PRIVATE -Wno-unused-variable)
     endif()
