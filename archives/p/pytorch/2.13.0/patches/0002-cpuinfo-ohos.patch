--- a/third_party/cpuinfo/CMakeLists.txt
+++ b/third_party/cpuinfo/CMakeLists.txt
@@ -67,6 +67,27 @@ ENDIF()
 
 # -- [ Determine target processor
 SET(CPUINFO_TARGET_PROCESSOR "${CMAKE_SYSTEM_PROCESSOR}")
+# HarmonyOS/OHOS: the OHOS CMakeToolchain reports CMAKE_SYSTEM_PROCESSOR as
+# "unknown" (no Platform/HarmonyOS.cmake), which would disable all cpuinfo
+# platform sources. Fall back to the compiler target triple, e.g.
+# `clang -dumpmachine` -> aarch64-unknown-linux-ohos.
+IF(CPUINFO_TARGET_PROCESSOR STREQUAL "unknown" OR NOT CPUINFO_TARGET_PROCESSOR)
+  IF(CMAKE_C_COMPILER)
+    EXECUTE_PROCESS(COMMAND "${CMAKE_C_COMPILER}" -dumpmachine
+                    OUTPUT_VARIABLE CPUINFO_COMPILER_MACHINE
+                    OUTPUT_STRIP_TRAILING_WHITESPACE)
+  ENDIF()
+  IF(CPUINFO_COMPILER_MACHINE MATCHES "aarch64")
+    SET(CPUINFO_TARGET_PROCESSOR "aarch64")
+  ELSEIF(CPUINFO_COMPILER_MACHINE MATCHES "x86_64")
+    SET(CPUINFO_TARGET_PROCESSOR "x86_64")
+  ELSEIF(CPUINFO_COMPILER_MACHINE MATCHES "^(armv[5-8])")
+    # Keep the armvN spelling. The supported-platform check below accepts
+    # only "armv[5-8].*" for 32-bit ARM and the aarch32 ISA selection
+    # matches ^armv[5-8], so a bare "arm" would disable cpuinfo entirely.
+    SET(CPUINFO_TARGET_PROCESSOR "${CMAKE_MATCH_1}")
+  ENDIF()
+ENDIF()
 IF(CMAKE_SYSTEM_NAME MATCHES "FreeBSD" AND CPUINFO_TARGET_PROCESSOR STREQUAL "amd64")
   SET(CPUINFO_TARGET_PROCESSOR "AMD64")
 ENDIF()
