--- a/third_party/googletest/googletest/src/gtest-port.cc
+++ b/third_party/googletest/googletest/src/gtest-port.cc
@@ -1129,7 +1129,15 @@
     if (!EndsWithPathSeparator(name_template))
       name_template.push_back(GTEST_PATH_SEP_[0]);
 #else
-    name_template = "/tmp/";
+    // OHOS/musl: /tmp can be read-only on the target (HarmonyOS PC mounts it
+    // read-only), which makes every death test fail. testing::TempDir() honors
+    // TEST_TMPDIR/TMPDIR -- the same mechanism the Android branch above uses --
+    // and returns the path with a trailing separator, falling back to /tmp.
+    name_template = TempDir();
+    // TempDir() normally ends with a separator (GetDirFromEnv appends it),
+    // but a custom tempdir hook need not, so keep the path well-formed.
+    if (name_template.empty() || name_template.back() != GTEST_PATH_SEP_[0])
+      name_template.push_back(GTEST_PATH_SEP_[0]);
 #endif
     name_template.append("gtest_captured_stream.XXXXXX");
 
