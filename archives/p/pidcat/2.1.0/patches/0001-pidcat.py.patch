 import sys
 import re
 import subprocess
 from subprocess import PIPE
 
+# OHOS: '/usr/bin/env' shebang cannot pass the '-u' flag (the kernel passes
+# only one argument after the interpreter). Replicate `python -u` in code so
+# log lines still appear in real time when stdout is piped or redirected.
+sys.stdout.reconfigure(line_buffering=True, write_through=True)
