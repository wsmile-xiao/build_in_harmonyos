+/* ------------------------------------------------------------------ *
+ * Headless self test (-S / --selftest).                               *
+ *                                                                     *
+ * HarmonyOS PC has no X server, so the GTK window cannot be opened.   *
+ * This entry point exercises the display-independent production code  *
+ * of the package: the pstr/ptime helpers and the complete taskwarrior *
+ * import path (taskwarrior version gate, `task export` JSON parsing,  *
+ * tag/project extraction) driven by a stub `task` command.            *
+ * ------------------------------------------------------------------ */
+
+static int st_total;
+static int st_failed;
+
+static void st_check(const char *what, int ok, const char *detail)
+{
+	st_total++;
+
+	if (!ok)
+		st_failed++;
+
+	printf("%s %s%s%s\n", ok ? "ok  " : "FAIL", what,
+	       (detail && *detail) ? " -- " : "",
+	       (detail && *detail) ? detail : "");
+}
+
+/* Stand-in for the taskwarrior CLI: it only has to answer --version and
+ * to dump the JSON document used by `task export'. */
+static const char *st_stub_task =
+	"#!/bin/sh\n"
+	"case \"$*\" in\n"
+	"  *--version*) echo \"${PTASK_STUB_VERSION:-2.6.2}\" ;;\n"
+	"  *export*)    cat \"$PTASK_STUB_EXPORT\" ;;\n"
+	"esac\n"
+	"exit 0\n";
+
+static const char *st_stub_export =
+	"[\n"
+	" {\"id\":1,\"description\":\"first task\",\"status\":\"pending\",\n"
+	"  \"project\":\"ptask\",\"priority\":\"H\",\n"
+	"  \"uuid\":\"11111111-1111-1111-1111-111111111111\",\"urgency\":12.5,\n"
+	"  \"entry\":\"20260102T030405Z\",\"due\":\"20260203T040506Z\",\n"
+	"  \"tags\":[\"ohos\",\"selftest\"]},\n"
+	" {\"id\":2,\"description\":\"second task\",\"status\":\"pending\",\n"
+	"  \"uuid\":\"22222222-2222-2222-2222-222222222222\",\n"
+	"  \"entry\":\"20260103T030405Z\",\"tags\":[]}\n"
+	"]\n";
+
+static int st_write(const char *path, const char *content, int executable)
+{
+	FILE *f;
+
+	f = fopen(path, "w");
+
+	if (!f)
+		return 0;
+
+	fputs(content, f);
+	fclose(f);
+
+	if (executable)
+		chmod(path, 0755);
+
+	return 1;
+}
+
+static char *st_scratch_dir(void)
+{
+	const char *base;
+	char *dir;
+
+	base = getenv("TMPDIR");
+
+	if (!base || !*base || access(base, W_OK) != 0)
+		base = ".";
+
+	dir = malloc(strlen(base) + strlen("/ptask-selftest-XXXXXX") + 1);
+	sprintf(dir, "%s/ptask-selftest-XXXXXX", base);
+
+	if (!mkdtemp(dir)) {
+		free(dir);
+		return NULL;
+	}
+
+	return dir;
+}
+
+static char *st_join(const char *dir, const char *name)
+{
+	char *path;
+
+	path = malloc(strlen(dir) + strlen(name) + 2);
+	sprintf(path, "%s/%s", dir, name);
+
+	return path;
+}
+
+static int st_schema_available(void)
+{
+	GSettingsSchemaSource *src;
+	GSettingsSchema *schema;
+
+	src = g_settings_schema_source_get_default();
+
+	if (!src)
+		return 0;
+
+	schema = g_settings_schema_source_lookup(src, "ptask", TRUE);
+
+	if (!schema)
+		return 0;
+
+	g_settings_schema_unref(schema);
+
+	return 1;
+}
+
+static int st_run_selftest(void)
+{
+	char *dir, *stub, *export_file, *old_path, *new_path;
+	char *old_home, *schema_dir;
+	struct task **tasks;
+	struct project **projects;
+	struct tm tm;
+	char *s;
+	int i, all_ok, ptask_ok;
+
+	printf("ptask %s selftest\n", VERSION);
+
+	/* pstr: trim() */
+	{
+		char a[] = "  spaced  ";
+		char b[] = "\t \n";
+		char c[] = "inner space";
+
+		trim(a);
+		trim(b);
+		trim(c);
+
+		st_check("trim strips leading and trailing blanks",
+			 !strcmp(a, "spaced"), a);
+		st_check("trim of a blanks-only string is empty",
+			 !strcmp(b, ""), NULL);
+		st_check("trim keeps inner blanks",
+			 !strcmp(c, "inner space"), NULL);
+	}
+
+	/* ptime helpers */
+	s = get_time_str();
+	st_check("get_time_str returns a non-empty string", s && *s, s);
+	free(s);
+
+	memset(&tm, 0, sizeof(tm));
+	tm.tm_year = 126;
+	tm.tm_mon = 0;
+	tm.tm_mday = 2;
+	tm.tm_hour = 3;
+	tm.tm_min = 4;
+	tm.tm_sec = 5;
+	s = tm_to_str(&tm);
+	st_check("tm_to_str renders the calendar date",
+		 s && strstr(s, "2026"), s);
+	free(s);
+
+	/* the GSettings schema shipped with the package */
+	schema_dir = getenv("GSETTINGS_SCHEMA_DIR");
+
+	if (schema_dir) {
+		int found = st_schema_available();
+
+		st_check("GSettings schema 'ptask' found", found, schema_dir);
+
+		if (found) {
+			/* keep the test hermetic: do not depend on a dconf
+			 * daemon being reachable */
+			setenv("G_SETTINGS_BACKEND", "memory", 1);
+			settings_init();
+		}
+	} else {
+		printf("info GSETTINGS_SCHEMA_DIR not set, note lookup "
+		       "falls back to $HOME/.task\n");
+	}
+
+	dir = st_scratch_dir();
+
+	if (!dir) {
+		st_check("scratch directory created", 0, strerror(errno));
+		printf("selftest: %d/%d checks passed\n",
+		       st_total - st_failed, st_total);
+		return 1;
+	}
+
+	stub = st_join(dir, "task");
+	export_file = st_join(dir, "export.json");
+
+	st_check("stub taskwarrior written",
+		 st_write(stub, st_stub_task, 1)
+		 && st_write(export_file, st_stub_export, 0), dir);
+
+	setenv("PTASK_STUB_EXPORT", export_file, 1);
+	setenv("PTASK_STUB_VERSION", "2.6.2", 1);
+
+	old_home = strdup(getenv("HOME") ? getenv("HOME") : "");
+	old_path = strdup(getenv("PATH") ? getenv("PATH") : "");
+
+	new_path = malloc(strlen(dir) + strlen(old_path) + 2);
+	sprintf(new_path, "%s:%s", dir, old_path);
+
+	/* keep the note lookup inside the scratch directory */
+	setenv("HOME", dir, 1);
+	setenv("PATH", new_path, 1);
+
+	tasks = tw_get_all_tasks("pending");
+	st_check("taskwarrior export imported (2.6.2 accepted)",
+		 tasks != NULL, NULL);
+
+	if (tasks) {
+		st_check("both exported tasks parsed",
+			 tasks[0] && tasks[1] && !tasks[2], NULL);
+
+		if (tasks[0] && tasks[1]) {
+			st_check("task id parsed", tasks[0]->id == 1, NULL);
+			st_check("description parsed",
+				 !strcmp(tasks[0]->description, "first task"),
+				 tasks[0]->description);
+			st_check("project parsed",
+				 !strcmp(tasks[0]->project, "ptask"), NULL);
+			st_check("priority parsed",
+				 !strcmp(tasks[0]->priority, "H"), NULL);
+			st_check("uuid parsed",
+				 !strcmp(tasks[0]->uuid,
+					 "11111111-1111-1111-1111-111111111111"),
+				 NULL);
+			st_check("tags parsed",
+				 tasks[0]->tags && tasks[0]->tags[0]
+				 && !strcmp(tasks[0]->tags[0], "ohos")
+				 && tasks[0]->tags[1]
+				 && !strcmp(tasks[0]->tags[1], "selftest")
+				 && !tasks[0]->tags[2], NULL);
+			st_check("entry date parsed",
+				 tasks[0]->entry
+				 && tasks[0]->entry->tm_year == 126
+				 && tasks[0]->entry->tm_mon == 0
+				 && tasks[0]->entry->tm_mday == 2, NULL);
+			st_check("due date parsed",
+				 tasks[0]->due && tasks[0]->due->tm_mday == 3,
+				 NULL);
+			st_check("absent project defaults to an empty string",
+				 !strcmp(tasks[1]->project, ""), NULL);
+			st_check("absent priority defaults to an empty string",
+				 !strcmp(tasks[1]->priority, ""), NULL);
+		}
+
+		projects = tw_get_projects(tasks);
+		all_ok = 0;
+		ptask_ok = 0;
+
+		for (i = 0; projects && projects[i]; i++) {
+			if (!strcmp(projects[i]->name, "ALL")
+			    && projects[i]->count == 2)
+				all_ok = 1;
+
+			if (!strcmp(projects[i]->name, "ptask")
+			    && projects[i]->count == 1)
+				ptask_ok = 1;
+		}
+
+		st_check("project list aggregation", all_ok && ptask_ok, NULL);
+		tw_project_list_free(projects);
+		tw_task_list_free(tasks);
+	}
+
+	/* an unsupported taskwarrior version must be refused ... */
+	setenv("PTASK_STUB_VERSION", "9.9.9", 1);
+	tasks = tw_get_all_tasks("pending");
+	st_check("unsupported taskwarrior version rejected",
+		 tasks == NULL, NULL);
+
+	if (tasks)
+		tw_task_list_free(tasks);
+
+	/* ... unless -f / --force-unsupported-taskwarrior was used */
+	tw_enable_check_version(0);
+	tasks = tw_get_all_tasks("pending");
+	st_check("forced unsupported taskwarrior still parses",
+		 tasks != NULL, NULL);
+
+	if (tasks)
+		tw_task_list_free(tasks);
+
+	tw_enable_check_version(1);
+
+	/* a missing taskwarrior must be reported, not crash */
+	setenv("PATH", "/nonexistent", 1);
+	tasks = tw_get_all_tasks("pending");
+	st_check("missing taskwarrior yields no tasks", tasks == NULL, NULL);
+
+	setenv("PATH", old_path, 1);
+	setenv("HOME", old_home, 1);
+
+	unlink(stub);
+	unlink(export_file);
+	rmdir(dir);
+
+	free(stub);
+	free(export_file);
+	free(dir);
+	free(new_path);
+	free(old_path);
+	free(old_home);
+
+	printf("selftest: %d/%d checks passed\n",
+	       st_total - st_failed, st_total);
+
+	return st_failed ? 1 : 0;
+}
+
