diff --git a/configure b/configure
index 6ce336b..752cb51 100755
--- a/configure
+++ b/configure
@@ -76593,7 +76593,7 @@ else case e in #(
                                                       if {
               # Use the mktemp program if available. If not available, hide the error
               # message.
-              tmp=`(umask 077 && mktemp -d /tmp/gtXXXXXX) 2>/dev/null` &&
+              tmp=`(umask 022 && mktemp -d /tmp/gtXXXXXX) 2>/dev/null` &&
               test -n "$tmp" && test -d "$tmp"
             } ||
             {
@@ -76603,7 +76603,7 @@ else case e in #(
               # rather, it minimizes the probability of failure in a very cluttered /tmp
               # directory.
               tmp=/tmp/gt$$-$RANDOM
-              (umask 077 && mkdir "$tmp")
+              (umask 022 && mkdir "$tmp")
             }; then
            mkdir "$tmp/subdir"
            GL_SUBDIR_FOR_UNLINK="$tmp/subdir"
@@ -109351,12 +109351,12 @@ $debug ||
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 022 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
