--- a/apps/CMakeLists.txt
+++ b/apps/CMakeLists.txt
@@ -22,7 +22,11 @@
 # Inspired by http://bloerg.net/2012/11/10/cmake-and-distutils.html
 
 FIND_PROGRAM(PYTHON "python3")
-IF(PYTHON)
+# Honor INSTALL_PYTHON_MODULE (declared in the top-level CMakeLists.txt but
+# never consulted upstream): the module build needs setuptools, which the
+# OHOS build environment does not ship; the packaging recipe installs the
+# module itself with a package-relative path instead.
+IF(PYTHON AND INSTALL_PYTHON_MODULE)
     SET(SETUP_PY_IN "${CMAKE_CURRENT_SOURCE_DIR}/setup.py.in")
     SET(SETUP_PY    "${CMAKE_CURRENT_BINARY_DIR}/setup.py")
     SET(DEPS_IN     "${CMAKE_CURRENT_SOURCE_DIR}/lensfun/__init__.py.in")
@@ -43,4 +47,4 @@
       SET(SETUP_PY_INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}")
     ENDIF()
     INSTALL(CODE "execute_process(COMMAND ${PYTHON} ${SETUP_PY} install --prefix=\$ENV{DESTDIR}${SETUP_PY_INSTALL_PREFIX})")
-ENDIF(PYTHON)
+ENDIF(PYTHON AND INSTALL_PYTHON_MODULE)
