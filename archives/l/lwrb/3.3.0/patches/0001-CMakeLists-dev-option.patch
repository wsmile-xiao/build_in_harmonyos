--- a/CMakeLists.txt	2026-09-27 23:23:10.336497812 +0800
+++ b/CMakeLists.txt	2026-09-27 23:26:11.492497812 +0800
@@ -3,9 +3,12 @@
 # Setup project
 project(LwLibPROJECT C)
 
+# Build the dev-only demo executable (default OFF for library packaging)
+option(LWRB_BUILD_DEV "Build the development demo executable" OFF)
+
 if(NOT PROJECT_IS_TOP_LEVEL)
     add_subdirectory(lwrb)
-else()
+elseif(LWRB_BUILD_DEV)
     enable_testing()
     add_executable(${PROJECT_NAME})
     target_sources(${PROJECT_NAME} PRIVATE
@@ -27,4 +30,21 @@
 
     # Add test
     add_test(NAME Test COMMAND $<TARGET_FILE:${CMAKE_PROJECT_NAME}>)
+else()
+    # Library-only build: just the lwrb targets, no dev executable
+    add_subdirectory(lwrb)
+
+    # Set SONAME so downstream linkers can address the shared library
+    # (root project() declares no VERSION, so use explicit values)
+    set_target_properties(lwrb PROPERTIES
+        VERSION 3.3.0
+        SOVERSION 3)
+
+    # Install rules for the Conan package: core library + public header
+    install(TARGETS lwrb
+        ARCHIVE DESTINATION lib
+        LIBRARY DESTINATION lib
+        RUNTIME DESTINATION bin)
+    install(FILES ${CMAKE_CURRENT_LIST_DIR}/lwrb/src/include/lwrb/lwrb.h
+        DESTINATION include/lwrb)
 endif()
