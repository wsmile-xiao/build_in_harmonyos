--- /dev/null	2026-09-03 08:11:29.375494219 +0800
+++ b/lwrb/test/lwrb_test_ex_main.c	2026-09-27 22:43:06.084497031 +0800
@@ -0,0 +1,39 @@
+/*
+ * Test runner for the extended upstream suite (lwrb/test/test_ex.c).
+ *
+ * test_ex.c only defines Unity test cases (guarded by TEST); upstream
+ * never wires it into a build target, so it has no main(). This runner
+ * provides the executable entry point for the lwrb_test_ex target
+ * (wired in by patch 0002) without touching the upstream cases.
+ */
+#include "unity.h"
+
+void setUp(void);
+void tearDown(void);
+
+void test_lwrb_ex_copy_1_linear_linear_simple(void);
+void test_lwrb_ex_copy_2_linear_linear_end(void);
+void test_lwrb_ex_copy_3_linear_wrap(void);
+void test_lwrb_ex_copy_4_wrap_wrap(void);
+void test_lwrb_ex_overwrite_1_linear_under_free(void);
+void test_lwrb_ex_overwrite_2_wrap_under_free(void);
+void test_lwrb_ex_overwrite_3_linear_over_free(void);
+void test_lwrb_ex_overwrite_4_linear_over_wrap(void);
+void test_lwrb_ex_overwrite_5_oversize_from_middle(void);
+void test_lwrb_ex_overwrite_6_oversize_from_zero(void);
+
+int
+main(void) {
+    UNITY_BEGIN();
+    RUN_TEST(test_lwrb_ex_copy_1_linear_linear_simple);
+    RUN_TEST(test_lwrb_ex_copy_2_linear_linear_end);
+    RUN_TEST(test_lwrb_ex_copy_3_linear_wrap);
+    RUN_TEST(test_lwrb_ex_copy_4_wrap_wrap);
+    RUN_TEST(test_lwrb_ex_overwrite_1_linear_under_free);
+    RUN_TEST(test_lwrb_ex_overwrite_2_wrap_under_free);
+    RUN_TEST(test_lwrb_ex_overwrite_3_linear_over_free);
+    RUN_TEST(test_lwrb_ex_overwrite_4_linear_over_wrap);
+    RUN_TEST(test_lwrb_ex_overwrite_5_oversize_from_middle);
+    RUN_TEST(test_lwrb_ex_overwrite_6_oversize_from_zero);
+    return UNITY_END();
+}
