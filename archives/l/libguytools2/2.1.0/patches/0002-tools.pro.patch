--- a/tools.pro
+++ b/tools.pro
@@ -50,17 +50,35 @@
 DEPENDPATH  += ./include
 INCLUDEPATH += ./include
 
 QMAKE_CXXFLAGS *= $(shell dpkg-buildflags --get CXXFLAGS)
 QMAKE_LFLAGS   *= $(shell dpkg-buildflags --get LDFLAGS)
 
 QMAKE_CXXFLAGS_WARN_ON += -Wno-strict-aliasing   # Switch off warning "dereferencing type-punned pointer will break strict-aliasing rules"
 QMAKE_CXXFLAGS_WARN_ON += -fmessage-length=0     # Tell g++ not to split messages into different lines
 QMAKE_CXXFLAGS_RELEASE += -O3
 
+# Make the shared library versioned (libguytools.so.MAJOR) instead of relying on
+# qmake's QT_VERSION-derived default.  Without this, Qt >= 5.15 derives the major
+# from the Qt version, which yields the nonsensical SONAME libguytools.so.5.
+VERSION = $$VERSION
+
+# Installation layout: headers go to include/libguytools, the library to lib/.
+headers.path   = $$PREFIX/include/libguytools
+headers.files  = $$PWD/include/tooltypes.h \
+                 $$PWD/include/toolconstants.h \
+                 $$PWD/include/toolglobalid.h \
+                 $$PWD/include/toolerror.h \
+                 $$PWD/include/toollog.h \
+                 $$PWD/include/toolcfg.h \
+                 $$PWD/include/toolsignal.h \
+                 $$PWD/include/toolsysinfo.h
+target.path    = $$PREFIX/lib
+INSTALLS      += headers target
+
 SOURCES += toollog.cpp
 SOURCES += toolerror.cpp
 SOURCES += toolsysinfo.cpp
 SOURCES += toolsignal.cpp
 SOURCES += toolcfg.cpp
 
 
