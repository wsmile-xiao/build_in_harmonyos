--- a/config.sub
+++ b/config.sub
@@ -1,4 +1,13 @@
 #! /bin/sh
+# aarch64 and the OHOS operating system were introduced long after this
+# bundled config.sub was released: accept the triplet verbatim.
+case $1 in
+  aarch64-*-linux-* | aarch64-*-ohos*)
+    echo "$1"
+    exit 0
+    ;;
+esac
