diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,11 @@
+#!/bin/bash
+# Configure wrapper for liblc3 (meson project)
+# This script wraps meson setup to behave like ./configure
+
+PREFIX="${PREFIX:-/storage/Users/currentUser/usr/local}"
+BUILD_DIR="${BUILD_DIR:-build}"
+
+export CC="${CC:-/storage/Users/currentUser/usr/local/bin/cc}"
+export AR="${AR:-/storage/Users/currentUser/usr/local/bin/ar}"
+
+meson setup "$BUILD_DIR" --prefix="$PREFIX"