diff -ruN a/rb.c b/rb.c
--- a/rb.c
+++ b/rb.c
@@ -141,9 +141,14 @@
  * @param sem semaphore to post to
  * ========================================================================== */
 #if ENABLE_THREADS
 static void rb_sem_post(sem_t *sem)
 {
-	int value;
-	sem_getvalue(sem, &value);
-	if (value == 0)
-		sem_post(sem);
+	/* Unconditional post: the old `sem_getvalue() == 0` gate is racy on
+	 * any POSIX (value can change between getvalue and post: it reads 1,
+	 * then a consumer blocks, and the wakeup is lost -> make check hangs
+	 * under high producer/consumer contention), and musl additionally
+	 * reports blocked waiters as a negative count so `== 0` drops the
+	 * wakeup exactly when waiters exist. A count above 1 only costs an
+	 * extra sem_wait drain in rb_wait_for_data()/rb_wait_for_space(),
+	 * while a missed post hangs pthread_join forever. */
+	sem_post(sem);
 }
 #endif
