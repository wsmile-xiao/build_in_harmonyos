diff -ruN /dev/null b/CMakeLists.txt
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,112 @@
+cmake_minimum_required(VERSION 3.10)
+project(libXrandr VERSION 1.5.5 LANGUAGES C)
+
+# Set C standard
+set(CMAKE_C_STANDARD 99)
+
+# Force position-independent code (required for shared libraries)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+
+# Compiler flags
+if(CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
+    add_compile_options(-fno-strict-aliasing)
+    add_compile_options(-DMALLOC_0_RETURNS_NULL)
+endif()
+
+# Find required dependencies using pkg-config
+find_package(PkgConfig REQUIRED)
+
+pkg_check_modules(X11 REQUIRED x11>=1.6)
+pkg_check_modules(XCB REQUIRED xcb)
+pkg_check_modules(RANDRPROTO REQUIRED randrproto>=1.5)
+pkg_check_modules(XEXT REQUIRED xext)
+pkg_check_modules(XEXTPROTO REQUIRED xextproto)
+pkg_check_modules(XRENDER REQUIRED xrender)
+pkg_check_modules(RENDERPROTO REQUIRED renderproto)
+
+# Include directories
+include_directories(
+    ${CMAKE_CURRENT_SOURCE_DIR}/include/X11/extensions
+    ${X11_INCLUDE_DIRS}
+    ${XCB_INCLUDE_DIRS}
+    ${RANDRPROTO_INCLUDE_DIRS}
+    ${XEXT_INCLUDE_DIRS}
+    ${XEXTPROTO_INCLUDE_DIRS}
+    ${XRENDER_INCLUDE_DIRS}
+    ${RENDERPROTO_INCLUDE_DIRS}
+)
+
+# Source files
+set(LIBXRANDR_SOURCES
+    src/Xrandr.c
+    src/XrrConfig.c
+    src/XrrCrtc.c
+    src/XrrMode.c
+    src/XrrOutput.c
+    src/XrrProperty.c
+    src/XrrScreen.c
+    src/XrrProvider.c
+    src/XrrProviderProperty.c
+    src/XrrMonitor.c
+)
+
+# Create shared library
+add_library(Xrandr SHARED ${LIBXRANDR_SOURCES})
+
+# Create static library
+add_library(Xrandr_static STATIC ${LIBXRANDR_SOURCES})
+
+# Set library version (from meson.build: version '2.2.0')
+set_target_properties(Xrandr PROPERTIES
+    VERSION 2.2.0
+    SOVERSION 2
+    OUTPUT_NAME Xrandr
+)
+
+set_target_properties(Xrandr_static PROPERTIES
+    OUTPUT_NAME Xrandr
+)
+
+# Link dependencies
+target_link_directories(Xrandr PRIVATE
+    ${X11_LIBRARY_DIRS}
+    ${XCB_LIBRARY_DIRS}
+    ${XEXT_LIBRARY_DIRS}
+    ${XRENDER_LIBRARY_DIRS}
+)
+target_link_libraries(Xrandr
+    ${X11_LIBRARIES}
+    ${XCB_LIBRARIES}
+    ${XEXT_LIBRARIES}
+    ${XRENDER_LIBRARIES}
+)
+
+# Install library
+install(TARGETS Xrandr Xrandr_static
+    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION lib
+    RUNTIME DESTINATION bin
+)
+
+# Install headers
+install(FILES include/X11/extensions/Xrandr.h
+    DESTINATION include/X11/extensions
+)
+
+# Generate pkg-config file
+set(prefix "${CMAKE_INSTALL_PREFIX}")
+set(exec_prefix "\${prefix}")
+set(includedir "\${prefix}/include")
+set(libdir "\${prefix}/lib")
+set(VERSION "${PROJECT_VERSION}")
+set(RANDR_VERSION "1.6.0")
+
+configure_file(
+    ${CMAKE_CURRENT_SOURCE_DIR}/xrandr.pc.in
+    ${CMAKE_CURRENT_BINARY_DIR}/xrandr.pc
+    @ONLY
+)
+
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/xrandr.pc
+    DESTINATION lib/pkgconfig
+)