+Result<FILE*, std::string>
+open_unlinked_temp_file()
+{
+    static const std::filesystem::path dir = [] {
+        std::error_code ec;
+        auto d = lnav::paths::workdir();
+        std::filesystem::create_directories(d, ec);
+        return d;
+    }();
+
+    auto tmp_pair = TRY(open_temp_file(dir / "lnav.tmp.XXXXXX"));
+    std::FILE *fh = fdopen(tmp_pair.second.release(), "wb+");
+    if (fh == nullptr) {
+        return Err(std::string(strerror(errno)));
+    }
+    std::filesystem::remove(tmp_pair.first);
+    return Ok(fh);
+}
+
