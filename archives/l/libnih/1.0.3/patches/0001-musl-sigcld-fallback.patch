@@ -27,6 +27,15 @@
 #include <string.h>
 #include <signal.h>
 
+/* musl/OHOS compat: SIGCLD is a System V alias for SIGCHLD provided by
+ * glibc but absent on musl (including OpenHarmony). Define it as SIGCHLD
+ * when missing so the CLD entry below still compiles and behaves. */
+#ifndef SIGCLD
+# ifdef SIGCHLD
+#  define SIGCLD SIGCHLD
+# endif
+#endif
