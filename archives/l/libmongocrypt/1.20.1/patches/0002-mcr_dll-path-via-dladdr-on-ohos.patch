 }
 
+#elif defined(__OHOS__)
+
+/* OHOS libc provides dladdr()/dl_iterate_phdr() but no dlinfo(), and its
+ * dlopen() handle is an opaque token that matches neither dlpi_addr nor any
+ * segment address, so the link_map lookup below cannot be reproduced. Resolve a
+ * symbol that is guaranteed to live inside the loaded library instead and ask
+ * dladdr() which file that symbol came from. */
+mcr_dll_path_result mcr_dll_path(mcr_dll dll) {
+    /* mongo_crypt_v1_status_create is required of every crypt_shared library
+       (MONGOC_CSFLE_FUNCTIONS_X); mongocrypt_version belongs to libmongocrypt
+       itself. */
+    static const char *const probes[] = {"mongo_crypt_v1_status_create", "mongocrypt_version"};
+    Dl_info info;
+    size_t i;
+
+    for (i = 0; i < sizeof(probes) / sizeof(probes[0]); i++) {
+        void *sym = mcr_dll_sym(dll, probes[i]);
+        if (sym != NULL && dladdr(sym, &info) && info.dli_fname != NULL) {
+            return (mcr_dll_path_result){.path = mstr_copy_cstr(info.dli_fname)};
+        }
+    }
+    return (mcr_dll_path_result){.error_string =
+                                     mstr_copy_cstr("Failed to resolve the path of the loaded library via dladdr")};
+}
+
+bool mcr_dll_path_supported(void) {
+    return true;
+}
+
 #elif defined(__linux__) || defined(__FreeBSD__)
 
 #include <link.h>
