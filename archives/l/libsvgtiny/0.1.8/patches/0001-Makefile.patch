--- a/Makefile
+++ b/Makefile
@@ -1,59 +1,112 @@
 #!/bin/make
 #
-# Makefile for libsvgtiny
+# Standalone Makefile for libsvgtiny 0.1.8 (adapted for HarmonyOS/OpenHarmony)
+#
+# Original NetSurf build system replaced with standalone build because
+# netsurf-buildsystem package is not available on this platform.
 #
 # Copyright 2009-2015 John-Mark Bell <jmb@netsurf-browser.org>
 
 # Component settings
 COMPONENT := svgtiny
 COMPONENT_VERSION := 0.1.8
-# Default to a static library
-COMPONENT_TYPE ?= lib-static
 
-# Setup the tooling
-PREFIX ?= /opt/netsurf
-NSSHARED ?= $(PREFIX)/share/netsurf-buildsystem
-include $(NSSHARED)/makefiles/Makefile.tools
+# Installation paths
+PREFIX ?= /storage/Users/currentUser/usr/local
+LIBDIR ?= lib
+INCLUDEDIR ?= include
 
-# Reevaluate when used, as BUILDDIR won't be defined yet
-TESTRUNNER = test/runtest.sh $(BUILDDIR) $(EXEEXT)
+# Source files (core; autogenerated_colors.c is #included by svgtiny.c)
+SRC := \
+	src/svgtiny.c \
+	src/svgtiny_gradient.c \
+	src/svgtiny_list.c
+OBJ := $(SRC:.c=.o)
+LIB := lib$(COMPONENT).a
+PC_IN := lib$(COMPONENT).pc.in
+PC := lib$(COMPONENT).pc
 
-# Toolchain flags
+# Dependencies (headers at compile time, -l... at link time)
+# Values are injected by the conan recipe from each dependency's cpp_info.
+DOM_CFLAGS ?= -I$(PREFIX)/include
+WAPCAPLET_CFLAGS ?= -I$(PREFIX)/include
+DEP_CFLAGS := $(DOM_CFLAGS) $(WAPCAPLET_CFLAGS)
+DEP_LIBS ?= -L$(PREFIX)/lib -ldom -lwapcaplet -lm
+
+# Compiler settings. Override only make's built-in defaults so that
+# environment / command-line CC/AR/RANLIB (e.g. from the conan recipe)
+# take precedence over these fallbacks.
+ifeq ($(origin CC),default)
+CC = clang
+endif
+ifeq ($(origin AR),default)
+AR = llvm-ar
+endif
+ifeq ($(origin RANLIB),default)
+RANLIB = llvm-ranlib
+endif
+CFLAGS ?= -fPIC -O2
+
+# Our own compile flags (adapted from original NetSurf Makefile)
+# Note: removed -Werror for HarmonyOS compatibility (clang 15 may emit
+# warnings that differ from GCC's)
 WARNFLAGS := -Wall -W -Wundef -Wpointer-arith -Wcast-align \
 	-Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes \
-	-Wmissing-declarations -Wnested-externs -pedantic
-# BeOS/Haiku/AmigaOS standard library headers create warnings
-ifneq ($(BUILD),i586-pc-haiku)
-  ifneq ($(findstring amigaos,$(BUILD)),amigaos)
-    WARNFLAGS := $(WARNFLAGS) -Werror
-  endif
-endif
+	-Wmissing-declarations -Wnested-externs -Wno-error
 
-CFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE \
-	-I$(CURDIR)/include/ -I$(CURDIR)/src \
+COMPILE_CFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE -std=c99 \
+	-I$(CURDIR)/include/ -I$(CURDIR)/src/ $(DEP_CFLAGS) \
 	$(WARNFLAGS) $(CFLAGS)
-ifneq ($(GCCVER),2)
-  CFLAGS := $(CFLAGS) -std=c99
-else
-  # __inline__ is a GCCism
-  CFLAGS := $(CFLAGS) -Dinline="__inline__"
-endif
 
-# libdom
-ifneq ($(PKGCONFIG),)
-  CFLAGS := $(CFLAGS) \
-		$(shell $(PKGCONFIG) $(PKGCONFIGFLAGS) --cflags libdom libwapcaplet)
-  LDFLAGS := $(LDFLAGS) -lm \
-		$(shell $(PKGCONFIG) $(PKGCONFIGFLAGS) --libs libdom libwapcaplet)
-else
-  CFLAGS := $(CFLAGS) -I$(PREFIX)/include
-  LDFLAGS := $(CFLAGS) -ldom -lwapcaplet -lexpat -lm
-endif
+# The colour lookup table src/autogenerated_colors.c is committed (patch
+# 0002) so the build never invokes the gperf host tool. It is a source
+# of truth: clean does NOT delete it and it has no generation rule, so a
+# missing file fails fast with "No rule to make target".
+AUTOGEN := src/autogenerated_colors.c
 
-include $(NSBUILD)/Makefile.top
+# Targets
+.PHONY: all clean install uninstall
 
-# Extra installation rules
-I := /$(INCLUDEDIR)
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/svgtiny.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) /$(LIBDIR)/pkgconfig:lib$(COMPONENT).pc.in
-INSTALL_ITEMS := $(INSTALL_ITEMS) /$(LIBDIR):$(OUTPUT)
+all: $(LIB) $(PC)
+
+# svgtiny.c #includes autogenerated_colors.c, so it must exist before compiling
+src/svgtiny.o: $(AUTOGEN)
+
+%.o: %.c
+	$(CC) $(COMPILE_CFLAGS) -c -o $@ $<
+
+$(LIB): $(OBJ)
+	$(AR) rcs $@ $(OBJ)
+	$(RANLIB) $@
+
+$(PC): $(PC_IN)
+	sed -e 's|PREFIX|$(PREFIX)|g' \
+	    -e 's|LIBDIR|$(LIBDIR)|g' \
+	    -e 's|INCLUDEDIR|$(INCLUDEDIR)|g' \
+	    -e 's|VERSION|$(COMPONENT_VERSION)|g' \
+	    -e 's|Requires: libdom|Requires: libdom libwapcaplet|' \
+	    -e 's|Libs: -L$${libdir} -lsvgtiny|Libs: -L$${libdir} -lsvgtiny $(DEP_LIBS)|' \
+	    $(PC_IN) > $(PC)
+
+clean:
+	rm -f $(OBJ) $(LIB) $(PC)
+
+install: all
+	mkdir -p $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig
+	# Headers + library + regenerated .pc with the final PREFIX
+	mkdir -p $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)
+	cp include/svgtiny.h $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/
+	sed -e 's|PREFIX|$(PREFIX)|g' \
+	    -e 's|LIBDIR|$(LIBDIR)|g' \
+	    -e 's|INCLUDEDIR|$(INCLUDEDIR)|g' \
+	    -e 's|VERSION|$(COMPONENT_VERSION)|g' \
+	    -e 's|Requires: libdom|Requires: libdom libwapcaplet|' \
+	    -e 's|Libs: -L$${libdir} -lsvgtiny|Libs: -L$${libdir} -lsvgtiny $(DEP_LIBS)|' \
+	    $(PC_IN) > $(PC)
+	cp $(LIB) $(DESTDIR)$(PREFIX)/$(LIBDIR)/
+	cp $(PC) $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/
+
+uninstall:
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/$(LIB)
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/$(PC)
+	rm -f $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/svgtiny.h
