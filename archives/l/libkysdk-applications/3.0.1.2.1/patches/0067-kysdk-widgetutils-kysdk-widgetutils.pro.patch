--- a/kysdk-widgetutils/kysdk-widgetutils.pro
+++ b/kysdk-widgetutils/kysdk-widgetutils.pro
@@ -1,17 +1,25 @@
 QT += widgets gui dbus
 
 TEMPLATE = lib
 DEFINES += KYSDKWIDGETUTILS_LIBRARY
 
 CONFIG += c++17 link_pkgconfig
-PKGCONFIG += gsettings-qt6
+
+KYSDK_GSETTINGS_INCLUDE = $$(KYSDK_GSETTINGS_INCLUDE)
+KYSDK_GSETTINGS_LIBDIR = $$(KYSDK_GSETTINGS_LIBDIR)
+!isEmpty(KYSDK_GSETTINGS_INCLUDE) {
+    INCLUDEPATH += $$KYSDK_GSETTINGS_INCLUDE
+    LIBS += -L$$KYSDK_GSETTINGS_LIBDIR -lgsettings-qt6
+} else {
+    error("KYSDK_GSETTINGS_INCLUDE is not set (build through conanfile.py)")
+}
 
 LIBS += -Wl,--no-as-needed -lc
 QMAKE_LFLAGS += -Wl,--no-as-needed
 
 # The following define makes your compiler emit warnings if you use
 # any Qt feature that has been marked deprecated (the exact warnings
 # depend on your compiler). Please consult the documentation of the
 # deprecated API in order to know how to port your code away from it.
 DEFINES += QT_DEPRECATED_WARNINGS
 
