diff -urN patch-orig/kysdk-qtwidgets/src/ohosstub/QGSettings/QGSettings patch-new/kysdk-qtwidgets/src/ohosstub/QGSettings/QGSettings
--- patch-orig/kysdk-qtwidgets/src/ohosstub/QGSettings/QGSettings	1970-01-01 08:00:00.000000000 +0800
+++ patch-new/kysdk-qtwidgets/src/ohosstub/QGSettings/QGSettings	2026-09-17 16:30:28.660840626 +0800
@@ -0,0 +1,34 @@
+// OHOS 无 gsettings-qt6（路径 C 适配）：QGSettings 极简 stub。
+// 保留上游源码 include <QGSettings/QGSettings> 不动（避免逐文件裁剪），
+// isSchemaInstalled 恒 true 保证 m_gsetting 被正常实例化（运行时不悬空），
+// get/reset 返回默认值，changed 为普通成员函数（new-style connect 可连）。
+#ifndef QGSETTINGS_STUB_H
+#define QGSETTINGS_STUB_H
+
+#include <QByteArray>
+#include <QObject>
+#include <QString>
+#include <QStringList>
+#include <QVariant>
+
+class QGSettings : public QObject
+{
+    Q_OBJECT
+public:
+    static bool isSchemaInstalled(const QByteArray &) { return true; }
+
+    QGSettings(const QByteArray &, const QByteArray & = QByteArray(), QObject *parent = nullptr)
+        : QObject(parent)
+    {
+    }
+    ~QGSettings() override = default;
+
+    QStringList keys() const { return QStringList(); }
+    QVariant get(const QString &) const { return QVariant(); }
+    void reset(const QString &) {}
+
+signals:
+    void changed(const QString &);
+};
+
+#endif // QGSETTINGS_STUB_H
