--- a/Makefile
+++ b/Makefile
@@ -1,59 +1,206 @@
 #!/bin/make
 #
-# Makefile for parserutils
+# Standalone Makefile for libparserutils (adapted for HarmonyOS/OpenHarmony)
+#
+# Original NetSurf build system replaced with standalone build because
+# netsurf-buildsystem package is not available on this platform.
 #
 # Copyright 2009-2015 John-Mark Bell <jmb@netsurf-browser.org>
 
 # Component settings
 COMPONENT := parserutils
 COMPONENT_VERSION := 0.2.5
-# Default to a static library
 COMPONENT_TYPE ?= lib-static
 
-# Setup the tooling
-PREFIX ?= /opt/netsurf
-NSSHARED ?= $(PREFIX)/share/netsurf-buildsystem
-include $(NSSHARED)/makefiles/Makefile.tools
-
-TESTRUNNER := $(PERL) $(NSTESTTOOLS)/testrunner.pl
-
-# Toolchain flags
+# Installation paths
+PREFIX ?= /storage/Users/currentUser/usr/local
+LIBDIR ?= lib
+INCLUDEDIR ?= include
+
+# Source files
+SRCDIR := src
+INCDIR := include
+SRC := $(SRCDIR)/charset/aliases.c $(SRCDIR)/charset/codec.c \
+	$(SRCDIR)/charset/codecs/codec_ascii.c $(SRCDIR)/charset/codecs/codec_8859.c \
+	$(SRCDIR)/charset/codecs/codec_ext8.c $(SRCDIR)/charset/codecs/codec_utf8.c \
+	$(SRCDIR)/charset/codecs/codec_utf16.c \
+	$(SRCDIR)/charset/encodings/utf8.c $(SRCDIR)/charset/encodings/utf16.c \
+	$(SRCDIR)/input/filter.c $(SRCDIR)/input/inputstream.c \
+	$(SRCDIR)/utils/buffer.c $(SRCDIR)/utils/errors.c $(SRCDIR)/utils/stack.c \
+	$(SRCDIR)/utils/vector.c
+OBJ := $(SRC:.c=.o)
+LIB := lib$(COMPONENT).a
+PC_IN := libparserutils.pc.in
+PC := lib$(COMPONENT).pc
+
+# Generated file (from build/make-aliases.pl)
+ALIASES_INC := $(SRCDIR)/charset/aliases.inc
+
+# Compiler settings
+CC = clang
+AR = llvm-ar
+RANLIB = llvm-ranlib
+CFLAGS ?= -fPIC -O2
+
+# Our own compile flags (adapted from original NetSurf Makefile)
+# Note: removed -Werror for HarmonyOS compatibility (clang may emit
+# warnings that differ from GCC's)
 WARNFLAGS := -Wall -W -Wundef -Wpointer-arith -Wcast-align \
 	-Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes \
-	-Wmissing-declarations -Wnested-externs -pedantic
-# BeOS/Haiku standard library headers create warnings.
-ifneq ($(BUILD),i586-pc-haiku)
-  WARNFLAGS := $(WARNFLAGS) -Werror
-endif
-
-CFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE \
+	-Wmissing-declarations -Wnested-externs -Wno-error
+
+COMPILE_CFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE -std=c99 \
 	-I$(CURDIR)/include/ -I$(CURDIR)/src \
 	$(WARNFLAGS) $(CFLAGS)
-ifneq ($(GCCVER),2)
-  CFLAGS := $(CFLAGS) -std=c99
-else
-  # __inline__ is a GCCism
-  CFLAGS := $(CFLAGS) -Dinline="__inline__"
-endif
-
-include $(NSBUILD)/Makefile.top
-
-# Extra installation rules
-Is := include/parserutils
-I := /$(INCLUDEDIR)/parserutils
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):$(Is)/errors.h;$(Is)/functypes.h;$(Is)/parserutils.h;$(Is)/types.h
-
-Is := include/parserutils/charset
-I := /$(INCLUDEDIR)/parserutils/charset
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):$(Is)/codec.h;$(Is)/mibenum.h;$(Is)/utf16.h;$(Is)/utf8.h
-
-Is := include/parserutils/input
-I := /$(INCLUDEDIR)/parserutils/input
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):$(Is)/inputstream.h
-
-Is := include/parserutils/utils
-I := /$(INCLUDEDIR)/parserutils/utils
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):$(Is)/buffer.h;$(Is)/stack.h;$(Is)/vector.h
-
-INSTALL_ITEMS := $(INSTALL_ITEMS) /$(LIBDIR)/pkgconfig:lib$(COMPONENT).pc.in
-INSTALL_ITEMS := $(INSTALL_ITEMS) /$(LIBDIR):$(OUTPUT)
+
+# Targets
+.PHONY: all clean install uninstall test
+
+all: $(LIB) $(PC)
+
+$(ALIASES_INC): build/make-aliases.pl build/Aliases
+	perl build/make-aliases.pl
+
+$(SRCDIR)/charset/aliases.o: $(SRCDIR)/charset/aliases.c $(ALIASES_INC)
+
+%.o: %.c
+	$(CC) $(COMPILE_CFLAGS) -c -o $@ $<
+
+$(LIB): $(OBJ)
+	$(AR) rcs $@ $(OBJ)
+	$(RANLIB) $@
+
+$(PC): $(PC_IN)
+	sed -e 's|PREFIX|$(PREFIX)|g' \
+	    -e 's|LIBDIR|$(LIBDIR)|g' \
+	    -e 's|INCLUDEDIR|$(INCLUDEDIR)|g' \
+	    -e 's|VERSION|$(COMPONENT_VERSION)|g' \
+	    $(PC_IN) > $(PC)
+
+clean:
+	rm -f $(OBJ) $(LIB) $(PC) $(ALIASES_INC)
+	rm -rf build/test-bin
+
+install: all
+	mkdir -p $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig
+	mkdir -p $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/parserutils/charset
+	mkdir -p $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/parserutils/input
+	mkdir -p $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/parserutils/utils
+	cp $(LIB) $(DESTDIR)$(PREFIX)/$(LIBDIR)/
+	cp $(PC) $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/
+	cp $(INCDIR)/parserutils/errors.h $(INCDIR)/parserutils/functypes.h \
+	   $(INCDIR)/parserutils/parserutils.h $(INCDIR)/parserutils/types.h \
+	   $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/parserutils/
+	cp $(INCDIR)/parserutils/charset/codec.h \
+	   $(INCDIR)/parserutils/charset/mibenum.h \
+	   $(INCDIR)/parserutils/charset/utf16.h \
+	   $(INCDIR)/parserutils/charset/utf8.h \
+	   $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/parserutils/charset/
+	cp $(INCDIR)/parserutils/input/inputstream.h \
+	   $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/parserutils/input/
+	cp $(INCDIR)/parserutils/utils/buffer.h \
+	   $(INCDIR)/parserutils/utils/stack.h \
+	   $(INCDIR)/parserutils/utils/vector.h \
+	   $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/parserutils/utils/
+
+uninstall:
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/$(LIB)
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/$(PC)
+	rm -rf $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/parserutils
+
+# ----------------------------------------------------------------------
+# Test targets
+#
+# The upstream NetSurf test system (testrunner.pl, part of
+# netsurf-buildsystem) is not available on this platform, so the test
+# binaries are built directly and executed here. Each test binary prints
+# "PASS" (or "FAIL") as its final line.
+#
+# Link with the default lld linker only: GNU ld (bfd) output is refused
+# execution in the OHOS sandbox (exit 126, needs ELF signing). lld needs
+# the SDK's libxml2 at link time, so LD_LIBRARY_PATH is set accordingly.
+# ----------------------------------------------------------------------
+
+TESTDIR := build/test-bin
+TESTCFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE -std=c99 \
+	-I$(CURDIR)/include/ -I$(CURDIR)/src -I$(CURDIR)/test \
+	-I$(CURDIR)/test/regression
+SDK_LLVM_LIB := /data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib
+LDLINK := LD_LIBRARY_PATH=$(SDK_LLVM_LIB) $(CC)
+
+TEST_BINS := aliases cscodec-8859 cscodec-ext8 cscodec-utf16 cscodec-utf8 \
+	filter inputstream filter-segv stream-nomem filter-badenc-segv \
+	buffer-discard
+
+$(TESTDIR):
+	mkdir -p $(TESTDIR)
+
+$(TESTDIR)/aliases: test/aliases.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+$(TESTDIR)/cscodec-utf8: test/cscodec-utf8.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+$(TESTDIR)/cscodec-utf16: test/cscodec-utf16.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+$(TESTDIR)/cscodec-ext8: test/cscodec-ext8.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+$(TESTDIR)/cscodec-8859: test/cscodec-8859.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+$(TESTDIR)/filter: test/filter.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+$(TESTDIR)/inputstream: test/inputstream.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+$(TESTDIR)/filter-segv: test/regression/filter-segv.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+$(TESTDIR)/stream-nomem: test/regression/stream-nomem.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+$(TESTDIR)/filter-badenc-segv: test/regression/filter-badenc-segv.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+$(TESTDIR)/buffer-discard: test/regression/buffer-discard.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB)
+
+# Test data files (from the upstream data directories)
+CSC8859_DATA := $(sort $(wildcard test/data/cscodec-8859/*.dat))
+CSCEXT8_DATA := $(sort $(wildcard test/data/cscodec-ext8/*.dat))
+CSCUTF8_DATA := test/data/cscodec-utf8/simple.dat test/data/cscodec-utf8/UTF-8-test.txt
+CSCUTF16_DATA := test/data/cscodec-utf16/simple.dat
+INPUT_DATA := test/data/input/UTF-8-test.txt
+
+test: all $(TEST_BINS:%=$(TESTDIR)/%)
+	@echo "=== Running upstream libparserutils testcases ==="
+	@echo "--- aliases ---"
+	@$(TESTDIR)/aliases || exit 1
+	@echo "--- filter ---"
+	@$(TESTDIR)/filter || exit 1
+	@echo "--- inputstream ---"
+	@$(TESTDIR)/inputstream $(INPUT_DATA) || exit 1
+	@echo "--- cscodec-utf8 ---"
+	@for f in $(CSCUTF8_DATA); do \
+		echo "== $$f"; $(TESTDIR)/cscodec-utf8 $$f || exit 1; done
+	@echo "--- cscodec-utf16 ---"
+	@for f in $(CSCUTF16_DATA); do \
+		echo "== $$f"; $(TESTDIR)/cscodec-utf16 $$f || exit 1; done
+	@echo "--- cscodec-ext8 ---"
+	@for f in $(CSCEXT8_DATA); do \
+		echo "== $$f"; $(TESTDIR)/cscodec-ext8 $$f || exit 1; done
+	@echo "--- cscodec-8859 ---"
+	@for f in $(CSC8859_DATA); do \
+		echo "== $$f"; $(TESTDIR)/cscodec-8859 $$f || exit 1; done
+	@echo "--- regression: filter-segv ---"
+	@$(TESTDIR)/filter-segv || exit 1
+	@echo "--- regression: stream-nomem ---"
+	@$(TESTDIR)/stream-nomem || exit 1
+	@echo "--- regression: filter-badenc-segv ---"
+	@$(TESTDIR)/filter-badenc-segv || exit 1
+	@echo "--- regression: buffer-discard ---"
+	@$(TESTDIR)/buffer-discard || exit 1
+	@echo "=== All upstream testcases PASSED ==="
