--- a/src/null.c
+++ b/src/null.c
@@ -80,3 +80,14 @@
 
         return CA_ERROR_NOTSUPPORTED;
 }
+
+int driver_playing(ca_context *c, uint32_t id, int *playing) {
+        ca_return_val_if_fail(c, CA_ERROR_INVALID);
+        ca_return_val_if_fail(playing, CA_ERROR_INVALID);
+
+        /* The null driver never keeps a sound playing: driver_play()
+         * reports completion synchronously, so nothing is ever playing. */
+        *playing = 0;
+
+        return CA_SUCCESS;
+}
