diff --git a/src/ksieve/CMakeLists.txt b/src/ksieve/CMakeLists.txt
index 51eaeb8..3958cc1 100644
--- a/src/ksieve/CMakeLists.txt
+++ b/src/ksieve/CMakeLists.txt
@@ -82,9 +82,27 @@ install(
     COMPONENT Devel
 )
 
+# OHOS packaging: KSieve exposes a real parser API to downstream consumers
+# (KSieve::Parser / ScriptBuilder / Error / Lexer), but upstream only installs
+# libksieve_version.h here. Install the public parser headers and the generated
+# export header under include/KSieve so find_package(KPim6KSieve) consumers can
+# use the library (relied on by this recipe's test_package).
+install(
+    FILES
+        parser.h
+        scriptbuilder.h
+        error.h
+        lexer.h
+        utf8validator.h
+        ${CMAKE_CURRENT_BINARY_DIR}/ksieve_export.h
+    DESTINATION ${KDE_INSTALL_INCLUDEDIR}/KSieve
+    COMPONENT Devel
+)
+
 target_include_directories(
     KPim6KSieve
     PUBLIC
         "$<BUILD_INTERFACE:${libksieve_SOURCE_DIR}/src;${libksieve_BINARY_DIR}/src>"
+        "$<INSTALL_INTERFACE:include>"
 )
 install(TARGETS KPim6KSieve EXPORT KPim6KSieveTargets ${KDE_INSTALL_TARGETS_DEFAULT_ARGS})
