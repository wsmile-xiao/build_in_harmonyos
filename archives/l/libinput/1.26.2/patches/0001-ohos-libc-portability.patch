+/* program_invocation_short_name 是 glibc 扩展，OHOS 的 musl 不提供。
+ * musl 提供传统 BSD 的 __progname，语义一致（都是不含路径的程序名），
+ * 直接别名即可；注意它不在任何标准头里声明，须自行 extern。
+ * 不选 getauxval(AT_EXECFN)：那个返回完整路径，对应的是
+ * program_invocation_name 而非 _short_name。 */
+extern char *__progname;
+#define program_invocation_short_name __progname
