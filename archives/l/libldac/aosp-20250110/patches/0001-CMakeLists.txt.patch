diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -0,0 +1,45 @@
+cmake_minimum_required(VERSION 3.10)
+project(libldac VERSION 1.0 LANGUAGES C)
+
+# Set C standard
+set(CMAKE_C_STANDARD 99)
+set(CMAKE_C_STANDARD_REQUIRED ON)
+
+# Compiler flags
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -O2 -Wall -Wextra")
+
+# Build libldacBT_enc
+add_library(ldacBT_enc SHARED
+    src/ldaclib.c
+    src/ldacBT.c
+)
+
+target_include_directories(ldacBT_enc PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/inc
+    ${CMAKE_CURRENT_SOURCE_DIR}/src
+)
+
+# Build libldacBT_abr
+add_library(ldacBT_abr SHARED
+    abr/src/ldacBT_abr.c
+)
+
+target_include_directories(ldacBT_abr PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/abr/inc
+)
+
+target_link_libraries(ldacBT_abr PRIVATE ldacBT_enc)
+
+# Installation rules
+install(TARGETS ldacBT_enc ldacBT_abr
+    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION lib
+)
+
+install(FILES inc/ldacBT.h
+    DESTINATION include
+)
+
+install(FILES abr/inc/ldacBT_abr.h
+    DESTINATION include
+)