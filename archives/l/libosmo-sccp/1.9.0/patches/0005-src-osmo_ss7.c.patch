+#if !defined(HAVE_LIBSCTP)
+/* OpenHarmony / HarmonyOS adaptation:
+ *
+ * The platform has no libsctp and its kernel does not support SCTP
+ * (socket(AF_INET, SOCK_STREAM, IPPROTO_SCTP) -> EPROTONOSUPPORT), so the
+ * libosmocore dependency is built with --disable-libsctp.  libosmocore then
+ * does NOT export the SCTP multi-address ("multi-homing") helpers that this
+ * file's callers use.  Provide local fallbacks so the library still links and
+ * runs:
+ *
+ *  - osmo_sock_multiaddr_get_ip_and_port(): replicate libosmocore's own
+ *    non-SCTP default path (single address via osmo_sock_get_ip_and_port).
+ *  - osmo_multiaddr_ip_and_port_snprintf(): pure formatting helper, re-implemented.
+ *  - osmo_sock_multiaddr_add/del_local_addr(): SCTP multi-homing is not
+ *    applicable on a single-homed (TCP) socket; the local bind set is fixed at
+ *    connect/bind time, so treat as a successful no-op.
+ *
+ * These are only compiled when HAVE_LIBSCTP is undefined (i.e. exactly on
+ * platforms that need them), so they never collide with libosmocore's real
+ * SCTP-enabled implementations.
+ */
+int osmo_sock_multiaddr_get_ip_and_port(int fd, int ip_proto, char *ip, size_t *ip_cnt, size_t ip_len,
+					char *port, size_t port_len, bool local)
+{
+	if (*ip_cnt == 0) {
+		*ip_cnt = 1;
+		return 0;
+	}
+	*ip_cnt = 1;
+	return osmo_sock_get_ip_and_port(fd, ip, ip_len, port, port_len, local);
+}
+
+int osmo_multiaddr_ip_and_port_snprintf(char *str, size_t str_len,
+					const char *ip, size_t ip_cnt, size_t ip_len,
+					const char *portbuf)
+{
+	const char *first;
+	bool is_v6;
+	int off = 0;
+
+	if (ip_cnt == 0) {
+		snprintf(str, str_len, "NULL:%s", portbuf ? portbuf : "");
+		return strlen(str);
+	}
+
+	first = &ip[0];
+	is_v6 = !!strchr(first, ':');
+	if (is_v6)
+		off += snprintf(str + off, str_len - off, "[");
+	off += snprintf(str + off, str_len - off, "%s", first);
+	if (is_v6)
+		off += snprintf(str + off, str_len - off, "]");
+	if (portbuf)
+		off += snprintf(str + off, str_len - off, ":%s", portbuf);
+	return off;
+}
+
+int osmo_sock_multiaddr_add_local_addr(int sfd, const char **addrs, size_t addrs_cnt)
+{
+	/* SCTP multi-homing is unavailable; the socket is single-homed and its
+	 * local address set was already fixed at bind/connect time. */
+	return 0;
+}
+
+int osmo_sock_multiaddr_del_local_addr(int sfd, const char **addrs, size_t addrs_cnt)
+{
+	/* See osmo_sock_multiaddr_add_local_addr() above. */
+	return 0;
+}
+#endif /* !HAVE_LIBSCTP */
