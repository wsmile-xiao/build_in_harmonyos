diff -Nur a/tests/ohos.test b/tests/ohos.test
--- a/tests/ohos.test	1970-01-01 08:00:00.000000000 +0800
+++ b/tests/ohos.test	2026-10-08 23:11:27.016572657 +0800
@@ -0,0 +1,92 @@
+# ohos.test --
+#
+#	HarmonyOS (OHOS PC / aarch64) 消费者用例可行性测试。
+#
+#	由 OpenHarmony PC 适配补丁 0001-ohos-consumer-test.patch 新增。
+#
+#	目的：在真实 OHOS 宿主上验证 Img 扩展的 **消费者可用性**：
+#	  (a) Img 主包及其各格式处理器 .so 能否被消费者脚本解释器真实 dlopen
+#	      加载（TEA stub 链接 + OHOS 加载器语义并非理所当然）；
+#	  (b) 消费者能否用 `image create photo` 完成真实的图像格式读写往返。
+#
+#	本文件由 tests/all.tcl 的 ::tcltest::runAllTests 自动收集执行。
+
+package require Tk
+
+package require tcltest
+tcltest::configure {*}$argv
+source [file join [file dirname [info script]] constraints.tcl]
+
+imageInit
+
+namespace eval ::ohos::test {
+    namespace import ::tcltest::*
+
+    set handlerPkgs {
+        img::bmp img::gif img::ico img::jpeg img::pcx img::pixmap
+        img::png img::ppm img::ps img::sgi img::sun img::tga
+        img::tiff img::window img::xbm img::xpm img::dted
+        img::raw img::flir
+    }
+
+    test ohos-0.1 {Img 主包在 HarmonyOS 上可被消费者加载} -body {
+        package require Img
+    } -result 2.1.1
+
+    test ohos-0.2 {OHOS 消费者 load 机制：共享库后缀为 ELF .so} -body {
+        info sharedlibextension
+    } -result .so
+
+    test ohos-0.3 {OHOS 平台标识与目标字长} -body {
+        list $::tcl_platform(platform) $::tcl_platform(pointerSize)
+    } -result {unix 8}
+
+    test ohos-0.4 {宿主 OS 标识为 OHOS 系（HarmonyOS 或 Linux）} -body {
+        expr {
+            [string match -nocase "*harmony*" $::tcl_platform(os)]
+            || [string match -nocase "linux" $::tcl_platform(os)]
+        }
+    } -result 1
+
+    # ---------------------------------------------------------------
+    # 消费者可行性核心：逐个 dlopen 全部格式处理器（TEA stub 链接的 .so）。
+    # 任何一个处理器在 OHOS 上加载失败都会让该用例 FAIL，从而暴露平台问题。
+    # ---------------------------------------------------------------
+    foreach pkg $handlerPkgs {
+        set fmt [string map {"img::" ""} $pkg]
+        test ohos-1.$fmt "$pkg 处理器在 HarmonyOS 上可 dlopen 加载" -body {
+            package require $pkg
+        } -match glob -result *
+    }
+
+    # ---------------------------------------------------------------
+    # 真实消费者往返：读文件 -> 写盘 -> 重新读回 -> 逐像素比较
+    # ---------------------------------------------------------------
+    test ohos-2.1 {消费者真实读图：从 BMP 文件创建 photo 并读取尺寸} -setup {
+        catch {image delete i}
+    } -body {
+        image create photo i -file [file join testimgs img.bmp]
+        imageSize i
+    } -cleanup {
+        image delete i
+    } -result {40 7}
+
+    test ohos-2.2 {消费者真实往返：photo 写盘后重新读回逐像素一致} -setup {
+        catch {image delete i}
+        catch {image delete j}
+    } -body {
+        image create photo i -file [file join testimgs img.bmp]
+        set out [file join testimgs ohos_roundtrip.bmp]
+        i write $out
+        image create photo j -file $out
+        imageCompare i j
+    } -cleanup {
+        image delete i
+        image delete j
+        file delete -force [file join testimgs ohos_roundtrip.bmp]
+    } -result 1
+}
+
+imageFinish
+tcltest::cleanupTests
+namespace delete ::ohos::test
