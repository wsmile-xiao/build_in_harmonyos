--- a/aux-build/config.guess
+++ b/aux-build/config.guess
@@ -197,6 +197,18 @@
 # Note: order is significant - the case branches are not exclusive.
 
 case $UNAME_MACHINE:$UNAME_SYSTEM:$UNAME_RELEASE:$UNAME_VERSION in
+    *:HarmonyOS:*:*)
+	# HarmonyOS / OpenHarmony (HongMeng kernel).  Map the machine part
+	# onto the *-linux-ohos triplet accepted by config.sub.
+	case "$UNAME_MACHINE" in
+	    aarch64|arm64) echo aarch64-unknown-linux-ohos; exit ;;
+	    armv7*|armv8*) echo arm-unknown-linux-ohos; exit ;;
+	    x86_64|amd64)  echo x86_64-unknown-linux-ohos; exit ;;
+	    i?86)          echo i686-unknown-linux-ohos; exit ;;
+	    *)             echo ${UNAME_MACHINE}-unknown-linux-ohos; exit ;;
+	esac
+	;;
+
     *:NetBSD:*:*)
 	# NetBSD (nbsd) targets should (where applicable) match one or
 	# more of the tuples: *-*-netbsdelf*, *-*-netbsdaout*,
