diff -Naur a/makefile b/makefile
--- a/makefile	2026-09-20 23:10:45.807065938 +0800
+++ b/makefile	2026-09-20 23:10:45.971067500 +0800
@@ -80,6 +80,13 @@
 
 
 SHLIB_CFLAGS = -fPIC
+
+# Installed layout: executables in bin/, the shared library in lib/.  The
+# upstream install target drops both into $(prefix) with no RUNPATH at all, so
+# bin/lrs can only find liblrs.so.1 through LD_LIBRARY_PATH.  Make the
+# executables relocatable.  ($$ORIGIN is escaped for make; the shell keeps the
+# single quotes so the linker receives the literal $ORIGIN token.)
+RUNPATHFLAGS ?= -Wl,-rpath,'$$ORIGIN/../lib'
 mpicxx=mpicc
 
 LRSOBJ=lrs.o lrslong1.o lrslib1.o lrslibgmp.o lrsgmp.o lrsdriver.o
@@ -259,11 +266,11 @@
 all-shared: ${SHLIBBIN}
 
 lrs-shared: ${SHLINK} lrs-shared.o
-	$(CC) $^ -o $@ -L . -llrs
+	$(CC) $^ -o $@ -L . -llrs $(RUNPATHFLAGS)
 
 
 lrsnash-shared: ${SHLINK}  lrsnash.c
-	$(CC) ${CFLAGS} -DGMP -DMA lrsnash.c  lrsnashlib.c -I${INCLUDEDIR} -o $@ -L . -llrs -lgmp
+	$(CC) ${CFLAGS} -DGMP -DMA lrsnash.c  lrsnashlib.c -I${INCLUDEDIR} -o $@ -L . -llrs -lgmp $(RUNPATHFLAGS)
 
 # driver object files
 
