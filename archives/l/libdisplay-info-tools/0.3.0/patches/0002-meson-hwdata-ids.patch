diff -ruN a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -21,7 +21,13 @@
 	hwdata_dir = dep_hwdata.get_variable(pkgconfig: 'pkgdatadir')
 	pnp_ids = files(hwdata_dir / 'pnp.ids')
 else
-	pnp_ids = files('/usr/share/hwdata/pnp.ids')
+	# hwdata is a pure data package with no conan recipe, and the OHOS
+	# device has no /usr/share/hwdata either, so the hardcoded upstream
+	# fallback makes meson abort with
+	#   File /usr/share/hwdata/pnp.ids does not exist.
+	# Fall back to the pnp.ids that ships with this recipe next to the
+	# sources (see export_sources() / source() in conanfile.py).
+	pnp_ids = files('data/pnp.ids')
 endif
 
 gen_search_table = find_program('tool/gen-search-table.py')