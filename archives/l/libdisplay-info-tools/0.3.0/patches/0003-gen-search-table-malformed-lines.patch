diff -ruN a/tool/gen-search-table.py b/tool/gen-search-table.py
--- a/tool/gen-search-table.py
+++ b/tool/gen-search-table.py
@@ -45,7 +45,18 @@
 
 with open(infile, 'r') as f:
     for line in f:
-        [pnpid, name] = line.split(maxsplit=1)
+        fields = line.split(maxsplit=1)
+        if len(fields) != 2:
+            # hwdata's pnp.ids carries lines that hold a PNP ID but no
+            # vendor name (e.g. the bare "MV" line), and unpacking them
+            # kills the whole build with
+            #   ValueError: not enough values to unpack (expected 2, got 1)
+            # Skip them the same way invalid IDs are skipped below.
+            print("Warning: skipping malformed line %s"
+                  % (repr(line.strip()),), file=sys.stderr)
+            continue
+
+        [pnpid, name] = fields
 
         if len(pnpid) != 3:
             print("Warning: skipping invalid PNP ID %s" % (repr(pnpid)), file=sys.stderr)