diff -ruN a/maa/Makefile.gnu b/maa/Makefile.gnu
--- a/maa/Makefile.gnu
+++ b/maa/Makefile.gnu
@@ -0,0 +1,75 @@
+# GNU Make Makefile for libmaa
+# Compatible with original BSD make Makefile
+
+PREFIX ?= /storage/Users/currentUser/usr/local
+LIBDIR ?= $(PREFIX)/lib
+INCDIR ?= $(PREFIX)/include
+
+MAA_MAJOR = 4
+MAA_MINOR = 0
+MAA_TEENY = 0
+VERSION = 1.4.7
+
+CC ?= clang
+AR ?= llvm-ar
+RANLIB ?= llvm-ranlib
+CFLAGS ?= -O2 -Wall -Wextra -fPIC
+CPPFLAGS = -I. -DMAA_MAJOR=$(MAA_MAJOR) -DMAA_MINOR=$(MAA_MINOR) -DMAA_TEENY=$(MAA_TEENY) -DSIZEOF_LONG=8
+LDFLAGS ?=
+
+# Source files from original Makefile
+SRCS = xmalloc.c hash.c set.c stack.c list.c error.c memory.c string.c \
+       debug.c flags.c maa.c prime.c \
+       arg.c pr.c sl.c base64.c base26.c source.c parse-concrete.c \
+       text.c log.c
+
+# Generated files
+GEN_SRCS = arggram.c
+
+OBJS = $(SRCS:.c=.o) $(GEN_SRCS:.c=.o)
+
+# Library targets
+LIB = libmaa.a
+SHLIB = libmaa.so.$(MAA_MAJOR).$(MAA_MINOR)
+SHLIB_LINK = libmaa.so
+
+# All targets
+all: $(LIB) $(SHLIB)
+
+# Static library
+$(LIB): $(OBJS)
+	$(AR) rc $@ $(OBJS)
+	$(RANLIB) $@
+
+# Shared library
+$(SHLIB): $(OBJS)
+	$(CC) -shared -o $@ $(OBJS) $(LDFLAGS)
+	ln -sf $(SHLIB) $(SHLIB_LINK)
+	ln -sf $(SHLIB) libmaa.so.$(MAA_MAJOR)
+
+# Compile source files
+%.o: %.c maa.h
+	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@
+
+# Generate arggram.c
+arggram.c: arggram.txt arggram2c
+	awk -f arggram2c arggram.txt > arggram.c
+
+# Install
+install: all
+	mkdir -p $(DESTDIR)$(LIBDIR)
+	mkdir -p $(DESTDIR)$(INCDIR)
+	cp $(LIB) $(DESTDIR)$(LIBDIR)
+	cp $(SHLIB) $(DESTDIR)$(LIBDIR)
+	cp maa.h $(DESTDIR)$(INCDIR)
+	ln -sf $(SHLIB) $(DESTDIR)$(LIBDIR)/$(SHLIB_LINK)
+	ln -sf $(SHLIB) $(DESTDIR)$(LIBDIR)/libmaa.so.$(MAA_MAJOR)
+
+# Clean
+clean:
+	rm -f $(OBJS) $(LIB) $(SHLIB) $(SHLIB_LINK) libmaa.so.$(MAA_MAJOR)
+
+# arggram.c is needed by arg.c
+arg.o: arggram.c
+
+.PHONY: all install clean