@@ -1,5 +1,15 @@
 add_executable(iothtest_server iothtest_server.c)
-target_link_libraries(iothtest_server ioth pthread)
+# OHOS portability: HarmonyOS libc provides the pthread API in libc itself,
+# there is no separate libpthread to link against.
+if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+	target_link_libraries(iothtest_server ioth)
+else()
+	target_link_libraries(iothtest_server ioth pthread)
+endif()
 
 add_executable(iothtest_client iothtest_client.c)
