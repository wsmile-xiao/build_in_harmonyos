diff -ruN orig/vecpf-ohos-compat.h work/vecpf-ohos-compat.h
--- a/vecpf-ohos-compat.h	1970-01-01 08:00:00.000000000 +0800
+++ b/vecpf-ohos-compat.h	2026-09-27 18:56:19.428973905 +0800
@@ -0,0 +1,752 @@
+/* vecpf-ohos-compat.h — glibc printf-hook compatibility layer for musl/OHOS.
+ *
+ *   Copyright (c) 2026, contributed under the same LGPL-2.1 terms as libvecpf.
+ *
+ *   WHY THIS FILE EXISTS
+ *   --------------------
+ *   libvecpf is implemented as an extension of the *host libc's* printf: it
+ *   registers new conversion specifiers ('d', 'x', ...), extra length
+ *   modifiers ("vl", "vh", "v", "vv", ...) and a user-defined argument type
+ *   through glibc's private <printf.h> API:
+ *
+ *       register_printf_type()  register_printf_modifier()  register_printf_specifier()
+ *
+ *   That API is a glibc extension with no POSIX basis, and musl deliberately
+ *   does not implement it.  OpenHarmony ships musl, so <printf.h> and the
+ *   three symbols above are simply absent.
+ *
+ *   The formatting engine itself (vec_printf_d(), vec_printf_f(),
+ *   gen_fmt_str() in vecpf.c) is plain C and only emits through
+ *   fprintf()/fputs(), i.e. it is fully portable.  The three missing symbols
+ *   are used from 17 call sites (1 + 1 + 15, all inside
+ *   __register_printf_vec()), and contain
+ *   no formatting logic whatsoever.  So instead of giving the library up we
+ *   rebuild that missing mount point here:
+ *
+ *     1. an in-tree registry implementing the three registration calls, and
+ *     2. a front-end dispatcher that walks a format string, hands vector
+ *        conversions to the engine and everything else to the host printf.
+ *
+ *   CONTRACT NOTE (important)
+ *   -------------------------
+ *   On glibc the library is transparent: after linking, any printf("%vld", v)
+ *   in the program just works.  That is impossible on musl, because the hook
+ *   has to live inside the libc's printf implementation.  On OHOS the entry
+ *   points below must therefore be called explicitly:
+ *
+ *       vecpf_printf(), vecpf_fprintf(), vecpf_sprintf(), vecpf_asprintf()
+ *
+ *   This is the only behavioural change of the port; everything else
+ *   (supported format strings, output text, error codes) is unchanged.
+ *
+ *   This file is included by vecpf.c only when !defined(__GLIBC__).
+ */
+
+#ifndef VECPF_OHOS_COMPAT_H
+#define VECPF_OHOS_COMPAT_H
+
+/* Internal header: it contains implementations, not just declarations, and it
+   redefines fprintf/fputs for the remainder of vecpf.c.  It is shipped with
+   the sources for reference but must never be included by consumers.  */
+#if !defined(VECPF_BUILDING_LIBRARY)
+#error "vecpf-ohos-compat.h is internal to libvecpf; include <vecpf.h> instead."
+#endif
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdarg.h>
+#include <stddef.h>
+#include <wchar.h>
+#include <ctype.h>
+
+/* -------------------------------------------------------------------------
+ * 1. The subset of glibc's <printf.h> that libvecpf actually uses.
+ *
+ *    Layout and semantics follow glibc's stdio-common/printf.h.  Only the
+ *    members libvecpf reads (spec, prec, width, alt, space, left, showsign,
+ *    group, pad, user) are meaningful here.
+ * ------------------------------------------------------------------------- */
+
+struct printf_info
+{
+  int prec;                     /* Precision, or -1 when unspecified.  */
+  int width;                    /* Field width.  */
+  wchar_t spec;                 /* Format letter ('d', 'x', ...).  */
+
+  unsigned int is_long_double:1;
+  unsigned int is_short:1;
+  unsigned int is_long:1;
+  unsigned int alt:1;           /* '#' flag.  */
+  unsigned int space:1;         /* ' ' flag.  */
+  unsigned int left:1;          /* '-' flag.  */
+  unsigned int showsign:1;      /* '+' flag.  */
+  unsigned int group:1;         /* '\'' flag.  */
+  unsigned int extra:1;
+  unsigned int is_char:1;
+  unsigned int wide:1;
+  unsigned int i18n:1;
+  unsigned int is_binary:1;
+  unsigned int is_negative:1;
+  unsigned int :1;
+
+  wchar_t pad;                  /* Padding character ('0' or ' ').  */
+  unsigned int user;            /* Registered modifiers that matched.  */
+};
+
+/* Prints one conversion.  */
+typedef int printf_function (FILE *__stream, const struct printf_info *__info,
+                             const void *const *__args);
+
+/* Describes one argument, including its size in bytes.  */
+typedef int printf_arginfo_size_function (const struct printf_info *__info,
+                                          size_t __n, int *__argtypes,
+                                          int *__size);
+
+/* Describes one argument (legacy, no size).  */
+typedef int printf_arginfo_function (const struct printf_info *__info,
+                                     size_t __n, int *__argtypes);
+
+/* Copies a user-defined argument out of a va_list.  */
+typedef void printf_type_function (void *__mem, va_list *__ap);
+
+/* -------------------------------------------------------------------------
+ * 2. Forward declarations of the engine entry points defined in vecpf.c.
+ *    These are `static` there; the prototypes must match exactly.
+ * ------------------------------------------------------------------------- */
+
+static int vec_printf_d (FILE *fp, const struct printf_info *info,
+                         const void *const *args);
+static int vec_printf_f (FILE *fp, const struct printf_info *info,
+                         const void *const *args);
+
+/* -------------------------------------------------------------------------
+ * 3. In-tree replacement for the three glibc registration functions.
+ * ------------------------------------------------------------------------- */
+
+#ifndef VECPF_COMPAT_MAX_MODS
+#define VECPF_COMPAT_MAX_MODS 16
+#endif
+#ifndef VECPF_COMPAT_MAX_SPECS
+#define VECPF_COMPAT_MAX_SPECS 64
+#endif
+#ifndef VECPF_COMPAT_VEC_BYTES
+#define VECPF_COMPAT_VEC_BYTES 16     /* AltiVec vector width.  */
+#endif
+
+/* These three stand in for glibc's <printf.h> entry points.  They are kept
+   file-local on purpose: exporting symbols whose names belong to the libc
+   would risk clashing with the C library if it ever grows them, and only
+   vecpf.c (which is the single translation unit including this header) needs
+   to call them.  */
+
+/* Registered "copy an argument of my type out of the va_list" callback.  */
+static printf_type_function *vecpf_compat_type_fn;
+
+static int
+register_printf_type (printf_type_function *__fct)
+{
+  vecpf_compat_type_fn = __fct;
+  return 1;                     /* Type handle; always 1 in this implementation. */
+}
+
+/* Modifier registry.  glibc hands out one bit per registered modifier; the
+   caller (vecpf.c) stores it in vector_mods[i].bits and later tests it
+   against struct printf_info.user.  */
+static struct
+{
+  const wchar_t *wstr;
+  unsigned short bit;
+} vecpf_compat_mods[VECPF_COMPAT_MAX_MODS];
+static int vecpf_compat_n_mods;
+static unsigned short vecpf_compat_next_bit = 1;
+
+static int
+register_printf_modifier (const wchar_t *__str)
+{
+  unsigned short bit;
+
+  if (__str == NULL || *__str == L'\0' || vecpf_compat_n_mods >= VECPF_COMPAT_MAX_MODS)
+    return -1;
+
+  bit = vecpf_compat_next_bit;
+  vecpf_compat_next_bit = (unsigned short) (vecpf_compat_next_bit << 1);
+  if (vecpf_compat_next_bit == 0)
+    vecpf_compat_next_bit = 1;
+
+  vecpf_compat_mods[vecpf_compat_n_mods].wstr = __str;
+  vecpf_compat_mods[vecpf_compat_n_mods].bit = bit;
+  vecpf_compat_n_mods++;
+  return bit;
+}
+
+/* Conversion-specifier registry.  `__arginfo` is not stored: this front-end
+   performs argument dispatch itself, so the size/type information that
+   vec_ais() would report to glibc is unused here.  */
+static struct
+{
+  int spec;
+  printf_function *func;
+} vecpf_compat_specs[VECPF_COMPAT_MAX_SPECS];
+static int vecpf_compat_n_specs;
+
+static int
+register_printf_specifier (int __spec, printf_function *__func,
+                           printf_arginfo_size_function *__arginfo)
+{
+  int i;
+
+  (void) __arginfo;
+
+  for (i = 0; i < vecpf_compat_n_specs; i++)
+    {
+      if (vecpf_compat_specs[i].spec == __spec)
+        {
+          vecpf_compat_specs[i].func = __func;
+          return 0;
+        }
+    }
+
+  if (vecpf_compat_n_specs >= VECPF_COMPAT_MAX_SPECS)
+    return -1;
+
+  vecpf_compat_specs[vecpf_compat_n_specs].spec = __spec;
+  vecpf_compat_specs[vecpf_compat_n_specs].func = __func;
+  vecpf_compat_n_specs++;
+  return 0;
+}
+
+/* Kept for API completeness; libvecpf itself never calls it.  Marked unused
+   because the build enables -Wall -Werror.  */
+static int __attribute__ ((unused))
+register_printf_function (int __spec, printf_function *__func,
+                          printf_arginfo_function *__arginfo)
+{
+  (void) __spec;
+  (void) __func;
+  (void) __arginfo;
+  return -1;                    /* Not used by libvecpf.  */
+}
+
+/* -------------------------------------------------------------------------
+ * 4. Front-end dispatcher.
+ * ------------------------------------------------------------------------- */
+
+static printf_function *
+vecpf_compat_find_spec (int spec)
+{
+  int i;
+  for (i = 0; i < vecpf_compat_n_specs; i++)
+    if (vecpf_compat_specs[i].spec == spec)
+      return vecpf_compat_specs[i].func;
+  return NULL;
+}
+
+/* Longest-first modifier match at `pos` ('vv' before 'v').  */
+static unsigned short
+vecpf_compat_match_modifier (const char *pos, int *len_out)
+{
+  int L, i, j;
+
+  for (L = 2; L >= 1; L--)
+    for (i = 0; i < vecpf_compat_n_mods; i++)
+      {
+        const wchar_t *w = vecpf_compat_mods[i].wstr;
+        for (j = 0; j < L && w[j] != L'\0' && (char) w[j] == pos[j]; j++)
+          ;
+        if (j == L && w[j] == L'\0')
+          {
+            *len_out = L;
+            return vecpf_compat_mods[i].bit;
+          }
+      }
+
+  *len_out = 0;
+  return 0;
+}
+
+/* Output sink: the engine writes through fprintf()/fputs() to a FILE*.  On
+   this platform open_memstream()/fmemopen() lose everything on the fclose()
+   path (see notes.md) and tmpfile() returns NULL, so the front-end passes
+   fp == NULL and the engine's writes are captured here.
+
+   The sink is thread-local on purpose.  Upstream on glibc wrote straight to
+   the caller's FILE*, so the library kept no shared mutable state; a single
+   process-wide buffer here would make concurrent vecpf_*() calls race on the
+   same pointer and corrupt the heap.  */
+#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
+#  define VECPF_COMPAT_TLS _Thread_local
+#elif defined(__GNUC__)
+#  define VECPF_COMPAT_TLS __thread
+#else
+#  define VECPF_COMPAT_TLS           /* No TLS support: single-threaded only.  */
+#endif
+
+static VECPF_COMPAT_TLS char *vecpf_compat_buf;
+static VECPF_COMPAT_TLS size_t vecpf_compat_len;
+static VECPF_COMPAT_TLS size_t vecpf_compat_cap;
+
+static void
+vecpf_compat_put (const char *s, size_t n)
+{
+  if (vecpf_compat_len + n + 1 > vecpf_compat_cap)
+    {
+      size_t nc = vecpf_compat_cap ? vecpf_compat_cap : 128;
+      char *np;
+
+      while (nc < vecpf_compat_len + n + 1)
+        nc *= 2;
+
+      np = (char *) realloc (vecpf_compat_buf, nc);
+      if (np == NULL)
+        return;                 /* Out of memory: drop the chunk.  */
+      vecpf_compat_buf = np;
+      vecpf_compat_cap = nc;
+    }
+
+  if (vecpf_compat_buf == NULL)
+    return;
+
+  memcpy (vecpf_compat_buf + vecpf_compat_len, s, n);
+  vecpf_compat_len += n;
+  vecpf_compat_buf[vecpf_compat_len] = '\0';
+}
+
+/* Release the buffer.  Called at the start and at the end of every public
+   entry point so that repeated calls do not accumulate memory.  */
+static void
+vecpf_compat_reset (void)
+{
+  free (vecpf_compat_buf);
+  vecpf_compat_buf = NULL;
+  vecpf_compat_len = 0;
+  vecpf_compat_cap = 0;
+}
+
+/* Hand the buffer over to the caller (asprintf semantics); the sink is left
+   empty so nothing leaks and nothing is double-freed later.  */
+static char *
+vecpf_compat_take (void)
+{
+  char *r = vecpf_compat_buf != NULL ? vecpf_compat_buf : strdup ("");
+
+  vecpf_compat_buf = NULL;
+  vecpf_compat_len = 0;
+  vecpf_compat_cap = 0;
+  return r;
+}
+
+/* Invoke one engine handler.  Note the calling convention inherited from
+   glibc: args[i] is a pointer *to the pointer* that holds the argument,
+   which is why the engine dereferences it as *((void ***) args)[0].  */
+static void
+vecpf_compat_run_handler (printf_function *fn, const struct printf_info *info,
+                          const void *arg0)
+{
+  void *datap = (void *) arg0;
+  const void *args[1];
+
+  args[0] = &datap;
+  fn (NULL, info, args);        /* fp == NULL -> capture into the buffer.  */
+}
+
+/* Length-modifier classes.  */
+enum vecpf_compat_lm
+{
+  VECPF_LM_NONE, VECPF_LM_HH, VECPF_LM_H, VECPF_LM_L,
+  VECPF_LM_LL, VECPF_LM_Z, VECPF_LM_J, VECPF_LM_T, VECPF_LM_BIG_L
+};
+
+static void
+vecpf_compat_vformat (const char *fmt, va_list ap)
+{
+  const char *p = fmt;
+
+  while (*p != '\0')
+    {
+      char spec_text[80];
+      struct printf_info info;
+      const char *q;
+      int si = 0;
+      unsigned short mbit;
+      int mlen;
+      int lm = VECPF_LM_NONE;
+      char conv;
+      printf_function *handler;
+
+      if (*p != '%')
+        {
+          vecpf_compat_put (p, 1);
+          p++;
+          continue;
+        }
+
+      q = p + 1;
+      memset (&info, 0, sizeof (info));
+      info.pad = L' ';
+      info.prec = -1;           /* -1 means "no precision given".  */
+      spec_text[si++] = '%';
+
+      if (*q == '%')            /* "%%" - let the host handle it.  */
+        {
+          vecpf_compat_put ("%", 1);
+          p = q + 1;
+          continue;
+        }
+
+      /* Flags.  */
+      while (*q != '\0' && strchr ("#-+0 '", *q) != NULL)
+        {
+          switch (*q)
+            {
+            case '#': info.alt = 1; break;
+            case '-': info.left = 1; break;
+            case '+': info.showsign = 1; break;
+            case '0': info.pad = L'0'; break;
+            case ' ': info.space = 1; break;
+            case '\'': info.group = 1; break;
+            default: break;
+            }
+          if (si < 70)
+            spec_text[si++] = *q;
+          q++;
+        }
+
+      /* Width.  */
+      if (*q == '*')
+        {
+          info.width = va_arg (ap, int);
+          si += snprintf (spec_text + si, sizeof (spec_text) - (size_t) si,
+                          "%d", info.width);
+          q++;
+        }
+      else
+        {
+          while (*q != '\0' && isdigit ((unsigned char) *q))
+            {
+              info.width = info.width * 10 + (*q - '0');
+              if (si < 70)
+                spec_text[si++] = *q;
+              q++;
+            }
+        }
+
+      /* Precision.  */
+      if (*q == '.')
+        {
+          if (si < 70)
+            spec_text[si++] = '.';
+          q++;
+          if (*q == '*')
+            {
+              info.prec = va_arg (ap, int);
+              si += snprintf (spec_text + si, sizeof (spec_text) - (size_t) si,
+                              "%d", info.prec);
+              q++;
+            }
+          else
+            {
+              info.prec = 0;
+              while (*q != '\0' && isdigit ((unsigned char) *q))
+                {
+                  info.prec = info.prec * 10 + (*q - '0');
+                  if (si < 70)
+                    spec_text[si++] = *q;
+                  q++;
+                }
+            }
+        }
+
+      /* Vector modifier, longest match first.  */
+      mbit = vecpf_compat_match_modifier (q, &mlen);
+      if (mlen > 0)
+        {
+          char vbuf[VECPF_COMPAT_VEC_BYTES];
+
+          conv = q[mlen];
+          handler = vecpf_compat_find_spec (conv);
+          memset (vbuf, 0, sizeof (vbuf));
+
+          if (vecpf_compat_type_fn != NULL)
+            vecpf_compat_type_fn (vbuf, &ap);   /* Advances ap.  */
+
+          if (handler != NULL)
+            {
+              info.spec = (wchar_t) conv;
+              info.user |= mbit;
+              vecpf_compat_run_handler (handler, &info, vbuf);
+            }
+          else
+            {
+              /* Modifier matched but that conversion is not registered:
+                 emit the specifier verbatim rather than losing it.  */
+              vecpf_compat_put (p, (size_t) (q + mlen + 1 - p));
+            }
+
+          p = q + mlen + 1;
+          continue;
+        }
+
+      /* Standard length modifiers.  */
+      if (q[0] == 'h' && q[1] == 'h')
+        {
+          lm = VECPF_LM_HH;
+          if (si < 74) { spec_text[si++] = 'h'; spec_text[si++] = 'h'; }
+          q += 2;
+        }
+      else if (q[0] == 'l' && q[1] == 'l')
+        {
+          lm = VECPF_LM_LL;
+          if (si < 74) { spec_text[si++] = 'l'; spec_text[si++] = 'l'; }
+          q += 2;
+        }
+      else if (*q == 'h')       { lm = VECPF_LM_H;     if (si < 75) spec_text[si++] = *q; q++; }
+      else if (*q == 'l')       { lm = VECPF_LM_L;     if (si < 75) spec_text[si++] = *q; q++; }
+      else if (*q == 'z')       { lm = VECPF_LM_Z;     if (si < 75) spec_text[si++] = *q; q++; }
+      else if (*q == 'j')       { lm = VECPF_LM_J;     if (si < 75) spec_text[si++] = *q; q++; }
+      else if (*q == 't')       { lm = VECPF_LM_T;     if (si < 75) spec_text[si++] = *q; q++; }
+      else if (*q == 'L')       { lm = VECPF_LM_BIG_L; if (si < 75) spec_text[si++] = *q; q++; }
+
+      /* Everything else goes to the host printf, one argument at a time.  */
+      conv = *q;
+      if (si < 79)
+        spec_text[si++] = conv;
+      spec_text[si] = '\0';
+
+      {
+        char tmp[1024];
+        int tn = -1;
+
+        switch (conv)
+          {
+          case 'd':
+          case 'i':
+            if (lm == VECPF_LM_LL)          tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, long long));
+            else if (lm == VECPF_LM_L)      tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, long));
+            else if (lm == VECPF_LM_Z)      tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, long));
+            else if (lm == VECPF_LM_J)      tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, intmax_t));
+            else if (lm == VECPF_LM_T)      tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, ptrdiff_t));
+            else                            tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, int));
+            break;
+
+          case 'o':
+          case 'u':
+          case 'x':
+          case 'X':
+            if (lm == VECPF_LM_LL)          tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, unsigned long long));
+            else if (lm == VECPF_LM_L)      tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, unsigned long));
+            else if (lm == VECPF_LM_Z)      tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, size_t));
+            else if (lm == VECPF_LM_J)      tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, uintmax_t));
+            else if (lm == VECPF_LM_T)      tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, size_t));
+            else                            tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, unsigned int));
+            break;
+
+          case 'f': case 'F': case 'e': case 'E': case 'g': case 'G':
+          case 'a': case 'A':
+            if (lm == VECPF_LM_BIG_L)       tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, long double));
+            else                            tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, double));
+            break;
+
+          case 'c':
+            tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, int));
+            break;
+
+          case 's':
+            if (lm == VECPF_LM_L)           tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, wchar_t *));
+            else                            tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, char *));
+            break;
+
+          case 'p':
+            tn = snprintf (tmp, sizeof (tmp), spec_text, va_arg (ap, void *));
+            break;
+
+          case 'n':
+            *(va_arg (ap, int *)) = (int) vecpf_compat_len;
+            break;
+
+          default:
+            /* Unknown conversion: emit verbatim.  The argument (if any)
+               cannot be consumed safely, so the rest of the call is
+               undefined - documented limitation.  */
+            vecpf_compat_put (p, (size_t) (q + 1 - p));
+            break;
+          }
+
+        if (tn >= 0)
+          vecpf_compat_put (tmp, (size_t) (tn < (int) sizeof (tmp)
+                                           ? tn : (int) sizeof (tmp) - 1));
+      }
+
+      p = q + 1;
+    }
+}
+
+/* -------------------------------------------------------------------------
+ * 5. Public entry points (the OHOS/musl replacement for the transparent hook).
+ * ------------------------------------------------------------------------- */
+
+/* Capture the engine's FILE* writes; fp == NULL means "into the buffer".  */
+static int
+vecpf_compat_fprintf (FILE *fp, const char *fmt, ...)
+{
+  char tmp[1024];
+  va_list ap;
+  int n;
+
+  va_start (ap, fmt);
+
+  if (fp != NULL)
+    {
+      n = vfprintf (fp, fmt, ap);
+      va_end (ap);
+      return n;
+    }
+
+  n = vsnprintf (tmp, sizeof (tmp), fmt, ap);
+
+  if (n < 0)
+    {
+      va_end (ap);
+      return n;
+    }
+
+  if ((size_t) n < sizeof (tmp))
+    {
+      /* The common case: it fit.  */
+      vecpf_compat_put (tmp, (size_t) n);
+      va_end (ap);
+      return n;
+    }
+
+  /* Wider than the stack buffer (e.g. a large field width such as "%2000vlu"
+     for the outer conversion): redo it into an exactly-sized buffer so the
+     output is not silently truncated.  */
+  {
+    char *big = (char *) malloc ((size_t) n + 1);
+
+    if (big != NULL)
+      {
+        va_list ap2;
+        va_copy (ap2, ap);
+        vsnprintf (big, (size_t) n + 1, fmt, ap2);
+        va_end (ap2);
+        vecpf_compat_put (big, (size_t) n);
+        free (big);
+      }
+  }
+
+  va_end (ap);
+  return n;
+}
+
+static int
+vecpf_compat_fputs (const char *s, FILE *fp)
+{
+  if (fp != NULL)
+    return fputs (s, fp);
+
+  vecpf_compat_put (s, strlen (s));
+  return 0;
+}
+
+char *
+vecpf_vasprintf (const char *fmt, va_list ap)
+{
+  vecpf_compat_reset ();        /* drop anything left over by a failed call */
+  vecpf_compat_vformat (fmt, ap);
+  return vecpf_compat_take ();
+}
+
+char *
+vecpf_asprintf (const char *fmt, ...)
+{
+  va_list ap;
+  char *r;
+
+  va_start (ap, fmt);
+  r = vecpf_vasprintf (fmt, ap);
+  va_end (ap);
+  return r;
+}
+
+/* Same semantics as sprintf(): writes into dst and returns the number of
+   bytes written, excluding the terminating NUL.  The result may contain
+   embedded NULs (the 'c' conversion uses a NUL separator), so the length
+   return value - not strlen() - is authoritative.  */
+int
+vecpf_vsprintf (char *dst, const char *fmt, va_list ap)
+{
+  size_t n;
+
+  vecpf_compat_reset ();
+  vecpf_compat_vformat (fmt, ap);
+
+  n = vecpf_compat_len;
+  if (vecpf_compat_buf != NULL)
+    memcpy (dst, vecpf_compat_buf, n);
+  dst[n] = '\0';
+
+  vecpf_compat_reset ();        /* frees the scratch buffer */
+  return (int) n;
+}
+
+int
+vecpf_sprintf (char *dst, const char *fmt, ...)
+{
+  va_list ap;
+  int n;
+
+  va_start (ap, fmt);
+  n = vecpf_vsprintf (dst, fmt, ap);
+  va_end (ap);
+  return n;
+}
+
+int
+vecpf_fprintf (FILE *fp, const char *fmt, ...)
+{
+  va_list ap;
+  char *s;
+  int n;
+
+  va_start (ap, fmt);
+  s = vecpf_vasprintf (fmt, ap);
+  va_end (ap);
+
+  fputs (s, fp);
+  n = (int) strlen (s);
+  free (s);
+  return n;
+}
+
+int
+vecpf_printf (const char *fmt, ...)
+{
+  va_list ap;
+  char *s;
+  int n;
+
+  va_start (ap, fmt);
+  s = vecpf_vasprintf (fmt, ap);
+  va_end (ap);
+
+  fputs (s, stdout);
+  n = (int) strlen (s);
+  free (s);
+  return n;
+}
+
+/* -------------------------------------------------------------------------
+ * 6. Route the engine's own output to the sink above.
+ *
+ *    vec_printf_d() / vec_printf_f() emit through fprintf()/fputs().  On this
+ *    platform there is no usable in-memory FILE* (open_memstream()/fmemopen()
+ *    silently capture nothing, tmpfile() returns NULL), so redirect those two
+ *    calls for the remainder of vecpf.c.  The wrappers above are already
+ *    defined at this point, so they still bind to the real functions.
+ * ------------------------------------------------------------------------- */
+
+#define fprintf vecpf_compat_fprintf
+#define fputs   vecpf_compat_fputs
+
+#endif /* VECPF_OHOS_COMPAT_H */
