 #include <asm/types.h>
+/*
+ * OHOS SDK kernel UAPI headers typedef a plain `struct sockaddr_storage`
+ * (linux/socket.h) that collides with the musl libc definition already
+ * seen by this translation unit (knowledge base E091).  Rename the
+ * kernel-side typedef for the duration of the kernel include.  On glibc
+ * the kernel header does not declare it, making this a harmless no-op,
+ * so the guard is unconditional on purpose: patches in this repository
+ * must not branch on platform macros (rule R8).
+ */
+#define sockaddr_storage __linux_sockaddr_storage
 #include <linux/netlink.h>
+#undef sockaddr_storage
 #include <linux/rtnetlink.h>
 #include <unistd.h>
 #include <sys/user.h>
