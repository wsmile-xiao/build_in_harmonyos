--- a/test/config/config-diff.sh	2026-06-16 17:43:35.000000000 +0800
+++ b/test/config/config-diff.sh	2026-10-09 21:12:36.924185937 +0800
@@ -1,5 +1,6 @@
-#!/bin/bash -e
+#!/usr/bin/env bash
 # SPDX-License-Identifier: LGPL-2.1-or-later
+set -e
 
 positional_args=()
 sysfs_tar=""
@@ -35,7 +36,16 @@
 
    rm -rf "${sysfs_path}"
    mkdir "${sysfs_path}"
-   tar -x -f "${sysfs_tar}" -C "${sysfs_path}"
+
+   # toybox tar cannot reproduce the self-referential hardlink entries
+   # (X link to X) used by the sysfs snapshot tarballs: it unlinks the
+   # target before linking and fails with ENOENT. Extract with -k so
+   # the regular files extracted first are kept, and treat the
+   # resulting non-zero status as success as long as the sysfs tree
+   # is present.
+   if ! tar -xk -f "${sysfs_tar}" -C "${sysfs_path}" 2>/dev/null; then
+       [ -d "${sysfs_path}/sys" ] || exit 1
+   fi
 fi
 
 output="${build_dir}"/$(basename "${expected_output}")
