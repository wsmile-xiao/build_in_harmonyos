--- a/test/sysfs/tree-diff.sh	2026-06-16 17:43:35.000000000 +0800
+++ b/test/sysfs/tree-diff.sh	2026-10-09 21:12:36.924185937 +0800
@@ -1,5 +1,6 @@
-#!/bin/bash -e
+#!/usr/bin/env bash
 # SPDX-License-Identifier: LGPL-2.1-or-later
+set -e
 
 BUILD_DIR=$1
 TREE_DUMP=$2
@@ -12,7 +13,15 @@
 
 rm -rf "${TEST_DIR}"
 mkdir "${TEST_DIR}"
-tar -x -f "${SYSFS_INPUT}" -C "${TEST_DIR}"
+
+# toybox tar cannot reproduce the self-referential hardlink entries
+# (X link to X) used by the sysfs snapshot tarballs: it unlinks the
+# target before linking and fails with ENOENT. Extract with -k so the
+# regular files extracted first are kept, and treat the resulting
+# non-zero status as success as long as the sysfs tree is present.
+if ! tar -xk -f "${SYSFS_INPUT}" -C "${TEST_DIR}" 2>/dev/null; then
+    [ -d "${TEST_DIR}/sys" ] || exit 1
+fi
 
 LIBNVME_SYSFS_PATH="${TEST_DIR}" \
 LIBNVME_HOSTNQN=nqn.2014-08.org.nvmexpress:uuid:ce4fee3e-c02c-11ee-8442-830d068a36c6 \
