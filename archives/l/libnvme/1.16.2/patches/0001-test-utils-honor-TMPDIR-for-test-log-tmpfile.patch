 #include <err.h>
+#include <limits.h>
+#include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 #include <unistd.h>
 
 #include "utils.h"
 
 FILE *test_setup_log(void)
 {
+	const char *tmpdir;
+	char path[PATH_MAX];
+	int fd_num;
 	FILE *fd;
 
-	fd = tmpfile();
+	/*
+	 * tmpfile() always creates the file in the hardcoded /tmp
+	 * directory and fails with EACCES on platforms where /tmp is
+	 * read-only (e.g. OpenHarmony EROFS). Create the log file
+	 * below $TMPDIR instead, keeping the tmpfile() semantics:
+	 * the file is unlinked immediately and the stream is
+	 * read/write.
+	 */
+	tmpdir = getenv("TMPDIR");
+	if (!tmpdir || !*tmpdir)
+		tmpdir = "/tmp";
+
+	if (snprintf(path, sizeof(path), "%s/libnvme-test-log-XXXXXX",
+		     tmpdir) >= (int)sizeof(path))
+		err(EXIT_FAILURE, "temporary file path too long");
+
+	fd_num = mkstemp(path);
+	if (fd_num < 0)
+		err(EXIT_FAILURE, "can't create temporary file for log buf");
+
+	/* Best effort: keep the tmpfile() auto-delete semantics, but do
+	 * not abort the test if the platform cannot unlink an open file. */
+	if (unlink(path))
+		printf("warning: can't unlink temporary file %s\n", path);
+
+	fd = fdopen(fd_num, "w+");
 	if (!fd)
 		err(EXIT_FAILURE, "can't create temporary file for log buf");
 
