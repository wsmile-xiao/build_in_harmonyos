diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,6 +1,17 @@
 cmake_minimum_required(VERSION 3.10)
 project(libde265 VERSION 1.0.18)
 
+# Check for ARM64 architecture
+# ARM assembly code in this project is written for ARM32 (armv7-a)
+# and is not compatible with ARM64 (aarch64)
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
+  set(HAVE_ARM64 1)
+  message(STATUS "ARM64 platform detected - disabling ARM assembly optimization")
+else()
+  set(HAVE_ARM64 0)
+endif()
+
+# Disable ARM assembly on ARM64 platforms
+if(HAVE_ARM64)
+  set(ENABLE_ARM FALSE)
+endif()
+
 # Options
 option(ENABLE_ARM "Enable ARM assembly optimizations" ON)
 option(ENABLE_SSE "Enable SSE optimizations" ON)