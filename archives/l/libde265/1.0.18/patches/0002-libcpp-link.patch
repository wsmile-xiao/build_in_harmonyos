diff --git a/dec265/CMakeLists.txt b/dec265/CMakeLists.txt
--- a/dec265/CMakeLists.txt
+++ b/dec265/CMakeLists.txt
@@ -1,6 +1,18 @@
 add_executable(dec265 dec265.cc hdr2png.cc)
 
+# Check for libc++ standard library
+# When using libc++ (common on musl-based systems), we need to explicitly
+# link the C++ standard library. Otherwise, dec265 will fail to run with
+# "symbol not found" errors.
+check_cxx_symbol_exists(__cxa_demangle cxxabi.h HAVE_LIBCPP)
+
+if(HAVE_LIBCPP)
+  message(STATUS "libc++ detected - linking c++ standard library")
+  target_link_libraries(dec265 PRIVATE c++)
+else()
+  message(STATUS "libstdc++ detected - linking stdc++ standard library")
+  target_link_libraries(dec265 PRIVATE stdc++)
+endif()
+
 # Link against libde265
 target_link_libraries(dec265 PRIVATE libde265)
 
 # Install dec265 executable