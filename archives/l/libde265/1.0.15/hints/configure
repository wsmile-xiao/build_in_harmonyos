#!/bin/sh
# hints/configure — libde265 CMake wrapper for G0 clean-verify
#
# libde265 uses CMake, not autotools. This script wraps cmake to satisfy
# ohc-run.py clean-verify's ./configure expectation.
#
# Usage: ./configure --prefix=$PREFIX [options...]
#
# Options from manifest configure_options are already in cmake -D format,
# so we just pass them directly.

set -e

# Parse --prefix and other options
PREFIX=""
CMAKE_OPTS=""
while [ $# -gt 0 ]; do
    case "$1" in
        --prefix=*)
            PREFIX="${1#--prefix=}"
            ;;
        --prefix)
            PREFIX="$2"
            shift
            ;;
        -DCMAKE_*|-D*)
            # Already in cmake -D format, pass directly
            CMAKE_OPTS="$CMAKE_OPTS $1"
            ;;
        -*)
            # Convert other --options to -D
            opt="${1#--}"
            CMAKE_OPTS="$CMAKE_OPTS -D${opt}"
            ;;
        *)
            ;;
    esac
    shift
done

# Set default prefix if not provided
if [ -z "$PREFIX" ]; then
    PREFIX="$HOME/usr/local"
fi

# Ensure LD_LIBRARY_PATH is set for lld linker
if [ -z "$LD_LIBRARY_PATH" ] || ! echo "$LD_LIBRARY_PATH" | grep -q "ohos-sdk"; then
    export LD_LIBRARY_PATH="/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib:/storage/Users/currentUser/usr/local/lib:${LD_LIBRARY_PATH:-}"
fi

# Create build directory
BUILD_DIR="${TMPDIR:-$HOME/tmp}/libde265-cmake-build"
mkdir -p "$BUILD_DIR"

echo "Running cmake with:"
echo "  PREFIX: $PREFIX"
echo "  BUILD_DIR: $BUILD_DIR"
echo "  OPTIONS: $CMAKE_OPTS"

# Run cmake
cmake "$(pwd)" \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    "$CMAKE_OPTS" \
    -B "$BUILD_DIR"

# Copy Makefile to source directory for make to find it
# (clean-verify expects make to run in src dir, but cmake generates in build dir)
cp "$BUILD_DIR/Makefile" ./Makefile 2>/dev/null || true

# Store build dir for make to use
echo "$BUILD_DIR" > .cmake-build-dir

echo "✅ cmake configure completed"
echo "   Build directory: $BUILD_DIR"
echo "   Install prefix: $PREFIX"
