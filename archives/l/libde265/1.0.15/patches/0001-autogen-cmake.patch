 fi
 
-LIBTOOLIZE=libtoolize
-SYSNAME=`uname`
-if [ "x$SYSNAME" = "xDarwin" ] ; then
-  LIBTOOLIZE=glibtoolize
+# Create configure wrapper script (for clean_verify.py)
+cat > configure << 'CONFIGURE_EOF'
+#!/bin/sh
+# CMake configure wrapper for G0 clean-verify (E092)
+SDK_LLVM_LIB="/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib"
+if [ -d "$SDK_LLVM_LIB" ]; then
+    export LD_LIBRARY_PATH="$SDK_LLVM_LIB:${LD_LIBRARY_PATH:-}"
 fi
-aclocal -I m4 && \
-	autoheader && \
-	$LIBTOOLIZE && \
-	autoconf && \
-	automake --add-missing --force-missing --copy
+PREFIX=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*) PREFIX="${1#--prefix=}" ;;
+        *) ;;
+    esac
+    shift
+done
+[ -z "$PREFIX" ] && PREFIX="$HOME/usr/local"
+TOOLCHAIN_FILE="toolchain-ohos.cmake"
+cat > "$TOOLCHAIN_FILE" << 'EOF'
+set(CMAKE_SYSTEM_NAME Linux)
+set(CMAKE_SYSTEM_PROCESSOR aarch64)
+set(CMAKE_C_COMPILER clang)
+set(CMAKE_CXX_COMPILER clang++)
+set(CMAKE_C_COMPILER_WORKS TRUE)
+set(CMAKE_CXX_COMPILER_WORKS TRUE)
+EOF
+cmake . -G "Unix Makefiles" -DCMAKE_TOOLCHAIN_FILE="$TOOLCHAIN_FILE" -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5
+[ $? -ne 0 ] && exit 1
+exit 0
+CONFIGURE_EOF
+
+chmod +x configure
+echo "Created configure wrapper for CMake build"
+exit 0