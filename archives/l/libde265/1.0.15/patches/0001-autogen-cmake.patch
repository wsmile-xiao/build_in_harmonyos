-if [ -x "`which autoreconf 2>/dev/null`" ] ; then
-   exec autoreconf -ivf
+# HarmonyOS CMake wrapper - create configure script for G0 verification
+SDK_LLVM_LIB="/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib"
