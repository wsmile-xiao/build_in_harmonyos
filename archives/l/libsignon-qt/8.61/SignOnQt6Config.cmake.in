@PACKAGE_INIT@

# SignOnQt6 — CMake package for libsignon-qt (Qt6 flavour of the Single Sign On
# client library). Mirrors upstream SignOnQt5Config.cmake.in, which exposes the
# legacy SIGNONQT_* variables that kaccounts-integration consumes.

include(CMakeFindDependencyMacro)
if(NOT TARGET Qt6::Core)
    # Consumers of the Qt6 packages in this repository set Qt6_DIR explicitly
    # (the conan qtbase package ships Qt's own Qt6Config.cmake).
    find_dependency(Qt6 COMPONENTS Core DBus)
endif()

set(SIGNONQT_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include/signon-qt6")

# Static package (conan default here); fall back to the shared library when the
# package was built with -o libsignon-qt/*:shared=True.
set(SIGNONQT_LIBRARIES "${PACKAGE_PREFIX_DIR}/lib/libsignon-qt6.a")
if(NOT EXISTS "${SIGNONQT_LIBRARIES}")
    set(SIGNONQT_LIBRARIES "${PACKAGE_PREFIX_DIR}/lib/libsignon-qt6.so")
endif()
set(SIGNONQT_LIBRARIES_STATIC "${SIGNONQT_LIBRARIES}")

include("${CMAKE_CURRENT_LIST_DIR}/SignOnQt6Targets.cmake")

check_required_components(SignOnQt6)
