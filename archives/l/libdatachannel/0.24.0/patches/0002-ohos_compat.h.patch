diff -ruN a/ohos_compat.h b/ohos_compat.h
--- a/ohos_compat.h
+++ b/ohos_compat.h
@@ -0,0 +1,56 @@
+/* OpenHarmony compatibility header for BSD-style types and macros */
+#ifndef __OHOS_COMPAT_H__
+#define __OHOS_COMPAT_H__
+
+#include <sys/time.h>
+#include <string.h>
+
+#if !defined(__FreeBSD__) && !defined(__NetBSD__) && !defined(__OpenBSD__) && !defined(__DragonFly__) && !defined(__APPLE__) && !defined(_WIN32)
+
+/* BSD-style types */
+typedef unsigned int u_int;
+typedef unsigned long u_long;
+typedef unsigned short u_short;
+typedef unsigned char u_char;
+typedef char *caddr_t;
+
+/* Network constants */
+#ifndef IFNAMSIZ
+#define IFNAMSIZ 16
+#endif
+
+/* timeval macros (BSD) */
+#ifndef timercmp
+#define timercmp(tvp, uvp, cmp)                          \
+  (((tvp)->tv_sec == (uvp)->tv_sec) ?                    \
+   ((tvp)->tv_usec cmp (uvp)->tv_usec) :                 \
+   ((tvp)->tv_sec cmp (uvp)->tv_sec))
+#endif
+
+#ifndef timeradd
+#define timeradd(tvp, uvp, vvp)                          \
+  do {                                                    \
+    (vvp)->tv_sec = (tvp)->tv_sec + (uvp)->tv_sec;        \
+    (vvp)->tv_usec = (tvp)->tv_usec + (uvp)->tv_usec;    \
+    if ((vvp)->tv_usec >= 1000000) {                      \
+      (vvp)->tv_sec++;                                    \
+      (vvp)->tv_usec -= 1000000;                          \
+    }                                                     \
+  } while (0)
+#endif
+
+#ifndef timersub
+#define timersub(tvp, uvp, vvp)                          \
+  do {                                                    \
+    (vvp)->tv_sec = (tvp)->tv_sec - (uvp)->tv_sec;        \
+    (vvp)->tv_usec = (tvp)->tv_usec - (uvp)->tv_usec;    \
+    if ((vvp)->tv_usec < 0) {                             \
+      (vvp)->tv_sec--;                                    \
+      (vvp)->tv_usec += 1000000;                          \
+    }                                                     \
+  } while (0)
+#endif
+
+#endif /* BSD compat */
+
+#endif /* __OHOS_COMPAT_H__ */
