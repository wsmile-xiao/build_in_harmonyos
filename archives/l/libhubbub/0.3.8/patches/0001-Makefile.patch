--- a/Makefile
+++ b/Makefile
@@ -1,80 +1,200 @@
 #!/bin/make
 #
-# Makefile for libhubbub
+# Standalone Makefile for libhubbub 0.3.8 (adapted for HarmonyOS/OpenHarmony)
+#
+# Original NetSurf build system replaced with standalone build because
+# netsurf-buildsystem package is not available on this platform.
 #
 # Copyright 2009-2020 John-Mark Bell <jmb@netsurf-browser.org>
 
 # Component settings
 COMPONENT := hubbub
 COMPONENT_VERSION := 0.3.8
-# Default to a static library
-COMPONENT_TYPE ?= lib-static
-
-# Setup the tooling
-PREFIX ?= /opt/netsurf
-NSSHARED ?= $(PREFIX)/share/netsurf-buildsystem
-include $(NSSHARED)/makefiles/Makefile.tools
-
-TESTRUNNER := $(PERL) $(NSTESTTOOLS)/testrunner.pl
-
-# Toolchain flags
+
+# Installation paths
+PREFIX ?= /storage/Users/currentUser/usr/local
+LIBDIR ?= lib
+INCLUDEDIR ?= include
+
+# Source files
+SRCDIR := src
+INCDIR := include
+SRC := $(SRCDIR)/parser.c \
+	$(SRCDIR)/charset/detect.c \
+	$(SRCDIR)/tokeniser/entities.c $(SRCDIR)/tokeniser/tokeniser.c \
+	$(SRCDIR)/treebuilder/treebuilder.c \
+	$(SRCDIR)/treebuilder/initial.c $(SRCDIR)/treebuilder/before_html.c \
+	$(SRCDIR)/treebuilder/before_head.c $(SRCDIR)/treebuilder/in_head.c \
+	$(SRCDIR)/treebuilder/in_head_noscript.c $(SRCDIR)/treebuilder/after_head.c \
+	$(SRCDIR)/treebuilder/in_body.c $(SRCDIR)/treebuilder/in_table.c \
+	$(SRCDIR)/treebuilder/in_caption.c $(SRCDIR)/treebuilder/in_column_group.c \
+	$(SRCDIR)/treebuilder/in_table_body.c $(SRCDIR)/treebuilder/in_row.c \
+	$(SRCDIR)/treebuilder/in_cell.c $(SRCDIR)/treebuilder/in_select.c \
+	$(SRCDIR)/treebuilder/in_select_in_table.c \
+	$(SRCDIR)/treebuilder/in_foreign_content.c $(SRCDIR)/treebuilder/after_body.c \
+	$(SRCDIR)/treebuilder/in_frameset.c $(SRCDIR)/treebuilder/after_frameset.c \
+	$(SRCDIR)/treebuilder/after_after_body.c $(SRCDIR)/treebuilder/after_after_frameset.c \
+	$(SRCDIR)/treebuilder/generic_rcdata.c $(SRCDIR)/treebuilder/element-type.c \
+	$(SRCDIR)/utils/errors.c $(SRCDIR)/utils/string.c
+OBJ := $(SRC:.c=.o)
+LIB := lib$(COMPONENT).a
+PC_IN := lib$(COMPONENT).pc.in
+PC := lib$(COMPONENT).pc
+
+# Generated files
+ENTITIES_INC := $(SRCDIR)/tokeniser/entities.inc
+ELEMENT_TYPE_INC := $(SRCDIR)/treebuilder/autogenerated-element-type.c
+
+# libparserutils dependency (headers at compile time, -lparserutils at link time)
+PARSERUTILS_CFLAGS ?= -I$(PREFIX)/include
+PARSERUTILS_LIBS ?= -L$(PREFIX)/lib -lparserutils
+
+# Compiler settings
+CC = clang
+AR = llvm-ar
+RANLIB = llvm-ranlib
+CFLAGS ?= -fPIC -O2
+
+# Our own compile flags (adapted from original NetSurf Makefile)
+# Note: removed -Werror for HarmonyOS compatibility (clang 15 may emit
+# warnings that differ from GCC's)
 WARNFLAGS := -Wall -W -Wundef -Wpointer-arith -Wcast-align \
 	-Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes \
-	-Wmissing-declarations -Wnested-externs -pedantic
-# BeOS/Haiku/AmigaOS have standard library errors that issue warnings.
-ifneq ($(BUILD),i586-pc-haiku)
-  ifneq ($(findstring amigaos,$(BUILD)),amigaos)
-    WARNFLAGS := $(WARNFLAGS) -Werror
-  endif
-endif
-
-CFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE \
-	 -I$(CURDIR)/include/ -I$(CURDIR)/src \
+	-Wmissing-declarations -Wnested-externs -Wno-error
+
+COMPILE_CFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE -std=c99 \
+	-I$(CURDIR)/include/ -I$(CURDIR)/src/ $(PARSERUTILS_CFLAGS) \
 	$(WARNFLAGS) $(CFLAGS)
-ifneq ($(GCCVER),2)
-  CFLAGS := $(CFLAGS) -std=c99
-else
-  # __inline__ is a GCCism
-  CFLAGS := $(CFLAGS) -Dinline="__inline__"
-endif
-
-# Parserutils
-ifneq ($(findstring clean,$(MAKECMDGOALS)),clean)
-  ifneq ($(PKGCONFIG),)
-    CFLAGS := $(CFLAGS) $(shell $(PKGCONFIG) libparserutils --cflags)
-    LDFLAGS := $(LDFLAGS) $(shell $(PKGCONFIG) libparserutils --libs)
-  else
-    CFLAGS := $(CFLAGS) -I$(PREFIX)/include
-    LDFLAGS := $(LDFLAGS) -lparserutils
-  endif
-endif
-
-include $(NSBUILD)/Makefile.top
-
-ifeq ($(WANT_TEST),yes)
-  # We require the presence of libjson -- http://oss.metaparadigm.com/json-c/
-  ifneq ($(PKGCONFIG),)
-    TESTCFLAGS := $(TESTCFLAGS) \
-		$(shell $(PKGCONFIG) $(PKGCONFIGFLAGS) --cflags json-c)
-    TESTLDFLAGS := $(TESTLDFLAGS) \
-		$(shell $(PKGCONFIG) $(PKGCONFIGFLAGS) --libs json-c)
-  else
-    TESTCFLAGS := $(TESTCFLAGS) -I$(PREFIX)/include/json-c
-    TESTLDFLAGS := $(TESTLDFLAGS) -ljson-c
-  endif
-
-  ifneq ($(GCCVER),2)
-    TESTCFLAGS := $(TESTCFLAGS) -Wno-unused-parameter
-  endif
-endif
-
-# Extra installation rules
-I := /$(INCLUDEDIR)/hubbub
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/hubbub/errors.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/hubbub/functypes.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/hubbub/hubbub.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/hubbub/parser.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/hubbub/tree.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/hubbub/types.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) /$(LIBDIR)/pkgconfig:lib$(COMPONENT).pc.in
-INSTALL_ITEMS := $(INSTALL_ITEMS) /$(LIBDIR):$(OUTPUT)
+
+# Targets
+.PHONY: all clean install uninstall test
+
+all: $(LIB) $(PC)
+
+$(ENTITIES_INC): build/make-entities.pl build/Entities
+	perl build/make-entities.pl
+
+$(ELEMENT_TYPE_INC): $(SRCDIR)/treebuilder/element-type.gperf
+	gperf --output-file=$@.tmp $<
+	sed -e 's/^\(const struct element_type_map\)/static \1/' $@.tmp > $@
+	rm -f $@.tmp
+
+$(SRCDIR)/tokeniser/entities.o: $(SRCDIR)/tokeniser/entities.c $(ENTITIES_INC)
+$(SRCDIR)/treebuilder/element-type.o: $(SRCDIR)/treebuilder/element-type.c $(ELEMENT_TYPE_INC)
+
+%.o: %.c
+	$(CC) $(COMPILE_CFLAGS) -c -o $@ $<
+
+$(LIB): $(OBJ)
+	$(AR) rcs $@ $(OBJ)
+	$(RANLIB) $@
+
+$(PC): $(PC_IN)
+	sed -e 's|PREFIX|$(PREFIX)|g' \
+	    -e 's|LIBDIR|$(LIBDIR)|g' \
+	    -e 's|INCLUDEDIR|$(INCLUDEDIR)|g' \
+	    -e 's|VERSION|$(COMPONENT_VERSION)|g' \
+	    $(PC_IN) > $(PC)
+
+clean:
+	rm -f $(OBJ) $(LIB) $(PC) $(ENTITIES_INC) $(ELEMENT_TYPE_INC)
+	rm -rf build/test-bin
+
+install: all
+	mkdir -p $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig
+	mkdir -p $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/hubbub
+	# Regenerate .pc with the final PREFIX so the installed pc is correct
+	sed -e 's|PREFIX|$(PREFIX)|g' \
+	    -e 's|LIBDIR|$(LIBDIR)|g' \
+	    -e 's|INCLUDEDIR|$(INCLUDEDIR)|g' \
+	    -e 's|VERSION|$(COMPONENT_VERSION)|g' \
+	    $(PC_IN) > $(PC)
+	cp $(LIB) $(DESTDIR)$(PREFIX)/$(LIBDIR)/
+	cp $(PC) $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/
+	cp $(INCDIR)/hubbub/errors.h $(INCDIR)/hubbub/functypes.h \
+	   $(INCDIR)/hubbub/hubbub.h $(INCDIR)/hubbub/parser.h \
+	   $(INCDIR)/hubbub/tree.h $(INCDIR)/hubbub/types.h \
+	   $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/hubbub/
+
+uninstall:
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/$(LIB)
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/$(PC)
+	rm -rf $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/hubbub
+
+# ----------------------------------------------------------------------
+# Test targets
+#
+# The upstream NetSurf test system (testrunner.pl, part of
+# netsurf-buildsystem) is not available on this platform, so the test
+# binaries are built directly and executed here. Each test binary prints
+# "PASS" (or "FAIL") as its final line.
+#
+# tokeniser2/tokeniser3 require json-c which is not available on this
+# platform, so they are not built.
+#
+# Link with lld (default ld is GNU bfd whose output is refused execution
+# in the OHOS sandbox, exit 126). lld needs the SDK's libxml2 at link
+# time, so LD_LIBRARY_PATH is set accordingly.
+# ----------------------------------------------------------------------
+
+TESTDIR := build/test-bin
+TESTCFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE -std=c99 \
+	-I$(CURDIR)/include/ -I$(CURDIR)/src/ -I$(CURDIR)/test/ \
+	$(PARSERUTILS_CFLAGS)
+SDK_LLVM_LIB := /data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib
+LDLINK := LD_LIBRARY_PATH=$(SDK_LLVM_LIB) $(CC)
+
+TEST_BINS := entities csdetect parser tokeniser tree tree2 tree-buf
+
+HTML_DATA := $(sort $(wildcard test/data/html/*.html test/data/html/*.jsp))
+CSDETECT_DATA := $(sort $(wildcard test/data/csdetect/*.dat))
+TREECONSTR_DATA := $(sort $(wildcard test/data/tree-construction/*.dat))
+TREECHUNK_DATA := $(sort $(wildcard test/data/tree-chunks/*.dat test/data/tree-chunks/*.html))
+
+$(TESTDIR):
+	mkdir -p $(TESTDIR)
+
+$(TESTDIR)/entities: test/entities.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB) $(PARSERUTILS_LIBS)
+
+$(TESTDIR)/csdetect: test/csdetect.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB) $(PARSERUTILS_LIBS)
+
+$(TESTDIR)/parser: test/parser.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB) $(PARSERUTILS_LIBS)
+
+$(TESTDIR)/tokeniser: test/tokeniser.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB) $(PARSERUTILS_LIBS)
+
+$(TESTDIR)/tree: test/tree.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB) $(PARSERUTILS_LIBS)
+
+$(TESTDIR)/tree2: test/tree2.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB) $(PARSERUTILS_LIBS)
+
+$(TESTDIR)/tree-buf: test/tree-buf.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(LIB) $(PARSERUTILS_LIBS)
+
+test: all $(TEST_BINS:%=$(TESTDIR)/%)
+	@echo "=== Running upstream libhubbub testcases ==="
+	@echo "--- entities ---"
+	@$(TESTDIR)/entities || exit 1
+	@echo "--- csdetect ---"
+	@for f in $(CSDETECT_DATA); do \
+		echo "== $$f"; $(TESTDIR)/csdetect $$f || exit 1; done
+	@echo "--- parser (html) ---"
+	@for f in $(HTML_DATA); do \
+		echo "== $$f"; $(TESTDIR)/parser $$f || exit 1; done
+	@echo "--- tokeniser (html) ---"
+	@for f in $(HTML_DATA); do \
+		echo "== $$f"; $(TESTDIR)/tokeniser $$f || exit 1; done
+	@echo "--- tree (html) ---"
+	@for f in $(HTML_DATA); do \
+		echo "== $$f"; $(TESTDIR)/tree $$f || exit 1; done
+	@echo "--- tree2 (tree-construction) ---"
+	@for f in $(TREECONSTR_DATA); do \
+		echo "== $$f"; $(TESTDIR)/tree2 $$f || exit 1; done
+	@echo "--- tree-buf (tree-chunks) ---"
+	@for f in $(TREECHUNK_DATA); do \
+		echo "== $$f"; $(TESTDIR)/tree-buf $$f || exit 1; done
+	@echo "=== All upstream testcases PASSED ==="
