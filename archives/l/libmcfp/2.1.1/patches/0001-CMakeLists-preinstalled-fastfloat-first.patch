@@ -59,11 +59,19 @@ try_compile(STD_CHARCONV_COMPILING
 
 if(NOT STD_CHARCONV_COMPILING)
     message(NOTICE "mcfp: Using fast_float for std::from_chars")
-    CPMFindPackage(
-        NAME FastFloat
-        GIT_REPOSITORY "https://github.com/fastfloat/fast_float"
-        GIT_TAG v8.0.2
-        EXCLUDE_FROM_ALL YES)
+    # OHOS/offline: use a preinstalled fast_float (e.g. the Conan package) when
+    # one is available, and only fall back to CPM's GitHub download when it is
+    # not.  The upstream CPMFindPackage below would fetch fast_float 8.0.2 from
+    # github.com at configure time, which cannot work on a network-restricted
+    # build worker.
+    find_package(fast_float CONFIG QUIET)
+    if(NOT fast_float_FOUND)
+        CPMFindPackage(
+            NAME FastFloat
+            GIT_REPOSITORY "https://github.com/fastfloat/fast_float"
+            GIT_TAG v8.0.2
+            EXCLUDE_FROM_ALL YES)
+    endif()
 endif()
 
