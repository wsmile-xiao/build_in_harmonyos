-CPMFindPackage(NAME Catch2 GIT_REPOSITORY "https://github.com/catchorg/Catch2" VERSION "3.4.0" EXCLUDE_FROM_ALL YES)
+# OHOS/offline: use a preinstalled Catch2 (e.g. the Conan package) when one is
+# available, and only fall back to CPM's GitHub download when it is not.  The
+# upstream CPMFindPackage below would fetch Catch2 3.4.0 from github.com at
+# configure time, which cannot work on a network-restricted build worker.
+find_package(Catch2 CONFIG QUIET)
+if(NOT Catch2_FOUND)
+    CPMFindPackage(NAME Catch2 GIT_REPOSITORY "https://github.com/catchorg/Catch2" VERSION "3.4.0" EXCLUDE_FROM_ALL YES)
+endif()
 
