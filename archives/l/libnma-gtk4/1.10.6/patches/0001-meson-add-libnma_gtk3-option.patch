diff --git a/meson.build b/meson.build
index 2e1030f..0b537e4 100644
--- a/meson.build
+++ b/meson.build
@@ -156,13 +156,22 @@ m_dep = cc.find_library('m')
 # Check for gtk+
 gtk_req_version = '>= 3.12'
 
-gtk_dep = declare_dependency(
-  dependencies: dependency('gtk+-3.0', version: gtk_req_version),
-  compile_args: [
-    '-DGDK_VERSION_MIN_REQUIRED=GDK_VERSION_3_12',
-    '-DGDK_VERSION_MAX_ALLOWED=GDK_VERSION_3_12'
-  ]
-)
+enable_libnma_gtk3 = get_option('libnma_gtk3')
+if enable_libnma_gtk3
+  gtk_dep = declare_dependency(
+    dependencies: dependency('gtk+-3.0', version: gtk_req_version),
+    compile_args: [
+      '-DGDK_VERSION_MIN_REQUIRED=GDK_VERSION_3_12',
+      '-DGDK_VERSION_MAX_ALLOWED=GDK_VERSION_3_12'
+    ]
+  )
+else
+  # gtk4-variant-only build: the shared sources are gtk3/gtk4
+  # dual-compatible (utils.c and every src/*.c consumer carry
+  # GTK_CHECK_VERSION(4,0,0) branches), so the shared infrastructure
+  # (utils-libnm, gir_sources) compiles against the gtk4 headers.
+  gtk_dep = gtk4_dep
+endif
 
 # API documentation
 nm_req_version = '>= 1.7'
