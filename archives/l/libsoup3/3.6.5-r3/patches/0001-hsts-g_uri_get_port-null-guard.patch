--- a/tests/hsts-test.c
+++ b/tests/hsts-test.c	2026-09-11 14:48:33.405929375 +0800
@@ -150,7 +150,15 @@
 	if (soup_uri_is_http (soup_message_get_uri (msg)))
 		new_uri = soup_uri_copy (soup_message_get_uri (msg), SOUP_URI_PORT, g_uri_get_port (http_uri), SOUP_URI_NONE);
 	else if (soup_uri_is_https (soup_message_get_uri (msg)))
-		new_uri = soup_uri_copy (soup_message_get_uri (msg), SOUP_URI_PORT, g_uri_get_port (https_uri), SOUP_URI_NONE);
+		/* R11 测试迁移（glib 2.84 语义）：当 TLS 后端不可用（OHOS 无
+		 * glib-networking，tls_available=FALSE）时 https_uri 保持 NULL，
+		 * 直接调用 g_uri_get_port(NULL) 触发 GLib-FATAL-CRITICAL
+		 * assertion 'uri != NULL' → SIGTRAP exit 133。按 glib 2.84 语义
+		 * 在调用前判空：uri 有效才取端口，否则保持消息 URI 原样（https
+		 * 请求在无 TLS 后端时本就不会实际发出）。测试语义不变。 */
+		new_uri = https_uri != NULL
+			? soup_uri_copy (soup_message_get_uri (msg), SOUP_URI_PORT, g_uri_get_port (https_uri), SOUP_URI_NONE)
+			: g_uri_ref (soup_message_get_uri (msg));
 	else
 		g_assert_not_reached();
 	soup_message_set_uri (msg, new_uri);
