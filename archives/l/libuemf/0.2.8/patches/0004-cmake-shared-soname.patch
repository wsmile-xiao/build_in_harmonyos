--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -28,6 +28,11 @@
 
 set_target_properties(uemf PROPERTIES VERSION 0.0.3)
 set_target_properties(uemf PROPERTIES SOVERSION 0)
+# OHOS CMake (CMAKE_SYSTEM_NAME=HarmonyOS) ships no platform module, so the
+# VERSION/SOVERSION properties above are ignored and the ELF gets no DT_SONAME.
+# Pass it explicitly; the value equals the real file name, keeping the build
+# tree and the package consistent (L5a).
+set_target_properties(uemf PROPERTIES LINK_FLAGS "-Wl,-soname,libuemf.so")
 target_compile_options(uemf PRIVATE ${FS8})
 
 add_executable(cutemf            cutemf.c            )
