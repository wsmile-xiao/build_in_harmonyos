  */
 int osmo_sockaddr_str_to_in6_addr(const struct osmo_sockaddr_str *sockaddr_str, struct in6_addr *dst)
 {
+	struct in6_addr addr;
 	int rc;
 	if (!sockaddr_str)
 		return -EINVAL;
 	if (!dst)
 		return -ENOSPC;
 	if (sockaddr_str->af != AF_INET6)
 		return -EINVAL;
-	rc = inet_pton(AF_INET6, sockaddr_str->ip, dst);
+	/* Parse into a local variable first: inet_pton() implementations differ in
+	 * whether they leave the output untouched when the string is invalid. */
+	rc = inet_pton(AF_INET6, sockaddr_str->ip, &addr);
 	if (rc != 1)
 		return -EINVAL;
+	*dst = addr;
 	return 0;
 }
 
