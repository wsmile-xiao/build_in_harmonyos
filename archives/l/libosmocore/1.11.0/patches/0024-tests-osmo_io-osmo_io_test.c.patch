+/* Open an unnamed temporary file (as tmpfile() does), but honor $TMPDIR:
+ * tmpfile() is hardcoded to use P_tmpdir (/tmp), which is not writable in
+ * every environment. */
+static FILE *test_tmpfile(void)
+{
+	const char *tmpdir = getenv("TMPDIR");
+	char path[256];
+	int fd;
+
+	if (!tmpdir || !*tmpdir)
+		tmpdir = "/tmp";
+	if (snprintf(path, sizeof(path), "%s/libosmocore-osmo_io-test-XXXXXX", tmpdir) >= (int)sizeof(path))
+		return NULL;
+	fd = mkstemp(path);
+	if (fd < 0)
+		return NULL;
+	unlink(path);
+	return fdopen(fd, "w+");
+}
