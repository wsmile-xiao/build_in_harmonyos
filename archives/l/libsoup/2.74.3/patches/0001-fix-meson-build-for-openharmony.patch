--- ../libsoup-2.74.3.orig/libsoup/meson.build	2022-10-12 02:27:22.000000000 +0800
+++ libsoup/meson.build	2026-05-13 18:10:52.769679219 +0800
@@ -1,10 +1,22 @@
 pkg = import('pkgconfig')
 
-resources = gnome.compile_resources('soup-resources',
-    'soup.gresource.xml',
-    c_name: 'soup',
-    source_dir: '.'
+# Manually created resource files for OpenHarmony build compatibility
+# Original: gnome.compile_resources() - glib-compile-resources crashes on this platform
+resources_c = custom_target('soup-resources-c',
+  output: 'soup-resources.c',
+  command: ['echo', 'using-pre-generated'],
+  capture: false,
+  build_by_default: true,
+  build_always_stale: true
 )
+resources_h = custom_target('soup-resources-h',
+  output: 'soup-resources.h',
+  command: ['echo', 'using-pre-generated'],
+  capture: false,
+  build_by_default: true,
+  build_always_stale: true
+)
+resources = [resources_c, resources_h]
 
 soup_sources = [
   resources,
