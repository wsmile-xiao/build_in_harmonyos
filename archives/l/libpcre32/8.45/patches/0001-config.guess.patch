diff -ruN a/config.guess b/config.guess
--- a/config.guess
+++ b/config.guess
@@ -1,15 +1,30 @@
 #! /bin/sh
 # Attempt to guess a canonical system name.
 #   Copyright 1992-2020 Free Software Foundation, Inc.
 
 timestamp='2020-11-07'
+
+# HarmonyOS/__OHOS__ detection - added for OpenHarmony platform
+# Return aarch64-unknown-linux-ohos for HarmonyOS systems
+case "$(uname -s)" in
+    HarmonyOS)
+        echo "aarch64-unknown-linux-ohos"
+        exit 0
+        ;;
+esac
+
+# Also check for __OHOS__ macro
+if test -f /etc/hmos-release || test -f /etc/ohos-release; then
+    echo "aarch64-unknown-linux-ohos"
+    exit 0
+fi
 
