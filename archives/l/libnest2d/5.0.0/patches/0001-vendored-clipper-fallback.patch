From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NebulaAGI <gyccc@gitcode.com>
Date: Mon, 15 Sep 2026 12:00:00 +0800
Subject: [PATCH] OHOS fallback: vendored polyclipping (Clipper 6.4.2 via pyclipper) when system clipper not found

When cross-building for OHOS, the polyclipping package (Clipper 6.4.2)
is not available in the ohpcd registry. Provide a fallback that
builds the pristine Clipper 6.4.2 source vendored as
external/clipper/polyclipping/clipper.{hpp,cpp} (extracted from
pyclipper 1.3.0.post3) and exposes clipper::clipper target.
Uses BUILD_INTERFACE / INSTALL_INTERFACE to avoid leaking absolute
build paths into INTERFACE_INCLUDE_DIRECTORIES (which CMake verifies
on install/export).

diff --git a/include/libnest2d/backends/clipper/CMakeLists.txt b/include/libnest2d/backends/clipper/CMakeLists.txt
index 1111111..2222222 100644
--- a/include/libnest2d/backends/clipper/CMakeLists.txt
+++ b/include/libnest2d/backends/clipper/CMakeLists.txt
@@ -1,8 +1,46 @@
 add_library(clipperBackend INTERFACE)
 
-find_package(clipper 6.1 REQUIRED)
-target_link_libraries(clipperBackend INTERFACE clipper::clipper)
-
+find_package(clipper 6.1 QUIET)
+if(clipper_FOUND)
+    target_link_libraries(clipperBackend INTERFACE clipper::clipper)
+else()
+    # Vendored fallback for OHOS / environments without polyclipping package.
+    # Source is staged by conanfile.py as external/clipper/polyclipping/clipper.hpp
+    # and external/clipper/clipper.cpp (pristine 6.4.2 from pyclipper 1.3.0.post3).
+    set(_clipper_candidates
+        ${PROJECT_SOURCE_DIR}/external/clipper
+        ${CMAKE_SOURCE_DIR}/external/clipper
+        ${CMAKE_CURRENT_SOURCE_DIR}/../../../external/clipper
+    )
+    set(CLIPPER_VENDORED_DIR "")
+    foreach(_cand IN LISTS _clipper_candidates)
+        if(EXISTS ${_cand}/polyclipping/clipper.hpp AND EXISTS ${_cand}/clipper.cpp)
+            set(CLIPPER_VENDORED_DIR ${_cand})
+            break()
+        endif()
+    endforeach()
+    if(CLIPPER_VENDORED_DIR STREQUAL "")
+        set(CLIPPER_VENDORED_DIR ${PROJECT_SOURCE_DIR}/external/clipper)
+    endif()
+    set(CLIPPER_VENDORED_HDR ${CLIPPER_VENDORED_DIR}/polyclipping/clipper.hpp)
+    set(CLIPPER_VENDORED_SRC ${CLIPPER_VENDORED_DIR}/clipper.cpp)
+    if(EXISTS ${CLIPPER_VENDORED_HDR} AND EXISTS ${CLIPPER_VENDORED_SRC})
+        add_library(polyclipping STATIC ${CLIPPER_VENDORED_SRC})
+        target_include_directories(polyclipping PUBLIC
+            $<BUILD_INTERFACE:${CLIPPER_VENDORED_DIR}>
+            $<BUILD_INTERFACE:${CLIPPER_VENDORED_DIR}/polyclipping>
+            $<INSTALL_INTERFACE:include>
+        )
+        if(NOT TARGET clipper::clipper)
+            add_library(clipper::clipper ALIAS polyclipping)
+        endif()
+        target_link_libraries(clipperBackend INTERFACE clipper::clipper)
+        install(TARGETS polyclipping EXPORT Libnest2DTargets ARCHIVE DESTINATION lib LIBRARY DESTINATION lib INCLUDES DESTINATION include)
+        install(FILES ${CLIPPER_VENDORED_HDR} DESTINATION include/polyclipping)
+    else()
+        message(FATAL_ERROR "Clipper not found and vendored source missing at ${CLIPPER_VENDORED_HDR}. Ensure conan source() staged external/clipper/.")
+    endif()
+endif()
 
 # Clipper backend is not enough on its own, it still need some functions
 # from Boost geometry
