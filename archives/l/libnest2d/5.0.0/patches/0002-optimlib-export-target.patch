From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NebulaAGI <gyccc@gitcode.com>
Date: Mon, 15 Sep 2026 12:00:00 +0800
Subject: [PATCH] Fix optimlibOptimizer missing from Libnest2DTargets export set

Upstream include/libnest2d/optimizers/optimlib/CMakeLists.txt creates
INTERFACE target optimlibOptimizer but never installs it. Top-level
CMakeLists.txt does install(TARGETS libnest2d libnest2d_headeronly ...)
where libnest2d_headeronly links to optimlibOptimizer. CMake export
then fails with:
  install(EXPORT "Libnest2DTargets" ...) includes target
  "libnest2d_headeronly" which requires target "optimlibOptimizer"
  that is not in any export set.
Mirror nlopt optimizer's install rule.

diff --git a/include/libnest2d/optimizers/optimlib/CMakeLists.txt b/include/libnest2d/optimizers/optimlib/CMakeLists.txt
index d33275c..1c69d4b 100644
--- a/include/libnest2d/optimizers/optimlib/CMakeLists.txt
+++ b/include/libnest2d/optimizers/optimlib/CMakeLists.txt
@@ -2,4 +2,6 @@ find_package(Armadillo REQUIRED)
 
 add_library(optimlibOptimizer INTERFACE)
 target_include_directories(optimlibOptimizer INTERFACE ${ARMADILLO_INCLUDE_DIRS})
-target_link_libraries(optimlibOptimizer INTERFACE ${ARMADILLO_LIBRARIES})
\ No newline at end of file
+target_link_libraries(optimlibOptimizer INTERFACE ${ARMADILLO_LIBRARIES})
+
+install(TARGETS optimlibOptimizer EXPORT Libnest2DTargets INCLUDES DESTINATION include)
