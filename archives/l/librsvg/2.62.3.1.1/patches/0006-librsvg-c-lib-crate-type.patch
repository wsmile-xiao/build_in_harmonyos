diff --git a/librsvg-c/Cargo.toml b/librsvg-c/Cargo.toml
index 54116cc..05ca6b6 100644
--- a/librsvg-c/Cargo.toml
+++ b/librsvg-c/Cargo.toml
@@ -9,6 +9,15 @@ repository.workspace = true
 edition.workspace = true
 rust-version.workspace = true
 
+[lib]
+# OHOS patch: cargo-c provides crate-type when it runs (`cargo cbuild --library-type
+# staticlib`).  Declaring it here lets a plain `cargo build` emit the staticlib
+# (liblibrsvg_c.a, copied to librsvg_2.a) that Meson's custom_target consumes, and
+# an rlib so `cargo test`/integration tests (librsvg-c/tests/legacy_sizing.rs:
+# `use librsvg_c::sizing::LegacySize`) can compile.  The [lib] name is NOT set so
+# the crate keeps its default name `librsvg_c`.
+crate-type = ["staticlib", "rlib"]
+
 [dependencies]
 cairo-rs = { workspace = true, features = ["v1_16", "png", "pdf", "ps", "svg"] }
 cast.workspace = true
