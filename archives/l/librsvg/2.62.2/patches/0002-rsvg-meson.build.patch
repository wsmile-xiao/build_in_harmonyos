diff -ruN a/rsvg/meson.build b/rsvg/meson.build
--- a/rsvg/meson.build
+++ b/rsvg/meson.build
@@ -97,22 +97,23 @@
     '--current-build-dir', '@OUTDIR@',
     '--current-source-dir', meson.current_source_dir(),
     '--packages', 'librsvg-c',
     '--extension', ext_static,
   ] + avif_feature_args
     + pixbuf_feature_args,
 )
 
 librsvg_c_lib = rust_artifacts[0]
 
+# HMDFS workaround: Use python3 to execute makedef.py script
 makedef_args = [
-  makedef,
+  python3_native, makedef_script,
   '--regex',
   '^rsvg_.',
 ]
 
 if host_system in ['darwin', 'ios']
   makedef_args += ['--os', 'darwin']
 elif host_system in ['windows', 'cygwin']
   makedef_args += ['--os', 'win']
 else
   makedef_args += ['--os', 'linux']
