diff -ruN a/librsvg-c/Cargo.toml b/librsvg-c/Cargo.toml
--- a/librsvg-c/Cargo.toml
+++ b/librsvg-c/Cargo.toml
@@ -9,6 +9,13 @@
 edition.workspace = true
 rust-version.workspace = true
 
+[lib]
+# OHOS patch: cargo-c provides these when it runs (`cargo cbuild --library-type
+# staticlib`).  Declaring them here lets a plain `cargo build` emit
+# librsvg_2.a directly, matching Meson's declared custom_target output.
+name = "rsvg_2"
+crate-type = ["staticlib"]
+
 [dependencies]
 cairo-rs = { workspace = true, features = ["v1_16", "png", "pdf", "ps", "svg"] }
 cast.workspace = true
