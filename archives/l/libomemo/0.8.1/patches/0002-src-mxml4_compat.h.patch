diff -ruN /dev/null b/src/mxml4_compat.h
--- /dev/null
+++ b/src/mxml4_compat.h
@@ -0,0 +1,46 @@
+/* Mini-XML v4 API compatibility layer for legacy code */
+#ifndef MXML4_COMPAT_H
+#define MXML4_COMPAT_H
+
+#include <mxml.h>
+
+/* v2/v3 to v4 API mappings */
+#define MXML_NO_PARENT NULL
+
+/* Descend constants - v4 renamed */
+#define MXML_DESCEND MXML_DESCEND_ALL
+
+/* Callback constants - use special pointer values as markers */
+#define MXML_NO_CALLBACK ((void *)0)
+#define MXML_OPAQUE_CALLBACK ((void *)1)
+
+/* v4 mxmlAdd signature: mxmlAdd(parent, add, child, node)
+ * v2/v3: mxmlAdd(parent, where, sibling, node)
+ * When sibling == MXML_ADD_TO_PARENT, means add to parent directly (child=NULL in v4)
+ */
+#define MXML_ADD_TO_PARENT NULL
+
+/* Wrapper functions to handle API parameter order changes */
+
+/* v4: mxmlLoadString(parent, options, string)
+ * v2/v3: mxmlLoadString(parent, string, callback)
+ */
+static inline mxml_node_t *mxml_load_string_compat(mxml_node_t *parent, const char *s, void *callback_marker) {
+    mxml_options_t *opts = mxmlOptionsNew();
+    if (callback_marker == MXML_OPAQUE_CALLBACK || callback_marker == ((void *)1)) {
+        mxmlOptionsSetTypeValue(opts, MXML_TYPE_OPAQUE);
+    }
+    mxml_node_t *node = mxmlLoadString(parent, opts, s);
+    mxmlOptionsDelete(opts);
+    return node;
+}
+
+/* Override mxmlLoadString macro */
+#define mxmlLoadString(parent, s, callback) mxml_load_string_compat(parent, s, callback)
+
+/* v4: mxmlSaveAllocString(node, options)
+ * v2/v3: mxmlSaveAllocString(node, callback)
+ */
+#define mxmlSaveAllocString(node, callback) mxmlSaveAllocString(node, NULL)
+
+#endif /* MXML4_COMPAT_H */
