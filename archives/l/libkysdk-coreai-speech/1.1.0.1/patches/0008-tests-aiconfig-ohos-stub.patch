diff --git a/tests/ohosstub/kylin-ai/private/aiconfig/modelconfig.h b/tests/ohosstub/kylin-ai/private/aiconfig/modelconfig.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/tests/ohosstub/kylin-ai/private/aiconfig/modelconfig.h
@@ -0,0 +1,164 @@
+/*
+ * OHOS portability stub for <kylin-ai/private/aiconfig/modelconfig.h>
+ *
+ * libkysdk-coreai-speech 的上游 tests/ 依赖 libkysdk-ai-private 的
+ * ai-config 模块（libkyai-config.so + kylin-ai/private/aiconfig/modelconfig.h），
+ * 该模块是独立软件包、OHOS 制品仓未发布（libkysdk-ai-private 1.1.0.1 尚在
+ * PR #10314 首次发布流程中），CI 上 tests 因此无法编译（
+ * fatal error: 'kylin-ai/private/aiconfig/modelconfig.h' file not found）。
+ *
+ * 按生态既有 ohosstub 模式（libkysdk-applications 的 QGSettings stub 同款）
+ * 提供本 header-only 内联 stub：枚举与结构体按上游 modelconfig.h 原样复制，
+ * ModelConfig 类改为内联实现（无 pimpl、不链接 libkyai-config）。测试仅把
+ * 模型鉴权/当前模型设置作为运行前置调用（setAllAuthentications 等，无断言），
+ * stub 提供可编译可链接的 API 面，speech 相关用例仍真实执行。适配修改已在
+ * PR body 上游测试修改说明中申报。
+ */
+
+#ifndef KYAI_CONFIG_MODEL_MODELCONFIG_STUB_H
+#define KYAI_CONFIG_MODEL_MODELCONFIG_STUB_H
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace kyai {
+namespace config {
+namespace model {
+
+enum class AiCapability {
+    Nlp,
+    Vision,
+    Speech,
+};
+
+enum class DeployType {
+    Ondevice,
+    PublicCloud,
+    PrivateCloud,
+    Custom = PrivateCloud,
+};
+
+enum class ModelStatus {
+    Idle,
+    Running,
+    Unknown,
+};
+
+struct Authentication {
+    std::string friendlyKeyName;
+    std::string key;
+    std::string value;
+};
+
+struct Model {
+    std::string modelName;
+    std::string vendor;
+    AiCapability capability;
+    DeployType deployType;
+};
+
+struct ExtendedModel : public Model {
+    std::string modelVersion;
+    std::string apiUrl;
+    std::string debName;
+    bool is3rdModel{false};
+};
+
+struct MultiAuthentication {
+    std::string itemName;
+    std::vector<Authentication> authentications;
+};
+
+// header-only stub：方法内联实现，set 结果存于进程内静态表（跨实例可见，
+// 与真实 libkyai-config 的持久化语义近似），未设置项返回默认值。
+class ModelConfig {
+public:
+    ModelConfig() = default;
+    ~ModelConfig() = default;
+
+    static std::map<std::pair<int, int>, std::string> &currentModelNames() {
+        static std::map<std::pair<int, int>, std::string> names;
+        return names;
+    }
+
+    static std::map<std::string, std::vector<MultiAuthentication>> &auths() {
+        static std::map<std::string, std::vector<MultiAuthentication>> a;
+        return a;
+    }
+
+    std::vector<Model> getModels(AiCapability) const { return {}; }
+    std::vector<Model> getModels(DeployType) const { return {}; }
+
+    std::vector<ExtendedModel> getExtendedModels(AiCapability) const { return {}; }
+    std::vector<ExtendedModel> getExtendedModels(DeployType) const { return {}; }
+
+    std::string getCurrentModelName(AiCapability capability,
+                                    DeployType deployType) const {
+        auto key = std::make_pair(static_cast<int>(capability),
+                                  static_cast<int>(deployType));
+        auto it = currentModelNames().find(key);
+        return it == currentModelNames().end() ? std::string() : it->second;
+    }
+
+    std::vector<MultiAuthentication> getModelAuthentications(
+        const std::string &modelName) const {
+        auto it = auths().find(modelName);
+        return it == auths().end() ? std::vector<MultiAuthentication>()
+                                   : it->second;
+    }
+
+    int getModelSchedulingPriority(DeployType) const { return 0; }
+    bool getModelDeployEnabled(DeployType) const { return false; }
+
+    bool setCurrentModelName(AiCapability capability, DeployType deployType,
+                             const std::string &modelName) {
+        currentModelNames()[std::make_pair(static_cast<int>(capability),
+                                           static_cast<int>(deployType))] =
+            modelName;
+        return true;
+    }
+
+    bool setModelAuthentications(
+        const std::string &modelName,
+        const std::vector<MultiAuthentication> authentications) {
+        auths()[modelName] = authentications;
+        return true;
+    }
+
+    bool setModelSchedulingPriority(DeployType, int) { return true; }
+    bool setModelDeployEnabled(DeployType, bool) { return true; }
+
+    bool clearModelAuthentications(const std::string &modelName) const {
+        auths().erase(modelName);
+        return true;
+    }
+
+    ModelStatus getModelStatus(const std::string &) const {
+        return ModelStatus::Unknown;
+    }
+
+    bool setCustomModelApiUrl(const std::string &, const std::string &) {
+        return true;
+    }
+    bool setCustomModelVersion(const std::string &, const std::string &) {
+        return true;
+    }
+
+    bool addCustomModel(const std::string &, const std::string &,
+                        const std::string &, const std::string &) {
+        return true;
+    }
+
+    bool deleteCustomModel(const std::string &) { return true; }
+
+    std::vector<Model> getFreeTrialModels(AiCapability) const { return {}; }
+};
+
+}  // namespace model
+}  // namespace config
+}  // namespace kyai
+
+#endif  // KYAI_CONFIG_MODEL_MODELCONFIG_STUB_H
