diff -ruN a/runtime/src/kmp.h b/runtime/src/kmp.h
--- a/runtime/src/kmp.h
+++ b/runtime/src/kmp.h
@@ -59,7 +59,9 @@

 // Android does not have pthread_cancel.  Undefine KMP_CANCEL_THREADS if being
 // built on Android
-#if defined(__ANDROID__)
+// Platforms without pthread_cancel (e.g. HarmonyOS) disable it
+// via the LIBOMP_HAVE_PTHREAD_CANCEL capability macro.
+#if defined(__ANDROID__) || !defined(LIBOMP_HAVE_PTHREAD_CANCEL)
 #undef KMP_CANCEL_THREADS
 #endif

