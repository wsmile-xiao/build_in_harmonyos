-#! /bin/sh
+#!/bin/sh
+# HarmonyOS early detection - avoid compilation on HMDFS
+if test -f /system/bin/hap -o "$(uname -s)" = "HarmonyOS"; then
+    case "$(uname -m)" in
+        aarch64|arm64) MACHINE=aarch64 ;;
+        armv7*|armv8*)  MACHINE=arm ;;
+        x86_64|amd64)   MACHINE=x86_64 ;;
+        i?86)          MACHINE=i686 ;;
+        *)             MACHINE="$(uname -m)" ;;
+    esac
+    echo "${MACHINE}-unknown-linux-ohos"
+    exit 0
+fi
