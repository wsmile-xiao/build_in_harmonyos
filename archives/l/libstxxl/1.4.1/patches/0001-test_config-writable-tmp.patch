--- a/tests/mng/test_config.cpp
+++ b/tests/mng/test_config.cpp
@@ -12,6 +12,8 @@
 
 #include <stxxl/mng>
 #include <stxxl/bits/verbose.h>
+#include <cstdlib>
+#include <string>
 
 void test1()
 {
@@ -55,24 +57,34 @@
 
     stxxl::config* config = stxxl::config::get_instance();
 
+    // HMBS/OHOS: /tmp is read-only on runners; honor the writable TMPDIR
+    // injected for ctest (STXXL_TMPDIR/TMPDIR/TEMP) instead of hardcoding
+    // /tmp so block_manager can create its disk files.
+    const char* _hmbs_tmp = getenv("TMPDIR");
+    if (!_hmbs_tmp) _hmbs_tmp = getenv("STXXL_TMPDIR");
+    if (!_hmbs_tmp) _hmbs_tmp = getenv("TEMP");
+    if (!_hmbs_tmp) _hmbs_tmp = "/tmp";
+    std::string _hmbs_p1 = std::string(_hmbs_tmp) + "/stxxl-1.tmp";
+    std::string _hmbs_p2 = std::string(_hmbs_tmp) + "/stxxl-2.tmp";
+
     {
-        stxxl::disk_config disk1("/tmp/stxxl-1.tmp", 100 * 1024 * 1024, "syscall");
+        stxxl::disk_config disk1(_hmbs_p1, 100 * 1024 * 1024, "syscall");
         disk1.unlink_on_open = true;
         disk1.direct = stxxl::disk_config::DIRECT_OFF;
 
-        STXXL_CHECK(disk1.path == "/tmp/stxxl-1.tmp");
+        STXXL_CHECK(disk1.path == _hmbs_p1);
         STXXL_CHECK(disk1.size == 100 * 1024 * stxxl::uint64(1024));
         STXXL_CHECK(disk1.fileio_string() == "syscall direct=off unlink_on_open");
 
         config->add_disk(disk1);
 
-        stxxl::disk_config disk2("/tmp/stxxl-2.tmp", 200 * 1024 * 1024, "syscall direct=off");
+        stxxl::disk_config disk2(_hmbs_p2, 200 * 1024 * 1024, "syscall direct=off");
         disk2.unlink_on_open = true;
 
-        STXXL_CHECK(disk2.path == "/tmp/stxxl-2.tmp");
+        STXXL_CHECK(disk2.path == _hmbs_p2);
         STXXL_CHECK(disk2.size == 200 * 1024 * stxxl::uint64(1024));
         STXXL_CHECK(disk2.fileio_string() == "syscall direct=off unlink_on_open");
         STXXL_CHECK(disk2.direct == 0);
 
         config->add_disk(disk2);
     }
