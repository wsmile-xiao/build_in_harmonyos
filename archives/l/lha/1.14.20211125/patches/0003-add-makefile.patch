--- /dev/null
+++ b/src/Makefile
@@ -0,0 +1,33 @@
+CC = clang
+CFLAGS = -fPIC -O2 -Wall -I.. -DHAVE_CONFIG_H -DEUC -DSUPPORT_LH7
+LDFLAGS = 
+PREFIX = /storage/Users/currentUser/usr/local
+
+SRCS = append.c bitio.c crcio.c dhuf.c extract.c header.c huf.c \
+       indicator.c larc.c lhadd.c lharc.c lhext.c lhlist.c \
+       maketbl.c maketree.c patmatch.c shuf.c slide.c util.c \
+       getopt_long.c pm2.c pm2hist.c pm2tree.c support_utf8.c \
+       fnmatch.c vsnprintf.c
+
+OBJS = $(SRCS:.c=.o)
+TARGET = lha
+
+all: $(TARGET)
+
+$(TARGET): $(OBJS)
+	$(CC) $(LDFLAGS) -o $(TARGET) $(OBJS)
+
+%.o: %.c
+	$(CC) $(CFLAGS) -c -o $@ $<
+
+install: $(TARGET)
+	mkdir -p $(PREFIX)/bin
+	cp $(TARGET) $(PREFIX)/bin/
+
+clean:
+	rm -f $(OBJS) $(TARGET)
+
+.PHONY: all install clean
