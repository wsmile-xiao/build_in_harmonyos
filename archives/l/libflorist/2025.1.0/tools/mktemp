#!/bin/sh
# HMDFS workaround for autoconf's temporary directory.
#
# `configure` and `config.status` create their scratch directory as
#
#     tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null`
#
# On HMDFS a 0700-mode directory is NOT writable (chmod/umask are effectively
# ignored; the inherited ACL decides, and the resulting directory lands as
# `drwx--S---`), so the run then dies with
#
#     ./config.status[NNN]: can't create ./confXXXXXX/subs1.awk: Permission denied
#     config.status: error: could not setup config files machinery
#
# Forcing a permissive umask before delegating to the real mktemp yields a
# writable directory and leaves the generated `configure` script untouched
# (iron rule R6: generated files must not be edited).
#
# This shim is placed first on PATH by the recipe's generate() step.
umask 022
exec /usr/bin/mktemp "$@"
