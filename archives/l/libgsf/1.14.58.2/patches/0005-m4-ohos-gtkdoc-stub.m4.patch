--- /dev/null
+++ b/m4/ohos-gtkdoc-stub.m4
@@ -0,0 +1,12 @@
+dnl GTK_DOC_CHECK stub for OHOS (gtk-doc unavailable)
+dnl Provides the option but always disables gtk-doc.
+AC_DEFUN([GTK_DOC_CHECK], [
+  AC_ARG_ENABLE([gtk-doc],
+    AS_HELP_STRING([--enable-gtk-doc],
+                   [use gtk-doc to build documentation [[default=no]]]),
+    [enable_gtk_doc=$enableval], [enable_gtk_doc=no])
+  if test "x$enable_gtk_doc" = "xyes"; then
+    AC_MSG_ERROR([gtk-doc is not available in this OHOS environment])
+  fi
+  gtk_doc_installed=false
+])
