--- /dev/null
+++ b/gtkdocize
@@ -0,0 +1,11 @@
+#!/bin/sh
+# gtkdocize stub for OHOS — gtk-doc is unavailable.
+# autoreconf runs gtkdocize because configure.ac uses GTK_DOC_CHECK.
+# GTK_DOC_CHECK is stubbed (m4/ohos-gtkdoc-stub.m4) so gtk-doc is always
+# disabled; this script just creates a minimal gtk-doc.make and exits 0.
+if [ ! -f gtk-doc.make ]; then
+    echo "# gtk-doc disabled (OHOS stub)" > gtk-doc.make
+    echo "CLEANFILES =" >> gtk-doc.make
+    echo "EXTRA_DIST =" >> gtk-doc.make
+fi
+exit 0
