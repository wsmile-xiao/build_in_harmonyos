--- a/configure
+++ b/configure
@@ -13985,7 +13985,9 @@
 # Detect OS
 
 
-LSOF_VSTR=$(uname -r)
+# HarmonyOS: `uname -r` returns "HongMeng Kernel 1.13.0" (embedded spaces);
+# keep the last field only so -DLSOF_VSTR quoting stays intact.
+LSOF_VSTR=$(uname -r | awk '{print $NF}')
 LSOF_DIALECT=unknown
 LSOF_DIALECT_DIR=unknown
 LSOF_TGT=unknown
@@ -17171,7 +17173,8 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  # HarmonyOS: mktemp-created dirs (mode drwx--S---) reject writes; mkdir works.
+  tmp=`(umask 077 && mkdir "./confXXXXXX" 2>/dev/null) && echo "./confXXXXXX"` &&
   test -d "$tmp"
 }  ||
 {
