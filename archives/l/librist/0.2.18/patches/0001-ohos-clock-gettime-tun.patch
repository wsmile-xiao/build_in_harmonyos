diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -134,7 +134,16 @@
 	librist_soversion = ''
 else
-	if host_machine.system() == 'linux' or host_machine.system() == 'android'
-		platform_files += 'src/tun_linux.c'
+	# OHOS reports host_machine.system() as 'ohos' (Conan/CI) or 'harmonyos'
+	# (some toolchains) and uses a musl-derived libc: it needs _GNU_SOURCE
+	# for the clock_gettime declaration (hidden under c_std=c99 otherwise),
+	# but has no /dev/net/tun, so it uses a stub TUN backend instead of
+	# tun_linux.c (which needs <linux/if_tun.h>).
+	if host_machine.system() == 'linux' or host_machine.system() == 'android' or host_machine.system() == 'ohos' or host_machine.system() == 'harmonyos'
+		if host_machine.system() == 'linux' or host_machine.system() == 'android'
+			platform_files += 'src/tun_linux.c'
+		else
+			platform_files += 'src/tun_ohos.c'
+		endif
 		test_args += '-D_GNU_SOURCE'
 		add_project_arguments('-D_GNU_SOURCE', language: 'c')
 		if cc.check_header('linux/if_alg.h')
@@ -171,12 +171,20 @@
 	else
 		have_clock_gettime = cc.has_function('clock_gettime', prefix : '#include <time.h>', args : test_args)
 		if not have_clock_gettime and host_machine.system() != 'darwin'
 			lib_rt = cc.find_library('rt', required: false)
 			have_clock_gettime = cc.has_function('clock_gettime', prefix : '#include <time.h>', args : test_args, dependencies : lib_rt)
+			# OHOS keeps clock_gettime in libc (librt is only a stub there):
+			# retry with the threads dependency before giving up, and never
+			# link a missing librt into deps.
+			if not have_clock_gettime
+				have_clock_gettime = cc.has_function('clock_gettime', prefix : '#include <time.h>', args : test_args, dependencies : dependency('threads'))
+			endif
 			if not have_clock_gettime
 				error('clock_gettime not found')
 			endif
-			deps += [ lib_rt ]
+			if lib_rt.found()
+				deps += [ lib_rt ]
+			endif
 		endif
 	endif
 	add_project_arguments(['-Wshadow', '-pedantic-errors'], language: 'c')
diff --git a/src/tun_ohos.c b/src/tun_ohos.c
new file mode 100644
--- /dev/null
+++ b/src/tun_ohos.c
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* OHOS stub TUN backend.
+ *
+ * OpenHarmony/HarmonyOS has no /dev/net/tun userspace API, so the TUN
+ * data-fd path of RIST is unsupported here. Provide the same symbols as
+ * src/tun_linux.c so the library links; every entry point fails with
+ * ENOSYS at runtime, mirroring the failure mode of src/tun_win.c stubs.
+ */
+#include "librist/tun.h"
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+
+int rist_tun_open(const char *requested_name, char *actual_name, size_t name_len)
+{
+	(void)requested_name;
+	(void)actual_name;
+	(void)name_len;
+	errno = ENOSYS;
+	return -1;
+}
+
+void rist_tun_close(int fd)
+{
+	(void)fd;
+}
+
+int rist_tun_read(int fd, uint8_t *buf, size_t len)
+{
+	(void)fd;
+	(void)buf;
+	(void)len;
+	errno = ENOSYS;
+	return -1;
+}
+
+int rist_tun_write(int fd, const uint8_t *buf, size_t len)
+{
+	(void)fd;
+	(void)buf;
+	(void)len;
+	errno = ENOSYS;
+	return -1;
+}
+
+static int tun_ohos_not_supported(void)
+{
+	errno = ENOSYS;
+	return -1;
+}
+
+int rist_tun_set_ip(const char *dev, const char *ip, int prefix_len)
+{
+	(void)dev;
+	(void)ip;
+	(void)prefix_len;
+	return tun_ohos_not_supported();
+}
+
+int rist_tun_set_mtu(const char *dev, int mtu)
+{
+	(void)dev;
+	(void)mtu;
+	return tun_ohos_not_supported();
+}
+
+int rist_tun_bring_up(const char *dev)
+{
+	(void)dev;
+	return tun_ohos_not_supported();
+}
