 #ifndef AO_PLUGIN_PATH
 #define AO_PLUGIN_PATH "/usr/local/lib/ao"
 #endif
+
+/* The plugin directory is baked in by configure.  A staged install does not
+   live at the configure prefix, so this environment variable may redirect
+   the search: on HarmonyOS PC the package is consumed from the Conan cache,
+   where the compiled-in path is only valid once the package is merged into
+   the root filesystem.  Only an absolute path is accepted, so an unset,
+   empty or relative value keeps upstream behaviour. */
+static const char *_ao_plugin_path(void)
+{
+	const char *override = getenv("AO_PLUGIN_PATH");
+	return (override != NULL && override[0] == '/') ? override : AO_PLUGIN_PATH;
+}
