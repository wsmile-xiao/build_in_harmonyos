Description: OHOS (musl) direct-load fallback when ctypes.util.find_library() returns None
Origin: downstream
Upstream: not submitted
Modification-Layer: 1 (legacycrypt.py module import, runtime library discovery)
Notes: find_library() always returns None on OHOS (no ldconfig/gcc); after the
 upstream lookups fail, try CDLL('libcrypt.so.2') - the SONAME libxcrypt
 installs - and select the libxcrypt crypt_data layout accordingly.
---
--- a/legacycrypt.py
+++ b/legacycrypt.py
@@ -94,7 +94,17 @@
     else:
         raise OSError
 except OSError:
-    raise ImportError("libcrypt / libxcrypt missing") from None
+    # OHOS (musl) fallback: ctypes.util.find_library() returns None even for
+    # installed shared libraries (the device has no ldconfig/gcc for it to
+    # query), so the lookups above never succeed.  Load the libxcrypt
+    # SONAME directly through the normal dynamic-loader search path
+    # (LD_LIBRARY_PATH and the loader default paths).  libxcrypt installs
+    # libcrypt.so.2, so the libxcrypt crypt_data layout is the correct one.
+    _crypt_data = _crypt_data_libxcrypt
+    try:
+        _libcrypt = _ctypes.CDLL('libcrypt.so.2')
+    except OSError:
+        raise ImportError("libcrypt / libxcrypt missing") from None
 
 
 _crypt_r_func = _crypt_func = None
