--- a/external/xmlf90-1.6.3/src/sax/m_sax_reader.f90
+++ b/external/xmlf90-1.6.3/src/sax/m_sax_reader.f90
@@ -326,7 +326,38 @@
 call get_unit(lun,iostat)

 if (iostat /= 0) stop "Out of unit numbers"

 open(unit=lun,status="scratch",form="formatted", &
      action="readwrite",position="rewind",iostat=iostat)
+if (iostat /= 0) then
+! HarmonyOS has no writable /tmp for the libc tmpfile() behind
+! STATUS="SCRATCH": fall back to an explicitly-named file under
+! $TMPDIR/$TMP/$TEMP, else the current directory (deleted on close).
+! Only the constant EOR/EOF iostat codes are probed, so semantics hold.
+! BLOCK keeps the helper variables local: no new procedure, no new symbol.
+   block
+     character(len=256) :: probe_dir
+     character(len=300) :: probe_fname
+     character(len=16) :: probe_lun_str
+     integer :: probe_k
+     write(probe_lun_str,'(I0)') lun
+     do probe_k = 1, 4
+        probe_dir = ""
+        if (probe_k == 1) call get_environment_variable("TMPDIR",probe_dir)
+        if (probe_k == 2) call get_environment_variable("TMP",probe_dir)
+        if (probe_k == 3) call get_environment_variable("TEMP",probe_dir)
+        if (probe_k < 4 .and. len_trim(probe_dir) == 0) cycle
+        if (probe_k < 4) then
+           probe_fname = trim(probe_dir) // "/__xmlf90_eor_eof_probe_" // &
+                   trim(adjustl(probe_lun_str)) // ".tmp"
+        else
+           probe_fname = "__xmlf90_eor_eof_probe_" // &
+                   trim(adjustl(probe_lun_str)) // ".tmp"
+        endif
+        open(unit=lun,file=trim(probe_fname),form="formatted", &
+             action="readwrite",position="rewind",iostat=iostat)
+        if (iostat == 0) exit
+     enddo
+   end block
+endif
 if (iostat /= 0)   stop "Cannot open test file"
