--- a/tests/test_install.sh	2026-09-04 13:05:24.866832345 +0800
+++ b/tests/test_install.sh	2026-09-04 13:05:53.970833595 +0800
@@ -2,7 +2,11 @@
 set -e
 
 
-make="make -C $lz4_root"
+# POSIX_ENV=Yes is required so the top-level install/uninstall targets are
+# defined (they are guarded by `ifeq ($(POSIX_ENV),Yes)`); on HarmonyOS/OHOS
+# uname returns 'HarmonyOS' which is not Linux/BSD, so default POSIX_ENV is No.
+# Pass a usable SHELL and CC too (OHOS /bin/sh is restricted, no cc default).
+make="make -C $lz4_root POSIX_ENV=Yes SHELL=/data/service/hnp/bin/bash CC=clang CXX=clang++ LN_SF=cp"
 unamestr=$(uname)
 if [ "$unamestr" = 'Linux' ]; then
   make="make -C $lz4_root"
