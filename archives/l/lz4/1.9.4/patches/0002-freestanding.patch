--- a/tests/freestanding.c	2026-09-04 13:05:11.470833126 +0800
+++ b/tests/freestanding.c	2026-09-04 13:05:11.734831251 +0800
@@ -30,8 +30,25 @@
 
 
 #if !defined(__x86_64__) || !defined(__linux__)
-EXTERN_C void _start(void) { }
-int main(int argc, char** argv) { return 0; }
+/* _start must not fall through: provide an exit() syscall so the
+ * freestanding probe can terminate cleanly on non-x86_64 (e.g. aarch64).
+ * On aarch64, exit = syscall(__NR_exit: x8=93, x0=code); svc #0. */
+static void _exit_sys(int code) {
+#if defined(__aarch64__)
+    register long x8 asm("x8") = 93;   /* __NR_exit */
+    register long x0 asm("x0") = (long)code;
+    asm volatile("svc #0" : : "r"(x8), "r"(x0) : "memory");
+#else
+    (void)code;
+#endif
+}
+EXTERN_C void _start(void) {
+    _exit_sys(0);
+}
+int main(int argc, char** argv) {
+    (void)argc; (void)argv;
+    return 0;
+}
 #else
 
 static void MY_exit(int exitCode);
