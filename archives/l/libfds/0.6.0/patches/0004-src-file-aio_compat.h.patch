diff -ruN a/src/file/aio_compat.h b/src/file/aio_compat.h
--- a/src/file/aio_compat.h
+++ b/src/file/aio_compat.h
@@ -0,0 +1,104 @@
+/**
+ * @file   src/file/aio_compat.h
+ * @brief  POSIX AIO compatibility layer for HarmonyOS (musl-libc)
+ *
+ * HarmonyOS uses musl-libc which doesn't implement POSIX AIO (aio_read,
+ * aio_write, etc). This header provides a compatibility shim that maps
+ * AIO operations to synchronous pread/pwrite calls.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef AIO_COMPAT_H
+#define AIO_COMPAT_H
+
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <cstring>
+#include <signal.h>
+
+/* AIO constants */
+#define AIO_CANCELED     0
+#define AIO_NOTCANCELED  1
+#define AIO_ALLDONE      2
+/* Note: EINPROGRESS is already defined in HarmonyOS errno.h (115), no need to redefine */
+
+/* aiocb structure - extended with result field for sync compat */
+struct aiocb {
+    int             aio_fildes;     /* File descriptor */
+    off_t           aio_offset;     /* File offset */
+    volatile void  *aio_buf;        /* Buffer pointer */
+    size_t          aio_nbytes;     /* Number of bytes */
+    int             aio_reqprio;    /* Request priority offset */
+    struct sigevent aio_sigevent;   /* Signal number and value */
+    int             aio_lio_opcode; /* Operation to be performed */
+    /* Compatibility extension: store result of synchronous operation */
+    ssize_t         _compat_result; /* Result from pread/pwrite */
+    int             _compat_errno;  /* errno from pread/pwrite */
+};
+
+/* Synchronous AIO implementations for HarmonyOS */
+inline int
+aio_read(struct aiocb *aiocbp)
+{
+    aiocbp->_compat_errno = 0;
+    ssize_t rc = pread(aiocbp->aio_fildes,
+                       (void *)aiocbp->aio_buf,
+                       aiocbp->aio_nbytes,
+                       aiocbp->aio_offset);
+    if (rc < 0) {
+        aiocbp->_compat_errno = errno;
+        aiocbp->_compat_result = -1;
+        return -1;
+    }
+    aiocbp->_compat_result = rc;
+    return 0;
+}
+
+inline int
+aio_write(struct aiocb *aiocbp)
+{
+    aiocbp->_compat_errno = 0;
+    ssize_t rc = pwrite(aiocbp->aio_fildes,
+                        (const void *)aiocbp->aio_buf,
+                        aiocbp->aio_nbytes,
+                        aiocbp->aio_offset);
+    if (rc < 0) {
+        aiocbp->_compat_errno = errno;
+        aiocbp->_compat_result = -1;
+        return -1;
+    }
+    aiocbp->_compat_result = rc;
+    return 0;
+}
+
+inline int
+aio_error(const struct aiocb *aiocbp)
+{
+    /* Since our AIO is synchronous, operations are always complete */
+    return aiocbp->_compat_errno;
+}
+
+inline ssize_t
+aio_return(struct aiocb *aiocbp)
+{
+    return aiocbp->_compat_result;
+}
+
+inline int
+aio_cancel(int fd, struct aiocb *aiocbp)
+{
+    /* Synchronous AIO: always already done */
+    return AIO_ALLDONE;
+}
+
+inline int
+aio_suspend(struct aiocb *list[], int nent,
+            const struct timespec *timeout)
+{
+    /* Synchronous AIO: always complete immediately */
+    return 0;
+}
+
+#endif /* AIO_COMPAT_H */