# librtmp 2.4_git20190330 — OpenSSL 1.1+/3.x 兼容补丁
#
# 上游 2019-03-30 快照使用 OpenSSL 1.0 时代的 HMAC_CTX 栈对象与 DH 结构体
# 直接成员访问;OpenSSL 1.1.0 起结构体不透明且 HMAC_CTX_init/cleanup 已移除,
# 对 openssl/3.5.6 编译失败。本补丁按版本宏(OPENSSL_VERSION_NUMBER < 0x10100000L)
# 保留旧 API 分支,新 API 用 HMAC_CTX_new/free 与 DH_get0_pqg/DH_get0_key/
# DH_set0_pqg/DH_set_length 访问器重写,与 Debian/Fedora/Arch 发行版补丁语义一致。
# RC4/DH_generate_key 等低层 API 在 OpenSSL 3.x 仍存在(仅 deprecated 警告),不改动。
--- a/librtmp/handshake.h
+++ b/librtmp/handshake.h
@@ -69,9 +69,15 @@
 #if OPENSSL_VERSION_NUMBER < 0x0090800 || !defined(SHA256_DIGEST_LENGTH)
 #error Your OpenSSL is too old, need 0.9.8 or newer with SHA256
 #endif
+#if OPENSSL_VERSION_NUMBER < 0x10100000L
 #define HMAC_setup(ctx, key, len)	HMAC_CTX_init(&ctx); HMAC_Init_ex(&ctx, key, len, EVP_sha256(), 0)
 #define HMAC_crunch(ctx, buf, len)	HMAC_Update(&ctx, buf, len)
 #define HMAC_finish(ctx, dig, dlen)	HMAC_Final(&ctx, dig, &dlen); HMAC_CTX_cleanup(&ctx)
+#else
+#define HMAC_setup(ctx, key, len)	ctx = HMAC_CTX_new(); HMAC_Init_ex(ctx, key, len, EVP_sha256(), NULL)
+#define HMAC_crunch(ctx, buf, len)	HMAC_Update(ctx, buf, len)
+#define HMAC_finish(ctx, dig, dlen)	HMAC_Final(ctx, dig, &dlen); HMAC_CTX_free(ctx)
+#endif
 
 typedef RC4_KEY *	RC4_handle;
 #define RC4_alloc(h)	*h = malloc(sizeof(RC4_KEY))
@@ -117,7 +123,11 @@
 {
   uint8_t digest[SHA256_DIGEST_LENGTH];
   unsigned int digestLen = 0;
+#if OPENSSL_VERSION_NUMBER < 0x10100000L
   HMAC_CTX ctx;
+#else
+  HMAC_CTX *ctx = NULL;
+#endif
 
   RC4_alloc(rc4keyIn);
   RC4_alloc(rc4keyOut);
@@ -266,7 +276,11 @@
 	   size_t keylen, uint8_t *digest)
 {
   unsigned int digestLen;
+#if OPENSSL_VERSION_NUMBER < 0x10100000L
   HMAC_CTX ctx;
+#else
+  HMAC_CTX *ctx = NULL;
+#endif
 
   HMAC_setup(ctx, key, keylen);
   HMAC_crunch(ctx, message, messageLen);
--- a/librtmp/hashswf.c
+++ b/librtmp/hashswf.c
@@ -57,11 +57,18 @@
 #include <openssl/sha.h>
 #include <openssl/hmac.h>
 #include <openssl/rc4.h>
+#if OPENSSL_VERSION_NUMBER < 0x10100000L
 #define HMAC_setup(ctx, key, len)	HMAC_CTX_init(&ctx); HMAC_Init_ex(&ctx, (unsigned char *)key, len, EVP_sha256(), 0)
 #define HMAC_crunch(ctx, buf, len)	HMAC_Update(&ctx, (unsigned char *)buf, len)
 #define HMAC_finish(ctx, dig, dlen)	HMAC_Final(&ctx, (unsigned char *)dig, &dlen);
 #define HMAC_close(ctx)	HMAC_CTX_cleanup(&ctx)
+#else
+#define HMAC_setup(ctx, key, len)	ctx = HMAC_CTX_new(); HMAC_Init_ex(ctx, (const unsigned char *)key, len, EVP_sha256(), NULL)
+#define HMAC_crunch(ctx, buf, len)	HMAC_Update(ctx, (const unsigned char *)buf, len)
+#define HMAC_finish(ctx, dig, dlen)	HMAC_Final(ctx, (unsigned char *)dig, &dlen); HMAC_CTX_free(ctx)
+#define HMAC_close(ctx)
 #endif
+#endif
 
