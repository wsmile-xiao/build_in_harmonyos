--- Makefile.orig	2026-05-19 19:18:14.916910000 +0800
+++ Makefile	2026-05-19 19:19:20.692910938 +0800
@@ -43,8 +43,8 @@
 # CC		= /usr/lang/acc
 # CCFLAGS 	= -c -O
 
-CC		= gcc -ansi -pedantic
-CCFLAGS 	= -c -O2 -DNeedFunctionPrototypes=1 -Wall -Wno-comment
+CC		= clang
+CCFLAGS 	= -c -O2 -DNeedFunctionPrototypes=1 -Wall -Wno-comment --target=aarch64-linux-ohos
 
 LD 		= $(CC)
 
@@ -71,7 +71,10 @@
 # Leave INSTALL_ROOT empty (or just don't execute "make install") to
 # not install gsm and toast outside of this directory.
 
-INSTALL_ROOT	=
+# HarmonyOS: 支持 DESTDIR 模式
+# 用法: make install DESTDIR=/path/to/staging PREFIX=/usr/local
+PREFIX ?= /usr/local
+INSTALL_ROOT ?= $(DESTDIR)$(PREFIX)
 
 # Where do you want to install the gsm library, header file, and manpages?
 #
@@ -312,11 +315,11 @@
 
 $(UNTOAST):	$(BIN) $(TOAST)
 		-rm $(RMFLAGS) $(UNTOAST)
-		$(LN) $(TOAST) $(UNTOAST)
+		$(LN) -s $(TOAST) $(UNTOAST) || cp $(TOAST) $(UNTOAST)
 
 $(TCAT):	$(BIN) $(TOAST)
 		-rm $(RMFLAGS) $(TCAT)
-		$(LN) $(TOAST) $(TCAT)
+		$(LN) -s $(TOAST) $(TCAT) || cp $(TOAST) $(TCAT)
 
 
 # The local bin and lib directories
@@ -332,11 +335,13 @@
 
 gsminstall:
 		-if [ x"$(GSM_INSTALL_ROOT)" != x ] ; then	\
+			mkdir -p $(GSM_INSTALL_LIB) $(GSM_INSTALL_INC) $(GSM_INSTALL_MAN) ; \
 			make $(GSM_INSTALL_TARGETS) ;	\
 		fi
 
 toastinstall:
 		-if [ x"$(TOAST_INSTALL_ROOT)" != x ]; then	\
+			mkdir -p $(TOAST_INSTALL_BIN) $(TOAST_INSTALL_MAN) ; \
 			make $(TOAST_INSTALL_TARGETS);	\
 		fi
 
@@ -357,11 +362,11 @@
 
 $(TOAST_INSTALL_BIN)/untoast:	$(TOAST_INSTALL_BIN)/toast
 		-rm $@
-		ln $? $@
+		ln -s toast $@ || cp $(TOAST_INSTALL_BIN)/toast $@
 
 $(TOAST_INSTALL_BIN)/tcat:	$(TOAST_INSTALL_BIN)/toast
 		-rm $@
-		ln $? $@
+		ln -s toast $@ || cp $(TOAST_INSTALL_BIN)/toast $@
 
 $(TOAST_INSTALL_MAN)/toast.1:	$(MAN)/toast.1
 		-rm $@
