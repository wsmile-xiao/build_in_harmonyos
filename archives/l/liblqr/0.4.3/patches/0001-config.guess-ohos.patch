--- a/config.guess
+++ b/config.guess
@@ -897,6 +897,23 @@
     i*86:Minix:*:*)
 	echo "$UNAME_MACHINE"-pc-minix
 	exit ;;
+    *:HarmonyOS:*:*)
+	case "$UNAME_MACHINE" in
+	    aarch64|arm64)
+		UNAME_MACHINE=aarch64
+		;;
+	    armv7*|armv8*)
+		UNAME_MACHINE=arm
+		;;
+	    x86_64|amd64)
+		UNAME_MACHINE=x86_64
+		;;
+	    i?86)
+		UNAME_MACHINE=i686
+		;;
+	esac
+	echo "$UNAME_MACHINE-unknown-linux-ohos"
+	exit ;;
     aarch64:Linux:*:*)
 	echo "$UNAME_MACHINE"-unknown-linux-"$LIBC"
 	exit ;;
