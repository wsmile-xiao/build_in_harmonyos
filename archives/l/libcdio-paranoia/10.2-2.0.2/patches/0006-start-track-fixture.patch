--- a/test/check_start_track_not_one.sh.in
+++ b/test/check_start_track_not_one.sh.in
@@ -1,5 +1,5 @@
 #/bin/sh
-# Check that a digital audio CD with a start track number of >1 works.
+# Check that a CD image with audio tracks starting at track 7 works.
 
 if test ! -d "$abs_top_builddir" ; then
   abs_top_builddir=@abs_top_builddir@
@@ -26,23 +26,39 @@
 base=start_track_not_one
 orig_cdda=$test_dir/data/cdda.bin
 
-# First we make a longer CDDA image.
+# Build a mixed-mode image with six one-sector data tracks followed by
+# three audio tracks.  The BIN/CUE driver in libcdio 2.3.0 numbers image
+# entries from one, so the audio tracks must be preceded by six entries to
+# exercise the non-one audio track numbers expected by cd-paranoia.
 cdda=$test_build_dir/$base.bin
-cat $orig_cdda $orig_cdda $orig_cdda > $cdda
+dd if=$orig_cdda of=$cdda bs=2352 count=6 2>/dev/null
+cat $orig_cdda $orig_cdda $orig_cdda >> $cdda
 
-# And a CUE file with a non-one start track.
+# And a CUE file whose audio tracks start at number 7.
 cue=$test_build_dir/$base.cue
 cat << EOF > $cue
 FILE "$cdda" BINARY
+  TRACK 01 MODE1/2352
+    INDEX 01 00:00:00
+  TRACK 02 MODE1/2352
+    INDEX 01 00:00:01
+  TRACK 03 MODE1/2352
+    INDEX 01 00:00:02
+  TRACK 04 MODE1/2352
+    INDEX 01 00:00:03
+  TRACK 05 MODE1/2352
+    INDEX 01 00:00:04
+  TRACK 06 MODE1/2352
+    INDEX 01 00:00:05
   TRACK 07 AUDIO
     FLAGS DCP
-    INDEX 01 00:00:00
+    INDEX 01 00:00:06
   TRACK 08 AUDIO
     FLAGS DCP
-    INDEX 01 00:04:02
+    INDEX 01 00:04:08
   TRACK 09 AUDIO
     FLAGS DCP
-    INDEX 01 00:08:04
+    INDEX 01 00:08:10
 EOF
 
 # Use an awk program to parse/verify the TOC.
