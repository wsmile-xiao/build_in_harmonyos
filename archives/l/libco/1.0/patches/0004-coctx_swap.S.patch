--- a/coctx_swap.S
+++ b/coctx_swap.S
@@ -85,11 +85,46 @@
 	popq %rsi
 	popq %rax //ret func addr
 	popq %rdx
 	popq %rcx
 	popq %rbx
 	popq %rsp
 	pushq %rax
 	
 	xorl %eax, %eax
 	ret
+
+#elif defined(__aarch64__)
+	// x0 = &a->regs[0], x1 = &b->regs[0]
+	// save current context into a->regs, then restore from b->regs
+	// NOTE: aarch64 BL does NOT push a return address; sp at entry == caller sp
+	mov x16, sp //real sp of current coroutine
+	mov x17, x30 //resume addr: coctx_swap return point (or pfn for fresh ctx)
+	stp x19, x20, [x0, #0]
+	stp x21, x22, [x0, #16]
+	stp x23, x24, [x0, #32]
+	stp x25, x26, [x0, #48]
+	stp x27, x28, [x0, #64]
+	stp x29, x30, [x0, #80] //regs[10..11]: fp, lr
+	stp x16, x17, [x0, #96] //regs[12..13]: real sp, resume addr
+	stp d8, d9, [x0, #112]
+	stp d10, d11, [x0, #128]
+	stp d12, d13, [x0, #144]
+	stp d14, d15, [x0, #160]
+	stp x0, x1, [x0, #176] //regs[22..23]: args (fresh ctx only)
+
+	ldp x19, x20, [x1, #0]
+	ldp x21, x22, [x1, #16]
+	ldp x23, x24, [x1, #32]
+	ldp x25, x26, [x1, #48]
+	ldp x27, x28, [x1, #64]
+	ldp x29, x30, [x1, #80]
+	ldp x9, x8, [x1, #96] //real sp, resume addr
+	ldp d8, d9, [x1, #112]
+	ldp d10, d11, [x1, #128]
+	ldp d12, d13, [x1, #144]
+	ldp d14, d15, [x1, #160]
+	ldp x0, x1, [x1, #176] //args for fresh ctx
+
+	mov sp, x9
+	br x8
 #endif
