+static inline int
+slaxNodePushCompat (xmlParserCtxtPtr ctxt, xmlNodePtr value)
+{
+    xmlNodePtr *tmp;
+    int max_depth, new_size, extra;
+
+    if (ctxt == NULL)
+        return 0;
+
+    if (ctxt->nodeNr >= ctxt->nodeMax) {
+        max_depth = (ctxt->options & XML_PARSE_HUGE) ? 2048 : 256;
+
+        if (ctxt->nodeMax <= 0) {
+            new_size = 10;
+        } else {
+            if (ctxt->nodeMax >= max_depth)
+                return -1;
+
+            extra = (ctxt->nodeMax + 1) / 2;
+            if (ctxt->nodeMax > max_depth - extra)
+                new_size = max_depth;
+            else
+                new_size = ctxt->nodeMax + extra;
+        }
+
+        tmp = xmlRealloc(ctxt->nodeTab,
+                         (size_t) new_size * sizeof(tmp[0]));
+        if (tmp == NULL)
+            return -1;
+
+        ctxt->nodeTab = tmp;
+        ctxt->nodeMax = new_size;
+    }
+
+    ctxt->nodeTab[ctxt->nodeNr] = value;
+    ctxt->node = value;
+    return ctxt->nodeNr++;
+}
+static inline xmlNodePtr
+slaxNodePopCompat (xmlParserCtxtPtr ctxt)
+{
+    xmlNodePtr ret;
+
+    if (ctxt == NULL || ctxt->nodeNr <= 0)
+        return NULL;
+
+    ctxt->nodeNr--;
+
+    if (ctxt->nodeNr > 0)
+        ctxt->node = ctxt->nodeTab[ctxt->nodeNr - 1];
+    else
+        ctxt->node = NULL;
+
+    ret = ctxt->nodeTab[ctxt->nodeNr];
+    ctxt->nodeTab[ctxt->nodeNr] = NULL;
+
+    return ret;
+}
+
+#define nodePush slaxNodePushCompat
+#define nodePop slaxNodePopCompat
