+#ifndef HAVE_GETPASS
 static char *
+slaxIoGetpassFallback (const char *prompt)
+{
+    char buffer[BUFSIZ];
+    struct termios old_term, new_term;
+    int changed = 0;
+
+    if (prompt) {
+        fputs(prompt, stderr);
+        fflush(stderr);
+    }
+
+    if (tcgetattr(STDIN_FILENO, &old_term) == 0) {
+        new_term = old_term;
+        new_term.c_lflag &= ~ECHO;
+        if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &new_term) == 0)
+            changed = 1;
+    }
+
+    if (fgets(buffer, sizeof(buffer), stdin) == NULL) {
+        if (changed) {
+            tcsetattr(STDIN_FILENO, TCSAFLUSH, &old_term);
+            fputc(10, stderr);
+        }
+        return NULL;
+    }
+
+    if (changed) {
+        tcsetattr(STDIN_FILENO, TCSAFLUSH, &old_term);
+        fputc(10, stderr);
+    }
+
+    buffer[strcspn(buffer, "\r\n")] = 0;
+    return (char *) xmlStrdup((const xmlChar *) buffer);
+}
+#endif
