--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -92,7 +92,11 @@
 configure_file(libkolabxml-version.h.cmake "${CMAKE_BINARY_DIR}/libkolabxml-version.h" @ONLY)
 
 set(Boost_USE_MULTITHREADED ON)
-find_package(Boost REQUIRED COMPONENTS thread system)
+# OHOS adaptation: boost/1.90.0 conan package is header-only for thread/system
+# (no compiled boost_thread/boost_system libraries). The thread-specific-ptr
+# usages were replaced with C++11 thread_local (see utils.cpp and
+# XMLParserWrapper.cpp patches), so headers-only Boost is sufficient.
+find_package(Boost REQUIRED)
 if (Boost_FOUND)
     message("Found boost in ${Boost_INCLUDE_DIRS}")
 endif (Boost_FOUND)
@@ -144,29 +148,53 @@
 #xsdcxx cxx-tree --generate-xml-schema --generate-serialization --custom-type date_time --hxx-epilogue '#include "bindings/customtypes/xml-schema-custom.hxx"' xml-schema.xsd
 # --generate-inline --extern-xml-schema xml-schema.xsd
 # --cxx-suffix .cpp --hxx-suffix .h   
-add_custom_command(OUTPUT ${SCHEMA_SOURCEFILES}
-    COMMAND ${XSDCXX} cxx-tree --generate-polymorphic --generate-serialization  --namespace-map http://kolab.org=KolabXSD --root-element icalendar --root-element vcards --root-element note --root-element configuration --root-element file --output-dir ${CMAKE_BINARY_DIR}/bindings ${SCHEMAS}
-    COMMENT "Generating XSD bindings"
-    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
-    DEPENDS ${SCHEMAS}
-    VERBATIM
-    )
-
-# Compile xsdbin if not found
-if (NOT XSDBIN_FOUND)
-    add_executable(xsdbin compiled/xsdbin.cxx)
-    target_link_libraries(xsdbin ${XERCES_C})
-    set(XSDBIN ${CMAKE_BINARY_DIR}/xsdbin)
-endif ()
-
-# Compile Schemas
-add_custom_command(OUTPUT kolabformat-xcal-schema.cxx
-        COMMAND ${XSDBIN} --verbose --array-name iCalendar_schema --output-dir ${CMAKE_BINARY_DIR} ${SCHEMAS}
-        COMMENT "Compiling Kolab XSD schema"
+# OHOS adaptation: pre-generated bindings (XSD 4.0.0, --std c++11) are
+# copied to the build dir instead of running xsdcxx on cross-compile CI.
+if (XSDCXX STREQUAL "xsd-pre-generated")
+    add_custom_command(OUTPUT ${SCHEMA_SOURCEFILES}
+        COMMAND ${CMAKE_COMMAND} -E copy_directory ${CMAKE_SOURCE_DIR}/bindings ${CMAKE_BINARY_DIR}/bindings
+        COMMENT "Copying pre-generated XSD bindings"
         WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
-        DEPENDS ${SCHEMAS} ${XSDBIN}
         VERBATIM
-    )
+        )
+else()
+    add_custom_command(OUTPUT ${SCHEMA_SOURCEFILES}
+        COMMAND ${XSDCXX} cxx-tree --generate-polymorphic --generate-serialization  --namespace-map http://kolab.org=KolabXSD --root-element icalendar --root-element vcards --root-element note --root-element configuration --root-element file --output-dir ${CMAKE_BINARY_DIR}/bindings ${SCHEMAS}
+        COMMENT "Generating XSD bindings"
+        WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
+        DEPENDS ${SCHEMAS}
+        VERBATIM
+        )
+endif()
+
+# OHOS adaptation: xsdbin (host tool) cannot run on cross-compile CI
+# workers; the compiled schema array is pre-generated and shipped as
+# kolabformat-xcal-schema.cxx in the source tree.
+if (XSDCXX STREQUAL "xsd-pre-generated")
+    add_custom_command(OUTPUT kolabformat-xcal-schema.cxx
+        COMMAND ${CMAKE_COMMAND} -E copy ${CMAKE_SOURCE_DIR}/kolabformat-xcal-schema.cxx ${CMAKE_BINARY_DIR}/kolabformat-xcal-schema.cxx
+        COMMAND ${CMAKE_COMMAND} -E copy ${CMAKE_SOURCE_DIR}/kolabformat-xcal-schema.hxx ${CMAKE_BINARY_DIR}/kolabformat-xcal-schema.hxx
+        COMMENT "Copying pre-compiled Kolab XSD schema"
+        WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
+        VERBATIM
+        )
+else()
+    # Compile xsdbin if not found
+    if (NOT XSDBIN_FOUND)
+        add_executable(xsdbin compiled/xsdbin.cxx)
+        target_link_libraries(xsdbin ${XERCES_C})
+        set(XSDBIN ${CMAKE_BINARY_DIR}/xsdbin)
+    endif ()
+
+    # Compile Schemas
+    add_custom_command(OUTPUT kolabformat-xcal-schema.cxx
+            COMMAND ${XSDBIN} --verbose --array-name iCalendar_schema --output-dir ${CMAKE_BINARY_DIR} ${SCHEMAS}
+            COMMENT "Compiling Kolab XSD schema"
+            WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
+            DEPENDS ${SCHEMAS} ${XSDBIN}
+            VERBATIM
+        )
+endif()
 
 set( SCHEMA_SOURCEFILES ${SCHEMA_SOURCEFILES} ${CMAKE_BINARY_DIR}/kolabformat-xcal-schema.cxx)
 
