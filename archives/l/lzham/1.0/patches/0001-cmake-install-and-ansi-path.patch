diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,8 +1,89 @@
-# PROJECT(lzham)
-cmake_minimum_required(VERSION 2.8)
-option(BUILD_X64 "build 64-bit" TRUE)
-
-add_subdirectory(lzhamdecomp)
-add_subdirectory(lzhamcomp)
-add_subdirectory(lzhamdll)
-add_subdirectory(lzhamtest)
+cmake_minimum_required(VERSION 3.15)
+project(lzham LANGUAGES C CXX)
+
+include(GNUInstallDirs)
+
+option(BUILD_SHARED_LIBS "Build shared libraries" OFF)
+option(LZHAM_BUILD_TESTS "Build the upstream test executable" OFF)
+option(LZHAM_ANSI_CPLUSPLUS "Use the portable single-threaded implementation" ON)
+
+set(LZHAM_SOURCES
+    lzhamdecomp/lzham_assert.cpp
+    lzhamdecomp/lzham_checksum.cpp
+    lzhamdecomp/lzham_huffman_codes.cpp
+    lzhamdecomp/lzham_lzdecomp.cpp
+    lzhamdecomp/lzham_lzdecompbase.cpp
+    lzhamdecomp/lzham_mem.cpp
+    lzhamdecomp/lzham_platform.cpp
+    lzhamdecomp/lzham_prefix_coding.cpp
+    lzhamdecomp/lzham_symbol_codec.cpp
+    lzhamdecomp/lzham_timer.cpp
+    lzhamdecomp/lzham_vector.cpp
+    lzhamcomp/lzham_lzbase.cpp
+    lzhamcomp/lzham_lzcomp.cpp
+    lzhamcomp/lzham_lzcomp_internal.cpp
+    lzhamcomp/lzham_lzcomp_state.cpp
+    lzhamcomp/lzham_match_accel.cpp
+    lzhamlib/lzham_lib.cpp
+)
+
+add_library(lzham ${LZHAM_SOURCES})
+if(LZHAM_ANSI_CPLUSPLUS)
+    target_compile_definitions(lzham PRIVATE LZHAM_ANSI_CPLUSPLUS=1)
+endif()
+target_compile_definitions(lzham PRIVATE
+    _FILE_OFFSET_BITS=64
+    _LARGEFILE64_SOURCE=1
+)
+if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
+    target_compile_options(lzham PRIVATE -fno-strict-aliasing)
+endif()
+set_target_properties(lzham PROPERTIES
+    CXX_STANDARD 98
+    CXX_STANDARD_REQUIRED YES
+    CXX_EXTENSIONS YES
+)
+target_include_directories(lzham
+    PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
+        $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+    PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}/lzhamdecomp
+        ${CMAKE_CURRENT_SOURCE_DIR}/lzhamcomp
+)
+
+install(TARGETS lzham
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+)
+install(DIRECTORY include/
+    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+    FILES_MATCHING
+        PATTERN "*.h"
+        PATTERN "*.inc"
+)
+
+if(LZHAM_BUILD_TESTS)
+    enable_testing()
+    add_executable(lzhamtest
+        lzhamtest/lzhamtest.cpp
+        lzhamtest/timer.cpp
+    )
+    target_compile_definitions(lzhamtest PRIVATE LZHAM_USE_LZHAM_DLL=0)
+    target_include_directories(lzhamtest PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}/include
+        ${CMAKE_CURRENT_SOURCE_DIR}/lzhamdecomp
+        ${CMAKE_CURRENT_SOURCE_DIR}/lzhamcomp
+    )
+    set_target_properties(lzhamtest PROPERTIES
+        CXX_STANDARD 98
+        CXX_STANDARD_REQUIRED YES
+        CXX_EXTENSIONS YES
+    )
+    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
+        target_compile_options(lzhamtest PRIVATE -fno-strict-aliasing)
+    endif()
+    target_link_libraries(lzhamtest PRIVATE lzham)
+    add_test(NAME lzham_upstream_smoke COMMAND lzhamtest)
+endif()
