--- a/lzhamdecomp/lzham_mem.cpp
+++ b/lzhamdecomp/lzham_mem.cpp
@@ -22,6 +22,28 @@
    #endif
 #endif
 
+#if defined(__linux__)
+   static void* lzham_aligned_malloc(size_t size)
+   {
+      void* p = NULL;
+      if (posix_memalign(&p, LZHAM_MIN_ALLOC_ALIGNMENT, size) != 0)
+         return NULL;
+      return p;
+   }
+
+   static void* lzham_aligned_realloc(void* p, size_t size)
+   {
+      void* p_new = lzham_aligned_malloc(size);
+      if (p_new)
+      {
+         const size_t old_size = _msize(p);
+         memcpy(p_new, p, old_size < size ? old_size : size);
+         free(p);
+      }
+      return p_new;
+   }
+#endif
+
 namespace lzham
