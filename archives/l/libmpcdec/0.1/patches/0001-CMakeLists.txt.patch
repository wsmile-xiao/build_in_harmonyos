--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,33 +1,27 @@
-CMAKE_MINIMUM_REQUIRED(VERSION 2.4)
+CMAKE_MINIMUM_REQUIRED(VERSION 3.5)
 cmake_policy(SET CMP0003 NEW)
 include(TestBigEndian)
 
 project(libmpc C)
 
 set(CMAKE_VERBOSE_MAKEFILE false)
 TEST_BIG_ENDIAN(MPC_ENDIANNESS)
 
 if(WIN32)
   option(SHARED "Use shared libmpcdec" OFF)
 else(WIN32)
   option(SHARED "Use shared libmpcdec" ON)
 endif(WIN32)
 
 add_definitions(-DFAST_MATH -DCVD_FASTLOG)
 
 if(NOT MSVC)
-  set(CMAKE_C_FLAGS "-O3 -Wall -fomit-frame-pointer -pipe")
+  # append instead of overwrite so toolchain/env CFLAGS (conan) survive;
+  # -fcommon: legacy tables (Res_bit/__Cc/__Dc) are defined in several
+  # translation units (mpc_decoder.c/requant.c); modern clang defaults to
+  # -fno-common and the duplicate-symbol link would fail.
+  set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -O3 -Wall -fomit-frame-pointer -pipe -fcommon")
 endif(NOT MSVC)
 
 add_subdirectory(libmpcdec)
-add_subdirectory(libmpcpsy)
-add_subdirectory(libmpcenc)
-add_subdirectory(libwavformat)
-add_subdirectory(mpcgain)
-add_subdirectory(mpcdec)
-add_subdirectory(mpcenc)
-add_subdirectory(mpc2sv8)
-add_subdirectory(mpccut)
-add_subdirectory(mpcchap)
-add_subdirectory(wavcmp)
 add_subdirectory(include)
