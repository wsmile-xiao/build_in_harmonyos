 /* atm.h - Functions useful for ATM applications */
  
 /* Written 1995-2000 by Werner Almesberger, EPFL-LRC/ICA */
  
 
 #ifndef _ATM_H
 #define _ATM_H
 
 #include <stdint.h>
 #include <sys/socket.h>
+
+#ifndef _UAPI_LINUX_SOCKET_H
+/*
+ * HarmonyOS: <linux/socket.h> redefines struct sockaddr_storage, which
+ * <sys/socket.h> already provides.  Suppress the duplicate definition while
+ * keeping the uapi __kernel_sa_family_t type that other kernel headers
+ * (e.g. <linux/netlink.h>) still expect to get from <linux/socket.h>.
+ */
+typedef unsigned short __kernel_sa_family_t;
+#define _UAPI_LINUX_SOCKET_H
+#endif
+
 #include <linux/atm.h>
 
 #ifdef  __cplusplus
 extern "C" {
