  */
 
@@ -35,20 +47,37 @@
 #endif
 
 #ifndef SOL_ATM
 #define SOL_ATM		264
 #endif
 
 #ifndef SOL_AAL
 #define SOL_AAL		265
 #endif
 
+
+/*
+ * The classic <linux/atm.h> used to define these two convenience helpers as
+ * static inline functions; current kernel headers (and the HarmonyOS sysroot)
+ * no longer provide them.  Define them here so the tools stay self-contained.
+ * An address counts as "in use" if any of its fields is set.
+ */
+
+static __inline__ int atmpvc_addr_in_use(struct sockaddr_atmpvc addr)
+{
+	return addr.sap_addr.itf || addr.sap_addr.vpi || addr.sap_addr.vci;
+}
+
+static __inline__ int atmsvc_addr_in_use(struct sockaddr_atmsvc addr)
+{
+	return *addr.sas_addr.prv || *addr.sas_addr.pub;
+}
 
 #define HOSTS_ATM "/etc/hosts.atm"
 
 /* text2atm flags */
 #define T2A_PVC		  1	/* address is PVC */
 #define T2A_SVC		  2	/* address is SVC */
 #define T2A_UNSPEC	  4	/* allow unspecified parts in PVC address */
 #define T2A_WILDCARD	  8	/* allow wildcards in PVC or SVC address */
 #define T2A_NNI		 16	/* allow NNI VPI range (PVC) */
 #define T2A_NAME	 32	/* allow name resolution */
