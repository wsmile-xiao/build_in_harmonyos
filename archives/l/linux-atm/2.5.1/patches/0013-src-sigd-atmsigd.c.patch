--- a/src/sigd/atmsigd.c
+++ b/src/sigd/atmsigd.c
@@ -292,20 +292,32 @@
     if (!dump_dir) file = stderr;
     else {
 	sprintf(path,"atmsigd.%d.trace.exit",getpid());
 	if (!(file = fopen(path,"w"))) {
 	    perror(path);
 	    file = stderr;
 	}
     }
     dump_trace(file,"Message trace (after error exit)");
     if (file != stderr) (void) fclose(file);
+}
+
+
+/*
+ * on_exit() is a glibc-specific interface that is not available on all C
+ * libraries (e.g. the musl-based HarmonyOS libc).  atexit() is portable but
+ * does not pass the exit status, so the trace is dumped on every exit.
+ */
+
+static void trace_at_exit(void)
+{
+    trace_on_exit(1,NULL);
 }
 
 
 static void manual_override(void)
 {
      /*
       * Gross hack to avoid changing the command-line parameters ... @@@
       */
      entities = &_entity;
      _entity.next = NULL;
@@ -510,16 +522,16 @@
 	pid_t pid;
 
 	pid = fork();
 	if (pid < 0)
 	    diag(COMPONENT,DIAG_FATAL,"fork: %s",strerror(errno));
 	if (pid) {
 	    diag(COMPONENT,DIAG_DEBUG,"Backgrounding (PID %d)",pid);
 	    exit(0);
 	}
     }
-    (void) on_exit(trace_on_exit,NULL);
+    (void) atexit(trace_at_exit);
     poll_loop();
     close_all();
