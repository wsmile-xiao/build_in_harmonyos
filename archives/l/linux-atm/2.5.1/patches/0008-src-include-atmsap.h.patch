--- a/src/include/atmsap.h
+++ b/src/include/atmsap.h
@@ -5,20 +5,35 @@
 
 #ifndef _ATMSAP_H
 #define _ATMSAP_H
 
 #include <stdint.h>
 #include <linux/atmsap.h>
 
 #ifdef __cplusplus
 extern "C" {
 #endif
+
+/*
+ * blli_in_use - Non-zero if a BLLI entry carries any information.
+ *
+ * An atm_blli with both l2_proto and l3_proto cleared is unused.  The
+ * upstream 2.5.1/2.5.2 tarballs reference this helper from sapequal.c,
+ * sap2text.c and sigd/sap.c without providing a definition; GNU ld
+ * tolerates the resulting undefined symbol in libatm.so, but lld (used by
+ * the HarmonyOS toolchain) rejects it.
+ */
+
+static __inline__ int blli_in_use(struct atm_blli blli)
+{
+	return blli.l2_proto || blli.l3_proto;
+}
 
