--- a/config/config.guess
+++ b/config/config.guess
@@ -141,38 +141,50 @@
 	# We could probably try harder.
 	LIBC=gnu
 
 	set_cc_for_build
 	cat <<-EOF > "$dummy.c"
 	#include <features.h>
 	#if defined(__UCLIBC__)
 	LIBC=uclibc
 	#elif defined(__dietlibc__)
 	LIBC=dietlibc
+	#elif defined(__OHOS__)
+	LIBC=ohos
 	#else
 	LIBC=gnu
 	#endif
 	EOF
 	eval "`$CC_FOR_BUILD -E "$dummy.c" 2>/dev/null | grep '^LIBC' | sed 's, ,,g'`"
 
 	# If ldd exists, use it to detect musl libc.
 	if command -v ldd >/dev/null && \
 		ldd --version 2>&1 | grep -q ^musl
 	then
 	    LIBC=musl
 	fi
 	;;
 esac
 
 # Note: order is significant - the case branches are not exclusive.
 
 case "$UNAME_MACHINE:$UNAME_SYSTEM:$UNAME_RELEASE:$UNAME_VERSION" in
+    *:HarmonyOS:*:*)
+	case "$UNAME_MACHINE" in
+	    aarch64|arm64) echo aarch64-unknown-linux-ohos; exit ;;
+	    armv7*|armv8*) echo arm-unknown-linux-ohos; exit ;;
+	    x86_64|amd64)  echo x86_64-unknown-linux-ohos; exit ;;
+	    i?86)          echo i686-unknown-linux-ohos; exit ;;
+	    *)             echo ${UNAME_MACHINE}-unknown-linux-ohos; exit ;;
+	esac
+	;;
+
     *:NetBSD:*:*)
 	# NetBSD (nbsd) targets should (where applicable) match one or
 	# more of the tuples: *-*-netbsdelf*, *-*-netbsdaout*,
 	# *-*-netbsdecoff* and *-*-netbsd*.  For targets that recently
 	# switched to ELF, *-*-netbsd* would select the old
 	# object file format.  This provides both forward
 	# compatibility and a consistent mechanism for selecting the
 	# object file format.
 	#
 	# Note: NetBSD doesn't particularly care about the vendor
