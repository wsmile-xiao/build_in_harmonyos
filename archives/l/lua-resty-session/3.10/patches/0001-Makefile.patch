diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,4 +1,13 @@
-.PHONY: lint
+.PHONY: lint install
+
+PREFIX ?= /usr/local
+DESTDIR ?=
 
 lint:
 	@luacheck -q ./lib
+
+install:
+	@echo "Installing lua-resty-session to $(DESTDIR)$(PREFIX)/share/lua/5.4/resty/"
+	@mkdir -p $(DESTDIR)$(PREFIX)/share/lua/5.4/resty
+	@cp -r lib/resty/* $(DESTDIR)$(PREFIX)/share/lua/5.4/resty/
+	@echo "Installation complete"
