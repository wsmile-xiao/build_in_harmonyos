 #define MAT_MKTEMP_TPL "XXXXXX"
 #define MAT_MKTEMP_FILE "/temp.mat"

+/* Sized for a TMPDIR-based template: TMPDIR may be an arbitrarily long
+   path (POSIX allows up to PATH_MAX), unlike the hardcoded "/tmp/"
+   the original size was computed for (21 bytes). PATH_MAX is not
+   guaranteed by strict POSIX (e.g. GNU/Hurd defines none), so fall
+   back to a conservative 4096 there. */
+#ifndef PATH_MAX
+#define MAT_MKTEMP_PATH_MAX 4096
+#else
+#define MAT_MKTEMP_PATH_MAX PATH_MAX
+#endif
 #define MAT_MKTEMP_BUF_SIZE \
-    (sizeof(MAT_MKTEMP_DIR) + sizeof(MAT_MKTEMP_TPL) + sizeof(MAT_MKTEMP_FILE) - 2)
+    (MAT_MKTEMP_PATH_MAX + sizeof(MAT_MKTEMP_TPL) + sizeof(MAT_MKTEMP_FILE))
+
+/* Prefer the TMPDIR environment variable over the hardcoded /tmp:
+   on HarmonyOS (ohos) the root filesystem is read-only, so mkdtemp()
+   against the hardcoded /tmp fails and every Mat_VarDelete() call
+   errors out with "Cannot create a unique file name".
+   TMPDIR is the POSIX-blessed override, so honor it when set and
+   fall back to /tmp otherwise (with a '/' separator inserted).
+   Returns the mkdtemp() template "<tmpdir>/XXXXXX". */
+static const char *
+Mat_TmpDirTemplate(void)
+{
+    static char tpl_buf[MAT_MKTEMP_BUF_SIZE];
+    const char *env = getenv("TMPDIR");
+
+    if ( NULL != env && '\0' != *env ) {
+        size_t len = strlen(env);
+        if ( len + sizeof(MAT_MKTEMP_TPL) + 2 > sizeof(tpl_buf) )
+            return MAT_MKTEMP_DIR MAT_MKTEMP_TPL;
+        if ( '/' == env[len - 1] )
+            snprintf(tpl_buf, sizeof(tpl_buf), "%s%s", env, MAT_MKTEMP_TPL);
+        else
+            snprintf(tpl_buf, sizeof(tpl_buf), "%s/%s", env, MAT_MKTEMP_TPL);
+        return tpl_buf;
+    }
+    return MAT_MKTEMP_DIR MAT_MKTEMP_TPL;
+}

