--- configure.orig	2026-08-27 01:41:44.297661875 +0800
+++ configure	2026-08-27 01:41:44.569660625 +0800
@@ -29948,12 +29948,12 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 000 && mktemp -d "${TMPDIR:-/tmp}/confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  tmp=${TMPDIR:-/tmp}/conf$$-$RANDOM
+  (umask 000 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
