From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: hw-4 <hw-4@local>
Date: Thu, 24 Sep 2026 12:00:00 +0800
Subject: [PATCH] tests: replace tmpfile() with a portable $TMPDIR fallback in
 test helpers

tmpfile() is not portable across libcs: musl always creates the file
under a hardcoded /tmp (ignoring $TMPDIR), which is read-only in the
OHOS sandbox. Use a unique file under $TMPDIR (falling back to P_tmpdir)
and unlink it immediately - the fd stays valid until fclose, exactly like
tmpfile(). Pure POSIX: getenv/fopen/unlink.

Same fix as the one already shipped in archives/l/libei/1.5.0, with the
hunk re-based onto 1.6.0's src/util-io.c (the anchor block moved by 5
lines, context otherwise identical).
---
 src/util-io.c | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/src/util-io.c b/src/util-io.c
index 3315ab6..33ac9e6 100644
--- a/src/util-io.c
+++ b/src/util-io.c
@@ -435,6 +435,35 @@ iobuf_free(struct iobuf *buf)
 #include "util-munit.h"
 #include "util-strings.h"
 
+/* tmpfile() is not portable across libcs: musl's implementation always
+ * creates the file under a hardcoded /tmp (ignoring $TMPDIR), which is
+ * read-only in the OHOS sandbox. Replace it with a unique file under
+ * $TMPDIR (falling back to P_tmpdir) that is unlinked immediately —
+ * the fd stays valid until fclose, exactly like tmpfile(). Pure POSIX:
+ * getenv/fopen/unlink. */
+static FILE *test_tmpfile(void)
+{
+	static unsigned int seq;
+	const char *tmpdir = getenv("TMPDIR");
+	char path[512];
+	FILE *fp;
+
+	if (tmpdir == NULL || *tmpdir == '\0')
+#ifdef P_tmpdir
+		tmpdir = P_tmpdir;
+#else
+		tmpdir = "/tmp";
+#endif
+	snprintf(path, sizeof(path), "%s/libei-test-tmpf-%ld-%u.tmp", tmpdir,
+		 (long)getpid(), seq++);
+	fp = fopen(path, "w+");
+	if (fp == NULL)
+		return NULL;
+	unlink(path);
+	return fp;
+}
+#define tmpfile() test_tmpfile()
+
 MUNIT_TEST(test_iobuf_new)
 {
 	/* test allocation and freeing a buffer */
