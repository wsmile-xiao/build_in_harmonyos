 #ifndef _LAYERSURFACE_H
+// OHOS: Qt 6.11.1's QtWaylandClient private headers
+// (qwayland-wayland.h -> wayland-wayland-client-protocol.h) declare the
+// wl_fixes protocol interface, which the wayland 1.22 protocol header does
+// not contain. Both protocol headers share the same include guard
+// (WAYLAND_CLIENT_PROTOCOL_H); if <wayland-client.h> is included first the
+// Qt one is skipped and `struct ::wl_fixes` is missing at compile time.
+// Include the Qt protocol header first so wl_fixes is declared, then let
+// <wayland-client.h> provide the client API functions (its protocol header
+// part is guarded out, which is fine -- the Qt header declares the same
+// core protocol structs).
+#include <QtWaylandClient/private/wayland-wayland-client-protocol.h>
 #define _LAYERSURFACE_H
 
 #include <wayland-client.h>
