--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -45,7 +45,14 @@
 find_package(WaylandProtocols REQUIRED)
 find_package(PkgConfig REQUIRED)
 
-pkg_check_modules(XKBCOMMON xkbcommon REQUIRED IMPORTED_TARGET)
+# OHOS: libxkbcommon pkg-config ships prefix=/ (broken include path).
+# Resolve xkbcommon directly instead of through pkg-config.
+find_path(XKBCOMMON_INCLUDE_DIR xkbcommon/xkbcommon.h)
+find_library(XKBCOMMON_LIBRARY NAMES xkbcommon)
+add_library(xkbcommon UNKNOWN IMPORTED)
+set_target_properties(xkbcommon PROPERTIES
+    IMPORTED_LOCATION "${XKBCOMMON_LIBRARY}"
+    INTERFACE_INCLUDE_DIRECTORIES "${XKBCOMMON_INCLUDE_DIR}")
 
 set_package_properties(Wayland PROPERTIES
                        TYPE REQUIRED)
