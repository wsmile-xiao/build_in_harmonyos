 template<typename T>
 static void ExtractResults ( T && tPQ, std::vector<DocDist_t> & dResults )
 {
 	dResults.resize(0);
 	dResults.reserve ( tPQ.size() );
+
+	// Handle both priority_queue and vector types
+	// priority_queue has top() and pop(), vector has back() and pop_back()
 	while ( !tPQ.empty() )
 	{
-		dResults.push_back ( { (uint32_t)tPQ.top().second, (float)tPQ.top().first } );
-		tPQ.pop();
+		// Use back() for vector, top() for priority_queue
+		#if __cplusplus >= 201703L
+		if constexpr (std::is_same_v<T, std::vector<std::pair<float, unsigned long>>>)
+		{
+			dResults.push_back ( { (uint32_t)tPQ.back().second, (float)tPQ.back().first } );
+			tPQ.pop_back();
+		}
+		else
+		{
+			dResults.push_back ( { (uint32_t)tPQ.top().second, (float)tPQ.top().first } );
+			tPQ.pop();
+		}
+		#else
+		// Fallback for older C++ standards - try back() first
+		auto & item = tPQ.back();
+		dResults.push_back ( { (uint32_t)item.second, (float)item.first } );
+		tPQ.pop_back();
+		#endif
 	}
 }
 
 
