--- a/configure
+++ b/configure
@@ -16129,10 +16129,10 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 007 && mktemp -d "${TMPDIR:-$HOME/tmp}/confXXXXXX") 2>/dev/null` &&
