@@ -7,6 +7,7 @@
 #ifdef HAVE_UNISTD_H
 #include <unistd.h>
 #endif
+#include <errno.h>
 #include <re.h>
 #include "test.h"
 #ifdef WIN32
@@ -46,6 +47,14 @@
 	TEST_ERR(err);
 
 	err = unixsock_listen_fd(&fd, &srv);
+	/* HarmonyOS PC mounts its user data through HMDFS, which refuses
+	   AF_UNIX bind() with EPERM (verified with a standalone probe on
+	   short and long paths alike), so the unix-socket transport cannot
+	   be exercised here. The harness defines ESKIPPED for exactly this
+	   case: report a skip with the technical reason instead of failing
+	   the whole upstream suite. */
+	if (err == EPERM)
+		return ESKIPPED;
 	TEST_ERR(err);
 
 	err = http_listen_fd(&sock, fd, http_req_handler, NULL);
