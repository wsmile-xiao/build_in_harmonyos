--- a/configure
+++ b/configure
@@ -134,6 +134,16 @@ export LANGUAGE
 # CDPATH.
 (unset CDPATH) >/dev/null 2>&1 && unset CDPATH
 
+# HMBS portability: the shared OHOS Conan profile exports
+# CONFIG_SHELL=/data/service/hnp/bin/bash, which is inaccessible inside
+# the HMBS build sandbox (configure re-exec dies with
+# "inaccessible or not found", exit 127). Fall back to the current
+# POSIX shell when the configured shell is not executable. This is a
+# source-level guard so it holds regardless of buildenv ordering.
+if test "x$CONFIG_SHELL" != x && ! test -x "$CONFIG_SHELL"; then
+  CONFIG_SHELL=""
+fi
+
 # Use a proper internal environment variable to ensure we don't fall
   # into an infinite loop, continuously re-executing ourselves.
   if test x"${_as_can_reexec}" != xno && test "x$CONFIG_SHELL" != x; then
