-
-	password = getpass ("Password: ");
+	gchar buf[512];
+	size_t len;
+
+	/* Portable replacement for getpass(): bionic exposes getpass with an
+	 * incompatible declaration. Read from stdin without echo instead. */
+	fputs ("Password: ", stderr);
+	fflush (stderr);
+	if (fgets (buf, sizeof (buf), stdin) == NULL)
+		buf[0] = '\0';
+	len = strlen (buf);
+	while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r'))
+		buf[--len] = '\0';
+	password = g_strdup (buf);
 	return secret_value_new_full (password, -1, "text/plain",
 	                              (GDestroyNotify)secret_password_wipe);
 }
 
