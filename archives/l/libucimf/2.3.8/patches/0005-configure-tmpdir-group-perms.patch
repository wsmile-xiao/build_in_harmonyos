--- a/configure
+++ b/configure
@@ -16863,13 +16863,39 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=
+  # OHOS(aarch64)/HMDFS: on /storage volumes new dirs get a remapped owner
+  # (20001006) while the CI worker runs as another uid that can neither write
+  # into nor chmod a mode-700 dir (autoconf's "umask 077 && mktemp -d"), so
+  # config.status dies with "can't create .../subs1.awk: Permission denied".
+  # Probe candidate dirs with a real write and use the first writable one.
+  # The write probe runs in a subshell: under mksh a failed redirection on a
+  # special builtin (e.g. ": > file") aborts the whole shell, and the error
+  # bypasses "2>/dev/null" because it fires before that redirect takes effect.
+  # Note the probe must write INSIDE the candidate: on HMDFS any dir we
+  # create is mode 700 and unwritable even under a writable parent, so
+  # mktemp/mkdir success alone proves nothing.
+  for ac_ohos_d in ${TMPDIR:-} /data/storage/el2/base/cache /data/cache /data/local/tmp
+  do
+    test -n "$ac_ohos_d" || continue
+    ac_ohos_t=`(umask 077 && mktemp -d "$ac_ohos_d/confXXXXXX") 2>/dev/null` &&
+    test -n "$ac_ohos_t" && test -d "$ac_ohos_t" || continue
+    if (echo probe > "$ac_ohos_t/.writable") 2>/dev/null; then
+      tmp=$ac_ohos_t
+      break
+    fi
+    rm -rf "$ac_ohos_t" 2>/dev/null || :
+  done
+  if test -z "$tmp"; then
+    # Last resort: build dir with a world-writable subdir (umask 000). Under
+    # the HMDFS owner remap a 700/755 dir we create is still unwritable for
+    # the worker, but a 0777 one is not (autoconf's own fallback used 0770).
+    ac_ohos_t=./conf$$-$RANDOM
+    (umask 000 && mkdir "$ac_ohos_t") &&
+    (echo probe > "$ac_ohos_t/.writable") 2>/dev/null && tmp=$ac_ohos_t
+  fi
   test -n "$tmp" && test -d "$tmp"
-}  ||
-{
-  tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
-} || as_fn_error "cannot create a temporary directory in ." "$LINENO" 5
+} || as_fn_error "cannot create a temporary directory in TMPDIR, /data or ." "$LINENO" 5
 
