 # 设置 CMAKE_INSTALL_LIBDIR 变量  
 set (CMAKE_INSTALL_LIBDIR ${CMAKE_INSTALL_LIBDIR})
 
-set (CMAKE_INSTALL_HEADER_DIR /usr/include/kysdk/kysdk-base)
