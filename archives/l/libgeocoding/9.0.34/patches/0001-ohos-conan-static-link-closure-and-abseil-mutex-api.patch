--- a/cpp/CMakeLists.txt
+++ b/cpp/CMakeLists.txt
@@ -429,6 +429,15 @@
 
 set (LIBRARY_DEPS ${ICU_LIB} ${PROTOBUF_LIB} absl::node_hash_set absl::strings absl::synchronization)
 
+# Conan/OHOS: append the remaining static dependency closure supplied by the
+# recipe (ICU common data, the Abseil libraries protobuf itself references,
+# utf8_range/utf8_validity and zlib).  Static archives do not carry their own
+# dependencies, and upstream only discovers icuuc/icui18n/protobuf plus three
+# Abseil targets, so the rest of the closure has to be appended explicitly.
+if (DEFINED LIBPHONENUMBER_CONAN_LIBS)
+  list (APPEND LIBRARY_DEPS ${LIBPHONENUMBER_CONAN_LIBS})
+endif ()
+
 if (USE_BOOST)
   list (APPEND LIBRARY_DEPS ${Boost_LIBRARIES})
 endif ()
@@ -568,6 +577,12 @@
   add_executable (libphonenumber_test ${TEST_SOURCES})
   set (TEST_LIBS phonenumber_testing ${GTEST_LIB})
 
+  # Conan/OHOS: the test executable links the static testing library directly,
+  # so it needs the same external closure as the libraries themselves.
+  if (DEFINED LIBPHONENUMBER_CONAN_LIBS)
+    list (APPEND TEST_LIBS ${LIBPHONENUMBER_CONAN_LIBS})
+  endif ()
+
   if (NOT WIN32)
     list (APPEND TEST_LIBS pthread)
   endif ()
