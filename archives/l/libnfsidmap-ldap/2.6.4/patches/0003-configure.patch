 # Create a (secure) tmp directory for tmp files.
+#
+# OHOS/HMDFS (E110/E112/E118, cln/1.3.7 CI-proven): `umask 077 && mktemp -d`
+# yields a 0700 directory (mktemp ignores umask), and on HMDFS such a
+# directory is not writable by the build user, so config.status dies with
+# "./confXXXXXX/subs1.awk: Permission denied".  Use a $$-based unique name
+# and create it with umask 000 so the permissions are decided at creation
+# time (chmod is ignored on HMDFS).
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=./conf$$-$RANDOM
+  (umask 000 && mkdir "$tmp")
   test -d "$tmp"
 }  ||
