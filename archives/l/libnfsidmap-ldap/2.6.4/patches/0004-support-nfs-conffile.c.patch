+/*
+ * musl-based libcs (the OHOS SDK one among them) provide neither
+ * versionsort() nor strverscmp(): both are GNU extensions that glibc
+ * declares in <dirent.h>/<string.h>.  conf_init_dir() below calls
+ * versionsort() unconditionally to sort the include files of the
+ * "conf.d" style directories (see conf_init_dir() below), so a libc
+ * without it cannot compile this file at all.
+ *
+ * Both symbols are therefore declared and defined here as weak.  The
+ * definitions are compiled unconditionally, without any platform
+ * conditional: where the libc exports a strong definition (glibc and
+ * friends) the linker prefers it and these definitions stay inert, and
+ * where the libc lacks the symbol (musl/OHOS) the weak definitions bind at
+ * link time.  strverscmp() keeps the GNU semantics (a digit run starting
+ * with '0' sorts first, otherwise the longer run is larger, equal-length
+ * runs are compared digit by digit and never accumulated into an integer,
+ * and all other differing bytes compare as plain bytes).
+ */
+int versionsort(const struct dirent **, const struct dirent **);
+int strverscmp(const char *, const char *);
+
+__attribute__((weak)) int strverscmp(const char *l0, const char *r0)
+{
+	const unsigned char *l = (const unsigned char *)l0;
+	const unsigned char *r = (const unsigned char *)r0;
+	size_t llen, rlen;
+
+	/* Find the first differing character. */
+	while (*l == *r) {
+		if (*l == '\0')
+			return 0;
+		++l;
+		++r;
+	}
+
+	if (isdigit(*l) && isdigit(*r)) {
+		/* Leading-zero rule: the run starting with '0' sorts first. */
+		if ((*l == '0') != (*r == '0'))
+			return (*l == '0') ? -1 : 1;
+
+		/* Skip the common leading zeros, then compare runs. */
+		while (*l == '0')
+			++l;
+		while (*r == '0')
+			++r;
+
+		/* Compare remaining digit-run lengths (no overflow). */
+		llen = 0;
+		while (isdigit(l[llen]))
+			++llen;
+		rlen = 0;
+		while (isdigit(r[rlen]))
+			++rlen;
+		if (llen != rlen)
+			return llen > rlen ? 1 : -1;
+
+		/* Equal lengths: compare digit-by-digit. */
+		while (llen-- > 0) {
+			if (*l != *r)
+				return (*l < *r) ? -1 : 1;
+			++l;
+			++r;
+		}
+		/* Digit runs equal; fall through to plain byte comparison. */
+	}
+
+	return (int)*l - (int)*r;
+}
+
+__attribute__((weak)) int versionsort(const struct dirent **a,
+				      const struct dirent **b)
+{
+	return strverscmp((*a)->d_name, (*b)->d_name);
+}
