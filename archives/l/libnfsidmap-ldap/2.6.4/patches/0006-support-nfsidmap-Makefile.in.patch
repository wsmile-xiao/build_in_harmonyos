+static_la_LIBADD = ../../support/nfs/libnfsconf.la libnfsidmap.la
 regex_la_SOURCES = regex.c
 regex_la_LDFLAGS = -module -avoid-version
-regex_la_LIBADD = ../../support/nfs/libnfsconf.la
+regex_la_LIBADD = ../../support/nfs/libnfsconf.la libnfsidmap.la
