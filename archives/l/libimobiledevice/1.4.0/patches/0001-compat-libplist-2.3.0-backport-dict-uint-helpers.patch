--- /dev/null
+++ b/tools/plist_dict_compat.h
@@ -0,0 +1,85 @@
+/*
+ * plist_dict_compat.h
+ * Backport of the libplist 2.6.0 dict uint helpers for libplist >= 2.3.0.
+ *
+ * libimobiledevice 1.4.0 tools (afcclient.c, idevicecrashreport.c,
+ * ideviceimagemounter.c, idevicebackup2.c) use plist_dict_get_uint() and
+ * plist_dict_copy_uint(), which were added in libplist 2.6.0. The OHOS
+ * Conan repository ships libplist/2.3.0 (pinned by this recipe and by
+ * libimobiledevice-glue), so we backport the exact upstream
+ * implementations (from libplist 2.6.0 src/plist.c) as static inline
+ * functions - the same approach as the merged libtatsu/1.0.5 recipe
+ * (patches/0001-compat-libplist-2.3.0-backport-dict-helpers.patch).
+ *
+ * All code below is Copyright (c) the libimobiledevice project authors,
+ * licensed under LGPL-2.1+, identical to the licenses of libplist and
+ * libimobiledevice. When the system libplist is >= 2.6.0 the real library
+ * functions are used instead (drop this header and the includes).
+ */
+
+#ifndef PLIST_DICT_COMPAT_H
+#define PLIST_DICT_COMPAT_H
+
+#include <plist/plist.h>
+#include <string.h>
+#include <stdlib.h>
+#include <inttypes.h>
+#include <endian.h>
+
+/* PLIST_OPT_NONE was added in libplist 2.6.0 alongside the plist_dict_*
+ * helpers; it is the documented "no options" value of
+ * plist_write_options_t (plain 0). */
+#ifndef PLIST_OPT_NONE
+#define PLIST_OPT_NONE 0
+#endif
+
+static inline uint64_t plist_dict_get_uint(plist_t dict, const char *key)
+{
+	uint64_t uintval = 0;
+	const char *strval = NULL;
+	uint64_t strsz = 0;
+	plist_t node = plist_dict_get_item(dict, key);
+	if (!node) {
+		return uintval;
+	}
+	switch (plist_get_node_type(node)) {
+	case PLIST_INT:
+		plist_get_uint_val(node, &uintval);
+		break;
+	case PLIST_STRING:
+		strval = plist_get_string_ptr(node, NULL);
+		if (strval) {
+			uintval = strtoull(strval, NULL, 0);
+		}
+		break;
+	case PLIST_DATA:
+		strval = plist_get_data_ptr(node, &strsz);
+		if (strval) {
+			if (strsz == 8) {
+				uintval = le64toh(*(uint64_t*)strval);
+			} else if (strsz == 4) {
+				uintval = le32toh(*(uint32_t*)strval);
+			} else if (strsz == 2) {
+				uintval = le16toh(*(uint16_t*)strval);
+			} else if (strsz == 1) {
+				uintval = strval[0];
+			}
+		}
+		break;
+	default:
+		break;
+	}
+	return uintval;
+}
+
+static inline plist_err_t plist_dict_copy_uint(plist_t target_dict, plist_t source_dict, const char *key, const char *alt_source_key)
+{
+	if (plist_dict_get_item(source_dict, (alt_source_key) ? alt_source_key : key) == NULL) {
+		return PLIST_ERR_INVALID_ARG;
+	}
+	uint64_t u64val = plist_dict_get_uint(source_dict, (alt_source_key) ? alt_source_key : key);
+	plist_dict_set_item(target_dict, key, plist_new_uint(u64val));
+	return PLIST_ERR_SUCCESS;
+}
+
+#endif /* PLIST_DICT_COMPAT_H */
