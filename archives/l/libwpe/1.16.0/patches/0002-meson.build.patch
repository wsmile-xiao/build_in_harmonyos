diff -ruN a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -53,25 +53,22 @@
 	)
 endif
 
 cc = meson.get_compiler('c')
 egl_dep = dependency('egl', required: false)
 if egl_dep.found()
 	dependencies += egl_dep.partial_dependency(
 		compile_args: true,
 		includes: true,
 	)
-elif target_machine.system() != 'windows'
-	assert(cc.has_header('EGL/eglplatform.h'),
-		'Required header <EGL/eglplatform.h> not found'
-	)
 endif
+# Skip EGL check on HarmonyOS platform
 
 if not cc.has_function('dlopen')
 	dl_dep = cc.find_library('dl', required: false)
 	if not dl_dep.found()
 		dl_dep = dependency('dl',
 			allow_fallback: target_machine.system() == 'windows',
 		)
 	endif
 	dependencies += dl_dep
 endif
