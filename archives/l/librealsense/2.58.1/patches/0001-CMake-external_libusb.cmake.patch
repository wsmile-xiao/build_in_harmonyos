diff -ruN a/CMake/external_libusb.cmake b/CMake/external_libusb.cmake
--- a/CMake/external_libusb.cmake
+++ b/CMake/external_libusb.cmake
@@ -1,25 +1,29 @@
 include(ExternalProject)
 
 ExternalProject_Add(
     libusb
     PREFIX libusb
     GIT_REPOSITORY "https://github.com/libusb/libusb-cmake.git"
-    GIT_TAG "v1.0.27-1" # "v1.0.27-1" 
+    GIT_TAG "v1.0.27-1" # "v1.0.27-1"
 
     UPDATE_COMMAND ""
-    PATCH_COMMAND ""
+    PATCH_COMMAND bash -c "echo 'Patching libusb for HarmonyOS...' && \
