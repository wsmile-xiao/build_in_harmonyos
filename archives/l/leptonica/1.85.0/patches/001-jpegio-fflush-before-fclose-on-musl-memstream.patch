--- a/src/jpegio.c	2024-10-17 03:32:44.000000000 +0800
+++ b/src/jpegio.c	2026-09-05 02:00:00.437936093 +0800
@@ -1131,7 +1131,17 @@
     if ((fp = open_memstream((char **)pdata, psize)) == NULL)
         return ERROR_INT("stream not opened", __func__, 1);
     ret = pixWriteStreamJpeg(fp, pix, quality, progressive);
+    /* OHOS musl: open_memstream() does not count the terminating NUL in
+     * *psize unless it is explicitly flushed before fclose(), unlike glibc
+     * where fclose() flushes it into *psize. Without this fflush(), *psize
+     * equals the raw jpeg byte count here and the -1 below truncates the
+     * last byte of the JPEG stream (the second byte of the EOI marker
+     * FF D9), so every subsequent pixReadMem() fails with "Premature end
+     * of JPEG file". With the fflush(), both glibc and musl report
+     * *psize == jpeg_bytes + 1 at this point and the -1 restores the
+     * exact size. Verified on HarmonyOS PC (musl). */
     fputc('\0', fp);
+    fflush(fp);
     fclose(fp);
     if (*psize > 0) *psize = *psize - 1;
 #else
