--- a/configure.ac
+++ b/configure.ac
@@ -45,11 +45,20 @@
 dnl ALL_LINGUAS is not needed with latest autotools
 dnl but debian maintainer still needs it
 dnl These languages should be a copy of po/LINGUAS
-ALL_LINGUAS="da de el eo es fr it nl pl rw sv"
-AM_GNU_GETTEXT(,need-ngettext)
-
-dnl codeset conversion library
-AM_ICONV
+dnl [OHOS portability] NLS is switched off for this port.  The 2007
+dnl AM_GNU_GETTEXT/AM_ICONV pair needs autopoint plus the vendored intl/
+dnl library, and that combination no longer bootstraps with autoconf 2.72
+dnl / automake 1.18 on HarmonyOS.  src/gedlib/llgettext.c already carries a
+dnl complete #if ENABLE_NLS fallback, so both programs keep working and
+dnl simply print untranslated (English) strings.  The AC_SUBST calls below
+dnl keep the @LIBINTL@ / @LIBICONV@ placeholders in src/*/Makefile.in valid.
+AC_SUBST(LIBINTL, [""])
+AC_SUBST(LTLIBINTL, [""])
+AC_SUBST(LIBICONV, [""])
+AC_SUBST(LTLIBICONV, [""])
+AC_SUBST(POSUB, [""])
+USE_NLS=no
+ENABLE_NLS=no
 
 dnl **************************************************************
 dnl Apply OS/Compiler-Specific Settings
@@ -271,6 +280,4 @@
         reports/st/Makefile \
         tt/Makefile \
         win32/Makefile \
-        build/Makefile \
-        intl/Makefile \
-        po/Makefile.in)
+        build/Makefile)
