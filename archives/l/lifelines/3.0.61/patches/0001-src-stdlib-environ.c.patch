--- a/src/stdlib/environ.c
+++ b/src/stdlib/environ.c
@@ -57,9 +57,17 @@
 	mktemp(win32_tempfile);
 	return win32_tempfile;
 #else
-	static char template[] = "/tmp/lltmpXXXXXX";
+	static char template[512] = "/tmp/lltmpXXXXXX";
 	int fd;
 	static char unix_tempfile[sizeof(template)];
+	/* OHOS portability: /tmp is not writable on HarmonyOS devices, so
+	 * honour TMPDIR (POSIX) before falling back to /tmp. */
+	{
+		const char *tmpdir = getenv("TMPDIR");
+		if (tmpdir && *tmpdir) {
+			snprintf(template, sizeof(template), "%s/lltmpXXXXXX", tmpdir);
+		}
+	}
 	strcpy(unix_tempfile, template);
 	/* security precaution */
 	/* fd = open(unix_tempfile, O_EXCL|O_CREAT|O_WRONLY, 0x600); */
