--- a/tests/ewf_test_header_values.c
+++ b/tests/ewf_test_header_values.c
@@ -4475,7 +4475,7 @@
 
 /* Date and times generated by MinGW are not localized in certain conditions
  */
-#if !defined( __MINGW32__ )
+#if !defined( __MINGW32__ ) && !defined( __OHOS__ )
 
 	result = memory_compare(
 	          date_time_values_string,
@@ -4487,7 +4487,23 @@
 	 result,
 	 0 );
 
-#endif /* !defined( __MINGW32__ ) */
+#endif /* !defined( __MINGW32__ ) && !defined( __OHOS__ ) */
+
+#if defined( __OHOS__ )
+	/* OHOS musl renders the zone as "+01:00 (CET)" (verified on device)
+	 * instead of glibc's " CET" suffix. TZ is pinned to CET by the recipe
+	 * build environment, so the full 37-byte string is deterministic. */
+	result = memory_compare(
+	          date_time_values_string,
+	          "Mon Jan  6 06:34:45 2020 +01:00 (CET)",
+	          37 );
+
+	EWF_TEST_ASSERT_EQUAL_INT(
+	 "result",
+	 result,
+	 0 );
+
+#endif /* defined( __OHOS__ ) */
 
 	memory_free(
 	 date_time_values_string );
@@ -4908,7 +4924,7 @@
 
 /* Date and times generated by MinGW are missing the time zone indicator
  */
-#if !defined( __MINGW32__ )
+#if !defined( __MINGW32__ ) && !defined( __OHOS__ )
 
 	EWF_TEST_ASSERT_EQUAL_SIZE(
 	 "xheader_size",
@@ -4929,7 +4945,56 @@
 	 result,
 	 0 );
 
-#endif /* !defined( __MINGW32__ ) */
+#endif /* !defined( __MINGW32__ ) && !defined( __OHOS__ ) */
+
+#if defined( __OHOS__ )
+	/* OHOS musl renders the zone as "+01:00 (CET)" (verified on device:
+	 * the xheader is 133 bytes vs glibc's 124), so the glibc reference
+	 * string cannot be compared verbatim. Verify the three deterministic
+	 * segments instead: the 67-byte XML prefix, the 37-byte musl date
+	 * rendering, and the 29-byte closing structure (the trailing NUL
+	 * matches the C string terminator). TZ is pinned to CET by the
+	 * recipe build environment. */
+	EWF_TEST_ASSERT_EQUAL_SIZE(
+	 "xheader_size",
+	 xheader_size,
+	 (size_t) 133 );
+
+	EWF_TEST_ASSERT_IS_NULL(
+	 "error",
+	 error );
+
+	result = memory_compare(
+	          xheader,
+	          expected_xheader,
+	          67 );
+
+	EWF_TEST_ASSERT_EQUAL_INT(
+	 "result",
+	 result,
+	 0 );
+
+	result = memory_compare(
+	          xheader + 67,
+	          "Mon Jan  6 06:34:45 2020 +01:00 (CET)",
+	          37 );
+
+	EWF_TEST_ASSERT_EQUAL_INT(
+	 "result",
+	 result,
+	 0 );
+
+	result = memory_compare(
+	          xheader + xheader_size - 29,
+	          "</acquiry_date>\n</xheader>\n\n",
+	          29 );
+
+	EWF_TEST_ASSERT_EQUAL_INT(
+	 "result",
+	 result,
+	 0 );
+
+#endif /* defined( __OHOS__ ) */
 
 	memory_free(
 	 xheader );
