--- a/tests/ewf_test_tools_info_handle.c
+++ b/tests/ewf_test_tools_info_handle.c
@@ -36,6 +36,40 @@
 
 #include "../ewftools/info_handle.h"
 
+#if defined( __OHOS__ )
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+/* OHOS musl tmpfile(3) hardcodes the read-only /tmp and ignores TMPDIR
+ * (verified on device: EACCES regardless of TMPDIR). Emulate tmpfile(3)
+ * on a writable TMPDIR path via mkstemp + fdopen + immediate unlink, so
+ * the descriptor owns the storage until fclose(3). */
+static FILE *ewf_test_ohos_tmpfile( void )
+{
+	char tmp_path[ 512 ];
+	const char *tmpdir = getenv( "TMPDIR" );
+	int tmp_fd = -1;
+
+	if( ( tmpdir == NULL ) || ( tmpdir[ 0 ] == '\0' ) )
+	{
+		tmpdir = "/data/storage/el2/base/cache";
+	}
+	if( snprintf( tmp_path, sizeof( tmp_path ), "%s/ewf_test_XXXXXX",
+	     tmpdir ) >= (int) sizeof( tmp_path ) )
+	{
+		return( NULL );
+	}
+	tmp_fd = mkstemp( tmp_path );
+	if( tmp_fd < 0 )
+	{
+		return( NULL );
+	}
+	unlink( tmp_path );
+	return( fdopen( tmp_fd, "w+" ) );
+}
+#define tmpfile ewf_test_ohos_tmpfile
+#endif /* __OHOS__ */
+
