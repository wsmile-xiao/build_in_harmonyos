--- /dev/null
+++ b/tests/ohos_tmpfile_compat.c
@@ -0,0 +1,42 @@
+#define _GNU_SOURCE 1
+/* OHOS compat: musl tmpfile() hardcodes /tmp which is not writable by
+ * apps on HarmonyOS. Provide a drop-in tmpfile() that honours $TMPDIR and
+ * falls back to a set of known-writable directories. Linked into test_main
+ * only; the static definition interposes the libc symbol. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+FILE *tmpfile(void);
+
+FILE *tmpfile(void)
+{
+    static const char *fallbacks[] = {
+        "/data/storage/el2/base/cache",
+        "/data/storage/el2/base/haps/entry/cache",
+        "/data/local/tmp",
+        ".",
+    };
+    const char *dirs[3 + 4];
+    int ndirs = 0;
+    const char *t = getenv("TMPDIR");
+    if (t && t[0])
+        dirs[ndirs++] = t;
+    for (int i = 0; i < 4; i++)
+        dirs[ndirs++] = fallbacks[i];
+
+    char path[512];
+    for (int i = 0; i < ndirs; i++) {
+        snprintf(path, sizeof(path), "%s/check_tmpXXXXXX", dirs[i]);
+        int fd = mkstemp(path);
+        if (fd < 0)
+            continue;
+        unlink(path); /* tmpfile() semantics: name vanishes immediately */
+        FILE *f = fdopen(fd, "w+b");
+        if (f)
+            return f;
+        close(fd);
+    }
+    return NULL;
+}
