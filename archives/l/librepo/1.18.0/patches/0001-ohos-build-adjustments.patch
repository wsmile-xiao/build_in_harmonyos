--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,6 +39,12 @@
 
 IF (USE_GPGME)
     FIND_PACKAGE(Gpgme REQUIRED)
+    # The bundled FindGpgme only computes GPGME_INCLUDES; when gpgme lives
+    # in a non-system prefix (conan) the consumer must add it to the include
+    # path itself, otherwise <gpgme.h> is not found.
+    IF (GPGME_INCLUDES)
+        INCLUDE_DIRECTORIES(${GPGME_INCLUDES})
+    ENDIF (GPGME_INCLUDES)
     IF (ENABLE_SELINUX)
         PKG_CHECK_MODULES(SELINUX REQUIRED libselinux)
     ENDIF(ENABLE_SELINUX)
@@ -72,6 +78,10 @@
 
 IF (WITH_ZCHUNK)
     PKG_CHECK_MODULES(ZCHUNKLIB zck>=0.9.11 REQUIRED)
+    # Non-system prefix (conan): expose zck.h to the build, otherwise
+    # <zck.h> (included from the generated downloadtarget.h/util.h) is not
+    # found.
+    INCLUDE_DIRECTORIES(${ZCHUNKLIB_INCLUDE_DIRS})
     SET (CMAKE_C_FLAGS          "${CMAKE_C_FLAGS} -DWITH_ZCHUNK")
     SET (CMAKE_C_FLAGS_DEBUG    "${CMAKE_C_FLAGS_DEBUG} -DWITH_ZCHUNK")
     SET (LIBREPO_ZCHUNK_ENABLED "1")
@@ -105,6 +115,16 @@
 # Add include dirs
 
 INCLUDE_DIRECTORIES(${LIBXML2_INCLUDE_DIRS})
+
+# Non-system prefixes (conan): the pkg-config modules live outside the
+# default linker search path, so their -L directories must be added,
+# otherwise "-lxml2/-lglib-2.0/-lzck/..." cannot be resolved at link time.
+LINK_DIRECTORIES(
+    ${GLIB2_LIBRARY_DIRS}
+    ${LIBXML2_LIBRARY_DIRS}
+    ${LIBCRYPTO_LIBRARY_DIRS}
+    ${ZCHUNKLIB_LIBRARY_DIRS}
+)
 INCLUDE_DIRECTORIES(${CURL_INCLUDE_DIR})
 #INCLUDE_DIRECTORIES(${CHECK_INCLUDE_DIR})
 IF (USE_GPGME AND ENABLE_SELINUX)
--- a/librepo/CMakeLists.txt
+++ b/librepo/CMakeLists.txt
@@ -85,6 +85,13 @@
 
 SET_TARGET_PROPERTIES(librepo PROPERTIES OUTPUT_NAME "repo")
 SET_TARGET_PROPERTIES(librepo PROPERTIES SOVERSION 0)
+# CMake does not know the HarmonyOS/OHOS platform (no Platform/HarmonyOS.cmake
+# and no CMAKE_SHARED_LIBRARY_SONAME_C_FLAG detected), so no SONAME is emitted
+# and dependents record the *link-time path* (e.g. "../librepo/librepo.so")
+# in DT_NEEDED, which the runtime loader resolves against the CWD only.
+# Emit a flat SONAME so DT_NEEDED is a plain file name resolvable via
+# LD_LIBRARY_PATH / the package libdir.
+SET_TARGET_PROPERTIES(librepo PROPERTIES LINK_FLAGS "-Wl,-soname,librepo.so")
 #SET_TARGET_PROPERTIES(librepo PROPERTIES VERSION "0")
 
 CONFIGURE_FILE("librepo.pc.cmake" "${CMAKE_BINARY_DIR}/librepo.pc" @ONLY)
