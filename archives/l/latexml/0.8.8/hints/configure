#!/bin/sh
# Configure hint for latexml (Perl project)
# Build system: Makefile.PL (ExtUtils::MakeMaker)
# Usage: perl Makefile.PL INSTALL_BASE=$DEFAULT_PREFIX

# Unset local::lib to avoid conflict
unset PERL_MM_OPT
unset PERL_MB_OPT

# Run Perl Makefile.PL with INSTALL_BASE for DESTDIR mode
perl Makefile.PL INSTALL_BASE="$DEFAULT_PREFIX" NOMKTEXLSR=1
