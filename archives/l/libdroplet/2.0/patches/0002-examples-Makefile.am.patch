--- a/examples/Makefile.am
+++ b/examples/Makefile.am
@@ -1,17 +1,22 @@
 noinst_PROGRAMS = recurse idtest idrangetest srwskey
 
-recurse_CFLAGS = -I$(top_srcdir)/libdroplet/include
+# droplet.h transitively pulls in openssl / libxml2 / json-c / pthread
+# headers; conan 私有 prefix 隔离环境下必须显式携带各依赖的 cflags
+#（与 libdroplet/Makefile.am 的 libdroplet_la_CFLAGS 保持一致）。
+DEP_CFLAGS = $(LIBXML_CFLAGS) $(JSON_CFLAGS) $(OPENSSL_CFLAGS) $(PTHREAD_CFLAGS)
+
+recurse_CFLAGS = -I$(top_srcdir)/libdroplet/include $(DEP_CFLAGS)
 recurse_LDADD = $(top_builddir)/libdroplet/libdroplet.la
 recurse_SOURCES = recurse.c
 
-idtest_CFLAGS = -I$(top_srcdir)/libdroplet/include
+idtest_CFLAGS = -I$(top_srcdir)/libdroplet/include $(DEP_CFLAGS)
 idtest_LDADD = $(top_builddir)/libdroplet/libdroplet.la
 idtest_SOURCES = idtest.c
 
-idrangetest_CFLAGS = -I$(top_srcdir)/libdroplet/include
+idrangetest_CFLAGS = -I$(top_srcdir)/libdroplet/include $(DEP_CFLAGS)
 idrangetest_LDADD = $(top_builddir)/libdroplet/libdroplet.la
 idrangetest_SOURCES = idrangetest.c
 
-srwskey_CFLAGS = -I$(top_srcdir)/libdroplet/include
+srwskey_CFLAGS = -I$(top_srcdir)/libdroplet/include $(DEP_CFLAGS)
 srwskey_LDADD = $(top_builddir)/libdroplet/libdroplet.la
 srwskey_SOURCES = srwskey.c
