diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,63 @@
+cmake_minimum_required(VERSION 3.15)
+project(liquidfun CXX)
+
+# LiquidFun v1.1.0 = Box2D 2.3.0 physics engine + Google's particle
+# extension (b2ParticleSystem). Upstream's own build tree
+# (liquidfun/Box2D/CMakeLists.txt, cmake 2.8 era) hard-codes -Wall -Werror
+# (2014 code trips -Wshift-negative-value on modern clang) and references
+# an "Unittests" directory whose real name is "UnitTests" (case-sensitive
+# breakage on Linux/OHOS), and its example target drags in freeglut/OpenGL.
+#
+# This replacement CMakeLists builds the library headless and self-contained:
+#   - all 54 sources under liquidfun/Box2D/Box2D/ (Collision/Common/Dynamics/
+#     Particle/Rope) -> libliquidfun (static by default)
+#   - headers installed under include/Box2D/... (upstream include layout:
+#     sources do #include <Box2D/...> with -I pointing at liquidfun/Box2D)
+# Upstream unit tests (13 gtest binaries, 179 TEST cases) are executed
+# during the conan build() phase via a generated test project that links
+# the vendored googletest sibling; see the recipe.
+
+set(LF_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/liquidfun/Box2D/Box2D")
+
+file(GLOB_RECURSE LF_SOURCES CONFIGURE_DEPENDS
+    "${LF_ROOT}/Collision/*.cpp"
+    "${LF_ROOT}/Common/*.cpp"
+    "${LF_ROOT}/Dynamics/*.cpp"
+    "${LF_ROOT}/Particle/*.cpp"
+    "${LF_ROOT}/Rope/*.cpp"
+)
+
+add_library(liquidfun ${LF_SOURCES})
+target_compile_definitions(liquidfun PUBLIC LIQUIDFUN_EXTERNAL_LANGUAGE_API=1)
+target_include_directories(liquidfun PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/liquidfun/Box2D>
+    $<INSTALL_INTERFACE:include>
+)
+target_compile_features(liquidfun PUBLIC cxx_std_11)
+
+if(NOT BUILD_SHARED_LIBS)
+    set_target_properties(liquidfun PROPERTIES OUTPUT_NAME "liquidfun")
+endif()
+
+include(GNUInstallDirs)
+install(TARGETS liquidfun
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+)
+
+# Header layout mirrors the upstream install rules: every .h keeps its
+# Box2D/... relative path (Collision, Common, Dynamics/{,Contacts,Joints},
+# Particle, Rope, plus the top-level Box2D.h).
+file(GLOB_RECURSE LF_HEADERS CONFIGURE_DEPENDS
+    "${LF_ROOT}/*.h"
+)
+foreach(HDR ${LF_HEADERS})
+    file(RELATIVE_PATH REL "${LF_ROOT}" "${HDR}")
+    get_filename_component(DIR "${REL}" DIRECTORY)
+    install(FILES "${HDR}" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/Box2D/${DIR}")
+endforeach()
+
+# Upstream license pointer.
+install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/liquidfun/Box2D/Changes.txt"
+        DESTINATION share/doc/liquidfun OPTIONAL)
