--- a/config.guess
+++ b/config.guess
@@ -983,6 +983,14 @@
     *:Minix:*:*)
 	GUESS=$UNAME_MACHINE-unknown-minix
 	;;
+    *:HarmonyOS:*:* | *:HongMeng*:*:*)
+	# HarmonyOS / OpenHarmony (uname -s reports "HarmonyOS"); the GNU
+	# triplet used by the OHOS toolchain is <machine>-unknown-linux-ohos.
+	# Without this branch config.guess falls back to compiling and running
+	# a probe program in a mktemp directory, which the OHOS worker storage
+	# refuses ("dummy.c: Permission denied").
+	GUESS=$UNAME_MACHINE-unknown-linux-ohos
+	;;
     aarch64:Linux:*:*)
 	set_cc_for_build
 	CPU=$UNAME_MACHINE
