--- a/include/libcgroup.h
+++ b/include/libcgroup.h
@@ -16,6 +16,19 @@
 #ifndef _LIBCG_H
 #define _LIBCG_H
 
+
+/* HarmonyOS/musl compatibility: glibc's <sys/cdefs.h> __BEGIN_DECLS and
+ * __END_DECLS macros are not provided by musl; define them locally. */
+#ifndef __BEGIN_DECLS
+#if defined(__cplusplus)
+#define __BEGIN_DECLS extern "C" {
+#define __END_DECLS   }
+#else
+#define __BEGIN_DECLS
+#define __END_DECLS
+#endif
+#endif
+
 #include <features.h>
 
 __BEGIN_DECLS
@@ -28,7 +41,15 @@ __BEGIN_DECLS
 #include <sys/types.h>
 #include <unistd.h>
 #include <limits.h>
+/* HarmonyOS/musl: linux/cn_proc.h -> linux/socket.h redefines
+ * sockaddr_storage already declared by musl sys/socket.h.  Pre-define
+ * the uapi guard and alias the kernel typedef so the duplicated body
+ * is skipped while cn_proc.h still gets its own declarations. */
+#define _UAPI_LINUX_SOCKET_H
+#define __kernel_sa_family_t sa_family_t
 #include <linux/cn_proc.h>
+#undef __kernel_sa_family_t
+#undef _UAPI_LINUX_SOCKET_H
 
 #ifndef _GNU_SOURCE
 #define _GNU_SOURCE
