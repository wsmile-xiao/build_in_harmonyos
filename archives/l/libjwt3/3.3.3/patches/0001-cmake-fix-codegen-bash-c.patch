--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -83,16 +83,23 @@
 	add_definitions(-DUSE_KCAPI_MD)
 endif()
 
+# The preprocessor flags must be a proper CMake list: passing the raw
+# CMAKE_C_FLAGS string as a single COMMAND argument makes the compiler see
+# one bogus argument like "-fPIC -O2" (error: unknown argument).
+separate_arguments(JWT_CODEGEN_FLAGS NATIVE_COMMAND "${CMAKE_C_FLAGS}")
+
 add_custom_command(
 	OUTPUT jwt-builder.i
-	COMMAND bash -c "${CMAKE_C_COMPILER} -E -DJWT_BUILDER ${CMAKE_SOURCE_DIR}/libjwt/jwt-common.c -o jwt-builder.i ${CMAKE_C_FLAGS}"
-		-o jwt-builder.i
+	COMMAND ${CMAKE_C_COMPILER} -E -DJWT_BUILDER
+		${CMAKE_SOURCE_DIR}/libjwt/jwt-common.c
+		${JWT_CODEGEN_FLAGS} -o jwt-builder.i
 	DEPENDS libjwt/jwt-common.c)
 
 add_custom_command(
 	OUTPUT jwt-checker.i
-	COMMAND bash -c "${CMAKE_C_COMPILER} -E -DJWT_CHECKER ${CMAKE_SOURCE_DIR}/libjwt/jwt-common.c -o jwt-checker.i ${CMAKE_C_FLAGS}"
-		-o jwt-checker.i
+	COMMAND ${CMAKE_C_COMPILER} -E -DJWT_CHECKER
+		${CMAKE_SOURCE_DIR}/libjwt/jwt-common.c
+		${JWT_CODEGEN_FLAGS} -o jwt-checker.i
 	DEPENDS libjwt/jwt-common.c)
 
 add_custom_target(gen_jwt_builder ALL DEPENDS jwt-builder.i)
