+# execution environment. Probe clone3 with the same namespace flags used by
+# Process; a successful compile alone is insufficient for syscall support.
+if cc.has_header_symbol('spawn.h', 'posix_spawn')
+    config_h.set('HAVE_POSIX_SPAWN', 1)
+endif
+
+clone3_probe = '''
+#include <linux/sched.h>
+#include <signal.h>
+#include <stdint.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+int main(void)
+{
+    struct clone_args args = { 0 };
+    int pidfd = -1;
+    args.flags = CLONE_PIDFD | CLONE_NEWUSER | CLONE_NEWNET;
+    args.pidfd = (uintptr_t)&pidfd;
+    args.exit_signal = SIGCHLD;
+    long child = syscall(SYS_clone3, &args, sizeof(args));
+    if (child < 0)
+        return 1;
+    if (child == 0)
+        _exit(0);
+    int status;
+    if (waitpid((pid_t)child, &status, 0) != (pid_t)child)
+        return 1;
+    if (pidfd >= 0)
