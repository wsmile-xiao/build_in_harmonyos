--- a/configure
+++ b/configure
@@ -3835,6 +3835,7 @@
-# Test print first, because it will be a builtin if present.
-if test "X`( print -r -- -n ) 2>/dev/null`" = X-n && \
-   test "X`print -r -- $ECHO 2>/dev/null`" = "X$ECHO"; then
-  ECHO='print -r --'
-elif test "X`printf %s $ECHO 2>/dev/null`" = "X$ECHO"; then
+# OHOS/HMDFS workaround: configure runs under /bin/sh (mksh, which has the
+# `print` builtin) so this probe picks ECHO='print -r --', but the generated
+# config.status and libtool get a bash shebang where `print` does not exist,
+# breaking both with "print: command not found". Force the printf branch so
+# the generated scripts work under bash.
+if test "X`printf %s $ECHO 2>/dev/null`" = "X$ECHO"; then
   ECHO='printf %s\n'
 else
