--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -8,20 +8,28 @@
 
 set(CMAKE_CXX_STANDARD 17)
 
 add_library(exmdbpp SHARED
             src/ExmdbClient.cpp
             src/queries.cpp
             src/requests.cpp
             src/structures.cpp
             src/util.cpp)
 set_target_properties(exmdbpp PROPERTIES SOVERSION 0)
+# CMake has no Platform/HarmonyOS module, so CMAKE_SYSTEM_NAME=HarmonyOS leaves
+# CMAKE_SHARED_LIBRARY_SONAME_CXX_FLAG empty: VERSION/SOVERSION are ignored and
+# no DT_SONAME reaches the ELF file. Pin it to the single installed file name.
+# (Restoring the flag globally would enable versioned output too - .so.0 plus a
+# namelink symlink - but creating that symlink fails inside the Conan build
+# folder on this platform, so keep one file with an explicit SONAME instead.)
+set_target_properties(exmdbpp PROPERTIES
+    LINK_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,-soname,libexmdbpp.so")
 target_include_directories(exmdbpp PUBLIC
                            $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include/exmdbpp>
                            $<INSTALL_INTERFACE:include/exmdbpp>)
 install(TARGETS exmdbpp
         EXPORT exmdbppTarget
         LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
         INCLUDES DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
 
 if(pybind11_FOUND)
     option(BUILD_PYEXMDB "Build libexmdbpp Python bindings" ON)
