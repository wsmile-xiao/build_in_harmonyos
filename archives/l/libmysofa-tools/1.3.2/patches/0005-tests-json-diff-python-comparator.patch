+++ b/tests/json_diff_ohos.py
@@ -0,0 +1,105 @@
+#!/usr/bin/env python3
+"""json_diff_ohos.py — python equivalent of the node-based json-diff comparators.
+
+Replicates, line-by-line, the semantics of the upstream comparators:
+  - json-diff.js          (strict):    report E(dit beyond tolerance) + D(eleted:
+                                       only in NEW output) + N(ew: only in REF)
+  - json-diffIgnoreNew.js (ignore-new): same, but entries present only in the
+                                       reference JSON are ignored
+Numeric tolerance (json-diff.js line 8 `var e = 0.05`, deepDiff tail):
+  lhs>0:  equal iff lhs*(1-e) < rhs < lhs*(1+e)
+  lhs<=0: equal iff lhs*(1+e) < rhs < lhs*(1-e)
+  JS `lhs === rhs` short-circuit (0.0 === 0); NaN equals NaN; all other
+  types compared strictly. Non-UTF8 bytes are replaced with U+FFFD like
+  Node's utf8 decoding.
+
+Exit 0 = equal, 1 = differences, 2 = usage error.
+"""
+import bz2
+import json
+import math
+import sys
+
+E = 0.05
+
+
+def load(path):
+    if path.endswith(".bz2"):
+        with bz2.open(path, "rt", encoding="utf-8", errors="replace") as fh:
+            return json.load(fh)
+    with open(path, encoding="utf-8", errors="replace") as fh:
+        return json.load(fh)
+
+
+def num_equal(l, r):
+    if l == r:
+        return True
+    if math.isnan(l) and math.isnan(r):
+        return True
+    if l > 0:
+        return l * (1 - E) < r and l * (1 + E) > r
+    return l * (1 - E) > r and l * (1 + E) < r
+
+
+def walk(lhs, rhs, path, out, kind_of_missing_in_new):
+    """kind_of_missing_in_new: kind letter for entries existing only in REF."""
+    if isinstance(lhs, dict) and isinstance(rhs, dict):
+        for k in lhs:
+            if k in rhs:
+                walk(lhs[k], rhs[k], path + "." + str(k), out,
+                     kind_of_missing_in_new)
+            else:
+                out.append(("D", path + "." + str(k)))  # only in NEW
+        for k in rhs:
+            if k not in lhs:
+                out.append((kind_of_missing_in_new, path + "." + str(k)))
+    elif isinstance(lhs, list) and isinstance(rhs, list):
+        for i in range(max(len(lhs), len(rhs))):
+            if i < len(lhs) and i < len(rhs):
+                walk(lhs[i], rhs[i], path + "[%d]" % i, out,
+                     kind_of_missing_in_new)
+            elif i < len(lhs):
+                out.append(("D", "%s[%d]" % (path, i)))  # only in NEW
+            else:
+                out.append((kind_of_missing_in_new, "%s[%d]" % (path, i)))
+    else:
+        lnum = isinstance(lhs, (int, float)) and not isinstance(lhs, bool)
+        rnum = isinstance(rhs, (int, float)) and not isinstance(rhs, bool)
+        if lnum and rnum:
+            if not num_equal(float(lhs), float(rhs)):
+                out.append(("E", "%s  (%r vs %r)" % (path, lhs, rhs)))
+        elif lhs != rhs:
+            out.append(("E", "%s  (%r vs %r)" % (path, lhs, rhs)))
+
+
+def main():
+    args = sys.argv[1:]
+    ignore_new = False
+    while args and args[0].startswith("--"):
+        opt = args.pop(0)
+        if opt == "--ignore-new":
+            ignore_new = True
+        else:
+            print("unknown option: %s" % opt, file=sys.stderr)
+            return 2
+    if len(args) != 2:
+        print("usage: json_diff_ohos.py [--ignore-new] <new.json> <ref.json[.bz2]>",
+              file=sys.stderr)
+        return 2
+    newf, reff = args
+    a, b = load(newf), load(reff)
+    diffs = []
+    # L = new output, R = reference (same argument order as upstream scripts)
+    walk(a, b, "", diffs, "N" if not ignore_new else "SKIP")
+    real = [d for d in diffs if d[0] != "SKIP"]
+    if real:
+        for kind, where in real[:20]:
+            print("%s: %s" % (kind, where))
+        print("total diffs: %d" % len(real))
+        return 1
+    print("ok")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
