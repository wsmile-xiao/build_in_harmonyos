+    _tgt=$(readlink "$SOFA_INPUT") || exit 1
+    case $_tgt in
+        /*) SOFA_INPUT=$_tgt ;;
+        *)  SOFA_INPUT=${1%/*}/$_tgt ;;
+    esac
+fi
+
