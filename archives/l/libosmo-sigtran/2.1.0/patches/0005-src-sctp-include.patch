@@ -27,7 +27,20 @@
 #include <inttypes.h>
 #include <netdb.h>
 #include <netinet/in.h>
-#include <netinet/sctp.h>
+/* SCTP header selection: use the platform netinet/sctp.h when present;
+ * fall back to the bundled RFC6458 type shim (src/sctp_ohos.h) on libc
+ * flavors without it (e.g. musl). */
+#if defined(__has_include)
+#  if __has_include(<netinet/sctp.h>)
+#    include <netinet/sctp.h>
+#    define HAVE_NETINET_SCTP_H 1
+#  else
+#    include "sctp_ohos.h"
+#  endif
+#else
+#  include <netinet/sctp.h>
+#  define HAVE_NETINET_SCTP_H 1
+#endif
 
