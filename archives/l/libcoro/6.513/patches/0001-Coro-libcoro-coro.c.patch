diff -ruN a/Coro/libcoro/coro.c b/Coro/libcoro/coro.c
--- a/Coro/libcoro/coro.c
+++ b/Coro/libcoro/coro.c
@@ -588,24 +588,32 @@
     }
   else
     ctx->id = null_tid;
 }
 
 void
 coro_destroy (coro_context *ctx)
 {
   if (!pthread_equal (ctx->id, null_tid))
     {
+#ifdef __OHOS__
+      /* musl/OHOS lacks pthread_cancel; signal thread via flag and join */
+      ctx->cancel_flag = 1;
+      pthread_mutex_unlock (&coro_mutex);
+      pthread_join (ctx->id, 0);
+      pthread_mutex_lock (&coro_mutex);
+#else
       pthread_cancel (ctx->id);
       pthread_mutex_unlock (&coro_mutex);
       pthread_join (ctx->id, 0);
       pthread_mutex_lock (&coro_mutex);
+#endif
     }
 
   pthread_cond_destroy (&ctx->cv);
 }
 
