 /*
  * Group 4: log_reference
  */
+
+/* OHOS: open_memstream()/tmpfile() link but fail at runtime
+ * (fclose returns EBADF, memory-stream writes never published;
+ * knowledge entries E302/E320). Capture into a real named temp
+ * file and read it back. Assertions unchanged. */
+static FILE *
+capture_open(void)
+{
+	return fopen("capture.tmp", "w+");
+}
+
+static char *
+capture_readback(FILE *f)
+{
+	char *buf = 0;
+	size_t len = 0;
+	char chunk[4096];
+	size_t n;
+	fflush(f);
+	rewind(f);
+	while ((n = fread(chunk, 1, sizeof(chunk), f)) > 0) {
+		char *nb = realloc(buf, len + n + 1);
+		if (!nb) { free(buf); fclose(f); remove("capture.tmp"); return 0; }
+		buf = nb;
+		memcpy(buf + len, chunk, n);
+		len += n;
+	}
+	if (buf) buf[len] = 0;
+	fclose(f);
+	remove("capture.tmp");
+	return buf;
+}
+
