 {
 	char *buf = 0;
 	size_t len = 0;
-	FILE *f = open_memstream(&buf, &len);
+	FILE *f = fopen("capture.tmp", "w+");
 	fn(f);
+	fflush(f);
+	rewind(f);
+	len = 0;
+	char chunk[4096];
+	size_t n;
+	while ((n = fread(chunk, 1, sizeof(chunk), f)) > 0) {
+		char *nb = realloc(buf, len + n + 1);
+		if (!nb) { free(buf); fclose(f); return 0; }
+		buf = nb;
+		memcpy(buf + len, chunk, n);
+		len += n;
+	}
+	if (buf) buf[len] = 0;
 	fclose(f);
+	remove("capture.tmp");
 	if (lenp) *lenp = len;
 	return buf;
 }
