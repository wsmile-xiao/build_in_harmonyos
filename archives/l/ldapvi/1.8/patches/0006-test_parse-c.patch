 static FILE *
 make_input(const char *data)
 {
-	return fmemopen((void *) data, strlen(data), "r");
+	/* OHOS: fmemopen() links but fails at runtime (E320) - stream never
+	 * populated. Write to a named temp file instead. */
+	char tmpl[] = "inputXXXXXX";
+	int fd = mkstemp(tmpl);
+	if (fd < 0) { perror("mkstemp"); abort(); }
+	if (data && *data) write(fd, data, strlen(data));
+	lseek(fd, 0, SEEK_SET);
+	return fdopen(fd, "r");
 }
 
