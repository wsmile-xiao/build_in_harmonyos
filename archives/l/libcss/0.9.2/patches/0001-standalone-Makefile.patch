 #!/bin/make
 #
-# Makefile for libcss
+# Standalone Makefile for libcss (adapted for HarmonyOS/OpenHarmony)
+#
+# Original NetSurf build system (Makefile include $(NSSHARED)/makefiles/
+# Makefile.tools) replaced with a standalone build because the
+# netsurf-buildsystem package is not available on this platform
+# (libwapcaplet 0.4.3 / libparserutils 0.2.5 precedent).
+#
+# Two build phases:
+#   1. gen_parser: host-compiled generator (src/parse/properties/
+#      css_property_parser_gen.c) turns src/parse/properties/properties.gen
+#      into 119 autogenerated_*.c property parsers (upstream runs this as
+#      PRE_TARGETS through netsurf-buildsystem rules).
+#   2. libcss.a: all 184 first-party sources + the generated parsers.
+#
+# The netsurf-buildsystem Makefile.clang injects two macros into CFLAGS:
+#   -D_ALIGNED=__attribute__((aligned)) -DSTMTEXPR=1
+# (src/stylesheet.h uses _ALIGNED; statement expressions are used in
+# macros). They are passed explicitly here.
+#
+# The select/ autogenerated headers (autogenerated_computed.h,
+# autogenerated_propget.h, autogenerated_propset.h) ship pre-generated in
+# the release tarball, so select_generator.py does not need to run.
 #
 # Copyright 2009-2020 John-Mark Bell <jmb@netsurf-browser.org>
+# MIT licence (see COPYING)
 
-# Component settings
 COMPONENT := css
 COMPONENT_VERSION := 0.9.2
-# Default to a static library
-COMPONENT_TYPE ?= lib-static
-
-# Setup the tooling
-PREFIX ?= /opt/netsurf
-NSSHARED ?= $(PREFIX)/share/netsurf-buildsystem
-include $(NSSHARED)/makefiles/Makefile.tools
 
-TESTRUNNER := $(PERL) $(NSTESTTOOLS)/testrunner.pl
+# Installation paths
+PREFIX ?= /usr/local
+LIBDIR ?= lib
+INCLUDEDIR ?= include
+
+# Toolchain (R33: recipe injects CC/AR/RANLIB from Conan conf)
+CC ?= clang
+BUILD_CC ?= clang
+AR ?= llvm-ar
+RANLIB ?= llvm-ranlib
+CFLAGS ?= -O2 -fPIC
+PKG_CONFIG ?= pkg-config
+
+# Dependency include/lib paths can be supplied through
+# DEP_CFLAGS / DEP_LIBS (recipe injects the Conan package paths) or via
+# pkg-config (fallback when the .pc files are reachable).
+DEP_CFLAGS ?= $(shell $(PKG_CONFIG) libparserutils libwapcaplet --cflags 2>/dev/null)
+DEP_LIBS ?= $(shell $(PKG_CONFIG) libparserutils libwapcaplet --libs 2>/dev/null)
 
-# Toolchain flags
+# Our own compile flags (adapted from the original NetSurf Makefile,
+# -Werror dropped for clang portability — libwapcaplet 0.4.3 precedent)
 WARNFLAGS := -Wall -W -Wundef -Wpointer-arith -Wcast-align \
 	-Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes \
-	-Wmissing-declarations -Wnested-externs
-# BeOS/Haiku/AmigaOS4 standard library headers create warnings
-ifneq ($(HOST),i586-pc-haiku)
-  ifneq ($(findstring amigaos,$(HOST)),amigaos)
-    WARNFLAGS := $(WARNFLAGS) -Werror
-  endif
-endif
-
-CFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE \
-	-I$(CURDIR)/include/ -I$(CURDIR)/src \
-	$(WARNFLAGS) $(CFLAGS)
-ifneq ($(GCCVER),2)
-  CFLAGS := $(CFLAGS) -std=c99
-else
-  # __inline__ is a GCCism
-  CFLAGS := $(CFLAGS) -Dinline="__inline__"
-endif
-
-# Parserutils & wapcaplet
-ifneq ($(findstring clean,$(MAKECMDGOALS)),clean)
-  ifneq ($(PKGCONFIG),)
-    CFLAGS := $(CFLAGS) $(shell $(PKGCONFIG) libparserutils libwapcaplet --cflags)
-    LDFLAGS := $(LDFLAGS) $(shell $(PKGCONFIG) libparserutils libwapcaplet --libs)
-  else
-    CFLAGS := $(CFLAGS) -I$(PREFIX)/include
-    LDFLAGS := $(LDFLAGS) -lparserutils -lwapcaplet
-  endif
-endif
-
-include $(NSBUILD)/Makefile.top
-
-# Extra installation rules
-I := /$(INCLUDEDIR)/libcss
-
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/computed.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/errors.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/font_face.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/fpmath.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/functypes.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/hint.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/libcss.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/properties.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/select.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/stylesheet.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/types.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libcss/unit.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) /$(LIBDIR)/pkgconfig:lib$(COMPONENT).pc.in
-INSTALL_ITEMS := $(INSTALL_ITEMS) /$(LIBDIR):$(OUTPUT)
+	-Wmissing-declarations -Wnested-externs -Wno-error
+
+COMPILE_CFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE -std=c99 \
+	'-D_ALIGNED=__attribute__((aligned))' -DSTMTEXPR=1 \
+	-I$(CURDIR)/include/ -I$(CURDIR)/src/ \
+	$(WARNFLAGS) $(DEP_CFLAGS) $(CFLAGS)
+
+# ---- Sources ------------------------------------------------------------
+# First-party sources (upstream DIR_SOURCES from each sub-Makefile)
+SRC := \
+	src/stylesheet.c \
+	src/charset/detect.c \
+	src/lex/lex.c \
+	src/parse/parse.c \
+	src/parse/language.c \
+	src/parse/important.c \
+	src/parse/propstrings.c \
+	src/parse/font_face.c \
+	src/parse/mq.c \
+	src/select/arena.c \
+	src/select/computed.c \
+	src/select/dispatch.c \
+	src/select/hash.c \
+	src/select/select.c \
+	src/select/strings.c \
+	src/select/font_face.c \
+	src/select/format_list_style.c \
+	src/select/unit.c \
+	src/utils/errors.c \
+	src/utils/utils.c \
+	$(wildcard src/parse/properties/*.c) \
+	$(wildcard src/select/properties/*.c)
+
+# Generated property parsers (119, from properties.gen via gen_parser)
+GEN_PROPS := $(shell sed -n 's/^\([a-z_0-9]*\):.*/\1/p' src/parse/properties/properties.gen)
+GEN_SRC := $(addprefix src/parse/properties/,$(addprefix autogenerated_,$(addsuffix .c,$(GEN_PROPS))))
+
+OBJ := $(SRC:.c=.o)
+GEN_OBJ := $(GEN_SRC:.c=.o)
+LIB := lib$(COMPONENT).a
+
+PC_IN := libcss.pc.in
+PC := lib$(COMPONENT).pc
+
+.PHONY: all clean install uninstall gen-parsers
+
+all: $(LIB) $(PC)
+
+# ---- Phase 1: host generator + property parsers -------------------------
+gen_parser:
+	$(BUILD_CC) -o $@ src/parse/properties/css_property_parser_gen.c
+
+$(GEN_SRC): src/parse/properties/properties.gen gen_parser
+	for p in $(GEN_PROPS); do \
+		./gen_parser -o src/parse/properties/autogenerated_$$p.c \
+			"$$(grep "^$$p:" src/parse/properties/properties.gen)"; \
+	done
+
+gen-parsers: $(GEN_SRC)
+
+# ---- Phase 2: library ----------------------------------------------------
+# 所有对象（一手 + 生成）共用同一条编译规则（COMPILE_CFLAGS）
+$(OBJ) $(GEN_OBJ): %.o: %.c
+	$(CC) $(COMPILE_CFLAGS) -c -o $@ $<
+
+$(LIB): $(OBJ) $(GEN_OBJ)
+	$(AR) rcs $@ $(OBJ) $(GEN_OBJ)
+	$(RANLIB) $@
+
+$(PC): $(PC_IN)
+	sed -e 's|PREFIX|$(PREFIX)|g' \
+	    -e 's|LIBDIR|$(LIBDIR)|g' \
+	    -e 's|INCLUDEDIR|$(INCLUDEDIR)|g' \
+	    -e 's|VERSION|$(COMPONENT_VERSION)|g' \
+	    $(PC_IN) > $(PC)
+
+clean:
+	rm -f $(OBJ) $(GEN_OBJ) $(LIB) $(PC) gen_parser \
+		src/parse/properties/autogenerated_*.c
+
+install: all
+	mkdir -p $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig
+	mkdir -p $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/libcss
+	cp $(LIB) $(DESTDIR)$(PREFIX)/$(LIBDIR)/
+	cp $(PC) $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/
+	for h in include/libcss/*.h; do \
+		cp $$h $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/libcss/; \
+	done
+
+uninstall:
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/$(LIB)
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/$(PC)
+	rm -rf $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/libcss
