--- a/cmake/config.cmake
+++ b/cmake/config.cmake
@@ -1,18 +1,35 @@
 include(CheckFunctionExists)
 include(CMakeFindDependencyMacro)
+if(NOT PostgreSQL_FOUND AND NOT TARGET libpq::libpq)
+    # Conan's libpq package (CMakeDeps) exports libpq::libpq rather than
+    # CMake's built-in FindPostgreSQL targets.  Try it first so that a
+    # conan-provided libpq wins over any system PostgreSQL.
+    find_package(libpq CONFIG QUIET)
+    if(TARGET libpq::libpq)
+        set(PostgreSQL_FOUND TRUE)
+    endif()
+endif()
 if(NOT PostgreSQL_FOUND)
     find_package(PostgreSQL)
 endif()
 if(NOT PostgreSQL_FOUND)
     find_package(PkgConfig REQUIRED)
     pkg_check_modules(PostgreSQL REQUIRED libpq)
+endif()
+
+# OHOS libc++ 15 (clang 15.0.4) ships <format> as an "incomplete" feature:
+# the header compiles once _LIBCPP_ENABLE_EXPERIMENTAL is defined, and the
+# runtime symbols (std::format_error etc.) live in libc++experimental.
+if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS" OR CMAKE_SYSTEM_NAME STREQUAL "OHOS")
+    add_compile_definitions(_LIBCPP_ENABLE_EXPERIMENTAL)
+    add_link_options(-lc++experimental)
 endif()
 check_function_exists("poll" PQXX_HAVE_POLL)
 
 # Incorporate feature checks based on C++ feature test macros.
 include(pqxx_cxx_feature_checks)
 
