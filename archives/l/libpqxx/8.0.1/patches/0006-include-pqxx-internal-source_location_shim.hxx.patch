--- /dev/null
+++ b/include/pqxx/internal/source_location_shim.hxx
@@ -0,0 +1,57 @@
+/* Minimal std::source_location shim for OHOS libc++ 15.
+ *
+ * The OHOS NDK ships libc++ 15.0.4, whose <source_location> header does not
+ * exist yet (upstream libc++ gained C++20 source_location support in 16).
+ * libpqxx 8.0.1 only uses std::source_location for diagnostics
+ * (file_name/function_name/line/column on error paths), so a small
+ * fallback implementation keeps the API surface intact.
+ *
+ * When PQXX_HAVE_SOURCE_LOCATION is defined (newer libc++), the real
+ * <source_location> header is used instead.
+ */
+#ifndef PQXX_SOURCE_LOCATION_SHIM_H
+#define PQXX_SOURCE_LOCATION_SHIM_H
+
+#include <cstdint>
+
+#if defined(PQXX_HAVE_SOURCE_LOCATION)
+#  include <source_location>
+#else
+#  include <version>
+#  if defined(__cpp_lib_source_location)
+#    include <source_location>
+#    define PQXX_HAVE_SOURCE_LOCATION
+#  else
+namespace std
+{
+/// Fallback source_location for libc++ < 16 (e.g. OHOS NDK's 15.0.4).
+/// Reports the call site of `current()` as unknown; libpqxx only renders
+/// these values into diagnostic messages, so "unknown" placeholders keep
+/// behaviour correct without changing any control flow.
+struct source_location
+{
+  [[nodiscard]] static constexpr source_location current() noexcept
+  {
+    return source_location{};
+  }
+  [[nodiscard]] constexpr char const *file_name() const noexcept
+  {
+    return "(unknown)";
+  }
+  [[nodiscard]] constexpr char const *function_name() const noexcept
+  {
+    return "(unknown)";
+  }
+  [[nodiscard]] constexpr std::uint_least32_t line() const noexcept
+  {
+    return 0;
+  }
+  [[nodiscard]] constexpr std::uint_least32_t column() const noexcept
+  {
+    return 0;
+  }
+};
+} // namespace std
+#  endif
+#endif
+#endif // PQXX_SOURCE_LOCATION_SHIM_H
