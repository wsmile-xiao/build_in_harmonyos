diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,27 @@
+#!/bin/sh
+# libetpan bootstrap configure wrapper for HarmonyOS
+# Original tarball has empty configure; this wrapper:
+# 1. Runs libtoolize + autoreconf to generate real configure + auxiliary files
+# 2. Applies HMDFS umask 077 fix to generated configure
+# 3. Re-invokes the generated configure with original arguments
+#
+# Note: /bin/sh reads entire script into memory before execution,
+# so autoreconf overwriting this file on disk won't affect execution.
+
+CONFIGURE_ARGS="$*"
+
+echo "=== libetpan bootstrap: generating build system ==="
+
+libtoolize --copy --install
+
+echo "=== libetpan bootstrap: running autoreconf ==="
+
+autoreconf -fi
+
+echo "=== libetpan bootstrap: fixing HMDFS umask ==="
+
+sed -i "s|umask 077 && mktemp -d ./confXXXXXX|mktemp -d \$TMPDIR/confXXXXXX|g" configure
+
+echo "=== libetpan bootstrap: running real configure ==="
+
+exec bash ./configure $CONFIGURE_ARGS