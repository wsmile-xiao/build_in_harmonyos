--- a/gcc/testsuite/gm2/iso/run/pass/iso-run-pass.exp
+++ b/gcc/testsuite/gm2/iso/run/pass/iso-run-pass.exp
@@ -25,16 +25,31 @@
 load_lib gm2-torture.exp
 
 gm2_init_iso "${srcdir}/gm2/iso/run/pass" -fsoft-check-all
 gm2_link_obj fileio.o
 
 foreach testcase [lsort [glob -nocomplain $srcdir/$subdir/*.mod]] {
     # If we're only testing specific files and this isn't one of them, skip it.
     if ![runtest_file_p $runtests $testcase] then {
 	continue
     }
+    # OHOS test-batching: allow slicing the module list via env GM2_ISO_SLICE
+    # (format "start,count") so a huge exp can be run in windows without
+    # re-running already-covered modules.
+    if [info exists env(GM2_ISO_SLICE)] {
+	set _slice $env(GM2_ISO_SLICE)
+	set _s0 [lindex [split $_slice ,] 0]
+	set _s1 [lindex [split $_slice ,] 1]
+	set _testdir [file dirname $testcase]
+	set _all [lsort [glob -nocomplain $_testdir/*.mod]]
+	set _n [expr {[llength $_all]}]
+	set _idx [lsearch -exact $_all $testcase]
+	if { $_idx < $_s0 || $_idx >= [expr {$_s0 + $_s1}] } {
+	    continue
+	}
+    }
 
     if { $testcase != "$srcdir/$subdir/fileio.mod" } {
         gm2_target_compile $srcdir/$subdir/fileio.mod fileio.o object "-g"
 	gm2-torture-execute $testcase "" "pass"
     }
 }
