--- a/config.guess
+++ b/config.guess
@@ -149,6 +149,17 @@
 UNAME_SYSTEM=`(uname -s) 2>/dev/null` || UNAME_SYSTEM=unknown
 UNAME_VERSION=`(uname -v) 2>/dev/null` || UNAME_VERSION=unknown
 
+# [HarmonyOS] This config.guess predates HarmonyOS (uname -s = "HarmonyOS").
+# Report the same aarch64 triple the recipe passes explicitly
+# (--build/--host=aarch64-unknown-linux-gnu); without this the script exits
+# with "unable to guess system type" and a bare ./configure aborts, which
+# also breaks the clean-build verification gate.
+case "${UNAME_SYSTEM}:${UNAME_MACHINE}" in
+  HarmonyOS:aarch64 | HarmonyOS:arm64)
+    echo aarch64-unknown-linux-gnu
+    exit 0 ;;
+esac
+
 case $UNAME_SYSTEM in
 Linux|GNU|GNU/*)
 	LIBC=unknown
