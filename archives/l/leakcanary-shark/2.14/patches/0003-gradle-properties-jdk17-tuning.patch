--- a/gradle.properties
+++ b/gradle.properties
@@ -21,5 +21,8 @@
 #Gradle properties: https://docs.gradle.org/current/userguide/build_environment.html
 org.gradle.caching=true
 org.gradle.configureondemand=true
-org.gradle.jvmargs=-XX:+UseParallelGC -Dfile.encoding=UTF-8
+# bishengjdk17 on HarmonyOS aarch64: raise heap for upstream shark test JVM tooling.
+# --add-opens: the Kotlin 1.4.21 in-process compiler reflects into JDK internals
+# (ResourceBundle/IntelliJ platform code) which JDK 17 strong encapsulation blocks.
+org.gradle.jvmargs=-Xmx2g -XX:+UseParallelGC -Dfile.encoding=UTF-8 --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED --add-opens java.base/java.net=ALL-UNNAMED --add-opens java.base/java.nio=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED
 org.gradle.parallel=true
