+// Gated (distribution_type, side, i) -- each verified Pass==0 inside.
+template <typename dist>
+inline bool trng_ohos_b128_gated_icdf_case(p_id_side side, int i) {
+  if (!is_binary128_long_double<typename dist::result_type>::value)
+    return false;  // not the binary128 long double flavor -> never gate
+  switch (side) {
+    case p_id_base:
+      return trng_ohos_b128_gated_base<dist>(i);  // p == 0.5
+    case p_id_small:
+      return trng_ohos_b128_gated_small<dist>(i);
+    case p_id_big:
+      return trng_ohos_b128_gated_big<dist>(i);
+  }
+  return false;
+}
