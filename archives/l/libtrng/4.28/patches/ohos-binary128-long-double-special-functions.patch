+// Audit counter — incremented every time a case is explicitly SKIPped.
+// Printed at program exit by trng_ohos_b128_sf_audit_printer destructor.
+static unsigned long trng_ohos_b128_sf_skipped_count = 0;
+
+// RAII: prints the audit line when the program exits. Placed in
+// file scope so it runs after main() / Catch2 session returns.
+struct trng_ohos_b128_sf_audit_printer {
+  ~trng_ohos_b128_sf_audit_printer() {
+    std::fprintf(stderr,
+                 "OHOS_BINARY128_SKIPPED_SPECIAL_FUNCTION_CASES=%lu\n",
+                 trng_ohos_b128_sf_skipped_count);
+  }
+};
+static trng_ohos_b128_sf_audit_printer trng_ohos_b128_sf_printer;
+
+// Gate. sec = section tag; args_str = stringified fixed input args (identity).
+template <typename T>
+inline bool trng_ohos_b128_gated_sf_case(sf_id sec, const std::string &args_str) {
+  if (!is_binary128_long_double<T>::value)
+    return false;  // not binary128 long double -> never gate
+  switch (sec) {
+// 100%-FAIL sections (Pass==0) -> gate whole section
+    case sf_Beta:
+    case sf_acoth:
+    case sf_acsch:
+    case sf_inc_Gamma:
+    case sf_inc_gamma:
+    case sf_inv_GammaP:
+    case sf_inv_erf:
+    case sf_inv_erfc:
+      return true;
+    // Partial-fail sections: gate only the specific failing arg identities.
+    case sf_Beta_I:
+      return trng_ohos_b128_sf_case_Beta_I<T>(args_str);
+    case sf_GammaP:
+      return trng_ohos_b128_sf_case_GammaP<T>(args_str);
+    case sf_GammaQ:
+      return trng_ohos_b128_sf_case_GammaQ<T>(args_str);
+    case sf_Phi:
+      return trng_ohos_b128_sf_case_Phi<T>(args_str);
+    case sf_asech:
+      return trng_ohos_b128_sf_case_asech<T>(args_str);
+    case sf_inv_Beta_I:
+      return trng_ohos_b128_sf_case_inv_Beta_I<T>(args_str);
+    case sf_inv_Phi:
+      return trng_ohos_b128_sf_case_inv_Phi<T>(args_str);
+    case sf_mln1p:
+      return trng_ohos_b128_sf_case_mln1p<T>(args_str);
+    default:
+      return false;
+  }
+}
