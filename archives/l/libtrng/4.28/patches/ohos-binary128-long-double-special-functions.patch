+  static const char * const ids[] = {
+    "args=0.0625, 2, 3",
+    "args=0.125, 2, 3",
+    "args=0.1875, 2, 3",
+    "args=0.375, 2, 3",
+    "args=0.4375, 2, 3",
+    "args=0.5625, 2, 3",
+    "args=0.75, 2, 3",
+    "args=0.875, 2, 3",
+    "args=0.9375, 2, 3",
+  };
+  for (size_t k = 0; k < sizeof(ids)/sizeof(ids[0]); ++k)
+    if (a == ids[k]) return true;
+  return false;
+}
