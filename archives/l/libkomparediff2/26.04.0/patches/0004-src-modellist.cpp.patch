 using namespace KompareDiff2;
 
+// KIO::file_copy() with KIO::Overwrite equivalent for local files: replace
+// \a destination with the contents of \a source. KIO is not available on
+// OHOS, so the save paths use plain QFile operations.
+static bool copyFileOverwrite(const QString &source, const QUrl &destination)
+{
+    const QString destinationPath = destination.toLocalFile();
+    if (destinationPath.isEmpty())
+        return false;
+    if (QFile::exists(destinationPath) && !QFile::remove(destinationPath))
+        return false;
+    return QFile::copy(source, destinationPath);
+}
