+// KIO::upUrl() equivalent built on plain QUrl: returns the parent URL of
+// \a url, or an invalid QUrl once the root is reached. This removes this
+// file's KIO symbol usage (KIO is not available on OHOS).
+static QUrl parentUrl(const QUrl &url)
+{
+    QString path = url.path();
+    if (path.length() > 1) { // avoid returning empty when we're at '/'
+        if (path.endsWith(QLatin1Char('/')))
+            path.chop(1);
+        const int lastSlash = path.lastIndexOf(QLatin1Char('/'));
+        if (lastSlash != -1)
+            path.truncate(lastSlash + 1); // keep the trailing slash
+        else
+            path = QStringLiteral("/");
+    }
+    QUrl result = url;
+    result.setPath(path);
+    if (result == url) {
+        return QUrl();
+    }
+    return result;
+}
