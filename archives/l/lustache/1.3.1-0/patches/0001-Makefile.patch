diff -ruN /dev/null b/Makefile
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,33 @@
+# Makefile for lustache (pure Lua library)
+# Build system: custom
+# Follows R20: DESTDIR mode
+
+# PREFIX should be ~/usr/local (DEFAULT_PREFIX)
+PREFIX ?= /storage/Users/currentUser/usr/local
+LUA_SHARE_DIR = $(PREFIX)/share/lua/5.4
+
+# Files to install
+LUA_FILES = src/lustache.lua
+LUA_SUBDIR_FILES = src/lustache/context.lua src/lustache/renderer.lua src/lustache/scanner.lua
+
+all:
+	@echo "Nothing to build (pure Lua library)"
+
+install:
+	@echo "Installing lustache Lua files to $(DESTDIR)$(LUA_SHARE_DIR)..."
+	mkdir -p $(DESTDIR)$(LUA_SHARE_DIR)
+	mkdir -p $(DESTDIR)$(LUA_SHARE_DIR)/lustache
+	cp $(LUA_FILES) $(DESTDIR)$(LUA_SHARE_DIR)/
+	cp $(LUA_SUBDIR_FILES) $(DESTDIR)$(LUA_SHARE_DIR)/lustache/
+	@echo "Installation complete"
+
+check:
+	@echo "Running tests..."
+	lua spec/context_spec.lua
+	lua spec/parse_spec.lua
+	lua spec/render_spec.lua
+
+clean:
+	@echo "Nothing to clean"
+
+.PHONY: all install check clean