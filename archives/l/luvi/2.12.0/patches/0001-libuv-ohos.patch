+#if defined(HAVE_OS_ACCOUNT_NDK)
+/* On HarmonyOS, application UIDs (e.g. 200xxxxx) are not in /etc/passwd.
+ * Fall back to the OHOS OsAccount NDK API to retrieve the account name.
+ * Note: dlclose() is intentionally NOT called — the system library registers
+ * atexit handlers that cause SIGSEGV if the library is unloaded before exit. */
+static int uv__get_ohos_account_name(char* buffer, size_t buflen) {
+  typedef int (*getname_t)(char*, size_t);
+  void* handle;
+  getname_t fn;
+  int r;
+
+  handle = dlopen("/system/lib64/ndk/libos_account_ndk.so",
+                  RTLD_NOW | RTLD_LOCAL);
+  if (handle == NULL)
+    return UV_ENOENT;
+
+  fn = (getname_t)dlsym(handle, "OH_OsAccount_GetName");
+  if (fn == NULL)
+    return UV_ENOENT;
+
+  r = fn(buffer, buflen);
+
+  if (r != 0)
+    return UV_ENOENT;
+
+  return 0;
+}
+#endif /* HAVE_OS_ACCOUNT_NDK */
