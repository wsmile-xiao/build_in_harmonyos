--- a/lib/libaudit.h	2017-03-28 22:01:41.000000000 +0800
+++ b/lib/libaudit.h	2026-09-15 10:32:55.539224375 +0800
@@ -30,6 +30,23 @@
 
 #include <asm/types.h>
 #include <stdint.h>
+#if !defined(__GLIBC__)
+/* musl-family libcs (incl. OHOS bionic): the uapi linux/socket.h
+ * (pulled in via linux/netlink.h or linux/net.h) redefines
+ * sockaddr_storage already declared by the libc sys/socket.h, and the
+ * libc declares struct sockaddr_storage without an include guard
+ * around it. glibc coordinates the two headers via libc-compat
+ * machinery, which musl-family libcs lack. Define the uapi header's
+ * own include guard BEFORE either header can be pulled in, so
+ * whichever of the two comes first wins and the other becomes a
+ * no-op. The __kernel_sa_family_t typedef (normally provided by
+ * linux/socket.h) is re-supplied for linux/netlink.h consumers. */
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+#endif
+typedef unsigned short __ohos_kernel_sa_family_t;
+#define __kernel_sa_family_t __ohos_kernel_sa_family_t
+#endif
 #include <sys/socket.h>
 #include <linux/netlink.h>
 #include <linux/audit.h>
@@ -277,7 +294,13 @@
 #define AUDIT_KEY_SEPARATOR 0x01
 
 /* These are used in filter control */
+/* Modern kernel uapi linux/audit.h already defines
+ * AUDIT_FILTER_EXCLUDE; guard the legacy alias so both old and new
+ * kernel headers build (redefinition of an identical value would
+ * otherwise warn/fail on some toolchains). */
+#ifndef AUDIT_FILTER_EXCLUDE
 #define AUDIT_FILTER_EXCLUDE	AUDIT_FILTER_TYPE
+#endif
 #define AUDIT_FILTER_MASK	0x07	/* Mask to get actual filter */
 #define AUDIT_FILTER_UNSET	0x80	/* This value means filter is unset */
 
