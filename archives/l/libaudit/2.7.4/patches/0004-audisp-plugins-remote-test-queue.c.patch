+/* Honour $TMPDIR for the mkstemp template (POSIX env var; some
+ * environments mount /tmp read-only). Keep the upstream /tmp default
+ * when TMPDIR is unset so glibc behaviour is unchanged. */
+static char filename[PATH_MAX];
+static void init_filename(void)
+{
+	const char *dir = getenv("TMPDIR");
+	if (dir == NULL || *dir == '\0')
+		dir = "/tmp";
+	snprintf(filename, sizeof(filename), "%s/tqXXXXXX", dir);
+}
