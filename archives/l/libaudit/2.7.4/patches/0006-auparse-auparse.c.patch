--- a/auparse/auparse.c	2017-03-28 22:01:41.000000000 +0800
+++ b/auparse/auparse.c	2026-09-15 10:32:55.367225156 +0800
@@ -33,6 +33,23 @@
 #include <unistd.h>
 #include <stdio_ext.h>
 
+#if !defined(__GLIBC__)
+/* musl-family libcs (incl. OHOS bionic) have no strndupa (glibc
+ * extension). A macro is used instead of a static inline function on
+ * purpose: clang's inliner emits llvm.lifetime markers for alloca()
+ * inside an inlined function, which invalidates the returned stack
+ * buffer before the caller uses it (observed as corrupted tokens from
+ * audit_strsplit). Expanding the alloca at the call site keeps the
+ * buffer alive for the enclosing function's stack frame, matching
+ * glibc's block-scope semantics. */
+#include <alloca.h>
+#define strndupa(s, n) \
+    (char *)({ const char *_s = (s); size_t _n = (n); \
+       size_t _l = strnlen(_s, _n); \
+       char *_p = __builtin_alloca(_l + 1); \
+       memcpy(_p, _s, _l); _p[_l] = '\0'; _p; })
+#endif
+
 #if	LOL_EVENTS_DEBUG01
 static int debug = 0;
 #endif
