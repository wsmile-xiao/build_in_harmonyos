@@ -29,6 +30,17 @@
 #include <string.h>
 #include <sys/wait.h>
 #include <pthread.h>
+#if !defined(__GLIBC__)
+/* musl-family libcs (incl. OHOS bionic) do not implement
+ * pthread_cancel. The only call site here is the alarm_handler()
+ * 5-second last-resort path during shutdown: the inbound thread's
+ * main loop already exits on its own via `while (stop == 0)` with a
+ * 20s poll timeout, so cancel is merely a forced wake-up. pthread_kill
+ * with signal 0 (existence probe, no signal delivered) keeps the raise(
+ * SIGTERM) process termination right after it — same approach as the
+ * audit 4.1.2 OHOS port (patches/0005). */
+#define pthread_cancel(t) pthread_kill((t), 0)
+#endif
