diff -ruN a/lp_rlp_tokens.h b/lp_rlp_tokens.h
--- a/lp_rlp_tokens.h
+++ b/lp_rlp_tokens.h
@@ -0,0 +1,92 @@
+/* lp_rlp_tokens.h - Bison token defines for lp_solve
+ *
+ * The flex-generated lp_rlp.h header uses bison tokens in inline functions,
+ * but these tokens are only defined in the bison-generated lp_rlp.c output.
+ * This header provides the token values so they are available before lp_rlp.h
+ * is included. Values are conditionally defined to avoid conflicts with the
+ * bison-generated enum/#defines in lp_rlp.c.
+ */
+
+#ifndef LP_RLP_TOKENS_H
+#define LP_RLP_TOKENS_H
+
+#ifndef YYEMPTY
+#define YYEMPTY -2
+#endif
+#ifndef YYEOF
+#define YYEOF 0
+#endif
+#ifndef YYerror
+#define YYerror 256
+#endif
+#ifndef YYUNDEF
+#define YYUNDEF 257
+#endif
+#ifndef VAR
+#define VAR 258
+#endif
+#ifndef CONS
+#define CONS 259
+#endif
+#ifndef INTCONS
+#define INTCONS 260
+#endif
+#ifndef VARIABLECOLON
+#define VARIABLECOLON 261
+#endif
+#ifndef INF
+#define INF 262
+#endif
+#ifndef SEC_INT
+#define SEC_INT 263
+#endif
+#ifndef SEC_BIN
+#define SEC_BIN 264
+#endif
+#ifndef SEC_SEC
+#define SEC_SEC 265
+#endif
+#ifndef SEC_SOS
+#define SEC_SOS 266
+#endif
+#ifndef SOSDESCR
+#define SOSDESCR 267
+#endif
+#ifndef SEC_FREE
+#define SEC_FREE 268
+#endif
+#ifndef TOK_SIGN
+#define TOK_SIGN 269
+#endif
+#ifndef AR_M_OP
+#define AR_M_OP 270
+#endif
+#ifndef RE_OPEQ
+#define RE_OPEQ 271
+#endif
+#ifndef RE_OPLE
+#define RE_OPLE 272
+#endif
+#ifndef RE_OPGE
+#define RE_OPGE 273
+#endif
+#ifndef END_C
+#define END_C 274
+#endif
+#ifndef COMMA
+#define COMMA 275
+#endif
+#ifndef COLON
+#define COLON 276
+#endif
+#ifndef MINIMISE
+#define MINIMISE 277
+#endif
+#ifndef MAXIMISE
+#define MAXIMISE 278
+#endif
+#ifndef UNDEFINED
+#define UNDEFINED 279
+#endif
+
+#endif /* LP_RLP_TOKENS_H */