diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1 +1,224 @@
-# placeholder - lp_solve uses custom build system (ccc scripts)
+# Makefile for lp_solve 5.5.2.14 on OpenHarmony (aarch64)
+# Adapted from the original ccc shell scripts for the OpenHarmony build system
+# Uses CC=clang, GNU ld (ld.bfd), and proper install targets with DESTDIR support
+
+CC      ?= clang
+AR      ?= llvm-ar
+RANLIB  ?= llvm-ranlib
+LDFLAGS ?= -fuse-ld=/data/service/hnp/bin/ld.bfd
+CFLAGS  ?= -fPIC -O2
+
+PREFIX  ?= /storage/Users/currentUser/usr/local
+DESTDIR ?=
+
+PLATFORM = ux64
+
+# Common defines (from original ccc scripts)
+DEFS = -DYY_NEVER_INTERACTIVE -DPARSER_LP -DINVERSE_ACTIVE=INVERSE_LUSOL -DRoleIsExternalInvEngine
+
+# Flex/bison prefix fix: the generated lp_rlp.h uses lp_yy* prefixed symbols,
+# but the PARM macro and bison parser calls in lp_rlp.c use unprefixed yy* symbols.
+# Map all unprefixed names to prefixed ones via compiler defines.
+FLEX_BISON_PREFIX_DEFS = \
+	-Dyyscanner=lp_yyscanner \
+	-Dyyget_extra=lp_yyget_extra \
+	-Dyyset_extra=lp_yyset_extra \
+	-Dyylex=lp_yylex \
+	-Dyylex_init=lp_yylex_init \
+	-Dyylex_destroy=lp_yylex_destroy \
+	-Dyyset_in=lp_yyset_in \
+	-Dyyset_out=lp_yyset_out \
+	-Dyy_scan_string=lp_yy_scan_string \
+	-Dyy_delete_buffer=lp_yy_delete_buffer \
+	-Dyyalloc=lp_yyalloc \
+	-Dyyrealloc=lp_yyrealloc \
+	-Dyyfree=lp_yyfree
+
+# Bison token defines: lp_rlp.h (flex header) uses bison tokens in inline functions,
+# but these are only defined in lp_rlp.c (bison output).
+# We created lp_rlp_tokens.h with conditional defines to resolve this.
+# (No longer needed as -D flags since the header provides them)
+
+# Common include paths (relative to project root)
+INCLUDES = -I. -Ishared -Ibfp -Ibfp/bfp_LUSOL -Ibfp/bfp_LUSOL/LUSOL -Icolamd
+
+# ─────────────────────────────────────────────────────
+# Source files for the core library (from lpsolve55/ccc)
+# ─────────────────────────────────────────────────────
+LIB_SRC = \
+	lp_MDO.c \
+	shared/commonlib.c \
+	shared/mmio.c \
+	shared/myblas.c \
+	ini.c \
+	fortify.c \
+	colamd/colamd.c \
+	lp_rlp.c \
+	lp_crash.c \
+	bfp/bfp_LUSOL/lp_LUSOL.c \
+	bfp/bfp_LUSOL/LUSOL/lusol.c \
+	lp_Hash.c \
+	lp_lib.c \
+	lp_wlp.c \
+	lp_matrix.c \
+	lp_mipbb.c \
+	lp_MPS.c \
+	lp_params.c \
+	lp_presolve.c \
+	lp_price.c \
+	lp_pricePSE.c \
+	lp_report.c \
+	lp_scale.c \
+	lp_simplex.c \
+	lp_SOS.c \
+	lp_utils.c \
+	yacc_read.c
+
+# Source files for the standalone solver (from lp_solve/ccc)
+EXE_SRC = $(LIB_SRC) lp_solve/lp_solve.c
+
+# ─────────────────────────────────────────────────────
+# Derived object file lists
+# ─────────────────────────────────────────────────────
+LIB_OBJ   = $(foreach f,$(LIB_SRC),$(notdir $(f:.c=.o)))
+EXE_OBJ   = $(foreach f,$(EXE_SRC),$(notdir $(f:.c=.o)))
+
+# ─────────────────────────────────────────────────────
+# Targets
+# ─────────────────────────────────────────────────────
+.PHONY: all static shared exe install clean
+
+all: static shared exe
+
+# ── Static library ──
+static: bin/$(PLATFORM)/liblpsolve55.a
+
+bin/$(PLATFORM)/liblpsolve55.a: $(LIB_OBJ)
+	mkdir -p bin/$(PLATFORM)
+	$(AR) rv $@ $(LIB_OBJ)
+	$(RANLIB) $@
+
+# ── Shared library ──
+shared: bin/$(PLATFORM)/liblpsolve55.so
+
+bin/$(PLATFORM)/liblpsolve55.so: $(LIB_OBJ)
+	mkdir -p bin/$(PLATFORM)
+	$(CC) -shared $(LDFLAGS) -Wl,-soname,liblpsolve55.so \
+		-o $@ $(LIB_OBJ) -lm
+
+# ── Standalone executable ──
+exe: bin/$(PLATFORM)/lp_solve
+
+bin/$(PLATFORM)/lp_solve: $(EXE_OBJ)
+	mkdir -p bin/$(PLATFORM)
+	$(CC) $(LDFLAGS) -o $@ $(EXE_OBJ) -lm
+
+# ── Install ──
+install: all
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	mkdir -p $(DESTDIR)$(PREFIX)/lib
+	mkdir -p $(DESTDIR)$(PREFIX)/include
+	cp bin/$(PLATFORM)/lp_solve      $(DESTDIR)$(PREFIX)/bin/
+	cp bin/$(PLATFORM)/liblpsolve55.a $(DESTDIR)$(PREFIX)/lib/
+	cp bin/$(PLATFORM)/liblpsolve55.so $(DESTDIR)$(PREFIX)/lib/
+	cp lp_lib.h                       $(DESTDIR)$(PREFIX)/include/
+	cp lp_types.h                     $(DESTDIR)$(PREFIX)/include/
+	cp lp_utils.h                     $(DESTDIR)$(PREFIX)/include/
+	cp lp_report.h                    $(DESTDIR)$(PREFIX)/include/
+	cp lp_simplex.h                   $(DESTDIR)$(PREFIX)/include/
+	cp lp_matrix.h                    $(DESTDIR)$(PREFIX)/include/
+	cp lp_mipbb.h                     $(DESTDIR)$(PREFIX)/include/
+	cp lp_Hash.h                      $(DESTDIR)$(PREFIX)/include/
+	cp lp_price.h                     $(DESTDIR)$(PREFIX)/include/
+	cp lp_pricePSE.h                  $(DESTDIR)$(PREFIX)/include/
+	cp lp_presolve.h                  $(DESTDIR)$(PREFIX)/include/
+	cp lp_scale.h                     $(DESTDIR)$(PREFIX)/include/
+	cp lp_MPS.h                       $(DESTDIR)$(PREFIX)/include/
+	cp lp_MDO.h                       $(DESTDIR)$(PREFIX)/include/
+	cp lp_rlp.h                       $(DESTDIR)$(PREFIX)/include/
+	cp lp_rlp_tokens.h                $(DESTDIR)$(PREFIX)/include/
+	cp yacc_read.h                    $(DESTDIR)$(PREFIX)/include/
+	cp lp_SOS.h                       $(DESTDIR)$(PREFIX)/include/
+	cp lp_crash.h                     $(DESTDIR)$(PREFIX)/include/
+	cp lp_wlp.h                       $(DESTDIR)$(PREFIX)/include/
+	cp lp_fortify.h                   $(DESTDIR)$(PREFIX)/include/
+	cp ini.h                          $(DESTDIR)$(PREFIX)/include/
+	cp lp_bit.h                       $(DESTDIR)$(PREFIX)/include/
+	cp lpkit.h                        $(DESTDIR)$(PREFIX)/include/
+	cp lpsolve.h                      $(DESTDIR)$(PREFIX)/include/
+	cp declare.h                      $(DESTDIR)$(PREFIX)/include/
+	cp ufortify.h                     $(DESTDIR)$(PREFIX)/include/
+	cp fortify.h                      $(DESTDIR)$(PREFIX)/include/
+	cp lp_explicit.h                  $(DESTDIR)$(PREFIX)/include/
+	cp lp_solveDLL.h                  $(DESTDIR)$(PREFIX)/include/
+	cp bfp/lp_BFP.h                   $(DESTDIR)$(PREFIX)/include/
+	cp bfp/bfp_LUSOL/lp_LUSOL.h       $(DESTDIR)$(PREFIX)/include/lp_LUSOL.h
+	cp colamd/colamd.h                $(DESTDIR)$(PREFIX)/include/
+	cp shared/commonlib.h             $(DESTDIR)$(PREFIX)/include/
+	cp shared/mmio.h                  $(DESTDIR)$(PREFIX)/include/
+	cp shared/myblas.h                $(DESTDIR)$(PREFIX)/include/
+
+# ── Clean ──
+clean:
+	rm -f $(LIB_OBJ) $(EXE_OBJ)
+	rm -rf bin
+
+# ─────────────────────────────────────────────────────
+# Compilation rules for library objects
+# ─────────────────────────────────────────────────────
+lp_MDO.o: lp_MDO.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+commonlib.o: shared/commonlib.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $< -Ishared
+mmio.o: shared/mmio.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $< -Ishared
+myblas.o: shared/myblas.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $< -Ishared
+ini.o: ini.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+fortify.o: fortify.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+colamd.o: colamd/colamd.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $< -Icolamd
+lp_rlp.o: lp_rlp.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) $(FLEX_BISON_PREFIX_DEFS) -o $@ $<
+lp_crash.o: lp_crash.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_LUSOL.o: bfp/bfp_LUSOL/lp_LUSOL.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lusol.o: bfp/bfp_LUSOL/LUSOL/lusol.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $< -Ibfp/bfp_LUSOL/LUSOL
+lp_Hash.o: lp_Hash.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_lib.o: lp_lib.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_wlp.o: lp_wlp.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_matrix.o: lp_matrix.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_mipbb.o: lp_mipbb.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_MPS.o: lp_MPS.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_params.o: lp_params.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_presolve.o: lp_presolve.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_price.o: lp_price.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_pricePSE.o: lp_pricePSE.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_report.o: lp_report.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_scale.o: lp_scale.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_simplex.o: lp_simplex.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_SOS.o: lp_SOS.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_utils.o: lp_utils.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+yacc_read.o: yacc_read.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<
+lp_solve.o: lp_solve/lp_solve.c
+	$(CC) -c $(CFLAGS) $(INCLUDES) $(DEFS) -o $@ $<