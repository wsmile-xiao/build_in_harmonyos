--- a/config.guess
+++ b/config.guess
@@ -132,6 +132,23 @@
 UNAME_SYSTEM=`(uname -s) 2>/dev/null`  || UNAME_SYSTEM=unknown
 UNAME_VERSION=`(uname -v) 2>/dev/null` || UNAME_VERSION=unknown
 
+# A task may opt in to the target compiler's already-proven machine tuple.
+# This avoids deriving a target from uname strings on cross-runtime systems.
+if test "x${CONFIG_GUESS_USE_CC_DUMPMACHINE-}" = x1 ; then
+	eval $set_cc_for_build
+	if test "x${CC_FOR_BUILD-}" = x -o \
+	   "x${CC_FOR_BUILD-}" = xno_compiler_found ; then
+		echo "$0: error: no compiler is available for -dumpmachine" >&2
+		exit 1
+	fi
+	compiler_machine=`$CC_FOR_BUILD -dumpmachine 2>/dev/null` || compiler_machine=
+	if test -z "$compiler_machine" ; then
+		echo "$0: error: compiler returned an empty machine tuple" >&2
+		exit 1
+	fi
+	echo "$compiler_machine"
+	exit
+fi
 case "${UNAME_SYSTEM}" in
 Linux|GNU|GNU/*)
 	# If the system lacks a compiler, then just pick glibc.
