+static FILE *
+create_ascii_tmpfile (void)
+{
+/* creating a temporary file, with a writable-directory fallback */
+    FILE *stream = tmpfile ();
+#if defined(HAVE_UNISTD_H)
+    const char *tmpdir;
+    char *path;
+    size_t length;
+    int fd;
+
+    if (stream != NULL)
+	return stream;
+    tmpdir = getenv ("TMPDIR");
+    if (tmpdir == NULL || *tmpdir == '\0')
+	return NULL;
+    length = strlen (tmpdir);
+    path = malloc (length + sizeof ("/librasterlite2-ascii-XXXXXX") + 1);
+    if (path == NULL)
+	return NULL;
+    if (tmpdir[length - 1] == '/')
+	snprintf (path, length + sizeof ("/librasterlite2-ascii-XXXXXX"),
+		  "%slibrasterlite2-ascii-XXXXXX", tmpdir);
+    else
+	snprintf (path, length + sizeof ("/librasterlite2-ascii-XXXXXX") + 1,
+		  "%s/librasterlite2-ascii-XXXXXX", tmpdir);
+    fd = mkstemp (path);
+    if (fd < 0)
+      {
+	  free (path);
+	  return NULL;
+      }
+    if (unlink (path) != 0)
+      {
+	  close (fd);
+	  free (path);
+	  return NULL;
+      }
+    stream = fdopen (fd, "w+b");
+    if (stream == NULL)
+	close (fd);
+    free (path);
+#endif
+    return stream;
+}
 
