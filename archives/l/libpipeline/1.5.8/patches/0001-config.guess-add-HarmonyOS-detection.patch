From a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b Mon Sep 17 00:00:00 2001
From: OpenDesk <opendesk@openharmony.io>
Date: Sun, 23 Mar 2026 17:40:00 +0800
Subject: [PATCH 1/2] build-aux/config.guess: add HarmonyOS detection

Add HarmonyOS (__OHOS__) LIBC detection and system case so that
config.guess returns the correct triplet aarch64-unknown-linux-ohos
on HarmonyOS systems.
---
 build-aux/config.guess | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/build-aux/config.guess b/build-aux/config.guess
index original..patched 100644
--- a/build-aux/config.guess
+++ b/build-aux/config.guess
@@ -155,7 +155,9 @@
 
 	set_cc_for_build
 	cat <<-EOF > "$dummy.c"
-	#if defined(__ANDROID__)
+	#if defined(__OHOS__)
+LIBC=ohos
+#elif defined(__ANDROID__)
 	LIBC=android
 	#else
 	#include <features.h>
@@ -981,6 +983,9 @@
     *:Minix:*:*)
 	GUESS=$UNAME_MACHINE-unknown-minix
 	;;
+    *:HarmonyOS:*:*)
+	GUESS=$UNAME_MACHINE-unknown-linux-ohos
+	;;
     aarch64:Linux:*:*)
 	set_cc_for_build
 	CPU=$UNAME_MACHINE
-- 
