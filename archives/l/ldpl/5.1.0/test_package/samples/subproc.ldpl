# SUB-PROCEDURE with LOCAL DATA and RETURN: docs/procedure.md
data:
    counter is number

procedure:
    sub sayHi
        local data:
            line is text
        procedure:
            store "hi from subprocedure" in line
            display line crlf
            return
    end sub
    call sayHi
    store 3 in counter
    display counter crlf
