 static void *fuse_prune_nodes(void *fuse)
 {
 	struct fuse *f = fuse;
 	int sleep_time;
 
 	while(1) {
 		sleep_time = fuse_clean_cache(f);
+#ifdef HAVE_PTHREAD_CANCEL
 		sleep(sleep_time);
+#else
+		/*
+		 * sleep() cannot be interrupted by a cancellation request, so
+		 * wait in one second slices and leave as soon as
+		 * fuse_stop_cleanup_thread() asks us to.
+		 */
+		while (sleep_time > 0 && !f->prune_thread_stop) {
+			int slice = sleep_time > 1 ? 1 : sleep_time;
+
+			sleep(slice);
+			sleep_time -= slice;
+		}
+		if (f->prune_thread_stop)
+			break;
+#endif
 	}
 	return NULL;
 }
 
 int fuse_start_cleanup_thread(struct fuse *f)
 {
 	if (lru_enabled(f))
 		return fuse_start_thread(&f->prune_thread, fuse_prune_nodes, f);
 
 	return 0;
 }
 
 void fuse_stop_cleanup_thread(struct fuse *f)
 {
 	if (lru_enabled(f)) {
 		pthread_mutex_lock(&f->lock);
+#ifdef HAVE_PTHREAD_CANCEL
 		pthread_cancel(f->prune_thread);
+#else
+		/*
+		 * pthread_cancel() is not available: ask the cleanup thread to
+		 * return instead; it notices the flag within a second.
+		 */
+		f->prune_thread_stop = 1;
+#endif
 		pthread_mutex_unlock(&f->lock);
 		pthread_join(f->prune_thread, NULL);
 	}
 }
 
 
