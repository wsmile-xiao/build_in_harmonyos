+# Test for POSIX thread cancellation.  Not every libc provides it (OpenHarmony's
+# libc neither declares nor exports pthread_cancel/pthread_setcancel*), so the
+# callers must be guarded by this feature test rather than a platform macro.
+private_cfg.set('HAVE_PTHREAD_CANCEL',
+        cc.has_function('pthread_cancel', prefix: '#include <pthread.h>'))
 
