#!/bin/sh
# 本机(HMDFS/hmmac=use_task)兼容版 mktemp 垫片。
# 系统 mktemp -d 以 0700 建目录；本文件系统把新目录所有者映射为固定 uid，
# 进程 uid 与之一致性无法保证，0700 目录因此对当前进程不可写
# （autoconf config.status 的 ./confXXXXXX 临时目录即在此处失败）。
# 本垫片改为 umask 002 建目录/文件（组可写，实测 2771 可写），保持唯一性。
set -eu
# pipefail is not POSIX; enable it when the current /bin/sh supports it.
if (set -o pipefail) 2>/dev/null; then
  set -o pipefail
fi
dir=0
dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    -d) dir=1; shift ;;
    -u) dry=1; shift ;;
    -q) shift ;;
    --) shift; break ;;
    -*) shift ;;
    *) break ;;
  esac
done
tmpl="${1:-}"
[ -n "$tmpl" ] || tmpl="${TMPDIR:-/tmp}/tmp.XXXXXX"
case "$tmpl" in
  *XXXXXX) pre="${tmpl%XXXXXX}" ;;
  *) pre="$tmpl" ;;
esac
i=0
while [ "$i" -le 500 ]; do
  cand="${pre}$$-$i"
  if [ "$dry" = 1 ]; then
    printf '%s\n' "$cand"
    exit 0
  fi
  if [ "$dir" = 1 ]; then
    if ( umask 002; mkdir "$cand" ) 2>/dev/null; then
      if ! chmod 2770 "$cand" 2>/dev/null; then
        rmdir "$cand" 2>/dev/null || :
        exit 1
      fi
      printf '%s\n' "$cand"
      exit 0
    fi
  else
    if ( umask 002; set -C; : > "$cand" ) 2>/dev/null; then
      printf '%s\n' "$cand"
      exit 0
    fi
  fi
  i=$((i + 1))
done
exit 1
