+/* GNU C nested functions hoisted to file scope (clang lacks nested functions);
+ * captured variables are passed by pointer/ref as explicit parameters. */
+static int chrget_re(int *wnc,char **c)
+{
+	if (*wnc) {
+		int n=*wnc;
+		*wnc=0;
+		return n;
+	}
+	return get_unichar(*c,c,0);
+}
+static int chrgot_re(int *wnc,char **c,char **d)
+{
+	if (*wnc) {
+		int n=*wnc;
+		*wnc=0;
+		*d=*c;
+		return n;
+	}
+	return get_unichar(*c,d,0);
+}
+static int nchar_re(int wnc,char *c)
+{
+	if (wnc) return wnc;
+	return get_unichar(c,NULL,0);
+}
+static int chcom_re(char *a,char *b)
+{
+	while (*a) if (*a++!=*b++) return 0;
+	if (*b != '}') return 0;
+	return 1;
+}
+static int cmwrd_re(char *fmat,char **c,int *wnc)
+{
+	char *dx=*c;
+	wchar_t wxc=*wnc;
+	wchar_t px,sx;
+	for (;*fmat;) {
+		px=get_unichar(fmat,&fmat,0);
+		if (!px) return 0;
+		if (wxc) {
+			sx=wxc;
+			wxc=0;
+		}
+		else {
+			sx=get_unichar(dx,&dx,0);
+		}
+		if (!sx) return 0;
+		if (isfupper(px)) {
+			if (sx != px) return 0;
+		}
+		else {
+			if (toflower(sx)!=px) return 0;
+		}
+	}
+	sx=get_unichar(dx,NULL,0);
+	if (sx && isfalnum(sx)) return 0;
+	*c=dx;
+	return 1;
+}
 
