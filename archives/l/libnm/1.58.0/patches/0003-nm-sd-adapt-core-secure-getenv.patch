--- a/src/libnm-systemd-core/sd-adapt-core/nm-sd-adapt-core.h
+++ b/src/libnm-systemd-core/sd-adapt-core/nm-sd-adapt-core.h
@@ -55,7 +55,13 @@
 #ifdef HAVE___SECURE_GETENV
 #define secure_getenv __secure_getenv
 #else
-#error neither secure_getenv nor __secure_getenv is available
+/* Neither secure_getenv(3) nor __secure_getenv(3) is provided by the C
+ * library.  Fall back to getenv(3) instead of aborting the build, so this
+ * compatibility header stays portable across libcs that lack the GNU
+ * extension.  (Portability fix; no platform-specific macro.) */
+#ifndef secure_getenv
+#define secure_getenv getenv
+#endif
 #endif
 #endif
 
