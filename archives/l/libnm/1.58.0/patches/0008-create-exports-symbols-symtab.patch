--- a/tools/create-exports-NetworkManager.sh
+++ b/tools/create-exports-NetworkManager.sh
@@ -24,8 +24,13 @@
 
 get_symbols_nm () {
     base=./src/core/NetworkManager-all-sym
-    call_nm "$base" |
-        sed -n 's/^[tTDGRBS] //p' |
+    # OHOS: NetworkManager-all-sym 以 PIE 方式链接且未加 --export-dynamic，本工具链
+    # 下其 .dynsym 仅含导入符号，`nm -D` 取不到定义符号（只剩 _init/_fini），会让
+    # 版本脚本退化为空并触发 set -e 退出。改为读取普通符号表中的全局定义符号
+    # (T/D/G/R/B/S)，等价于 --export-dynamic 之后的动态符号集。
+    "${NM:-nm}" "$base" |
+        sed -n 's/.* \([^ ]\) \([^ ]*\)$/\1 \2/p' |
+        sed -n 's/^[TDGRBS] //p' |
         _sort
 }
 
