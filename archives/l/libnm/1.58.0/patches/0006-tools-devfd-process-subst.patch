+    _nm_tmp_e="${TMPDIR:-.}/nm-exports-explicit-$$.txt"
+    _nm_tmp_n="${TMPDIR:-.}/nm-exports-nm-$$.txt"
+    get_symbols_explicit > "$_nm_tmp_e"
+    get_symbols_nm > "$_nm_tmp_n"
     (for f in $(find ./src/core/settings/plugins/*/ \
                      ./src/core/devices/*/ \
                      ./src/core/ppp/ -name '*.so' 2>/dev/null); do
@@ -43,8 +49,8 @@
             sed -n 's/^\([U]\) \(\(nm_\|nmp_\|_nm\|NM\|_NM\|nmtst_\|c_siphash_\|c_list_\).*\)$/\2/p'
     done) |
         _sort |
-        grep -Fx -f <(get_symbols_explicit) -v |
-        grep -Fx -f <(get_symbols_nm)
+        grep -Fx -f "$_nm_tmp_e" -v |
+        grep -Fx -f "$_nm_tmp_n"
 }
 
