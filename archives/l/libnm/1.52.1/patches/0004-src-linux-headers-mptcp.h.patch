--- a/src/linux-headers/mptcp.h
+++ b/src/linux-headers/mptcp.h
@@ -208,19 +208,27 @@
 	__u32		size_user;			/* size of one element in data[] */
 } __attribute__((aligned(8)));
 
+/* This file is a verbatim copy of the upstream UAPI header, which names the
+ * kernel's sockaddr_storage "struct __kernel_sockaddr_storage". That spelling
+ * is not guaranteed to exist: the HarmonyOS sysroot's <linux/socket.h>
+ * declares the type unprefixed as "struct sockaddr_storage" and has no
+ * __kernel_ alias at all, so the two fields below would stay incomplete.
+ * <sys/socket.h>, included further up, provides the unprefixed type on every
+ * libc, and the two definitions are interchangeable for this union: both are
+ * 128 bytes with ss_family at offset 0. */
 struct mptcp_subflow_addrs {
 	union {
 		__kernel_sa_family_t sa_family;
 		struct sockaddr sa_local;
 		struct sockaddr_in sin_local;
 		struct sockaddr_in6 sin6_local;
-		struct __kernel_sockaddr_storage ss_local;
+		struct sockaddr_storage ss_local;
 	};
 	union {
 		struct sockaddr sa_remote;
 		struct sockaddr_in sin_remote;
 		struct sockaddr_in6 sin6_remote;
-		struct __kernel_sockaddr_storage ss_remote;
+		struct sockaddr_storage ss_remote;
 	};
 };
 
