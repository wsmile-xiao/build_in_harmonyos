--- a/src/libnm-systemd-core/sd-adapt-core/nm-sd-adapt-core.h
+++ b/src/libnm-systemd-core/sd-adapt-core/nm-sd-adapt-core.h
@@ -54,11 +54,38 @@
 #ifndef HAVE_SECURE_GETENV
 #ifdef HAVE___SECURE_GETENV
 #define secure_getenv __secure_getenv
+#elif !defined(__GLIBC__)
+/* The musl-derived HarmonyOS libc provides neither secure_getenv() nor
+ * __secure_getenv(). libnm never raises its own privileges, so getenv() is an
+ * equivalent fallback. */
+#define secure_getenv getenv
 #else
 #error neither secure_getenv nor __secure_getenv is available
 #endif
 #endif
 
+/* sigisemptyset() is a glibc extension too (glibc 2.30). sd-event.c:817 uses
+ * it to decide whether an event source still has signals armed; libcs without
+ * it only expose sigemptyset()/sigismember(). On Linux a zeroed sigset_t
+ * holds no signal, so comparing against one is equivalent - the same fallback
+ * systemd itself carries. */
+#ifndef __GLIBC__
+
+#include <signal.h>
+#include <string.h>
+
+static inline int
+nm_sd__sigisemptyset(const sigset_t *set)
+{
+    static const sigset_t empty;
+
+    return memcmp(set, &empty, sizeof(sigset_t)) == 0;
+}
+
+#define sigisemptyset nm_sd__sigisemptyset
+
+#endif /* !__GLIBC__ */
+
 #include "libnm-base/nm-base.h"
 
 /*****************************************************************************/
