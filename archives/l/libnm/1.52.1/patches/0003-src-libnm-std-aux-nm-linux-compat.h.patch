--- a/src/libnm-std-aux/nm-linux-compat.h
+++ b/src/libnm-std-aux/nm-linux-compat.h
@@ -19,6 +19,34 @@
 #define __KERNEL_DIV_ROUND_UP(n, d) (((n) + (d) - 1) / (d))
 #endif
 
+/* The copies below are newer upstream Linux UAPI headers and, as stated
+ * above, they are meant to win over the headers installed on the system. A
+ * C library may however ship its own - older - copies under a *different*
+ * include guard: the HarmonyOS sysroot declares linux/ethtool.h with
+ * _UAPI_LINUX_ETHTOOL_H and linux/mptcp.h with _UAPI_MPTCP_H, whereas the
+ * copies here use _LINUX_ETHTOOL_H and _MPTCP_H. Both spellings would then
+ * land in the same translation unit (nm-platform-utils.c includes this
+ * header first and <linux/mii.h>, which pulls <linux/ethtool.h>, a few lines
+ * later), and the shared structs, enums and macros would be defined twice.
+ *
+ * Predefining the system guards makes the system copies no-ops, so exactly
+ * one set of definitions - the newer bundled one - is in effect. This is the
+ * same trick the other recipes in this repository use for
+ * _UAPI_LINUX_SOCKET_H (E119); no platform or libc macro is involved.
+ *
+ * The system copy of linux/mptcp.h is suppressed for a second reason: it has
+ * no struct mptcp_subflow_addrs at all, so the bundled copy must stay
+ * authoritative.
+ *
+ * linux/nl802154.h is deliberately not listed: the HarmonyOS sysroot ships
+ * no such header, so there is nothing that could collide with it. */
+#ifndef _UAPI_LINUX_ETHTOOL_H
+#define _UAPI_LINUX_ETHTOOL_H
+#endif
+#ifndef _UAPI_MPTCP_H
+#define _UAPI_MPTCP_H
+#endif
+
 #include "linux-headers/ethtool.h"
 #include "linux-headers/nl802154.h"
 #include "linux-headers/mptcp.h"
