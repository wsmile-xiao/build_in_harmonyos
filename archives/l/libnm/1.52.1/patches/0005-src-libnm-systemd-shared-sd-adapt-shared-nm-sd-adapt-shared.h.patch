+/* The glibc extension secure_getenv() is not available on every libc: the
+ * musl-derived HarmonyOS libc provides neither secure_getenv() nor
+ * __secure_getenv(), which meson records in HAVE_SECURE_GETENV /
+ * HAVE___SECURE_GETENV. libnm never raises its own privileges, so falling
+ * back to plain getenv() keeps the callers working. */
+#ifndef HAVE_SECURE_GETENV
+#ifdef HAVE___SECURE_GETENV
+#define secure_getenv __secure_getenv
+#elif !defined(__GLIBC__)
+#define secure_getenv getenv
+#else
+#error neither secure_getenv nor __secure_getenv is available
+#endif
+#endif
+
+/* qsort_r() is a glibc extension as well; libcs that lack it (musl) only
+ * provide qsort(). sort-util.h calls qsort_r() directly, so build the
+ * userdata-taking variant on top of qsort() using a thread-local comparison
+ * context. */
+#ifndef __GLIBC__
+
+#include <stdlib.h>
+
+typedef struct {
+    int (*compar)(const void *, const void *, void *);
+    void *userdata;
+} NMSdQSortRData;
+
+static inline NMSdQSortRData *
+nm_sd__qsort_r_data(void)
+{
+    static _Thread_local NMSdQSortRData data;
+
+    return &data;
+}
+
+static inline int
+nm_sd__qsort_r_compare(const void *a, const void *b)
+{
+    NMSdQSortRData *data = nm_sd__qsort_r_data();
+
+    return data->compar(a, b, data->userdata);
+}
+
+static inline void
+nm_sd__qsort_r(void *base,
+               size_t nmemb,
+               size_t size,
+               int (*compar)(const void *, const void *, void *),
+               void *userdata)
+{
+    NMSdQSortRData *data = nm_sd__qsort_r_data();
+
+    data->compar = compar;
+    data->userdata = userdata;
+    qsort(base, nmemb, size, nm_sd__qsort_r_compare);
+}
+
+#define qsort_r nm_sd__qsort_r
+
+#endif /* !__GLIBC__ */
+
+/* get_current_dir_name() is a glibc extension as well. path-util.c's
+ * safe_getcwd() expects a freshly allocated, NUL-terminated absolute path
+ * (the caller releases it with _cleanup_free_), which is exactly what
+ * getcwd(NULL, 0) returns. glibc additionally prefers $PWD when that still
+ * points at the current directory; resolving the real path instead is the
+ * stricter behaviour safe_getcwd() asks for anyway - it rejects anything that
+ * does not start with '/' (CVE-2018-1000001). */
+#ifndef __GLIBC__
+
+#include <unistd.h>
+
+static inline char *
+nm_sd__get_current_dir_name(void)
+{
+    return getcwd(NULL, 0);
+}
+
+#define get_current_dir_name nm_sd__get_current_dir_name
+
+#endif /* !__GLIBC__ */
+
 #endif /* (NETWORKMANAGER_COMPILATION) & NM_NETWORKMANAGER_COMPILATION_WITH_SYSTEMD */
 
