--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -5,7 +5,15 @@
 # libraries that were built locally.
 set(OdsStream_FOUND 1)
 set(OdsStream_INCLUDE_DIRS "${CMAKE_SOURCE_DIR}/src")
-set(OdsStream_LIBRARY "${CMAKE_BINARY_DIR}/src/libodsstream.so")
+# HarmonyOS PC (OHOS): prefer the shared lib; fall back to the static
+# archive when the build is configured with BUILD_SHARED_LIBS=OFF. Also
+# add explicit target dependencies: the library path is a plain file
+# path, so parallel make would not otherwise know to build it first.
+if(EXISTS "${CMAKE_BINARY_DIR}/src/libodsstream.so")
+  set(OdsStream_LIBRARY "${CMAKE_BINARY_DIR}/src/libodsstream.so")
+else()
+  set(OdsStream_LIBRARY "${CMAKE_BINARY_DIR}/src/libodsstream.a")
+endif()
 add_library(
     OdsStream::Core UNKNOWN IMPORTED
 )
@@ -47,7 +55,7 @@
     PUBLIC ${OdsStream_INCLUDE_DIRS} ${CMAKE_CURRENT_BINARY_DIR}
 )
 add_test(test_ods "test_ods")
-set_tests_properties(test_ods PROPERTIES ENVIRONMENT "LD_LIBRARY_PATH=${CMAKE_BINARY_DIR}/src")
+set_tests_properties(test_ods PROPERTIES ENVIRONMENT_MODIFICATION "LD_LIBRARY_PATH=path_list_prepend:${CMAKE_BINARY_DIR}/src")
 
 add_executable(
     test_tsv
@@ -67,7 +75,7 @@
     PUBLIC ${OdsStream_INCLUDE_DIRS} ${CMAKE_CURRENT_BINARY_DIR}
 )
 add_test(test_tsv "test_tsv")
-set_tests_properties(test_tsv PROPERTIES ENVIRONMENT "LD_LIBRARY_PATH=${CMAKE_BINARY_DIR}/src")
+set_tests_properties(test_tsv PROPERTIES ENVIRONMENT_MODIFICATION "LD_LIBRARY_PATH=path_list_prepend:${CMAKE_BINARY_DIR}/src")
 
 add_executable(
     test_zlib
@@ -86,4 +94,17 @@
     PUBLIC ${OdsStream_INCLUDE_DIRS} ${CMAKE_CURRENT_BINARY_DIR}
 )
 add_test(test_zlib "test_zlib")
-set_tests_properties(test_zlib PROPERTIES ENVIRONMENT "LD_LIBRARY_PATH=${CMAKE_BINARY_DIR}/src")
+set_tests_properties(test_zlib PROPERTIES ENVIRONMENT_MODIFICATION "LD_LIBRARY_PATH=path_list_prepend:${CMAKE_BINARY_DIR}/src")
+
+# HarmonyOS PC (OHOS): the tests link the library by plain file path;
+# make the build order explicit for parallel make.
+if(TARGET odsstream-static)
+  add_dependencies(test_ods odsstream-static)
+  add_dependencies(test_tsv odsstream-static)
+  add_dependencies(test_zlib odsstream-static)
+endif()
+if(TARGET Core)
+  add_dependencies(test_ods Core)
+  add_dependencies(test_tsv Core)
+  add_dependencies(test_zlib Core)
+endif()
