--- a/CMakeStuff/toolchains/unix-toolchain.cmake
+++ b/CMakeStuff/toolchains/unix-toolchain.cmake
@@ -19,7 +19,25 @@
 add_compile_definitions(CATCH2_MAJOR_VERSION_${Catch2_VERSION_MAJOR})
 
 
-find_package(QuaZip-Qt6 REQUIRED)
+# HarmonyOS PC (OHOS) adaptation: the conan registry provides quazip linked
+# against Qt5 (conan CMakeDeps target QuaZip-Qt5::quazip1-qt5; canonical
+# upstream target name QuaZip::QuaZip). The Qt5/Qt6 co-link is ABI-safe for
+# the QtCore subset libodsstream uses (QString/QFile/QIODevice only). Try
+# QuaZip-Qt6 first, fall back to QuaZip-Qt5, then alias to QuaZip::QuaZip.
+find_package(QuaZip-Qt6 QUIET)
+if(NOT TARGET QuaZip::QuaZip)
+  find_package(QuaZip-Qt5 REQUIRED)
+  if(NOT TARGET QuaZip::QuaZip AND TARGET QuaZip-Qt5::quazip1-qt5)
+    add_library(QuaZip::QuaZip ALIAS QuaZip-Qt5::quazip1-qt5)
+  endif()
+endif()
+
+# OHOS: CMake 4.1 has no Platform/HarmonyOS.cmake, so upstream's
+# find_package(ZLIB REQUIRED) (module mode) cannot run; the conan CMakeDeps
+# config provides zlib::zlib instead. Alias it to the canonical ZLIB::ZLIB.
+if(NOT TARGET ZLIB::ZLIB AND TARGET zlib::zlib)
+  add_library(ZLIB::ZLIB ALIAS zlib::zlib)
+endif()
 
 
 add_definitions(-fPIC)
