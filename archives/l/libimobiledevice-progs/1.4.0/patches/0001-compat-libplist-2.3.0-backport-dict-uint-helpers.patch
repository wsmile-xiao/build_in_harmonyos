diff -ruN old/tools/plist_dict_compat.h new/tools/plist_dict_compat.h
--- a/tools/plist_dict_compat.h	1970-01-01 08:00:00.000000000 +0800
+++ b/tools/plist_dict_compat.h	2026-09-21 22:51:59.121924219 +0800
@@ -0,0 +1,85 @@
+/*
+ * plist_dict_compat.h
+ * Backport of the libplist 2.6.0 dict helper API for libplist >= 2.3.0.
+ *
+ * The libimobiledevice 1.4.0 tools (afcclient.c, idevicecrashreport.c,
+ * ideviceimagemounter.c) use plist_dict_get_uint()/plist_dict_copy_uint(),
+ * which were added in libplist 2.6.0.  The OHOS Conan repository currently
+ * ships libplist/2.3.0, which has all the underlying primitives but not
+ * these two wrappers.  When the configure/conan layer detects libplist
+ * < 2.6.0 it passes -DLIBPLIST_LT_2_6=1 and this header is included by the
+ * affected tools; the implementations below are verbatim upstream
+ * implementations (libplist 2.6.0 src/plist.c) as static inline functions.
+ *
+ * All code below is Copyright (c) the libimobiledevice project authors,
+ * licensed under LGPL-2.1+, identical to the libimobiledevice license.
+ * When the installed libplist is >= 2.6.0 the real library functions are
+ * used and this header is not compiled at all.
+ */
+
+#ifndef PLIST_DICT_COMPAT_H
+#define PLIST_DICT_COMPAT_H
+
+#include <plist/plist.h>
+#include <string.h>
+#include <stdlib.h>
+#include <inttypes.h>
+#include <endian.h>
+
+/* PLIST_OPT_NONE was added in libplist 2.6.0 alongside the plist_dict_*
+ * helpers; it is the documented "no options" value of plist_write_options_t
+ * (plain 0). */
+#ifndef PLIST_OPT_NONE
+#define PLIST_OPT_NONE 0
+#endif
+
+static inline uint64_t plist_dict_get_uint(plist_t dict, const char *key)
+{
+	uint64_t uintval = 0;
+	const char *strval = NULL;
+	uint64_t strsz = 0;
+	plist_t node = plist_dict_get_item(dict, key);
+	if (!node) {
+		return uintval;
+	}
+	switch (plist_get_node_type(node)) {
+	case PLIST_INT:
+		plist_get_uint_val(node, &uintval);
+		break;
+	case PLIST_STRING:
+		strval = plist_get_string_ptr(node, NULL);
+		if (strval) {
+			uintval = strtoull(strval, NULL, 0);
+		}
+		break;
+	case PLIST_DATA:
+		strval = plist_get_data_ptr(node, &strsz);
+		if (strval) {
+			if (strsz == 8) {
+				uintval = le64toh(*(uint64_t*)strval);
+			} else if (strsz == 4) {
+				uintval = le32toh(*(uint32_t*)strval);
+			} else if (strsz == 2) {
+				uintval = le16toh(*(uint16_t*)strval);
+			} else if (strsz == 1) {
+				uintval = strval[0];
+			}
+		}
+		break;
+	default:
+		break;
+	}
+	return uintval;
+}
+
+static inline plist_err_t plist_dict_copy_uint(plist_t target_dict, plist_t source_dict, const char *key, const char *alt_source_key)
+{
+	if (plist_dict_get_item(source_dict, (alt_source_key) ? alt_source_key : key) == NULL) {
+		return PLIST_ERR_INVALID_ARG;
+	}
+	uint64_t u64val = plist_dict_get_uint(source_dict, (alt_source_key) ? alt_source_key : key);
+	plist_dict_set_item(target_dict, key, plist_new_uint(u64val));
+	return PLIST_ERR_SUCCESS;
+}
+
+#endif /* PLIST_DICT_COMPAT_H */
