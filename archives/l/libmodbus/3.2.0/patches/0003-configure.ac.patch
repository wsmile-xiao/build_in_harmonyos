--- a/configure.ac
+++ b/configure.ac
@@ -143,22 +143,41 @@
 
 if test "$os_sunos" = "true"; then
     LIBS="$LIBS -lnsl -lsocket"
     AC_SUBST(LIBS)
 fi
 
 # Check for RS485 support (Linux kernel version 2.6.28+)
 AC_CHECK_DECLS([TIOCSRS485], [], [], [[#include <sys/ioctl.h>]])
 # Check for RTS flags
 AC_CHECK_DECLS([TIOCM_RTS], [], [], [[#include <sys/ioctl.h>]])
-# Check for termios2 support
-AC_CHECK_TYPES([struct termios2], [], [], [[#include <asm/termbits.h>]])
+# Check for termios2 support (struct termios2 plus TCGETS2/TCSETS2 ioctls).
+# Some platforms (e.g. OHOS) expose struct termios2 in asm/termbits.h but
+# do not define the TCGETS2/TCSETS2 ioctl constants, so a type-only check
+# would select the termios2 code path and fail to compile.
+AC_CACHE_CHECK([whether struct termios2 with TCGETS2/TCSETS2 is supported],
+               [ac_cv_have_termios2],
+               [AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[
+#include <asm/termbits.h>
+#include <sys/ioctl.h>
+]], [[
+    struct termios2 t;
+    (void) sizeof(t);
+    (void) TCGETS2;
+    (void) TCSETS2;
+    return 0;
+]])],
+               [ac_cv_have_termios2=yes],
+               [ac_cv_have_termios2=no])])
+AS_IF([test "x$ac_cv_have_termios2" = "xyes"],
+      [AC_DEFINE([HAVE_STRUCT_TERMIOS2], [1],
+                 [Define to 1 if struct termios2 and TCGETS2/TCSETS2 are available])])
 
 WARNING_CFLAGS="-Wall \
 -Wmissing-declarations -Wmissing-prototypes \
 -Wnested-externs -Wpointer-arith \
 -Wsign-compare -Wchar-subscripts \
 -Wstrict-prototypes -Wshadow \
 -Wformat-security"
 AC_SUBST([WARNING_CFLAGS])
 
 # Build options
