diff --git a/faces/KConfigPropertyMapCompat.cpp b/faces/KConfigPropertyMapCompat.cpp
new file mode 100644
index 0000000..59e44ae
--- /dev/null
+++ b/faces/KConfigPropertyMapCompat.cpp
@@ -0,0 +1,40 @@
+/*
+    SPDX-FileCopyrightText: 2025 libksysguard OHOS adaptation
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+#include "KConfigPropertyMapCompat.h"
+
+#include <kconfigloader.h>
+
+KConfigPropertyMap::KConfigPropertyMap(KConfigLoader *config, QObject *parent)
+    : QQmlPropertyMap(this, parent)
+    , m_config(config)
+{
+    const auto items = config->items();
+    for (KConfigSkeletonItem *item : items) {
+        insert(item->name(), item->property());
+    }
+}
+
+KConfigPropertyMap::~KConfigPropertyMap() = default;
+
+bool KConfigPropertyMap::writeBackEnabled() const
+{
+    return m_writeBackEnabled;
+}
+
+void KConfigPropertyMap::setWriteBackEnabled(bool enabled)
+{
+    m_writeBackEnabled = enabled;
+}
+
+QVariant KConfigPropertyMap::updateValue(const QString &key, const QVariant &input)
+{
+    if (m_writeBackEnabled && m_config) {
+        if (KConfigSkeletonItem *item = m_config->findItemByName(key)) {
+            item->setProperty(input);
+            item->writeConfig(m_config->config());
+        }
+    }
+    return input;
+}
diff --git a/faces/KConfigPropertyMapCompat.h b/faces/KConfigPropertyMapCompat.h
new file mode 100644
index 0000000..d51807b
--- /dev/null
+++ b/faces/KConfigPropertyMapCompat.h
@@ -0,0 +1,35 @@
+/*
+    SPDX-FileCopyrightText: 2025 libksysguard OHOS adaptation
+    SPDX-License-Identifier: LGPL-2.0-or-later
+
+    Compatibility implementation of kconfig's KConfigPropertyMap for platforms
+    whose kconfig package is built with KCONFIG_USE_QML=OFF (upstream ships the
+    class only in kconfig's QML module). It provides the subset of the upstream
+    API used by libksysguard and the SensorFace QML components: construction
+    from a KConfigLoader, QQmlPropertyMap semantics (initial population from
+    the loader items, value/updateValue write-back) and the generic
+    QQmlPropertyMap::valueChanged signal the controller reacts to.
+*/
+#pragma once
+
+#include <QQmlPropertyMap>
+
+class KConfigLoader;
+
+class KConfigPropertyMap : public QQmlPropertyMap
+{
+    Q_OBJECT
+public:
+    explicit KConfigPropertyMap(KConfigLoader *config, QObject *parent = nullptr);
+    ~KConfigPropertyMap() override;
+
+    bool writeBackEnabled() const;
+    void setWriteBackEnabled(bool enabled);
+
+protected:
+    QVariant updateValue(const QString &key, const QVariant &input) override;
+
+private:
+    KConfigLoader *m_config = nullptr;
+    bool m_writeBackEnabled = false;
+};
