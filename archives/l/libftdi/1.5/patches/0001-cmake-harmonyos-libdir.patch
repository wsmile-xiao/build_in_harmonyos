--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -5,6 +5,15 @@
 set(PACKAGE libftdi1)
 set(VERSION_STRING ${MAJOR_VERSION}.${MINOR_VERSION})
 set(VERSION ${VERSION_STRING})
+
+# Static-only builds (STATICLIBS=ON and DONT_BUILD_SHARED=ON) build the
+# main ftdi1 target as STATIC; default remains SHARED as upstream.
+if(STATICLIBS AND DONT_BUILD_SHARED)
+  set(LIBFTDI_LIBRARY_TYPE STATIC)
+else()
+  set(LIBFTDI_LIBRARY_TYPE SHARED)
+endif()
+
 set(CMAKE_MODULE_PATH ${CMAKE_SOURCE_DIR}/cmake)

 # CMake
@@ -158,7 +167,7 @@
 set(exec_prefix ${CMAKE_INSTALL_PREFIX}/bin)
 set(includedir  ${CMAKE_INSTALL_PREFIX}/include/${PROJECT_NAME})

-if(${UNIX})
+if(UNIX OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
    set(libdir      ${CMAKE_INSTALL_PREFIX}/lib${LIB_SUFFIX})
 endif(${UNIX})
 if(${WIN32})
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -21,7 +21,7 @@
 set(c_sources     ${CMAKE_CURRENT_SOURCE_DIR}/ftdi.c ${CMAKE_CURRENT_SOURCE_DIR}/ftdi_stream.c CACHE INTERNAL "List of c sources" )
 set(c_headers     ${CMAKE_CURRENT_SOURCE_DIR}/ftdi.h CACHE INTERNAL "List of c headers" )

-add_library(ftdi1 SHARED ${c_sources})
+add_library(ftdi1 ${LIBFTDI_LIBRARY_TYPE} ${c_sources})

 math(EXPR VERSION_FIXUP "${MAJOR_VERSION} + 1")    # Compatibility with previous releases
 set_target_properties(ftdi1 PROPERTIES VERSION ${VERSION_FIXUP}.${MINOR_VERSION}.0 SOVERSION 2)
