diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,2 +1,31 @@
-all:
-	gcc *.c -o lolcode
+CC ?= gcc
+CFLAGS ?= -O2
+LDFLAGS ?=
+PREFIX ?= /usr/local
+DESTDIR ?=
+TMPDIR ?= /tmp
+
+-include config.mk
+
+BIN = lolcode
+
+all: $(BIN)
+
+$(BIN): lolcode.c
+	$(CC) $(CFLAGS) -o $(BIN) lolcode.c $(LDFLAGS)
+
+install: all
+	install -d $(DESTDIR)$(PREFIX)/bin
+	install -m 755 $(BIN) $(DESTDIR)$(PREFIX)/bin/
+
+check: all
+	@echo "Running basic tests..."
+	@printf 'HAI 1.2\nVISIBLE "HAI WORLD!"\nKTHXBYE\n' > $(TMPDIR)/test_lolcode.lol
+	@./$(BIN) -f $(TMPDIR)/test_lolcode.lol
+	@echo "Tests complete."
+	@rm -f $(TMPDIR)/test_lolcode.lol
+
+clean:
+	rm -f $(BIN)
+
+.PHONY: all install check clean
