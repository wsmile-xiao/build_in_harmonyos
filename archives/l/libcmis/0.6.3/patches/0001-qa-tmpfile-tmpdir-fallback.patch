--- a/qa/libcmis/test-decoder.cxx
+++ b/qa/libcmis/test-decoder.cxx
@@ -32,6 +32,46 @@
 #include <cppunit/ui/text/TestRunner.h>
 
 #include <libcmis/xml-utils.hxx>
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <unistd.h>
+
+namespace {
+// Portable TMPDIR-aware tmpfile fallback. Some libcs hardcode /tmp in
+// tmpfile() which fails where /tmp is read-only; honor TMPDIR/TMP/TEMP.
+FILE* libcmis_test_tmpfile( )
+{
+    FILE* f = tmpfile( );
+    if ( f != NULL )
+        return f;
+    const char* dir = getenv( "TMPDIR" );
+    if ( dir == NULL || *dir == '\0' )
+        dir = getenv( "TMP" );
+    if ( dir == NULL || *dir == '\0' )
+        dir = getenv( "TEMP" );
+    if ( dir == NULL || *dir == '\0' )
+        dir = "/tmp";
+    std::string tmpl = std::string( dir ) + "/libcmis-test-XXXXXX";
+    char* buf = new char[tmpl.size( ) + 1];
+    for ( size_t i = 0; i <= tmpl.size( ); ++i )
+        buf[i] = tmpl[i];
+    int fd = mkstemp( buf );
+    if ( fd < 0 )
+    {
+        delete[] buf;
+        return NULL;
+    }
+    unlink( buf );
+    delete[] buf;
+    f = fdopen( fd, "w+" );
+    if ( f == NULL )
+        close( fd );
+    return f;
+}
+}
+
 
