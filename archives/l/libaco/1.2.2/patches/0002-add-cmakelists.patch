diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..6393798
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,34 @@
+cmake_minimum_required(VERSION 3.15)
+project(libaco C ASM)
+
+# libaco: minimal CMake build added by the HarmonyOS port. Upstream ships
+# only acosw.S + aco.c + aco.h (make.sh/test.sh compile ad-hoc test
+# programs, there is no configure/CMake support upstream).
+
+option(BUILD_SHARED_LIBS "Build shared library" OFF)
+
+set(CMAKE_C_STANDARD 11)
+set(CMAKE_C_STANDARD_REQUIRED ON)
+
+set(ACO_SOURCES aco.c acosw.S)
+
+add_library(aco ${ACO_SOURCES})
+set_target_properties(aco PROPERTIES POSITION_INDEPENDENT_CODE ON)
+target_include_directories(aco PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+    $<INSTALL_INTERFACE:include>
+)
+
+include(GNUInstallDirs)
+install(TARGETS aco
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+)
+install(FILES aco.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
+
+enable_testing()
+if(BUILD_TESTING)
+    add_executable(test_aco_tutorial_0 test_aco_tutorial_0.c)
+    target_link_libraries(test_aco_tutorial_0 aco)
+    add_test(NAME test_aco_tutorial_0 COMMAND test_aco_tutorial_0)
+endif()
