+
+# Link flags for test binaries (static libdom + all static deps + libxml2)
+TEST_LIBS := -L$(CURDIR) -L$(PREFIX)/lib \
+	-ldom -lwapcaplet -lhubbub -lparserutils -lxml2 -lm
+
+# Targets
+.PHONY: all clean install uninstall test
+
+all: $(LIB) $(PC)
+
+%.o: %.c
+	$(CC) $(COMPILE_CFLAGS) -c -o $@ $<
+
+$(LIB): $(OBJ)
+	$(AR) rcs $@ $(OBJ)
+	$(RANLIB) $@
+
+$(PC): $(PC_IN)
+	sed -e 's|PREFIX|$(PREFIX)|g' \
+	    -e 's|LIBDIR|$(LIBDIR)|g' \
+	    -e 's|INCLUDEDIR|$(INCLUDEDIR)|g' \
+	    -e 's|VERSION|$(COMPONENT_VERSION)|g' \
+	    -e 's|^REQUIRED|Requires.private: libparserutils libwapcaplet libhubbub libxml-2.0|' \
+	    -e 's|^Libs: -L$${libdir} -ldom LIBRARIES|Libs: -L$${libdir} -ldom\nLibs.private: -lm|' \
+	    $(PC_IN) > $(PC)
+
+clean:
+	rm -f $(OBJ) $(LIB) $(PC)
+	rm -rf build/test-bin
+
+install: all
+	mkdir -p $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig
+	mkdir -p $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/dom
+	cp -R include/dom/dom.h include/dom/functypes.h include/dom/inttypes.h \
+	   include/dom/walk.h include/dom/core include/dom/events include/dom/html \
+	   $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/dom/
+	mkdir -p $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/dom/bindings/hubbub
+	mkdir -p $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/dom/bindings/xml
+	cp bindings/hubbub/errors.h bindings/hubbub/parser.h \
+	   $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/dom/bindings/hubbub/
+	cp bindings/xml/xmlerror.h bindings/xml/xmlparser.h \
+	   $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/dom/bindings/xml/
+	sed -e 's|PREFIX|$(PREFIX)|g' \
+	    -e 's|LIBDIR|$(LIBDIR)|g' \
+	    -e 's|INCLUDEDIR|$(INCLUDEDIR)|g' \
+	    -e 's|VERSION|$(COMPONENT_VERSION)|g' \
+	    -e 's|^REQUIRED|Requires.private: libparserutils libwapcaplet libhubbub libxml-2.0|' \
+	    -e 's|^Libs: -L$${libdir} -ldom LIBRARIES|Libs: -L$${libdir} -ldom\nLibs.private: -lm|' \
+	    $(PC_IN) > $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/$(PC)
+	cp $(LIB) $(DESTDIR)$(PREFIX)/$(LIBDIR)/
+
+uninstall:
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/$(LIB)
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/$(PC)
+	rm -rf $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/dom
+
+# ---------------------------------------------------------------------------
+# Test target
+#
+# The upstream NetSurf test system (testrunner.pl, part of netsurf-buildsystem)
+# is not available on this platform, so a custom test binary is built that
+# exercises the core DOM API plus both bindings (libxml XML parser used by
+# libsvgtiny, and the hubbub HTML parser).
+# ---------------------------------------------------------------------------
+
+TESTDIR := build/test-bin
+TESTCFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE -std=c99 \
+	-I$(CURDIR)/include/ -I$(CURDIR)/src/ \
+	$(PARSERUTILS_CFLAGS) $(WAPCAPLET_CFLAGS) $(HUBBUB_CFLAGS) $(LIBXML2_CFLAGS)
+
+# Link with lld (GNU bfd output is refused execution in the OHOS sandbox).
+# lld needs the SDK's libxml2 at link time, so LD_LIBRARY_PATH is set.
+SDK_LLVM_LIB := /data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib
+LDLINK := LD_LIBRARY_PATH=$(SDK_LLVM_LIB) $(CC)
+
+$(TESTDIR):
+	mkdir -p $(TESTDIR)
+
+$(TESTDIR)/test_dom: test/custom_test.c $(LIB) | $(TESTDIR)
+	$(LDLINK) $(TESTCFLAGS) -o $@ $< $(TEST_LIBS)
+
+test: all $(TESTDIR)/test_dom
+	@echo "=== Running libdom smoke tests ==="
+	@LD_LIBRARY_PATH=$(SDK_LLVM_LIB):$(PREFIX)/lib $(TESTDIR)/test_dom
+	@echo "=== All libdom smoke tests PASSED ==="
