--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -42,8 +42,16 @@
         ENABLE_TESTING()
 
         ADD_SUBDIRECTORY(test)
-        ADD_TEST(NAME ./test/demo COMMAND ./test/demo)
-        ADD_TEST(NAME ./test/test.run COMMAND ./test/test.run)
+        # The unit tests open their fixtures through the relative path
+        # "../test/testdata/..." (see TConfig.cpp, TStdExtension.cpp and
+        # TStringUtil.cpp). That only resolves when the build directory happens
+        # to be a direct child of the source root. Run both test executables
+        # from <source>/test instead, and use $<TARGET_FILE:...> so the command
+        # itself stays valid for out-of-tree build directories.
+        ADD_TEST(NAME ./test/demo COMMAND $<TARGET_FILE:demo>)
+        ADD_TEST(NAME ./test/test.run COMMAND $<TARGET_FILE:test.run>)
+        SET_TESTS_PROPERTIES(./test/demo ./test/test.run
+                PROPERTIES WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}/test")
 endif()
 
