--- a/python/legion_linux/legion_linux/legion.py
+++ b/python/legion_linux/legion_linux/legion.py
@@ -15,6 +15,13 @@
 
 log = logging.getLogger(__name__)
 
+# The module shells out for a few optional probes (dmesg, systemd service state).
+# bash is not guaranteed to exist on every POSIX target -- HarmonyOS PC ships a
+# POSIX shell only -- and a missing bash made those probes raise
+# FileNotFoundError out of the feature constructors, taking the whole CLI down.
+# Use the best available shell instead of hard-requiring bash.
+SHELL = shutil.which('bash') or shutil.which('sh') or 'sh'
+
 
 DEFAULT_ENCODING = "utf8"
 DEFAULT_CONFIG_DIR = "/etc/legion_linux"
@@ -31,7 +38,7 @@
             cmd = 'dmesg | grep legion | tail -n 20' if only_tail else 'dmesg | grep legion'
         else:
             cmd = 'dmesg | tail -n 20' if only_tail else 'dmesg'
-        with subprocess.Popen(['bash', '-c', cmd], stdout=subprocess.PIPE) as process:
+        with subprocess.Popen([SHELL, '-c', cmd], stdout=subprocess.PIPE) as process:
             out, _ = process.communicate(timeout=1)
             out_str = out.decode(DEFAULT_ENCODING)
             return out_str
@@ -648,7 +655,7 @@
     def _exec_cmd(self, cmd, timeout=None) -> Tuple[str, int]:
         log.info('CommandFeature %s execute "%s"', self.name(), cmd)
         try:
-            with subprocess.Popen(['bash', '-c', cmd], stdout=subprocess.PIPE, stderr=subprocess.PIPE) as process:
+            with subprocess.Popen([SHELL, '-c', cmd], stdout=subprocess.PIPE, stderr=subprocess.PIPE) as process:
                 stdout, _ = process.communicate(timeout=timeout)
                 out_str = stdout.decode(DEFAULT_ENCODING)
                 returncode = process.returncode
