--- /dev/null
+++ b/src/compat/linux/ax25.h
@@ -0,0 +1,39 @@
+/*==========================================================================
+   linpac/linux/ax25.h — OpenHarmony compatibility wrapper
+
+   LinPac includes the kernel uapi header <linux/ax25.h>.  On OpenHarmony
+   the sysroot copy of that header cannot be used as-is:
+
+     * it pulls in <linux/socket.h>, which redefines `struct
+       sockaddr_storage` that <sys/socket.h> already provides (the libc
+       definition is guarded by `__MUSL__`, a macro the OHOS clang does
+       not define), and
+     * it uses SIOCPROTOPRIVATE, which on GNU/Linux comes from
+       <asm/socket.h> via a complete <linux/socket.h>; the OHOS sysroot
+       ships the truncated uapi header, so every SIOCAX25* constant fails
+       to expand.
+
+   This wrapper is placed in front of the system include path (the recipe
+   passes -I src/compat, and -I is searched before the -isystem sysroot).
+   It pre-seeds the uapi guard and supplies the two missing pieces, then
+   defers to the real header with #include_next, so no existing
+   `#include <linux/ax25.h>` line has to be touched.
+  =========================================================================*/
+#ifndef LINPAC_COMPAT_LINUX_AX25_H
+#define LINPAC_COMPAT_LINUX_AX25_H
+
+#include <sys/socket.h>
+
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H 1
+typedef unsigned short __kernel_sa_family_t;
+#endif
+
+#ifndef SIOCPROTOPRIVATE
+/* asm-generic/socket.h: private protocol ioctls, 0x89E0 - 0x89EF */
+#define SIOCPROTOPRIVATE 0x89E0
+#endif
+
+#include_next <linux/ax25.h>
+
+#endif /* LINPAC_COMPAT_LINUX_AX25_H */
