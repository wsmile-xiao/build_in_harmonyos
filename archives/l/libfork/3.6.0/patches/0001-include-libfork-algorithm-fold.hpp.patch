     using S = std::decay_t<decltype(std::ranges::end(range))>;
 
     co_return co_await lf::just(detail::fold_overload_impl<I, S, Proj, Bop>{})(
         std::ranges::begin(range), std::ranges::end(range), std::move(bop), std::move(proj) //
     );
   }
