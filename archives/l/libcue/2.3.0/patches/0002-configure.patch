diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,10 @@
+#!/bin/sh
+# CMake configure wrapper for OpenHarmony (toybox sh compatible)
+PREFIX=""
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*) PREFIX=$(echo "$arg" | cut -d= -f2) ;;
+    esac
+done
+[ -z "$PREFIX" ] && PREFIX="/usr/local"
+cmake -S . -B build -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_POLICY_VERSION_MINIMUM=3.5 < /dev/null
