diff -ruN /dev/null b/Makefile
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,12 @@
+# Makefile wrapper for CMake project on OpenHarmony
+all:
+	cd build && $(MAKE) all
+install:
+	cd build && $(MAKE) install DESTDIR="${DESTDIR}"
+test:
+	cd build && $(MAKE) test
+check:
+	cd build && $(MAKE) test
+clean:
+	cd build && $(MAKE) clean
+.PHONY: all install test check clean
