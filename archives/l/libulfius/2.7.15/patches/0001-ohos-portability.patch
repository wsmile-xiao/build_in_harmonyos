From 1cb0c027c7649984bcd5cf8f435483ab0279d2a7 Mon Sep 17 00:00:00 2001
From: j669539 <j669539@noreply.gitcode.com>
Date: Sat, 19 Sep 2026 01:34:53 +0800
Subject: [PATCH] OHOS portability

- GnuTLS/MHD/Jansson/ZLIB/CURL: prefer the Conan CMakeDeps targets
  (gnutls::gnutls, libmicrohttpd::libmicrohttpd, jansson::jansson,
  zlib::zlib, CURL::libcurl) which carry the complete static transitive
  closures; fall back to the upstream bundled find-modules (MODULE mode)
  otherwise
- Orcania/Yder version gates: accept the camel-case VERSION_STRING that
  Conan CMakeDeps exports in addition to the upstream spelling
- Tests: force find_package(Check MODULE) so the bundled FindCheck.cmake
  runs under CMAKE_FIND_PACKAGE_PREFER_CONFIG=ON; relax the Subunit hard
  requirement (ohpcd libcheck is self-contained); link the tests against
  the actual library target (ulfius_static) under BUILD_STATIC
---
 CMakeLists.txt | 91 ++++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 77 insertions(+), 14 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 94f6cb1..552f98a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -115,8 +115,17 @@ list(APPEND ULFIUS_LIBS ${CMAKE_THREAD_LIBS_INIT})
 option(WITH_GNUTLS "GNU TLS support" ON)
 
 if (WITH_GNUTLS)
-    find_package(GnuTLS REQUIRED)
-    list(APPEND ULFIUS_LIBS GnuTLS::GnuTLS)
+    # OHOS portability: prefer the Conan CMakeDeps target (gnutls::gnutls)
+    # which carries the complete static transitive closure (nettle, libtasn1,
+    # libgcrypt, libgpg-error, gmp, libunistring); otherwise fall back to the
+    # upstream bundled FindGnuTLS.cmake (MODULE mode) seeded by the recipe.
+    find_package(gnutls QUIET CONFIG)
+    if (TARGET gnutls::gnutls)
+        list(APPEND ULFIUS_LIBS gnutls::gnutls)
+    else ()
+        find_package(GnuTLS REQUIRED)
+        list(APPEND ULFIUS_LIBS GnuTLS::GnuTLS)
+    endif ()
 endif ()
 
 # websocket support
@@ -137,17 +146,35 @@ else ()
     set(U_DISABLE_GNUTLS ON)
 endif ()
 
-find_package(MHD ${MHD_MIN_VERSION} REQUIRED)
-list(APPEND ULFIUS_LIBS MHD::MHD)
-include_directories(${MHD_INCLUDE_DIRS})
+# OHOS portability: prefer the Conan CMakeDeps target
+# (libmicrohttpd::libmicrohttpd) which carries the transitive link closure;
+# otherwise fall back to the upstream bundled FindMHD.cmake (MODULE mode)
+# seeded by the recipe. The upstream version gate is preserved through the
+# MHD_VERSION_STRING check below.
+find_package(libmicrohttpd QUIET CONFIG)
+if (TARGET libmicrohttpd::libmicrohttpd)
+    list(APPEND ULFIUS_LIBS libmicrohttpd::libmicrohttpd)
+    set(MHD_VERSION_STRING "${libmicrohttpd_VERSION_STRING}")
+else ()
+    find_package(MHD ${MHD_MIN_VERSION} REQUIRED)
+    list(APPEND ULFIUS_LIBS MHD::MHD)
+    include_directories(${MHD_INCLUDE_DIRS})
+    set(MHD_VERSION_STRING "${MHD_VERSION_STRING}")
+endif ()
 if (MHD_VERSION_STRING VERSION_LESS "0.9.53")
     set(WITH_WEBSOCKET OFF)
 endif ()
 
 if (WITH_WEBSOCKET)
     set(U_DISABLE_WEBSOCKET OFF)
-    find_package(ZLIB REQUIRED)
-    list(APPEND ULFIUS_LIBS ZLIB::ZLIB)
+    # OHOS portability: prefer the Conan CMakeDeps target (zlib::zlib).
+    find_package(ZLIB QUIET CONFIG)
+    if (TARGET zlib::zlib)
+        list(APPEND ULFIUS_LIBS zlib::zlib)
+    else ()
+        find_package(ZLIB REQUIRED)
+        list(APPEND ULFIUS_LIBS ZLIB::ZLIB)
+    endif ()
 else ()
     set(U_DISABLE_WEBSOCKET ON)
 endif ()
@@ -161,7 +188,10 @@ endif ()
 option(WITH_CURL "Use Curl library" ON)
 
 if (WITH_CURL)
-    find_package(CURL REQUIRED)
+    # OHOS portability: prefer the Conan CMakeDeps target (CURL::libcurl,
+    # exported by the curl recipe with cmake_target_name). The fallback keeps
+    # the upstream resolution path intact.
+    find_package(CURL QUIET CONFIG)
     # FIXME: CMake 3.12.4 creates CURL::libcurl
     if (NOT TARGET CURL::libcurl)
         add_library(CURL::libcurl INTERFACE IMPORTED)
@@ -179,8 +209,15 @@ option(WITH_JANSSON "Use jansson library" ON)
 
 if (WITH_JANSSON)
     set(JANSSON_MIN_VERSION 2.4)
-    find_package(Jansson ${JANSSON_MIN_VERSION} REQUIRED)
-    list(APPEND ULFIUS_LIBS Jansson::Jansson)
+    # OHOS portability: prefer the Conan CMakeDeps target (jansson::jansson);
+    # fall back to the upstream bundled FindJansson.cmake (MODULE mode).
+    find_package(jansson QUIET CONFIG)
+    if (TARGET jansson::jansson)
+        list(APPEND ULFIUS_LIBS jansson::jansson)
+    else ()
+        find_package(Jansson ${JANSSON_MIN_VERSION} REQUIRED)
+        list(APPEND ULFIUS_LIBS Jansson::Jansson)
+    endif ()
     set(U_DISABLE_JANSSON OFF)
 else ()
     set(U_DISABLE_JANSSON ON)
@@ -273,6 +310,12 @@ endif ()
 # dependencies
 
 find_package(Orcania ${ORCANIA_VERSION_REQUIRED} REQUIRED)
+if (NOT ORCANIA_VERSION_STRING AND Orcania_VERSION_STRING)
+    # OHOS portability: Conan CMakeDeps exports the version as
+    # Orcania_VERSION_STRING (camel case). Accept both spellings; the gate
+    # is still enforced by OrcaniaConfigVersion.cmake.
+    set(ORCANIA_VERSION_STRING "${Orcania_VERSION_STRING}")
+endif ()
 if ("${ORCANIA_VERSION_STRING}" VERSION_GREATER_EQUAL "${ORCANIA_VERSION_REQUIRED}")
     message(STATUS "Orcania found: ${ORCANIA_VERSION_STRING}")
 else ()
@@ -294,6 +337,11 @@ option(WITH_YDER "Use Yder library to log messages" ON)
 
 if (WITH_YDER)
     find_package(Yder ${YDER_VERSION_REQUIRED} REQUIRED)
+    if (NOT YDER_VERSION_STRING AND Yder_VERSION_STRING)
+        # OHOS portability: same camel-case acceptance for the Yder CMakeDeps
+        # export (Yder_VERSION_STRING).
+        set(YDER_VERSION_STRING "${Yder_VERSION_STRING}")
+    endif ()
     if ("${YDER_VERSION_STRING}" VERSION_GREATER_EQUAL "${YDER_VERSION_REQUIRED}")
         message(STATUS "Yder found: ${YDER_VERSION_STRING}")
     else ()
@@ -355,11 +403,20 @@ set (CMAKE_EXTRA_INCLUDE_FILES ${PROJECT_BINARY_DIR})
 option(BUILD_ULFIUS_TESTING "Build the testing tree." OFF) # because we do not use include(CTest)
 
 if (BUILD_ULFIUS_TESTING)
-    find_package(Check REQUIRED)
+    # OHOS portability: force MODULE mode so ulfius's bundled
+    # cmake-modules/FindCheck.cmake runs (CHECK_FOUND / Check::Check). The
+    # Conan toolchain sets CMAKE_FIND_PACKAGE_PREFER_CONFIG=ON which would
+    # otherwise resolve find_package(Check) in CONFIG mode to the CMakeDeps
+    # check-config.cmake and silently drop this whole CTest tree.
+    find_package(Check MODULE)
     if (CHECK_FOUND)
         if (NOT WIN32 AND NOT APPLE)
             include(FindSubunit)
-            find_package(Subunit REQUIRED)
+            # OHOS portability: the ohpcd libcheck (check/0.15.2) is
+            # self-contained and the ulfius tests use only check.h, so
+            # Subunit is not needed at link time (same relaxation as
+            # orcania 2.3.3 / libyder 1.4.20 / libhoel 1.4.29).
+            find_package(Subunit)
         endif ()
 
         enable_testing()
@@ -369,7 +426,13 @@ if (BUILD_ULFIUS_TESTING)
         set(TST_DIR ${CMAKE_CURRENT_SOURCE_DIR}/test)
         set(EXAMPLE_CALLBACK_COMPRESSION_DIR ${CMAKE_CURRENT_SOURCE_DIR}/example_callbacks/http_compression/)
         set(EXAMPLE_CALLBACK_STATIC_FILE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/example_callbacks/static_compressed_inmemory_website/)
-        set(TEST_LIBS Ulfius::Ulfius Check::Check)
+        if (TARGET ulfius_static)
+            # OHOS portability: link the tests against the actual library
+            # target under BUILD_STATIC (ulfius_static).
+            set(TEST_LIBS ulfius_static Check::Check)
+        else ()
+            set(TEST_LIBS Ulfius::Ulfius Check::Check)
+        endif ()
         if (NOT WIN32)
             find_package(Threads REQUIRED)
             list(APPEND TEST_LIBS ${CMAKE_THREAD_LIBS_INIT} m)
@@ -377,7 +440,7 @@ if (BUILD_ULFIUS_TESTING)
         if (NOT APPLE AND NOT WIN32)
             list(APPEND TEST_LIBS rt)
         endif ()
-        if (NOT WIN32 AND NOT APPLE)
+        if (NOT WIN32 AND NOT APPLE AND SUBUNIT_FOUND)
             list(APPEND TEST_LIBS Subunit::Subunit)
         endif ()
         
-- 
2.45.2

