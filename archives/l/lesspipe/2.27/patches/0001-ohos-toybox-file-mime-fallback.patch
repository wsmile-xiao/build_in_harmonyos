diff --git a/lesspipe.sh b/lesspipe.sh
index 4fe2c0d..de710b0 100755
--- a/lesspipe.sh
+++ b/lesspipe.sh
@@ -37,6 +37,49 @@ filetype () {
 	fext=$(fileext "$fname")
 	### get file type from mime type
 	ft=$(file -L -s -b --mime "$1" 2> /dev/null)
+	if [[ -z $ft ]]; then
+		# OHOS (toybox) fallback: the system file command has no --mime
+		# support. Map the plain file(1) description to an equivalent
+		# mime type so archives and compression formats are detected.
+		fchar=binary
+		ft=$(file -L -s -b "$1" 2> /dev/null)
+		case "$ft" in
+			*tar\ archive*)
+				ft=application/x-tar ;;
+			*Zip\ archive*)
+				ft=application/zip ;;
+			*gzip\ compressed*)
+				ft=application/gzip ;;
+			*bzip2\ compressed*)
+				ft=application/x-bzip2 ;;
+			*xz\ compressed*)
+				ft=application/x-xz ;;
+			*zstd\ compressed*)
+				ft=application/zstd ;;
+			*ar\ archive*)
+				# a Debian package is an ar archive containing debian-binary
+				if [[ $(head -c 32 "$1" 2> /dev/null) == *debian-binary* ]]; then
+					ft=application/vnd.debian.binary-package
+				else
+					ft=application/x-archive
+				fi ;;
+			*7-zip\ archive*)
+				ft=application/x-7z-compressed ;;
+			*ASCII\ text*|*ISO-8859\ text*|*UTF-8*text*|*text*)
+				ft=text/plain
+				fchar=utf-8 ;;
+			*directory*)
+				ft=inode/directory ;;
+			*)
+				# RAR archives are reported as plain data by toybox file
+				if [[ $(head -c 4 "$1" 2> /dev/null) == Rar\! ]]; then
+					ft=application/x-rar
+				else
+					ft=application/octet-stream
+				fi ;;
+		esac
+		ft="$ft; charset=$fchar"
+	fi
 	[[ $ft == *=* ]] && fchar="${ft##*=}" || fchar=utf-8
 	fcat="${ft%/*}"
 	ft="${ft#*/}"; ft="${ft%;*}"; ft="${ft#x-script.}"; ft="${ft#x-}"
