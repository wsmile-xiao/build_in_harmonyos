+/* The Linux UAPI <linux/socket.h> (pulled in via <linux/netlink.h>) and the C
+ * library's <sys/socket.h> both define struct sockaddr_storage, so the two
+ * definitions clash once both headers are visible.  Rename the UAPI struct
+ * while the kernel headers are being processed; libmbim never uses the UAPI
+ * sockaddr_storage, and the rename is released again right after. */
+#define sockaddr_storage __linux_uapi_sockaddr_storage
 #include <linux/if_link.h>
 #include <linux/netlink.h>
 #include <linux/rtnetlink.h>
+#undef sockaddr_storage
 
 /* These are built-in files, not provided by the kernel headers,
  * used to add wwan/link symbols if not available */
 #include <kernel/wwan.h>
 #include <kernel/if_link.h>
 
 #include <net/if.h>
 #include <net/if_arp.h>
 #include <sys/socket.h>
 #include <sys/types.h>
