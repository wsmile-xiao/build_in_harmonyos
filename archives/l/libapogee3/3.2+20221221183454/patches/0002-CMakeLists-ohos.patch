--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 3.0)
+cmake_minimum_required(VERSION 3.15)
 PROJECT(libapogee C CXX)
 
 set(CMAKE_CXX_STANDARD 11)
@@ -23,7 +23,10 @@
 
 find_package(USB1 REQUIRED)
 find_package(CURL REQUIRED)
-find_package(INDI REQUIRED)
+# OHOS: INDI is a macro-only dependency here (only indimacros.h is included,
+# no INDI symbols are ever linked). Stub headers are supplied via the
+# INDI_INCLUDE_DIR cache variable set by the recipe.
+# find_package(INDI REQUIRED)
 
 if (CMAKE_VERSION VERSION_LESS 3.12.0)
 set(CURL ${CURL_LIBRARIES})
@@ -32,6 +35,9 @@
 endif()
 
 include_directories( ${INDI_INCLUDE_DIR})
+# Upstream omits the USB include directory (Debian builds resolve it via the
+# default /usr/include path); cross builds need it explicitly.
+include_directories( ${USB1_INCLUDE_DIRS})
 include_directories( ${CMAKE_CURRENT_BINARY_DIR})
 include_directories( ${CMAKE_CURRENT_SOURCE_DIR})
 include_directories( ${CMAKE_CURRENT_SOURCE_DIR}/linux)
@@ -53,7 +59,9 @@
 
 add_library(apogee SHARED ${libapogee_SRCS})
 
-set_target_properties(apogee PROPERTIES VERSION ${APOGEE_VERSION} SOVERSION ${APOGEE_SOVERSION})
+# OHOS: drop the versioned SO layout (HMDFS denies the SOVERSION symlink
+# layout); the recipe emits an unversioned relocatable SONAME instead.
+# set_target_properties(apogee PROPERTIES VERSION ${APOGEE_VERSION} SOVERSION ${APOGEE_SOVERSION})
 
 target_link_libraries(apogee ${USB1_LIBRARIES} ${CURL})
 
