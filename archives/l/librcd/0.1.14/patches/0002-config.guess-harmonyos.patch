--- a/config.guess
+++ b/config.guess
@@ -136,6 +136,17 @@
 UNAME_SYSTEM=`(uname -s) 2>/dev/null`  || UNAME_SYSTEM=unknown
 UNAME_VERSION=`(uname -v) 2>/dev/null` || UNAME_VERSION=unknown
 
+# This bundled config.guess (timestamp 2005-03-24) predates both the aarch64
+# machine and the HarmonyOS system name, and the later LIBC probe cannot fix it
+# on its own: that probe compiles a throwaway program inside a $TMPDIR/cgXXXXXX
+# directory created with `umask 077`, which the HarmonyOS sandbox does not allow
+# to be written (SGID + restricted umask).  Report the canonical GNU triplet
+# directly for aarch64 instead of falling through to the unknown-system error.
+case "${UNAME_MACHINE}:${UNAME_SYSTEM}" in
+    aarch64:HarmonyOS | aarch64:Linux)
+	echo "${UNAME_MACHINE}-unknown-linux-gnu" ; exit 0 ;;
+esac
+
 if [ "${UNAME_SYSTEM}" = "Linux" ] ; then
 	eval $set_cc_for_build
 	cat << EOF > $dummy.c
