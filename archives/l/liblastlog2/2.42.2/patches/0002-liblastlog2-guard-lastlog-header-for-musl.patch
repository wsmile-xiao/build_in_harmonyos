--- a/liblastlog2/src/lastlog2.c
+++ b/liblastlog2/src/lastlog2.c
@@ -28,13 +28,30 @@
 #include <pwd.h>
 #include <errno.h>
 #include <time.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <limits.h>
 #include <sys/stat.h>
 #include <sqlite3.h>
-#include <lastlog.h>
+
+/*
+ * <lastlog.h> is a glibc-only header.  musl (and therefore the OHOS libc)
+ * does not provide it.  Only ll2_import_lastlog() consumes legacy
+ * fixed-size lastlog records, so for non-glibc builds provide a
+ * glibc-compatible struct lastlog: with 64-bit time_t on aarch64 the
+ * layout matches glibc (sizeof(struct lastlog) == 296), keeping legacy
+ * lastlog files readable.
+ */
+#if defined(__GLIBC__)
+#include <lastlog.h>
+#else
+struct lastlog {
+	time_t ll_time;
+	char ll_line[32];
+	char ll_host[256];
+};
+#endif

 #include "lastlog2P.h"
 #include "strutils.h"
