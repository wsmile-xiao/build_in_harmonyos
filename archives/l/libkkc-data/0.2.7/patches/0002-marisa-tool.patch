+import os
 import re
+import struct
+import subprocess
+import tempfile
 
 NGRAM = 3
 NGRAM_LINE_REGEX = '^([-0-9.]+)[ \t]+([^\t]+?)(?:[ \t]+([-0-9.]+))?$'
 
+
+def build_trie(keys, output_path, tool, want_ids=True):
+    """Build a marisa trie from `keys` (in order), save it, return {key: id}.
+
+    The trie is built by the `marisa_tool` helper process rather than by an
+    in-process marisa extension: the OHOS build worker only lets a process
+    load shared objects that carry the `hnp_file` security label, while build
+    products live in user-owned paths (hmdfs label), so importing a freshly
+    built CPython extension module there fails with "Permission denied"
+    (hmmac security labels, see knowledge E212).
+    """
+    workdir = os.path.dirname(os.path.abspath(output_path)) or "."
+    fd, keys_path = tempfile.mkstemp(prefix=".sortlm-keys-", dir=workdir)
+    os.close(fd)
+    try:
+        with open(keys_path, "w", encoding="utf-8", newline="\n") as f:
+            for key in keys:
+                f.write(key + "\n")
+        command = [tool, "build", keys_path, output_path]
+        if not want_ids:
+            command.append("--no-ids")
+        output = subprocess.check_output(command)
+    finally:
+        os.remove(keys_path)
+    key_ids = {}
+    for line in output.decode("utf-8").splitlines():
+        key_id, _, key = line.partition("\t")
+        key_ids[key] = int(key_id)
+    return key_ids
+
