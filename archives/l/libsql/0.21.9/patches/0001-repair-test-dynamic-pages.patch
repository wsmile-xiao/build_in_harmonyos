+# Walk trunk pages one read at a time. This is not the recursive CTE under
+# test, so test 1.5 cannot pass by comparing that CTE with itself.
+set expected_trunks [list]
+set trunk_next [db one {SELECT sqlite_readint32(data, 32) FROM sqlite_dbpage WHERE pgno=1}]
+set trunk_guard [db one {PRAGMA page_count}]
+while {$trunk_next>1 && [llength $expected_trunks]<$trunk_guard} {
+  lappend expected_trunks $trunk_next
+  set trunk_next [db one "SELECT sqlite_readint32(data) FROM sqlite_dbpage WHERE pgno=$trunk_next"]
+}
+if {[llength $expected_trunks]==0} {
+  error "checkfreelist01: independent trunk walk found no pages"
+}
