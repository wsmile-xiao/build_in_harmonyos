+# Select a real trunk page with at least three leaf entries. Page ids vary
+# when the pinned SQLite fork changes its page allocation layout.
+set trunkPage [db one {
+  WITH freelist_trunk(i, d, n) AS (
+    SELECT 1, NULL, sqlite_readint32(data, 32) FROM sqlite_dbpage WHERE pgno=1
+    UNION ALL
+    SELECT n, data, sqlite_readint32(data)
+      FROM freelist_trunk, sqlite_dbpage WHERE pgno=n
+  )
+  SELECT i FROM freelist_trunk
+   WHERE i!=1 AND sqlite_readint32(d,4)>=3
+   ORDER BY i LIMIT 1;
+}]
+
+set nFree [db one {PRAGMA freelist_count}]
+set expected [list "free-list count mismatch: actual=[expr {$nFree-1}] header=$nFree"]
