diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -0,0 +1,46 @@
+PREFIX ?= /usr/local
+DESTDIR ?=
+
+CC ?= cc
+CFLAGS ?= -O2 -Wall -fPIC
+AR ?= ar
+RANLIB ?= ranlib
+
+SQLITE3_CFLAGS := $(shell pkg-config --cflags sqlite3)
+SQLITE3_LIBS := $(shell pkg-config --libs sqlite3)
+ZLIB_CFLAGS := $(shell pkg-config --cflags zlib)
+ZLIB_LIBS := $(shell pkg-config --libs zlib)
+
+ALL_CFLAGS = $(CFLAGS) $(SQLITE3_CFLAGS) $(ZLIB_CFLAGS) -I.
+ALL_LDFLAGS = $(SQLITE3_LIBS) $(ZLIB_LIBS) -lm
+
+HEADERS = libfossil.h libfossil-config.h
+SRC = libfossil.c
+OBJ = libfossil.o
+
+LIB_STATIC = libfossil.a
+LIB_SHARED = libfossil.so
+
+.PHONY: all clean install
+
+all: $(LIB_STATIC) $(LIB_SHARED)
+
+$(OBJ): $(SRC) $(HEADERS)
+	$(CC) $(ALL_CFLAGS) -c $(SRC) -o $(OBJ)
+
+$(LIB_STATIC): $(OBJ)
+	$(AR) rc $(LIB_STATIC) $(OBJ)
+	$(RANLIB) $(LIB_STATIC)
+
+$(LIB_SHARED): $(OBJ)
+	$(CC) -shared $(ALL_CFLAGS) -o $(LIB_SHARED) $(OBJ) $(ALL_LDFLAGS) -Wl,-soname,libfossil.so
+
+install: all
+	mkdir -p $(DESTDIR)$(PREFIX)/lib
+	mkdir -p $(DESTDIR)$(PREFIX)/include
+	cp $(LIB_STATIC) $(DESTDIR)$(PREFIX)/lib/
+	cp $(LIB_SHARED) $(DESTDIR)$(PREFIX)/lib/
+	cp $(HEADERS) $(DESTDIR)$(PREFIX)/include/
+
+clean:
+	rm -f $(OBJ) $(LIB_STATIC) $(LIB_SHARED)