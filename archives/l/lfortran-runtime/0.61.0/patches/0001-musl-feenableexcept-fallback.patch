--- a/src/libasr/runtime/lfortran_intrinsics.c
+++ b/src/libasr/runtime/lfortran_intrinsics.c
@@ -8521,7 +8521,26 @@
     // denormal: Linux feenableexcept doesn't have a separate flag;
     // on x86, we handle it via MXCSR below
     if (excepts) {
+#if defined(__GLIBC__)
         feenableexcept(excepts);
+#elif defined(__aarch64__)
+        // Non-glibc libcs (e.g. musl as used by OHOS/HarmonyOS) do not provide
+        // the GNU extension feenableexcept(); unmask the FP exceptions by
+        // setting the FPCR trap-enable bits directly (ARMv8-A AArch64).
+        // FPCR trap enable bits: 8=IOE(invalid), 9=DZE(divbyzero),
+        //                        10=OFE(overflow), 11=UFE(underflow), 12=IXE(inexact)
+        uint64_t fpcr;
+        __asm__ __volatile__("mrs %0, fpcr" : "=r"(fpcr));
+        if (excepts & FE_INVALID)   fpcr |= (1ULL << 8);   // IOE - Invalid Operation
+        if (excepts & FE_DIVBYZERO) fpcr |= (1ULL << 9);   // DZE - Division by Zero
+        if (excepts & FE_OVERFLOW)  fpcr |= (1ULL << 10);  // OFE - Overflow
+        if (excepts & FE_UNDERFLOW) fpcr |= (1ULL << 11);  // UFE - Underflow
+        if (excepts & FE_INEXACT)   fpcr |= (1ULL << 12);  // IXE - Inexact
+        __asm__ __volatile__("msr fpcr, %0" : : "r"(fpcr));
+#else
+        // Neither feenableexcept() nor a known FPCR layout: leave masked.
+        (void)excepts;
+#endif
     }
 #if defined(__x86_64__) || defined(__i386__)
     if (trap_mask & LCOMPILERS_FE_DENORMAL) {
