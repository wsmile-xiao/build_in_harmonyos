--- a/intl/Makefile.in	2020-10-31 18:02:34.000000000 +0800
+++ b/intl/Makefile.in	2026-09-16 14:27:37.932866250 +0800
@@ -41,7 +41,12 @@
 INSTALL_DATA = @INSTALL_DATA@
 MKINSTALLDIRS = @MKINSTALLDIRS@
 
-l = @l@
+# OHOS: the upstream intl/Makefile.in uses the gettext-0.10.35-only `l`
+# libtool-suffix substitution.  The tarball's configure was regenerated
+# with autoconf 2.69, whose config.status no longer substitutes @l@, so
+# `libintl.$la` would expand to `libintl.@l@a` and break make.  We never
+# use libtool here (plain static archive), so hardcode the empty suffix.
+l =
 
 AR = ar
 CC = @CC@
@@ -83,7 +88,11 @@
 
 all: all-@USE_INCLUDED_LIBINTL@
 
-all-yes: libintl.$la intlh.inst
+# OHOS: drop the intlh.inst target - the upstream tarball does not ship
+# intl/intlh.inst.in, so make dies with "No rule to make target".
+# The installed-header copy only matters for external gettext users; we
+# link the bundled libintl.a statically.
+all-yes: libintl.$la
 all-no:
 
 libintl.a: $(OBJECTS)
@@ -203,16 +212,6 @@
 	cd .. \
 	  && CONFIG_FILES=$(subdir)/$@ CONFIG_HEADERS= $(SHELL) ./config.status
 
-# The dependency for intlh.inst is different in gettext and all other
-# packages.  Because we cannot you GNU make features we have to solve
-# the problem while rewriting Makefile.in.
-intlh.inst: intlh.inst.in ../config.status
-	cd .. \
-	&& CONFIG_FILES=$(subdir)/$@ CONFIG_HEADERS= \
-	  $(SHELL) ./config.status
-.PHONY: intlh.inst
-intlh.inst:
-
 # Tell versions [3.59,3.63) of GNU make not to export all variables.
 # Otherwise a system limit (for SysV at least) may be exceeded.
 .NOEXPORT:
