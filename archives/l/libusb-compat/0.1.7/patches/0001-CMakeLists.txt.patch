diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -0,0 +1,72 @@
+cmake_minimum_required(VERSION 3.10)
+project(libusb-compat VERSION 0.1.7)
+
+# --- Conan-generated find module for libusb-1.0 ---------------------
+# CMakeDeps produces libusb-1.0Config.cmake with an imported target
+# libusb-1.0::libusb-1.0.  The Conan recipe declares the dependency as
+# libusb/1.0.27 which sets cmake_file_name=libusb-1.0.
+find_package(libusb-1.0 CONFIG REQUIRED)
+
+# --- Config header --------------------------------------------------
+option(ENABLE_LOG "Enable logging" ON)
+option(ENABLE_DEBUG_LOG "Enable debug logging" OFF)
+
+configure_file(
+    ${CMAKE_CURRENT_SOURCE_DIR}/config.h.cmake
+    ${CMAKE_CURRENT_BINARY_DIR}/config.h
+)
+
+# --- Library sources ------------------------------------------------
+set(LIBUSB_COMPAT_SOURCES libusb/core.c)
+set(LIBUSB_COMPAT_HEADERS libusb/usb.h)
+
+add_library(usb ${LIBUSB_COMPAT_SOURCES})
+
+target_include_directories(usb
+    PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+        $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}>
+        $<INSTALL_INTERFACE:include>
+)
+
+target_compile_options(usb PRIVATE
+    -fvisibility=hidden
+    -std=gnu99
+    -Wall
+    -Wundef
+    -Wunused
+    -Wstrict-prototypes
+    -Werror-implicit-function-declaration
+)
+
+# Link to libusb-1.0 via the Conan-imported target
+target_link_libraries(usb PRIVATE libusb-1.0::libusb-1.0 ${CMAKE_DL_LIBS})
+
+# LT_MAJOR=8, LT_REVISION=4, LT_AGE=4 → soversion 4.4.4
+set_target_properties(usb PROPERTIES
+    VERSION 4.4.4
+    SOVERSION 0.1
+    OUTPUT_NAME usb
+)
+
+# --- pkg-config file ------------------------------------------------
+set(prefix ${CMAKE_INSTALL_PREFIX})
+set(exec_prefix "\${prefix}")
+set(libdir "\${exec_prefix}/lib")
+set(includedir "\${prefix}/include")
+set(VERSION ${PROJECT_VERSION})
+configure_file(
+    ${CMAKE_CURRENT_SOURCE_DIR}/libusb.pc.in
+    ${CMAKE_CURRENT_BINARY_DIR}/libusb.pc
+    @ONLY
+)
+
+# --- Install rules --------------------------------------------------
+install(TARGETS usb
+    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION lib
+    RUNTIME DESTINATION bin
+)
+
+install(FILES libusb/usb.h DESTINATION include)
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/libusb.pc DESTINATION lib/pkgconfig)
