+        struct kqueue *kq, *kq_tmp;
+        LIST_FOREACH_SAFE(kq, &kq_list, kq_entry, kq_tmp) {
+            if (fcntl(kq->kq_id, F_GETFD) < 0 && errno == EBADF) {
+                dbg_printf("kq=%p - fd=%i closed, cleaning up", kq, kq->kq_id);
+                kqueue_free(kq);
+            }
+        }
+#else
+        /* Should not happen */
         dbg_printf("fd=%i - not a known FD", fd);
+#endif
         return;
     }
 
