      */
     fd = fd_map[signal_fd];
     if (fd < 0) {
-       /* Should not happen */
+#if defined(__OHOS__)
+        /*
+         * OHOS (musl libc) does not populate si_fd when the RT signal
+         * (F_SETSIG) is delivered to sigwaitinfo, so signal_fd is 0 here
+         * and fd_map[0] is -1 (libc probe / R8 exception). Fall back to
