+
+/*
+ * OHOS (musl-based libc) does not export the GNU pthread cancellation API
+ * (pthread_cancel / pthread_setcancelstate / pthread_testcancel) from its
+ * sysroot libc (verified: nm -D <sysroot>/usr/lib/aarch64-linux-ohos/libc.so
+ * | grep pthread_cancel -> no hits). musl does not implement POSIX thread
+ * cancellation. Provide no-op/consistent stubs so the kqueue monitoring,
+ * proc and kevent paths link and behave deterministically. __OHOS__ acts as
+ * the libc probe here (__MUSL__ is not defined by this toolchain).
+ */
+#if defined(__OHOS__)
+#include <pthread.h>
+#include <errno.h>
+static int kqueue_cancel_state = PTHREAD_CANCEL_ENABLE;
+static inline int pthread_setcancelstate(int state, int *oldstate)
+{
+    if (oldstate != NULL)
+        *oldstate = kqueue_cancel_state;
+    kqueue_cancel_state = state;
+    return 0;
+}
+static inline void pthread_testcancel(void)
+{
+    /* no-op: cancellation is not supported by OHOS libc */
+}
+static inline int pthread_cancel(pthread_t thread)
+{
+    (void) thread;
+    return ESRCH; /* nothing was cancelled; callers log and proceed */
+}
 #endif
 
