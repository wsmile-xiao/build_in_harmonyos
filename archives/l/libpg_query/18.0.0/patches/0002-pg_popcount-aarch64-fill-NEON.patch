 #ifdef POPCNT_AARCH64
 
@@ -92,7 +93,45 @@
  * pointers to vary the implementation.  We instead just make these actual
  * external functions when USE_SVE_POPCNT_WITH_RUNTIME_CHECK is not defined.
  * The compiler should be able to inline the Neon versions here.
+ *
+ * NOTE (OHOS adaptation): upstream extract_source.rb
+ * stripped the actual NEON bodies of pg_popcount_neon / pg_popcount_masked_neon
+ * from this file.  Provide them here so the static lib links.
  */
+static uint64
+pg_popcount_neon(const char *buf, int bytes)
+{
+	uint64 result = 0;
+	const uint8_t *b8 = (const uint8_t *) buf;
+	int i;
+
+	for (i = 0; i < bytes; i++)
+		result += __builtin_popcountl((unsigned long) b8[i]);
+
+	return result;
+}
+
+static uint64
+pg_popcount_masked_neon(const char *buf, int bytes, bits8 mask)
+{
+	uint64 result = 0;
+	const uint8_t *b8 = (const uint8_t *) buf;
+	const uint8_t m = (uint8_t) mask;
+	int i;
+
+	if (m == 0)
+		return 0;
+
+	for (i = 0; i < bytes; i++)
+	{
+		uint8_t v = (uint8_t) (b8[i] & m);
+		if (v)
+			result += __builtin_popcountl((unsigned long) v);
+	}
+
+	return result;
+}
