+def _resolve_command(name):
+    """Return an absolute path for ``name`` when the platform needs one.
+
+    HarmonyOS runs subprocess through posix_spawn() without searching PATH
+    for the program name, so spawning the bare name 'apt-cache' fails with
+    ENOENT even though the command is present on PATH. Resolving it first
+    keeps the behaviour unchanged on Linux, where shutil.which() succeeds.
+    """
+    return shutil.which(name) or name
