--- /dev/null	2026-09-03 12:41:53.756897188 +0800
+++ b/src/plist_dict_compat.h	2026-09-03 12:52:47.564897188 +0800
@@ -0,0 +1,162 @@
+/*
+ * plist_dict_compat.h
+ * Backport of libplist 2.6.0 dict helper API for libplist >= 2.3.0.
+ *
+ * libtatsu 1.0.5 tss.c uses these 7 helpers (192 call sites) that were
+ * added in libplist 2.6.0. The OHOS Conan repository currently ships
+ * libplist/2.3.0, so we backport the exact upstream implementations
+ * (from libplist 2.6.0 src/plist.c) as static inline functions here.
+ *
+ * All code below is Copyright (c) the libimobiledevice project authors,
+ * licensed under LGPL-2.1+, identical to the libtatsu license. When the
+ * system libplist is >= 2.6.0 the real library functions are used and
+ * this header is not compiled.
+ */
+
+#ifndef PLIST_DICT_COMPAT_H
+#define PLIST_DICT_COMPAT_H
+
+#include <plist/plist.h>
+#include <string.h>
+#include <stdlib.h>
+#include <inttypes.h>
+
+/* PLIST_OPT_NONE was added in libplist 2.6.0 alongside the
+ * plist_dict_* helpers; it is the documented "no options" value of
+ * plist_write_options_t (plain 0). */
+#ifndef PLIST_OPT_NONE
+#define PLIST_OPT_NONE 0
+#endif
+
+static inline uint8_t plist_dict_get_bool(plist_t dict, const char *key)
+{
+	uint8_t bval = 0;
+	uint64_t uintval = 0;
+	const char *strval = NULL;
+	uint64_t strsz = 0;
+	plist_t node = plist_dict_get_item(dict, key);
+	if (!node) {
+		return 0;
+	}
+	switch (plist_get_node_type(node)) {
+	case PLIST_BOOLEAN:
+		plist_get_bool_val(node, &bval);
+		break;
+	case PLIST_INT:
+		plist_get_uint_val(node, &uintval);
+		bval = (uintval) ? 1 : 0;
+		break;
+	case PLIST_STRING:
+		strval = plist_get_string_ptr(node, NULL);
+		if (strval) {
+			if (!strcmp(strval, "true")) {
+				bval = 1;
+			} else if (!strcmp(strval, "false")) {
+				bval = 0;
+			}
+		}
+		break;
+	case PLIST_DATA:
+		strval = plist_get_data_ptr(node, &strsz);
+		if (strval) {
+			if (strsz == 1) {
+				bval = (strval[0]) ? 1 : 0;
+			}
+		}
+		break;
+	default:
+		break;
+	}
+	return bval;
+}
+
+static inline uint64_t plist_dict_get_uint(plist_t dict, const char *key)
+{
+	uint64_t uintval = 0;
+	const char *strval = NULL;
+	uint64_t strsz = 0;
+	plist_t node = plist_dict_get_item(dict, key);
+	if (!node) {
+		return uintval;
+	}
+	switch (plist_get_node_type(node)) {
+	case PLIST_INT:
+		plist_get_uint_val(node, &uintval);
+		break;
+	case PLIST_STRING:
+		strval = plist_get_string_ptr(node, NULL);
+		if (strval) {
+			uintval = strtoull(strval, NULL, 0);
+		}
+		break;
+	case PLIST_DATA:
+		strval = plist_get_data_ptr(node, &strsz);
+		if (strval) {
+			if (strsz == 8) {
+				uintval = le64toh(*(uint64_t*)strval);
+			} else if (strsz == 4) {
+				uintval = le32toh(*(uint32_t*)strval);
+			} else if (strsz == 2) {
+				uintval = le16toh(*(uint16_t*)strval);
+			} else if (strsz == 1) {
+				uintval = strval[0];
+			}
+		}
+		break;
+	default:
+		break;
+	}
+	return uintval;
+}
+
+static inline plist_err_t plist_dict_copy_item(plist_t target_dict, plist_t source_dict, const char *key, const char *alt_source_key)
+{
+	plist_t node = plist_dict_get_item(source_dict, (alt_source_key) ? alt_source_key : key);
+	if (!node) {
+		return PLIST_ERR_INVALID_ARG;
+	}
+	plist_dict_set_item(target_dict, key, plist_copy(node));
+	return PLIST_ERR_SUCCESS;
+}
+
+static inline plist_err_t plist_dict_copy_bool(plist_t target_dict, plist_t source_dict, const char *key, const char *alt_source_key)
+{
+	if (plist_dict_get_item(source_dict, (alt_source_key) ? alt_source_key : key) == NULL) {
+		return PLIST_ERR_INVALID_ARG;
+	}
+	uint8_t bval = plist_dict_get_bool(source_dict, (alt_source_key) ? alt_source_key : key);
+	plist_dict_set_item(target_dict, key, plist_new_bool(bval));
+	return PLIST_ERR_SUCCESS;
+}
+
+static inline plist_err_t plist_dict_copy_uint(plist_t target_dict, plist_t source_dict, const char *key, const char *alt_source_key)
+{
+	if (plist_dict_get_item(source_dict, (alt_source_key) ? alt_source_key : key) == NULL) {
+		return PLIST_ERR_INVALID_ARG;
+	}
+	uint64_t u64val = plist_dict_get_uint(source_dict, (alt_source_key) ? alt_source_key : key);
+	plist_dict_set_item(target_dict, key, plist_new_uint(u64val));
+	return PLIST_ERR_SUCCESS;
+}
+
+static inline plist_err_t plist_dict_copy_string(plist_t target_dict, plist_t source_dict, const char *key, const char *alt_source_key)
+{
+	plist_t node = plist_dict_get_item(source_dict, (alt_source_key) ? alt_source_key : key);
+	if (!PLIST_IS_STRING(node)) {
+		return PLIST_ERR_INVALID_ARG;
+	}
+	plist_dict_set_item(target_dict, key, plist_copy(node));
+	return PLIST_ERR_SUCCESS;
+}
+
+static inline plist_err_t plist_dict_copy_data(plist_t target_dict, plist_t source_dict, const char *key, const char *alt_source_key)
+{
+	plist_t node = plist_dict_get_item(source_dict, (alt_source_key) ? alt_source_key : key);
+	if (!PLIST_IS_DATA(node)) {
+		return PLIST_ERR_INVALID_ARG;
+	}
+	plist_dict_set_item(target_dict, key, plist_copy(node));
+	return PLIST_ERR_SUCCESS;
+}
+
+#endif /* PLIST_DICT_COMPAT_H */
--- a/src/tss.c	2026-09-03 12:41:53.756897188 +0800
+++ b/src/tss.c	2026-09-03 12:52:47.564897188 +0800
@@ -41,0 +42,14 @@
+/* The plist_dict_get_bool/get_uint and plist_dict_copy_* helpers used
+ * throughout this file were added in libplist 2.6.0. This recipe builds
+ * against libplist 2.3.0, which has all the underlying primitives but not
+ * these wrappers; libplist exports no version macros, so the choice is
+ * made at configure time (LIBPLIST_LT_2_6) via the compat patch. */
+#ifdef LIBPLIST_LT_2_6
+#include "plist_dict_compat.h"
+#else
+/* PLIST_OPT_NONE also only exists from 2.6.0 on; it is a plain 0. */
+#ifndef PLIST_OPT_NONE
+#define PLIST_OPT_NONE 0
+#endif
+#endif
+
