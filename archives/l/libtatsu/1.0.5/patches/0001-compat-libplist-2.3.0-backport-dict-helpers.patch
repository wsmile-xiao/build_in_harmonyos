+# --- libplist < 2.6.0 compat detection (added by OHOS adaptation) ---
+# tss.c needs the plist_dict_* helpers introduced in libplist 2.6.0; when
+# the installed libplist is older, pass -DLIBPLIST_LT_2_6 so tss.c compiles
+# the verbatim backport in src/plist_dict_compat.h.
+if test -n "$PKG_CONFIG"; then
+  if $PKG_CONFIG --atleast-version=2.6.0 libplist-2.0 2>/dev/null; then
+    :
+  else
+    CPPFLAGS="$CPPFLAGS -DLIBPLIST_LT_2_6=1"
+  fi
+fi
+
