--- a/CMakeLists.txt	2026-08-31 22:17:18.821565157 +0800
+++ b/CMakeLists.txt	2026-08-31 22:21:52.093565782 +0800
@@ -189,6 +189,12 @@
   # Zlib and ZSTD need to be found otherwise disable it
   if(NOT TARGET ZLIB::ZLIB)
     find_package(ZLIB)
+    # Conan CMakeDeps for the ohpcd zlib recipe exposes the imported
+    # target as zlib::zlib; upstream links against ZLIB::ZLIB. Alias it
+    # so the same target name is available on OHOS and other platforms.
+    if(TARGET zlib::zlib AND NOT TARGET ZLIB::ZLIB)
+      add_library(ZLIB::ZLIB ALIAS zlib::zlib)
+    endif()
   else()
     # Presumably in this case, the target has been found externally but set this flag just in case
     set(ZLIB_FOUND TRUE)
@@ -218,6 +224,9 @@
     set(ZSTD_LIB libzstd_shared)
   elseif(TARGET libzstd_static)
     set(ZSTD_LIB libzstd_static)
+  elseif(TARGET zstd::libzstd)
+    # Conan CMakeDeps for the ohpcd zstd recipe exposes zstd::libzstd.
+    set(ZSTD_LIB zstd::libzstd)
   else()
     set(ZSTD_LIB ZSTD::ZSTD)
   endif()
