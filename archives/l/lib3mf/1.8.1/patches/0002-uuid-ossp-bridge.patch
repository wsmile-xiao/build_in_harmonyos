--- a/Source/Common/NMR_UUID.cpp	2019-01-08 20:36:18.000000000 +0800
+++ b/Source/Common/NMR_UUID.cpp	2026-09-14 01:00:49.560286719 +0800
@@ -40,6 +40,9 @@
 #if defined(_WIN32)
 #include <objbase.h>
 #include <iomanip>
+#elif defined(__OHOS__)
+#include <cstdio>
+#include <cstdlib>
 #else
 #include <uuid/uuid.h>
 #endif
@@ -57,10 +60,27 @@
 			throw CNMRException(NMR_ERROR_UUIDGENERATIONFAILED);
 		set(fnUTF16toUTF8(str).c_str());
 #else
-		uuid_t uuid;
-		uuid_generate_random(uuid);
+		/* OHOS: ossp-uuid 1.6.2 runtime (PRNG/MD5 engine) corrupts the heap
+		 * under optimization; generate a random UUID v4 directly from
+		 * /dev/urandom instead (RFC 4122). */
+		unsigned char bin[16];
+		{
+			FILE *f = std::fopen("/dev/urandom", "rb");
+			if (f == nullptr)
+				throw CNMRException(NMR_ERROR_UUIDGENERATIONFAILED);
+			if (std::fread(bin, 1, sizeof(bin), f) != sizeof(bin)) {
+				std::fclose(f);
+				throw CNMRException(NMR_ERROR_UUIDGENERATIONFAILED);
+			}
+			std::fclose(f);
+		}
+		bin[6] = (unsigned char)((bin[6] & 0x0f) | 0x40); /* version 4 */
+		bin[8] = (unsigned char)((bin[8] & 0x3f) | 0x80); /* variant 1 */
 		char s[37];
-		uuid_unparse(uuid, s);
+		std::snprintf(s, sizeof(s),
+			"%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+			bin[0], bin[1], bin[2], bin[3], bin[4], bin[5], bin[6], bin[7],
+			bin[8], bin[9], bin[10], bin[11], bin[12], bin[13], bin[14], bin[15]);
 		set(std::string(s).c_str());
 #endif
 	}
