@@ -21,6 +18,15 @@
 option(USE_INCLUDED_ZLIB "Use included zlib" ON)
 option(USE_INCLUDED_LIBZIP "Use included libzip" ON)
 
+# ── OHOS adaptation: external dependency discovery when bundled libs are off ──
+if (NOT USE_INCLUDED_ZLIB OR NOT USE_INCLUDED_LIBZIP)
+	find_package(ZLIB REQUIRED)
+endif()
+if (NOT USE_INCLUDED_LIBZIP)
+	find_package(libzip CONFIG REQUIRED)
+	set(LIBZIP_LIBRARIES libzip::zip)
+endif()
+
 if ("${CMAKE_CXX_COMPILER_ID}" STREQUAL "GNU")
   # using GCC
   add_definitions(-DBUILD_DLL)
@@ -108,11 +114,22 @@
