+		if (NOT CMAKE_SYSTEM_NAME MATCHES "OHOS|HarmonyOS")
+			find_library(LIBUUID_PATH uuid)
+			if(NOT LIBUUID_PATH)
+				message(FATAL_ERROR "libuuid not found")
+			endif()
+			target_link_libraries(${PROJECT_NAME}_s ${LIBUUID_PATH})
 		endif()
