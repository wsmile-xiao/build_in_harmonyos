diff -ruN a/libsm/strerror.c b/libsm/strerror.c
--- a/libsm/strerror.c
+++ b/libsm/strerror.c
@@ -9,29 +9,38 @@
  * forth in the LICENSE file which can be found at the top level of
  * the sendmail distribution.
  *
  */
 
 #include <sm/gen.h>
 SM_RCSID("@(#)$Id: strerror.c,v 1.24 2013-11-22 20:51:43 ca Exp $")
 
 /*
 **  define strerror for platforms that lack it.
+**
+**  Modified for HarmonyOS/musl: sys_errlist and sys_nerr are not available
+**  in musl libc. Use standard strerror() function instead.
 */
 
 #include <errno.h>
 #include <stdio.h>	/* sys_errlist, on some platforms */
 
 #include <sm/io.h>	/* sm_snprintf */
 #include <sm/string.h>
 #include <sm/conf.h>
 #include <sm/errstring.h>
+
+/* HarmonyOS/musl has strerror() and no sys_errlist/sys_nerr */
+#if defined(__OHOS__) || defined(__MUSL__)
+#define HASSTRERROR 1
+#define ERRLIST_PREDEFINED 1
+#endif
 
 #if !defined(ERRLIST_PREDEFINED)
 extern char *sys_errlist[];
 extern int sys_nerr;
 #endif
 
 #if !HASSTRERROR
 
 /*
 **  STRERROR -- return error message string corresponding to an error number.
@@ -42,19 +51,24 @@
 **	Returns:
 **		Error string (might be pointer to static buffer).
 */
 
 char *
 strerror(err)
 	int err;
 {
 	static char buf[64];
 
+#if defined(__OHOS__) || defined(__MUSL__)
+	/* Use standard strerror for musl/HarmonyOS */
+	return strerror(err);
+#else
 	if (err >= 0 && err < sys_nerr)
 		return (char *) sys_errlist[err];
 	else
 	{
 		(void) sm_snprintf(buf, sizeof(buf), "Error %d", err);
 		return buf;
 	}
+#endif
 }
 #endif /* !HASSTRERROR */
