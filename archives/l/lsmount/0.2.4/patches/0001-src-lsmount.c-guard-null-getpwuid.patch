diff --git a/src/lsmount.c b/src/lsmount.c
--- a/src/lsmount.c
+++ b/src/lsmount.c
@@ -43,7 +43,11 @@
 
 	char* conf_file2;
 	const struct passwd* pw = getpwuid(getuid());
-	const char*  homedir    = pw->pw_dir;
+	/* getpwuid() may return NULL when the effective uid is absent from the
+	 * passwd database, and pw_dir may be empty; never dereference blindly.
+	 * Fall back to $HOME, then to "/" so asprintf()/access() see a valid pointer. */
+	const char*  hh       = (pw && pw->pw_dir && *(pw->pw_dir)) ? pw->pw_dir : getenv("HOME");
+	const char*  homedir  = (hh && *hh) ? hh : "/";
 
 	// get absolute conf_file2 path in homedir
 	if(-1 == asprintf(&conf_file2, "%s%s", homedir, "/.config/lsmount.rc")) {
