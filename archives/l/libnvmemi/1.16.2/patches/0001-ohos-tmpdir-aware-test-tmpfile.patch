--- a/test/utils.c	2026-09-30 13:45:36.831401496 +0800
+++ b/test/utils.c	2026-09-30 14:01:16.920623454 +0800
@@ -13,11 +13,54 @@
 
 #include "utils.h"
 
+/*
+ * test_tmpfile - portable replacement for libc tmpfile().
+ *
+ * On HarmonyOS/OHOS the libc tmpfile() creates its file under a read-only
+ * "/tmp" and ignores $TMPDIR entirely (measured on a HarmonyOS PC: /tmp is
+ * root-owned and tmpfile() fails with EACCES even when $TMPDIR points at a
+ * writable directory).  Walk the usual temp-directory environment variables
+ * instead, create an unlinked temporary file in the first one that works
+ * (keeping tmpfile()'s anonymous-file semantics) and only fall back to the
+ * libc tmpfile() when none of them is usable.
+ */
+static FILE *test_tmpfile(void)
+{
+	static const char *const dir_vars[] = { "TMPDIR", "TMP", "TEMP", "HOME" };
+	const char *dir;
+	char template[512];
+	unsigned int i;
+	int fd;
+	FILE *fp;
+
+	for (i = 0; i < sizeof(dir_vars) / sizeof(dir_vars[0]); i++) {
+		dir = getenv(dir_vars[i]);
+		if (dir == NULL || *dir == '\0')
+			continue;
+
+		snprintf(template, sizeof(template), "%s/libnvme-test-XXXXXX", dir);
+		fd = mkstemp(template);
+		if (fd < 0)
+			continue;
+
+		/* Unlink immediately so the file disappears on close, like tmpfile(). */
+		(void)unlink(template);
+		fp = fdopen(fd, "w+b");
+		if (fp == NULL) {
+			close(fd);
+			continue;
+		}
+		return fp;
+	}
+
+	return tmpfile();
+}
+
 FILE *test_setup_log(void)
 {
 	FILE *fd;
 
-	fd = tmpfile();
+	fd = test_tmpfile();
 	if (!fd)
 		err(EXIT_FAILURE, "can't create temporary file for log buf");
 
