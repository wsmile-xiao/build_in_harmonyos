--- a/libs/libmld/src/job.c
+++ b/libs/libmld/src/job.c
@@ -83,38 +83,46 @@
 	if (job->flags & JOB_FREE) free(job->arg);
 	if (job->flags & JOB_RET) free(job->ret);
 	free(job);
 }
 
 static void *job_seek(void *arg)
 {
 	job_thread_t *jt = (job_thread_t *)arg;
 	job_t *job;
 	while((job = job_wait(jt->q))) {
+		if (job->f == NULL) {
+			/* stop sentinel posted by job_queue_destroy() */
+			job_free(job);
+			return jt;
+		}
 		pthread_cleanup_push((void (*)(void *))job_free, job);
 		jt->q->cur = job;
 		if (job->f) job->ret = job->f(job->arg);
 		if (job->callback) job->callback(job->arg);
 		pthread_cleanup_pop(1); /* job_free(job) */
 	}
 	/* never reached */
 	return jt;
 }
 
 void job_queue_destroy(job_queue_t *q)
 {
 	job_t *job;
 	while ((job = job_shift(q))) {
 		job_free(job);
 	}
+	/* Ask each worker to exit on its own instead of relying on
+	 * pthread_cancel(), which OHOS/musl does not implement. A NULL-function
+	 * job is the stop sentinel recognised by job_seek(). */
 	for (size_t z = 0; z < q->nthreads; z++) {
-		pthread_cancel(q->thread[z].thread);
+		if (job_push(q, job_new(NULL, NULL, 0, NULL, 0)) == NULL) break;
 	}
 	for (size_t z = 0; z < q->nthreads; z++) {
 		pthread_join(q->thread[z].thread, NULL);
 	}
 	sem_destroy(&q->lock);
 	sem_destroy(&q->jobs);
 	sem_destroy(&q->done);
 	free(q->thread);
 	free(q);
 }
