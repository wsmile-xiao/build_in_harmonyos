--- a/Makefile.in
+++ b/Makefile.in
@@ -3,20 +3,27 @@
 
 PREFIX ?= @prefix@
 export PREFIX
 LIBNAME := librecast
 LIBDIR := $(PREFIX)/lib
 LIBFILE := lib${LIBNAME}.so
 INCLUDEDIR := $(PREFIX)/include
 COVERITY_DIR := cov-int
 COVERITY_TGZ := $(LIBNAME).tgz
 OSNAME := $(shell uname -s)
+# HarmonyOS reports "HarmonyOS" from uname -s but has a Linux userspace
+# (musl libc, Linux ABI). Treat it as Linux so src/Makefile selects the
+# Linux interface implementation (if_linux.o, which provides
+# lc_tuntap_create) and the Linux shared-object naming.
+ifeq ($(OSNAME),HarmonyOS)
+OSNAME := Linux
+endif
 export OSNAME
 
 export SOURCEDIR=$(shell pwd)
 
 ifeq ($(origin CC),default)
 CC = @CC@
 endif
 export CC
 
 CFLAGS ?= @CFLAGS@
