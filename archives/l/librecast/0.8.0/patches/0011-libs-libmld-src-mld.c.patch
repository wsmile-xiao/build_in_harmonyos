+#if defined(__linux__) && !defined(__GLIBC__)
+/* RFC 3542 §10 hop-by-hop / destination option builders.
+ *
+ * These are only needed by libcs that do not implement the API (musl, as used
+ * by OpenHarmony).  Semantics follow RFC 3542 §10 and the KAME/BSD reference
+ * implementation (lib/libc/net/ip6opt.c) on which the glibc and FreeBSD
+ * implementations are based, so the option bytes produced here are identical
+ * to those the platform would have produced.
+ */
+
+#ifndef IP6OPT_PAD1
+#define IP6OPT_PAD1 0
+#endif
+#ifndef IP6OPT_PADN
+#define IP6OPT_PADN 1
+#endif
+
+int inet6_opt_init(void *extbuf, socklen_t extlen)
+{
+	struct ip6_ext *ext = (struct ip6_ext *)extbuf;
+
+	if (ext) {
+		if (extlen <= 0 || (extlen % 8))
+			return -1;
+		ext->ip6e_len = (uint8_t)((extlen >> 3) - 1);
+	}
+
+	/* length of the next-header and header-ext-length fields */
+	return 2;
+}
+
+int inet6_opt_append(void *extbuf, socklen_t extlen, int offset, uint8_t type,
+                     socklen_t len, uint8_t align, void **databufp)
+{
+	int currentlen = offset, padlen = 0;
+
+	/* option types 0 and 1 are reserved for Pad1 and PadN */
+	if (type < 2)
+		return -1;
+	/* the option data length is carried in a single octet */
+	if (len > 255)
+		return -1;
+	if (align != 1 && align != 2 && align != 4 && align != 8)
+		return -1;
+	if (align > len)
+		return -1;
+
+	currentlen += 2 + (int)len;	/* 2 == type + len octets */
+	if (align && currentlen % align)
+		padlen = align - (currentlen % align);
+	currentlen += padlen;
+
+	if (extlen && currentlen > (int)extlen)
+		return -1;
+
+	if (extbuf) {
+		uint8_t *optp = (uint8_t *)extbuf + offset;
+
+		if (padlen == 1) {
+			/* a single Pad1 covers the alignment */
+			*optp++ = IP6OPT_PAD1;
+		}
+		else if (padlen > 0) {
+			*optp++ = IP6OPT_PADN;
+			*optp++ = (uint8_t)(padlen - 2);
+			memset(optp, 0, padlen - 2);
+			optp += (padlen - 2);
+		}
+		*optp++ = type;
+		*optp++ = (uint8_t)len;
+		if (databufp) *databufp = optp;
+	}
+
+	return currentlen;
+}
+
+int inet6_opt_finish(void *extbuf, socklen_t extlen, int offset)
+{
+	/* pad the header out to a multiple of 8, as IPv6 requires */
+	int updatelen = offset > 0 ? (1 + ((offset - 1) | 7)) : 0;
+
+	if (extbuf) {
+		uint8_t *padp;
+		int padlen = updatelen - offset;
+
+		if (updatelen > (int)extlen)
+			return -1;
+		padp = (uint8_t *)extbuf + offset;
+		if (padlen == 1) {
+			*padp = IP6OPT_PAD1;
+		}
+		else if (padlen > 0) {
+			*padp++ = IP6OPT_PADN;
+			*padp++ = (uint8_t)(padlen - 2);
+			memset(padp, 0, padlen - 2);
+		}
+	}
+
+	return updatelen;
+}
+
+int inet6_opt_set_val(void *databuf, int offset, void *val, socklen_t vallen)
+{
+	memcpy((uint8_t *)databuf + offset, val, vallen);
+	return offset + (int)vallen;
+}
+#endif /* musl / non-glibc Linux */
