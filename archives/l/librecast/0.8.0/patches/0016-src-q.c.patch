 void *q_job_seek(void *arg)
 {
 	q_t *q = (q_t *)arg;
 	q_job_t job = {0};
 	while (1) {
+#if !(defined(__linux__) && !defined(__GLIBC__))
 		pthread_testcancel();
+#endif
 		if (q_wait(q, &job) == -1) continue;
+		if (job.f == NULL) return NULL; /* stop sentinel */
 		job.f(job.arg);
 	}
 	return arg;
 }
 
