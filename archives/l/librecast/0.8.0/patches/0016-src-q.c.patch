+int q_pool_destroy_q(pthread_t tid[], int nthreads, q_t *q)
+{
+	/* OHOS/musl has no working pthread_cancel(); wake every worker with a
+	 * NULL-function stop sentinel (handled in q_job_seek()) and join. */
+	for (int z = 0; z < nthreads; z++) {
+		if (q_push(q, NULL, NULL) == -1) return -1;
+	}
+	for (int z = 0; z < nthreads; z++) {
+		if (pthread_join(tid[z], NULL)) return -1;
+	}
+	return 0;
+}
