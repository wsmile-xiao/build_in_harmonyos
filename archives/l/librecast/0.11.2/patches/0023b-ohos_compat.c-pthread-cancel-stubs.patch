--- /dev/null
+++ b/src/ohos_compat.c
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only */
+/* ohos_compat.c — OHOS musl does not support thread cancellation (E127):
+ * the libc carries neither the symbols nor working semantics for
+ * pthread_cancel(3).  The build links these no-op stubs so the library and
+ * its tests compile and link; shutdown paths that relied on cancellation
+ * are reworked separately (poison-pill jobs / fd-close unblocking), see
+ * patches 0019-0022. */
+
+#if defined(__linux__) && !defined(__GLIBC__)
+
+#include <pthread.h>
+
+int pthread_cancel(pthread_t thread)
+{
+	/* no-op: musl has no cancellation; callers pair this with join after
+	 * arranging for the thread to exit on its own */
+	(void)thread;
+	return 0;
+}
+
+int pthread_setcancelstate(int state, int *oldstate)
+{
+	if (oldstate) *oldstate = state;
+	return 0;
+}
+
+int pthread_testcancel(void)
+{
+	return 0;
+}
+
+#endif /* __linux__ && !__GLIBC__ */
