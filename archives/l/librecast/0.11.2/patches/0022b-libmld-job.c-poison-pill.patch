--- a/libs/libmld/src/job.c
+++ b/libs/libmld/src/job.c
@@ -96,6 +96,12 @@
 	while((job = job_wait(jt->q))) {
 		pthread_cleanup_push((void (*)(void *))job_free, job);
 		jt->q->cur = job;
+#if defined(__linux__) && !defined(__GLIBC__)
+		/* musl: no pthread_cancel — NULL job is the poison pill; mark stop and
+		 * break AFTER cleanup_pop so the push/pop pair stays balanced */
+		if (!job->f) astor(&jt->q->stop, 1);
+		else
+#endif
 		if (job->f) job->ret = job->f(job->arg);
 		if (job->callback) job->callback(job->arg);
 		pthread_cleanup_pop(1); /* job_free(job) */
@@ -110,6 +116,13 @@
 	while ((job = job_shift(q))) {
 		job_free(job);
 	}
+#if defined(__linux__) && !defined(__GLIBC__)
+	/* musl: feed one poison-pill (NULL) job per worker so job_seek() exits */
+	for (size_t z = 0; z < q->nthreads; z++) {
+		job_t *pill = calloc(1, sizeof(job_t));
+		if (pill) job_push(q, pill);
+	}
+#endif
 	for (size_t z = 0; z < q->nthreads; z++) {
 		pthread_cancel(q->thread[z].thread);
 	}
