+	close(logging->sock_nack->sock);
+	logging->sock_nack->sock = -1;
+#endif
 	pthread_cancel(logging->nack_thread);
 	pthread_join(logging->nack_thread, NULL);
 	pthread_mutex_destroy(&logging->mutex);
