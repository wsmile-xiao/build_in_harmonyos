+int q_pool_stop(q_t *q, int nthreads)
+{
+#if defined(__linux__) && !defined(__GLIBC__)
+	/* OHOS musl: no pthread_cancel (E127) — push one poison-pill (NULL) job per
+	 * worker so each q_job_seek() thread wakes up and exits; q_pool_destroy()
+	 * then joins cleanly. */
+	for (int z = 0; z < nthreads; z++) q_trypush(q, NULL, NULL);
+#else
+	(void)q; (void)nthreads;
+#endif
+	return 0;
+}
