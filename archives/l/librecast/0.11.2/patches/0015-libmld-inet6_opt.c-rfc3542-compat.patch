--- /dev/null
+++ b/libs/libmld/src/inet6_opt.c
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only */
+/* inet6_opt.c — RFC 3542 (Advanced Sockets API for IPv6) Hop-by-Hop /
+ * Destination option builder, for OHOS musl which ships neither the
+ * declarations nor the symbols.
+ *
+ * Semantics follow RFC 3542 §10.4 and Appendix B; implementation style
+ * after musl libc (MIT). Only the four functions consumed by mld.c are
+ * provided: inet6_opt_init / append / finish / set_val. */
+
+#include <netinet/in.h>
+#include <stdint.h>
+#include <string.h>
+
+int inet6_opt_init(void *bp, socklen_t buflen)
+{
+	if (buflen && buflen < 8) return -1;
+	if (buflen) {
+		((uint8_t *)bp)[0] = 0;		/* next header (filled by caller) */
+		((uint8_t *)bp)[1] = 0;		/* hdr ext len (filled by finish) */
+	}
+	return 2;				/* first byte past the fixed header */
+}
+
+int inet6_opt_append(void *bp, int offset, size_t buflen, uint8_t type,
+		socklen_t len, uint8_t align, void **dbp)
+{
+	uint8_t *p = bp;
+	int pad = 0;
+
+	if (offset < 2 || buflen < (size_t)offset) return -1;
+	/* insert padding so the option data lands on an 'align' boundary */
+	while ((offset + pad) % align) pad++;
+	if ((size_t)offset + pad + 2 + len > buflen) return -1;
+
+	if (pad == 1) {				/* Pad1 */
+		p[offset] = 0;
+	}
+	else if (pad > 1) {			/* PadN */
+		p[offset] = 1;
+		p[offset + 1] = (uint8_t)(pad - 2);
+		memset(p + offset + 2, 0, (size_t)(pad - 2));
+	}
+	offset += pad;
+
+	p[offset] = type;
+	p[offset + 1] = (uint8_t)len;
+	if (dbp) *dbp = p + offset + 2;
+	return offset + 2 + len;
+}
+
+int inet6_opt_finish(void *bp, size_t buflen, int offset)
+{
+	uint8_t *p = bp;
+	int pad;
+
+	if (offset < 2 || buflen < (size_t)offset) return -1;
+	/* the whole extension header must be a multiple of 8 bytes */
+	pad = (8 - (offset & 7)) & 7;
+	if (pad == 1) pad++;			/* Pad1 alone is illegal here */
+	if ((size_t)offset + pad > buflen) return -1;
+
+	if (pad == 1) {
+		p[offset] = 0;
+	}
+	else if (pad > 1) {
+		p[offset] = 1;
+		p[offset + 1] = (uint8_t)(pad - 2);
+		memset(p + offset + 2, 0, (size_t)(pad - 2));
+	}
+	offset += pad;
+
+	p[1] = (uint8_t)(offset / 8 - 1);	/* Hdr Ext Len in 8-octet units */
+	return offset;
+}
+
+int inet6_opt_set_val(void *databuf, int offset, void *val, socklen_t vallen)
+{
+	memcpy((char *)databuf + offset, val, (size_t)vallen);
+	return offset + vallen;
+}
