--- a/configure
+++ b/configure
@@ -20332,13 +20332,20 @@
 }
 # Create a (secure) tmp directory for tmp files.
 
+# HMDFS (HarmonyOS distributed fs): umask 077 + mktemp yields a setgid
+# dir (2700) that cannot be written to; relax to 022 on linux-ohos only.
+hmdfs_tmp_umask=077
+case $host_os in
+  linux-ohos*) hmdfs_tmp_umask=022 ;;
+esac
+
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask "$hmdfs_tmp_umask" && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask "$hmdfs_tmp_umask" && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
@@ -21577,4 +21584,3 @@
 printf "%s\n" "$as_me: WARNING: unrecognized options: $ac_unrecognized_opts" >&2;}
 fi
 
-
