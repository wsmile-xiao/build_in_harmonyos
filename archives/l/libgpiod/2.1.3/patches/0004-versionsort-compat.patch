+/* versionsort compatibility for musl libc (HarmonyOS) */
+#ifdef __OHOS__
+static int strverscmp(const char *s1, const char *s2) {
+    const char *p1 = s1, *p2 = s2;
+    
+    while (*p1 && *p2) {
+        if (isdigit((unsigned char)*p1) && isdigit((unsigned char)*p2)) {
+            /* Compare numeric parts - version sort */
+            const char *start1 = p1, *start2 = p2;
+            /* Skip leading zeros */
+            while (*p1 == '0' && isdigit((unsigned char)*(p1+1))) p1++;
+            while (*p2 == '0' && isdigit((unsigned char)*(p2+1))) p2++;
+            /* Count digit lengths */
+            size_t len1 = 0, len2 = 0;
+            const char *t1 = p1, *t2 = p2;
+            while (isdigit((unsigned char)*t1)) { t1++; len1++; }
+            while (isdigit((unsigned char)*t2)) { t2++; len2++; }
+            /* Longer number is greater */
+            if (len1 != len2) return (len1 > len2) ? 1 : -1;
+            /* Compare digit values */
+            while (p1 < t1 && p2 < t2) {
+                if (*p1 != *p2) return *p1 - *p2;
+                p1++; p2++;
+            }
+        } else {
+            if (*p1 != *p2) return *p1 - *p2;
+            p1++; p2++;
+        }
+    }
+    return *p1 - *p2;
+}
+
+int versionsort(const struct dirent **a, const struct dirent **b) {
+    return strverscmp((*a)->d_name, (*b)->d_name);
+}
+#endif /* __OHOS__ */
