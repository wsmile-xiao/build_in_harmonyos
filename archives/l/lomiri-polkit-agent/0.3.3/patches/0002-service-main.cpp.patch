 #include "auth-manager.h"
 #include "authentication.h"
 
 #include <csignal>
 #include <future>
 
 #include <glib.h>
 
 std::promise<int> retval;
 
+/* HarmonyOS adaptation: --version/--help entry points so the installed service
+ * binary can be smoke-tested (the agent is D-Bus activated and needs a session
+ * bus + polkitd, which the test environment does not provide). */
+#define LPA_VERSION_STRING "0.3.3"
+
+static int print_version_and_exit()
+{
+    g_print("lomiri-polkit-agent %s\n", LPA_VERSION_STRING);
+    return 0;
+}
+
+static int print_usage_and_exit()
+{
+    g_print("Usage: policykit-agent [--version|--help]\n");
+    g_print("Lomiri PolicyKit agent - D-Bus session authentication agent.\n");
+    return 0;
+}
+
 int main(int argc, char* argv[])
 {
+    if (argc > 1)
+    {
+        const gchar* arg = argv[1];
+        if (g_strcmp0(arg, "--version") == 0)
+        {
+            return print_version_and_exit();
+        }
+        else if (g_strcmp0(arg, "--help") == 0 || g_strcmp0(arg, "-h") == 0)
+        {
+            return print_usage_and_exit();
+        }
+    }
+
     auto auths = std::make_shared<AuthManager>();
     auto agent = std::make_shared<Agent>(auths);
 
     std::signal(SIGTERM, [](int signal) -> void { retval.set_value(0); });
 
     g_debug("PolicyKit Agent Started");
     return retval.get_future().get();
 }
