+#include "blake2b.h"
+/* libsodium-free build: equihash.cc only ever calls
+ * crypto_generichash(out, outlen, in, inlen, NULL, 0), i.e. keyless BLAKE2b.
+ * The vendored RFC 7693 implementation in blake2b.c is bit-identical, so the
+ * PoW semantics are unchanged and the libsodium dependency is dropped
+ * (its configure script cannot run on the OHOS preflight host). */
+static inline int crypto_generichash(unsigned char *out, size_t outlen,
+                                     const unsigned char *in, unsigned long long inlen,
+                                     const unsigned char *key, size_t keylen)
+{
+    return equihash_blake2b(out, outlen, in, (size_t)inlen, key, keylen);
+}
