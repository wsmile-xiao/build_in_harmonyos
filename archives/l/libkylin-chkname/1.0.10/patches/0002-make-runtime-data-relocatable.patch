--- a/Makefile.am
+++ b/Makefile.am
@@ -4,0 +5,3 @@ include_HEADERS=kylin-chkname.h
+reservednamesdir = $(datadir)/kylin-chkname
+reservednames_DATA = reserved-names
+
@@ -10 +13 @@ ACLOCAL_AMFLAGS = -I m4
-EXTRA_DIST = m4/ChangeLog
+EXTRA_DIST = reserved-names
--- a/kylin-chkname.c
+++ b/kylin-chkname.c
@@ -9,0 +10 @@
+#include <stdlib.h>
@@ -17,0 +19,11 @@
+#define LOCALE_DIR "/usr/share/locale"
+
+static const char *resource_path(const char *variable, const char *fallback)
+{
+    const char *value = getenv(variable);
+
+    if (value != NULL && value[0] != '\0')
+        return value;
+
+    return fallback;
+}
@@ -27 +39,2 @@ static int reserve_check(const char *name)
-    fp = fopen(RESERVED_NAMES, "r");
+    fp = fopen(resource_path("KYLIN_CHKNAME_RESERVED_NAMES", RESERVED_NAMES),
+               "r");
@@ -49 +62,3 @@ int kylin_username_check(const char *name, int reserve)
-{
+{
+    int reserved;
+
@@ -66,6 +81,7 @@ int kylin_username_check(const char *name, int reserve)
-    if (reserve && reserve_check(name)) {
-        if (reserve_check(name) == 1)
+    if (reserve) {
+        reserved = reserve_check(name);
+        if (reserved == 1)
             return RESERVED_ERROR;
-        else
+        if (reserved != 0)
             return OPEN_RESERVED_NAMES_ERROR;
     }
@@ -138 +154,4 @@ char *kylin_username_strerror(int err_num)
-    bindtextdomain("kylin-chkname", "/usr/share/locale");
+    bindtextdomain(
+        "kylin-chkname",
+        resource_path("KYLIN_CHKNAME_LOCALEDIR", LOCALE_DIR)
+    );
