--- /dev/null
+++ b/lms7_defaults.c
@@ -0,0 +1,45 @@
+/*
+ * Default platform hooks for liblms7compact.
+ *
+ * liblms7002m.c is designed as a compact MCU library: low-level SPI
+ * transport and logging are provided by the integrator.  To let the
+ * library build and link as a standalone shared object (and to let
+ * consumers run the library API without real hardware) these default
+ * implementations are provided as WEAK symbols.  Integrators may
+ * override them by defining strong symbols with the same name.
+ */
+#include "liblms7002m.h"
+
+#include <stdarg.h>
+
+__attribute__((weak)) void
+lms7_log_ex(struct lms7_state* s,
+            const char* function,
+            const char* file,
+            int line_no,
+            const char* fmt, ...)
+{
+    (void)s;
+    (void)function;
+    (void)file;
+    (void)line_no;
+    (void)fmt;
+}
+
+__attribute__((weak)) int
+lms7_spi_transact(struct lms7_state* s, uint16_t ival, uint32_t* oval)
+{
+    (void)s;
+    (void)ival;
+    (void)oval;
+    return -1;
+}
+
+__attribute__((weak)) int
+lms7_spi_post(struct lms7_state* s, unsigned count, const uint32_t* regs)
+{
+    (void)s;
+    (void)count;
+    (void)regs;
+    return -1;
+}
