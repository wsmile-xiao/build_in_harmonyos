# OHOS: the gl handler meson.build unconditionally calls
#   gst_gl_apis = gst_gl_dep.get_variable('gl_apis').split()
# on the `gstreamer-gl-1.0` dependency, which is NotFound on HarmonyOS PC
# (no GL API library is published; gst-plugins-base is built with gl disabled).
# Calling .get_variable() on a NotFoundDependency is a hard meson error
# ("No default provided for dependency <NotFoundDependency ...>").
#
# The GL importer/uploader (glimporter/gluploader) and the whole gst-plugin are
# not built by this recipe, so we gracefully skip this subdir when gstreamer-gl
# is absent, while keeping gst_clapper_gl_ch_dep (the empty dependency declared
# at the top of this file) defined for the importing plugin meson.build. The
# upstream error path is preserved: an explicit glimporter/gluploader enable
# still raises when gstreamer-gl is missing.
--- a/src/lib/gst/plugin/handlers/gl/meson.build
+++ b/src/lib/gst/plugin/handlers/gl/meson.build
@@ -19,6 +19,14 @@
 gst_gl_wayland_dep = dependency('', required: false)
 gst_gl_egl_dep = dependency('', required: false)
 
+if not gst_gl_dep.found()
+  if gl_support_required
+    error('GL importer/uploader was enabled, but gstreamer-gl-1.0 was not found')
+  endif
+  build_gl_ch = false
+  subdir_done()
+endif
+
 gst_gl_apis = gst_gl_dep.get_variable('gl_apis').split()
 gst_gl_winsys = gst_gl_dep.get_variable('gl_winsys').split()
 gst_gl_platforms = gst_gl_dep.get_variable('gl_platforms').split()
