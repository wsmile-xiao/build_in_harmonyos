From: OpenDesk <opendesk@openharmony.io>
Date: 2026-03-28
Subject: [PATCH 2/2] closure: add HarmonyOS HMDFS mount table fallback

On HarmonyOS, /proc/self/maps contains HMDFS (distributed filesystem)
internal paths that are not directly accessible via open() from userspace.
For example:

  /data/service/el2/100/hmdfs/account/files/Docs/usr/local/lib/libffi.so

This causes ffi_tramp_get_libffi() to fail when trying to open the libffi
binary file, which is required for the FFI_EXEC_STATIC_TRAMP closure mechanism.

This patch adds a fallback in ffi_tramp_get_libffi() that:
1. When open(maps_path) fails, parses /proc/self/mounts to find mount mappings
2. Translates HMDFS internal paths to userspace-accessible paths by replacing
   the mount source prefix with the mount target prefix
3. Handles HMDFS's intermediate path prefix "/files/Docs/" (11 chars to skip)

The translation works as follows:
  maps path:   .../hmdfs/account/files/Docs/usr/local/lib/libffi.so
  mount entry: .../hmdfs/account -> /storage/Users/currentUser
  accessible:  /storage/Users/currentUser/usr/local/lib/libffi.so

Also adds #include <errno.h> which is needed by the new code.

This enables ffi_closure (callback) functionality on HarmonyOS when
FFI_EXEC_STATIC_TRAMP is enabled, working around the kernel's W^X policy
that prohibits PROT_EXEC mmap but allows MAP_FIXED replacement of existing
executable mappings.

---
 src/tramp.c | 79 ++++++++++++++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 73 insertions(+), 6 deletions(-)

diff --git a/src/tramp.c b/src/tramp.c
--- libffi-3.5.2/src/tramp.c
+++ libffi-3.5.2/src/tramp.c
@@ -48,6 +48,7 @@
 #include <stdlib.h>
 #include <stdint.h>
 #include <fcntl.h>
+#include <errno.h>
 #include <pthread.h>
 #include <sys/mman.h>
 #include <tramp.h>
@@ -243,7 +244,84 @@ ffi_tramp_get_libffi (void)
 
   tramp_globals.fd = open (file, open_flags);
   if (tramp_globals.fd == -1)
-    return 0;
+    {
+      /*
+       * HarmonyOS HMDFS fallback:
+       *
+       * On HarmonyOS, /proc/self/maps contains HMDFS internal paths
+       * (e.g., /data/service/el2/100/hmdfs/account/files/Docs/...) that
+       * are not directly accessible via open() from userspace. We need to
+       * translate these paths using /proc/self/mounts.
+       *
+       * Translation example:
+       *   maps path:   .../hmdfs/account/files/Docs/usr/local/lib/libffi.so
+       *   mount entry: /data/.../hmdfs/account -> /storage/Users/currentUser
+       *   accessible:  /storage/Users/currentUser/usr/local/lib/libffi.so
+       *
+       * HMDFS inserts "/files/Docs/" between the mount source and the
+       * actual file path, so we strip that prefix when translating.
+       */
+      FILE *mf;
+      char mline[PATH_MAX * 3];
+      char resolved[PATH_MAX];
+
+      mf = fopen ("/proc/self/mounts", "r");
+      if (mf != NULL)
+	{
+	  while (fgets (mline, sizeof (mline), mf) != NULL)
+	    {
+	      char msrc[PATH_MAX], mtgt[PATH_MAX], mtype[64];
+
+	      if (sscanf (mline, "%1023s %1023s %63s", msrc, mtgt, mtype) < 3)
+		continue;
+
+	      /* Check if the maps file path starts with this mount source */
+	      if (strncmp (file, msrc, strlen (msrc)) != 0)
+		continue;
+
+	      const char *suffix = file + strlen (msrc);
+
+	      /* Try 1: Direct replacement mount_source -> mount_target */
+	      snprintf (resolved, sizeof (resolved), "%s%s", mtgt, suffix);
+	      tramp_globals.fd = open (resolved, open_flags);
+	      if (tramp_globals.fd != -1)
+		break;
+
+	      /*
+	       * Try 2: Skip HMDFS intermediate path prefix "/files/Docs/".
+	       * suffix starts with "/files/Docs/..." (12 chars).
+	       * We want to keep the '/' at position 11, so use suffix+11
+	       * to get "/usr/local/..." which concatenates correctly with mtgt.
+	       */
+	      if (strncmp (suffix, "/files/Docs/", 12) == 0)
+		{
+		  snprintf (resolved, sizeof (resolved), "%s%s",
+			    mtgt, suffix + 11);
+		  tramp_globals.fd = open (resolved, open_flags);
+		  if (tramp_globals.fd != -1)
+		    break;
+		}
+
+	      /*
+	       * Try 3: Also try skipping just "/files/" for other
+	       * possible HMDFS path layouts.
+	       * "/files/" is 7 chars; use suffix+6 to keep the '/'.
+	       */
+	      if (strncmp (suffix, "/files/", 7) == 0)
+		{
+		  snprintf (resolved, sizeof (resolved), "%s%s",
+			    mtgt, suffix + 6);
+		  tramp_globals.fd = open (resolved, open_flags);
+		  if (tramp_globals.fd != -1)
+		    break;
+		}
+	    }
+	  fclose (mf);
+	}
+
+      if (tramp_globals.fd == -1)
+        return 0;
+    }
 
   /*
    * Allocate a trampoline table just to make sure that the trampoline code
