@@ -81,20 +81,27 @@
   )
   if(WIN32 AND NOT CYGWIN)
 		foreach(addlib ${ADDITIONAL_LIBRARIES})
 			install(FILES ${addlib} DESTINATION lib)
 		endforeach(addlib)
   endif(WIN32 AND NOT CYGWIN)
 endif(LIBHPDF_STATIC)
 if(LIBHPDF_SHARED)
   add_library(${LIBHPDF_NAME} SHARED ${LIBHPDF_SRCS})
   target_link_libraries(${LIBHPDF_NAME} ${ADDITIONAL_LIBRARIES})
+  # OHOS adaptation: set VERSION/SOVERSION so the shared library carries a
+  # DT_SONAME. Upstream leaves the hpdf target without SONAME, which the CI
+  # L5 SONAME quality gate requires for downstream SONAME-based addressing
+  # (W3 L5 gate: libhpdf.so missing DT_SONAME).
+  set_target_properties(${LIBHPDF_NAME} PROPERTIES
+    VERSION ${LIBHPDF_VERSION}
+    SOVERSION ${LIBHPDF_MAJOR})
   if(WIN32 AND NOT CYGWIN)
   	set_target_properties(${LIBHPDF_NAME} PROPERTIES DEFINE_SYMBOL HPDF_DLL_MAKE)
   endif(WIN32 AND NOT CYGWIN)
   install(
     TARGETS ${LIBHPDF_NAME}
     ARCHIVE DESTINATION lib
     LIBRARY DESTINATION lib
     RUNTIME DESTINATION bin
   )
 endif(LIBHPDF_SHARED)
