diff -ruN a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -1,30 +1,39 @@
 #                                               -*- Autoconf -*-
 # Process this file with autoconf to produce a configure script.
 
 AC_PREREQ([2.63])
 AC_INIT([libbs2b], [3.1.0], [boris_mikhaylov@users.sourceforge.net])
 AC_CONFIG_AUX_DIR([build-aux])
 AM_INIT_AUTOMAKE([1.10.1 -Wall foreign subdir-objects
-                  dist-zip dist-bzip2 dist-lzma])
+                  dist-zip dist-bzip2 ])
 AC_CONFIG_SRCDIR([src/bs2b.h])
 
 # Checks for programs.
 AC_PROG_CXX
 AC_PROG_CC
-AC_PROG_LIBTOOL
+LT_INIT
 PKG_PROG_PKG_CONFIG
 
 # Checks for libraries.
-PKG_CHECK_EXISTS([sndfile], [], [
-    AC_MSG_ERROR(Please install libsndfile.)
+PKG_CHECK_EXISTS([sndfile], [
+    HAS_SNDFILE=yes
+    SNDFILE_CFLAGS=`$PKG_CONFIG --cflags sndfile`
+    SNDFILE_LIBS=`$PKG_CONFIG --libs sndfile`
+], [
+    HAS_SNDFILE=no
+    AC_MSG_WARN(libsndfile not found; bs2bconvert will not be built.)
 ])
+AC_SUBST([HAS_SNDFILE])
+AC_SUBST([SNDFILE_CFLAGS])
+AC_SUBST([SNDFILE_LIBS])
+AM_CONDITIONAL([HAVE_SNDFILE], [test "$HAS_SNDFILE" = "yes"])
 
 # Checks for header files.
 AC_CHECK_HEADERS([fcntl.h malloc.h string.h])
 
 # Checks for typedefs, structures, and compiler characteristics.
 AC_HEADER_STDBOOL
 AC_TYPE_SIZE_T
 
 # Checks for library functions.
 AC_FUNC_MALLOC
