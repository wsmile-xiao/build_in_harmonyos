From 2426c7f1f739f3ee5dcd802cd5ed05dd8c2afdb4 Mon Sep 17 00:00:00 2001
From: OpenDesk <opendesk@noreply.gitcode.com>
Date: Wed, 19 Aug 2026 05:46:11 +0800
Subject: [PATCH] Make declarative and QML test conditional on Qt Quick

---
 project.pro     | 10 +++++++++-
 tests/tests.pro |  6 ++++--
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/project.pro b/project.pro
index 85b0b11..2880597 100644
--- a/project.pro
+++ b/project.pro
@@ -3,7 +3,15 @@ isEmpty(PREFIX) {
     PREFIX = /usr/local
 }
 TEMPLATE = subdirs
-SUBDIRS += src declarative tests
+SUBDIRS += src
+
+# declarative QML plugin requires Qt Quick (qt5-declarative)
+qtHaveModule(quick) {
+    SUBDIRS += declarative
+} else {
+    message("Qt Quick module not available, skipping declarative subproject")
+}
+SUBDIRS += tests
 
 # No need to build this, but if you want then 'qmake EXAMPLE=1 && make'
 count(EXAMPLE, 1) {
diff --git a/tests/tests.pro b/tests/tests.pro
index 4967525..7a27e64 100644
--- a/tests/tests.pro
+++ b/tests/tests.pro
@@ -2,8 +2,10 @@ include(tests_common.pri)
 
 TEMPLATE = subdirs
 SUBDIRS = \
-        ut_client.pro \
-        ut_declarativengfevent.pro \
+        ut_client.pro
+qtHaveModule(quick) {
+    SUBDIRS += ut_declarativengfevent.pro
+}
 
 configure($${PWD}/tests.xml.in)
 tests_xml.path = $${INSTALL_TESTDIR}
-- 
2.45.2

