--- a/libgda/sqlite/gda-sqlite-provider.c
+++ b/libgda/sqlite/gda-sqlite-provider.c
@@ -257,6 +257,91 @@
 gda_sqlite_provider_iface_init (GdaProviderInterface *iface);
 
 // API routines from library
+
+#ifdef OHC_SQLITE_DIRECT_LINK
+/* OHOS PC: the conan sqlite3 dependency is static-only, so the runtime
+ * dlopen("libsqlite3") path can never succeed. Fill the API routines table
+ * with direct references to the sqlite3 symbols already linked into
+ * libgda instead. Encryption symbols (sqlite3_key/key_v2/rekey) are left
+ * NULL, matching the dlopen fallback behaviour. */
+static void
+gda_sqlite_load_symbols_direct (Sqlite3ApiRoutines **apilib)
+{
+	Sqlite3ApiRoutines *api = g_new0 (Sqlite3ApiRoutines, 1);
+	api->sqlite3_bind_blob = sqlite3_bind_blob;
+	api->sqlite3_bind_double = sqlite3_bind_double;
+	api->sqlite3_bind_int = sqlite3_bind_int;
+	api->sqlite3_bind_int64 = sqlite3_bind_int64;
+	api->sqlite3_bind_null = sqlite3_bind_null;
+	api->sqlite3_bind_text = sqlite3_bind_text;
+	api->sqlite3_bind_zeroblob = sqlite3_bind_zeroblob;
+	api->sqlite3_blob_bytes = sqlite3_blob_bytes;
+	api->sqlite3_blob_close = sqlite3_blob_close;
+	api->sqlite3_blob_open = sqlite3_blob_open;
+	api->sqlite3_blob_read = sqlite3_blob_read;
+	api->sqlite3_blob_write = sqlite3_blob_write;
+	api->sqlite3_busy_timeout = sqlite3_busy_timeout;
+	api->sqlite3_changes = sqlite3_changes;
+	api->sqlite3_clear_bindings = sqlite3_clear_bindings;
+	api->sqlite3_close = sqlite3_close;
+	api->sqlite3_close_v2 = sqlite3_close_v2;
+	api->sqlite3_column_blob = sqlite3_column_blob;
+	api->sqlite3_column_bytes = sqlite3_column_bytes;
+	api->sqlite3_column_count = sqlite3_column_count;
+	api->sqlite3_column_database_name = sqlite3_column_database_name;
+	api->sqlite3_column_decltype = sqlite3_column_decltype;
+	api->sqlite3_column_double = sqlite3_column_double;
+	api->sqlite3_column_int = sqlite3_column_int;
+	api->sqlite3_column_int64 = sqlite3_column_int64;
+	api->sqlite3_column_name = sqlite3_column_name;
+	api->sqlite3_column_origin_name = sqlite3_column_origin_name;
+	api->sqlite3_column_table_name = sqlite3_column_table_name;
+	api->sqlite3_column_text = sqlite3_column_text;
+	api->sqlite3_column_type = sqlite3_column_type;
+	api->sqlite3_config = sqlite3_config;
+	api->sqlite3_create_collation = sqlite3_create_collation;
+	api->sqlite3_create_function = sqlite3_create_function;
+	api->sqlite3_create_function_v2 = sqlite3_create_function_v2;
+	api->sqlite3_create_module = sqlite3_create_module;
+	api->sqlite3_db_handle = sqlite3_db_handle;
+	api->sqlite3_declare_vtab = sqlite3_declare_vtab;
+	api->sqlite3_enable_load_extension = sqlite3_enable_load_extension;
+	api->sqlite3_errcode = sqlite3_errcode;
+	api->sqlite3_errmsg = sqlite3_errmsg;
+	api->sqlite3_exec = sqlite3_exec;
+	api->sqlite3_extended_result_codes = sqlite3_extended_result_codes;
+	api->sqlite3_finalize = sqlite3_finalize;
+	api->sqlite3_free = sqlite3_free;
+	api->sqlite3_free_table = sqlite3_free_table;
+	api->sqlite3_get_table = sqlite3_get_table;
+	api->sqlite3_last_insert_rowid = sqlite3_last_insert_rowid;
+	api->sqlite3_malloc = sqlite3_malloc;
+	api->sqlite3_mprintf = sqlite3_mprintf;
+	api->sqlite3_open = sqlite3_open;
+	api->sqlite3_open_v2 = sqlite3_open_v2;
+	api->sqlite3_prepare = sqlite3_prepare;
+	api->sqlite3_prepare_v2 = sqlite3_prepare_v2;
+	api->sqlite3_reset = sqlite3_reset;
+	api->sqlite3_result_blob = sqlite3_result_blob;
+	api->sqlite3_result_double = sqlite3_result_double;
+	api->sqlite3_result_error = sqlite3_result_error;
+	api->sqlite3_result_int = sqlite3_result_int;
+	api->sqlite3_result_int64 = sqlite3_result_int64;
+	api->sqlite3_result_null = sqlite3_result_null;
+	api->sqlite3_result_text = sqlite3_result_text;
+	api->sqlite3_step = sqlite3_step;
+	api->sqlite3_table_column_metadata = sqlite3_table_column_metadata;
+	api->sqlite3_threadsafe = sqlite3_threadsafe;
+	api->sqlite3_value_blob = sqlite3_value_blob;
+	api->sqlite3_value_bytes = sqlite3_value_bytes;
+	api->sqlite3_value_int = sqlite3_value_int;
+	api->sqlite3_value_double = sqlite3_value_double;
+	api->sqlite3_value_int64 = sqlite3_value_int64;
+	api->sqlite3_value_text = sqlite3_value_text;
+	api->sqlite3_value_type = sqlite3_value_type;
+	*apilib = api;
+}
+#endif
 Sqlite3ApiRoutines *s3r;
 
 /**
