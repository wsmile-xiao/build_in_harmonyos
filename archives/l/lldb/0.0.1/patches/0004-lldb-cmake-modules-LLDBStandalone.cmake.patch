--- a/lldb/cmake/modules/LLDBStandalone.cmake
+++ b/lldb/cmake/modules/LLDBStandalone.cmake
@@ -97,23 +97,35 @@
 
 set(PACKAGE_VERSION "${LLVM_PACKAGE_VERSION}")
 
 set(CMAKE_INCLUDE_CURRENT_DIR ON)
 include_directories(
   "${CMAKE_BINARY_DIR}/include"
   "${LLVM_INCLUDE_DIRS}"
   "${CLANG_INCLUDE_DIRS}")
 
 if(LLDB_INCLUDE_TESTS)
-  # Build the gtest library needed for unittests, if we have LLVM sources
-  # handy.
-  if (EXISTS ${LLVM_THIRD_PARTY_DIR}/unittest AND NOT TARGET llvm_gtest)
+  # Build the gtest library needed for unittests. LLVM 22.1.0 vendors the
+  # LLVM-patched googletest in <monorepo root>/third-party/unittest; its
+  # wrapper (LLVM_HAS_GTEST mode, normally enabled by the monorepo root
+  # CMakeLists) builds the merged llvm_gtest target (gtest-all.cc +
+  # gmock-all.cc) that add_unittest and LLVMTestingSupport link by name, and
+  # the vendored gtest internals carry the llvm_gtest::printable raw_ostream
+  # streaming bridge. The packaged LLVM_THIRD_PARTY_DIR points at the build
+  # machine (stale for standalone consumers), so resolve the vendored tree
+  # against the source tree first, falling back to LLVM_THIRD_PARTY_DIR.
+  set(LLVM_HAS_GTEST ON)
+  get_filename_component(_lldb_monorepo_root "${LLVM_MAIN_SRC_DIR}" DIRECTORY)
+  if (EXISTS ${_lldb_monorepo_root}/third-party/unittest/CMakeLists.txt
+      AND NOT TARGET llvm_gtest)
+    add_subdirectory(${_lldb_monorepo_root}/third-party/unittest third-party/unittest)
+  elseif (EXISTS ${LLVM_THIRD_PARTY_DIR}/unittest AND NOT TARGET llvm_gtest)
     add_subdirectory(${LLVM_THIRD_PARTY_DIR}/unittest third-party/unittest)
   endif()
   # LLVMTestingSupport library is needed for Process/gdb-remote.
   if (EXISTS ${LLVM_MAIN_SRC_DIR}/lib/Testing/Support
       AND NOT TARGET LLVMTestingSupport)
     add_subdirectory(${LLVM_MAIN_SRC_DIR}/lib/Testing/Support
       lib/Testing/Support)
   endif()
 endif()
 
