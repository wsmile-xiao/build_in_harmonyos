--- a/lldb/CMakeLists.txt
+++ b/lldb/CMakeLists.txt
@@ -154,22 +154,31 @@
 if (LLDB_ENABLE_LUA)
   if(LLDB_BUILD_FRAMEWORK)
     set(LLDB_LUA_CPATH "${LLDB_FRAMEWORK_ABSOLUTE_BUILD_DIR}/LLDB.framework/Resources/Lua")
   else()
     set(LLDB_LUA_CPATH "${CMAKE_BINARY_DIR}/${CMAKE_CFG_INTDIR}/${LLDB_LUA_RELATIVE_PATH}")
   endif()
   get_target_property(lldb_lua_bindings_dir swig_wrapper_lua BINARY_DIR)
   finish_swig_lua("lldb-lua" "${lldb_lua_bindings_dir}" "${LLDB_LUA_CPATH}")
 endif()
 
-set(LLDB_INCLUDE_UNITTESTS ON)
-if (NOT TARGET llvm_gtest)
+# OHOS adaptation: honour an explicit LLDB_INCLUDE_UNITTESTS override.
+# CI/conan builds pass OFF (the unittest targets are EXCLUDE_FROM_ALL and
+# out of conan create's build scope anyway; skipping their configuration
+# keeps CI configure light - the full upstream suite is exercised on the
+# local build tree, see archives notes R51). When the option is not
+# explicitly set, upstream behavior is kept (ON when the vendored
+# llvm_gtest target is available, wired in LLDBStandalone.cmake).
+if (NOT DEFINED LLDB_INCLUDE_UNITTESTS)
+  set(LLDB_INCLUDE_UNITTESTS ON)
+endif()
+if (LLDB_INCLUDE_UNITTESTS AND NOT TARGET llvm_gtest)
   set(LLDB_INCLUDE_UNITTESTS OFF)
 endif()
 
 if(LLDB_INCLUDE_TESTS)
   add_subdirectory(test)
   if (LLDB_INCLUDE_UNITTESTS)
     add_subdirectory(unittests)
   endif()
   add_subdirectory(utils)
 endif()
