diff --git a/src/nss.h b/src/nss.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/src/nss.h
@@ -0,0 +1,43 @@
+/* Minimal glibc NSS header for HarmonyOS (musl) adaptation.
+   glibc's <nss.h> is not available on musl/OHOS; this library only uses
+   enum nss_status and the NSS_STATUS_* constants. Source: glibc nss/nss.h.
+   Also carries the glibc-only netdb additions used by nis-hosts.c (the
+   gethostbyname4_r NSS interface): NETDB_* herrno values and
+   struct gaih_addrtuple (glibc inet/getaddrinfo.h layout). */
+#ifndef _NSS_H
+#define _NSS_H 1
+
+#include <stdint.h>
+#include <netdb.h>
+
+enum nss_status
+{
+  NSS_STATUS_TRYAGAIN = -2,
+  NSS_STATUS_UNAVAIL,
+  NSS_STATUS_NOTFOUND,
+  NSS_STATUS_SUCCESS,
+  NSS_STATUS_RETURN
+};
+
+#ifndef NETDB_INTERNAL
+#define NETDB_INTERNAL -1
+#endif
+#ifndef NETDB_SUCCESS
+#define NETDB_SUCCESS 0
+#endif
+
+struct gaih_addrtuple
+{
+  struct gaih_addrtuple *next;
+  char *name;
+  int family;
+  uint32_t addr[4];
+  uint32_t scopeid;
+};
+
+#endif /* _NSS_H */
+
+/* musl/OHOS exports mempcpy() but not glibc's internal __mempcpy alias. */
+#ifndef __mempcpy
+#define __mempcpy mempcpy
+#endif
diff --git a/src/aliases.h b/src/aliases.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/src/aliases.h
@@ -0,0 +1,14 @@
+/* Minimal glibc <aliases.h> for HarmonyOS (musl) adaptation.
+   Only struct aliasent is used by libnss_nis. Source: glibc inet/aliases.h. */
+#ifndef _ALIASES_H
+#define _ALIASES_H 1
+
+struct aliasent
+  {
+    char *alias_name;
+    char **alias_members;
+    int alias_members_len;
+    int alias_local;
+  };
+
+#endif /* _ALIASES_H */
diff --git a/src/rpc/netdb.h b/src/rpc/netdb.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/src/rpc/netdb.h
@@ -0,0 +1,7 @@
+/* Minimal glibc <rpc/netdb.h> for HarmonyOS (musl) adaptation.
+   libnss_nis/rpc module only needs struct rpcent (declared by rpc/rpcent.h,
+   provided by libtirpc); the getrpc*() entry points are not used. */
+#ifndef _RPC_NETDB_H
+#define _RPC_NETDB_H 1
+#include <rpc/rpcent.h>
+#endif /* _RPC_NETDB_H */
