diff -ruN a/libqalculate/util.cc b/libqalculate/util.cc
--- a/libqalculate/util.cc
+++ b/libqalculate/util.cc
@@ -1135,22 +1135,27 @@
 	pthread_attr_destroy(&m_thread_attr);
 }
 
 void Thread::doCleanup(void *data) {
 	Thread *thread = (Thread *) data;
 	thread->running = false;
 	mpfr_free_cache2(MPFR_FREE_LOCAL_CACHE);
 }
 
 void Thread::enableAsynchronousCancel() {
+#ifdef __OHOS__
+	// OpenHarmony does not support pthread_cancel functions
+	// Thread cancellation is not available on this platform
+#else
 	pthread_setcancelstate(PTHREAD_CANCEL_ENABLE, NULL);
 	pthread_setcanceltype(PTHREAD_CANCEL_ASYNCHRONOUS, NULL);
+#endif
 }
 
 void *Thread::doRun(void *data) {
 
 	pthread_cleanup_push(&Thread::doCleanup, data);
 
 	Thread *thread = (Thread *) data;
 	thread->run();
 
 	pthread_cleanup_pop(1);
@@ -1159,16 +1164,23 @@
 }
 
 bool Thread::start() {
 	if(running) return true;
 	running = pthread_create(&m_thread, &m_thread_attr, &Thread::doRun, this) == 0;
 	return running;
 }
 
 bool Thread::cancel() {
 	if(!running) return true;
+#ifdef __OHOS__
+	// OpenHarmony does not support pthread_cancel
+	// Thread cancellation is not available on this platform
+	// Alternative: wait for thread to complete naturally or use other mechanisms
+	running = false;
+#else
 	running = pthread_cancel(m_thread) != 0;
+#endif
 	return !running;
 }
 
 
 #endif
