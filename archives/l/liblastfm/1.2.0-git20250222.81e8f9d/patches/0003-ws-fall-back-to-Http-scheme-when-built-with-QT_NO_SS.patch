 lastfm::ws::Scheme
 lastfm::ws::scheme()
 {
+#ifdef QT_NO_SSL
+    // qt5-qtbase on OHOS is built with QT_NO_SSL (no OpenSSL backend),
+    // so the QSslSocket::supportsSsl() runtime probe is unavailable and
+    // the QSslSocket class declaration itself is compiled out. Per the
+    // documented API contract ("will only use Https if SSL is supported
+    // on the user's machine otherwise it will default to Http"), fall
+    // back to Http under QT_NO_SSL.
+    return Http;
+#else
     return QSslSocket::supportsSsl() ? theScheme : Http;
+#endif
 }
 
