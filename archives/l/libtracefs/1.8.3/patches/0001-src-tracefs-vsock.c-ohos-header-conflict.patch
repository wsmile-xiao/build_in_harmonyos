--- a/src/tracefs-vsock.c
+++ b/src/tracefs-vsock.c
@@ -1,8 +1,26 @@
 #include <stdlib.h>
 #include <unistd.h>
 #include <ctype.h>
-#include <sys/socket.h>
-#include <linux/vm_sockets.h>
+
+/* OHOS SDK header conflict workaround: define vm_sockets types locally
+ * instead of including linux/vm_sockets.h which causes sockaddr_storage
+ * redefinition conflict with sys/socket.h */
+
+#include <sys/socket.h>
+
+#ifndef AF_VSOCK
+#define AF_VSOCK 40
+#endif
+
+#ifndef VMADDR_CID_ANY
+#define VMADDR_CID_ANY -1U
+#endif
+
+/* Define sockaddr_vm locally to avoid header conflict */
+struct sockaddr_vm {
+	unsigned short svm_family;
+	unsigned short svm_reserved1;
+	unsigned int svm_port;
+	unsigned int svm_cid;
+	unsigned char svm_zero[4];
+};
 
 #include <tracefs.h>
 
