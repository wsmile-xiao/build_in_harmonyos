+/* A program that links libf2c for its run time keeps its own entry point:
+ * main() is only provided for f2c-translated programs, so it must not
+ * override the one of a C program that links the run time for its
+ * intrinsics. */
+int main(int argc, char **argv) __attribute__((weak));
+
+/* MAIN__ is defined by the program f2c translated; here it only needs a
+ * definition so that the shared library has no undefined reference left.
+ * A strong definition in the program overrides this weak alias, so
+ * translated programs are unaffected, while something that merely links
+ * -lf2c no longer hits the "undefined reference due to
+ * --no-allow-shlib-undefined: MAIN__" error that lld and current
+ * binutils report for undefined symbols in a shared object. */
+static int
+weak_MAIN__(void)
+{
+	return -1;
+}
+extern int MAIN__(void) __attribute__((weak, alias("weak_MAIN__")));
