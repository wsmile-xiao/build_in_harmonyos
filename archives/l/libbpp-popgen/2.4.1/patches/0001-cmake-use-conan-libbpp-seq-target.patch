--- a/CMakeLists.txt	2026-09-23 12:45:17.386882131 +0800
+++ b/CMakeLists.txt	2026-09-23 12:45:17.406828833 +0800
@@ -53,7 +53,15 @@
 endif (CMAKE_INSTALL_PREFIX)
 
 include (GNUInstallDirs)
-find_package (bpp-seq 12.0.0 REQUIRED)
+# [OHOS/Conan] Resolve libbpp-seq through the Conan-generated CMake target.
+# The published libbpp-seq package ships the upstream bpp-seq-config.cmake
+# next to a pruned (static-only) library directory; that config aborts while
+# validating its shared imported target, so it cannot be used by consumers.
+# The Conan target carries the same headers, the same static archives and the
+# same transitive bpp-core link.
+find_package (libbpp-seq CONFIG REQUIRED)
+set (BPP_LIBS_STATIC libbpp-seq::libbpp-seq)
+set (BPP_LIBS_SHARED libbpp-seq::libbpp-seq)
 
 # CMake package
 set (cmake-package-location ${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME})
