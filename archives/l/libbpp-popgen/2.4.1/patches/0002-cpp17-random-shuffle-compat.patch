 #include "PolymorphismMultiGContainerTools.h"
 #include <algorithm>
+#include <cstdlib>
+#include <iterator>
 
 using namespace std;
 using namespace bpp;
 
+// [OHOS/C++17] std::random_shuffle was removed in C++17 (libc++ 15 no longer
+// provides it, and the OHOS profile builds with -std=c++17).  This is the
+// historical libstdc++ implementation of that algorithm: a Fisher-Yates
+// shuffle driven by std::rand(), which keeps the sampling behaviour of the
+// original calls unchanged.
+namespace {
+template <class RandomIt>
+void bppRandomShuffle(RandomIt first, RandomIt last) {
+  typedef typename std::iterator_traits<RandomIt>::difference_type diff_t;
+  for (diff_t i = last - first - 1; i > 0; --i) {
+    diff_t j = static_cast<diff_t>(std::rand() % (i + 1));
+    std::swap(first[i], first[j]);
+  }
+}
+}  // namespace
+
