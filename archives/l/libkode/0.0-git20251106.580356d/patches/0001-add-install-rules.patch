diff --git a/code_generation/CMakeLists.txt b/code_generation/CMakeLists.txt
--- a/code_generation/CMakeLists.txt
+++ b/code_generation/CMakeLists.txt
@@ -46,3 +46,12 @@
 )
 
 set_target_properties(kode PROPERTIES OUTPUT_NAME "kode${kode_LIBRARY_QTID}")
+
+# Install each library's headers to BOTH the flat include/ root (so a consumer
+# can do `#include "class.h"` and `<kode_export.h>`, matching the test package)
+# AND the source-mirroring subdir so upstream's angle-bracket cross-directory
+# includes like `<common/qname.h>` resolve (schema/headers do this). The three
+# subdirs share no basenames, so the flat root is collision-free.
+install(TARGETS kode ARCHIVE DESTINATION lib)
+install(FILES ${CODE_GENERATION_HEADERS} DESTINATION include)
+install(FILES ${CODE_GENERATION_HEADERS} DESTINATION include/code_generation)
