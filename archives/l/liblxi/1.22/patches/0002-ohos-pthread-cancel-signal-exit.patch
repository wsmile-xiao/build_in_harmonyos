 #include "vxi11core.h"
 #include "vxi11.h"
 #include "tcp.h"
 #include "error.h"
+
+/*
+ * OHOS (musl) 不提供 POSIX 线程取消 API（知识库 E085/E513）：
+ * pthread_cancel 在链接期报 undefined symbol。这里以 weak 声明在
+ * 链接期探测：符号存在（glibc）走真 cancel；缺席（musl）时按
+ * E513 guarded-signal-thread-exit，用保留实时信号让 worker 线程
+ * 从阻塞调用中经 handler 走 pthread_exit，保住后续 pthread_join
+ * 的回收语义（应用若屏蔽 SIGRTMIN 会退化，文档见 PR 说明）。
+ */
+__attribute__((weak)) int pthread_cancel(pthread_t thread);
+
+static void _ohos_thread_exit_handler(int signo)
+{
+    (void)signo;
+    pthread_exit(0);
+}
+
+static void _ohos_thread_exit_install(void)
+{
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = _ohos_thread_exit_handler;
+    sigaction(SIGRTMIN, &sa, NULL);
+}
+
+static int _thread_cancel(pthread_t thread)
+{
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+
+    if (pthread_cancel != NULL)
+        return pthread_cancel(thread);
+
+    pthread_once(&once, _ohos_thread_exit_install);
+    return pthread_kill(thread, SIGRTMIN);
+}

