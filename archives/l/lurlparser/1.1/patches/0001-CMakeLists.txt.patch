--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,8 +1,36 @@
 cmake_minimum_required(VERSION 3.0)
 
 project("LUrlParser")
 
 add_executable(Example Example.cpp LUrlParser.cpp LUrlParser.h)
 
 set_property(TARGET Example PROPERTY CXX_STANDARD 11)
 set_property(TARGET Example PROPERTY CXX_STANDARD_REQUIRED ON)
+
+# --- HarmonyOS adaptation (recipe patch) ---
+# Upstream ships only the Example target and no install rules. Add a
+# static library target with the public header, install rules, and an
+# optional upstream gtest suite wired through Conan CMakeDeps.
+add_library(LUrlParser STATIC LUrlParser.cpp)
+target_include_directories(LUrlParser PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+    $<INSTALL_INTERFACE:include>)
+set_property(TARGET LUrlParser PROPERTY CXX_STANDARD 11)
+set_property(TARGET LUrlParser PROPERTY CXX_STANDARD_REQUIRED ON)
+
+install(TARGETS LUrlParser ARCHIVE DESTINATION lib)
+install(FILES LUrlParser.h DESTINATION include)
+install(FILES License.txt DESTINATION share/licenses/lurlparser)
+
+option(WITH_TESTS "Build the upstream gtest suite" OFF)
+if(WITH_TESTS)
+    enable_testing()
+    find_package(GTest REQUIRED)
+    add_executable(lurlparser_tests test/test.cpp)
+    target_include_directories(lurlparser_tests PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
+    # gtest 1.17 requires C++17; the library itself stays C++11.
+    set_property(TARGET lurlparser_tests PROPERTY CXX_STANDARD 17)
+    set_property(TARGET lurlparser_tests PROPERTY CXX_STANDARD_REQUIRED ON)
+    target_link_libraries(lurlparser_tests PRIVATE LUrlParser GTest::gtest)
+    add_test(NAME lurlparser_tests COMMAND lurlparser_tests)
+endif()
