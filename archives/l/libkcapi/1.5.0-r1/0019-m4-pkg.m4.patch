+dnl
+dnl PKG_INSTALLDIR([DIRECTORY])
+dnl
+dnl This macro provides an installation directory for pkg-config files.
+dnl By default, the directory is ${libdir}/pkgconfig, but can be
+dnl overridden by passing DIRECTORY as an argument.
+dnl
+AC_DEFUN([PKG_INSTALLDIR],
+[
+  AC_REQUIRE([AC_PROG_INSTALL])
+  AC_ARG_VAR([pkgconfigdir], [pkg-config installation directory @<:@default='${libdir}/pkgconfig'@:>])
+  AC_SUBST([pkgconfigdir], ['${libdir}/pkgconfig'])
+])
