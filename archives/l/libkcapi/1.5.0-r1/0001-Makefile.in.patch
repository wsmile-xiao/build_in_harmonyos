+@ENABLE_KCAPI_HASHER_TRUE@install-exec-hook:
+@ENABLE_KCAPI_HASHER_TRUE@	$(MKDIR_P) -p $(DESTDIR)/$(pkglibexecdir)
+@ENABLE_KCAPI_HASHER_TRUE@	$(foreach link, $(hasher_links), $(LN) -srf $(DESTDIR)/$(bindir)/kcapi-hasher $(DESTDIR)/$(pkglibexecdir)/$(link);)
+@ENABLE_KCAPI_HASHER_TRUE@@HAVE_OPENSSL_TRUE@	$(MKDIR_P) $(DESTDIR)$(CHECK_DIR_BIN)
+@ENABLE_KCAPI_HASHER_TRUE@@HAVE_OPENSSL_TRUE@	cd $(DESTDIR)$(bindir) && $(CHECKSUM_CMD) kcapi-hasher > $(DESTDIR)$(CHECK_DIR_BIN)/$(CHECK_PREFIX)kcapi-hasher.$(CHECK_SUFFIX)
+@ENABLE_KCAPI_HASHER_TRUE@@HAVE_OPENSSL_TRUE@	$(foreach lib, $(wildcard $(DESTDIR)$(libdir)/libkcapi.so*), \
+@ENABLE_KCAPI_HASHER_TRUE@@HAVE_OPENSSL_TRUE@		$(CHECKSUM_CMD) $(lib)  > $(DESTDIR)$(CHECK_DIR_LIB)/$(CHECK_PREFIX)$(notdir $(lib)).$(CHECK_SUFFIX);)
