diff -ruN a/run_config_status.sh b/run_config_status.sh
--- a/run_config_status.sh
+++ b/run_config_status.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+
+# 设置 TMPDIR
+export TMPDIR="/storage/Users/currentUser/tmp"
+
+# 创建临时目录
+ac_tmp=$(mktemp -d "$TMPDIR/confXXXXXX")
+echo "使用临时目录: $ac_tmp"
+
+# 运行 config.status，设置 ac_tmp
+# 首先替换 config.status 中的 ac_tmp 设置
+sed "s|^ac_tmp=\$tmp|ac_tmp=$ac_tmp|" config.status > config.status.modified
+
+# 运行修改后的 config.status
+sh config.status.modified
+
+# 清理
+rm -rf "$ac_tmp"
