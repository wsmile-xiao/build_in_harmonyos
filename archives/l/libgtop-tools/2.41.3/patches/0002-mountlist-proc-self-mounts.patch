--- a/sysdeps/linux/mountlist.c	2026-09-09 22:17:24.998894999 +0800
+++ b/sysdeps/linux/mountlist.c	2026-09-09 22:17:25.022894999 +0800
@@ -161,7 +161,14 @@
   entries = g_array_sized_new(FALSE, FALSE, sizeof(glibtop_mountentry), 8);
 
   if (!(fp = setmntent(MOUNTED, "r"))) {
-      glibtop_warn_io_r(server, "Could not open %s", MOUNTED);
+      /* Some minimal / read-only systems (e.g. HarmonyOS, containers)
