 #ifndef HAVE_SECURE_MKSTEMP
+#ifdef __OHOS__
+/* HarmonyOS: mkstemp is secure, bypass rep_mkstemp replacement.
+ * The HAVE_SECURE_MKSTEMP test fails on HarmonyOS because mkstemp
