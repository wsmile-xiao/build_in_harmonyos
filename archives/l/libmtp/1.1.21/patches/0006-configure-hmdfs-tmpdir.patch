--- a/configure
+++ b/configure
@@ -18482,12 +18482,12 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 077 && mkdir -m 777 "${TMPDIR:-/tmp}/conf$$-$RANDOM") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  tmp=${TMPDIR:-/tmp}/conf$$-$RANDOM
+  (umask 077 && mkdir -m 777 "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
