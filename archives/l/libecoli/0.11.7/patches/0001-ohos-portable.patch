+/**
+ * Portable replacement for open_memstream() used by unit tests.
+ *
+ * open_memstream() is not usable on all supported libc builds here:
+ * dumps captured through it come back empty and dict/htable crash.
+ * Capture dump output in an unlinked temp file inside TMPDIR/TMP/TEMP
+ * (writable dir ensured by the recipe) and read it back on close.
+ * Test assertions are unchanged.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static inline FILE *
+ec_test_memstream_open(char **bufp, size_t *sizep)
+{
+	char *path;
+	const char *tmpd;
+	int fd;
+	FILE *f;
+
+	if (bufp == NULL || sizep == NULL)
+		return NULL;
+	*bufp = NULL;
+	*sizep = 0;
+
+	tmpd = getenv("TMPDIR");
+	if (tmpd == NULL)
+		tmpd = getenv("TMP");
+	if (tmpd == NULL)
+		tmpd = getenv("TEMP");
+	if (tmpd == NULL)
+		tmpd = "/tmp";
+
+	path = malloc(strlen(tmpd) + 32);
+	if (path == NULL)
+		return NULL;
+	sprintf(path, "%s/ecoli_test_XXXXXX", tmpd);
+	fd = mkstemp(path);
+	if (fd < 0) {
+		free(path);
+		return NULL;
+	}
+	unlink(path);
+	free(path);
+
+	f = fdopen(fd, "w+");
+	if (f == NULL)
+		close(fd);
+	return f;
+}
+
+static inline int
+ec_test_memstream_close(FILE *f, char **bufp, size_t *sizep)
+{
+	char *buf;
+	size_t n;
+	long size;
+
+	if (f == NULL || bufp == NULL || sizep == NULL)
+		return -1;
+	if (fflush(f) != 0)
+		return -1;
+	if (fseek(f, 0, SEEK_END) != 0)
+		return -1;
+	size = ftell(f);
+	if (size < 0)
+		return -1;
+	rewind(f);
+	buf = malloc((size_t)size + 1);
+	if (buf == NULL)
+		return -1;
+	n = fread(buf, 1, (size_t)size, f);
+	buf[n] = '\0';
+	fclose(f);
+	*bufp = buf;
+	*sizep = n;
+	return 0;
+}
 
