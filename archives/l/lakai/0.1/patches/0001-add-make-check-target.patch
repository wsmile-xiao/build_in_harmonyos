--- a/Makefile
+++ b/Makefile
@@ -50,3 +50,13 @@
 clean:
 	rm -f *.o $(OBJS) $(LIB) lakclear lakbak lakres
 
+
+# --- OHOS adaptation: self-authored test suite -------------------------
+# Upstream lakai 0.1 ships no test suite at all (no check/test target and no
+# tests/ directory), so the OHOS archive adds this target to run the
+# adaptation test suite against the freshly built liblakai.a and the CLIs.
+TEST_BIN=test_lakai
+
+check: $(LIB) progs
+	$(CC) $(CFLAGS) -I. tests/test_lakai.c -L. -llakai -o $(TEST_BIN)
+	./$(TEST_BIN) .
