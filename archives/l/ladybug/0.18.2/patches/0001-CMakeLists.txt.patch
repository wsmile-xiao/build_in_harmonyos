--- a/CMakeLists.txt	2026-07-15 10:15:47.000000000 +0800
+++ b/CMakeLists.txt	2026-08-21 15:30:49.039368595 +0800
@@ -467,6 +467,28 @@
 include_directories(third_party/roaring_bitmap)
 include_directories(SYSTEM third_party/simsimd/include)
 
+# HarmonyOS: OHOS Clang 15 cannot compile simsimd's extended SIMD backends:
+#   - arm_sve.h hard-errors ("SVE support not enabled") without -march=...+sve,
+#   - per-function target("arch=...+dotprod/fp16/bf16") attributes fail to enable
+#     the dotprod/fp16/bf16 NEON intrinsics (vdotq_s32, bfloat16x8_t, ...).
+# Disable the extended backends and fall back to baseline NEON, which is
+# universally available on AArch64. simsimd does runtime dispatch, so vector
+# queries still work (via the NEON backend).
+if(CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    add_compile_definitions(
+        SIMSIMD_TARGET_SVE=0
+        SIMSIMD_TARGET_SVE2=0
+        SIMSIMD_TARGET_NEON_I8=0
+        SIMSIMD_TARGET_NEON_F16=0
+        SIMSIMD_TARGET_NEON_BF16=0)
+    # OHOS libc++ (LLVM 15) ships std::format in <format> but gates it behind
+    # _LIBCPP_ENABLE_EXPERIMENTAL, and the runtime symbols (std::format_error,
+    # __throw_format_error) live in libc++experimental.a. ladybug uses
+    # std::format throughout its core headers.
+    add_compile_definitions(_LIBCPP_ENABLE_EXPERIMENTAL)
+    add_link_options(-lc++experimental)
+endif()
+
 add_subdirectory(third_party)
 
 add_library(lbug_link_deps INTERFACE)
@@ -478,7 +500,9 @@
 if(NOT WIN32)
     list(PREPEND LBUG_LINK_LIBRARIES dl)
 endif()
-if ((NOT APPLE AND NOT BSD AND NOT WIN32 AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang") AND NOT __WASM__ AND NOT __SINGLE_THREADED__)
+if ((NOT APPLE AND NOT BSD AND NOT WIN32 AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang") AND NOT __WASM__ AND NOT __SINGLE_THREADED__ AND NOT (CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS"))
+    # HarmonyOS ships no libatomic and aarch64 clang inlines all 128-bit atomics
+    # (ldaxp/stlxp), so the explicit -latomic link would fail on OHOS.
     list(PREPEND LBUG_LINK_LIBRARIES atomic)
 endif()
 if (ENABLE_BACKTRACES)
