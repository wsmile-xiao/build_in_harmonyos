@@ -8,23 +8,61 @@
 #if HAVE_LIBCURL
 /* Convert UTF-8 @string representation of ISO 8601 date to @time.
  * XXX: Not all ISO formats are supported */
 _hidden isds_error _isds_datestring2tm(const xmlChar *string, struct tm *time) {
     char *offset;
+    struct tm tmp;
     if (!string || !time) return IE_INVAL;
 
     /* xsd:date is ISO 8601 string, thus ASCII */
-    offset = strptime((char*)string, "%Y-%m-%d", time);
-    if (offset && *offset == '\0')
+    memset(&tmp, 0, sizeof(tmp));
+    offset = strptime((char*)string, "%Y-%m-%d", &tmp);
+    if (offset && *offset == '\0') {
+        *time = tmp;
         return IE_SUCCESS;
+    }
 
-    offset = strptime((char*)string, "%Y%m%d", time);
-    if (offset && *offset == '\0')
+    memset(&tmp, 0, sizeof(tmp));
+    offset = strptime((char*)string, "%Y%m%d", &tmp);
+    if (offset && *offset == '\0') {
+        *time = tmp;
         return IE_SUCCESS;
+    }
 
-    offset = strptime((char*)string, "%Y-%j", time);
-    if (offset && *offset == '\0')
+    /* Year plus day-of-year (%Y-%j): parsed manually instead of
+     * strptime %j, whose normalization of tm_mon/tm_mday is glibc
+     * specific. musl/OHOS leave month/day untouched (and earlier
+     * failed parses would otherwise leak e.g. tm_mon=34 into the
+     * result), so convert the ordinal day with leap-year handling. */
+    {
+        int year = 0, yday = 0;
+        char trailing = '\0';
+        static const int mdays[12] =
+            { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
+        int leap = 0, m = 0, remaining = 0;
+
+        if (sscanf((const char *)string, "%4d-%3d%c", &year, &yday,
+                &trailing) != 2)
+            return IE_NOTSUP;
+        leap = ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0);
+        if (yday < 1 || yday > 365 + leap)
+            return IE_NOTSUP;
+        memset(&tmp, 0, sizeof(tmp));
+        remaining = yday;
+        for (m = 0; m < 12; m++) {
+            int dim = mdays[m] + ((m == 1 && leap) ? 1 : 0);
+            if (remaining > dim)
+                remaining -= dim;
+            else
+                break;
+        }
+        tmp.tm_year = year - 1900;
+        tmp.tm_mon = m;
+        tmp.tm_mday = remaining;
+        tmp.tm_yday = yday - 1;
+        *time = tmp;
         return IE_SUCCESS;
+    }
 
     return IE_NOTSUP;
 }
 #endif
