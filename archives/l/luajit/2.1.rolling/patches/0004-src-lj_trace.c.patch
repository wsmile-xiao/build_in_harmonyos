diff -ruN a/src/lj_trace.c b/src/lj_trace.c
--- a/src/lj_trace.c
+++ b/src/lj_trace.c
@@ -102,22 +102,24 @@
   const char *name = proto_chunknamestr(pt);
   BCLine lineno;
   if (name[0] == '@' || name[0] == '=')
     name++;
   else
     name = "(string)";
   lj_assertX(startpc >= proto_bc(pt) && startpc < proto_bc(pt) + pt->sizebc,
 	     "trace PC out of range");
   lineno = lj_debug_line(pt, proto_bcpos(pt, startpc));
   if (!fp) {
-    char fname[40];
-    sprintf(fname, "/tmp/perf-%d.map", getpid());
+    char fname[64];
+    const char *tmpdir = getenv("TMPDIR");
+    if (!tmpdir) tmpdir = "/data/local/tmp";
+    snprintf(fname, sizeof(fname), "%s/perf-%d.map", tmpdir, getpid());
     if (!(fp = fopen(fname, "w"))) return;
     setlinebuf(fp);
   }
   fprintf(fp, "%lx %x TRACE_%d::%s:%u\n",
 	  (long)T->mcode, T->szmcode, T->traceno, name, lineno);
 }
 #endif
 
