diff -ruN a/src/lib_os.c b/src/lib_os.c
--- a/src/lib_os.c
+++ b/src/lib_os.c
@@ -76,21 +76,23 @@
 
 LJLIB_CF(os_tmpname)
 {
 #if LJ_TARGET_PS3 || LJ_TARGET_PS4 || LJ_TARGET_PS5 || LJ_TARGET_PSVITA || LJ_TARGET_NX
   lj_err_caller(L, LJ_ERR_OSUNIQF);
   return 0;
 #else
 #if LJ_TARGET_POSIX
   char buf[15+1];
   int fp;
-  strcpy(buf, "/tmp/lua_XXXXXX");
+  const char *tmpdir = getenv("TMPDIR");
+  if (!tmpdir) tmpdir = "/data/local/tmp";
+  snprintf(buf, sizeof(buf), "%s/lua_XXXXXX", tmpdir);
   fp = mkstemp(buf);
   if (fp != -1)
     close(fp);
   else
     lj_err_caller(L, LJ_ERR_OSUNIQF);
 #else
   char buf[L_tmpnam];
   if (tmpnam(buf) == NULL)
     lj_err_caller(L, LJ_ERR_OSUNIQF);
 #endif
