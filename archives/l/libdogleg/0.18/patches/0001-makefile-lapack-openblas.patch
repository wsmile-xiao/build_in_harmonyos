diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -20,7 +20,11 @@
 DIST_INCLUDE += \
   dogleg.h

-LDLIBS += -lcholmod -llapack -lsuitesparseconfig
+# OHOS portability: link the LAPACK symbols (dpptrf_/dpotrf_ used by the dense
+# paths in dogleg.c) from openblas, the BLAS/LAPACK provider shipped in this
+# registry (same provider suitesparse/7.8.3 links against). Upstream -llapack
+# assumes a system liblapack.so, which does not exist on OHOS.
+LDLIBS += -lcholmod -lopenblas -lsuitesparseconfig
 LDLIBS += -lm

 CFLAGS += -Wall -Wextra
