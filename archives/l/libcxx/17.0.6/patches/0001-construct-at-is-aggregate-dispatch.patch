+// HarmonyOS PC adaptation: clang 15 does not implement C++20 parenthesized
+// aggregate initialization, which libc++17's construct_at relies on. Dispatch
+// on std::is_aggregate so aggregates use brace-init (works on clang 15) while
+// non-aggregates keep paren-init (preserves e.g. nlohmann::basic_json being
+// constructed from a json_ref).
+
+namespace __construct_at_detail {
+
+template <class _Tp, class... _Args,
+          class = decltype(::new(std::declval<void*>()) _Tp{std::declval<_Args>()...})>
+_LIBCPP_HIDE_FROM_ABI constexpr _Tp*
+__construct_at_impl(_Tp* __location, true_type /* is_aggregate */, _Args&&... __args) {
+  return ::new (std::__voidify(*__location)) _Tp{std::forward<_Args>(__args)...};
+}
+
+template <class _Tp, class... _Args,
+          class = decltype(::new(std::declval<void*>()) _Tp(std::declval<_Args>()...))>
+_LIBCPP_HIDE_FROM_ABI constexpr _Tp*
+__construct_at_impl(_Tp* __location, false_type /* is_aggregate */, _Args&&... __args) {
+  return ::new (std::__voidify(*__location)) _Tp(std::forward<_Args>(__args)...);
+}
+
+} // namespace __construct_at_detail
