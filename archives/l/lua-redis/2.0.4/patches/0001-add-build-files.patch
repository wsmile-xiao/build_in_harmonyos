--- a/configure 1970-01-01 00:00:00.000000000 +0000
+++ b/configure 2026-06-11 12:00:00.000000000 +0000
@@ -0,0 +1,5 @@
+#!/bin/sh
+# Pure Lua library, no configure needed
+echo "lua-redis is a pure Lua library, no configuration required"
+exit 0
--- a/Makefile 1970-01-01 00:00:00.000000000 +0000
+++ b/Makefile 2026-06-11 12:00:00.000000000 +0000
@@ -0,0 +1,17 @@
+# Makefile for lua-redis (pure Lua library)
+
+PREFIX ?= /usr/local
+LUA_VERSION ?= 5.4
+
+INSTALL_DIR = $(PREFIX)/share/lua/$(LUA_VERSION)
+
+all:
+	@echo "Nothing to build for pure Lua library"
+
+install:
+	mkdir -p $(DESTDIR)$(INSTALL_DIR)
+	cp src/redis.lua $(DESTDIR)$(INSTALL_DIR)/
+
+check:
+	@echo "No automated tests available"
+
+.PHONY: all install check clean
