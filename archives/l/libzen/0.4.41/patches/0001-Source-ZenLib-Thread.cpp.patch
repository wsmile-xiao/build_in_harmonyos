--- a/Source/ZenLib/Thread.cpp
+++ b/Source/ZenLib/Thread.cpp
@@ -402,6 +402,13 @@ Thread::returnvalue Thread::Internal_Exit()
 //---------------------------------------------------------------------------
 #include <pthread.h>
 #include <unistd.h>
+
+// musl-based libcs (e.g. OHOS) do not implement POSIX thread cancellation
+// and ship no pthread_cancel symbol at all. A weak declaration keeps the
+// reference binding to the real function on full POSIX libcs (upstream
+// cancellation semantics kept) while resolving to NULL where it is absent;
+// Thread::ForceTerminate() tests the pointer before calling it.
+extern "C" int pthread_cancel(pthread_t) __attribute__((weak));
 #ifdef _POSIX_PRIORITY_SCHEDULING
     #include <sched.h>
 #endif //_POSIX_PRIORITY_SCHEDULING
@@ -519,7 +526,8 @@ Thread::returnvalue Thread::ForceTerminate()
 {
     //Terminating (not clean)
     #if !defined(__ANDROID_API__)
-    pthread_cancel((pthread_t)ThreadPointer);
+    if (pthread_cancel)
+        pthread_cancel((pthread_t)ThreadPointer);
     #endif
 
     //Configuring
