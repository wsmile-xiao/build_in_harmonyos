+-- Lua 5.4 compatibility: math.frexp and math.ldexp were removed
+local frexp = math.frexp or function(x)
+  if x == 0 then return 0, 0 end
+  local e = 0
+  if x < 0 then
+    x = -x
+  end
+  while x >= 1 do
+    x = x / 2
+    e = e + 1
+  end
+  while x < 0.5 do
+    x = x * 2
+    e = e - 1
+  end
+  return x, e
+end
+
+local ldexp = math.ldexp or function(m, e)
+  return m * (2 ^ e)
+end
