--- a/cpp/cmake_modules/ThirdpartyToolchain.cmake
+++ b/cpp/cmake_modules/ThirdpartyToolchain.cmake
@@ -3254,6 +3254,16 @@
     message(STATUS "Forcing gRPC_SOURCE to Protobuf_SOURCE (${Protobuf_SOURCE})")
     set(gRPC_SOURCE "${Protobuf_SOURCE}")
   endif()
+  # Conan/OHOS registry: the installed gRPCTargets.cmake shipped with the
+  # registry grpc package references the `openssl::openssl` imported target,
+  # which is only created by Conan's openssl-config.cmake (CMakeDeps).
+  # Arrow's own OpenSSL resolution above (OPENSSL_ROOT_DIR + built-in
+  # FindOpenSSL in MODULE mode) succeeds without ever loading the conan
+  # config, so gRPCTargets.cmake would fail on the missing target.
+  # Load the conan openssl config explicitly before resolving gRPC.
+  if(NOT TARGET openssl::openssl)
+    find_package(openssl CONFIG REQUIRED)
+  endif()
   resolve_dependency(gRPC
                      ARROW_CMAKE_PACKAGE_NAME
                      ArrowFlight
