diff --git a/ai-proto/cmake/KylinAiProtoFunctions.cmake b/ai-proto/cmake/KylinAiProtoFunctions.cmake
index 9acda09..923dd08 100644
--- a/ai-proto/cmake/KylinAiProtoFunctions.cmake
+++ b/ai-proto/cmake/KylinAiProtoFunctions.cmake
@@ -1,4 +1,12 @@
 function(kylin_ai_generate_gdbus_proto_code RETURNED_GDBUS_GLUE_FILES) #REQUIRED_GLIB_MIN_VERSION #XMLFILENAMES)
+    # 变量化缺省回退（审查 P3）：外部（消费者配方 generate()）未注入 KYLAI_*
+    # 变量时回退 Linux 布局，避免 COMMAND 为空/目录缺失导致无提示失败
+    if(NOT DEFINED KYLAI_GDBUS_CODEGEN)
+        set(KYLAI_GDBUS_CODEGEN /usr/bin/gdbus-codegen)
+    endif()
+    if(NOT DEFINED KYLAI_GDBUS_PROTOCOL_DIR)
+        set(KYLAI_GDBUS_PROTOCOL_DIR /usr/share/kylin-ai/protocols/gdbus)
+    endif()
     set(REQUIRED_GLIB_MIN_VERSION)
     set(XML_FILE_NAMES)
     set(XML_FILES)
@@ -14,7 +22,7 @@ function(kylin_ai_generate_gdbus_proto_code RETURNED_GDBUS_GLUE_FILES) #REQUIRED
     endforeach()
 
     foreach(XML_FILE_NAME ${XML_FILE_NAMES})
-        set(XML_FILE /usr/share/kylin-ai/protocols/gdbus/${XML_FILE_NAME}.xml)
+        set(XML_FILE ${KYLAI_GDBUS_PROTOCOL_DIR}/${XML_FILE_NAME}.xml)
         if(NOT EXISTS ${XML_FILE})
             message(FATAL_ERROR "gdbus-codegen: Unable to find XML file: ${XML_FILE_NAME}")
         else()
@@ -26,7 +34,7 @@ function(kylin_ai_generate_gdbus_proto_code RETURNED_GDBUS_GLUE_FILES) #REQUIRED
         get_filename_component(PROTO_FILE_NAME ${PROTO_FILE} NAME)
         string(REPLACE ".xml" "" PROTO_FILE_NAME ${PROTO_FILE_NAME})
         execute_process(
-            COMMAND /usr/bin/gdbus-codegen ${REQUIRED_GLIB_MIN_VERSION} --output-directory=${CMAKE_CURRENT_BINARY_DIR}
+            COMMAND ${KYLAI_GDBUS_CODEGEN} ${REQUIRED_GLIB_MIN_VERSION} --output-directory=${CMAKE_CURRENT_BINARY_DIR}
                 --generate-c-code=${PROTO_FILE_NAME}glue --interface-prefix=com.kylin ${PROTO_FILE}
             WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
             RESULT_VARIABLE GDBUS_RESULT
