diff -ruN a/Makefile.in b/Makefile.in
--- a/Makefile.in
+++ b/Makefile.in
@@ -1,10 +1,35 @@
+# Makefile.in for Lzip - LZMA lossless data compressor
+# Copyright (C) 2008-2026 Antonio Diaz Diaz.
+#
+# This Makefile is free software: you have unlimited permission
+# to copy, distribute, and modify it.
+
+# Variables with ?= defaults for OpenHarmony build.
+# When configure runs, it writes these with = before appending this file,
+# so ?= won't override configure's values.
+# When configure cannot run (e.g. HMDFS issues), these defaults apply.
+pkgname ?= lzip
+pkgversion ?= 1.26
+progname ?= lzip
+VPATH ?= .
+prefix ?= /usr/local
+exec_prefix ?= $(prefix)
+bindir ?= $(exec_prefix)/bin
+datarootdir ?= $(prefix)/share
+infodir ?= $(datarootdir)/info
+mandir ?= $(datarootdir)/man
+CXX ?= clang++
+CPPFLAGS ?=
+CXXFLAGS ?= -Wall -W -O2 -fPIC
+LDFLAGS ?=
+MAKEINFO ?= makeinfo
 
 DISTNAME = $(pkgname)-$(pkgversion)
 INSTALL = install
 INSTALL_PROGRAM = $(INSTALL) -m 755
 INSTALL_DIR = $(INSTALL) -d -m 755
 INSTALL_DATA = $(INSTALL) -m 644
 SHELL = /bin/sh
 CAN_RUN_INSTALLINFO = $(SHELL) -c "install-info --version" > /dev/null 2>&1
 
 objs = arg_parser.o lzip_index.o list.o encoder_base.o encoder.o \
