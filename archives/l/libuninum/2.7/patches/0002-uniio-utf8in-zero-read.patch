diff --git a/uniio.c b/uniio.c
--- a/uniio.c
+++ b/uniio.c
@@ -158,10 +158,15 @@
   /* Now get the remaining bytes */
   BytesNeeded = (int) TrailingBytesForUTF8[c[0]];
   BytesSoFar = 0;
-  do {
+  /* read(fd, buf, 0) does not reliably return 0 (OHOS bionic returns -1),
+   * which made this loop over-read and swallow the rest of the input line.
+   * Only read while trailing bytes are actually needed, and stop on error.
+   */
+  while (BytesSoFar < BytesNeeded) {
     BytesRead = read(fd,(void *) &c[BytesSoFar+1],(size_t) (BytesNeeded-BytesSoFar));
+    if (BytesRead <= 0) break;
     BytesSoFar += BytesRead;
-  } while (BytesRead > 0 || BytesSoFar < BytesNeeded);
+  }
   if(BytesSoFar != BytesNeeded) return(UTF8_NOTENOUGHBYTES);
   *bytes = BytesNeeded+1;
   *bstr = &c[0];
