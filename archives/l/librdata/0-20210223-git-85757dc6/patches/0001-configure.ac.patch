--- a/configure.ac
+++ b/configure.ac
@@ -14,7 +14,14 @@
     [SANITIZERS="-fsanitize=address,bool,float-cast-overflow,integer-divide-by-zero,return,returns-nonnull-attribute,shift-exponent,signed-integer-overflow,unreachable,vla-bound -fsanitize-coverage=trace-pc-guard,indirect-calls,trace-cmp"], [SANITIZERS=""])
 AC_SUBST([SANITIZERS])
 
-AM_ICONV
+dnl AM_ICONV comes from GNU gettext's iconv.m4, which is not part of the
+dnl OHOS build-tool closure (autoreconf then fails with "possibly
+dnl undefined macro: AM_ICONV"). OHOS musl libc provides iconv.h and
+dnl iconv()/iconv_open()/iconv_close() in libc itself, so check those
+dnl directly instead of pulling in gettext.
+AC_CHECK_HEADERS([iconv.h], [], [AC_MSG_ERROR([iconv.h not found])])
+AC_CHECK_FUNCS([iconv_open iconv iconv_close], [],
+               [AC_MSG_ERROR([iconv functions not found in libc])])
 
 AC_CANONICAL_HOST
 AS_CASE([$host],
