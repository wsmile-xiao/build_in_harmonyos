--- /dev/null
+++ b/libwnck/x11-compat/gdk/gdkx.h
@@ -0,0 +1,49 @@
+/* Standalone GDK-X11 compatibility declarations for non-X11 GDK builds. */
+#ifndef WNCK_GDKX_COMPAT_H
+#define WNCK_GDKX_COMPAT_H
+
+#include <gdk/gdk.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+
+G_BEGIN_DECLS
+
+Display *gdk_x11_display_get_xdisplay (GdkDisplay *display);
+GdkDisplay *gdk_x11_lookup_xdisplay (Display *xdisplay);
+void gdk_x11_display_error_trap_push (GdkDisplay *display);
+gint gdk_x11_display_error_trap_pop (GdkDisplay *display);
+void gdk_x11_display_error_trap_pop_ignored (GdkDisplay *display);
+
+GdkAtom gdk_x11_xatom_to_atom (Atom xatom);
+Atom gdk_x11_get_xatom_by_name (const gchar *atom_name);
+const gchar *gdk_x11_get_xatom_name (Atom xatom);
+
+gint gdk_x11_screen_get_screen_number (GdkScreen *screen);
+gboolean gdk_x11_screen_supports_net_wm_hint (GdkScreen *screen,
+                                               GdkAtom property);
+
+Window gdk_x11_window_get_xid (GdkWindow *window);
+GdkWindow *gdk_x11_window_lookup_for_display (GdkDisplay *display,
+                                               Window window);
+void wnck_x11_window_add_filter (GdkWindow *window,
+                                 GdkFilterFunc function,
+                                 gpointer data);
+void wnck_x11_window_remove_filter (GdkWindow *window,
+                                    GdkFilterFunc function,
+                                    gpointer data);
+
+#define GDK_DISPLAY_XDISPLAY(display) (gdk_x11_display_get_xdisplay (display))
+#define GDK_WINDOW_XID(window) (gdk_x11_window_get_xid (window))
+#define GDK_IS_X11_DISPLAY(display) \
+  (gdk_x11_display_get_xdisplay (display) != NULL)
+#define gdk_display_flush(display) \
+  XFlush (gdk_x11_display_get_xdisplay (display))
+#define gdk_display_get_default_screen(display) (gdk_screen_get_default ())
+#define gdk_window_add_filter(window, function, data) \
+  wnck_x11_window_add_filter ((window), (function), (data))
+#define gdk_window_remove_filter(window, function, data) \
+  wnck_x11_window_remove_filter ((window), (function), (data))
+
+G_END_DECLS
+
+#endif
