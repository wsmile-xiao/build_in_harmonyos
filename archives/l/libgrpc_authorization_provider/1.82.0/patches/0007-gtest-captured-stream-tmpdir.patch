--- a/third_party/googletest/googletest/src/gtest-port.cc	2026-09-18 18:58:53.506323750 +0800
+++ b/third_party/googletest/googletest/src/gtest-port.cc	2026-09-18 19:09:50.118320781 +0800
@@ -1129,7 +1129,19 @@
     if (!EndsWithPathSeparator(name_template))
       name_template.push_back(GTEST_PATH_SEP_[0]);
 #else
-    name_template = "/tmp/";
+    // OHOS adaptation: honor $TEST_TMPDIR/$TMPDIR (same variables the
+    // Android branch and gtest.cc TempDir() use) so stream-capturing
+    // tests work where /tmp is read-only; falls back to "/tmp/".
+    const char* gtest_tmpdir = ::getenv("TEST_TMPDIR");
+    if (gtest_tmpdir == nullptr || *gtest_tmpdir == '\0') {
+      gtest_tmpdir = ::getenv("TMPDIR");
+    }
+    name_template =
+        (gtest_tmpdir != nullptr && *gtest_tmpdir != '\0') ? gtest_tmpdir : "/tmp/";
+    if (!name_template.empty() &&
+        name_template[name_template.size() - 1] != GTEST_PATH_SEP_[0]) {
+      name_template.push_back(GTEST_PATH_SEP_[0]);
+    }
 #endif
     name_template.append("gtest_captured_stream.XXXXXX");
 
