--- a/src/core/util/posix/tmpfile.cc	2026-09-18 00:21:42.275012969 +0800
+++ b/src/core/util/posix/tmpfile.cc	2026-09-18 00:22:12.207008906 +0800
@@ -41,7 +41,14 @@
 
   if (tmp_filename != nullptr) *tmp_filename = nullptr;
 
-  gpr_asprintf(&filename_template, "/tmp/%s_XXXXXX", prefix);
+  // Use $TMPDIR when set (POSIX convention); this lets tests run on systems
+  // where /tmp is read-only (e.g. sandboxed/containerized environments).
+  // Falls back to /tmp when $TMPDIR is unset or empty.
+  const char* tmpdir = getenv("TMPDIR");
+  if (tmpdir == nullptr || *tmpdir == '\0') {
+    tmpdir = "/tmp";
+  }
+  gpr_asprintf(&filename_template, "%s/%s_XXXXXX", tmpdir, prefix);
   CHECK_NE(filename_template, nullptr);
 
   fd = mkstemp(filename_template);
