diff -ruN /dev/null b/src/socket-wrapper.h
--- /dev/null
+++ b/src/socket-wrapper.h
@@ -0,0 +1,27 @@
+#ifndef __SOCKET_WRAPPER_H__
+#define __SOCKET_WRAPPER_H__
+/*
+ * Wrapper for socket headers to avoid conflicts between linux/socket.h and sys/socket.h
+ * in HarmonyOS SDK.
+ *
+ * Problem: Both linux/socket.h and sys/socket.h define sockaddr_storage, causing conflicts.
+ * Also, linux/netlink.h needs __kernel_sa_family_t from linux/socket.h.
+ *
+ * Solution:
+ * 1. Include linux/socket.h first to get __kernel_sa_family_t and kernel sockaddr_storage
+ * 2. Define __MUSL__ to prevent sys/socket.h from defining duplicate sockaddr_storage
+ * 3. Include sys/socket.h for other POSIX socket functions
+ */
+
+/* Step 1: Include linux/socket.h for kernel socket definitions */
+#include <linux/socket.h>
+
+/* Step 2: Prevent sys/socket.h from defining sockaddr_storage (it's guarded by __MUSL__) */
+#ifndef __MUSL__
+#define __MUSL__
+#endif
+
+/* Step 3: Include sys/socket.h for POSIX socket API (sockaddr_storage already defined by linux/socket.h) */
+#include <sys/socket.h>
+
+#endif /* __SOCKET_WRAPPER_H__ */