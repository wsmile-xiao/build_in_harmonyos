 namespace {
 
+std::string ResolvePluginPathForTest(const std::string& plugin_path) {
+  if (plugin_path.empty() || plugin_path.find('/') != std::string::npos) {
+    return plugin_path;
+  }
+  const char* const prefixes[] = {"./", "./build/Release/"};
+  for (const char* prefix : prefixes) {
+    std::string candidate = absl::StrCat(prefix, plugin_path);
+    if (File::Exists(candidate)) {
+      return candidate;
+    }
+  }
+  return plugin_path;
+}
