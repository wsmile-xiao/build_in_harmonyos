 static int io_popen (lua_State *L) {
   const char *filename = luaL_checkstring(L, 1);
   const char *mode = luaL_optstring(L, 2, "r");
   FILE **pf = newfile(L);
   *pf = lua_popen(L, filename, mode);
   return (*pf == NULL) ? pushresult(L, 0, filename) : 1;
 }
 
 
+#if defined(LUA_USE_MKSTEMP)
+static FILE *tmpfile_from_tmpdir (void) {
+  const char *tmpdir = getenv("TMPDIR");
+  char *name;
+  size_t len;
+  int fd;
+  FILE *file;
+  if (tmpdir == NULL || *tmpdir == '\0')
+    return tmpfile();
+  len = strlen(tmpdir) + sizeof("/lua_XXXXXX");
+  name = (char *)malloc(len);
+  if (name == NULL) {
+    errno = ENOMEM;
+    return NULL;
+  }
+  snprintf(name, len, "%s/lua_XXXXXX", tmpdir);
+  fd = mkstemp(name);
+  if (fd == -1) {
+    free(name);
+    return NULL;
+  }
+  if (unlink(name) != 0) {
+    close(fd);
+    remove(name);
+    free(name);
+    return NULL;
+  }
+  free(name);
+  file = fdopen(fd, "w+b");
+  if (file == NULL)
+    close(fd);
+  return file;
+}
+#endif
+
+
 static int io_tmpfile (lua_State *L) {
   FILE **pf = newfile(L);
+#if defined(LUA_USE_MKSTEMP)
+  *pf = tmpfile_from_tmpdir();
+#else
   *pf = tmpfile();
+#endif
   return (*pf == NULL) ? pushresult(L, 0, NULL) : 1;
 }
 
 
