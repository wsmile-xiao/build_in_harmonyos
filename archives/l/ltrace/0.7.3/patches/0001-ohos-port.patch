From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AtomCode <noreply@atomgit.com>
Date: Wed, 2 Sep 2026 17:00:00 +0000
Subject: [PATCH] Add OpenHarmony support

Recognize linux-ohos* as a valid host_os, treating it the same as linux-gnu.

diff --git a/configure.ac b/configure.ac
index 1111111..2222222 100644
--- a/configure.ac
+++ b/configure.ac
@@ -32,7 +32,7 @@ AC_CONFIG_AUX_DIR([config/autoconf])
 AC_CANONICAL_HOST
 
 case "${host_os}" in
-    linux-gnu*) HOST_OS="linux-gnu" ;;
+    linux-gnu*|linux-ohos*) HOST_OS="linux-gnu" ;;
     linux-uclibc*) HOST_OS="linux-gnu" ;;
     *)		AC_MSG_ERROR([unkown host-os ${host_os}]) ;;
 esac
