diff -ruN a/subprojects/libinsane-gobject/src/meson.build b/subprojects/libinsane-gobject/src/meson.build
--- a/subprojects/libinsane-gobject/src/meson.build
+++ b/subprojects/libinsane-gobject/src/meson.build
@@ -43,18 +43,29 @@
 
 ## Introspection
 
-gir = gnome.generate_gir(libinsane_gobject,
-    sources: INSANE_GOBJECT_SRCS + INSANE_GOBJECT_HEADERS,
-    namespace: 'Libinsane',
-    # Not a typo: This is the GObject API version. Not the Libinsane
-    # version.
-    nsversion: '1.0',
-    includes: 'GObject-2.0',
-    install: true)
+# gnome.generate_gir() resolves dependency('gobject-introspection-1.0') while
+# configure runs, and gnome.generate_vapi() additionally needs vapigen. Neither
+# tool exists in a HarmonyOS PC build environment, so the whole subproject
+# aborted at src/meson.build:46 with 'Dependency "gobject-introspection-1.0"
+# not found'. Upstream declares no switch for it, so the block is gated on the
+# 'introspection' option added next to this file: turn it on where
+# g-ir-scanner/vapigen are installed and upstream behaviour returns unchanged.
+if get_option('introspection')
+    gir = gnome.generate_gir(libinsane_gobject,
+        sources: INSANE_GOBJECT_SRCS + INSANE_GOBJECT_HEADERS,
+        namespace: 'Libinsane',
+        # Not a typo: This is the GObject API version. Not the Libinsane
+        # version.
+        nsversion: '1.0',
+        includes: 'GObject-2.0',
+        install: true)
 
-## Vala support
+    ## Vala support
 
-gnome.generate_vapi('libinsane',
-    sources: [gir.get(0)],
-    install: true,
-    packages: ['glib-2.0', 'gobject-2.0'])
+    gnome.generate_vapi('libinsane',
+        sources: [gir.get(0)],
+        install: true,
+        packages: ['glib-2.0', 'gobject-2.0'])
+else
+    message('Introspection disabled: no g-ir-scanner/vapigen here, so Libinsane-1.0.typelib and libinsane.vapi are not generated.')
+endif
