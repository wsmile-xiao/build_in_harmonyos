diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,17 +1,18 @@
 
 ifneq ($(OS),Windows_NT)
 OS := $(shell uname -s)
 endif
 
-CC    := $(CROSS_COMPILE)gcc
-STRIP := $(CROSS_COMPILE)strip
+CC    ?= $(CROSS_COMPILE)gcc
+STRIP ?= $(CROSS_COMPILE)strip
+prefix ?= /usr/local
 
 CFLAGS += -O2 -Wall -Wextra -Wmissing-declarations -Wmissing-prototypes -Wstrict-prototypes -Wpointer-arith -Wno-unused-parameter
 LDFLAGS += -lpthread
 SHARED = -shared -Wl,-soname,libhdhomerun$(LIBEXT)
 
 IF_DETECT := getifaddrs
 BINEXT :=
 LIBEXT := .so
 
 ifeq ($(OS),Windows_NT)
@@ -84,14 +85,22 @@
 	$(CC) $(CFLAGS) $+ $(LDFLAGS) -o $@
 	$(STRIP) $@
 
 clean :
 	-rm -f hdhomerun_config$(BINEXT)
 	-rm -f libhdhomerun$(LIBEXT)
 	-rm -f hdhomerun_discover_example$(BINEXT)
 
 distclean : clean
 
+install :
+	mkdir -p $(DESTDIR)$(prefix)/bin
+	mkdir -p $(DESTDIR)$(prefix)/lib
+	mkdir -p $(DESTDIR)$(prefix)/include
+	cp hdhomerun_config$(BINEXT) $(DESTDIR)$(prefix)/bin/
+	cp libhdhomerun$(LIBEXT) $(DESTDIR)$(prefix)/lib/
+	cp hdhomerun.h hdhomerun_os.h hdhomerun_os_posix.h hdhomerun_types.h hdhomerun_pkt.h hdhomerun_sock.h hdhomerun_debug.h hdhomerun_discover.h hdhomerun_control.h hdhomerun_video.h hdhomerun_channels.h hdhomerun_channelscan.h hdhomerun_device.h hdhomerun_device_selector.h $(DESTDIR)$(prefix)/include/
+
 %:
 	@echo "(ignoring request to make $@)"
 
 .PHONY: all list clean distclean
