--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -4,7 +4,13 @@
 
 set_directory_properties(PROPERTIES ADDITIONAL_MAKE_CLEAN_FILES "gschemas.compiled")
 set_source_files_properties("gschemas.compiled" GENERATED)
-execute_process(COMMAND ${PKG_CONFIG_EXECUTABLE} gio-2.0 --variable glib_compile_schemas OUTPUT_VARIABLE COMPILE_SCHEMA_EXECUTABLE OUTPUT_STRIP_TRAILING_WHITESPACE)
+# conan 配方已注入 COMPILE_SCHEMA_EXECUTABLE（glib 包 bin/glib-compile-schemas
+# 绝对路径）——pkg-config 查询在 OHOS conan 环境下不可靠（PKG_CONFIG_PATH
+# 指向 glib 原始 .pc 的 prefix=/ 返回 //bin/ 错误路径；generators .pc 缺该
+# 变量返回空），仅当变量未注入时才回退 pkg-config 查询。
+if(NOT DEFINED COMPILE_SCHEMA_EXECUTABLE)
+  execute_process(COMMAND ${PKG_CONFIG_EXECUTABLE} gio-2.0 --variable glib_compile_schemas OUTPUT_VARIABLE COMPILE_SCHEMA_EXECUTABLE OUTPUT_STRIP_TRAILING_WHITESPACE)
+endif()
 
 add_custom_command(
     OUTPUT "gschemas.compiled"
