diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4d2c1f0..1179df7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -24,11 +24,14 @@ include_directories(${OPENSSL_INCLUDE_DIR})
 pkg_check_modules(GIO REQUIRED gio-unix-2.0)
 pkg_check_modules(AI_COMMON REQUIRED kysdk-ai-common)
 
-find_package(jsoncpp REQUIRED)
+find_package(JsonCpp CONFIG REQUIRED)
 
 kylin_ai_generate_gdbus_proto_code(COMMON_PROTO_FILES gennlpservice)
 include_directories(${GIO_INCLUDE_DIRS})
 pkg_check_modules(JSON REQUIRED json-glib-1.0)
+# pkg_check_modules 的 -L 库搜索路径不随 GIO_LIBRARIES/JSON_LIBRARIES 传入链接器
+# （OHOS 下 lld 按 -L 直查），必须显式 link_directories（同 libkysdk-ai-private 0001）
+link_directories(${GIO_LIBRARY_DIRS} ${JSON_LIBRARY_DIRS})
 include_directories(${GIO_INCLUDE_DIRS} ${OPENSSL_INCLUDE_DIR} ${JSON_INCLUDE_DIRS} ${AI_COMMON_INCLUDE_DIRS})
 include_directories(include/kylin-ai/genai/text)
 include_directories(include/kylin-ai)
@@ -65,9 +68,15 @@ endif ()
 
 set_target_properties(kysdk-genai-nlp PROPERTIES VERSION 1.0.0 SOVERSION 1)
 
+# CMake lacks a HarmonyOS platform module, so CMAKE_SHARED_LIBRARY_SONAME_FLAG
+# is empty and VERSION/SOVERSION produce no -Wl,-soname (and no versioned
+# symlinks). Inject the soname explicitly; it matches the installed filename
+# libkysdk-genai-nlp.so.
+target_link_options(kysdk-genai-nlp PRIVATE "-Wl,-soname,libkysdk-genai-nlp.so")
+
 target_link_libraries(
     kysdk-genai-nlp
-    jsoncpp
+    JsonCpp::JsonCpp
     ${GIO_LIBRARIES}
     ${JSON_LIBRARIES}
     ${OPENSSL_LIBRARIES}
@@ -81,4 +90,4 @@ install(TARGETS kysdk-genai-nlp
 install(DIRECTORY include/kylin-ai
     DESTINATION include)
 
-install(DIRECTORY usr/ DESTINATION /usr)
+install(DIRECTORY usr/ DESTINATION .)
