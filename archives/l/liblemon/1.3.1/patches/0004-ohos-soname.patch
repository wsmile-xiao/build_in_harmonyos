--- a/lemon/CMakeLists.txt
+++ b/lemon/CMakeLists.txt
@@ -63,3 +63,11 @@
-IF(UNIX)
-  SET_TARGET_PROPERTIES(lemon PROPERTIES OUTPUT_NAME emon VERSION ${LEMON_VERSION} SOVERSION ${LEMON_VERSION})
-ENDIF()
+IF(CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+  SET(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,-soname,liblemon.so" CACHE STRING "" FORCE)
+  SET(CMAKE_SHARED_LINKER_FLAGS_RELEASE "${CMAKE_SHARED_LINKER_FLAGS_RELEASE} -Wl,-soname,liblemon.so" CACHE STRING "" FORCE)
+  SET_TARGET_PROPERTIES(lemon PROPERTIES OUTPUT_NAME lemon LINK_FLAGS "-Wl,-soname,liblemon.so" VERSION ${LEMON_VERSION} SOVERSION ${LEMON_VERSION})
+  IF(COMMAND target_link_options)
+    target_link_options(lemon PRIVATE "-Wl,-soname,liblemon.so")
+  ENDIF()
+  TARGET_LINK_LIBRARIES(lemon "-Wl,-soname,liblemon.so")
+ELSEIF(UNIX)
+  SET_TARGET_PROPERTIES(lemon PROPERTIES OUTPUT_NAME emon VERSION ${LEMON_VERSION} SOVERSION ${LEMON_VERSION})
+ENDIF()
