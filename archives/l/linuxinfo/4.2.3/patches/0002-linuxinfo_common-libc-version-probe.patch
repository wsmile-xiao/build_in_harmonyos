--- a/linuxinfo_common.c
+++ b/linuxinfo_common.c
@@ -59,13 +59,17 @@
 
 /* Really neat hack to detect all libraries known on Linux */
 #ifndef system_unknown
-asm (".weak gnu_get_libc_version");
-asm (".weak __libc_version");
-asm (".weak __linux_C_lib_version");
-
-extern char *gnu_get_libc_version (void);
-extern char *__linux_C_lib_version;
-extern char __libc_version [];
+/* Weakness must be expressed with __attribute__((weak)), not with
+   asm(".weak sym"): clang does not treat the asm form as weakness for
+   constant folding, so `if (gnu_get_libc_version != 0)` gets folded to
+   "always true" and turned into an unconditional call through the PLT.
+   On a C library that does not provide these glibc symbols the PLT slot
+   resolves to 0 and the call faults.  A real weak declaration makes the
+   compiler keep the runtime null test, which is what this probe needs.
+   On glibc all three symbols resolve, so behaviour is unchanged. */
+extern char *gnu_get_libc_version (void) __attribute__((weak));
+extern char *__linux_C_lib_version __attribute__((weak));
+extern char __libc_version [] __attribute__((weak));
 #endif /* only define if on a Linux system :o) */
 
 void GetSystemLibcInfo(struct lib_stat *lib)
@@ -85,8 +89,19 @@
         {
 		ptr = __libc_version;
         }
-        else
+        else if (&__linux_C_lib_version != 0)
         	ptr = __linux_C_lib_version;
+        else
+        	ptr = NULL;
+
+        /* None of the glibc C-library version symbols resolved: they are
+           declared .weak above, so on a C library that does not provide
+           them (e.g. musl) all three addresses are 0.  Reading or walking
+           such a pointer would crash, so keep the "Unknown" default. */
+        if (ptr == NULL || *ptr == '\0')
+        {
+        	return;
+        }
 
         while (!isdigit (*ptr))
 	        ptr++;
