--- a/linuxinfo_common.c
+++ b/linuxinfo_common.c
@@ -152,6 +152,16 @@
 	*(p-1) = '\0', p++; 
 	while (isspace(*p)) p++;
 	strcpy(second_string, p);
+	/* The function is declared int and every caller uses the value as the
+	   "this line had a key:value split" boolean.  Upstream fell off the end
+	   here: on glibc the tail-called strcpy() left a non-null pointer in the
+	   return register so it happened to work, but at -O2/-O3 clang is free to
+	   exploit the missing return and callers then see 0, which makes
+	   GetHardwareInfo() and getphysicalmemory() silently parse nothing.  On
+	   the OHOS aarch64 toolchain the -O3 build degraded the whole CPU line to
+	   "Unknown Unknown processors, ? total bogomips, 0M RAM" while the -O0
+	   build was correct.  State the success value explicitly. */
+	return 1;
 }
 
 LONGLONG getphysicalmemory(void)
