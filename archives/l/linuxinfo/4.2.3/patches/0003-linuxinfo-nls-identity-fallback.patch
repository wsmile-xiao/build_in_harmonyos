--- a/linuxinfo.c
+++ b/linuxinfo.c
@@ -45,7 +45,28 @@
 #include <unistd.h>
 #include <fcntl.h>
 #include <string.h>
+#include <locale.h>
+#ifdef ENABLE_NLS
 #include <libintl.h>
+#else  /* !ENABLE_NLS */
+/* setlocale()/LC_ALL/LC_NUMERIC need <locale.h>; upstream only saw them
+   through glibc's transitive includes.  configure was run with
+   --disable-nls, so gettext.m4 did not AC_DEFINE ENABLE_NLS, yet the
+   sources still call gettext()/ngettext()/bindtextdomain()/textdomain()
+   directly.  This C library provides no gettext runtime at all -- its
+   <libintl.h> is a declaration-free stub -- so those calls would be
+   implicit int-returning declarations, which the OHOS clang rejects
+   outright (-Wint-conversion is an error) and which would in any case
+   hand an int to printf() where a char* is expected.  Fall back to the
+   identity translations GNU gettext documents for --disable-nls builds;
+   behaviour is byte-identical to an upstream --disable-nls build. */
+#define gettext(String) (String)
+#define ngettext(Singular, Plural, N) ((N) == 1 ? (Singular) : (Plural))
+#define dgettext(Domain, String) (String)
+#define dcgettext(Domain, String, Category) (String)
+#define bindtextdomain(Domain, Directory) (Domain)
+#define textdomain(Domain) (Domain)
+#endif /* ENABLE_NLS */
 #define _(String) gettext (String)
 #define __(String) String
 
--- a/linuxinfo_common.c
+++ b/linuxinfo_common.c
@@ -29,7 +29,14 @@
 #include <ctype.h>
 #include <sys/types.h>
 #include <unistd.h>
+#ifdef ENABLE_NLS
 #include <libintl.h>
+#else  /* !ENABLE_NLS */
+/* See the identical note in linuxinfo.c: with --disable-nls there is no
+   ENABLE_NLS and no gettext runtime in this C library, so _() needs the
+   documented identity fallback instead of an implicit declaration. */
+#define gettext(String) (String)
+#endif /* ENABLE_NLS */
 #define _(String) gettext (String)
 
 #include "linuxinfo.h"
