\ No newline at end of file
+}
+
+#if !defined(__GLIBC__)
+#define ONEXIT_MAX	8
+
+struct onexit_entry {
+	void (*function) (int, void *);
+	void *arg;
+};
+
+static struct onexit_entry onexit_entry[ONEXIT_MAX];
+static int onexit_entry_count;
+
+static void onexit_run(void)
+{
+	int i;
+
+	for (i = onexit_entry_count - 1; i >= 0; i--)
+		onexit_entry[i].function(0, onexit_entry[i].arg);
+}
+
+/* Compat replacement for glibc's on_exit(3); see the declaration in utils.h
+ * for the single behavioural difference (the status argument is always 0).
+ */
+int on_exit(void (*function) (int, void *), void *arg)
+{
+	if (!function || onexit_entry_count >= ONEXIT_MAX)
+		return -1;
+
+	onexit_entry[onexit_entry_count].function = function;
+	onexit_entry[onexit_entry_count].arg = arg;
+
+	if (onexit_entry_count == 0 && atexit(onexit_run) != 0)
+		return -1;
+
+	onexit_entry_count++;
+	return 0;
+}
+#endif
