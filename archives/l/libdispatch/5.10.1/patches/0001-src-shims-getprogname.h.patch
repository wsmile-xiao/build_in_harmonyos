diff -ruN a/src/shims/getprogname.h b/src/shims/getprogname.h
--- a/src/shims/getprogname.h
+++ b/src/shims/getprogname.h
@@ -21,31 +21,37 @@
 
 #include <errno.h>
 
 #ifndef __DISPATCH_SHIMS_GETPROGNAME__
 #define __DISPATCH_SHIMS_GETPROGNAME__
 
 #if !HAVE_GETPROGNAME
 
 #ifdef __ANDROID__
 extern const char *__progname;
-#endif /* __ANDROID */
+#endif /* __ANDROID__ */
+
+#ifdef __OHOS__ /* OpenHarmony: __progname is available in musl libc */
+extern const char *__progname;
+#endif /* __OHOS__ */
 
 #if defined(_WIN32)
 const char *getprogname(void);
 #else
 
 static inline char *
 getprogname(void)
 {
 # if HAVE_DECL_PROGRAM_INVOCATION_SHORT_NAME
 	return program_invocation_short_name;
 # elif defined(__ANDROID__)
 	return __progname;
+# elif defined(__OHOS__)
+	return (char *)__progname;
 # else
 #   error getprogname(3) is not available on this platform
 # endif
 }
 #endif /* _WIN32 */
 #endif /* HAVE_GETPROGNAME */
 
 #endif /* __DISPATCH_SHIMS_GETPROGNAME__ */
