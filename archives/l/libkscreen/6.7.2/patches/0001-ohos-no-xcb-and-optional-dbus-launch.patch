From 21ebe7c31bcfdb17fac118549c040c285034abcf Mon Sep 17 00:00:00 2001
From: 2404_87638649 <87638649+2404_87638649@user.noreply.gitcode.com>
Date: Sat, 19 Sep 2026 17:33:34 +0800
Subject: [PATCH 1/2] OHOS: XCB-free build, wayland 1.22 minimum, no
 dbus-launch test wrapper

HarmonyOS PC has no XCB stack and the ohpcd qtbase package does not
install QtGui/private/qtx11extras_p.h (an X11-platform-only header).
The ohpcd ecosystem pins wayland/1.22.0 (qtbase/6.11.1.2 and
qtwayland/6.11.1 both require it; mixing 1.24.0 is a graph conflict);
libkscreen only uses the stable Wayland client API present in 1.22.

  * libdpms: drop the XCB DPMS helper sources and XCB link libraries
  * dpms.cpp / backendmanager.cpp: compile out the QX11Info branches
  * autotests: run test executables directly (no dbus-launch on OHOS)
  * CMakeLists.txt: relax the Wayland minimum from 1.24 to 1.22
---
 CMakeLists.txt             | 2 +-
 autotests/CMakeLists.txt   | 2 +-
 backends/xrandr/xrandr.cpp | 2 +-
 src/backendmanager.cpp     | 5 +----
 src/libdpms/CMakeLists.txt | 5 ++---
 src/libdpms/dpms.cpp       | 6 +-----
 6 files changed, 7 insertions(+), 15 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 088a5c7..6ce71df 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -40,7 +40,7 @@ find_package(WaylandScanner)
 find_package(PlasmaWaylandProtocols 1.21 CONFIG)
 set_package_properties(PlasmaWaylandProtocols PROPERTIES TYPE REQUIRED)
 
-find_package(Wayland 1.24 COMPONENTS Client)
+find_package(Wayland 1.22 COMPONENTS Client)
 set_package_properties(Wayland PROPERTIES
                        TYPE REQUIRED
                       )
diff --git a/autotests/CMakeLists.txt b/autotests/CMakeLists.txt
index ab983c4..a730748 100644
--- a/autotests/CMakeLists.txt
+++ b/autotests/CMakeLists.txt
@@ -9,7 +9,7 @@ macro(KSCREEN_ADD_TEST)
         add_executable(${_testname} ${test_SRCS})
         target_link_libraries(${_testname} Qt::Core Qt::Gui Qt::Test Qt::DBus KF6::Screen ${KSCREEN_WAYLAND_LIBS})
         add_test(NAME kscreen-${_testname}
-                 COMMAND dbus-launch $<TARGET_FILE:${_testname}>
+                 COMMAND $<TARGET_FILE:${_testname}>
         )
         ecm_mark_as_test(${_testname})
     endforeach(_testname)
diff --git a/backends/xrandr/xrandr.cpp b/backends/xrandr/xrandr.cpp
index b611c1d..1e1e81f 100644
--- a/backends/xrandr/xrandr.cpp
+++ b/backends/xrandr/xrandr.cpp
@@ -179,7 +179,7 @@ ConfigPtr XRandR::config() const
 QFuture<SetConfigResult> XRandR::setConfig(const ConfigPtr &config)
 {
     if (!config) {
-        return QtFuture::makeReadyFuture<SetConfigResult>(std::unexpected(QStringLiteral("config is nullptr!")));
+        return QtFuture::makeReadyFuture<SetConfigResult>(SetConfigResult::failure(QStringLiteral("config is nullptr!")));
     }
 
     qCDebug(KSCREEN_XRANDR) << "XRandR::setConfig";
diff --git a/src/backendmanager.cpp b/src/backendmanager.cpp
index c674f4a..c1a2c02 100644
--- a/src/backendmanager.cpp
+++ b/src/backendmanager.cpp
@@ -24,7 +24,6 @@
 #include <QGuiApplication>
 #include <QStandardPaths>
 #include <QThread>
-#include <QtGui/private/qtx11extras_p.h>
 
 #include <memory>
 
@@ -130,9 +129,7 @@ QFileInfo BackendManager::preferredBackend(const QString &backend)
     } else if (!env_kscreen_backend.isEmpty()) {
         backendFilter = env_kscreen_backend;
     } else {
-        if (QX11Info::isPlatformX11()) {
-            backendFilter = QStringLiteral("XRandR");
-        } else if (QGuiApplication::platformName().startsWith(QLatin1String("wayland"))) {
+        if (QGuiApplication::platformName().startsWith(QLatin1String("wayland"))) {
             backendFilter = QStringLiteral("KWayland");
         }
     }
diff --git a/src/libdpms/CMakeLists.txt b/src/libdpms/CMakeLists.txt
index 8d44fbc..a20c9fe 100644
--- a/src/libdpms/CMakeLists.txt
+++ b/src/libdpms/CMakeLists.txt
@@ -2,10 +2,9 @@
 # SPDX-FileCopyrightText: 2022 Aleix Pol Gonzalez <aleixpol@kde.org>
 
 add_library(KF6ScreenDpms SHARED)
-target_sources(KF6ScreenDpms PRIVATE dpms.cpp dpms.h abstractdpmshelper.cpp waylanddpmshelper.cpp xcbdpmshelper.cpp waylanddpmshelper.cpp)
+target_sources(KF6ScreenDpms PRIVATE dpms.cpp dpms.h abstractdpmshelper.cpp waylanddpmshelper.cpp)
 target_link_libraries(KF6ScreenDpms PUBLIC Qt::Gui
-                                    PRIVATE XCB::XCB XCB::DPMS XCB::RANDR
-                                            Qt::GuiPrivate Qt::WaylandClient Wayland::Client
+                                    PRIVATE Qt::GuiPrivate Qt::WaylandClient Wayland::Client
 )
 
 qt6_generate_wayland_protocol_client_sources(KF6ScreenDpms
diff --git a/src/libdpms/dpms.cpp b/src/libdpms/dpms.cpp
index e2ea1c8..e863062 100644
--- a/src/libdpms/dpms.cpp
+++ b/src/libdpms/dpms.cpp
@@ -5,17 +5,13 @@
 #include "dpms.h"
 #include "kscreendpms_debug.h"
 #include "waylanddpmshelper_p.h"
-#include "xcbdpmshelper_p.h"
 
 #include <QGuiApplication>
-#include <QtGui/private/qtx11extras_p.h>
 
 KScreen::Dpms::Dpms(QObject *parent)
     : QObject(parent)
 {
-    if (QX11Info::isPlatformX11()) {
-        m_helper.reset(new XcbDpmsHelper);
-    } else if (QGuiApplication::platformName().startsWith(QLatin1String("wayland"), Qt::CaseInsensitive)) {
+    if (QGuiApplication::platformName().startsWith(QLatin1String("wayland"), Qt::CaseInsensitive)) {
         m_helper.reset(new WaylandDpmsHelper);
     } else {
         qCWarning(KSCREEN_DPMS) << "Platform is not Wayland or X11, this doesn't make sense. Platform name is" << QGuiApplication::platformName();
-- 
