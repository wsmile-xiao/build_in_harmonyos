diff --git a/src/abstractbackend.h b/src/abstractbackend.h
index 37d1149..3f79ad0 100644
--- a/src/abstractbackend.h
+++ b/src/abstractbackend.h
@@ -13,14 +13,27 @@
 #include <QFuture>
 #include <QObject>
 #include <QString>
-#include <expected>
+
+#include <optional>
 
 namespace KScreen
 {
 class Config;
 
 
-typedef std::expected<void, QString> SetConfigResult;
+// OHOS libc++ 15 has no <expected>; a minimal value-or-error stand-in
+// with the same observable semantics for the void/QString case.
+struct SetConfigResult {
+    std::optional<QString> error;
+
+    constexpr bool has_value() const { return !error.has_value(); }
+    static SetConfigResult success() { return SetConfigResult(); }
+    static SetConfigResult failure(const QString &err) {
+        SetConfigResult r;
+        r.error = err;
+        return r;
+    }
+};
 
 /**
  * Abstract class for backends.
