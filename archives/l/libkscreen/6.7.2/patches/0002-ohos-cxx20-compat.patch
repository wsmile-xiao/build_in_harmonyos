 src/config.cpp                            |  2 +-
 src/doctor/doctor.cpp                     | 22 ++++++++++++++--------
 src/doctor/doctor.h                       |  4 ++--
 src/setconfigoperation.cpp                | 19 +++++++++++--------
 8 files changed, 48 insertions(+), 25 deletions(-)

