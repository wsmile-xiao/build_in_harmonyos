--- a/keduvocdocument/CMakeLists.txt
+++ b/keduvocdocument/CMakeLists.txt
@@ -112,27 +112,90 @@
 )
 
 # vHanda: Add library alias?
 ecm_generate_export_header(KEduVocDocument
     BASE_NAME KEduVocDocument
     VERSION ${KEDUVOCDOCUMENT_VERSION}
     DEPRECATED_BASE_VERSION 0
     USE_VERSION_HEADER
 )
 
+# OHOS adaptation (E537): relocatable linkage.
+#
+# The KF6 libraries published on ohpcd ship without a DT_SONAME
+# (libKF6Archive.so / libKF6I18n.so / libKF6CoreAddons.so ... carry no
+# SONAME entry).  Linking the imported KF6::* targets therefore makes the
+# linker record the absolute Conan cache path of the dependency in
+# DT_NEEDED ("/storage/Users/currentUser/.conan2/p/<hash>/p/lib/libKF6Archive.so"),
+# which is machine-private: the installed libKEduVocDocument.so.5 could not
+# be loaded on any machine with a different cache layout.
+#
+# Link the dependencies by basename with -l:<name> plus an explicit -L
+# directory instead, and pull the include directories of those targets in
+# as SYSTEM PRIVATE include dirs (they are no longer contributed through the
+# link interface).  The KF6 targets that KF6::KIOCore pulls in transitively
+# (CoreAddons for KJob/KAutoSaveFile, ConfigCore, Service, Crash) are listed
+# explicitly because the headers and symbols they provide are used by this
+# library.  Qt6::Xml keeps its own SONAME and stays an imported target.
+# (kpackage 6.26.0 / baloo 6.28.0 precedent.)
+set(_keduvoc_kf6_basename_libs)
+set(_keduvoc_kf6_lib_dirs)
+set(_keduvoc_kf6_inc_dirs)
+foreach(_keduvoc_kf6dep
+    KF6::I18n KF6::KIOCore KF6::Archive
+    KF6::CoreAddons KF6::ConfigCore KF6::Service KF6::Crash
+)
+  if(TARGET ${_keduvoc_kf6dep})
+    # IMPORTED_LOCATION is only set per configuration by the KF6 packages.
+    set(_keduvoc_dep_loc "")
+    get_target_property(_keduvoc_dep_loc ${_keduvoc_kf6dep} IMPORTED_LOCATION)
+    if(NOT _keduvoc_dep_loc)
+      string(TOUPPER "${CMAKE_BUILD_TYPE}" _keduvoc_build_cfg)
+      if(_keduvoc_build_cfg)
+        get_target_property(_keduvoc_dep_loc ${_keduvoc_kf6dep} IMPORTED_LOCATION_${_keduvoc_build_cfg})
+      endif()
+    endif()
+    if(NOT _keduvoc_dep_loc)
+      foreach(_keduvoc_cfg RELEASE RELWITHDEBINFO MINSIZEREL DEBUG)
+        get_target_property(_keduvoc_dep_loc ${_keduvoc_kf6dep} IMPORTED_LOCATION_${_keduvoc_cfg})
+        if(_keduvoc_dep_loc)
+          break()
+        endif()
+      endforeach()
+    endif()
+    if(_keduvoc_dep_loc AND NOT _keduvoc_dep_loc STREQUAL "")
+      get_filename_component(_keduvoc_dep_dir "${_keduvoc_dep_loc}" DIRECTORY)
+      get_filename_component(_keduvoc_dep_name "${_keduvoc_dep_loc}" NAME)
+      list(APPEND _keduvoc_kf6_lib_dirs "${_keduvoc_dep_dir}")
+      list(APPEND _keduvoc_kf6_basename_libs "-l:${_keduvoc_dep_name}")
+    endif()
+    get_target_property(_keduvoc_dep_inc ${_keduvoc_kf6dep} INTERFACE_INCLUDE_DIRECTORIES)
+    if(_keduvoc_dep_inc)
+      list(APPEND _keduvoc_kf6_inc_dirs ${_keduvoc_dep_inc})
+    endif()
+  endif()
+endforeach()
+if(_keduvoc_kf6_lib_dirs)
+  list(REMOVE_DUPLICATES _keduvoc_kf6_lib_dirs)
+endif()
+if(_keduvoc_kf6_inc_dirs)
+  list(REMOVE_DUPLICATES _keduvoc_kf6_inc_dirs)
+endif()
+
+target_link_directories(KEduVocDocument PRIVATE ${_keduvoc_kf6_lib_dirs})
+target_include_directories(KEduVocDocument SYSTEM PRIVATE ${_keduvoc_kf6_inc_dirs})
+
 target_link_libraries(KEduVocDocument
   PUBLIC
     Qt6::Xml
   PRIVATE
-    KF6::I18n
-    KF6::KIOCore
-    KF6::Archive
+    ${_keduvoc_kf6_basename_libs}
 )
 
 
 target_include_directories(KEduVocDocument INTERFACE "$<INSTALL_INTERFACE:${KDE_INSTALL_INCLUDEDIR}/libkeduvocdocument>")
 
 
 #Library for non-api unittests
 add_library(keduvocdocument_static STATIC ${keduvocdocument_LIB_SRCS})
 set_target_properties(keduvocdocument_static PROPERTIES COMPILE_FLAGS -DKEDUVOCDOCUMENT_STATIC_DEFINE)
 
