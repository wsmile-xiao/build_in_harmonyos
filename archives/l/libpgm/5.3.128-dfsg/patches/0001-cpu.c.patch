+#if defined(__i386__) || defined(__x86_64__)
 #ifndef _MSC_VER
 static
 void
 __cpuidex (int cpu_info[4], int function_id, int subfunction_id) {
   __asm__ volatile (
     "mov %%ebx, %%edi\n"
     "cpuid\n"
     "xchg %%edi, %%ebx\n"
     : "=a"(cpu_info[0]), "=D"(cpu_info[1]), "=c"(cpu_info[2]), "=d"(cpu_info[3])
