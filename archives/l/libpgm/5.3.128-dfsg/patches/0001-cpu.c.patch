@@ -52,21 +53,20 @@
 uint64_t
 _xgetbv(uint32_t xcr) {
   uint32_t eax, edx;
   __asm__ volatile (
     "xgetbv" : "=a"(eax), "=d"(edx) : "c"(xcr));
   return (((uint64_t)(edx)) << 32) | eax;
 }
 #endif
 
 
