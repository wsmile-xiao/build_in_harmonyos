--- /dev/null
+++ b/test-error.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static inline void
+test_error(int status, int errnum, const char *format, ...)
+{
+    va_list arguments;
+
+    va_start(arguments, format);
+    vfprintf(stderr, format, arguments);
+    va_end(arguments);
+    if (errnum != 0)
+        fprintf(stderr, ": %s", strerror(errnum));
+    fputc('\n', stderr);
+    if (status != 0)
+        exit(status);
+}
+
+#define error test_error
