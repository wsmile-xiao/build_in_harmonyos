diff --git a/ohos_compat.h b/ohos_compat.h
new file mode 100644
index 0000000..741d36b
--- /dev/null
+++ b/ohos_compat.h
@@ -0,0 +1,53 @@
+#ifndef OHOS_COMPAT_H
+#define OHOS_COMPAT_H
+
+/*
+ * OHOS (HarmonyOS PC, musl libc + generated kernel uapi headers)
+ * compatibility shims for l2tpns.
+ *
+ * Force-included as the very first header on OHOS builds via
+ * `EXTRA_CFLAGS=-include ohos_compat.h` (see the recipe build()), so every
+ * translation unit gets a consistent view regardless of include order.
+ *
+ * The OHOS SDK sysroot ships sanitized linux/* uapi headers whose include
+ * guards do not cooperate with musl's sys/* and netinet/* headers: several
+ * types are defined twice under different guards. Pre-define the uapi guard
+ * macros so the duplicated blocks are skipped, and supply the few
+ * identifiers that other uapi headers expect the skipped blocks to provide.
+ * Same root cause and fix family as the batctl OHOS port (knowledge E119).
+ */
+
+/*
+ * linux/socket.h redefines sockaddr_storage (and would define
+ * __kernel_sa_family_t) already provided by musl's sys/socket.h, which
+ * l2tpns includes. Skip the uapi copy; the netlink/rtnetlink/pppox/l2tp
+ * uapi headers reference __kernel_sa_family_t, so provide that typedef
+ * ourselves (identical duplicate typedefs are legal under C11, which is
+ * the OHOS clang default).
+ */
+#define _UAPI_LINUX_SOCKET_H
+typedef unsigned short __kernel_sa_family_t;
+
+/*
+ * linux/sysinfo.h redefines struct sysinfo from musl's sys/sysinfo.h
+ * (pulled in via linux/kernel.h <- linux/netlink.h). Skip the uapi copy;
+ * l2tpns uses the musl sysinfo(2) wrapper only.
+ */
+#define _LINUX_SYSINFO_H
+
+/*
+ * linux/if_ether.h redefines struct ethhdr from netinet/if_ether.h. Keep
+ * the header's ETH_P_* macros but drop the duplicated struct through the
+ * sanitized headers' own libc-compat switch.
+ */
+#define __UAPI_DEF_ETHHDR 0
+
+/*
+ * The uapi ppp/pppox headers use the kernel-internal __packed qualifier
+ * without ever defining it; provide it before the first uapi include.
+ */
+#ifndef __packed
+#define __packed __attribute__((packed))
+#endif
+
+#endif /* OHOS_COMPAT_H */
