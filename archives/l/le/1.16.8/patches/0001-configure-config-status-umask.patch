Create the config.status scratch directory with umask 022
autoconf's generated config.status builds its scratch directory with
umask 077.  HMDFS forces the setgid bit on new directories and the
resulting 02700 directory makes the helper files inside it
(./confXXXXXX/subs1.awk) unusable, so configure aborted with
"config.status: error: could not setup config files machinery".
Using umask 022 keeps the directory writable/executable by its owner.
--- a/configure
+++ b/configure
@@ -27948,22 +27948,22 @@
   : "${ac_tmp:=$tmp}"
   { test ! -d "$ac_tmp" || rm -fr "$ac_tmp"; } && exit $exit_status
 ' 0
   trap 'as_fn_exit 1' 1 2 13 15
 }
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 022 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
 # Set up the scripts for CONFIG_FILES section.
 # No need to generate them if there are no CONFIG_FILES.
 # This happens for instance with `./config.status config.h'.
 if test -n "$CONFIG_FILES"; then
 
