Spell the typeof extension with its reserved name
signals.cc derives the signal-handler type with the GNU typeof keyword.
clang compiles this project with strict -std=c++17 (the OHOS profile's
cppstd), where only the reserved spelling __typeof__ is available, so the
build failed with "use of undeclared identifier 'typeof'".  Using
__typeof__ keeps the exact upstream semantics and also builds under
compilers that only expose the reserved form.
--- a/src/signals.cc
+++ b/src/signals.cc
@@ -41,9 +41,9 @@
 static struct sigaction  OldSIGQUIT;
 static struct sigaction  OldSIGTSTP;
 
 #ifdef __GNUC__
-#define  SA_HANDLER_TYPE   typeof(OldSIGHUP.sa_handler)
+#define  SA_HANDLER_TYPE   __typeof__(OldSIGHUP.sa_handler)
 #else
 #define  SA_HANDLER_TYPE   void(*)(int)
 #endif
 #ifndef SA_RESTART
