diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5e73189..e4167f4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -59,8 +59,17 @@ if (${CMAKE_SYSTEM_NAME} MATCHES "Linux")
 list(APPEND fli_LIB_SRCS unix/linux/libfli-parport.c)
 endif()

-#build a shared library
-ADD_LIBRARY(fli SHARED ${fli_LIB_SRCS})
+# Honour the standard BUILD_SHARED_LIBS switch instead of hardcoding SHARED, so
+# that a downstream packager (e.g. Conan) can request a static build. When
+# BUILD_SHARED_LIBS is not defined at all the historical shared-only behaviour
+# is preserved, so plain upstream builds are unaffected.
+if(BUILD_SHARED_LIBS)
+  ADD_LIBRARY(fli SHARED ${fli_LIB_SRCS})
+elseif(DEFINED BUILD_SHARED_LIBS)
+  ADD_LIBRARY(fli STATIC ${fli_LIB_SRCS})
+else()
+  ADD_LIBRARY(fli SHARED ${fli_LIB_SRCS})
+endif()

 set_target_properties(fli PROPERTIES VERSION 2.0 SOVERSION 2)

