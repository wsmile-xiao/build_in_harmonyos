@@ -319,14 +319,23 @@
 
 
 begin_test 'FIFO is skipped, even with -f'
-mkfifo foo
-mkfifo foo.gz
-assert_skipped gzip foo
-assert_skipped gzip -f foo
-#assert_skipped gzip -c foo # XXX: works with GNU gzip, not libdeflate's
-assert_skipped gunzip foo.gz
-assert_skipped gunzip -f foo.gz
-#assert_skipped gunzip -c foo.gz # XXX: works with GNU gzip, not libdeflate's
+
+if ! command -v mkfifo >/dev/null 2>&1; then
+	echo 'mkfifo command is unavailable; skipping FIFO assertions'
+elif mkfifo foo 2> mkfifo.err && mkfifo foo.gz 2>> mkfifo.err; then
+	assert_skipped gzip foo
+	assert_skipped gzip -f foo
+	#assert_skipped gzip -c foo # XXX: works with GNU gzip, not libdeflate's
+	assert_skipped gunzip foo.gz
+	assert_skipped gunzip -f foo.gz
+	#assert_skipped gunzip -c foo.gz # XXX: works with GNU gzip, not libdeflate's
+elif grep -q 'Operation not permitted' mkfifo.err; then
+	echo 'mkfifo(2) is unavailable; skipping FIFO assertions'
+else
+	cat mkfifo.err >&2
+	exit 1
+fi
+rm -f mkfifo.err
 
 
