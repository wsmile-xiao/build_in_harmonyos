// embed_script.lat — exercised through the public embedding API by
// latino_embed_test.c (latC_crear_mv -> latA_analizar_arch ->
// latC_analizar -> latC_llamar_funcion), the same chain the CLI uses.
//
// Kept deliberately small, deterministic and bounded on purpose:
// one small function, one bounded loop, no recursion.

nombre = "latino"
version = 1 + 1 + 0 + 4 / 2
poner(nombre .. " " .. version)

si (version >= 2)
    poner("si_ok")
sino
    poner("si_fail")
fin

funcion sumar_hasta(n)
    total = 0
    i = 1
    mientras (i <= n)
        total = total + i
        i = i + 1
    fin
    retorno total
fin

poner(sumar_hasta(10))

lst = [1, 2, 3]
lista.agregar(lst, 4)
poner(lista.longitud(lst))

d = {"clave": "valor"}
poner(d.clave)
