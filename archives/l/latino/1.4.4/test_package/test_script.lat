// test_script.lat — consumer test for the packaged `latino` CLI.
// Exercises: variables, arithmetic, strings, lists, dictionaries,
// functions, control flow (si/sino, mientras, elegir),
// list/dic standard libraries, and string formatting.
//
// NOTE: avoids two upstream VM bugs observed on real OHOS hardware with
// v1.4.4 (out of adaptation scope, reproduced with upstream's own
// ejemplos/11-fibonacci.lat):
//   1. binary recursion in one expression (f(n-1)+f(n-2)) never returns;
//   2. one previously observed `desde` loop/function-call pattern can hang the VM; this is not universal.
// Sequential calls and iterative loops are correct (verified locally).

funcion fibo_iter(n)
    si (n < 2)
        retorno n
    sino
        prevPrev = 0
        prev = 1
        res = 0
        i = 2
        mientras (i <= n)
            res = prev + prevPrev
            prevPrev = prev
            prev = res
            i = i + 1
        fin
        retorno res
    fin
fin

// recursive but single-call-per-expression works fine
funcion sumatoria(n)
    si (n <= 0)
        retorno 0
    fin
    retorno n + sumatoria(n-1)
fin

funcion clasificar(x)
    elegir (x)
        caso 1:
            retorno "uno"
        caso 2:
            retorno "dos"
        otro:
            retorno "muchos"
    fin
fin

poner(fibo_iter(10))
poner(sumatoria(100))
poner(clasificar(1))
poner(clasificar(2))
poner(clasificar(7))

cadena = "hola" .. " " .. "latino"
poner(cadena)

e = [1, 2, 3, 4, 5]
suma = 0
desde (i = 0; i < lista.longitud(e); i++)
    suma = suma + e[i]
fin
poner(suma)

d = {"uno": 1, "dos": 2}
poner(d.dos)

poner(lista.longitud(lista.invertir([1, 2, 3])))

imprimirf("%s=%d", "respuesta", 42)
