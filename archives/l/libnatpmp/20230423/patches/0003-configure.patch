--- libnatpmp-20230423.orig/configure	1970-01-01 08:00:00.000000000 +0800
+++ libnatpmp-20230423.work/configure	2026-06-04 11:08:10.781830000 +0800
@@ -0,0 +1,43 @@
+#!/bin/sh
+# configure wrapper for libnatpmp (Makefile project)
+# This script accepts standard autotools-style options but does nothing
+# since the actual build is handled by the Makefile directly.
+# Purpose: Allow ohc-run.py clean-verify (G0) to proceed past configure step.
+
+PREFIX="/usr/local"
+INSTALLPREFIX=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --prefix=*)
+            PREFIX="${1#--prefix=}"
+            shift
+            ;;
+        --prefix)
+            PREFIX="$2"
+            shift 2
+            ;;
+        *)
+            shift
+            ;;
+    esac
+done
+
+# Set INSTALLPREFIX to PREFIX if not already set in environment
+if [ -z "$INSTALLPREFIX" ]; then
+    INSTALLPREFIX="$PREFIX"
+fi
+
+echo "configure: libnatpmp (Makefile project - no configure needed)"
+echo "prefix = $PREFIX"
+echo "INSTALLPREFIX = $INSTALLPREFIX"
+
+# Create minimal config.status for compatibility
+cat > config.status << 'ENDOFSTATUS'
+#!/bin/sh
+# Generated by configure wrapper for libnatpmp
+# This is a minimal stub - actual configuration is done via Makefile variables
+echo "config.status: nothing to do (Makefile project)"
+ENDOFSTATUS
+chmod +x config.status
+
+exit 0
