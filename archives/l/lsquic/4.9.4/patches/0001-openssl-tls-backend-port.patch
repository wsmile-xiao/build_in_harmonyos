+++ b/src/liblsquic/lsquic_ossl_compat.h
@@ -0,0 +1,323 @@
+/*
+ * lsquic_ossl_compat.h - OpenSSL 3.5+ compatibility layer for lsquic.
+ *
+ * lsquic 4.9.4 is written against the BoringSSL push-model QUIC TLS API
+ * (SSL_provide_quic_data / SSL_set_quic_method / SSL_QUIC_METHOD
+ * callbacks / EVP_AEAD family).  OpenSSL 3.5+ implements the IETF QUIC
+ * TLS API instead: a pull-model OSSL_DISPATCH callback table registered
+ * via SSL_set_quic_tls_cbs().
+ *
+ * This header + lsquic_ossl_compat.c translate between the two models:
+ *
+ *   - SSL_provide_quic_data()  -> buffers data in a per-SSL receive
+ *     queue which OpenSSL drains through the crypto_recv_rcd callback.
+ *   - SSL_set_quic_method()    -> registers the OSSL_DISPATCH table;
+ *     OpenSSL then invokes our callbacks, which forward to the
+ *     application's SSL_QUIC_METHOD (set_read_secret / set_write_secret
+ *     / add_handshake_data / flush_flight / send_alert).
+ *   - Transport parameters go through SSL_set_quic_tls_transport_params
+ *     (send) and the got_transport_params callback (receive).
+ *   - The EVP_AEAD family is re-implemented on top of OpenSSL's
+ *     EVP_CIPHER (AES-128/256-GCM, ChaCha20-Poly1305).
+ *   - CRYPTO_chacha_20() (header protection) is re-implemented on top
+ *     of EVP_chacha20().
+ *
+ * Session tickets are serialized with i2d_SSL_SESSION / d2i_SSL_SESSION,
+ * the same DER encoding BoringSSL's SSL_SESSION_to_bytes produces.
+ *
+ * 0-RTT: the BoringSSL-style 0-RTT client path (SSL_in_early_data /
+ * SSL_reset_early_data_reject / SSL_set_quic_early_data_context) is not
+ * available under the OpenSSL pull model; resumption still works, but
+ * early data is not sent.  The shims below degrade gracefully.
+ *
+ * Only compiled in when HAVE_OPENSSL is defined (see CMakeLists.txt).
+ */
+
+#ifndef LSQUIC_OSSL_COMPAT_H
+#define LSQUIC_OSSL_COMPAT_H
+
+#ifdef HAVE_OPENSSL
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <openssl/ssl.h>
+#include <openssl/evp.h>
+#include <openssl/kdf.h>
+#include <openssl/rand.h>
+#include <openssl/err.h>
+#include <openssl/x509v3.h>
+
+/* BoringSSL sizes its error-string buffers with this constant; OpenSSL
+ * callers pass ERR_error_string(n, buf) with a 256-byte buffer. */
+#ifndef ERR_ERROR_STRING_BUF_LEN
+#define ERR_ERROR_STRING_BUF_LEN 256
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ---------------------------------------------------------------------- */
+/* Encryption levels.                                                     */
+/* BoringSSL defines an enum ssl_encryption_level_t with the values
+ * ssl_encryption_initial/early_data/handshake/application.  lsquic
+ * static-asserts that these match its own ENC_LEV_* values.  OpenSSL's
+ * pull model reports OSSL_RECORD_PROTECTION_LEVEL_* instead. */
+
+enum ssl_encryption_level_t {
+    ssl_encryption_initial     = 0,
+    ssl_encryption_early_data  = 1,
+    ssl_encryption_handshake   = 2,
+    ssl_encryption_application = 3,
+};
+
+/* Map OpenSSL protection level -> BoringSSL-style level (callback path). */
+enum ssl_encryption_level_t
+lsquic_ossl_from_prot_level(uint32_t prot_level);
+
+/* ---------------------------------------------------------------------- */
+/* QUIC method (application callback table) - same shape as BoringSSL.    */
+
+typedef int (*ssl_set_secret_cb)(SSL *ssl, enum ssl_encryption_level_t level,
+            const SSL_CIPHER *cipher, const uint8_t *secret,
+            size_t secret_len);
+typedef int (*ssl_add_handshake_data_cb)(SSL *ssl,
+            enum ssl_encryption_level_t level, const uint8_t *data,
+            size_t len);
+typedef int (*ssl_flush_flight_cb)(SSL *ssl);
+typedef int (*ssl_send_alert_cb)(SSL *ssl, enum ssl_encryption_level_t level,
+            uint8_t alert);
+
+typedef struct ssl_quic_method_st {
+    ssl_set_secret_cb          set_read_secret;
+    ssl_set_secret_cb          set_write_secret;
+    ssl_add_handshake_data_cb  add_handshake_data;
+    ssl_flush_flight_cb        flush_flight;
+    ssl_send_alert_cb          send_alert;
+} SSL_QUIC_METHOD;
+
+int SSL_set_quic_method(SSL *ssl, const SSL_QUIC_METHOD *method);
+
+/* Push interface used by lsquic: queue handshake bytes for the next
+ * crypto_recv_rcd callback. */
+int SSL_provide_quic_data(SSL *ssl, enum ssl_encryption_level_t level,
+            const uint8_t *data, size_t len);
+
+/* ---------------------------------------------------------------------- */
+/* QUIC transport parameters.                                             */
+
+int SSL_set_quic_transport_params(SSL *ssl, const uint8_t *params,
+            size_t params_len);
+void SSL_get_peer_quic_transport_params(const SSL *ssl,
+            const uint8_t **out_params, size_t *out_params_len);
+
+/* BoringSSL knobs without an OpenSSL pull-model equivalent. */
+
+/* draft-27 legacy codepoint selection: only relevant for ID-27, which
+ * lsquic only negotiates when explicitly enabled.  No-op on OpenSSL. */
+static inline void
+SSL_set_quic_use_legacy_codepoint (SSL *ssl, int enable)
+{   (void) ssl; (void) enable;   }
+
+/* 0-RTT early data context (server side anti-replay).  Early data is
+ * not enabled in the OpenSSL port; accept the call so server init
+ * succeeds. */
+static inline int
+SSL_set_quic_early_data_context (SSL *ssl, const uint8_t *ctx,
+            size_t ctx_len)
+{   (void) ssl; (void) ctx; (void) ctx_len; return 1;   }
+
+/* ---------------------------------------------------------------------- */
+/* Session tickets / early data.                                          */
+
+/* BoringSSL: SSL_CTX_set_early_data_enabled().  OpenSSL: the max_early_data
+ * knob controls whether sessions may carry early data.  We keep early
+ * data off (0-RTT not supported in the OpenSSL port), so this is a
+ * no-op that accepts the call. */
+static inline void
+SSL_CTX_set_early_data_enabled (SSL_CTX *ctx, int enabled)
+{   (void) ctx; (void) enabled;   }
+
+/* BoringSSL: session may be used for 0-RTT.  OpenSSL reports the
+ * max_early_data the ticket was issued with; we disabled early data,
+ * so always report "not capable". */
+static inline int
+SSL_SESSION_early_data_capable (const SSL_SESSION *sess)
+{   (void) sess; return 0;   }
+
+/* Client-side early-data state.  We never send early data. */
+#define SSL_in_early_data(ssl)          (0)
+
+/* BoringSSL: after the server rejects early data, reset the SSL object
+ * to continue with a normal 1-RTT handshake.  Since we never send
+ * early data this cannot trigger; keep the symbol for link compat. */
+static inline int
+SSL_reset_early_data_reject (SSL *ssl)
+{   (void) ssl; return 1;   }
+
+/* Post-handshake processing.  In the pull model OpenSSL processes
+ * post-handshake messages during SSL_do_handshake / SSL_read; there is
+ * no separate entry point.  Report success. */
+static inline int
+SSL_process_quic_post_handshake (SSL *ssl)
+{   (void) ssl; return 1;   }
+
+/* BoringSSL reports early-data rejection through SSL_get_error(); since
+ * this port never sends early data the code path cannot trigger.  Use a
+ * sentinel outside OpenSSL's SSL_ERROR_* value range so an unexpected
+ * sighting is loud rather than silently misclassified. */
+#ifndef SSL_ERROR_EARLY_DATA_REJECTED
+#define SSL_ERROR_EARLY_DATA_REJECTED  (-10000)
+#endif
+
+/* ---------------------------------------------------------------------- */
+/* HKDF-Extract (RFC 5869).  BoringSSL exposes it as a standalone function;
+ * OpenSSL only provides the EVP_PKEY_HKDF pkey path. */
+
+#include <openssl/hmac.h>
+
+static inline uint8_t *
+HKDF_extract (uint8_t *out_key, size_t *out_len, const EVP_MD *digest,
+              const uint8_t *secret, size_t secret_len,
+              const uint8_t *salt, size_t salt_len)
+{
+    unsigned int md_len = EVP_MAX_MD_SIZE;
+
+    if (!HMAC(digest, salt, (int) salt_len, secret, secret_len, out_key,
+              &md_len))
+        return NULL;
+    *out_len = md_len;
+    return out_key;
+}
+
+/* BoringSSL's ERR_get_error() returns uint32_t; OpenSSL's returns
+ * unsigned long.  lsquic logs it with %"PRIu32" - cast for printf. */
+#define ERR_get_error()   ((uint32_t) (ERR_get_error) ())
+
+/* HKDF-Expand (RFC 5869), BoringSSL signature.  Implemented in
+ * lsquic_ossl_compat.c via the OpenSSL EVP_PKEY_HKDF pkey interface. */
+int HKDF_expand (uint8_t *out_key, size_t out_len, const EVP_MD *digest,
+                 const uint8_t *prk, size_t prk_len, const uint8_t *info,
+                 size_t info_len);
+
+/* ---------------------------------------------------------------------- */
+/* Session (de)serialization - same DER as BoringSSL.                     */
+
+int SSL_SESSION_to_bytes(const SSL_SESSION *sess, uint8_t **out_bytes,
+            size_t *out_len);
+SSL_SESSION *SSL_SESSION_from_bytes(const uint8_t *in, size_t in_len,
+            const SSL_CTX *ssl_ctx);
+
+/* ---------------------------------------------------------------------- */
+/* Certificate verification (client).                                     */
+
+/* BoringSSL's custom verify API returns ssl_verify_ok / ssl_verify_invalid
+ * and lets the callback run async.  OpenSSL's classic verify callback
+ * returns int and runs synchronously; we adapt by wrapping the app's
+ * callback. */
+enum ssl_verify_result_t {
+    ssl_verify_ok,
+    ssl_verify_invalid,
+    ssl_verify_retry,
+};
+
+typedef enum ssl_verify_result_t (*ssl_custom_verify_func)(SSL *ssl,
+            uint8_t *out_alert);
+
+int SSL_CTX_set_custom_verify(SSL_CTX *ctx, int mode,
+            ssl_custom_verify_func cb);
+
+/* Fatal alert from inside a handshake callback.  The pull-model API has
+ * no direct equivalent; record the alert and fail the callback so the
+ * handshake aborts.  Returns 1 (BoringSSL semantics). */
+int SSL_send_fatal_alert(SSL *ssl, uint8_t alert);
+
+/* ---------------------------------------------------------------------- */
+/* EVP_AEAD family on top of EVP_CIPHER.                                  */
+
+typedef struct evp_aead_st {
+    const EVP_CIPHER *cipher;       /* EVP_aes_128_gcm/256_gcm/chacha20_poly1305 */
+    const EVP_MD     *md;           /* digest bound to the AEAD suite */
+    size_t            key_len;
+    size_t            nonce_len;
+    size_t            tag_len;
+} EVP_AEAD;
+
+const EVP_AEAD *EVP_aead_aes_128_gcm(void);
+const EVP_AEAD *EVP_aead_aes_256_gcm(void);
+const EVP_AEAD *EVP_aead_chacha20_poly1305(void);
+
+size_t EVP_AEAD_key_length(const EVP_AEAD *aead);
+size_t EVP_AEAD_nonce_length(const EVP_AEAD *aead);
+size_t EVP_AEAD_max_overhead(const EVP_AEAD *aead);
+
+enum evp_aead_direction_t {
+    evp_aead_open,
+    evp_aead_seal,
+};
+
+typedef struct evp_aead_ctx_st {
+    const EVP_AEAD  *aead;
+    EVP_CIPHER_CTX  *cipher_ctx;
+    size_t           tag_len;    /* as passed to EVP_AEAD_CTX_init */
+    unsigned char    key_buf[EVP_MAX_KEY_LENGTH];
+    size_t           key_sz;
+    unsigned         inited : 1;
+} EVP_AEAD_CTX;
+
+int EVP_AEAD_CTX_init(EVP_AEAD_CTX *ctx, const EVP_AEAD *aead,
+            const uint8_t *key, size_t key_len, size_t tag_len, ENGINE *impl);
+int EVP_AEAD_CTX_init_with_direction(EVP_AEAD_CTX *ctx, const EVP_AEAD *aead,
+            const uint8_t *key, size_t key_len, size_t tag_len,
+            enum evp_aead_direction_t dir);
+void EVP_AEAD_CTX_cleanup(EVP_AEAD_CTX *ctx);
+
+int EVP_AEAD_CTX_seal(const EVP_AEAD_CTX *ctx, uint8_t *out, size_t *out_len,
+            size_t max_out_len, const uint8_t *nonce, size_t nonce_len,
+            const uint8_t *in, size_t in_len, const uint8_t *ad,
+            size_t ad_len);
+int EVP_AEAD_CTX_open(const EVP_AEAD_CTX *ctx, uint8_t *out, size_t *out_len,
+            size_t max_out_len, const uint8_t *nonce, size_t nonce_len,
+            const uint8_t *in, size_t in_len, const uint8_t *ad,
+            size_t ad_len);
+
+/* ---------------------------------------------------------------------- */
+/* ChaCha20 (header protection).                                          */
+
+void CRYPTO_chacha_20(uint8_t *out, const uint8_t *in, size_t in_len,
+            const uint8_t key[32], const uint8_t nonce[12],
+            uint32_t counter);
+
+/* ---------------------------------------------------------------------- */
+/* Header-protection cipher handle helpers.                               */
+/* lsquic stores two EVP_CIPHER_CTX per header_prot (read/write).  Under
+ * BoringSSL these are embedded by value and initialized with
+ * EVP_CIPHER_CTX_init / EVP_CIPHER_CTX_cleanup.  Under OpenSSL the type
+ * is opaque, so lsquic_ossl_compat uses heap handles (see struct
+ * header_prot in lsquic_enc_sess_ietf.c); these helpers manage them. */
+
+static inline void
+lsquic_hp_ctx_init (EVP_CIPHER_CTX **slot)
+{
+    if (*slot == NULL)
+        *slot = EVP_CIPHER_CTX_new();
+}
+
+static inline void
+lsquic_hp_ctx_cleanup (EVP_CIPHER_CTX **slot)
+{
+    if (*slot != NULL)
+    {
+        EVP_CIPHER_CTX_free(*slot);
+        *slot = NULL;
+    }
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* HAVE_OPENSSL */
+#endif /* LSQUIC_OSSL_COMPAT_H */
--- /dev/null
+++ b/src/liblsquic/lsquic_ossl_compat.c
@@ -0,0 +1,719 @@
+/*
+ * lsquic_ossl_compat.c - OpenSSL 3.5+ compatibility layer for lsquic.
+ * See lsquic_ossl_compat.h for the design overview.
+ *
+ * Reference: ngtcp2 crypto/ossl/ossl.c (the canonical consumer of the
+ * SSL_set_quic_tls_cbs pull-model API).
+ */
+
+#ifdef HAVE_OPENSSL
+
+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <openssl/ssl.h>
+#include <openssl/evp.h>
+#include <openssl/kdf.h>
+#include <openssl/rand.h>
+#include <openssl/x509v3.h>
+#include <openssl/core_dispatch.h>
+
+#include "lsquic_ossl_compat.h"
+
+/* ====================================================================== */
+/* Per-SSL bridge state.                                                  */
+/* ====================================================================== */
+
+/* Receive queue chunk.  OpenSSL pulls a contiguous window at a time
+ * (crypto_recv_rcd), then tells us how much it consumed
+ * (crypto_release_rcd).  A simple growable buffer with a read offset
+ * is sufficient: handshake flights are small (KiB range). */
+struct rcd_queue {
+    unsigned char   *buf;
+    size_t           cap, len, rced;    /* rced = released prefix */
+};
+
+struct ossl_bridge {
+    const SSL_QUIC_METHOD *method;
+    struct rcd_queue       rq;
+    /* Transport parameters received from the peer via the
+     * got_transport_params callback. */
+    unsigned char         *peer_params;
+    size_t                 peer_params_len;
+    /* Level of the most recent secret handed to the application; used as
+     * the protection level for send/alert forwarding because the
+     * pull-model API does not pass it on those callbacks. */
+    enum ssl_encryption_level_t last_w_level;
+    /* Pending fatal alert requested from inside a callback
+     * (SSL_send_fatal_alert). */
+    int                    fatal_alert;
+    uint8_t                alert_code;
+};
+
+static int g_bridge_idx = -1;   /* SSL ex_data index */
+
+static struct ossl_bridge *
+bridge_get (const SSL *ssl)
+{
+    if (g_bridge_idx < 0)
+        return NULL;
+    return SSL_get_ex_data((SSL *) ssl, g_bridge_idx);
+}
+
+static void
+bridge_free (void *parent, void *ptr, CRYPTO_EX_DATA *ad, int idx, long argl,
+             void *argp)
+{
+    struct ossl_bridge *br = ptr;
+    (void) parent; (void) ad; (void) idx; (void) argl; (void) argp;
+    if (br)
+    {
+        free(br->rq.buf);
+        free(br->peer_params);
+        free(br);
+    }
+}
+
+/* Ensure the ex_data class is registered once. */
+static int
+bridge_idx_init (void)
+{
+    if (g_bridge_idx >= 0)
+        return 0;
+    g_bridge_idx = SSL_get_ex_new_index(0, NULL, NULL, NULL, bridge_free);
+    return g_bridge_idx < 0 ? -1 : 0;
+}
+
+/* ====================================================================== */
+/* OSSL_DISPATCH callbacks (pull model -> application push callbacks).    */
+/* ====================================================================== */
+
+enum ssl_encryption_level_t
+lsquic_ossl_from_prot_level (uint32_t prot_level)
+{
+    switch (prot_level)
+    {
+    case OSSL_RECORD_PROTECTION_LEVEL_NONE:
+        return ssl_encryption_initial;
+    case OSSL_RECORD_PROTECTION_LEVEL_EARLY:
+        return ssl_encryption_early_data;
+    case OSSL_RECORD_PROTECTION_LEVEL_HANDSHAKE:
+        return ssl_encryption_handshake;
+    case OSSL_RECORD_PROTECTION_LEVEL_APPLICATION:
+        return ssl_encryption_application;
+    default:
+        assert(0);
+        return ssl_encryption_initial;
+    }
+}
+
+static int
+ossl_crypto_send (SSL *ssl, const unsigned char *buf, size_t buf_len,
+                  size_t *consumed, void *arg)
+{
+    struct ossl_bridge *br = bridge_get(ssl);
+    (void) arg;
+
+    if (!br || !br->method)
+    {
+        *consumed = buf_len;
+        return 1;
+    }
+
+    /* The pull-model API does not pass the protection level on the send
+     * path; use the level of the most recent secret yielded to the
+     * application (tracked in ossl_yield_secret).  This mirrors
+     * BoringSSL's behaviour where add_handshake_data runs at the
+     * current write level. */
+    if (!br->method->add_handshake_data(ssl, br->last_w_level, buf,
+                                        buf_len))
+        return 0;
+    *consumed = buf_len;
+    return 1;
+}
+
+static int
+ossl_crypto_recv_rcd (SSL *ssl, const unsigned char **buf,
+                      size_t *bytes_read, void *arg)
+{
+    struct ossl_bridge *br = bridge_get(ssl);
+    (void) arg;
+
+    if (!br || br->rq.len == br->rq.rced)
+    {
+        *buf = NULL;
+        *bytes_read = 0;
+        return 1;
+    }
+
+    *buf = br->rq.buf + br->rq.rced;
+    *bytes_read = br->rq.len - br->rq.rced;
+    /* The whole window is marked as handed out; release_rcd reports the
+     * amount actually consumed and we rewind for any unconsumed tail. */
+    br->rq.rced = br->rq.len;
+    return 1;
+}
+
+static int
+ossl_crypto_release_rcd (SSL *ssl, size_t released, void *arg)
+{
+    struct ossl_bridge *br = bridge_get(ssl);
+    (void) arg;
+
+    if (!br || 0 == released)
+        return 1;
+
+    assert(released <= br->rq.len);
+
+    /* Keep any unconsumed tail for the next pull. */
+    if (released < br->rq.len)
+        memmove(br->rq.buf, br->rq.buf + released, br->rq.len - released);
+    br->rq.len -= released;
+    br->rq.rced = 0;
+    return 1;
+}
+
+static int
+ossl_yield_secret (SSL *ssl, uint32_t prot_level, int direction,
+                   const unsigned char *secret, size_t secret_len, void *arg)
+{
+    struct ossl_bridge *br = bridge_get(ssl);
+    enum ssl_encryption_level_t level;
+    const SSL_CIPHER *cipher;
+    (void) arg;
+
+    if (!br || !br->method)
+        return 1;
+
+    level = lsquic_ossl_from_prot_level(prot_level);
+    br->last_w_level = level;
+
+    cipher = SSL_get_current_cipher(ssl);
+
+    if (direction)   /* write */
+    {
+        if (br->method->set_write_secret
+                && !br->method->set_write_secret(ssl, level, cipher, secret,
+                                                 secret_len))
+            return 0;
+    }
+    else
+    {
+        if (br->method->set_read_secret
+                && !br->method->set_read_secret(ssl, level, cipher, secret,
+                                                secret_len))
+            return 0;
+    }
+    return 1;
+}
+
+static int
+ossl_got_transport_params (SSL *ssl, const unsigned char *params,
+                           size_t params_len, void *arg)
+{
+    struct ossl_bridge *br = bridge_get(ssl);
+    unsigned char *copy;
+    (void) arg;
+
+    if (!br)
+        return 1;
+
+    copy = malloc(params_len ? params_len : 1);
+    if (!copy)
+        return 0;
+    memcpy(copy, params, params_len);
+    free(br->peer_params);
+    br->peer_params     = copy;
+    br->peer_params_len = params_len;
+    return 1;
+}
+
+static int
+ossl_alert (SSL *ssl, unsigned char alert_code, void *arg)
+{
+    struct ossl_bridge *br = bridge_get(ssl);
+    (void) arg;
+
+    if (!br || !br->method || !br->method->send_alert)
+        return 1;
+
+    return br->method->send_alert(ssl, br->last_w_level, alert_code);
+}
+
+static const OSSL_DISPATCH g_qtdis[] = {
+    { OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_SEND,
+      (void (*)(void)) ossl_crypto_send },
+    { OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_RECV_RCD,
+      (void (*)(void)) ossl_crypto_recv_rcd },
+    { OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_RELEASE_RCD,
+      (void (*)(void)) ossl_crypto_release_rcd },
+    { OSSL_FUNC_SSL_QUIC_TLS_YIELD_SECRET,
+      (void (*)(void)) ossl_yield_secret },
+    { OSSL_FUNC_SSL_QUIC_TLS_GOT_TRANSPORT_PARAMS,
+      (void (*)(void)) ossl_got_transport_params },
+    { OSSL_FUNC_SSL_QUIC_TLS_ALERT,
+      (void (*)(void)) ossl_alert },
+    { 0, NULL },
+};
+
+/* ====================================================================== */
+/* BoringSSL-style entry points.                                          */
+/* ====================================================================== */
+
+int
+SSL_set_quic_method (SSL *ssl, const SSL_QUIC_METHOD *method)
+{
+    struct ossl_bridge *br;
+
+    if (0 != bridge_idx_init())
+        return 0;
+
+    br = bridge_get(ssl);
+    if (!br)
+    {
+        br = calloc(1, sizeof(*br));
+        if (!br)
+            return 0;
+        if (!SSL_set_ex_data(ssl, g_bridge_idx, br))
+        {
+            free(br);
+            return 0;
+        }
+    }
+
+    br->method = method;
+    return SSL_set_quic_tls_cbs(ssl, g_qtdis, NULL);
+}
+
+int
+SSL_provide_quic_data (SSL *ssl, enum ssl_encryption_level_t level,
+                       const uint8_t *data, size_t len)
+{
+    struct ossl_bridge *br = bridge_get(ssl);
+    (void) level;
+
+    if (!br)
+        return 0;
+
+    if (br->rq.len + len > br->rq.cap)
+    {
+        size_t ncap = br->rq.cap ? br->rq.cap : 4096;
+        unsigned char *nbuf;
+        while (ncap < br->rq.len + len)
+            ncap *= 2;
+        nbuf = realloc(br->rq.buf, ncap);
+        if (!nbuf)
+            return 0;
+        br->rq.buf = nbuf;
+        br->rq.cap = ncap;
+    }
+
+    memcpy(br->rq.buf + br->rq.len, data, len);
+    br->rq.len += len;
+    return 1;
+}
+
+int
+SSL_set_quic_transport_params (SSL *ssl, const uint8_t *params,
+                               size_t params_len)
+{
+    return SSL_set_quic_tls_transport_params(ssl, params, params_len);
+}
+
+void
+SSL_get_peer_quic_transport_params (const SSL *ssl, const uint8_t **out_params,
+                                    size_t *out_params_len)
+{
+    struct ossl_bridge *br = bridge_get(ssl);
+
+    if (br && br->peer_params)
+    {
+        *out_params     = br->peer_params;
+        *out_params_len = br->peer_params_len;
+    }
+    else
+    {
+        *out_params     = NULL;
+        *out_params_len = 0;
+    }
+}
+
+int
+SSL_send_fatal_alert (SSL *ssl, uint8_t alert)
+{
+    struct ossl_bridge *br = bridge_get(ssl);
+
+    if (br)
+    {
+        br->fatal_alert = 1;
+        br->alert_code  = alert;
+    }
+    /* Returning "success" here matches BoringSSL semantics (the alert is
+     * queued); the enclosing application callback then returns 0 to fail
+     * the handshake step, and OpenSSL aborts. */
+    return 1;
+}
+
+int
+SSL_SESSION_to_bytes (const SSL_SESSION *sess, uint8_t **out_bytes,
+                      size_t *out_len)
+{
+    unsigned char *buf = NULL, *p;
+    int len;
+
+    len = i2d_SSL_SESSION(sess, &buf);
+    if (len <= 0)
+        return 0;
+
+    /* i2d advances buf; hand out a malloc'd copy that the caller can
+     * OPENSSL_free() exactly like BoringSSL. */
+    p = OPENSSL_malloc(len);
+    if (!p)
+    {
+        OPENSSL_free(buf);
+        return 0;
+    }
+    memcpy(p, buf, (size_t) len);
+    OPENSSL_free(buf);
+
+    *out_bytes = p;
+    *out_len   = (size_t) len;
+    return 1;
+}
+
+SSL_SESSION *
+SSL_SESSION_from_bytes (const uint8_t *in, size_t in_len, const SSL_CTX *ssl_ctx)
+{
+    const unsigned char *p = in;
+    SSL_SESSION *sess;
+
+    sess = d2i_SSL_SESSION(NULL, &p, (long) in_len);
+    if (!sess)
+        return NULL;
+
+    /* BoringSSL binds the deserialized session to the SSL_CTX; OpenSSL's
+     * d2i result is already usable with any context of matching
+     * settings.  Touch ssl_ctx to keep the signature meaningful. */
+    (void) ssl_ctx;
+
+    return sess;
+}
