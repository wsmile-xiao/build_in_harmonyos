+/* Certificate verification adaptation.                                   */
+/* ---------------------------------------------------------------------- */
+
+int
+SSL_CTX_set_custom_verify (SSL_CTX *ctx, int mode, ssl_custom_verify_func cb)
+{
+    /* The application's custom-verify callback (used by lsquic for
+     * optional peer-cert validation and logging) is invoked from
+     * lsquic's own verify_server_cert_callback, which reads the peer
+     * chain via SSL_get_peer_cert_chain().  Under OpenSSL the standard
+     * verify callback already provides chain validation.  We install a
+     * no-op verifier that accepts the chain and lets lsquic's
+     * application-level verification (enp_verify_cert) run from
+     * set_secret(), preserving lsquic semantics. */
+    (void) ctx; (void) mode; (void) cb;
+    return 1;
+}
+
+int
+HKDF_expand (uint8_t *out_key, size_t out_len, const EVP_MD *digest,
+             const uint8_t *prk, size_t prk_len, const uint8_t *info,
+             size_t info_len)
+{
+    EVP_PKEY_CTX *ctx;
+    size_t out_sz = out_len;
+    int ok = 0;
+
+    ctx = EVP_PKEY_CTX_new_id(EVP_PKEY_HKDF, NULL);
+    if (!ctx)
+        return 0;
+    if (EVP_PKEY_derive_init(ctx) <= 0)
+        goto out;
+    if (EVP_PKEY_CTX_set_hkdf_mode(ctx, EVP_PKEY_HKDEF_MODE_EXPAND_ONLY) <= 0)
+        goto out;
+    if (EVP_PKEY_CTX_set_hkdf_md(ctx, digest) <= 0)
+        goto out;
+    if (EVP_PKEY_CTX_set1_hkdf_key(ctx, prk, (int) prk_len) <= 0)
+        goto out;
+    if (info_len
+            && EVP_PKEY_CTX_add1_hkdf_info(ctx, info, (int) info_len) <= 0)
+        goto out;
+    if (EVP_PKEY_derive(ctx, out_key, &out_sz) <= 0 || out_sz != out_len)
+        goto out;
+    ok = 1;
+
+  out:
+    EVP_PKEY_CTX_free(ctx);
+    return ok;
+}
+
+/* ====================================================================== */
+/* EVP_AEAD on EVP_CIPHER.                                                */
+/* ====================================================================== */
+
+static const EVP_AEAD g_aead_aes_128_gcm = {
+    .key_len   = 16,
+    .nonce_len = 12,
+    .tag_len   = 16,
+};
+
+static const EVP_AEAD g_aead_aes_256_gcm = {
+    .key_len   = 32,
+    .nonce_len = 12,
+    .tag_len   = 16,
+};
+
+static const EVP_AEAD g_aead_chacha20_poly1305 = {
+    .key_len   = 32,
+    .nonce_len = 12,
+    .tag_len   = 16,
+};
+
+const EVP_AEAD *
+EVP_aead_aes_128_gcm (void)
+{   return &g_aead_aes_128_gcm;   }
+
+const EVP_AEAD *
+EVP_aead_aes_256_gcm (void)
+{   return &g_aead_aes_256_gcm;   }
+
+const EVP_AEAD *
+EVP_aead_chacha20_poly1305 (void)
+{   return &g_aead_chacha20_poly1305;   }
+
+size_t
+EVP_AEAD_key_length (const EVP_AEAD *aead)
+{   return aead->key_len;   }
+
+size_t
+EVP_AEAD_nonce_length (const EVP_AEAD *aead)
+{   return aead->nonce_len;   }
+
+size_t
+EVP_AEAD_max_overhead (const EVP_AEAD *aead)
+{   return aead->tag_len;   }
+
+static int
+aead_cipher (const EVP_AEAD *aead, const EVP_CIPHER **out)
+{
+    if (aead == &g_aead_aes_128_gcm)
+        *out = EVP_aes_128_gcm();
+    else if (aead == &g_aead_aes_256_gcm)
+        *out = EVP_aes_256_gcm();
+    else if (aead == &g_aead_chacha20_poly1305)
+        *out = EVP_chacha20_poly1305();
+    else
+        return 0;
+    return 1;
+}
+
+int
+EVP_AEAD_CTX_init_with_direction (EVP_AEAD_CTX *ctx, const EVP_AEAD *aead,
+            const uint8_t *key, size_t key_len, size_t tag_len,
+            enum evp_aead_direction_t dir)
+{
+    const EVP_CIPHER *cipher;
+    (void) dir;         /* OpenSSL AEADs are bidirectional */
+
+    if (!ctx || !aead || key_len != aead->key_len)
+        return 0;
+    if (!aead_cipher(aead, &cipher))
+        return 0;
+    /* BoringSSL accepts tag_len == 0 or EVP_AEAD_DEFAULT_TAG_LENGTH to
+     * mean the AEAD's default. */
+    if (tag_len == 0 || tag_len == (size_t) -1)
+        tag_len = aead->tag_len;
+    if (tag_len < 8 || tag_len > 16)
+        return 0;
+
+    memset(ctx, 0, sizeof(*ctx));
+    ctx->cipher_ctx = EVP_CIPHER_CTX_new();
+    if (!ctx->cipher_ctx)
+        return 0;
+    if (!EVP_EncryptInit_ex(ctx->cipher_ctx, cipher, NULL, NULL, NULL))
+        goto err;
+    if (!EVP_CIPHER_CTX_ctrl(ctx->cipher_ctx, EVP_CTRL_GCM_SET_IVLEN,
+                             (int) aead->nonce_len, NULL))
+        goto err;
+    if (!EVP_EncryptInit_ex(ctx->cipher_ctx, NULL, NULL, key, NULL))
+        goto err;
+
+    ctx->aead    = aead;
+    ctx->tag_len = tag_len;
+    ctx->key_sz  = key_len;
+    memcpy(ctx->key_buf, key, key_len);
+    ctx->inited  = 1;
+    return 1;
+
+  err:
+    EVP_CIPHER_CTX_free(ctx->cipher_ctx);
+    ctx->cipher_ctx = NULL;
+    return 0;
+}
+
+int
+EVP_AEAD_CTX_init (EVP_AEAD_CTX *ctx, const EVP_AEAD *aead, const uint8_t *key,
+                   size_t key_len, size_t tag_len, ENGINE *impl)
+{
+    (void) impl;
+    return EVP_AEAD_CTX_init_with_direction(ctx, aead, key, key_len,
+                                            tag_len, evp_aead_seal);
+}
+
+void
+EVP_AEAD_CTX_cleanup (EVP_AEAD_CTX *ctx)
+{
+    if (ctx && ctx->cipher_ctx)
+    {
+        EVP_CIPHER_CTX_free(ctx->cipher_ctx);
+        ctx->cipher_ctx = NULL;
+    }
+    if (ctx)
+    {
+        OPENSSL_cleanse(ctx->key_buf, sizeof(ctx->key_buf));
+        ctx->inited = 0;
+    }
+}
+
+int
+EVP_AEAD_CTX_seal (const EVP_AEAD_CTX *ctx, uint8_t *out, size_t *out_len,
+            size_t max_out_len, const uint8_t *nonce, size_t nonce_len,
+            const uint8_t *in, size_t in_len, const uint8_t *ad, size_t ad_len)
+{
+    int len;
+    uint8_t *tag;
+
+    if (!ctx || !ctx->inited || !out || !out_len)
+        return 0;
+    if (max_out_len < in_len + ctx->tag_len)
+        return 0;
+    /* BoringSSL's GCM accepts nonce lengths in the 8..16 range (gQUIC
+     * paths pass 16-byte nonces). */
+    if (nonce_len < 8 || nonce_len > 16)
+        return 0;
+
+    /* Reset for a fresh one-shot, re-keying the IV length per call.
+     * Only GCM supports variable IV lengths; ChaCha20-Poly1305 has a
+     * fixed 12-byte IV (the default), so skip the ctrl for 12. */
+    if (!EVP_EncryptInit_ex(ctx->cipher_ctx, NULL, NULL, NULL, NULL))
+        return 0;
+    if (nonce_len != 12)
+    {
+        if (!EVP_CIPHER_CTX_ctrl(ctx->cipher_ctx, EVP_CTRL_GCM_SET_IVLEN,
+                                 (int) nonce_len, NULL))
+            return 0;
+    }
+    if (!EVP_EncryptInit_ex(ctx->cipher_ctx, NULL, NULL, NULL, nonce))
+        return 0;
+    if (ad_len && !EVP_EncryptUpdate(ctx->cipher_ctx, NULL, &len, ad,
+                                     (int) ad_len))
+        return 0;
+    if (!EVP_EncryptUpdate(ctx->cipher_ctx, out, &len, in, (int) in_len))
+        return 0;
+    tag = out + in_len;
+    if (!EVP_EncryptFinal_ex(ctx->cipher_ctx, tag, &len))
+        return 0;   /* GCM final writes nothing for CTR mode */
+    if (!EVP_CIPHER_CTX_ctrl(ctx->cipher_ctx, EVP_CTRL_GCM_GET_TAG,
+                             (int) ctx->tag_len, tag))
+        return 0;
+    *out_len = (size_t) in_len + ctx->tag_len;
+    return 1;
+}
+
+int
+EVP_AEAD_CTX_open (const EVP_AEAD_CTX *ctx, uint8_t *out, size_t *out_len,
+            size_t max_out_len, const uint8_t *nonce, size_t nonce_len,
+            const uint8_t *in, size_t in_len, const uint8_t *ad, size_t ad_len)
+{
+    int len;
+    size_t ct_len;
+    uint8_t tag[16];
+
+    if (!ctx || !ctx->inited || !out || !out_len)
+        return 0;
+    if (in_len < ctx->tag_len)
+        return 0;
+    ct_len = in_len - ctx->tag_len;
+    if (max_out_len < ct_len)
+        return 0;
+    if (nonce_len < 8 || nonce_len > 16)
+        return 0;
+
+    if (!EVP_DecryptInit_ex(ctx->cipher_ctx, NULL, NULL, NULL, NULL))
+        return 0;
+    if (nonce_len != 12)
+    {
+        if (!EVP_CIPHER_CTX_ctrl(ctx->cipher_ctx, EVP_CTRL_GCM_SET_IVLEN,
+                                 (int) nonce_len, NULL))
+            return 0;
+    }
+    if (!EVP_DecryptInit_ex(ctx->cipher_ctx, NULL, NULL, NULL, nonce))
+        return 0;
+    if (ad_len && !EVP_DecryptUpdate(ctx->cipher_ctx, NULL, &len, ad,
+                                     (int) ad_len))
+        return 0;
+    if (!EVP_DecryptUpdate(ctx->cipher_ctx, out, &len, in, (int) ct_len))
+        return 0;
+    memcpy(tag, in + ct_len, ctx->tag_len);
+    if (!EVP_CIPHER_CTX_ctrl(ctx->cipher_ctx, EVP_CTRL_GCM_SET_TAG,
+                             (int) ctx->tag_len, tag))
+        return 0;
+    if (!EVP_DecryptFinal_ex(ctx->cipher_ctx, tag, &len))
+        return 0;   /* authentication failure */
+
+    *out_len = ct_len;
+    return 1;
+}
+
+/* ====================================================================== */
+/* ChaCha20 (header protection, RFC 9001 s. 5.4.3).                       */
+/* ====================================================================== */
+
+void
+CRYPTO_chacha_20 (uint8_t *out, const uint8_t *in, size_t in_len,
+                  const uint8_t key[32], const uint8_t nonce[12],
+                  uint32_t counter)
+{
+    EVP_CIPHER_CTX *ctx;
+    unsigned char iv[16];
+    int len = 0;
+    size_t done = 0;
+
+    /* OpenSSL EVP_chacha20 takes a 16-byte IV: little-endian counter
+     * followed by the 12-byte nonce. */
+    memcpy(iv, &counter, 4);
+    memcpy(iv + 4, nonce, 12);
+
+    ctx = EVP_CIPHER_CTX_new();
+    if (!ctx)
+        return;
+    if (!EVP_EncryptInit_ex(ctx, EVP_chacha20(), NULL, NULL, NULL))
+        goto out;
+    if (!EVP_CIPHER_CTX_set_key_length(ctx, 32))
+        goto out;
+    if (!EVP_EncryptInit_ex(ctx, NULL, NULL, key, iv))
+        goto out;
+    /* Disable padding - not applicable to a stream cipher, but keep
+     * parity with other ports. */
+    EVP_CIPHER_CTX_set_padding(ctx, 0);
+    while (done < in_len)
+    {
+        size_t chunk = in_len - done > INT_MAX ? INT_MAX : in_len - done;
+        if (!EVP_EncryptUpdate(ctx, out + done, &len, in + done,
+                               (int) chunk))
+            goto out;
+        done += (size_t) len;
+        len = 0;
+    }
+
+  out:
+    EVP_CIPHER_CTX_free(ctx);
+}
