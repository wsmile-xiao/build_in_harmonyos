diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -0,0 +1,350 @@
+cmake_minimum_required(VERSION 3.10)
+project(libpst VERSION 0.6.76 LANGUAGES C CXX)
+
+# Set C standard
+set(CMAKE_C_STANDARD 11)
+set(CMAKE_C_STANDARD_REQUIRED ON)
+
+# Set C++ standard
+set(CMAKE_CXX_STANDARD 11)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+# Options
+option(ENABLE_DII "Enable DII utility" OFF)
+option(ENABLE_PST_DEBUG "Force debug dump file creation" OFF)
+option(ENABLE_SHARED "Build shared library" OFF)
+option(ENABLE_STATIC_TOOLS "Link tools statically" ON)
+option(ENABLE_PYTHON "Build Python interface" OFF)
+option(ENABLE_MSG_UTILS "Enable msg-based utilities (requires libgsf)" OFF)
+
+# Find required dependencies
+find_package(ZLIB REQUIRED)
+find_package(Threads REQUIRED)
+
+# Find iconv
+include(CheckFunctionExists)
+check_function_exists(iconv HAVE_ICONV_SYSTEM)
+if(NOT HAVE_ICONV_SYSTEM)
+    # Try to find iconv in library
+    find_library(ICONV_LIBRARY NAMES iconv)
+    if(ICONV_LIBRARY)
+        set(HAVE_ICONV TRUE)
+    else()
+        message(FATAL_ERROR "libpst requires iconv which is missing")
+    endif()
+else()
+    set(HAVE_ICONV TRUE)
+endif()
+
+# Check for regex
+check_function_exists(regexec HAVE_REGEXEC_SYSTEM)
+if(NOT HAVE_REGEXEC_SYSTEM)
+    find_library(REGEX_LIBRARY NAMES regex)
+    if(REGEX_LIBRARY)
+        set(HAVE_REGEXEC TRUE)
+    else()
+        message(FATAL_ERROR "No regex library found")
+    endif()
+else()
+    set(HAVE_REGEXEC TRUE)
+endif()
+
+# Check for getopt
+check_include_file(unistd.h HAVE_UNISTD_H)
+if(HAVE_UNISTD_H)
+    check_function_exists(getopt HAVE_GETOPT)
+endif()
+
+# Try to find libgsf (optional for msg-based utilities)
+if(ENABLE_MSG_UTILS)
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(GSF REQUIRED libgsf-1)
+endif()
+
+# Generate config.h with comprehensive definitions
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/config.h "
+/* Comprehensive config.h for cmake build */
+#define PACKAGE \"libpst\"
+#define PACKAGE_VERSION \"0.6.76\"
+#define VERSION \"0.6.76\"
+#define PACKAGE_STRING \"libpst 0.6.76\"
+#define PACKAGE_NAME \"libpst\"
+#define PACKAGE_TARNAME \"libpst\"
+#define PACKAGE_BUGREPORT \"carl@five-ten-sg.com\"
+
+/* Enable large file support */
+#define _FILE_OFFSET_BITS 64
+#define _LARGEFILE_SOURCE 1
+#define _LARGE_FILES 1
+
+/* System headers - all available */
+#define HAVE_UNISTD_H 1
+#define HAVE_STDLIB_H 1
+#define HAVE_STRING_H 1
+#define HAVE_STRINGS_H 1
+#define HAVE_STDIO_H 1
+#define HAVE_CTYPE_H 1
+#define HAVE_ERRNO_H 1
+#define HAVE_FCNTL_H 1
+#define HAVE_TIME_H 1
+#define HAVE_WCHAR_H 1
+#define HAVE_INTTYPES_H 1
+#define HAVE_STDINT_H 1
+#define HAVE_DIRENT_H 1
+#define HAVE_SYS_STAT_H 1
+#define HAVE_SYS_TYPES_H 1
+#define HAVE_SYS_PARAM_H 1
+#define HAVE_LIMITS_H 1
+#define HAVE_SIGNAL_H 1
+#define HAVE_STDARG_H 1
+#define HAVE_REGEX_H 1
+#define HAVE_SEMAPHORE_H 1
+#define HAVE_SYS_SHM_H 1
+#define HAVE_SYS_STAT_H 1
+#define HAVE_MALLOC_H 1
+
+/* Functions - all available */
+#define HAVE_ICONV 1
+#define HAVE_REGEXEC 1
+#define HAVE_MALLOC 1
+#define HAVE_REALLOC 1
+#define HAVE_CHDIR 1
+#define HAVE_GETCWD 1
+#define HAVE_MEMCHR 1
+#define HAVE_MEMMOVE 1
+#define HAVE_MEMSET 1
+#define HAVE_STRCASECMP 1
+#define HAVE_STRNCASECMP 1
+#define HAVE_STRCHR 1
+#define HAVE_STRDUP 1
+#define HAVE_STRERROR 1
+#define HAVE_STRPBRK 1
+#define HAVE_STRRCHR 1
+#define HAVE_STRSTR 1
+#define HAVE_STRFTIME 1
+#define HAVE_VPRINTF 1
+#define HAVE_FSEEKO 1
+#define HAVE_STAT 1
+#define HAVE_LSTAT 1
+#define HAVE_ALARM 1
+#define HAVE_FORK 1
+#define HAVE_GETOPT 1
+
+/* Types */
+#define HAVE_OFF_T 1
+#define HAVE_SIZE_T 1
+#define HAVE_PID_T 1
+#define SIZEOF_OFF_T 8
+
+/* Iconv */
+#define ICONV_CONST
+
+/* Regex */
+#define HAVE_REGEXEC 1
+
+/* Large file support */
+#define HAVE_FSEEKO 1
+#define AC_SYS_LARGEFILE 1
+
+/* NLS */
+#define ENABLE_NLS 1
+")
+
+if(ENABLE_PST_DEBUG)
+    file(APPEND ${CMAKE_CURRENT_BINARY_DIR}/config.h "#define DEBUG_ALL 1\n")
+endif()
+
+if(ENABLE_MSG_UTILS AND GSF_FOUND)
+    file(APPEND ${CMAKE_CURRENT_BINARY_DIR}/config.h "#define HAVE_LIBGSF 1\n")
+endif()
+
+include_directories(${CMAKE_CURRENT_BINARY_DIR})
+
+# Add necessary compile flags and definitions
+add_compile_options(
+    -Wno-implicit-function-declaration
+    -Wno-pointer-sign
+)
+
+add_compile_definitions(
+    HAVE_CONFIG_H
+    HAVE_GETOPT
+)
+
+# Define library sources
+set(LIBPST_SOURCES
+    src/libpst.c
+    src/debug.c
+    src/libstrfunc.c
+    src/lzfu.c
+    src/timeconv.c
+    src/vbuf.c
+)
+
+set(LIBPST_HEADERS
+    src/libpst.h
+    src/common.h
+    src/define.h
+    src/lzfu.h
+    src/libstrfunc.h
+    src/timeconv.h
+    src/vbuf.h
+)
+
+# Build shared or static library
+if(ENABLE_SHARED)
+    add_library(pst SHARED ${LIBPST_SOURCES} ${LIBPST_HEADERS})
+    set_target_properties(pst PROPERTIES
+        VERSION 4.1.18
+        SOVERSION 4
+        OUTPUT_NAME pst
+    )
+else()
+    add_library(pst STATIC ${LIBPST_SOURCES} ${LIBPST_HEADERS})
+    set_target_properties(pst PROPERTIES OUTPUT_NAME pst)
+endif()
+
+# Link dependencies to library
+target_include_directories(pst PUBLIC
+    ${ZLIB_INCLUDE_DIRS}
+)
+
+target_link_libraries(pst PUBLIC
+    ${ZLIB_LIBRARIES}
+    Threads::Threads
+)
+
+if(ICONV_LIBRARY)
+    target_link_libraries(pst PUBLIC ${ICONV_LIBRARY})
+endif()
+
+if(REGEX_LIBRARY)
+    target_link_libraries(pst PUBLIC ${REGEX_LIBRARY})
+endif()
+
+# Build simple tools (no msg.cpp dependency)
+set(SIMPLE_TOOL_SOURCES
+    src/lspst.c
+    src/getidblock.c
+    src/dumpblocks.c
+)
+
+foreach(TOOL_SRC IN LISTS SIMPLE_TOOL_SOURCES)
+    get_filename_component(TOOL_NAME ${TOOL_SRC} NAME_WE)
+    add_executable(${TOOL_NAME} ${TOOL_SRC})
+
+    if(ENABLE_STATIC_TOOLS AND NOT ENABLE_SHARED)
+        target_link_libraries(${TOOL_NAME} pst ${ZLIB_LIBRARIES} Threads::Threads)
+        if(ICONV_LIBRARY)
+            target_link_libraries(${TOOL_NAME} ${ICONV_LIBRARY})
+        endif()
+        if(REGEX_LIBRARY)
+            target_link_libraries(${TOOL_NAME} ${REGEX_LIBRARY})
+        endif()
+    else()
+        target_link_libraries(${TOOL_NAME} pst)
+    endif()
+
+    target_include_directories(${TOOL_NAME} PRIVATE
+        ${ZLIB_INCLUDE_DIRS}
+    )
+endforeach()
+
+# Build msg-based tools if libgsf is available
+if(ENABLE_MSG_UTILS AND GSF_FOUND)
+    # readpst needs msg.cpp
+    add_executable(readpst src/readpst.c src/msg.cpp)
+    target_include_directories(readpst PRIVATE ${GSF_INCLUDE_DIRS})
+    target_link_libraries(readpst pst ${GSF_LIBRARIES} ${ZLIB_LIBRARIES} Threads::Threads)
+    if(ICONV_LIBRARY)
+        target_link_libraries(readpst ${ICONV_LIBRARY})
+    endif()
+    if(REGEX_LIBRARY)
+        target_link_libraries(readpst ${REGEX_LIBRARY})
+    endif()
+
+    # pst2ldif and nick2ldif need msg.cpp
+    add_executable(pst2ldif src/pst2ldif.cpp src/msg.cpp)
+    add_executable(nick2ldif src/nick2ldif.cpp src/msg.cpp)
+
+    foreach(TOOL_NAME pst2ldif nick2ldif)
+        target_include_directories(${TOOL_NAME} PRIVATE ${GSF_INCLUDE_DIRS})
+        target_link_libraries(${TOOL_NAME} pst ${GSF_LIBRARIES} ${ZLIB_LIBRARIES} Threads::Threads)
+        if(ICONV_LIBRARY)
+            target_link_libraries(${TOOL_NAME} ${ICONV_LIBRARY})
+        endif()
+        if(REGEX_LIBRARY)
+            target_link_libraries(${TOOL_NAME} ${REGEX_LIBRARY})
+        endif()
+    endforeach()
+
+    # deltasearch needs msg.cpp
+    add_executable(deltasearch src/deltasearch.cpp src/msg.cpp)
+    target_include_directories(deltasearch PRIVATE ${GSF_INCLUDE_DIRS})
+    target_link_libraries(deltasearch pst ${GSF_LIBRARIES} ${ZLIB_LIBRARIES} Threads::Threads)
+    if(ICONV_LIBRARY)
+        target_link_libraries(deltasearch ${ICONV_LIBRARY})
+    endif()
+    if(REGEX_LIBRARY)
+        target_link_libraries(deltasearch ${REGEX_LIBRARY})
+    endif()
+else()
+    message(STATUS "  Skipping msg-based utilities (libgsf not available)")
+endif()
+
+# Install targets
+install(TARGETS pst
+    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION lib
+    RUNTIME DESTINATION bin
+)
+
+if(ENABLE_MSG_UTILS AND GSF_FOUND)
+    install(TARGETS readpst lspst getidblock pst2ldif nick2ldif dumpblocks deltasearch
+        RUNTIME DESTINATION bin
+    )
+else()
+    install(TARGETS lspst getidblock dumpblocks
+        RUNTIME DESTINATION bin
+    )
+endif()
+
+install(FILES src/libpst.h src/common.h src/define.h src/lzfu.h src/libstrfunc.h src/timeconv.h src/vbuf.h
+    DESTINATION include/libpst-4/libpst
+)
+
+# Generate pkg-config file
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/libpst.pc "
+prefix=${CMAKE_INSTALL_PREFIX}
+exec_prefix=\${prefix}
+libdir=\${exec_prefix}/lib
+includedir=\${prefix}/include/libpst-4/libpst
+
+Name: libpst
+Description: Library to read Outlook PST files
+Version: ${PROJECT_VERSION}
+Libs: -L\${libdir} -lpst -lz -lpthread
+Cflags: -I\${includedir}
+")
+
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/libpst.pc DESTINATION lib/pkgconfig)
+
+message(STATUS "libpst configuration:")
+message(STATUS "  Version: ${PROJECT_VERSION}")
+message(STATUS "  Build shared library: ${ENABLE_SHARED}")
+message(STATUS "  Static tools: ${ENABLE_STATIC_TOOLS}")
+message(STATUS "  Enable DII: ${ENABLE_DII}")
+message(STATUS "  Enable PST Debug: ${ENABLE_PST_DEBUG}")
+message(STATUS "  Enable msg utilities: ${ENABLE_MSG_UTILS}")
+message(STATUS "  Install prefix: ${CMAKE_INSTALL_PREFIX}")
+message(STATUS "  ZLIB found: ${ZLIB_FOUND}")
+message(STATUS "  Iconv: ${HAVE_ICONV}")
+message(STATUS "  Regex: ${HAVE_REGEXEC}")
+message(STATUS "  getopt: ${HAVE_GETOPT}")
+if(ENABLE_MSG_UTILS AND GSF_FOUND)
+    message(STATUS "  libgsf: found (version ${GSF_VERSION})")
+elseif(ENABLE_MSG_UTILS)
+    message(STATUS "  libgsf: NOT FOUND (required for msg utilities)")
+else()
+    message(STATUS "  libgsf: disabled (msg utilities not built)")
+endif()