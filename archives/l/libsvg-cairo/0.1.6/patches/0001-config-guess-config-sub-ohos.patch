diff --git a/config.guess b/config.guess
index 2fc3acc..aea23ea 100755
--- a/config.guess
+++ b/config.guess
@@ -808,6 +808,10 @@ EOF
     i*86:Minix:*:*)
 	echo ${UNAME_MACHINE}-pc-minix
 	exit 0 ;;
+    aarch64:HarmonyOS:*:*)
+	# HarmonyOS (OHOS) is musl-based; aarch64 is the canonical OHOS PC arch.
+	echo aarch64-unknown-linux-ohos
+	exit 0 ;;
     arm*:Linux:*:*)
 	echo ${UNAME_MACHINE}-unknown-linux-gnu
 	exit 0 ;;
