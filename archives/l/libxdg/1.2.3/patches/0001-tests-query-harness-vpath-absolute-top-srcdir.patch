Description: Resolve the query-test expected path with `cd ... && pwd -P` instead of
             concatenating `pwd` with ${top_srcdir}. The concatenation only holds when
             ${top_srcdir} is relative (in-tree / `cd build && ../configure`); any build
             that configures through an absolute path (Conan always does:
             Autotools.configure_cmd = "<source_folder>/configure") yields
             "$(pwd)//abs/src/tests/querycf.2", so querycf.2 and querydf.2 can never match
             their expected output. `cd ... && pwd -P` produces the same real directory for
             both relative and absolute ${top_srcdir}, so the cases hold either way.
Origin: https://github.com/devnev/libxdg-basedir/tree/libxdg-basedir-1.2.3
Upstream: not submitted; general out-of-tree(VPATH) portability fix, upstreamable as-is
Source-Commit: 177ff3b6483ae9111b74b4d0439cd9b59c5b0162
Modification-Layer: 1 (test harness path resolution only; no library source touched)
Knowledge-Ref: DRAFT-libxdg-1.2.3-vpath-absolute-top-srcdir-test-paths, P005

diff -ruN a/tests/querycf.2 b/tests/querycf.2
--- a/tests/querycf.2
+++ b/tests/querycf.2
@@ -1,14 +1,13 @@
 #!/bin/sh
 
 harness="${top_srcdir}/tests/query-harness.sh"
-wd="`pwd`"
-td="${top_srcdir}/tests"
+td="$(cd "${top_srcdir}/tests" && pwd -P)"
 
 export HOME=/home/test
-export XDG_CONFIG_DIRS="$wd/$td"
+export XDG_CONFIG_DIRS="$td"
 
 basename="`basename "$0"`"
 arguments="config find $basename"
-expected="$wd/$td/$basename"
+expected="$td/$basename"
 
 . "$harness"
diff -ruN a/tests/querydf.2 b/tests/querydf.2
--- a/tests/querydf.2
+++ b/tests/querydf.2
@@ -1,14 +1,13 @@
 #!/bin/sh
 
 harness="${top_srcdir}/tests/query-harness.sh"
-wd="`pwd`"
-td="${top_srcdir}/tests"
+td="$(cd "${top_srcdir}/tests" && pwd -P)"
 
 export HOME=/home/test
-export XDG_DATA_DIRS="$wd/$td"
+export XDG_DATA_DIRS="$td"
 
 basename="`basename "$0"`"
 arguments="data find $basename"
-expected="$wd/$td/$basename"
+expected="$td/$basename"
 
 . "$harness"
