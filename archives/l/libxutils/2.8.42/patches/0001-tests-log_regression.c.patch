+/* A writable scratch dir: some platforms (e.g. OHOS) mount /tmp read-only.
+ * Honour $TMPDIR when set, otherwise fall back to /tmp. */
+static void xlog_test_tmpdir(char *pBuf, size_t nSize, const char *pName)
+{
+    const char *pBase = getenv("TMPDIR");
+    if (pBase == NULL || *pBase == '\0') pBase = "/tmp";
+    snprintf(pBuf, nSize, "%s/xutils-%s-XXXXXX", pBase, pName);
+}
