diff --git a/test/Makefile.am b/test/Makefile.am
index 82c2487..ce85462 100644
--- a/test/Makefile.am
+++ b/test/Makefile.am
@@ -8,7 +8,12 @@ TESTS = tests tests_rs
 
 CLEANFILES = mockbridge.json.h mockbridgeinfo.json.h
 
-mockbridge.c: mockbridge.json.h mockbridgeinfo.json.h
+# Out-of-tree (VPATH) build fix: the old `mockbridge.c: mockbridge.json.h
+# mockbridgeinfo.json.h` dependency-only rule made make treat mockbridge.c as
+# buildable in the build dir and skip the VPATH search for it (clang then
+# died with "no such file or directory: 'mockbridge.c'"). BUILT_SOURCES is
+# automake's intended mechanism: generate the headers before anything else.
+BUILT_SOURCES = mockbridge.json.h mockbridgeinfo.json.h
 
 %.json.h: %.json
 	@$(MKDIR_P) $(@D)
