 #ifdef PROFILE
+#if defined(__x86_64__) || defined(__i386__)
 static long long rdtsc(void)
 {
     unsigned long low, hi;
     asm volatile ("rdtsc" : "=d" (hi), "=a" (low));
     return ( (((long long)hi) << 32) | ((long long) low));
 }
+#else
+/* Non-x86 (aarch64/OHOS): the TSC inline asm is x86-only ("invalid output
+ * constraint '=d' in asm"); rdtsc() is instrumentation-only dead code, so a
+ * monotonic clock keeps the same role. */
+#include <time.h>
+static long long rdtsc(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (long long)ts.tv_sec * 1000000000ll + (long long)ts.tv_nsec;
+}
+#endif
 
