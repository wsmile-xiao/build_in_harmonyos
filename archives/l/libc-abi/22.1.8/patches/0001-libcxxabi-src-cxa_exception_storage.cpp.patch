--- a/libcxxabi/src/cxa_exception_storage.cpp
+++ b/libcxxabi/src/cxa_exception_storage.cpp
@@ -5,21 +5,29 @@
 // SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
 //
 //
 //  This file implements the storage for the "Caught Exception Stack"
 //  https://itanium-cxx-abi.github.io/cxx-abi/abi-eh.html#cxx-exc-stack
 //
 //===----------------------------------------------------------------------===//
 
 #include "cxa_exception.h"
 
-#include <__thread/support.h>
+// libc++ 22 moved the thread abstraction API from <__threading_support> to
+// <__thread/support.h>. The OHOS SDK ships libc++ 15 headers (which have only
+// the old header), so probe for the new one and fall back: both expose the
+// same std::__libcpp_tls_key / _LIBCPP_EXEC_ONCE_INITIALIZER names.
+#if __has_include(<__thread/support.h>)
+#  include <__thread/support.h>
+#else
+#  include <__threading_support>
+#endif
 
 #if defined(_LIBCXXABI_HAS_NO_THREADS)
 
 namespace __cxxabiv1 {
 extern "C" {
     static __cxa_eh_globals eh_globals;
     __cxa_eh_globals *__cxa_get_globals() { return &eh_globals; }
     __cxa_eh_globals *__cxa_get_globals_fast() { return &eh_globals; }
 } // extern "C"
 } // namespace __cxxabiv1
