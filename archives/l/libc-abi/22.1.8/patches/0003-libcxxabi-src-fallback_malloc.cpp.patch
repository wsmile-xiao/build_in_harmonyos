 #include "fallback_malloc.h"
 #include "abort_message.h"
 
-#include <__thread/support.h>
+// libc++ 22 renamed <__threading_support> to <__thread/support.h>; both expose the
+// same std::__libcpp_* thread API names. The OHOS SDK ships only the former.
+#if __has_include(<__thread/support.h>)
+#  include <__thread/support.h>
+#else
+#  include <__threading_support>
+#endif
 #ifndef _LIBCXXABI_HAS_NO_THREADS
 #if defined(__ELF__) && defined(_LIBCXXABI_LINK_PTHREAD_LIB)
 #pragma comment(lib, "pthread")
 #endif
 #endif
 
-#include "include/aligned_alloc.h" // from libc++
+#include <__config>
+// libc++ 22 moved the aligned allocation helpers out of <new> into a standalone
+// header.  The libc++ 15 headers shipped with the OHOS SDK still provide them
+// from <new>, so include the standalone header only for libc++ 22 and later.
+#if _LIBCPP_VERSION >= 220000
+#  include "include/aligned_alloc.h" // from libc++
+#else
+#  include <new> // provides std::__libcpp_aligned_alloc / std::__libcpp_aligned_free
+#endif
 #include <__assert>
 #include <stdlib.h> // for malloc, calloc, free
 #include <string.h> // for memset
 
 //  A small, simple heap manager based (loosely) on
 //  the startup heap manager from FreeBSD, optimized for space.
 //
 //  Manages a fixed-size memory pool, supports malloc and free only.
 //  No support for realloc.
 //
