 #include "__cxxabi_config.h"
 #include "abort_message.h"
-#include "include/aligned_alloc.h"        // from libc++
+#include <__config>
+// libc++ 22 moved the aligned allocation helpers out of <new> into this header.
+// The libc++ 15 headers shipped with the OHOS SDK still provide them from <new>,
+// so pulling it in there would redefine __libcpp_aligned_free; include it only
+// when the headers really do not provide those helpers anymore.
+#if _LIBCPP_VERSION >= 220000
+#  include "include/aligned_alloc.h"        // from libc++
+#endif
 #include "include/overridable_function.h" // from libc++
 #include <cstddef>
 #include <cstdlib>
 #include <new>
 
 // Perform a few sanity checks on libc++ and libc++abi macros to ensure that
 // the code below can be an exact copy of the code in libcxx/src/new.cpp.
 #if !defined(_THROW_BAD_ALLOC)
 #  error The _THROW_BAD_ALLOC macro should be already defined by libc++
 #endif
