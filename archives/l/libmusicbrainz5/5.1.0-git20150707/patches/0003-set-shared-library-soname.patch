--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -66,6 +66,12 @@
 	ENDIF(CMAKE_COMPILER_IS_GNUCXX)
 endif(CMAKE_BUILD_TYPE STREQUAL Debug)
 
+# OHOS toolchain: CMake does not emit DT_SONAME from SOVERSION; set it explicitly.
+# Use the unversioned file name (upstream install produces only libX.so, no .so.N
+# symlink chain), otherwise the runtime loader cannot find the file.
+SET_TARGET_PROPERTIES(musicbrainz5cc PROPERTIES LINK_FLAGS "-Wl,-soname,libmusicbrainz5cc.so")
+SET_TARGET_PROPERTIES(musicbrainz5 PROPERTIES LINK_FLAGS "-Wl,-soname,libmusicbrainz5.so")
+
 TARGET_LINK_LIBRARIES(musicbrainz5cc ${NEON_LIBRARIES} ${LIBXML2_LIBRARIES})
 TARGET_LINK_LIBRARIES(musicbrainz5 musicbrainz5cc)
 
