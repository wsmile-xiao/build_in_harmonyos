diff --git a/shadow.h b/shadow.h
new file mode 100644
index 0000000..ce92ab2
--- /dev/null
+++ b/shadow.h
@@ -0,0 +1,17 @@
+/*
+ * Tree-local <shadow.h> wrapper for OHOS/musl.
+ * musl ships shadow.h with struct spwd but no parsing functions;
+ * libnss-cache needs fgetspent_r() which musl does not declare.
+ * Pull in the system header and add the missing prototype.
+ */
+#ifndef _SHADOW_WRAPPER_H
+#define _SHADOW_WRAPPER_H
+
+#include_next <shadow.h>
+
+#include <stdio.h>
+
+int fgetspent_r(FILE *stream, struct spwd *spbuf, char *buffer,
+                size_t buflen, struct spwd **result);
+
+#endif /* _SHADOW_WRAPPER_H */
