diff --git a/gshadow.h b/gshadow.h
new file mode 100644
index 0000000..9f73a7b
--- /dev/null
+++ b/gshadow.h
@@ -0,0 +1,21 @@
+/*
+ * Minimal gshadow.h compatibility header for OHOS/musl.
+ * musl libc does not ship <gshadow.h>. Define struct sgrp (glibc layout)
+ * and the fgetsgent_r() prototype used by libnss-cache.
+ */
+#ifndef _GSHADOW_COMPAT_H
+#define _GSHADOW_COMPAT_H
+
+#include <stdio.h>
+
+struct sgrp {
+  char *sg_namp;
+  char *sg_passwd;
+  char **sg_adm;
+  char **sg_mem;
+};
+
+int fgetsgent_r(FILE *stream, struct sgrp *sgrp, char *buffer,
+                size_t buflen, struct sgrp **result);
+
+#endif /* _GSHADOW_COMPAT_H */
