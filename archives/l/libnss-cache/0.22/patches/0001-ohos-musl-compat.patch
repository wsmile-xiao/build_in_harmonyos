diff --git a/nss.h b/nss.h
new file mode 100644
index 0000000..5543c36
--- /dev/null
+++ b/nss.h
@@ -0,0 +1,18 @@
+/*
+ * Minimal glibc NSS compatibility header for OHOS/musl.
+ * OHOS uses musl libc which has no NSS framework and does not ship <nss.h>.
+ * libnss-cache (a glibc NSS module) needs only the nss_status enum and the
+ * NSS_STATUS_* constants. Layout follows glibc nss/nss.h.
+ */
+#ifndef _NSS_COMPAT_H
+#define _NSS_COMPAT_H
+
+enum nss_status {
+  NSS_STATUS_TRYAGAIN = -2,
+  NSS_STATUS_UNAVAIL = -1,
+  NSS_STATUS_NOTFOUND = 0,
+  NSS_STATUS_SUCCESS = 1,
+  NSS_STATUS_RETURN = 2
+};
+
+#endif /* _NSS_COMPAT_H */
