diff --git a/compat/fgetsgent_r.c b/compat/fgetsgent_r.c
new file mode 100644
index 0000000..911c02d
--- /dev/null
+++ b/compat/fgetsgent_r.c
@@ -0,0 +1,119 @@
+/*
+ * fgetsgent_r() implementation for OHOS/musl.
+ * musl libc has no <gshadow.h>. Adapted in the style of
+ * compat/getpwent_r.c (musl-derived) for libnss-cache.
+ * Format: name:passwd:admin-list:member-list  (lists are comma separated)
+ *
+ * The char* arrays for the admin/member lists are placed immediately after
+ * the parsed line content inside the caller's buffer; pointers reference the
+ * in-place, comma-split items.
+ */
+
+#if defined(BSD) || (defined(__linux__) && !defined(__GLIBC__))
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "gshadow.h"
+
+/* Count comma-separated items in a NUL-terminated list. */
+static int count_items(const char *s) {
+  int n = 0;
+  if (s && *s) {
+    n = 1;
+    for (; *s; s++)
+      if (*s == ',') n++;
+  }
+  return n;
+}
+
+/* Split the comma list at start into nitems tokens and write the pointer
+ * array beginning at buf.  Returns NULL on ERANGE (region would overflow
+ * the caller's buffer). */
+static char **build_list(char *start, int nitems, char *buf, size_t buflen,
+                         char *limit) {
+  char **arr;
+  int i;
+
+  if ((size_t)(nitems + 1) * sizeof(char *) > (size_t)(limit - buf)) {
+    return NULL;
+  }
+  arr = (char **)buf;
+  for (i = 0; i < nitems; i++) {
+    arr[i] = start;
+    start = strchr(start, ',');
+    if (start) {
+      *start++ = 0;
+    }
+  }
+  arr[nitems] = NULL;
+  return arr;
+}
+
+int fgetsgent_r(FILE *f, struct sgrp *sg, char *line, size_t size,
+                struct sgrp **res) {
+  char *s, *adm_start, *mem_start;
+  char *name;
+  char *buf;   /* pointer array region after line content */
+  char *limit; /* end of caller buffer */
+  int n_adm, n_mem, rv = 0;
+  size_t linelen;
+
+  for (;;) {
+    line[size - 1] = '\xff';
+    if ((fgets(line, size, f) == NULL) || ferror(f) ||
+        line[size - 1] != '\xff') {
+      rv = (line[size - 1] != '\xff') ? ERANGE : ENOENT;
+      line = 0;
+      sg = 0;
+      break;
+    }
+    line[strcspn(line, "\n")] = 0;
+    linelen = strlen(line) + 1;
+
+    buf = line + linelen;
+    limit = line + size;
+
+    s = line;
+    name = s;
+    if (!(s = strchr(s, ':'))) continue;
+    *s++ = 0;
+    sg->sg_namp = name;
+    sg->sg_passwd = s;
+    if (!(s = strchr(s, ':'))) continue;
+    *s++ = 0;
+
+    /* admin list token runs until next ':' (or EOL) */
+    adm_start = s;
+    s = strchr(s, ':');
+    if (s) *s++ = 0;
+    mem_start = s; /* member list (NULL when no fourth field) */
+
+    n_adm = count_items(adm_start);
+    n_mem = mem_start ? count_items(mem_start) : 0;
+
+    sg->sg_adm = build_list(adm_start, n_adm, buf, size, limit);
+    if (sg->sg_adm == NULL) {
+      rv = ERANGE;
+      break;
+    }
+    buf += (size_t)(n_adm + 1) * sizeof(char *);
+
+    /* Always hand back a {NULL}-terminated array, even for empty lists:
+     * gen_getent dereferences sg_mem directly. */
+    sg->sg_mem = build_list(mem_start, n_mem, buf, size, limit);
+    if (sg->sg_mem == NULL) {
+      rv = ERANGE;
+      break;
+    }
+    buf += (size_t)(n_mem + 1) * sizeof(char *);
+
+    break;
+  }
+  *res = sg;
+  if (rv) errno = rv;
+  return rv;
+}
+#endif /* BSD || (linux && !glibc) */
