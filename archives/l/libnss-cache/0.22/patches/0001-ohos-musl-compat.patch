diff --git a/compat/fgetspent_r.c b/compat/fgetspent_r.c
new file mode 100644
index 0000000..035b7e3
--- /dev/null
+++ b/compat/fgetspent_r.c
@@ -0,0 +1,72 @@
+/*
+ * fgetspent_r() implementation for OHOS/musl.
+ * musl libc ships <shadow.h> with struct spwd but no parsing functions.
+ * Adapted in the style of compat/getpwent_r.c (musl-derived) for libnss-cache.
+ * Format: name:passwd:lstchg:min:max:warn:inact:expire:flag
+ */
+
+#if defined(BSD) || (defined(__linux__) && !defined(__GLIBC__))
+
+#include <errno.h>
+#include <shadow.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static long atol_field(char **s) {
+  char *p = *s;
+  /* Empty numeric field (end of line or ':' separator) means "not set" */
+  if (*p == '\0' || *p == ':') {
+    return -1;
+  }
+  return strtol(p, s, 10);
+}
+
+int fgetspent_r(FILE *f, struct spwd *sp, char *line, size_t size,
+                struct spwd **res) {
+  char *s;
+  int rv = 0;
+  for (;;) {
+    line[size - 1] = '\xff';
+    if ((fgets(line, size, f) == NULL) || ferror(f) ||
+        line[size - 1] != '\xff') {
+      rv = (line[size - 1] != '\xff') ? ERANGE : ENOENT;
+      line = 0;
+      sp = 0;
+      break;
+    }
+    line[strcspn(line, "\n")] = 0;
+
+    s = line;
+    sp->sp_namp = s;
+    if (!(s = strchr(s, ':'))) continue;
+    *s++ = 0;
+    sp->sp_pwdp = s;
+    if (!(s = strchr(s, ':'))) continue;
+    *s++ = 0;
+    sp->sp_lstchg = atol_field(&s);
+    if (*s != ':') continue;
+    *s++ = 0;
+    sp->sp_min = atol_field(&s);
+    if (*s != ':') continue;
+    *s++ = 0;
+    sp->sp_max = atol_field(&s);
+    if (*s != ':') continue;
+    *s++ = 0;
+    sp->sp_warn = atol_field(&s);
+    if (*s != ':') continue;
+    *s++ = 0;
+    sp->sp_inact = atol_field(&s);
+    if (*s != ':') continue;
+    *s++ = 0;
+    sp->sp_expire = atol_field(&s);
+    if (*s != ':') continue;
+    *s++ = 0;
+    sp->sp_flag = atol_field(&s);
+    break;
+  }
+  *res = sp;
+  if (rv) errno = rv;
+  return rv;
+}
+#endif /* BSD || (linux && !glibc) */
