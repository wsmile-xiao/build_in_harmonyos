--- a/Makefile
+++ b/Makefile
@@ -1,55 +1,78 @@
 #!/bin/make
 #
-# Makefile for wapcaplet
+# Standalone Makefile for libwapcaplet (adapted for HarmonyOS/OpenHarmony)
+#
+# Original NetSurf build system replaced with standalone build because
+# netsurf-buildsystem package is not available on this platform.
 #
 # Copyright 2009-2015 John-Mark Bell <jmb@netsurf-browser.org>

 # Component settings
 COMPONENT := wapcaplet
 COMPONENT_VERSION := 0.4.3
-# Default to a static library
 COMPONENT_TYPE ?= lib-static

-# Setup the tooling
-PREFIX ?= /opt/netsurf
-NSSHARED ?= $(PREFIX)/share/netsurf-buildsystem
-include $(NSSHARED)/makefiles/Makefile.tools
+# Installation paths
+PREFIX ?= /usr/local
+LIBDIR ?= lib
+INCLUDEDIR ?= include

-# Reevaluate when used, as BUILDDIR won't be defined yet
-TESTRUNNER = $(BUILDDIR)/test_testrunner$(EXEEXT)
+# Source files
+SRCDIR := src
+INCDIR := include/libwapcaplet
+SRC := $(SRCDIR)/libwapcaplet.c
+OBJ := $(SRC:.c=.o)
+LIB := lib$(COMPONENT).a
+PC_IN := libwapcaplet.pc.in
+PC := lib$(COMPONENT).pc

-# Toolchain flags
+# Compiler settings
+CC ?= clang
+AR ?= llvm-ar
+RANLIB ?= llvm-ranlib
+CFLAGS ?= -fPIC -O2
+
+# Our own compile flags (adapted from original NetSurf Makefile)
+# Note: removed -Werror for HarmonyOS compatibility (clang may emit
+# warnings that differ from GCC's)
 WARNFLAGS := -Wall -W -Wundef -Wpointer-arith -Wcast-align \
 	-Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes \
-	-Wmissing-declarations -Wnested-externs
-# BeOS/Haiku standard library headers issue warnings
-ifneq ($(BUILD),i586-pc-haiku)
-  WARNFLAGS := $(WARNFLAGS) -Werror
-endif
+	-Wmissing-declarations -Wnested-externs -Wno-error

-CFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE \
+COMPILE_CFLAGS := -D_BSD_SOURCE -D_DEFAULT_SOURCE -std=c99 \
 	-I$(CURDIR)/include/ -I$(CURDIR)/src \
 	$(WARNFLAGS) $(CFLAGS)
-ifneq ($(GCCVER),2)
-  CFLAGS := $(CFLAGS) -std=c99
-else
-  # __inline__ is a GCCism
-  CFLAGS := $(CFLAGS) -Dinline="__inline__"
-endif

-include $(NSBUILD)/Makefile.top
+# Targets
+.PHONY: all clean install uninstall

-ifeq ($(WANT_TEST),yes)
-  ifneq ($(PKGCONFIG),)
-    TESTCFLAGS := $(TESTCFLAGS) $(shell $(PKGCONFIG) --cflags check)
-    TESTLDFLAGS := $(TESTLDFLAGS) $(shell $(PKGCONFIG) --libs check)
-  else
-    TESTLDFLAGS := $(TESTLDFLAGS) -lcheck
-  endif
-endif
+all: $(LIB) $(PC)

-# Extra installation rules
-I := /$(INCLUDEDIR)/libwapcaplet
-INSTALL_ITEMS := $(INSTALL_ITEMS) $(I):include/libwapcaplet/libwapcaplet.h
-INSTALL_ITEMS := $(INSTALL_ITEMS) /$(LIBDIR)/pkgconfig:lib$(COMPONENT).pc.in
-INSTALL_ITEMS := $(INSTALL_ITEMS) /$(LIBDIR):$(OUTPUT)
+$(OBJ): $(SRC)
+	$(CC) $(COMPILE_CFLAGS) -c -o $@ $<
+
+$(LIB): $(OBJ)
+	$(AR) rcs $@ $(OBJ)
+	$(RANLIB) $@
+
+$(PC): $(PC_IN)
+	sed -e 's|PREFIX|$(PREFIX)|g' \
+	    -e 's|LIBDIR|$(LIBDIR)|g' \
+	    -e 's|INCLUDEDIR|$(INCLUDEDIR)|g' \
+	    -e 's|VERSION|$(COMPONENT_VERSION)|g' \
+	    $(PC_IN) > $(PC)
+
+clean:
+	rm -f $(OBJ) $(LIB) $(PC)
+
+install: all
+	mkdir -p $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig
+	mkdir -p $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/libwapcaplet
+	cp $(LIB) $(DESTDIR)$(PREFIX)/$(LIBDIR)/
+	cp $(PC) $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/
+	cp $(INCDIR)/libwapcaplet.h $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/libwapcaplet/
+
+uninstall:
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/$(LIB)
+	rm -f $(DESTDIR)$(PREFIX)/$(LIBDIR)/pkgconfig/$(PC)
+	rm -f $(DESTDIR)$(PREFIX)/$(INCLUDEDIR)/libwapcaplet/libwapcaplet.h
