diff -ruN /dev/null b/CMakeLists.txt
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,155 @@
+# ===========================================================
+# LibRaw 0.22.1 — self-contained CMake build for OHOS cross-compile.
+# Upstream 0.22.1 ships only Autotools (configure.ac/Makefile.am) with no
+# pre-generated configure script.  Autoreconf needs aclocal/automake which
+# are unavailable on OHOS CI workers.  This CMakeLists.txt replaces the
+# Autotools path entirely and is fully self-contained (no cmake/modules/).
+# pkg-config and CMake config files are generated by Conan (package_info),
+# NOT by CMake — keeps this file minimal and avoids template dependencies.
+# ===========================================================
+
+cmake_minimum_required(VERSION 3.12)
+
+# --- Version extraction from libraw/libraw_version.h ---
+file(READ "${CMAKE_CURRENT_SOURCE_DIR}/libraw/libraw_version.h" _vh)
+string(REGEX MATCH "#define LIBRAW_MAJOR_VERSION[ \t]*([0-9]+)" _m "${_vh}")
+set(_MAJ "${CMAKE_MATCH_1}")
+string(REGEX MATCH "#define LIBRAW_MINOR_VERSION[ \t]*([0-9]+)" _m "${_vh}")
+set(_MIN "${CMAKE_MATCH_1}")
+string(REGEX MATCH "#define LIBRAW_PATCH_VERSION[ \t]*([0-9]+)" _m "${_vh}")
+set(_PAT "${CMAKE_MATCH_1}")
+string(REGEX MATCH "#define LIBRAW_SHLIB_CURRENT[ \t]*([0-9]+)" _m "${_vh}")
+set(_CUR "${CMAKE_MATCH_1}")
+string(REGEX MATCH "#define LIBRAW_SHLIB_REVISION[ \t]*([0-9]+)" _m "${_vh}")
+set(_REV "${CMAKE_MATCH_1}")
+string(REGEX MATCH "#define LIBRAW_SHLIB_AGE[ \t]*([0-9]+)" _m "${_vh}")
+set(_AGE "${CMAKE_MATCH_1}")
+
+set(RAW_LIB_VERSION_STRING "${_MAJ}.${_MIN}.${_PAT}")
+set(RAW_LIB_SO_VERSION "${_CUR}.${_REV}.${_AGE}")
+
+project(libraw VERSION ${RAW_LIB_VERSION_STRING} LANGUAGES C CXX)
+
+include(GNUInstallDirs)
+
+option(BUILD_SHARED_LIBS "Build shared library" ON)
+option(ENABLE_EXAMPLES "Build sample command-line programs" ON)
+option(ENABLE_ZLIB "Enable zlib (deflate-compressed DNG) support" ON)
+option(ENABLE_JPEG "Enable libjpeg (lossy-compressed DNG) support" ON)
+
+# --- Source files (LibRaw 0.22: glob src/*.cpp, exclude stubs *_ph.cpp) ---
+file(GLOB_RECURSE _SRCS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp")
+file(GLOB_RECURSE _STUBS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/*_ph.cpp")
+list(REMOVE_ITEM _SRCS ${_STUBS})
+
+# --- System libraries ---
+find_library(MATH_LIBRARY m)
+find_package(Threads REQUIRED)
+
+# ============================================================================
+# raw — single-threaded library (LIBRAW_NOTHREADS define)
+# ============================================================================
+add_library(raw ${_SRCS})
+add_library(libraw::libraw ALIAS raw)
+target_compile_definitions(raw PRIVATE LIBRAW_NOTHREADS)
+if(NOT BUILD_SHARED_LIBS)
+    target_compile_definitions(raw PUBLIC LIBRAW_NODLL)
+endif()
+target_include_directories(raw PUBLIC
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/libraw>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>)
+if(MATH_LIBRARY)
+    target_link_libraries(raw PUBLIC ${MATH_LIBRARY})
+endif()
+set_target_properties(raw PROPERTIES
+    VERSION "${RAW_LIB_SO_VERSION}"
+    SOVERSION "${_CUR}"
+    OUTPUT_NAME "raw"
+    POSITION_INDEPENDENT_CODE ON)
+
+# ============================================================================
+# raw_r — reentrant / thread-safe library
+# ============================================================================
+add_library(raw_r ${_SRCS})
+add_library(libraw::libraw_r ALIAS raw_r)
+if(NOT BUILD_SHARED_LIBS)
+    target_compile_definitions(raw_r PUBLIC LIBRAW_NODLL)
+endif()
+target_include_directories(raw_r PUBLIC
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/libraw>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>)
+target_link_libraries(raw_r PUBLIC Threads::Threads)
+if(MATH_LIBRARY)
+    target_link_libraries(raw_r PUBLIC ${MATH_LIBRARY})
+endif()
+set_target_properties(raw_r PROPERTIES
+    VERSION "${RAW_LIB_SO_VERSION}"
+    SOVERSION "${_CUR}"
+    OUTPUT_NAME "raw_r"
+    POSITION_INDEPENDENT_CODE ON)
+
+# ============================================================================
+# Optional dependencies: zlib, libjpeg (provided by Conan CMakeDeps)
+# Controlled by ENABLE_ZLIB / ENABLE_JPEG options (forwarded from Conan).
+# ============================================================================
+if(ENABLE_ZLIB)
+    find_package(ZLIB REQUIRED)
+    target_link_libraries(raw PUBLIC ZLIB::ZLIB)
+    target_link_libraries(raw_r PUBLIC ZLIB::ZLIB)
+    target_compile_definitions(raw PUBLIC USE_ZLIB)
+    target_compile_definitions(raw_r PUBLIC USE_ZLIB)
+endif()
+
+if(ENABLE_JPEG)
+    find_package(JPEG REQUIRED)
+    target_link_libraries(raw PUBLIC JPEG::JPEG)
+    target_link_libraries(raw_r PUBLIC JPEG::JPEG)
+    target_compile_definitions(raw PUBLIC USE_JPEG USE_JPEG8)
+    target_compile_definitions(raw_r PUBLIC USE_JPEG USE_JPEG8)
+else()
+    # No JPEG: define NO_JPEG so dng.cpp uses empty stubs instead of
+    # pulling in <jpeglib.h> (avoids undefined jpeg_* symbols).
+    target_compile_definitions(raw PUBLIC NO_JPEG)
+    target_compile_definitions(raw_r PUBLIC NO_JPEG)
+endif()
+
+# ============================================================================
+# Install — headers + libraries (pkg-config/cmake-config handled by Conan)
+# ============================================================================
+install(FILES
+    "${CMAKE_CURRENT_SOURCE_DIR}/libraw/libraw.h"
+    "${CMAKE_CURRENT_SOURCE_DIR}/libraw/libraw_alloc.h"
+    "${CMAKE_CURRENT_SOURCE_DIR}/libraw/libraw_const.h"
+    "${CMAKE_CURRENT_SOURCE_DIR}/libraw/libraw_datastream.h"
+    "${CMAKE_CURRENT_SOURCE_DIR}/libraw/libraw_internal.h"
+    "${CMAKE_CURRENT_SOURCE_DIR}/libraw/libraw_types.h"
+    "${CMAKE_CURRENT_SOURCE_DIR}/libraw/libraw_version.h"
+    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/libraw")
+
+install(TARGETS raw raw_r
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+
+# ============================================================================
+# Examples (optional CLI tools)
+# ============================================================================
+if(ENABLE_EXAMPLES)
+    set(_samples
+        simple_dcraw.cpp mem_image_sample.cpp dcraw_emu.cpp
+        4channels.cpp unprocessed_raw.cpp raw-identify.cpp
+        multirender_test.cpp postprocessing_benchmark.cpp)
+    foreach(_s ${_samples})
+        string(REGEX REPLACE "\\..*$" "" _t "${_s}")
+        add_executable(${_t} "samples/${_s}")
+        target_link_libraries(${_t} PRIVATE raw)
+        install(TARGETS ${_t} RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+    endforeach()
+    # Thread-safe C samples
+    add_executable(dcraw_half samples/dcraw_half.c)
+    target_link_libraries(dcraw_half PRIVATE raw_r)
+    install(TARGETS dcraw_half RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+    add_executable(half_mt samples/half_mt.c)
+    target_link_libraries(half_mt PRIVATE raw_r)
+    install(TARGETS half_mt RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+endif()
