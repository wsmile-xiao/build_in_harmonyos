From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yinuoguo <yinuoguo@noreply.gitcode.com>
Date: Sat, 20 Sep 2026 00:00:00 +0000
Subject: [PATCH] Map upstream CMake dependency targets onto Conan registry packages

Upstream expects dependency CMake targets that the ohpcd registry
packages do not provide under those names:

- binarize links heatshrink::heatshrink_dynalloc (name from the bundled
  deps/heatshrink build). The registry heatshrink/0.4.1 exposes the two
  upstream flavors as heatshrink::dynamic / heatshrink::static instead.
  The dynalloc flavor is the exact equivalent (HEATSHRINK_DYNAMIC_ALLOC=1).
- convert links Boost::boost. The repo-local boost/1.90.0.4 recipe exports
  exactly Boost::boost (full upstream header tree incl. nowide), so no
  mapping is needed there.
- tests request the compiled Boost::nowide component, which no registry
  boost package builds. The tests only use boost::nowide::fopen, which is
  a header-only passthrough on POSIX/OHOS, so link Boost::boost and
  drop the COMPONENTS request. No test logic is modified.

diff --git a/src/LibBGCode/binarize/CMakeLists.txt b/src/LibBGCode/binarize/CMakeLists.txt
--- a/src/LibBGCode/binarize/CMakeLists.txt
+++ b/src/LibBGCode/binarize/CMakeLists.txt
@@ -36,7 +36,7 @@ target_include_directories(${_libname}_binarize
         $<INSTALL_INTERFACE:include>
 )

-target_link_libraries(${_libname}_binarize PRIVATE heatshrink::heatshrink_dynalloc ZLIB::ZLIB)
+target_link_libraries(${_libname}_binarize PRIVATE heatshrink::dynamic ZLIB::ZLIB)
 target_link_libraries(${_libname}_binarize PUBLIC ${_libname}_core)

 set(Binarize_DOWNSTREAM_DEPS ${Binarize_DOWNSTREAM_DEPS} PARENT_SCOPE)
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -2,7 +2,7 @@ find_package(Catch2 3.8 REQUIRED)

 include(Catch)

-find_package(Boost ${Boost_VER} REQUIRED COMPONENTS nowide)
+find_package(Boost ${Boost_VER} REQUIRED)

 if (MSVC)
     set_target_properties(Boost::nowide PROPERTIES MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release)
@@ -16,7 +16,7 @@ file(TO_NATIVE_PATH "${TEST_DATA_DIR}" TEST_DATA_DIR)
 add_library(test_common INTERFACE)
 target_include_directories(test_common INTERFACE ${CMAKE_CURRENT_LIST_DIR})
 target_compile_definitions(test_common INTERFACE TEST_DATA_DIR=R"\(${TEST_DATA_DIR}\)" CATCH_CONFIG_FAST_COMPILE)
-target_link_libraries(test_common INTERFACE Catch2::Catch2WithMain Boost::nowide)
+target_link_libraries(test_common INTERFACE Catch2::Catch2WithMain Boost::boost)

 if (EMSCRIPTEN)
     target_link_libraries(test_common INTERFACE nodefs.js noderawfs.js)
diff --git a/tests/convert/CMakeLists.txt b/tests/convert/CMakeLists.txt
--- a/tests/convert/CMakeLists.txt
+++ b/tests/convert/CMakeLists.txt
@@ -1,5 +1,5 @@
 add_executable(convert_tests convert_tests.cpp)

-target_link_libraries(convert_tests ${_libname}_convert test_common Boost::nowide)
+target_link_libraries(convert_tests ${_libname}_convert test_common Boost::boost)

 catch_discover_tests(convert_tests EXTRA_ARGS ${CATCH_EXTRA_ARGS})
