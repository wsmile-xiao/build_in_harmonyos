+# pybind11 is not part of the OHOS toolchain (no pybind11 package in the OHOS
+# registry); the module and the two tests that import it (realign, pyvcflib) are
+# kept behind the same guard, mirroring how the zig dependent test is handled.
+if(pybind11_FOUND)
+  pybind11_add_module(pyvcflib "${CMAKE_SOURCE_DIR}/src/pythonffi.cpp")
+  add_dependencies(pyvcflib ${vcflib_DEPS})
+  target_link_libraries(pyvcflib PUBLIC vcflib ${vcflib_LIBS} ${WFALIB})
+  install(TARGETS pyvcflib LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR})
+endif()
 
