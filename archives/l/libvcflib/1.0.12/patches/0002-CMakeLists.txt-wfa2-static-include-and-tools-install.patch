 #   message(STATUS "ERROR: Can not find wfa2lib! Make sure it is installed or use the git submodule instead")
 # endif()
 
-include_directories(${WFA_INCLUDE_DIRS})
+# The HarmonyOS/HMDFS file systems are case-insensitive: contrib/WFA2-lib/VERSION (a
+# plain version string) is matched by `#include <version>` and would shadow the C++17
+# standard header. -idirafter directories are searched after the compiler's own
+# include directories, so <version> keeps resolving to libc++ while the vendored
+# "wavefront/wfa.hpp" and "utils/*.h" includes still resolve from the WFA2 tree.
+if(WFA_GITMODULE)
+  set(EXTRA_WFA_INCLUDE "-idirafter ${CMAKE_SOURCE_DIR}/${WFA_INCLUDE_DIRS}")
+  set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${EXTRA_WFA_INCLUDE}")
+  set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${EXTRA_WFA_INCLUDE}")
+else()
+  include_directories(${WFA_INCLUDE_DIRS})
+endif()
 MESSAGE(STATUS "WFA using include ${WFA_INCLUDE_DIRS}")
 
