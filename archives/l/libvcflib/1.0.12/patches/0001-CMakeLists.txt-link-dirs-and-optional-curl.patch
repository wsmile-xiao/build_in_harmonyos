--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -22,7 +22,7 @@
 include(FindBZip2)
 include(FindLibLZMA)
 include(FindZLIB)
-include(FindCURL) # for htslib
+find_package(CURL) # for htslib (only needed when htslib itself is built with libcurl)
 
 feature_summary(
   FATAL_ON_MISSING_REQUIRED_PACKAGES
@@ -60,9 +60,18 @@
 pkg_check_modules(HTSLIB htslib)   # Optionally builds from contrib/
 pkg_check_modules(TABIXPP tabixpp) # Optionally builds from contrib/
 
+# pkg-config reports library directories and library names separately. The link line
+# below only consumes the names, which resolves against the linker's default search
+# path (e.g. /usr/lib) but not when the dependencies were installed elsewhere.
+link_directories(${HTSLIB_LIBRARY_DIRS} ${TABIXPP_LIBRARY_DIRS})
+
 # ---- Build switches
 set(CMAKE_POSITION_INDEPENDENT_CODE ON)
-set(CMAKE_INTERPROCEDURAL_OPTIMIZATION ${ipo_supported})
+# Interprocedural optimisation is disabled: with 85 executables every single link
+# re-runs thin-LTO code generation over the whole static library (measured ~19 s per
+# link, ~28 min in total), which does not fit the 3600 s build budget of a serial
+# (jobs=1) build.  Object code semantics are unchanged.
+set(CMAKE_INTERPROCEDURAL_OPTIMIZATION FALSE)
 
 if(NOT CMAKE_BUILD_TYPE)
   set(CMAKE_BUILD_TYPE Release CACHE STRING
@@ -421,9 +421,10 @@
   add_definitions(-DNO_ZIG=1)
 endif (ZIG)
 
-set(vcflib_DEPS
-  CURL::libcurl
-  )
+set(vcflib_DEPS)
+if(TARGET CURL::libcurl)
+  list(APPEND vcflib_DEPS CURL::libcurl)
+endif()
 
 if (ZIG)
   list(APPEND vcflib_DEPS ZIG-EXT)
@@ -435,7 +435,6 @@
 
 set(vcflib_LIBS
   ${HTSLIB_LIBRARIES}
-  ${CURL_LIBRARIES}
   ${ZLIB_LIBRARIES}
   ${LIBLZMA_LIBRARIES}
   ${BZIP2_LIBRARIES}
@@ -444,6 +444,9 @@
   ${WFA_LINK_LIBRARIES}
   ${HTSLIB_LINK_LIBRARIES}
 )
+if(TARGET CURL::libcurl)
+  list(APPEND vcflib_LIBS ${CURL_LIBRARIES})
+endif()
 
 if (ZIG)
   list(APPEND vcflib_LIBS ${ZIG_LINK_LIBRARIES})
