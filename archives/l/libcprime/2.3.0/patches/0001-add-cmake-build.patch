diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,90 @@
+cmake_minimum_required(VERSION 3.16)
+project(cprime VERSION 2.3.0 LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+set(CMAKE_AUTOMOC ON)
+set(CMAKE_AUTOUIC ON)
+
+find_package(Qt6 REQUIRED COMPONENTS Core Gui Widgets)
+
+set(CPRIME_SOURCES
+    cprime/settingsmanage.cpp
+    cprime/bookmarkmanage.cpp
+    cprime/bookmarkdialog.cpp
+    cprime/applicationdialog.cpp
+    cprime/desktopfile.cpp
+    cprime/properties.cpp
+    cprime/mimeutils.cpp
+    cprime/stringfunc.cpp
+    cprime/themefunc.cpp
+    cprime/sortfunc.cpp
+    cprime/validityfunc.cpp
+    cprime/appopenfunc.cpp
+    cprime/infofunc.cpp
+    cprime/filefunc.cpp
+    cprime/trashmanager.cpp
+)
+
+set(CPRIME_HEADERS
+    cprime/settingsmanage.h
+    cprime/bookmarkmanage.h
+    cprime/bookmarkdialog.h
+    cprime/applicationdialog.h
+    cprime/desktopfile.h
+    cprime/properties.h
+    cprime/mimeutils.h
+    cprime/stringfunc.h
+    cprime/cprime.h
+    cprime/themefunc.h
+    cprime/sortfunc.h
+    cprime/validityfunc.h
+    cprime/appopenfunc.h
+    cprime/infofunc.h
+    cprime/filefunc.h
+    cprime/trashmanager.h
+    libcprime_global.h
+)
+
+set(CPRIME_FORMS cprime/bookmarkdialog.ui)
+add_library(cprime SHARED ${CPRIME_SOURCES} ${CPRIME_HEADERS} ${CPRIME_FORMS})
+
+target_include_directories(cprime PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${CMAKE_CURRENT_SOURCE_DIR}/cprime
+)
+
+target_link_libraries(cprime PUBLIC Qt6::Core Qt6::Gui Qt6::Widgets)
+target_compile_definitions(cprime PRIVATE COREAPPS_THEME_FOLDER="${CMAKE_INSTALL_PREFIX}/share/coreapps/theme")
+
+set_target_properties(cprime PROPERTIES
+    VERSION ${PROJECT_VERSION}
+    SOVERSION ${PROJECT_VERSION_MAJOR}
+)
+
+# Install shared library
+install(TARGETS cprime
+    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION lib
+    RUNTIME DESTINATION bin
+)
+
+# Install headers to include/cprime/
+install(FILES ${CPRIME_HEADERS} DESTINATION include/cprime)
+
+# Install theme files (.qss and .ini)
+install(DIRECTORY theme/ DESTINATION share/coreapps/theme
+    FILES_MATCHING
+        PATTERN "*.qss"
+        PATTERN "*.ini"
+)
+# Install docs
+install(DIRECTORY docs/ DESTINATION share/coreapps/docs
+    FILES_MATCHING
+        PATTERN "ChangeLog"
+        PATTERN "ReleaseNotes"
+        PATTERN "To-Do.txt"
+)
+# Install LICENSE
+install(FILES LICENSE DESTINATION licenses)
