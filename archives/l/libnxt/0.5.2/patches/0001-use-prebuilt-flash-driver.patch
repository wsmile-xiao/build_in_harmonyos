--- a/meson.build
+++ b/meson.build
@@ -5,7 +5,14 @@
 
 usbdep = dependency('libusb-1.0')
 
-subdir('flash_write')
+# OHOS port: build runners have no bare-metal ARM toolchain, so the NXT-side
+# flash driver cannot be rebuilt from flash_write/flash.c here. Use the
+# upstream prebuilt driver instead (flash_write/flash.bin, provided by the
+# packaging recipe; same 136-byte driver upstream's SCons-era release
+# tarballs shipped and auto-downloaded as fallback, built from the same
+# sources). Upstream make_flash_header.py still generates flash_routine.h
+# from it below.
+flash_bin = files('flash_write/flash.bin')
 subdir('doc')
 
 prog_python = import('python').find_installation()
@@ -26,3 +33,6 @@
   flash_routine_h,
   dependencies : usbdep,
+  # OHOS port: meson >= 0.60 emits a thin archive (!<thin>) for an
+  # *uninstalled* static_library, which breaks conan packaging/consumers.
+  install : true,
 )
