--- a/config.guess
+++ b/config.guess
@@ -153,9 +153,34 @@
 	;;
 esac
 
+# OHOS cross build: when the selected compiler targets a OHOS triple,
+# report the same host an on-device HarmonyOS build reports, no matter
+# what the build machine's uname says.  Without this, building on a
+# generic Linux box resolves host to the *build* machine triplet, so
+# host_cpu/host_os differ from a native OHOS build and configure takes
+# different paths (e.g. the i386 port-I/O probes in configure.ac).
+ohos_target=`$CC_FOR_BUILD -dumpmachine 2>/dev/null`
+case "$ohos_target" in
+*-linux-ohos)
+    ohos_mach=`echo "$ohos_target" | sed 's/-.*//'`
+    echo "${ohos_mach}-unknown-linux-ohos"
+    exit ;;
+esac
+
 # Note: order is significant - the case branches are not exclusive.
 
 case "${UNAME_MACHINE}:${UNAME_SYSTEM}:${UNAME_RELEASE}:${UNAME_VERSION}" in
+    *:HarmonyOS:*:*)
+	case "$UNAME_MACHINE" in
+	    aarch64|arm64) MACHINE=aarch64 ;;
+	    armv7*|armv8*) MACHINE=arm ;;
+	    x86_64|amd64)  MACHINE=x86_64 ;;
+	    i?86)         MACHINE=i686 ;;
+	    *)            MACHINE="$UNAME_MACHINE" ;;
+	esac
+	GUESS=${MACHINE}-unknown-linux-ohos
+	;;
+
     *:NetBSD:*:*)
 	# NetBSD (nbsd) targets should (where applicable) match one or
 	# more of the tuples: *-*-netbsdelf*, *-*-netbsdaout*,
