diff --git a/lib/CMakeLists.txt b/lib/CMakeLists.txt
index 4daa663..cb2001a 100644
--- a/lib/CMakeLists.txt
+++ b/lib/CMakeLists.txt
@@ -4,10 +4,19 @@ include(CTest)
 
 if(BUILD_TESTING)
     if(NOT TARGET gtest)
-        if(IS_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/gtest)
+        if(EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/gtest/CMakeLists.txt)
             add_subdirectory(gtest EXCLUDE_FROM_ALL)
         else()
-            message(FATAL_ERROR "gtest submodule not found; please call git submodule update --init or disable the unit tests using -DBUILD_TESTING=OFF")
+            # conan recipe: gtest comes from a package instead of the git submodule
+            find_package(GTest REQUIRED)
+            if(NOT TARGET gtest)
+                add_library(gtest INTERFACE IMPORTED)
+                target_link_libraries(gtest INTERFACE GTest::gtest)
+            endif()
+            if(NOT TARGET gtest_main)
+                add_library(gtest_main INTERFACE IMPORTED)
+                target_link_libraries(gtest_main INTERFACE GTest::gtest_main)
+            endif()
         endif()
     endif()
 endif()
