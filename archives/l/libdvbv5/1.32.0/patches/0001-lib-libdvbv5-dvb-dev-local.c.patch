 static int dvb_local_stop_monitor(struct dvb_device_priv *dvb)
 {
 #ifdef HAVE_PTHREAD
 	struct dvb_dev_local_priv *priv = dvb->priv;
 
 	if (priv->notify_dev_change) {
-		pthread_cancel(priv->dev_change_id);
+		/* musl/OHOS does not provide pthread_cancel. The monitor loop
+		 * polls with a 1s timeout, so request a cooperative stop and
+		 * wait for the thread to observe it. */
