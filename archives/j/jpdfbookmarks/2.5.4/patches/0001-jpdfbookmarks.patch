 JAR_NAME=jpdfbookmarks.jar
 
 SCRIPT_DIR=$(cd $(dirname "$0"); pwd)
 
+# Support both source directory layout and installed layout
+# When installed: jar is in ../lib/jpdfbookmarks/, script is in bin/
+if [ -f "$SCRIPT_DIR/$JAR_NAME" ]; then
+  APP_DIR="$SCRIPT_DIR"
+else
+  APP_DIR="$SCRIPT_DIR/../lib/jpdfbookmarks"
+fi
+
 # ADD logging config file
