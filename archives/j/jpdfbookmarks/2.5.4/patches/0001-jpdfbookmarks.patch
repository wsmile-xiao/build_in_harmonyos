 if [ -n "$JAVA_HOME" ]; then
-  "$JAVA_HOME/bin/java" $JVM_OPTIONS -jar "$SCRIPT_DIR/$JAR_NAME" "$@"
+  "$JAVA_HOME/bin/java" $JVM_OPTIONS -jar "$APP_DIR/$JAR_NAME" "$@"
 else
-  java $JVM_OPTIONS -jar "$SCRIPT_DIR/$JAR_NAME" "$@"
+  java $JVM_OPTIONS -jar "$APP_DIR/$JAR_NAME" "$@"
