--- a/source/Makefile
+++ b/source/Makefile
@@ -20,6 +20,9 @@
 
 
 PREFIX = /usr/local
+# Parameterised: plain `install` (coreutils) is not on the PATH on
+# OpenHarmony; the toybox implementation lives at /bin/install.
+INSTALL ?= /bin/install
 SUFFIX := $(shell uname -m | sed -e 's/^unknown/$//' -e 's/^i.86/$//' -e 's/^x86_64/$/64/')
 LIBDIR = lib$(SUFFIX)
 SHARED = $(PREFIX)/share
@@ -37,15 +40,15 @@
 jnoise:	CPPFLAGS += -ffast-math
 jnoise:	LDLIBS += -ljack -lrt
 jnoise:	$(JNOISE_O)
-	g++ $(LDFLAGS) -o $@ $(JNOISE_O) $(LDLIBS)
+	$(CXX) $(LDFLAGS) -o $@ $(JNOISE_O) $(LDLIBS)
 
 $(JNOISE_O):
 -include $(JNOISE_O:%.o=%.d)
 
 
 install:	all
-	install -d $(DESTDIR)$(PREFIX)/bin
-	install -m 755 jnoise $(DESTDIR)$(PREFIX)/bin
+	$(INSTALL) -d $(DESTDIR)$(PREFIX)/bin
+	$(INSTALL) -m 755 jnoise $(DESTDIR)$(PREFIX)/bin
 
 clean:
 	/bin/rm -f *~ *.o *.a *.d *.so
