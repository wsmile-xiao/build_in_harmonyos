--- a/portability.h
+++ b/portability.h
@@ -13,15 +13,45 @@
     return t->compar(p1, p2, t->thunk);
 }
 
 #define QSORT(base, nmemb, size, cmp, arg)      \
     struct bsdarg thunk = {                     \
         .compar = (cmp),                        \
         .thunk = (arg)                          \
     };                                          \
     qsort_r(base, nmemb, size, &thunk, cmpbsd)
 #else
+/* OHOS adaptation: this branch calls the GNU (glibc) flavour of qsort_r, whose
+ * comparator receives the user context as its last argument. OHOS ships musl
+ * libc, which does not export that flavour, so the link fails with
+ * "ld.lld: error: undefined symbol: qsort_r". For non-glibc targets provide an
+ * equivalent implementation on top of plain qsort; the comparator and its
+ * context are kept in file-static storage, which is safe here because jomon is
+ * a single-threaded process. */
+#ifndef __GLIBC__
+#include <stdlib.h>
+
+static int (*qsort_r_compar)(const void *, const void *, void *);
+static void *qsort_r_compar_arg;
+
+static int qsort_r_compar_trampoline(const void *p1, const void *p2)
+{
+    return qsort_r_compar(p1, p2, qsort_r_compar_arg);
+}
+
+static inline void jomon_qsort_r(void *base, size_t nmemb, size_t size,
+                                 int (*compar)(const void *, const void *, void *),
+                                 void *arg)
+{
+    qsort_r_compar = compar;
+    qsort_r_compar_arg = arg;
+    qsort(base, nmemb, size, qsort_r_compar_trampoline);
+}
+
+#define qsort_r jomon_qsort_r
+#endif
+
 #define QSORT(base, nmemb, size, cmp, arg) \
     qsort_r(base, nmemb, size, cmp, arg)
 #endif
 
 #endif
