--- /dev/null
+++ b/Include/jsonifier/Compat/SourceLocation.hpp
@@ -0,0 +1,36 @@
+// OHOS libcxx-ohos (clang-15 SDK) 缺失标准 <source_location>
+// 提供最小 shim：API 与 std::source_location 完全一致（file_name/function_name/line/column/current）。
+// 若上游标准库存在则由其提供，否则使用本实现（基于 clang 内建 __builtin_FILE/FUNCTION/LINE）。
+#pragma once
+
+#if __has_include(<source_location>)
+	#include <source_location>
+#else
+	#include <cstdint>
+
+	namespace std {
+		class source_location {
+		  public:
+			static constexpr source_location current(const char* file = __builtin_FILE(),
+													 const char* function = __builtin_FUNCTION(),
+													 const std::uint_least32_t line = __builtin_LINE()) noexcept {
+				source_location result{};
+				result.file_ = file;
+				result.function_ = function;
+				result.line_ = line;
+				return result;
+			}
+			constexpr source_location() noexcept = default;
+
+			constexpr const char* file_name() const noexcept { return file_; }
+			constexpr const char* function_name() const noexcept { return function_; }
+			constexpr std::uint_least32_t line() const noexcept { return line_; }
+			constexpr std::uint_least32_t column() const noexcept { return 0; }
+
+		  private:
+			const char* file_ { "unknown" };
+			const char* function_ { "unknown" };
+			std::uint_least32_t line_ { 0 };
+		};
+	}	 // namespace std
+#endif
