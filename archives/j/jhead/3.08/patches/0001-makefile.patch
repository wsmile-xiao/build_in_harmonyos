-CFLAGS:=$(shell dpkg-buildflags --get CFLAGS)
-LDFLAGS:=$(shell dpkg-buildflags --get LDFLAGS)
-endif
+LDFLAGS=-fuse-ld=/data/service/hnp/binutils.org/binutils_2.45/bin/ld.bfd
 
 # To enable electric fence, set ELECTRIC_FENCE=1
 ifeq ($(ELECTRIC_FENCE),1)
 CFLAGS += -fsanitize=address
 LDFLAGS += -fsanitize=address
 endif
 
 all: objdir jhead
 
 docs = $(SRC)/usage.html
@@ -33,14 +30,14 @@
 $(OBJ)/%.o:$(SRC)/%.c objdir
 	${CC} $(CFLAGS) $(CPPFLAGS) -c $< -o $@
 
 jhead: $(objs) jhead.h
 	${CC} $(LDFLAGS) -o jhead $(objs) -lm
 
 clean:
 	rm -f $(objs) jhead
 
 install: all
-	install -d $(BINDIR) $(DOCDIR) $(MANDIR)
-	install -m 0755 jhead $(BINDIR)
-	install -m 0644 $(docs) $(DOCDIR)
-	install -m 0644 jhead.1 $(MANDIR)
+	install -d $(DESTDIR)$(BINDIR) $(DESTDIR)$(DOCDIR) $(DESTDIR)$(MANDIR)
+	install -m 0755 jhead $(DESTDIR)$(BINDIR)
+	install -m 0644 $(docs) $(DESTDIR)$(DOCDIR)
+	install -m 0644 jhead.1 $(DESTDIR)$(MANDIR)
