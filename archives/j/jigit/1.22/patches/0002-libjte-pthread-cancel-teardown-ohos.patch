--- a/libjte/checksum.c
+++ b/libjte/checksum.c
@@ -328,7 +328,23 @@
         if (a->thread)
         {
             void *ret;
-            pthread_cancel(a->thread);
+            /* musl libc, which OpenHarmony uses, does not implement the POSIX
+             * thread cancellation API, so pthread_cancel() cannot be linked
+             * here.  Ask the worker to stop through the quit protocol this
+             * file already defines instead: checksum_thread() leaves its
+             * condition wait as soon as buf is non-NULL and returns through
+             * pthread_exit() when len is zero.  That keeps both halves of the
+             * original behaviour -- the worker exits on purpose and the
+             * caller still reclaims it with pthread_join() -- which a no-op
+             * stub or a dropped join would break.  The buffer pointer below
+             * is only a non-NULL token; it is never dereferenced, because the
+             * zero length makes the worker break before calling update().
+             */
+            pthread_mutex_lock(&a->start_mutex);
+            a->len = 0;
+            a->buf = (unsigned char const *)a;
+            pthread_cond_signal(&a->start_cv);
+            pthread_mutex_unlock(&a->start_mutex);
             pthread_join(a->thread, &ret);
             a->thread = 0;
         }
