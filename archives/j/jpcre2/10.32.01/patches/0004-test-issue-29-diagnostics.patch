--- a/src/test_issue_29.cpp
+++ b/src/test_issue_29.cpp
@@ -25,7 +25,14 @@
     assert(matches[0][2] != "dummy"); // idx 2 should be accessible
     assert(matches[0][3] != "dummy"); // idx 3 should be accessible
     try{
-        assert(matches[0].at(4) != "dummy"); // idx 4 should not be accessible
+        // Do not wrap the bounds check in assert(): assert() is a no-op
+        // under NDEBUG (Release), so the .at() access and its expected
+        // std::out_of_range would vanish and the test would falsely fail.
+        // Evaluate .at() unconditionally; keep an assert on the value for
+        // Debug builds.
+        std::string const unexpected = matches[0].at(4);
+        assert(unexpected != "dummy"); // idx 4 should not be accessible
+        (void)unexpected;
     } catch(std::out_of_range const & e){
         out_of_range_occured = true;
     }
