From a9c6d1ff90c6dd0a45df50d5fa474bf8d8c0e65 Mon Sep 17 00:00:00 2001
From: j669539 <j669539@noreply.gitcode.com>
Date: 2026-10-08
Subject: [PATCH] Makefile: fix HMDFS symlink compatibility (ln -sf -> rm -f && ln -s)

OpenHarmony PC (HarmonyOS) HMDFS filesystem does not support `ln -sf`
overwriting an existing symlink target atomically: when the destination
symlink already exists, `ln -sf` fails on HMDFS while it succeeds on
ext4/tmpfs. Replace the two `ln -sf` rules with `rm -f $@ && ln -s $< $@`
so that repeated builds (and the %.so / %.so.$(SOVERSION) rules) work
on HMDFS-backed workspaces.

This is the same portability fix already shipped for jsonnet v0.20.0
in this repository (patches/0001-Makefile.patch of v0.20.0), re-based
onto the v0.21.0 Makefile.
---
 Makefile | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index 1111111..2222222 100644
--- a/Makefile
+++ b/Makefile
@@ -177,10 +177,10 @@ libjsonnet++.so.$(VERSION): $(LIB_CPP_OBJ)
 	$(CXX) $(LDFLAGS) $(LIB_CPP_OBJ) $(SHARED_LDFLAGS) -Wl,$(SONAME),libjsonnet++.so.$(SOVERSION) -o $@

 %.so.$(SOVERSION): %.so.$(VERSION)
-	ln -sf $< $@
+	rm -f $@ && ln -s $< $@

 %.so: %.so.$(SOVERSION)
-	ln -sf $< $@
+	rm -f $@ && ln -s $< $@

 # Tests for C binding.
 LIBJSONNET_TEST_SNIPPET_SRCS = \
--
2.25.1

