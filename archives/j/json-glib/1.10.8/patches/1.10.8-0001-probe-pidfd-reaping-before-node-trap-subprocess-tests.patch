+      return;
+    }
+#endif
   if (g_test_subprocess ())
     {
       JsonNode *node = NULL;
@@ -462,6 +557,13 @@ test_immutable_string (void)
 static void
 test_immutable_object (void)
 {
+#ifdef G_OS_UNIX
