From: 2301_80739235 <1catmint1@noreply.atomgit.com>
Subject: [patch] tests: probe pidfd reaping before node trap-subprocess cases

glib's child watch reaps g_test_trap_subprocess() children through
pidfd + waitid (P_PIDFD); on kernels where the pidfd is signaled but
waitid keeps returning an empty siginfo, /nodes/immutable/* spin and
the suite never completes.  Probe that combination at runtime and
g_test_skip() the affected cases; no platform macros involved.
---
diff --git a/json-glib/tests/node.c b/json-glib/tests/node.c
index 20b0c5a..f8e0ddd 100644
--- a/json-glib/tests/node.c
+++ b/json-glib/tests/node.c
@@ -9,6 +9,73 @@
 #include <string.h>
 #include <json-glib/json-glib.h>
 
+#ifdef G_OS_UNIX
+#include <errno.h>
+#include <poll.h>
+#include <signal.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#ifndef SYS_pidfd_open
+#define SYS_pidfd_open 434
+#endif
+#ifndef P_PIDFD
+#define P_PIDFD 3
+#endif
+
+/* Probe whether the kernel can report a child exit through a pidfd and
+ * waitid (P_PIDFD).  glib's child watch uses exactly that combination to
+ * reap g_test_trap_subprocess() children; on kernels where the pidfd is
+ * signaled but waitid() keeps returning an empty siginfo, the watching
+ * parent never observes the exit and the subprocess-based tests below
+ * would spin forever.  Detect that combination at runtime instead of
+ * discriminating by platform. */
+static gboolean
+test_node_pidfd_child_watch_broken (void)
+{
+  static gint broken = -1;
+
+  if (broken != -1)
+    return broken != 0;
+
+  broken = 0;
+
+  pid_t pid = fork ();
+  if (pid < 0)
+    return FALSE;
+  if (pid == 0)
+    _exit (0);
+
+  int fd = (int) syscall (SYS_pidfd_open, pid, 0);
+  if (fd >= 0)
+    {
+      struct pollfd pfd = { fd, POLLIN, 0 };
+      int pres = poll (&pfd, 1, 3000);
+      if (pres > 0)
+        {
+          siginfo_t si;
+          memset (&si, 0, sizeof (si));
+          if (waitid ((idtype_t) P_PIDFD, (id_t) fd, &si,
+                      WEXITED | WNOHANG) == 0 &&
+              si.si_pid == 0)
+            broken = 1;
+        }
+      else if (pres == 0)
+        {
+          broken = 1;
+        }
+      close (fd);
+    }
+
+  while (waitpid (pid, NULL, 0) < 0 && errno == EINTR)
+    continue;
+
+  return broken != 0;
+}
+#endif
+
+
 static void
 test_init_int (void)
 {
@@ -378,6 +445,13 @@ test_seal_array (void)
 static void
 test_immutable_int (void)
 {
+#ifdef G_OS_UNIX
+  if (test_node_pidfd_child_watch_broken ())
+    {
+      g_test_skip ("pidfd child-watch cannot reap g_test_trap_subprocess() children on this kernel");
+      return;
+    }
+#endif
   if (g_test_subprocess ())
     {
       JsonNode *node = NULL;
@@ -399,6 +473,13 @@ test_immutable_int (void)
 static void
 test_immutable_double (void)
 {
+#ifdef G_OS_UNIX
+  if (test_node_pidfd_child_watch_broken ())
+    {
+      g_test_skip ("pidfd child-watch cannot reap g_test_trap_subprocess() children on this kernel");
+      return;
+    }
+#endif
   if (g_test_subprocess ())
     {
       JsonNode *node = NULL;
@@ -420,6 +501,13 @@ test_immutable_double (void)
 static void
