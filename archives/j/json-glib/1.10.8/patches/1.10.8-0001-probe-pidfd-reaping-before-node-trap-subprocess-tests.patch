+#endif
   if (g_test_subprocess ())
     {
       JsonNode *node = NULL;
@@ -441,6 +529,13 @@ test_immutable_boolean (void)
 static void
 test_immutable_string (void)
 {
+#ifdef G_OS_UNIX
