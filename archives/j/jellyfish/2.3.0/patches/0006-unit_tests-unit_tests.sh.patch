--- a/unit_tests/unit_tests.sh
+++ b/unit_tests/unit_tests.sh
@@ -3,8 +3,19 @@
 cd tests
 . ../compat.sh
 
+# TmpPipes.* and GeneratorManager.OneLiners drive jellyfish::tmp_pipes, which
+# needs mkfifo(2).  HarmonyOS rejects it with EPERM, so drop only those three
+# cases where named pipes are missing; every other unit test still runs.
+GTEST_FILTER=
+jf_fifo_probe=./jf13942-fifo-$$
+if ! mkfifo "$jf_fifo_probe" 2>/dev/null; then
+    echo "Named pipes unavailable: excluding mkfifo-based gtest cases"
+    GTEST_FILTER="--gtest_filter=-TmpPipes.*:GeneratorManager.OneLiners"
+fi
+rm -f "$jf_fifo_probe"
+
 if [ -n "$VALGRIND" ]; then
-    exec valgrind ${DIR}/test_all
+    exec valgrind ${DIR}/test_all $GTEST_FILTER
 else
-    exec ${DIR}/test_all
+    exec ${DIR}/test_all $GTEST_FILTER
 fi
