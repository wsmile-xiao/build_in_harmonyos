+  // /tmp (P_tmpdir) is a read-only mount on HarmonyOS PC, so try TMPDIR first
+  // and fall back to the build directory, like jellyfish::tmp_pipes does.
+  static char* make_tmpdir() {
+    static const char* const candidates[] = { getenv("TMPDIR"), "/tmp", "." };
+    for(size_t i = 0; i < sizeof(candidates) / sizeof(candidates[0]); ++i) {
+      if(!candidates[i])
+        continue;
+      std::string path = std::string(candidates[i]) + "/stream_iterator_XXXXXX";
+      char* dir = strdup(path.c_str());
+      if(mkdtemp(dir))
+        return dir;
+      free(dir);
+    }
+    throw std::runtime_error(err::msg() << "Failed to create tmp directory: " << err::no);
+  }
