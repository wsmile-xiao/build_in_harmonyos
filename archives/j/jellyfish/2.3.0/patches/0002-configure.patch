--- a/configure
+++ b/configure
@@ -16685,6 +16685,20 @@
 
 fi
 
+# The upstream test suite calls "unix2dos -n <in> <out>".  Not every
+# unix2dos implements -n (toybox on HarmonyOS exits 1 on it), which would
+# make tests/generate_sequence.sh fail under "set -e".  Keep UNIX2DOS only
+# when the option really works.
+if test -n "$UNIX2DOS"; then
+  as_unix2dos_probe="conftest-unix2dos-$$"
+  if ! "$UNIX2DOS" -n /dev/null "$as_unix2dos_probe" >/dev/null 2>&1; then
+    { $as_echo "$as_me:${as_lineno-$LINENO}: result: unix2dos lacks -n, disabling DOS line ending tests" >&5
+$as_echo "$as_me: result: unix2dos lacks -n, disabling DOS line ending tests" >&6;}
+    UNIX2DOS=
+  fi
+  rm -f "$as_unix2dos_probe"
+fi
+
 # Check for md5 or md5sum
 
 if test "x$MD5" = "x"; then :
@@ -20023,12 +20037,12 @@
 # Create a (secure) tmp directory for tmp files.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 022 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 022 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
