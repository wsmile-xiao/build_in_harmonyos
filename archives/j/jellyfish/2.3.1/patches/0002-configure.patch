+# The test suite uses "unix2dos -n <in> <out>". Some implementations
+# (e.g. toybox on HarmonyOS) provide an incompatible command line.
+# Disable the unix2dos-dependent test steps when the option is not
+# supported, so that the tests remain portable.
+if test -n "$UNIX2DOS"; then
+  printf 'unix2dos probe\n' > "conf-unix2dos-in-$$"
+  if ! "$UNIX2DOS" -n "conf-unix2dos-in-$$" "conf-unix2dos-out-$$" >/dev/null 2>&1; then
+    UNIX2DOS=
+  fi
+  rm -f "conf-unix2dos-in-$$" "conf-unix2dos-out-$$"
+fi
