--- a/unit_tests/unit_tests.sh
+++ b/unit_tests/unit_tests.sh
@@ -1,10 +1,21 @@
 #! /bin/sh
 
 cd tests
 . ../compat.sh
 
+# Named pipes (mkfifo) are not supported on all platforms (e.g. HarmonyOS
+# denies their creation with EPERM). Exclude the test cases that need them.
+GTEST_FILTER=
+fifo_probe=./fifo_probe.$$
+if ! mkfifo "$fifo_probe" 2>/dev/null; then
+    echo "Named pipes (mkfifo) not available; excluding FIFO-based test cases"
+    GTEST_FILTER="--gtest_filter=-TmpPipes.*:GeneratorManager.OneLiners"
+else
+    rm -f "$fifo_probe"
+fi
+
 if [ -n "$VALGRIND" ]; then
-    exec valgrind ${DIR}/test_all
+    exec valgrind ${DIR}/test_all $GTEST_FILTER
 else
-    exec ${DIR}/test_all
+    exec ${DIR}/test_all $GTEST_FILTER
 fi
