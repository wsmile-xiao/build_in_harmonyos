diff --git a/lib/jekyll.rb b/lib/jekyll.rb
index 231f8fd..e0034c6 100644
--- a/lib/jekyll.rb
+++ b/lib/jekyll.rb
@@ -192,4 +192,12 @@ require_all "jekyll/drops"
 require_all "jekyll/generators"
 require_all "jekyll/tags"
 
-require "jekyll-sass-converter"
+begin
+  require "jekyll-sass-converter"
+rescue LoadError => e
+  # jekyll-sass-converter -> sass-embedded -> google-protobuf, all C
+  # extensions. On platforms where C extensions cannot be loaded (OHOS,
+  # and the CI worker), let jekyll itself load anyway; SCSS support is
+  # then unavailable (declared in notes.md / manifest.yaml).
+  warn "[jekyll] jekyll-sass-converter unavailable: #{e.message}; SCSS support disabled"
+end
