@@ -15,6 +15,18 @@
 #define __JNX_TIMESTR_H__
 
 /*
+ * The traditional __P() prototype macro comes from glibc (sys/cdefs.h).
+ * OHOS libc does not provide it, so define the standard fallback here.
+ */
+#if !defined(__P)
+# if defined(__STDC__) || defined(__cplusplus)
+#  define __P(args) args
+# else
+#  define __P(args) ()
+# endif
+#endif
+
+/*
  * Use C linkage when using a C++ compiler
  */
 #ifdef __cplusplus
