diff --git a/configure.ac b/configure.ac
index aae5ccd..bd5b5be 100644
--- a/configure.ac
+++ b/configure.ac
@@ -36,6 +36,22 @@ LIBXSLT_REQUIRED_VERSION=1.1.26
 LIBSLAX_REQUIRED_VERSION=0.22.0
 
 AC_PROG_CC
+
+dnl The global _res resolver state is not part of the POSIX API.  Some
+dnl libcs (e.g. musl-based OHOS libc) neither declare _res in <resolv.h>
+dnl nor export the symbol, so libjuise's retrans/retry tuning must only
+dnl be compiled where the declaration exists.  Probe for it at configure
+dnl time (feature detection, not a platform macro); when absent the
+dnl caller uses gethostbyaddr directly.
+AC_CHECK_DECL([_res],
+  [AC_DEFINE([HAVE_DECL__RES], 1,
+    [Define to 1 if _res is declared in <resolv.h>])],
+  [],
+  [#include <sys/types.h>
+   #include <netinet/in.h>
+   #include <arpa/nameser.h>
+   #include <resolv.h>])
+
 AM_PROG_AR
 AC_PROG_INSTALL
 AC_CONFIG_MACRO_DIR([m4])
