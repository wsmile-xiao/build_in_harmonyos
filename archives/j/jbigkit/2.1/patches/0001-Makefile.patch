diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,40 +1,53 @@
 # Unix makefile for JBIG-KIT
 
 # Select an ANSI/ISO C compiler here, GNU gcc is recommended
-CC = gcc
+#ifdef __OHOS__
+CC = clang
+#else
+#CC = gcc
+#endif
 
 # Options for the compiler: A high optimization level is suggested
-CFLAGS = -O2 -W -Wno-unused-result
+CFLAGS = -fPIC -O2 -W -Wno-unused-result
 # CFLAGS = -O -g -W -Wall -Wno-unused-result -ansi -pedantic # -DDEBUG
 
 export CC CFLAGS
 
+PREFIX ?= /usr/local
 VERSION=2.1
 
 all: lib pbm
 	@echo "Enter 'make test' in order to start some automatic tests."
 
 lib:
 	cd libjbig && $(MAKE) -e
 
 pbm: lib
 	cd pbmtools && $(MAKE) -e
 
 test: lib pbm
 	cd libjbig  && $(MAKE) test
 	cd pbmtools && $(MAKE) test
 
 analyze:
 	cd libjbig  && $(MAKE) analyze
 	cd pbmtools && $(MAKE) analyze
 
+install: lib pbm
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	mkdir -p $(DESTDIR)$(PREFIX)/lib
+	mkdir -p $(DESTDIR)$(PREFIX)/include
+	cp pbmtools/pbmtojbg pbmtools/jbgtopbm pbmtools/pbmtojbg85 pbmtools/jbgtopbm85 $(DESTDIR)$(PREFIX)/bin/
+	cp libjbig/libjbig.a libjbig/libjbig85.a $(DESTDIR)$(PREFIX)/lib/
+	cp libjbig/jbig.h libjbig/jbig85.h libjbig/jbig_ar.h $(DESTDIR)$(PREFIX)/include/
+
 clean:
 	rm -f *~ core
 	cd libjbig  && $(MAKE) clean
 	cd pbmtools && $(MAKE) clean
 
 distribution:
 	rm -rf jbigkit-$(VERSION)
 	git archive v$(VERSION) --prefix jbigkit-$(VERSION)/ | tar xvf -
 	make -C jbigkit-$(VERSION)/pbmtools txt
 	tar cvaf jbigkit-$(VERSION).tar.gz jbigkit-$(VERSION)
