--- configure.orig	2006-04-29 21:34:00.000000000 +0000
+++ configure	2026-06-12 10:52:00.000000000 +0000
@@ -XXX,XX +XXX,XX @@
-tmp=`(umask 077 && mktemp -d -q "./confstatXXXXXX") 2>/dev/null` &&
-  (umask 077 && mkdir $tmp)
+tmp=`(umask 022 && mktemp -d -q "./confstatXXXXXX") 2>/dev/null` &&
+  (umask 022 && mkdir $tmp)

 # HMDFS workaround: autotools的mktemp -d在HMDFS文件系统上
 # 需要更宽松的umask设置才能创建临时目录。
 # 解决方案：修改umask从077改为022