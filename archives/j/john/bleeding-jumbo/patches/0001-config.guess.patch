diff -ruN a/config.guess b/config.guess
--- a/config.guess
+++ b/config.guess
@@ -75,20 +75,31 @@
        echo "$me: invalid option $1$help" >&2
        exit 1 ;;
     * )
        break ;;
   esac
 done
 
 if test $# != 0; then
   echo "$me: too many arguments$help" >&2
   exit 1
+fi
+
+# HarmonyOS detection - early return
+if test "`uname -s`" = "HarmonyOS" ; then
+  case "`uname -m`" in
+    aarch64) echo "aarch64-linux-ohos" ; exit ;;
+    arm*)    echo "arm-linux-ohos" ; exit ;;
+    x86_64)  echo "x86_64-linux-ohos" ; exit ;;
+    i*86)    echo "i686-linux-ohos" ; exit ;;
+    *)       echo "`uname -m`-linux-ohos" ; exit ;;
+  esac
 fi
 
 trap 'exit 1' 1 2 15
 
