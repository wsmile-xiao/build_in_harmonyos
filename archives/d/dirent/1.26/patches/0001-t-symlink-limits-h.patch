--- a/tests/t-symlink.c
+++ b/tests/t-symlink.c
@@ -15,6 +15,7 @@
 #include <string.h>
 #include <locale.h>
 #include <time.h>
+#include <limits.h>
 #include <dirent.h>
 #include <sys/stat.h>
 #include <fcntl.h>
@@ -203,8 +204,28 @@
 	assert(i > 0);
 	assert(tmpdir[i - 1] == '\\');
 #else
-	strcpy(tmpdir, "/tmp/");
-	i = strlen(tmpdir);
+	{
+		/* Honor $TMPDIR when set; fall back to /tmp.  On HarmonyOS PC the
+		 * /tmp mount is read-only, so tests must use a writable temp dir
+		 * (the OHOS test environment sets TMPDIR to a writable location). */
+		const char *td = getenv("TMPDIR");
+		if (td != NULL && *td != '\0') {
+			size_t len = strlen(td);
+			if (len + 1 < (size_t) PATH_MAX) {
+				memcpy(tmpdir, td, len);
+				if (td[len - 1] != '/')
+					tmpdir[len++] = '/';
+				tmpdir[len] = '\0';
+				i = (int) len;
+			} else {
+				strcpy(tmpdir, "/tmp/");
+				i = strlen(tmpdir);
+			}
+		} else {
+			strcpy(tmpdir, "/tmp/");
+			i = strlen(tmpdir);
+		}
+	}
 #endif
 
 	/* Append random directory name to path name */
