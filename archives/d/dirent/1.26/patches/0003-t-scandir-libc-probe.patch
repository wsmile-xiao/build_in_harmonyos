@@ -21,6 +21,81 @@
 #include <errno.h>
 #include <time.h>
 #include <limits.h>
+#include <ctype.h>
+
+/* OHOS 运行时 libc (musl) 不提供 GNU versionsort()/strverscmp() 扩展；
+ * dirent 自带可移植实现（include/dirent.h 中 versionsort 即 strverscmp
+ * 的比较包装），这里通过 libc 探针兜底，使上游 t-scandir.c 能在 OHOS 上
+ * 真实编译链接并执行全部断言。 */
+#if !defined(__GLIBC__) && !defined(_MSC_VER)
+static int
+dirent_portable_strverscmp(const char *a, const char *b)
+{
+	size_t i = 0;
+	size_t j;
+
+	/* Find first difference */
+	while (a[i] == b[i]) {
+		if (a[i] == '\0') {
+			/* No difference */
+			return 0;
+		}
+		++i;
+	}
+
+	/* Count backwards and find the leftmost digit */
+	j = i;
+	while (j > 0 && isdigit(a[j-1])) {
+		--j;
+	}
+
+	/* Determine mode of comparison */
+	if (a[j] == '0' || b[j] == '0') {
+		/* Find the next non-zero digit */
+		while (a[j] == '0' && a[j] == b[j]) {
+			j++;
+		}
+
+		/* String with more digits is smaller, e.g 002 < 01 */
+		if (isdigit(a[j])) {
+			if (!isdigit(b[j])) {
+				return -1;
+			}
+		} else if (isdigit(b[j])) {
+			return 1;
+		}
+	} else if (isdigit(a[j]) && isdigit(b[j])) {
+		/* Numeric comparison */
+		size_t k1 = j;
+		size_t k2 = j;
+
+		/* Compute number of digits in each string */
+		while (isdigit(a[k1])) {
+			k1++;
+		}
+		while (isdigit(b[k2])) {
+			k2++;
+		}
+
+		/* Number with more digits is bigger, e.g 999 < 1000 */
+		if (k1 < k2)
+			return -1;
+		else if (k1 > k2)
+			return 1;
+	}
+
+	/* Alphabetical comparison */
+	return (int) ((unsigned char) a[i]) - ((unsigned char) b[i]);
+}
+
+static int
+dirent_portable_versionsort(const struct dirent **a, const struct dirent **b)
+{
+	return dirent_portable_strverscmp((*a)->d_name, (*b)->d_name);
+}
+
+#define versionsort dirent_portable_versionsort
+#endif
 
