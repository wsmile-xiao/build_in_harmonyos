 template <>
 void stream::Stream<ByteVectorSink>::Write(stream::Sink* sink, const ByteVectorSink& vec) {
     // For nested sinks, we do not record the length, and just copy the data so that it
     // appears flattened.
     size_t size = vec.size();
     if (size > 0) {
-        std::ranges::copy(vec, sink->GetSpace(size).begin());
+        std::copy(vec.begin(), vec.end(), sink->GetSpace(size).begin());
     }
 }
 
 std::ostream& operator<<(std::ostream& os, const ByteVectorSink& vec) {
     os << std::hex;
     for (const std::byte b : vec) {
         os << std::setfill('0') << std::setw(2) << static_cast<int>(b) << " ";
     }
     os << std::dec;
     return os;
