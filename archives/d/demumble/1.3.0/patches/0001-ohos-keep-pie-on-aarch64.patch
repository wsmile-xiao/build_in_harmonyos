From e82c4520107ab87460c92a65d2b0e8b090b3f742 Mon Sep 17 00:00:00 2001
From: OpenHarmony PC Developer <openharmony@example.invalid>
Date: Thu, 10 Sep 2026 15:20:00 +0800
Subject: [PATCH] ohos: keep position-independent executable defaults

Source-Commit: e82c4520107ab87460c92a65d2b0e8b090b3f742
Modification-Layer: CMakeLists.txt
Knowledge-Ref: knowledge/operations/build-systems.md#4-cmake-adaptation

The upstream non-Apple UNIX branch forces both -fno-PIC and -no-pie.  Those
flags produce unaligned R_AARCH64_LDST64_ABS_LO12_NC relocations when linked
with the HarmonyOS aarch64 SDK.  Keep the SDK's PIE/PIC defaults on OHOS while
preserving upstream behavior on every other platform.
---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 77d50d5..49d1016 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,7 +12,7 @@ if (UNIX)
   # to libc++ and ld64 defaults to stripping __TEXT,__eh_frame.
   if (APPLE)
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -mmacosx-version-min=10.9")
-  else()
+  elseif (NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS")
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fno-PIC")
     set(CMAKE_EXE_LINKER_FLAGS  "${CMAKE_EXE_LINKER_FLAGS} -no-pie")
   endif()
