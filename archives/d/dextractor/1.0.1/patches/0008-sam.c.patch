 #define CHECK(cond, msg)				\
 { if ((cond))						\
     { fprintf(stderr, "%s: %s\n", Prog_Name, msg);	\
        return (-1);					\
     }							\
 }
 
 #define NEXT_ITEM(b,e)					\
 { b = e;						\
   while (*e != '\0' && *e != '\t')			\
     e++;						\
   CHECK( *e == '\0', "Missing one or more fields")	\
   *e = 0;						\
 }
 
