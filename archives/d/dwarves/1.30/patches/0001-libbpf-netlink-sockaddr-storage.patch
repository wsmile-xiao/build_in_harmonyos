--- a/lib/bpf/src/netlink.c
+++ b/lib/bpf/src/netlink.c
@@ -8,8 +8,16 @@
 #include <linux/bpf.h>
 #include <linux/if_ether.h>
 #include <linux/pkt_cls.h>
+#ifdef __OHOS__
+/* E091: OHOS linux/socket.h 无条件定义 sockaddr_storage，与 musl sys/socket.h 冲突；
+ * include 期间重命名避免 redefinition。 */
+#define sockaddr_storage __linux_sockaddr_storage
+#endif
 #include <linux/rtnetlink.h>
 #include <linux/netdev.h>
+#ifdef __OHOS__
+#undef sockaddr_storage
+#endif
 #include <sys/socket.h>
 #include <errno.h>
 #include <time.h>
