+// ------------------------------------------------------------------------
+// Simple Rect struct
+// ------------------------------------------------------------------------
+
+struct Rect
+{
+    int x, y, width, height;
+
+    Rect() : x(0), y(0), width(0), height(0) {}
+    Rect(int x_, int y_, int w_, int h_) : x(x_), y(y_), width(w_), height(h_) {}
+
+    void Offset(int dx, int dy) { x += dx; y += dy; }
+
+    void Union(const Rect &other)
+    {
+        if (width == 0 && height == 0) { *this = other; return; }
+        if (other.width == 0 && other.height == 0) return;
+        int x1 = (x < other.x) ? x : other.x;
+        int y1 = (y < other.y) ? y : other.y;
+        int x2 = (x + width > other.x + other.width) ? x + width : other.x + other.width;
+        int y2 = (y + height > other.y + other.height) ? y + height : other.y + other.height;
+        x = x1; y = y1; width = x2 - x1; height = y2 - y1;
+    }
+};
