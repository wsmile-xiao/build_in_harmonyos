+// Render page and return as cairo surface
+// Note: the caller must keep img alive while using the surface
+cairo_surface_t *render_page_to_cairo(poppler::document *doc, int page_index, poppler::image &img_out)
+{
+    img_out = render_page(doc, page_index);
+    if (!img_out.is_valid())
+        return NULL;
+    return image_to_cairo_surface(img_out);
+}
