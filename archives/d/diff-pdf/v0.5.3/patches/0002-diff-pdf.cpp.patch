+
+// Render a page using poppler-cpp page_renderer
+// Returns a poppler::image in argb32 format
+poppler::image render_page(poppler::document *doc, int page_index)
+{
+    poppler::page *p = doc->create_page(page_index);
+    if (!p)
+        return poppler::image();
+
+    poppler::page_renderer renderer;
+    renderer.set_render_hint(poppler::page_renderer::antialiasing, true);
+    renderer.set_render_hint(poppler::page_renderer::text_antialiasing, true);
+    renderer.set_paper_color(0xFFFFFF); // white background
+
+    poppler::image img = renderer.render_page(p, g_resolution, g_resolution);
+    delete p;
+
+    return img;
+}
+
+// Convert poppler::image (argb32) to cairo_surface_t (ARGB32)
+// poppler argb32: [A][R][G][B] per pixel (as 32-bit native endian)
+// Both formats store 4 bytes per pixel with similar layout,
+// so we can reuse the data directly.
+cairo_surface_t *image_to_cairo_surface(poppler::image &img)
+{
+    if (!img.is_valid() || img.format() != poppler::image::format_argb32)
+        return NULL;
+
+    cairo_surface_t *surface = cairo_image_surface_create_for_data(
+        (unsigned char *)img.data(),
+        CAIRO_FORMAT_ARGB32,
+        img.width(),
+        img.height(),
+        img.bytes_per_row());
 
     return surface;
 }
 
