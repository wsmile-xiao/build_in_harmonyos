diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -0,0 +1,40 @@
+# Makefile for diff-pdf (OpenHarmony headless build)
+# Uses poppler-cpp C++ API + Cairo for PDF output instead of poppler-glib + wxWidgets
+
+PKG_CONFIG_PATH ?= /storage/Users/currentUser/usr/local/lib/pkgconfig
+
+PREFIX ?= /storage/Users/currentUser/usr/local
+
+CXX ?= clang++
+
+POPPLER_CFLAGS := $(shell PKG_CONFIG_PATH=$(PKG_CONFIG_PATH) pkg-config --cflags poppler-cpp cairo cairo-pdf)
+POPPLER_LIBS := $(shell PKG_CONFIG_PATH=$(PKG_CONFIG_PATH) pkg-config --libs poppler-cpp cairo cairo-pdf)
+
+CXXFLAGS ?= -fPIC -O2 -std=c++17
+CXXFLAGS += $(POPPLER_CFLAGS)
+
+LDFLAGS ?=
+LDFLAGS += $(POPPLER_LIBS)
+
+TARGET = diff-pdf
+
+SRCS = diff-pdf.cpp
+
+OBJS = $(SRCS:.cpp=.o)
+
+all: $(TARGET)
+
+$(TARGET): $(OBJS)
+	$(CXX) $(CXXFLAGS) -o $(TARGET) $(OBJS) $(LDFLAGS)
+
+%.o: %.cpp
+	$(CXX) $(CXXFLAGS) -c -o $@ $<
+
+install: $(TARGET)
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	cp $(TARGET) $(DESTDIR)$(PREFIX)/bin/
+
+clean:
+	rm -f $(OBJS) $(TARGET)
+
+.PHONY: all install clean