diff -ruN a/bootstrap-ohos.sh b/bootstrap-ohos.sh
--- a/bootstrap-ohos.sh
+++ b/bootstrap-ohos.sh
@@ -0,0 +1,7 @@
+#!/bin/bash
+# Bootstrap script for dnsmap on HMDFS/OpenHarmony
+# 1. Run autoreconf to generate configure (source tarball doesn't include it)
+# 2. Patch configure to fix HMDFS umask issue (umask 077 → 002)
+
+autoreconf -i || exit 1
+sed -i 's/umask 077 && mktemp/umask 002 \&\& mktemp/g; s/umask 077 && mkdir/umask 002 \&\& mkdir/g' configure
