+
+/* Compatibility for musl libc which doesn't support qsort_r */
+#ifdef __OHOS__
+/* musl libc doesn't provide qsort_r, we implement a workaround using
+ * thread-local storage to pass the comparison context */
+static __thread void *qsort_r_context;
+static __thread int (*qsort_r_compare)(const void *, const void *, void *);
+
+static int qsort_r_wrapper(const void *a, const void *b) {
+    return qsort_r_compare(a, b, qsort_r_context);
+}
+
+static void qsort_r(void *base, size_t nmemb, size_t size,
+                    int (*compare)(const void *, const void *, void *),
+                    void *context) {
+    qsort_r_context = context;
+    qsort_r_compare = compare;
+    qsort(base, nmemb, size, qsort_r_wrapper);
+}
+#endif
 
