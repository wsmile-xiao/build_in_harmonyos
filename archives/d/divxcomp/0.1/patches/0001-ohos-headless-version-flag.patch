--- a/divxcomp.pl
+++ b/divxcomp.pl
@@ -19,6 +19,17 @@
 #
 #############################################################################
 
+# OHOS port: headless environments have neither Perl::Tk nor an X11
+# display, so the GUI cannot start there. Handle --version in a BEGIN
+# block (runs during compilation, before `use Tk` loads) so the version
+# can be queried without a GUI stack.
+BEGIN {
+    if (grep { $_ eq '--version' } @ARGV) {
+        print "divxcomp 0.1\n";
+        exit 0;
+    }
+}
+
 use Tk;
 use Tk::BrowseEntry;
 
