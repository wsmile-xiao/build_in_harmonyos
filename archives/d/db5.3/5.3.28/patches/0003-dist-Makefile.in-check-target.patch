--- a/dist/Makefile.in
+++ b/dist/Makefile.in
@@ -1214,7 +1214,10 @@
 	$(RM) -r $(REALCLEAN_LIST)
 	$(RM) -r libtool
 
-check depend dvi info obj TAGS:
+check: cutest
+	./cutest
+
+depend dvi info obj TAGS:
 	@echo "make: $@ target not available"
 
 dist rpm rpmbuild:
@@ -1308,7 +1311,11 @@
 	$(POSTLINK) $@
 
 # C unit test suite.
-CUTEST_FLAGS= $(CFLAGS) -I$(testdir)/c/cutest -I$(testdir)/c/suites -I$(testdir)/c/common
+# -O0：上游 test/c/suites/TestQueue.c 用 SH_LIST_* 相对偏移宏操作 malloc 对象，
+# 跨对象指针相减是 UB；GCC -O1/-O2 会把元素 link 字段的写入当死存储删掉
+# （实测 -O0 next=-1/prev=-800，-O1 next=0/prev=0）→ sh_l_as_string 沿 next=0
+# 自环、缓冲越界 SIGSEGV。只降级测试对象，库本体仍按 CFLAGS 的优化级别编。
+CUTEST_FLAGS= $(CFLAGS) -O0 -I$(testdir)/c/cutest -I$(testdir)/c/suites -I$(testdir)/c/common
 
 CuTest@o@: $(testdir)/c/cutest/CuTest.c
 	$(CC) $(CUTEST_FLAGS) $?
