--- a/src/dc3dd.c
+++ b/src/dc3dd.c
@@ -23,0 +24 @@
+#include <errno.h>
@@ -319,0 +321 @@
+static volatile sig_atomic_t signal_handling_shutdown = 0;
@@ -2948 +2949,0 @@
-   int sig = 0;
@@ -2952 +2953,0 @@
-   sigwait(&set, &sig);
@@ -2954,3 +2954,18 @@
-   pthread_mutex_lock(&signaling_lock);
-   pthread_cond_signal(interrupted);
-   pthread_mutex_unlock(&signaling_lock);
+   while (!signal_handling_shutdown)
+   {
+      struct timespec timeout;
+      int sig;
+
+      timeout.tv_sec = 0;
+      timeout.tv_nsec = 100000000;
+      sig = sigtimedwait(&set, NULL, &timeout);
+      if (sig == SIGINT)
+      {
+         pthread_mutex_lock(&signaling_lock);
+         pthread_cond_signal(interrupted);
+         pthread_mutex_unlock(&signaling_lock);
+         break;
+      }
+      if (sig < 0 && errno != EAGAIN && errno != EINTR)
+         break;
+   }
@@ -3011,0 +3026 @@
+   signal_handling_shutdown = 0;
@@ -3033 +3049,2 @@
-   pthread_cancel(signal_handling_thread);
+   signal_handling_shutdown = 1;
+   pthread_join(signal_handling_thread, NULL);
