+	if (!capability_audio_probe_enabled()) {
+		return;
+	}
+	constexpr float Pi = 3.14159265358979323846f;
+	constexpr float FrequencyHz = 440.0f;
+	constexpr float Amplitude = 2048.0f;
+	static float phase = 0.0f;
+	const auto sample_rate = static_cast<float>(mixer.sample_rate_hz.load());
+	if (!(sample_rate > 0.0f)) {
+		return;
+	}
+	const auto phase_step = 2.0f * Pi * FrequencyHz / sample_rate;
+	for (auto& frame : mixer.output_buffer) {
+		const auto sample = std::sin(phase) * Amplitude;
+		frame.left += sample;
+		frame.right += sample;
+		phase += phase_step;
+		if (phase >= 2.0f * Pi) {
+			phase -= 2.0f * Pi;
+		}
+	}
