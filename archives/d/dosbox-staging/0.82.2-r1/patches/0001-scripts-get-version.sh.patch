--- a/scripts/get-version.sh
+++ b/scripts/get-version.sh
@@ -20,25 +20,50 @@
   version-and-hash   Version and Git hash concatenated with a dash
                      (e.g., 0.79.1-da3c5, 0.81.1-alpha-c22ef8)
 "
 }
 
 if [ "$#" -lt 1 ]; then
     usage
     exit 0
 fi
 
-ROOT=$(git rev-parse --show-toplevel)
+if ROOT=$(git rev-parse --show-toplevel 2>/dev/null); then
+    :
+else
+    ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+fi
 
-VERSION=$(
-    grep "#define\\s*DOSBOX_VERSION\\s*\"" "$ROOT/include/version.h" \
-        | cut -d"\"" -f2
-)
+if VERSION=$(
+    awk '
+        $1 == "#define" && $2 == "DOSBOX_VERSION" {
+            value = $0
+            sub(/^[^"]*"/, "", value)
+            sub(/".*$/, "", value)
+            if (value == "") exit 1
+            print value
+            found++
+        }
+        END { if (found != 1) exit 1 }
+    ' "$ROOT/include/version.h"
+); then
+    :
+else
+    printf '%s\n' "Missing or invalid DOSBOX_VERSION" >&2
+    exit 1
+fi
 
-GIT_HASH=$(git rev-parse --short=5 HEAD)
+if GIT_HASH=$(git -C "$ROOT" rev-parse --short=5 HEAD 2>/dev/null); then
+    :
+elif [ -n "${DOSBOX_SOURCE_GIT_HASH:-}" ]; then
+    GIT_HASH=$DOSBOX_SOURCE_GIT_HASH
+else
+    printf '%s\n' "Missing Git metadata and DOSBOX_SOURCE_GIT_HASH" >&2
+    exit 1
+fi
 
 case $1 in
     version)          echo "$VERSION" ;;
     hash)             echo "$GIT_HASH" ;;
     version-and-hash) echo "$VERSION-$GIT_HASH" ;;
     *)                usage; exit 1 ;;
 esac
