diff -ruN a/m4/dpkg-libs.m4 b/m4/dpkg-libs.m4
--- a/m4/dpkg-libs.m4
+++ b/m4/dpkg-libs.m4
@@ -13,22 +13,41 @@
     dpkg_save_libmd_LIBS=$LIBS
     AC_SEARCH_LIBS([MD5Init], [md])
     LIBS=$dpkg_save_libmd_LIBS
     AS_IF([test "x$ac_cv_search_MD5Init" = "xnone required"], [
       have_libmd="builtin"
     ], [test "x$ac_cv_search_MD5Init" != "xno"], [
       have_libmd="yes"
       MD_LIBS="$ac_cv_search_MD5Init"
     ])
   ])
+
+  # If libmd not found, try OpenSSL crypto library
   AS_IF([test "x$have_libmd" = "xno"], [
-    AC_MSG_FAILURE([md5 digest functions not found])
+    AC_CHECK_HEADERS([openssl/md5.h], [
+      dpkg_save_libcrypto_LIBS=$LIBS
+      AC_SEARCH_LIBS([MD5_Init], [crypto])
+      LIBS=$dpkg_save_libcrypto_LIBS
+      AS_IF([test "x$ac_cv_search_MD5_Init" != "xno"], [
+        have_libmd="openssl"
+        AS_IF([test "x$ac_cv_search_MD5_Init" = "xnone required"], [
+          MD_LIBS=""
+        ], [
+          MD_LIBS="$ac_cv_search_MD5_Init"
+        ])
+        AC_DEFINE([HAVE_LIBCRYPTO], [1], [Define if using OpenSSL crypto library for MD5])
+      ])
+    ])
+  ])
+
+  AS_IF([test "x$have_libmd" = "xno"], [
+    AC_MSG_FAILURE([md5 digest functions not found (neither libmd nor OpenSSL crypto library)])
   ])
 ])# DPKG_LIB_MD
 
