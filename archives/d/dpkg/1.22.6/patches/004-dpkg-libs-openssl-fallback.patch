 AC_DEFUN([DPKG_WITH_COMPRESS_LIB], [
   AC_ARG_VAR(AS_TR_CPP([$1_LIBS]), [linker flags for $1 library])
   AC_ARG_WITH([lib$1],
     [AS_HELP_STRING([--with-lib$1],
