+/*****************************************************************************/
+
+#ifndef WIN32
+// Function to read DNS server from /etc/resolv.conf
+// This is a replacement for the _res structure method which doesn't work with musl libc
+char *get_dns_server_from_resolv_conf(void) {
+    FILE *fp;
+    char line[256];
+    char *nameserver = NULL;
+
+    fp = fopen("/etc/resolv.conf", "r");
+    if (fp == NULL) {
+        return NULL;
+    }
+
+    while (fgets(line, sizeof(line), fp) != NULL) {
+        // Skip comments and empty lines
+        if (line[0] == '#' || line[0] == '\n' || line[0] == '\0') {
+            continue;
+        }
+
+        // Look for "nameserver" directive
+        if (strncmp(line, "nameserver", 10) == 0) {
+            char ip[64];
+            // Extract IP address after "nameserver"
+            if (sscanf(line, "nameserver %63s", ip) == 1) {
+                nameserver = strdup(ip);
+                break;  // Use the first nameserver found
+            }
+        }
+    }
+
+    fclose(fp);
+    return nameserver;
+}
+#endif
 
