--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,49 @@
+cmake_minimum_required(VERSION 3.16)
+project(dewalls VERSION 1.0.0 LANGUAGES CXX)
+
+# dewalls: C++/Qt5 parser library for Walls .wpj/.srv cave survey data.
+# Upstream uses QBS only; this CMakeLists.txt is an OHOS adaptation that
+# builds the same targets declared in dewalls.qbs:
+#   - libdewalls  (dynamic library, src/*)
+#   - dewalls-test (Catch-based test runner, test/*)
+
+set(CMAKE_CXX_STANDARD 11)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_AUTOMOC ON)
+set(CMAKE_AUTORCC ON)
+
+find_package(Qt5 5.15 REQUIRED COMPONENTS Core)
+
+file(GLOB DEWALLS_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp")
+file(GLOB DEWALLS_HEADERS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/*.h")
+
+add_library(dewalls SHARED ${DEWALLS_SOURCES} ${DEWALLS_HEADERS})
+target_include_directories(dewalls PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
+    $<INSTALL_INTERFACE:include>)
+target_link_libraries(dewalls PUBLIC Qt5::Core)
+# L5a soname gate: shared library must carry a DT_SONAME so downstream
+# linkers can address it by soname (E537: missing SONAME records the
+# machine-private absolute path into DT_NEEDED).
+set_target_properties(dewalls PROPERTIES
+    VERSION ${PROJECT_VERSION}
+    SOVERSION ${PROJECT_VERSION_MAJOR})
+
+# ---- tests (Catch v1.2.1, single-header in lib/catch.hpp) ----
+enable_testing()
+
+file(GLOB DEWALLS_TEST_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/test/*.cpp")
+add_executable(dewalls-test ${DEWALLS_TEST_SOURCES} test/dewalls-test.qrc)
+target_include_directories(dewalls-test PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/src
+    ${CMAKE_CURRENT_SOURCE_DIR}/test
+    ${CMAKE_CURRENT_SOURCE_DIR}/lib)
+target_link_libraries(dewalls-test PRIVATE dewalls Qt5::Core)
+
+add_test(NAME dewalls-test COMMAND dewalls-test)
+
+# ---- install ----
+install(TARGETS dewalls LIBRARY DESTINATION lib)
+install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/src/
+    DESTINATION include
+    FILES_MATCHING PATTERN "*.h")