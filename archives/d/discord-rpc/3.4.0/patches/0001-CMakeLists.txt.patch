+# rapidjson is provided by the Conan dependency (rapidjson/1.1.0). The recipe
+# passes the package root via the RAPIDJSON_ROOT cache variable, so we no
+# longer download it from GitHub during configure (offline/reproducible build).
+if (NOT DEFINED RAPIDJSON_ROOT)
+    message(FATAL_ERROR "RAPIDJSON_ROOT must be set to the rapidjson package root (Conan dependency)")
+endif()
+set(RAPIDJSON ${RAPIDJSON_ROOT})
+find_path(RAPIDJSON_INCLUDE NAMES rapidjson/document.h PATHS ${RAPIDJSON_ROOT} PATH_SUFFIXES include)
+if (NOT RAPIDJSON_INCLUDE)
+    message(FATAL_ERROR "rapidjson headers not found under RAPIDJSON_ROOT=${RAPIDJSON_ROOT}")
+endif()
 
