@@ -50,6 +50,32 @@
 #define new(n,type)  (type *) myalloc((n)*sizeof(type))    // actually use these not myalloc
 #define new0(n,type)  (type *) mycalloc((n),sizeof(type))
 
+//  The scratch directory for schema temporaries must be probed at run time:
+//  /tmp is a read-only mount on some targets, and writing there then fails with
+//  EROFS.  Candidates are tried in order: $TMPDIR, /tmp, $HOME, the working
+//  directory.
+
+static const char *oneTempDir (void)
+{ static char *dir = NULL ;
+
+  if (dir == NULL)
+    { const char *cand[4] ;
+      int         i ;
+
+      cand[0] = getenv("TMPDIR") ;
+      cand[1] = "/tmp" ;
+      cand[2] = getenv("HOME") ;
+      cand[3] = "." ;
+
+      dir = "" ;
+      for (i = 0 ; i < 4 ; ++i)
+        if (cand[i] != NULL && cand[i][0] != '\0' && access(cand[i],W_OK) == 0)
+          { dir = strdup(cand[i]) ; break ; }
+    }
+
+  return (dir) ;
+}
+
 // global required for parallelisation
 
 static pthread_mutex_t mutexInit = PTHREAD_MUTEX_INITIALIZER;
