-		    break;
+	    	return 0;
+	    case '\t':	/*Already tabbed - a real recipe line - ignore it*/
+	    	return 0;
+	}
+
+	/*
+	 * cpp collapses the newlines and tabs of a multi-line macro call (and of
+	 * an escaped newline) into a single space, so indented lines of a rule
+	 * body may arrive here with exactly one leading space instead of a tab.
+	 * Aligned macro definitions keep their original (wider) indentation.
+	 */
+	for (q = p; *q == ' ' || *q == '\t'; q++)
+		;
+	nblank = q - p;
+	if (*q == '\0' || *q == '#')
+		return 0;
+
+	/*
+	 * A rule line carries its colon in the first word (".SUFFIXES: .xbm .cbm",
+	 * "all::", "install.minimal: depends"); a colon anywhere else in the line
+	 * is part of the recipe text (shell "sed 's:/:.:g'", URLs, and so on).
+	 */
+	istarget = FALSE;
+	for (p = q; *p && *p != ' ' && *p != '\t'; p++)
+		if (p[0] == ':' && p[-1] != '\\') {
+			istarget = TRUE;
+			break;
 		}
-		if (InRule && **pline == ' ')
-		    **pline = '\t';
-		break;
+	if (istarget) {
+		if (nblank != 0)
+			memmove(*pline, q, strlen(q) + 1);	/* targets start at column 0 */
+		InRule = TRUE;
+		return 0;
 	}
+
+	/*
+	 * An indented "NAME = value" is a macro definition, not part of a rule.
+	 */
+	isassignment = FALSE;
+	if ((*q >= 'A' && *q <= 'Z') || (*q >= 'a' && *q <= 'z') || *q == '_') {
+		char	*r = q;
+		while ((*r >= 'A' && *r <= 'Z') || (*r >= 'a' && *r <= 'z')
+		    || (*r >= '0' && *r <= '9') || *r == '_')
+			r++;
+		if (r > q && (*r == ' ' || *r == '\t')) {
+			char	*t = r;
+			while (*t == ' ' || *t == '\t')
+				t++;
+			if (*t == '='
+			    || ((*t == ':' || *t == '+' || *t == '?')
+				&& *(t+1) == '='))
+				isassignment = TRUE;
+		}
+	}
+
+	if (nblank == 0) {
+		InRule = FALSE;			/* back at the top level */
+		return 0;
+	}
+
+	if (nblank != 1 || !InRule)
+		return 0;			/* aligned definition - leave alone */
+
+	if (isassignment) {
+		memmove(*pline, q, strlen(q) + 1);	/* definitions start at column 0 */
+		return 0;
+	}
+
+	memmove(*pline + 1, q, strlen(q) + 1);		/* recipe line */
+	**pline = '\t';
+	return 0;
