 #ifdef FIXUP_CPP_WHITESPACE
+int
 KludgeOutputLine(pline)
 	char	**pline;
 {
 	char	*p = *pline;
+	char	*q;
+	int	nblank;
+	int	istarget;
+	int	isassignment;
 
 	switch (*p) {
 	    case '#':	/*Comment - ignore*/
