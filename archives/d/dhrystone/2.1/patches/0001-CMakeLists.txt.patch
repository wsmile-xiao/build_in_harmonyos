--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,15 @@
+cmake_minimum_required(VERSION 3.16)
+project(dhrystone VERSION 2.1 LANGUAGES C)
+
+add_executable(dhrystone dhry_1.c dhry_2.c)
+set_target_properties(dhrystone PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES
+    C_EXTENSIONS NO INTERPROCEDURAL_OPTIMIZATION FALSE POSITION_INDEPENDENT_CODE ON
+    UNITY_BUILD OFF)
+target_compile_definitions(dhrystone PRIVATE _POSIX_C_SOURCE=200809L)
+if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
+    target_compile_options(dhrystone PRIVATE -Wall -Wextra -Werror=implicit-function-declaration
+        -Werror=return-type -Werror=format -fno-lto -fno-inline)
+    target_link_options(dhrystone PRIVATE -fno-lto -Wl,-z,relro -Wl,-z,now)
+endif()
+install(TARGETS dhrystone RUNTIME DESTINATION bin)
+install(FILES README_C RATIONALE VARIATIONS DESTINATION share/doc/dhrystone)
