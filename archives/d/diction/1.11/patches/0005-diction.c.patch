+/* Return a data directory shipped together with this program.  The directory
+   is resolved relative to the running executable first, so that a relocated
+   installation (e.g. a Conan package folder or an hnp prefix) still finds its
+   data; the configure-time directory is used when that path is not present. */
+static const char *diction_data_dir(const char *sub,const char *fallback) /*{{{*/
+{
+  static char path[4096];
+  char *cut;
+  ssize_t n;
+
+  if ((n=readlink("/proc/self/exe",path,sizeof(path)-1))<=0)
+    return fallback;
+  path[n]='\0';
+  if ((cut=strrchr(path,'/'))==NULL)  /* strip the program name */
+    return fallback;
+  *cut='\0';
+  if ((cut=strrchr(path,'/'))==NULL)  /* strip "bin" */
+    return fallback;
+  *cut='\0';
+  strncat(path,"/share",sizeof(path)-strlen(path)-1);
+  strncat(path,sub,sizeof(path)-strlen(path)-1);
+  if (access(path,R_OK)!=0)
+    return fallback;
+  return path;
+}
