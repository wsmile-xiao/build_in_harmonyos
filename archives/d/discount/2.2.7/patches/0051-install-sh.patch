diff -ruN /dev/null b/install-sh
--- /dev/null
+++ b/install-sh
@@ -0,0 +1,71 @@
+#!/bin/sh
+# Simple install command replacement for HarmonyOS
+# POSIX-compliant version
+
+mode=""
+create_dir=0
+
+# Parse options
+args=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        -m)
+            mode="$2"
+            shift 2
+            ;;
+        -d)
+            create_dir=1
+            shift
+            ;;
+        *)
+            args="$args $1"
+            shift
+            ;;
+    esac
+done
+
+# Remove leading space from args
+set -- $args
+
+if [ $create_dir -eq 1 ]; then
+    # Create directories
+    for dir in "$@"; do
+        mkdir -p "$dir" || exit 1
+    done
+    exit 0
+fi
+
+if [ $# -lt 2 ]; then
+    echo "Usage: install-sh [-m mode] [-d] source... dest" >&2
+    exit 1
+fi
+
+# Get destination (last argument)
+dest=""
+sources=""
+for arg in "$@"; do
+    sources="$sources $dest"
+    dest="$arg"
+done
+
+# Remove leading space from sources
+sources=$(echo "$sources" | sed 's/^ //')
+
+# Install each source file
+for src in $sources; do
+    if [ -d "$dest" ]; then
+        cp "$src" "$dest/" || exit 1
+        target="$dest/$src"
+    else
+        cp "$src" "$dest" || exit 1
+        target="$dest"
+    fi
+    
+    if [ -n "$mode" ]; then
+        chmod "$mode" "$target" || exit 1
+    else
+        chmod 755 "$target" || exit 1
+    fi
+done
+
+exit 0