diff -ruN /dev/null b/librarian.sh
--- /dev/null
+++ b/librarian.sh
@@ -0,0 +1,28 @@
+#! /bin/sh
+#
+#  Build static libraries, hiding (some) ickiness from the makefile
+
+ACTION=$1; shift
+LIBRARY=$1; shift
+VERSION=$1; shift
+
+case "$ACTION" in
+make)   # first strip out any libraries that might
+	# be passed in on the object line
+	objs=
+	for x in "$@"; do
+	    case "$x" in
+	    -*) ;;
+	    *) objs="$objs $x" ;;
+	    esac
+	done
+	/data/service/hnp/bin/llvm-ar crv $LIBRARY.a $objs
+	/data/service/hnp/bin/llvm-ranlib $LIBRARY.a
+	rm -f $LIBRARY
+	cp $LIBRARY.a $LIBRARY
+	;;
+files)  echo "${LIBRARY}.a"
+	;;
+install)./install-sh -m 644 ${LIBRARY}.a $1
+	;;
+esac
