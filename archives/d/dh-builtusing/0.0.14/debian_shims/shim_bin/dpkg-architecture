#!/usr/bin/env sh
# Minimal dpkg-architecture shim for dh-builtusing upstream tests on OHOS.
# Only implements what run-unit-tests / Dh_Lib need:
#   dpkg-architecture -qDEB_HOST_ARCH  -> host Debian arch
# Honest default is arm64 (OHOS aarch64); DH_BUILTUSING_HOST_ARCH overrides
# so Dh_Lib::hostarch and the test $host stay consistent.
if [ "${1:-}" = "-qDEB_HOST_ARCH" ]; then
    echo "${DH_BUILTUSING_HOST_ARCH:-arm64}"
    exit 0
fi
echo "dpkg-architecture shim: unsupported args: $*" 1>&2
echo "${DH_BUILTUSING_HOST_ARCH:-arm64}"
exit 0
