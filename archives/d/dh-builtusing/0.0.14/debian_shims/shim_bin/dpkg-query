#!/usr/bin/env perl
# Minimal dpkg-query shim for dh-builtusing upstream tests on OHOS.
# Implements only: dpkg-query -Wf FORMAT PKG_GLOB...
# Fixture DB mirrors real Debian trixie source mappings needed by the
# 16 unit-tests (offline fixture, versions satisfy re_verinfo).
# Unknown packages produce no output lines (caller treats as not installed).
use strict;
use warnings;

my %DB = (
    'dpkg'            => ['dpkg', '1.22.18'],
    'dpkg-dev'        => ['dpkg', '1.22.18'],
    'libdpkg-perl'    => ['dpkg', '1.22.18'],
    'gcc'             => ['gcc-defaults', '14.2.0-1'],
    'g++'             => ['gcc-defaults', '14.2.0-1'],
    'cpp'             => ['gcc-defaults', '14.2.0-1'],
    'autotools-dev'   => ['autotools-dev', '20220109.1'],
    'binutils'        => ['binutils', '2.44-1'],
    'binutils-common' => ['binutils', '2.44-1'],
    'libbinutils'     => ['binutils', '2.44-1'],
    'libc6'           => ['glibc', '2.41-12'],
    'make'            => ['make-dfsg', '4.4.1-1'],
    'debhelper'       => ['debhelper', '13.24.3'],
);

my ($format, @pkgs);
my @argv = @ARGV;
while (@argv) {
    my $a = shift @argv;
    if ($a eq '-Wf' || $a eq '-W' || $a eq '-f') {
        $format = shift @argv if @argv && !defined $format;
        if ($a eq '-W' && @argv && $argv[0] !~ /^-/) {
            # -W may be followed by -f FORMAT; loop handles it.
        }
        next;
    }
    next if $a =~ /^-/;
    push @pkgs, $a;
}
$format = '' unless defined $format;
my $want_source = ($format =~ /source:Package/) ? 1 : 0;

sub glob_to_re {
    my ($g) = @_;
    # quotemeta escapes all non-word chars; restore glob wildcards.
    my $re = quotemeta($g);
    $re =~ s/\\\*/.*/g;
    $re =~ s/\\\?/./g;
    return qr/^$re$/;
}

my $rc = 0;
for my $pat (@pkgs) {
    my $re = glob_to_re($pat);
    my @hits = grep { $_ =~ $re } keys %DB;
    for my $bin (sort @hits) {
        my ($src, $ver) = @{$DB{$bin}};
        if ($want_source) {
            print "ii $bin:$src (= $ver)\n";
        } else {
            print "ii $bin\n";
        }
    }
    # Unknown patterns: no output (treated as not installed), exit stays 0
    # so the harness reports a real mismatch instead of dying in qx_cmd.
}
exit $rc;
