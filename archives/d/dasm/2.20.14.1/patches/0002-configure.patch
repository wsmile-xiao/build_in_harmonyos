diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -0,0 +1,12 @@
+#!/bin/sh
+# Dummy configure script for dasm (makefile project, no autotools)
+# dasm uses a plain Makefile, no configuration needed.
+# Build: make; Install: manual (no install target)
+prefix=""
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*) prefix="${arg#--prefix=}" ;;
+    esac
+done
+echo "dasm: makefile project, configure skipped (prefix=${prefix:-default})"
+exit 0
