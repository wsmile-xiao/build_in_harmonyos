+/* On libc with an opaque FILE type (musl, e.g. HarmonyOS), FILE has no
+ * accessible members (_fileno/_file/_magic/_flags/_chain/_lock/_IO_*),
+ * so the glibc-specific tricks below do not compile there.  For those
+ * targets dcap hands out private heap tokens cast to FILE * and keeps
+ * the virtual fd plus EOF/ERR bits in a small registry instead of
+ * inside FILE.  Real system FILE * values never enter the registry and
+ * are delegated to the system_* backend via fileno().  glibc (and other
+ * non-Linux) builds are untouched.
+ */
+#if defined(__linux__) && !defined(__GLIBC__) && !defined(__UCLIBC__)
+#define DCAP_OPAQUE_FILE 1
+#endif
+
+#ifdef DCAP_OPAQUE_FILE
+#include <pthread.h>
+
+struct dc_fake_file {
+	int fd;
+	int flags;
+	struct dc_fake_file *next;
+};
+
+static pthread_mutex_t dc_fake_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct dc_fake_file *dc_fake_list = NULL;
+
+/* Registry lookup: known token -> virtual fd; anything else is a real
+ * system FILE * -> fileno().  NULL yields -1 so callers fall through to
+ * the system_* backend instead of crashing.
+ */
+static int dc_fake_fd(FILE *fp)
+{
+	struct dc_fake_file *cur;
+	int fd = -1;
+
+	if (fp == NULL) {
+		return -1;
+	}
+	pthread_mutex_lock(&dc_fake_lock);
+	for (cur = dc_fake_list; cur != NULL; cur = cur->next) {
+		if ((FILE *)cur == fp) {
+			fd = cur->fd;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&dc_fake_lock);
+	if (fd < 0) {
+		fd = fileno(fp);
+	}
+	return fd;
+}
+
+static FILE *dc_fake_alloc(int fd)
+{
+	struct dc_fake_file *node;
+
+	node = (struct dc_fake_file *)malloc(sizeof(*node));
+	if (node == NULL) {
+		return NULL;
+	}
+	node->fd = fd;
+	node->flags = 0;
+	pthread_mutex_lock(&dc_fake_lock);
+	node->next = dc_fake_list;
+	dc_fake_list = node;
+	pthread_mutex_unlock(&dc_fake_lock);
+	return (FILE *)node;
+}
+
+static void dc_fake_add_flags(FILE *fp, int flags)
+{
+	struct dc_fake_file *cur;
+
+	pthread_mutex_lock(&dc_fake_lock);
+	for (cur = dc_fake_list; cur != NULL; cur = cur->next) {
+		if ((FILE *)cur == fp) {
+			cur->flags |= flags;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&dc_fake_lock);
+}
+
+static int dc_fake_has_flag(FILE *fp, int flag)
+{
+	struct dc_fake_file *cur;
+	int rc = 0;
+
+	pthread_mutex_lock(&dc_fake_lock);
+	for (cur = dc_fake_list; cur != NULL; cur = cur->next) {
+		if ((FILE *)cur == fp) {
+			rc = (cur->flags & flag) != 0;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&dc_fake_lock);
+	return rc;
+}
+
+static void dc_fake_free(FILE *fp)
+{
+	struct dc_fake_file **prev, *cur;
+
+	pthread_mutex_lock(&dc_fake_lock);
+	for (prev = &dc_fake_list; (cur = *prev) != NULL; prev = &cur->next) {
+		if ((FILE *)cur == fp) {
+			*prev = cur->next;
+			free(cur);
+			break;
+		}
+	}
+	pthread_mutex_unlock(&dc_fake_lock);
+}
+#endif
+
 
