+/* MacosX does not have a special API for 64bit. The same holds on musl
+ * (e.g. HarmonyOS): with _GNU_SOURCE the *64 names are macros aliasing
+ * the base names (open64->open, stat64->stat, ...), so compiling this
+ * file would redefine the base symbols from dcap_preload.c and fail the
+ * libpdcap link with duplicate symbols. Skip it there as well. The
+ * open64/stat64 checks fire after <fcntl.h>/<sys/stat.h> above even when
+ * the compiler itself does not predefine __musl__/__OHOS__.
+ */
+#if !defined(__APPLE__) && !defined(__musl__) && !defined(__OHOS__) && !defined(open64) && !defined(stat64)
 
