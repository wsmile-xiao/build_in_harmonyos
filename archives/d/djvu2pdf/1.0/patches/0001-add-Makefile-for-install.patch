--- a/Makefile	1970-01-01 08:00:00.000000000 +0800
+++ b/Makefile	2026-05-27 14:57:09.485770000 +0800
@@ -0,0 +1,23 @@
+PREFIX ?= /usr/local
+
+all:
+	@echo "djvu2pdf is a shell script, nothing to build."
+
+install:
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	cp djvu2pdf $(DESTDIR)$(PREFIX)/bin/
+	cp djvu2pdf_toc_parser.py $(DESTDIR)$(PREFIX)/bin/
+	chmod 755 $(DESTDIR)$(PREFIX)/bin/djvu2pdf
+	chmod 755 $(DESTDIR)$(PREFIX)/bin/djvu2pdf_toc_parser.py
+
+uninstall:
+	rm -f $(DESTDIR)$(PREFIX)/bin/djvu2pdf
+	rm -f $(DESTDIR)$(PREFIX)/bin/djvu2pdf_toc_parser.py
+
+clean:
+	@echo "Nothing to clean."
+
+check:
+	@echo "No tests available for djvu2pdf (shell script)."
+
+.PHONY: all install uninstall clean check
\ No newline at end of file
