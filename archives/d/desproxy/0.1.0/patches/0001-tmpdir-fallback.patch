--- configure.orig	2026-09-10 17:14:05.880320000 +0800
+++ configure	2026-09-10 17:14:05.974699000 +0800
@@ -2599,17 +2599,20 @@
 }
 
 # Create a (secure) tmp directory for tmp files.
+# HarmonyOS 适配: OHOS toybox mktemp -d 创建的临时目录权限异常，config.status
+# 写入其下文件报 Permission denied（Makefile 未生成）。改用 mkdir（umask 077），
+# TMPDIR 不可用/不可写时回退当前目录（configure/config.status 所在目录，确定可写）。
 : ${TMPDIR=/tmp}
 {
-  tmp=`(umask 077 && mktemp -d -q "$TMPDIR/csXXXXXX") 2>/dev/null` &&
-  test -n "$tmp" && test -d "$tmp"
-}  ||
-{
   tmp=$TMPDIR/cs$$-$RANDOM
   (umask 077 && mkdir $tmp)
 } ||
 {
-   echo "$me: cannot create a temporary directory in $TMPDIR" >&2
+  tmp=./cs$$-$RANDOM
+  (umask 077 && mkdir $tmp)
+} ||
+{
+   echo "$me: cannot create a temporary directory" >&2
    { (exit 1); exit 1; }
 }
 
