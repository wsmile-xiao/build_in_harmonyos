diff --git a/dh-elpa.el b/dh-elpa.el
index 611fdae..f457002 100644
--- a/dh-elpa.el
+++ b/dh-elpa.el
@@ -26,6 +26,36 @@
 (require 'package)
 (require 'cl-lib)
 
+;; Emacs < 30 compatibility shim.  Upstream dh-elpa 2.2.0 declares
+;; `emacs (>= 30.1)' because `lm-package-requires' was added to lisp-mnt.el
+;; in Emacs 30; the published ohpcd emacs package is 29.1, so backport the
+;; function here with identical semantics (see Emacs 30
+;; lisp/emacs-lisp/lisp-mnt.el).  No-op on Emacs >= 30.
+(unless (fboundp 'lm-package-requires)
+  (defun lm--prepare-package-dependencies (deps)
+    "Turn DEPS into an acceptable list of dependencies."
+    (cond
+     ((not (listp deps))
+      (error "Invalid requirement specifier: %S" deps))
+     (t (mapcar (lambda (dep)
+                  (cond
+                   ((symbolp dep) (list dep "0"))
+                   ((stringp dep)
+                    (error "Invalid requirement specifier: %S" dep))
+                   ((and (listp dep) (null (cdr dep)))
+                    (list (car dep) "0"))
+                   (t dep)))
+                deps))))
+  (defun lm-package-requires (&optional file)
+    "Return dependencies listed in file FILE, or current buffer if FILE is nil."
+    (require 'package)
+    (lm-with-file file
+      (let ((require-lines (lm-header-multiline "package-requires")))
+        (when require-lines
+          (lm--prepare-package-dependencies
+           (package-read-from-string
+            (mapconcat #'identity require-lines " "))))))))
+
 ;; Originally package-unpack from package.el in Emacs 24.5
 (defun dhelpa-unpack (pkg-desc destdir &optional epoch-time)
   "Install the contents of the current buffer into DESTDIR as a package.
