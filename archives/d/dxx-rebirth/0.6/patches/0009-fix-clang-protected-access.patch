From d0566119891c7f381cbe7a375c09ccda6c0c689a Mon Sep 17 00:00:00 2001
From: Kp <kp@valhallalegends.com>
Date: Tue, 22 Oct 2019 21:58:41 -0500
Subject: [PATCH] Fix mglobal.cpp build in clang-9

Add a using statement to switch report_error_uses_exception to public
access. Nothing else uses it, and there is no design purpose served by
keeping it protected.
---
 common/include/fwd-valptridx.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/common/include/fwd-valptridx.h b/common/include/fwd-valptridx.h
index 4cf4689..0e13651 100644
--- a/common/include/fwd-valptridx.h
+++ b/common/include/fwd-valptridx.h
@@ -61,6 +61,7 @@ class valptridx :
 	using array_base_storage_type = std::array<managed_type, array_size>;
 public:
 	class array_managed_type;
+	using typename specialized_types::report_error_uses_exception;
 
 protected:
 	using const_pointer_type = const managed_type *;
-- 
