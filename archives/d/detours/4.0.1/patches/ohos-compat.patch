--- a/CMakeLists.txt	1970-01-01 08:00:00.000000000 +0800
+++ b/CMakeLists.txt	2026-07-29 20:24:18.871362031 +0800
@@ -0,0 +1,54 @@
+cmake_minimum_required(VERSION 3.15)
+project(detours CXX)
+
+# HarmonyOS ARM64 architecture macros
+add_definitions(
+    -D_ARM64_
+    -D_WIN64
+    -D_ARM_WINAPI_PARTITION_DESKTOP_SDK_AVAILABLE=1
+    -DDETOURS_64BIT
+    -DDETOURS_BITS=64
+    -DWIN32_LEAN_AND_MEAN
+    -D_WIN32_WINNT=0x0501
+    
+)
+
+# Add compat headers to include path (must come before system includes)
+include_directories(BEFORE ${CMAKE_CURRENT_SOURCE_DIR}/compat)
+
+set(DETOURS_SRC
+    src/detours.cpp
+    src/modules.cpp
+    src/disasm.cpp
+    src/image.cpp
+    src/creatwth.cpp
+    src/disolx86.cpp
+    src/disolx64.cpp
+    src/disolia64.cpp
+    src/disolarm.cpp
+    src/disolarm64.cpp
+    compat/stubs.cpp
+)
+
+# Disable MSVC-specific pragmas and warnings on non-MSVC compilers
+if(NOT MSVC)
+    add_compile_options(
+        -Wno-unknown-pragmas
+        -Wno-pragmas
+        -Wno-unused-function
+        -Wno-unused-variable
+        -Wno-unused-but-set-variable
+        -Wno-deprecated-declarations
+        -Wno-sign-compare
+        -Wno-format
+        -fno-exceptions
+        -fno-rtti
+    )
+endif()
+
+add_library(detours STATIC ${DETOURS_SRC})
+
+# Install headers and library
+install(TARGETS detours ARCHIVE DESTINATION lib)
+install(DIRECTORY compat/ DESTINATION include)
+install(FILES src/detours.h src/detver.h DESTINATION include)
