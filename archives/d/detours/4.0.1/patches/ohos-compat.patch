+/* Minimal imagehlp.h compatibility header for Detours compilation on non-Windows.
+   NOTE: IMAGEHLP_MODULE64 and SYMBOL_INFO are NOT defined here — detours.h
+   creates them as typedef aliases from IMAGEHLP_MODULE and IMAGEHLP_SYMBOL
+   when _MSC_VER < 1299 (which is the case on clang/Linux). */
+#ifndef _IMAGEHLP_H_COMPAT
+#define _IMAGEHLP_H_COMPAT
+
+#include "windows.h"
+
+/* API_VERSION */
+typedef struct _API_VERSION {
+    USHORT MajorVersion;
+    USHORT MinorVersion;
+    USHORT Revision;
+    USHORT Reserved;
+} API_VERSION, *LPAPI_VERSION;
+
+/* IMAGEHLP_MODULE (legacy) — detours.h typedefs IMAGEHLP_MODULE64 from this */
+typedef struct _IMAGEHLP_MODULE {
+    DWORD    SizeOfStruct;
+    DWORD    Base;
+    DWORD    ImageSize;
+    DWORD    TimeDateStamp;
+    DWORD    CheckSum;
+    DWORD    NumSyms;
+    CHAR     ModuleName[32];
+    CHAR     ImageName[256];
+    CHAR     LoadedImageName[256];
+} IMAGEHLP_MODULE, *PIMAGEHLP_MODULE;
+
+/* IMAGEHLP_SYMBOL (legacy) — detours.h typedefs SYMBOL_INFO from this */
+typedef struct _IMAGEHLP_SYMBOL {
+    DWORD    SizeOfStruct;
+    ULONG    Address;
+    ULONG    Size;
+    DWORD    Flags;
+    DWORD    MaxNameLength;
+    CHAR     Name[1];
+} IMAGEHLP_SYMBOL, *PIMAGEHLP_SYMBOL;
+
+/* LOADED_IMAGE */
+typedef struct _LOADED_IMAGE {
+    PSTR                  ModuleName;
+    PSTR                  hFile;
+    PUCHAR                MappedAddress;
+    PIMAGE_NT_HEADERS     FileHeader;
+    PIMAGE_SECTION_HEADER LastRvaSection;
+    ULONG                 NumberOfSections;
+    PIMAGE_SECTION_HEADER Sections;
+    ULONG                 Characteristics;
+    BOOLEAN               fSystemImage;
+    BOOLEAN               fDOSImage;
+    BOOLEAN               fReadOnly;
+    BOOLEAN               Version;
+    ULONG                 Links;
+    ULONG                 UnLoad;
+} LOADED_IMAGE, *PLOADED_IMAGE;
+
+/* Function declarations — use legacy types; detours.h will create aliases.
+   These are never called directly (loaded via GetProcAddress). */
+WINAPI LPAPI_VERSION ImagehlpApiVersionEx(LPAPI_VERSION AppVersion);
+WINAPI BOOL SymInitialize(HANDLE hProcess, LPCSTR UserSearchPath, BOOL fInvadeProcess);
+WINAPI DWORD SymSetOptions(DWORD SymOptions);
+WINAPI DWORD SymGetOptions(VOID);
+WINAPI PVOID ImageDirectoryEntryToData(PVOID Base, BOOLEAN MappedAsImage, USHORT DirectoryEntry, PULONG Size);
+WINAPI PLOADED_IMAGE ImageLoad(LPSTR DllName, LPSTR DllPath);
+WINAPI BOOL ImageUnload(PLOADED_IMAGE LoadedImage);
+WINAPI BOOL MapAndLoad(LPSTR ImagePath, LPSTR DllPath, PLOADED_IMAGE LoadedImage, BOOL DotDll, BOOL ReadOnly);
+WINAPI BOOL UnMapAndLoad(PLOADED_IMAGE LoadedImage);
+WINAPI BOOL GetModuleInformation(HANDLE hProcess, HMODULE hModule, LPMODULEINFO lpmodinfo, DWORD cb);
+
+#endif /* _IMAGEHLP_H_COMPAT */
