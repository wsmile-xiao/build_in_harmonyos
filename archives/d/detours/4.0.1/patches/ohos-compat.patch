+/* Minimal dbghelp.h compatibility header (not typically reached, but provided for safety). */
+#ifndef _DBGHELP_H_COMPAT
+#define _DBGHELP_H_COMPAT
+#define DBHLPAPI
+
+#include "windows.h"
+#include "imagehlp.h"
+
+/* IMAGEAPI is already defined in windows.h */
+
+/* SYMBOL_INFO (dbghelp-style) */
+typedef struct _SYMBOL_INFO {
+    ULONG    SizeOfStruct;
+    ULONG    TypeIndex;
+    ULONG64  Reserved[2];
+    ULONG    Index;
+    ULONG    Size;
+    ULONG64  ModBase;
+    ULONG    Flags;
+    ULONG64  Address;
+    ULONG    Register;
+    ULONG    Scope;
+    ULONG    Tag;
+    ULONG    NameLen;
+    ULONG    MaxNameLen;
+    CHAR     Name[1];
+} SYMBOL_INFO, *PSYMBOL_INFO;
+
+/* IMAGEHLP_MODULE64 */
+typedef struct _IMAGEHLP_MODULE64 {
+    DWORD    SizeOfStruct;
+    DWORD64  Base;
+    DWORD    ImageSize;
+    DWORD    TimeDateStamp;
+    DWORD    CheckSum;
+    DWORD    NumSyms;
+    CHAR     ModuleName[32];
+    CHAR     ImageName[256];
+    CHAR     LoadedImageName[256];
+    DWORD    LoadedPdbName[2];
+    DWORD    CVData[2];
+    DWORD    PdbSig;
+    DWORD    PdbAge;
+    DWORD    PdbBuildMatched;
+    DWORD    ImageMatched;
+} IMAGEHLP_MODULE64, *PIMAGEHLP_MODULE64;
+
+#endif /* _DBGHELP_H_COMPAT */
