@@ -0,0 +1,929 @@
+/*
+ * Minimal Windows compatibility header for building Detours on non-Windows platforms.
+ * Provides type definitions, PE format structures, and API function declarations.
+ * Function implementations are not provided — this is for compilation only.
+ */
+#ifndef _WINDOWS_H_COMPAT
+#define _WINDOWS_H_COMPAT
+
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <wchar.h>
+#include <limits.h>
+#include <stdarg.h>
+
+/* ── Calling conventions (must come first, used in typedefs) ── */
+#define WINAPI
+#define CALLBACK
+#define APIENTRY
+#define APIRET  WINAPI
+#define NTAPI
+#define IMAGEAPI
+#define PIMAGEAPI WINAPI
+
+/* ── Suppress MSVC-specific pragmas ── */
+#ifndef _MSC_VER
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wpragmas"
+
+/* SEH (Structured Exception Handling) compatibility macros.
+   On non-Windows, __try blocks always execute, __except blocks never execute. */
+#define __try
+#define __except(x) if (0)
+#define GetExceptionCode() 0
+#define GetExceptionInformation() NULL
+#endif
+#pragma GCC diagnostic pop
+
+/* ── Basic types ── */
+typedef uint32_t              DWORD;
+typedef unsigned char       BYTE;
+typedef unsigned short      WORD;
+typedef short               SHORT;
+typedef unsigned short      USHORT;
+typedef int32_t               LONG;
+typedef uint32_t              ULONG;
+typedef int                 BOOL;
+typedef char                CHAR;
+typedef unsigned char       UCHAR;
+typedef wchar_t             WCHAR;
+typedef void                VOID;
+typedef unsigned int        UINT;
+typedef unsigned long long  DWORD64;
+typedef unsigned long long  ULONGLONG;
+typedef long long           LONGLONG;
+typedef int32_t             INT32;
+typedef unsigned int        UINT32;
+typedef unsigned long long  UINT64;
+typedef long long           LONG64;
+typedef long long           INT64;
+typedef int                 INT;
+typedef unsigned char      BOOLEAN;
+typedef unsigned long long  ULONG64;
+typedef void*               PVOID;
+typedef void*               HWND;
+typedef BOOL*               LPBOOL;
+typedef LONG*              LPLONG;
+
+/* UNREFERENCED_PARAMETER */
+#define UNREFERENCED_PARAMETER(p) (void)(p)
+#define _Must_inspect_result_
+
+/* SAL 2.0 annotations — empty macros for non-Windows */
+#define _Analysis_assume_
+#define _Benign_race_begin_
+#define _Benign_race_end_
+#define _Field_range_(x,y)
+#define _Field_size_(x)
+#define _In_
+#define _In_bytecount_(x)
+#define _In_count_(x)
+#define __in_ecount(x)
+#define _In_opt_
+#define _In_opt_bytecount_(x)
