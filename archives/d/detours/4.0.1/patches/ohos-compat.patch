+/* Minimal strsafe.h compatibility header for Detours compilation on non-Windows. */
+#ifndef _STRSAFE_H_COMPAT
+#define _STRSAFE_H_COMPAT
+
+#define _STRSAFE_H_INCLUDED_
+
+#include "windows.h"
+#include <stdarg.h>
+
+static inline HRESULT StringCchLengthA(LPCSTR psz, size_t cchMax, size_t *pcch) {
+    if (!psz || cchMax == 0) return 0x80070057;
+    size_t len = 0;
+    while (len < cchMax && psz[len]) len++;
+    if (len >= cchMax) return 0x80070057;
+    if (pcch) *pcch = len;
+    return 0;
+}
+
+static inline HRESULT StringCchCopyA(LPSTR pszDest, size_t cchDest, LPCSTR pszSrc) {
+    if (cchDest == 0) return 0x80070057;
+    size_t i = 0;
+    while (i < cchDest - 1 && pszSrc && pszSrc[i]) { pszDest[i] = pszSrc[i]; i++; }
+    pszDest[i] = '\0';
+    return 0;
+}
+
+static inline HRESULT StringCchCopyExA(LPSTR pszDest, size_t cchDest, LPCSTR pszSrc, LPSTR *ppszDestEnd, size_t *pcchRemaining, DWORD dwFlags) {
+    if (cchDest == 0) return 0x80070057;
+    size_t i = 0;
+    while (i < cchDest - 1 && pszSrc && pszSrc[i]) { pszDest[i] = pszSrc[i]; i++; }
+    pszDest[i] = '\0';
+    if (ppszDestEnd) *ppszDestEnd = &pszDest[i];
+    if (pcchRemaining) *pcchRemaining = cchDest - i - 1;
+    return 0;
+}
+
+static inline HRESULT StringCchCatA(LPSTR pszDest, size_t cchDest, LPCSTR pszSrc) {
+    if (cchDest == 0) return 0x80070057;
+    size_t dlen = 0;
+    while (dlen < cchDest - 1 && pszDest[dlen]) dlen++;
+    size_t i = 0;
+    while (dlen + i < cchDest - 1 && pszSrc && pszSrc[i]) { pszDest[dlen + i] = pszSrc[i]; i++; }
+    pszDest[dlen + i] = '\0';
+    return 0;
+}
+
+static inline HRESULT StringCchCatW(LPWSTR pszDest, size_t cchDest, LPCWSTR pszSrc) {
+    if (cchDest == 0) return 0x80070057;
+    size_t dlen = 0;
+    while (dlen < cchDest - 1 && pszDest[dlen]) dlen++;
+    size_t i = 0;
+    while (dlen + i < cchDest - 1 && pszSrc && pszSrc[i]) { pszDest[dlen + i] = pszSrc[i]; i++; }
+    pszDest[dlen + i] = L'\0';
+    return 0;
+}
+
+static inline HRESULT StringCchPrintfA(LPSTR pszDest, size_t cchDest, LPCSTR pszFormat, ...) {
+    if (cchDest == 0) return 0x80070057;
+    va_list args; va_start(args, pszFormat);
+    int written = vsnprintf(pszDest, cchDest, pszFormat, args);
+    va_end(args);
+    return (written < 0) ? 0x80070057 : 0;
+}
+
+static inline HRESULT StringCchPrintfW(LPWSTR pszDest, size_t cchDest, LPCWSTR pszFormat, ...) {
+    if (cchDest == 0) return 0x80070057;
+    pszDest[0] = L'\0';
+    return 0;
+}
+
+static inline HRESULT StringCbPrintfA(LPSTR pszDest, size_t cbDest, LPCSTR pszFormat, ...) {
+    if (cbDest == 0) return 0x80070057;
+    va_list args; va_start(args, pszFormat);
+    int written = vsnprintf(pszDest, cbDest, pszFormat, args);
+    va_end(args);
+    return (written < 0) ? 0x80070057 : 0;
+}
+
+#endif /* _STRSAFE_H_COMPAT */
