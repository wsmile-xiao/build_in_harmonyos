--- a/configure.ac
+++ b/configure.ac
@@ -1,16 +1,29 @@
 m4_include([version.m4])
 AC_INIT([ding-libs],
         VERSION_NUMBER,
         [sssd-devel@lists.fedorahosted.org])
 AC_CONFIG_SRCDIR([README])
 AC_CONFIG_AUX_DIR([build])
+
+# HarmonyOS HMDFS normalizes private temporary directories; keep the build
+# directory writable by the owning group without changing global permissions.
+m4_define([AS_TMPDIR],
+[# Create a temporary directory with an OHOS-compatible umask.
+{
+  tmp=`(umask 027 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  test -d "$tmp"
+} ||
+{
+  tmp=./conf$$-$RANDOM
+  (umask 027 && mkdir "$tmp")
+} || AS_ERROR([cannot create a temporary directory in .])])
 
 m4_ifdef([AC_USE_SYSTEM_EXTENSIONS],
     [AC_USE_SYSTEM_EXTENSIONS],
     [AC_GNU_SOURCE])
 AM_INIT_AUTOMAKE([-Wall foreign subdir-objects])
 AM_PROG_CC_C_O
 m4_ifdef([AM_PROG_AR], [AM_PROG_AR])
 AC_PROG_LIBTOOL
 AC_CONFIG_MACRO_DIR([m4])
 AC_PROG_INSTALL
