+    fail_unless_str_equal(p, "/usr/bin");
 
     /* if pathname does not contain a slash, the parent is cwd */
     fail_if(getcwd(cwd, PATH_MAX) == NULL, "getcwd failed");
@@ -578,7 +581,7 @@
 START_TEST(test_find_existing_directory_ancestor_neg)
 {
     char small[4];
