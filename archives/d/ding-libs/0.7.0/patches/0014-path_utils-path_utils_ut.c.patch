--- a/path_utils/path_utils_ut.c
+++ b/path_utils/path_utils_ut.c
@@ -564,8 +564,11 @@
     char p[PATH_MAX];
     char cwd[PATH_MAX];
 
-    fail_unless(find_existing_directory_ancestor(p, PATH_MAX, "/etc/passwd") == SUCCESS);
-    fail_unless_str_equal(p, "/etc");
+    /* Probe a file whose parent is a real directory on every target:
+     * /etc is a symbolic link on some systems (HarmonyOS, for example)
