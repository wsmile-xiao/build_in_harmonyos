+    /* C99 hexadecimal floating point: 0x<hex>[.<hex>][p[+-]<dec>] */
+    if (p[0]=='0' && (p[1]=='x' || p[1]=='X')) {
+        const char* q = p + 2;
+        ldbltype h = 0.;
+        int ndig = 0;
+        int nfrac = 0;
+        for (;;) {
+            unsigned int d;
+            if ((unsigned int)(*q - '0') < 10u) d = *q - '0';
+            else if ((*q | 32) >= 'a' && (*q | 32) <= 'f') d = (*q | 32) - 'a' + 10;
+            else break;
+            h = h*16. + d;
+            ++q; ++ndig;
+        }
+        if (*q == '.') {
+            ++q;
+            for (;;) {
+                unsigned int d;
+                if ((unsigned int)(*q - '0') < 10u) d = *q - '0';
+                else if ((*q | 32) >= 'a' && (*q | 32) <= 'f') d = (*q | 32) - 'a' + 10;
+                else break;
+                h = h*16. + d;
+                ++q; ++nfrac; ++ndig;
+            }
+        }
+        if (!ndig) {
+            /* "0x" with no hex digits: consume only the leading "0" */
+            if (endptr) *endptr = (char*)(p + 1);
+            return 0.;
+        }
+        if ((*q | 32) == 'p') {
+            const char* r = q + 1;
+            long e = 0;
+            int esign = +1;
+            if (*r == '-') { esign = -1; ++r; }
+            else if (*r == '+') { ++r; }
+            if ((unsigned int)(*r - '0') >= 10u) {
+                /* 'p' without digits: value is just the significand */
+                if (nfrac) {
+                    ldbltype f = 0.5;
+                    unsigned long u = (unsigned long)(4 * nfrac);
+                    for (;;) {
+                        if (u & 1) h *= f;
+                        if (!(u >>= 1)) break;
+                        f *= f;
+                    }
+                }
+                if (endptr) *endptr = (char*)q;
+                return (double)(h * sign);
+            }
+            while ((unsigned int)(*r - '0') < 10u)
+                e = e*10 + (*r++ - '0');
+            q = r;
+            {
+                long x = esign < 0 ? -(e + 4L*nfrac) : (e - 4L*nfrac);
+                ldbltype f = (x < 0) ? 0.5 : 2.;
+                unsigned long u = (unsigned long)(x < 0 ? -x : x);
+                for (;;) {
+                    if (u & 1) h *= f;
+                    if (!(u >>= 1)) break;
+                    f *= f;
+                }
+            }
+        } else if (nfrac) {
+            ldbltype f = 0.5;
+            unsigned long u = (unsigned long)(4 * nfrac);
+            for (;;) {
+                if (u & 1) h *= f;
+                if (!(u >>= 1)) break;
+                f *= f;
+            }
+        }
+        if (endptr) *endptr = (char*)q;
+        return (double)(h * sign);
+    }
