diff --git a/lib/__v_scanf.c b/lib/__v_scanf.c
index c90df27..6619c40 100644
--- a/lib/__v_scanf.c
+++ b/lib/__v_scanf.c
@@ -64,6 +64,8 @@ int __v_scanf(struct arg_scanf* fn, const char *format, va_list arg_ptr)
 	char flag_half=0;
 	char flag_long=0;
 	char flag_longlong=0;
+	int lcount=0;
+	char Llflag=0;
 
 in_scan:
 	ch=*format++;
@@ -80,17 +82,20 @@ in_scan:
 
 	/* FLAGS */
 	case '*':
+	  if (flag_width) goto err_out;	/* '*' must precede the width */
 	  flag_discard=1;
 	  goto in_scan;
 	case 'h':
 	  flag_half=1;
 	  goto in_scan;
 	case 'l':
+	  if (++lcount>2) goto err_out;		/* at most two 'l' (ll) */
 	  if (flag_long) flag_longlong=1;
 	  flag_long=1;
 	  goto in_scan;
 	case 'q':
 	case 'L':
+	  Llflag=1;
 	  flag_longlong=1;
 	  goto in_scan;
 
@@ -105,6 +110,7 @@ in_scan:
 	case '7':
 	case '8':
 	case '9':
+	  if (flag_long || flag_half || flag_longlong) goto err_out; /* width must precede length */
 	  width=strtol(format-1,&s,10);
 	  format=s;
 	  flag_width=1;
@@ -122,6 +128,7 @@ in_scan:
 	case 'u':
 	case 'i':
 	  {
+	    if (Llflag) goto err_out;	/* %Ld/%qd invalid for integers */
 #ifdef WANT_LONGLONG_SCANF
 	    unsigned long long v=0;
 #else
