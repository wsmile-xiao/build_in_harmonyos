diff --git a/lib/__v_printf.c b/lib/__v_printf.c
index c28b480..6819c6c 100644
--- a/lib/__v_printf.c
+++ b/lib/__v_printf.c
@@ -404,8 +404,101 @@ num_printf:
 	  flag_hash=0;
 	  goto print_out;
 	}
+	      /* %a/%A: C99 hexadecimal floating point */
+	      case 'a':
+	      case 'A':
+		{
+		  union { double d; unsigned long long l; } uu;
+		  unsigned long long mant;
+		  int exp2, i, signchar=0;
+		  unsigned int ndig;
+		  char hex[16];
+		  char *q;
+		  const char *hx;
+
+		  flag_upcase = (ch=='A');
+		  hx = flag_upcase ? "0123456789ABCDEF" : "0123456789abcdef";
+		  uu.d = va_arg(arg_ptr,double);
+		  mant = uu.l & ((1ull<<52)-1);
+		  exp2 = (int)((uu.l >> 52) & 0x7ff);
+
+		  if (uu.l >> 63) signchar='-';
+		  else if (flag_sign) signchar='+';
+		  else if (flag_space) signchar=' ';
+
+		  q = buf+1;
+		  if (signchar) *q++ = (char)signchar;
+		  *q++ = '0';
+		  *q++ = (flag_upcase ? 'X' : 'x');
+
+		  if (exp2 == 0x7ff) {		/* inf / nan */
+		    if (mant == 0) { *q++=(flag_upcase?'I':'i'); *q++=(flag_upcase?'N':'n'); *q++=(flag_upcase?'F':'f'); }
+		    else           { *q++=(flag_upcase?'N':'n'); *q++=(flag_upcase?'A':'a'); *q++=(flag_upcase?'N':'n'); }
+		    *q = 0; s = buf+1; sz = strlen(s);
+		    flag_hash = 0; flag_in_sign = 0; flag_dot = 0; goto print_out;
+		  }
+
+		  if (exp2 == 0 && mant == 0) {	/* zero */
+		    *q++ = '0';
+		    if (flag_dot && preci) { unsigned int z = preci; *q++ = '.'; while (z--) *q++ = '0'; }
+		    *q++ = 'p'; *q++ = '+'; *q++ = '0'; *q = 0;
+		    s = buf+1; sz = strlen(s);
+		    flag_hash = (signchar ? 3 : 2); flag_in_sign = 0; flag_dot = 0; goto print_out;
+		  }
+
+		  {
+		    int leading;
+		    if (exp2 == 0) { exp2 = -1022; leading = 0; }	/* subnormal */
+		    else           { exp2 -= 1023; leading = 1; }	/* normal */
+
+		    for (i = 0; i < 13; ++i) { hex[12-i] = hx[mant & 0xf]; mant >>= 4; }
+		    hex[13] = 0;
+
+		    if (flag_dot) {
+		      ndig = preci; if (ndig > 13) ndig = 13;
+		      if (ndig < 13) {	/* round to ndig hex digits (half-up) */
+			int r = hex[ndig]-'0'; if (r>9) r -= ('a'-'0')-10;
+			if (r >= 8) {
+			  int carry = 1;
+			  for (i = (int)ndig-1; i >= 0 && carry; --i) {
+			    int dv = hex[i]-'0'; if (dv>9) dv -= ('a'-'0')-10;
+			    if (++dv < 16) { hex[i]=hx[dv]; carry=0; } else hex[i]='0';
+			  }
+			  if (carry) { if (leading==15) { leading=0; ++exp2; } else ++leading; }
+			}
+		      }
+		    } else {
+		      ndig = 13;
+		      while (ndig > 0 && hex[ndig-1] == '0') --ndig;
+		    }
+
+		    *q++ = hx[leading];
+		    if (ndig > 0 || flag_hash) {
+		      *q++ = '.';
+		      for (i = 0; i < (int)ndig; ++i) *q++ = hex[i];
+		    }
+		    *q++ = 'p';
+		    if (exp2 < 0) { *q++='-'; exp2=-exp2; } else *q++='+';
+		    { char ebuf[8]; int en=0; do { ebuf[en++]=(char)('0'+exp2%10); exp2/=10; } while (exp2); while (en) *q++=ebuf[--en]; }
+		    *q = 0;
+		  }
+
+		  s = buf+1; sz = strlen(s);
+		  flag_hash = (signchar ? 3 : 2);
+		  flag_in_sign = 0; flag_dot = 0;
+		  goto print_out;
+		}
 #endif
 
+      /* %n: store number of bytes written so far (with h/l/ll width) */
+      case 'n':
+	if (flag_long>1)       *(va_arg(arg_ptr,long long*)) = (long long)len;
+	else if (flag_long>0)  *(va_arg(arg_ptr,long*))      = (long)len;
+	else if (flag_long<-1) *(va_arg(arg_ptr,char*))      = (char)len;
+	else if (flag_long<0)  *(va_arg(arg_ptr,short*))     = (short)len;
+	else                   *(va_arg(arg_ptr,int*))       = (int)len;
+	break;
+
       default:
 	break;
       }
