diff -ruN /dev/null b/build.sh
--- /dev/null
+++ b/build.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+# build.sh for doh 0.1 - wrapper for simple Makefile build
+# Usage: ./build.sh [all|install|clean]
+
+set -e
+
+ACTION="${1:-all}"
+
+case "$ACTION" in
+    all|build)
+        make -j1
+        ;;
+    install)
+        PREFIX="${DESTDIR}${PREFIX:-/storage/Users/currentUser/usr/local}"
+        mkdir -p "$PREFIX/bin" "$PREFIX/share/man/man1"
+        cp doh "$PREFIX/bin/doh"
+        cp doh.1 "$PREFIX/share/man/man1/doh.1"
+        ;;
+    clean)
+        make clean
+        ;;
+    *)
+        echo "Usage: $0 [all|install|clean]"
+        exit 1
+        ;;
+esac
