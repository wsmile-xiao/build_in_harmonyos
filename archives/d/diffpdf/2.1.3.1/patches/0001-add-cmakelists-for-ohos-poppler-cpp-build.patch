diff --git a/diffpdf-v2.1.3.1/poppler-qt5.cpp b/diffpdf-v2.1.3.1/poppler-qt5.cpp
new file mode 100644
index 0000000..e4e1672
--- /dev/null
+++ b/diffpdf-v2.1.3.1/poppler-qt5.cpp
@@ -0,0 +1,229 @@
+/*
+ * poppler-qt5.cpp — Implementation of the poppler-qt5 compatibility
+ * shim for diffpdf on HarmonyOS PC (see poppler-qt5.h).
+ *
+ * Mapping notes (poppler-qt5 API -> poppler-cpp API):
+ *
+ *  - Document::load(name)         -> poppler::document::load_from_file
+ *  - Document::isLocked()         -> is_locked()
+ *  - Document::numPages()         -> pages()
+ *  - Document::page(i)            -> create_page(i)
+ *  - Document::infoKeys()         -> info_keys()
+ *  - Document::info(key)          -> info_key(key) (ustring -> QString)
+ *  - Document::date(key)          -> info_date_t(key) -> QDateTime
+ *  - Document::setRenderHint      -> stored on Document; applied by
+ *                                    Page::renderToImage through a
+ *                                    poppler::page_renderer
+ *  - Page::pageSize()             -> page_rect(crop_box) size in points
+ *  - Page::renderToImage(xres,yres,x,y,w,h)
+ *                                -> page_renderer::render_page +
+ *                                   image -> QImage conversion
+ *  - Page::textList()             -> text_list() (vector<text_box>)
+ *  - TextBox::text()              -> text_box::text() (ustring)
+ *  - TextBox::boundingBox()       -> text_box::bbox()
+ *  - TextBox::charBoundingBox(i)  -> text_box::char_bbox(i)
+ *
+ * poppler-cpp ustring is UTF-32-ish (ustring::to_utf8() converts to
+ * UTF-8 std::string); QString::fromUtf8 is used for the conversion.
+ *
+ * poppler-cpp image format_argb32 stores 0xAARRGGBB packed into
+ * char data with native endianness, which matches QImage::Format_ARGB32
+ * on little-endian aarch64.
+ */
+
+#include "poppler-qt5.h"
+
+#include <QByteArray>
+#include <QDateTime>
+#include <QImage>
+#include <QString>
+#include <QStringList>
+
+#include <cstring>
+
+namespace {
+
+QString ustringToQString(const poppler::ustring &us)
+{
+    if (us.empty())
+        return QString();
+    const poppler::byte_array utf8 = us.to_utf8();
+    return QString::fromUtf8(utf8.data(), static_cast<int>(utf8.size()));
+}
+
+QRectF rectfToQRectF(const poppler::rectf &r)
+{
+    return QRectF(r.left(), r.top(), r.width(), r.height());
+}
+
+} // namespace
+
+namespace Poppler {
+
+// ---------------------------------------------------------------- Document
+
+Document::~Document()
+{
+    delete m_doc;
+}
+
+Document::Document(poppler::document *doc)
+    : m_doc(doc), m_renderHints(0)
+{
+}
+
+Document *Document::load(const QString &fileName,
+                         const QByteArray &ownerPassword,
+                         const QByteArray &userPassword)
+{
+    poppler::document *doc = poppler::document::load_from_file(
+        fileName.toStdString(),
+        std::string(ownerPassword.constData(), ownerPassword.size()),
+        std::string(userPassword.constData(), userPassword.size()));
+    if (!doc)
+        return nullptr;
+    return new Document(doc);
+}
+
+bool Document::isLocked() const
+{
+    return m_doc->is_locked();
+}
+
+int Document::numPages() const
+{
+    return m_doc->pages();
+}
+
+Page *Document::page(int index) const
+{
+    if (index < 0 || index >= m_doc->pages())
+        return nullptr;
+    poppler::page *p = m_doc->create_page(index);
+    if (!p)
+        return nullptr;
+    return new Page(p, m_renderHints);
+}
+
+QStringList Document::infoKeys() const
+{
+    QStringList keys;
+    const std::vector<std::string> k = m_doc->info_keys();
+    keys.reserve(static_cast<int>(k.size()));
+    for (std::size_t i = 0; i < k.size(); ++i)
+        keys.append(QString::fromUtf8(k[i].c_str()));
+    return keys;
+}
+
+QString Document::info(const QString &key) const
+{
+    return ustringToQString(m_doc->info_key(key.toStdString()));
+}
+
+QDateTime Document::date(const QString &key) const
+{
+    const time_t t = m_doc->info_date_t(key.toStdString());
+    if (t == time_t(-1))
+        return QDateTime();
+    return QDateTime::fromSecsSinceEpoch(static_cast<qint64>(t));
+}
+
+void Document::setRenderHint(RenderHint hint, bool on)
+{
+    unsigned int flag = 0;
+    switch (hint) {
+    case Antialiasing:     flag = poppler::page_renderer::antialiasing; break;
+    case TextAntialiasing: flag = poppler::page_renderer::text_antialiasing; break;
+    }
+    if (on)
+        m_renderHints |= flag;
+    else
+        m_renderHints &= ~flag;
+}
+
+// ------------------------------------------------------------------- Page
+
+Page::Page(poppler::page *page, unsigned int renderHints)
+    : m_page(page), m_renderHints(renderHints)
+{
+}
+
+Page::~Page()
+{
+    delete m_page;
+}
+
+QSize Page::pageSize() const
+{
+    const poppler::rectf r = m_page->page_rect(poppler::crop_box);
+    return QSize(static_cast<int>(r.width()), static_cast<int>(r.height()));
+}
+
+QImage Page::renderToImage(double xres, double yres, int x, int y,
+                           int w, int h) const
+{
+    poppler::page_renderer renderer;
+    renderer.set_render_hints(m_renderHints);
+    renderer.set_image_format(poppler::image::format_argb32);
+    const poppler::image img = renderer.render_page(
+        m_page, xres, yres, x, y, w, h, poppler::rotate_0);
+    if (!img.is_valid() || img.width() <= 0 || img.height() <= 0)
+        return QImage();
+    // poppler-cpp format_argb32 = 0xAARRGGBB per pixel, 4 bytes/pixel,
+    // stored in native host byte order (little-endian on aarch64).
+    // QImage::Format_ARGB32 expects exactly the same layout.
+    QImage result(reinterpret_cast<const uchar *>(img.const_data()),
+                  img.width(), img.height(),
+                  img.bytes_per_row(), QImage::Format_ARGB32);
+    return result.copy(); // detach from poppler-owned buffer
+}
+
+std::vector<TextBox *> Page::textList() const
+{
+    std::vector<TextBox *> boxes;
+    const std::vector<poppler::text_box> raw = m_page->text_list();
+    boxes.reserve(raw.size());
+    for (std::size_t i = 0; i < raw.size(); ++i)
+        boxes.push_back(new TextBox(raw[i]));
+    return boxes;
+}
+
+// --------------------------------------------------------------- TextBox
+
+TextBox::TextBox(const poppler::text_box &box)
+{
+    m_text = std::string(box.text().to_utf8().data(),
+                         box.text().to_utf8().size());
+    m_bbox = rectfToQRectF(box.bbox());
+    // poppler-cpp char_bbox(i) is per-glyph; in simple scripts the
+    // glyph count matches the UTF-8 codepoint sequence for the kinds
+    // of documents diffpdf compares (Latin/CJK PDF text). The glyph
+    // count may differ from codepoint count in complex scripts; extra
+    // queries beyond the stored list return a null QRectF (upstream
+    // poppler-qt5 returns the text_box bbox in that case, but
+    // diffpdf never indexes past word.length()).
+    const poppler::ustring us = box.text();
+    const poppler::byte_array utf8 = us.to_utf8();
+    m_charBoxes.reserve(utf8.size());
+    for (std::size_t i = 0; i < utf8.size(); ++i)
+        m_charBoxes.push_back(rectfToQRectF(box.char_bbox(i)));
+}
+
+QString TextBox::text() const
+{
+    return QString::fromUtf8(m_text.c_str(), static_cast<int>(m_text.size()));
+}
+
+QRectF TextBox::boundingBox() const
+{
+    return m_bbox;
+}
+
+QRectF TextBox::charBoundingBox(int index) const
+{
+    if (index < 0 || static_cast<std::size_t>(index) >= m_charBoxes.size())
+        return QRectF();
+    return m_charBoxes[static_cast<std::size_t>(index)];
+}
+
+} // namespace Poppler
diff --git a/diffpdf-v2.1.3.1/poppler-qt5.h b/diffpdf-v2.1.3.1/poppler-qt5.h
new file mode 100644
index 0000000..91cdebf
--- /dev/null
+++ b/diffpdf-v2.1.3.1/poppler-qt5.h
@@ -0,0 +1,124 @@
+/*
+ * poppler-qt5.h — Compatibility shim for diffpdf on HarmonyOS PC.
+ *
+ * The upstream diffpdf 2.1.3.1 uses the Qt5 bindings of poppler
+ * (libpoppler-qt5-dev: Poppler::Document / Poppler::Page /
+ * Poppler::TextBox). The ohpcd conan registry publishes poppler
+ * 25.12.0.2 with ENABLE_QT5=OFF / ENABLE_QT6=OFF (no Qt bindings),
+ * because building the Qt bindings would couple the poppler package
+ * to a specific Qt version for every consumer.
+ *
+ * This header reimplements the small subset of the poppler-qt5 API
+ * that diffpdf actually uses, on top of the plain poppler-cpp
+ * frontend shipped inside the poppler package:
+ *
+ *   Poppler::Document          -> poppler::document
+ *     Document::load(), isLocked(), numPages(), page(i),
+ *     infoKeys(), info(key), date(key), setRenderHint()
+ *   Poppler::Page              -> poppler::page
+ *     pageSize(), renderToImage(dpi,dpi[,x,y,w,h]), textList()
+ *   Poppler::TextBox           -> poppler::text_box
+ *     text(), boundingBox(), charBoundingBox(i)
+ *
+ * Ownership model mirrors poppler-qt5: Document::load() returns a
+ * heap Document; Document::page() returns a heap Page owned by the
+ * document; page->textList() returns heap TextBox* vectors owned by
+ * the page (freed when the page is destroyed).
+ *
+ * diffpdf holds these in QSharedPointer (PdfDocument/PdfPage/
+ * PdfTextBox typedefs in generic.hpp), which keeps the upstream code
+ * unchanged.
+ */
+
+#ifndef POPPLER_QT5_SHIM_H
+#define POPPLER_QT5_SHIM_H
+
+#include <QDateTime>
+#include <QImage>
+#include <QRectF>
+#include <QSize>
+#include <QString>
+#include <QStringList>
+
+#include <poppler/cpp/poppler-document.h>
+#include <poppler/cpp/poppler-global.h>
+#include <poppler/cpp/poppler-image.h>
+#include <poppler/cpp/poppler-page-renderer.h>
+#include <poppler/cpp/poppler-page.h>
+
+#include <string>
+#include <vector>
+
+namespace Poppler {
+
+class Page;
+
+class Document
+{
+public:
+    enum RenderHint { Antialiasing = 1, TextAntialiasing = 2 };
+
+    ~Document();
+    Document(const Document &) = delete;
+    Document &operator=(const Document &) = delete;
+
+    static Document *load(const QString &fileName,
+                          const QByteArray &ownerPassword = QByteArray(),
+                          const QByteArray &userPassword = QByteArray());
+
+    bool isLocked() const;
+    int numPages() const;
+    Page *page(int index) const;
+
+    QStringList infoKeys() const;
+    QString info(const QString &key) const;
+    QDateTime date(const QString &key) const;
+
+    void setRenderHint(RenderHint hint, bool on = true);
+
+private:
+    explicit Document(poppler::document *doc);
+    poppler::document *m_doc;
+    unsigned int m_renderHints;
+};
+
+class TextBox;
+
+class Page
+{
+public:
+    ~Page();
+    Page(const Page &) = delete;
+    Page &operator=(const Page &) = delete;
+
+    QSize pageSize() const;
+    QImage renderToImage(double xres = 72.0, double yres = 72.0,
+                         int x = -1, int y = -1, int w = -1,
+                         int h = -1) const;
+    std::vector<TextBox *> textList() const;
+
+private:
+    explicit Page(poppler::page *page, unsigned int renderHints);
+    poppler::page *m_page;
+    unsigned int m_renderHints;
+    friend class Document;
+};
+
+class TextBox
+{
+public:
+    QString text() const;
+    QRectF boundingBox() const;
+    QRectF charBoundingBox(int index) const;
+
+private:
+    explicit TextBox(const poppler::text_box &box);
+    std::string m_text;
+    QRectF m_bbox;
+    std::vector<QRectF> m_charBoxes;
+    friend class Page;
+};
+
+} // namespace Poppler
+
+#endif // POPPLER_QT5_SHIM_H
-- 
