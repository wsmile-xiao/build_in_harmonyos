+cmake_minimum_required(VERSION 3.16)
+project(DiffPDF VERSION 2.1.3.1 LANGUAGES CXX)
+
+# OHOS PC (aarch64 musl) adaptation build for diffpdf 2.1.3.1.
+#
+# Upstream CMakeLists.txt requires: ECM (extra-cmake-modules) +
+# poppler-qt5 (libpoppler-qt5-dev). The ohpcd conan registry publishes
+# poppler with ENABLE_QT5=OFF (no Qt bindings) and there is no
+# poppler-qt5 package, so this adaptation ships a poppler-qt5
+# compatibility shim (poppler-qt5.h/.cpp) implemented on top of the
+# plain poppler-cpp frontend that the registry poppler package DOES
+# provide. See patches/poppler-qt5.h for the API mapping.
+#
+# Qt5 comes from conan package qt5-qtbase/5.15.2.2 (Core/Gui/Widgets/
+# PrintSupport included). Include dirs are passed explicitly via
+# DIFFPDF_QT5_INCLUDE_DIRS (CMakeDeps component dirs are not wired for
+# this Qt packaging, matching the disomaster/acetoneiso recipes).
+#
+# This outer CMakeLists.txt is applied at the tarball root; the actual
+# target definition lives in diffpdf-v2.1.3.1/CMakeLists.txt (also
+# added by the patch, replacing the upstream ECM/poppler-qt5 file).
+
+set(CMAKE_CXX_STANDARD 14)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+# Upstream tarball top-level dir (source() keeps it, patch paths
+# are a/diffpdf-v2.1.3.1/...).
+add_subdirectory(diffpdf-v2.1.3.1)
