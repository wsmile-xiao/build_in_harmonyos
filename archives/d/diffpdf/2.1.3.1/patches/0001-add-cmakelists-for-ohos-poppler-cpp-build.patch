+set(diffpdf_MOC_HEADERS
+    aboutform.hpp
+    helpform.hpp
+    label.hpp
+    lineedit.hpp
+    mainwindow.hpp
+    optionsform.hpp
+    saveform.hpp)
+
+add_executable(diffpdf ${diffpdf_SRCS} ${diffpdf_MOC_HEADERS})
+
+# ---- Manual moc step ----------------------------------------------------
+# Headers carrying Q_OBJECT need moc-generated sources; CMAKE_AUTOMOC
+# cannot be used (see NOTE above). The moc binary comes from the
+# qt5-qtbase conan package (DIFFPDF_QT5_MOC passed by the recipe).
+# moc runs as a *build host* tool: it needs LD_LIBRARY_PATH set to the
+# qt5 lib dir so the dynamically linked moc resolves libQt5Core.
+find_program(DIFFPDF_MOC_EXE moc HINTS "${DIFFPDF_QT5_BIN_DIR}")
+if(NOT DIFFPDF_MOC_EXE)
+    message(FATAL_ERROR "moc not found (looked in DIFFPDF_QT5_BIN_DIR)")
+endif()
+
+set(_moc_out "")
+foreach(_hdr ${diffpdf_MOC_HEADERS})
+    get_filename_component(_base "${_hdr}" NAME_WE)
+    set(_out "${CMAKE_CURRENT_BINARY_DIR}/moc_${_base}.cpp")
+    add_custom_command(
+        OUTPUT "${_out}"
+        COMMAND ${CMAKE_COMMAND} -E env
+                "LD_LIBRARY_PATH=${DIFFPDF_QT5_LIB_DIR}"
+                "${DIFFPDF_MOC_EXE}"
+                ${DIFFPDF_QT5_MOC_INCLUDES}
+                "${CMAKE_CURRENT_SOURCE_DIR}/${_hdr}"
+                -o "${_out}"
+        DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${_hdr}"
+        COMMENT "moc ${_hdr}")
+    list(APPEND _moc_out "${_out}")
+endforeach()
+target_sources(diffpdf PRIVATE ${_moc_out})
+
+target_include_directories(diffpdf PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${CMAKE_CURRENT_BINARY_DIR}
+    ${DIFFPDF_QT5_INCLUDE_DIRS}
+    ${DIFFPDF_POPPLER_CPP_INCLUDE_DIR}
+)
+
+target_link_directories(diffpdf PRIVATE
+    ${DIFFPDF_QT5_LIB_DIR}
+    ${DIFFPDF_POPPLER_CPP_LIB_DIR}
+)
+
+target_link_libraries(diffpdf PRIVATE
+    Qt5Widgets
+    Qt5Gui
+    Qt5Core
+    Qt5PrintSupport
+    ${DIFFPDF_POPPLER_CPP_LIBRARY}
+)
+
+# Upstream CMakeLists defines POPPLER_VERSION from the FindPoppler
+# module; the shim build reports the poppler-cpp version instead.
+target_compile_definitions(diffpdf PRIVATE
+    POPPLER_VERSION="${DIFFPDF_POPPLER_VERSION}")
+
+install(TARGETS diffpdf DESTINATION bin)
