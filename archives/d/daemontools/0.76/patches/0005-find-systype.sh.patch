diff -ruN a/find-systype.sh b/find-systype.sh
--- a/find-systype.sh
+++ b/find-systype.sh
@@ -72,22 +72,22 @@
     ;;
   *)
     oper="$sys-$unamer-$unamev"
     arch="`arch | tr /: ..`"
     syst=""
     chip="$unamem"
     kern=""
     ;;
   esac
 else
-  gcc -c trycpp.c
-  gcc -o trycpp trycpp.o
+  clang -c trycpp.c
+  clang -o trycpp trycpp.o
   case `./trycpp` in
   nextstep)
     oper="nextstep-`hostinfo | sed -n 's/^[ 	]*NeXT Mach \([^:]*\):.*$/\1/p'`"
     arch="`hostinfo | sed -n 's/^Processor type: \(.*\) (.*)$/\1/p' | tr /: ..`"
     syst=""
     chip="`hostinfo | sed -n 's/^Processor type: .* (\(.*\))$/\1/p' | tr ' /:' '...'`"
     kern=""
     ;;
   *)
     oper="unknown"
@@ -119,23 +119,23 @@
   ;;
 i586)
   # no, you nitwits, there is no such chip. (Linux)
   chip=pentium
   ;;
 i686)
   # STOP SAYING THAT! (Linux)
   chip=ppro
 esac
 
-if gcc -c x86cpuid.c
+if clang -c x86cpuid.c
 then
-  if gcc -o x86cpuid x86cpuid.o
+  if clang -o x86cpuid x86cpuid.o
   then
     x86cpuid="`./x86cpuid | tr /: ..`"
     case "$x86cpuid" in
       ?*)
         chip="$x86cpuid"
         ;;
     esac
   fi
 fi
 rm -f x86cpuid x86cpuid.o
