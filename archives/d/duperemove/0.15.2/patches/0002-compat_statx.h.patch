diff -ruN a/compat_statx.h b/compat_statx.h
--- a/compat_statx.h
+++ b/compat_statx.h
@@ -0,0 +1,87 @@
+/*
+ * compat_statx.h - OpenHarmony compatibility layer
+ */
+#ifndef COMPAT_STATX_H
+#define COMPAT_STATX_H
+
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <stdint.h>
+#include <fcntl.h>
+
+#ifndef STATX_BASIC_STATS
+#define STATX_BASIC_STATS 0x000007ffU
+#endif
+
+#ifndef AT_FDCWD
+#define AT_FDCWD -100
+#endif
+
+struct compat_statx_timestamp {
+    int64_t tv_sec;
+    uint32_t tv_nsec;
+};
+#define statx_timestamp compat_statx_timestamp
+
+struct compat_statx {
+    uint32_t stx_mask;
+    uint32_t stx_blksize;
+    uint64_t stx_attributes;
+    uint32_t stx_nlink;
+    uint32_t stx_uid;
+    uint32_t stx_gid;
+    uint16_t stx_mode;
+    uint64_t stx_ino;
+    uint64_t stx_size;
+    uint64_t stx_blocks;
+    uint64_t stx_attributes_mask;
+    struct statx_timestamp stx_atime;
+    struct statx_timestamp stx_btime;
+    struct statx_timestamp stx_ctime;
+    struct statx_timestamp stx_mtime;
+    uint32_t stx_rdev_major;
+    uint32_t stx_rdev_minor;
+    uint32_t stx_dev_major;
+    uint32_t stx_dev_minor;
+};
+
+static inline int compat_statx(int dirfd, const char *pathname, int flags,
+                               unsigned int mask, struct compat_statx *stx)
+{
+    struct stat st;
+    int ret;
+
+    if (pathname && pathname[0] == '/') {
+        ret = stat(pathname, &st);
+    } else if (dirfd == AT_FDCWD || dirfd > 0) {
+        ret = fstatat(dirfd, pathname, &st, flags);
+    } else {
+        ret = stat(pathname, &st);
+    }
+    
+    if (ret < 0) return ret;
+
+    stx->stx_mask = STATX_BASIC_STATS;
+    stx->stx_blksize = st.st_blksize;
+    stx->stx_nlink = st.st_nlink;
+    stx->stx_uid = st.st_uid;
+    stx->stx_gid = st.st_gid;
+    stx->stx_mode = st.st_mode;
+    stx->stx_ino = st.st_ino;
+    stx->stx_size = st.st_size;
+    stx->stx_blocks = st.st_blocks;
+
+    stx->stx_atime.tv_sec = st.st_atime;
+    stx->stx_mtime.tv_sec = st.st_mtime;
+    stx->stx_ctime.tv_sec = st.st_ctime;
+    stx->stx_btime.tv_sec = st.st_ctime;
+
+    stx->stx_dev_major = major(st.st_dev);
+    stx->stx_dev_minor = minor(st.st_dev);
+    stx->stx_rdev_major = major(st.st_rdev);
+    stx->stx_rdev_minor = minor(st.st_rdev);
+
+    return 0;
+}
+
+#endif
