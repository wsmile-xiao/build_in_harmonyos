diff --git a/src/cli-auth.c b/src/cli-auth.c
index fc414f3..758a8e9 100644
--- a/src/cli-auth.c
+++ b/src/cli-auth.c
@@ -360,7 +360,28 @@ char* getpass_or_cancel(const char* prompt)
 	}
 
 	if (!cli_opts.batch_mode) {
+#ifdef HAVE_GETPASS
 		password = getpass(prompt);
+#else
+		/* Platform without getpass() (e.g. OHOS): read one line from
+		 * the terminal, mirroring getpass() semantics for interactive
+		 * password entry (echo handling is left to the tty driver). */
+		static char password_buf[256];
+		FILE *tty = fopen("/dev/tty", "r+");
+		password = NULL;
+		if (tty) {
+			fprintf(tty, "%s", prompt);
+			fflush(tty);
+			if (fgets(password_buf, sizeof(password_buf), tty) != NULL) {
+				size_t len = strlen(password_buf);
+				if (len > 0 && password_buf[len-1] == '\n') {
+					password_buf[len-1] = '\0';
+				}
+				password = password_buf;
+			}
+			fclose(tty);
+		}
+#endif
 	}
 
 	/* 0x03 is a ctrl-c character in the buffer. */
