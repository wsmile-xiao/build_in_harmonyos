 }
 
 #if DROPBEAR_CLI_PASSWORD_AUTH || DROPBEAR_CLI_INTERACT_AUTH
 /* A helper for getpass() that exits if the user cancels. The returned
  * password is statically allocated by getpass() */
 char* getpass_or_cancel(const char* prompt)
 {
 	char* password = NULL;
-	
+
 #if DROPBEAR_USE_PASSWORD_ENV
 	/* Password provided in an environment var */
 	password = getenv(DROPBEAR_PASSWORD_ENV);
 	if (password)
 	{
 		return password;
 	}
 #endif
 	if (cli_opts.batch_mode) {
 		dropbear_close("BatchMode active, no interactive session possible.");
 	}
 
 	if (!cli_opts.batch_mode) {
+#ifdef HAVE_GETPASS
 		password = getpass(prompt);
+#else
+		/* HarmonyOS: getpass() not implemented, use simple fgets */
+		static char password_buf[256];
+		fprintf(stderr, "%s", prompt);
+		fflush(stderr);
+		if (fgets(password_buf, sizeof(password_buf), stdin) != NULL) {
+			password = password_buf;
+			/* Remove trailing newline */
+			size_t len = strlen(password_buf);
+			if (len > 0 && password_buf[len-1] == '\n') {
+				password_buf[len-1] = '\0';
+			}
+		}
+#endif
 	}
 
 	/* 0x03 is a ctrl-c character in the buffer. */
 	if (password == NULL || strchr(password, '\3') != NULL) {
 		dropbear_close("Interrupted.");
 	}
 	return password;
 }
 #endif
