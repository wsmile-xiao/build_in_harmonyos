--- autosetup/autosetup-config.guess.orig
+++ autosetup/autosetup-config.guess
@@ -0,0 +0,0 @@
+# HarmonyOS platform recognition
+# Add the following case in the main case block:
+
+    *:HarmonyOS:*:*)
+        GUESS=${UNAME_MACHINE}-unknown-linux-ohos
+        ;;
+
+# Note: For SQLite autosetup build system, the config.guess file
+# is located at autosetup/autosetup-config.guess
+# 
+# The simplest fix is to copy a HarmonyOS-adapted config.guess from
+# libtool or another source that has already been patched:
+# cp /path/to/libtool/config.guess autosetup/autosetup-config.guess
+# cp /path/to/libtool/config.sub autosetup/autosetup-config.sub
+
+# For this build, we used libtool's config.guess and config.sub from:
+# archives/l/libtool/2.4.7/packaging/pkg-libtool-2.4.7/share/libtool/build-aux/