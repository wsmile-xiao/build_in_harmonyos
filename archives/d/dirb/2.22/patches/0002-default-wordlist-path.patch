--- a/src/dirb.c
+++ b/src/dirb.c
@@ -7,6 +7,34 @@
 
 #include "dirb.h"
 
+
+/*
+ * OHOS adaptation: upstream hardcodes /usr/share/dirb/wordlists/common.txt,
+ * which does not exist on HarmonyOS. The wordlists are installed next to the
+ * binary as <prefix>/share/dirb/wordlists/, so resolve the default wordlist
+ * relative to the executable location (/proc/self/exe), falling back to a
+ * path relative to the current directory.
+ */
+
+static void default_wordlist(char *dest, size_t size) {
+  ssize_t len;
+  char exe[STRING_SIZE];
+  char *bindir;
+
+  len=readlink("/proc/self/exe", exe, sizeof(exe)-1);
+  if(len>0) {
+    exe[len]='\0';
+    bindir=strrchr(exe, '/');
+    if(bindir) {
+      *bindir='\0';
+      snprintf(dest, size, "%s/../share/dirb/wordlists/common.txt", exe);
+      return;
+    }
+  }
+
+  strncpy(dest, "share/dirb/wordlists/common.txt", size-1);
+  dest[size-1]='\0';
+}
 
