+// OHOS adaptation: do not send compare: through the raw ObjC runtime
+// (objc_msgSend); on OpenHarmony/libobjc2 calling a Nu-provided method IMP
+// (libffi closure / variadic block) this way crashes.  Route through Nu's own
+// dispatch (nu_calling_objc_method_handler), which evaluates Nu methods
+// directly from the block table and falls back to the runtime otherwise.
+static NSComparisonResult nu_compare(id a, id b)
+{
+    Class cls = object_getClass(a);
+    Method m = class_getInstanceMethod(cls, @selector(compare:));
+    if (!m) m = class_getClassMethod(cls, @selector(compare:));
+    if (m) {
+        NSMutableArray *args = [NSMutableArray arrayWithObject:b];
+        id result = nu_calling_objc_method_handler(a, m, args);
+        return (NSComparisonResult)[result intValue];
+    }
+    return (NSComparisonResult)[a compare:b];
+}
 #if !TARGET_OS_IPHONE
 #include <readline/readline.h>
 #endif
