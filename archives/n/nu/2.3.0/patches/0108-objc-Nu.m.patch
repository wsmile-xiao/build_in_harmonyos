+// OHOS adaptation: [NSException raise:format:] bypasses the ObjC exception
+// runtime on OpenHarmony; nu_raise() uses @throw with an NSException built via
+// exceptionWithName:reason:userInfo:, which is fully supported (verified with a
+// standalone native test). This keeps NuUndefinedSymbol/NuParseError etc.
+// catchable by Nu's try/catch and define checks.
+void nu_raise(NSString *name, NSString *format, ...)
+{
+    va_list args;
+    va_start(args, format);
+    NSString *reason = [[NSString alloc] initWithFormat:format arguments:args];
+    va_end(args);
+    NSException *e = [NSException exceptionWithName:name reason:reason userInfo:nil];
+    [reason release];
+    @throw e;
+    // no return
+}
 #import "NuException.h"
