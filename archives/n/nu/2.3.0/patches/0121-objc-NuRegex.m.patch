+// Convert a UTF-8 byte offset (relative to the start of s) to a UTF-16
+// code unit offset, so that regexec's byte-based offsets can be mapped back
+// to NSString's UTF-16-based NSRange locations.
+static NSUInteger utf8ByteOffsetToUTF16(NSString *s, NSUInteger byteOffset)
+{
+    NSUInteger utf16 = 0;
+    NSUInteger bytes = 0;
+    NSUInteger len = [s length];
+    NSUInteger i = 0;
+    while (i < len && bytes < byteOffset) {
+        unichar c = [s characterAtIndex:i];
+        NSUInteger adv;
+        NSUInteger units = 1;
+        if (c >= 0xD800 && c <= 0xDBFF && i + 1 < len) {
+            // surrogate pair -> 4 UTF-8 bytes, 2 UTF-16 units
+            adv = 4;
+            units = 2;
+            i += 2;
+        } else if (c >= 0x0800) {
+            adv = 3;
+            i += 1;
+        } else if (c >= 0x0080) {
+            adv = 2;
+            i += 1;
+        } else {
+            adv = 1;
+            i += 1;
+        }
+        if (bytes + adv > byteOffset) break;   // offset not on char boundary: stop
+        bytes += adv;
+        utf16 += units;
+    }
+    return utf16;
+}
