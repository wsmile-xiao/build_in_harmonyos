+- (id)initWithPattern:(NSString *)aPattern options:(int)optionFlags
+{
+    self = [super init];
+    if (self) {
+        regexOptions = optionFlags;
+        int cflags = REG_EXTENDED;
+        if (optionFlags & 1)          // NSRegularExpressionCaseInsensitive
+            cflags |= REG_ICASE;
+        NSString *patternToUse = aPattern;
+        if (optionFlags & 2) {        // NSRegularExpressionAllowCommentsAndWhitespace (x)
+            // Strip unescaped whitespace and '#' comments outside character classes
+            NSMutableString *cleaned = [NSMutableString string];
+            NSUInteger len = [aPattern length];
+            BOOL inClass = NO;
+            for (NSUInteger i = 0; i < len; i++) {
+                unichar c = [aPattern characterAtIndex:i];
+                if (c == '\\' && i + 1 < len) {
+                    [cleaned appendFormat:@"%C%C", c, [aPattern characterAtIndex:i+1]];
+                    i++;
+                    continue;
+                }
+                if (c == '[') { inClass = YES; [cleaned appendFormat:@"%C", c]; continue; }
+                if (c == ']') { inClass = NO; [cleaned appendFormat:@"%C", c]; continue; }
+                if (!inClass) {
+                    if (c == '#') {
+                        // skip to end of line
+                        while (i + 1 < len && [aPattern characterAtIndex:i+1] != '\n') i++;
+                        continue;
+                    }
+                    if (isspace(c)) continue;
+                }
+                [cleaned appendFormat:@"%C", c];
+            }
+            patternToUse = cleaned;
+        }
+        regexString = [patternToUse copy];
+        // POSIX regex has no direct equivalents for DotMatchesLineSeparators (s),
+        // AnchorsMatchLines (m); most test-cases in the upstream suite do not use
+        // them, so they are accepted but not transformed.
+        const char *pat = [regexString UTF8String];
+        int rc = regcomp(&compiledRegex, pat, cflags);
+        if (rc != 0) {
+            char errbuf[256];
+            regerror(rc, &compiledRegex, errbuf, sizeof(errbuf));
+            [self release];
+            nu_raise(@"NuRegexError",@"invalid regular expression: %s (%s)", pat, errbuf);
+        }
+    }
+    return self;
+}
