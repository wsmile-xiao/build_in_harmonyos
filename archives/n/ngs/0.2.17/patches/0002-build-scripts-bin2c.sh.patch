--- a/build-scripts/bin2c.sh
+++ b/build-scripts/bin2c.sh
@@ -16,17 +16,17 @@
 	echo "Failed to assert GNU sed: 'sed --version' output had no 'GNU sed'" >&2
 	exit 2
 fi
 
 file_name=$2
 var_name=$(tr /. __ <<eof
 $file_name
 eof
 )
 len=$(wc -c < "$file_name")
-data=$(od -A n -t u1 -v "$file_name" | $SED 's/ \+/,/g;1s/,//')
-printf '// Generated by %s from input file %s
-unsigned char %s[] = {
-%s
-};
-unsigned int %s_len = %s;
-' "$0" "$file_name" "$var_name" "$data" "$var_name" "$len"
+# Emit the byte array by streaming sed straight into stdout instead of
+# expanding it as a printf argument: "$data" is ~1MB for lib/stdlib.ngs and
+# exceeds ARG_MAX (131072 on HarmonyOS), which makes an external /usr/bin/printf
+# fail with "Argument list too long". Output is byte-for-byte identical.
+printf '// Generated by %s from input file %s\nunsigned char %s[] = {\n' "$0" "$file_name" "$var_name"
+od -A n -t u1 -v "$file_name" | $SED 's/ \+/,/g;1s/,//'
+printf '};\nunsigned int %s_len = %s;\n' "$var_name" "$len"
