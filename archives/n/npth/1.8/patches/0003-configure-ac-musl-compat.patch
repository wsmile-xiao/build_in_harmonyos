--- /storage/Users/currentUser/tmp/builds/npth-1.8.orig/configure.ac	2024-11-12 18:52:54.000000000 +0800
+++ configure.ac	2026-04-20 15:09:17.968737344 +0800
@@ -362,18 +362,41 @@
 #
 #   We test for pthread_cancel because in glibc 2.34, libc includes
 #   pthread_create and pthread_detach, but not pthread_cancel.
+#   However, on musl/HarmonyOS, pthread_cancel is not available.
+#   So we test for pthread_create instead on HarmonyOS.
 if test "$have_w32_system" = no; then
-  AC_SEARCH_LIBS([pthread_cancel],[pthread])
-  case "x$ac_cv_search_pthread_cancel" in
-    xno)
-      have_pthread=no
-      ;;
-    xnone\ required)
-      have_pthread=yes
+  case "${host}" in
+    *-*-linux-ohos*)
+      # HarmonyOS/musl: pthread_cancel not available, test for pthread_create
+      AC_SEARCH_LIBS([pthread_create],[pthread])
+      case "x$ac_cv_search_pthread_create" in
+        xno)
+          have_pthread=no
+          ;;
+        xnone\ required)
+          have_pthread=yes
+          ;;
+        *)
+          have_pthread=yes
+          config_libs="$config_libs $ac_cv_search_pthread_create"
+          ;;
+      esac
       ;;
     *)
-      have_pthread=yes
-      config_libs="$config_libs $ac_cv_search_pthread_cancel"
+      # Other systems: test for pthread_cancel as usual
+      AC_SEARCH_LIBS([pthread_cancel],[pthread])
+      case "x$ac_cv_search_pthread_cancel" in
+        xno)
+          have_pthread=no
+          ;;
+        xnone\ required)
+          have_pthread=yes
+          ;;
+        *)
+          have_pthread=yes
+          config_libs="$config_libs $ac_cv_search_pthread_cancel"
+          ;;
+      esac
       ;;
   esac
   if test "$have_pthread" != no; then
