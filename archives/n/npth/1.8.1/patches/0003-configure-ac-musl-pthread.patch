--- a/configure.ac
+++ b/configure.ac
@@ -362,8 +362,22 @@
 #
 #   We test for pthread_cancel because in glibc 2.34, libc includes
 #   pthread_create and pthread_detach, but not pthread_cancel.
+#
+#   HarmonyOS uses musl libc, which does not implement pthread_cancel, so
+#   probing it would wrongly conclude that pthreads are unavailable and
+#   abort the configure run.  Probe pthread_create there instead and feed
+#   the result into ac_cv_search_pthread_cancel so that the remaining
+#   checks are shared with the other platforms.
 if test "$have_w32_system" = no; then
-  AC_SEARCH_LIBS([pthread_cancel],[pthread])
+  case "${host}" in
+    *-*-linux-ohos*)
+        AC_SEARCH_LIBS([pthread_create],[pthread])
+        ac_cv_search_pthread_cancel="$ac_cv_search_pthread_create"
+        ;;
+    *)
+        AC_SEARCH_LIBS([pthread_cancel],[pthread])
+        ;;
+  esac
   case "x$ac_cv_search_pthread_cancel" in
     xno)
       have_pthread=no
