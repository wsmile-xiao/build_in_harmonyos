 #!/usr/bin/env bash
 test_description='"notmuch insert"'
+
+# OHOS toybox stat 的 -c %a（八进制权限）输出异常（如 2771 非权限位）——
+# 用 -c %A（符号权限 drwxr-xr-x）解析转八进制，兼容 GNU/toybox
+stat_octal() {
+    local sym out=""
+    sym=$(stat -c %A "$1" 2>/dev/null)
+    [ -z "$sym" ] && { echo 0000; return; }
+    # 每三位（owner/group/other）转八进制
+    local segs="$(echo "$sym" | sed 's/^d//;s/^l//;s/^b//;s/^c//;s/^p//;s/^s//')"
+    local i seg
+    for i in 0 1 2; do
+        seg=$(echo "$segs" | cut -c$((i*3+1))-$((i*3+3)))
+        case "$seg" in
+            rwx) out="${out}7";; rw-) out="${out}6";; r-x) out="${out}5";; r--) out="${out}4";;
+            -wx) out="${out}3";; -w-) out="${out}2";; --x) out="${out}1";; ---) out="${out}0";;
+            *) out="${out}0";;
+        esac
+    done
+    echo "$out"
+}
+
 . $(dirname "$0")/test-lib.sh || exit 1
 
 # subtests about file permissions assume that we're working with umask
