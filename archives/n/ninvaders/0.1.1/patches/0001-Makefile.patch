diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,16 +1,23 @@
-CC=gcc
-CFLAGS=-O3 -Wall
+CC?=clang
+PREFIX?=/storage/Users/currentUser/usr/local
+CFLAGS?=-fPIC -O2 -Wall -fcommon -I$(PREFIX)/include
+LDFLAGS?=-L$(PREFIX)/lib -fuse-ld=bfd
 LIBS=-lncurses
 
 CFILES=globals.c view.c aliens.c ufo.c player.c nInvaders.c
 HFILES=globals.h view.h aliens.h ufo.h player.h nInvaders.h
 OFILES=globals.o view.o aliens.o ufo.o player.o nInvaders.o
 all:		nInvaders
 
 nInvaders: 	$(OFILES) $(HFILES)
 		$(CC) $(LDFLAGS) -o$@ $(OFILES) $(LIBS)
 
 .c.o:
-		$(CC) -c  -I. $(CFLAGS) $(OPTIONS) $<
+		$(CC) -c  -I. -I$(PREFIX)/include $(CFLAGS) $(OPTIONS) $<
+
+install:	nInvaders
+		mkdir -p $(DESTDIR)$(PREFIX)/bin
+		cp nInvaders $(DESTDIR)$(PREFIX)/bin/
+
 clean:
-		rm -f nInvaders $(OFILES)
+		rm -f nInvaders $(OFILES)