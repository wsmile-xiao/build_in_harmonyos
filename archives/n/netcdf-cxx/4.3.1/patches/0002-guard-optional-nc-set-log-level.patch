+################################
+# Feature detection for optional APIs
+################################
+
+# nc_set_log_level is an optional logging API that may be disabled
+# in some netCDF-C binary builds. Guard its use in the test suite
+# instead of disabling the test that exercises real filter logic.
+include(CheckFunctionExists)
+if(NETCDF_C_LIBRARY)
+  set(CMAKE_REQUIRED_LIBRARIES ${NETCDF_C_LIBRARY})
+  check_function_exists(nc_set_log_level HAVE_NC_SET_LOG_LEVEL)
+  unset(CMAKE_REQUIRED_LIBRARIES)
+endif()
+
