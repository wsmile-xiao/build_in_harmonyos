diff -ruN a/src/libnetdata/os/uuid_generate.c b/src/libnetdata/os/uuid_generate.c
--- a/src/libnetdata/os/uuid_generate.c
+++ b/src/libnetdata/os/uuid_generate.c
@@ -26,6 +26,28 @@
 
 #else
 
+#if !defined(OS_MACOS) && !defined(HAVE_LIBUUID)
+/* No libuuid on this system (feature-detected by CMake): generate
+ * RFC 4122 version 4 UUIDs with arc4random_buf, whose availability
+ * was verified at configure time. */
+#include <stdlib.h>
+void os_uuid_generate(void *out) {
+    arc4random_buf(out, 16);
+    uint8_t *u = (uint8_t *)out;
+    u[6] = (u[6] & 0x0f) | 0x40;
+    u[8] = (u[8] & 0x3f) | 0x80;
+}
+
+void os_uuid_generate_random(void *out) {
+    os_uuid_generate(out);
+}
+
+void os_uuid_generate_time(void *out) {
+    os_uuid_generate(out);
+}
+
+#else
+
 #if !defined(OS_MACOS)
 #include <uuid.h>
 #endif
@@ -43,3 +65,5 @@
 }
 
 #endif
+
+#endif
