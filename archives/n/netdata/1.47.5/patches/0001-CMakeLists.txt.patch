+        endif()
 elseif("${CMAKE_SYSTEM_NAME}" STREQUAL "CYGWIN" OR "${CMAKE_SYSTEM_NAME}" STREQUAL "MSYS" OR "${CMAKE_SYSTEM_NAME}" STREQUAL "Windows")
         set(OS_WINDOWS True)
 
@@ -135,8 +141,13 @@
         endif()
 
         message(STATUS " Compiling for Windows (${CMAKE_SYSTEM_NAME}, MSYSTEM=$ENV{MSYSTEM})... ")
+elseif("${CMAKE_SYSTEM_NAME}" MATCHES "OHOS|OpenHarmony|HarmonyOS")
+        set(OS_OHOS True)
+        set(OS_LINUX True)
+        add_definitions(-D_GNU_SOURCE)
+        message(STATUS " Compiling for OpenHarmony/HarmonyOS (treated as Linux-compatible)... ")
 else()
