@@ -443,10 +454,36 @@
 }
 " HAVE_SETNS)
 
+# pthread CPU affinity and thread-cancellation APIs may be missing on
+# musl-based systems (e.g. OpenHarmony); detect instead of assuming.
+check_c_source_compiles("
+#define _GNU_SOURCE
+#include <pthread.h>
+#include <sched.h>
+int main() {
+        cpu_set_t set;
+        cpu_set_t probe;
+        CPU_ZERO(&set);
+        CPU_SET(0, &set);
+        if(pthread_setaffinity_np(pthread_self(), sizeof(set), &set))
+                return 1;
+        return pthread_getaffinity_np(pthread_self(), sizeof(probe), &probe);
+}
+" HAVE_PTHREAD_SETAFFINITY_NP)
+
+check_c_source_compiles("
+#include <pthread.h>
+int main() {
+        int old;
+        return pthread_setcanceltype(0, &old) || pthread_setcancelstate(0, &old);
+}
+" HAVE_PTHREAD_SETCANCEL)
+
 check_cxx_source_compiles("
+#include <cstdint>
 int main() {
-        __atomic_load_8(nullptr, 0);
-        return 0;
+        uint64_t a = 0;
+        return static_cast<int>(__atomic_load_n(&a, 0));
 }
 " HAVE_BUILTIN_ATOMICS)
 
@@ -1661,10 +1698,27 @@
         # UUID functionality is part of the system libraries here, so no extra
         # stuff needed.
 else()
-        pkg_check_modules(UUID REQUIRED uuid)
