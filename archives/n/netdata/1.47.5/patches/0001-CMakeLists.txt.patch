diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -105,7 +105,13 @@
 elseif("${CMAKE_SYSTEM_NAME}" STREQUAL "Linux")
         set(OS_LINUX True)
         add_definitions(-D_GNU_SOURCE)
-        message(STATUS " Compiling for Linux... ")
+        # OpenHarmony may report as Linux to cmake; the OS_OHOS cache option
+        # (set by the Conan toolchain or -DOS_OHOS=ON) marks it explicitly.
+        if(OS_OHOS)
+                message(STATUS " Compiling for OpenHarmony (Linux-compatible)... ")
