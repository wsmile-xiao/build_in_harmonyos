-        target_compile_options(libnetdata PUBLIC ${UUID_CFLAGS_OTHER})
-        target_link_libraries(libnetdata PUBLIC ${UUID_LDFLAGS})
+        pkg_check_modules(UUID QUIET uuid)
+        if(NOT UUID_FOUND)
+                # No libuuid (e.g. musl-based systems like OpenHarmony):
+                # fall back to arc4random_buf, availability checked here.
+                check_c_source_compiles("
+#include <stdlib.h>
+int main() {
+        unsigned char buf[16];
+        arc4random_buf(buf, sizeof(buf));
+        return 0;
+}
+" HAVE_ARC4RANDOM_BUF)
+                if(NOT HAVE_ARC4RANDOM_BUF)
+                        message(FATAL_ERROR "Neither libuuid nor arc4random_buf is available for UUID generation")
+                endif()
+        else()
+                set(HAVE_LIBUUID True)
