--- a/src/lib/emptydefn
+++ b/src/lib/emptydefn
@@ -1,9 +1,9 @@
 #!/bin/sh
 #
 # notangle filter that makes the definition of an empty chunk <<>>= 
 # stand for a continuation of the previous chunk definition.
 
-nawk 'BEGIN { lastdefn = "@defn " }
+awk 'BEGIN { lastdefn = "@defn " }
 /^@defn $/ { print lastdefn; next }
 /^@defn /  { lastdefn = $0 }
 { print }' "$@"
