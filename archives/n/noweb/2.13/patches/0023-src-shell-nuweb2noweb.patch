--- a/src/shell/nuweb2noweb
+++ b/src/shell/nuweb2noweb
@@ -1,7 +1,15 @@
 #!/bin/sh
 
 # convert nuweb to noweb
 
 LIB=|LIBDIR|
 
+# standard --version/--help (packaging convenience)
+for _nwopt in "$@"; do
+  case $_nwopt in
+    --version) echo "noweb 2.13 (nuweb2noweb)" ; exit 0 ;;
+    --help)    echo "Usage: $0 file.nw" ; exit 0 ;;
+  esac
+done
+
 $LIB/numarkup "$@" | $LIB/unmarkup
