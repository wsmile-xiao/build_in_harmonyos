--- a/src/shell/cpif
+++ b/src/shell/cpif
@@ -1,19 +1,27 @@
 #!/bin/sh
 
 # cpif [ -eq -ne ] file...
 # copy standard input to each of the named files
 # if new * old is true or old doesn't exist;
 # * defaults to -ne
 
 PATH=/bin:/usr/bin
 LIB=|LIBDIR|
+
+# standard --version/--help (packaging convenience)
+for _nwopt in "$@"; do
+  case $_nwopt in
+    --version) echo "noweb 2.13 (cpif)" ; exit 0 ;;
+    --help)    echo "Usage: $0 [-eq|-ne] file..." ; exit 0 ;;
+  esac
+done
 
 # set -x
 op=-ne
 case "$1" in
 -eq|-ne)	op=$1; shift ;;
 -*)		echo 'Usage: '`basename $0`' [ -eq -ne ] file...' 1>&2; exit 2
 esac
 case $# in
 0)		echo 'Usage: '`basename $0`' [ -eq -ne ] file...' 1>&2; exit 2
 esac
