--- a/src/shell/htmltoc
+++ b/src/shell/htmltoc
@@ -1,12 +1,16 @@
 eval 'exec perl -S $0 ${1+"$@"}'
     if 0;
+
+# standard --version/--help (packaging convenience)
+if (grep(/^--version$/, @ARGV)) { print "noweb 2.13 (htmltoc)\n"; exit 0; }
+if (grep(/^--help$/, @ARGV))    { print "Usage: $0 < file.html\n"; exit 0; }
 
 $sentinel     = "<tableofcontents>";
 $sentinel_end = "</tableofcontents>";
 
 while (<>) {
     push(@file, $_) unless (/^$sentinel/ .. /^$sentinel_end/);
     push(@file, $_) if (/^$sentinel/ || /^$sentinel_end/);
 }
 
 $intro = -1;
