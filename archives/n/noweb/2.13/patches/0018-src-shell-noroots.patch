--- a/src/shell/noroots
+++ b/src/shell/noroots
@@ -1,15 +1,22 @@
 #!/bin/sh
 #
 # Copyright 1991 by Norman Ramsey.  All rights reserved.
 # See file COPYRIGHT for more information.
 # set -x
 LIB=|LIBDIR|
-$LIB/markup "$@" | nawk '
+# standard --version/--help (packaging convenience)
+for _nwopt in "$@"; do
+  case $_nwopt in
+    --version) echo "noweb 2.13 (noroots)" ; exit 0 ;;
+    --help)    echo "Usage: $0 file.nw" ; exit 0 ;;
+  esac
+done
+$LIB/markup "$@" | awk '
 /^@quote$/,/^@endquote$/ { next }
 /^@defn / { chunk=substr($0,7) ; defined[chunk]=1 }
 /^@use /  { chunk=substr($0,6) ; used[chunk]=1 }
 END {
   for (chunk in defined) {
     if (defined[chunk]==1 && used[chunk]==0) printf "<<%s>>\n", chunk
   }
 }'
