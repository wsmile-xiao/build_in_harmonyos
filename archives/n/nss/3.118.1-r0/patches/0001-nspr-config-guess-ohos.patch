--- a/nspr/build/autoconf/config.guess
+++ b/nspr/build/autoconf/config.guess
@@ -0,0 +1,10 @@
+#!/bin/bash
+# OpenHarmony quick fix for config.guess
+ 
+# Detect OpenHarmony by checking for __OHOS__ macro
+cat > /tmp/test_ohos.c << 'EOF'
+#ifdef __OHOS__
+int main() { return 0; }
+#endif
+EOF
+ 
+if $CC -c /tmp/test_ohos.c -o /tmp/test_ohos.o 2>/dev/null; then
+    echo "aarch64-unknown-linux-ohos"
+else
+    # Fall back to original config.guess logic
+    UNAME_MACHINE=$(uname -m)
+    echo "${UNAME_MACHINE}-unknown-linux-gnu"
+fi
+ 
+rm -f /tmp/test_ohos.c /tmp/test_ohos.o
+exit 0
--- a/nspr/build/autoconf/config.sub  
+++ b/nspr/build/autoconf/config.sub
@@ -0,0 +1,5 @@
+# Quick fix for OpenHarmony in config.sub
+# Add this near the beginning of the case statement for OS matching
+ 
+case $1 in
+    *-linux-ohos*)
+        echo "$1"
+        exit 0
+        ;;
+esac
