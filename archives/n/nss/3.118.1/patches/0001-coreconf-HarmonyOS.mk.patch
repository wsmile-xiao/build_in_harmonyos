--- /dev/null
+++ b/nss/coreconf/HarmonyOS.mk
@@ -0,0 +1,133 @@
+#
+# HarmonyOS configuration file for NSS
+# Based on Linux.mk, adapted for OpenHarmony/HarmonyOS
+#
+
+include $(CORE_DEPTH)/coreconf/UNIX.mk
+
+#
+# The default implementation strategy is pthreads
+#
+USE_PTHREADS = 1
+IMPL_STRATEGY = _PTH
+
+DEFAULT_COMPILER = clang
+DEFINES += -D_DEFAULT_SOURCE -D_BSD_SOURCE -D_POSIX_SOURCE -DSDB_MEASURE_USE_TEMP_DIR -D__OHOS__
+
+#
+# CPU architecture detection
+#
+ifeq ($(OS_TEST),aarch64)
+	CPU_ARCH = aarch64
+	ARCHFLAG = 
+else
+ifeq ($(OS_TEST),arm)
+	CPU_ARCH = arm
+else
+ifeq ($(OS_TEST),x86_64)
+	CPU_ARCH = x86_64
+else
+	CPU_ARCH = $(OS_TEST)
+endif
+endif
+endif
+
+#
+# Compiler settings
+#
+CC ?= clang
+CCC ?= clang++
+RANLIB ?= llvm-ranlib
+LD ?= ld.lld
+AR ?= llvm-ar
+STRIP ?= llvm-strip
+
+ifndef COMPILER_TAG
+COMPILER_TAG = _clang
+endif
+
+#
+# Optimization flags
+#
+ifdef BUILD_OPT
+ifeq (11,$(ALLOW_OPT_CODE_SIZE)$(OPT_CODE_SIZE))
+	OPTIMIZER = -Os
+else
+	OPTIMIZER = -O2
+endif
+ifdef MOZ_DEBUG_SYMBOLS
+	ifdef MOZ_DEBUG_FLAGS
+		OPTIMIZER += $(MOZ_DEBUG_FLAGS)
+	else
+		OPTIMIZER += -gdwarf-2
+	endif
+endif
+endif
+
+#
+# Pthread support
+#
+ifeq ($(USE_PTHREADS),1)
+OS_PTHREAD = -lpthread
+DEFINES += -D_REENTRANT
+endif
+
+#
+# OS flags
+#
+OS_CFLAGS = $(DSO_CFLAGS) $(OS_REL_CFLAGS) $(ARCHFLAG) -pipe -ffunction-sections -fdata-sections -DHAVE_STRERROR -DHARMONYOS
+OS_LIBS = $(OS_PTHREAD) -ldl -lc
+
+#
+# DSO (Dynamic Shared Object) settings
+#
+DSO_CFLAGS = -fPIC
+DSO_LDOPTS = -shared $(ARCHFLAG) -Wl,--gc-sections
+ZDEFS_FLAG = -Wl,-z,defs
+DSO_LDOPTS += $(ZDEFS_FLAG)
+LDFLAGS += $(ARCHFLAG) -z noexecstack
+
+#
+# CPU tag
+#
+CPU_TAG = _$(CPU_ARCH)
+
+#
+# Freebl settings
+#
+FREEBL_NO_DEPEND = 1
+# FREEBL_LOWHASH = 1  # removed: stub build drops NSSLOWHASH symbols, breaks lowhashtest
+
+#
+# System zlib (pre-installed)
+#
+USE_SYSTEM_ZLIB = 1
+ZLIB_LIBS = -lz
+
+#
+# NSPR settings
+#
+ifeq ($(USE_64),1)
+	USE_64 = 1
+endif
+
+#
+# Library creation
+#
+MKSHLIB = $(CC) $(DSO_LDOPTS) -Wl,-soname -Wl,$(@:$(OBJDIR)/%.so=%.so) $(RPATH)
+
+ifdef MAPFILE
+	MKSHLIB += -Wl,--version-script,$(MAPFILE)
+endif
+PROCESS_MAP_FILE = grep -v ';-' $< | \
+        sed -e 's,;+,,' -e 's; DATA ;;' -e 's,;;,,' -e 's,;.*,;,' > $@
+
+#
+# Additional defines for HarmonyOS
+#
+DEFINES += -DNO_NSPR_10_SUPPORT -DUSE_UTIL_DIRECTLY
+
+#
+# Disable tests that may not work
+#
+NSS_DISABLE_GTESTS = 1