--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 3.0.0)
+cmake_minimum_required(VERSION 3.10)
 project(nanodbc CXX)
 
 # NOTE: All options follow CMake convention:
@@ -109,7 +109,20 @@
 ########################################
 ## find unixODBC or iODBC config binary
 ########################################
-if(UNIX)
+if(ODBC_INCLUDE_DIR AND ODBC_LIBRARY)
+  # Cross-compilation (e.g. HarmonyOS/OHOS): the ODBC driver manager is
+  # provided by the Conan package unixodbc; the host-only probes below
+  # (odbc_config program / find_path / iodbc-config) cannot succeed in a
+  # cross build environment, so honour the explicitly provided paths.
+  # Note: CMAKE_SYSTEM_NAME=HarmonyOS does not define the UNIX variable,
+  # hence every UNIX-guarded block below also needs the extended condition.
+  message(STATUS "nanodbc build: ODBC on Unix - unixODBC (conan-provided)")
+  set(ODBCLIB "${ODBC_LIBRARY}")
+  set(ODBC_CONFIG 1)
+  set(ODBC_CFLAGS "-I${ODBC_INCLUDE_DIR}")
+  get_filename_component(ODBC_LIB_DIR "${ODBC_LIBRARY}" DIRECTORY)
+  set(ODBC_LINK_FLAGS "-L${ODBC_LIB_DIR} -lodbc")
+elseif(UNIX)
   # Try to find unixODBC first via odbc_config program.
   find_program(ODBC_CONFIG odbc_config
     PATHS $ENV{ODBC_PATH}/bin /usr/bin /usr/local/bin)
@@ -170,7 +183,7 @@
 ########################################
 ## find ODBC libraries to link
 ########################################
-if(UNIX)
+if(UNIX OR (ODBC_INCLUDE_DIR AND ODBC_LIBRARY))
   set(ODBC_LIBRARIES ${ODBCLIB})
   set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} ${ODBC_LINK_FLAGS}")
 elseif(MSVC OR CMAKE_CXX_COMPILER_ID MATCHES "Intel")
@@ -227,7 +240,7 @@
   $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
   $<INSTALL_INTERFACE:include/nanodbc>) # <prefix>/include/nanodbc
 
-if(UNIX)
+if(UNIX OR (ODBC_INCLUDE_DIR AND ODBC_LIBRARY))
   set_target_properties(nanodbc PROPERTIES
     COMPILE_FLAGS "${ODBC_CFLAGS}"
     LIBRARY_OUTPUT_DIRECTORY "lib")
