--- a/src/logger.cc
+++ b/src/logger.cc
@@ -84,12 +84,15 @@
 {
     char buf[2048];
 
-#if (_POSIX_C_SOURCE >= 200112L || _XOPEN_SOURCE >= 600) && ! _GNU_SOURCE
-    if (strerror_r(errno, buf, sizeof(buf))
+// strerror_r returns char* only on glibc with _GNU_SOURCE; musl
+// (including OHOS) always returns int per POSIX regardless of
+// _GNU_SOURCE, so branch on __GLIBC__ instead of feature macros.
+#ifdef __GLIBC__
+    return strerror_r(errno, buf, sizeof(buf));
+#else
+    if (strerror_r(errno, buf, sizeof(buf)) != 0)
         return "Unknown error";
     return buf;
-#else
-    return strerror_r(errno, buf, sizeof(buf));
 #endif
 }
 
