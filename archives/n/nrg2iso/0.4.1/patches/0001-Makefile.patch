diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,6 +1,20 @@
-all: nrg2iso.c
-	gcc nrg2iso.c -o nrg2iso
+CC      ?= clang
+CFLAGS  ?= -fPIC -O2
+PREFIX  ?= /usr/local
+DESTDIR ?=
 
-clean: 
+all: nrg2iso
+
+nrg2iso: nrg2iso.c
+	$(CC) $(CFLAGS) nrg2iso.c -o nrg2iso
+
+install: nrg2iso
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	cp nrg2iso $(DESTDIR)$(PREFIX)/bin/
+
+uninstall:
+	rm -f $(DESTDIR)$(PREFIX)/bin/nrg2iso
+
+clean:
 	rm -f nrg2iso
 	rm -f *~
