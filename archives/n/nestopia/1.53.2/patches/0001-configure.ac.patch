diff --git a/configure.ac b/configure.ac
index 1d7d0a0d280a160be07737ef2279272ee8785f8f..aee1ec8f34e0705b3d5cfd5f3c3c11becf73405d 100644
--- a/configure.ac
+++ b/configure.ac
@@ -66,30 +66,45 @@ AS_IF([test "x${enable_flags_setting}" = "xyes" && test "x${enable_debug}" = "xn
 dnl ======================
 dnl Check for dependencies
 dnl ======================
+dnl Every dependency MUST be supplied via *_CFLAGS/*_LIBS (the HarmonyOS PC
+dnl build passes absolute package paths from Conan). Probing with
+dnl pkg-config/fltk-config is intentionally disabled so that a cross or
+dnl hybrid environment can never leak host-native flags into the build.
 dnl zlib
-PKG_CHECK_MODULES([ZLIB], [zlib])
+AC_ARG_VAR([ZLIB_CFLAGS], [zlib C compiler flags (required)])
+AC_ARG_VAR([ZLIB_LIBS], [zlib linker flags (required)])
+AS_IF([AS_VAR_TEST_SET([ZLIB_CFLAGS]) && AS_VAR_TEST_SET([ZLIB_LIBS])], [],
+	[AC_MSG_ERROR([ZLIB_CFLAGS and ZLIB_LIBS must be set (pkg-config probing disabled for cross builds)])])
 
 dnl libarchive
-PKG_CHECK_MODULES([LIBARCHIVE], [libarchive])
+AC_ARG_VAR([LIBARCHIVE_CFLAGS], [libarchive C compiler flags (required)])
+AC_ARG_VAR([LIBARCHIVE_LIBS], [libarchive linker flags (required)])
+AS_IF([AS_VAR_TEST_SET([LIBARCHIVE_CFLAGS]) && AS_VAR_TEST_SET([LIBARCHIVE_LIBS])], [],
+	[AC_MSG_ERROR([LIBARCHIVE_CFLAGS and LIBARCHIVE_LIBS must be set (pkg-config probing disabled for cross builds)])])
 
 dnl SAMPLERATE
-PKG_CHECK_MODULES([SAMPLERATE], [samplerate])
+AC_ARG_VAR([SAMPLERATE_CFLAGS], [libsamplerate C compiler flags (required)])
+AC_ARG_VAR([SAMPLERATE_LIBS], [libsamplerate linker flags (required)])
+AS_IF([AS_VAR_TEST_SET([SAMPLERATE_CFLAGS]) && AS_VAR_TEST_SET([SAMPLERATE_LIBS])], [],
+	[AC_MSG_ERROR([SAMPLERATE_CFLAGS and SAMPLERATE_LIBS must be set (pkg-config probing disabled for cross builds)])])
 
 dnl SDL2
-PKG_CHECK_MODULES([SDL2], [sdl2 >= 2.0.12])
+AC_ARG_VAR([SDL2_CFLAGS], [SDL2 C compiler flags (required)])
+AC_ARG_VAR([SDL2_LIBS], [SDL2 linker flags (required)])
+AS_IF([AS_VAR_TEST_SET([SDL2_CFLAGS]) && AS_VAR_TEST_SET([SDL2_LIBS])], [],
+	[AC_MSG_ERROR([SDL2_CFLAGS and SDL2_LIBS must be set (pkg-config probing disabled for cross builds)])])
 
 dnl LibEpoxy
-PKG_CHECK_MODULES([LIBEPOXY], [epoxy])
-
-AC_CHECK_PROG(FLTKCONFIG,fltk-config,[fltk-config],[no])
-test "$FLTKCONFIG" == "no" && AC_MSG_ERROR([Cannot find the fltk-config executable. Is FLTK installed?])
-
-AC_SUBST(FLTK_CFLAGS,"$(fltk-config --use-gl --use-images --cxxflags)")
-AS_CASE([${host_os}],
-	[darwin*],
-	[AC_SUBST(FLTK_LIBS,"$(fltk-config --use-gl --use-images --ldflags)")],
-	[AC_SUBST(FLTK_LIBS,"-lGL $(fltk-config --use-gl --use-images --ldflags)")]
-)
+AC_ARG_VAR([LIBEPOXY_CFLAGS], [libepoxy C compiler flags (required)])
+AC_ARG_VAR([LIBEPOXY_LIBS], [libepoxy linker flags (required)])
+AS_IF([AS_VAR_TEST_SET([LIBEPOXY_CFLAGS]) && AS_VAR_TEST_SET([LIBEPOXY_LIBS])], [],
+	[AC_MSG_ERROR([LIBEPOXY_CFLAGS and LIBEPOXY_LIBS must be set (pkg-config probing disabled for cross builds)])])
+
+dnl FLTK
+AC_ARG_VAR([FLTK_CFLAGS], [FLTK C++ compiler flags (required)])
+AC_ARG_VAR([FLTK_LIBS], [FLTK linker flags (required)])
+AS_IF([AS_VAR_TEST_SET([FLTK_CFLAGS]) && AS_VAR_TEST_SET([FLTK_LIBS])], [],
+	[AC_MSG_ERROR([FLTK_CFLAGS and FLTK_LIBS must be set (fltk-config probing disabled for cross builds)])])
 
 dnl full HTML suite
 AC_ARG_ENABLE([doc],
