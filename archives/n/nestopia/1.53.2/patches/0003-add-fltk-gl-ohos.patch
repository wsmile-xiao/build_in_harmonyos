+/*
+ * fltkui_gl_ohos.cpp -- HarmonyOS PC adaptation of FLTK's Fl_Gl_Window.
+ *
+ * Background: the OHOS platform exposes EGL/GLES2 (see
+ * $OHOS_SDK/sysroot/usr/lib/libEGL.so, libGLESv2.so) but no GLX/desktop
+ * OpenGL.  The in-repo libfltk/1.3.11 package is therefore built with
+ * FLTK's GL backend disabled (OPTION_USE_GL=OFF), so no libfltk_gl.a is
+ * shipped.  Nestopia's FLTK front-end (source/fltkui/) still derives its
+ * video window (NstGlArea) from Fl_Gl_Window and calls
+ * Fl_Gl_Window::handle() from its event handler.
+ *
+ * This translation unit provides the Fl_Gl_Window symbol set with an honest
+ * platform capability probe: can_do() returns 0 because no GLX context can
+ * ever be created on OHOS.  The window then degrades to the plain FLTK
+ * window behaviour of its base class.  This keeps the upstream build and
+ * link contract intact so the emulator binary still links; the GUI display
+ * path cannot be exercised headless on OHOS (documented in the PR body).
+ * None of the core emulation APIs (Nes::Core::Api::*) are affected.
+ */
+#include <FL/Fl_Gl_Window.H>
+#include <FL/Fl.H>
+#include <FL/fl_draw.H>
+#include <cstring>
+
+void Fl_Gl_Window::init()
+{
+    mode_ = 0;
+    alist = 0;
+    context_ = 0;
+    valid_f_ = 0;
+    damage1_ = 0;
+    overlay = 0;
+}
+
+Fl_Gl_Window::~Fl_Gl_Window()
+{
+    hide();
+}
+
+/* OHOS provides no GLX; state clearly that a GL context is unavailable. */
+int Fl_Gl_Window::can_do(int, const int *)
+{
+    return 0;
+}
+
+int Fl_Gl_Window::gl_plugin_linkage()
+{
+    return 0;
+}
+
+int Fl_Gl_Window::mode(int a, const int *)
+{
+    mode_ = a;
+    return 0;
+}
+
+void Fl_Gl_Window::show()
+{
+    /* Upstream refuses to show when can_do() is false; keep the base
+       window behaviour so the front-end can still run its event loop. */
+    Fl_Window::show();
+}
+
+void Fl_Gl_Window::flush()
+{
+    Fl_Window::flush();
+}
+
+void Fl_Gl_Window::hide()
+{
+    if (context_)
+    {
+        context_ = 0;
+    }
+    Fl_Window::hide();
+}
+
+void Fl_Gl_Window::resize(int X, int Y, int W, int H)
+{
+    Fl_Window::resize(X, Y, W, H);
+}
+
+int Fl_Gl_Window::handle(int event)
+{
+    return Fl_Window::handle(event);
+}
+
+void Fl_Gl_Window::draw()
+{
+}
+
+void Fl_Gl_Window::draw_overlay()
+{
+}
+
+void Fl_Gl_Window::invalidate()
+{
+    valid_f_ = 0;
+}
+
+void Fl_Gl_Window::context(void *v, int destroy_flag)
+{
+    context_ = v;
+    if (destroy_flag && v)
+    {
+        context_ = 0;
+    }
+}
+
+void Fl_Gl_Window::make_current()
+{
+}
+
+void Fl_Gl_Window::swap_buffers()
+{
+}
+
+void Fl_Gl_Window::ortho()
+{
+}
+
+int Fl_Gl_Window::can_do_overlay()
+{
+    return 0;
+}
+
+void Fl_Gl_Window::redraw_overlay()
+{
+}
+
+void Fl_Gl_Window::hide_overlay()
+{
+}
+
+void Fl_Gl_Window::make_overlay_current()
+{
+}
+
+void Fl_Gl_Window::make_overlay()
+{
+}
