@@ -42,6 +42,17 @@
 # have a pre-POSIX /bin/sh.
 
 
+# OpenHarmony/HarmonyOS platform detection (added for cross-compilation support)
+# Return the appropriate system triplet for HarmonyOS/OpenHarmony systems
+if test -f /system/bin/toybox || test "$(uname -s)" = "HarmonyOS"; then
+    case "$(uname -m)" in
+        aarch64) echo "aarch64-linux-gnu"; exit 0 ;;
+        arm*)    echo "arm-linux-gnu"; exit 0 ;;
+        x86_64)  echo "x86_64-linux-gnu"; exit 0 ;;
+        i386|i486|i586|i686) echo "i686-linux-gnu"; exit 0 ;;
+    esac
+fi
+
 me=`echo "$0" | sed -e 's,.*/,,'`
 
 usage="\
