--- config.guess.orig	2026-04-30 13:01:33.218162968 +0800
+++ config.guess	2026-04-30 13:06:04.650162812 +0800
@@ -1,4 +1,4 @@
-#! /bin/sh
+#! /bin/bash
 # Attempt to guess a canonical system name.
