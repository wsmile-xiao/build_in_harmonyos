--- a/tests/run-check.sh
+++ b/tests/run-check.sh
@@ -9,7 +9,7 @@
 
 cd "$(dirname "$0")/.."
 
-make CFLAGS='-O3 -fPIC' libnewsraft.so
+make CFLAGS='-O3 -fPIC' AUXCFLAGS="$AUXCFLAGS" LDFLAGS="$LDFLAGS" libnewsraft.so
 
 test -e libnewsraft.so
 
@@ -19,8 +19,8 @@
 for test_file in tests/*.c; do
 	status=0
 	rm -rf newsraft-test-database*
-	make TEST_FILE="$test_file" test-program 1>>"$log_file" 2>&1 || status="$?"
-	[ "$status" = 0 ] && env LD_LIBRARY_PATH=. ./newsraft-test 2>&1 || status="$?"
+	make TEST_FILE="$test_file" AUXCFLAGS="$AUXCFLAGS" LDFLAGS="$LDFLAGS" test-program 1>>"$log_file" 2>&1 || status="$?"
+	[ "$status" = 0 ] && env LD_LIBRARY_PATH="$LD_LIBRARY_PATH:." ./newsraft-test 2>&1 || status="$?"
 	echo "TEST_STATUS:$status" >> "$log_file"
 	echo "[$([ "$status" = 0 ] && echo "${green}OKAY" || echo "${red}FAIL")${reset}] $test_file"
 done | tee -a "$log_file"
