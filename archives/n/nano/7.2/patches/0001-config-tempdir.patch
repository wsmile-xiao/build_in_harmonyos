--- configure.orig	2023-04-17 00:00:00.000000000 +0000
+++ configure	2026-05-20 00:00:00.000000000 +0000
@@ -603,9 +603,11 @@
 tmpfiles=
 cleanup_tmpfiles() {
-  rm -f $tmpfiles
+  rm -rf $tmpfiles
 }

-tmp=`mktemp -d "$TMPDIR/confXXXXXX"` || exit 1
+# OHOS compatibility: avoid mktemp pipe issue on HMDFS
+# HMDFS restricts fstat/lseek on pipe fd, returns EACCES
+tmp=./.conf-temp
+mkdir -p $tmp || exit 1
 tmpfiles="$tmpfiles $tmp"