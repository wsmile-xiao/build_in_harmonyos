#!/bin/sh
# qemu-system-x86_64 test stub for nemu upstream tests (rule4 real-run).
# Emulates `qemu-system-x86_64 -M help` (machine table with "(default)"
# marks; nemu's nm_mach_parse picks the first "(default)" line, "pc").
# Any other invocation exits 0: the tests assert the QEMU command line
# generated by nemu, they never actually start QEMU.
# Optional tracing: set NEMU_QEMU_STUB_LOG to a writable file path.
if [ -n "${NEMU_QEMU_STUB_LOG:-}" ]; then
    echo "qemu-system-x86_64 $*" >> "$NEMU_QEMU_STUB_LOG" 2>/dev/null || true
fi
if [ "$1" = "-M" ] && [ "$2" = "help" ]; then
    cat <<'MACHELP'
Supported machines are:
akaroa               Akaroa (default)
pc-i440fx-2.0        Standard PC (i440FX + PIIX, 1996)
pc                   Standard PC (i440FX + PIIX, 1996) (default)
q35                  Standard PC (Q35 + ICH9, 2009)
virt                 Linux-only Virtual Machine (default)
none                 empty machine
MACHELP
    exit 0
fi
exit 0
