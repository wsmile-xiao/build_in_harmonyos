#!/bin/sh
# qemu-img 测试桩（nemu 上游测试 rule4 真跑用）
# 模拟上游 qemu-img 的两个用法：
#   qemu-img create -f <fmt> <file> <size>G   → 创建稀疏镜像文件
#   qemu-img convert -O <fmt> <src> <dst>     → 复制镜像内容
case "$1" in
create)
    # create -f fmt file size
    file="$4"
    : > "$file" 2>/dev/null || exit 1
    exit 0
    ;;
convert)
    # convert -O fmt src dst
    src="$4"
    dst="$5"
    if [ -f "$src" ]; then
        cp "$src" "$dst" 2>/dev/null || : > "$dst"
    else
        : > "$dst" 2>/dev/null || exit 1
    fi
    exit 0
    ;;
esac
exit 0
