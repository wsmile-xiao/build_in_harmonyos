--- /dev/null
+++ b/src/server/ohos_stub_headers.h
@@ -0,0 +1,23 @@
+/*
+	ohos_stub_headers.h — OHOS compat seam for the NymphCast server port.
+
+	The __OHOS__ branches in patches 0001/0002 route the server subsystem
+	headers (screensaver, nyansd, nc_apps, gui) through this single header.
+	On OHOS all four upstream headers compile cleanly (verified with the
+	recipe-injected include paths: SDL2 subdir, freetype2, nymphrpc,
+	libnymphcast), so this seam simply re-includes them rather than
+	reimplementing stubs. This keeps declarations ABI-identical to the
+	real implementations that the server Makefile compiles and links
+	(gui.cpp, screensaver.cpp, nc_apps.cpp, bytebauble.cpp, libnymphcast).
+
+	Only referenced from within #ifdef __OHOS__ guards.
+*/
+#ifndef OHOS_STUB_HEADERS_H
+#define OHOS_STUB_HEADERS_H
+
+#include "screensaver.h"
+#include "nyansd.h"
+#include "nc_apps.h"
+#include "gui.h"
+
+#endif // OHOS_STUB_HEADERS_H
