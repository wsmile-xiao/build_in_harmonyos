+
 TARGET_BIN := $(TARGET)/
 
 # Include the file with the versioning information ('VERSION' variable).
@@ -72,9 +77,11 @@ LIB := -lnymphrpc -lnymphcast -lPocoUtil -lPocoNet -lPocoNetSSL -lPocoJSON -lPoc
 			# -lvlc -lpostproc
 ifndef HAIKU
