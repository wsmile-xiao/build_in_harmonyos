+endif
 
 STATIC_LIB := -Wl,-Bstatic -lnymphrpc -lswscale -lavcodec -lavdevice -lavformat -lavutil \
 		-lswresample -lavfilter -lSDL2_image -Langelscript/angelscript/lib-$(TARGET) -langelscript \
@@ -118,6 +125,16 @@ else ifdef HAIKU
 	LDFLAGS += -pthread -latomic -lGL -lnetwork
 else ifdef FREEBSD
 	LDFLAGS += -pthread -lGL
+else ifdef OHOS
+	# OHOS has no libatomic/libGL/libasound. The GUI renderer is compiled
+	# with -DUSE_OPENGL_14 but runs headless; the no-op GL stub object is
+	# added to the link line separately (OHOS_STUB_OBJ). libfreeimage.a
+	# references libtiff symbols, so link libtiff explicitly.
+	# -static-libstdc++: statically link libc++ so nymphcast_server does
+	# not need libc++_shared.so at run time (the conanrun env only prepends
+	# Conan package lib dirs, not the OHOS SDK/system runtime path; on a
+	# clean W3/CI shell the dynamic dep would fail to load).
+	LDFLAGS += -pthread -ltiff -static-libstdc++
 else
 	LDFLAGS += -pthread -latomic -lGL -lasound
 endif
