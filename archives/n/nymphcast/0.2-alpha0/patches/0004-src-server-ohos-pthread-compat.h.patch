--- /dev/null
+++ b/src/server/ohos_pthread_compat.h
@@ -0,0 +1,33 @@
+/*
+	ohos_pthread_compat.h — OHOS pthread cancel-compat declarations.
+
+	The upstream lcdapi/ server code uses the GNU pthread cancellation API
+	(pthread_cancel / pthread_setcanceltype / pthread_setcancelstate /
+	pthread_testcancel). OHOS pthread.h does not declare these, but the
+	symbols ARE exported by the device libc (verified via
+	nm -D /system/lib64/libc.so: pthread_cancel T, pthread_setcancelstate W,
+	pthread_testcancel W). This header restores the declarations so the
+	lcdapi sources compile and link against the device libc.
+
+	Injected for all translation units via CFLAGS/CXXFLAGS `-include`.
+*/
+#ifndef OHOS_PTHREAD_COMPAT_H
+#define OHOS_PTHREAD_COMPAT_H
+
+// The compat header is force-included into every TU (CFLAGS/CXXFLAGS
+// `-include`), including assembler sources. Guard the C-only content so
+// preprocessing an .s file does not pull C headers into assembly.
+#ifndef __ASSEMBLER__
+
+#include <pthread.h>
+
+#ifdef __OHOS__
+extern "C" int pthread_cancel(pthread_t);
+extern "C" int pthread_setcanceltype(int, int *);
+extern "C" int pthread_setcancelstate(int, int *);
+extern "C" void pthread_testcancel(void);
+#endif
+
+#endif // __ASSEMBLER__
+
+#endif // OHOS_PTHREAD_COMPAT_H
