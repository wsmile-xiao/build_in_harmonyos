@@ -21,15 +22,26 @@
   unsigned id;
   struct tabletctx* next;
   pthread_mutex_t lock;
+#ifndef HAVE_PTHREAD_CANCEL
+  // cooperative shutdown: set by kill_tablet() when no pthread_cancel
+  volatile sig_atomic_t stop;
+#endif
 } tabletctx;
 
 static void
 kill_tablet(tabletctx** tctx){
   tabletctx* t = *tctx;
   if(t){
+#ifdef HAVE_PTHREAD_CANCEL
     if(pthread_cancel(t->tid)){
       fprintf(stderr, "Warning: error sending pthread_cancel (%s)\n", strerror(errno));
     }
+#else
+    // no pthread_cancel: request cooperative shutdown. a SIGWINCH kick
+    // interrupts any nanosleep() in flight, so the join returns quickly.
+    t->stop = 1;
+    pthread_kill(t->tid, SIGWINCH);
+#endif
     if(pthread_join(t->tid, NULL)){
       fprintf(stderr, "Warning: error joining pthread (%s)\n", strerror(errno));
     }
@@ -124,6 +136,11 @@
     ts.tv_sec = rand() % 2 + MINSECONDS;
     ts.tv_nsec = rand() % 1000000000;
     nanosleep(&ts, NULL);
+#ifndef HAVE_PTHREAD_CANCEL
+    if(tctx->stop){
+      break;
+    }
+#endif
     int action = rand() % 5;
     pthread_mutex_lock(&tctx->lock);
     if(action < 2){
@@ -155,6 +172,9 @@
     return NULL;
   }
   pthread_mutex_init(&tctx->lock, NULL);
