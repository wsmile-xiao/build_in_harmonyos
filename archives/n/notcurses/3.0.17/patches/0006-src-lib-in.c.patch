+// OHOS: Clear initdata so input thread processes keyboard input normally.
+// Called after skipping handle_responses (no queries were sent).
+void inputlayer_clear_initdata(inputctx* ictx){
+  if(ictx){
+    pthread_mutex_lock(&ictx->ilock);
+    if(ictx->initdata){
+      free(ictx->initdata);
+      ictx->initdata = NULL;
+      ictx->coutstanding = 0;
+    }
+    pthread_mutex_unlock(&ictx->ilock);
+    pthread_cond_broadcast(&ictx->icond);
+    loginfo("OHOS: cleared initdata, input thread ready for normal input");
+  }
