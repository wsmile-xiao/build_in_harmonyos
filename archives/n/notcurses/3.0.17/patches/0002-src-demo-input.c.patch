 int stop_input(void){
   int ret = 0;
   if(input_pipefds[0] >= 0){
+#ifndef __OHOS__
     ret |= pthread_cancel(tid);
+#endif
     ret |= pthread_join(tid, NULL);
     ret |= close(input_pipefds[0]);
     ret |= close(input_pipefds[1]);
     input_pipefds[0] = input_pipefds[1] = -1;
     ret |= pthread_cond_destroy(&cond);
   }
   return ret;
 }
