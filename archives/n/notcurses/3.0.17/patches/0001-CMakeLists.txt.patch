--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -150,12 +150,44 @@
 # feature_summary + set_package_properties to fail in one fell swoop.
 find_package(Threads)
 set_package_properties(Threads PROPERTIES TYPE REQUIRED)
+# feature detection: not every libc provides pthread_cancel, ppoll or
+# mremap (e.g. OHOS musl omits all three). probe the headers and fall
+# back to portable alternatives at compile time instead of keying off
+# platform macros.
+include(CheckSymbolExists)
+set(CMAKE_REQUIRED_LIBRARIES ${CMAKE_THREAD_LIBS_INIT})
+check_symbol_exists(pthread_cancel "pthread.h" HAVE_PTHREAD_CANCEL)
+check_symbol_exists(ppoll "poll.h" HAVE_PPOLL)
+check_symbol_exists(mremap "sys/mman.h" HAVE_MREMAP)
+set(CMAKE_REQUIRED_LIBRARIES "")
+if(HAVE_PTHREAD_CANCEL)
+  add_compile_definitions(HAVE_PTHREAD_CANCEL)
+endif()
+if(HAVE_PPOLL)
+  add_compile_definitions(HAVE_PPOLL)
+endif()
+if(HAVE_MREMAP)
+  add_compile_definitions(HAVE_MREMAP)
+endif()
+# workarounds for terminals that never answer status queries (DA1/DA2/
+# DSRCPR/DIRECTIVES) and deliver Enter as a synthesized key. off by
+# default; enable when targeting such terminals.
+option(NOTCURSES_TERM_QUIRKS "Terminal workarounds: skip status queries, handle synthesized Enter" OFF)
+if(NOTCURSES_TERM_QUIRKS)
+  add_compile_definitions(NOTCURSES_TERM_QUIRKS)
+endif()
 # platform-specific logics
 if(WIN32)
   set(LIBRT wsock32 ws2_32 secur32)
 elseif(NOT APPLE)
-  find_library(LIBM m REQUIRED)
-  find_library(LIBRT rt REQUIRED)
+  find_library(LIBM m)
+  if(NOT LIBM)
+    set(LIBM "")
+  endif()
+  find_library(LIBRT rt)
+  if(NOT LIBRT)
+    set(LIBRT "")
+  endif()
 endif()
 if(NOT ${CMAKE_SYSTEM_NAME} STREQUAL "Linux")
   include_directories(/usr/local/include)
