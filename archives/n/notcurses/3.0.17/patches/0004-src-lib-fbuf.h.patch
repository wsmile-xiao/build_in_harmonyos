 static inline void
 fbuf_free(fbuf* f){
   if(f){
 //    logdebug("Releasing from %" PRIu32 "B (%" PRIu32 "B)", f->size, f->used);
     if(f->buf){
-#if __linux__
+#if defined(__linux__) && !defined(__OHOS__)
       if(munmap(f->buf, f->size)){
         //logwarn("Error unmapping alloc (%s)", strerror(errno));
       }
 #else
       free(f->buf);
 #endif
       f->buf = NULL;
     }
     f->size = 0;
     f->used = 0;
