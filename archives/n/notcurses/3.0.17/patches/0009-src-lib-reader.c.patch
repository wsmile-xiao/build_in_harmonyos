+#ifdef __OHOS__
+  // OHOS: Handle Enter as actual newline (cursor to start of next line).
+  // Default path writes '\r' as 1-col invisible EGC, causing:
+  //   - No visible newline
+  //   - Cursor drift (invisible char takes up space)
+  // Must be BEFORE nckey_synthesized_p check since NCKEY_ENTER is synthesized.
+  // Also handle OHOS-specific Enter key code 0x1103f1.
+  if(ni->id == NCKEY_ENTER || ni->id == 0x1103f1){
+    unsigned y = n->textarea->y;
+    if(y < n->textarea->leny - 1){
+      ncplane_putchar(n->textarea, '\n');
+      ncplane_cursor_move_yx(n->textarea, y + 1, 0);
+      ncplane_cursor_move_yx(n->ncp, n->ncp->y + 1, 0);
+      ncreader_redraw(n);
+    }
+    return true;
   }
-  // FIXME deal with multicolumn EGCs -- probably extract these and make them
-  // general ncplane_cursor_{left, right, up, down}()
+#endif
