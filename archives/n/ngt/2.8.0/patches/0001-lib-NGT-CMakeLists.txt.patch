+	# OHOS/HMDFS cannot create the versioned symlink chain (libngt.so ->
+	# libngt.so.2 -> libngt.so.2.8.0) that CMake normally generates when
+	# VERSION/SOVERSION are set, so build a plain unversioned libngt.so.
+	# (HarmonyOS dynamic loader also refuses to load .so through symlinks.)
+	# set_target_properties(ngt PROPERTIES VERSION ${ngt_VERSION})
+	# set_target_properties(ngt PROPERTIES SOVERSION ${ngt_SOVERSION})
 	add_dependencies(ngt ngtstatic)
 	if((NOT DEFINED NGT_QBG_DISABLED) OR (NOT ${NGT_QBG_DISABLED}))
 		if((DEFINED NGT_X86SIMDSORT) OR (DEFINED NGTQG_X86SIMDSORT))
-			target_link_libraries(ngt lapack blas x86simdsortcpp)
+			target_link_libraries(ngt ${BLAS_LIBRARIES} ${LAPACK_LIBRARIES} x86simdsortcpp)
 		else()
-			target_link_libraries(ngt lapack blas)
+			# Link the BLAS/LAPACK providers found by find_package(BLAS/LAPACK)
+			# (full paths) instead of bare -llapack/-lblas so that conan-provided
+			# providers (e.g. OpenBLAS) are used correctly.
+			target_link_libraries(ngt ${BLAS_LIBRARIES} ${LAPACK_LIBRARIES})
 		endif()
 	endif()
 	if(${APPLE})
 		if(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
 			target_link_libraries(ngt OpenMP::OpenMP_CXX)
 		else()
 			target_link_libraries(ngt gomp)
 		endif()
 	else(${APPLE})
 		target_link_libraries(ngt gomp rt)
-		if(NGT_FOREST)
+		if(NGT_FOREST AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+			# -lstdc++fs is only required by old GCC/libstdc++ (<9) for
+			# <experimental/filesystem>; Clang + libc++ (HarmonyOS/OHOS)
+			# provides <filesystem> in the C++ standard library itself.
 			target_link_libraries(ngt stdc++fs)
 			target_link_libraries(ngtstatic stdc++fs)
 		endif()
 	endif(${APPLE})
 	add_custom_command(OUTPUT command DEPENDS ${NGT_SOURCES} WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR} COMMAND sh ${PROJECT_SOURCE_DIR}/utils/mk_version_defs_h.sh ${PROJECT_SOURCE_DIR} version_defs.h)
 	add_custom_target(versiondef DEPENDS command)
 	add_dependencies(ngtstatic versiondef)
 	install(TARGETS
 		ngt
 		ngtstatic
