+#undef HAVE_GETPASS
--- a/include/proto.h
+++ b/include/proto.h
@@ -119,5 +119,82 @@
 #ifdef HAVE_GETPASSPHRASE
 #define GETPASS getpassphrase
-#else
+#elif defined(HAVE_GETPASS)
 #define GETPASS getpass
+#else
+#include <stdio.h>
+#include <string.h>
+#if defined(HAVE_SYS_TERMIOS_H)
+#include <sys/termios.h>
+#elif defined(HAVE_TERMIOS_H)
+#include <termios.h>
+#endif
+#if defined(HAVE_SYS_TERMIOS_H) || defined(HAVE_TERMIOS_H)
+#include <unistd.h>
+#endif
+
+static char nut_getpass_buffer[256];
+
+static char *nut_getpass_fallback(const char *prompt)
+{
+	FILE *input = fopen("/dev/tty", "r");
+	FILE *output = fopen("/dev/tty", "w");
+#if defined(HAVE_SYS_TERMIOS_H) || defined(HAVE_TERMIOS_H)
+	int input_fd;
+	struct termios old_termios;
+	int noecho = 0;
+#endif
+
+	if (!input) {
+		input = stdin;
+	}
+	if (!output) {
+		output = stderr;
+	}
+
+	fputs(prompt, output);
+	fflush(output);
+#if defined(HAVE_SYS_TERMIOS_H) || defined(HAVE_TERMIOS_H)
+	input_fd = fileno(input);
+	if (tcgetattr(input_fd, &old_termios) == 0) {
+		struct termios noecho_termios = old_termios;
+		noecho_termios.c_lflag &= (tcflag_t)~ECHO;
+		noecho = tcsetattr(input_fd, TCSAFLUSH, &noecho_termios) == 0;
+	}
+#endif
+
+	if (!fgets(nut_getpass_buffer,
+	    sizeof(nut_getpass_buffer), input)) {
+#if defined(HAVE_SYS_TERMIOS_H) || defined(HAVE_TERMIOS_H)
+		if (noecho) {
+			tcsetattr(input_fd, TCSAFLUSH, &old_termios);
+		}
+#endif
+		if (input != stdin) {
+			fclose(input);
+		}
+		if (output != stderr) {
+			fclose(output);
+		}
+		return NULL;
+	}
+
+#if defined(HAVE_SYS_TERMIOS_H) || defined(HAVE_TERMIOS_H)
+	if (noecho) {
+		tcsetattr(input_fd, TCSAFLUSH, &old_termios);
+	}
+#endif
+	fputc('\n', output);
+	fflush(output);
+	if (input != stdin) {
+		fclose(input);
+	}
+	if (output != stderr) {
+		fclose(output);
+	}
+
+	nut_getpass_buffer[strcspn(nut_getpass_buffer, "\r\n")] = '\0';
+	return nut_getpass_buffer;
+}
+
+#define GETPASS nut_getpass_fallback
 #endif
