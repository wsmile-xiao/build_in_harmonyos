 ac_fn_c_check_func "$LINENO" "getpassphrase" "ac_cv_func_getpassphrase"
 if test "x$ac_cv_func_getpassphrase" = xyes
 then :
   printf "%s\n" "#define HAVE_GETPASSPHRASE 1" >>confdefs.h
-
+
 fi
