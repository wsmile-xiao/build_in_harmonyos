--- /dev/null
+++ b/configure
@@ -0,0 +1,21 @@
+#!/bin/sh
+# nomacs cmake configure wrapper for OpenHarmony build system
+# This script provides a ./configure interface for cmake-based projects
+#
+# Usage: ./configure --prefix=/path [options]
+# Options are converted to cmake -D flags
+
+PREFIX=""
+EXTRA_OPTS=""
+
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*) PREFIX="${arg#--prefix=}" ;;
+        *) EXTRA_OPTS="$EXTRA_OPTS $arg" ;;
+    esac
+done
+
+if [ -z "$PREFIX" ]; then
+    PREFIX="$HOME/usr/local"
+fi
+
+mkdir -p build
+cd build
+cmake ../ImageLounge -DCMAKE_INSTALL_PREFIX="$PREFIX" \
+    -DENABLE_OPENCV=OFF -DENABLE_RAW=OFF -DENABLE_TIFF=OFF \
+    -DENABLE_QUAZIP=OFF -DENABLE_PLUGINS=OFF -DENABLE_TESTING=OFF \
+    -DENABLE_QT_DEBUG=OFF -DENABLE_TRANSLATIONS=OFF $EXTRA_OPTS
