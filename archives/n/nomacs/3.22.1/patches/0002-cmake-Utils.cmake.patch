diff -ruN a/ImageLounge/cmake/Utils.cmake b/ImageLounge/cmake/Utils.cmake
--- a/ImageLounge/cmake/Utils.cmake
+++ b/ImageLounge/cmake/Utils.cmake
@@ -15,22 +15,31 @@
         get_filename_component(QT_QMAKE_PATH ${QT_QMAKE_EXECUTABLE} PATH)
     endif()
 
     if(NOT DEFINED QT_VERSION_MAJOR)
         find_package(QT NAMES Qt6 REQUIRED COMPONENTS Core)
     endif()
 
     find_package(
         Qt${QT_VERSION_MAJOR}
         REQUIRED
-        COMPONENTS Widgets Network LinguistTools PrintSupport Concurrent Gui Svg
+        COMPONENTS Widgets Network LinguistTools PrintSupport Concurrent Gui
     )
+
+    # HarmonyOS: Qt6Svg is a stub library with no real QSvgRenderer.
+    # Try to find it but don't require it - we use DkSvgRendererStub instead.
+    find_package(Qt${QT_VERSION_MAJOR} COMPONENTS Svg QUIET)
+    if(Qt${QT_VERSION_MAJOR}Svg_FOUND)
+        message(STATUS "Qt6Svg found - real SVG support available")
+    else()
+        message(STATUS "Qt6Svg NOT found - using DkSvgRendererStub (no SVG rendering)")
+    endif()
 
     if(NOT Qt${QT_VERSION_MAJOR}_FOUND)
         message(FATAL_ERROR "Qt Libraries not found!")
     endif()
 endmacro(NMC_FINDQT)
 
 macro(NMC_INSTALL)
     set(NOMACS_INSTALL_DIRECTORY ${CMAKE_SOURCE_DIR}/../installer/ CACHE PATH "Path to the installer directory")
 
     if(MSVC)
