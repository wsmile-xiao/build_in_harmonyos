--- /dev/null
+++ b/ImageLounge/src/DkCore/DkSvgRenderer_stub.h
@@ -0,0 +1,44 @@
+#ifndef DKSVGRENDERER_STUB_H
+#define DKSVGRENDERER_STUB_H
+
+#include <QObject>
+#include <QPixmap>
+#include <QSize>
+#include <QString>
+#include <QByteArray>
+#include <QPainter>
+#include <QRectF>
+#include <QPointF>
+#include <QIODevice>
+
+/**
+ * HarmonyOS stub for QSvgRenderer.
+ * Qt6Svg on HarmonyOS provides minimal stub headers with no real SVG rendering.
+ * This class provides a compatible API that allows nomacs to compile without
+ * linking to a real QSvgRenderer vtable.
+ */
+class DkSvgRendererStub : public QObject {
+    Q_OBJECT
+public:
+    explicit DkSvgRendererStub(QObject *parent = nullptr) : QObject(parent) {}
+    DkSvgRendererStub(const QString &filename, QObject *parent = nullptr) : QObject(parent) {}
+    DkSvgRendererStub(const QByteArray &contents, QObject *parent = nullptr) : QObject(parent) {}
+    bool isValid() const { return false; }
+    QSize defaultSize() const { return QSize(); }
+    bool render(QPainter *painter, const QRectF &bounds = QRectF()) { return false; }
+    void render(QPainter *painter, const QString &elementId, const QRectF &bounds = QRectF()) {}
+    void render(QPainter *painter, const QPointF &offset = QPointF()) {}
+    bool load(const QString &filename) { return false; }
+    bool load(const QByteArray &contents) { return false; }
+    bool load(QIODevice *device) { return false; }
+    void setViewBox(const QRectF &viewbox) {}
+    QRectF viewBoxF() const { return QRectF(); }
+    QRectF boundsOnElement(const QString &id) const { return QRectF(); }
+    bool elementExists(const QString &id) const { return false; }
+};
+
+// On HarmonyOS/OpenHarmony, Qt6Svg is a stub library with no real QSvgRenderer.
+// Use DkSvgRendererStub everywhere instead of QSvgRenderer.
+using QSvgRenderer = DkSvgRendererStub;
+
+#endif // DKSVGRENDERER_STUB_H
