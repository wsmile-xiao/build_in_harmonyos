diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,48 @@
+#!/bin/sh
+# configure wrapper for makefile-based nsxiv on OpenHarmony
+
+PREFIX=$HOME/usr/local
+
+# Check if --prefix was provided
+for arg in $*; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX=`echo "$arg" | sed 's/--prefix=//'`
+            ;;
+    esac
+done
+
+PKG_CONFIG_PATH="$HOME/usr/local/lib/pkgconfig:$HOME/usr/local/share/pkgconfig"
+export PKG_CONFIG_PATH
+
+echo "nsxiv configure wrapper for OpenHarmony"
+echo "PREFIX=$PREFIX"
+
+# Check for required dependencies
+for pkg in imlib2 x11 xft fontconfig freetype2; do
+    if pkg-config --exists $pkg; then
+        ver=`pkg-config --modversion $pkg`
+        echo "  $pkg: $ver"
+    else
+        echo "ERROR: $pkg not found via pkg-config"
+        exit 1
+    fi
+done
+
+# Create config.h from config.def.h
+if [ ! -f config.h ]; then
+    cp config.def.h config.h
+    echo "Created config.h from config.def.h"
+fi
+
+# Create version.h
+echo '#define VERSION "34"' > version.h
+echo "Created version.h"
+
+# Create .git/index for Makefile version.h rule
+mkdir -p .git
+touch .git/index
+echo "Created .git/index"
+
+echo "Configuration complete."
+exit 0
