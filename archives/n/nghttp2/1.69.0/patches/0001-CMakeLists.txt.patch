--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -142,20 +142,25 @@
   check_cxx_source_compiles("
   #include <vector>
   #include <future>
   int main() { std::vector<std::future<int>> v; }" HAVE_STD_FUTURE)
   # Check that std::chrono::time_zone is available.
   check_cxx_source_compiles("
