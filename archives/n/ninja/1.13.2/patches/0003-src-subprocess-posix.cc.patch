--- a/src/subprocess-posix.cc
+++ b/src/subprocess-posix.cc
@@ -15,6 +15,17 @@
 #include "exit_status.h"
 #include "subprocess.h"
 
+// The POSIX shell used to launch subprocess commands.  Some platforms (e.g.
+// HarmonyOS PC) ship a /bin/sh without full POSIX signal semantics (a child
+// killed by SIGHUP exits normally with WIFEXITED(129) instead of dying with
+// WIFSIGNALED(SIGHUP)), which makes tools that rely on WIFSIGNALED for
+// interrupt detection fail.  The build may override this via
+// NINJA_SUBPROCESS_SHELL to a POSIX-conformant shell (e.g. bash); the default
+// keeps upstream behaviour unchanged on other platforms.
+#ifndef NINJA_SUBPROCESS_SHELL
+#define NINJA_SUBPROCESS_SHELL "/bin/sh"
+#endif
+
 #include <sys/select.h>
 #include <assert.h>
 #include <errno.h>
@@ -129,8 +140,8 @@ bool Subprocess::Start(SubprocessSet* set, const string& command) {
   if (err != 0)
     Fatal("posix_spawnattr_setflags: %s", strerror(err));
 
-  const char* spawned_args[] = { "/bin/sh", "-c", command.c_str(), NULL };
-  err = posix_spawn(&pid_, "/bin/sh", &action, &attr,
+  const char* spawned_args[] = { NINJA_SUBPROCESS_SHELL, "-c", command.c_str(), NULL };
+  err = posix_spawn(&pid_, NINJA_SUBPROCESS_SHELL, &action, &attr,
         const_cast<char**>(spawned_args), environ);
   if (err != 0)
     Fatal("posix_spawn: %s", strerror(err));
