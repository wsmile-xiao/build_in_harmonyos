+std::string utf8ToLatin1(const std::string &s)
+{
+	std::string result;
+	result.reserve(s.size());
+	for (size_t i = 0; i < s.size(); ++i)
+	{
+		const unsigned char c = static_cast<unsigned char>(s[i]);
+		if (c < 0x80)
+		{
+			result += static_cast<char>(c);
+			continue;
+		}
+		uint32_t cp = 0;
+		size_t len = 0;
+		if ((c >> 5) == 0x06) { cp = c & 0x1F; len = 2; }
+		else if ((c >> 4) == 0x0E) { cp = c & 0x0F; len = 3; }
+		else { result += '?'; continue; }
+		if (i + len > s.size()) { result += '?'; break; }
+		bool valid = true;
+		for (size_t j = 1; j < len; ++j)
+		{
+			const unsigned char cc = static_cast<unsigned char>(s[i + j]);
+			if ((cc >> 6) != 0x02) { valid = false; break; }
+			cp = (cp << 6) | (cc & 0x3F);
