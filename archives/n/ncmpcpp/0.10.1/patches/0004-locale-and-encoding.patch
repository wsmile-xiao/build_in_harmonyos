+std::string toLower(std::string s)
+{
+	// ASCII lowercase; non-ASCII bytes pass through unchanged.
+	for (auto &c : s)
+	{
+		if (static_cast<unsigned char>(c) < 0x80)
+			c = std::tolower(static_cast<unsigned char>(c));
+	}
+	return s;
+}
