+ *   Free Software Foundation, Inc.,                                       *
+ *   51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA.              *
+ ***************************************************************************/
+
+#include "utility/encoding.h"
+
+#include <cstdint>
+#include <utility>
+
+namespace Encoding {
+namespace {
+
+void appendUtf8(std::string &out, uint32_t cp)
+{
+	if (cp < 0x80)
+		out += static_cast<char>(cp);
+	else if (cp < 0x800)
+	{
+		out += static_cast<char>(0xC0 | (cp >> 6));
+		out += static_cast<char>(0x80 | (cp & 0x3F));
+	}
+	else if (cp < 0x10000)
+	{
+		out += static_cast<char>(0xE0 | (cp >> 12));
+		out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+		out += static_cast<char>(0x80 | (cp & 0x3F));
+	}
+	else
+	{
+		out += static_cast<char>(0xF0 | (cp >> 18));
+		out += static_cast<char>(0x80 | ((cp >> 12) & 0x3F));
+		out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+		out += static_cast<char>(0x80 | (cp & 0x3F));
+	}
+}
+
+uint32_t decodeUtf8(const std::string &s, size_t &i)
+{
+	const unsigned char c = static_cast<unsigned char>(s[i]);
+	uint32_t cp;
+	size_t len;
+	if (c < 0x80) { cp = c; len = 1; }
+	else if ((c >> 5) == 0x06) { cp = c & 0x1F; len = 2; }
+	else if ((c >> 4) == 0x0E) { cp = c & 0x0F; len = 3; }
+	else if ((c >> 3) == 0x1E) { cp = c & 0x07; len = 4; }
+	else { cp = 0xFFFD; len = 1; }
+
+	if (i + len > s.size())
+	{
+		i = s.size();
+		return 0xFFFD;
+	}
+	for (size_t j = 1; j < len; ++j)
+	{
+		const unsigned char cc = static_cast<unsigned char>(s[i + j]);
+		if ((cc >> 6) != 0x02) { cp = 0xFFFD; len = 1; break; }
+		cp = (cp << 6) | (cc & 0x3F);
+	}
+	i += len;
+	return cp;
+}
+
+} // namespace
+
+std::string toUtf8(const std::string &s) { return s; }
+std::string toUtf8(std::string &&s) { return std::move(s); }
+
+std::string toUtf8(const std::wstring &s)
+{
+	std::string out;
+	out.reserve(s.size());
+	if (sizeof(wchar_t) == 2)
+	{
+		for (size_t i = 0; i < s.size(); ++i)
+		{
+			const uint16_t u = static_cast<uint16_t>(s[i]);
+			if (u >= 0xD800 && u <= 0xDBFF && i + 1 < s.size())
+			{
+				const uint16_t lo = static_cast<uint16_t>(s[i + 1]);
+				if (lo >= 0xDC00 && lo <= 0xDFFF)
+				{
+					const uint32_t cp = 0x10000
+						+ ((static_cast<uint32_t>(u) - 0xD800) << 10)
+						+ (lo - 0xDC00);
+					appendUtf8(out, cp);
+					++i;
+					continue;
+				}
+			}
+			appendUtf8(out, u);
+		}
+	}
+	else
+	{
+		for (wchar_t wc : s)
+			appendUtf8(out, static_cast<uint32_t>(wc));
+	}
+	return out;
+}
+
+std::wstring fromUtf8(const std::wstring &s) { return s; }
+
+std::wstring fromUtf8(const std::string &s)
+{
+	std::wstring out;
+	out.reserve(s.size());
+	if (sizeof(wchar_t) == 2)
+	{
+		for (size_t i = 0; i < s.size(); )
+		{
+			const uint32_t cp = decodeUtf8(s, i);
+			if (cp >= 0x10000)
+			{
+				const uint32_t v = cp - 0x10000;
+				out += static_cast<wchar_t>(0xD800 + (v >> 10));
+				out += static_cast<wchar_t>(0xDC00 + (v & 0x3FF));
+			}
+			else
+				out += static_cast<wchar_t>(cp);
+		}
+	}
+	else
+	{
+		for (size_t i = 0; i < s.size(); )
+			out += static_cast<wchar_t>(decodeUtf8(s, i));
+	}
+	return out;
+}
+
+} // namespace Encoding
