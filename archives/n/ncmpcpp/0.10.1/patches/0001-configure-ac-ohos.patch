diff --git a/m4/boost.m4 b/m4/boost.m4
index a0894f3..85f113b 100644
--- a/m4/boost.m4
+++ b/m4/boost.m4
@@ -1136,9 +1136,21 @@ BOOST_DEFUN([String_Algo],
 # documentation of BOOST_FIND_LIB above.  This library was introduced in Boost
 # 1.35.0.
 BOOST_DEFUN([System],
-[BOOST_FIND_LIB([system], [$1],
+[BOOST_FIND_HEADER([boost/system/error_code.hpp])
+if test $boost_major_version -ge 169; then
+  # Boost.System is header-only since 1.69.0: there is no
+  # libboost_system to find or link against.
+  BOOST_SYSTEM_LDFLAGS=
+  BOOST_SYSTEM_LDPATH=
+  BOOST_SYSTEM_LIBS=
+  AC_SUBST([BOOST_SYSTEM_LDFLAGS])
+  AC_SUBST([BOOST_SYSTEM_LDPATH])
+  AC_SUBST([BOOST_SYSTEM_LIBS])
+else
+BOOST_FIND_LIB([system], [$1],
                 [boost/system/error_code.hpp],
                 [boost::system::error_code e; e.clear();])
+fi
 ])# BOOST_SYSTEM
 
 
