diff --git a/src/utility/readline.h b/src/utility/readline.h
index 1506bef..1f06af5 100644
--- a/src/utility/readline.h
+++ b/src/utility/readline.h
@@ -21,18 +21,63 @@
 #ifndef NCMPCPP_UTILITY_READLINE_H
 #define NCMPCPP_UTILITY_READLINE_H
 
-#include "config.h"
-
-#if defined(HAVE_READLINE_HISTORY_H)
-# include <readline/history.h>
-#endif // HAVE_READLINE_HISTORY
-
-#if defined(HAVE_READLINE_H)
-# include <readline.h>
-#elif defined(HAVE_READLINE_READLINE_H)
-# include <readline/readline.h>
-#else
-# error "readline is not available"
+/*
+ * Minimal GNU readline compatibility layer for HarmonyOS PC.
+ *
+ * The OHOS package repository has no readline and ncmpcpp only uses a small
+ * subset of the readline API (see src/curses/window.cpp). This header
+ * declares that subset; the implementation lives in
+ * src/curses/readline_compat.cpp and drives line editing through the
+ * rl_getc_function / rl_redisplay_function callbacks installed by ncmpcpp.
+ *
+ * NOTE: editing is intentionally simple (printable characters, Enter,
+ * Backspace, Ctrl-D on an empty line, Ctrl-C/Ctrl-G abort). There is no
+ * history recall; add_history() is accepted for compatibility.
+ */
+
+#include <cstdio>
+
+#define HAVE_READLINE_HISTORY_H 1
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef int rl_command_func_t(int, int);
+typedef int rl_getc_func_t(FILE *);
+typedef void rl_voidfunc_t(void);
+typedef int rl_vintfunc_t(void);
+typedef char **rl_completion_func_t(const char *, int, int);
+
+extern char *rl_line_buffer;
+extern int rl_point;
+extern int rl_end;
+extern int rl_done;
+
+extern int rl_catch_signals;
+extern int rl_catch_sigwinch;
+extern int rl_attempted_completion_over;
+extern rl_getc_func_t *rl_getc_function;
+extern rl_voidfunc_t *rl_redisplay_function;
+extern rl_vintfunc_t *rl_startup_hook;
+extern rl_voidfunc_t *rl_prep_term_function;
+extern rl_voidfunc_t *rl_deprep_term_function;
+extern rl_completion_func_t *rl_attempted_completion_function;
+
+enum { RL_STATE_DISPATCHING = 0x800 };
+extern int rl_readline_state;
+#define RL_ISSTATE(x) ((rl_readline_state) & (x))
+
+void rl_initialize(void);
+void rl_resize_terminal(void);
+void rl_bind_key(int key, rl_command_func_t *function);
+int rl_insert_text(const char *text);
+char *readline(const char *prompt);
+void add_history(const char *line);
+void clear_history(void);
+
+#ifdef __cplusplus
+}
 #endif
 
-#endif // NCMPCPP_READLINE_UTILITY_H
+#endif // NCMPCPP_UTILITY_READLINE_H
