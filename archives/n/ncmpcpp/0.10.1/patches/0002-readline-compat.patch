+ *   it under the terms of the GNU General Public License as published by  *
+ *   the Free Software Foundation; either version 2 of the License, or     *
+ *   (at your option) any later version.                                   *
+ *                                                                         *
+ *   This program is distributed in the hope that it will be useful,       *
+ *   but WITHOUT ANY WARRANTY; without even the implied warranty of        *
+ *   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the         *
+ *   GNU General Public License for more details.                          *
+ *                                                                         *
+ *   You should have received a copy of the GNU General Public License     *
+ *   along with this program; if not, write to the                         *
+ *   Free Software Foundation, Inc.,                                       *
+ *   51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA.              *
+ ***************************************************************************/
+
+#include "utility/readline.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace {
+
+struct Binding
+{
+	int key;
+	rl_command_func_t *function;
+};
+
+std::vector<Binding> bindings;
+char *line_buffer = nullptr;
+size_t line_buffer_capacity = 0;
+bool active = false;
+bool ended_with_eof = false;
+
+bool ensureCapacity(size_t needed)
+{
+	if (needed + 1 <= line_buffer_capacity)
+		return true;
+	size_t new_capacity = line_buffer_capacity == 0 ? 16 : line_buffer_capacity;
+	while (new_capacity < needed + 1)
+		new_capacity *= 2;
+	char *new_buffer = static_cast<char *>(std::realloc(line_buffer, new_capacity));
+	if (new_buffer == nullptr)
+		return false;
+	line_buffer = new_buffer;
+	line_buffer_capacity = new_capacity;
+	rl_line_buffer = line_buffer;
+	return true;
+}
+
+void redisplay()
+{
+	if (rl_redisplay_function != nullptr)
+		rl_redisplay_function();
+}
+
+} // namespace
+
+char *rl_line_buffer = nullptr;
+int rl_point = 0;
+int rl_end = 0;
+int rl_done = 0;
+int rl_catch_signals = 0;
+int rl_catch_sigwinch = 0;
+int rl_attempted_completion_over = 0;
+int rl_readline_state = 0;
+rl_getc_func_t *rl_getc_function = nullptr;
+rl_voidfunc_t *rl_redisplay_function = nullptr;
+rl_vintfunc_t *rl_startup_hook = nullptr;
+rl_voidfunc_t *rl_prep_term_function = nullptr;
+rl_voidfunc_t *rl_deprep_term_function = nullptr;
+rl_completion_func_t *rl_attempted_completion_function = nullptr;
+
+void rl_initialize()
+{
+	// nothing to do; ncmpcpp installs the callbacks right afterwards
+}
+
+void rl_resize_terminal()
+{
+	// ncurses owns the terminal dimensions on OHOS; ncmpcpp calls this
+	// before endwin()/refresh() on SIGWINCH, so just repaint the active
+	// prompt through the redisplay callback.
+	redisplay();
+}
+
+void rl_bind_key(int key, rl_command_func_t *function)
+{
+	for (auto &b : bindings)
+	{
+		if (b.key == key)
+		{
+			b.function = function;
+			return;
+		}
+	}
+	bindings.push_back({key, function});
+}
+
+int rl_insert_text(const char *text)
+{
+	if (text == nullptr || !active)
+		return 0;
+	const size_t len = std::strlen(text);
+	if (!ensureCapacity(rl_end + len))
+		return 0;
+	std::memmove(line_buffer + rl_point + len, line_buffer + rl_point,
+	             rl_end - rl_point + 1);
+	std::memcpy(line_buffer + rl_point, text, len);
+	rl_point += static_cast<int>(len);
+	rl_end += static_cast<int>(len);
+	redisplay();
+	return static_cast<int>(len);
+}
+
+char *readline(const char *prompt)
+{
+	(void)prompt;
+	if (active)
+		return nullptr;
+	active = true;
+	ended_with_eof = false;
+	if (!ensureCapacity(0))
+	{
+		active = false;
+		return nullptr;
+	}
+	rl_point = 0;
+	rl_end = 0;
+	rl_done = 0;
+	rl_readline_state = 0;
+	line_buffer[0] = 0;
+	rl_line_buffer = line_buffer;
+
+	if (rl_startup_hook != nullptr)
+		rl_startup_hook();
+
+	redisplay();
+
+	while (!rl_done)
+	{
+		const int key = rl_getc_function != nullptr
+			? rl_getc_function(stdin)
+			: std::getchar();
+
+		if (key == EOF)
+		{
+			// The prompt hook may have requested termination (it sets
+			// rl_done and returns EOF). GNU readline returns NULL when EOF
+			// is received on an empty line.
+			if (rl_done || rl_end == 0)
+			{
+				ended_with_eof = true;
+				break;
+			}
+			continue;
+		}
+
+		bool handled = false;
+		for (const auto &b : bindings)
+		{
+			if (b.key == key && b.function != nullptr)
+			{
+				b.function(key, 0);
+				handled = true;
+				break;
+			}
+		}
+		if (rl_done)
+			break;
+		if (handled)
+			continue;
+
+		switch (key)
+		{
+			case '\r':
+			case '\n':
+				rl_done = 1;
+				break;
+			case 0x04: // Ctrl-D
+				if (rl_end == 0)
+				{
+					ended_with_eof = true;
+					rl_done = 1;
+				}
+				break;
+			case 0x7f:
+			case 0x08: // backspace
+				if (rl_point > 0)
+				{
+					std::memmove(line_buffer + rl_point - 1, line_buffer + rl_point,
+					             rl_end - rl_point + 1);
+					--rl_point;
+					--rl_end;
+					redisplay();
+				}
+				break;
+			default:
+				if (key >= 0x20 && key <= 0x7e)
+				{
+					if (!ensureCapacity(rl_end + 1))
+						break;
+					std::memmove(line_buffer + rl_point + 1, line_buffer + rl_point,
+					             rl_end - rl_point + 1);
+					line_buffer[rl_point] = static_cast<char>(key);
+					++rl_point;
+					++rl_end;
+					redisplay();
+				}
+				break;
+		}
+	}
+
+	if (ended_with_eof && rl_end == 0)
+	{
+		active = false;
+		rl_done = 0;
+		return nullptr;
+	}
+
+	line_buffer[rl_end] = 0;
+	rl_point = std::min(rl_point, rl_end);
+	active = false;
+	rl_done = 0;
+	return line_buffer;
+}
+
+void add_history(const char *line)
+{
+	(void)line; // history recall is not used by ncmpcpp's prompts
+}
+
+void clear_history()
+{
+}
