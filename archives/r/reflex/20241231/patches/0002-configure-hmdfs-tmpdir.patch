diff -ruN a/configure b/configure
--- a/configure
+++ b/configure
@@ -7634,17 +7634,23 @@
 # Create a (secure) tmp directory for tmp files.
 : "${TMPDIR=/tmp}"
 {
-  tmp=`(umask 077 && mktemp -d -q "$TMPDIR/csXXXXXX") 2>/dev/null` &&
+  tmp=`(mktemp -d -q "$TMPDIR/csXXXXXX") 2>/dev/null` &&
   test -n "$tmp" && test -d "$tmp"
 }  ||
 {
   tmp=$TMPDIR/cs$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  mkdir "$tmp"
 } ||
 {
    echo "$me: cannot create a temporary directory in $TMPDIR" >&2
    { (exit 1); exit 1; }
 }
+# HMBS: HMDFS can hand back the freshly created directory without usable
+# owner permissions (umask/metadata not applied yet), so the first
+# redirect into it -- e.g. `> "$tmp"/subs.sed` -- dies with
+# "Permission denied".  mktemp already asked for 0700, but force it
+# explicitly so the mode is deterministic on every filesystem.
+chmod 700 "$tmp" 2>/dev/null || true
 
 EOF
 
