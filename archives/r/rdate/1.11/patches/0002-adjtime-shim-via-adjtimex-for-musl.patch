+#if !defined(HAVE_ADJTIME)
+/*
+ * musl provides adjtimex(2) but not the BSD/glibc adjtime(3) convenience
+ * wrapper this file's -a (slow adjustment) mode uses.  Provide the thin
+ * equivalent in terms of adjtimex -- which is exactly what glibc's own
+ * adjtime does internally.  Define HAVE_ADJTIME to use the libc one.
+ */
+#include <sys/timex.h>
+
+int
+adjtime(const struct timeval *delta, struct timeval *olddelta)
+{
+	struct timex tx;
+
+	memset(&tx, 0, sizeof(tx));
+	if (delta != NULL) {
+		tx.modes = ADJ_OFFSET_SINGLESHOT;
+		tx.offset = delta->tv_sec * 1000000 + delta->tv_usec;
+	}
+	if (adjtimex(&tx) == -1)
+		return (-1);
+	if (olddelta != NULL) {
+		olddelta->tv_sec = tx.offset / 1000000;
+		olddelta->tv_usec = tx.offset % 1000000;
+	}
+	return (0);
+}
+#endif /* !HAVE_ADJTIME */
