--- /dev/null
+++ b/include/unistd.h
@@ -0,0 +1,42 @@
+/*
+ * Public domain
+ * unistd.h compatibility shim
+ * Modified for OpenHarmony compatibility
+ */
+
+#ifndef LIBCOMPAT_UNISTD_H
+#define LIBCOMPAT_UNISTD_H
+
+/* Include system unistd.h first */
+#include <unistd.h>
+
+/* Include getopt.h for optarg/optind if needed */
+#include <getopt.h>
+
+/* Only declare functions that are missing on this platform */
+
+#ifndef HAVE_PIPE2
+int pipe2(int [2], int);
+#endif
+
+#ifndef HAVE_PLEDGE
+int pledge(const char *, const char *);
+
+#ifdef HAVE_LANDLOCK
+void pledge_landlock(const char *);
+#endif
+#endif
+
+#ifndef HAVE_UNVEIL
+int unveil(const char *, const char *);
+#endif
+
+#ifndef HAVE_GETENTROPY
+int getentropy(void *, size_t);
+#endif
+
+/* OpenHarmony has setgroups, setresgid/setresuid in system headers - skip declaration */
+
+#endif
