diff -ruN a/lib/libpe/error.c b/lib/libpe/error.c
--- a/lib/libpe/error.c
+++ b/lib/libpe/error.c
@@ -89,21 +89,21 @@
 		 * message. This may be either a pointer to a string that the function stores in buf, or
