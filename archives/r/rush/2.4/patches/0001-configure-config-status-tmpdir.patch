--- a/configure
+++ b/configure
@@ -31343,8 +31343,12 @@
 }
 # Create a (secure) tmp directory for tmp files.
 
+# OHOS/HMDFS workaround (E114): HMDFS forces setgid on directories, and
+# `umask 077 && mktemp -d "./confXXXXXX"` creates a drwx--S--- dir that
+# cannot be written even by its owner. Drop umask 077 so the temp dir is
+# created with normal (writeable) permissions.
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`mktemp -d "./confXXXXXX" 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
@@ -31351,5 +31355,5 @@
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  mkdir "$tmp" 2>/dev/null
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
