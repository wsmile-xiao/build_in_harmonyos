 int plthook_open_by_handle(plthook_t **plthook_out, void *hndl)
 {
     struct link_map *lmap = NULL;
 
     if (hndl == NULL) {
         set_errmsg("NULL handle");
         return PLTHOOK_FILE_NOT_FOUND;
     }
+#ifdef PLTHOOK_MUSL_LIBC
+    /* musl libc does not have dlinfo; use dlsym to get link_map from handle */
+    lmap = (struct link_map *)dlsym(hndl, "__dl_link_map");
+    if (lmap == NULL) {
+        /* fallback: return NOT_IMPLEMENTED on musl */
+        set_errmsg("dlinfo not available on musl libc");
+        return PLTHOOK_NOT_IMPLEMENTED;
+    }
+#else
     if (dlinfo(hndl, RTLD_DI_LINKMAP, &lmap) != 0) {
         set_errmsg("dlinfo error");
         return PLTHOOK_FILE_NOT_FOUND;
     }
+#endif
     return plthook_open_real(plthook_out, lmap);
 }
 
 int plthook_open_by_address(plthook_t **plthook_out, void *address)
 {
 #if defined __FreeBSD__
+    return PLTHOOK_NOT_IMPLEMENTED;
+#elif defined PLTHOOK_MUSL_LIBC
+    /* musl libc does not have dladdr1 or RTLD_DL_LINKMAP */
     return PLTHOOK_NOT_IMPLEMENTED;
 #else
     Dl_info info;
     struct link_map *lmap = NULL;
 
     *plthook_out = NULL;
     if (dladdr1(address, &info, (void**)&lmap, RTLD_DL_LINKMAP) == 0) {
         set_errmsg("dladdr error");
         return PLTHOOK_FILE_NOT_FOUND;
     }
     return plthook_open_real(plthook_out, lmap);
 #endif
 }
 
