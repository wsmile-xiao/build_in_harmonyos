+/* Like tmpfile(3), but create the file under $TMPDIR when set.
+   On some systems (e.g., HMDFS on HarmonyOS) /tmp is read-only, so
+   the C library tmpfile(3) fails unconditionally.  */
+static FILE *
+dir_tmpfile (void)
+{
+  char const *tmpdir = cgetenv ("TMPDIR");
+  char const *dir = tmpdir && *tmpdir ? tmpdir : "/tmp";
+  size_t dlen = strlen (dir);
+  char *pattern = malloc (dlen + 1 + sizeof ("rcsXXXXXX"));
+  int fd;
+  FILE *f;
+
+  if (!pattern)
+    return NULL;
+  memcpy (pattern, dir, dlen);
+  pattern[dlen] = '/';
+  memcpy (pattern + dlen + 1, "rcsXXXXXX", sizeof ("rcsXXXXXX"));
+  fd = mkstemp (pattern);
+  /* Give tmpfile(3) semantics: the file vanishes when closed.  */
+  unlink (pattern);
+  free (pattern);
+  if (fd < 0)
+    return NULL;
+  f = fdopen (fd, "w+b");
+  if (!f)
+    close (fd);
+  return f;
+}
