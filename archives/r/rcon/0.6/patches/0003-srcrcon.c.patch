+ * result unbiased; arc4random() itself is provided by musl >= 1.2.4. */
+#ifndef HAVE_ARC4RANDOM_UNIFORM
+static int32_t rcon_arc4random_uniform(int32_t limit)
+{
+    uint32_t threshold = (uint32_t)(-(uint32_t)limit % (uint32_t)limit);
+    uint32_t value;
+    do {
+        value = arc4random();
+    } while (value < threshold);
+    return (int32_t)(value % (uint32_t)limit);
+}
+#endif
