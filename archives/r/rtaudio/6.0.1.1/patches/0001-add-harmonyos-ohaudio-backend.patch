+/*
+  RtAudio OHAudio backend.
+
+  This backend uses HarmonyOS' routed OHAudio renderer and capturer. OHAudio
+  chooses devices through system routing, so RtAudio exposes the currently
+  preferred route and rejects attempts to open a different device ID.
+*/
+
+#ifndef RTAUDIO_OHAUDIO_H
+#define RTAUDIO_OHAUDIO_H
+
+#if defined(RTAUDIO_OHAUDIO_ENABLED)
+
+#include "RtAudio.h"
+#include <ohaudio/native_audiocapturer.h>
+#include <ohaudio/native_audiorenderer.h>
+#include <ohaudio/native_audiostreambuilder.h>
+
+class RtApiOHOS : public RtApi
+{
+public:
+  RtApiOHOS();
+  ~RtApiOHOS() override;
+  RtAudio::Api getCurrentApi() override { return RtAudio::OHOS_OHAUDIO; }
+  void closeStream() override;
+  RtAudioErrorType startStream() override;
+  RtAudioErrorType stopStream() override;
+  RtAudioErrorType abortStream() override;
+
+private:
+  struct OHAudioHandle;
+
+  void probeDevices() override;
+  bool probeDeviceOpen(unsigned int deviceId, StreamMode mode, unsigned int channels,
+                       unsigned int firstChannel, unsigned int sampleRate,
+                       RtAudioFormat format, unsigned int *bufferSize,
+                       RtAudio::StreamOptions *options) override;
+  static OH_AudioData_Callback_Result rendererWrite(OH_AudioRenderer *renderer,
+                                                     void *userData,
+                                                     void *audioData,
+                                                     int32_t audioDataSize);
+  static void capturerRead(OH_AudioCapturer *capturer, void *userData,
+                           void *audioData, int32_t audioDataSize);
+  static void stopRequestLoop(RtApiOHOS *api);
+  void requestStop();
+  void stopHardware(OHAudioHandle *handle);
+};
+
+#endif
+#endif
