+
+struct RtApiOHOS::OHAudioHandle {
+  OH_AudioStreamBuilder *rendererBuilder;
+  OH_AudioStreamBuilder *capturerBuilder;
+  OH_AudioRenderer *renderer;
+  OH_AudioCapturer *capturer;
+  char *outputBuffer;
+  char *inputBuffer;
+  char *pendingInput;
+  size_t outputBytes;
+  size_t inputBytes;
+  bool rendererStarted;
+  bool capturerStarted;
+  std::atomic<bool> running;
+  bool inputAvailable;
+  bool inputOverflow;
+  std::atomic<bool> stopRequested;
+  std::mutex inputMutex;
+  std::mutex controlMutex;
+  std::mutex stopMutex;
+  std::condition_variable stopCondition;
+  bool shuttingDown;
+  std::thread stopThread;
+
+  OHAudioHandle()
+    : rendererBuilder(0), capturerBuilder(0), renderer(0), capturer(0),
+      outputBuffer(0), inputBuffer(0), pendingInput(0), outputBytes(0),
+      inputBytes(0), rendererStarted(false), capturerStarted(false),
+      running(false), inputAvailable(false), inputOverflow(false), stopRequested(false),
+      shuttingDown(false) {}
+};
+
+namespace {
+
+bool queryPreferredDevice(OH_AudioRoutingManager *manager, bool output,
+                          uint32_t &deviceId)
+{
+  OH_AudioDeviceDescriptorArray *devices = 0;
+  OH_AudioCommon_Result result;
+  if (output) {
+    result = OH_AudioRoutingManager_GetPreferredOutputDevice(
+      manager, AUDIOSTREAM_USAGE_MUSIC, &devices);
+  } else {
+    result = OH_AudioRoutingManager_GetPreferredInputDevice(
+      manager, AUDIOSTREAM_SOURCE_TYPE_MIC, &devices);
+  }
+  if (result != AUDIOCOMMON_RESULT_SUCCESS || !devices || devices->size == 0) {
+    if (devices) OH_AudioRoutingManager_ReleaseDevices(manager, devices);
+    return false;
+  }
+  const bool ok = OH_AudioDeviceDescriptor_GetDeviceId(
+    devices->descriptors[0], &deviceId) == AUDIOCOMMON_RESULT_SUCCESS;
+  OH_AudioRoutingManager_ReleaseDevices(manager, devices);
+  return ok;
+}
+
+unsigned int maximumChannelCount(OH_AudioDeviceDescriptor *descriptor)
+{
+  uint32_t *counts = 0;
+  uint32_t count = 0;
+  unsigned int maximum = 0;
+  if (OH_AudioDeviceDescriptor_GetDeviceChannelCounts(
+        descriptor, &counts, &count) == AUDIOCOMMON_RESULT_SUCCESS) {
+    for (uint32_t i = 0; i < count; ++i)
+      maximum = std::max(maximum, static_cast<unsigned int>(counts[i]));
+  }
+  return maximum;
+}
+
+} // namespace
+
+RtApiOHOS::RtApiOHOS() {}
+
+RtApiOHOS::~RtApiOHOS()
+{
+  closeStream();
+}
