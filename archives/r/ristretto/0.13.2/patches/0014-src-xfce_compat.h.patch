diff -ruN /dev/null b/src/xfce_compat.h
--- /dev/null
+++ b/src/xfce_compat.h
@@ -0,0 +1,99 @@
+/*
+ * xfce_compat.h — Compatibility stubs for XFCE libraries on HarmonyOS NEXT
+ *
+ * Provides type definitions, macros, and function declarations for
+ * libxfce4ui, libxfce4util, xfconf, and exo when these libraries
+ * are not available on the target platform.
+ */
+
+#ifndef XFCE_COMPAT_H
+#define XFCE_COMPAT_H
+
+#include <gtk/gtk.h>
+#include <glib.h>
+#include <glib-object.h>
+#include <gdk/gdk.h>
+
+/* Version check macros — our stubs report version 4.18.0, so always return TRUE */
+#define LIBXFCE4UTIL_CHECK_VERSION(major, minor, micro) \
+    ((major) <= 4 && ((major) < 4 || (minor) <= 18 && ((minor) < 18 || (micro) <= 0)))
+
+/* gettext _() macro fallback — when ENABLE_NLS is not defined */
+#ifndef ENABLE_NLS
+#ifndef _
+#define _(String) ((const gchar *)(String))
+#endif
+#ifndef N_
+#define N_(String) ((const gchar *)(String))
+#endif
+#endif
+
+/* ====== libxfce4util stubs ====== */
+typedef enum
+{
+    XFCE_RESOURCE_CONFIG,
+    XFCE_RESOURCE_DATA,
+    XFCE_RESOURCE_CACHE,
+    XFCE_RESOURCE_DOCUMENTS,
+    XFCE_RESOURCE_ICONS,
+    XFCE_RESOURCE_PIXMAPS,
+    XFCE_RESOURCE_SOUNDS,
+    XFCE_RESOURCE_THUMBNAILS,
+    XFCE_RESOURCE_COUNT
+} XfceResourceType;
+
+gchar *xfce_resource_lookup (XfceResourceType type, const gchar *relpath);
+gchar *xfce_resource_save_location (XfceResourceType type, const gchar *relpath, gboolean create);
+gchar *xfce_create_shared_thumbnail_path (const gchar *uri, const gchar *flavor_name);
+
+typedef struct _XfceRC XfceRC;
+typedef XfceRC XfceRc;  /* XFCE uses XfceRc, our internal type is XfceRC */
+XfceRC *xfce_rc_simple_open (const gchar *filename, gboolean readonly);
+XfceRC *xfce_rc_config_open (XfceResourceType type, const gchar *relpath, gboolean readonly);
+void    xfce_rc_close (XfceRC *rc);
+void    xfce_rc_set_group (XfceRC *rc, const gchar *group);
+gchar  *xfce_rc_read_entry (XfceRC *rc, const gchar *key, const gchar *fallback);
+void    xfce_rc_write_entry (XfceRC *rc, const gchar *key, const gchar *value);
+void    xfce_rc_flush (XfceRC *rc);
+gchar **xfce_rc_get_entries (XfceRC *rc, const gchar *group);
+
+/* ====== libxfce4ui stubs ====== */
+typedef enum
+{
+    XFCE_LICENSE_TEXT_GPL,
+    XFCE_LICENSE_TEXT_LGPL,
+    XFCE_LICENSE_TEXT_BSD
+} XfceLicenseTextType;
+
+void    xfce_textdomain (const gchar *package, const gchar *dir, const gchar *encoding);
+GtkWidget *xfce_gtk_button_new_mixed (const gchar *icon_name, const gchar *label);
+GtkWidget *xfce_gtk_frame_box_new_with_content (const gchar *label, GtkWidget *content);
+void  xfce_dialog_show_help (GtkWindow *parent, const gchar *component,
+                              const gchar *page, const gchar *item);
+gchar *xfce_get_license_text (XfceLicenseTextType license_type);
+
+/* ====== xfconf stubs ====== */
+typedef struct _XfconfChannel XfconfChannel;
+
+gboolean  xfconf_init (GError **error);
+void      xfconf_shutdown (void);
+XfconfChannel *xfconf_channel_new (const gchar *channel_name);
+void xfconf_g_property_bind (XfconfChannel *channel, const gchar *property,
+                              GType property_type, gpointer object,
+                              const gchar *object_property);
+void xfconf_g_property_bind_gdkrgba (XfconfChannel *channel,
+                                      const gchar *property,
+                                      gpointer object,
+                                      const gchar *object_property);
+gboolean xfconf_channel_get_bool (XfconfChannel *channel, const gchar *property, gboolean default_value);
+gchar   *xfconf_channel_get_string (XfconfChannel *channel, const gchar *property, const gchar *default_value);
+gint     xfconf_channel_get_int (XfconfChannel *channel, const gchar *property, gint default_value);
+void xfconf_channel_set_bool (XfconfChannel *channel, const gchar *property, gboolean value);
+void xfconf_channel_set_string (XfconfChannel *channel, const gchar *property, const gchar *value);
+void xfconf_channel_set_int (XfconfChannel *channel, const gchar *property, gint value);
+gboolean xfconf_channel_has_property (XfconfChannel *channel, const gchar *property);
+gchar  **xfconf_channel_get_properties (XfconfChannel *channel, const gchar *property_prefix);
+gboolean xfconf_channel_get_array (XfconfChannel *channel, const gchar *property, ...);
+void     xfconf_channel_set_array (XfconfChannel *channel, const gchar *property, ...);
+
+#endif /* XFCE_COMPAT_H */