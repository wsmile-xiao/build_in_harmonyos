diff -ruN /dev/null b/src/xfce_compat.c
--- /dev/null
+++ b/src/xfce_compat.c
@@ -0,0 +1,176 @@
+/*
+ * xfce_compat.c — Compatibility stub implementations for XFCE libraries
+ */
+
+#include "xfce_compat.h"
+#include <libintl.h>
+#include <glib/gstdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+/* ====== libxfce4util ====== */
+static gchar *
+_xfce_resource_dir (XfceResourceType type)
+{
+    const gchar *base = NULL;
+    switch (type) {
+        case XFCE_RESOURCE_CONFIG: base = g_get_user_config_dir (); break;
+        case XFCE_RESOURCE_DATA: base = g_get_user_data_dir (); break;
+        case XFCE_RESOURCE_CACHE: base = g_get_user_cache_dir (); break;
+        case XFCE_RESOURCE_DOCUMENTS: base = g_get_user_special_dir (G_USER_DIRECTORY_DOCUMENTS); break;
+        case XFCE_RESOURCE_ICONS: case XFCE_RESOURCE_PIXMAPS: base = g_get_user_data_dir (); break;
+        case XFCE_RESOURCE_THUMBNAILS: base = g_get_user_cache_dir (); break;
+        default: base = g_get_home_dir (); break;
+    }
+    if (base == NULL) base = g_get_home_dir ();
+    return g_strdup (base);
+}
+
+gchar *
+xfce_resource_lookup (XfceResourceType type, const gchar *relpath)
+{
+    gchar *dir = _xfce_resource_dir (type);
+    gchar *full = g_build_filename (dir, relpath, NULL);
+    g_free (dir);
+    if (g_file_test (full, G_FILE_TEST_EXISTS)) return full;
+    g_free (full);
+    return NULL;
+}
+
+gchar *
+xfce_resource_save_location (XfceResourceType type, const gchar *relpath, gboolean create)
+{
+    gchar *dir = _xfce_resource_dir (type);
+    gchar *full = g_build_filename (dir, relpath, NULL);
+    g_free (dir);
+    if (create) {
+        gchar *parent = g_path_get_dirname (full);
+        g_mkdir_with_parents (parent, 0755);
+        g_free (parent);
+    }
+    return full;
+}
+
+gchar *
+xfce_create_shared_thumbnail_path (const gchar *uri, const gchar *flavor_name)
+{
+    const gchar *cache = g_get_user_cache_dir ();
+    gchar *thumb_dir = g_build_filename (cache, "thumbnails", flavor_name, NULL);
+    g_mkdir_with_parents (thumb_dir, 0755);
+    gchar *md5_hex = g_compute_checksum_for_string (G_CHECKSUM_MD5, uri, -1);
+    gchar *path = g_build_filename (thumb_dir, md5_hex, ".png", NULL);
+    g_free (md5_hex);
+    g_free (thumb_dir);
+    return path;
+}
+
+/* ====== XfceRC via GKeyFile ====== */
+struct _XfceRC { GKeyFile *kf; gchar *filename; gchar *group; gboolean readonly; };
+
+XfceRC *
+xfce_rc_simple_open (const gchar *filename, gboolean readonly)
+{
+    XfceRC *rc = g_new0 (XfceRC, 1);
+    rc->kf = g_key_file_new ();
+    rc->filename = g_strdup (filename);
+    rc->readonly = readonly;
+    rc->group = g_strdup ("General");
+    if (g_file_test (filename, G_FILE_TEST_EXISTS))
+        g_key_file_load_from_file (rc->kf, filename, G_KEY_FILE_NONE, NULL);
+    return rc;
+}
+
+XfceRC *
+xfce_rc_config_open (XfceResourceType type, const gchar *relpath, gboolean readonly)
+{
+    gchar *dir = _xfce_resource_dir (type);
+    gchar *full = g_build_filename (dir, relpath, NULL);
+    g_free (dir);
+    XfceRC *rc = xfce_rc_simple_open (full, readonly);
+    g_free (full);
+    if (rc) {
+        gchar *dir2 = _xfce_resource_dir (type);
+        gchar *full2 = g_build_filename (dir2, relpath, NULL);
+        g_free (dir2);
+        g_free (rc->filename);
+        rc->filename = full2;
+    }
+    return rc;
+}
+
+void xfce_rc_close (XfceRC *rc) { if (!rc) return; if (!rc->readonly) xfce_rc_flush(rc); g_key_file_free(rc->kf); g_free(rc->filename); g_free(rc->group); g_free(rc); }
+void xfce_rc_set_group (XfceRC *rc, const gchar *group) { if (!rc) return; g_free(rc->group); rc->group = g_strdup(group); }
+gchar *xfce_rc_read_entry (XfceRC *rc, const gchar *key, const gchar *fallback) { if (!rc) return g_strdup(fallback); gchar *v = g_key_file_get_string(rc->kf, rc->group, key, NULL); return v ? v : g_strdup(fallback); }
+void xfce_rc_write_entry (XfceRC *rc, const gchar *key, const gchar *value) { if (!rc || rc->readonly) return; g_key_file_set_string(rc->kf, rc->group, key, value); }
+void xfce_rc_flush (XfceRC *rc) { if (!rc || rc->readonly || !rc->filename) return; gchar *p = g_path_get_dirname(rc->filename); g_mkdir_with_parents(p, 0755); g_free(p); g_key_file_save_to_file(rc->kf, rc->filename, NULL); }
+gchar **xfce_rc_get_entries (XfceRC *rc, const gchar *group) { if (!rc) return NULL; return g_key_file_get_keys(rc->kf, group, NULL, NULL); }
+
+/* ====== libxfce4ui ====== */
+void xfce_textdomain (const gchar *package, const gchar *dir, const gchar *encoding) { bindtextdomain(package, dir); if (encoding) bind_textdomain_codeset(package, encoding); }
+
+GtkWidget *
+xfce_gtk_button_new_mixed (const gchar *icon_name, const gchar *label)
+{
+    GtkWidget *button;
+    if (icon_name && !g_str_has_prefix(icon_name, "gtk-")) {
+        button = gtk_button_new ();
+        GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 4);
+        GtkWidget *image = gtk_image_new_from_icon_name (icon_name, GTK_ICON_SIZE_BUTTON);
+        GtkWidget *lbl = gtk_label_new_with_mnemonic (label);
+        gtk_box_pack_start (GTK_BOX (box), image, FALSE, FALSE, 0);
+        gtk_box_pack_start (GTK_BOX (box), lbl, FALSE, FALSE, 0);
+        gtk_container_add (GTK_CONTAINER (button), box);
+        gtk_widget_show_all (box);
+    } else {
+        button = gtk_button_new_with_mnemonic (label);
+    }
+    return button;
+}
+
+GtkWidget *
+xfce_gtk_frame_box_new_with_content (const gchar *label, GtkWidget *content)
+{
+    GtkWidget *frame = gtk_frame_new (label);
+    gtk_container_add (GTK_CONTAINER (frame), content);
+    gtk_frame_set_shadow_type (GTK_FRAME (frame), GTK_SHADOW_NONE);
+    gtk_widget_set_margin_top (content, 6);
+    gtk_widget_set_margin_bottom (content, 6);
+    gtk_widget_set_margin_start (content, 12);
+    gtk_widget_set_margin_end (content, 12);
+    return frame;
+}
+
+void
+xfce_dialog_show_help (GtkWindow *parent, const gchar *component, const gchar *page, const gchar *item)
+{
+    GtkWidget *dialog = gtk_message_dialog_new (parent, GTK_DIALOG_DESTROY_WITH_PARENT,
+        GTK_MESSAGE_INFO, GTK_BUTTONS_CLOSE,
+        "Help not available. Component: %s", component ? component : "(unknown)");
+    gtk_dialog_run (GTK_DIALOG (dialog));
+    gtk_widget_destroy (dialog);
+}
+
+gchar *
+xfce_get_license_text (XfceLicenseTextType license_type)
+{
+    const gchar *text = "This program is free software; you can redistribute it and/or "
+        "modify it under the terms of the GNU General Public License.";
+    return g_strdup (text);
+}
+
+/* ====== xfconf stubs ====== */
+gboolean xfconf_init (GError **error) { if (error) *error = g_error_new_literal(g_quark_from_static_string("xfconf"), 1, "Xfconf not available"); return FALSE; }
+void xfconf_shutdown (void) { }
+XfconfChannel *xfconf_channel_new (const gchar *channel_name) { return NULL; }
+void xfconf_g_property_bind (XfconfChannel *channel, const gchar *property, GType property_type, gpointer object, const gchar *object_property) { }
+void xfconf_g_property_bind_gdkrgba (XfconfChannel *channel, const gchar *property, gpointer object, const gchar *object_property) { }
+gboolean xfconf_channel_get_bool (XfconfChannel *channel, const gchar *property, gboolean default_value) { return default_value; }
+gchar *xfconf_channel_get_string (XfconfChannel *channel, const gchar *property, const gchar *default_value) { return g_strdup(default_value); }
+gint xfconf_channel_get_int (XfconfChannel *channel, const gchar *property, gint default_value) { return default_value; }
+void xfconf_channel_set_bool (XfconfChannel *channel, const gchar *property, gboolean value) { }
+void xfconf_channel_set_string (XfconfChannel *channel, const gchar *property, const gchar *value) { }
+void xfconf_channel_set_int (XfconfChannel *channel, const gchar *property, gint value) { }
+gboolean xfconf_channel_has_property (XfconfChannel *channel, const gchar *property) { return FALSE; }
+gchar **xfconf_channel_get_properties (XfconfChannel *channel, const gchar *property_prefix) { return NULL; }
+gboolean xfconf_channel_get_array (XfconfChannel *channel, const gchar *property, ...) { return FALSE; }
+void xfconf_channel_set_array (XfconfChannel *channel, const gchar *property, ...) { }