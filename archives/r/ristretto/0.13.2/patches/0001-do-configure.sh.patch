diff -ruN /dev/null b/do-configure.sh
--- /dev/null
+++ b/do-configure.sh
@@ -0,0 +1,30 @@
+#!/bin/bash
+# Wrapper for configure that fixes config.status permissions issue
+# on HarmonyOS HMDFS filesystem where setgid causes permission problems
+# with config.status temp directories
+
+SRCDIR="$(cd "$(dirname "$0")" && pwd)"
+export PKG_CONFIG_PATH="$HOME/usr/local/lib/pkgconfig:$HOME/usr/local/share/pkgconfig"
+export CC=clang
+export CXX=clang++
+
+# Run configure
+cd "$SRCDIR"
+./configure --prefix="$HOME/usr/local" "$@" 2>&1 || {
+    # If configure fails with the permission issue in config.status,
+    # fix config.status and rerun it
+    if [ -f config.status ]; then
+        echo "*** Fixing config.status permission issue ***"
+        # Change umask from 077 to 022 so temp dirs are writable
+        sed -i 's/umask 077 && mktemp -d/umask 022 \&\& mktemp -d/' config.status
+        sed -i 's/(umask 077 \&\& mkdir/(umask 022 \&\& mkdir/' config.status
+        # Remove the old temp directories if they exist
+        for d in $(ls -d conf* 2>/dev/null | grep -v config); do
+            rmdir "$d" 2>/dev/null
+        done
+        echo "*** Rerunning config.status ***"
+        ./config.status 2>&1
+    fi
+}
+
+echo "*** Configure wrapper done ***"