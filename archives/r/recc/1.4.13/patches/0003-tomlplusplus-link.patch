@@ -16,6 +16,19 @@
     ${SRCS}
     ${PROTO_GENERATED_SRCS})
 
+# libgrpc.a references zlib symbols (message_compress); propagate ZLIB to
+# every consumer of common (tests link common and need inflate/deflate).
+find_package(ZLIB QUIET)
+if(TARGET ZLIB::ZLIB)
+  set(ZLIB_LINK_TARGET ZLIB::ZLIB)
+elseif(TARGET zlib::zlib)
+  # OHOS adaptation: registry zlib exports zlib::zlib target
+  set(ZLIB_LINK_TARGET zlib::zlib)
+else()
+  find_package(ZLIB REQUIRED)
+  set(ZLIB_LINK_TARGET ZLIB::ZLIB)
+endif()
+
 target_precompile_headers(common PRIVATE buildboxcommon_deps.h)
 
 target_link_libraries(common
