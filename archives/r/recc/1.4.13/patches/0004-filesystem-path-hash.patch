+// OHOS libc++ (libcxx-ohos) does not provide std::hash<std::filesystem::path>,
+// which this header uses as unordered_map key. Instead of specializing
+// std::hash (which would require a platform macro and is UB for a std type),
+// provide a plain hash functor and pass it explicitly as the container's
+// hash template argument. It is kept local to this header so it covers every
+// translation unit that includes merklize, independent of PCH.
+#include <functional>
+
 namespace buildboxcommon {
+struct PathHash {
+    size_t operator()(const std::filesystem::path &p) const noexcept
+    {
+        return std::hash<std::string>{}(p.string());
+    }
+};
