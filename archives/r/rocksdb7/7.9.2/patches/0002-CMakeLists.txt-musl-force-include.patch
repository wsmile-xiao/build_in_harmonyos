--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -524,6 +524,34 @@
 if(NOT WIN32)
   add_definitions(-DROCKSDB_PLATFORM_POSIX -DROCKSDB_LIB_IO_POSIX)
 endif()
 
+# OpenHarmony: exclude musl libc headers from ~/usr/local/include that conflict
+# with OHOS SDK sysroot. Dependencies (zlib, snappy, etc.) are installed in
+# ~/usr/local, so find_package adds ~/usr/local/include as -isystem.
+# That directory also contains musl headers (pthread.h, stdlib.h, etc.)
+# which override the OHOS SDK sysroot versions and cause compilation errors.
+# Fix: force-include the sysroot's versions of the specific headers that cause
+# compilation errors. Both musl and sysroot share the same include guards,
+# so the musl versions will be skipped when encountered later.
+if(CMAKE_SYSTEM_NAME MATCHES "HarmonyOS")
+  get_filename_component(_clang_real "${CMAKE_CXX_COMPILER}" REALPATH)
+  get_filename_component(_clang_dir "${_clang_real}" DIRECTORY)
+  get_filename_component(_ohos_sysroot "${_clang_dir}/../../sysroot" ABSOLUTE)
+  if(EXISTS "${_ohos_sysroot}/usr/include/pthread.h")
+    set(_ohos_conflict_headers pthread.h stdlib.h)
+    set(_ohos_force_include "${CMAKE_BINARY_DIR}/ohos_sysroot_force_include.h")
+    file(WRITE "${_ohos_force_include}" "// Auto-generated: force-include OHOS sysroot headers\n")
+    file(APPEND "${_ohos_force_include}" "#ifndef __bitwise\n#define __bitwise\n#endif\n")
+    foreach(_hdr ${_ohos_conflict_headers})
+      if(EXISTS "${_ohos_sysroot}/usr/include/${_hdr}"
+         AND EXISTS "$ENV{HOME}/usr/local/include/${_hdr}")
+        file(APPEND "${_ohos_force_include}" "#include \"${_ohos_sysroot}/usr/include/${_hdr}\"\n")
+      endif()
+    endforeach()
+    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -include ${_ohos_force_include}")
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -include ${_ohos_force_include}")
+  endif()
+endif()
+
 option(WITH_FALLOCATE "build with fallocate" ON)
 if(WITH_FALLOCATE)
