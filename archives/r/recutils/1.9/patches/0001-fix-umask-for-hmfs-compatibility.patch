#!/bin/sh
# 0001-fix-umask-for-hmfs-compatibility.patch
#
# recutils 1.9: Fix autoconf umask 077 for HMFS compatibility
#
# On HarmonyOS NEXT's HMFS filesystem, newly created directories inherit the
# owner UID from the parent directory regardless of the creating process's UID.
# When autoconf's generated configure script creates temporary directories with
# "umask 077 && mktemp -d", the result is a directory with permissions drwx------
# owned by the parent directory's owner, not the current user. This makes the
# temp directory inaccessible to the build process, causing "Permission denied".
#
# This patch changes umask 077 to umask 007 in the generated configure script.
# With umask 007, the created directories have permissions drwxrws---, allowing
# group access since our user belongs to the file_manager group.
#
# Apply: sed -i 's/umask 077/umask 007/g' configure

--- /dev/null
+++ b/configure.umask-fix
@@ -0,0 +1,5 @@
+# This is a sed-based patch applied after configure is generated.
+# Apply with: sed -i 's/umask 077/umask 007/g' configure
+# This changes "umask 077" to "umask 007" to allow group access
+# to autoconf's temporary directories on HMFS.
