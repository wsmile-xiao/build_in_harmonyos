 #define DICE_PROMPT "> "
 
+/* readline replacement using getline — OHOS portability (no libreadline dependency) */
+static char *readline(const char *prompt) {
+    if (prompt && *prompt) {
+        fprintf(stderr, "%s", prompt);
+        fflush(stderr);
+    }
+    char *line = NULL;
+    size_t len = 0;
+    ssize_t n = getline(&line, &len, stdin);
+    if (n < 0) {
+        free(line);
+        return NULL;
+    }
+    if (n > 0 && line[n-1] == '\n')
+        line[n-1] = '\0';
+    return line;
+}
