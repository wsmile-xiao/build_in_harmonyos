diff --git a/db/db_test.cc b/db/db_test.cc
index c59951d..4faa65c 100644
--- a/db/db_test.cc
+++ b/db/db_test.cc
@@ -2711,6 +2711,28 @@ TEST_F(DBTest, PurgeInfoLogs) {
     // For mode (2), no info log file should have been put under DB dir.
     // Since dbname_ has no children, there is no need to loop db_files
     std::vector<std::string> db_files;
+    // OHOS: rmdir() may fail if another test sharing dbname_ left a
+    // subdirectory (e.g. db_log_dir) that DestroyDB does not remove. Recursively
+    // remove remaining children so this test is robust on OHOS.
+    std::function<void(const std::string&)> rmdir_children =
+        [&](const std::string& dir) {
+          std::vector<std::string> kids;
+          if (!env_->GetChildren(dir, &kids).ok()) return;
+          for (const std::string& k : kids) {
+            std::string p = dir + "/" + k;
+            std::vector<std::string> kk;
+            if (env_->GetChildren(p, &kk).ok()) {
+              rmdir_children(p);
+              env_->DeleteDir(p);
+            } else {
+              env_->DeleteFile(p);
+            }
+          }
+        };
+    if (!env_->GetChildren(dbname_, &db_files).IsNotFound()) {
+      rmdir_children(dbname_);
+      env_->DeleteDir(dbname_);
+    }
     ASSERT_TRUE(env_->GetChildren(dbname_, &db_files).IsNotFound());
     ASSERT_TRUE(db_files.empty());
 
