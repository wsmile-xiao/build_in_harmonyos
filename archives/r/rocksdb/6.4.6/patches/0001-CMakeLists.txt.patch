+# OpenHarmony: exclude musl libc headers from ~/usr/local/include that conflict
+# with OHOS SDK sysroot. Dependencies (zlib, bzip2, etc.) are installed in
+# ~/usr/local, so find_package adds ~/usr/local/include as -isystem.
+# That directory also contains musl headers (pthread.h, stdlib.h, etc.)
+# which override the OHOS SDK sysroot versions and cause compilation errors
+# (e.g. missing pthread_cond_clockwait, abs declaration conflicts).
+# Fix: force-include the sysroot's versions of the specific headers that cause
+# compilation errors. Both musl and sysroot share the same include guards,
+# so the musl versions will be skipped when encountered later.
+# NOTE: Only include headers that cause actual errors, not all conflicting
+# headers. Including complex headers like sys/types.h can break kernel header
+# include ordering (e.g. __bitwise in linux/fs.h).
+if(CMAKE_SYSTEM_NAME MATCHES "HarmonyOS")
+  # Derive OHOS SDK sysroot from compiler real path (clang is symlink to SDK)
+  get_filename_component(_clang_real "${CMAKE_CXX_COMPILER}" REALPATH)
+  get_filename_component(_clang_dir "${_clang_real}" DIRECTORY)
+  get_filename_component(_ohos_sysroot "${_clang_dir}/../../sysroot" ABSOLUTE)
+  if(EXISTS "${_ohos_sysroot}/usr/include/pthread.h")
+    # Headers known to cause compilation errors when musl version overrides sysroot:
+    # - pthread.h: missing pthread_cond_clockwait declaration (libcxx __mutex_base)
+    # - stdlib.h: abs() declaration conflict with libcxx cstdlib
+    set(_ohos_conflict_headers pthread.h stdlib.h)
+    # Define __bitwise as empty: musl's linux/types.h (found via -isystem
+    # ~/usr/local/include before sysroot) does NOT define __bitwise, but
+    # linux/fs.h uses it (typedef int __bitwise __kernel_rwf_t).
+    # Cannot -include sysroot's linux/types.h because it has a different
+    # include guard (_UAPI_LINUX_TYPES_H vs musl's _LINUX_TYPES_H), so both
+    # get included and __u64 typedef conflicts.
+    # Instead, just define __bitwise to empty (which is what the sysroot
+    # version does: #define __bitwise__ / #define __bitwise __bitwise__).
+    set(_ohos_force_include "${CMAKE_BINARY_DIR}/ohos_sysroot_force_include.h")
+    file(WRITE "${_ohos_force_include}" "// Auto-generated: force-include OHOS sysroot headers\n")
+    file(APPEND "${_ohos_force_include}" "#ifndef __bitwise\n#define __bitwise\n#endif\n")
+    # Fix libcxx bug: cmath uses __promote (C++17+ only, #if _LIBCPP_STD_VER > 14)
+    # but doesn't include <__type_traits/promote.h> where it's defined.
+    # In C++11 mode the code is skipped, but in C++17 it causes compilation error.
+    file(APPEND "${_ohos_force_include}" "#ifdef __cplusplus\n#include <__type_traits/promote.h>\n#endif\n")
+    foreach(_hdr ${_ohos_conflict_headers})
+      if(EXISTS "${_ohos_sysroot}/usr/include/${_hdr}"
+         AND EXISTS "$ENV{HOME}/usr/local/include/${_hdr}")
+        file(APPEND "${_ohos_force_include}" "#include \"${_ohos_sysroot}/usr/include/${_hdr}\"\n")
+      endif()
+    endforeach()
+    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -include ${_ohos_force_include}")
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -include ${_ohos_force_include}")
   endif()
