--- a/renv.awk
+++ b/renv.awk
@@ -1,13 +1,18 @@
-#!/usr/bin/awk -f
+#!/bin/sh
 # Set up remote environment for rset(1)
 # Print only lines that match the format [name="value" ...]
+#
+#toybox awk mis-parses script arguments like "-q" as awk options when run
+#via "#!/usr/bin/awk -f". Feed the program through /dev/fd/3 instead so
+#that all arguments are passed through to the script untouched.
+exec awk -f /dev/fd/3 -- "$@" 3<<'RSET_AWK_PROGRAM'
 
 # release: ${release}
 
 function err(s) {
 	print "renv: " s ": " $0 > "/dev/stderr"
 	exit 1
 }
 
 BEGIN {
 	for (i=1; i<ARGC; i++) {
@@ -44,10 +49,12 @@
 	gsub(/[ \t]+/, " ")
 	gsub(/\$\$/, "\\$")
 	sub(/ $/, "")
 
 	len=index($0, "=")
 	if (!quiet)
 		print substr($0, 0, len) "\"" substr($0, len+1) "\""
 	next
 }
 { err("unknown pattern") }
+RSET_AWK_PROGRAM
+
