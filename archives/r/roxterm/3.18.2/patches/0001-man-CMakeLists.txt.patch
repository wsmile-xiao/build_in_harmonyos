--- a/man/CMakeLists.txt
+++ b/man/CMakeLists.txt
@@ -1,12 +1,17 @@
 find_program(XSLTPROC xsltproc)
-if (NOT "${XSLTPROC}" EQUAL "XSLTPROC-NOTFOUND")
+# BUILD_MANPAGES: man pages are generated with xsltproc pulling
+# http://docbook.sourceforge.net/release/xsl/current/manpages/docbook.xsl
+# at build time, which is unavailable in offline/sandboxed build
+# environments; allow packagers to disable them without losing the binary.
+option(BUILD_MANPAGES "Generate man pages with xsltproc" ON)
+if (XSLTPROC AND BUILD_MANPAGES)
     set(XSLTPROC_OPTIONS --novalid --param man.charmap.use.subset 0
         http://docbook.sourceforge.net/release/xsl/current/manpages/docbook.xsl)
 
     set(ALL_MANPAGES)
     set(LANGS "." pt_BR)
     set(MAN_NAMES roxterm roxterm-config)
 
     foreach(LANG ${LANGS})
         set(MANPAGES_FOR_LANG)
         if(LANG STREQUAL ".")
@@ -32,12 +37,12 @@
                 WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
             list(APPEND MANPAGES_FOR_LANG "${MAN_OUT_ABS}")
         endforeach()
 
         install(FILES ${MANPAGES_FOR_LANG} DESTINATION "${INSTALL_DEST}")
         list(APPEND ALL_MANPAGES ${MANPAGES_FOR_LANG})
     endforeach()
 
     add_custom_target(manpages ALL DEPENDS ${ALL_MANPAGES})
 else ()
-    message(WARNING "xsltproc not found, man pages will not be generated")
+    message(WARNING "xsltproc not found or man pages disabled, man pages will not be generated")
 endif ()
