--- a/src/rtl_adsb.c
+++ b/src/rtl_adsb.c
@@ -493,7 +493,13 @@
 	else {
 		fprintf(stderr, "\nLibrary error %d, exiting...\n", r);}
 	rtlsdr_cancel_async(dev);
-	pthread_cancel(demod_thread);
+	/* HarmonyOS/OHOS (musl libc) has no pthread_cancel().  The demod thread
+	   already has its own exit condition (the do_exit flag used by the signal
