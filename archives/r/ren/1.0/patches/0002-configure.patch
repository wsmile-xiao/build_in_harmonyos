diff -ruN /dev/null b/configure
--- /dev/null
+++ b/configure
@@ -0,0 +1,30 @@
+#!/bin/sh
+# Minimal configure script for ren (Makefile project)
+# This script exists so that ohc-run.py clean-verify (G0) can work.
+# It doesn't do real configuration - ren uses a simple Makefile.
+
+PREFIX="/usr/local"
+
+for arg in "$@"; do
+    case "$arg" in
+        --prefix=*)
+            PREFIX="${arg#--prefix=}"
+            ;;
+        --help|--version)
+            echo "ren configure (wrapper for Makefile project)"
+            echo "Options: --prefix=DIR"
+            exit 0
+            ;;
+        *)
+            echo "Unknown option: $arg"
+            ;;
+    esac
+done
+
+# Generate Makefile.conf so the Makefile can include PREFIX
+cat > Makefile.conf << EOF
+PREFIX = ${PREFIX}
+EOF
+
+echo "Configuration complete: PREFIX=${PREFIX}"
+exit 0
