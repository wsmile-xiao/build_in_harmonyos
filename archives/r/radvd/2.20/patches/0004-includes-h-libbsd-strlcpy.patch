@@ -26,7 +26,12 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
-#ifndef __FreeBSD__
+/* strlcpy/strlcat 只有在 libc 不提供时才需要 libbsd 的 <bsd/string.h>。
+ * 目标平台 libc 已导出 strlcpy/strlcat（nm -D libc.so 见 "T strlcpy"，
+ * 且 sysroot 的 <string.h> 已声明），全盘也搜不到任何 bsd/string.h，
+ * 无条件包含会在第一个 .c 上就 fatal error。需要退回 libbsd 路径时
+ * 在 CPPFLAGS 里加 -DUSE_LIBBSD_STRLCPY 即可，其余行为不变。 */
+#if defined(USE_LIBBSD_STRLCPY) && !defined(__FreeBSD__)
 #include <bsd/string.h> // strlcpy
 #endif
 #include <syslog.h>
