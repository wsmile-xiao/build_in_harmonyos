--- /dev/null
+++ b/makefile
@@ -0,0 +1,129 @@
+#-----------------------------------------------------------------------------
+# RTKLIB top-level makefile
+#
+# Upstream ships one makefile per console application (app/consapp/*/gcc) and
+# one for the unit tests (test/utest), but nothing that builds the RTKLIB
+# library itself or all console tools at once.  This makefile adds that single
+# entry point: it compiles src/*.c once into build/lib/libRTK.a and links every
+# console application against it, then installs library + header + tools under
+# $(PREFIX).
+#
+# Every build product lives below build/ so that the build never writes into -
+# and "make clean" never deletes - an upstream source directory.  Upstream
+# already has lib/ (IERS/Fortran sources, Borland and OpenBLAS import
+# libraries) and bin/ (a readme) of its own.
+#
+# The GUI applications (app/qtapp, app/winapp) are intentionally not built:
+# they need Qt/Windows and are out of scope for a headless library package.
+#
+# Usage:
+#   make [-j N] [CC=...] [CFLAGS=...] [LDFLAGS=...] [LDLIBS=...]
+#   make install [DESTDIR=...] [PREFIX=...]
+#
+# Variables CC/AR/RANLIB/CFLAGS/CPPFLAGS/LDFLAGS/LDLIBS are only *defaulted*
+# here; a value given on the command line (as the Conan recipe does) wins.
+#-----------------------------------------------------------------------------
+
+PREFIX  ?= /usr/local
+DESTDIR ?=
+CC      ?= cc
+AR      ?= ar
+RANLIB  ?= ranlib
+
+SRCDIR   = src
+BUILDDIR = build
+OBJDIR   = $(BUILDDIR)/obj
+LIBDIR   = $(BUILDDIR)/lib
+BINDIR   = $(BUILDDIR)/bin
+
+CFLAGS   ?= -O2
+CPPFLAGS ?=
+LDFLAGS  ?=
+LDLIBS   ?= -lm -lrt -lpthread
+
+# Feature set used by the upstream console applications
+# (app/consapp/*/gcc/makefile, OPTS/CFLAGS): trace log, GLONASS, QZSS,
+# Galileo, BeiDou, IRNSS and 5 frequencies.
+RTKOPTS = -DTRACE -DENAGLO -DENAQZS -DENAGAL -DENACMP -DENAIRN -DNFREQ=5
+
+# Caller supplied flags first, RTKLIB's own options after them, so that a
+# recipe can pass CFLAGS/CPPFLAGS straight through without losing -Isrc.
+ALL_CPPFLAGS = $(CPPFLAGS) -I$(SRCDIR) $(RTKOPTS)
+ALL_CFLAGS   = $(CFLAGS)
+
+APPS  = convbin pos2kml rnx2rtkp str2str rtkrcv
+BINS  = $(addprefix $(BINDIR)/,$(APPS))
+APPOBJ = $(addprefix $(OBJDIR)/,$(addsuffix .o,$(APPS)))
+LIB   = $(LIBDIR)/libRTK.a
+# src/*.c holds the core library, src/rcv/*.c the receiver specific raw
+# decoders (upstream keeps them in a subdirectory; every console application
+# links both sets).
+RTKSRC = $(wildcard $(SRCDIR)/*.c) $(wildcard $(SRCDIR)/rcv/*.c)
+RTKOBJ = $(addprefix $(OBJDIR)/,$(addsuffix .o,$(notdir $(basename $(RTKSRC)))))
+
+vpath %.c $(SRCDIR) $(SRCDIR)/rcv
+
+all : $(LIB) $(BINS)
+
+# --- RTKLIB library ---------------------------------------------------------
+$(OBJDIR)/%.o : %.c
+	@mkdir -p $(OBJDIR)
+	$(CC) -c $(ALL_CPPFLAGS) $(ALL_CFLAGS) -o $@ $<
+
+$(LIB) : $(RTKOBJ)
+	@mkdir -p $(LIBDIR)
+	$(AR) rcs $@ $(RTKOBJ)
+	$(RANLIB) $@
+
+# --- console applications ---------------------------------------------------
+# One rule per application object: upstream keeps each application in its own
+# app/consapp/<name>/ directory, which a single pattern rule cannot express
+# (a make pattern prerequisite supports only one stem substitution).
+$(OBJDIR)/convbin.o  : app/consapp/convbin/convbin.c
+	@mkdir -p $(OBJDIR)
+	$(CC) -c $(ALL_CPPFLAGS) $(ALL_CFLAGS) -o $@ $<
+
+$(OBJDIR)/pos2kml.o  : app/consapp/pos2kml/pos2kml.c
+	@mkdir -p $(OBJDIR)
+	$(CC) -c $(ALL_CPPFLAGS) $(ALL_CFLAGS) -o $@ $<
+
+$(OBJDIR)/rnx2rtkp.o : app/consapp/rnx2rtkp/rnx2rtkp.c
+	@mkdir -p $(OBJDIR)
+	$(CC) -c $(ALL_CPPFLAGS) $(ALL_CFLAGS) -o $@ $<
+
+$(OBJDIR)/str2str.o  : app/consapp/str2str/str2str.c
+	@mkdir -p $(OBJDIR)
+	$(CC) -c $(ALL_CPPFLAGS) $(ALL_CFLAGS) -o $@ $<
+
+$(OBJDIR)/rtkrcv.o   : app/consapp/rtkrcv/rtkrcv.c
+	@mkdir -p $(OBJDIR)
+	$(CC) -c $(ALL_CPPFLAGS) $(ALL_CFLAGS) -o $@ $<
+
+$(OBJDIR)/vt.o       : app/consapp/rtkrcv/vt.c
+	@mkdir -p $(OBJDIR)
+	$(CC) -c $(ALL_CPPFLAGS) $(ALL_CFLAGS) -o $@ $<
+
+$(BINDIR)/% : $(OBJDIR)/%.o $(LIB)
+	@mkdir -p $(BINDIR)
+	$(CC) $(LDFLAGS) -o $@ $< $(LIB) $(LDLIBS)
+
+$(BINDIR)/rtkrcv : $(OBJDIR)/rtkrcv.o $(OBJDIR)/vt.o $(LIB)
+	@mkdir -p $(BINDIR)
+	$(CC) $(LDFLAGS) -o $@ $(OBJDIR)/rtkrcv.o $(OBJDIR)/vt.o $(LIB) $(LDLIBS)
+
+# --- install ----------------------------------------------------------------
+# Only the library, its header and the console tools are installed, matching
+# what the upstream app/consapp/makefile installs (the data/ directory holds
+# optional sample assets and is not installed by upstream either).
+install : all
+	mkdir -p $(DESTDIR)$(PREFIX)/bin
+	mkdir -p $(DESTDIR)$(PREFIX)/lib
+	mkdir -p $(DESTDIR)$(PREFIX)/include
+	cp -f $(BINS) $(DESTDIR)$(PREFIX)/bin/
+	cp -f $(LIB) $(DESTDIR)$(PREFIX)/lib/
+	cp -f $(SRCDIR)/rtklib.h $(DESTDIR)$(PREFIX)/include/
+
+clean :
+	rm -rf $(BUILDDIR)
+
+.PHONY : all install clean
