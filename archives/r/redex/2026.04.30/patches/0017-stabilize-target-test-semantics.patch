+enum class BoxedBooleanValue { False, True };
+
+static bool is_boxed_boolean_descriptor(const DexType* type) {
+  if (type == nullptr) {
+    return false;
+  }
+  const auto descriptor = type->str();
+  // Some target-created references omit the trailing object delimiter.
+  return descriptor == "Ljava/lang/Boolean;" ||
+         descriptor == "Ljava/lang/Boolean";
+}
+
+static boost::optional<BoxedBooleanValue> get_boxed_boolean_value(
+    const DexFieldRef* field) {
+  if (field == nullptr ||
+      !is_boxed_boolean_descriptor(field->get_class()) ||
+      !is_boxed_boolean_descriptor(field->get_type())) {
+    return boost::none;
+  }
+  if (field->get_name()->str() == "FALSE") {
+    return BoxedBooleanValue::False;
+  }
+  if (field->get_name()->str() == "TRUE") {
+    return BoxedBooleanValue::True;
+  }
+  return boost::none;
+}
+
+static const DexField* get_boxed_boolean_field(const DexFieldRef* raw_field) {
+  auto raw_value = get_boxed_boolean_value(raw_field);
+  if (!raw_value) {
+    return nullptr;
+  }
+  // Resolve through the current class scope first.  A cached concrete
+  // definition can belong to a previous RedexContext, so accepting it before
+  // resolution can swap TRUE/FALSE semantics across test contexts.
+  auto* resolved_field = resolve_field(raw_field);
+  if (resolved_field != nullptr) {
+    auto resolved_value = get_boxed_boolean_value(resolved_field);
+    if (!resolved_value || *resolved_value != *raw_value) {
+      return nullptr;
+    }
+    return resolved_field;
+  }
+  if (raw_field->is_def()) {
+    return dynamic_cast<const DexField*>(raw_field);
+  }
+  return nullptr;
+}
