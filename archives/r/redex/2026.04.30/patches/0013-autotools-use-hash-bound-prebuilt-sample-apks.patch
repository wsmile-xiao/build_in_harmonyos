+++ b/test/samples/strings/Makefile.am
@@ -17,1 +17,2 @@
 JAVA_PACKAGE = com/fb/strings
+PREBUILT_SAMPLE_APK_SHA256 = @PREBUILT_STRINGS_APK_SHA256@
