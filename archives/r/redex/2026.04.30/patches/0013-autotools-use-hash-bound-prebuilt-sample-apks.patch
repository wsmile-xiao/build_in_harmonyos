diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -125,6 +125,29 @@
         [AC_PATH_PROG([PROTOC], [protoc], [no])])
     ]
 )
+
+# Cross targets cannot execute the Android SDK's host aapt2 binary.  Allow a
+# frozen host-built sample APK to replace fixture generation without removing
+# the sample or any test that consumes it.
+AC_ARG_ENABLE([prebuilt-sample-apks],
+    [AS_HELP_STRING([--enable-prebuilt-sample-apks],
+        [Use SHA-256-bound prebuilt APKs for the sample test fixtures])],
+    [],
+    [enable_prebuilt_sample_apks=no]
+)
+AC_ARG_VAR([PREBUILT_STRINGS_APK_SHA256],
+    [SHA-256 of test/samples/strings/unsigned.apk])
+AC_ARG_VAR([PREBUILT_MORE_RESOURCES_APK_SHA256],
+    [SHA-256 of test/samples/more_resources/unsigned.apk])
+AS_IF([test "x$enable_prebuilt_sample_apks" = "xyes"], [
+    AS_IF([test -z "$PREBUILT_STRINGS_APK_SHA256"],
+        [AC_MSG_ERROR([PREBUILT_STRINGS_APK_SHA256 is required with --enable-prebuilt-sample-apks])])
+    AS_IF([test -z "$PREBUILT_MORE_RESOURCES_APK_SHA256"],
+        [AC_MSG_ERROR([PREBUILT_MORE_RESOURCES_APK_SHA256 is required with --enable-prebuilt-sample-apks])])
+])
+AM_CONDITIONAL([USE_PREBUILT_SAMPLE_APKS],
+    [test "x$enable_prebuilt_sample_apks" = "xyes"])
+
 # Look for dx & android.jar.
 AS_IF([test "x$NO_ANDROID_HOME" = "xno"],
     [],
diff --git a/test/samples/Makefile.inc b/test/samples/Makefile.inc
--- a/test/samples/Makefile.inc
+++ b/test/samples/Makefile.inc
@@ -1,1 +1,17 @@
+if USE_PREBUILT_SAMPLE_APKS
+
+define make_apk
+.PHONY: verify-prebuilt-sample-apk
+verify-prebuilt-sample-apk:
+	test -f unsigned.apk
+	test "$$$$(sha256sum unsigned.apk | sed 's/ .*//')" = "$$(PREBUILT_SAMPLE_APK_SHA256)"
+
+all-local: verify-prebuilt-sample-apk
+
+check-local: verify-prebuilt-sample-apk
+
+endef
+
+else
+
 define make_compiled_resource
@@ -56,1 +72,3 @@
 endef
+
+endif
diff --git a/test/samples/strings/Makefile.am b/test/samples/strings/Makefile.am
