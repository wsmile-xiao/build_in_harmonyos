--- a/configure	2024-04-02 18:07:35.000000000 +0800
+++ b/configure
@@ -32346,14 +32346,16 @@
   trap 'as_fn_exit 1' 1 2 13 15
 }
 # Create a (secure) tmp directory for tmp files.
+# E011 HMDFS fix: umask 077 creates tmp dirs the build process cannot write
+# to on HMDFS (UID mapping). umask 000 keeps the dir group-writable.
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 000 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
   tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
+  (umask 000 && mkdir "$tmp")
 } || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
 ac_tmp=$tmp
 
