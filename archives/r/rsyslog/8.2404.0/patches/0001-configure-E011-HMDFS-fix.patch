--- rsyslog-8.2404.0.orig/configure	2024-04-02 18:07:35.000000000 +0800
+++ rsyslog-8.2404.0.work/configure	2026-05-28 14:25:02.046386874 +0800
@@ -2071,7 +2071,7 @@
   --enable-pgsql-tests    enable PostgreSQL specific tests in testbench
                           [default=no]
   --enable-mail           Enable mail support [default=no]
-  --enable-fmhttp         Enable fmhttp [default=yes]
+  --enable-fmhttp         Enable fmhttp [default=no]
   --enable-imdiag         Enable imdiag [default=no]
   --enable-mmnormalize    Enable building mmnormalize support [default=no]
   --enable-mmjsonparse    Enable building mmjsonparse support [default=no]
@@ -23538,7 +23538,7 @@
            *) as_fn_error $? "bad value ${enableval} for --enable-fmhttp" "$LINENO" 5 ;;
          esac
 else
-  enable_fmhttp=yes
+  enable_fmhttp=no
 
 fi
 
@@ -32346,15 +32346,16 @@
   trap 'as_fn_exit 1' 1 2 13 15
 }
 # Create a (secure) tmp directory for tmp files.
+# E011 HMDFS fix: use $TMPDIR/build-tmp instead of ./confXXXXXX
 
 {
-  tmp=`(umask 077 && mktemp -d "./confXXXXXX") 2>/dev/null` &&
+  tmp=`(umask 000 && mktemp -d "$TMPDIR/build-tmp/confXXXXXX") 2>/dev/null` &&
   test -d "$tmp"
 }  ||
 {
-  tmp=./conf$$-$RANDOM
-  (umask 077 && mkdir "$tmp")
-} || as_fn_error $? "cannot create a temporary directory in ." "$LINENO" 5
+  tmp=$TMPDIR/build-tmp/rsyslog-conf$$-$RANDOM
+  (umask 000 && mkdir -p "$tmp")
+} || as_fn_error $? "cannot create a temporary directory in $TMPDIR/build-tmp" "$LINENO" 5
 ac_tmp=$tmp
 
 # Set up the scripts for CONFIG_FILES section.
