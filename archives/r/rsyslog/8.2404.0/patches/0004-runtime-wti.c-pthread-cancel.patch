--- a/runtime/wti.c	2023-03-21 23:22:17.000000000 +0800
+++ b/runtime/wti.c
@@ -190,6 +190,7 @@
 			fprintf(stderr, "rsyslog debug: %s: need to do hard cancellation\n",
