 TEST_CASE("variant - swap", "[variant]")
 {
     SECTION("self")
     {
-        variant a = 1;
+        rttr::variant a = 1;
         a.swap(a);
 
         CHECK(a.is_valid() == true);
     }
 
     SECTION("both valid")
     {
-        variant a = 12;
-        variant b = std::string("text");
+        rttr::variant a = 12;
+        rttr::variant b = std::string("text");
         a.swap(b);
 
         CHECK(a.is_type<std::string>() == true);
         CHECK(b.is_type<int>() == true);
     }
 
     SECTION("left valid")
     {
-        variant a = 12;
-        variant b;
+        rttr::variant a = 12;
+        rttr::variant b;
         a.swap(b);
 
         CHECK(a.is_valid() == false);
         CHECK(b.is_type<int>() == true);
     }
 
     SECTION("right valid")
     {
-        variant a;
-        variant b = 12;
+        rttr::variant a;
+        rttr::variant b = 12;
         a.swap(b);
 
         CHECK(a.is_type<int>() == true);
         CHECK(b.is_valid() == false);
     }
 
     SECTION("both invalid")
     {
-        variant a, b;
+        rttr::variant a, b;
         a.swap(b);
 
         CHECK(a.is_valid() == false);
         CHECK(b.is_valid() == false);
     }
 }
 
