diff --git a/randomio.c b/randomio.c
index 590c889..162017b 100644
--- a/randomio.c
+++ b/randomio.c
@@ -208,6 +208,19 @@ usage:
 
 	// open the file and save its size
 	globals.fd = open(filename, OPEN_FLAGS | (globals.write_fraction > 0.f ? O_RDWR : O_RDONLY));
+#ifdef O_DIRECT
+	if (globals.fd == -1 && errno == EINVAL) {
+		// portability fallback (mirrors the __APPLE__ OPEN_FLAGS=0 branch):
+		// some filesystems (e.g. HMDFS on HarmonyOS) reject O_DIRECT when
+		// opening an existing file, even though they accept it at create
+		// time.  retry with buffered I/O so the benchmark still runs;
+		// latencies then include the page cache and are not directly
+		// comparable to true direct-I/O runs.
+		fprintf(stderr, "warning: O_DIRECT unsupported on %s, falling back to buffered I/O\n",
+			filename);
+		globals.fd = open(filename, globals.write_fraction > 0.f ? O_RDWR : O_RDONLY);
+	}
+#endif
 	if (globals.fd == -1) {
 		perror("open");
 		exit(1);
