--- builds/readline-8.3.orig/support/config.guess	2024-12-13 22:06:05.000000000 +0800
+++ builds/readline-8.3.work/support/config.guess	2026-06-05 16:23:04.473406719 +0800
@@ -277,6 +277,26 @@
 	UNAME_MACHINE_ARCH=`arch | sed 's/Bitrig.//'`
 	GUESS=$UNAME_MACHINE_ARCH-unknown-bitrig$UNAME_RELEASE
 	;;
+	*:HarmonyOS:*:*)
+		case "$UNAME_MACHINE" in
+			aarch64|arm64)
+			MACHINE=aarch64
+			;;
+			armv7*|armv8*)
+			MACHINE=arm
+			;;
+			x86_64|amd64)
+			MACHINE=x86_64
+			;;
+			i?86)
+			MACHINE=i686
+			;;
+			*)
+			MACHINE="$UNAME_MACHINE"
+			;;
+		esac
+		GUESS=${MACHINE}-unknown-linux-ohos
+	;;
     *:OpenBSD:*:*)
 	UNAME_MACHINE_ARCH=`arch | sed 's/OpenBSD.//'`
 	GUESS=$UNAME_MACHINE_ARCH-unknown-openbsd$UNAME_RELEASE
