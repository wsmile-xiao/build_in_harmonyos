diff -ruN a/RGF/CMakeLists.txt b/RGF/CMakeLists.txt
--- a/RGF/CMakeLists.txt
+++ b/RGF/CMakeLists.txt
@@ -1,5 +1,8 @@
 project(rgf)
-set(CMAKE_INSTALL_PREFIX ${CMAKE_CURRENT_SOURCE_DIR})
+# OHOS/Conan portability: do not hardcode the install prefix to the source
+# tree. The Conan CMakeToolchain injects CMAKE_INSTALL_PREFIX=<package_folder>;
+# a plain set() here would silently overwrite it and `cmake --install` would
+# scatter files into the recipe source cache instead of the package.
 set(EXECUTABLE_OUTPUT_PATH ${CMAKE_CURRENT_SOURCE_DIR}/bin)
 if(MINGW)
     set(CMAKE_EXE_LINKER_FLAGS ${CMAKE_EXE_LINKER_FLAGS} -static-libstdc++)
