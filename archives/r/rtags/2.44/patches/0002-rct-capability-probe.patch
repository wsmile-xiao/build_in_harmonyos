diff -ru a/src/rct/rct/Thread.cpp b/src/rct/rct/Thread.cpp
--- a/src/rct/rct/Thread.cpp	2026-10-03 13:07:19.586683594 +0800
+++ b/src/rct/rct/Thread.cpp	2026-10-03 13:07:19.882687969 +0800
@@ -16,7 +16,15 @@
 Thread::~Thread()
 {
     if (mRunning)
+#if defined(RCT_HAVE_PTHREAD_CANCEL)
         pthread_cancel(mThread);
+#else
+        // 平台无 pthread_cancel（如 OHOS musl 未导出该符号）时兜底同步
+        // pthread_join：等待线程自然退出后再继续析构，避免 detach 导致
+        // 线程继续访问已析构对象（UAF）。
+        pthread_join(mThread, nullptr);
+        mRunning = false;
+#endif
 }
 
 void *Thread::localStart(void *arg)
diff -ru a/src/rct/rct.cmake b/src/rct/rct.cmake
--- a/src/rct/rct.cmake	2026-10-03 13:07:19.370687656 +0800
+++ b/src/rct/rct.cmake	2026-10-03 13:07:19.886686563 +0800
@@ -189,6 +189,15 @@
 file(REMOVE "${RCT_INCLUDE_DIR}/rct/rct-config.h.gen")
 
 set(RCT_DEFINITIONS ${RCT_DEFINITIONS} -DOS_${CMAKE_SYSTEM_NAME})
+# 构建期能力探测：pthread_cancel 并非所有 libc 变体都实现/导出（如 OHOS musl），
+# 探测通过才启用 cancel 分支，否则 Thread 析构走 detach 兜底（见 rct/Thread.cpp）。
+include(CheckSymbolExists)
+set(CMAKE_REQUIRED_LIBRARIES pthread)
+check_symbol_exists(pthread_cancel "pthread.h" RCT_HAVE_PTHREAD_CANCEL)
+unset(CMAKE_REQUIRED_LIBRARIES)
+if (RCT_HAVE_PTHREAD_CANCEL)
+  set(RCT_DEFINITIONS ${RCT_DEFINITIONS} -DRCT_HAVE_PTHREAD_CANCEL)
+endif ()
 if (RCT_SERIALIZER_VERIFY_PRIMITIVE_SIZE)
   set(RCT_DEFINITIONS ${RCT_DEFINITIONS} -DRCT_SERIALIZER_VERIFY_PRIMITIVE_SIZE=1)
 endif ()
