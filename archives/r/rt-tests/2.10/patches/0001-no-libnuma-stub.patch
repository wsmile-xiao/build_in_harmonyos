+// SPDX-License-Identifier: GPL-2.0-or-later
+/* OpenHarmony: fallback when the archive has no libnuma. The upstream test
+ * programs call a handful of libnuma helpers directly; the CPU topology and
+ * CPU-list parsing are unavailable, so provide harmless single-node stubs. */
+#ifndef __RT_NUMA_NONUMA_H
+#define __RT_NUMA_NONUMA_H
+
+#include <sched.h>
+#include <stdlib.h>
+
+struct bitmask;
+
+static unsigned int numa_bitmask_weight(const struct bitmask *mask) { (void)mask; return 0; }
+static int numa_bitmask_isbitset(const struct bitmask *mask, unsigned long i) { (void)mask; (void)i; return 0; }
+static void numa_bitmask_free(struct bitmask *mask) { (void)mask; }
+static struct bitmask *numa_parse_cpustring_all(const char *s) { (void)s; return NULL; }
+static int numa_sched_setaffinity(pid_t pid, const struct bitmask *mask) { (void)pid; (void)mask; return 0; }
+
+#endif
