+// SPDX-License-Identifier: GPL-2.0-or-later
+/* OpenHarmony: fallback cyclictest NUMA helpers (no libnuma). */
+#ifndef __RT_NUMA_CYCLICTEST_NONUMA_H
+#define __RT_NUMA_CYCLICTEST_NONUMA_H
+
+#include "rt-utils.h"
+#include "rt-error.h"
+#include <bionic.h>
+
+#include <sched.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct bitmask;
+
+static int numa_initialize(void) { return 0; }
+static void *threadalloc(size_t size, int node) { (void)node; return malloc(size); }
+static void threadfree(void *ptr, size_t size, int node) { (void)size; (void)node; free(ptr); }
+static void rt_numa_set_numa_run_on_node(int node, int cpu) { (void)node; (void)cpu; }
+static void *rt_numa_numa_alloc_onnode(size_t size, int node, int cpu) { (void)node; (void)cpu; return malloc(size); }
+static int rt_numa_numa_node_of_cpu(int cpu) { (void)cpu; return -1; }
+static unsigned int rt_numa_bitmask_isbitset(const struct bitmask *mask, unsigned long i) { (void)mask; (void)i; return 0; }
+static struct bitmask *rt_numa_parse_cpustring(const char *s) { (void)s; return NULL; }
+static void rt_bitmask_free(struct bitmask *mask) { (void)mask; }
+
+#endif
