+// The Rio directory structures above are serialised to the player byte for
+// byte, so their layout must not change with the data model of the host
+// compiler.  These assertions catch the LP64 regression that the 32 bit
+// SIGNED32/UNSIGNED32 declarations used to cause on LP64 (64 bit) systems.
+#if defined(__cplusplus) && __cplusplus >= 201103L
+static_assert( sizeof(CDirHeader) == 512, "CDirHeader must be exactly 512 bytes" );
+static_assert( sizeof(CDirEntry) == 128, "CDirEntry must be exactly 128 bytes" );
+static_assert( sizeof(CEnd512ByteBlock) == 16, "CEnd512ByteBlock must be exactly 16 bytes" );
+#endif
