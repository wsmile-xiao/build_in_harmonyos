+// The on-the-wire integers of the Rio protocol are exactly 32 bits wide.
+// Using `long` here only worked on 32 bit data models (ILP32); on LP64
+// systems (aarch64) `long` is 64 bits wide and would corrupt both the
+// serialised directory structures and the block checksums.
+typedef int SIGNED32;
+typedef unsigned int UNSIGNED32;
 
