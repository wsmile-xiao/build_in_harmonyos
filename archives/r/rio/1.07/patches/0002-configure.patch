--- /dev/null
+++ b/configure
@@ -0,0 +1,28 @@
+#!/bin/sh
+#
+# configure — rio 1.07
+#
+# The upstream 1.07 release is a plain Makefile project and ships no
+# autotools configure script.  This wrapper implements the
+# ./configure --prefix=... interface so that the usual
+#
+#     ./configure --prefix=<dir> && make && make install
+#
+# sequence (used by the clean build verification and by packagers) works.
+# It only records the installation prefix in config.mk, which the makefile
+# includes.
+
+prefix=/usr/local
+
+for arg in "$@"; do
+	case "$arg" in
+		--prefix=*) prefix="${arg#--prefix=}" ;;
+	esac
+done
+
+cat > config.mk <<EOF
+PREFIX := $prefix
+EOF
+
+echo "configure: installing to prefix '$prefix' (recorded in config.mk)"
+exit 0
