 ###############################################################################
 
-all: 		rio
+# installation prefix, recorded by ./configure (see config.mk)
+-include config.mk
+
+CXX		?= g++
+CXXFLAGS	?= -O1
+LDFLAGS		?=
+PREFIX		?= /usr/local
+
+all:		rio
 
 rio:		app.cpp rio.cpp
-		g++ -O1 -o rio app.cpp rio.cpp
-		chmod +s rio
+		$(CXX) $(CXXFLAGS) -o rio app.cpp rio.cpp $(LDFLAGS)
+
+install:	rio
+		mkdir -p $(DESTDIR)$(PREFIX)/bin
+		cp rio $(DESTDIR)$(PREFIX)/bin/rio
 
 clean:
 		rm -f rio
 		rm -f *.o
+		rm -f config.mk
 
