+
 int output_checker(const std::string &path, const Model &model,
                    const std::pair<ValueType, ValueType> &value_types) {
 
-  std::ofstream out(path);
-  if (!out)
+  // /dev/stdout cannot necessarily be re-opened: it resolves through
+  // /proc/self/fd/1, which some sandboxes refuse with ENOENT, and the
+  // /dev/stdout path itself may be denied with EACCES when stdout is a
+  // pipe. The already-open standard output stream refers to exactly the
+  // same file descriptor, so fall back to it instead of failing.
+  std::ofstream file_out(path);
+
+  if (!file_out && path == "/dev/stdout")
+    return output_checker_body(std::cout, model, value_types);
+
+  if (!file_out)
     return -1;
+
+  return output_checker_body(file_out, model, value_types);
+}
+
+static int output_checker_body(std::ostream &out, const Model &model,
