--- a/infiniband-diags/ibdiag_common.c
+++ b/infiniband-diags/ibdiag_common.c
@@ -954,10 +954,37 @@
 
 op_fn_t *match_op(const match_rec_t match_tbl[], char *name)
 {
 	const match_rec_t *r;
 	for (r = match_tbl; r->name; r++)
 		if (!strcasecmp(r->name, name) ||
 		    (r->alias && !strcasecmp(r->alias, name)))
 			return r->fn;
 	return NULL;
 }
+
+/* getpass() is a GNU extension not provided by OHOS musl libc.
+ * Weak definition: glibc's strong symbol wins when available. */
+char *getpass(const char *prompt)
+{
+	static char buf[128];
+	FILE *in;
+	ssize_t n;
+
+	if (prompt) {
+		fputs(prompt, stderr);
+		fflush(stderr);
+	}
+	in = fopen("/dev/tty", "r");
+	if (!in)
+		in = stdin;
+	if (fgets(buf, sizeof(buf), in) == NULL) {
+		if (in != stdin)
+			fclose(in);
+		return NULL;
+	}
+	n = strcspn(buf, "\n");
+	buf[n] = '\0';
+	if (in != stdin)
+		fclose(in);
+	return buf;
+}
