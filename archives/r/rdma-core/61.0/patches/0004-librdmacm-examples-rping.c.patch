+
+/* OHOS musl libc does not implement pthread_cancel(3).  Per knowledge
+ * E513, preserve joinable-thread teardown with a reserved signal whose
+ * handler exits the worker, then join. */
+static void rping_thread_exit_handler(int sig)
+{
+	(void)sig;
+	pthread_exit(NULL);
+}
+
+static void rping_setup_thread_exit(void)
+{
+	struct sigaction sa;
+
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_handler = rping_thread_exit_handler;
+	sigaction(SIGUSR1, &sa, NULL);
+}
 
