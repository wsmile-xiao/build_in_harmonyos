+// Local gtest main() shim. The upstream suite links gtest_main, which the
+// packaged gtest does not provide as a separate library.
+#include "gtest/gtest.h"
+
+int main(int argc, char** argv) {
+  ::testing::InitGoogleTest(&argc, argv);
+  return RUN_ALL_TESTS();
+}
