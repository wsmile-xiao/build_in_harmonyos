+##
+# Suffix array construction is provided by the Conan package libdivsufsort
+# (components divsufsort / divsufsort64).  Upstream built it from an in-tree
+# tarball through ExternalProject; that nested CMake invocation does not inherit
+# the cross-compilation toolchain file, and it forces USE_OPENMP on.  Consuming
+# the package keeps the build hermetic -- no download step at all.
+##
+find_package(libdivsufsort REQUIRED)
+set(SUFFARRAY_LIB divsufsort::divsufsort)
+set(SUFFARRAY64_LIB divsufsort64::divsufsort64)
+set(SUFFARRAY_INCLUDE_DIRS "")
+
+##
+# cereal is header-only and is provided by the Conan package cereal.  The
+# upstream fallback fetched cereal-1.2.2 with `curl -k` (note: certificate
+# checking disabled) and unpacked it into the source tree, which cannot run in
+# an offline build.  The include directory is propagated through the
+# cereal::cereal interface instead of CEREAL_INCLUDE_DIRS.
+#
+# CONFIG mode is requested explicitly: this project prepends its own
+# cmake/Modules to CMAKE_MODULE_PATH, and that directory still holds the
+# FindCereal.cmake written for the old "copy headers under external/install"
+# flow.  Pinning CONFIG keeps the lookup on the package file Conan generates.
+##
+find_package(cereal CONFIG REQUIRED)
+set(CEREAL_INCLUDE_DIRS "")
 
 set (FAST_MALLOC_LIB "")
 set (HAVE_FAST_MALLOC FALSE)
@@ -281,22 +267,14 @@
   set (JEMALLOC_FLAGS "CC=${CMAKE_C_COMPILER}")
 endif()
 
+# The upstream fallback fetched a forked jemalloc 4.5.0 with `curl -k` and ran
