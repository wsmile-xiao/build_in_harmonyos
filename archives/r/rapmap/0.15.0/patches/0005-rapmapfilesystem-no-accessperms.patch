From: OpenHarmonyPCDeveloper adaptation <nobody@example.invalid>
Subject: [PATCH 5/10] Create directories with the POSIX S_IRWX* mode instead of BSD ACCESSPERMS

Part of the RapMap 0.15.0 adaptation for HarmonyOS PC (aarch64).
Generated against upstream tag salmon-v0.15.0.

--- a/src/RapMapFileSystem.cpp
+++ b/src/RapMapFileSystem.cpp
@@ -51,7 +51,10 @@
         }
 
         void MakeDir(const char* path) {
-            mkdir(path, ACCESSPERMS);
+            // ACCESSPERMS is a BSD extension (FreeBSD/DragonFly/macOS
+            // sys/stat.h); it is not POSIX and not every libc ships it.
+            // The S_IRWX* macros below are POSIX and spell the same 0777.
+            mkdir(path, S_IRWXU | S_IRWXG | S_IRWXO);
         }
 
     }
