From: OpenHarmonyPCDeveloper adaptation <nobody@example.invalid>
Subject: [PATCH 8/10] Guard the x86 'pause' spin hint by architecture and yield elsewhere

Part of the RapMap 0.15.0 adaptation for HarmonyOS PC (aarch64).
Generated against upstream tag salmon-v0.15.0.

--- a/include/FastxParserThreadUtils.hpp
+++ b/include/FastxParserThreadUtils.hpp
@@ -18,7 +18,15 @@
     static const size_t MAX_BACKOFF_ITERS = 1024;
 
     ALWAYS_INLINE static void cpuRelax() {
+#if defined(__i386__) || defined(__x86_64__)
       asm("pause");
+#else
+      // "pause" is an x86 instruction, so this cannot even be assembled
+      // on another ISA.  The backoff loop only needs a cheap hint that we
+      // are spinning; the portable equivalent is to let the scheduler run
+      // somebody else.
+      std::this_thread::yield();
+#endif
     }
 
     ALWAYS_INLINE void yieldSleep() {
