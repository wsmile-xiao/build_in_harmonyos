diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -0,0 +1,100 @@
+# Makefile for DBIish (Raku module) installation on HarmonyOS
+# This is a pure Raku module - no C compilation needed.
+# Installation copies .rakumod source files and metadata to the
+# standard Raku site module installation path.
+
+PREFIX ?= /storage/Users/currentUser/usr/local
+DESTDIR ?=
+
+# Raku module installation paths
+RAKU_SITE_DIR = $(PREFIX)/share/perl6/site
+RAKU_SITE_LIB = $(RAKU_SITE_DIR)/lib
+RAKU_SITE_DIST = $(RAKU_SITE_DIR)/dist
+
+# Module metadata
+MODULE_NAME = DBIish
+MODULE_VERSION = 0.6.8
+
+# Source files to install (from META6.json provides section)
+# Note: 'lib/' prefix is stripped when installing to RAKU_SITE_LIB
+RAKUMOD_FILES = \
+	DBIish.rakumod \
+	DBIish/Common.rakumod \
+	DBIish/CommonTesting.rakumod \
+	DBDish.rakumod \
+	DBDish/Connection.rakumod \
+	DBDish/ErrorHandling.rakumod \
+	DBDish/StatementHandle.rakumod \
+	DBDish/TestMock.rakumod \
+	DBDish/TestMock/Connection.rakumod \
+	DBDish/TestMock/StatementHandle.rakumod \
+	DBDish/mysql.rakumod \
+	DBDish/mysql/Connection.rakumod \
+	DBDish/mysql/ErrorHandling.rakumod \
+	DBDish/mysql/Native.rakumod \
+	DBDish/mysql/StatementHandle.rakumod \
+	DBDish/Pg.rakumod \
+	DBDish/Pg/Connection.rakumod \
+	DBDish/Pg/ErrorHandling.rakumod \
+	DBDish/Pg/Native.rakumod \
+	DBDish/Pg/StatementHandle.rakumod \
+	DBDish/SQLite.rakumod \
+	DBDish/SQLite/Connection.rakumod \
+	DBDish/SQLite/Native.rakumod \
+	DBDish/SQLite/StatementHandle.rakumod \
+	DBDish/SQLCipher.rakumod \
+	DBDish/SQLCipher/Connection.rakumod \
+	DBDish/SQLCipher/Native.rakumod \
+	DBDish/SQLCipher/StatementHandle.rakumod \
+	DBDish/Oracle.rakumod \
+	DBDish/Oracle/Connection.rakumod \
+	DBDish/Oracle/Native.rakumod \
+	DBDish/Oracle/StatementHandle.rakumod
+
+# Additional files
+EXTRA_FILES = \
+	META6.json \
+	CREDITS \
+	Changes
+
+.PHONY: all install clean check
+
+all:
+	@echo "DBIish is a pure Raku module - no compilation step needed."
+	@echo "Run 'make install' to install module files."
+
+install:
+	@echo "Installing DBIish $(MODULE_VERSION) to $(DESTDIR)$(RAKU_SITE_DIR)..."
+	# Create directory structure
+	mkdir -p $(DESTDIR)$(RAKU_SITE_LIB)
+	mkdir -p $(DESTDIR)$(RAKU_SITE_DIST)
+	# Install module source files preserving directory structure
+	# Strip 'lib/' prefix: source is lib/DBIish.rakumod -> install as DBIish.rakumod
+	for f in $(RAKUMOD_FILES); do \
+		dir=$$(dirname "$$f"); \
+		mkdir -p $(DESTDIR)$(RAKU_SITE_LIB)/$$dir; \
+		cp -p "lib/$$f" $(DESTDIR)$(RAKU_SITE_LIB)/$$dir/; \
+	done
+	# Install META6.json as dist metadata
+	cp -p META6.json $(DESTDIR)$(RAKU_SITE_DIST)/$(MODULE_NAME)_$(MODULE_VERSION).json
+	# Install extra files
+	for f in $(EXTRA_FILES); do \
+		cp -p "$$f" $(DESTDIR)$(RAKU_SITE_DIST)/; \
+	done
+	# Install examples
+	if [ -d examples ]; then \
+		mkdir -p $(DESTDIR)$(RAKU_SITE_DIST)/examples; \
+		cp -p examples/* $(DESTDIR)$(RAKU_SITE_DIST)/examples/ 2>/dev/null || true; \
+	fi
+	# Install README
+	cp -p README.md $(DESTDIR)$(RAKU_SITE_DIST)/ 2>/dev/null || \
+		cp -p README.pod $(DESTDIR)$(RAKU_SITE_DIST)/ 2>/dev/null || true
+	@echo "Installation complete."
+
+clean:
+	@echo "No build artifacts to clean for pure Raku module."
+
+check:
+	@echo "DBIish tests require a running database server (MySQL/PostgreSQL/SQLite)."
+	@echo "Skipping tests on build system without database services."
+	@echo "Tests should be run after deployment with zef test DBIish."