--- /dev/null
+++ b/test/ohos.sh
@@ -0,0 +1,117 @@
+#!/bin/sh
+# HarmonyOS regression case added by the OHOS adaptation of runawk 1.6.1.
+#
+# It complements test.sh with the three things that actually break on
+# HarmonyOS:
+#   1. the launcher must be a native aarch64 OHOS executable
+#   2. the module system (which writes the generated program to a temp file)
+#      must work while /tmp is read-only
+#   3. the AWK interpreter must be resolved from PATH, and the packaged
+#      modules must be usable by a consumer script
+#
+# Environment (same contract as test.sh):
+#   OBJDIR_runawk  directory holding the freshly built runawk binary
+#   SRCDIR         source root
+#   TMPDIR         writable temporary directory (/tmp is read-only on OHOS)
+
+set -e
+
+: "${OBJDIR_runawk:?OBJDIR_runawk must point at the directory holding runawk}"
+: "${SRCDIR:?SRCDIR must point at the source root}"
+
+RUNAWK=${OBJDIR_runawk}/runawk
+TMPDIR=${TMPDIR:-/data/local/tmp}
+export TMPDIR
+
+cd "${SRCDIR}/test"
+
+echo '--------------------------------------------------'
+echo ' ------ ohos: 1) launcher is a native aarch64 OHOS ELF'
+
+# e_ident: 7f 45 4c 46 02 01  -> 64-bit little endian ELF
+magic=`od -An -tx1 -N6 "${RUNAWK}" | tr -d ' \n'`
+if [ "${magic}" != '7f454c460201' ]; then
+	echo "FAILED: not a 64-bit little-endian ELF: ${magic}"
+	exit 1
+fi
+
+# e_machine (offset 18, 2 bytes, little endian) must be EM_AARCH64 (183)
+machine=`od -An -tu1 -j18 -N2 "${RUNAWK}" | awk '{print $1 + $2 * 256}'`
+if [ "${machine}" != '183' ]; then
+	echo "FAILED: e_machine=${machine}, expected 183 (aarch64)"
+	exit 1
+fi
+echo "ok: ELF64 aarch64"
+
+version=`"${RUNAWK}" -V | awk 'NR == 1 {print $2}'`
+if [ "${version}" != '1.6.1' ]; then
+	echo "FAILED: runawk -V reported '${version}', expected 1.6.1"
+	exit 1
+fi
+echo "ok: runawk ${version}"
+
+echo '--------------------------------------------------'
+echo ' ------ ohos: 2) module system works with a read-only /tmp'
+
+cat > _ohos_prog.awk <<'EOF'
+#use "abs.awk"
+#use "min.awk"
+#use "max.awk"
+BEGIN {
+	print abs(-42)
+	print min(3, 7)
+	print max(3, 7)
+	exit
+}
+EOF
+
+AWKPATH=${SRCDIR}/modules
+export AWKPATH
+
+out=`"${RUNAWK}" _ohos_prog.awk`
+expected='42
+3
+7'
+if [ "${out}" != "${expected}" ]; then
+	echo "FAILED: module program produced:"
+	echo "${out}"
+	exit 1
+fi
+echo "ok: abs/min/max modules resolved through AWKPATH"
+
+# The generated program is written to a temp file; on OHOS that file must
+# land in TMPDIR because /tmp is not writable.
+if [ -w /tmp ]; then
+	echo "note: /tmp is writable here, TMPDIR fallback not exercised"
+else
+	echo "ok: /tmp is read-only, module run still succeeded via TMPDIR=${TMPDIR}"
+fi
+
+echo '--------------------------------------------------'
+echo ' ------ ohos: 3) interpreter resolution + consumer script'
+
+interp=`"${RUNAWK}" -d -e 'BEGIN {exit}' | sed -n '1s/^new_argv \[0\] = //p'`
+if [ -z "${interp}" ]; then
+	echo "FAILED: runawk -d did not report an interpreter"
+	exit 1
+fi
+echo "ok: interpreter ${interp}"
+
+# consumer case: a standalone script driven by runawk, exactly how a
+# downstream package would use it
+cat > _ohos_consumer.awk <<'EOF'
+#use "shquote.awk"
+BEGIN {
+	print shquote("/data/local/tmp/a b.txt")
+	exit
+}
+EOF
+out=`"${RUNAWK}" _ohos_consumer.awk`
+if [ "${out}" != "'/data/local/tmp/a b.txt'" ]; then
+	echo "FAILED: consumer script produced: ${out}"
+	exit 1
+fi
+echo "ok: consumer script using shquote module"
+
+echo '--------------------------------------------------'
+echo 'ohos: succeeded'
