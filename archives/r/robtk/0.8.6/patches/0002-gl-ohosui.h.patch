+/* robwidget - HarmonyOS host interface
+ *
+ * Copyright (C) 2026 robtk OHOS port.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2, or (at your option)
+ * any later version.
+ *
+ * On desktop systems the window manager delivers pointer/keyboard events to
+ * the UI window and the toolkit renders straight into a compositor surface.
+ * On HarmonyOS the embedding application owns the window (ArkUI XComponent),
+ * so it must be able to hand the toolkit its OHNativeWindow and to forward
+ * the input events it receives.  This LV2 extension interface exposes exactly
+ * that to the host:
+ *
+ *   const RTKOhosUi* iface =
+ *       descriptor->extension_data(RTK_OHOS_UI_URI);
+ *   if (iface) {
+ *       PuglView* view = iface->view(handle);
+ *       puglSetNativeWindow(view, (PuglNativeWindow)ohNativeWindow);
+ *       puglSendMouse(view, 1, true, x, y, PUGL_MOD_SHIFT);
+ *       ...
+ *   }
+ *
+ * The interface is optional and additive: hosts that do not know it simply
+ * ignore it, and UIs never require it.
+ */
+#ifndef ROBTK_OHOS_UI_H
+#define ROBTK_OHOS_UI_H
+
+#include "pugl/pugl_ohos.h"
+
+#define RTK_OHOS_UI_URI "http://gareus.org/oss/lv2/robtk#ohosUi"
+#define RTK_OHOS_UI_ABI 1
+
+typedef struct {
+	/** Interface version (RTK_OHOS_UI_ABI) */
+	uint32_t abi_version;
+
+	/** Graphics view of this UI instance (never NULL while instantiated).
+	    Use it with the pugl API, in particular the HarmonyOS extensions
+	    puglSetNativeWindow(), puglSendMouse(), puglSendMotion(),
+	    puglSendScroll(), puglSendSpecial() and puglGrabFrame(). */
+	PuglView* (*view)(LV2UI_Handle handle);
+
+	/** Copy the last rendered frame into `rgba` (width * height * 4 bytes,
+	    RGBA, origin bottom-left).  Returns 0 on success. */
+	int (*grab_frame)(LV2UI_Handle handle,
+	                  int* width, int* height, unsigned char* rgba);
+} RTKOhosUi;
+
+#endif /* ROBTK_OHOS_UI_H */
