+
+# HarmonyOS / OpenHarmony: there is no X11/GLX, the UI is rendered with
+# OpenGL ES 3 (libGLESv3.so) through EGL (libEGL.so) and the window is a
+# OHNativeWindow owned by the host application.  Build the UI with
+#   make RTK_OHOS=1 ...
+ifeq ($(RTK_OHOS),1)
+  PUGL_SRC=$(RW)pugl/pugl_ohos.c
+  GLUICFLAGS+=-DRTK_GLES
+  GLUILIBS+=-lEGL -lGLESv3 -lnative_window
 endif
 
 ifeq ($(shell $(PKG_CONFIG) --exists liblo && echo yes), yes)
   JACKCFLAGS+=`$(PKG_CONFIG) $(PKG_UI_FLAGS) --cflags liblo` -DHAVE_LIBLO
   JACKLIBS+=`$(PKG_CONFIG) $(PKG_UI_FLAGS) --libs liblo`
 endif
 
 
