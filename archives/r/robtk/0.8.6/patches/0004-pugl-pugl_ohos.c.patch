+}
+
+/** Copy the current drawable into `rgba` (width * height * 4 bytes, RGBA).
+
+    @return 0 on success, negative on error.  `width`/`height` are updated
+    with the size of the frame that was read back.
+*/
+PUGL_API int
+puglGrabFrame(PuglView* view, int* width, int* height, unsigned char* rgba)
+{
+	PuglInternals* impl = puglOhosImpl(view);
+	if (!rgba) {
+		return -1;
+	}
+	if (!eglMakeCurrent(impl->display, impl->surface, impl->surface, impl->ctx)) {
+		puglOhosEglError("eglMakeCurrent");
+		return -1;
+	}
+	const int w = view->width;
+	const int h = view->height;
+	/* drop errors left over from earlier drawing so that a failure below is
+	 * really reported by glReadPixels and not by an unrelated stale error */
+	while (glGetError() != GL_NO_ERROR) { }
+	glPixelStorei(GL_PACK_ALIGNMENT, 1);
+	glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+	const GLenum err = glGetError();
+	if (err != GL_NO_ERROR) {
+		fprintf(stderr, "pugl: glReadPixels failed (0x%04x)\n", (unsigned)err);
+		return -2;
+	}
+	if (width)  { *width  = w; }
+	if (height) { *height = h; }
+	return 0;
+}
