+/**
+   @file pugl_ohos.h  HarmonyOS specific entry points of the OHOS backend.
+
+   Unlike X11 the HarmonyOS window and its input events belong to the
+   application (ArkUI/XComponent), so the backend cannot poll a server.
+   The host therefore pushes input into the view and can read frames back.
+   These functions are only available when pugl is built with the OHOS
+   backend (pugl/pugl_ohos.c).
+*/
+
+#ifndef PUGL_OHOS_H_INCLUDED
+#define PUGL_OHOS_H_INCLUDED
+
+#include "pugl.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Attach (or detach) the native OHNativeWindow the UI is rendered into.
+
+    Pass the `OHNativeWindow*` of the XComponent surface handed to the host
+    application; pass 0 to render offscreen into a pbuffer.  Passing 0 at
+    creation time (puglCreate) selects offscreen rendering as well. */
+PUGL_API PuglStatus
+puglSetNativeWindow(PuglView* view, PuglNativeWindow window);
+
+/** Pointer motion.  `mods` is a mask of `PuglMod` values. */
+PUGL_API void
+puglSendMotion(PuglView* view, int x, int y, int mods);
+
+/** Mouse button press (press=true) or release. */
+PUGL_API void
+puglSendMouse(PuglView* view, int button, bool press, int x, int y, int mods);
+
+/** Scroll wheel / track-pad scroll in "lines". */
+PUGL_API void
+puglSendScroll(PuglView* view, int x, int y, float dx, float dy, int mods);
+
+/** Non-printable key press/release (function keys, arrows, ...). */
+PUGL_API void
+puglSendSpecial(PuglView* view, bool press, PuglKey key, int mods);
+
+/** Printable key press/release (Unicode code point). */
+PUGL_API void
+puglSendKeyboard(PuglView* view, bool press, uint32_t key, int mods);
+
+/** Pointer entered (enter=true) or left the view. */
+PUGL_API void
+puglSendEnterLeave(PuglView* view, bool enter, int x, int y, int mods);
+
+/** Ask the UI to close itself (the ArkUI window has been closed). */
+PUGL_API void
+puglSendClose(PuglView* view);
+
+/** Read the current drawable back into memory (RGBA, width * height * 4).
+
+    `width`/`height` are updated with the size of the frame.  Returns 0 on
+    success, negative on error.  The buffer must hold at least
+    width * height * 4 bytes. */
+PUGL_API int
+puglGrabFrame(PuglView* view, int* width, int* height, unsigned char* rgba);
+
+#ifdef __cplusplus
+}  /* extern "C" */
+#endif
+
+#endif  /* PUGL_OHOS_H_INCLUDED */
