new file mode 100644
index 0000000..6b92422
--- /dev/null
+++ b/tests/_shim_mocker.py
@@ -0,0 +1,68 @@
+# -*- coding: utf-8 -*-
+"""Stdlib-based stand-in for the ``pytest-mock`` ``mocker`` fixture.
+
+``pytest-mock`` is not published on ohpcd, so it cannot be declared as a test
+requirement (a dependency must be published before it is consumed). The surface
+requests 2.22.0's own suite actually touches is tiny:
+
+    mocker.patch(target, new=...)      -- starts immediately, undone at teardown
+    mocker.patch.dict(mapping, dict)   -- starts immediately, undone at teardown
+    mocker.Mock() / mocker.MagicMock()
+
+``pytest-mock``'s ``patch()`` starts the patcher right away, whereas
+``unittest.mock.patch`` returns a patcher that must be started explicitly; the
+suite relies on the auto-start behaviour, which is what this shim provides.
+"""
+from unittest import mock as _mock
+
+import pytest
+
+
+class _AutoPatch(object):
+    """``mocker.patch`` that starts immediately and is undone at teardown."""
+
+    def __init__(self):
+        self._started = []
+
+    def _start(self, patcher):
+        try:
+            result = patcher.start()
+        except AttributeError:
+            # unittest.mock.patch.dict().start() returns None
+            patcher.start()
+            result = patcher
+        self._started.append(patcher)
+        return result
+
+    def __call__(self, *args, **kwargs):
+        return self._start(_mock.patch(*args, **kwargs))
+
+    def object(self, *args, **kwargs):
+        return self._start(_mock.patch.object(*args, **kwargs))
+
+    def dict(self, *args, **kwargs):
+        return self._start(_mock.patch.dict(*args, **kwargs))
+
+    def stopall(self):
+        for patcher in reversed(self._started):
+            try:
+                patcher.stop()
+            except RuntimeError:
+                pass
+        self._started = []
+
+
+class _Mocker(object):
+    Mock = _mock.Mock
+    MagicMock = _mock.MagicMock
+    NonCallableMock = _mock.NonCallableMock
+
+    def __init__(self, patch):
+        self.patch = patch
+
+
+@pytest.fixture
+def mocker():
+    patch = _AutoPatch()
+    yield _Mocker(patch)
+    patch.stopall()
