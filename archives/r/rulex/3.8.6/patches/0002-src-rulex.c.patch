+/* Locale-independent KOI8-R case folding for systems without ru_RU.KOI8-R. */
+static unsigned char koi8r_tolower(unsigned char ch)
+{
+  if (ch == 0xB3)
+    return 0xA3;
+  if (ch >= 0xE0)
+    return ch - 0x20;
+  if (ch < 0x80)
+    return (unsigned char)tolower(ch);
+  return ch;
+}
+
 static void *xrealloc(void *p, unsigned int n)
 {
   void *u = realloc(p, n);
   if (u) return u;
   else
     {
       perror("Memory allocation error");
       exit(EXIT_FAILURE);
     }
 }
