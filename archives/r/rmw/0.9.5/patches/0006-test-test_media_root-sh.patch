--- a/test/test_media_root.sh
+++ b/test/test_media_root.sh
@@ -20,10 +20,17 @@
   . "${MESON_SOURCE_ROOT}/test/COMMON"
 fi
 
-# This test requires /tmp to be a top-level mount point on its own device so
-# that rmw will write a relative Path in the trashinfo. Check /proc/mounts
-# (Linux); on macOS/BSD where it doesn't exist the grep fails and we skip.
-if ! grep -q '^[^ ]* /tmp ' /proc/mounts 2>/dev/null; then
+# This test requires the media root to be a top-level mount point on its own
+# device so that rmw will write a relative Path in the trashinfo.
+# OHOS: /tmp is a read-only erofs mount, so use the user storage volume
+# (/storage/Users, tmpfs, own device) when available; /tmp otherwise.
+# Check /proc/mounts (Linux); on macOS/BSD where it doesn't exist we skip.
+MEDIA_ROOT=/tmp
+if grep -q '^tmpfs /storage/Users ' /proc/mounts 2>/dev/null &&
+   mkdir -p /storage/Users/currentUser/.rmw-media-probe 2>/dev/null; then
+  rmdir /storage/Users/currentUser/.rmw-media-probe
+  MEDIA_ROOT=/storage/Users/currentUser
+elif ! grep -q '^[^ ]* /tmp ' /proc/mounts 2>/dev/null; then
   echo "/tmp is not a top-level mount point; skipping"
   exit 0
 fi
@@ -30,7 +37,7 @@
 
-# /tmp is on a different device — use it as the simulated media root.
-TRASH_DIR="/tmp/.Trash-$(id -u)"
-TEST_DIR="/tmp/rmw-media-root-test"
+# The media root is on a different device — use it as the simulated media root.
+TRASH_DIR="${MEDIA_ROOT}/.Trash-$(stat -c %u .)"
+TEST_DIR="${MEDIA_ROOT}/rmw-media-root-test"
 test_file="media_root_test"
 test_file_path="$TEST_DIR/$test_file"
 
@@ -43,10 +50,10 @@
 # Clean up any leftovers from a previous run
 rm -rf "$TRASH_DIR" "$TEST_DIR"
 
-# Create test config pointing the waste folder to /tmp
+# Create test config pointing the waste folder to the media root
 mkdir -p "$RMW_FAKE_HOME"
 TEST_CONFIG="$RMW_FAKE_HOME/media-root.testrc"
-printf 'WASTE = /tmp/.Trash-%s, removable\nexpire_age = 90\n' "$(id -u)" > "$TEST_CONFIG"
+printf 'WASTE = %s/.Trash-%s, removable\nexpire_age = 90\n' "$MEDIA_ROOT" "$(stat -c %u .)" > "$TEST_CONFIG"
 
 # Create waste dir manually (required because it is marked removable)
 mkdir -p "$TRASH_DIR/files" "$TRASH_DIR/info"
@@ -60,7 +67,7 @@
 test ! -f "$test_file_path"
 
 # The Path must be relative (no leading '/') since the waste folder is at
-# the topdir of /tmp's partition.
+# the topdir of the media root's partition.
 output=$(grep '^Path=' "$TRASH_DIR/info/$test_file.trashinfo")
 echo "trashinfo: $output"
 case "$output" in
