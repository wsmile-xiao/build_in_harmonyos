--- a/src/utils.c
+++ b/src/utils.c
@@ -566,6 +566,30 @@
 #include "purging.h"
 
 
+/* OHOS: the SELinux policy denies symlink(2) and lstat() on symlinks to
+ * untrusted (unsigned) processes with EACCES, which makes the symlink
+ * assertions below unrunnable there even though the platform supports
+ * symlinks in general.  Probe the capability once; tests skip their
+ * symlink checks gracefully when this returns 0. */
+static int
+test_symlink_ok(const char *const dir)
+{
+  char *target = join_paths(dir, "sym_probe_target");
+  FILE *fp = fopen(target, "w");
+  if (fp)
+    assert(fclose(fp) != EOF);
+  char *link = join_paths(dir, "sym_probe_link");
+  remove(link);
+  struct stat st;
+  const int ok = (symlink(target, link) == 0 && lstat(link, &st) == 0);
+  remove(link);
+  remove(target);
+  free(target);
+  free(link);
+  return ok;
+}
+
+
 static void
 test_isdotdir(void)
 {
@@ -719,6 +743,10 @@
 
   assert(!is_dir_f(foobar));
   char *snafu = join_paths(homedir, "snafu");
+  if (!test_symlink_ok(homedir)) {
+    printf("skipping symlink checks: platform denies symlink to untrusted processes\n");
+    remove(foobar);
+  } else {
   assert(symlink(foobar, snafu) == 0);
   assert(!is_dir_f(snafu));
   assert(bsdutils_rm(foobar, false) == 0);
@@ -725,6 +753,4 @@
-  free(foobar);
   assert(bsdutils_rm(snafu, false) == 0);
-  free(snafu);
 
   char *home_link = join_paths(homedir, "home_link");
   assert(symlink(homedir, home_link) == 0);
@@ -731,6 +757,9 @@
   assert(is_dir_f(home_link) == false);
   assert(bsdutils_rm(home_link, false) == 0);
   free(home_link);
+  }
+  free(foobar);
+  free(snafu);
 
   return;
 }
@@ -745,6 +774,13 @@
   assert(fclose(fp) != EOF);
   assert(check_pathname_state(foobar) == EEXIST);
 
+  if (!test_symlink_ok(homedir)) {
