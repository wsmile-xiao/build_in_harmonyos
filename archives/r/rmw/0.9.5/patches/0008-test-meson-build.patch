--- a/test/meson.build
+++ b/test/meson.build
@@ -46,12 +46,28 @@
   'MESON_BUILD_ROOT=' + meson.project_build_root(),
 ]
 
-foreach s : scripts
-  test(
-    s,
-    files(s),
-    env: test_env,
-    depends: main_bin,
-  )
-endforeach
+# OHOS: freshly unpacked scripts on the HMDFS filesystem may fail execve
+# with EACCES for untrusted processes; run the shell tests through the
+# interpreter (reading the file) instead of exec'ing them directly.
+if host_machine.system() == 'harmonyos'
+  sh_prog = find_program('sh', native: true)
+  foreach s : scripts
+    test(
+      s,
+      sh_prog,
+      args: [files(s)],
+      env: test_env,
+      depends: main_bin,
+    )
+  endforeach
+else
+  foreach s : scripts
+    test(
+      s,
+      files(s),
+      env: test_env,
+      depends: main_bin,
+    )
+  endforeach
+endif
 
