--- /dev/null
+++ b/lib/ohos_pthread_stubs.c
@@ -0,0 +1,31 @@
+/*
+ * ohos_pthread_stubs.c
+ *
+ * OHOS libc 未实现 POSIX 线程取消 API（pthread_cancel / pthread_testcancel）。
+ * 提供 weak 实现填补链接缺口：
+ *  - pthread_cancel：不做强制取消，返回 ESRCH（各线程依赖自身退出条件收敛，
+ *    调用方如 daemon/helpers.c 的 waker 机制先行信号化）
+ *  - pthread_testcancel：no-op
+ * 在 glibc/musl 等提供强符号的平台，动态链接时强符号优先，weak 实现不生效。
+ *
+ * 平台限制记录：线程无法被强制取消，仅影响异常退出路径的收敛速度。
+ */
+#include <errno.h>
+#include <pthread.h>
+
+__attribute__((weak)) int pthread_cancel(pthread_t thread) {
+	(void)thread;
+	errno = ESRCH;
+	return errno;
+}
+
+__attribute__((weak)) void pthread_testcancel(void) {
+	/* no-op: this platform has no thread cancellation mechanism */
+}
+
+__attribute__((weak)) int pthread_setcancelstate(int type, int *oldtype) {
+	(void)type;
+	if (oldtype)
+		*oldtype = PTHREAD_CANCEL_DISABLE;
+	return 0;
+}
