--- a/utils/gen-bcg729-flags
+++ b/utils/gen-bcg729-flags
@@ -1,11 +1,11 @@
-#!/bin/bash
+#!/usr/bin/env bash
 
 have_bcg729="no"
 
 # look for bcg729
 if pkg-config --exists libbcg729; then
