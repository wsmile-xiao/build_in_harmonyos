--- a/config/config.guess
+++ b/config/config.guess
@@ -131,20 +131,30 @@
 # This is needed to find uname on a Pyramid OSx when run in the BSD universe.
 # (ghazi@noc.rutgers.edu 1994-08-24)
 if (test -f /.attbin/uname) >/dev/null 2>&1 ; then
 	PATH=$PATH:/.attbin ; export PATH
 fi
 
 UNAME_MACHINE=`(uname -m) 2>/dev/null` || UNAME_MACHINE=unknown
 UNAME_RELEASE=`(uname -r) 2>/dev/null` || UNAME_RELEASE=unknown
 UNAME_SYSTEM=`(uname -s) 2>/dev/null`  || UNAME_SYSTEM=unknown
 UNAME_VERSION=`(uname -v) 2>/dev/null` || UNAME_VERSION=unknown
+
+# [HarmonyOS] This 2007-era config.guess predates both aarch64 and HarmonyOS.
+# On HarmonyOS PC the platform compiler is clang with the OHOS sysroot, so report
+# the same triple the recipe passes explicitly (--build/--host); without this the
+# script fails with "unable to guess system type" and a bare ./configure aborts.
+case "${UNAME_SYSTEM}:${UNAME_MACHINE}" in
+  HarmonyOS:aarch64 | HarmonyOS:arm64)
+    echo aarch64-unknown-linux-gnu
+    exit 0 ;;
+esac
 
 # Note: order is significant - the case branches are not exclusive.
 
