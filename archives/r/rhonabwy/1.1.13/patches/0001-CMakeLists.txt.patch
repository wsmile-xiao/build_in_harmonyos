-include(FindJansson)
+# HarmonyOS PC / Conan port: CMakeDeps exports these dependencies under their
+# package-name targets (jansson::jansson, nettle::nettle, gnutls::gnutls)
+# instead of the capitalised names used below. The bundled
+# cmake-modules/FindJansson.cmake and FindNettle.cmake are pkg-config based and
+# would silently resolve against a host library if a same-name copy happened to
+# be installed, so they are no longer pre-executed with include(); the
+# find_package() calls below resolve the Conan CMakeDeps packages and the aliases
+# created afterwards keep the upstream target names working. Nettle and GnuTLS
+# are static and must keep their transitive link closure, which is exactly what
+# the CMakeDeps targets provide.
 set(JANSSON_MIN_VERSION 2.4)
 find_package(Jansson ${JANSSON_MIN_VERSION} REQUIRED)
+if (NOT TARGET Jansson::Jansson AND TARGET jansson::jansson)
+    add_library(Jansson::Jansson INTERFACE IMPORTED)
+    set_target_properties(Jansson::Jansson PROPERTIES
+            INTERFACE_LINK_LIBRARIES jansson::jansson)
+endif ()
 list(APPEND RHONABWY_LIBS Jansson::Jansson)
 
-include(FindNettle)
 find_package(Nettle REQUIRED)
+if (NOT TARGET Nettle::Nettle AND TARGET nettle::nettle)
+    add_library(Nettle::Nettle INTERFACE IMPORTED)
+    set_target_properties(Nettle::Nettle PROPERTIES
+            INTERFACE_LINK_LIBRARIES nettle::nettle)
+endif ()
+# HarmonyOS PC / Conan port: the gmp package that nettle depends on reports no
+# include directory in its published Conan metadata (the generated
+# gmp-release-*-data.cmake has an empty gmp_INCLUDE_DIRS_RELEASE), while nettle's
+# public headers include <gmp.h>. The conan recipe passes the directory the gmp
+# package installs <gmp.h> in through GMP_INCLUDE_DIR; when it is not set the
+# build behaves exactly like upstream.
+if (GMP_INCLUDE_DIR AND IS_DIRECTORY "${GMP_INCLUDE_DIR}" AND TARGET Nettle::Nettle)
+    set_property(TARGET Nettle::Nettle APPEND PROPERTY
+            INTERFACE_INCLUDE_DIRECTORIES "${GMP_INCLUDE_DIR}")
+endif ()
 list(APPEND RHONABWY_LIBS Nettle::Nettle)
 
 find_package(GnuTLS REQUIRED)
+if (NOT TARGET GnuTLS::GnuTLS AND TARGET gnutls::gnutls)
+    add_library(GnuTLS::GnuTLS INTERFACE IMPORTED)
+    set_target_properties(GnuTLS::GnuTLS PROPERTIES
+            INTERFACE_LINK_LIBRARIES gnutls::gnutls)
+endif ()
 list(APPEND RHONABWY_LIBS GnuTLS::GnuTLS)
 
