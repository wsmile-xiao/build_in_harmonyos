+# HarmonyOS PC / Conan port: orcania is published as a static library only, so
+# CMakeDeps exports Orcania::Orcania-static. `Orcania::Orcania` is an ALIAS of the
+# upstream build tree and is not part of the installed export set, so recreate it
+# for the $<TARGET_NAME:Orcania::Orcania> links below and for the plain
+# `Orcania::Orcania` link of rnbyc.
+if (NOT TARGET Orcania::Orcania AND TARGET Orcania::Orcania-static)
+    add_library(Orcania::Orcania INTERFACE IMPORTED)
+    set_target_properties(Orcania::Orcania PROPERTIES
+            INTERFACE_LINK_LIBRARIES Orcania::Orcania-static)
+endif ()
+
