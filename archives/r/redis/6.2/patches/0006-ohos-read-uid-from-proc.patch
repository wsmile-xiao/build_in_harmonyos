diff --git a/tests/unit/oom-score-adj.tcl b/tests/unit/oom-score-adj.tcl
index 892b1a7..1619c90 100644
--- a/tests/unit/oom-score-adj.tcl
+++ b/tests/unit/oom-score-adj.tcl
@@ -1,5 +1,14 @@
 set system_name [string tolower [exec uname -s]]
-set user_id [exec id -u]
+if {[catch {exec id -u} user_id]} {
+    set status_fd [open "/proc/self/status" "r"]
+    set process_status [read $status_fd]
+    close $status_fd
+
+    if {![regexp -line {^Uid:[[:space:]]+([0-9]+)} \
+            $process_status _ user_id]} {
+        error "Unable to determine current numeric UID"
+    }
+}
 
 if {$system_name eq {linux}} {
     start_server {tags {"oom-score-adj"}} {
