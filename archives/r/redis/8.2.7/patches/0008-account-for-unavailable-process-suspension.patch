--- a/tests/support/test.tcl
+++ b/tests/support/test.tcl
@@ -164,2 +164,25 @@
 proc test {name code {okpattern undefined} {tags {}}} {
+    # Some restricted platforms acknowledge SIGSTOP without suspending the
+    # process. Keep those exclusions explicit and visible in the test totals.
+    if {[info exists ::env(REDIS_TEST_SKIP_PROCESS_PAUSE)] &&
+        ([string first "pause_process" $code] >= 0 ||
+         [string first "resume_process" $code] >= 0 ||
+         [string first "debug repl-pause" $code] >= 0 ||
+         [lsearch -exact {
+             {Test replica rdbchannel client has SC flag on client list output}
+             {Test replica state advances to online when fullsync is completed}
+             {Run blocking command again on cluster node1}
+             {Verify command got unblocked after cluster failure}
+             {Verify command (blocked on key) got unblocked after cluster failure}
+             {Verify command (no keys) got unblocked after cluster failure}
+             {Verify command RM_Call is rejected when cluster is down}
+             {no prefetch when the batch size is set to 0}
+             {Prefetch can resume working when the configuration option is set to a non-zero value}
+         } $name] >= 0)} {
+        incr ::num_skipped
+        send_data_packet $::test_server_fd skip \
+            "$name (requires SIGSTOP/SIGCONT process suspension)"
+        return
+    }
+
     # abort if test name in skiptests
--- a/tests/support/util.tcl
+++ b/tests/support/util.tcl
@@ -688,2 +688,6 @@
 proc pause_process pid {
+    if {[info exists ::env(REDIS_TEST_SKIP_PROCESS_PAUSE)]} {
+        fail "pause_process escaped explicit process-suspension test accounting"
+    }
+
     exec kill -SIGSTOP $pid
@@ -698,2 +702,6 @@
 proc resume_process pid {
+    if {[info exists ::env(REDIS_TEST_SKIP_PROCESS_PAUSE)]} {
+        return
+    }
+
     wait_for_condition 50 1000 {
--- a/tests/instances.tcl
+++ b/tests/instances.tcl
@@ -28,3 +28,4 @@
 set ::simulate_error 0
 set ::failed 0
+set ::skipped 0
 set ::sentinel_instances {}
@@ -415,2 +416,12 @@
 proc test {descr code} {
+    if {[info exists ::env(REDIS_TEST_SKIP_PROCESS_PAUSE)] &&
+        ([string first "pause_process" $code] >= 0 ||
+         [string first "resume_process" $code] >= 0 ||
+         [string first "debug repl-pause" $code] >= 0)} {
+        incr ::skipped
+        set ts [clock format [clock seconds] -format %H:%M:%S]
+        puts "$ts> $descr: SKIPPED (requires SIGSTOP/SIGCONT process suspension)"
+        return
+    }
+
     set ts [clock format [clock seconds] -format %H:%M:%S]
@@ -512,4 +523,7 @@
 proc end_tests {} {
     if {$::failed == 0 } {
+        if {$::skipped > 0} {
+            puts [colorstr yellow "$::skipped test(s) skipped (requires SIGSTOP/SIGCONT process suspension)"]
+        }
         puts [colorstr green "GOOD! No errors."]
         exit 0
