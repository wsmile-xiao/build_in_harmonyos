@@ -0,0 +1,21 @@
+/* musl compatibility stubs for pthread_cancel functions */
+#ifndef _MUSL_COMPAT_H
+#define _MUSL_COMPAT_H
+
+#ifndef __GLIBC__
+/* musl does not support pthread_cancel, provide stub functions */
+#include <pthread.h>
+
+/* Declare stub functions - implemented in musl-compat.c */
+int musl_pthread_setcancelstate(int state, int *oldstate);
+int musl_pthread_setcanceltype(int type, int *oldtype);
+int musl_pthread_cancel(pthread_t thread);
+
+/* Override pthread functions with musl stubs */
+#define pthread_setcancelstate musl_pthread_setcancelstate
+#define pthread_setcanceltype musl_pthread_setcanceltype
+#define pthread_cancel musl_pthread_cancel
+
+#endif /* __GLIBC__ */
+#endif /* _MUSL_COMPAT_H */
--- /dev/null
+++ b/src/musl-compat.c
@@ -0,0 +1,22 @@
+/* musl compatibility stubs for pthread_cancel functions - implementation */
+#ifndef __GLIBC__
+
+#include <pthread.h>
+#include <errno.h>
+
+/* Stub: always succeeds but does nothing */
+int musl_pthread_setcancelstate(int state, int *oldstate) {
+    (void)state;
+    if (oldstate) *oldstate = PTHREAD_CANCEL_ENABLE;
+    return 0;
+}
+
+int musl_pthread_setcanceltype(int type, int *oldtype) {
+    (void)type;
+    if (oldtype) *oldtype = PTHREAD_CANCEL_DEFERRED;
+    return 0;
+}
+
+int musl_pthread_cancel(pthread_t thread) {
+    (void)thread;
+    return ESRCH;
+}
+
+#endif /* __GLIBC__ */
