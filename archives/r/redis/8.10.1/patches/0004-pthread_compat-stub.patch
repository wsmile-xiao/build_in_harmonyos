--- /dev/null
+++ b/src/pthread_compat.c
@@ -0,0 +1,28 @@
+/* Non-glibc Linux libcs may omit POSIX thread cancellation symbols. */
+#if defined(__linux__) && !defined(__GLIBC__)
+#include <errno.h>
+#include <pthread.h>
+
+int pthread_cancel(pthread_t thread) {
+    (void)thread;
+    /* Redis joins only after cancellation succeeds. A success-returning
+     * no-op would deadlock while joining a thread that remains live. */
+    return ENOSYS;
+}
+
+int pthread_setcancelstate(int state, int *oldstate) {
+    (void)state;
+    if (oldstate != NULL) {
+        *oldstate = PTHREAD_CANCEL_ENABLE;
+    }
+    return 0;
+}
+
+int pthread_setcanceltype(int type, int *oldtype) {
+    (void)type;
+    if (oldtype != NULL) {
+        *oldtype = PTHREAD_CANCEL_DEFERRED;
+    }
+    return 0;
+}
+#endif /* defined(__linux__) && !defined(__GLIBC__) */
