diff -ruN a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,16 +1,26 @@
+# Makefile for rpm2cpio
+# 
+# PREFIX should be set by DEFAULT_PREFIX environment variable
+# DESTDIR is the staging root for package creation
+
 PREFIX ?= /usr/local
 DESTDIR ?=
 
 all:
 	# Nothing to build - it's a shell script
 
 install:
 	mkdir -p $(DESTDIR)$(PREFIX)/bin
 	install -m 755 rpm2cpio.sh $(DESTDIR)$(PREFIX)/bin/rpm2cpio
-	ln -f $(DESTDIR)$(PREFIX)/bin/rpm2cpio $(DESTDIR)$(PREFIX)/bin/rpm2cpio.pl
+	# Use symbolic link instead of hard link (R5: HMDFS limitation)
+	rm -f $(DESTDIR)$(PREFIX)/bin/rpm2cpio.pl
+	ln -s rpm2cpio $(DESTDIR)$(PREFIX)/bin/rpm2cpio.pl
 
 clean:
 	# Nothing to clean
 
 check:
-	# No test suite
+	# No test suite - basic functionality test
+	@if [ -f $(DESTDIR)$(PREFIX)/bin/rpm2cpio ]; then \
+		echo "rpm2cpio installed successfully"; \
+	fi
