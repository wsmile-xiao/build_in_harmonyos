--- /dev/null
+++ b/rtrlib/lib/ohos_pthread_compat.c
@@ -0,0 +1,36 @@
+/*
+ * OHOS/musl pthread cancellation compat for rtrlib.
+ *
+ * HarmonyOS (musl) does not implement the POSIX thread cancellation API
+ * (pthread_cancel, pthread_testcancel, pthread_setcancelstate,
+ * pthread_setcanceltype). librtr references pthread_cancel and
+ * pthread_setcancelstate from rtr.c / packets.c / tcp_transport.c, so the
+ * shared object carries undefined symbols and executables linking it fail
+ * under the OHOS toolchain flag --no-allow-shlib-undefined.
+ *
+ * Provide no-op stubs so the link succeeds. The stubs are only activated
+ * for OHOS builds (RTRLIB_OHOS_PTHREAD_STUB comes from the Conan recipe
+ * on OHOS); on other platforms this file
+ * compiles to an empty translation unit and never overrides the real
+ * libc implementations.
+ */
+#include <pthread.h>
+
+#if defined(RTRLIB_OHOS_PTHREAD_STUB)
+int pthread_cancel(pthread_t t) { (void)t; return 0; }
+void pthread_testcancel(void) { }
+int pthread_setcancelstate(int s, int *os)
+{
+	if (os)
+		*os = PTHREAD_CANCEL_ENABLE;
+	(void)s;
+	return 0;
+}
+int pthread_setcanceltype(int t, int *ot)
+{
+	if (ot)
+		*ot = PTHREAD_CANCEL_DEFERRED;
+	(void)t;
+	return 0;
+}
+#endif
