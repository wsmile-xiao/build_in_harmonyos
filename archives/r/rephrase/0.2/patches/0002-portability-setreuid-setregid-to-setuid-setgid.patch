+  /* HongMeng raises an undeliverable SIGSYS (exit 159) for setreuid() and
+   * setregid() -- knowledge/graph/E051.kv: the signal cannot be caught, the
+   * process dies outright.  setuid()/setgid() are permitted and express the
+   * very same privilege-dropping intent, so no platform macro is needed:
+   * with a non-zero effective id both forms are a no-op success, and with
+   * euid == 0 setuid() additionally clears the saved-set id, i.e. it drops
+   * strictly more privilege than setreuid(getuid(), getuid()) did. */
-  if (setreuid (getuid (), getuid ())) {
-    perror ("setreuid");
-    exit (3);
-  }
+  if (setuid (getuid ())) {
+    perror ("setuid");
+    exit (3);
+  }
   /* rephrase shouldn't have the setgid bit set.  just in case it was
    * set anyway, we'll drop any setgid privileges.
    */
-  if (setregid (getgid (), getgid ())) {
-    perror ("setregid");
-    exit (28);
-  }
+  if (setgid (getgid ())) {
+    perror ("setgid");
+    exit (28);
+  }
 
