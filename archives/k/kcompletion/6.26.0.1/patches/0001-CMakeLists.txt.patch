--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -35,20 +35,41 @@
   SOVERSION 6)
 
 # Dependencies
 set(REQUIRED_QT_VERSION 6.9.0)
 
 find_package(Qt6 ${REQUIRED_QT_VERSION} NO_MODULE REQUIRED Widgets)
 
 find_package(KF6Codecs ${KF_DEP_VERSION} REQUIRED)
 find_package(KF6Config ${KF_DEP_VERSION} REQUIRED)
 find_package(KF6WidgetsAddons ${KF_DEP_VERSION} REQUIRED)
+
+# E537 relocatable linkage: kconfig/kwidgetsaddons are published without a
+# DT_SONAME, so linking by their absolute Conan cache path makes the linker
+# record the machine-private path in DT_NEEDED (non-consumable on a different
+# cache layout). Stamp an IMPORTED_SONAME on the dependency targets and clear
+# both the generic and per-config IMPORTED_NO_SONAME so CMake links by
+# `-L<dir> -l:libKF6*.so` and ld records the basename (ksanecore 26.04.0
+# precedent).
+foreach(_dep_target KF6::ConfigCore KF6::ConfigGui KF6::WidgetsAddons)
+    if(TARGET ${_dep_target})
+        get_target_property(_dep_soname ${_dep_target} IMPORTED_SONAME)
+        if(NOT _dep_soname)
+            set_target_properties(${_dep_target} PROPERTIES
+                IMPORTED_NO_SONAME FALSE
+                IMPORTED_NO_SONAME_RELEASE FALSE
+                IMPORTED_SONAME "$<TARGET_FILE_NAME:${_dep_target}>"
+            )
+        endif()
+        unset(_dep_soname)
+    endif()
+endforeach()
 
 set(EXCLUDE_DEPRECATED_BEFORE_AND_AT 0 CACHE STRING "Control the range of deprecated API excluded from the build [default=0].")
 
 cmake_dependent_option(BUILD_DESIGNERPLUGIN "Build plugin for Qt Designer" ON "NOT CMAKE_CROSSCOMPILING" OFF)
 add_feature_info(DESIGNERPLUGIN ${BUILD_DESIGNERPLUGIN} "Build plugin for Qt Designer")
 
 ecm_set_disabled_deprecation_versions(
     QT 6.11
     KF 6.23
 )
