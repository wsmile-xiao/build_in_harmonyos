--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -47,24 +47,55 @@
     GROUP_BASE_NAME KF
     VERSION ${KF_VERSION}
     USE_VERSION_HEADER
     DEPRECATED_BASE_VERSION 0
     DEPRECATION_VERSIONS 6.11
     EXCLUDE_DEPRECATED_BEFORE_AND_AT ${EXCLUDE_DEPRECATED_BEFORE_AND_AT}
 )
 
 target_include_directories(KF6Completion INTERFACE "$<INSTALL_INTERFACE:${KDE_INSTALL_INCLUDEDIR_KF}/KCompletion>")
 
+# E537 relocatable linkage: kconfig/kwidgetsaddons are published without a
+# DT_SONAME, so linking by their absolute Conan cache paths makes the linker
+# record machine-private paths in DT_NEEDED (non-consumable on a different
+# cache layout). Link by SONAME-style basenames with a PRIVATE -L so ld
+# records `libKF6ConfigCore.so` and friends; consumers obtain KF6/Qt includes
+# transitively through their own imported targets (ksanecore 26.04.0
+# precedent).
+target_link_directories(KF6Completion PRIVATE ${KCOMPLETION_DEP_LIB_DIRS})
+
+if(TARGET KF6::ConfigCore)
+    get_target_property(_configcore_inc KF6::ConfigCore INTERFACE_INCLUDE_DIRECTORIES)
+    if(_configcore_inc)
+        target_include_directories(KF6Completion SYSTEM PRIVATE ${_configcore_inc})
+    endif()
+    unset(_configcore_inc)
+endif()
+if(TARGET KF6::ConfigGui)
+    get_target_property(_configgui_inc KF6::ConfigGui INTERFACE_INCLUDE_DIRECTORIES)
+    if(_configgui_inc)
+        target_include_directories(KF6Completion SYSTEM PRIVATE ${_configgui_inc})
+    endif()
+    unset(_configgui_inc)
+endif()
+if(TARGET KF6::WidgetsAddons)
+    get_target_property(_addons_inc KF6::WidgetsAddons INTERFACE_INCLUDE_DIRECTORIES)
+    if(_addons_inc)
+        target_include_directories(KF6Completion SYSTEM PRIVATE ${_addons_inc})
+    endif()
+    unset(_addons_inc)
+endif()
+
 target_link_libraries(KF6Completion PUBLIC Qt6::Widgets
-                                    PRIVATE KF6::ConfigCore      # KConfigGroup, used in many places
-                                            KF6::ConfigGui       # KStandardShortcut
-                                            KF6::WidgetsAddons   # KCursor
+                                    PRIVATE -lKF6ConfigCore   # KConfigGroup, used in many places
+                                            -lKF6ConfigGui    # KStandardShortcut
+                                            -lKF6WidgetsAddons # KCursor
                                             KF6::Codecs # KEmailAddress
 )
 
 ecm_generate_headers(KCompletion_HEADERS
   HEADER_NAMES
   KComboBox
   KCompletion
   KCompletionBase
