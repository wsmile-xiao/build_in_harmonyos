--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -46,20 +46,33 @@
     PACKAGE_VERSION_FILE "${CMAKE_CURRENT_BINARY_DIR}/KSaneCore${KSANECORE_SUFFFIX}ConfigVersion.cmake"
     SOVERSION 1
 )
 
 # Dependencies
 # Required Qt components to build this framework
 find_package(Qt6 ${REQUIRED_QT_VERSION} NO_MODULE REQUIRED Core Gui)
 # Required KDE Frameworks
 find_package(KF6I18n ${KF_MIN_VERSION} REQUIRED)
 
+# R05: relocatable linkage. The KF6 dependency libraries are published without a
+# DT_SONAME, so linking this project's libraries against their absolute Conan
+# cache paths makes the linker record the machine-private path in DT_NEEDED
+# (non-consumable on a different cache layout). Stamp an IMPORTED_SONAME on the
+# KF6::I18n dependency and clear both the generic and per-config
+# IMPORTED_NO_SONAME so CMake links by `-L<dir> -l:libKF6I18n.so` and ld
+# records the basename.
+if(TARGET KF6::I18n)
+    set_property(TARGET KF6::I18n PROPERTY IMPORTED_NO_SONAME FALSE)
+    set_property(TARGET KF6::I18n PROPERTY IMPORTED_NO_SONAME_RELEASE FALSE)
+    set_property(TARGET KF6::I18n PROPERTY IMPORTED_SONAME "libKF6I18n.so")
+endif()
+
 # Check if sane API is available.
 find_package(Sane REQUIRED)
 message(STATUS "SANE_FOUND:       ${SANE_FOUND}")
 message(STATUS "SANE_INCLUDE_DIR: ${SANE_INCLUDE_DIR}")
 message(STATUS "SANE_LIBRARY:     ${SANE_LIBRARY}")
 
 ecm_set_disabled_deprecation_versions(QT 6.4
     KF 5.101
 )
 
