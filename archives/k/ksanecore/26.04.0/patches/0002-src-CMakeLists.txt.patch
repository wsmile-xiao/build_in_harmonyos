--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -52,27 +52,46 @@
     ${_generate_export_header_version_args}
 )
 
 target_include_directories(KSaneCore${KSANECORE_SUFFFIX}
     INTERFACE
         "$<INSTALL_INTERFACE:${KDE_INSTALL_INCLUDEDIR}/KSaneCore${KSANECORE_SUFFFIX}>"
     PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}/options
 )
 
+# R05/R07: relocatable linkage. KF6I18n is published without a DT_SONAME,
+# so linking by its absolute Conan cache path makes the linker record the
+# machine-private path in DT_NEEDED (non-consumable on a different cache
+# layout). Link by SONAME-style basename with a PRIVATE -L so ld records
+# `libKF6I18n.so`; the dependency is propagated to consumers via the INTERFACE
+# imported target metadata.
+target_link_directories(KSaneCore${KSANECORE_SUFFFIX} PRIVATE ${KSANECORE_DEP_LIB_DIRS})
+
+# Keep the include directories needed to build this library. They are added as
+# PRIVATE so producer absolute cache paths are never exported to consumers;
+# consumers obtain KF6/Qt includes transitively through their own imported
+# targets (kpackage 6.26.0 precedent).
+if(TARGET KF6::I18n)
+    get_target_property(_i18n_inc KF6::I18n INTERFACE_INCLUDE_DIRECTORIES)
+    if(_i18n_inc)
+        target_include_directories(KSaneCore${KSANECORE_SUFFFIX} SYSTEM PRIVATE ${_i18n_inc})
+    endif()
+endif()
+
 target_link_libraries(KSaneCore${KSANECORE_SUFFFIX}
     PUBLIC
         Qt6::Core
         Qt6::Gui
     PRIVATE
         Sane::Sane
-        KF6::I18n
+        -lKF6I18n
 )
 
 ecm_generate_headers(KSaneCore_CamelCase_HEADERS
     HEADER_NAMES
         Interface
         Option
         DeviceInformation
     REQUIRED_HEADERS KSaneCore_HEADERS
     PREFIX KSaneCore
     RELATIVE "../src/"
