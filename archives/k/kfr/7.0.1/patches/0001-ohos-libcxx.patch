--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -377,7 +377,15 @@ if (WIN32)
 endif ()
 
 set(STD_LIB)
-if (NOT IOS AND NOT ANDROID)
+# OHOS portability: the HarmonyOS NDK ships libc++ only, and clang++ selects it
+# by itself, so asking the linker for libstdc++ (-lstdc++, inherited through the
+# INTERFACE of the kfr target by kfr_io/kfr_dsp/kfr_audio/kfr_dft and by every
+# consumer) fails to resolve.  CMake's platform name is not a usable trigger on
+# a native OHOS build, so the Conan recipe passes the new KFR_LINK_LIBSTDCXX
+# switch explicitly; every other configuration keeps the upstream behaviour.
+if (DEFINED KFR_LINK_LIBSTDCXX AND NOT KFR_LINK_LIBSTDCXX)
+    set(STD_LIB)
+elseif (NOT IOS AND NOT ANDROID)
     set(STD_LIB stdc++)
 endif ()
 
