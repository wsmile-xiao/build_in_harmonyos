--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -25,7 +25,10 @@
 
 project(kfr CXX)
 
-set(CMAKE_CXX_STANDARD 14)
+# OHOS portability: 17, not 14. Matches the cppstd=17 the OHOS Conan
+# profile mandates and makes variable-template specialisations
+# implicitly inline (see the header patch as well).
+set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CXX_EXTENSIONS ON)
 
@@ -104,7 +107,9 @@
     add_definitions(-D_ENABLE_EXTENDED_ALIGNED_STORAGE)
 endif()
 
-if (IOS)
+if (IOS OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    # OHOS ships libc++ only; clang++ adds it automatically, so do not ask the
+    # linker for libstdc++ (-lstdc++ would be an unresolved library).
     set(STD_LIB)
 else ()
     set(STD_LIB stdc++)
@@ -121,7 +126,8 @@
 target_sources(kfr INTERFACE ${KFR_SRC})
 target_include_directories(kfr INTERFACE include)
 target_compile_options(kfr INTERFACE "$<$<CONFIG:DEBUG>:-DKFR_DEBUG>")
-if (NOT MSVC AND NOT IOS)
+if (NOT MSVC AND NOT IOS AND X86)
+    # -mstackrealign is an x86-only driver flag; clang rejects it on aarch64.
     target_compile_options(kfr INTERFACE -mstackrealign)
 endif ()
 if (MSVC)
