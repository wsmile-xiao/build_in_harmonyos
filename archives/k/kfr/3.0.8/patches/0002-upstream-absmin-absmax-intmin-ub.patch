+// Backport of upstream kfr commit cabdebd284 "Avoid undefined behavior in
+// absmin and absmax" (2019-11-25), which postdates the v3.0.8 tag
+// (d1ef651da3, 2019-03-15). v3.0.8 ALREADY provides the 4th predicate hook of
+// test_function2 (include/kfr/simd/vec.hpp:1126), and the commits between the
+// tag and cabdebd284 that touch the harness are not prerequisites, so no
+// prerequisite backport is required. The only mechanical adaptation is
+// qualifying two traits: upstream (2019-11) used cometa's unqualified
+// is_floating_point / is_unsigned, which do not exist in v3.0.8's headers.
+// std:: equivalents are used instead. Effect is unchanged: the reference
+// lambda `x = x >= 0 ? x : -x` has signed-overflow UB when
+// x == std::numeric_limits<T>::min(), so that genuinely-undefined input domain
+// is excluded from the test matrix. The kfr library implementation is NOT
+// touched and no expected value is altered.
+struct IsNotMinInt
+{
+    template <typename T>
+    bool operator()(ctype_t<T>, identity<T> x, identity<T> y) const
+    {
+        return std::is_floating_point<T>::value || std::is_unsigned<T>::value ||
+               (x != std::numeric_limits<T>::min() && y != std::numeric_limits<T>::min());
+    }
+    template <typename T, size_t N>
+    bool operator()(ctype_t<vec<T, N>>, identity<T> x, identity<T> y) const
+    {
+        return operator()(ctype<T>, x, y);
+    }
+};
+
