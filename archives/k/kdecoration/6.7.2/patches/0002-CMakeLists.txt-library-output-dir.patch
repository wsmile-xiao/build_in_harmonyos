@@ -18,6 +18,14 @@
 include(KDEInstallDirs)
 include(KDECompilerSettings NO_POLICY_SCOPE)
 include(KDECMakeSettings)
+# HarmonyOS: KDECMakeSettings (ECM >= 5.38) points
+# CMAKE_LIBRARY_OUTPUT_DIRECTORY at ${CMAKE_BINARY_DIR}/bin for every
+# platform, which makes the linker record a bin/-relative NEEDED entry
+# ("../bin/libkdecorations3private.so") for the private sibling library
+# that breaks after installation into lib/. Keep shared libraries in
+# ${CMAKE_BINARY_DIR}/lib (mirroring the ANDROID branch in
+# KDECMakeSettings) so the NEEDED entry stays a bare soname.
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
 include(ECMSetupVersion)
