+#if defined(KCODECS_USE_ICONV_FALLBACK)
+namespace
+{
+bool decodeWithIconv(QByteArrayView input, const QByteArray &charset, QString *result)
+{
+    if (charset.isEmpty()) {
+        return false;
+    }
+
+    iconv_t cd = iconv_open("UTF-8", charset.constData());
+    if (cd == reinterpret_cast<iconv_t>(-1)) {
+        return false;
+    }
+
+    QByteArray output;
+    output.resize(static_cast<int>(input.size() * 4 + 16));
+
+    ICONV_CONST char *inBuf = const_cast<char *>(input.data());
+    size_t inBytesLeft = static_cast<size_t>(input.size());
+    char *outBuf = output.data();
+    size_t outBytesLeft = static_cast<size_t>(output.size());
+
+    while (true) {
+        const size_t rc = iconv(cd, &inBuf, &inBytesLeft, &outBuf, &outBytesLeft);
+        if (rc != static_cast<size_t>(-1)) {
+            break;
+        }
+        if (errno != E2BIG) {
+            iconv_close(cd);
+            return false;
+        }
+
+        const qsizetype used = outBuf - output.data();
+        output.resize(output.size() * 2);
+        outBuf = output.data() + used;
+        outBytesLeft = static_cast<size_t>(output.size() - used);
+    }
+
+    output.truncate(static_cast<int>(outBuf - output.data()));
+    iconv_close(cd);
+    *result = QString::fromUtf8(output);
+    return true;
+}
+} // namespace
+#endif
