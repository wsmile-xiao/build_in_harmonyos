@@ -4,31 +4,61 @@
 
 cmake_minimum_required(VERSION 3.16)
 
+# HarmonyOS PC (OHOS): upstream is Qt5/Qt6 dual-version via
+# ${QT_MAJOR_VERSION}; the ohpcd build graph only ships Qt6, pin it here
+# (upstream normally derives it from the ECM toolchain on Linux).
+set(QT_MAJOR_VERSION 6 CACHE STRING "Qt major version" FORCE)
 set(KF_MIN_VERSION "5.96.0")
 set(KDE_COMPILERSETTINGS_LEVEL "5.84.0")
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
+# HarmonyOS PC (OHOS): find_package(ECM) sits before project() upstream;
+# CMAKE_TOOLCHAIN_FILE (and the conan_cmakedeps_paths.cmake include it
+# performs) is only processed at the project() call, so the ECM prefix
+# is not visible that early (CI first-round error: ECMConfig.cmake not
+# found at CMakeLists.txt:16). Pure reorder: project() moves up, the
+# ECM lookup follows immediately after.
+project(kup)
+
 find_package(ECM ${KF_MIN_VERSION} REQUIRED NO_MODULE)
 set(CMAKE_MODULE_PATH ${ECM_MODULE_PATH})
 
-project(kup)
-
-find_package(LibGit2 REQUIRED)
+# HarmonyOS PC (OHOS): libgit2 comes from the ohpcd conan package
+# (target libgit2::libgit2package, CONFIG mode via its own installed
+# libgit2Config.cmake); the ECM FindLibGit2 module probes the system
+# prefix and finds nothing on OHOS.
+find_package(libgit2 REQUIRED)
+# The package exports INTERFACE_INCLUDE_DIRECTORIES as <pkg>/./include/git2.
+# Repoint it to <pkg>/include:
+#  - kup includes the headers as <git2/global.h>, which only resolves from
+#    <pkg>/include (the git2 subdir on the search path would only resolve
+#    <global.h>);
+#  - include/git2/stdint.h is libgit2's MSVC-compat shim; on clang it
+#    preprocesses to nothing yet shadows the real musl <stdint.h> on the
+#    -I search path, leaving libc++'s "using ::intmax_t" unresolved
+#    (kup-filedigger mocs_compilation.cpp <ratio> errors, CI rounds 4-6;
+#    kup-daemon links no libgit2 and compiled fine throughout).
+get_target_property(_git2_inc_dirs libgit2::libgit2package INTERFACE_INCLUDE_DIRECTORIES)
+if(_git2_inc_dirs)
+    set(_git2_fixed_dirs "")
+    foreach(_git2_dir IN LISTS _git2_inc_dirs)
+        string(REPLACE "/./include/git2" "/include" _git2_dir "${_git2_dir}")
+        list(APPEND _git2_fixed_dirs "${_git2_dir}")
+    endforeach()
+    set_target_properties(libgit2::libgit2package PROPERTIES
+        INTERFACE_INCLUDE_DIRECTORIES "${_git2_fixed_dirs}")
+endif()
 
