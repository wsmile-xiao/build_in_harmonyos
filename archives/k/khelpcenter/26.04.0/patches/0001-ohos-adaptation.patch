+# OHOS adaptation: the upstream khelpcenter GUI executable (Qt
+# WebEngineWidgets-based help viewer) is trimmed from this build because
+# qtwebengine is not published to the ohpcd conan registry and the
+# qtbase/6.11.1 package does not provide Qt6::PrintSupport /
+# Qt6::WebEngineWidgets (algobox 1.1.1 recipe precedent). The delivered
+# artifacts on HarmonyOS PC are the headless Xapian search stack:
+#   - khcdocmetainfo shared library (docentry/docmetainfo/docentrytraverser
+#     plus the generated kcfg settings, consumed by embedding applications
+#     and the upstream tests)
+#   - khc_xapianindexer / khc_xapiansearch command line tools
+#   - the khelpcenter data files (plugins, templates, glossary/toc xslt)
+# All the search-stack sources depend only on Qt6::Core/Gui and
+# KF6::Archive/Config/ConfigWidgets/CoreAddons/DocTools/I18n, none of which
+# require WebEngine.
+
+add_library(khcdocmetainfo SHARED)
+
+target_sources(khcdocmetainfo PRIVATE
     docmetainfo.cpp
-    docentrytraverser.cpp
-    grantleeformatter.cpp
-    glossary.cpp
-    toc.cpp
-    mainwindow.cpp
     docentry.cpp
-    history.cpp
