 // macOS does not have fmemopen, but has funopen
 // BSD may not have fmemopen
 // Most Linux distros do have fmemopen
+// OHOS/HarmonyOS portability: tmpfile() hardcodes /tmp which may be
+// missing or not writable in the HarmonyOS sandbox/CI workers, so it
+// returns NULL and the API test aborts at "fmemopen failed". Fall back
+// to a TMPDIR/TMP/TEMP-aware mkstemp file (unlinked immediately to keep
+// tmpfile anonymity) when tmpfile() fails. Semantics unchanged.
+#include <unistd.h>
+static inline FILE* kanzi_tmpfile_with_env(void)
+{
+    const char* d = getenv("TMPDIR");
+    if (d == NULL || *d == '\0')
+        d = getenv("TMP");
+    if (d == NULL || *d == '\0')
+        d = getenv("TEMP");
+    if (d == NULL || *d == '\0')
+        d = "/tmp";
+    char path[1024];
+    /* snprintf truncation still yields a usable template when the dir is
+       extremely long; mkstemp validates the result. */
+    snprintf(path, sizeof(path), "%s/kanzi_api_XXXXXX", d);
+    int fd = mkstemp(path);
+    if (fd < 0)
+        return NULL;
+    /* Keep tmpfile() anonymity: remove the directory entry, the FILE*
+       stays valid until fclose(). Ignore unlink errors (e.g. sandbox
+       restrictions); the fclose() still cleans the descriptor. */
+    unlink(path);
+    FILE* f = fdopen(fd, "w+b");
+    if (f == NULL)
+        close(fd);
+    return f;
+}
