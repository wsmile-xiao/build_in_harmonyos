--- a/src/lib/testutils/dhcp_test_lib.sh.in
+++ b/src/lib/testutils/dhcp_test_lib.sh.in
@@ -932,8 +932,17 @@
     # Keep ${long_version} unquoted so that it is not included as an empty
     # string if not given as argument.
     for v in -v ${long_version}; do
-        run_command \
-            "${bin_path}/${bin}" "${v}"
+        # A shell script cannot be execve()-ed on the HarmonyOS PC (shebang
+        # execution is denied regardless of the executable bits), so script
+        # tools are started through sh while ELF binaries keep being executed
+        # directly.
+        if test "$(head -c 2 "${bin_path}/${bin}")" = '#!'; then
+            run_command \
+                sh "${bin_path}/${bin}" "${v}"
+        else
+            run_command \
+                "${bin_path}/${bin}" "${v}"
+        fi
 
         if test "${OUTPUT}" != "${EXPECTED_VERSION}"; then
             printf 'ERROR: Expected version "%s", got "%s" when calling "%s"\n' \
