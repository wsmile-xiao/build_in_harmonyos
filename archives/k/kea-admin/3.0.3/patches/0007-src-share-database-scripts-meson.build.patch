-mysql_scripts_conf_data.set('datarootdir', '${prefix}/' + DATADIR)
+# Resolve the shared scripts directory relative to the script location at
+# run time instead of baking in the absolute installation prefix: the package
+# ships the scripts under <package>/share/kea/scripts, where the configured
+# /share/kea path (--prefix=/) does not exist.  The value lands inside the
+# quoted admin-utils.sh sourcing line of the generated scripts and walks up
+# from <root>/share/kea/scripts/mysql/<script> to <root>/share.
+mysql_scripts_conf_data.set('datarootdir', '$(cd "$(dirname "${0}")/../../.." && pwd)')
 mysql_scripts_conf_data.set('PACKAGE_NAME', 'kea')
 configure_file(
     input: 'wipe_data.sh.in',
