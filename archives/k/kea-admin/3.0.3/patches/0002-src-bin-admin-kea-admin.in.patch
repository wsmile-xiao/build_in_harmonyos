+    # Resolve the installation root relative to the location of this script
+    # instead of the absolute prefix baked in at configure time: the package
+    # ships kea-admin in <root>/bin and the shared scripts in
+    # <root>/share/kea/scripts, where the configured /share/kea path
+    # (--prefix=/) does not exist.
+    package_root=$(cd "${script_path}/.." && pwd)
+    admin_utils="${package_root}/share/kea/scripts/admin-utils.sh"
+    KEA_LFC="${package_root}/bin/kea-lfc"
+    SCRIPTS_DIR="${package_root}/share/kea/scripts"
 fi
 
+# The default scripts directory printed by usage() is the one resolved above.
+SCRIPTS_DIR_DEFAULT="${SCRIPTS_DIR}"
+
 # shellcheck source=src/bin/admin/admin-utils.sh.in
 . "${admin_utils}"
 
