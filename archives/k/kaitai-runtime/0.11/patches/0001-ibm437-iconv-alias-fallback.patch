--- a/kaitai/kaitaistream.cpp	2026-09-03 10:08:54.207242188 +0800
+++ b/kaitai/kaitaistream.cpp	2026-09-03 10:08:54.247241719 +0800
@@ -917,7 +917,21 @@
 
     if (cd == (iconv_t)-1) {
         if (errno == EINVAL) {
-            throw unknown_encoding(src_enc);
+            // HarmonyOS/musl iconv 对同一代码页使用不同别名（如 IBM437 → CP437），
+            // 失败时用平台兼容别名重试，保持与 glibc 一致的编码名兼容性。
+            std::string enc(src_enc);
+            std::string alias;
+            if (enc == "IBM437") {
+                alias = "CP437";
+            } else if (enc == "IBM-437") {
+                alias = "CP437";
+            }
+            if (!alias.empty()) {
+                cd = iconv_open(KS_STR_DEFAULT_ENCODING, alias.c_str());
+            }
+            if (cd == (iconv_t)-1) {
+                throw unknown_encoding(src_enc);
+            }
         } else {
             throw bytes_to_str_error("error opening iconv");
         }
