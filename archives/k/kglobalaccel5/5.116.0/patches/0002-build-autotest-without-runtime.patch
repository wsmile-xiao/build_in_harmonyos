--- a/autotests/CMakeLists.txt
+++ b/autotests/CMakeLists.txt
@@ -20,4 +20,23 @@
         kglobalshortcuttest.cpp
         LINK_LIBRARIES Qt${QT_MAJOR_VERSION}::Test KF5::GlobalAccelPrivate ${additionalLibraries}
     )
+else()
+    # Build the upstream autotest even when the runtime daemon is excluded
+    # (OHOS: the kglobalacceld daemon is X11/XCB-only and non-functional).
+    # Upstream guards the test on BUILD_RUNTIME only because it links the
+    # daemon-side private target KF5::GlobalAccelPrivate; the test source
+    # itself exercises the public KF5::GlobalAccel API plus
+    # src/sequencehelpers_p.cpp (whose helpers are exported for exactly this
+    # unit test). Link the public library and compile the helper TU in, so
+    # the suite still builds and self-skips at runtime when the daemon
+    # service is absent (initTestCase probes org.kde.kglobalaccel).
+    ecm_add_tests(
+        kglobalshortcuttest.cpp
+        LINK_LIBRARIES Qt${QT_MAJOR_VERSION}::Test KF5::GlobalAccel ${additionalLibraries}
+    )
+    target_sources(kglobalshortcuttest PRIVATE ../src/sequencehelpers_p.cpp)
+    target_include_directories(kglobalshortcuttest PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}/../src
+        ${CMAKE_CURRENT_BINARY_DIR}/../src
+    )
 endif()
