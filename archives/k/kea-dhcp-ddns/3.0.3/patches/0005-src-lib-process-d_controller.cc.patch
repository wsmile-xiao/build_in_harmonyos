+    // OpenHarmony PC platform tooling (packaging smoke tests) and common
+    // command-line conventions probe executables with --version and --help,
+    // which the stock short options (-v/-V) do not accept.  Handle them as
+    // pure aliases before getopt(): --version prints the version exactly
+    // like -v does and --help prints the usage text; both exit successfully.
+    for (int i = 1; i < argc; ++i) {
+        if (std::string(argv[i]) == "--version") {
+            isc_throw(VersionMessage, getVersion(false));
+        }
+        if (std::string(argv[i]) == "--help") {
+            usage("");
+            isc_throw(VersionMessage, "");
+        }
+    }
+
