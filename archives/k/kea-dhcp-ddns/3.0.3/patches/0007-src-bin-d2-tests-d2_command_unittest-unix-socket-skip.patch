+    /// @brief Checks whether the host can host AF_UNIX pathname sockets
+    /// in the configured socket path directory.
+    ///
+    /// Some sandboxed platforms refuse bind() of path-based unix sockets
+    /// outright (e.g. HarmonyOS PC, whose user storage is an hmdfs mount),
+    /// or the resolved path exceeds the sockaddr_un size limit.  Tests
+    /// covering the unix command channel use this to detect such hosts.
+    ///
+    /// @return true if a probe socket can be created in the socket path
+    /// directory and removed again.
+    static bool unixControlSocketsUsable() {
+        std::string probe_path = UnixCommandConfig::getSocketPath() +
+                                 "/d2-socket-probe";
+        struct sockaddr_un addr;
+        std::memset(&addr, 0, sizeof(addr));
+        addr.sun_family = AF_UNIX;
+        if (probe_path.size() >= sizeof(addr.sun_path)) {
+            return (false);
+        }
+        std::memcpy(addr.sun_path, probe_path.c_str(), probe_path.size());
+        int fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+        if (fd < 0) {
+            return (false);
+        }
+        static_cast<void>(::unlink(probe_path.c_str()));
+        bool usable = (::bind(fd, reinterpret_cast<struct sockaddr*>(&addr),
+                              sizeof(addr)) == 0);
+        static_cast<void>(::close(fd));
+        static_cast<void>(::unlink(probe_path.c_str()));
+        return (usable);
+    }
