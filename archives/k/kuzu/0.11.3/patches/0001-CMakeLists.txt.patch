diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -183,20 +183,42 @@
     set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} /STACK:8388608")
 
     string(REGEX REPLACE "/W[3|4]" "/w" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
     add_compile_options($<$<CONFIG:Release>:/W0>)
 else()
     add_compile_options(-Wall -Wextra)
     # Disable warnings for unknown pragmas, which is used by several third-party libraries
     add_compile_options(-Wno-unknown-pragmas)
 endif()
 
+# HarmonyOS (aarch64) adaptation: disable unsupported SimSIMD intrinsics
+# SVE/SVE2: not enabled on clang 15.0.4 / HarmonyOS aarch64
+# NEON_I8/NEON_BF16/NEON_F16: not available on clang 15.0.4
+# x86 SIMD: not applicable on aarch64
+# Dynamic dispatch: mrs system register access not available
+add_compile_definitions(SIMSIMD_DYNAMIC_DISPATCH=0)
+add_compile_definitions(SIMSIMD_NATIVE_F16=0)
+add_compile_definitions(SIMSIMD_NATIVE_BF16=0)
+add_compile_definitions(SIMSIMD_TARGET_NEON=1)
+add_compile_definitions(SIMSIMD_TARGET_SVE=0)
+add_compile_definitions(SIMSIMD_TARGET_SVE2=0)
+add_compile_definitions(SIMSIMD_TARGET_NEON_I8=0)
+add_compile_definitions(SIMSIMD_TARGET_NEON_BF16=0)
+add_compile_definitions(SIMSIMD_TARGET_NEON_F16=0)
+add_compile_definitions(SIMSIMD_TARGET_HASWELL=0)
+add_compile_definitions(SIMSIMD_TARGET_SKYLAKE=0)
+add_compile_definitions(SIMSIMD_TARGET_ICE=0)
+add_compile_definitions(SIMSIMD_TARGET_GENOA=0)
+add_compile_definitions(SIMSIMD_TARGET_SAPPHIRE=0)
+add_compile_definitions(SIMSIMD_TARGET_TURIN=0)
+add_compile_definitions(SIMSIMD_TARGET_SIERRA=0)
+
 if(${BUILD_WASM})
     if(NOT __SINGLE_THREADED__)
         add_compile_options(-pthread)
         add_link_options(-pthread)
         add_link_options(-sPTHREAD_POOL_SIZE=8)
     endif()
     add_compile_options(-s DISABLE_EXCEPTION_CATCHING=0)
     add_link_options(-sSTACK_SIZE=4MB)
     add_link_options(-sASSERTIONS=1)
     add_link_options(-lembind)
