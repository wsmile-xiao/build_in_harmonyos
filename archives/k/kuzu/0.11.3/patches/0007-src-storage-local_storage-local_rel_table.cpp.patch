diff -ruN a/src/storage/local_storage/local_rel_table.cpp b/src/storage/local_storage/local_rel_table.cpp
--- a/src/storage/local_storage/local_rel_table.cpp
+++ b/src/storage/local_storage/local_rel_table.cpp
@@ -142,21 +142,22 @@
     if (deleteState.relIDVector.isNull(relIDPos)) {
         return false;
