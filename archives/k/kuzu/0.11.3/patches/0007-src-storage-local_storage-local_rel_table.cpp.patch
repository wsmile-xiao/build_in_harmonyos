     const auto relOffset = deleteState.relIDVector.readNodeOffset(relIDPos);
     const auto matchedRow = findMatchingRow(transaction, rowIndicesToDeleteFrom, relOffset);
     if (matchedRow == INVALID_ROW_IDX) {
         return false;
