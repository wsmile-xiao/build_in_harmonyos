--- a/testsuite/module-playground/Makefile
+++ b/testsuite/module-playground/Makefile
@@ -19,10 +19,20 @@
 	$(eval arch=$(patsubst mod-simple-%.ko,%,$@))
 	$(MAKE) KDIR=$(KDIR_$(arch)) ARCH=$(arch) CROSS_COMPILE=$(CROSS_COMPILE_$(arch)) -f Makefile.arch
 
+# The stub-linux/ tree provides minimal kernel-style headers (linux/module.h
+# etc.) so the dummy kernel modules can be compiled with the native clang
+# without a Linux kernel kbuild tree, which does not exist on OHOS.
+STUB_INCLUDES := $(abspath stub-linux)
+CC ?= clang
+
 modules:
-	$(MAKE) -C $(KDIR) M=$$PWD modules
+	@set -e; for f in *.c; do \
+		name="$${f%.c}"; \
+		$(CC) -c $(CFLAGS) -I$(STUB_INCLUDES) -include $(STUB_INCLUDES)/vermagic.h \
+			-DKBUILD_MODNAME="\"$$name\"" -o "$$name.ko" "$$f"; \
+	done
 
 arch-modules: $(ARCH_SPECIFIC_MODULES)
 
 clean:
-	$(MAKE) -C $(KDIR) M=$$PWD clean
+	rm -f *.ko *.o
