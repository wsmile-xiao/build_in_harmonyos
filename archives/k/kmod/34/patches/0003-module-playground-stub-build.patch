@@ -0,0 +1,8 @@
+#ifndef _LINUX_EXPORT_H
+#define _LINUX_EXPORT_H
+/* Emit each exported symbol NAME into the __ksymtab_strings section, which
+ * libkmod reads to build the exported-symbol list (modprobe --show-exports). */
+#define EXPORT_SYMBOL(sym) \
+	static const char __attribute__((used,__section__("__ksymtab_strings"))) __ksymtab_str_##sym[] = #sym
+#define EXPORT_SYMBOL_GPL(sym) EXPORT_SYMBOL(sym)
+#endif
