--- /dev/null
+++ b/testsuite/module-playground/stub-linux/vermagic.h
@@ -0,0 +1,16 @@
+#ifndef _STUB_VERMAGIC_H
+#define _STUB_VERMAGIC_H
+#include <linux/module.h>
+MODULE_INFO(vermagic, "6.1.0-ohos-generic SMP mod_unload aarch64");
+
+/* Emit the kernel-style .gnu.linkonce.this_module section with the module
+ * name at MODULE_NAME_OFFSET_64 (24, = struct module state+padding+list_head)
+ * so the testsuite init_module() override can extract it and record the
+ * module as loaded. KBUILD_MODNAME comes from -D per module. */
+struct stub_module {
+	char pad[24];
+	char name[56];
+};
+static const struct stub_module __attribute__((used, __section__(".gnu.linkonce.this_module")))
+	__this_module = { .name = KBUILD_MODNAME };
+#endif
