--- a/tools/log.c
+++ b/tools/log.c
@@ -6,11 +6,32 @@
 #include <errno.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 #include <syslog.h>
 
 #include <libkmod/libkmod.h>
 
 #include "kmod.h"
+
+#if !defined(__GLIBC__) && !defined(__ANDROID__)
+/* musl/bionic lack the glibc program_invocation_* globals; define them from
+ * __progname (basename) so kmod multi-call dispatch and logging still work. */
+extern char *__progname;
+
+char *program_invocation_name;
+char *program_invocation_short_name;
+
+static void __attribute__((constructor)) _init_program_invocation(void)
+{
+	char *slash;
+
+	program_invocation_name = __progname;
+	program_invocation_short_name = __progname;
+	if (program_invocation_short_name != NULL &&
+	    (slash = strrchr(program_invocation_short_name, '/')) != NULL)
+		program_invocation_short_name = slash + 1;
+}
+#endif
 
 #define PRIO_MAX_SIZE 32
 
--- a/shared/util.c
+++ b/shared/util.c
@@ -18,6 +18,11 @@
 
 #include <shared/missing.h>
 #include <shared/util.h>
+
+#if !defined(__GLIBC__) && !defined(get_current_dir_name)
+/* glibc extension: return malloc'd cwd; POSIX getcwd(NULL, 0) allocates too. */
