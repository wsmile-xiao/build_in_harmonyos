--- a/config.h.in
+++ b/config.h.in
@@ -1,5 +1,16 @@
 /* config.h.in.  Generated from configure.ac by autoheader.  */
 
+/* OHOS/musl portability: the SDK's <linux/netlink.h> (also reached through
+ * libnl's <netlink/netlink.h>) pulls an Android-generated <linux/socket.h>
+ * that defines `struct sockaddr_storage`, which collides with musl's
+ * <sys/socket.h> and fails under this project's -Werror. Every source file
+ * includes this generated config header first, so suppress the kernel copy
+ * here and re-declare the single type <linux/netlink.h> still needs from it. */
+#ifndef _UAPI_LINUX_SOCKET_H
+#define _UAPI_LINUX_SOCKET_H
+typedef unsigned short __kernel_sa_family_t;
+#endif
+
 /* Define to 1 if you have the g_pattern_spec_match function. */
 #undef HAVE_GLIB_G_PATTERN_SPEC_MATCH
 
