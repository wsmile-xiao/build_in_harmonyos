+// The SFINAE guard below is keyed on the instantiated type instead of the template
+// identity: clang does not canonicalize alias templates used as template template
+// arguments (GCC does), so is_sequence_container<AliasTemplate> was always false and
+// enable_if_t<false> was evaluated eagerly while instantiating functor<AliasTemplate>
+// -- a hard error rather than a substitution failure. Keying on SequenceContainer<A>
+// keeps the same accept/reject set (std::vector / std::deque / std::list only) while
+// staying dependent on the member template parameter A, hence SFINAE-friendly.
+template <typename T>
+struct is_sequence_container_type : std::false_type {};
+
+template <typename T, typename Allocator>
+struct is_sequence_container_type<std::vector<T, Allocator>> : std::true_type {};
+
+template <typename T, typename Allocator>
+struct is_sequence_container_type<std::deque<T, Allocator>> : std::true_type {};
+
+template <typename T, typename Allocator>
+struct is_sequence_container_type<std::list<T, Allocator>> : std::true_type {};
+
+template <typename T>
+using enable_if_sequence_container = std::enable_if_t<is_sequence_container_type<T>::value>;
 
 }
 
