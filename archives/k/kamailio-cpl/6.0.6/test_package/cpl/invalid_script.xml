<?xml version="1.0" encoding="UTF-8"?>
<!--
  非法 CPL 脚本（对照随包 cpl-06.dtd 校验，须被拒绝）——负向对照，防止
  “校验器恒返回通过”的假绿。
  bogus-element 未在 cpl-06.dtd 中声明，且 address-switch 的内容模型
  ( address*, (not-present, address*)?, otherwise? ) 不允许该元素。
-->
<cpl>
  <incoming>
    <address-switch field="origin">
      <bogus-element/>
    </address-switch>
  </incoming>
</cpl>
