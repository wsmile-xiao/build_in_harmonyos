<?xml version="1.0" encoding="UTF-8"?>
<!--
  合法 CPL 脚本（对照随包 cpl-06.dtd 校验，须通过）。
  覆盖 cplc 解释器的主要节点类型：address-switch/address（Switch 节点）、
  otherwise（默认分支）、reject/proxy（SignallingAction 节点）。
  元素与属性均取自 cpl-06.dtd 声明：
    <!ELEMENT cpl ( ancillary?, subaction*, outgoing?, incoming? )>
    <!ELEMENT address-switch ( address*, (not-present, address*)?, otherwise? )>
    <!ATTLIST address-switch field CDATA #REQUIRED>
    <!ELEMENT reject EMPTY> <!ATTLIST reject status CDATA #REQUIRED reason CDATA #IMPLIED>
-->
<cpl>
  <incoming>
    <address-switch field="origin">
      <address is="sip:alice@example.com">
        <reject status="reject" reason="blocked by CPL script"/>
      </address>
      <otherwise>
        <proxy/>
      </otherwise>
    </address-switch>
  </incoming>
</cpl>
