From 4cc0f03cbc6636e3a271b9dba445ac6cf6939917 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sat, 19 Sep 2026 01:55:02 +0800
Subject: [PATCH] ohos: trim KIO and kdoctools; link KF6::CoreAddons explicitly

---
 CMakeLists.txt      | 11 +++++++----
 src/CMakeLists.txt  |  2 +-
 src/kgoldrunner.cpp |  8 ++++++--
 3 files changed, 14 insertions(+), 7 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5e763c2..2e35063 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -37,9 +37,7 @@ find_package(KF6 ${KF_MIN_VERSION} REQUIRED COMPONENTS
     CoreAddons
     Crash
     DBusAddons
-    DocTools
     I18n
-    KIO
     WidgetsAddons
     XmlGui
     IconThemes
@@ -53,12 +51,17 @@ ecm_set_disabled_deprecation_versions(
     KDEGAMES 6.0
 )
 
+# kdoctools (handbook generation) disabled on OHOS: the doc toolchain is
+# not part of the platform package set and the game data is self-contained.
+if(KF6DocTools_FOUND)
+    add_subdirectory(doc)
+endif()
+
 add_subdirectory(src)
 add_subdirectory(gamedata)
 add_subdirectory(themes)
-add_subdirectory(doc)
 
 ki18n_install(po)
-kdoctools_install(po)
+# kdoctools_install(po) - doc toolchain disabled on OHOS
 
 feature_summary(WHAT ALL FATAL_ON_MISSING_REQUIRED_PACKAGES)
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 783616b..c2ec6f5 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -62,9 +62,9 @@ ecm_add_app_icon(kgoldrunner ICONS ${ICONS_SRCS})
 
 target_link_libraries(kgoldrunner
     KDEGames6
+    KF6::CoreAddons
     KF6::ConfigWidgets
     KF6::DBusAddons
-    KF6::KIOCore
     KF6::Crash
     KF6::I18n
     KF6::WidgetsAddons
diff --git a/src/kgoldrunner.cpp b/src/kgoldrunner.cpp
index 2c8e4de..2acbd15 100644
--- a/src/kgoldrunner.cpp
+++ b/src/kgoldrunner.cpp
@@ -10,6 +10,7 @@
 
 #include <QAction>
 #include <QActionGroup>
+#include <QDir>
 #include <QIcon>
 #include <QKeyEvent>
 #include <QKeySequence>
@@ -19,7 +20,6 @@
 #include <KActionCollection>
 #include <KConfig>
 #include <KConfigGroup>
-#include <KIO/MkpathJob>
 #include <KLocalizedString>
 #include <KSharedConfig>
 #include <KShortcutsDialog>
@@ -885,7 +885,11 @@ bool KGoldrunner::getDirectories()
     // Locate and optionally create directories for user collections and levels.
     userDataDir   = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + QLatin1Char('/');
     QString levelDir = userDataDir + QStringLiteral("levels");
-    KIO::mkpath(QUrl::fromUserInput(levelDir))->exec();
+    // OHOS adaptation: KIO is not published on the platform registry; the
+    // single upstream use (KIO::mkpath) is replaced by the equivalent
+    // QDir().mkpath() call (creates the directory and any missing parent
+    // directories, returns true if the directory already exists).
+    QDir().mkpath(levelDir);
 
     return (result);
 }
-- 
2.45.2

