--- a/src/hooks/dhcp/forensic_log/rotating_file.cc
+++ b/src/hooks/dhcp/forensic_log/rotating_file.cc
@@ -352,20 +352,40 @@
     if (rotate_file) {
         close();

         if (!prerotate_.empty()) {
             ProcessArgs args;
+#if defined(__linux__) && !defined(__GLIBC__)
+            // The HarmonyOS PC kernel refuses script execve regardless of
+            // the executable bits, and ProcessSpawn::spawn() runs execve()
+            // directly with no shell fallback, so a shell-script prerotate
+            // command would die in the child.  Run it through /bin/sh: the
+            // script path becomes $1 to the shell, keeping the original
+            // argument semantics.  glibc/Linux targets keep the direct
+            // execve path, so non-script commands keep working there too.
+            args.push_back(prerotate_);
+            args.push_back(getFileName());
+            ProcessSpawn process(ProcessSpawn::ASYNC, "/bin/sh", args);
+#else
             args.push_back(getFileName());
             ProcessSpawn process(ProcessSpawn::ASYNC, prerotate_, args);
+#endif
             process.spawn(true);
         }

         openInternal(current_time_info, false);

         if (!postrotate_.empty()) {
             ProcessArgs args;
+#if defined(__linux__) && !defined(__GLIBC__)
+            // Same as the prerotate case above.
+            args.push_back(postrotate_);
+            args.push_back(getFileName());
+            ProcessSpawn process(ProcessSpawn::ASYNC, "/bin/sh", args);
+#else
             args.push_back(getFileName());
             ProcessSpawn process(ProcessSpawn::ASYNC, postrotate_, args);
+#endif
             process.spawn(true);
         }
     }
 }
