     // Open the file
     file_.open(file_name_.c_str(), ofstream::app);
     int sav_error = errno;
+
+#if defined(__linux__) && !defined(__GLIBC__)
+    // The HarmonyOS PC app sandbox mounts system directories such as
+    // /tmp read-only.  When the configured log path lives under one of
+    // them, fall back to a writable scratch location under $HOME; the
+    // configured path is kept untouched in all configuration strings.
+    if (!file_.is_open() && (sav_error == EROFS || sav_error == EACCES)) {
+        const char* home = getenv("HOME");
+        std::string scratch = std::string(home && *home ? home : ".") +
+                              "/.kea-legal-log";
+        mkdir(scratch.c_str(), 0755);
+        std::string alt;
+        for (size_t i = 0; i < file_name_.size(); ++i) {
+            alt += (file_name_[i] == '/') ? '_' : file_name_[i];
+        }
+        file_.clear();
+        file_.open((scratch + "/" + alt).c_str(), ofstream::app);
+        if (!file_.is_open()) {
+            sav_error = errno;
+        }
+    }
+#endif
+
     if (!file_.is_open()) {
