 set_target_properties(KF6Wallet PROPERTIES
-    VERSION     ${KWALLET_VERSION}
-    SOVERSION   ${KWALLET_SOVERSION}
+    # OHOS (E018 copy-instead-of-link fallback): the OHOS build sandbox denies
+    # symlink(2) for the conan process tree, so the versioned symlink chain
+    # cmake_symlink_library would create (libKF6Wallet.so.6 / libKF6Wallet.so)
+    # cannot materialize. The VERSION and SOVERSION properties are therefore
+    # left unset (setting them to empty strings still makes CMake emit a
+    # trailing-dot "libKF6Wallet.so." name and try to symlink), the build
+    # produces a plain libKF6Wallet.so, and the conan recipe restores the
+    # upstream DT_SONAME (libKF6Wallet.so.6) via the linker flags plus a copy
+    # of the soname file name in the package step.
     EXPORT_NAME Wallet
 )
 
