diff --git a/build.gradle b/build.gradle
index 244b2b0..140f043 100644
--- a/build.gradle
+++ b/build.gradle
@@ -64,3 +64,20 @@ jar {
         )
     }
 }
+
+// PATCHED for OHOS CI: preload the ByteBuddy agent via -javaagent at JVM
+// startup. On OHOS CI workers the dynamic attach API is unavailable (the
+// external attach helper hangs and self-attach fails with
+// IllegalStateException), which breaks Mockito inline mock maker init and
+// fails all 26 upstream @Test methods. With the agent preloaded at startup,
+// ByteBuddyAgent.install() finds the premain-registered Instrumentation and
+// returns immediately - no runtime attach needed.
+configurations {
+    byteBuddyAgent
+}
+dependencies {
+    byteBuddyAgent 'net.bytebuddy:byte-buddy-agent:1.14.6'
+}
+test {
+    jvmArgs "-javaagent:${configurations.byteBuddyAgent.singleFile}", '-Djdk.attach.allowAttachSelf=true'
+}
