+# OHOS (build_in_harmonyos): KF6::I18nQml (KLocalizedQmlContext) is not
+# published in the conan registry (ki18n builds with BUILD_WITH_QML=OFF). The
+# KLocalizedContext class from KF6::I18n provides the same QML i18n context
+# object; it is deprecated at KF 6.8 and hidden by
+# ecm_set_disabled_deprecation_versions below, so keep it visible.
+target_compile_definitions(keepsecret PRIVATE KI18N_DISABLE_DEPRECATED_BEFORE_AND_AT=0)
