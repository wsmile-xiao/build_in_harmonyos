index 0000000..194af4a
--- /dev/null
+++ b/src/qmlsortfilterproxymodel.h
@@ -0,0 +1,78 @@
+/*
+    SPDX-FileCopyrightText: 2025 Marco Martin <notmart@gmail.com>
+    SPDX-License-Identifier: GPL-2.0-or-later
+
+    OHOS (build_in_harmonyos): stand-in for the KSortFilterProxyModel QML type
+    that the org.kde.kitemmodels QML module normally provides. That module is
+    not published in the conan registry (the kitemodels recipe builds without
+    qtdeclarative, which skips the QML plugin), so the single
+    KSortFilterProxyModel use in CollectionContentsPage.qml is served by this
+    in-tree QSortFilterProxyModel subclass instead.
+*/
+#ifndef QMLSORTFILTERPROXYMODEL_H
+#define QMLSORTFILTERPROXYMODEL_H
+
+#include <QSortFilterProxyModel>
+#include <qqmlregistration.h>
+
+class QmlSortFilterProxyModel : public QSortFilterProxyModel
+{
+    Q_OBJECT
+    QML_ELEMENT
+    Q_PROPERTY(QString filterString READ filterString WRITE setFilterString NOTIFY filterStringChanged)
+    Q_PROPERTY(int filterRole READ filterRole WRITE setFilterRole NOTIFY filterRoleChanged)
+    Q_PROPERTY(QString filterRoleName READ filterRoleName WRITE setFilterRoleName NOTIFY filterRoleNameChanged)
+    Q_PROPERTY(Qt::CaseSensitivity filterCaseSensitivity READ filterCaseSensitivity WRITE setFilterCaseSensitivity NOTIFY filterCaseSensitivityChanged)
+    Q_PROPERTY(int sortRole READ sortRole WRITE setSortRole NOTIFY sortRoleChanged)
+    Q_PROPERTY(QString sortRoleName READ sortRoleName WRITE setSortRoleName NOTIFY sortRoleNameChanged)
+    Q_PROPERTY(Qt::CaseSensitivity sortCaseSensitivity READ sortCaseSensitivity WRITE setSortCaseSensitivity NOTIFY sortCaseSensitivityChanged)
+
+public:
+    explicit QmlSortFilterProxyModel(QObject *parent = nullptr);
+
+    QString filterString() const;
+    void setFilterString(const QString &filterString);
+
+    int filterRole() const;
+    void setFilterRole(int filterRole);
+
+    QString filterRoleName() const;
+    void setFilterRoleName(const QString &roleName);
+
+    Qt::CaseSensitivity filterCaseSensitivity() const;
+    void setFilterCaseSensitivity(Qt::CaseSensitivity caseSensitivity);
+
+    int sortRole() const;
+    void setSortRole(int sortRole);
+
+    QString sortRoleName() const;
+    void setSortRoleName(const QString &roleName);
+
+    Qt::CaseSensitivity sortCaseSensitivity() const;
+    void setSortCaseSensitivity(Qt::CaseSensitivity caseSensitivity);
+
+Q_SIGNALS:
+    void filterStringChanged();
+    void filterRoleChanged();
+    void filterRoleNameChanged();
+    void filterCaseSensitivityChanged();
+    void sortRoleChanged();
+    void sortRoleNameChanged();
+    void sortCaseSensitivityChanged();
+
+protected:
+    bool filterAcceptsRow(int sourceRow, const QModelIndex &sourceParent) const override;
+
+private:
+    int roleByName(const QString &roleName) const;
+
+    QString m_filterString;
+    int m_filterRole = -1;
+    QString m_filterRoleName;
+    int m_sortRole = -1;
+    QString m_sortRoleName;
+    Qt::CaseSensitivity m_filterCaseSensitivity = Qt::CaseInsensitive;
+    Qt::CaseSensitivity m_sortCaseSensitivity = Qt::CaseInsensitive;
+};
+
+#endif // QMLSORTFILTERPROXYMODEL_H
diff --git a/src/qmlsortfilterproxymodel.cpp b/src/qmlsortfilterproxymodel.cpp
new file mode 100644
index 0000000..da3e8b4
--- /dev/null
+++ b/src/qmlsortfilterproxymodel.cpp
@@ -0,0 +1,154 @@
+/*
+    SPDX-FileCopyrightText: 2025 Marco Martin <notmart@gmail.com>
+    SPDX-License-Identifier: GPL-2.0-or-later
+
+    OHOS (build_in_harmonyos): see qmlsortfilterproxymodel.h.
+*/
+
+#include "qmlsortfilterproxymodel.h"
+
+QmlSortFilterProxyModel::QmlSortFilterProxyModel(QObject *parent)
+    : QSortFilterProxyModel(parent)
+{
+    setDynamicSortFilter(true);
+}
+
+int QmlSortFilterProxyModel::roleByName(const QString &roleName) const
+{
+    if (roleName.isEmpty() || !sourceModel()) {
+        return -1;
+    }
+    const QHash<int, QByteArray> roles = sourceModel()->roleNames();
+    for (auto it = roles.constBegin(); it != roles.constEnd(); ++it) {
+        if (QString::fromUtf8(it.value()) == roleName) {
+            return it.key();
+        }
+    }
+    return -1;
+}
+
+QString QmlSortFilterProxyModel::filterString() const
+{
+    return m_filterString;
+}
+
+void QmlSortFilterProxyModel::setFilterString(const QString &filterString)
+{
+    if (m_filterString == filterString) {
+        return;
+    }
+    m_filterString = filterString;
+    invalidateFilter();
+    Q_EMIT filterStringChanged();
+}
+
+int QmlSortFilterProxyModel::filterRole() const
+{
+    return m_filterRole;
+}
+
+void QmlSortFilterProxyModel::setFilterRole(int filterRole)
+{
+    if (m_filterRole == filterRole) {
+        return;
+    }
+    m_filterRole = filterRole;
+    invalidateFilter();
+    Q_EMIT filterRoleChanged();
+}
+
+QString QmlSortFilterProxyModel::filterRoleName() const
+{
+    return m_filterRoleName;
+}
+
+void QmlSortFilterProxyModel::setFilterRoleName(const QString &roleName)
+{
+    if (m_filterRoleName == roleName) {
+        return;
+    }
+    m_filterRoleName = roleName;
+    const int role = roleByName(roleName);
+    if (role != -1) {
+        m_filterRole = role;
+        Q_EMIT filterRoleChanged();
+    }
+    invalidateFilter();
+    Q_EMIT filterRoleNameChanged();
+}
+
+Qt::CaseSensitivity QmlSortFilterProxyModel::filterCaseSensitivity() const
+{
+    return m_filterCaseSensitivity;
+}
+
+void QmlSortFilterProxyModel::setFilterCaseSensitivity(Qt::CaseSensitivity caseSensitivity)
+{
+    if (m_filterCaseSensitivity == caseSensitivity) {
+        return;
+    }
+    m_filterCaseSensitivity = caseSensitivity;
+    QSortFilterProxyModel::setFilterCaseSensitivity(caseSensitivity);
+    invalidateFilter();
+    Q_EMIT filterCaseSensitivityChanged();
+}
+
+int QmlSortFilterProxyModel::sortRole() const
+{
+    return m_sortRole;
+}
+
+void QmlSortFilterProxyModel::setSortRole(int sortRole)
+{
+    if (m_sortRole == sortRole) {
+        return;
+    }
+    m_sortRole = sortRole;
+    QSortFilterProxyModel::setSortRole(sortRole);
+    Q_EMIT sortRoleChanged();
+}
+
+QString QmlSortFilterProxyModel::sortRoleName() const
+{
+    return m_sortRoleName;
+}
+
+void QmlSortFilterProxyModel::setSortRoleName(const QString &roleName)
+{
+    if (m_sortRoleName == roleName) {
+        return;
+    }
+    m_sortRoleName = roleName;
+    const int role = roleByName(roleName);
+    if (role != -1) {
+        m_sortRole = role;
+        QSortFilterProxyModel::setSortRole(role);
+        Q_EMIT sortRoleChanged();
+    }
+    Q_EMIT sortRoleNameChanged();
+}
+
+Qt::CaseSensitivity QmlSortFilterProxyModel::sortCaseSensitivity() const
+{
+    return m_sortCaseSensitivity;
+}
+
+void QmlSortFilterProxyModel::setSortCaseSensitivity(Qt::CaseSensitivity caseSensitivity)
+{
+    if (m_sortCaseSensitivity == caseSensitivity) {
+        return;
+    }
+    m_sortCaseSensitivity = caseSensitivity;
+    QSortFilterProxyModel::setSortCaseSensitivity(caseSensitivity);
+    Q_EMIT sortCaseSensitivityChanged();
+}
+
+bool QmlSortFilterProxyModel::filterAcceptsRow(int sourceRow, const QModelIndex &sourceParent) const
+{
+    if (m_filterString.isEmpty() || m_filterRole < 0) {
+        return true;
+    }
+    const QModelIndex index = sourceModel()->index(sourceRow, 0, sourceParent);
+    const QString value = index.data(m_filterRole).toString();
+    return value.contains(m_filterString, m_filterCaseSensitivity);
+}
