From a077893b397e952e7c5120ac4dec8aff24dcd252 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Thu, 1 Oct 2026 20:03:02 +0800
Subject: [PATCH 1/2] ohos: trim Qt6 PrintSupport and KF6 DocTools

---
 CMakeLists.txt      | 10 +++++++---
 src/CMakeLists.txt  |  3 ---
 src/imagewindow.cpp | 11 +++++------
 src/kuickshow.cpp   | 16 ++++------------
 4 files changed, 16 insertions(+), 24 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 84fc567..844ae72 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -25,7 +25,6 @@ endif ()
 set(REQUIRED_QT_MODULES
 	Core
 	Gui
-	PrintSupport
 )
 if(IMLIB_FOUND OR IMLIB2_FOUND)
 	list(APPEND REQUIRED_QT_MODULES X11Extras)
@@ -33,7 +32,6 @@ endif ()
 find_package(Qt6 ${QT_MIN_VERSION} REQUIRED ${REQUIRED_QT_MODULES})
 
 find_package(KF6 ${KF_MIN_VERSION} REQUIRED COMPONENTS
-	DocTools
 	I18n
 	IconThemes
 	KIO
@@ -63,7 +61,13 @@ add_subdirectory( src )
 add_subdirectory( misc ) 
 add_subdirectory( pics ) 
 add_subdirectory( icons )
-add_subdirectory( doc )
+
+# OHOS: the kdoctools handbook toolchain is not part of the platform
+# package set (kfourinline 26.04.0 / kgoldrunner 26.04.0 precedent);
+# the DocBook handbook is not a runtime requirement for the viewer.
+if(KF6DocTools_FOUND)
+    add_subdirectory( doc )
+endif()
 
 ki18n_install(po)
 if(KF6DocTools_FOUND)
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 7b1e5e3..c366bdd 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -28,7 +28,6 @@ set(SOURCES
    imlibwidget.cpp 
    slideshowwidget.cpp 
    imagemods.cpp
-   printing.cpp
    openfilesanddirsdialog.cpp
    imagecache.cpp
    imlib.cpp
@@ -36,7 +35,6 @@ set(SOURCES
 
 ki18n_wrap_ui(SOURCES
    aboutwidget.ui
-   printing_page.ui
    generalwidget.ui
    defaultswidget.ui
    slideshowwidget.ui
@@ -73,7 +71,6 @@ target_compile_definitions(${MAIN_TARGET} PRIVATE -DQT_NO_URL_CAST_FROM_STRING)
 target_link_libraries(${MAIN_TARGET}
 	Qt6::Core
 	Qt6::Gui
-	Qt6::PrintSupport
 	KF6::I18n
 	KF6::IconThemes
 	KF6::KIOCore
diff --git a/src/imagewindow.cpp b/src/imagewindow.cpp
index 4b50f8d..5abebd3 100644
--- a/src/imagewindow.cpp
+++ b/src/imagewindow.cpp
@@ -70,7 +70,6 @@
 #include "kuick.h"
 #include "kuickconfig.h"
 #include "kuickimage.h"
-#include "printing.h"
 #include "imagecache.h"
 
 QCursor *ImageWindow::s_handCursor = nullptr;
@@ -901,11 +900,11 @@ void ImageWindow::printImage()
     if ( !m_kuim )
         return;
 
-    if ( !Printing::printImage( *this, this ) )
-    {
-        KMessageBox::error( this, i18n("Unable to print the image."),
-                            i18n("Printing Failed") );
-    }
+    // OHOS adaptation: the Qt6 PrintSupport module is not part of the
+    // published qtbase package; the action reports unavailability
+    // instead of pulling in QPrinter/QPrintDialog.
+    KMessageBox::information( this, i18n("Printing is not supported on this platform."),
+                              i18n("Printing Failed") );
 }
 
 
diff --git a/src/kuickshow.cpp b/src/kuickshow.cpp
index 276ee89..534c3e9 100644
--- a/src/kuickshow.cpp
+++ b/src/kuickshow.cpp
@@ -739,18 +739,10 @@ void KuickShow::nextSlide( const KFileItem& item )
 // prints the selected files in the filebrowser
 void KuickShow::slotPrint()
 {
-    const KFileItemList items = fileWidget->selectedItems();
-    if (items.isEmpty()) return;
-
-    // don't show the image, just print
-    ImageWindow *iw = new ImageWindow(this);
-    iw->setObjectName( QString::fromLatin1("printing image"));
-    for (const KFileItem &item : std::as_const(items))
-    {
-        if (FileWidget::isImage(item) && iw->loadImage(item.url())) iw->printImage();
-    }
-
-    delete iw;
+    // OHOS adaptation: the Qt6 PrintSupport module is not part of the
+    // published qtbase package; printing is unavailable on this platform.
+    KMessageBox::information( this, i18n("Printing is not supported on this platform."),
+                              i18n("Printing Failed") );
 }
 
 void KuickShow::slotShowInOtherWindow()
-- 
