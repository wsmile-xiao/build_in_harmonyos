From a1747944585cf22afa4f2ed321bf357e0b6c54ce Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Thu, 1 Oct 2026 20:40:30 +0800
Subject: [PATCH] ohos: drop X11-only kwindowsystem parts (KStartupInfo
 handshake, KWindowInfo frame query)

---
 ...ly-kwindowsystem-parts-KStartupInfo-.patch | 153 ++++++++++++++++++
 src/kuick.h                                   |  17 +-
 src/kuickshow.cpp                             |   7 +-
 3 files changed, 164 insertions(+), 13 deletions(-)
 create mode 100644 out/0001-ohos-drop-X11-only-kwindowsystem-parts-KStartupInfo-.patch

diff --git a/out/0001-ohos-drop-X11-only-kwindowsystem-parts-KStartupInfo-.patch b/out/0001-ohos-drop-X11-only-kwindowsystem-parts-KStartupInfo-.patch
new file mode 100644
index 0000000..d15a318
--- /dev/null
+++ b/out/0001-ohos-drop-X11-only-kwindowsystem-parts-KStartupInfo-.patch
@@ -0,0 +1,153 @@
+From db4df750f18a1a0d5815a29bc0eb32beeacd3d5b Mon Sep 17 00:00:00 2001
+From: t <t@t>
+Date: Thu, 1 Oct 2026 20:40:30 +0800
+Subject: [PATCH] ohos: drop X11-only kwindowsystem parts (KStartupInfo
+ handshake, KWindowInfo frame query)
+
+---
+ ...ly-kwindowsystem-parts-KStartupInfo-.patch | 72 +++++++++++++++++++
+ src/kuick.h                                   | 17 ++---
+ src/kuickshow.cpp                             |  6 +-
+ 3 files changed, 82 insertions(+), 13 deletions(-)
+ create mode 100644 out/0001-ohos-drop-X11-only-kwindowsystem-parts-KStartupInfo-.patch
+
+diff --git a/out/0001-ohos-drop-X11-only-kwindowsystem-parts-KStartupInfo-.patch b/out/0001-ohos-drop-X11-only-kwindowsystem-parts-KStartupInfo-.patch
+new file mode 100644
+index 0000000..4aad82a
+--- /dev/null
++++ b/out/0001-ohos-drop-X11-only-kwindowsystem-parts-KStartupInfo-.patch
+@@ -0,0 +1,72 @@
++From 02565384c47a5c91ad76f102b314542917ac8d66 Mon Sep 17 00:00:00 2001
++From: t <t@t>
++Date: Thu, 1 Oct 2026 20:40:30 +0800
++Subject: [PATCH] ohos: drop X11-only kwindowsystem parts (KStartupInfo
++ handshake, KWindowInfo frame query)
++
++---
++ src/kuick.h       | 16 ++++++----------
++ src/kuickshow.cpp |  6 ++++--
++ 2 files changed, 10 insertions(+), 12 deletions(-)
++
++diff --git a/src/kuick.h b/src/kuick.h
++index ef310e4..6a34c84 100644
++--- a/src/kuick.h
+++++ b/src/kuick.h
++@@ -19,7 +19,6 @@
++ #ifndef KUICKGLOBALS_H
++ #define KUICKGLOBALS_H
++ 
++-#include <KWindowInfo>
++ 
++ #include <QGuiApplication>
++ #include <QRect>
++@@ -44,15 +43,12 @@ public:
++ 	}
++ 
++     static QSize frameSize(WId win = WId(0)) {
++-	if ( win ) {
++-	    KWindowInfo info(win, NET::WMFrameExtents | NET::WMGeometry | NET::WMDesktop);
++-	    int wborder = info.frameGeometry().width() - info.geometry().width();
++-	    int hborder = info.frameGeometry().height() - info.geometry().height();
++-	
++-	    if ( wborder || hborder ) { // we get a 0,0 border when not shown
++-		s_frameSize.setWidth( wborder );
++-		s_frameSize.setHeight( hborder );
++-	    }
+++	// OHOS adaptation: the published kwindowsystem package is built
+++	// with KWINDOWSYSTEM_X11=OFF and ships neither KWindowInfo nor the
+++	// NET WM query API. No window-manager frame decoration info is
+++	// available; keep the invalid s_frameSize fallback (same result as
+++	// the upstream "window not shown yet" path: zero frame size).
+++	Q_UNUSED(win);
++ 	}
++ 	
++ 	if ( !s_frameSize.isValid() )
++diff --git a/src/kuickshow.cpp b/src/kuickshow.cpp
++index 534c3e9..7af0b91 100644
++--- a/src/kuickshow.cpp
+++++ b/src/kuickshow.cpp
++@@ -35,7 +35,6 @@
++ #include <KStandardAction>
++ #include <KStandardGuiItem>
++ #include <KStandardShortcut>
++-#include <KStartupInfo>
++ #include <KToolBar>
++ #include <KUrlComboBox>
++ #include <KUrlCompletion>
++@@ -242,7 +241,10 @@ KuickShow::KuickShow( const char *objName )
++ 
++     else { // don't show browser, when image on commandline
++         hide();
++-        KStartupInfo::appStarted();
+++        // OHOS adaptation: startup notification is X11/Wayland
+++        // visual-feedback infrastructure (kstartupinfo.h is not
+++        // shipped by the OHOS kwindowsystem package); nothing to
+++        // complete here.
++     }
++ }
++ 
++-- 
++2.45.2
++
+diff --git a/src/kuick.h b/src/kuick.h
+index ef310e4..03bd100 100644
+--- a/src/kuick.h
++++ b/src/kuick.h
+@@ -19,7 +19,6 @@
+ #ifndef KUICKGLOBALS_H
+ #define KUICKGLOBALS_H
+ 
+-#include <KWindowInfo>
+ 
+ #include <QGuiApplication>
+ #include <QRect>
+@@ -44,16 +43,12 @@ public:
+ 	}
+ 
+     static QSize frameSize(WId win = WId(0)) {
+-	if ( win ) {
+-	    KWindowInfo info(win, NET::WMFrameExtents | NET::WMGeometry | NET::WMDesktop);
+-	    int wborder = info.frameGeometry().width() - info.geometry().width();
+-	    int hborder = info.frameGeometry().height() - info.geometry().height();
+-	
+-	    if ( wborder || hborder ) { // we get a 0,0 border when not shown
+-		s_frameSize.setWidth( wborder );
+-		s_frameSize.setHeight( hborder );
+-	    }
+-	}
++	// OHOS adaptation: the published kwindowsystem package is built
++	// with KWINDOWSYSTEM_X11=OFF and ships neither KWindowInfo nor the
++	// NET WM query API. No window-manager frame decoration info is
++	// available; keep the invalid s_frameSize fallback (same result as
++	// the upstream "window not shown yet" path: zero frame size).
++	Q_UNUSED(win);
+ 	
+ 	if ( !s_frameSize.isValid() )
+ 	    return QSize( 0, 0 );
+diff --git a/src/kuickshow.cpp b/src/kuickshow.cpp
+index 534c3e9..7af0b91 100644
+--- a/src/kuickshow.cpp
++++ b/src/kuickshow.cpp
+@@ -35,7 +35,6 @@
+ #include <KStandardAction>
+ #include <KStandardGuiItem>
+ #include <KStandardShortcut>
+-#include <KStartupInfo>
+ #include <KToolBar>
+ #include <KUrlComboBox>
+ #include <KUrlCompletion>
+@@ -242,7 +241,10 @@ KuickShow::KuickShow( const char *objName )
+ 
+     else { // don't show browser, when image on commandline
+         hide();
+-        KStartupInfo::appStarted();
++        // OHOS adaptation: startup notification is X11/Wayland
++        // visual-feedback infrastructure (kstartupinfo.h is not
++        // shipped by the OHOS kwindowsystem package); nothing to
++        // complete here.
+     }
+ }
+ 
+-- 
+2.45.2
+
diff --git a/src/kuick.h b/src/kuick.h
index ef310e4..03bd100 100644
--- a/src/kuick.h
+++ b/src/kuick.h
@@ -19,7 +19,6 @@
 #ifndef KUICKGLOBALS_H
 #define KUICKGLOBALS_H
 
-#include <KWindowInfo>
 
 #include <QGuiApplication>
 #include <QRect>
@@ -44,16 +43,12 @@ public:
 	}
 
     static QSize frameSize(WId win = WId(0)) {
-	if ( win ) {
-	    KWindowInfo info(win, NET::WMFrameExtents | NET::WMGeometry | NET::WMDesktop);
-	    int wborder = info.frameGeometry().width() - info.geometry().width();
-	    int hborder = info.frameGeometry().height() - info.geometry().height();
-	
-	    if ( wborder || hborder ) { // we get a 0,0 border when not shown
-		s_frameSize.setWidth( wborder );
-		s_frameSize.setHeight( hborder );
-	    }
-	}
+	// OHOS adaptation: the published kwindowsystem package is built
+	// with KWINDOWSYSTEM_X11=OFF and ships neither KWindowInfo nor the
+	// NET WM query API. No window-manager frame decoration info is
+	// available; keep the invalid s_frameSize fallback (same result as
+	// the upstream "window not shown yet" path: zero frame size).
+	Q_UNUSED(win);
 	
 	if ( !s_frameSize.isValid() )
 	    return QSize( 0, 0 );
diff --git a/src/kuickshow.cpp b/src/kuickshow.cpp
index 534c3e9..6df3484 100644
--- a/src/kuickshow.cpp
+++ b/src/kuickshow.cpp
@@ -35,13 +35,13 @@
 #include <KStandardAction>
 #include <KStandardGuiItem>
 #include <KStandardShortcut>
-#include <KStartupInfo>
 #include <KToolBar>
 #include <KUrlComboBox>
 #include <KUrlCompletion>
 
 #include <QAbstractItemView>
 #include <QGuiApplication>
+#include <QWindow>
 #include <QCommandLineParser>
 #include <QDialog>
 #include <QDir>
@@ -242,7 +242,10 @@ KuickShow::KuickShow( const char *objName )
 
     else { // don't show browser, when image on commandline
         hide();
-        KStartupInfo::appStarted();
+        // OHOS adaptation: startup notification is X11/Wayland
+        // visual-feedback infrastructure (kstartupinfo.h is not
+        // shipped by the OHOS kwindowsystem package); nothing to
+        // complete here.
     }
 }
 
-- 
2.45.2

