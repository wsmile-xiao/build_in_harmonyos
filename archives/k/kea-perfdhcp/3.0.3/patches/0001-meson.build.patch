 #### System-specific Variables
 
 SYSTEM = build_machine.system()
+# OpenHarmony/HarmonyOS shares the Linux userspace ABI (musl libc, Linux
+# syscalls, linux iface_mgr/pkt_filter back-ends). Meson reports the
+# platform as 'harmonyos'; normalize it to the Linux branch below.
+if SYSTEM == 'harmonyos'
+    SYSTEM = 'linux'
+endif
 if SYSTEM == 'linux'
     conf_data.set('OS_LINUX', true)
     OS_TYPE = 'Linux'
 elif SYSTEM == 'freebsd'
     conf_data.set('OS_BSD', true)
     conf_data.set('OS_FREEBSD', true)
     OS_TYPE = 'BSD'
 elif SYSTEM == 'netbsd'
     conf_data.set('OS_BSD', true)
     conf_data.set('OS_NETBSD', true)
