+void KListOpenFilesJobPrivate::startEntryQuery()
+{
+    const QStringList names = path.entryList(QDir::AllEntries | QDir::NoDotAndDotDot | QDir::Hidden | QDir::System, QDir::Name);
+    pendingEntries.clear();
+    for (const QString &name : names) {
+        pendingEntries << path.absoluteFilePath(name);
+    }
+    if (pendingEntries.isEmpty()) {
+        // Nothing can be open in an empty directory: same result as +d.
+        job->emitResult();
+        return;
+    }
+    stage = EntryQuery;
+    lsofProcess.start(lsofExecutable, QStringList{QStringLiteral("-t")} + pendingEntries);
+}
+
+void KListOpenFilesJobPrivate::lsofFinished(int exitCode, QProcess::ExitStatus)
+{
+    if (hasEmittedResult) {
+        return;
+    }
+    const QByteArray rawOut = lsofProcess.readAllStandardOutput();
+    if (!rawOut.isEmpty()) {
+        appendPids(QString::fromLocal8Bit(rawOut));
+    }
+
+    if (stage != DirectoryQuery) {
+        if (stage == EntryQuery && exitCode != 0 && processInfoList.isEmpty()) {
+            // The reduced tool refuses the whole query when any argument
+            // cannot be stat'ed, so retry one entry at a time.
+            stage = EntryQueryPerEntry;
+            pendingIndex = 0;
+        }
+        if (stage == EntryQueryPerEntry && pendingIndex < pendingEntries.size()) {
+            lsofProcess.start(lsofExecutable, QStringList{QStringLiteral("-t"), pendingEntries.at(pendingIndex++)});
+            return;
+        }
+        job->emitResult();
+        return;
+    }
+
+    // The plain directory query. A tool without +d support aborts before
+    // listing anything; fall back to querying the entries directly.
+    if (processInfoList.isEmpty() && exitCode != 0
+        && lsofProcess.readAllStandardError().contains("+d")) {
+        startEntryQuery();
+        return;
+    }
     job->emitResult();
 }
 
