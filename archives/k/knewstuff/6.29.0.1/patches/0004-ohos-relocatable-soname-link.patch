diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
index d8e411f..1623ff1 100644
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -55,8 +55,21 @@ target_sources(knscore_jobs_static PRIVATE
     jobs/httpjob.cpp
     jobs/httpworker.cpp
 )
-target_link_libraries(knscore_jobs_static PUBLIC Qt6::Network KF6::I18n KF6::CoreAddons KF6::Package)
+# R05: static libs forward their PRIVATE deps to the final link; link the KF6
+# deps by basename (-l) through a PRIVATE -L so ld records `libKF6I18n.so` etc.
+# in DT_NEEDED instead of the machine-private absolute cache path.
+target_link_directories(knscore_jobs_static PRIVATE ${KNEWSTUFF_DEP_LIB_DIRS})
+target_link_libraries(knscore_jobs_static PRIVATE Qt6::Network -lKF6I18n -lKF6CoreAddons -lKF6Package)
 target_include_directories(knscore_jobs_static PRIVATE ${CMAKE_BINARY_DIR})
+foreach(kf6dep KF6::I18n KF6::CoreAddons KF6::Package)
+    if(TARGET ${kf6dep})
+        get_target_property(_jobs_inc ${kf6dep} INTERFACE_INCLUDE_DIRECTORIES)
+        if(_jobs_inc)
+            target_include_directories(knscore_jobs_static SYSTEM PRIVATE ${_jobs_inc})
+        endif()
+    endif()
+endforeach()
+unset(_jobs_inc)
 # Needed to link this static lib to shared libs
 set_property(TARGET knscore_jobs_static PROPERTY POSITION_INDEPENDENT_CODE ON)
 
@@ -78,6 +91,30 @@ set_target_properties(KF6NewStuffCore PROPERTIES
    EXPORT_NAME NewStuffCore
 )
 
+# R05: relocatable linkage. The KF6 dependency libraries are published without a
+# DT_SONAME, so linking them by absolute Conan cache path makes the linker record
+# that machine-private path in DT_NEEDED (non-consumable on a different cache
+# layout). Link each dependency by its SONAME-style basename using a PRIVATE -L
+# (so ld records `libKF6CoreAddons.so` etc.), propagate the public KF6 deps to
+# consumers via the INTERFACE imported target names, and stamp an explicit SONAME
+# so executables linked against this in-tree target record `libKF6NewStuffCore.so`.
+target_link_directories(KF6NewStuffCore PRIVATE ${KNEWSTUFF_DEP_LIB_DIRS})
+target_link_options(KF6NewStuffCore PRIVATE "-Wl,-soname,libKF6NewStuffCore.so")
+
+# Keep the include directories needed to build this library. The KF6 deps above
+# are linked by bare -l (PRIVATE) so their INTERFACE include dirs are not
+# propagated to this target; re-add them PRIVATE so producer absolute cache paths
+# are never exported to consumers.
+foreach(kf6dep KF6::Attica KF6::Archive KF6::Config KF6::ConfigCore KF6::CoreAddons KF6::I18n KF6::Package KF6::WidgetsAddons)
+    if(TARGET ${kf6dep})
+        get_target_property(_kf6_inc ${kf6dep} INTERFACE_INCLUDE_DIRECTORIES)
+        if(_kf6_inc)
+            target_include_directories(KF6NewStuffCore SYSTEM PRIVATE ${_kf6_inc})
+        endif()
+    endif()
+endforeach()
+unset(_kf6_inc)
+
 ecm_generate_export_header(KF6NewStuffCore
     EXPORT_FILE_NAME knewstuffcore_export.h
     BASE_NAME KNewStuffCore
@@ -103,15 +140,22 @@ target_include_directories(KF6NewStuffCore
 )
 
 target_link_libraries(KF6NewStuffCore
+  INTERFACE
+    # KF6 deps are intentionally NOT exported here: the published dep libraries
+    # carry no DT_SONAME, so exporting them by target name embeds absolute cache
+    # paths and exporting them by -l forces consumers to add -L. Consumers only
+    # link libKF6NewStuffCore.so (explicit SONAME); its own NEEDED entries pull
+    # the KF6 deps transitively at runtime via the consumer library path.
   PUBLIC
-    KF6::Attica                # For interacting with ocs providers, public for uploaddialog slots
-    KF6::CoreAddons
     Qt6::Gui                   # For QImage
   PRIVATE
-    KF6::Archive               # For decompressing archives
-    KF6::I18n                  # For translations
-    KF6::ConfigCore
-    KF6::Package
+    -lKF6Attica                # For interacting with ocs providers (by basename, R05)
+    -lKF6CoreAddons
+    -lKF6Archive               # For decompressing archives
+    -lKF6I18n                  # For translations
+    -lKF6ConfigCore
+    -lKF6Package
+    Qt6::Network               # knscore_jobs_static 不再向本目标传播其 PRIVATE Qt 头
     Qt6::Xml
     knscore_jobs_static
 )
