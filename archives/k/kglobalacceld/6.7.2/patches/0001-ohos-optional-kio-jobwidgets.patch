diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7a9c3c1..f63132a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -50,8 +50,16 @@ find_package(KF6DBusAddons ${KF6_MIN_VERSION} REQUIRED)
 find_package(KF6WindowSystem ${KF6_MIN_VERSION} REQUIRED)
 find_package(KF6GlobalAccel ${KF6_MIN_VERSION} REQUIRED)
 find_package(KF6Service ${KF6_MIN_VERSION} REQUIRED)
-find_package(KF6KIO ${KF6_MIN_VERSION} REQUIRED)
-find_package(KF6JobWidgets ${KF6_MIN_VERSION} REQUIRED)
+
+# KIO (KF6::KIOGui) and JobWidgets are only used for the desktop-file launch
+# path in KServiceActionComponent. Allow building without them on platforms
+# whose build environment provides no KIOGui target (e.g. OHOS, where the
+# published KIO package is built in KIOCore-only mode).
+option(WITH_KIO "Build with KIO-based application launching" ON)
+if(WITH_KIO)
+    find_package(KF6KIO ${KF6_MIN_VERSION} REQUIRED)
+    find_package(KF6JobWidgets ${KF6_MIN_VERSION} REQUIRED)
+endif()
 
 
 option(WITH_X11 "Build with X11 support." ON)
