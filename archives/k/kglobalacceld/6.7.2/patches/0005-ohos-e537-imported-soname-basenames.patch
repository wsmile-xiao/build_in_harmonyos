+# OHOS adaptation (knowledge entry E537): the published KF6 dependency
+# packages ship their .so without a DT_SONAME, so linking the imported
+# targets makes the linker record the dependencies' absolute Conan cache
+# paths (IMPORTED_LOCATION) into DT_NEEDED — unrelocatable artifacts.
+# Link the KF6 dependencies by bare "-l<name>" with their package lib dirs
+# on the link path instead, so the linker records bare basenames. Qt6 and
+# KF6::GlobalAccel targets keep their own DT_SONAME and stay as targets.
+function(_ohos_link_kf6_bare _tgt _scope)
+    foreach(_dep IN LISTS ARGN)
+        if(NOT TARGET ${_dep})
+            continue()
+        endif()
+        get_property(_loc TARGET ${_dep} PROPERTY IMPORTED_LOCATION_RELEASE)
+        if(NOT _loc)
+            get_property(_loc TARGET ${_dep} PROPERTY IMPORTED_LOCATION)
+        endif()
+        if(NOT _loc)
+            target_link_libraries(${_tgt} PRIVATE ${_dep})
+            continue()
+        endif()
+        get_filename_component(_dir "${_loc}" DIRECTORY)
+        get_filename_component(_name "${_loc}" NAME)
+        string(REGEX REPLACE "^lib" "" _base "${_name}")
+        string(REGEX REPLACE "\\.(so|dylib).*$" "" _base "${_base}")
+        target_link_directories(${_tgt} PRIVATE "${_dir}")
+        # Keep the headers reachable: bare -l items drop the imported
+        # target's INTERFACE_INCLUDE_DIRECTORIES (E537 method note).
+        get_property(_incs TARGET ${_dep} PROPERTY INTERFACE_INCLUDE_DIRECTORIES)
+        foreach(_inc ${_incs})
+            string(FIND "${_inc}" "$<" _genexp)
+            if(_genexp EQUAL 0)
+                continue()
+            endif()
+            if(IS_ABSOLUTE "${_inc}")
+                target_include_directories(${_tgt} PRIVATE "${_inc}")
+            endif()
+        endforeach()
+        target_link_libraries(${_tgt} ${_scope} -l${_base})
+    endforeach()
+endfunction()
+
+_ohos_link_kf6_bare(KGlobalAccelD PRIVATE
+    KF6::WindowSystem   # KKeyServer
+    KF6::CoreAddons     # KAboutData
+    KF6::ConfigCore
+    KF6::Service
+)
