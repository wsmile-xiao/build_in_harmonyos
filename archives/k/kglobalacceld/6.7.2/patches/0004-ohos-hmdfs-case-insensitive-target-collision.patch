diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 6290b7b..11b52be 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -61,21 +61,29 @@ if(XCB_XCB_FOUND)
     target_link_libraries(KGlobalAccelD PUBLIC Qt6::GuiPrivate) # qtx11extras_p.h
 endif()
 
-add_executable(kglobalacceld main.cpp)
+# OHOS adaptation: the build tree lives on HMDFS, which is case-insensitive.
+# The executable target "kglobalacceld" and the library target "KGlobalAccelD"
+# would collide on their CMakeFiles/<target>.dir and CMakeFiles/<target>_autogen.dir
+# directories (the executable's AUTOMOC output overwrote the library's, so the
+# moc_*.cpp files were never generated). Use a distinct target name and keep
+# the installed binary name via OUTPUT_NAME.
+add_executable(kglobalacceld_daemon main.cpp)
 
-target_include_directories(kglobalacceld PRIVATE ${CMAKE_BINARY_DIR})
+target_include_directories(kglobalacceld_daemon PRIVATE ${CMAKE_BINARY_DIR})
 
-target_link_libraries(kglobalacceld
+target_link_libraries(kglobalacceld_daemon
     KGlobalAccelD
     KF6::CoreAddons
     KF6::DBusAddons   # KDBusService
     KF6::Crash
     )
 
+set_target_properties(kglobalacceld_daemon PROPERTIES OUTPUT_NAME kglobalacceld)
+
 add_subdirectory(plugins)
 
 install(TARGETS KGlobalAccelD EXPORT KGlobalAccelDTargets ${KF_INSTALL_TARGETS_DEFAULT_ARGS} LIBRARY NAMELINK_SKIP)
-install(TARGETS kglobalacceld DESTINATION ${KDE_INSTALL_LIBEXECDIR})
+install(TARGETS kglobalacceld_daemon DESTINATION ${KDE_INSTALL_LIBEXECDIR})
 
 install(FILES
   ${CMAKE_CURRENT_BINARY_DIR}/kglobalacceld_export.h
