prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: kodiplatform
Description: Kodi add-on platform support library
Version: @kodiplatform_VERSION_MAJOR@.@kodiplatform_VERSION_MINOR@
Libs: -L${libdir} -lkodiplatform -lp8-platform -ltinyxml -lpthread
Cflags: -I${includedir}
