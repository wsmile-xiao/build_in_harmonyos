--- a/cmake/FindGraphviz.cmake
+++ b/cmake/FindGraphviz.cmake
@@ -66,8 +66,46 @@
 
 if (EXISTS "${Graphviz_INCLUDE_DIRECTORIES}/graphviz_version.h")
     file(READ "${Graphviz_INCLUDE_DIRECTORIES}/graphviz_version.h" _graphviz_version_content)
-    string(REGEX MATCH "#define +PACKAGE_VERSION +\"([0-9]+\\.[0-9]+\\.[0-9]+)\"" _dummy "${_graphviz_version_content}")
-    set(Graphviz_VERSION "${CMAKE_MATCH_1}")
+    # OHOS: newer graphviz headers no longer carry a PACKAGE_VERSION string
+    # (graphviz 12/13 define GRAPHVIZ_VERSION instead). Try the historic
+    # PACKAGE_VERSION spelling first, then the GRAPHVIZ_VERSION_STRING /
+    # GRAPHVIZ_VERSION strings, then assemble the version from the
+    # GRAPHVIZ_VERSION_MAJOR/MINOR/PATCH numeric macros.
+    set(_gv_ver "")
+    string(REGEX MATCH "#define +PACKAGE_VERSION +\"([0-9]+\.[0-9]+\.[0-9]+)\"" _gv_dummy "${_graphviz_version_content}")
+    if (_gv_dummy)
+        set(_gv_ver "${CMAKE_MATCH_1}")
+    endif ()
+    if (NOT _gv_ver)
+        string(REGEX MATCH "#define +GRAPHVIZ_VERSION_STRING +\"([0-9]+\.[0-9]+\.[0-9]+)\"" _gv_dummy "${_graphviz_version_content}")
+        if (_gv_dummy)
+            set(_gv_ver "${CMAKE_MATCH_1}")
+        endif ()
+    endif ()
+    if (NOT _gv_ver)
+        string(REGEX MATCH "#define +GRAPHVIZ_VERSION +\"([0-9]+\.[0-9]+\.[0-9]+)\"" _gv_dummy "${_graphviz_version_content}")
+        if (_gv_dummy)
+            set(_gv_ver "${CMAKE_MATCH_1}")
+        endif ()
+    endif ()
+    if (NOT _gv_ver)
+        string(REGEX MATCH "#define +GRAPHVIZ_VERSION_MAJOR +([0-9]+)" _gv_dummy "${_graphviz_version_content}")
+        if (_gv_dummy)
+            set(_gv_maj "${CMAKE_MATCH_1}")
+        endif ()
+        string(REGEX MATCH "#define +GRAPHVIZ_VERSION_MINOR +([0-9]+)" _gv_dummy "${_graphviz_version_content}")
+        if (_gv_dummy)
+            set(_gv_min "${CMAKE_MATCH_1}")
+        endif ()
+        string(REGEX MATCH "#define +GRAPHVIZ_VERSION_PATCH +([0-9]+)" _gv_dummy "${_graphviz_version_content}")
+        if (_gv_dummy)
+            set(_gv_pat "${CMAKE_MATCH_1}")
+        endif ()
+        if (_gv_maj)
+            set(_gv_ver "${_gv_maj}.${_gv_min}.${_gv_pat}")
+        endif ()
+    endif ()
+    set(Graphviz_VERSION "${_gv_ver}")
 endif ()
 
 if ("${Graphviz_FIND_VERSION}" VERSION_GREATER "${Graphviz_VERSION}")
