From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenHarmony PC Port <openharmony@example.invalid>
Date: Thu, 27 Aug 2026 10:36:00 +0800
Subject: [PATCH] Use libical 4 status string API

libical 4 exposes STATUS parsing through icalproperty_string_to_status().
Keep the xCal parser using the same icalproperty_status value type while
building against the newer API.
---
 src/xcalformat.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/xcalformat.cpp b/src/xcalformat.cpp
index 0000000..0000000 100644
--- a/src/xcalformat.cpp
+++ b/src/xcalformat.cpp
@@ -260,7 +260,7 @@ void XCalFormat::Private::parseVevent(QXmlStreamReader &reader, const Event::Ptr
                 reader.skipCurrentElement();
             }
         } else if (reader.name() == "status"_L1) {
-            event->setStatus(ICalFormatImpl::fromIcalEnum(icalenum_string_to_status(parseProperty(reader).toString().toUtf8().constData())));
+            event->setStatus(ICalFormatImpl::fromIcalEnum(icalproperty_string_to_status(parseProperty(reader).toString().toUtf8().constData())));
         } else if (reader.name() == "summary"_L1) {
             event->setSummary(parseProperty(reader).toString());
         } else if (reader.name() == "transp"_L1) {
