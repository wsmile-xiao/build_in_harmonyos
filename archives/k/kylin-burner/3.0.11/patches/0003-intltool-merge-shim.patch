--- /dev/null
+++ b/intltool-merge-shim
@@ -0,0 +1,14 @@
+#!/bin/sh
+# OHOS shim for intltool-merge: strips "_" translation markers from
+# .desktop.in / .xml.in files (intltool needs XML::Parser perl module).
+# Usage: intltool-merge-shim <input> [<output>]
+#   - 1 arg: output = input with trailing ".in" stripped
+#   - 2 args: explicit input/output
+input=""
+output=""
+for arg in "$@"; do
+    if [ -z "$input" ]; then input="$arg"; else output="$arg"; fi
+done
+[ -n "$input" ] || { echo "intltool-merge-shim: no input" >&2; exit 1; }
+[ -n "$output" ] || output="${input%.in}"
+perl -pe 's/<(\/?)_([a-zA-Z][a-zA-Z0-9_]*)>/<$1$2>/g' "$input" > "$output"
