--- /dev/null
+++ b/m4/ohos-stubs.m4
@@ -0,0 +1,20 @@
+dnl ---- OHOS stub macros (gnome-common / yelp-tools / gtk-doc / intltool unavailable) ----
+AC_DEFUN([GNOME_COMPILE_WARNINGS], [AC_SUBST([WARN_CFLAGS], [])])
+AC_DEFUN([GNOME_CXX_WARNINGS], [AC_SUBST([WARN_CXXFLAGS], [])])
+AC_DEFUN([GNOME_MAINTAINER_MODE_DEFINES], [])
+AC_DEFUN([YELP_HELP_INIT], [])
+AC_DEFUN([GTK_DOC_CHECK], [])
+AC_DEFUN([IT_PROG_INTLTOOL], [
+  AC_SUBST([INTLTOOL_EXTRACT], ['true'])
+  AC_SUBST([INTLTOOL_MERGE], ['$(SHELL) $(top_srcdir)/intltool-merge-shim'])
+  AC_SUBST([INTLTOOL_PERL], ['perl'])
+  AC_SUBST([INTLTOOL_UPDATE], ['true'])
+  AC_SUBST([INTLTOOL_V_MERGE], [''])
+  AC_SUBST([INTLTOOL_V_MERGE_OPTIONS], [''])
+  dnl NOTE: avoid $@ in AC_SUBST here - inside an AC_DEFUN, m4 expands
+  dnl $@ to this macro's own arguments (the intltool version), breaking
+  dnl the rule. The shim derives the output name from the input (.in).
+  AC_SUBST([INTLTOOL_XML_RULE], ['%.xml: %.xml.in ; $(SHELL) $(top_srcdir)/intltool-merge-shim $<'])
+  AC_SUBST([INTLTOOL_DESKTOP_RULE], ['%.desktop: %.desktop.in ; $(SHELL) $(top_srcdir)/intltool-merge-shim $<'])
+  AC_SUBST([INTLTOOL__v_MERGE_], [''])
+])
