--- /dev/null
+++ b/ohos-stubs/canberra-gtk.h
@@ -0,0 +1,24 @@
+/* OHOS stub for <canberra-gtk.h> — the conan libcanberra package is built
+ * with --disable-gtk3, so libcanberra-gtk3 (ca_gtk_play_for_widget) is not
+ * available.  Stub returns 0 (success/no-op) so audio cues are silently
+ * skipped on HarmonyOS PC. */
+#ifndef __CANBERRA_GTK_H__
+#define __CANBERRA_GTK_H__
+
+#include <gtk/gtk.h>
+#include <stdarg.h>
+
+G_BEGIN_DECLS
+
+#define CA_PROP_EVENT_ID            "event.id"
+#define CA_PROP_EVENT_DESCRIPTION   "event.description"
+
+static inline int
+ca_gtk_play_for_widget (GtkWidget *widget, int id, ...)
+{
+  return 0;
+}
+
+G_END_DECLS
+
+#endif /* __CANBERRA_GTK_H__ */
