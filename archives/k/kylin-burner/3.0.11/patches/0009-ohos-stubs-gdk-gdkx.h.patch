--- /dev/null
+++ b/ohos-stubs/gdk/gdkx.h
@@ -0,0 +1,38 @@
+/* OHOS stub for <gdk/gdkx.h> — gtk3 on HarmonyOS PC is built without the
+ * X11 backend (broadway only), so the gdkx.h header and the gdk_x11_*
+ * symbols do not exist.  These stubs let the burner code compile; the
+ * X11-specific code paths (window embedding via XID) are no-ops here.
+ * Note: GDK_WINDOWING_X11 is deliberately NOT defined, so guarded code
+ * blocks in burner-app.c are excluded at compile time.
+ * See notes.md for the rationale (sound-juicer HAVE_STUB_DEPS precedent). */
+#ifndef __GDK_GDKX_H__
+#define __GDK_GDKX_H__
+
+#include <gdk/gdk.h>
+
+G_BEGIN_DECLS
+
+/* X11 XID (window id) type used by burner-player-bacon.c etc. */
+typedef unsigned long XID;
+
+static inline gboolean
+GDK_IS_X11_DISPLAY (GdkDisplay *display)
+{
+  return FALSE;
+}
+
+static inline guint32
+gdk_x11_window_get_xid (GdkWindow *window)
+{
+  return 0;
+}
+
+static inline GdkWindow *
+gdk_x11_window_foreign_new_for_display (GdkDisplay *display, guint32 xid)
+{
+  return NULL;
+}
+
+G_END_DECLS
+
+#endif /* __GDK_GDKX_H__ */
