--- a/meson.build
+++ b/meson.build
@@ -125,7 +125,12 @@
 SUDO = find_program('sudo', required: false)
 XMLLINT = find_program('xmllint', required: false)
 
-CD_AND_RUN = find_program(TOP_SOURCE_DIR / 'scripts/cd-and-run.sh')
-ENV = find_program(TOP_SOURCE_DIR / 'scripts/env.sh')
-GRABBER = find_program(TOP_SOURCE_DIR / 'scripts/grabber.py')
+# The HarmonyOS PC kernel refuses script execve (shebang execution is denied
+# regardless of the executable bits), so every configure-time script
+# invocation goes through its interpreter explicitly: sh for the shell
+# scripts, python3 for grabber.py.  All call sites keep passing these values
+# as the first run_command() argument, so the change is contained here.
+CD_AND_RUN = ['/bin/sh', TOP_SOURCE_DIR / 'scripts/cd-and-run.sh']
+ENV = ['/bin/sh', TOP_SOURCE_DIR / 'scripts/env.sh']
+GRABBER = [find_program('python3').full_path(), TOP_SOURCE_DIR / 'scripts/grabber.py']
 KEA_MSG_COMPILER = disabler()
@@ -1028,5 +1028,5 @@
 CONFIG_REPORT = configure_file(
     output: 'config.report',
     input: config_report_sh,
-    command: [TOP_BUILD_DIR / 'config-report.sh'],
+    command: ['/bin/sh', TOP_BUILD_DIR / 'config-report.sh'],
 )
