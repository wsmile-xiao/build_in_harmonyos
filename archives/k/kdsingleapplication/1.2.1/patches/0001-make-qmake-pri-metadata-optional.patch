From 0cf6397fb4eed65f89c78b17b84e7a64ac49ab0b Mon Sep 17 00:00:00 2001
From: OpenHarmonyPCDeveloper <openharmonypcdeveloper@users.noreply.github.com>
Date: Wed, 23 Sep 2026 14:15:00 +0000
Subject: [PATCH] Make optional metadata and moc tool configurable

The library and its CMake package do not require qmake. Allow consumers that
cross-build with a target Qt installation to skip optional qmake metadata and
to select a host-runnable moc executable.
---
 CMakeLists.txt | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ec0ac58..26d7c6e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -68,5 +68,10 @@ option(${PROJECT_NAME}_QT6 "Build against Qt 6" ON)
 option(${PROJECT_NAME}_DEVELOPER_MODE "Developer Mode" OFF)
 option(${PROJECT_NAME}_TESTS "Build the tests" OFF)
+option(${PROJECT_NAME}_INSTALL_QMAKE_PRI
+       "Install optional qmake module metadata"
+       ON)
+set(${PROJECT_NAME}_MOC_EXECUTABLE "" CACHE FILEPATH
+    "Optional moc executable wrapper for cross builds")
 option(${PROJECT_NAME}_EXAMPLES "Build the examples" ON)
 option(${PROJECT_NAME}_DOCS "Build the API documentation" OFF)
 option(${PROJECT_NAME}_STATIC "Build lib as static" OFF)
@@ -110,7 +115,17 @@
 if(${PROJECT_NAME}_TESTS)
     find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Test)
 endif()
-
+
-include(KDQtInstallPaths) #to set QT_INSTALL_FOO variables
+if(${PROJECT_NAME}_MOC_EXECUTABLE)
+    set_target_properties(
+        Qt${QT_VERSION_MAJOR}::moc
+        PROPERTIES IMPORTED_LOCATION "${${PROJECT_NAME}_MOC_EXECUTABLE}"
+                   IMPORTED_LOCATION_RELEASE "${${PROJECT_NAME}_MOC_EXECUTABLE}"
+    )
+endif()
+
+if(${PROJECT_NAME}_INSTALL_QMAKE_PRI OR ${PROJECT_NAME}_DOCS)
+    include(KDQtInstallPaths) # to set QT_INSTALL_FOO variables
+endif()
-
+
 add_definitions(
@@ -174 +189 @@ if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
-    if(NOT CMAKE_CONFIGURATION_TYPES)
+    if(${PROJECT_NAME}_INSTALL_QMAKE_PRI AND NOT CMAKE_CONFIGURATION_TYPES)
