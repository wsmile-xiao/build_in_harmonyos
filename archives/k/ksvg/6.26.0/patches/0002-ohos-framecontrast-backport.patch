+// OHOS adaptation: KColorScheme::frameContrast() was introduced in
+// kcolorscheme 6.26.0; the ohpcd registry publishes kcolorscheme 6.18.0
+// (the KF6 chain cap pinned by the lowered KF_DEP_VERSION). Reimplement the
+// upstream static helper locally (in sync with kcolorscheme 6.26.0
+// src/kcolorscheme.cpp and Kirigami platformtheme.cpp) so Svg::Frame
+// resolves against the published headers.
+static qreal ksvgFrameContrast()
+{
+    const qreal default_value = 0.2;
+    KSharedConfigPtr conf = KSharedConfig::openConfig();
+    if (!conf) {
+        return default_value;
+    }
+    KConfigGroup g(conf, QStringLiteral("KDE"));
+    return std::clamp(g.readEntry("frameContrast", default_value), 0.0, 1.0);
+}
