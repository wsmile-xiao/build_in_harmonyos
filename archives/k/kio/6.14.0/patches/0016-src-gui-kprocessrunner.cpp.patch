diff --git a/src/gui/kprocessrunner.cpp b/src/gui/kprocessrunner.cpp
index 00f7811..13fc64c 100644
--- a/src/gui/kprocessrunner.cpp
+++ b/src/gui/kprocessrunner.cpp
@@ -364,6 +364,16 @@ void ForkingProcessRunner::slotProcessError(QProcess::ProcessError errorCode)
     // This is unlikely to happen while the ApplicationLauncherJob is still connected to the KProcessRunner.
     // So the emit does nothing, this is really just for debugging.
     qCDebug(KIO_GUI) << name() << "error=" << errorCode << m_process->errorString();
+    if (errorCode == QProcess::FailedToStart) {
+        // When exec() fails outright (e.g. the executable lives on storage that
+        // refuses to execute it), QProcess never emits finished(), so
+        // slotProcessExited() never runs and this instance (plus its KProcess)
+        // would leak forever. Treat FailedToStart as a terminal state: report the
+        // error (deferred, so listeners still have time to connect) and schedule
+        // deletion, exactly like slotProcessExited() does for exit code 127.
+        emitDelayedError(m_process->errorString());
+        return;
+    }
     Q_EMIT error(m_process->errorString());
 }
 
