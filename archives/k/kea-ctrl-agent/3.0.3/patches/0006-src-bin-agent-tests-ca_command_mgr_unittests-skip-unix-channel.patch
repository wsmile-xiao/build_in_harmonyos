+    /// @brief Checks whether the host can host AF_UNIX pathname sockets
+    /// on the path used by the test server.
+    ///
+    /// Some host filesystems cannot host AF_UNIX pathname sockets at all:
+    /// the HarmonyOS PC user storage is an hmdfs mount, where bind() of a
+    /// path-based unix socket fails with EPERM, and a socket path whose
+    /// resolved probe file exceeds the sockaddr_un size limit fails with
+    /// ENAMETOOLONG.  The command forwarding tests probe with the very
+    /// path and operation the test server performs, so that they can skip
+    /// instead of failing on such hosts.
+    ///
+    /// @return true if a probe socket can be created on that path and
+    /// removed again.
+    bool unixControlSocketsUsable() {
+        std::string probe_path = unixSocketFilePath();
+        struct sockaddr_un addr;
+        memset(&addr, 0, sizeof(addr));
+        addr.sun_family = AF_UNIX;
+        if (probe_path.size() >= sizeof(addr.sun_path)) {
+            return (false);
+        }
+        memcpy(addr.sun_path, probe_path.c_str(), probe_path.size());
+        int fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+        if (fd < 0) {
+            return (false);
+        }
+        static_cast<void>(::unlink(probe_path.c_str()));
+        bool usable = (::bind(fd, reinterpret_cast<struct sockaddr*>(&addr),
+                              sizeof(addr)) == 0);
+        static_cast<void>(::close(fd));
+        static_cast<void>(::unlink(probe_path.c_str()));
+        return (usable);
+    }
+
