+bool
+Dhcpv4SrvTest::unixControlSocketsUsable() {
+    // Some host filesystems cannot host AF_UNIX pathname sockets at all:
+    // the HarmonyOS PC user storage is an hmdfs mount, where bind() of a
+    // path-based unix socket fails with EPERM, and a socket directory
+    // whose resolved probe path exceeds the sockaddr_un size limit fails
+    // with ENAMETOOLONG.  Tests covering the unix command channel probe
+    // with the very operation the server performs, so that they can skip
+    // instead of failing on such hosts.
+    std::string probe_path = UnixCommandConfig::getSocketPath() +
+                             "/kea4-socket-probe";
+    struct sockaddr_un addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    if (probe_path.size() >= sizeof(addr.sun_path)) {
+        return (false);
+    }
+    memcpy(addr.sun_path, probe_path.c_str(), probe_path.size());
+    int fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) {
+        return (false);
+    }
+    static_cast<void>(::unlink(probe_path.c_str()));
+    bool usable = (::bind(fd, reinterpret_cast<struct sockaddr*>(&addr),
+                          sizeof(addr)) == 0);
+    static_cast<void>(::close(fd));
+    static_cast<void>(::unlink(probe_path.c_str()));
+    return (usable);
 }
 
