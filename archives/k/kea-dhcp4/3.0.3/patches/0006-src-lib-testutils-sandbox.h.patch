@@ -11,6 +11,7 @@
 
 #include <iostream>
 #include <string>
+#include <vector>
 #include <cstdlib>
 #include <cstdio>
 #include <unistd.h>
@@ -40,8 +41,20 @@
 public:
     /// @brief Sandbox constructor.
     Sandbox() {
-        char tmpl[] = {P_tmpdir "/kea-XXXXXX"};
-        path_ = mkdtemp(tmpl);
+        // Honor TMPDIR when set: POSIX defines it for temporary files, and
+        // sandboxed build environments may not have a writable P_tmpdir
+        // (e.g. HarmonyOS PC, where /tmp is a read-only filesystem).  On
+        // such systems mkdtemp() would return NULL and the std::string
+        // assignment below would crash on a null pointer.  On regular build
+        // hosts TMPDIR is usually unset, so the built-in default is used.
+        const char* tmpdir = std::getenv("TMPDIR");
+        if ((tmpdir == NULL) || (*tmpdir == 0)) {
+            tmpdir = P_tmpdir;
+        }
+        std::string tmpl_str = std::string(tmpdir) + "/kea-XXXXXX";
+        std::vector<char> tmpl(tmpl_str.begin(), tmpl_str.end());
+        tmpl.push_back(0);
+        path_ = mkdtemp(tmpl.data());
     }
 
     /// @brief Destructor, it deletes temporary folder with its content.
