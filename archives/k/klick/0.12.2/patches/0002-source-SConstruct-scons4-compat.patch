--- a/SConstruct
+++ b/SConstruct
@@ -2,9 +2,19 @@
 
 import os
 
+# SCons 4 compatibility (HarmonyOS PC port): SCons 4 removed the legacy
+# Options / PathOption / BoolOption spellings of the build-variable API, no
+# longer pushes command-line NAME=value into the Environment implicitly (the
+# Variables object has to consume ARGUMENTS itself), and takes the compiler
+# at Environment construction time only. All three are spelled out here so
+# the upstream SConstruct keeps working unmodified apart from these lines.
+from SCons.Variables import Variables, PathVariable, BoolVariable
+
 version = '0.12.2'
 
 env = Environment(
+    CC = os.environ.get('CC', 'clang'),
+    CXX = os.environ.get('CXX', 'clang++'),
     CPPDEFINES = [
         ('VERSION', '\\"%s\\"' % version),
     ],
@@ -12,14 +22,14 @@
 )
 
 # build options
-opts = Options('scache.conf')
-opts.AddOptions(
-    PathOption('PREFIX', 'install prefix', '/usr/local'),
-    PathOption('DESTDIR', 'intermediate install prefix', '', PathOption.PathAccept),
-    BoolOption('DEBUG', 'debug mode', False),
-    BoolOption('OSC', 'OSC support', True),
-    BoolOption('TERMINAL', 'terminal control support', True),
-    BoolOption('RUBBERBAND', 'use Rubber Band for pitch shifting', False),
+opts = Variables('scache.conf', ARGUMENTS)
+opts.AddVariables(
+    PathVariable('PREFIX', 'install prefix', '/usr/local'),
+    PathVariable('DESTDIR', 'intermediate install prefix', '', PathVariable.PathAccept),
+    BoolVariable('DEBUG', 'debug mode', False),
+    BoolVariable('OSC', 'OSC support', True),
+    BoolVariable('TERMINAL', 'terminal control support', True),
+    BoolVariable('RUBBERBAND', 'use Rubber Band for pitch shifting', False),
 )
 opts.Update(env)
 opts.Save('scache.conf', env)
