diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -18,6 +18,15 @@
 include(KDEInstallDirs)
 include(KDECompilerSettings NO_POLICY_SCOPE)
 include(KDECMakeSettings)
+# KDECMakeSettings places shared libraries in bin. On HarmonyOS this can make
+# the linker record a build-tree-relative NEEDED entry for the private sibling
+# library, which no longer resolves after installation. Keep both shared
+# libraries in lib so the public library records the private library SONAME.
+if(KDECORATION3_OHOS OR CMAKE_SYSTEM_NAME MATCHES "^(OHOS|HarmonyOS)$")
+    set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
+    set(CMAKE_INSTALL_RPATH "$ORIGIN")
+    set(CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE)
+endif()
 include(ECMSetupVersion)
 include(ECMGenerateHeaders)
 include(ECMGenerateExportHeader)
