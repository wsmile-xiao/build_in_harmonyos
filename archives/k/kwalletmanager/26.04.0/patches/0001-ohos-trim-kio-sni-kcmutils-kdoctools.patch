diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	2026-04-09 12:24:02.000000000 +0800
+++ b/CMakeLists.txt	2026-10-01 22:09:05.653988906 +0800
@@ -42,28 +42,35 @@
     find_package(KF6 ${KF_MIN_VERSION} REQUIRED Auth)
 endif()
 
+# OHOS adaptation: KCMUtils and KIO are dropped from the required set and
+# StatusNotifierItem becomes optional. The ohpcd conan registry publishes
+# kio/kcmutils/kstatusnotifieritem binaries only on the 6.26 KF6 line while
+# the kwallet/6.18.0 binary closure anchors this build to the 6.18 line
+# (kgoldrunner 26.04.0 KIO-trim precedent). KIO call sites are replaced by
+# direct local-file I/O in src/; the KCM module and its KAuth helper are
+# disabled through ENABLE_KAUTH=OFF in the recipe.
 find_package(KF6 ${KF_MIN_VERSION} REQUIRED
     Archive
+    Codecs
     Config
     ConfigWidgets
     CoreAddons
     DBusAddons
     I18n
-    KCMUtils
-    KIO
+    ItemViews
     Wallet
     WindowSystem
     XmlGui
     Crash
-    StatusNotifierItem
     Service
 )
+find_package(KF6 ${KF_MIN_VERSION} OPTIONAL_COMPONENTS StatusNotifierItem)
 
 if (BUILD_DOC)
     find_package(KF6DocTools ${KF_MIN_VERSION})
     set_package_properties(KF6DocTools PROPERTIES
         DESCRIPTION "Tools to generate documentation"
-        TYPE REQUIRED
+        TYPE OPTIONAL
     )
 endif()
 
@@ -90,7 +97,7 @@
         DESTINATION ${KDE_INSTALL_LOGGINGCATEGORIESDIR}
         )
 
-if (BUILD_DOC)
+if (BUILD_DOC AND KF6DocTools_FOUND)
     add_subdirectory(doc)
     kdoctools_install(po)
 endif()
