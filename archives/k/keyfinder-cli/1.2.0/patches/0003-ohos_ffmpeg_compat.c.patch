+/* OHOS FFmpeg compatibility: provides ohos_av_get_default_channel_layout() which
+ * replaces av_get_default_channel_layout() that was removed from FFmpeg 7.x.
+ * We implement it using av_channel_layout_default() from FFmpeg 7.x.
+ */
+
+#include <stdint.h>
+#include <string.h>
+
+typedef struct OhosAVChannelLayout {
+    int order;
+    int nb_channels;
+    union {
+        uint64_t mask;
+        void *map;
+    } u;
+    void *opaque;
+} OhosAVChannelLayout;
+
+int64_t ohos_av_get_default_channel_layout(int nb_channels)
+{
+    OhosAVChannelLayout ch_layout;
+    memset(&ch_layout, 0, sizeof(ch_layout));
+    av_channel_layout_default(&ch_layout, nb_channels);
+    int64_t layout = ch_layout.u.mask;
+    av_channel_layout_uninit(&ch_layout);
+    return layout;
+}
