 namespace KPackage
 {
+// Additional GenericDataLocation roots to append, taken from the
+// KPACKAGE_EXTRA_DATA_DIRS environment variable (semicolon-separated). On
+// platforms where XDG_DATA_DIRS/XDG_DATA_HOME are not configured (e.g. the OHOS
+// device), the Conan recipe exports the platform data volumes through this
+// variable so KPackage can still discover packages/plugins. The behavior is
+// fully testable in normal builds by setting the variable, without any
+// platform-specific compile-time fork.
+static QStringList extraGenericDataLocations()
+{
+    QStringList locations = QStandardPaths::standardLocations(QStandardPaths::GenericDataLocation);
+    const QString extra = qEnvironmentVariable("KPACKAGE_EXTRA_DATA_DIRS");
+    const QStringList extraRoots = extra.split(QLatin1Char(':'), Qt::SkipEmptyParts);
+    for (const QString &root : extraRoots) {
+        if (!root.isEmpty() && !locations.contains(root)) {
+            locations.append(root);
+        }
+    }
+    return locations;
+}
+
 PackageLoader::PackageLoader()
     : d(new PackageLoaderPrivate)
 {
