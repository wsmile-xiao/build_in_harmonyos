+// KArchive::copyTo() preserves ownership/permissions and, on some extraction
+// paths, relies on privileged syscalls (setreuid/chroot) that are restricted in
+// sandboxed environments (e.g. OHOS). When copyTo() fails, fall back to a plain
+// recursive extraction that only materialises file contents and re-creates the
+// directory tree. The fallback is unconditional and therefore testable in normal
+// builds, not gated behind a platform macro.
+static bool fallbackExtractArchiveEntry(const KArchiveEntry *entry, const QString &destBase)
+{
+    const QString destPath = destBase + QLatin1Char('/') + entry->name();
+    if (entry->isDirectory()) {
+        const auto *dir = static_cast<const KArchiveDirectory *>(entry);
+        QDir d(destPath);
+        if (!d.exists() && !d.mkpath(destPath)) {
+            return false;
+        }
+        const auto subEntries = dir->entries();
+        for (const QString &name : subEntries) {
+            const KArchiveEntry *child = dir->entry(name);
+            if (!child || !fallbackExtractArchiveEntry(child, destPath)) {
+                return false;
+            }
+        }
+        return true;
+    }
+    if (entry->isFile()) {
+        const auto *file = static_cast<const KArchiveFile *>(entry);
+        QFile out(destPath);
+        if (!out.open(QIODevice::WriteOnly)) {
+            return false;
+        }
+        const QByteArray data = file->data();
+        if (out.write(data) != data.size()) {
+            // Short/failed write (e.g. disk full, interrupted): surface an
+            // explicit failure instead of silently producing a truncated file.
+            out.close();
+            return false;
+        }
+        out.close();
+        return true;
+    }
+    // KF6 KArchiveEntry exposes symlink entries through symLinkTarget()
+    // (isFile()/isDirectory() are both false for them). A plain string content
+    // entry (e.g. the standard KZip "mimetype" marker) has an empty target.
+    const QString target = entry->symLinkTarget();
+    if (!target.isEmpty()) {
+        // HMDFS cannot replace an existing symlink in place: remove first.
+        QFile::remove(destPath);
+        return QFile::link(target, destPath);
+    }
+    return true;
+}
+
+static bool fallbackExtractArchive(const KArchiveDirectory *source, const QString &destBase)
+{
+    const auto entries = source->entries();
+    for (const QString &name : entries) {
+        const KArchiveEntry *entry = source->entry(name);
+        if (!entry || !fallbackExtractArchiveEntry(entry, destBase)) {
+            return false;
+        }
+    }
+    return true;
+}
