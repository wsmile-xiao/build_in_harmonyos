Add missing includes that Qt 5.15.19 no longer provides transitively.

Upstream kirigami2 5.116.0 compiles against Qt versions whose headers
leak QColor / QCoreApplication definitions through QQuickItem, QDir and
QIcon includes. The HarmonyOS Qt 5.15.19 chain processes includes
strictly, so three translation units fail without the explicit
includes:

    src/libkirigami/kirigamipluginfactory.cpp:51:35: error: use of
        undeclared identifier 'QCoreApplication'
    src/shadowedrectangle.h:56:12: error: field has incomplete type
        'QColor'

--- a/src/icon.h
+++ b/src/icon.h
@@ -8,6 +8,7 @@
 
 #pragma once
 
+#include <QColor>
 #include <QIcon>
 #include <QPointer>
 #include <QQuickItem>
--- a/src/libkirigami/kirigamipluginfactory.cpp
+++ b/src/libkirigami/kirigamipluginfactory.cpp
@@ -6,6 +6,7 @@
 
 #include "kirigamipluginfactory.h"
 
+#include <QCoreApplication>
 #include <QDebug>
 
 #include <QDir>
--- a/src/shadowedrectangle.h
+++ b/src/shadowedrectangle.h
@@ -6,6 +6,7 @@
 
 #pragma once
 
+#include <QColor>
 #include <QQuickItem>
 #include <memory>
 
