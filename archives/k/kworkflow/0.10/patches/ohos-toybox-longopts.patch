+# OHOS toybox sed lacks GNU --follow-symlinks: a plain `sed -i` replaces a
+# symlink with a regular file, destroying remote.config links created by
+# `kw env`. This helper edits symlinked files through their resolved target,
+# preserving the link (the documented upstream behavior).
+function sed_in_place()
+{
+  local target="${@: -1}"
+
+  if [[ -L "$target" ]]; then
+    target=$(readlink -f "$target")
+    set -- "${@:1:$#-1}" "$target"
+  fi
+
+  sed "$@"
+}
