+// Some musl-based Linux sysroots (OpenHarmony/HarmonyOS) ship a bionic-derived
+// <linux/socket.h> that defines struct sockaddr_storage, which musl's
+// <sys/socket.h> already provides, so including the netlink headers collides.
+// Rename the kernel definition while pulling them in, keeping the libc one the
+// same way glibc-based systems do.
+#if defined(__linux__) && !defined(__GLIBC__)
+#  define sockaddr_storage __linux_uapi_sockaddr_storage
+#  define KEA_RESTORE_SOCKADDR_STORAGE 1
+#endif
 #include <linux/rtnetlink.h>
+#ifdef KEA_RESTORE_SOCKADDR_STORAGE
+#  undef sockaddr_storage
+#  undef KEA_RESTORE_SOCKADDR_STORAGE
+#endif
 
