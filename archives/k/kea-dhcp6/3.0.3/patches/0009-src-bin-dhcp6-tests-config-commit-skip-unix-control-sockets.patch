@@ -7701,6 +7701,14 @@
 TEST_F(Dhcp6ParserTest, comments) {
     setSocketTestPath();
 
+    // This test loads a config with a unix control socket; the
+    // server cannot commit it where AF_UNIX pathname sockets are
+    // not supported.
+    if (!unixControlSocketsUsable()) {
+        GTEST_SKIP() << "PARSER_CONFIGS[9] configures a unix control "
+                        "socket, which this platform cannot host";
+    }
+
     string config = PARSER_CONFIGS[9];
     extractConfig(config);
     configure(config, CONTROL_RESULT_SUCCESS, "");
