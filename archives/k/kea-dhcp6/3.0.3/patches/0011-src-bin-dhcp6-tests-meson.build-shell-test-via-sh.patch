--- a/src/bin/dhcp6/tests/meson.build
+++ b/src/bin/dhcp6/tests/meson.build
@@ -39,9 +39,14 @@
     output: 'dhcp6_process_tests.sh',
     configuration: dhcp6_tests_conf_data,
 )
+# Run the shell test through the POSIX shell: HarmonyOS PC rejects execve()
+# of shebang scripts (EACCES) regardless of the executable bit, so meson's
+# direct execution of the configured script fails there; `sh script` is
+# equivalent on every other platform.
 test(
     'dhcp6_process_tests.sh',
-    dhcp6_process_tests,
+    find_program('sh'),
+    args: [dhcp6_process_tests],
     workdir: current_build_dir,
     is_parallel: false,
     priority: -1,
