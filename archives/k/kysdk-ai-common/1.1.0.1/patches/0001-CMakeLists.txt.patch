diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3e71ae0..766abda 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -20,6 +20,12 @@ set_target_properties(KysdkAiCommon PROPERTIES
     SOVERSION ${PROJECT_VERSION_MAJOR}
 )
 
+# CMake lacks a HarmonyOS platform module, so CMAKE_SHARED_LIBRARY_SONAME_FLAG
+# is empty and VERSION/SOVERSION produce no -Wl,-soname (and no versioned
+# symlinks). Inject the soname explicitly; it matches the installed filename
+# libkysdk-ai-common.so.
+target_link_options(KysdkAiCommon PRIVATE "-Wl,-soname,libkysdk-ai-common.so")
+
 target_include_directories(
     KysdkAiCommon
   INTERFACE $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
@@ -54,4 +60,3 @@ install(FILES "${PROJECT_BINARY_DIR}/KysdkAiCommonConfig.cmake"
         DESTINATION ${CMAKE_INSTALL_DATAROOTDIR}/${PROJECT_NAME}/cmake)
 
 install(DIRECTORY ${PROJECT_SOURCE_DIR}/include/kylin-ai DESTINATION include)
-install(DIRECTORY usr/ DESTINATION /usr)
