+if(KLEVER_WITH_WEBENGINE)
+    target_link_libraries(klevernotes_static PUBLIC
+        Qt::WebChannel
+        Qt::PrintSupport
+        Qt6::WebEngineQuick
+    )
+    # main.cpp is compiled both into klevernotes_static and into the
+    # executable target; PUBLIC definitions reach both compilations.
+    target_compile_definitions(klevernotes_static PUBLIC KLEVER_WITH_WEBENGINE)
+else()
+    # OHOS: upstream reaches QtWidgets (<QApplication> in kleverUtility.cpp,
+    # <QTextEdit> in editorHighlighterPrivate.hpp) transitively through
+    # Qt6::PrintSupport; with the WebEngine/PrintSupport pipeline gated off,
+    # link Widgets explicitly instead.
+    target_link_libraries(klevernotes_static PUBLIC Qt::Widgets)
+    if(NOT KLEVER_QQC2_DESKTOP_STYLE)
+        target_compile_definitions(klevernotes_static PUBLIC KLEVER_NO_QQC2_DESKTOP_STYLE)
+    endif()
+endif()
+
 add_executable(klevernotes
     main.cpp
     resources.qrc
