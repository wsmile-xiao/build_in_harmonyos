+# OHOS (build_in_harmonyos): KLEVER_WITH_WEBENGINE (default OFF, see the top
+# CMakeLists.txt) selects between the upstream WebEngine-based preview and the
+# pure QML rich-text fallback. Empty variables expand to no list entries, so
+# the OFF path drops PrintingPage.qml (QtQuick.Pdf) and printingHelper.cpp
+# (QPrinter / Qt::PrintSupport / PrintingUtility) from the build entirely.
+if(KLEVER_WITH_WEBENGINE)
+    set(KLEVER_PREVIEW_QML contents/ui/textEditor/TextDisplay.qml)
+    set(KLEVER_PRINTING_PAGE_QML contents/ui/pages/PrintingPage.qml)
+    set(KLEVER_PRINTING_SOURCES logic/printing/printingHelper.cpp)
+else()
+    set(KLEVER_PREVIEW_QML contents/ui/textEditor/TextDisplayNative.qml)
+endif()
+
 add_library(klevernotes_static STATIC)
 
 ecm_add_qml_module(klevernotes_static
