+// SPDX-License-Identifier: GPL-3.0-or-later
+// SPDX-FileCopyrightText: 2023-2024 Louis Schul <schul9louis@gmail.com>
+
+/*
+ * OHOS (build_in_harmonyos) pure QML fallback for the markdown preview.
+ *
+ * The upstream TextDisplay.qml renders notes through a WebEngineView (HTML
+ * preview + printToPdf). QtWebEngine is not available on the OHOS port, so
+ * this twin component renders the HTML the parser produced in a read-only
+ * rich-text TextArea instead. It keeps the small interface EditorView.qml
+ * relies on (view, renderedHtml, makePdf(), visible) so the rest of the UI
+ * works unchanged; PDF printing is unavailable by design (PrintingPage.qml
+ * is excluded from the build by the same KLEVER_WITH_WEBENGINE option).
+ * CSS-based theming of the preview is a known degradation: the Qt rich-text
+ * engine ignores <style> blocks, so the editor theme colors are used.
+ */
+
+import QtQuick
+import QtQuick.Controls
+
+import org.kde.kirigami as Kirigami
+
+import org.kde.klevernotes
+
+Item {
+    id: root
+
+    // Interface parity with the WebEngine TextDisplay: EditorView.qml guards
+    // on `view` before calling runJavaScript(); it stays null on this build.
+    readonly property var view: null
+
+    // Last HTML rendered by the parser; consumed by EditorView.qml when the
+    // user exports a note as HTML without a WebEngineView to interrogate.
+    property string renderedHtml: ""
+
+    function makePdf() {
+        // PDF printing requires QtWebEngine (printToPdf); no-op by design.
+    }
+
+    function scrollToHeader() {
+        return
+    }
+
+    Component.onCompleted: {
+        StyleHandler.loadStyle()
+    }
+
+    Connections {
+        target: EditorHandler
+
+        function onRenderingFinished(content) {
+            if (applicationWindow().isMainPage()) {
+                root.renderedHtml = content
+                contentEdit.text = content
+            }
+        }
+    }
+
+    ScrollView {
+        id: scroller
+
+        anchors.fill: parent
+        anchors.margins: Kirigami.Units.largeSpacing
+
+        TextArea {
+            id: contentEdit
+
+            background: null
+            readOnly: true
+            selectByMouse: true
+            textFormat: TextArea.RichText
+            wrapMode: TextArea.Wrap
+            color: Kirigami.Theme.textColor
+            selectionColor: Kirigami.Theme.highlightColor
+            selectedTextColor: Kirigami.Theme.highlightedText
+        }
+    }
+}
