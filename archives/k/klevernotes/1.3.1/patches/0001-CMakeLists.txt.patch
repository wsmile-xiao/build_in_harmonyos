--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -38,6 +38,19 @@
     find_package(Qt6 ${QT_MIN_VERSION} REQUIRED COMPONENTS Test)
 endif()
 
+# OHOS (build_in_harmonyos): QtWebEngine (WebEngineQuick) and PrintSupport
+# are only used by the WebEngine-based markdown preview and the PDF printing
+# pipeline. Neither module is published to the OHOS conan registry, so the
+# whole pipeline (TextDisplay WebEngine preview, PrintingPage PDF viewer,
+# PrintingUtility) is gated behind the KLEVER_WITH_WEBENGINE option (default
+# OFF); the OFF path degrades the preview to a pure QML rich-text renderer
+# (TextDisplayNative.qml).
+option(KLEVER_WITH_WEBENGINE "Build the QtWebEngine-based preview and PDF printing pipeline" OFF)
+# OHOS (build_in_harmonyos): the org.kde.desktop Qt Quick Controls style
+# lives in qqc2-desktop-style, which is not published to the OHOS conan
+# registry; builds without it fall back to the built-in Basic style.
+option(KLEVER_QQC2_DESKTOP_STYLE "The org.kde.desktop QQC2 style (qqc2-desktop-style) is available" ON)
+
 find_package(Qt6 ${QT_MIN_VERSION} REQUIRED COMPONENTS
     Core
     Gui
@@ -44,10 +57,15 @@
     Qml
     QuickControls2
     Svg
-    PrintSupport
-    WebEngineQuick
 )
 
+if(KLEVER_WITH_WEBENGINE)
+    find_package(Qt6 ${QT_MIN_VERSION} REQUIRED COMPONENTS
+        PrintSupport
+        WebEngineQuick
+    )
+endif()
+
 find_package(KF6 ${KF_MIN_VERSION} REQUIRED COMPONENTS
     Kirigami
