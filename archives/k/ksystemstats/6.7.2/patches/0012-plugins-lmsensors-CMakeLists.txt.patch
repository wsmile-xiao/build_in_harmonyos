--- a/plugins/lmsensors/CMakeLists.txt
+++ b/plugins/lmsensors/CMakeLists.txt
@@ -1,9 +1,17 @@
 # SPDX-License-Identifier: BSD-2-Clause
 # SPDX-FileCopyrightText: 2021 David Redondo <kde@david-redondo.de>
 
 add_library(ksystemstats_plugin_lmsensors MODULE lmsensors.cpp)
 
 target_link_libraries(ksystemstats_plugin_lmsensors PRIVATE Qt::Core KF6::CoreAddons KF6::I18n KSysGuard::SystemStats)
 
+# lm-sensors is found by the top-level find_package(Sensors); its headers and
+# libraries are not in the default search paths on this platform. This
+# directory is only added when KSYSTEMSTATS_HAVE_SENSORS is set.
+if (KSYSTEMSTATS_HAVE_SENSORS)
+    target_include_directories(ksystemstats_plugin_lmsensors PRIVATE ${SENSORS_INCLUDE_DIR})
+    target_link_libraries(ksystemstats_plugin_lmsensors PRIVATE ${SENSORS_LIBRARIES})
+endif()
+
 install(TARGETS ksystemstats_plugin_lmsensors DESTINATION ${KSYSTEMSTATS_PLUGIN_INSTALL_DIR})
 
