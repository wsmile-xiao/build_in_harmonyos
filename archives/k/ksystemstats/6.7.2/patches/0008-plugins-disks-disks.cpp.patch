 void VolumeObject::update()
 {
     if (mountPoint.isEmpty()) {
         // skip non-mounted partitions
         return;
     }
+#ifdef KSYSTEMSTATS_USE_KIO
     auto job = KIO::fileSystemFreeSpace(QUrl::fromLocalFile(mountPoint));
     connect(job, &KJob::result, this, [this, job]() {
         if (!job->error()) {
             KIO::filesize_t size = job->size();
             KIO::filesize_t available = job->availableSize();
             m_total->setValue(size);
             m_free->setValue(available);
             m_free->setMax(size);
             m_used->setValue(size - available);
             m_used->setMax(size);
         }
     });
+#else
+    // KIO-free fallback: KIO::fileSystemFreeSpace resolves local URLs through
+    // QStorageInfo internally, so querying it directly yields the same numbers
+    // without pulling in the KF6KIO stack. The path is bound to a named
+    // variable so the declaration cannot be read as a function prototype.
+    const QString mountPath(mountPoint);
+    const QStorageInfo storage(mountPath);
+    if (!storage.isValid() || !storage.isReady()) {
+        return;
+    }
+    const quint64 size = storage.bytesTotal();
+    const quint64 available = storage.bytesAvailable();
+    m_total->setValue(size);
+    m_free->setValue(available);
+    m_free->setMax(size);
+    m_used->setValue(size - available);
+    m_used->setMax(size);
+#endif
 }
 
 void VolumeObject::setBytes(quint64 read, quint64 written, qint64 elapsed)
 {
     if (elapsed != 0) {
         double seconds = elapsed / 1000.0;
         m_readRate->setValue((read - m_bytesRead) / seconds);
         m_writeRate->setValue((written - m_bytesWritten) / seconds);
     }
     m_bytesRead = read;
