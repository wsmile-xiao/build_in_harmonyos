 cmake_minimum_required(VERSION 3.16)
 
 set(PROJECT_VERSION "6.7.2")
 project(ksystemstats VERSION ${PROJECT_VERSION})
 
 set(PROJECT_DEP_VERSION "6.7.0")
 set(QT_MIN_VERSION "6.10.0")
-set(KF6_MIN_VERSION "6.26.0")
+set(KF6_MIN_VERSION "6.18.0")
 set(KDE_COMPILERSETTINGS_LEVEL "5.82")
+
+# HarmonyOS is Linux-kernel based and its toolchain defines __linux__, so the
+# upstream Linux code paths (the sensor and rtnetlink backends, the /proc
+# readers) are the correct ones for HarmonyOS as well. Treat Linux and
+# HarmonyOS as a single "Linux-like" platform family so the CMake gates below
+# select exactly the sources the preprocessor branches already compile.
+if (CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")
+    set(KSYSTEMSTATS_LINUX_PLATFORM TRUE)
+else()
+    set(KSYSTEMSTATS_LINUX_PLATFORM FALSE)
+endif()
+
+# KIO is used by the disks plugin only, for a single statfs call. Keeping it
+# selectable lets a dependency set without a KF6KIO provider build the
+# equivalent QStorageInfo path instead (see plugins/disks/).
+option(KSYSTEMSTATS_USE_KIO "Report filesystem free space through KIO" ON)
 
 find_package(ECM ${KF6_MIN_VERSION} REQUIRED NO_MODULE)
 set(CMAKE_MODULE_PATH ${ECM_MODULE_PATH}  ${CMAKE_CURRENT_SOURCE_DIR}/cmake)
 
 include(CheckIncludeFiles)
 include(KDEInstallDirs)
 include(KDECMakeSettings)
 include(KDECompilerSettings NO_POLICY_SCOPE)
 include(KDEClangFormat)
 include(ECMAddTests)
 include(ECMInstallIcons)
 include(FeatureSummary)
 include(ECMConfiguredInstall)
 include(ECMGenerateDBusServiceFile)
 include(ECMDeprecationSettings)
 include(ECMQtDeclareLoggingCategory)
 include(ECMSetupVersion)
 
 find_package(Qt6 ${QT_MIN_VERSION} CONFIG REQUIRED COMPONENTS Core Test)
-find_package(KF6 ${KF6_MIN_VERSION} REQUIRED COMPONENTS CoreAddons Solid KIO Crash)
+if (KSYSTEMSTATS_USE_KIO)
+    find_package(KF6 ${KF6_MIN_VERSION} REQUIRED COMPONENTS CoreAddons Solid KIO Crash)
+else()
+    find_package(KF6 ${KF6_MIN_VERSION} REQUIRED COMPONENTS CoreAddons Solid Crash)
+endif()
 find_package(KSysGuard ${PROJECT_DEP_VERSION} REQUIRED)
+
+# KSysGuard's exported targets reference Qt6::Qml, Qt6::Quick and KF6::Service
+# in their link interfaces, but the shipped KSysGuardConfig.cmake only
+# resolves Qt6Core/Qt6Network/Qt6Widgets and KF6Config/KF6I18n. Import the
+# remaining components before the KSysGuard import so those targets exist
+# (they ship in the separate qtdeclarative and kservice packages).
+find_package(Qt6Qml CONFIG REQUIRED)
+find_package(Qt6Quick CONFIG REQUIRED)
+find_package(KF6Service CONFIG REQUIRED)
+
+# The lm-sensors based temperature sensors need lm-sensors itself plus a
+# KSysGuard package exporting makeSensorsFeatureSensor, which the latter only
+# provides when it was configured with lm-sensors. Builders whose dependency
+# set lacks either can turn KSYSTEMSTATS_WITH_LM_SENSORS off (or simply not
+# provide lm-sensors) and still get the CPU/memory/disk/network/pressure
+# plugins.
+option(KSYSTEMSTATS_WITH_LM_SENSORS
+       "Build the lm-sensors based temperature sensors (also requires a KSysGuard package built with lm-sensors)"
+       ON)
 
 # there's no NetworkManager on FreeBSD'
 if (LINUX)
