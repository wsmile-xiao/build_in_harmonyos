 endif()
 
 add_definitions(-DQT_NO_URL_CAST_FROM_STRING)
 add_definitions(-DQT_USE_QSTRINGBUILDER)
 
 ecm_setup_version(PROJECT VARIABLE_PREFIX KSYSTEMSTATS
