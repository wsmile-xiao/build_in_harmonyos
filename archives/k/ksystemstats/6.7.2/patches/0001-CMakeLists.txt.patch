-if (${CMAKE_SYSTEM_NAME} MATCHES "Linux")
+if (KSYSTEMSTATS_LINUX_PLATFORM)
+    # lm-sensors stays RECOMMENDED rather than REQUIRED here: the platform
+    # dependency set may not provide it, and the sensors based temperature
+    # sensors additionally need a KSysGuard package that was itself built with
+    # lm-sensors (its SystemStats only compiles SensorsFeatureSensor.cpp when
+    # SENSORS_FOUND, so makeSensorsFeatureSensor is only exported then). The
+    # KSYSTEMSTATS_HAVE_SENSORS switch below keeps both conditions together and
+    # lets a dependency set fall back to the sensors-free paths instead of
+    # failing to link.
     find_package(Sensors)
     set_package_properties(Sensors PROPERTIES
-            TYPE REQUIRED
+            TYPE RECOMMENDED
             PURPOSE "Used for reading hardware sensors that aren't covered by other plugins."
             URL "https://github.com/lm-sensors/lm-sensors"
         )
+
+    # Evaluated here, after both find_package(Sensors) and the KSysGuard import
+    # above: SENSORS_FOUND is only defined once Sensors has been searched for, so
+    # this switch has to be set after that point.
+    if (KSYSTEMSTATS_LINUX_PLATFORM AND SENSORS_FOUND AND KSYSTEMSTATS_WITH_LM_SENSORS)
+        set(KSYSTEMSTATS_HAVE_SENSORS TRUE)
+    else()
+        set(KSYSTEMSTATS_HAVE_SENSORS FALSE)
+    endif()
 
