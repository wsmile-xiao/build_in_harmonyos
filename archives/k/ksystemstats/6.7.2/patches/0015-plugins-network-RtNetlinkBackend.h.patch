+// On Linux systems that do not use glibc the C library's sys/socket.h and the
+// kernel's linux/socket.h both define struct sockaddr_storage, and libnl pulls
+// the kernel header in. Parse the C library header first, then parse the
+// kernel header once with its duplicate definition renamed: the header's own
+// include guard makes every later inclusion from libnl a no-op, and the macro
+// is gone again before any other header is parsed. glibc coordinates the two
+// headers by itself, so it is left untouched.
+#include <sys/socket.h>
+#if defined(__linux__) && !defined(__GLIBC__)
+#define sockaddr_storage __linux_sockaddr_storage
+#include <linux/socket.h>
+#undef sockaddr_storage
+#endif
