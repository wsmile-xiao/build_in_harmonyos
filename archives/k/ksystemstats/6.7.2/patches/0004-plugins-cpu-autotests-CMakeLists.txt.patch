--- a/plugins/cpu/autotests/CMakeLists.txt
+++ b/plugins/cpu/autotests/CMakeLists.txt
@@ -1,20 +1,35 @@
 # SPDX-License-Identifier: BSD-2-Clause
 # SPDX-FileCopyrightText: 2024 Arjen Hiemstra <ahiemstra@heimr.nl>
 
-if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
+if (KSYSTEMSTATS_LINUX_PLATFORM)
     get_target_property(_bindir ksystemstats_plugin_cpu BINARY_DIR)
+
+    # The test compiles the plugin sources directly, so it needs the same
+    # private dependencies as the plugin itself: KF6::I18n (KLocalizedString
+    # in cpu.cpp) and, when sensors support is built in, lm-sensors
+    # (linuxcpu.cpp/linuxcpuplugin.cpp). Those headers and libraries are not in
+    # the default search paths here.
+    set(_test_extra_libs KF6::I18n)
+    set(_test_extra_includes ${_bindir})
+    if (KSYSTEMSTATS_HAVE_SENSORS)
+        list(APPEND _test_extra_libs ${SENSORS_LIBRARIES})
+        list(APPEND _test_extra_includes ${SENSORS_INCLUDE_DIR})
+    endif()
 
     ecm_add_test(
         TestLinuxCpu.cpp
         ../cpu.cpp
         ../cpuplugin.cpp
         ../linuxcpu.cpp
         ../linuxcpuplugin.cpp
         ../loadaverages.cpp
         ../usagecomputer.cpp
         ${_bindir}/debug.cpp
         TEST_NAME TestLinuxCpu
-        LINK_LIBRARIES Qt::Test KF6::CoreAddons KSysGuard::SystemStats
+        LINK_LIBRARIES Qt::Test KF6::CoreAddons KSysGuard::SystemStats ${_test_extra_libs}
     )
-    target_include_directories(TestLinuxCpu PRIVATE ${_bindir})
+    target_include_directories(TestLinuxCpu PRIVATE ${_test_extra_includes})
+    if (KSYSTEMSTATS_HAVE_SENSORS)
+        target_compile_definitions(TestLinuxCpu PRIVATE HAVE_SENSORS)
+    endif()
 endif()
