--- a/src/matrix/kaldi-blas.h
+++ b/src/matrix/kaldi-blas.h
@@ -94,10 +94,16 @@
   }
 #elif defined(HAVE_OPENBLAS)
   #include <complex>
-  // getting cblas.h and lapacke.h from <openblas-install-dir>/.
+  // getting cblas.h from <openblas-install-dir>/.
   // putting in "" not <> to search -I before system libraries.
   #include "cblas.h"
-  #include "lapacke.h"
+  // LAPACK >= 3.10 headers (as shipped by recent OpenBLAS) declare the Fortran
+  // entry points with trailing hidden string-length arguments, while
+  // cblas-wrappers.h calls them in the classic CLAPACK pointer style. Use the
+  // CLAPACK prototypes bundled with Kaldi (same routine ABI, plain pointer
+  // arguments) instead of <lapacke.h> so that both agree.
+  #include "../../tools/CLAPACK/f2c.h"
+  #include "../../tools/CLAPACK/clapack.h"
   #undef I
   #undef complex
   // get rid of macros from f2c.h -- these are dangerous.
