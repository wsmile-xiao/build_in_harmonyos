diff --git a/src/plugins/feedback/hfd-service/CMakeLists.txt b/src/plugins/feedback/hfd-service/CMakeLists.txt
--- a/src/plugins/feedback/hfd-service/CMakeLists.txt
+++ b/src/plugins/feedback/hfd-service/CMakeLists.txt
@@ -1,3 +1,10 @@
+# The qt_add_dbus_interface macro is provided by the Qt6DBus CMake package
+# (Qt6DBusMacros.cmake). The upstream file calls the macro and links
+# Qt6::DBus without declaring find_package(Qt6 COMPONENTS DBus) first, which
+# silently works in a full desktop Qt install but fails in a clean/isolated
+# (conan) build where only the explicitly requested Qt6 components are loaded.
+find_package(Qt6 REQUIRED COMPONENTS DBus)
+
 qt_add_resources(FEEDBACK_RESOURCES )
 
 qt_add_dbus_interface(QTFEEDBACK_HFD_SRC
