 include(KDEFrameworkCompilerSettings NO_POLICY_SCOPE)
+# OHOS adaptation: KDEFrameworkCompilerSettings adds -DQT_NO_CAST_FROM_ASCII
+# which deletes the QString(const char*) constructor. kconfig 6.26 (KF6)
+# removed the deprecated KConfigGroup(KConfigBase*, const char*) overload, so
+# the KF5-style char-array config group names used throughout this codebase
+# (9 static const char[] group names + 8 string-literal call sites) can only
+# compile through the implicit QString conversion. Remove the define so the
+# constructor is available again (style-only strictness, no semantic change).
+remove_definitions(-DQT_NO_CAST_FROM_ASCII)
