@@ -1,9 +1,18 @@
 # SPDX-FileCopyrightText: 2022-2023 Laurent Montel <montel@kde.org>
 # SPDX-License-Identifier: BSD-3-Clause
-add_subdirectory(bing)  
-add_subdirectory(deepl)
+# OHOS adaptation: the deepl and libretranslate plugins store API credentials
+# through Qt6Keychain, which is not part of the ohpcd baseline (its conan
+# recipe pulls a second Qt tree via qtbase-sql-dbus). Guard both plugins on
+# the qt6keychain target so they are skipped gracefully when the library is
+# absent.
+add_subdirectory(bing)
+if (TARGET qt6keychain)
+    add_subdirectory(deepl)
+endif()
 add_subdirectory(google)
-add_subdirectory(libretranslate)
+if (TARGET qt6keychain)
+    add_subdirectory(libretranslate)
+endif()
 add_subdirectory(lingva)
 add_subdirectory(yandex)
 if (BERGAMOT_TRANSLATOR_PLUGIN)
