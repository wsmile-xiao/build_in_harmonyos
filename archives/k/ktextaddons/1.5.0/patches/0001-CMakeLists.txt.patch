@@ -41,6 +41,12 @@
 
 find_package(Qt${QT_MAJOR_VERSION} ${REQUIRED_QT_VERSION} CONFIG REQUIRED Widgets Core Network)
 
+# OHOS adaptation: kio is published on ohpcd as a KIOCore-only package
+# (KIOCORE_ONLY=ON, no KIOWidgets/KIOGui targets) and Qt6Keychain/Qt6TextToSpeech
+# are not part of the ohpcd baseline. Drop KIO from the required component set
+# (its only consumer, the textcustomeditor web-shortcut menu, is removed by a
+# companion patch) and make the Qt6Keychain lookup informational so the deepl
+# and libretranslate translator plugins are skipped gracefully.
 find_package(KF${KF_MAJOR_VERSION} ${KF_MIN_VERSION} REQUIRED COMPONENTS
     I18n
     ConfigWidgets
