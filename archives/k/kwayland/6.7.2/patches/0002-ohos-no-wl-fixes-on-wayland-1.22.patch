From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LIMInGZE666 <LIMInGZE666@noreply.gitcode.com>
Date: Thu, 2 Oct 2026 12:00:00 +0800
Subject: [PATCH] OHOS: compile out wl_fixes support on Wayland 1.22

wl_fixes is an interface added in Wayland 1.24; the ohpcd ecosystem pins
wayland/1.22.0 (qtbase/6.11.1.2 and qtwayland/6.11.1 both require it,
mixing 1.24.0 is a graph conflict, see 0001).

Two places need adapting:

- src/client/registry.cpp uses the wl_fixes interface unconditionally.
  Guard every use with WL_FIXES_INTERFACE, the macro the generated
  wayland-client-protocol.h defines from Wayland 1.24 on; the 1.22
  headers do not define it, so the code compiles out. No functionality
  is lost: a Wayland 1.22 compositor cannot announce wl_fixes at all.
- src/client/surface_p.cpp includes QtWaylandClient private headers
  whose generated qwayland-wayland.h refers to struct ::wl_fixes without
  a guard (its wrapper class stores a struct ::wl_fixes *). The 1.22
  headers do not declare the type, so forward-declare the incomplete
  type; only the pointer type is needed and nothing here calls into it.

Both adaptations are no-ops with Wayland >= 1.24.
---
 src/client/registry.cpp  | 12 ++++++++++++
 src/client/surface_p.cpp |  8 ++++++++
 2 files changed, 20 insertions(+)

diff --git a/src/client/registry.cpp b/src/client/registry.cpp
index e963882..7c48317 100644
--- a/src/client/registry.cpp
+++ b/src/client/registry.cpp
@@ -338,7 +338,9 @@ public:
     WaylandPointer<wl_registry, wl_registry_destroy> registry;
     static const struct wl_callback_listener s_callbackListener;
     WaylandPointer<wl_callback, wl_callback_destroy> callback;
+#ifdef WL_FIXES_INTERFACE
     WaylandPointer<wl_fixes, wl_fixes_destroy> fixes;
+#endif
     EventQueue *queue = nullptr;
 
 private:
@@ -383,12 +385,16 @@ Registry::~Registry()
 
 void Registry::release()
 {
+#ifdef WL_FIXES_INTERFACE
     if (d->fixes && d->registry) {
         wl_fixes_destroy_registry(d->fixes, d->registry);
     }
+#endif
     d->registry.release();
     d->callback.release();
+#ifdef WL_FIXES_INTERFACE
     d->fixes.release();
+#endif
 }
 
 void Registry::destroy()
@@ -396,7 +402,9 @@ void Registry::destroy()
     Q_EMIT registryDestroyed();
     d->registry.destroy();
     d->callback.destroy();
+#ifdef WL_FIXES_INTERFACE
     d->fixes.destroy();
+#endif
 }
 
 void Registry::create(wl_display *display)
@@ -435,9 +443,11 @@ void Registry::setEventQueue(EventQueue *queue)
     if (d->callback) {
         d->queue->addProxy(d->callback);
     }
+#ifdef WL_FIXES_INTERFACE
     if (d->fixes) {
         d->queue->addProxy(d->fixes);
     }
+#endif
 }
 
 EventQueue *Registry::eventQueue()
@@ -495,12 +505,14 @@ static Registry::Interface nameToInterface(const char *interface)
 void Registry::Private::handleAnnounce(uint32_t name, const char *interface, uint32_t version)
 {
     Interface i = nameToInterface(interface);
+#ifdef WL_FIXES_INTERFACE
     if (qstrcmp(interface, wl_fixes_interface.name) == 0) {
         fixes.setup(reinterpret_cast<wl_fixes *>(wl_registry_bind(registry, name, &wl_fixes_interface, 1)));
         if (queue) {
             queue->addProxy(fixes);
         }
     }
+#endif
 
     if (i == Interface::Unknown) {
         qCDebug(KWAYLAND_CLIENT) << "Unknown interface announced: " << interface << "/" << name << "/" << version;
diff --git a/src/client/surface_p.cpp b/src/client/surface_p.cpp
index 2b57e34..3efa8d4 100644
--- a/src/client/surface_p.cpp
+++ b/src/client/surface_p.cpp
@@ -7,6 +7,14 @@
 #include "surface_p.h"
 #include "surface.h"
 
+// wl_fixes (Wayland >= 1.24) is not declared by the 1.22 headers, but the
+// QtWaylandClient private header included below refers to struct ::wl_fixes
+// unconditionally (its wrapper class takes a struct ::wl_fixes *). Only the
+// incomplete type is needed here; nothing calls into the interface.
+#ifndef WL_FIXES_INTERFACE
+struct wl_fixes;
+#endif
+
 #include <QGuiApplication>
 #include <private/qwaylandwindow_p.h>
 #include <qpa/qplatformnativeinterface.h>
