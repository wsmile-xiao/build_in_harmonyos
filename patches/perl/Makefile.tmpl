# Makefile.tmpl - Perl 5.42.2 build for HarmonyOS/aarch64
#
# This is a static Makefile template for building perl on platforms where
# the standard Configure-generated Makefile cannot be used (e.g., cross-compile
# or constrained environments).
#
# Variables that may need adjustment for different platforms:
#   CC, CFLAGS, LDFLAGS, LIBS, PREFIX, SYSTEM_PERL_CORE

# ===== Toolchain =====
CC       = __CC__
CFLAGS   = -D_GNU_SOURCE -fno-strict-aliasing -pipe -fstack-protector-strong \
           -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -fPIC -O2 \
           -DPERL_CORE -DUSE_PERLIO \
           -include sys/types.h
LDFLAGS  = -fstack-protector-strong
AR       = __AR__
RANLIB   = :

# ===== Installation prefix =====
PREFIX   = __PREFIX__

# ===== Libraries =====
LIBS     = -lpthread -ldl -lm -lcrypt -lutil -lc

# ===== System perl (for header files) =====
SYSTEM_PERL_CORE = __SYSTEM_PERL_CORE__

# ===== Source/object files =====
#
# Object file list derived from Makefile.SH common_objs + mini_only_objs,
# with the following exclusions:
#   - locale.c      → replaced by locale_stub.c (glibc _NL_* incompatibility)
#   - vutil.c       → NOT compiled separately (#included by util.c)
#   - generate_uudmap.c → has its own main(), standalone utility
#   - malloc.o      → not linked (use system malloc, MYMALLOC crashes)
#   - miniperlmain.o → only for miniperl, not full perl
#   - perlmain.o     → only for full perl, not miniperl

COMMON_OBJS = \
  av.o builtin.o caretx.o class.o deb.o doio.o doop.o dquote.o dump.o \
  globals.o gv.o hv.o keywords.o \
  mathoms.o mg.o mro_core.o numeric.o op.o pad.o peep.o \
  perlio.o perly.o pp.o pp_ctl.o pp_hot.o pp_pack.o pp_sort.o \
  pp_sys.o reentr.o regcomp.o regcomp_debug.o regcomp_invlist.o \
  regcomp_study.o regcomp_trie.o regexec.o run.o scope.o sv.o taint.o \
  time64.o toke.o universal.o utf8.o util.o

STUB_OBJS = locale_stub.o

MINI_MAIN = miniperlmain.o
FULL_MAIN = perlmain.o

MINI_OBJS = $(COMMON_OBJS) $(STUB_OBJS) $(MINI_MAIN)
FULL_OBJS = $(COMMON_OBJS) $(STUB_OBJS) $(FULL_MAIN)

# ===== Targets =====

.PHONY: all miniperl perl install clean test

all: miniperl perl

miniperl: $(MINI_OBJS)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(MINI_OBJS) $(LIBS)
	@echo "=== miniperl built successfully ==="

perl: lib/Config.pm $(FULL_OBJS)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(FULL_OBJS) $(LIBS)
	@echo "=== perl built successfully ==="

lib/Config.pm: miniperl config.sh
	./miniperl -Ilib configpm

# ===== Compilation rules =====

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

# ===== Installation =====

install: perl
	install -d $(PREFIX)/bin
	install -d $(PREFIX)/lib
	install -m 755 perl $(PREFIX)/bin/perl
	install -m 755 miniperl $(PREFIX)/bin/miniperl
	cp -r lib/* $(PREFIX)/lib/
	@echo "=== Installed to $(PREFIX) ==="

# ===== Clean =====

clean:
	rm -f *.o miniperl perl lib/Config.pm lib/Config_heavy.pl lib/Config.pod

distclean: clean
	rm -f config.sh Policy.sh config.h
