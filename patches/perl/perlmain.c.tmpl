/* perlmain.c - main() entry point for full perl binary
 *
 * This is a static template for platforms where ExtUtils::Miniperl cannot
 * run (e.g., during bootstrap/cross-compile when XS modules like Cwd
 * are not yet available).
 *
 * Based on miniperlmain.c with DynaLoader support added.
 * For the canonical version, see regen/miniperlmain.pl and
 * ext/ExtUtils-Miniperl/lib/ExtUtils/Miniperl.pm.
 */

#ifdef OEMVS
#ifdef MYMALLOC
#pragma runopts(HEAP(8M,500K,ANYWHERE,KEEP,8K,4K) STACK(,,ANY,) ALL31(ON))
#else
#pragma runopts(HEAP(2M,500K,ANYWHERE,KEEP,8K,4K) STACK(,,ANY,) ALL31(ON))
#endif
#endif

#define PERL_IN_MINIPERLMAIN_C
#define PERL_CORE 1

#include "EXTERN.h"
#include "perl.h"
#include "XSUB.h"

static void xs_init(pTHX);
static PerlInterpreter *my_perl;

#ifdef NO_ENV_ARRAY_IN_MAIN
extern char **environ;
int
main(int argc, char **argv)
#else
int
main(int argc, char **argv, char **env)
#endif
{
    int exitstatus, i;
#ifndef NO_ENV_ARRAY_IN_MAIN
    PERL_UNUSED_ARG(env);
#endif

    /* if user wants control of gprof profiling off by default */
    PERL_GPROF_MONCONTROL(0);

#ifdef NO_ENV_ARRAY_IN_MAIN
    PERL_SYS_INIT3(&argc,&argv,&environ);
#else
    PERL_SYS_INIT3(&argc,&argv,&env);
#endif

#if defined(USE_ITHREADS)
    PTHREAD_ATFORK(Perl_atfork_lock,
                   Perl_atfork_unlock,
                   Perl_atfork_unlock);
#endif

    PERL_SYS_FPU_INIT;

    if (!PL_do_undump) {
	my_perl = perl_alloc();
	if (!my_perl)
	    exit(1);
	perl_construct(my_perl);
	PL_perl_destruct_level = 0;
    }
    PL_exit_flags |= PERL_EXIT_DESTRUCT_END;
    if (!perl_parse(my_perl, xs_init, argc, argv, (char **)NULL)) {
        assert(!PL_restartop);
        perl_run(my_perl);
    }

    for (i = 1; PL_sig_name[i]; i++) {
	if (rsignal_state(PL_sig_num[i]) == (Sighandler_t) PL_csighandlerp) {
	    rsignal(PL_sig_num[i], (Sighandler_t) SIG_DFL);
	}
    }

    exitstatus = perl_destruct(my_perl);

    perl_free(my_perl);

    PERL_SYS_TERM();

    exit(exitstatus);
}

/*
 * xs_init - Register statically-linked XS extensions
 *
 * Add newXS() calls here for any extensions that are statically linked
 * into the perl binary. DynaLoader is registered below if available.
 */
static void
xs_init(pTHX)
{
    dXSUB_SYS;
    PERL_UNUSED_CONTEXT;

    /*
     * DynaLoader is registered here. If DynaLoader was compiled as a
     * shared library and will be loaded dynamically, comment out the
     * following line. For static builds, uncomment it.
     */
    /*
     * extern void boot_DynaLoader(pTHX_ CV* cv);
     * char *file = __FILE__;
     * newXS("DynaLoader::boot_DynaLoader", boot_DynaLoader, file);
     */
}

