/*
 * locale_stub.c - Stub implementations of locale.c functions
 *
 * This file replaces locale.c on platforms where the full locale.c cannot
 * be compiled (e.g., HarmonyOS/musl where glibc-specific _NL_* constants
 * are referenced but not available).
 *
 * Provides minimal stub implementations for all symbols normally defined in
 * locale.c that are referenced by other compilation units.
 */

#include "EXTERN.h"
#define PERL_IN_LOCALE_C
#include "perl.h"

/*
 * Perl_init_i18nl10n - Initialize internationalization/locale subsystem
 * Returns: 0 on success (stub always succeeds)
 */
int
Perl_init_i18nl10n(pTHX_ int printwarn)
{
    PERL_UNUSED_ARG(printwarn);
    return 0;
}

/*
 * Perl_is_in_locale_category_ - Check if we're in a specific locale category
 * Returns: FALSE (stub - no locale categories active)
 */
bool
Perl_is_in_locale_category_(pTHX_ const bool compiling, const int category)
{
    PERL_UNUSED_ARG(compiling);
    PERL_UNUSED_ARG(category);
    return FALSE;
}

/*
 * Perl_set_numeric_standard - Set numeric locale to C/POSIX standard
 */
void
Perl_set_numeric_standard(pTHX_ const char * const file, const line_t line)
{
    PERL_UNUSED_ARG(file);
    PERL_UNUSED_ARG(line);
}

/*
 * Perl_set_numeric_underlying - Restore underlying numeric locale
 */
void
Perl_set_numeric_underlying(pTHX_ const char * const file, const line_t line)
{
    PERL_UNUSED_ARG(file);
    PERL_UNUSED_ARG(line);
}

/*
 * Perl_warn_problematic_locale - Warn about problematic locale settings
 */
void
Perl_warn_problematic_locale(void)
{
    /* No-op stub */
}

/*
 * Perl_my_strerror - Thread-safe strerror wrapper
 * Returns: result of standard strerror()
 */
const char *
Perl_my_strerror(pTHX_ const int errnum, utf8ness_t * utf8ness)
{
    PERL_UNUSED_ARG(utf8ness);
    return strerror(errnum);
}

/*
 * Perl_mem_collxfrm_ - String collation transformation for sorting
 * Returns: pointer to original string (no actual collation transform)
 *
 * Note: This means sort() with locale will use byte order, not collation order.
 * Acceptable for a stub; proper locale support would need full locale.c.
 */
char *
Perl_mem_collxfrm_(pTHX_ const char *input_string, STRLEN len, STRLEN *xlen, bool utf8)
{
    PERL_UNUSED_ARG(utf8);
    /* Fallback: return original string, no collation transformation */
    *xlen = len;
    return (char *) input_string;
}
