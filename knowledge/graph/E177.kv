id: E177
trigger_tool:           python
phase:                  configuration
error_signature:        ImportError: No module named 'distutils.msvccompiler'
severity:               2
category:               build-system
match_keywords:         distutils, msvccompiler, Python3.12, ImportError

root_cause:             Python 3.12 移除了 distutils 模块，setuptools 提供的兼容层将 msvccompiler 重命名为 _msvccompiler
affected_scope:         所有使用 distutils.msvccompiler 的软件（autotools 构建系统）
verification_cmd:       grep -r "from distutils.msvccompiler import" source/

