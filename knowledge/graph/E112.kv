# Layer 0: 错误面
id: E112
trigger_tool:           config.status
phase:                  configuration
error_signature:        can't create ./confXXXXXX/subs1.awk: Permission denied|config\.status: error: could not setup config files machinery

# Layer 1: 识别层
severity:               3
category:               platform, hmdfs
match_keywords:         mktemp, Permission denied, subs1.awk, config.status, HMDFS, temporary directory, autotools

# Layer 2: 诊断层
root_cause:             HMDFS 文件系统上，mktemp -d 创建的临时目录权限为 drwx--S--- (2700 + setgid)，
                        导致即使目录 owner 是当前用户，也无法在其中创建文件。这是 HMDFS 的安全限制，
                        chmod 也无法修改权限（参见 E046）。
affected_scope:         所有使用 autotools 构建系统且依赖 mktemp 创建临时目录的软件
verification_cmd:       ls -ld $TMPDIR/conf* 2>/dev/null | grep "drwx--S---"

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           bypass-mktemp
rec_description:        在 configure/config.status 运行前，预先创建临时目录（不使用 mktemp），并修改脚本中的 tmp/ac_tmp 变量指向该目录
rec_command:            export TMPDIR=/storage/Users/currentUser/tmp && TEMP_DIR=$TMPDIR/fixed-temp-$$ && mkdir -p $TEMP_DIR && sed -i "s|ac_tmp=\$tmp|ac_tmp=$TEMP_DIR|g" configure config.status
rec_auto_fix:          false
rec_impl:               manual-patch

fallback_priority:      2
fallback_approach:      copy-to-tmpfs
fallback_description:   将整个工作目录复制到 $TMPDIR，在其中运行 configure（绕过 HMDFS 限制）
fallback_command:       cp -r ~/tmp/builds/sw-X.Y.work $TMPDIR/sw-build && cd $TMPDIR/sw-build && ./configure --prefix=$DEFAULT_PREFIX
fallback_auto_fix:     false
fallback_impl:          directory-copy

# Layer 4: 原则引用
principles:               

