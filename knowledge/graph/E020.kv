#====================================================================
# E020.kv — musl FILE 结构差异
#====================================================================

id:                     E020
title: musl FILE 结构差异
trigger_tool:           cc|clang|configure
phase:                  compilation
error_signature:        incomplete definition.*_IO_FILE|
                         _IO_read_ptr.*undeclared|
                         _IO_write_ptr.*undeclared|

severity:               2
category:               libc|compat
match_keywords:         _IO_FILE, _IO_read_ptr, _IO_write_ptr,
                         musl, glibc, opaque type, incomplete definition,
                         undeclared, struct __FILE, stdio internals

root_cause:             musl 的 FILE 结构是不透明类型,
                         内部字段(_IO_read_ptr/_IO_write_ptr等)不可访问;
                         glibc 允许直接访问这些内部字段
affected_scope:         直接操作 FILE 内部字段的 C 项目(coreutils, bash 等)
verification_cmd:       grep -r "_IO_read_ptr" src/

rec_priority:           1
rec_approach:           source-patch
rec_description:        添加 #ifdef __OHOS__ 或 !__GLIBC__ 条件编译分支,
                         用公开 API 替代内部字段访问
rec_command:
rec_auto_fix:          false
rec_impl:               none

forbid_1_pattern:      cast.*FILE.*\*.*_IO_FILE|access.*_IO_.*directly.*musl
forbid_1_reason:        不能用强制转换绕过不透明类型检查,
                         musl 内部结构可能随版本变化
forbid_1_consequence:   段错误或数据损坏
fallback_priority:      2
fallback_approach:      manual-workaround
fallback_description:   如果自动补丁不适用，手动在源码中做最小兼容修改并记录到 notes.md
fallback_command:      # 手动编辑源码后记录:
# 1. 修改文件列表
# 2. 修改原因
# 3. 验证方式
fallback_auto_fix:     false
fallback_impl:          manual

principles:             P-PATCH-001

causes:                 []
caused_by:              []
similar_to:             [E014]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E020.md
last_updated:           2026-04-09
source_event:           archives/c/coreutils/9.10/manifest.yaml
