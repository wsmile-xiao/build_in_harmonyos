#====================================================================
# E092.kv — OHOS 缺少 CPU 亲和性 API
# 对应的人类文档: doc/E092.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E147
trigger_tool:           cc|clang|configure|make
phase:                  compilation|configuration
error_signature:        'CPU_SETSIZE' undeclared|'cpu_set_t' undeclared|'sched_getaffinity' undeclared|'sched_setaffinity' undeclared|'CPU_COUNT' undeclared|'CPU_ZERO' undeclared|'CPU_SET' undeclared|implicit declaration of function 'sched_getaffinity'|implicit declaration of function 'sched_setaffinity'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, compat, libc
match_keywords:         CPU_SETSIZE, cpu_set_t, sched_getaffinity, sched_setaffinity, CPU_COUNT, CPU_ZERO, CPU_SET, CPU affinity, undeclared, musl, __linux__, __OHOS__

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             musl libc 未实现 Linux 特有的 CPU 亲和性 API (CPU_SETSIZE, cpu_set_t, sched_getaffinity, sched_setaffinity, CPU_COUNT 等)，这些 API 在 glibc 中存在但 OHOS 使用 musl
affected_scope:         使用 CPU 亲和性的软件，如 libuv、nginx、redis、系统监控工具等
verification_cmd:       grep -r "sched_getaffinity\|sched_setaffinity\|cpu_set_t\|CPU_SETSIZE" --include="*.c" --include="*.h" .

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description:        在 __linux__ 条件编译中排除 __OHOS__，使 OHOS 走替代路径
rec_command:            sed -i 's/#ifdef __linux__/#if defined(__linux__) \&\& !defined(__OHOS__)/g' <file>
rec_auto_fix:           true
rec_impl:               source-patch

# 回退方案
fallback_priority:      2
fallback_approach:      manual-workaround
fallback_description:   为 OHOS 提供 stub 实现或禁用 CPU 亲和性功能
fallback_command:      # 手动编辑源码添加 stub 实现或禁用功能
fallback_auto_fix:     false
fallback_impl:          none          

# ★ 禁止策略 ★
forbid_1_pattern:       #define CPU_SETSIZE|#define cpu_set_t|#define sched_getaffinity
forbid_1_reason:        不要手动定义这些宏/类型，会导致类型不匹配和 ABI 问题
forbid_1_consequence:   运行时崩溃或未定义行为

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E147.md
last_updated: 2026-04-22
source_event:           libuv 1.52.1 编译失败

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
