# Draft knowledge entry from acf-ppp/0.5.0 issue #211

id:                     E382
trigger_tool:           conan|tar|install|runtime
phase:                  source|packaging|testing|runtime
error_signature:        dangling symbolic link|PermissionError.*symlink|Operation not permitted.*symlink|missing.*shared.*view

severity:               2
category:               hmdfs, conan, packaging, filesystem, resource-overlay
match_keywords:         dangling symlink,cross-package resource,Conan dependency,HMDFS,materialize,copy2,byte identity,path containment,acf-ppp
title:                  Materialize immutable cross-package resources when HMDFS cannot preserve dangling links

root_cause:             The upstream deployment model overlays independently built packages, so a resource link is intentionally dangling until another package supplies its target; isolated Conan roots plus HMDFS link restrictions can silently omit the resource.
affected_scope:         Resource/application packages whose immutable linked target is owned by a declared Conan dependency and whose runtime semantics permit a byte-identical regular-file representation.
verification_cmd:       CI_PACKAGES="archives/a/acf-ppp/0.5.0" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           dependency-graph-resource-materialization
rec_description:        Resolve an explicit resource mapping from the declared dependency package, enforce source/destination containment, copy into a regular file, and verify byte identity against the resolved dependency version.
rec_command:            use os.path.realpath/commonpath, os.path.lexists/unlink, shutil.copy2, filecmp.cmp(shallow=False), and consumer cmp plus test ! -L
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      deployment-overlay-or-wrapper
fallback_description:   Use a deployment overlay for mutable/shared state or a wrapper for executable aliases when regular-file materialization would change semantics.
fallback_command:       define the ownership/overlay contract outside the isolated target package
fallback_auto_fix:      false
fallback_impl:          deployment-design

forbid_1_pattern:       symlink\(.*except.*pass|ln -s.*\|\| true|ignore.*PermissionError
forbid_1_reason:        Ignoring link failure lets packaging succeed with required resources absent.
forbid_1_consequence:   Runtime views or data are missing even though build and package creation report success.

forbid_2_pattern:       copy2?\(.*(/usr|/system)|golden.*copy|placeholder
forbid_2_reason:        Undeclared system sources, embedded golden copies and placeholders are not bound to the Conan dependency graph.
forbid_2_consequence:   Content can drift from the selected dependency version or package non-reproducibly.


causes:                 []
caused_by:              [E018]
similar_to:             [E050,E073]
conflicts_with:         []
prerequisite_of:        []

