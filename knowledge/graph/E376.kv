# 对应的人类文档: doc/E267.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E376
trigger_tool: cmake
phase: configuration|generation|linking
error_signature: NIFTI_SYSTEM_MATH_LIB.*NOTFOUND|linked by target.*ITKniftiio.*NOTFOUND

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category:               cmake, toolchain, linking, cache, libm
match_keywords: find_library, libm, NIFTI_SYSTEM_MATH_LIB, NOTFOUND, floor, pow, sqrt, empty cache
title: Bind an empty CMake library cache only when target math symbols need no separate libm

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: An upstream find_library(m) assumption leaves a NOTFOUND cache entry on targets where required math symbols link without a separate discoverable libm, poisoning a target link interface.
affected_scope: CMake projects that require a cache variable for libm even though the target libc or toolchain links the required math symbols without an additional library.
verification_cmd: Preserve the NOTFOUND failure, prove required functions compile and link without an extra library, pre-seed only the affected cache variable to empty, and run the real target link.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: target-evidence-bound-empty-library-cache
rec_description: Prefer a narrow recipe or toolchain cache binding to an upstream platform patch after exact target evidence proves the required symbols link without a separate library.
rec_command: Set only the affected CMake cache variable to the empty string for the proven target configuration and rerun configure plus the real link.
rec_auto_fix: false
rec_impl: conan-toolchain-cache-binding

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       set\(.*MATH.*""\).*(all|unconditional)|replace.*find_library.*platform
forbid_1_reason:        An empty cache value is valid only after the exact target proves the required symbols link without a separate library.
forbid_1_consequence:   Other targets silently lose required link libraries or a broad source patch encodes an unproved platform assumption.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

