#====================================================================
# E087.kv — HMDFS 上文件无执行权限，脚本无法直接运行
#====================================================================

id:                     E087
title: HMDFS 上文件无执行权限
trigger_tool:           make|install|test
phase:                  installation|testing
error_signature:        Permission denied.*\.sh|
                         cannot execute.*Permission denied|
                         ./.*\.sh.*not found.*Permission|
                         sh.*\.sh.*works but.*\.sh.*fails|
                         gpg-error-config-test\.sh.*fail

severity:               1
category:               platform|hmdfs|permissions
match_keywords:         Permission denied, .sh,
                         HMDFS, chmod, execute permission,
                         install -c -m 755,
                         no execute permission,
                         gpg-error-config-test.sh

root_cause:             HMDFS 文件系统上 chmod 操作不生效（UID 映射限制），
                         导致新生成的 shell 脚本文件没有执行权限（0600 而非 0755）。
                         Makefile 中 `./script.sh` 直接执行会报 Permission denied。
                         解决方法是用 `sh ./script.sh` 替代，或在 Makefile 中
                         使用 `install -c -m 755` 替代 `cp` 来安装脚本。
affected_scope:         所有在 HMDFS 上生成的 shell 脚本（libgpg-error, libtasn1 等）
verification_cmd:       ls -la *.sh 2>/dev/null; chmod +x test.sh && ls -la test.sh

rec_priority:           1
rec_approach:           use-sh-prefix
rec_description:        将 Makefile 中的 `./script.sh` 改为 `sh ./script.sh`，
                         绕过执行权限限制
rec_command:            sed -i 's|\./\([^ ]*\.sh\)|sh ./\1|g' Makefile
rec_auto_fix:           true
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      install-with-mode
fallback_description:   在 Makefile 中将脚本安装命令从 `cp` 改为 `install -c -m 755`
fallback_command:       sed -i 's|cp \(.*\.sh\)|install -c -m 755 \1|g' Makefile
fallback_auto_fix:      true
fallback_impl:          source-patch

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:             P-PATCH-001

causes:                 []
caused_by:              []
similar_to:             [E011, E046]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E087.md
last_updated:           2026-04-21
source_event:           archives/l/libgpg-error/1.55, archives/l/libtasn1/4.21.0

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

