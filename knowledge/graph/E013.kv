#====================================================================
# E013.kv — 动态链接错误（-ldl 缺失）
#====================================================================

id:                     E013
title: 动态链接错误（-ldl 缺失）
trigger_tool:           ld|clang|make
phase:                  linking
error_signature:        undefined reference.*dlopen|
                         undefined reference.*dlsym|
                         undefined reference.*dlclose|

severity:               2
category:               linking
match_keywords:         dlopen, dlsym, dlclose, -ldl, libdl,
                         dynamic linking, undefined reference,
                         shared library loading

root_cause:             链接阶段未指定 libdl 依赖,
                         dlopen/dlsym/dlclose 是 POSIX 动态加载 API,
                         需要显式链接 -ldl (musl 中 dl 功能在 libc 但符号在 libdl)
affected_scope:         使用动态加载(dlopen/dlsym)的 C/C++ 项目
verification_cmd:       nm -D /usr/lib/libc.so | grep dlopen

rec_priority:           1
rec_approach:           add-ldflags
rec_description:        添加 -ldl 到 LDFLAGS
rec_command:            LDFLAGS="-ldl $LDFLAGS"
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:
principles:

causes:                 []
caused_by:              []
similar_to:             [E003, E004]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E013.md
last_updated:           2026-04-09
source_event:           多个构建事件
