#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E322.kv，填写各字段
# 对应的人类文档: doc/E322.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E467
trigger_tool: configure|autotools|conan
phase: configuration
error_signature: checking whether we are cross compiling... configure: error: cannot run C compiled programs|Error loading shared library .* \(needed by \./conftest\)

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category:               autotools, toolchain, conan
match_keywords: AutotoolsDeps,LIBS,AC_PROG_CC,cross compiling,conftest,dependency closure,configure rc=77,OHOS
title: AutotoolsDeps exports LIBS, so autoconf's earliest run probe links the whole dependency closure and fails at configure

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan 的 AutotoolsDeps 会把依赖闭包写进 LIBS/CPPFLAGS 环境变量，autoconf 最早的 AC_PROG_CC 交叉编译判定会沿用这些 LIBS 去链接 conftest。于是本应只跑一个空 main 的探测变成需要真正加载整条共享依赖闭包；只要闭包里有任一库在本机不可加载，错误就在 configure 阶段以 rc=77 暴露，而不是在测试阶段，容易被误判为编译器或三元组问题。
affected_scope: 所有 os=OHOS 上使用 Autotools+AutotoolsDeps 且依赖含共享库的 Conan 配方（X.Org 客户端库、图形栈尤其常见）。
verification_cmd: grep -A6 'checking whether we are cross compiling' <build>/config.log  # 看真实第一条加载错误

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: read-config-log-then-fix-loader
rec_description: 先读 config.log 里 conftest 的完整链接命令与第一条错误，区分是签名/别名/路径问题（见 E257、E321），再在任务私有视图内修好可加载性；不要改成静态链接、不要预设 cross_compiling 缓存变量、也不要加 --host。
rec_command: grep -B2 -A8 'cannot run C compiled programs' $B/config.log
rec_auto_fix: false
rec_impl: 

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: drop-autotoolsdeps-when-pkgconfig-sufficient
fallback_description: 若依赖探测已由 PkgConfigDeps 覆盖，可不生成 AutotoolsDeps，使早期探测不再无条件链接整条闭包。
fallback_command: 
fallback_auto_fix: false
fallback_impl: 

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 用 ac_cv_prog_cc_works=yes 或 --host= 让探测直接通过
forbid_1_reason: 伪造能力检测结果会让 config.h 与真实平台不符；--host 属 R1 禁止项
forbid_1_consequence: 问题被推到运行期或其他包，且审计按欺骗检测判 P0
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

