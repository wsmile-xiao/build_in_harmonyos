#====================================================================
# E016.kv — 汇编代码错误
#====================================================================

id:                     E016
trigger_tool:           as|clang|configure|make
phase:                  compilation|configuration
error_signature:        assembler error.*unknown instruction|
                         selected processor does not support|
                         invalid instruction.*ARM|

severity:               2
category:               asm|compat
match_keywords:         assembler, unknown instruction, ARM mode,
                         disable-asm, no-asm, assembly code,
                         processor not support, inline asm

root_cause:             项目内嵌的汇编代码使用了目标平台(aarch64)
                         不支持的指令集或编码方式,
                         或 configure 未正确识别目标架构导致选错汇编路径
affected_scope:         包含手写汇编或内联汇编的 C/C++ 项目(OpenSSL, libx264 等)
verification_cmd:       clang -c -target aarch64-linux-ohos test.S 2>&1

rec_priority:           1
rec_approach:           reconfigure-no-asm
rec_description:        禁用汇编优化, 回退到纯 C 实现
rec_command:            ./configure --disable-asm (通用) 或 ./Configure no-asm (OpenSSL)
rec_auto_fix:          true
rec_impl:               reconfigure

forbid_1_pattern:
principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E016.md
last_updated:           2026-04-09
source_event:           多个构建事件

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
