#====================================================================
# E110: Java构建工具缺失(Ant/Maven/Gradle)
# 对应的人类文档: doc/E110.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E184
trigger_tool:           ant|maven|gradle|java
phase:                  configuration
error_signature:        ant.*command not found|mvn.*command not found|gradle.*command not found|Cannot run program "ant"

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               toolchain, environment
match_keywords:         ant, maven, gradle, java, build.xml, pom.xml, build.gradle, command not found

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             鸿蒙平台未预装Java构建工具(Ant/Maven/Gradle),cmd-pkgs无预编译包,需手动安装
affected_scope:         所有Java项目(Tomcat,Hadoop,Spring等使用Ant/Maven/Gradle构建的软件)
verification_cmd:       ant -version 2>&1 || echo "Ant not installed"; mvn -version 2>&1 || echo "Maven not installed"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           manual-install-ant
rec_description:        从Apache官方下载Ant二进制发布版,解压并配置环境变量
rec_command:            curl -k -L https://archive.apache.org/dist/ant/binaries/apache-ant-1.10.14-bin.tar.gz -o ~/downloads/ant.tar.gz && tar -xzf ~/downloads/ant.tar.gz -C ~/usr/local/ && export ANT_HOME=~/usr/local/apache-ant-1.10.14 && export PATH=$ANT_HOME/bin:$PATH
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:      use-prebuilt-java-app
fallback_description:   Java应用无需源码构建,直接下载官方二进制发布版(JAR/WAR)
fallback_command:       curl -k -L https://archive.apache.org/dist/tomcat/tomcat-10/v10.1.31/bin/apache-tomcat-10.1.31.tar.gz -o tomcat.tar.gz
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       apt-get install ant|yum install ant|brew install ant
forbid_1_reason:        鸿蒙平台不支持apt/yum/brew包管理器
forbid_1_consequence:   命令不存在或安装失败

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

