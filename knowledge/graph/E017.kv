#====================================================================
# E017.kv — GitHub 下载慢/超时
#====================================================================

id:                     E017
title: GitHub 下载慢/超时
trigger_tool:           wget|curl|git|configure
phase:                  download
error_signature:        Connection timed out.*github|
                         Operation timed out.*wget|
                         curl.*28.*timeout.*github|
                         github.*could not resolve|

severity:               2
category:               network
match_keywords:         GitHub, timeout, timed out, wget, curl,
                         mirror, ghfast, gitcode, gitee,
                         proxy, download failed, network unreachable,
                         tsinghua, aliyun, huawei, release

root_cause:             GitHub 在中国大陆网络环境下访问不稳定,
                         DNS 解析慢或连接超时
affected_scope:         所有需要从 GitHub 下载源码/依赖的构建过程
verification_cmd:       ping github.com -c 3; curl -sI https://github.com | head -1

rec_priority:           1
rec_approach:           use-ghfast
rec_description:        使用 ghfast.top 加速链接访问 GitHub release 包
rec_command:            URL替换: https://github.com/xxx/releases/download/vX.Y.Z/tar.gz → https://ghfast.top/https://github.com/xxx/releases/download/vX.Y.Z/tar.gz
rec_auto_fix:          true
rec_impl:               url-rewrite

fallback_priority:      2
fallback_approach:      use-mirror
fallback_description:  使用国内镜像源(清华源/阿里源/华为源/gitcode搜索)
fallback_command:      URL替换为对应镜像地址
fallback_auto_fix:     true
fallback_impl:          url-rewrite

fallback_2_priority:    3
fallback_2_approach:    use-proxy
fallback_2_description:使用代理服务器(如已配置)
fallback_2_command:    export https_proxy=http://proxy:port
fallback_2_auto_fix:   false
fallback_2_impl:        none

forbid_1_pattern:      github\.com.*(master|main|develop).*tar\.gz|github\.com.*(master|main|develop).*zip
forbid_1_reason:        必须使用 release 稳定版本, 避免开发分支不稳定导致构建失败
forbid_1_consequence:   开发分支可能包含未测试代码、编译错误或缺少必要文件

principles:

causes:                 []
caused_by:              []
similar_to:             [E054]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E017.md
last_updated:           2026-04-09
source_event:           多个构建事件
