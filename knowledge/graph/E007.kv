#====================================================================
# E007.kv — config.guess 无法识别 HarmonyOS 系统
#====================================================================

id:                     E007
trigger_tool:           configure
phase:                  configuration
error_signature:        cannot guess build type|unable to guess system type|
                         config.guess.*unable|cannot guess.*build type|
                         Invalid configuration.*guess|invalid triplet.*ohos|
                         OS ohos not recognized

severity:               2
category:               autotools, configure
match_keywords:         config.guess, build type, HarmonyOS, autoconf,
                         cannot guess, unable to guess, UNAME_SYSTEM,
                         build system type, Invalid configuration,
                         config.sub, triplet, ohos-linux, __OHOS__,
                         OS not recognized, basic os list

root_cause:             GNU config.guess 脚本不包含 HarmonyOS/__OHOS__ 检测分支。
                         uname -s 返回 HarmonyOS 无法匹配任何已知系统模式,
                         configure 在第一阶段就中断编译流程。
                         若用 --build/--host 绕过则误判为交叉编译,
                         导致 AC_RUN_IFELSE 等全部跳过, 生成错误 config.h
affected_scope:         **所有 autotools 项目**(鸿蒙编译第一道门槛)
verification_cmd:       ./build-aux/config.guess;
                         grep -c __OHOS__ build-aux/config.guess;
                         grep -c HarmonyOS build-aux/config.guess;
                         grep -c ohos-linux build-aux/config.sub;
                         ./config.sub aarch64-linux-ohos

rec_priority:           1
rec_approach:           patch-autotools-script
rec_description:        用内置补丁脚本 patch-autotools-ohos.pl 一键打补丁:
                         config.guess 两处修改(§2.1 LIBC检测 + §2.2 系统识别case分支),
                         config.sub 三处修改(§3.1 ohos-linux + §3.2 OS列表 + §3.3 内核列表)。
                         否则会报 "OS ohos not recognized" 错误。
                         输出标准三元组 aarch64-unknown-linux-ohos
rec_command:           perl ${SKILL_ROOT}/scripts/patch-autotools-ohos.pl \
                           build-aux/config.guess build-aux/config.sub
rec_auto_fix:          true
rec_impl:               run-patch-script

forbid_1_pattern:      --build=*|--host=*
forbid_1_reason:        导致 configure 误判为交叉编译(cross_compiling=yes),
                         AC_RUN_IFELSE 等运行时检测全部跳过,
                         大量平台能力使用硬编码默认值(基于Linux glibc),
                         生成的 config.h 与实际平台不匹配
forbid_1_consequence:   级联错误链:
fallback_priority:      2
fallback_approach:      consult-knowledge
fallback_description:   推荐方案不适用时，查阅 knowledge/error-patterns.md 中相似条目的替代方案
fallback_command:      grep -r "关键词" knowledge/graph/index.tsv
fallback_auto_fix:     false
fallback_impl:          none
                         → E064(conftest被跳过或误判)
                         → E061(gnulib模块选错)
                         → E062(符号未声明)
                         → E063(-Werror级联失败)
                         → E005(链接错误)
                         → E040/E019(运行时崩溃)

principles:              P001, P003, P011
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        [E064]

doc_file:               doc/E007.md
last_updated:           2026-04-10
source_event:           archives/x/xz/5.6.2/manifest.yaml (F069 确立铁律)

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
