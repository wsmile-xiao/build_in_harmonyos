#====================================================================
# E105 — Rust 工具链不可用（平台限制）
# 发现于: procs 0.14.10, sccache 0.12.0
# 日期: 2026-04-29, 2026-05-25
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E105
trigger_tool:           cargo|rustc|rust
phase:                  configuration|compilation
error_signature:        no such file or directory.*rustc|no such file or directory.*cargo|command not found.*rustc|command not found.*cargo|ELF.*interpreter /lib/ld-linux-aarch64.so.1.*No such file|unrecognized OS type: HarmonyOS

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               toolchain|rust|platform-limitation
match_keywords:         rust, cargo, rustc, Rust, toolchain, ELF, dynamic linker, ld-linux-aarch64.so.1, unrecognized OS type
title:                  Rust 工具链不可用（平台限制）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HarmonyOS 不在 Rust 官方支持平台列表中，rustup 无法识别操作系统类型。系统中若有 Linux 编译的 Rust 工具链，期望动态链接器路径 /lib/ld-linux-aarch64.so.1，鸿蒙系统缺少此路径。
affected_scope:         所有 Rust 项目：sccache, procs, bottom, yazi, ripgrep, bat, exa, fd, starship 等
verification_cmd:       which rustc && rustc --version && which cargo && cargo --version || echo "Rust toolchain not available"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           wait-for-platform-support
rec_description:        标记为平台限制，等待鸿蒙原生 Rust 工具链或 musl 静态链接版本可用
rec_command:            # 无命令，仅记录: "阻塞原因: Rust 工具链不可用"
rec_auto_fix:           false
rec_impl:               none

fallback_priority:      2
fallback_approach:      use-binary-release
fallback_description:   使用项目提供的预编译 musl 静态链接版本（如有）
fallback_command:       curl -LO https://github.com/{author}/{project}/releases/download/v{version}/{project}-v{version}-aarch64-linux.tar.gz && tar xf {project}-v{version}-aarch64-linux.tar.gz && mv {project} ~/usr/local/bin/
fallback_auto_fix:      false
fallback_impl:          none

# ★ 禁止策略 ★
forbid_1_pattern:       rustup.*sh.*--default-toolchain
forbid_1_reason:        rustup 不支持 HarmonyOS，执行会报错 "unrecognized OS type: HarmonyOS"
forbid_1_consequence:   安装失败，浪费时间

forbid_2_pattern:       cargo build.*--release.*make install
forbid_2_reason:        没有 Rust 工具链，cargo build 无法执行
forbid_2_consequence:   编译阻塞，任务无法继续

# ═══ Layer 4: 原则引用 ═══
principles:             P-PLATFORM-001

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E105.md
last_updated:           2026-05-25
source_event:           procs/0.14.10, sccache/0.12.0 编译失败

