#====================================================================
# E081.kv — secure_getenv 在 musl libc 上不可用
#====================================================================

id:                     E081
title: secure_getenv 在 musl libc 上不可用
trigger_tool:           cc|clang|make
phase:                  compilation
error_signature:        secure_getenv.*undeclared|implicit function declaration.*secure_getenv|
                         __libc_secure_getenv|incompatible integer to pointer.*secure_getenv

severity:               1
category:               libc-compat
match_keywords:         secure_getenv, __libc_secure_getenv, musl, tmpdir.c,
                         undeclared, implicit function declaration, libc,
                         TMPDIR, gnulib, path_search

root_cause:             musl libc 未实现 secure_getenv() 函数（glibc 扩展）。
                         部分软件（如含 gnulib 模块的项目）在非 _LIBC 构建中
                         通过 #define __libc_secure_getenv secure_getenv 调用此函数。
                         musl 中该函数不存在，导致编译报 "undeclared" 或
                         "incompatible integer to pointer conversion" 错误。
affected_scope:         所有使用 gnulib tmpdir 模块的软件（wget, coreutils 等），
                         以及直接调用 secure_getenv 的项目
verification_cmd:       echo 'int main(){secure_getenv("x");}' | cc -xc - -c 2>&1;
                         grep -r "secure_getenv\|__libc_secure_getenv" lib/

rec_priority:           1
rec_approach:           source-patch
rec_description:        将 secure_getenv 降级为 getenv。两者功能类似（getenv 不做
                         setuid 安全检查），在鸿蒙上无 setuid 场景，降级安全。
                         修改方式：将 #define __libc_secure_getenv secure_getenv
                         改为 #define __libc_secure_getenv getenv
rec_command:            sed -i 's/# define __libc_secure_getenv secure_getenv/# define __libc_secure_getenv getenv/' lib/tmpdir.c
rec_auto_fix:           false
rec_impl:               source-patch

forbid_1_pattern:       -DHAVE_SECURE_GETENV
forbid_1_reason:        强制声明存在但运行时无此符号，导致链接失败或运行时崩溃
forbid_1_consequence:   undefined reference to secure_getgetenv

fallback_priority:      2
fallback_approach:      add-cflags
fallback_description:   添加 -Dsecure_getenv=getenv 到 CFLAGS 全局替换
fallback_command:       CFLAGS="$CFLAGS -Dsecure_getenv=getenv"
fallback_auto_fix:      true
fallback_impl:          add-cflags

principles:             P-PATCH-001

causes:                 []
caused_by:              []
similar_to:             [E020]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E081.md
last_updated:           2026-04-13
source_event:           archives/w/wget/1.19.1

