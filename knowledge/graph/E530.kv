#====================================================================
# E341 draft - X11 客户端库无 X server 的消费者测试方法
# 触发事件: libXinerama 1.1.6 HarmonyOS PC 适配（archives/l/libxinerama/1.1.6）
# 主从明确：上游 make check 为空、OHOS CI 无 Xvfb 时，用"强类型活重定位 +
#           offsetof ABI 固定"做 display-independent 消费者测试，可复用整批 X11 库。
#====================================================================

id:                     E530
trigger_tool:           cmake|make check|test_package
phase:                  test
error_signature:        undefined reference to .Xinerama|No such file or directory.*X11|make check.*no tests|Xvfb|:0.*Cannot open display

severity:               3
category:               ohos, packaging, testing, abi, x11
match_keywords:         api_surface, version_contract, DECLARE_SYMBOL, __typeof__, offsetof, XineramaScreenInfo, display-independent, Xvfb, strong typed relocation
title:                  X11 客户端库无 X server 时用强类型活重定位 + ABI 布局固定做消费者测试

root_cause:             X11 扩展客户端库上游通常无自动化测试（make check 为空），
                        而真实函数调用需要 X server。空 test_package 只验证链接、
                        不验证导出符号集合与类型/常量契约，ABI 退化时无声。
                        OHOS CI worker 无 Xvfb，无法运行上游 X 测试。

affected_scope:         X11 家族扩展客户端库（Xcomposite/Xinerama/Xdamage/Xrandr/Xcursor）
                        及一切无上游测试、产物为 .so 且无运行时依赖的库在 OHOS 的适配。

verification_cmd:       CI_PACKAGES="archives/l/libxinerama/1.1.6" zsh ci/conan/build_and_test.sh
                        （test_package 两个可执行文件须全部通过）

rec_priority:           1
rec_approach:           strong-typed-relocation-plus-abi-pinning
rec_description:        api_surface.c 用 __typeof__(&name) + volatile 取地址对每个导出符号生成
                        活重定位（链接期即校验签名与存在性）；version_contract.c 用 CHECK 宏
                        钉死协议版本常量与公开结构体 offsetof/sizeof；CMake 加 -Wall -Wextra
                        -Werror；test_package 用 explicit test_type，OHOS 上签名后逐个运行。
rec_command:            CI_PACKAGES="archives/l/libxinerama/1.1.6" zsh ci/conan/build_and_test.sh
rec_auto_fix:           false
rec_impl:               conan-test-package

fallback_priority:      2
fallback_approach:       static-nm-symbol-check
fallback_description:   若无法编译消费者测试（如缺头），退而用 readelf/nm 对产物导出符号
                        做静态清单对比上游头文件声明；但该法不校验签名与布局，优先级低于前者。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          static-analysis

forbid_1_pattern:       int main\(void\)\{\s*return 0;\s*\}.*test_package
forbid_1_reason:        只链接不验证的空 test_package 无法捕获符号/类型/布局退化。
forbid_1_consequence:   ABI 破坏合并上线后消费者运行时才崩溃。
forbid_2_pattern:       Xvfb|DISPLAY=:0|dlopen.*dlsym
forbid_2_reason:        OHOS CI 无 X server；弱引用/dlopen 兜底掩盖缺失符号。
forbid_2_consequence:   测试在 CI 必挂或漏报缺失符号。

principles:             P013,P014
causes:                 []
caused_by:              []
similar_to:             E340
conflicts_with:         []
prerequisite_of:        []

