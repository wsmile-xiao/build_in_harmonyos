#====================================================================
# E048.kv — UDPLITE 协议不支持
#====================================================================

id:                     E048
trigger_tool:           python|socket|runtime
phase:                  runtime|testing
error_signature:        PermissionError.*UDPLITE|IPPROTO_UDPLITE.*not supported|
                         socket.*SOCK_DGRAM.*136.*denied

severity:               1
category:               kernel|network|socket
match_keywords:         UDPLITE, UDP-Lite, IPPROTO_UDPLITE, Permission denied,
                         socket, kernel protocol, RFC 3828, test_socket

root_cause:             HarmonyOS 内核未启用 UDPLITE(UDP-Lite, RFC 3828)协议支持。
                         Python socket 模块中 IPPROTO_UDPLITE 常量已定义(头文件中有),
                         但内核不实际支持该协议
affected_scope:         Python test_socket (36 个 UDPLITE 相关测试 error)
verification_cmd:       python3 -c "
import socket
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDPLITE)
    s.close(); print('UDPLITE: OK')
except (PermissionError, OSError) as e:
    print(f'UDPLITE: {e}')
"

rec_priority:           1
rec_approach:           skip-test
rec_description:        跳过 UDPLITE 相关测试: 检测是否支持, 不支持则 raise SkipTest
rec_command:
rec_auto_fix:          true
rec_impl:               skip-test

forbid_1_pattern:
principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E048.md
last_updated:           2026-04-10
source_event:           archives/s/python/3.9.0/manifest.yaml
