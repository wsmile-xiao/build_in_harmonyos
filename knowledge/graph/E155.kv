# Layer 0: 错误面
id: E155
title: 纯 Perl 模块编译模式 (ExtUtils::MakeMaker)
trigger_tool:           perl|make|test
phase:                  configuration|installation|testing
error_signature:        Can't locate.*\.pm in @INC|perl Makefile.PL|No such file.*Makefile.PL

# Layer 1: 识别层
severity:               1
category:               build-system|perl
match_keywords:         Makefile.PL, ExtUtils::MakeMaker, PERL5LIB, pure Perl, CPAN, backpan, PREFIX, INSTALL_BASE, Pod::Coverage, Devel::Symdump, Pod::Parser

# Layer 2: 诊断层
root_cause:             纯 Perl 模块使用 ExtUtils::MakeMaker (Makefile.PL) 构建，不涉及 C 编译器。
                        Perl 安装在 /data/service/hnp，@INC 不包含用户安装路径 ~/usr/local。
                        需通过 PERL5LIB 环境变量提供依赖模块路径。
                        部分模块源码 URL 可能 404（如 savannah.nongnu.org），需使用 CPAN backpan 替代。
affected_scope:         所有纯 Perl 模块（Pod::Coverage, PHP::Serialization, PDF::API2 等）
verification_cmd:       perl -MPod::Coverage -e 'print $Pod::Coverage::VERSION, "\n"'

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           perl-pure-module-build
rec_description:        使用 PERL5LIB 指定依赖路径，PREFIX/INSTALL_BASE=$DEFAULT_PREFIX 控制安装路径，DESTDIR 模式 staging
rec_command:            export PERL5LIB=$HOME/usr/local/lib/site_perl/5.42.0:$HOME/usr/local/lib/5.42.0 && perl Makefile.PL PREFIX=$DEFAULT_PREFIX && make && make install DESTDIR=$TEST_PREFIX && make test
rec_auto_fix:           true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      install-base-mode
fallback_description:   使用 INSTALL_BASE 替代 PREFIX（部分模块 INSTALL_BASE 更可靠地控制安装路径到 $DEFAULT_PREFIX/lib/perl5/）
fallback_command:       perl Makefile.PL INSTALL_BASE=$DEFAULT_PREFIX && make && make install DESTDIR=$TEST_PREFIX
fallback_auto_fix:      true
fallback_impl:          set-env-var

# Layer 4: 原则引用
principles:             R20-DESTDIR, R1-minimal-args

# 关系图
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

