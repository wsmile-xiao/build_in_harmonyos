#====================================================================
# E053.kv — cc1plus 不可用，必须使用 clang++
#====================================================================

id:                     E053
title: cc1plus 不可用，必须使用 clang++
trigger_tool:           configure|cc|make
phase:                  configuration|compilation
error_signature:        cc1plus.*error.*unrecognized|cc1plus.*not found|
                         CXX compiler cannot create executables|configure.*CXX.*fail

severity:               2
category:               toolchain|compiler|compat
match_keywords:         cc1plus, clang++, CXX, C++ compiler, autotools,
                         unrecognized command-line option, g++, LLVM, configure

root_cause:             鸿蒙 SDK 工具链不提供 cc1plus(GCC 的 C++ 编译器前端)。
                         鸿蒙使用 LLVM/Clang 工具链, clang++ 是 C++ 编译器,
                         但部分 autotools 项目的 configure 脚本或 Makefile 硬编码调用 cc1plus,
                         或 configure 的 C++ 编译器检测逻辑在 clang++ 上误判
affected_scope:         所有使用 C++ 代码且 configure 不正确检测 C++ 编译器的 autotools 项目
verification_cmd:       which cc1plus   # 不存在
                         which clang++   # /data/service/hnp/bin/clang++

rec_priority:           1
rec_approach:           set-env-var
rec_description:        显式指定 CXX=clang++ 并确保在 configure 前设置:
                         export CC=clang CXX=clang++
rec_command:            export CC=clang; export CXX=clang++;
                         ./configure --prefix=$HOME/usr/local CXX=clang++
rec_auto_fix:          true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      sed-fix-hardcode
fallback_description:   如果 Makefile 硬编码了 cc1plus 调用, 批量替换为 clang++
fallback_command:      sed -i 's/cc1plus/clang++/g' Makefile*
fallback_auto_fix:     false

forbid_1_pattern:      在鸿蒙目标平台上调用 cc1plus 作为 C++ 编译器
forbid_1_reason:       鸿蒙 SDK 不提供 cc1plus(GCC 前端), 仅提供 clang++
forbid_1_consequence:  configure 检测失败 或 编译错误: cc1plus: not found
principles:             P-TOOLCHAIN-001

causes:                 []
caused_by:              []
similar_to:             [E012]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E053.md
last_updated:           2026-04-10
source_event:           archives/p/python/3.9.0/manifest.yaml

