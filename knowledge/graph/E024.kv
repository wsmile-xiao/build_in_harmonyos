#====================================================================
# E024.kv — Unix Domain Socket 受限
#====================================================================

id:                     E024
title: Unix Domain Socket 受限
trigger_tool:           python|socket|runtime
phase:                  runtime|testing
error_signature:        PermissionError.*bind.*socket|
                         Operation not permitted.*AF_UNIX|
                         Unix.*domain.*socket.*Permission

severity:               2
category:               selinux|posix|network
match_keywords:         Unix domain socket, AF_UNIX, bind, Permission denied,
                         SELinux, multiprocessing, TCP fallback, localhost

root_cause:             鸿蒙 SELinux 策略限制 Unix domain socket 的 bind() 操作,
                         /tmp 目录下的 socket 文件创建受限
affected_scope:         Python multiprocessing、使用 AF_UNIX 的程序
verification_cmd:       python3 -c "import socket; s=socket.socket(socket.AF_UNIX); s.bind('/tmp/test')"

rec_priority:           1
rec_approach:           use-tcp-socket
rec_description:        将 Unix domain socket(AF_UNIX)替换为 TCP socket(localhost)
rec_command:
rec_auto_fix:          false
rec_impl:               source-patch

forbid_1_pattern:
principles:

causes:                 []
caused_by:              [E009]
similar_to:             [E022]
conflicts_with:         []
prerequisite_of:        []

