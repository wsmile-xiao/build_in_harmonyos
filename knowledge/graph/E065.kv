#====================================================================
# E065.kv — gnulib 头文件包含顺序导致符号未声明
#====================================================================

id:                     E065
trigger_tool:           cc|clang|make
phase:                  compilation
error_signature:        undeclared identifier.*xzalloc|unexpected type name.*size_t|
                         undeclared.*xmemdup|gnulib.*symbol.*undeclared|

severity:               2
category:               gnulib|headers|compilation
match_keywords:         gnulib, xzalloc, xmemdup, xalloc, size_t, stddef.h,
                         include order, CPPFLAGS, sed, compile.c, undeclared

root_cause:             gnulib 提供的头文件之间有依赖顺序要求。
                         xzalloc() 定义在 lib/xalloc.h, size_t 需要 <stddef.h>。
                         如果 .c 文件的 #include 顺序不符合 gnulib 预期,
                         或者 gnulib 替换头文件未正确覆盖系统头文件, 就会导致符号未声明。
                         这通常是 E064(conftest 失败)的二级后果: config.h 包含了错误的 #define 配置
affected_scope:         深度依赖 gnulib 的 GNU 软件(sed 4.9 等)
verification_cmd:       # 诊断流程:
                         # 符号来自系统头? → 补 #include
                         # 符号来自 gnulib? → 检查 CPPFLAGS / I 路径
                         # 符号来自项目自身? → 正常编译错误

rec_priority:           1
rec_approach:           fix-cppflags-or-reconfigure
rec_description:        确保 CPPFLAGS 包含必要路径(-I$BUILD_SRC_DIR/lib -I$BUILD_SRC_DIR);
                         或在受影响 .c 文件显式包含所需头文件;
                         或清理后重新 configure(解决 E064 后通常会顺带解决)
rec_command:            export CPPFLAGS="-I$BUILD_SRC_DIR/lib -I$BUILD_SRC_DIR"
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:
principles:

causes:                 [E064]   # E064 的二级后果
caused_by:              []
similar_to:             [E062]   # 都是 gnulib/头文件类问题
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E065.md
last_updated:           2026-04-10
source_event:           archives/s/sed/4.9/manifest.yaml
