#====================================================================
# E104.kv — libolm Makefile 缺少 version_script.ver
# 问题: ld.lld 找不到 version_script.ver 链接脚本
# 解决: 手动创建 version_script.ver 定义导出符号
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E104
trigger_tool:           ld.lld|make
phase:                  linking
error_signature:        ld\.lld: error: cannot find version script.*version_script\.ver|cannot open version script file

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               build-system|linking|missing-file
match_keywords:         version_script.ver, ld.lld, cannot find version script, olm, libolm, symbol export
title:                  libolm Makefile 构建缺少 version_script.ver 链接脚本

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             libolm 的 Makefile 构建依赖 version_script.ver 文件来控制符号导出。PyPI 的 python-olm 包含 libolm 子目录源码但不包含此文件，导致链接失败
affected_scope:         libolm（olm 加密库）Makefile 构建
verification_cmd:       ls version_script.ver || echo "version_script.ver missing"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           create-version-script
rec_description:        手动创建 version_script.ver 文件，定义 olm_* 和 _olm_* 为导出符号
rec_command:            cat > version_script.ver << 'EOF'\n{\n    global:\n        olm_*;\n        _olm_*;\n    local:\n        *;\n};\nEOF
rec_auto_fix:           true
rec_impl:               create-file

# 回退方案
fallback_priority:      2
fallback_approach:      cmake-build
fallback_description:   使用 CMake 构建替代 Makefile（需同时解决 E103 cmake_minimum_required 问题）
fallback_command:       mkdir build && cd build && cmake .. -DCMAKE_INSTALL_PREFIX=$DEFAULT_PREFIX
fallback_auto_fix:      false
fallback_impl:          cmake

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E103]
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E104.md
last_updated:           2026-04-27
source_event:           olm 3.2.16 编译

draft:                  false
contributor_id:         0D0A

