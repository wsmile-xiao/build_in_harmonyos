#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E320.kv，填写各字段
# 对应的人类文档: doc/E320.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E512
trigger_tool: python3|pip|conan
phase: compilation|testing
error_signature: ModuleNotFoundError: No module named .unidecode.|ModuleNotFoundError: No module named .*

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category:               python, dependency, ci-env
match_keywords: pure python, build self-check, import, runtime python package, unidecode, pyyaml, CI worker, clean environment, ModuleNotFoundError, pip install, local pass CI fail
title: 纯 Python 包 build() 自检 import 运行时 Python 包，宿主环境预装而 CI 干净环境缺失导致本地通过、远程 CI 失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 纯 Python 包（无 C 扩展）的 build()/test_package 自检会 import 包内子模块，若子模块顶层 import 第三方运行时 Python 包（如 venc3.datastore -> unidecode），宿主开发环境预装该包时本地 conan create 通过，而 CI worker 为干净环境缺少该包，导致 conan-build-test 阶段 ModuleNotFoundError
affected_scope: 所有 build() 自检或 test_package 涉及第三方运行时 Python 包 import 的纯 Python 包 Conan 配方
verification_cmd: python3 -c "import venc3.datastore" 2>&1 | tail -2; pip download unidecode pyyaml --no-deps -d ./dl 2>&1 | tail -2

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: add-deps
rec_description: 在 conanfile.py build() 与 test_package test() 的 pip install 中显式安装运行时 Python 包依赖（unidecode/pyyaml 等，社区源 pypi.cnb.cool 有 cp312-ohos_aarch64 预编译 wheel，先 pip download 验证可得性）；或在自检中跳过依赖外部包的子模块
rec_command: pip download unidecode pyyaml --no-deps -d ./dl && conan create ...
rec_auto_fix: true
rec_impl: pip-install-runtime-deps

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E320.md
last_updated: 2026-08-18
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors: xioaxin <3990149441@qq.com>
source_pr: !5985
source_commit: dc422198da

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:
