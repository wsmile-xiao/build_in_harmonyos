#====================================================================
# E050.kv — HMDFS 符号链接不可跟踪导致链接器找不到库
#====================================================================

id:                     E050
trigger_tool:           ld|clang|pip|make
phase:                  linking|installation|runtime
error_signature:        unable to find library.*-l|ld\.lld.*error.*library|
                         cannot open shared object|symbol link.*not found

severity:               3
category:               hmdfs, linking, runtime, filesystem
match_keywords:         HMDFS, symlink, symbolic link, os.path.exists, ld.lld,
                         -lpython, pip install, make install, lib*.so, linker

root_cause:             HMDFS 文件系统不正常跟踪符号链接。
                         os.path.exists() 对符号链接返回 False,
                         动态链接器(ld.lld)通过符号链接搜索库文件时也无法找到目标
affected_scope:         pip install 编译 C 扩展包、任何通过 -l 链接符号链接 .so 的操作
verification_cmd:       python3 -c "
import os
s = '/usr/local/lib/libpython3.9.so'
r = '/usr/local/lib/libpython3.9.so.1.0'
print(f'symlink exists: {os.path.exists(s)}')  # False
print(f'real exists: {os.path.exists(r)}')      # True
"

rec_priority:           1
rec_approach:           copy-replace-symlink
rec_description:        用文件副本(cp)替代符号链接(ln):
                         rm libpython3.9.so && cp libpython3.9.so.1.0 libpython3.9.so
                         对于 make install, 将 \$(LN_FORCE) 改为 \$(HARDLINK)(鸿蒙上为 cp -p)
rec_command:            rm /usr/local/lib/libpython3.9.so;
                         cp /usr/local/lib/libpython3.9.so.1.0 /usr/local/lib/libpython3.9.so
rec_auto_fix:          true
rec_impl:               batch-command

forbid_1_pattern:      在 HMDFS 上依赖符号链接分发共享库而不做 cp 备份方案
forbid_1_reason:       HMDFS 不正常跟踪符号链接, os.path.exists(symlink)=False, 链接器找不到目标
forbid_1_consequence:  ld.lld: unable to find library; pip install 全部失败
fallback_priority:      2
fallback_approach:      consult-knowledge
fallback_description:   推荐方案不适用时，查阅 knowledge/error-patterns.md 中相似条目的替代方案
fallback_command:      grep -r "关键词" knowledge/graph/index.tsv
fallback_auto_fix:     false
fallback_impl:          none
principles:              P016
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E050.md
last_updated:           2026-04-10
source_event:           archives/p/python/3.9.0/manifest.yaml

