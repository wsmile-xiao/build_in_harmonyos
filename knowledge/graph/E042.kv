#====================================================================
# E042.kv — 扩展模块 RPATH 遗漏导致运行时库找不到
#====================================================================

id:                     E042
trigger_tool:           patchelf|packaging|runtime
phase:                  installation|runtime
error_signature:        ImportError.*_\w+|cannot open shared object|
                         extension module.*library not found|lib-dynload.*NEEDED

severity:               2
category:               packaging|rpath|linking|runtime
match_keywords:         RPATH, patchelf, lib-dynload, extension module,
                         NEEDED, ImportError, portable, $ORIGIN, Python, gdbm

root_cause:             打包可移植包时只为主程序和主共享库设置了 RPATH,
                         遗漏了扩展模块(lib-dynload/*.so)的 RPATH 设置。
                         扩展模块如果 NEEDED 外部库, musl 动态链接器沿调用者链搜索 RPATH 不稳健
affected_scope:         Python 可移植打包及其他含 C 扩展的解释型语言
verification_cmd:       PATCHELF=patchelf; for so in lib/python*/lib-dynload/*.so;
                         do $PATCHELF --print-rpath "$so" 2>/dev/null || echo "empty"; done

rec_priority:           1
rec_approach:           set-rpath-patchelf
rec_description:        为扩展模块显式设置 RPATH:
                         EXT_RPATH='$ORIGIN:$ORIGIN/..:$ORIGIN/../external'
rec_command:            for so in "$PKGDIR/lib/python3.9/lib-dynload/"*.so; do
                           $PATCHELF --set-rpath "$EXT_RPATH" "$so"
                         done
rec_auto_fix:          true
rec_impl:               batch-command

forbid_1_pattern:      打包可移植包时仅设置主程序/主共享库的 RPATH 而遗漏 lib-dynload/*.so 扩展模块
forbid_1_reason:       扩展模块 NEEDED 外部库时, musl 链接器沿调用者链搜索不稳健
forbid_1_consequence:  换机部署后 ImportError: 扩展模块找不到依赖库
fallback_priority:      2
fallback_approach:      consult-knowledge
fallback_description:   推荐方案不适用时，查阅 knowledge/error-patterns.md 中相似条目的替代方案
fallback_command:      grep -r "关键词" knowledge/graph/index.tsv
fallback_auto_fix:     false
fallback_impl:          none
principles:              P009, P012, P019
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E042.md
last_updated:           2026-04-10
source_event:           archives/s/python/3.9.0/manifest.yaml

