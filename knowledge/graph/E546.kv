#====================================================================
# 来源事件: libcolord 1.4.8 HarmonyOS 适配（archives/l/libcolord/1.4.8）
#====================================================================

id:                     E546
trigger_tool:           meson|configure
phase:                  configuration|compilation
error_signature:        dependency .*libudev.*not found|dependency .*gudev.*not found|dependency .*gusb.*not found|libudev\.h.*No such file|cd-edid.*udev
severity:               2
category:               portability, ohos, build-system
match_keywords:         gusb, gudev, libudev, required:false, HAVE_LIBUDEV, cd-edid, hwdb, colorhug, __OHOS__, R8, meson

title:                  OHOS 无 gusb/gudev/libudev：meson required:false 解耦 + HAVE_LIBUDEV 配置宏守卫（R8 禁 __OHOS__ 平台宏）

root_cause:             OHOS 无 gusb/gudev/libudev（制品仓未发布且系统无），meson 默认 required 依赖在 configure 阶段直接失败；需 required:false 使其可选，并用配置宏 HAVE_LIBUDEV（而非 __OHOS__ 平台宏，符合 R8）守卫 <libudev.h> include 与 hwdb 查找逻辑，非 OHOS 平台保持原行为。
affected_scope:         使用 libudev/gudev/gusb 的 GObject 库在 OHOS 的适配
verification_cmd:       meson configure -Ddaemon=false -Dtests=false build/ && grep -n HAVE_LIBUDEV lib/colord/cd-edid.c

rec_priority:           1
rec_approach:           config-macro-guard-for-optional-deps
rec_description:        未发布的平台可选依赖用 meson required:false 解耦，平台特定代码用配置宏（HAVE_XXX）而非平台宏守卫，保留非 OHOS 兼容性（R8）
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

