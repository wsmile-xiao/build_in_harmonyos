#====================================================================
# E091.kv — OHOS linux/socket.h 重定义 sockaddr_storage
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E091
trigger_tool:           clang|cc
phase:                  compilation
error_signature:        redefinition of 'sockaddr_storage'|linux/socket.h.*redef|sys/socket.h.*previous definition|conflicting types.*sockaddr_storage

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               kernel, headers
match_keywords:         sockaddr_storage, redefinition, linux/socket.h, sys/socket.h, netlink, harmonyos, conflicting types, libusb, usbutils

# ═══ Layer 2: 诊断层 ═══
root_cause:             OHOS 内核头文件 linux/socket.h 定义了 struct sockaddr_storage，
                        与 musl libc 的 sys/socket.h 冲突。
                        当源码同时包含 sys/socket.h（通过系统头文件链）和
                        linux/netlink.h（间接包含 linux/socket.h）时产生重定义错误。
                        这是 OHOS 内核头文件与 musl libc 的不一致。
affected_scope:         所有包含 linux/netlink.h 的软件。已知: glib (gnetworkmonitornetlink.c), systemd, libusb, usbutils。
verification_cmd:       echo '#include <sys/socket.h>\n#include <linux/netlink.h>' | clang -xc -c - 2>&1 | grep redefinition;
                         echo '#include <sys/socket.h>\n#include <linux/socket.h>' | clang -c -xc - 2>&1 | grep redefinition

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           define-guard
rec_description:        在 #include <linux/netlink.h> 前用 #define 将 sockaddr_storage
                        重命名为 __linux_sockaddr_storage，include 后 #undef 恢复。
                        用 #ifdef __OHOS__ 守卫，不影响其他平台。
rec_command:            |
                        #ifdef HAVE_LINUX_NETLINK_H
                        #ifdef __OHOS__
                        #define sockaddr_storage __linux_sockaddr_storage
                        #endif
                        #include <linux/netlink.h>
                        #include <linux/rtnetlink.h>
                        #ifdef __OHOS__
                        #undef sockaddr_storage
                        #endif
                        #endif
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      disable-netlink
fallback_description:   如果不需要 netlink 功能，通过 configure 选项禁用相关模块。
                        glib 可用 -Dnetwork_libnl=disabled。
fallback_command:       meson setup builddir --prefix=$DEFAULT_PREFIX -Dnetwork_libnl=disabled
fallback_auto_fix:      false
fallback_impl:          configure-option

                        阻止其重复定义已由 sys/socket.h 提供的结构体。
                        适用于直接包含 linux/socket.h 的场景（如 libusb）。
                        #ifdef __OHOS__
                        #define _UAPI_LINUX_SOCKET_H
                        #endif
                        #include <linux/socket.h>

# ★ 禁止策略 ★
forbid_1_pattern:       sed.*linux/netlink.*delete|rm.*linux/netlink
forbid_1_reason:         不要删除或跳过 netlink 头文件包含，应通过宏守卫解决冲突
forbid_1_consequence:   netlink 功能完全丧失

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

