#====================================================================
# E005.kv — 静态库链接共享库失败 (-fPIC)
#====================================================================
id:                     E005
trigger_tool:           make|ld
phase:                  compilation|linking
error_signature:        relocation R_AARCH64.*recompile with -fPIC|
                         -fPIC.*shared library|cannot be used.*-fPIC
severity:               2
category:               linking
match_keywords:         -fPIC, relocation, R_AARCH64, PIC,
                         static library, shared library, position independent
root_cause:             静态库编译时未使用 -fPIC,
                         链接到共享库时 aarch64 要求位置无关代码
affected_scope:         使用静态库(.a)的 autotools 项目
verification_cmd:       nm libxxx.a | grep TEXT, readelf -d libxxx.so

rec_priority:           1
rec_approach:           add-cflags
rec_description:        添加 -fPIC 到 CFLAGS 重试编译
rec_command:            CFLAGS="-fPIC $CFLAGS"
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:
principles:             P-CFLAGS-001
causes:                 []
caused_by:              []
similar_to:             [E003]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E005.md
last_updated:           2026-04-09
