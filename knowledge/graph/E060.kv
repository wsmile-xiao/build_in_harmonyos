# Layer 0: 错误面
id: E060
trigger_tool:           config.status
phase:                  configuration

# Layer 1: 识别层
severity:               2
category:               hmdfs, filesystem
error_signature:        config\.status.*Permission denied|mktemp.*failed|confXXXXXX.*cannot create|subs1\.awk.*Permission denied
match_keywords:         config.status, Permission denied, mktemp, HMDFS, temporary, confXXXXXX

# Layer 2: 诊断层
root_cause:             HMDFS 文件系统对临时目录创建有特殊限制，config.status 使用 `mktemp -d "./confXXXXXX"` 在当前目录创建临时目录可能失败。
                        这与 E002（/tmp 只读）相关，但影响源码目录本身的临时文件操作。
affected_scope:         所有在 HMDFS 上运行 autotools configure 的项目
verification_cmd:       mount | grep hmdfs && mktemp -d "./confXXXXXX" || echo "HMDFS mktemp failed"

# Layer 3: 方案层
rec_priority:           1
rec_approach:           use-tmpfs-workaround
rec_description:        在 tmpfs 目录（如 $HOME/tmp）中构建，而非直接在 HMDFS 的源码目录中运行 configure。
                        复制源码到 tmpfs 目录，然后在那里运行完整的构建流程。
rec_command:            |
  # 检测是否在 HMDFS 上
  mount | grep hmdfs
  # 创建 tmpfs 构建目录
  mkdir -p $HOME/tmp/build-tmpfs
  # 复制源码
  cp -a $BUILD_SRC_DIR $HOME/tmp/build-tmpfs/$(basename $BUILD_SRC_DIR)
  cd $HOME/tmp/build-tmpfs/$(basename $BUILD_SRC_DIR)
  # 在 tmpfs 上运行 configure
  ./configure --prefix=$DEFAULT_PREFIX

fallback_priority:      2
fallback_approach:      manual-config-files
fallback_description:   手动创建 config.status 需要的配置文件（仅适用于简单项目，不推荐）。
fallback_command:       |
  # 直接复制已配置的模板文件
  # （这不是推荐做法，可能导致配置不完整）

forbid_1_pattern:       在 HMDFS 上强制创建临时目录
forbid_1_reason:        HMDFS 的权限和命名限制可能导致临时文件创建失败或不可访问
forbid_1_consequence:   configure 看似通过但配置文件不完整，后续编译失败

# Layer 4: 原则引用
principles:               

# 关系图
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

