#====================================================================
# E211.kv — musl pthread affinity 缺失
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E211
trigger_tool:           cc
phase:                  compilation
error_signature:        undeclared identifier.*pthread_getaffinity_np|undeclared identifier.*pthread_setaffinity_np|did you mean.*sched_setaffinity

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform_compat
match_keywords:         pthread_getaffinity_np, pthread_setaffinity_np, musl, affinity,
                        undeclared identifier, sched_setaffinity, sched_getaffinity

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             musl libc 缺少 glibc 的 pthread affinity 扩展函数,
                        pthread_getaffinity_np / pthread_setaffinity_np 在 musl 中未实现,
                        OpenHarmony 使用 musl libc 因此受影响
affected_scope:         使用 pthread affinity API 的软件 (OpenImageDenoise, TBB, OpenMPI 等)
verification_cmd:       echo -e '#include <pthread.h>\nint main(){pthread_getaffinity_np(0,0,0);return 0;}' | clang -x c -c - -o /dev/null 2>&1

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           replace-with-sched-api
rec_description:        用 sched_getaffinity/sched_setaffinity 替代 pthread affinity 函数,
                        sched_* 是标准 POSIX API, musl 完整实现, pid=0 表示当前线程/进程,
                        需确保 cpu_set_t 类型通过 sched.h 可用
rec_command:            sed -i 's/pthread_getaffinity_np(/sched_getaffinity(0, /g; s/pthread_setaffinity_np(/sched_setaffinity(0, /g'
rec_auto_fix:           false
rec_impl:               none

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E085]
conflicts_with:         []
prerequisite_of:        []

