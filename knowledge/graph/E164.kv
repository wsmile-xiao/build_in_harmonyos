#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E103.kv，填写各字段
# 对应的人类文档: doc/E103.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E164
trigger_tool:           gcc|clang|make
phase:                  compilation
error_signature:        undefined reference to `adjtime'|error: 'adjtime' was not declared

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               platform-compat
match_keywords:         adjtime, adjtimex, time adjustment, syscall
title:                  OpenHarmony 平台 adjtime 函数缺失

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             OpenHarmony 使用 adjtimex syscall 替代 POSIX 标准的 adjtime 函数，adjtime 函数在 libc 中不存在
affected_scope:         需要调整系统时间的软件（ntp 客户端、时间同步工具等），如 htpdate、ntpdate、chrony 等
verification_cmd:       grep -r "adjtime" ${BUILD_SRC_DIR}/*.c || echo "No adjtime usage found"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           source-patch                  # 见 DESIGN §5 impl 列表
rec_description:        添加 OpenHarmony 兼容性补丁，用 adjtimex 替换 adjtime
rec_command:
 # 方案代码模板：
 # #ifdef __OHOS__
 # #define adjtime(tv, oldtv) adjtimex_compat(tv)
 # static inline int adjtimex_compat(const struct timeval *tv) {
 #     struct timex txc = {0};
 #     txc.modes = ADJ_OFFSET_SINGLESHOT;
 #     txc.offset = (long long)tv->tv_sec * 1000000LL + tv->tv_usec;
 #     return adjtimex(&txc);
 # }
 # #endif
rec_auto_fix:           false                         # 需要根据软件具体情况调整补丁
rec_impl:               manual                        # 手动添加补丁

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      disable-feature
fallback_description:   禁用时间调整功能（如果软件支持运行时禁用）
fallback_command:       ./configure --disable-time-adjustment 或移除相关代码
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       --build=.*|--host=.*|--target=.*
forbid_1_reason:        本平台是 native 编译，使用 --build/--host 会绕过 config.guess 检测，但无法解决 adjtime 缺失问题
forbid_1_consequence:   编译参数错误，无法真正解决问题
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             R8-source-code-standards

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

