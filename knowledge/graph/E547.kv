#====================================================================
# 来源事件: libcolord 1.4.8 HarmonyOS 适配（archives/l/libcolord/1.4.8）
#====================================================================

id:                     E547
trigger_tool:           meson|pkg-config
phase:                  configuration|dependency-resolve
error_signature:        Package 'gobject-2\.0' not found|dependency .*gobject-2\.0.* not found|gio-unix-2\.0.*not found|gmodule-2\.0.*not found
severity:               2
category:               conan, build-system, pkg-config
match_keywords:         glib-2.0.pc, gobject-2.0.pc, gio-2.0.pc, gio-unix-2.0.pc, gmodule-2.0.pc, thin wrapper, pkg-config, meson, glib2 conan, E090

title:                  glib2 Conan 包仅提供聚合 glib-2.0.pc：meson 按单模块名查找需在 generate() 补写 gobject/gio/gio-unix/gmodule 薄包装 .pc

root_cause:             glib2 Conan 包只生成聚合 glib-2.0.pc；meson 的 dependency('gio-2.0'|'gobject-2.0'|'gio-unix-2.0'|'gmodule-2.0') 按单模块名走 pkg-config 查找时找不到对应 .pc 而失败。需在 generate() 针对每个单模块名补写 requires 指向聚合 glib-2.0.pc 的薄包装 .pc（依赖注入走 build_folder 私有 prefix，符合 R49）。
affected_scope:         依赖 glib 单模块 pkg-config 名查找的 meson/autotools 库（glib2 Conan 包消费者）
verification_cmd:       PKG_CONFIG_PATH=$(build_folder)/prefix/lib/pkgconfig pkg-config --exists gobject-2.0 gio-2.0 gio-unix-2.0 gmodule-2.0 && echo ok

rec_priority:           1
rec_approach:           thin-pc-wrapper-for-gl-submodules
rec_description:        generate() 中为 gobject-2.0/gio-2.0/gio-unix-2.0/gmodule-2.0 补写薄包装 .pc（Requires: glib-2.0），满足 meson 单模块 dependency 查找
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:             P014

