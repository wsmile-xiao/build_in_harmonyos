#====================================================================
# E081.kv — HMDFS umask 077 Permission Denied in config.status
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E129
trigger_tool:           configure|config.status
phase:                  configuration
error_signature:        config\.status.*Permission denied.*subs1\.awk|can't create.*conf[A-Za-z0-9]+.*Permission denied|could not setup config files machinery

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               platform-hmdfs
match_keywords:         umask 077, Permission denied, config.status, mktemp, subs1.awk, HMDFS, setgid
title:                  HMDFS setgid directory prevents file creation under umask 077

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HMDFS filesystem always sets setgid bit on new directories; umask 077 creates drwx--S--- which blocks even the owner from writing files inside it
affected_scope:         All autotools software using configure/config.status on HarmonyOS
verification_cmd:       cd ~/tmp && (umask 077 && tmp=$(mktemp -d "./confXXXXXX") && echo test > "$tmp/testfile" && echo FAIL || echo PASS) && rm -rf ./conf*

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           sed-replace
rec_description:        Replace umask 077 with umask 022 in configure and config.status scripts (lines creating temp directories)
rec_command:            sed -i 's/umask 077/umask 022/g' configure config.status
rec_auto_fix:           true
rec_impl:               sed-replace

fallback_priority:      2
fallback_approach:      env-hint
fallback_description:   Set TMPDIR to writable location and ensure mktemp creates directories with group read permissions
fallback_command:       export TMPDIR=$HOME/tmp && CONFIG_SHELL=bash bash ./configure --prefix=$DEFAULT_PREFIX
fallback_auto_fix:      false
fallback_impl:          env-hint

forbid_1_pattern:       --build=|--host=|--target=
forbid_1_reason:        Native compilation on HarmonyOS; platform detection should use updated config.guess instead
forbid_1_consequence:   Binary paths hardcoded incorrectly; runtime failures

# ═══ Layer 4: 原则引用 ═══
principles:             R23, R10

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E002]
similar_to:             [E007]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E081.md
last_updated:           2026-06-02
source_event:           libdbi 0.9.0-r5 compilation

draft: false
