#====================================================================
# E103: OpenSSL 3.5 API 兼容性问题
# 描述: OpenSSL 3.5.6 中移除的部分 API 导致编译失败
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E129
trigger_tool:           gcc|clang
phase:                  compilation
error_signature:        use of undeclared identifier 'SSL_OP_NO_RENEGOTIATION'|use of undeclared identifier 'SSL_trace'|call to undeclared function 'SSL_get1_peer_certificate'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               api-compatibility|openssl
match_keywords:         SSL_OP_NO_RENEGOTIATION, SSL_trace, SSL_get1_peer_certificate, OpenSSL 3.5, undeclared identifier
title:                  OpenSSL 3.5 API 兼容性问题

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OpenSSL 3.5.6 移除/重命名了部分 API：SSL_OP_NO_RENEGOTIATION 改为 SSL_OP_NO_CLIENT_RENEGOTIATION，SSL_get1_peer_certificate 不存在（应使用 SSL_get_peer_certificate），SSL_trace 函数被移除
affected_scope:         使用旧版 OpenSSL API 的软件（ustream-ssl 等 OpenWrt 相关库）
verification_cmd:       grep -E "SSL_OP_NO_RENEGOTIATION|SSL_trace|SSL_get1_peer_certificate" {源码目录}/*.c

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description:        应用 OpenSSL 3.5 兼容性补丁：替换已移除的 API
rec_command:
  # 修复 SSL_OP_NO_RENEGOTIATION
  sed -i 's/SSL_OP_NO_RENEGOTIATION/SSL_OP_NO_CLIENT_RENEGOTIATION/g' {源码文件}
  # 修复 SSL_get1_peer_certificate
  sed -i 's/SSL_get1_peer_certificate/SSL_get_peer_certificate/g' {源码文件}
  # 修复 SSL_trace（禁用 trace 功能）
  sed -i 's/SSL_CTX_set_msg_callback(ctx->ssl, SSL_trace)/SSL_CTX_set_msg_callback(ctx->ssl, NULL)/g' {源码文件}
rec_auto_fix:           false
rec_impl:               sed-replace

fallback_priority:      2
fallback_approach:      version-downgrade
fallback_description:   使用 OpenSSL 3.2+ 版本（包含这些 API）
fallback_command:       curl -fsSL https://gitcode.com/OpenHarmonyPCDeveloper/cmd-pkgs/releases/download/pkgs/install.sh | sh -s -- openssl 3.2.0
fallback_auto_fix:      false
fallback_impl:          pkg-install

# ★ 禁止策略 ★
forbid_1_pattern:       --build=.*|--host=.*
forbid_1_reason:        本平台是 native 编译，不应该使用交叉编译参数
forbid_1_consequence:   可能掩盖真正的 API 问题，导致运行时错误

# ═══ Layer 4: 原则引用 ═══
principles:             R15-历史信息纠正

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E103.md
last_updated:           2026-05-22
source_event:           ustream-ssl 20260222-r0 编译失败

