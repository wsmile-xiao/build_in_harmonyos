# Layer 0: 错误面
id:                     E072
title: config.sub 三元组验证失败
trigger_tool:           configure
phase:                  configuration
error_signature:        configure: error: invalid triplet.*ohos|config\.sub: invalid configuration.*ohos|cannot guess build type|unknown vendor|unknown operating system

# Layer 1: 识别层
severity:               3
category:               autotools-config
match_keywords:         config.sub, invalid triplet, ohos, unknown operating system, unknown vendor, configure, autoconf, autotools, triple validation

# Layer 2: 诊断层
root_cause:             config.sub 未识别 ohos 作为合法操作系统值，导致三元组 aarch64-*-linux-ohos 验证失败。
                        与 E007（config.guess 无法识别系统名）互补：E007 负责"猜出"三元组，E072 负责"验证"三元组合法性。
affected_scope:          所有使用 Autotools 构建系统的 C/C++ 项目（尤其是需要交叉编译或自定义三元组的场景）
verification_cmd:       grep -n "ohos\|android-linux" $SRC_DIR/config.sub | head -5

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           patch-autotools-script
rec_description:        在 config.sub 中做 3 处修改（完整方案）：
                        1. 在 android-linux 分支后添加 ohos-linux → basic_os=linux-ohos 映射
                        2. 在 OS 白名单（case $os in）中添加 ohos*
                        3. 在 kernel-os 白名单（case $kernel-$os in）中添加 linux-ohos*
                        缺少第 3 处会导致 "Kernel 'linux' not known to work with OS 'ohos'" 错误。
rec_command:            |
  # 修改1: basic_os 映射 — 找到 android-linux 分支，在其后添加：
  #   ohos-linux)
  #       basic_machine=$field1-unknown
  #       basic_os=linux-ohos
  #       ;;
  #
  # 修改2: OS 白名单 — 在 case $os in 中找到 gnu* | android* | bsd* 行，添加 ohos* ：
  #   ohos* | gnu* | android* | bsd* | mach* | minix* ...
  #
  # 修改3: kernel-os 白名单 — 找到 linux-gnu* | linux-dietlibc* | linux-android* 行，
  #   在 linux-musl* 之后添加 linux-ohos* ：
  #   linux-gnu* | linux-dietlibc* | linux-android* | linux-newlib* \
  #       | linux-musl* | linux-ohos* | linux-relibc* | linux-uclibc* )
rec_auto_fix:          true
rec_impl:               patch-gnuconfig

fallback_priority:      2
fallback_approach:      download-gnuconfig
fallback_description:   从 GNU Config Git 仓库下载最新版 config.guess + config.sub（已包含 ohos 支持）
fallback_command:      |
  curl -o config.guess 'https://git.savannah.gnu.org/gitweb/?p=config.git;a=blob_plain;f=config.guess;hb=HEAD'
  curl -o config.sub   'https://git.savannah.gnu.org/gitweb/?p=config.git;a=blob_plain;f=config.sub;hb=HEAD'
  chmod +x config.guess config.sub
fallback_auto_fix:     true
fallback_impl:          download-and-replace

forbid_1_pattern:      手动修改 configure.ac 中的 host_alias 绕过
forbid_1_reason:        host_alias 只是临时覆盖，不解决根本的 config.sub 验证问题，且可能导致后续链接路径错误
forbid_1_consequence:   编译通过但运行时库路径错误、RPATH 指向不存在目录

# Layer 4: 原则引用
principles:             P-AUTOTOOLS-001,P-AUTOTOOLS-002

# 关系图
causes:                 [E001]
caused_by:              []
similar_to:             [E007]
conflicts_with:         []
prerequisite_of:        []

# 元数据
doc_file:               doc/E072.md
last_updated:           2026-04-13
source_event:           troubleshooting.md §4.2 + 实际编译经验（rsync 3.3.0 补充第4处）

