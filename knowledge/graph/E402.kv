#====================================================================
# E333 — OHOS toybox gzip 仅支持短选项，GNU 长选项 --force/--best 使安装失败
#====================================================================

# Layer 0: Error Surface
id:                     E402
trigger_tool:           make|gzip
phase:                  compilation|installation
error_signature:        gzip: unrecognized option|gzip: Unknown option|--force.*not supported

# Layer 1: Recognition
severity:               2
category:               compat, ohos, toolchain
match_keywords:         gzip, toybox, GZIP_MAN, --force, --best, short option, -f -9, unrecognized option, Unknown option, man pages, install-no-strip
title:                  OHOS toybox gzip 仅支持短选项 [-19cdfkt]，GNU 长选项 --force/--best 导致 make install/package 失败

# Layer 2: Diagnosis
root_cause:             OHOS /usr/bin/gzip 为 toybox 实现（readlink -f /usr/bin/gzip 指向 /system/bin/toybox），仅支持短选项 [-19cdfkt]，不支持 GNU gzip 的长选项 --force/--best。上游 MLton Makefile 在 GZIP_MAN=true 分支执行 "$(GZIP) --force --best $(MAN_PAGES)"（Makefile 第 425 行），package() 的 install-no-strip 阶段报 gzip: Unknown option 'force' → rc=1 → make: *** [Makefile:425: install-no-strip] Error 1 → ConanException。设备端 /data/service/hnp/bin 亦无 GNU gzip，无 infra 级零配方改动方案，属上游平台工具链能力差异（上游假定 GNU gzip）。
affected_scope:         任何上游 Makefile/安装脚本使用 GNU gzip 长选项（--force/--best/--keep 等）的项目，在 OHOS 上安装/打包 man 页或 dist 压缩文件时失败。与 toybox sed/expr（E010）、toybox 缺 install（E098）同属 OHOS toybox 命令能力差异类。
verification_cmd:       readlink -f /usr/bin/gzip 指向 /system/bin/toybox 且 gzip --help 仅输出 "usage: gzip [-19cdfkt] [FILE...]"；定向复现：gzip --force --best x → gzip: Unknown option 'force'；gzip -f -9 x → rc=0

# Layer 3: Solution Space
rec_priority:           1
rec_approach:           recipe-patch-gzip-short-options
rec_description:        配方补丁把 install-no-strip 的 gzip 长选项改为 toybox 兼容短选项：$(GZIP) --force --best $(MAN_PAGES) → $(GZIP) -f -9 $(MAN_PAGES)，并在 conandata.yml 注册补丁。保留 GZIP_MAN=true 语义（man 页仍压缩），不跳过安装、不关闭 man 压缩、不改上游默认交付物。
rec_command:            patch 0003 将 Makefile 第 425 行 `cd "$(TMAN)" && $(GZIP) --force --best $(MAN_PAGES);` 改为 `cd "$(TMAN)" && $(GZIP) -f -9 $(MAN_PAGES);`；验证：make install-no-strip 后 5 个 .gz 生成且 gzip -t 全部通过，"gzip: Unknown option" 计数=0。
rec_auto_fix:           true
rec_impl:               patch-recipe-makefile

fallback_priority:      2
fallback_approach:      gzip-man-false-skip-man-compression
fallback_description:   若无法改命令，可设 GZIP_MAN=false 跳过 man 压缩。但改变了上游默认打包产物（man 页不再 gzip），掩盖 toybox 兼容性而非修复，仅作退路。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       apt.*gzip|yum.*gzip|brew.*gzip|安装 GNU gzip
forbid_1_reason:        为单个库在设备上安装 GNU gzip 扩大构建工具依赖面，官方 CI 环境不保证提供，且不符合"发行包构建不应要求额外工具链"。
forbid_1_consequence:   依赖面扩散，CI 可移植性下降。
forbid_2_pattern:       GZIP_MAN.*false.*不修复|跳过.*man.*压缩
forbid_2_reason:        直接关掉 man 压缩会改变交付产物并掩盖真实平台差异。
forbid_2_consequence:   man 页未压缩，交付物与上游不一致。

# Layer 4: Principles
principles:             P005

# Relations
causes:                 []
caused_by:              []
similar_to:             [E010,E098]
conflicts_with:         []
prerequisite_of:        []

