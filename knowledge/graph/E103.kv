#====================================================================
# E103.kv — CMake minimum_required VERSION < 3.5 与 CMake 4.x 不兼容
# 问题: cmake_minimum_required(VERSION 3.4) 在 CMake 4.x 上报错
# 解决: 修改 CMakeLists.txt 中版本号为 3.5+
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E103
trigger_tool:           cmake
phase:                  configuration
error_signature:        CMake Error.*Compatibility with CMake.*3\.5 has been removed|cmake_minimum_required.*VERSION.*3\.[0-4]

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               compat, build-system, cmake
match_keywords:         cmake_minimum_required, Compatibility, CMake 4, version 3.4, 3.3, 3.2, removed, deprecated

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             CMake 4.x 移除了对 3.5 之前版本的兼容模式支持。使用 cmake_minimum_required(VERSION 3.4) 或更低版本的 CMakeLists.txt 会直接报错退出
affected_scope:         所有使用旧版 cmake_minimum_required 且尚未升级的项目（如 olm 3.2.16）
verification_cmd:       grep -r "cmake_minimum_required.*VERSION.*3\.[0-4]" CMakeLists.txt

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           bump-cmake-minimum-version
rec_description:        修改 CMakeLists.txt 中的 cmake_minimum_required VERSION 为 3.5 或更高
rec_command:            sed -i 's/cmake_minimum_required(VERSION 3\.[0-4])/cmake_minimum_required(VERSION 3.5)/' CMakeLists.txt
rec_auto_fix:           true
rec_impl:               source-patch

# 回退方案
fallback_priority:      2
fallback_approach:      cmake-compat-flag
fallback_description:   传递 -DCMAKE_POLICY_VERSION_MINIMUM=3.5 绕过检查
fallback_command:       cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 ..
fallback_auto_fix:      false
fallback_impl:          cmake-flag

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E103.md
last_updated:           2026-04-27
source_event:           olm 3.2.16 编译


# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
