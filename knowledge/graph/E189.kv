#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E111.kv，填写各字段
# 对应的人类文档: doc/E111.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E189
trigger_tool:           qmake
phase:                  configuration
error_signature:        Cannot find feature spec_pre.prf|Could not find qmake spec

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               build-system-qmake
match_keywords:         qmake, spec_pre.prf, features, Qt, mkspecs
title:                  Qt/qmake 项目缺少 features 目录导致配置失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             Qt 安装不完整,缺少 mkspecs/features 目录和 spec_pre.prf 等配置文件
affected_scope:         所有使用 qmake 构建系统的 Qt 项目
verification_cmd:       find $QT_HOST_DATA -name "features" -type d && find $QT_HOST_DATA -name "spec_pre.prf"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           manual-compile              # 见 DESIGN §5 impl 列表
rec_description:        手动编译:使用 flex/bison 生成解析器,然后用 clang++ 编译源码并链接
rec_command:            cd src && bison -v -d -o parser.cpp datalang.y && flex -o tokens.cpp datalang.l && clang++ -std=c++14 -fPIC -c *.cpp && clang++ -shared -o libiodata-qt5.so *.o -lQt5Core
rec_auto_fix:           false                      # 引擎能否自动执行
rec_impl:               manual                     # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

