#====================================================================
# E095.kv — Boost b2 构建系统不兼容 OHOS
# 问题: b2 (Boost.Build) 构建系统无法识别 OHOS 平台
# 影响: 无法编译需要二进制库的 Boost 组件
# 方案: 使用 CMake 构建 或 仅使用 header-only 库
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E099
trigger_tool:           b2|bjam|boost-build
phase:                  configuration|compilation
error_signature:        clang\+\+ --version.*exit code 1|cannot deduce architecture|unable to find parent of|aarch64-unknown-linux-ohos not recognized

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               build-system|platform
match_keywords:         b2, bjam, Boost.Build, boost, clang++ --version, Jamroot, user-config.jam, architecture detection, compiler detection, exit code 1, OHOS, aarch64-unknown-linux-ohos

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             b2 构建系统无法识别 OHOS 平台，编译器版本检测失败(执行 clang++ --version 退出码为 1)，平台架构检测失败(无法匹配 aarch64-unknown-linux-ohos)，b2 内部创建目录失败
affected_scope:         Boost 库中需要编译二进制文件的组件(asio, filesystem, system, thread, python, test 等)，header-only 组件不受影响(smart_ptr, tuple, mpl, spirit 等)
verification_cmd:       cd boost源码目录 && ./b2 --debug-configuration 2>&1 | grep -E "(exit code 1|cannot deduce architecture|unable to find parent)"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案: 使用 CMake 构建 (Boost 1.90+ 支持)
rec_priority:           1
rec_approach:           use-cmake-build
rec_description:        Boost 1.90+ 支持 CMake 构建，绕过 b2 构建系统，直接生成 Ninja/Make 文件
rec_command:            mkdir -p build && cd build && cmake .. -DBOOST_INCLUDE_LIBRARIES="system;filesystem" -DCMAKE_INSTALL_PREFIX=$DEFAULT_PREFIX && cmake --build . && cmake --install .
rec_auto_fix:           true
rec_impl:               cmake-build

# 回退方案: 仅使用 header-only 库
fallback_priority:      2
fallback_approach:      header-only-mode
fallback_description:   大部分 Boost 库是 header-only，无需编译即可使用，仅引用 boost 头文件目录即可
fallback_command:       export CPLUS_INCLUDE_PATH=/path/to/boost_1_90_0:$CPLUS_INCLUDE_PATH
fallback_auto_fix:      false
fallback_impl:          header-only

# 回退方案2: 创建 user-config.jam 手动指定编译器

# ★ 禁止策略 ★
forbid_1_pattern:       ./b2.*--build.*--host.*--target
forbid_1_reason:        b2 不支持 --build/--host/--target 参数，这些参数用于 autotools/configure，不能解决 OHOS 平台识别问题
forbid_1_consequence:   参数被忽略，b2 仍然无法识别 OHOS，继续报错

forbid_2_pattern:       ln -sf.*clang\+\+.*clang\+\+-.*
forbid_2_reason:        创建编译器符号链接无法解决 b2 内部的平台检测逻辑问题，b2 检测的是目标三元组而非编译器可执行文件名
forbid_2_consequence:   浪费时间且不解决问题

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

