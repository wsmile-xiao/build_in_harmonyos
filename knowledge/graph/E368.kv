#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E2145.kv，填写各字段
# 对应的人类文档: doc/E2145.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E368
trigger_tool: meson|ld|test
phase: configuration|linking|testing
error_signature: Checking for function .*reallocarray.*NO|undefined reference to .*strndup|api-oom-spdxtool.*FAIL|TEST_ASSERT_NULL.*was

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: meson-fault-injection
match_keywords: Meson, --wrap, fault injection, OOM, reallocarray, mkstemps, mkdtemp, strndup, static library, shared library, MinGW, dllimport
title: Meson allocator fault-injection build contract

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Capability-gated GNU ld --wrap tests can be omitted when support APIs are missing; forcing the tested library static expands wrapping into library internals, while MinGW dllimport calls can bypass wrapper symbols.
affected_scope: Meson C projects that register allocator fault-injection or deterministic corpus replay tests with GNU ld --wrap.
verification_cmd: meson introspect --tests build && meson test -C build --num-processes 1 --print-errorlogs

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: capability-bound-fault-injection
rec_description: Preserve the upstream tested-library link boundary, supply only missing test-environment APIs, make wrapped calls direct, and bind the final registered inventory plus expected terminal states.
rec_command: meson setup build source && meson introspect --tests build && meson test -C build --num-processes 1 --print-errorlogs
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: native-capability-runner
fallback_description: Run the same official inventory on a native environment that already provides every probed API and GNU ld wrapper semantic, while preserving the upstream link boundary.
fallback_command: meson setup build source && meson test -C build --num-processes 1 --print-errorlogs
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: default_library=static.*api-oom|static.*--wrap
forbid_1_reason: Static linkage can widen fault injection from the intended consumer sources into the tested library internals.
forbid_1_consequence: Valid fallback paths inside the library are misclassified as constructor OOM failures.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E2145.md
last_updated: 2026-08-10
source_event: pkgconf 3.0.5 full upstream inventory and OOM/corpus replay validation

