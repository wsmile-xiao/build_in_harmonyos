#====================================================================
# E040.kv — MAN_OWNER 空指针解引用段错误
#====================================================================

id:                     E040
title: MAN_OWNER 空指针解引用段错误
trigger_tool:           mandb|man-db|runtime
phase:                  runtime
error_signature:        mandb.*SIGSEGV|mandb.*exit code 139|
                         MAN_OWNER.*null.*dereference|segfault.*man_owner

severity:               3
category:               security|runtime|null-pointer
match_keywords:         mandb, SIGSEGV, 139, MAN_OWNER, segfault, null pointer,
                         man-db, get_man_owner, pw_uid, chown, config.h

root_cause:             man-db 的 get_man_owner() 在鸿蒙上找不到 man 系统用户返回 NULL,
                         但调用方直接解引用 man_owner->pw_uid 未做 NULL 检查, 导致段错误。
                         问题链: configure --with-owner=man → config.h #define MAN_OWNER → NULL 解引用
affected_scope:         man-db mandb 命令完全无法运行 (exit code 139 = SIGSEGV)
verification_cmd:       mandb; echo $?  # 139 = SIGSEGV

rec_priority:           1
rec_approach:           config-patch
rec_description:        在 config.h 中取消 MAN_OWNER 定义:
                         sed -i 's/^#define MAN_OWNER "man"/\/\* #undef MAN_OWNER \*\//' config.h;
                         然后 make clean && make
rec_command:            grep MAN_OWNER config.h  # 应看到: /* #undef MAN_OWNER */
rec_auto_fix:          false
rec_impl:               manual-edit

fallback_priority:      2
fallback_approach:      source-patch
fallback_description:   补丁 security.c 返回 NULL + 所有调用方加 NULL 检查 (需改多处)
fallback_auto_fix:     false

forbid_1_pattern:      在 POSIX getpwnam() 返回值未做 NULL 检查就直接解引用 pw_uid/pw_gid/pw_name
forbid_1_reason:       鸿蒙系统可能缺少常见 Linux 用户(man/mail/news 等), getpwnam 返回 NULL
forbid_1_consequence:  段错误(SIGSEGV), 程序崩溃退出码 139
principles:             P-PATCH-001

causes:                 []
caused_by:              [E038]
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E040.md
last_updated:           2026-04-10
source_event:           archives/s/man-db/2.13.1/manifest.yaml

