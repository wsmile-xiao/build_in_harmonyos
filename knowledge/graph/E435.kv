#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E255.kv，填写各字段
# 对应的人类文档: doc/E255.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E435
trigger_tool: conan|autotools|configure
phase: configure
error_signature: gpgrt-config.*hang|read VAR_ <<EOF.*mksh|configure: checking for GPG Error.*hang|gpg-error-config: No such file or directory.*test: integer expected

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category:               ohos, build-system, autotools, shell
match_keywords: gpgrt-config, /bin/sh, mksh, here-doc, read loop, hang, gpg-error-config, config script, bash wrapper
title: gpgrt-config (libgpg-error config script) hangs under OHOS /bin/sh (mksh) — wrap with bash

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: libgpg-error 的 gpgrt-config POSIX 脚本在 OHOS /bin/sh (/system/bin/sh, mksh) 下执行 read VAR <<EOF 时死循环挂起；同脚本在 bash 下正常。configure 调用 $GPG_ERROR_CONFIG --modversion 时挂死，导致 configure 卡住。
affected_scope: autotools 项目经 configure 调用 libgpg-error 的 gpgrt-config 且 /bin/sh 为 mksh 的平台
verification_cmd: timeout 8 /bin/sh <gpgrt-config> gpg-error --modversion 观察挂起；同命令用 bash 执行则秒回

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:
rec_approach: build-local-bash-wrapper
rec_description: 在构建目录创建 gpgrt-config bash 包装脚本（exec bash 真实 gpgrt-config），prepend PATH 让 configure 找到包装器；同时提供修正后的 gpg-error.pc（依赖包 .pc 的 prefix=/ 错误）
rec_command: printf "#!/bin/sh\nexec /data/service/hnp/bin/bash <pkg>/bin/gpgrt-config \"$@\"\n" > <build>/bin/gpgrt-config && chmod +x <build>/bin/gpgrt-config && PATH=<build>/bin:$PATH ./configure
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: patch.*gpgrt-config.*shebang.*in.*conan.*cache
forbid_1_reason: 修改制品仓缓存里的依赖包脚本不可复现
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P005

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: [E256]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
forbid_2_pattern: --build=.*--host=.*
forbid_2_reason: 禁止三元组绕过（E007 铁律）
rec_auto_fix: false
doc_file: doc/E435.md
last_updated: 2026-08-10
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors: yanjiaxin <yanjiaxin@noreply.gitcode.com>
source_pr: !6301
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:
rec_priority:               1
authors:               0C59
