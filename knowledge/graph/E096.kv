#====================================================================
# E081 — CMake C++ 标准自动检测失败需显式设置 CMAKE_CXX_STANDARD
# 发现于: abseil-cpp 20260107.1 编译
# 日期: 2026-04-23
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E096
trigger_tool:           cmake
phase:                  configuration
error_signature:        Performing Test.*CXX17.*Failed|CMake Error.*compiler defaults.*C++ < 17|C++ >= 17 is required|System is unknown to cmake

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               cmake|compiler|configuration|platform
match_keywords:         cmake,c++17,c++20,cmake_cxx_standard,compiler detection,standard required,abseil
title:                  CMake C++ 标准自动检测失败需显式设置 CMAKE_CXX_STANDARD

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OpenHarmony 平台上 CMake 无法正确检测编译器的 C++ 标准支持能力，CMake 输出 "System is unknown to cmake" 导致编译器 ABI 检测不完整，即使编译器实际支持 C++17，特性检测也会失败
affected_scope:         所有使用 CMake 且依赖编译特性检测来确定 C++ 标准的项目，特别是要求特定 C++ 标准的库（如 abseil-cpp 要求 C++17）
verification_cmd:       cmake .. -DCMAKE_CXX_STANDARD=17 && make && echo "C++17 support verified"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           cmake-cxx-standard-explicit
rec_description:        显式设置 CMAKE_CXX_STANDARD 和 CMAKE_CXX_STANDARD_REQUIRED 强制指定 C++ 标准版本，绕过 CMake 的编译特性自动检测机制
rec_command:            cmake .. -DCMAKE_CXX_STANDARD=17 -DCMAKE_CXX_STANDARD_REQUIRED=ON
rec_auto_fix:           true
rec_impl:               cmake-cxx-standard

# ═══ 禁止策略 ═══
forbid_1_pattern:       -DCMAKE_CXX_STANDARD=.*[^0-9].*
forbid_1_reason:         CMAKE_CXX_STANDARD 必须是有效的整数年份（如 11, 14, 17, 20）
forbid_1_consequence:    CMake 将忽略无效值或报错

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E007]
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

