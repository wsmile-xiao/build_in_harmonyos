#====================================================================
# E015.kv — gettext/libintl 链接缺失 (dgettext undefined symbol)
# 适用: 检测到 libintl.h 但 configure 未自动添加 -lintl 的软件
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E015
trigger_tool:           make|ld
phase:                  linking
error_signature:        undefined symbol: libintl_dgettext|undefined reference to `_?dgettext'|undefined reference to `libintl_dgettext'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               linking, nls
match_keywords:         libintl_dgettext, dgettext, undefined symbol, libintl, gettext, NLS, argp, linking

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             软件 configure.ac 检测到 libintl.h 后使用 dgettext，
                        但未调用 AM_GNU_GETTEXT 来自动添加 -lintl 到链接标志。
                        当系统中有 gettext/libintl 安装时，源码使用真实的 dgettext（而非 no-op 宏），
                        但链接时缺少 -lintl 导致 undefined symbol。
affected_scope:         argp-standalone 及其他检测到 libintl.h 但未声明 gettext 链接依赖的软件
verification_cmd:       echo 'extern char* dgettext(const char*, const char*); int main(){dgettext("","x");}' | clang -xc - -lintl 2>&1

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           configure-libs-option
rec_description:        configure 时传 LIBS="-lintl" 显式链接 gettext 库
rec_command:            ./configure --prefix=$DEFAULT_PREFIX LIBS="-lintl"
rec_auto_fix:           false
rec_impl:               configure-option

fallback_priority:      2
fallback_approach:      configure-disable-nls
fallback_description:   如果不需要国际化功能，configure 时传 --disable-nls 完全跳过 gettext
fallback_command:       ./configure --prefix=$DEFAULT_PREFIX --disable-nls
fallback_auto_fix:      false
fallback_impl:          configure-option

# ★ 禁止策略 ★
forbid_1_pattern:       rm.*libintl\.h|删除.*libintl\.h
forbid_1_reason:         删除系统头文件让 configure 检测不到 libintl 会禁用 i18n 功能，且影响其他软件
forbid_1_consequence:   功能降级，可能影响其他依赖 gettext 的软件

# ═══ Layer 4: 原则引用 ═══
principles:             

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E015.md
last_updated:           2026-04-21
source_event:           argp-standalone 1.5.0 编译

