#====================================================================
# E021.kv — BUILDEXEEXT 异常 (.exe 后缀误判)
#====================================================================

id:                     E021
trigger_tool:           configure|make
phase:                  configuration
error_signature:        BUILDEXEEXT=\.exe|BUILDPYTHON.*\.exe|
                         .*\.exe.*should not have.*extension

severity:               1
category:               configure|filesystem
match_keywords:         BUILDEXEEXT, .exe, case insensitive, conftestdir,
                         file system, build exe, extension, Makefile

root_cause:             configure 脚本通过检测文件系统是否大小写不敏感来
                         设置 BUILDEXEEXT, 鸿蒙 HMFS 在边界检测中可能误判,
                         导致可执行文件名被附加 .exe 后缀
affected_scope:         Python 等使用 BUILDEXEEXT 的 autotools 项目
verification_cmd:       grep -r "BUILDEXEEXT" Makefile | head -5

rec_priority:           1
rec_approach:           skip-configure-test
rec_description:        在 configure.ac 中为 HarmonyOS 跳过此检测(从源头避免误判),
                         或通过传参/patch 让 configure 不设置 BUILDEXEEXT=.exe
rec_command:
rec_auto_fix:          false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      sed-fix
fallback_description:  在生成的 Makefile 中将 BUILDEXEEXT=.exe 替换为空(回退方案)
fallback_command:      sed -i 's/BUILDEXEEXT=.exe/BUILDEXEEXT=/' Makefile
fallback_auto_fix:     true
fallback_impl:          shell-cmd

forbid_1_pattern:
principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E021.md
last_updated:           2026-04-09
source_event:           archives/p/python/3.9.0/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
