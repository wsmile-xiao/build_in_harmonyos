#====================================================================
# E026.kv — 线程局部存储(TLS)差异
#====================================================================

id:                     E026
trigger_tool:           cc|clang|configure
phase:                  compilation
error_signature:        thread-local storage not supported|
                         __thread.*not supported|TLS.*mismatch|
                         tls_model.*unsupported

severity:               2
category:               libc|compat
match_keywords:         TLS, __thread, _Thread_local, thread_local,
                         tls_model, glibc extension, musl, pthread

root_cause:             代码使用了 glibc 特有的 TLS 扩展(如 tls_model 属性),
                         musl 不支持这些扩展; 标准 __thread/_Thread_local 在两者上都可用
affected_scope:         使用 TLS 的 C/C++ 项目
verification_cmd:       echo '_Thread_local int x;' | clang -x c - -fsyntax-only -

rec_priority:           1
rec_approach:           use-standard-tls
rec_description:        使用标准 C11 _Thread_local 或 POSIX __thread 替代 glibc TLS 扩展
rec_command:
rec_auto_fix:          false
rec_impl:               source-patch

forbid_1_pattern:      __attribute__\(\(tls_model\(.*\)\)\)
forbid_1_reason:        glibc TLS 扩展在 musl 上不支持, 必须使用标准语法
forbid_1_consequence:   编译失败或运行时 TLS 行为异常
fallback_priority:      2
fallback_approach:      consult-knowledge
fallback_description:   推荐方案不适用时，查阅 knowledge/error-patterns.md 中相似条目的替代方案
fallback_command:      grep -r "关键词" knowledge/graph/index.tsv
fallback_auto_fix:     false
fallback_impl:          none

principles:

causes:                 []
caused_by:              []
similar_to:             [E020]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E026.md
last_updated:           2026-04-09
source_event:           多个构建事件
