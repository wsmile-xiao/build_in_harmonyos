#====================================================================
# E002.kv — 临时目录不可写
#====================================================================
id:                     E002
title: 临时目录不可写
trigger_tool:           configure|make|install
phase:                  configuration|installation
error_signature:        cannot create temporary.*tmp|/tmp.*read-only|
                         erofs|temporary directory.*Permission denied
severity:               3
category:               environment
match_keywords:         /tmp, temporary, read-only, erofs, TMPDIR,
                         Permission denied, tmp
root_cause:             鸿蒙系统 /tmp 是 erofs 只读挂载,
                         configure/make/install 默认使用 /tmp 做临时文件
affected_scope:         所有软件 (几乎所有构建工具都用到 /tmp)
verification_cmd:       mount | grep tmp, touch /tmp/test_$$

rec_priority:           1
rec_approach:           set-env-var
rec_description:        设置 TMPDIR 指向可写目录 (脚本开头已设置)
rec_command:            TMPDIR=$HOME/tmp
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:
principles:
causes:                 []
caused_by:              []
similar_to:             [E008]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E002.md
last_updated:           2026-04-09

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

