#====================================================================
# E098.kv — fbida JPEG_VER 版本检测失败问题
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E157
trigger_tool:           make|sh|cpp
phase:                  configuration
error_signature:        jpeg-version.sh.*failed|
                        sh.*jpeg-version.sh.*cpp.*not found|
                        JPEG_VER.*undefined|
                        test.*-eq.*JVERSION.*syntax error

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               dependency|configuration|fbida
match_keywords:         JPEG_VER, jpeg-version.sh, cpp, libjpeg, libjpeg-turbo, JPEG_LIB_VERSION, jpeg version detection
title: fbida JPEG_VER 版本检测脚本失败（缺少 cpp 预处理器）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             **fbida 的 jpeg-version.sh 脚本需要 cpp 预处理器来检测 JPEG 库版本**。
                         1. 脚本使用 `cpp` 预处理器处理 jpeglib.h 来提取 JPEG_LIB_VERSION
                         2. 如果系统没有安装 cpp，脚本会失败
                         3. 即使有 cpp，脚本也可能因为路径问题而失败
                         解决方法：手动设置 JPEG_VER 环境变量，跳过自动检测。
affected_scope:         fbida、所有依赖 jpeg-version.sh 或类似版本检测脚本的项目。
verification_cmd:       # 1. 检查 cpp 是否存在：which cpp;# 输出: /usr/bin/cpp 或 "not found";# 2. 测试版本检测脚本：scripts/jpeg-version.sh 2>&1;# 输出: 失败信息;# 3. 检查 libjpeg 版本：grep JPEG_LIB_VERSION /usr/local/include/jpeglib.h 2>&1 | head -3

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           manual-jpeg-ver
rec_description:        手动设置 JPEG_VER 环境变量。对于 libjpeg-turbo 3.x，JPEG_LIB_VERSION=62，所以设置 JPEG_VER=62。可以在 Make.config 中设置，或在 make config 时通过环境变量设置。
rec_command:            # Step 1: 确定版本：grep JPEG_LIB_VERSION /usr/local/include/jpeglib.h | head -1;# Step 2: 手动设置（示例）：export JPEG_VER=62;# Step 3: 运行配置：make config;# Step 4: 验证配置：grep JPEG_VER Make.config
rec_auto_fix:           true
rec_impl:               semi-auto

fallback_priority:      2
fallback_approach:      install-cpp
fallback_description:   安装 cpp 预处理器，让 jpeg-version.sh 脚本能够正常运行。这需要 root 权限或包管理器。
fallback_command:        # Debian/Ubuntu: sudo apt-get install cpp;# OpenHarmony: 检查是否可用，或使用手动设置方案
fallback_auto_fix:      false
fallback_impl:          manual

# ═══ Layer 4: 原则引用 ═══
principles:             P-DEPENDENCY-001, P-CONFIGURATION-001

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E097]
similar_to:             [E006, E007]
conflicts_with:         []
prerequisite_of:        []

