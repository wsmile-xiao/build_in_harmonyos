#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E068.kv，填写各字段
# 对应的人类文档: doc/E068.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E035
trigger_tool:           b2|bjam|boost-build
phase:                  configuration
error_signature:        match-command-output.*exited with error code|SHELL.*version.*failed|clang++ --version.*error

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               build-system-compatibility
match_keywords:         boost, b2, bjam, SHELL, version, error code, match-command-output
title:                  Boost.Build SHELL 执行失败（鸿蒙兼容性问题）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             Boost.Build 的 SHELL 执行机制与鸿蒙 shell 不兼容，无法正确执行版本检测等命令
affected_scope:         所有需要使用 b2/bjam 构建的软件（boost, boost-dependent libraries）
verification_cmd:       ./b2 --version 2>&1 | grep -E "(exited with error|match-command-output)"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           header-only-install
rec_description:        仅安装 Boost 的 header-only 部分，无需编译，直接复制 boost/ 头文件目录
rec_command:            cp -r boost $DEFAULT_PREFIX/include/
rec_auto_fix:           false
rec_impl:               manual-copy

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      use-standard-library
fallback_description:   对于需要编译的库（filesystem, thread, chrono），使用 C++ 标准库替代（std::filesystem, std::thread, std::chrono）
fallback_command:       使用 C++11/17 标准库替代 Boost 库
fallback_auto_fix:      false
fallback_impl:          code-replacement

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       b2 install|bjam install
forbid_1_reason:        Boost.Build 在鸿蒙上无法正常执行 SHELL 命令，会导致编译失败
forbid_1_consequence:   编译过程中报错，无法继续

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P03-platform-compatibility, P09-header-only-priority

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

