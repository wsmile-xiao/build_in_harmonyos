#====================================================================
# E019.kv — 库加载失败（运行时）
#====================================================================

id:                     E019
title: 库加载失败（运行时）
trigger_tool:           ld|runtime|shell
phase:                  runtime
error_signature:        error while loading shared libraries.*cannot open|
                         cannot open shared object file.*lib.*\.so|
                         ld.so.*lib.*\.so.*not found

severity:               3
category:               runtime|linking
match_keywords:         shared library, cannot open, lib*.so,
                         LD_LIBRARY_PATH, rpath, ld.so, NEEDED,
                         dynamic linker, library path, ldd,
                         $ORIGIN, RPATH, runpath, musl

root_cause:             运行时动态链接器(ld.so)在标准搜索路径中
                         找不到所需的共享库(.so),
                         可能原因: 库未安装/路径不在搜索范围/rpath 未设置。
                         注意: musl 动态链接器不支持 $ORIGIN RPATH 扩展,
                         即便编译时设置了 -Wl,-rpath,$ORIGIN/../lib,
                         运行时也不会展开 $ORIGIN 为实际路径。
affected_scope:         所有依赖动态链接库的程序运行阶段
verification_cmd:       ldd /path/to/binary; llvm-readelf -d binary | grep NEEDED; ls -la $PREFIX/lib/*.so

rec_priority:           1
rec_approach:           set-ld-library-path
rec_description:        设置 LD_LIBRARY_PATH 包含库所在目录
rec_command:            export LD_LIBRARY_PATH=$HOME/usr/local/lib:$LD_LIBRARY_PATH
rec_auto_fix:          true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      set-rpath
fallback_description:  编译时设置 rpath 让二进制自带库路径(更持久)。
                        推荐使用绝对路径 RPATH（如 /data/usr/local/lib），
                        因为 musl 不支持 $ORIGIN 扩展。
fallback_command:      LDFLAGS="-Wl,-rpath,/data/usr/local/lib $LDFLAGS"
fallback_auto_fix:     false
fallback_impl:          add-cflags

forbid_1_pattern:
principles:

causes:                 []
caused_by:              [E004]
similar_to:             [E004]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E019.md
last_updated:           2026-04-09
source_event:           多个构建事件
