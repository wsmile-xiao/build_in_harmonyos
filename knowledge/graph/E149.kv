#====================================================================
# E093: socat 在 HarmonyOS 上可直接编译，无需修改源码
# 对应的人类文档: E093-draft-4E02.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E149
trigger_tool:           configure|make
phase:                  configuration|compilation

# 注意：这是一个成功案例，error_signature 用于匹配"预期需要修改但实际不需要"的场景
error_signature:        socat.*HarmonyOS|autotools.*platform.*success|无需修改源码

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               0
category:               platform_success
match_keywords:         socat, autotools, platform, success, musl, config.guess, config.sub
title:                  socat 在 HarmonyOS 上可直接编译成功（platform_success）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             socat 使用 autotools 构建系统，其 configure 脚本能够自动检测平台特性：
                         1. 通过 config.guess/config.sub 正确识别 HarmonyOS 平台
                         2. 自动检测 musl 缺失的函数（如 isastream）
                         3. 当 isastream 不可用时，自动禁用 WITH_ABSTRACT_UNIXSOCKET
                         4. 整个编译过程无需修改任何源码文件
affected_scope:         使用 autotools 构建的网络工具（socat, netcat, wget, curl 等）
verification_cmd:       socat -V; socat -V | grep "#define WITH"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           direct_compile
rec_description:        直接使用标准编译流程，无需任何源码修改
rec_command:            |
                         cd ~/tmp/builds/socat-1.7.4.4.work
                         ./configure --prefix=/storage/Users/currentUser/usr/local
                         make -j2
                         make install
rec_auto_fix:           true
rec_impl:               autotools_native_compile

# ═══ musl 兼容性记录 ═══
musl_compatibility:
  - feature: _res state
    status: reserved
    note: 已废弃但仍保留结构体定义，configure 检测到但未阻塞
  - feature: isastream()
    status: unavailable
    note: musl 不实现，configure 自动检测并禁用 WITH_ABSTRACT_UNIXSOCKET

# ═══ HMDFS 限制 ═══
hmdfs_limitations:
  - feature: chmod/chown
    impact: medium
    handling: HMDFS 上可能无权限效果，记录为平台限制，非阻塞
  - feature: symlink tests
    impact: low
    handling: test.sh 中使用符号链接，可能失败，需跳过相关测试

# ═══ 编译产物 ═══
build_artifacts:
  - name: socat
    size: 302K
    note: 主程序，支持 TCP/UDP/UNIX socket 等多种协议
  - name: procan
    size: 70K
    note: 进程分析工具
  - name: filan
    size: 78K
    note: 文件 descriptor 分析工具

# ═══ Layer 4: 原则引用 ═══
principles:             P-AUTOTOOLS-001, R18

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E007, E081]
conflicts_with:         []
prerequisite_of:        []

# ═══ 关键要点 ═══
key_points:
  - autotools 的优势：自动检测平台特性，减少手动适配工作
  - musl 兼容性：大部分 POSIX 功能可用，少数 Linux 特有函数缺失
  - HMDFS 限制：某些 POSIX 操作（chmod/chown）可能无效，但通常非阻塞
  - 无源码修改：.edit-tracker.json 显示 "edited": []

# ═══ 元数据 ═══
doc_file:               E093-draft-4E02.md
last_updated:           2026-05-14
source_event:           socat 1.7.4.4 编译成功
software:               socat 1.7.4.4
contributor_id:         4E02

draft: false
status:                 verified
quality_gate:           G1-G4 通过 (G0 因 HMDFS 限制未通过，已提供替代验证方案)
precompiled_package:    socat-1.7.4.4-ohos-aarch64.tar.gz (626K)