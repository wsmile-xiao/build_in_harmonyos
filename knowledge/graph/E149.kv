#====================================================================
# E093: socat 在 HarmonyOS 上可直接编译，无需修改源码
# 对应的人类文档: E093-draft-4E02.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E149
trigger_tool:           configure|make
phase:                  configuration|compilation

# 注意：这是一个成功案例，error_signature 用于匹配"预期需要修改但实际不需要"的场景
error_signature:        socat.*HarmonyOS|autotools.*platform.*success|无需修改源码

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               1
category:               platform
match_keywords:         socat, autotools, platform, success, musl, config.guess, config.sub

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             socat 使用 autotools 构建系统，其 configure 脚本能够自动检测平台特性：
affected_scope:         使用 autotools 构建的网络工具（socat, netcat, wget, curl 等）
verification_cmd:       socat -V; socat -V | grep "#define WITH"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           direct_compile
rec_description:        直接使用标准编译流程，无需任何源码修改
rec_command:            |
rec_auto_fix:           true
rec_impl:               autotools_native_compile

# ═══ musl 兼容性记录 ═══

# ═══ HMDFS 限制 ═══

# ═══ 编译产物 ═══

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E149.md
last_updated:           2026-05-14
source_event:           socat 1.7.4.4 编译成功


