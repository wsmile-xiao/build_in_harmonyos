#====================================================================
# E107-58CC.kv — 新工具链解决HMDFS问题
# 对应的人类文档: draft/E107-58CC.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E178
trigger_tool:           configure|autoreconf
phase:                  configuration
error_signature:        automake not found|autoreconf: failed

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               1
category:               platform|toolchain|resolved
match_keywords:         autoreconf, automake, coreutils, new toolchain

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             旧工具链缺少automake导致无法使用autoreconf重新生成configure
affected_scope:         所有autotools项目（8+软件）
verification_cmd:       autoreconf --version && automake --version

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           autoreconf-regenerate
rec_description:        新工具链提供automake 1.17，可用autoreconf -fvi重新生成configure
rec_command:            autoreconf -fvi && ./configure --prefix=$DEFAULT_PREFIX
rec_auto_fix:           true
rec_impl:               autoreconf

# ★ 禁止策略 ★
forbid_1_pattern:       
forbid_1_reason:        
forbid_1_consequence:   

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

