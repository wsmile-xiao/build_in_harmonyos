#====================================================================
# E081 — cmake config template missing/incomplete
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E117
trigger_tool:           cmake
phase:                  configuration
error_signature:        CMake Error: File .*config-cmake\.h\.in does not exist|PACKAGE_STRING undeclared|use of undeclared identifier 'PACKAGE_STRING'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               cmake_template
match_keywords:         config-cmake.h.in, PACKAGE_STRING, cmake CONFIGURE_FILE, undeclared identifier PACKAGE
title:                  cmake 项目缺少或不完整的 config-cmake.h.in 导致 configure/make 失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             cmake 项目 CMakeLists.txt 使用 CONFIGURE_FILE(config-cmake.h.in ...) 但模板文件缺失或使用了 autotools @...@ 语法而非 cmake ${...} 语法,导致 cmake configure 失败或编译时 PACKAGE_STRING 等宏未定义
affected_scope:         所有包含 cmake CONFIGURE_FILE 指令的 C 项目,特别是同时支持 cmake 和 autotools 的双构建系统项目
verification_cmd:       grep CONFIGURE_FILE CMakeLists.txt && cmake --build build && grep PACKAGE_STRING build/config.h

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           create_cmake_template
rec_description:        创建或修复 config-cmake.h.in 文件,使用 cmake ${...} 变量语法替换 autotools @...@ 语法,确保 PACKAGE/VERSION/PACKAGE_STRING 等宏定义完整
rec_command:            cat > config-cmake.h.in << 'EOF'\n#ifndef CONFIG_H\n#define CONFIG_H\n#cmakedefine WORDS_BIGENDIAN\n#define SIZEOF_LONG ${SIZEOF_LONG}\n#define PACKAGE "${PACKAGE}"\n#define VERSION "${VERSION}"\n#define PACKAGE_STRING "${PACKAGE_STRING}"\n#endif\nEOF
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      cmake_definitions
fallback_description:   在 CMakeLists.txt 中用 target_compile_definitions 直接定义 PACKAGE_STRING 等宏,绕过 CONFIGURE_FILE
fallback_command:       target_compile_definitions(target PRIVATE PACKAGE_STRING="libdiscid 0.6.5")
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       @PACKAGE_STRING@|@SIZEOF_LONG@|@VERSION@
forbid_1_reason:        cmake CONFIGURE_FILE 使用 ${...} 语法而非 @...@ 语法,虽然 cmake 也支持 @...@ 但 ${...} 更一致且避免与 autotools 冲突
forbid_1_consequence:   使用 @...@ 语法可能导致 CONFIGURE_FILE 生成的 config.h 中变量未替换,编译报 PACKAGE_STRING undeclared

# ═══ Layer 4: 原则引用 ═══
principles:             R6,R8,R23

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E007,E072]
conflicts_with:         []
prerequisite_of:        []

