id:                     E448
trigger_tool:           conan|autotools|gnustep-make|GNUmakefile|configure
phase:                  configuration|build|packaging
error_signature:        GNUSTEP_MAKEFILES.*not found|GNUSTEP_SYSTEM_ROOT|GNUSTEP_CONFIG_FILE|/bin/sh.*not found|Permission denied|GNUstep Makefiles

severity:               3
category:               ohos, autotools, environment, gnustep, tool-requires
match_keywords:         GNUSTEP_MAKEFILES, GNUSTEP_SYSTEM_ROOT, GNUSTEP_CONFIG_FILE, GNUSTEP_INSTALLATION_DOMAIN, gnustep-make, GNUmakefile, SYSTEM domain, LD_LIBRARY_PATH
title:                  Close the GNUstep Make environment for GNUstep libraries on OHOS

root_cause:             GNUstep libraries are not plain Autotools packages. The
                        configure script and GNUmakefile both need a coherent
                        GNUstep Make domain before they can detect, build, and
                        install libraries. On OHOS, scripts may also need an
                        executable shell path that exists on the worker, and the
                        produced libraries must be staged in the GNUstep SYSTEM
                        layout rather than a conventional prefix-only libdir.
affected_scope:         Conan recipes for GNUstep core or application libraries
                        that consume gnustep-make as a tool requirement and build
                        on an OHOS target worker.
verification_cmd:       CI_PACKAGES="archives/g/gnustep-base/1.31.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           conan-gnustep-make-domain-closure
rec_description:        Resolve the gnustep-make package folder from the Conan
                        build dependency, prepend its bin directory to PATH, set
                        GNUSTEP_MAKEFILES to share/GNUstep/Makefiles, bind
                        GNUSTEP_SYSTEM_ROOT and GNUSTEP_CONFIG_FILE to the
                        current package folder, pass
                        GNUSTEP_INSTALLATION_DOMAIN=SYSTEM during configure and
                        make, and expose dependency library directories through
                        the build and run environments. Prepare configure and
                        GNUstep Make scripts with an OHOS-available shell before
                        invoking them.
rec_command:            with gnustep_environment.vars(self).apply(): configure; make -j1 GNUSTEP_INSTALLATION_DOMAIN=SYSTEM GNUSTEP_SYSTEM_ROOT=<package_folder>
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      explicit-gnustep-tool-paths
fallback_description:   When the upstream build does not honor the full GNUstep
                        environment, pass GNUSTEP_MAKEFILES, GNUSTEP_SYSTEM_ROOT,
                        and GNUSTEP_INSTALLATION_DOMAIN directly on the make
                        command line while keeping the Conan package layout
                        task-local.
fallback_command:
fallback_auto_fix:      false
fallback_impl:          conan-recipe

forbid_1_pattern:       configure.*without.*GNUSTEP_MAKEFILES|make.*without.*GNUSTEP_SYSTEM_ROOT
forbid_1_reason:        GNUstep Make rules read domain variables throughout the
                        build, so a configure-only setting is not sufficient.
forbid_1_consequence:   Configure may pass, but build, install, or downstream
                        consumers resolve the wrong GNUstep domain.
forbid_2_pattern:       hardcode.*/storage/Users/.*/\.conan2|patch.*gnustep-make.*package_folder
forbid_2_reason:        gnustep-make is a shared Conan tool package and must stay
                        relocatable for other recipes and users.
forbid_2_consequence:   Builds become cache-location dependent and can corrupt
                        unrelated tasks.

principles:             P013,P014
causes:                 []
caused_by:              []
similar_to:             E337
conflicts_with:         []
prerequisite_of:        []

