# Layer 0: 错误面
id: E176
title: ICU 动态链接器无法加载 stubdata 共享库
trigger_tool:           make|icupkg
phase:                  build
error_signature:        Error loading shared library libicudata.so.*|Error relocating.*icudt.*_dat: symbol not found|cannot load stubdata

# Layer 1: 识别层
severity:               3
category:               platform|harmonyos|icu|bootstrap
match_keywords:         ICU, stubdata, libicudata, dynamic linker, bootstrap, static, data packaging

# Layer 2: 诊断层
root_cause:             HarmonyOS 动态链接器对 ICU 的 stubdata 共享库有特殊限制，无法正常加载空 stubdata 库用于 bootstrap 过程。ICU 构建系统依赖 bootstrap：工具需要库运行，库需要工具构建数据。在 HarmonyOS 上，动态链接器拒绝加载只包含空符号的 stubdata 库。
affected_scope:         所有 ICU 版本（78+）在 HarmonyOS 上的编译
verification_cmd:       ls -lh lib/libicudata.so.* && LD_LIBRARY_PATH=lib bin/icupkg --version

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           static-build-with-static-data
rec_description:        使用静态编译模式，将数据嵌入静态库，避免动态链接器依赖。configure 参数：--disable-shared --enable-static --with-data-packaging=static
rec_command:            ./configure --prefix=$DEFAULT_PREFIX --disable-shared --enable-static --with-data-packaging=static && make -j4 && make install DESTDIR=$TEST_PREFIX
rec_auto_fix:           true
rec_impl:               configure-options

fallback_priority:      2
fallback_approach:      cross-build
fallback_description:   使用预构建的 ICU 工具（在其他平台上构建）避免 bootstrap 依赖
fallback_command:       ./configure --prefix=$DEFAULT_PREFIX --with-cross-build=/path/to/prebuilt-icu-tools
fallback_auto_fix:      false
fallback_impl:          configure-options

forbid_1_pattern:       不要使用动态库模式（默认 --enable-shared）
forbid_1_reason:        动态链接器无法加载 stubdata，导致 bootstrap 失败
forbid_1_consequence:   工具无法运行，数据无法构建，编译中断

# Layer 4: 原则引用
principles:             P-PLATFORM-001

# 关系图
causes:                 []
caused_by:              []
similar_to:             [E002,E011]
conflicts_with:         []
prerequisite_of:        []

