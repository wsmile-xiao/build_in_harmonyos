#====================================================================
# E071.kv — automake 版本不匹配 (build-systems.md §10.3)
# 上游 tarball 要求的 automake 版本高于系统安装版本
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E071
trigger_tool:           configure|autoreconf
phase:                  configuration
error_signature:        requires automake .* but .* installed|automake version.*too old|AUTOMAKE_VERSION mismatch

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               autotools|version-mismatch
match_keywords:         automake, version mismatch, requires, installed, aclocal, autoheader, autoreconf, timestamp, /bin/true

# ═══ Layer 2: 诊断层 ═══
root_cause:             上游 tarball 的 configure.ac 声明需要的 automake 版本
                         高于系统已安装版本；或时间戳不一致触发 autotools 重生成
affected_scope:         man-db 等使用较新 autotools 特性的软件
verification_cmd:       automake --version; head -5 configure.ac | grep -i automake

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           bypass-autotools-env
rec_description:        将 autotools 工具设为 /bin/true 绕过调用
                         （前提：tarball 已包含正确生成的 Makefile.in）
rec_command:            ACLOCAL="/bin/true" AUTOHEADER="/bin/true" AUTOMAKE="/bin/true" \
                         ./configure --prefix=$HOME/usr/local && make -j1
rec_auto_fix:           true
rec_impl:                set-env-var

fallback_priority:      2
fallback_approach:      vpath-build
fallback_description:   使用 VPATH out-of-tree 构建避免触碰源码时间戳
fallback_command:       |
  mkdir ../build-$(basename $(pwd)) && cd ../build-$(basename $(pwd)) && \
  ACLOCAL="/bin/true" AUTOMAKE="/bin/true" \
  ../$(basename $(pwd))/configure --prefix=$HOME/usr/local && make -j1
fallback_auto_fix:      false
fallback_impl:          manual-fix

forbid_1_pattern:       apt-get.*install.*automake(?!.*系统包管理)
forbid_1_reason:        鸿蒙非 Debian/Ubuntu，无法用 apt 安装升级 automake
forbid_1_consequence:   command not found

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E071.md
last_updated:           2026-04-10
source_event:           man-db 2.13.1 编译

