#====================================================================
# E113.kv — 嵌套源码提升丢失同级目录
# 对应的人类文档: doc/E113.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E195
trigger_tool:           cmake|make
phase:                  configuration|compilation
error_signature:        CMakeLists.txt: No such file or directory|include.*No such file or directory|../include.*not found|Cannot find include directory

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system
match_keywords:         promote_nested_source,include directory missing,CMakeLists.txt path,../include,sibling directory loss,nested source

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             init-build 的 _promote_nested_source 函数检测到 src/ 子目录有构建文件(CMakeLists.txt)后，将 src/ 内容提升到顶层，但会删除所有非点号开头的同级目录(如 include/、testcase/)，导致 CMakeLists.txt 中引用的 ../include 等路径失效
affected_scope:          含有 src/ + include/ 分离结构的 CMake 项目(如 tinytoml、header-only 库)，以及任何源码在子目录但依赖同级目录的项目
verification_cmd:        ls include/ 2>/dev/null && echo "OK" || echo "MISSING - need to restore from tarball"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           restore-from-tarball
rec_description:        从原始 tarball 重新解压，将丢失的同级目录(如 include/、testcase/)复制到工作目录，并修改 CMakeLists.txt 中的路径从 ../include 改为 include
rec_command:            tar xzf $BUILD_TARBALL -C $HOME/tmp/ && cp -r $HOME/tmp/<extracted>/include $BUILD_SRC_DIR/ && cp -r $HOME/tmp/<extracted>/testcase $BUILD_SRC_DIR/ && sed -i 's|../include|include|g; s|../testcase|testcase|g' $BUILD_SRC_DIR/CMakeLists.txt
rec_auto_fix:           false
rec_impl:               manual-restore

# 回退方案
fallback_priority:      2
fallback_approach:      skip-promotion
fallback_description:   使用 --no-download 模式手动解压完整 tarball，跳过自动提升
fallback_command:       tar xzf $BUILD_TARBALL && mv <extracted>/* $BUILD_SRC_DIR/
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       rm -rf include|rm -rf testcase
forbid_1_reason:        不要删除已有的同级目录，它们可能是手动恢复的
forbid_1_consequence:   会导致构建再次失败，需要重新从 tarball 恢复

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

