#====================================================================
# E085 — 鸿蒙系统缺少install命令需手动替代
# 发现于: sysfsutils 2.1.0, lm-sensors 3.6.0 编译
# 日期: 2026-04-27
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E098
trigger_tool:           make
phase:                  install
error_signature:        install: command not found|sh: install: inaccessible or not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               1
category:               command|toybox|install
match_keywords:         install,command not found,toybox,缺失命令
title:                  鸿蒙系统缺少install命令需手动替代

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             鸿蒙系统使用toybox提供基础命令，toybox不包含install命令。Makefile中的install目标调用install命令失败。
affected_scope:         所有Makefile中使用install命令安装文件的软件
verification_cmd:       which install || echo "install命令不存在"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           cp-chmod-replace
rec_description:        用cp + chmod组合替代install命令。install命令本质是cp + chmod + strip的组合，可手动实现
rec_command:            mkdir -p $DESTDIR/$PREFIX/bin && cp program $DESTDIR/$PREFIX/bin/ && chmod 755 $DESTDIR/$PREFIX/bin/program
rec_auto_fix:           true
rec_impl:               manual-install

# ═══ Layer 4: 预防层 (Prevention) ═══
prevention:             检查Makefile中的install目标，提前准备手动安装方案
workaround:             从GNU coreutils预编译包安装完整的install命令

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
