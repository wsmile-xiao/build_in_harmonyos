#====================================================================
# E054.kv — 外来二进制首次执行被安全确认弹窗阻止
#====================================================================

id:                     E054
trigger_tool:           runtime|shell|install
phase:                  installation|runtime|testing
error_signature:        Permission denied.*binary|make check.*all fail|
                         first execution.*blocked|security confirmation.*dialog

severity:               2
category:               security|runtime|harmonyos
match_keywords:         security dialog, first execution, binary confirmation,
                         Permission denied, make check, make install, popup, non-system binary

root_cause:             鸿蒙安全机制要求用户确认非系统预装二进制的执行权限。
                         首次执行时弹出安全确认弹窗, 若超时未点则进程被杀。
                         导致 make install 后产物无法立即使用, make check 全部误判为功能问题
affected_scope:         所有编译安装后的首次运行; make check 测试阶段
verification_cmd:       # 安装后手动执行一次触发弹窗确认
                         $PREFIX/bin/program --version

rec_priority:           1
rec_approach:           batch-trigger-execution
rec_description:        make install 后批量触发所有二进制的首次执行以完成安全确认:
                         find $PREFIX/bin -type f -exec {} --version \;
                         或在 make check 前确保所有产物已确认
rec_command:            find $PREFIX/bin -type f -exec {} --version \; 2>/dev/null
rec_auto_fix:          true
rec_impl:               batch-command

forbid_1_pattern:
principles:

causes:                 []
caused_by:              []
similar_to:             [E064]   # 都与 conftest/二进制首次执行相关
conflicts_with:         []
prerequisite_of:        [E064]   # 弹窗是 E064 conftest 失败的直接原因之一

doc_file:               doc/E054.md
last_updated:           2026-04-10
resolved_in:            HongMeng Kernel 1.12.0
resolved_note:          已安装二进制（bash/clang等）可直接执行，不再触发安全确认弹窗
source_event:           archives/c/coreutils/9.10/manifest.yaml
