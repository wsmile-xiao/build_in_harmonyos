#====================================================================
# E095.kv — 自定义 configure 脚本不尊重 CXX 环境变量
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E095
trigger_tool:           configure
phase:                  configuration
error_signature:        c\+\+: not found|
                         which c\+\+.*no|
                         checking for c\+\+.*no|
                         c\+\+: command not found

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               toolchain|custom-configure
match_keywords:         lzip, custom configure, CXX, c++, CC,
                         environment variable, hardcode, custom build system

# ═══ Layer 2: 诊断层 ═══
root_cause:             部分软件使用自定义 configure 脚本（非 autoconf 生成），
                        脚本中硬编码 c++ 编译器名（如 `c++`、`g++`），
                        而非读取 $CXX 环境变量。
                        在 OpenHarmony 上系统无 `c++` 命令
                        （仅有 `clang++`），导致 configure 阶段
                        找不到 C++ 编译器而失败。
affected_scope:         使用非标准 configure 脚本的软件。
verification_cmd:       grep -n "c++\|CXX\|CXXFLAGS" configure | head -10;
                         which c++ 2>&1; which clang++ 2>&1

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           set-env-var
rec_description:        显式传入 CXX=clang++ 参数给 configure 脚本，
                        覆盖脚本内部的硬编码值。
                        部分自定义脚本支持 CXX 参数但不会自动
                        从环境变量读取。
rec_command:            ./configure --prefix=$DEFAULT_PREFIX CXX=clang++
rec_auto_fix:           true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      source-patch
fallback_description:   直接修改 configure 脚本，将硬编码的 c++ 替换为 clang++。
                        需要 track-edit add 记录修改。
fallback_command:       sed -i 's/c++/clang++/g' configure
fallback_auto_fix:      false
fallback_impl:          source-patch

# ★ 禁止策略 ★
forbid_1_pattern:       ln -s.*clang.*c\+\+|alias c\+\+.*clang
forbid_1_reason:        不要创建 c++ 软链接或 alias 来绕过，
                        这会污染构建环境且可能影响其他软件检测
forbid_1_consequence:   构建环境污染，可能导致其他软件的编译器检测混乱

# ═══ Layer 4: 原则引用 ═══
principles:             

# ═══ 关系图 ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

