#====================================================================
# E008.kv — fstat/lseek 返回 EACCES
#====================================================================

id:                     E008
title: fstat/lseek 返回 EACCES
trigger_tool:           configure|make|cc|runtime
phase:                  compilation|runtime
error_signature:        fstat.*failed.*Permission denied|
                         fstat.*errno=13|fstat.*EACCES|
                         lseek.*Permission denied.*pipe|
                         standard output.*Permission denied

severity:               2
category:               syscall|compat
match_keywords:         fstat, EACCES, Permission denied, pipe,
                         terminal, socket, STDOUT_FILENO, lseek,
                         errno=13, ohos_fstat, st_blksize

root_cause:             鸿蒙 SELinux 策略限制用户进程对非普通文件
                         (管道/终端/套接字)的 fstat()/lseek() 调用,
                         返回 EACCES 而非正常结果
affected_scope:         使用 fstat() 判断输出类型的工具(coreutils, make, sed 等)
verification_cmd:       strace -e fstat cat /dev/null 2>&1 | grep EACCES

rec_priority:           1
rec_approach:           source-patch
rec_description:        编写 C 兼容层补丁, fstat/lseek 失败时回退为安全默认值
rec_command:
rec_auto_fix:          false
rec_impl:               none

forbid_1_pattern:      ignore.*EACCES.*fstat|suppress.*fstat.*error
forbid_1_reason:        不能简单忽略 fstat 错误,
                         必须提供正确的回退值(如 S_IFIFO + st_blksize=4096)
forbid_1_consequence:   忽略后可能导致后续代码使用未初始化的 stat 结构体
fallback_priority:      2
fallback_approach:      manual-workaround
fallback_description:   如果自动补丁不适用，手动在源码中做最小兼容修改并记录到 notes.md
fallback_command:      # 手动编辑源码后记录:
# 1. 修改文件列表
# 2. 修改原因
# 3. 验证方式
fallback_auto_fix:     false
fallback_impl:          manual

principles:             P-PATCH-001

causes:                 [E009]
caused_by:              []
similar_to:             [E009]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E008.md
last_updated:           2026-04-09
resolved_in:            HongMeng Kernel 1.12.0
resolved_note:          fstat/lseek 对管道/终端/套接字不再返回 EACCES，正常返回有效 stat 结构体
source_event:           archives/c/coreutils/9.10/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
