# PR-attached knowledge draft: Qt host tools for Windows-to-OHOS cross builds

id:                     E456
trigger_tool:           cmake|conan|moc|rcc|uic
phase:                  configuration|compilation
error_signature:        Automatic MOC.*moc|Exec format error.*moc|cannot execute.*moc|AArch64.*moc

severity:               2
category:               cmake, cross-compile, host-tools, qt5
match_keywords:         CMAKE_AUTOMOC_EXECUTABLE, CMAKE_AUTORCC_EXECUTABLE, CMAKE_AUTOUIC_EXECUTABLE, Qt5, moc, rcc, uic, host tools, AArch64, Windows
title:                  Windows-to-OHOS Qt5 cross builds must separate target Qt from native host moc/rcc/uic

root_cause:             CMake AUTOGEN executes moc, rcc, and uic on the build host, but a target Qt package for OHOS contains AArch64 tools that Windows cannot execute. Treating the target Qt prefix as both the target runtime and the host-tool prefix therefore fails before target compilation.
affected_scope:         Windows host builds that cross-compile Qt5-based CMake projects to OHOS AArch64 and use Conan target Qt packages with AUTOGEN, resource compilation, or UI generation. Native same-architecture builds are outside this rule.
verification_cmd:       conan create archives/a/attica-kf5/5.116.0 -pr:h=ci/conan/profiles/ohos-aarch64 -c user.attica-kf5:qt_host_tools_dir="$QT_HOST_TOOLS_DIR"

rec_priority:           1
rec_approach:            separate-target-qt-and-native-host-tools
rec_description:        Keep the OHOS Qt package in the target dependency graph, provide a native Qt host-tools directory containing moc.exe, rcc.exe, and uic.exe, and inject CMAKE_AUTOMOC_EXECUTABLE, CMAKE_AUTORCC_EXECUTABLE, and CMAKE_AUTOUIC_EXECUTABLE through the Conan CMake toolchain.
rec_command:            conan create archives/a/attica-kf5/5.116.0 -pr:h=ci/conan/profiles/ohos-aarch64 -c user.attica-kf5:qt_host_tools_dir="$QT_HOST_TOOLS_DIR"
rec_auto_fix:           false
rec_impl:               conan-cmake-toolchain-host-tools

fallback_priority:      2
fallback_approach:      explicit-native-tool-paths
fallback_description:   When a complete native tools directory cannot be supplied, pass validated native paths individually through the recipe configuration and fail closed if any required Qt generator is missing.
fallback_command:       set user.attica-kf5:qt_host_moc="$QT_HOST_MOC" and keep native rcc.exe and uic.exe beside it
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       CMAKE_AUTOMOC_EXECUTABLE=.*(target|aarch64)|QT_HOST_PATH=.*(target|ohos)|run.*AArch64.*moc.*Windows
forbid_1_reason:        A target executable is not a host generator, and emulation or an unvalidated mixed tool directory changes the build environment instead of proving a reproducible host-tool contract.
forbid_1_consequence:   CMake AUTOGEN can fail with an execution-format error, or a build can accidentally use generators from a different Qt release and produce invalid or non-reproducible generated sources.

principles:

causes:                 []
caused_by:              []
similar_to:             [E215, E159]
conflicts_with:         []
prerequisite_of:        []

