#====================================================================
# E099.kv — fbida GNUmakefile 缺少 libexif pkg-config 配置
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E158
trigger_tool:           make|gcc|pkg-config
phase:                  compilation
error_signature:        libexif/exif-data.h.*No such file or directory|
                        exiftran.c.*fatal error.*libexif/exif-data.h|
                        thumbnail.cgi.*undefined reference.*exif_

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build_system|dependency|fbida
match_keywords:         fbida, libexif, pkg-config, exif-data.h, exiftran, thumbnail.cgi, GNUmakefile, CFLAGS, missing header
title: fbida GNUmakefile 缺少 libexif 的 pkg-config 配置

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             **fbida 的 GNUmakefile 中 exiftran 和 thumbnail.cgi 目标缺少 libexif 的 pkg-config 配置**。
                         1. libexif 库已安装，头文件和库文件都存在
                         2. 但 GNUmakefile 中的 exiftran 和 thumbnail.cgi 目标没有添加 libexif 的编译和链接选项
                         3. 需要在相应的目标规则中添加：CFLAGS += $(shell $(PKG_CONFIG) --cflags libexif) 和 LDFLAGS += $(shell $(PKG_CONFIG) --libs libexif)
                         这是 fbida 构建脚本的一个缺陷。
affected_scope:         fbida 2.14 及相关版本、所有编译 exiftran 和 thumbnail.cgi 的项目。
verification_cmd:       # 1. 检查 libexif 是否安装：pkg-config --exists libexif && echo "libexif found";# 2. 检查头文件路径：pkg-config --cflags libexif;# 输出: -I/usr/local/include;# 3. 检查库文件路径：pkg-config --libs libexif;# 输出: -L/usr/local/lib -lexif;# 4. 查看编译错误：make exiftran 2>&1 | grep "exif-data.h"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           patch-gnu-makefile
rec_description:        修改 GNUmakefile，为 exiftran 和 thumbnail.cgi 目标添加 libexif 的 pkg-config 配置。这是最直接的解决方案，确保编译和链接正确。
rec_command:            # Step 1: 备份原文件：cp GNUmakefile GNUmakefile.orig;# Step 2: 添加 libexif 配置（exiftran 目标）：sed -i '/^exiftran:/{n;s/CFLAGS :=/CFLAGS := $(shell $(PKG_CONFIG) --cflags libexif) /}' GNUmakefile;# Step 3: 添加 libexif 配置（thumbnail.cgi 目标）：sed -i '/^thumbnail.cgi:/{n;s/CFLAGS :=/CFLAGS := $(shell $(PKG_CONFIG) --cflags libexif) /}' GNUmakefile;# Step 4: 验证修改：grep -A2 "exiftran:" GNUmakefile | grep libexif
rec_auto_fix:           true
rec_impl:               semi-auto

fallback_priority:      2
fallback_approach:      env-variables
fallback_description:   通过环境变量设置 libexif 的编译和链接选项，无需修改 GNUmakefile。但需要手动确保正确的顺序和路径。
fallback_command:        export CFLAGS="-I/usr/local/include $(pkg-config --cflags libexif)";export LDFLAGS="-L/usr/local/lib $(pkg-config --libs libexif)";make exiftran
fallback_auto_fix:      false
fallback_impl:          manual

# ═══ Layer 4: 原则引用 ═══
principles:             P-PATCH-001, P-DEPENDENCY-001

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E097]
similar_to:             [E006, E008]
conflicts_with:         []
prerequisite_of:        []

