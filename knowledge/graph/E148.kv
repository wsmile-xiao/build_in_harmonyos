#====================================================================
# E093.kv — mmsg API 缺失 (struct mmsghdr, recvmmsg, sendmmsg)
# 对应的人类文档: doc/E093.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E148
trigger_tool:           cc|clang|make
phase:                  compilation
error_signature:        storage size of .*mmsghdr.*isn.t known|incomplete type.*struct mmsghdr|undeclared.*recvmmsg|undeclared.*sendmmsg|implicit declaration.*recvmmsg|implicit declaration.*sendmmsg

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, libc, network
match_keywords:         mmsghdr, recvmmsg, sendmmsg, batch message, UDP, high performance, incomplete type, undeclared, musl, __linux__, __OHOS__

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS 使用 musl libc，未实现 Linux 特有的批量消息 API (struct mmsghdr, recvmmsg, sendmmsg)，源码使用 __linux__ 宏判断平台但误将 OHOS 识别为 Linux
affected_scope:         高性能网络库 (libuv, libevent, nginx, redis 等) 在启用批量消息功能时受影响
verification_cmd:       grep -r "mmsghdr\|recvmmsg\|sendmmsg" --include="*.c" --include="*.h" .

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           exclude-ohos-from-linux-conditionals
rec_description:        在使用 mmsg API 的代码块前添加 #if defined(__linux__) && !defined(__OHOS__) 条件编译，排除 OHOS 平台
rec_command:            sed -i 's/#if defined(__linux__)/#if defined(__linux__) \&\& !defined(__OHOS__)/g' <source_file>
rec_auto_fix:           true
rec_impl:               patch-conditionals

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      stub-implementation
fallback_description:   提供 mmsg API 的空实现或 fallback 实现，牺牲性能但保持兼容性
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       --enable-mmsg|--with-mmsg
forbid_1_reason:        OHOS 不支持 mmsg API，启用此选项会导致编译失败
forbid_1_consequence:   编译报错 incomplete type 或 undeclared identifier

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E148.md
last_updated:           2026-04-22
source_event:           libuv 1.52.1 编译失败


# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
