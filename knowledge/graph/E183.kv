#====================================================================
# E109.kv — HMDFS heredoc 限制：Python 替代脚本绕过（推荐）
# 对应的人类文档: draft/E109-heredoc-python.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E183
trigger_tool:           configure
phase:                  configuration
error_signature:        cat.*<<.*EOF.*Permission denied|cannot create temp file for here-document|heredoc.*failed|config.mak.*only.*3.*lines

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               filesystem|hmdfs|autotools|build-system|python
match_keywords:         heredoc, cat << EOF, Permission denied, HMDFS, Python script, create_config.py
title:                  HMDFS 不支持 heredoc：Python 替代脚本方案（推荐）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HMDFS 分布式文件系统不支持 shell heredoc（cat << EOF）语法，
                        configure 脚本无法创建配置文件。
                        Python 的文件写入操作不受此限制，
                        可作为通用替代方案。
affected_scope:         所有使用 heredoc 创建配置文件的 autotools 项目：
                        x264、ffmpeg、libav、任何 configure + Makefile 项目
verification_cmd:       python3 -c "
                        with open('test.h', 'w') as f:
                            f.write('#define TEST 1\n')
                        "
                        cat test.h
                        # 如果成功写入内容，则 Python 方案可行

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           python-script-replace
rec_description:        创建 Python 脚本（create_config.py）替代 configure，
                        手动生成 config.h、config.mak、x264.pc 等配置文件，
                        使用 Python 文件写入替代 heredoc。
                        此方案通用性强，适用于任何 heredoc 依赖的项目。
rec_command:            python3 create_config.py
                        # 脚本模板见 doc/E109.md
rec_auto_fix:           false
rec_impl:               python-script

# Python 替代脚本模板（完整版见 doc/E109.md）
rec_script_template:    |
                        import os
                        prefix = os.environ.get('DEFAULT_PREFIX', '~/usr/local')
                        
                        # 创建 config.h
                        with open('config.h', 'w') as f:
                            f.write('#define HAVE_MALLOC_H 1\n')
                            f.write('#define HAVE_MMAP 1\n')
                            f.write('#define HAVE_VLA 1\n')
                            # ... 添加必要的宏
                        
                        # 创建 config.mak
                        with open('config.mak', 'w') as f:
                            f.write(f'PREFIX={prefix}\n')
                            f.write('CC=clang\n')
                            f.write('CFLAGS=-O2 -fPIC\n')
                            # ... 添加必要的变量
                        
                        # 创建 .pc 文件（如有）
                        with open('x264.pc', 'w') as f:
                            f.write(f'prefix={prefix}\n')
                            f.write(f'libdir={prefix}/lib\n')
                            f.write('Name: x264\n')
                            f.write('Description: H.264 encoder\n')
                            f.write('Version: 0.165\n')
                            f.write('Libs: -L${libdir} -lx264\n')
                            f.write('Cflags: -I{prefix}/include\n')

fallback_priority:      2
fallback_approach:      manual-makefile-modify
fallback_description:   手动修改 Makefile，见 E108。
fallback_command:       参考 E108
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       cat.*<<.*EOF
forbid_1_reason:        HMDFS 不支持 heredoc 语法
forbid_1_consequence:   configure 失败

forbid_2_pattern:       relying.*on.*configure.*heredoc
forbid_2_reason:        不要依赖 configure 的 heredoc 创建配置文件
forbid_2_consequence:   HMDFS 环境下必定失败

# ═══ Layer 4: 原则引用 ═══
principles:             P-PATCH-001

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E011]  # HMDFS umask 077 权限问题的扩展
similar_to:             [E108]  # 手动修改 Makefile 方案
conflicts_with:         []
prerequisite_of:        []

