# Knowledge graph draft for E2152.

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E430
trigger_tool: curl|github-api|conan
phase: source-acquisition|integrity
error_signature: Downloaded release archive SHA-256 conflicts with a third-party catalog checksum

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category:               security
match_keywords: GitHub Release API, asset digest, sha256, Homebrew checksum, release archive
title: Bind source archives to the current GitHub Release asset digest

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Third-party package indexes are snapshots and can retain a checksum that does not identify the current uploaded release asset.
affected_scope: Conan source recipes using uploaded GitHub Release assets when a third-party package index or catalog reports a conflicting checksum.
verification_cmd: Read the exact tag API, bind asset id name size updated_at URL and digest, then hash the completed local file.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: official-asset-digest-binding
rec_description: Use the current GitHub Releases API asset digest as the integrity authority and require the local file to match it exactly.
rec_command: curl the exact release tag API; select the exact asset name; compare size and sha256 digest
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: copy.*checksum.*Homebrew|trust.*third-party.*sha256
forbid_1_reason: A third-party catalog checksum can be stale or refer to a different asset generation.
forbid_1_consequence: The authentic release archive is rejected or an unrelated file is accepted.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             [E285]
conflicts_with:         []
prerequisite_of:        []

