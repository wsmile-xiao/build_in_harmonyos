#====================================================================
# E052 — HMDFS config.status 临时目录创建失败
# 对应的人类文档: doc/E052.md
#
# 这是 E002（/tmp 只读）的补充情况
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E052
trigger_tool:           configure
phase:                  configuration
error_signature:        config\.status: error creating temporary directory|can't create \./confXXXXXX/subs1\.awk: Permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, limitation
match_keywords:         HMDFS,config.status,临时目录,Permission denied,subs1.awk,tmpdir

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HMDFS 文件系统对 config.status 的临时文件创建有特殊限制，即使使用 mktemp -d 创建的目录也可能失败。这是 E002（/tmp 只读）的补充情况，发生在 configure 生成的 config.status 脚本执行时。
affected_scope:         在 HMDFS 文件系统上运行 configure 的所有 autotools 项目
verification_cmd:        grep -q "tmpdir=" config.status && echo "已找到 tmpdir 配置" || echo "未找到"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           modify_tmpdir
rec_description:        修改 config.status 使用固定临时目录（$HOME/tmp/configure.$$），避开 HMDFS 限制
rec_command:            sed -i 's|tmpdir=.*|tmpdir=$HOME/tmp/configure.$$|g' config.status && mkdir -p $HOME/tmp
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:       workdir_build
fallback_description:   在工作目录（~/builds/）中编译，避免使用 clean-verify 的临时目录
fallback_command:       cd ~/builds && tar xf <tarball> && ./configure --prefix=$DEFAULT_PREFIX
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       /tmp
forbid_1_reason:        /tmp 在 HMDFS 上是只读挂载点（E002）
forbid_1_consequence:   写入失败：Read-only file system

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E052.md
last_updated:           2026-05-28
source_event:           gauche 0.9.15 编译记录


