#====================================================================
# E331-draft-nymphrpc-posix-spawn-path.kv — OHOS 下 python subprocess
#   裸名命令不搜索 PATH（_IS_HARMONYOS 强制 posix_spawn → Errno 2）
#   实例：nymphrpc 0.1.1 CI pre-download 裸名 curl 失败
#====================================================================

# --- frontmatter 检索字段 ---

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E405
trigger_tool:       python|subprocess|curl|sh
phase:              download|integration|testing
error_signature:    FileNotFoundError: [Errno 2] No such file or directory: '<bare-name>'|
                    subprocess.*posix_spawn|_USE_POSIX_SPAWN|_IS_HARMONYOS

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:           2
category:               python, shell, integration, path
match_keywords:     posix_spawn, posix_spawnp, PATH, bare-name, subprocess,
                    FileNotFoundError, Errno 2, _IS_HARMONYOS, curl, shutil.which, shell=True
title:              OHOS 下 python subprocess 裸名命令不搜索 PATH（_IS_HARMONYOS 强制 posix_spawn → Errno 2）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:         HarmonyOS 的 python3 subprocess.py 通过 _IS_HARMONYOS 强制裸名
                    命令也走 os.posix_spawn()，而 posix_spawn 不做 PATH 搜索（非
                    posix_spawnp），裸名可执行文件直接抛 FileNotFoundError Errno 2。
affected_scope:     OHOS 上所有用 subprocess 调用子进程的 CI 脚本/工具链集成
verification_cmd:   python3 -c "import subprocess; subprocess.run(['curl','--version'])"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:       1
rec_approach:       use-absolute-path-or-shell-or-which
rec_description:    裸名命令改用绝对路径、shell=True，或先 shutil.which() 解析；测试兼容沿用 E055 skip-test。
rec_command:        subprocess.run(['/usr/bin/curl','--version']); subprocess.run('curl --version', shell=True); subprocess.run([shutil.which('curl'),'--version'])
rec_auto_fix:       true
rec_impl:           rewrite-command-with-path

fallback_priority:  2
fallback_approach:  skip-test-fallback
fallback_description: 若无法改写调用方命令路径，测试/探针兼容场景沿用 E055 的 skip-test
                    兜底（检测 subprocess._USE_POSIX_SPAWN 后跳过受影响测试），不阻塞整体构建。
fallback_command:   python3 -c "import subprocess; print(subprocess._USE_POSIX_SPAWN)"
fallback_auto_fix:  true
fallback_impl:      skip-test

forbid_1_pattern:   裸名 subprocess.run(["curl", ...]) 等系统命令
forbid_1_reason:    OHOS 上 _IS_HARMONYOS 强制 posix_spawn 分支，不做 PATH 搜索，必然 Errno 2。
forbid_1_consequence: CI 下载/工具链阶段在 OHOS 上静默失效，需降级兜底。
forbid_2_pattern:   无条件 skip 整套 pre-download/下载逻辑
forbid_2_reason:    问题仅出在"裸名命令不搜 PATH"，正确修法是改写命令路径；整体跳过会丢失下载功能本身。
forbid_2_consequence: 下载功能整体失效，且掩盖真实根因，后续新库照抄仍踩坑。

# ═══ Layer 4: 原则引用 ═══
principles:         P013

# ═══ 关系图 (Relations) ═══
causes:
caused_by:          E055
similar_to:         E055
conflicts_with:
prerequisite_of:

