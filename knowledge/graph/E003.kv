#====================================================================
# E003.kv — 找不到 pthread
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E003
title: 找不到 pthread
trigger_tool:           make|ld|clang
phase:                  linking
error_signature:        undefined reference.*pthread_create|
                         undefined reference.*pthread_mutex|
                         undefined reference.*pthread_|
                         ld.*error: undefined reference.*pthread

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               linking
match_keywords:         pthread, undefined reference, -lpthread,
                         -pthread, threading, libpthread,
                         pthread_create, pthread_mutex

# ═══ Layer 2: 诊断层 ═══
root_cause:             链接阶段未指定线程库依赖,
                         鸿蒙 clang 需要显式传递 -pthread 标志
                         (同时影响编译器预定义和链接器搜索)
affected_scope:         使用 POSIX 线程的 C/C++ 项目
verification_cmd:       nm libxxx.a | grep pthread, readelf -d binary | grep NEEDED

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           add-cflags
rec_description:        添加 -pthread 到 CFLAGS (编译+链接双效)
rec_command:            CFLAGS="-pthread $CFLAGS"
rec_auto_fix:          true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      add-ldflags
fallback_description:  仅在链接阶段添加 -lpthread (不如 -pthread 完整)
fallback_command:      LDFLAGS="-lpthread $LDFLAGS"
fallback_auto_fix:      true
fallback_impl:          set-env-var

forbid_1_pattern:

# ═══ Layer 4: 原则引用 ═══
principles:             P-CFLAGS-001

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             [E004, E013]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E003.md
last_updated:           2026-04-09
source_event:
