#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E217.kv，填写各字段
# 对应的人类文档: doc/E217.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E355
trigger_tool: meson|meson.build|host_machine.system|pkg-config|conan
phase: configuration|build|link
error_signature: Unsupported platform|Dependency .* not found|file not found|prefix=/|failed to map segment

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category:               ohos, meson, conan, pkg-config, boost
match_keywords: meson, host_machine.system, harmonyos, ohos, Unsupported platform, pkg-config, prefix=/, -I//include, boost interprocess, boost locale, libboost_locale, boost asio, boost charconv, gtest-main
title: OHOS meson 适配三步法——harmonyos 平台映射 + conan 制品 .pc prefix=/ 修正 + boost 裁剪模块补全（libboost_locale.a 手工编译）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS 上 meson 的 host_machine.system() 返回 harmonyos（非 linux/darwin/windows），meson 子项目（如 luajit）的平台检测报 Unsupported platform，需映射到 linux 分支；conan 制品 .pc 的 prefix=/ 错误导致 -I//include 空前缀需修正；boost 制品裁剪 interprocess/locale/asio/charconv 模块头与 libboost_locale 编译库需从 GitHub 补全+手工编译
affected_scope: 所有 meson 构建且含子项目（luajit 等）的库在 OHOS 适配；所有依赖 conan boost 制品裁剪模块的库；所有依赖 .pc prefix=/ 错误制品的库
verification_cmd: grep -n "host_machine.system" meson.build && grep -n "prefix=" <conan 制品>/lib/pkgconfig/*.pc && test -f <boost 制品>/include/boost/interprocess/streams/bufferstream.hpp && meson setup build --buildtype=release --wrap-mode=nodownload -Dwx_version=3.2.6 && meson compile -C build gtest-main

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: patch-meson-platform
rec_description: OHOS meson 适配三步：①host_machine.system() 返回 harmonyos 时映射 linux 分支（LUAJIT_OS_LINUX + elfasm）解决子项目 Unsupported platform；②修正 conan 制品 .pc 的 prefix=/（freetype/harfbuzz/fontconfig/icu/boost/wx-baseu/fftw3）；③补全 boost 制品裁剪模块头（interprocess/locale/asio/charconv 从 GitHub 下载）+ 手工编译 libboost_locale.a（15 共享源 + ICU/STD 后端，NO_POSIX/NO_WINAPI_BACKEND 避开 glibc 专有 strfmon_l）
rec_command:            grep -n "host_machine.system" <src>/meson.build && 在子项目平台检测处把
                        harmonyos/ohos 并入 linux 分支（如 luajit: if host_machine.system() in
                        ['linux','harmonyos','ohos']）+ 修正 conan 制品 .pc 的 prefix=/ +
                        补全 boost 裁剪模块头并手工编译 libboost_locale.a
rec_auto_fix:           false                       # 引擎能否自动执行（需人工改 meson.build/配方，非自动可修）
rec_impl:               recipe-meson-platform-map    # 内置实现名: 配方内 meson 平台映射 + .pc 修正

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

