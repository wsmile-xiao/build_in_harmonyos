#====================================================================
# E022.kv — POSIX 信号量差异
#====================================================================

id:                     E022
title: POSIX 信号量差异
trigger_tool:           python|ctest|runtime
phase:                  runtime|testing
error_signature:        FileNotFoundError.*sem_unlink|
                         sem_unlink.*No such file.*directory|
                         POSIX.*semaphore.*error

severity:               1
category:               posix|compat
match_keywords:         sem_unlink, POSIX semaphore, /dev/shm,
                         FileNotFoundError, multiprocessing, warning

root_cause:             鸿蒙 POSIX 信号量实现与 Linux 有差异,
                         信号量文件路径可能不同(非 /dev/shm/sem.xxx)
affected_scope:         Python multiprocessing、使用 POSIX 信号量的 C 程序
verification_cmd:       python3 -c "import os; os.unlink('/dev/shm/test')"

rec_priority:           1
rec_approach:           source-patch-try-except
rec_description:        在调用 sem_unlink 处添加 try/except 忽略 FileNotFoundError
rec_command:
rec_auto_fix:          false
rec_impl:               none

forbid_1_pattern:
principles:

causes:                 []
caused_by:              []
similar_to:             [E024]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E022.md
last_updated:           2026-04-09
source_event:           archives/p/python/3.9.0/manifest.yaml

