#====================================================================
# E331.kv — Go 链接器 fallocate 在 OHOS HMDFS 上失败
# 对应的人类文档: doc/E331.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E523
trigger_tool:           ld
phase:                  linking
error_signature:        mapping output file failed: permission denied|fallocate.*EACCES|go tool link.*permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               toolchain
match_keywords:         go build, mapping output file, fallocate, permission denied, link tool, toolexec, GOROOT, go mod
title:                  Go 链接器 fallocate() 在 HMDFS/tmpfs 上返回 EACCES 导致链接失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Go 链接器 (cmd/link) 在写入输出文件时调用 fallocate() 预分配空间。OHOS 的 HMDFS 和 tmpfs 文件系统不支持 fallocate，返回 EACCES (errno=13)。Go 链接器只忽略 ENOTSUP/EPERM，不忽略 EACCES，导致链接失败。
affected_scope:         所有在 OHOS 上使用 Go 工具链编译的 Go 项目（go build/go install/go test 等）
verification_cmd:       echo '#include <fcntl.h>' > /tmp/t.c && echo 'int main(){int fd=open("/tmp/t",O_CREAT|O_RDWR,0644);return fallocate(fd,0,0,4096);}' >> /tmp/t.c && clang /tmp/t.c -o /tmp/t && /tmp/t 2>&1; echo $?

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           toolexec-wrapper
rec_description:        创建 toolexec 包装器脚本，拦截 go build 的链接步骤，将链接器输出重定向到 /dev/shm（支持 fallocate），链接完成后再复制回原路径
rec_command:            go build -toolexec $HOME/tmp/toolexec_wrapper.sh -o <binary> <package>
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:       patch-go-source
fallback_description:   修改 GOROOT/src/cmd/link/internal/ld/outbuf_mmap.go，在 fallocate 错误忽略列表中添加 syscall.EACCES，然后重建链接器
fallback_command:        sed -i 's/errNoFallocate/errNoFallocate \&\& err != syscall.EACCES/' $GOROOT/src/cmd/link/internal/ld/outbuf_mmap.go
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       LD_PRELOAD.*fallocate
forbid_1_reason:        Go 使用 syscall 直接调用 fallocate，不经过 libc，LD_PRELOAD 无法拦截
forbid_1_consequence:   浪费时间调试 LD_PRELOAD 方案，最终无效

# ═══ Layer 4: 原则引用 ═══

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E002]
conflicts_with:         []
prerequisite_of:        []

