#====================================================================
# E082 — musl libc headers in ~/usr/local/include conflict with OHOS SDK sysroot
#====================================================================

id:                     E118
trigger_tool:           clang|cmake|make
phase:                  compilation
error_signature:        no member named 'nullptr_t' in the global namespace|pthread_cond_clockwait|target of using declaration conflicts|unable to find library -lc\+\+

severity:               3
category:               platform-musl-header-conflict
match_keywords:         musl, stddef.h, stdlib.h, pthread.h, sysroot conflict, isystem, nullptr_t
title:                  musl libc headers in ~/usr/local/include conflict with OHOS SDK sysroot when used as -isystem

root_cause:             cmake adds -isystem ~/usr/local/include for dependency headers, which causes musl libc headers (stddef.h, stdlib.h, pthread.h etc.) to shadow compiler built-in headers and OHOS SDK sysroot headers
affected_scope:         any C++ project using cmake with dependencies installed in ~/usr/local on OpenHarmony
verification_cmd:       echo '#include <string>' | clang++ -x c++ -std=c++17 -fno-rtti -isystem ~/usr/local/include - -o /dev/null

rec_priority:           1
rec_approach:           temp-move-musl-headers
rec_description:        Temporarily move conflicting musl headers from ~/usr/local/include/ during compilation, restore after build
rec_command:            mkdir -p ~/tmp/musl_backup && for h in stddef.h stdint.h stdlib.h string.h stdio.h pthread.h time.h unistd.h wchar.h wctype.h ctype.h errno.h fcntl.h signal.h limits.h float.h locale.h setjmp.h math.h stdarg.h stdbool.h; do mv ~/usr/local/include/$h ~/tmp/musl_backup/ 2>/dev/null; done && for d in bits sys netinet net linux arpa; do mv ~/usr/local/include/$d ~/tmp/musl_backup/ 2>/dev/null; done
rec_auto_fix:           false
rec_impl:               manual-edit

causes:                 [E081]
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E082.md
last_updated:           2026-06-23
source_event:           rocksdb 6.4.6 compile

draft: false
contributor_id: EFAD
