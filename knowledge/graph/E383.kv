#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E322.kv，填写各字段
# 对应的人类文档: doc/E322.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E383
trigger_tool: cmake|conan|readelf|clang
phase: build|verification
error_signature: readelf -d.*lib.*\.so.*no SONAME|SONAME.*not found|soname_gate_failed|CMAKE_SHARED_LIBRARY_SONAME.*empty

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category:               platform, detection, cmake, linking, shared-library
match_keywords: SONAME, CMAKE_SHARED_LIBRARY_SONAME_C_FLAG, Platform/HarmonyOS, readelf -d, libyajl.so, no SONAME, soname_gate
title: OHOS shared library missing SONAME due to absent Platform/HarmonyOS.cmake module

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: CMake 4.x ships no Platform/HarmonyOS.cmake module. The Linux platform module (Platform/Linux.cmake) sets CMAKE_SHARED_LIBRARY_SONAME_C_FLAG=-Wl,-soname,, but without a HarmonyOS equivalent this variable is empty. The link template CMAKE_C_CREATE_SHARED_LIBRARY contains <SONAME_FLAG><TARGET_SONAME>; when SONAME_FLAG is empty the soname is not passed to the linker and the resulting .so has no SONAME field in its ELF dynamic section (readelf -d shows no SONAME). The project's SET_TARGET_PROPERTIES(... SOVERSION ...) has no effect on the binary.
affected_scope: All CMake packages building shared libraries (.so) for OHOS/HarmonyOS PC where CMAKE_SYSTEM_NAME resolves to HarmonyOS and no Platform/HarmonyOS.cmake exists. Confirmed with yajl 2.1.0 (libyajl.so).
verification_cmd: readelf -d <lib>.so | grep SONAME; cmake --system-information 2>&1 | grep -i SONAME_FLAG; cmake --system-information 2>&1 | grep _INCLUDED_SYSTEM_INFO_FILE

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: conan-recipe-soname-flag
rec_description: In conanfile.py generate(), set tc.cache_variables['CMAKE_SHARED_LIBRARY_SONAME_C_FLAG']='-Wl,-soname,' and tc.cache_variables['CMAKE_SHARED_LIBRARY_SONAME_CXX_FLAG']='-Wl,-soname,' so CMake passes -Wl,-soname,<TARGET_SONAME> to the linker. The project's SOVERSION property then resolves TARGET_SONAME to libfoo.so.<major>.
rec_command: tc.cache_variables['CMAKE_SHARED_LIBRARY_SONAME_C_FLAG'] = '-Wl,-soname,'; tc.cache_variables['CMAKE_SHARED_LIBRARY_SONAME_CXX_FLAG'] = '-Wl,-soname,'
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: patchelf-post-build
fallback_description: If the toolchain-layer fix is not possible, run patchelf --set-soname libfoo.so.<major> on the .so in package() after cmake.install().
fallback_command: patchelf --set-soname libyajl.so.2 lib/libyajl.so
fallback_auto_fix: false
fallback_impl: conan-recipe

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: CMAKE_SKIP_RPATH|CMAKE_NO_SONAME|NO_SONAME
forbid_1_reason: Disabling SONAME entirely makes downstream DT_NEEDED entries non-relocatable.
forbid_1_consequence: Consumers only work while the exact Conan cache path exists.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P010,P012

# ═══ 关系图 (Relations) ═══
