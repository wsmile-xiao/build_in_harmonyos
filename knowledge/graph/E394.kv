id:                     E394
trigger_tool:           runtime|test|ld.so
phase:                  testing|runtime
error_signature:        PAM_WRAPPER_SERVICE_DIR.*not set|PAM_SERVICE_ERR|pam_start.*failed|run_pamtest.*failed|No such file or directory.*passdb

severity:               2
category:               ld-preload, runtime-init, test-fixture
match_keywords:         LD_PRELOAD, constructor, pre-main, environment snapshot, PAM_WRAPPER_SERVICE_DIR, service file, passdb, exec, test fixture
title:                  LD_PRELOAD 初始化早于 main 时测试环境和夹具必须在 exec 前就绪

root_cause:             动态加载器在进入消费者 main() 前加载 LD_PRELOAD 库并执行其初始化逻辑。若 preload 库在此阶段复制环境变量或打开配置路径，消费者随后在 main() 中 setenv、创建服务文件或生成数据库都已经太晚；库会继续使用启动时捕获的空值或不存在路径。
affected_scope:         通过 LD_PRELOAD 实现插桩、系统 API wrapper、分配器替换或测试隔离，并在 constructor/初始化函数中读取环境变量、配置目录或状态文件的测试和应用。
verification_cmd:       PAM_WRAPPER_SERVICE_DIR=<prepared-dir> PAM_WRAPPER_RUNTIME_DIR=<writable-dir> LD_PRELOAD=<libpam_wrapper.so> <consumer-test>

rec_priority:           1
rec_approach:           parent-prepare-then-exec
rec_description:        由 Conan test()、CTest launcher 或父进程先创建完整配置目录和状态文件，再一次性设置绝对路径环境变量与 LD_PRELOAD 并 exec 子进程；消费者 main() 只执行功能断言，不承担 preload 初始化输入的准备工作。
rec_command:            mkdir -p <service-dir> <runtime-dir> && write-fixtures && PAM_WRAPPER_SERVICE_DIR=<service-dir> PAM_WRAPPER_RUNTIME_DIR=<runtime-dir> LD_PRELOAD=<wrapper.so> <consumer-test>
rec_auto_fix:           false
rec_impl:               test-launcher-pre-exec-setup

fallback_priority:      2
fallback_approach:      self-reexec-after-setup
fallback_description:   若测试必须由同一二进制准备数据，首次启动时不要加载 preload 库；完成夹具后设置环境并 exec 自身进入第二阶段，让动态加载器在新进程启动时读取完整上下文。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       setenv.*PAM_WRAPPER_SERVICE_DIR.*main|create.*service.*after.*main|write.*passdb.*inside.*consumer
forbid_1_reason:        preload 初始化已经发生，后写入的环境和夹具无法改变其启动快照。
forbid_1_consequence:   测试会报告服务不存在、认证初始化失败或读取错误路径，并被误判为 PAM 实现不兼容。
forbid_2_pattern:       relative.*service.*path|depend.*current working directory
forbid_2_reason:        CTest 与 Conan test_package 的工作目录可变，相对路径会让 preload 初始化读取非预期位置。
forbid_2_consequence:   本地偶发通过、CI 或真机失败，证据不可复现。

principles:
causes:                 []
caused_by:              []
similar_to:             E200
conflicts_with:         []
prerequisite_of:        []

