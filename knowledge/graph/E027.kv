#====================================================================
# E027.kv — libintl_gettext 链接失败
#====================================================================

id:                     E027
title: libintl_gettext 链接失败
trigger_tool:           ld|clang|configure|make
phase:                  linking|configuration
error_signature:        undefined symbol.*libintl_gettext|
                         undefined symbol.*libintl_bindtextdomain|
                         libintl.*not found|-lintl.*undefined

severity:               2
category:               linking|nls
match_keywords:         libintl, gettext, NLS, -lintl,
                         native language support, --disable-nls,
                         bindtextdomain, textdomain, internationalization

root_cause:             GNU 软件默认启用 NLS(Native Language Support)国际化,
                         依赖 libintl(gettext 库), 鸿蒙系统未预装该库
affected_scope:         gdbm, tar, coreutils 等 GNU 工具链项目
verification_cmd:       grep -r "LIBINTL\|libintl\|nls" Makefile.am configure.ac

rec_priority:           1
rec_approach:           configure-disable-feature
rec_description:        通过 ./configure --disable-nls 禁用国际化支持(推荐)
rec_command:            ./configure --disable-nls
rec_auto_fix:          true
rec_impl:               reconfigure

forbid_1_pattern:
principles:

causes:                 []
caused_by:              []
similar_to:             [E013]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E027.md
last_updated:           2026-04-09
source_event:           archives/g/gdbm/1.23/manifest.yaml, archives/t/tar/1.35/manifest.yaml
