id: E142
trigger_tool:           ld|runtime
phase:                  runtime
error_signature:        g_libintl_dgettext: symbol not found|
                         Error relocating.*g_libintl_dgettext|
                         undefined reference.*g_libintl_dgettext

severity:               3
category:               platform-runtime
match_keywords:         g_libintl_dgettext, libintl_glib, gettext,
                         NLS, gnulib, dgettext, ENABLE_NLS

root_cause:             libbytesize.so 编译时启用 NLS（-DENABLE_NLS），gnulib gettext 重命名规则将标准 dgettext 重命名为 g_libintl_dgettext。该符号不在标准 libintl.so.8 中，而是在 libintl_glib.so（GLib 的 gettext 包装器）中提供
affected_scope:         所有启用 NLS 且使用 gnulib gettext 重命名的软件（libbytesize, libbd_utils, libostree 等）
verification_cmd:       nm -D /path/to/libintl_glib.so | grep g_libintl_dgettext

rec_priority:           1
rec_approach:           link-libintl_glib
rec_description:        运行使用 libbytesize.so 的程序时，必须链接 libintl_glib.so（-lintl_glib）以满足 g_libintl_dgettext 符号依赖
rec_command:            clang ... -lbytesize -lintl_glib -lintl -lgmp -lmpfr
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      LD_PRELOAD
fallback_description:   使用 LD_PRELOAD=libintl_glib.so 运行时注入符号（临时方案）
fallback_command:       LD_PRELOAD=$PREFIX/lib/libintl_glib.so ./program
fallback_auto_fix:      false

forbid_1_pattern:       -lintl.*without.*-lintl_glib
forbid_1_reason:        仅链接 -lintl 不能提供 g_libintl_dgettext 符号
forbid_1_consequence:   运行时 symbol not found 导致程序崩溃

principles:              

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E142.md
last_updated: 2026-06-02
source_event:           libbytesize-2.11-functional-test


