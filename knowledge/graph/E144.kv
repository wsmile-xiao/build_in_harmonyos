#====================================================================
# E090 — cmake模块丢失导致configure失败
# 对应的人类文档: doc/E090.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E144
trigger_tool:           cmake
phase:                  configuration
error_signature:        Could not find.*BuildVersion\.cmake|include.*BuildVersion.*could not be loaded|CMake Error.*include\(BuildVersion\)

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               cmake-modules-missing
match_keywords:         cmake module missing, BuildVersion.cmake, ParseVersion.cmake, MongoPlatform.cmake, MongoSettings.cmake, mongo-c-driver, libbson, .work re-initialization
title:                  ohc-run.py build重初始化.work目录导致cmake模块丢失

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             ohc-run.py build管线重新初始化.work目录时清空build/cmake子目录，导致后续cmake配置无法找到必要的cmake模块文件
affected_scope:         mongo-c-driver/libbson及所有使用嵌套build/cmake目录结构的项目
verification_cmd:       ls $BUILD_SRC_DIR/build/cmake/BuildVersion.cmake

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           manual-build-mode-b
rec_description:        使用模式B（手动cmake/make）编译，避免build管线重初始化.work目录；若.work已被重初始化，从.orig复制build/cmake/目录恢复cmake模块
rec_command:            cp -r $BUILD_SRC_ORIG_DIR/build/cmake $BUILD_SRC_DIR/build/cmake && cd $BUILD_SRC_DIR && cmake -DCMAKE_INSTALL_PREFIX=$DEFAULT_PREFIX -DCMAKE_SYSTEM_NAME=Linux <其他选项> .
rec_auto_fix:           false
rec_impl:               manual-copy-and-build

fallback_priority:      2
fallback_approach:      savannah-tarball
fallback_description:   使用Savannah官方发布tarball而非GitHub archive，因为Savannah tarball包含生成的cmake模块
fallback_command:       ohc-run.py init-build <软件> <版本> --url=https://download.savannah.nongnu.org/releases/libbson/libbson-<版本>.tar.gz
fallback_auto_fix:      false
fallback_impl:          init-build-with-url

# ★ 禁止策略 ★
forbid_1_pattern:       ohc-run.py build.*libbson|ohc-run.py build.*mongo-c-driver
forbid_1_reason:         build管线会重初始化.work目录导致cmake模块丢失
forbid_1_consequence:    cmake配置失败，无法找到BuildVersion等必需模块

# ═══ Layer 4: 原则引用 ═══
principles:              R14,R15,R20

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E090.md
last_updated:           2026-06-01
source_event:           libbson-1.27.1-cmake-modules-missing

draft: false
contributor_id:         C020