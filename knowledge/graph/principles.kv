#====================================================================
# principles.kv — 知识图谱 Layer 4: 原则库
#
# 定义跨错误模式的通用约束规则。
# match_error_pattern v3 在输出修复方案前，用这些原则做过滤。
#
# level: critical=自动拒绝 | high=警告+记录 | medium=仅记录
# forbid_N_auto_reject: true=引擎自动拒绝含此pattern的方案
#====================================================================

# ═══ P-AUTOTOOLS-001 ═══
id:                     P-AUTOTOOLS-001
name:                   禁止 --build/--host 绕过系统检测
level:                  critical
scope:                   E007, E064
statement:              鸿蒙是原生编译环境(aarch64)，不是交叉编译。
                         使用 --build/--host 绕过 config.guess 会导致:
                         cross_compiling=yes → AC_RUN_IFELSE 跳过 → config.h 错误
forbid_1_pattern:       --build=.*linux-|--host=.*linux-
forbid_1_auto_reject:   true
forbid_1_suggest:       使用 download-gnuconfig 或 patch-autotools-ohos.pl
forbid_2_pattern:       --build=.*gnu|--host=.*gnu
forbid_2_auto_reject:   true
forbid_2_suggest:       同上

# ═══ P-AUTOTOOLS-002 ═══
id:                     P-AUTOTOOLS-002
name:                   conftest 必须能正常执行
level:                  critical
scope:                   E064, E061, E062, E063, E065
statement:              configure 通过编译+执行 conftest 检测平台能力。
                         鸿蒙上首次执行二进制需安全弹窗确认。
                         弹窗超时 → configure 误判交叉编译 → 级联错误。
forbid_1_pattern:       cross.compiling=yes
forbid_1_auto_reject:   false
forbid_1_suggest:       先手动触发安全弹窗，再用 ac_cv_* 缓存变量

# ═══ P-PATCH-001 ═══
id:                     P-PATCH-001
name:                   修改生成文件必须保存为 .patch
level:                  high
scope:                   E058, E059, E007, E008, E063
statement:              configure/Makefile/config.h 是 autotools 生成文件。
                         sed 修改后必须存为 .patch，否则 distclean 后丢失。
forbid_1_pattern:       sed -i.*(configure|Makefile|config\.h)
forbid_1_auto_reject:   false
forbid_1_suggest:       确认 patches/ 目录有对应 .patch 文件

# ═══ P-PATCH-002 ═══
id:                     P-PATCH-002
name:                   __OHOS__ 守卫是平台隔离标准写法
level:                  high
scope:                   E008, E011, E051, E060, E004, E020
statement:              #ifdef __OHOS__ 是 clang 自动定义的宏，精确唯一。
                         禁止 #ifndef __linux__(排除BSD/macOS)和硬编码路径。
forbid_1_pattern:       #ifndef\s*__linux__
forbid_1_auto_reject:   true
forbid_1_suggest:       改为 #ifdef __OHOS__

# ═══ P-PATCH-003 ═══
id:                     P-PATCH-003
name:                   补丁必须可向上游提交
level:                  medium
scope:                   E058, E059, E060, E008, E039
statement:              遵循上游编码风格。英文注释(HarmonyOS: reason格式)。
                         不引入鸿蒙特有SDK/API依赖(除非绝对必要)。

# ═══ P-CFLAGS-001 ═══
id:                     P-CFLAGS-001
name:                   CFLAGS hack 必须记录为技术债务
level:                  medium
scope:                   E005, E011, E032, E033, E063
statement:              CFLAGS/CPPFLAGS/LDFLAGS 强制绕过编译错误时，
                         必须在 PROGRESS.md 记录技术债务及期望的上游修复方式。

# ═══ P-RUNTIME-001 ═══
id:                     P-RUNTIME-001
name:                   未实现 syscall 必须调用前拦截
level:                  critical
scope:                   E051
statement:              setreuid/setregid 的 SIGSYS 不可被 handler 捕获,
                         进程直接终止(exit 159)。信号处理方案完全不可行。
                         必须用 #ifdef __OHOS__ 在调用前 return ENOSYS。
forbid_1_pattern:       signal\(SIGSYS
forbid_1_auto_reject:   true
forbid_1_suggest:       用 #ifdef __OHOS__ 在调用前 return ENOSYS

# ═══ P-RUNTIME-002 ═══
id:                     P-RUNTIME-002
name:                   RPATH 必须覆盖所有 NEEDED 库
level:                  high
scope:                   E042, E019, E052
statement:              可移植包 RPATH 必须: 主程序→共享库→扩展模块,
                         任何一层遗漏都会在目标机出现 ImportError。

# ═══ P-TOOLCHAIN-001 ═══
id:                     P-TOOLCHAIN-001
name:                   必须使用 LLVM 工具链
level:                  high
scope:                   E012, E053
statement:              鸿蒙 SDK 只有 LLVM/Clang。ar/ranlib/nm/strip 用 llvm-* 版本。
                         C++ 编译器是 clang++ (无 cc1plus)。
forbid_1_pattern:       \bar\b(?!llvm-ar)
forbid_1_auto_reject:   false
forbid_1_suggest:       export AR=llvm-ar RANLIB=llvm-ranlib NM=llvm-nm

# ═══ P-PATCH-004 ═══
id:                     P-PATCH-004
name:                   补丁文件必须包含完整元数据 header
level:                  high
scope:                   E058, E059, E060, E007, E008, E039, E063
statement:              每个补丁必须含 Source-Commit(被改文件的原始commit)、
                         Modification-Layer(修改层级①②③)、Knowledge-Ref(关联知识)。
                         缺失则无法追溯来源和复现补丁。
forbid_1_pattern:       (diff|patch).*无Source-Commit|From:.*\n(?!(Description|Origin|Upstream|Source-Commit))
forbid_1_auto_reject:   false
forbid_1_suggest:       补丁 header 必须包含: Description/Origin/Upstream/Source-Commit/Modification-Layer/Knowledge-Ref

# ═══ P-LINKAGE-001 ═══
id:                     P-LINKAGE-001
name:                   静态库优先原则（系统库冲突防护）
level:                  high
scope:                   E042, E019, E052, E067
statement:              鸿蒙系统关键组件(/bin/zsh 等)依赖系统共享库。
                         用户编译的同名共享库会覆盖系统库→系统不稳定。
                         判断标准: ldd /bin/xxx | grep <库名> → 有输出则必须用 --without-shared。
forbid_1_pattern:       --with-shared(?!.*无系统依赖确认)
forbid_1_auto_reject:   false
forbid_1_suggest:       先检查系统是否已有同名库: ldd /bin/* | grep <库名>；有则用 --without-shared 编译静态库

# ═══ P-BUILD-001 ═══
id:                     P-BUILD-001
name:                   平台限制必须降级而非绕过
level:                  high
scope:                   E074, E046, E048, E055, E057
statement:              鸿蒙平台限制(FIFO/SELinux/HMDFS)是系统级行为差异，
                         不因重试而改变。遇到此类限制必须降级到可用方案(如单线程/skip-test/wrapper)，
                         禁止反复重试或忽略错误继续执行。
forbid_1_pattern:       反复重试.*make -j|忽略.*Permission denied.*继续|skipIf.*False
forbid_1_auto_reject:   true
forbid_1_suggest:       识别限制类型后选择对应降级方案

# ═══ P-ENV-001 ═══
id:                     P-ENV-001
name:                   环境变量与构建系统语义冲突陷阱
level:                  medium
scope:                   E075, E002, E074
statement:              某些环境变量(C_INCLUDE_PATH/LD_LIBRARY_PATH等)与pkg-config/make等
                         构建工具存在语义冲突。设置这些变量可能反而导致问题。
                         应优先使用构建系统原生机制(PKG_CONFIG_PATH/RPATH/Makefile变量)。
forbid_1_pattern:       同时设置 C_INCLUDE_PATH 和 PKG_CONFIG_PATH
forbid_1_auto_reject:   false
forbid_1_suggest:       unset C_*_INCLUDE_PATH / LIBRARY_PATH，仅用 PKG_CONFIG_PATH

# ═══ P-SYSCALL-001 ═══
id:                     P-SYSCALL-001
name:                   内核 syscall 行为差异必须源码适配
level:                  high
scope:                   E076, E008, E051, E022, E025
statement:              鸿蒙内核对部分 syscall(fstat/lseek/setreuid/sigaction等)的返回值
                         与 Linux glibc 不同。这类差异无法通过环境变量或编译参数绕过，
                         必须在源码中用 #ifdef __OHOS__ 守卫做兼容处理。
forbid_1_pattern:       忽略.*EACCES.*继续执行|suppress.*syscall.*error
forbid_1_auto_reject:   true
forbid_1_suggest:       用 #ifdef __OHOS__ 在调用处做兼容处理

# ═══ P-HMDFS-001 ═══
id:                     P-HMDFS-001
name:                   HMDFS 文件系统限制必须用替代方案
level:                  critical
scope:                   E050, E073, E079, E080, E018
statement:              HMDFS(HarmonyOS 分布式文件系统)不支持符号链接和硬链接创建。
                         所有 ln -s / ln / symlink() 调用都会失败。
                         必须用 cp 复制、wrapper 脚本、makedirs 或 monkey-patch 替代。
forbid_1_pattern:       ln -s.*HMDFS|symlink.*force|os\.symlink.*ignore.*OSError
forbid_1_auto_reject:   true
forbid_1_suggest:       cp 复制替代软链接；wrapper 脚本替代 bin 软链接；try/except OSError
