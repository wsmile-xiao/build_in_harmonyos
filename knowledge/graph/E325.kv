#====================================================================
# E255-draft-OSTR.kv — Conan test_package 在 OHOS 上应先解析可用 shell 再跑脚本
#====================================================================

id:                     E325
trigger_tool:           conan_test|python|shell
phase:                  testing
error_signature:        sh: bash: inaccessible or not found|Read-only file system|mktemp:.*Read-only file system
severity:               2
category:               portability, testing, shell, tmpdir
match_keywords:         CONFIG_SHELL, bash, /data/service/hnp/bin/bash, TMPDIR,
                        test_package, shutil.which, sh, mktemp, /tmp, ostra
title:                  Conan test_package 在 OHOS 上应先解析可用 shell 再跑脚本

root_cause:             目标机的 OHOS shell 环境可能没有把 bash 放进默认 PATH，
                        而 test_package 若直接执行 `bash test.sh` 就会在真正验证前
                        失败；同时 `mktemp` 默认落到 `/tmp`，在只读环境里也会失败。
affected_scope:         所有依赖 shell 脚本的 Conan test_package 包装器，以及需要
                        在 OHOS 上复用 bash 的安装后验证流程。
verification_cmd:       通过 `CONFIG_SHELL`、PATH bash 和 HNP bash 逐级回退后执行
                        test.sh，并确认临时文件落在可写目录。

rec_priority:           1
rec_approach:           shell-discovery-and-writable-tmpdir
rec_description:        先尊重 `CONFIG_SHELL`，再尝试 PATH 中的 bash，最后回退到
                        `/data/service/hnp/bin/bash`；临时文件统一放到 `$HOME/tmp`
                        或 `TMPDIR`，不要依赖 `/tmp` 默认值。
rec_command:            TMPDIR=$HOME/tmp CONFIG_SHELL=/data/service/hnp/bin/bash /data/service/hnp/bin/bash test.sh
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      plain-sh-and-home-tmp
fallback_description:   如果 bash 仍不可用，就退回到 POSIX `sh`，并把所有临时文件
                        约束到可写的 home 目录。
fallback_auto_fix:      false

principles:

causes:                 []
caused_by:              []
similar_to:             [E002, E165, E221]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E255.md
last_updated:           2026-08-29
source_event:           ostra 0.000709606481481482 HarmonyOS adaptation

