#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E112.kv，填写各字段
# 对应的人类文档: doc/E112.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E190
trigger_tool:           make|clang|ld
phase:                  compilation|linking
error_signature: errno.h.*file not found|sys/types.h.*file not found|crti.o.*No such file|crtbeginS.o.*No such file|libunwind.a.*No such file

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               perl_xs|build-parameters|musl
match_keywords: Perl XS,Makefile.PL,CCFLAGS,LDDLFLAGS,nostdlib,errno.h,crti.o
title: Perl XS 模块需要显式指定编译参数和链接参数

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Perl XS 模块使用 Makefile.PL 而非 configure，默认参数不包含 HarmonyOS 系统所需路径。
            Perl 编译时使用的 clang 版本可能与当前版本不匹配，导致系统头文件路径未包含。
            ld.lld 默认搜索路径不含本地 lib 目录，且可能链接 libunwind.a（musl 系统中不存在）。
affected_scope: 所有 Perl XS 模块（使用 Makefile.PL 构建的 Perl 扩展）
verification_cmd: |
  # 检查是否是 Perl XS 模块
  ls Makefile.PL 2>/dev/null && echo "Perl XS 模块"
  # 检查 Perl 配置
  perl -V:useshrplib  # 静态链接=false, 动态链接=true

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           perl-xs-build-params
rec_description:        在 Makefile.PL 调用时显式添加 CCFLAGS 和 LDDLFLAGS 参数
rec_command:            |
  # 生成 Makefile
  perl Makefile.PL PREFIX=$DEFAULT_PREFIX \
    CCFLAGS="-D_GNU_SOURCE -fno-strict-aliasing -pipe -fstack-protector-strong -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -I$DEFAULT_PREFIX/include" \
    LDFLAGS="-L$DEFAULT_PREFIX/lib"

  # 编译（关键：使用 -nostdlib 绕过 libunwind）
  make LDDLFLAGS="-shared -nostdlib -B$DEFAULT_PREFIX/lib -L$DEFAULT_PREFIX/lib -lc"
rec_auto_fix:           false
rec_impl:               manual-build-params

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      hints-file
fallback_description:   创建 hints/harmonyos.sh 文件固化编译参数
fallback_command:       |
  mkdir -p archives/{letter}/{name}/{ver}/hints
  cat > archives/{letter}/{name}/{ver}/hints/harmonyos.sh << 'EOF'
  #!/bin/bash
  export CCFLAGS="-D_GNU_SOURCE -I$DEFAULT_PREFIX/include"
  export LDFLAGS="-L$DEFAULT_PREFIX/lib"
  export LDDLFLAGS="-shared -nostdlib -B$DEFAULT_PREFIX/lib -lc"
  EOF
fallback_auto_fix:      false
fallback_impl:          hints-file-creation

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       LDDLFLAGS.*-lperl.*useshrplib=false
forbid_1_reason:        当 Perl 是静态链接(useshrplib=false)时，添加 -lperl 会导致链接失败
forbid_1_consequence:   找不到 libperl.so，链接报错

# ═══ Layer 4: 原则引用 ═══
principles:             P-PATH-001,P-LINKAGE-001

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E078]  # musl BIND_NOW 问题，但本条目针对 Perl XS 构建参数
conflicts_with:         []
prerequisite_of:        []

