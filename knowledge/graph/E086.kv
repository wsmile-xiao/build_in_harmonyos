#====================================================================
# E086.kv — struct ucred 在 musl/OpenHarmony 上不可用
#====================================================================

id:                     E086
title: struct ucred 在 musl/OpenHarmony 上不可用
trigger_tool:           clang|gcc|make
phase:                  compilation
error_signature:        struct ucred.*incomplete|
                         storage size of.*ucred.*isn't known|
                         invalid use of incomplete type.*ucred|
                         ucred.*undeclared|
                         SOCKCREDSIZE

severity:               2
category:               libc-compat|musl|socket
match_keywords:         struct ucred, SO_PEERCRED,
                         SCM_CREDENTIALS, assuan-socket,
                         peer credentials, local socket cred,
                         socket server, __OHOS__

root_cause:             OpenHarmony 的 musl libc 不定义 `struct ucred`
                         （定义在 Linux glibc 的 <sys/socket.h> 中）。
                         部分软件（如 libassuan）使用 `struct ucred`
                         获取 Unix socket 对端凭证（SO_PEERCRED）。
                         musl 下需条件编译或内联定义 struct ucred。
affected_scope:         libassuan, 以及所有使用 SO_PEERCRED 的软件
verification_cmd:       echo '#include <sys/socket.h>' | clang -E - 2>&1 | grep ucred;
                         grep -rn "struct ucred" src/ 2>/dev/null | head -3

rec_priority:           1
rec_approach:           ohos-guard-ucred
rec_description:        使用 `#ifdef __OHOS__` 守卫，在 __OHOS__ 下内联定义
                         struct ucred（pid_t, uid_t, gid_t 三个字段），
                         或使用 #ifdef 封装 SO_PEERCRED 相关代码块
rec_command:            sed -i '/struct ucred/i #ifdef __OHOS__\nstruct ucred { pid_t pid; uid_t uid; gid_t gid; };\n#endif' src/socket-server.c
rec_auto_fix:           true
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      disable-peer-cred
fallback_description:   使用 --disable-local-socket 或类似选项禁用 peer credential 功能
fallback_command:       ./configure --prefix=$DEFAULT_PREFIX --disable-local-socket
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:             P-PATCH-001

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E086.md
last_updated:           2026-04-21
source_event:           archives/l/libassuan/3.0.2
