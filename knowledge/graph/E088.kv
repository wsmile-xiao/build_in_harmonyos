#====================================================================
# E088.kv — HarmonyOS musl namespace 忽略 RUNPATH/LD_LIBRARY_PATH
#====================================================================

id:                     E088
trigger_tool:           python|ld|pip|install|runtime
phase:                  runtime|installation
error_signature:        ImportError.*Error loading shared library|
                         dlopen.*cannot open shared object.*libffi|
                         cannot open shared object.*lib-dynload

severity:               2
category:               linking, runtime
match_keywords:         RUNPATH, RPATH, LD_LIBRARY_PATH, namespace,
                         ld-musl-namespace, lib-dynload, ImportError,
                         shared library, patchelf, $ORIGIN

root_cause:             HarmonyOS musl 动态链接器使用 namespace 配置
                         (/etc/ld-musl-namespace-arm.ini)，完全忽略 ELF
                         RUNPATH/RPATH 和 LD_LIBRARY_PATH 环境变量。
                         只有 namespace 配置的 lib.paths 中的库才能被加载。
                         用户安装的库在 /storage/Users/currentUser/usr/local/lib/，
                         不在任何 namespace 路径中。
affected_scope:         所有使用外部共享库的软件（特别是 Python lib-dynload 模块、
                         以及依赖 libffi/openssl/readline 等的程序）
verification_cmd:       cat /etc/ld-musl-namespace-arm.ini 2>/dev/null | head -20;
                         python3 -c "import _ctypes" 2>&1;
                         readelf -d lib-dynload/_ctypes*.so | grep -E 'RPATH|RUNPATH|NEEDED'

rec_priority:           1
rec_approach:           copy-libs-to-dynload-dir
rec_description:        将外部依赖库拷贝到目标模块同目录下（$ORIGIN 是唯一可靠路径），
                         然后签名。不依赖 RUNPATH/RPATH 和 LD_LIBRARY_PATH。
rec_command:            cp -L /path/to/usr/local/lib/libffi.so.8 $PREFIX/lib/python3.12/lib-dynload/ &&
                         python3 ohc-run.py sign-elf --batch $PREFIX/lib/python3.12/lib-dynload/
rec_auto_fix:           true
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      set-namespace-path
fallback_description:   修改 /etc/ld-musl-namespace-arm.ini 添加用户库路径到 namespace
                         （需要 root 权限，不推荐）
fallback_command:       sed -i 's|lib.paths = /usr/local/lib|lib.paths = /usr/local/lib:/storage/Users/currentUser/usr/local/lib|' /etc/ld-musl-namespace-arm.ini
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       patchelf.*--set-rpath|patchelf.*--set-interpreter
forbid_1_reason:         禁止用 patchelf 修改 RPATH/RUNPATH 来解决此问题。
                         HarmonyOS musl ldso 完全忽略这些字段，
                         修改它们不会产生效果反而破坏 ELF 签名
forbid_1_consequence:   ELF 签名失效导致加载被拒，需重新签名，
                         浪费时间且问题未解决

principles:               

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E088.md
last_updated:           2026-04-21
source_event:           archives/p/python3/3.12.9

