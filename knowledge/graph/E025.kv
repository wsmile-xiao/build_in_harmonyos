#====================================================================
# E025.kv — CAN socket 宏未定义
#====================================================================

id:                     E025
title: CAN socket 宏未定义
trigger_tool:           cc|clang|configure|python
phase:                  compilation|configuration
error_signature:        undeclared.*CAN_RAW_FD_FRAMES|
                         undeclared.*CAN_RAW_JOIN_FILTERS|
                         CAN.*socket.*macro.*undefined

severity:               1
category:               kernel|headers
match_keywords:         CAN socket, CAN_RAW_FD_FRAMES, CAN_RAW_JOIN_FILTERS,
                         undeclared, pyconfig.h, HAVE_LINUX_CAN,
                         kernel header, configure detection mismatch

root_cause:             configure 检测阶段认为宏存在(通过简单预编译测试),
                         但实际编译时鸿蒙内核头文件中未定义该宏,
                         导致 pyconfig.h 中错误地 #define 了 HAVE_XXX
affected_scope:         Python 等使用 autoconf 检测内核特性的项目
verification_cmd:       grep "HAVE_LINUX_CAN" pyconfig.h; echo '#include <linux/can/raw.h>' | clang -E -

rec_priority:           1
rec_approach:           fix-configure-detection
rec_description:        修正 configure 检测逻辑或在代码中使用正确的条件编译守卫,
                         而非事后 sed 修改 config.h
rec_command:
rec_auto_fix:          false
rec_impl:               none

forbid_1_pattern:
principles:

causes:                 []
caused_by:              []
similar_to:             [E033]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E025.md
last_updated:           2026-04-09
source_event:           archives/p/python/3.9.0/manifest.yaml
