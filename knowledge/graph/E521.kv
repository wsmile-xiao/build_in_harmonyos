#====================================================================
# E324.kv — libtoolize hardcoded SED path breaks aux-dir resolution
# 对应的人类文档: doc/E324.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E521
trigger_tool:           autoreconf|libtoolize|automake
phase:                  configuration
error_signature:        required file \x27\./ltmain\.sh\x27 not found|libtoolize: putting auxiliary files in \x27\.\./\.\.\x27|usr/local/bin/sed: No such file

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, autotools
match_keywords:         libtoolize, SED, ltmain.sh, hardcoded path, autoreconf, automake, auxdir, autoconf
title:                  libtoolize hardcoded SED path breaks aux-dir resolution (ltmain.sh placed in parent dir)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Installed libtoolize/automake hardcode /storage/Users/currentUser/usr/local/bin/sed which does not exist on the minimal OHOS image.  When SED is unset, libtoolize's extract-trace / aux-dir heuristic fails and it walks UP the tree, placing auxiliary files (ltmain.sh) into a parent directory; automake then aborts with "required file ./ltmain.sh not found".
affected_scope:         Any autotools project bootstrapped via autoreconf -fi on a minimal OHOS image
verification_cmd:       ls -la ltmain.sh

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           export-env-tools
rec_description:        Set SED/AUTOCONF/AUTOHEADER/AUTOM4TE to the real tool paths (command -v) before autoreconf -fi so libtoolize resolves the aux dir to "." and copies ltmain.sh into the source root.  conanfile.py implements this in _prepare_autotools_env().
rec_command:            export SED=$(command -v sed) AUTOCONF=$(command -v autoconf) AUTOHEADER=$(command -v autoheader) AUTOM4TE=$(command -v autom4te); autoreconf -fi
rec_auto_fix:           true
rec_impl:               manual

fallback_priority:      2
fallback_approach:      manual-copy-ltmain
fallback_description:   Manually copy the libtool build-aux ltmain.sh into the source root before autoreconf.
fallback_command:       cp /storage/Users/currentUser/usr/local/share/libtool/build-aux/ltmain.sh . && autoreconf -fi
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       SED=
forbid_1_reason:        Leaving SED unset lets libtoolize fall back to its hardcoded broken path and walk up the tree.
forbid_1_consequence:   ltmain.sh placed in a parent dir; automake fails "required file ./ltmain.sh not found".

principles:             P002,P008

causes:                 []
caused_by:              []
similar_to:             E209
conflicts_with:         []
prerequisite_of:        []

