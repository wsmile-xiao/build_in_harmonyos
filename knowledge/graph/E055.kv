#====================================================================
# E055.kv — posix_spawn 与 fork+exec 行为差异（Python 3.12+）
#====================================================================

id:                     E055
trigger_tool:           python|testing|runtime
phase:                  runtime|testing
error_signature:        test__use_vfork.*AssertionError|test_exception_errpipe_normal.*FileNotFoundError|
                         test_restore_signals.*FileNotFoundError|posix_spawn.*errpipe|

severity:               1
category:               python|subprocess|compat|testing
match_keywords:         posix_spawn, fork+exec, _USE_POSIX_SPAWN, vfork,
                         errpipe, subprocess, shell builtin, Python 3.12, musl,

root_cause:             Python 3.12 subprocess.py 在 musl/HarmonyOS 上 _USE_POSIX_SPAWN=True,
                         所有子进程通过 os.posix_spawn() 启动而非 fork()+exec():
                         errpipe 机制失效(父进程直接报错)、shell 内建命令不可直接 exec
affected_scope:         Python 3.12+ 测试套件中涉及 subprocess 的测试
verification_cmd:       python3 -c "import subprocess; print(subprocess._USE_POSIX_SPAWN)"

rec_priority:           1
rec_approach:           skip-test
rec_description:        运行时检测 subprocess._USE_POSIX_SPAWN 并 skip 受影响测试
rec_command:
rec_auto_fix:          true
rec_impl:               skip-test

forbid_1_pattern:
principles:              P013
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E055.md
last_updated:           2026-04-10
source_event:           archives/p/python/3.9.0/manifest.yaml

