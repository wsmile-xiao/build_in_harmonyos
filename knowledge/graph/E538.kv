#====================================================================
# DRAFT-pangomm-2.50.1-cxx17-libcxx-conan-profile - 统一 C++17/libc++ profile 下 ohpcd 发布依赖图选项一致性修复（r12 补正）
#====================================================================

id:                     E538
trigger_tool:           conan|meson|ninja|clang|pkg-config
phase:                  configuration|dependency-resolve|build|package|test
error_signature:        Missing binary: harfbuzz|Options conflicts|No compatible configuration found|package 'pangocairo' has no Version|has no Description|gmmprocdir|glibmm_generate_extra_defs-2.68 not found|binary-sign-tool.*-a|pangomm.h.*not found|symbol not found

severity:               2
category:               ohos, toolchain, conan, dependency-graph, meson-pkgconfig
match_keywords:         pangomm, harfbuzz, glib, glibmm, cairomm, pango, cppstd=17, libc++, profile, shared, options conflict, package ID, pangocairo.pc, gmmprocdir, extra_defs, binary-sign-tool, musl
title:                  统一 C++17/libc++ profile 后 ohpcd 发布依赖图选项不一致的解决与 pangomm 本地闭环修复链

root_cause: >
  r11 时 ohpcd 发布的 harfbuzz/14.2.0.1 binary 仅基于 glib:shared=False（静态）
  构建，而 glibmm/cairomm/pango 发布 binary 基于 shared=True，pangomm 全图
  glib=shared=True 时 harfbuzz 计算包 ID 无发布 binary，源码构建超过 300s 前台时限。
  r12 中 ohpcd 发布修复版 harfbuzz/14.2.0.1#58fa487c（2026-08-23），binary
  1b5bfb 改为 requires glib/2.84.Z（动态，不锁 revision），全图解析成功。
  但 pangomm 自身闭环又暴露 meson/PkgConfigDeps/签名/运行时的多环节适配点。

affected_scope: >
  OHOS armv8 clang15 C++17/libc++ profile 下消费 glibmm/cairomm/pango/harfbuzz
  依赖链的 Meson 项目；依赖 ohpcd 发布一致性的 Conan 图；OHOS musl 运行时。

verification_cmd: >
  conan list 'harfbuzz/14.2.0.1:*' -r ohpcd;
  conan create archives/p/pangomm/2.50.1 --profile:host=pangomm-cxx17 --build=missing

rec_priority:           1
rec_approach:           published-binary-wait-plus-meson-pkgconfig-fixes
rec_description: >
  发布侧：等待 ohpcd 发布与 shared glib 匹配的 harfbuzz binary（r12 已修复）。
  消费侧 recipe 需要四类修复：
  (1) alias-pc：PkgConfigDeps 只生成 pango.pc，需为 pangocairo/pangoft2 手写
      转发 .pc 且带 Name/Description/Version（pkg-config 0.29.2 校验）；
  (2) pc-var：PkgConfigDeps 不写 gmmprocdir，需补进 glibmm-2.68.pc；
  (3) link-args：meson find_library(glibmm_generate_extra_defs-2.68) 需
      -L glibmm libdir（经 conf tools.build:sharedlinkflags/exelinkflags 注入）；
  (4) sign：binary-sign-tool 正确语法 sign -selfSign 1 -inFile X -outFile Y，
      -a 非法；package_info 需声明 include/pangomm-2.48 与 lib/.../include。
rec_command: >
  conan create archives/p/pangomm/2.50.1 --profile:host=pangomm-cxx17 --build=missing
rec_auto_fix:           false
rec_impl:               conan-recipe-composite

fallback_priority:      2
fallback_approach:      runtime-skip-musl-loader-block
fallback_description: >
  test_package 运行时若因 cairomm 发布 binary 与 OHOS musl 加载器不兼容
  （symbol not found）阻塞且无法在 recipe 内修复，记录为运行时环境阻塞，
  编译+链接证据保留，运行阶段按环境限制回报。
fallback_command:       LD_LIBRARY_PATH=... ./test_probe
fallback_auto_fix:      false
fallback_impl:          runtime-environment

forbid_1_pattern:       modify harfbuzz/glibmm/cairomm/pango recipe to force shared
forbid_1_reason:        违反"不得修改依赖库"原则，且会破坏已发布 binary 匹配。
forbid_1_consequence:   recipe 修改后发布 binary 不匹配，重新引入缺包。

forbid_2_pattern:       sign -a <file> for binary-sign-tool
forbid_2_reason:        -a 不是 binary-sign-tool 有效命令（trust list 报错）。
forbid_2_consequence:   package() 阶段签名失败，包无法产出。

principles:             P014, P020

doc_file:               knowledge/drafts/pangomm-2.50.1-cxx17-libcxx-conan-profile.md
last_updated:           2026-08-25
source_event:           archives/p/pangomm/2.50.1

authors: junshi_liu <liujsh2023@lzu.edu.cn>
source_pr: !6589
source_commit:          feat/pangomm-2.50.1

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.85
metrics_last_used:      2026-08-25

# r14 update:
# - cairomm/1.18.0 提供 cairomm-1.16.pc(Version 1.18.0) + libcairomm-1.16；
#   OHOS musl 运行时ون1.16.2 (FontOptions symbol not found) 失败而 1.18.0 通过。
# - conan-verify G1-G4/L2/L4/L5 全 PASS（test_package/MANIFEST.yml 必须存在）。
# - finish W2/W3 本地 CI 被其他包遗留 junk 文件（isa-l_crypto/middleclass/
#   swift-corelibs-blocksruntime）阻塞，非 pangomm 可修复。
