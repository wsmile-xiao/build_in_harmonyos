# Layer 0: 错误面
id:                     E074
trigger_tool:           make
phase:                  compilation
error_signature:        make.*-j.*hang|make.*stuck|FIFO.*Permission denied|jobserver.*fifo|cannot make pipe|pipe.*failed

# Layer 1: 识别层
severity:               2
category:               selinux|build-system|filesystem
match_keywords:         make -j, parallel, FIFO, jobserver, hang, stuck, pipe, Permission denied, SELinux, concurrent build, GNU make

# Layer 2: 诊断层
root_cause:             鸿蒙 SELinux 策略禁止用户进程创建 FIFO（命名管道）。
                        GNU make 的 jobserver 机制依赖 FIFO 在父子进程间传递并行任务令牌，
                        FIFO 创建失败导致 make -j 卡住或报错退出。
affected_scope:          所有使用 `make -j` (j>1) 并行构建的 Autotools/CMake 项目
verification_cmd:       |
  # 测试 FIFO 创建权限
  mkfifo /tmp/test_fifo 2>&1   # 应报 Permission denied
  rm -f /tmp/test_fifo

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           env-var-override
rec_description:        强制单线程编译，绕过 jobserver FIFO 机制。
rec_command:            make -j1
rec_auto_fix:          true
rec_impl:               env-var-override

fallback_priority:      2
fallback_approach:      add-makeflags
fallback_description:   通过 MAKEFLAGS 环境变量禁用 jobserver，部分场景下可保留子 make 并行。
fallback_command:      export MAKEFLAGS="--no-builtin-rules --no-builtin-variables -j1"
fallback_auto_fix:     true
fallback_impl:          set-env-var

forbid_1_pattern:      忽略卡住继续等待或反复重试 make -j
forbid_1_reason:        FIFO 权限是系统级限制，不会因重试而改变，只会无限挂起浪费资源
forbid_1_consequence:   编译进程永久挂起，占用 CPU/内存但不产出结果

# Layer 4: 原则引用
principles:               

