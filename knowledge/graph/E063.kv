#====================================================================
# E063.kv — -Werror 导致警告变错误
#====================================================================

id:                     E063
trigger_tool:           cc|clang|make
phase:                  compilation
error_signature:        error:.*\[-W.*\].*warnings and.*errors generated|
                         -Werror.*int-conversion|-Werror.*incompatible-pointer|
                         -Werror.*implicit-function|-Werror.*format-truncation

severity:               2
category:               compiler|warnings|compat
match_keywords:         -Werror, warning to error, int-conversion,
                         incompatible-pointer-types, implicit-function-declaration,
                         format-truncation, musl, clang, CFLAGS, Makefile

root_cause:             项目启用了 -Werror(或某些类别如 -Werror=implicit-function-declaration),
                         将所有编译器警告视为错误。musl/clang 组合下产生一些与 glibc 不同的警告:
                         size_t 差异、头文件差异、格式化字符串截断等
affected_scope:         所有使用 -Werror 的软件在鸿蒙上都可能遇到(最普遍的适配问题之一)
verification_cmd:       make 2>&1 | grep "error:" | grep "\-W"
                         # 如果看到 "-Werror" 或 "[-Wxxx]" 字样 → 就是 E063

rec_priority:           1
rec_approach:           add-cflags-disable-werror
rec_description:        在编译规则中对特定 warning 类别禁用 error 升级:
                         CFLAGS += -Wno-error=int-conversion -Wno-error=incompatible-pointer-types
rec_command:            make CFLAGS="$CFLAGS -Wno-error=int-conversion -Wno-error=incompatible-pointer-types"
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:
principles:              P002, P003, P006, P007, P011
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E063.md
last_updated:           2026-04-10
source_event:           archives/s/sed/4.9/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
