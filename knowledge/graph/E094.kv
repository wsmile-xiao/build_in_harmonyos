#====================================================================
# E094.kv — musl 缺 pthread_attr_setaffinity_np()
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E094
trigger_tool:           cc|clang|make
phase:                  compilation
error_signature:        implicit declaration of function.*pthread_attr_setaffinity_np|
                         undefined reference to.*pthread_attr_setaffinity_np|
                         CPU_SETSIZE.*undeclared|cpu_set_t.*undeclared|
                         sched_getaffinity.*implicit declaration|
                         sched_setaffinity.*implicit declaration|
                         CPU_COUNT.*undeclared|CPU_ZERO.*undeclared|CPU_SET.*undeclared

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               compat, libc, musl, threading
match_keywords:         pthread_attr_setaffinity_np, GNU extension, musl,
                         thread affinity, CPU affinity, undeclared,
                         CPU_SETSIZE, cpu_set_t, sched_getaffinity,
                         sched_setaffinity, CPU_COUNT, CPU_ZERO, CPU_SET

# ═══ Layer 2: 诊断层 ═══
root_cause:             pthread_attr_setaffinity_np() 是 GNU 扩展函数，
                        用于设置线程的 CPU 亲和性（affinity）。
                        musl libc 不实现此函数（不带 _np 后缀的
                        POSIX 标准版也不存在）。
                        软件源码中直接调用此函数时，
                        musl 环境下无此符号声明和定义，
                        导致编译或链接失败。
affected_scope:         需要设置线程 CPU 亲和性的软件。
verification_cmd:       echo '#include <pthread.h>\nint main(){pthread_attr_setaffinity_np(NULL,0,NULL);}' | cc -xc - -c 2>&1 | grep pthread_attr_setaffinity;
                         grep -rn "pthread_attr_setaffinity_np\|sched_setaffinity" src/ lib/ 2>/dev/null | head -5

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description:        使用 #ifdef __OHOS__ 条件编译跳过
                        pthread_attr_setaffinity_np() 调用，
                        或使用 sched_setaffinity() 替代。
                        在 HarmonyOS 上线程亲和性通常不是必需功能，
                        跳过调用不影响正确性。
rec_command:            |
                        #ifndef __OHOS__
                            pthread_attr_setaffinity_np(&attr, sizeof(cpu_set_t), &cpuset);
                        #else
                            /* thread affinity not supported on OHOS/musl */
                        #endif
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      add-cflags
fallback_description:   通过 CFLAGS 定义空宏替代函数调用
fallback_command:       CFLAGS="$CFLAGS -Dpthread_attr_setaffinity_np\\(a,b,c\\)=0"
fallback_auto_fix:      false
fallback_impl:          add-cflags

# ★ 禁止策略 ★
forbid_1_pattern:       -DHAVE_PTHREAD_ATTR_SETAFFINITY_NP
forbid_1_reason:        强制声明函数存在但 musl 无此符号，
                        导致链接阶段 undefined reference
forbid_1_consequence:   链接失败

forbid_2_pattern:       typedef.*cpu_set_t|#define CPU_SET|#define CPU_ZERO|#define CPU_COUNT|#define CPU_SETSIZE
forbid_2_reason:        不要手动定义 CPU_SETSIZE/cpu_set_t/CPU_ZERO/CPU_SET/CPU_COUNT 等宏和类型，
                        这些定义与内核 sched.h 中的原始定义不一致会导致 ABI 问题
forbid_2_consequence:   运行时 CPU 亲和性掩码大小不匹配，sched_setaffinity 调用可能截断或越界

# ═══ Layer 4: 原则引用 ═══
principles:             

