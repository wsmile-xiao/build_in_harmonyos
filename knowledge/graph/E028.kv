#====================================================================
# E028.kv — 用户编译的共享库与系统库冲突
#====================================================================

id:                     E028
trigger_tool:           make|install
phase:                  installation|runtime
error_signature:        shared library.*conflict|system library crash|
                         symbol link incomplete|ncurses.*crash|
                         lib.*\.so.*override.*system

severity:               3
category:               linking, packaging
match_keywords:         shared library, conflict, system crash, --without-shared,
                         static only, ncurses, symbol link, override,
                         LD_LIBRARY_PATH, rpath, version mismatch

root_cause:             用户编译的共享库(.so)版本覆盖了系统版本但符号链接不完整,
                         导致依赖系统库的程序崩溃
affected_scope:         安装到系统路径或 LD_LIBRARY_PATH 前端的共享库项目(ncurses 等)
verification_cmd:       ls -la $HOME/usr/local/lib/lib*.so*; ldd /usr/bin/zsh

rec_priority:           1
rec_approach:           configure-static-only
rec_description:        只编译静态库(--without-shared), 避免覆盖系统共享库
rec_command:            ./configure --without-shared --prefix=$HOME/usr/local
rec_auto_fix:          true
rec_impl:               reconfigure

forbid_1_pattern:      install.*shared.*library.*to.*/usr/(lib|lib64)
forbid_1_reason:        禁止将用户编译的共享库安装到系统目录(/usr/lib),
                         这会破坏系统程序
forbid_1_consequence:   系统工具崩溃(zsh/vim/grep 等全部不可用)
fallback_priority:      2
fallback_approach:      config-cache
fallback_description:   如果 ./configure 参数被忽略，检查 config.cache 并删除后重试
fallback_command:      rm -f config.cache && ./configure --prefix=$TEST_PREFIX <params>
fallback_auto_fix:     true
fallback_impl:          reconfigure

principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E028.md
last_updated:           2026-04-09
source_event:           archives/n/ncurses/6.4/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

