#====================================================================
# E083 — CMAKE_SYSTEM_NAME is HarmonyOS not Linux on OpenHarmony
#====================================================================

id: E140
trigger_tool:           cmake
phase:                  configuration
error_signature:        CMAKE_SYSTEM_NAME.*HarmonyOS|System is unknown to cmake.*HarmonyOS|OS_LINUX.*not defined

severity:               2
category:               platform-cmake-detection
match_keywords:         CMAKE_SYSTEM_NAME, HarmonyOS, OS_LINUX, platform detection, __OHOS__
title:                  CMAKE_SYSTEM_NAME returns HarmonyOS on OpenHarmony, not matching Linux in CMakeLists.txt

root_cause:             On OpenHarmony, uname -s returns HarmonyOS and CMAKE_SYSTEM_NAME is HarmonyOS, CMakeLists.txt platform blocks checking for Linux don't match, causing OS_LINUX to not be defined
affected_scope:         any cmake project with platform detection using CMAKE_SYSTEM_NAME MATCHES Linux
verification_cmd:       cmake -P -E echo ${CMAKE_SYSTEM_NAME} || uname -s

rec_priority:           1
rec_approach:           add-harmonyos-cmake-detection
rec_description:        Add elseif(CMAKE_SYSTEM_NAME MATCHES HarmonyOS) block to define OS_LINUX, or add || defined(__OHOS__) to source #if guards
rec_command:            sed -i '/elseif(CMAKE_SYSTEM_NAME MATCHES "Linux")/,/add_definitions(-DOS_LINUX)/{ /add_definitions(-DOS_LINUX)/a elseif(CMAKE_SYSTEM_NAME MATCHES "HarmonyOS")\n  add_definitions(-DOS_LINUX) }' CMakeLists.txt
rec_auto_fix:           false
rec_impl:               manual-edit

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E140.md
last_updated:           2026-06-23
source_event:           rocksdb 6.4.6 compile

draft: false
contributor_id: EFAD

