#====================================================================
# E256 — CLI 工具无 --version/--help 长选项导致 L2 smoke test 失败
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E503
trigger_tool: test
phase: testing
error_signature: unrecognized option|invalid option --|jshn

# ═══ Layer 1: 识别层 (Recognition) ═══
severity: 2
category:               smoke-test
match_keywords:         --version, --help, smoke test, L2 gate, jshn, CLI tool
title: CLI 工具无 --version/--help 长选项导致 L2 smoke test 失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: 上游 CLI 工具仅实现 getopt 短选项，--version/--help 落入默认分支调用 usage() 并返回非 0（exit 2）
affected_scope: conan-verify L2 门禁对所有 bin/ 可执行文件运行 --version/--help，rc!=0 则判定失败
verification_cmd: jshn --version && jshn --help; echo $?

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority: 1
rec_approach: 补丁在 main() 开头增加 --version/--help GNU 长选项处理并返回 0（libubox jshn 先例）
rec_description: main() 开头（getopt 循环前）拦截 --version/--help，打印版本/用法后 return 0
rec_command: 编辑 jshn.c 后: ohc-run.py track-edit add libubox 2026-06-19 jshn.c && ohc-run.py refresh-patch --auto libubox 2026-06-19
rec_auto_fix:           false
rec_impl:               patch-cli-longopts

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: 在 getopt 循环的 default 分支对 argv[optind] 判断 --version/--help
fallback_description: 通过 getopt 处理后的剩余参数匹配长选项，改动更小但需注意 optind 语义
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern: return usage\(argv\[0\]\)\s*;|exit\(2\)
forbid_1_reason: --help 分支若直接返回 usage() 结果会以非 0 退出，L2 门禁仍失败
forbid_1_consequence: L2 smoke test FAIL，conan-verify 无法通过

# ═══ Layer 4: 原则引用 ═══
principles: P004

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E002]
conflicts_with:         []
prerequisite_of:        []

