# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E160
trigger_tool:           configure
phase:                  configuration
error_signature:        config.guess: unable to guess system type|cannot guess build type|uname -s = HarmonyOS

severity:               3
category:               platform
match_keywords:         HarmonyOS, config.guess, unable to guess system type, HongMeng Kernel
title:                  HarmonyOS config.guess detection

root_cause:             标准config.guess脚本无法识别HarmonyOS系统，因为它是一个新系统且不在GNU config项目的已知系统列表中
affected_scope:         所有使用autotools构建系统的软件，在HarmonyOS上首次编译时
verification_cmd:       uname -s | grep HarmonyOS && ./config/config.guess

rec_priority:           1
rec_approach:           config-guess-harmonyos-patch
rec_description:        修改config/config.guess添加HarmonyOS检测分支，将其识别为Linux系统(LIBC=musl)
rec_command:            sed -i '/case $UNAME_SYSTEM in/a HarmonyOS|HongMeng) UNAME_SYSTEM=Linux; LIBC=musl; ;;' config/config.guess
rec_auto_fix:           true
rec_impl:               patch-config-guess

principles:  # TODO: map iron rules to principle IDs

causes:                 []
caused_by:              []
similar_to:             [E007]
conflicts_with:         []
prerequisite_of:        []

content:                HarmonyOS系统未被标准config.guess识别，需要修改config/config.guess添加HarmonyOS检测分支。将HarmonyOS识别为Linux系统(LIBC=musl)，因为HarmonyOS使用Linux内核。修改位置在case $UNAME_SYSTEM语句中，添加HarmonyOS|HongMeng分支，设置UNAME_SYSTEM=Linux。
software:               matio
version:                1.5.23
doc_file:               doc/E100.md
last_updated:           2026-05-19
source_event:           matio-1.5.23-compile

draft: false
contributor_id:         5099

