#====================================================================
# DRAFT-pico-sdk-cli-commands-json-r38 — application 包需要软件级 commands.json
# Source event: pico-sdk 2.2.0 shadow CI r2 L0k fail, r4 pass
#====================================================================

id:                     E424
trigger_tool:           build_and_test.sh|conan|l0
phase:                  preflight|quality-gate
error_signature:        L0k: CLI tool detected but commands.json missing|commands_json_r38|package_type.*application|bindirs
severity:               3
category:               conan, cli-tool, metadata
match_keywords:         pico-sdk, commands.json, R38, L0k, CLI tool, application, bindirs, pioasm
title:                  Conan application/CLI 工具包即使版本目录完整，也必须在软件级目录提供 commands.json

root_cause:             CI 的 L0k 会通过 package_type="application"、bindirs 或 bin 安装逻辑识别 CLI 工具包，并要求 archives/<letter>/<name>/commands.json 存在且 type=tool、name 包含包名、versions 包含当前版本。pico-sdk 构建 bin/pioasm，因此缺 commands.json 会在构建前失败。
affected_scope:         所有在 Conan package 中提供 bin/ 可执行文件的工具包，尤其是 package_type="application" 的适配。
verification_cmd:       CI_PACKAGES="archives/p/pico-sdk/2.2.0" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           add-software-level-commands-json
rec_description:        在 archives/p/pico-sdk/commands.json 声明 name=pico-sdk、type=tool、versions[2.2.0].ref=pico-sdk/2.2.0；保持在软件级目录而不是版本目录。
rec_command:            cp templates/commands.json.template archives/p/pico-sdk/commands.json
rec_auto_fix:           false
rec_impl:               metadata-file

fallback_priority:      2
fallback_approach:      declare-library-only-if-no-bin
fallback_description:   如果包最终不提供任何 bin/ 工具，才能按库包处理并移除 application/bindirs；但 pico-sdk 当前范围明确提供 pioasm，不适用该回退。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          package-scope-change

forbid_1_pattern:       archives/.*/.*/[0-9].*/commands\.json|package_type\s*=\s*"application".*missing commands
forbid_1_reason:        R38 检查的是软件级目录 archives/<letter>/<name>/commands.json，不是版本目录。
forbid_1_consequence:   L0k 继续失败，shadow CI 不进入 conan create。

principles:             P016
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-pico-sdk-cli-commands-json-r38.md
last_updated:           2026-08-25
source_event:           pico-sdk 2.2.0 shadow CI r2 failed L0k commands_json_r38; r4 passed after adding commands.json
authors: wxjshr <wxjshr@noreply.gitcode.com>
source_pr: !6613
source_commit:          0ad30b6f0d

metrics_success_count:  1
metrics_fail_count:     1
metrics_confidence:     0.5
