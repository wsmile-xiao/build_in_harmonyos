#====================================================================
# E116.kv — ICU U16_NEXT 宏调用后缺少分号
# 来源事件: libfreehand 0.1.1 编译
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E199
trigger_tool:           clang|make
phase:                  compilation
error_signature:        expected.*';'.*after|missing.*';'.*U16_NEXT|U16_NEXT.*expected

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               1
category:               c++|macro|compiler-warning
match_keywords:         U16_NEXT, expected semicolon, missing semicolon, ICU macro, unicode

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             U16_NEXT 是 ICU 库的多行宏，在某些使用场景中宏调用后未加分号，导致编译器报缺少分号错误
affected_scope:         使用 ICU/unicode U16_NEXT 宏的 C/C++ 项目（如 libfreehand, libcdr 等 LibreOffice 系列）
verification_cmd:       grep -n "U16_NEXT" src/lib/libfreehand_utils.cpp

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description:        在 U16_NEXT 宏调用后补充分号
rec_command:            sed -i '/U16_NEXT/s/$/;/' src/lib/libfreehand_utils.cpp
rec_auto_fix:           true
rec_impl:               source-patch

# 回退方案
fallback_priority:      2
fallback_approach:      disable-warning
fallback_description:   不适用，这是编译错误不是警告
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       --build=|--host=
forbid_1_reason:        R23: 不要用 --build/--host 绕过平台检测
forbid_1_consequence:   误判为交叉编译

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E199.md
last_updated:           2026-06-25
source_event:           libfreehand-0.1.1


# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
