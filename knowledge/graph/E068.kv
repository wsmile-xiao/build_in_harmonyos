#====================================================================
# E068.kv — find_library 崩溃（ldconfig 不存在）
#====================================================================

id:                     E068
trigger_tool:           python|ctypes|runtime
phase:                  runtime
error_signature:        SubprocessError.*ldconfig.*127|find_library.*SubprocessError|
                         /sbin/ldconfig.*not found|_findSoname_ldconfig.*fail

severity:               3
category:               python|ctypes|compat|runtime
match_keywords:         find_library, ldconfig, ctypes.util, SubprocessError,
                         /sbin/ldconfig, cffi, trio, dlopen, shared library

root_cause:             HarmonyOS 没有 /sbin/ldconfig(Linux 标准的共享库缓存管理工具)。
                         ctypes.util.find_library() 内部调用 _findSoname_ldconfig() 时
                         直接执行 ldconfig -p, 因命令不存在触发 SubprocessError
affected_scope:         所有调用 find_library() 的 Python 代码及依赖它的三方库(cffi, trio, Django GIS, Sphinx)
verification_cmd:       python3 -c "from ctypes.util import find_library; print(find_library('c'))"
                         # 修复前: SubprocessError; 修复后: None

rec_priority:           1
rec_approach:           source-patch
rec_description:        在 Lib/ctypes/util.py 的 _findSoname_ldconfig() 函数头部,
                         检测鸿蒙平台后直接 return None 跳过 ldconfig 调用
rec_command:
rec_auto_fix:          false
rec_impl:               patch

forbid_1_pattern:
principles:             P-PATCH-001

causes:                 []
caused_by:              []
similar_to:             [E019]   # 都是运行时找不到库的问题
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E068.md
last_updated:           2026-04-10
source_event:           archives/p/python/3.9.0/manifest.yaml
