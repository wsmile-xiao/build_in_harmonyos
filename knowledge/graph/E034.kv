#====================================================================
# E034.kv — 系统缺少 CA 证书包
#====================================================================

id:                     E034
title: 系统缺少 CA 证书包
trigger_tool:           wget|curl|python|runtime
phase:                  runtime|download
error_signature:        unable to load client CA certificates|SSL certificate verification failed|
                         ca-certificates.*not found|/etc/ssl/certs.*No such file

severity:               2
category:               ssl|packaging|filesystem
match_keywords:         CA certificates, SSL, wget, curl, ca-certificates,
                         /etc/ssl/certs, certificate verify failed, unable to load

root_cause:             鸿蒙系统未预装 ca-certificates 包,
                         缺少 /etc/ssl/certs/ca-certificates.crt
affected_scope:         wget、curl、Python requests 等所有需要 TLS 证书验证的工具
verification_cmd:       ls /etc/ssl/certs/ca-certificates.crt  # 文件不存在

rec_priority:           1
rec_approach:           install-ca-certs
rec_description:        通过鸿蒙系统 设置→安装证书→CA证书 导入证书包;
                         或从可信源下载 ca-certificates 并安装到 /etc/ssl/certs/
rec_command:
rec_auto_fix:          false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      skip-verify
fallback_description:   临时方案(仅可信源): wget --no-check-certificate 或 curl -k
rec_command:            wget --no-check-certificate https://example.com/file
fallback_auto_fix:     false

forbid_1_pattern:      在生产环境或不可信网络中使用 --no-check-certificate/-k
forbid_1_reason:       跳过证书验证使连接易受中间人攻击(MITM)
forbid_1_consequence:  敏感数据(密码、token)可能被窃取
principles:

causes:                 []
caused_by:              []
similar_to:             [E006]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E034.md
last_updated:           2026-04-10
source_event:           archives/s/wget/1.19.1/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

