#====================================================================
# E090.kv — Meson host_system == 'linux' 不匹配 HarmonyOS
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E090
trigger_tool:           meson
phase:                  configure,linking
error_signature:        undefined symbol: _g_fd_is_journal|host_system.*harmonyos|meson.*host_system.*linux|Platform.*harmonyos.*not.*linux

# ═══ Layer 1: 识别层 ═══
severity:               3
category:               platform, detection, meson
match_keywords:         meson, host_system, harmonyos, linux, undefined symbol, glib, gjournal, systemd, platform detection

# ═══ Layer 2: 诊断层 ═══
root_cause:             Meson 检测 HarmonyOS 为 'harmonyos' 而非 'linux'，
                        导致 meson.build 中 `host_system == 'linux'` 条件检查失败，
                        Linux 特有源文件（如 glib 的 gjournal-private.c）未被编译，
                        产生 undefined symbol 链接错误。
                        HarmonyOS 基于 Linux 内核，Linux 特有功能（systemd journal、netlink 等）通常适用。
affected_scope:         所有使用 meson 构建系统且有 `host_system == 'linux'` 条件判断的软件。
verification_cmd:       grep -rn "host_system == 'linux'" meson.build **/meson.build

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           sed-replace
rec_description:        将所有 meson.build 中的 host_system == 'linux' 替换为
                        host_system in ['linux', 'harmonyos']，
                        使 Linux 特有代码路径在 HarmonyOS 上也可用。
                        需要对每个 meson.build 文件执行 track-edit add 记录。
rec_command:            find . -name meson.build -exec sed -i "s/if host_system == 'linux'/if host_system in ['linux', 'harmonyos']/g" {} +
rec_auto_fix:           true
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      meson-cross-file
fallback_description:   创建 meson cross file 指定 platform=linux，但此方案可能掩盖其他平台差异问题。
fallback_command:       
fallback_auto_fix:      false
fallback_impl:          

# ★ 禁止策略 ★
forbid_1_pattern:       sed.*host_system.*=.*linux
forbid_1_reason:         不要将 host_system 直接赋值为 'linux'（改 meson 内部变量），
                        应改为 in ['linux', 'harmonyos'] 列表检查，保持可读性
forbid_1_consequence:   难以审查，后续 meson 版本升级可能冲突

# ═══ Layer 4: 原则引用 ═══
principles:             

# ═══ 关系图 ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E090.md
last_updated:           2026-04-21
source_event:           glib 2.88.0 编译

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

