#====================================================================
# E112.kv — 知识图谱条目 (草稿)
# HMDFS 大小写不敏感文件系统导致测试用例失败
#====================================================================

id: E193
trigger_tool:           test|make check
phase:                  testing
error_signature:        case.insensitive.*FAIL|case_sensitive.*FAIL|3d2.*/boo|BOO.*boo.*same inode|case.insensitive.filesystem

severity:               2
category:               platform, hmdfs, testing, filesystem
match_keywords:         case-insensitive, HMDFS, filesystem, BOO, boo,

root_cause:             HMDFS (鸿蒙分布式文件系统) 是大小写不敏感的。 
                        创建不同大小写的文件名（如 BOO 和 boo）时，
                        它们指向同一个 inode（共享相同 inode 编号）。
                        这与 macOS 的 APFS/HFS+ 行为一致，但与 Linux 
                        标准 ext4/xfs 不同。
                        许多开源测试套件会创建不同大小写的文件来测试
                        大小写区分能力，在 HMDFS 上这些测试会失败。
                        
affected_scope:         所有在 HMDFS 上运行 make check 的软件，
                        特别是那些创建不同大小写文件名来验证
                        文件系统行为的测试用例。
                        
verification_cmd:       touch BOO && touch boo && stat -c '%i' BOO boo | sort -u | wc -l
                        # 如果输出为 1，说明文件系统是大小写不敏感的

rec_priority:           2
rec_approach:           skip-case-sensitive-tests
rec_description:        检测到 HarmonyOS 系统时，跳过大小写敏感测试用例。
                        参考 macOS (Darwin) 上的相同处理策略。
rec_command:            '
                        # 在测试脚本中添加 HarmonyOS 检测：
                        case_insensitive_fs=false
                        if uname -a | grep -qi "HarmonyOS"; then
                            case_insensitive_fs=true
                        fi
                        for t_file in ...; do
                            if $case_insensitive_fs && [[ $t_file == */case_*sensitive ]]; then
                                continue   # 跳过大小写敏感测试
                            fi
                            ...
                        done
                        '
rec_auto_fix:           true
rec_impl:               manual-patch

principles:               

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E193.md
last_updated:           2026-06-26
source_event:           wimlib-1.14.5-compile


