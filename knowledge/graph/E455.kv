#====================================================================
# DRAFT-ecm629-stdlib-libstdcxx-invalid.kv
# 主题: OHOS clang 拒绝 -stdlib=libstdc++（Conan profile libcxx 误配）
# 来源: extra-cmake-modules 6.29.0 首轮本地适配首错（conan create 阶段）
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E455
trigger_tool:           conan|cmake|clang
phase:                  configuration
error_signature:        invalid library name in argument '-stdlib=libstdc++'|
                         Check for working CXX compiler.*broken|
                         is not able to compile a simple test program|
                         clang-15: error: invalid library name

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               platform, toolchain, conan, libcxx
match_keywords:         libstdc++, libc++, invalid library name, conan profile, libcxx,
                         OHOS, clang, CMakeToolchain, compiler check broken

# ═══ Layer 2: 诊断层 ═══
title:                  OHOS clang 拒绝 -stdlib=libstdc++（Conan profile libcxx 误配导致编译器检查 broken）
root_cause:             Conan profile 中 compiler.libcxx=libstdc++11（或任意 libstdc++ 变体）时，
                         CMakeToolchain 生成 conan_toolchain.cmake 注入 "-stdlib=libstdc++"；
                         OHOS 工具链 clang 15 只提供 libc++，拒绝该 flag：
                         "clang-15: error: invalid library name in argument '-stdlib=libstdc++'"
                         导致 CMake TryCompile 失败 → "Check for working CXX compiler ... broken"。
                         修复: 使用 repository 预置 OHOS profile（compiler.libcxx=libc++）。
affected_scope:         所有以 Conan 2 (CMakeToolchain) 构建到 OHOS aarch64 的 C++ 配方，
                         若使用 libcxx=libstdc++11 的默认/误配 profile
verification_cmd:       conan profile show | grep -i libcxx
                         # 或复现: conan create . -pr:b default -pr:h default

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           use-ohos-profile-libcxx
rec_description:        改用仓库预置 OHOS profile（compiler.libcxx=libc++）；不要用 detect 生成的
                         默认 profile（libstdc++11）。CMakeToolchain 将注入 -stdlib=libc++，
                         编译器 TryCompile 通过，conan create 与 test_package 正常运行。
rec_command:            conan create . --build=missing \
                         -pr:h=ci/conan/profiles/ohos-aarch64 \
                         -pr:b=ci/conan/profiles/ohos-aarch64
rec_auto_fix:           true
rec_impl:               use-ohos-profile

fallback_priority:      2
fallback_approach:      patch-profile-libcxx
fallback_description:   若无法使用仓库 profile，则修正默认 profile 的 compiler.libcxx=libc++，
                         或临时写 profile 文件传入 -pr 参数；禁止在 recipe 里写死 -stdlib。
fallback_command:       conan profile update settings.compiler.libcxx=libc++ default
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       -stdlib=libstdc\+\+
forbid_1_reason:        直接传 -stdlib=libstdc++ 或改 toolchain 文件仍会被 OHOS clang 拒绝，
                         且 recipe 内写死编译器 flag 违反 R33（环境变量/flag 不可裸写）
forbid_1_consequence:   编译继续失败；recipe 依赖宿主私有 flag，CI 干净环境无法复现

# ═══ Layer 4: 原则引用 ═══

# ═══ 关系图 ═══
causes:
caused_by:
similar_to:             E191
conflicts_with:
prerequisite_of:

