#====================================================================
# E038.kv — groff 宏文件缺失
#====================================================================

id:                     E038
title: groff 宏文件缺失
trigger_tool:           man|groff|runtime
phase:                  runtime
error_signature:        macro 'g' not defined|macro 'safe' not defined|
                         macro 'padj' not defined|groff.*warning.*diversion

severity:               1
category:               packaging|compat|man
match_keywords:         groff, macro, g.tmac, safe.tmac, padj.tmac, man-db,
                         man_db.conf, nroff, diversion, warning, mandoc

root_cause:             groff 1.23.0 移除了 g.tmac(getopt宏)、safe.tmac(安全子集宏)、
                         padj.tmac(段落调整宏); man-db 的 man_db.conf 中 nroff 定义仍引用这些已移除的宏
affected_scope:         man-db 及其他依赖旧版 groff 宏的手册页工具
verification_cmd:       man man  # 查看 groff 警告输出

rec_priority:           1
rec_approach:           config-patch
rec_description:        修改 man_db.conf 中的 nroff 定义, 移除不兼容的宏参数:
                         DEFINE nroff groff -Tutf8 -mandoc (去掉 -mg -msafe -mpadj)
rec_command:
rec_auto_fix:          false
rec_impl:               manual-edit

forbid_1_pattern:      groff 1.23.0+ 的 nroff 配置中引用 -mg/-msafe/-mpadj 宏参数
forbid_1_reason:       这些宏已在 groff 1.23.0 中被移除
forbid_1_consequence:  groff 警告 + 手册页渲染异常
fallback_priority:      2
fallback_approach:      consult-knowledge
fallback_description:   推荐方案不适用时，查阅 knowledge/error-patterns.md 中相似条目的替代方案
fallback_command:      grep -r "关键词" knowledge/graph/index.tsv
fallback_auto_fix:     false
fallback_impl:          none
principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        [E039,E040]

doc_file:               doc/E038.md
last_updated:           2026-04-10
source_event:           archives/s/man-db/2.13.1/manifest.yaml

