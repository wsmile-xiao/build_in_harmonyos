#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E105.kv，填写各字段
# 对应的人类文档: doc/E105.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E172
trigger_tool:           cargo|rustc|rust
phase:                  configuration
error_signature:        no such file or directory.*rustc|no such file or directory.*cargo|command not found.*rustc|command not found.*cargo|ELF.*interpreter /lib/ld-linux-aarch64.so.1.*No such file

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               toolchain|rust|platform-limitation
match_keywords:         rust, cargo, rustc, Rust, toolchain, ELF, dynamic linker, ld-linux-aarch64.so.1
title:                  Rust 工具链不可用（Linux ELF 二进制缺少鸿蒙动态链接器）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             系统中的 Rust 工具链（rustc/cargo）是为 Linux 编译的 ELF 二进制，
                        期望动态链接器路径 /lib/ld-linux-aarch64.so.1，
                        鸿蒙系统缺少此路径，导致 Rust 工具链无法执行。
                        所有 Rust 项目（procs, bottom, yazi 等）无法通过 cargo 构建。
affected_scope:         所有 Rust 项目：procs, bottom, yazi, ripgrep, bat, exa, fd, starship 等
verification_cmd:       file /storage/Users/currentUser/usr/local/bin/rustc &&
                        /storage/Users/currentUser/usr/local/bin/rustc --version &&
                        ls -la /lib/ld-linux-aarch64.so.1

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           wait-for-platform-support   # 见 DESIGN §5 impl 列表
rec_description:        标记为平台限制，等待鸿蒙原生 Rust 工具链或 musl 静态链接版本可用
rec_command:            # 无命令，仅记录 PROGRESS.md: "阻塞原因: Rust 工具链不可用"
rec_auto_fix:           false                       # 引擎能否自动执行
rec_impl:               none                        # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      use-binary-release
fallback_description:   使用项目提供的预编译 musl 静态链接版本（如有）
fallback_command:       curl -LO https://github.com/{author}/{project}/releases/download/v{version}/{project}-v{version}-aarch64-linux.zip &&
                        unzip {project}-v{version}-aarch64-linux.zip &&
                        mv {project} ~/usr/local/bin/
fallback_auto_fix:      false
fallback_impl:          none

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:             none    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

