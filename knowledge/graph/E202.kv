id: E202
trigger_tool:           runtime
phase:                  runtime
error_signature:        PTHREAD_KEYS_MAX|pthread_key_create.*fail|key_create.*failed
severity:               1
category:               platform-limitation
match_keywords:         PTHREAD_KEYS_MAX, pthread_key_create, musl, OHOS
root_cause:             musl libc has PTHREAD_KEYS_MAX=128 vs glibc 1024+, causing pthread_key_create failures for tests creating >128 keys
affected_scope:         Any software using pthread_key_create extensively on OHOS/musl
verification_cmd:       grep -r PTHREAD_KEYS_MAX /usr/include/ 2>/dev/null || echo "musl default: 128"
rec_priority:           1
rec_approach:           skip-test
rec_description:        Skip the failing test and record as musl platform limitation, not a library defect
rec_command:            echo "SKIP: musl PTHREAD_KEYS_MAX=128 platform limit"
rec_auto_fix:           false
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
principles:
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        
doc_file:               doc/E202.md
last_updated:           2026-06-03
source_event:           libeatmydata-131

