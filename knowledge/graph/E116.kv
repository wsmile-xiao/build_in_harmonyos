#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E081.kv，填写各字段
# 对应的人类文档: doc/E081.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E116
trigger_tool:           automake|aclocal|autoreconf|perl
phase:                  configuration
error_signature:        Can't locate Automake/Config.pm in @INC|bad interpreter: .*perl: no such file or directory

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               autotools|precompiled-package|compatibility
match_keywords:         Automake::Config, automake perl, aclocal perl module, precompiled package incompatible, perl @INC
title:                  预编译包的 automake Perl 模块不兼容

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             预编译包的 automake 脚本(aclocal/automake)是用 Perl 编写的，依赖 Automake::Config 等 Perl 模块。
                        预编译包打包时，Perl 模块安装在特定路径(如 ~/usr/local/share/automake-1.17)，而系统的 Perl 搜索路径(@INC)不包含该路径，
                        导致预编译包的 automake 无法工作。
affected_scope:         所有依赖 automake 的项目，尤其是需要运行 autogen.sh 的 Git 源码包
verification_cmd:       ~/usr/local/bin/aclocal --version 2>&1 | grep -i "Can't locate Automake/Config.pm"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           compile-automake-from-source
rec_description:        编译 perl 预编译包或从源码编译 automake，确保 Perl 模块路径匹配系统 Perl 的 @INC
rec_command:            # 步骤1: 编译 perl（如无预编译包）
                        # 步骤2: 从源码编译 automake（git clone https://git.savannah.gnu.org/git/automake.git）
                        # 步骤3: 验证 aclocal --version 正常工作
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      use-official-tarball
fallback_description:   使用包含预生成 configure 的官方发布 tarball，避免需要 automake
fallback_command:       # 避免 Git 源码包，优先使用 GCC infrastructure 或官方发布的 tarball
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       使用不兼容的预编译 automake 包强行运行 autogen.sh
forbid_1_reason:        预编译包的 Perl 模块路径与系统不匹配，无法工作
forbid_1_consequence:   autogen.sh 失败，configure 无法生成，编译完全阻塞

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

