# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E516
trigger_tool: clang|cc|ld|make|conan
phase: build|link
error_signature: undefined symbol: _res|undefined reference to ._res.|cannot find -lresolv|incomplete type .struct ip_options.|linux/ip.h: No such file

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category:               ohos, libc, build-system, ndk, resolver
match_keywords: _res,__res_state,resolv,ip_options,linux/ip.h,OHOS,libc,resolver state
title: OHOS libc omits _res/__res_state and <linux/ip.h> — provide custom resolver state and skip IP options

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: OHOS libc (bionic-derived) provides res_init()/res_search()/res_query()
    but does NOT export the legacy global `_res` symbol nor the `__res_state()`
    thread-local accessor that glibc exposes; software using `return &_res;` to
    obtain a resolver-state pointer fails to link (undefined symbol: _res).
    Separately the OHOS NDK headers ship no `<linux/ip.h>`, so `struct
    ip_options` is an incomplete type and code referencing it fails to compile.
affected_scope: C/C++ software ported from Linux/glibc that (a) directly reads
    the global `_res` resolver state or calls `__res_state()` to configure DNS
    resolver options/retrans/retry (e.g. MTAs, DNS tools, anything wrapping
    res_search with custom state), and (b) references IPv4 IP socket options
    via `<linux/ip.h>` / `struct ip_options`. Observed on exim 4.99.5.
verification_cmd: echo 'int main(void){extern int _res; return _res;}' > /tmp/t.c
    && clang /tmp/t.c -o /tmp/t 2>&1 | grep -q 'undefined.*_res' && echo CONFIRMED

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority: 1
rec_approach: provide-custom-resolver-state
rec_description: Define OS_GET_DNS_RESOLVER_RES to skip the generic _res path,
    then provide a process-wide static struct __res_state accessor; for
    ip_options define NO_IP_OPTIONS and undef GLIBC_IP_OPTIONS to skip the
    deprecated IPv4 source-route path.
rec_command: add to OS/os.h-<plat>: #define OS_GET_DNS_RESOLVER_RES \n #undef
    GLIBC_IP_OPTIONS \n #define NO_IP_OPTIONS ; add to OS/os.c-<plat>:
    static struct __res_state s; res_state os_get_dns_resolver_res(void){
    return &s; }
rec_auto_fix: false
rec_impl: provide-custom-resolver-state

fallback_priority: 2
fallback_approach: link-against-libresolv-shim
fallback_description: If the software cannot be patched, build a small shim
    library exposing a writable `_res` symbol and -lresolv to satisfy the
    linker, accepting that resolver options set on the shim may not propagate
    to OHOS internal resolver state.
fallback_command: echo 'int _res;' > shim.c && clang -shared -o libresshim.so
    shim.c && LDFLAGS+=-lresshim
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern: return\s*&_res\s*;
forbid_1_reason: Direct `_res` access does not link on OHOS (symbol absent);
    the shim fallback only silences the link error, runtime resolver config
    will not work.
forbid_1_consequence: Binary links but DNS resolver options (retrans/retry/
    options) set by the software are silently ignored by OHOS res_search().
forbid_2_pattern: #include\s*<linux/ip\.h>
forbid_2_reason: OHOS NDK does not ship <linux/ip.h>; direct include fails.
forbid_2_consequence: Compilation error: linux/ip.h: No such file or directory.

# ═══ Layer 4: 原则引用 ═══
principles: P001, P007

