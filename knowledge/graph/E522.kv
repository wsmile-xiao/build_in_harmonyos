id:                     E522
trigger_tool:           conan|autotools|libtool|pkg-config
phase:                  generate|linking|testing
error_signature:        is not a valid libtool archive|library .*\.la was moved|sanitized .*\.la.*missing archive|bad escape \\H

severity:               2
category:               autotools, cross-compile, conan, libtool, relocatable
match_keywords:         dependency_libs, stale Conan cache, libX11.la, libxcb.la, transitive .la, libtool shadow, PurePosixPath, Windows UNC, task-local cache
title:                  Build a task-local recursive Libtool metadata closure

root_cause:             A relocated Conan package can contain a direct Libtool
                        archive whose dependency_libs points to current or stale
                        transitive .la files. Repairing only the direct archive
                        is insufficient because Libtool recursively opens each
                        transitive archive. Cross-host graph checks add two traps:
                        regex replacement strings interpret Windows backslashes,
                        and Windows Path treats //lib/foo.la as a UNC anchor.
affected_scope:         Autotools/Libtool consumers of shared Conan dependencies
                        where the dependency graph publishes .la metadata that
                        still embeds package-cache paths.
verification_cmd:       Run a fresh isolated graph/install check and an exact
                        target static/shared conan create; require every shadow
                        .la reference to remain inside the task-local shadow,
                        zero stale cache tokens, complete upstream tests, real
                        package consumers, and unchanged dependency packages.

rec_priority:           1
rec_approach:           task-local-recursive-libtool-shadow
rec_description:        Enumerate dependency .la files by unique basename,
                        copy every declared library artifact into a build-local
                        directory, rewrite the complete dependency_libs closure
                        to shadow paths, bind each shadow libdir locally, and put
                        the shadow directory before dependency libdirs. Use a
                        callable regex replacement for host paths and
                        PurePosixPath for leading-slash target tokens.
rec_command:            conan create <recipe> -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing
rec_auto_fix:            false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      scoped-la-free-static-archive-directory
fallback_description:   For static-only dependencies, use E236 and copy only
                        required .a files into a private directory with no .la
                        metadata. Do not use this fallback when shared library
                        metadata is required.
fallback_command:
fallback_auto_fix:      false
fallback_impl:          conan-recipe

forbid_1_pattern:       sed .*dependency_libs.*\.conan|rm .*\.la.*conan
forbid_1_reason:        Rewriting or deleting files in a dependency package cache
                        mutates shared package state outside the current recipe.
forbid_1_consequence:   Reproducibility and unrelated builds depend on task order.
forbid_2_pattern:       copy .*libX11\.la.*only|sanitize.*direct.*\.la
forbid_2_reason:        Libtool recursively follows transitive dependency_libs;
                        a one-level repair leaves stale paths in libxcb or later
                        archives.
forbid_2_consequence:   Configure and compilation pass until the final Libtool
                        link, then fail on a moved or invalid archive.

principles:             P010,P012,P014
causes:                 []
caused_by:              []
similar_to:             [E236]
conflicts_with:         []
prerequisite_of:        []

