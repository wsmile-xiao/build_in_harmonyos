#====================================================================
# E066.kv — refresh-patch.sh 不支持 .tar.xz 格式
#====================================================================

id:                     E066
trigger_tool:           refresh-patch|scripts
phase:                  packaging|archival
error_signature:        tar.*Error is not recoverable|tar.*Cannot open|refresh-patch.*tar.*fail|
                         \.tar\.xz.*not supported|unsupported tar format

severity:               1
category:               tools|scripts|packaging
match_keywords:         refresh-patch.sh, tar.xz, tar.gz, tar.bz2, tar format,
                         script defect, xz compression, patch generation, archives

root_cause:             refresh-patch.sh 内部硬编码 tar xzf 解压原始 tarball,
                         只支持 .tar.gz 格式。GNU 软件越来越多使用 .tar.xz(xz 压缩率更高),
                         导致解压失败和补丁管线中断
affected_scope:         所有使用 .tar.xz 源码且依赖 refresh-patch.sh 的归档流程
verification_cmd:       head -20 ${SKILL_ROOT}/scripts/refresh-patch.sh | grep tar

rec_priority:           1
rec_approach:           source-patch
rec_description:        修改 refresh-patch.sh 按 tarball 扩展名选择解压方式:
                         *.tar.gz→tar xzf, *.tar.xz→tar xJf, *.tar.bz2→tar xjf, 其他→tar xf(自动检测)
rec_command:
rec_auto_fix:          true
rec_impl:               patch

forbid_1_pattern:      脚本中硬编码单一 tar 解压参数而不按扩展名分支
forbid_1_reason:       GNU 上游已全面转向 .tar.xz, 硬编码 tar xzf 会持续失败
forbid_1_consequence:  补丁生成管线失败, 新版本软件无法归档
fallback_priority:      2
fallback_approach:      manual-workaround
fallback_description:   如果自动补丁不适用，手动在源码中做最小兼容修改并记录到 PROGRESS.md
fallback_command:      # 手动编辑源码后记录:
# 1. 修改文件列表
# 2. 修改原因
# 3. 验证方式
fallback_auto_fix:     false
fallback_impl:          manual
principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E066.md
last_updated:           2026-04-10
source_event:           internal (script defect)
