#====================================================================
# Draft: zlib shadow CI needs HNP tool path for Makefile builds
#====================================================================

id:                     E540
trigger_tool:           ohos-test-runner|conan|make|cmake
phase:                  shadow-ci
error_signature:        make: inaccessible or not found|/system/bin/sh: make|/data/service/hnp/bin|exit 127

severity:               2
category:               ohos, runner-tool-path
match_keywords:         zlib, shadow CI, ohos-test-runner, make, PATH, /data/service/hnp/bin, CMake, Conan
title:                  zlib Makefile shadow CI needs /data/service/hnp/bin in PATH

root_cause:             The OHOS Conan profile can point CC/CXX to /data/service/hnp/bin/clang, so configure succeeds, while later recipe commands such as make -j1 still resolve through PATH. If runner PATH lacks /data/service/hnp/bin, Makefile packages fail at the first make invocation.
affected_scope:         zlib and similar Makefile/autotools packages verified through ohos-test-runner on HarmonyOS devices.
verification_cmd:       sh $HOME/bin/ohos-test-runner.sh --path /data/service/hnp/bin -- zsh ci/conan/build_and_test.sh archives/z/zlib/1.3.1.1.1

rec_priority:           1
rec_approach:           runner-path-prepend
rec_description:        Before single-package shadow CI, prepend /data/service/hnp/bin to PATH through the runner --path option. For CMake-based test_package builds, also include the active HNP CMake directory when present.
rec_command:            EXTRA_PATH=/data/service/hnp/bin:/data/service/hnp/cmake.org/cmake_4.1.2/bin:$HOME/usr/local/bin:$HOME/.local/bin:$HOME/ohpc-ci-shadow/python-user/bin; sh $HOME/bin/ohos-test-runner.sh --path "$EXTRA_PATH" -- zsh ci/conan/build_and_test.sh archives/z/zlib/1.3.1.1.1
rec_auto_fix:           false
rec_impl:               manual-runner-path

fallback_priority:      2
fallback_approach:      absolute-make-command-probe
fallback_description:   If the runner still fails, first verify /data/service/hnp/bin/make --version and inspect runner logs/env.txt before changing the recipe.
fallback_command:       /data/service/hnp/bin/make --version; grep '^PATH=' "$RUN/logs/env.txt"
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       treat make not found as zlib source failure|clear device lock owned by another run|rerun without CI_PACKAGES
forbid_1_reason:        The failure is a runner environment issue, not a zlib compatibility failure; lock ownership and single-package scope must be preserved.
forbid_1_consequence:   Misdiagnosis can cause unnecessary recipe churn or disrupt another active device CI task.


causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

