#====================================================================
# E067.kv — grep 匹配含正则元字符的固定字符串失败
#====================================================================

id:                     E067
trigger_tool:           shell|testing|runtime
phase:                  runtime|testing
error_signature:        grep.*match fail|grep.*regex metacharacter|
                         grep.*fixed string.*parenthesis|GNU sed.*version.*grep.*empty

severity:               1
category:               shell|tools|ai-mistake
match_keywords:         grep, BRE, regex metacharacter, fixed string, -F,
                         parenthesis, bracket, dollar, case pattern, AI programming

root_cause:             grep 默认使用基本正则表达式(BRE)模式。
                         当待匹配字符串含正则元字符( ()[]$ )时,
                         这些字符被当作正则元字符处理导致匹配失败。
                         这是 AI 编程疏忽, 不是平台问题
affected_scope:         鸿蒙上的测试脚本和验证逻辑
verification_cmd:       V=$($SED --version | head -1); echo "$V" | grep "GNU sed 4.9"
                         # ❌ 失败:( 是元字符
                         echo "$V" | grep -F "GNU sed 4.9"   # ✅ 成功:-F 固定字符串

rec_priority:           1
rec_approach:           use-grep-F-or-case
rec_description:        匹配固定字符串时使用 grep -F(强制固定字符串模式);
                         或使用 shell 原生 case 模式匹配(无元字符问题):
                         case "$var" in *pattern*) ;; esac
rec_command:
rec_auto_fix:          true
rec_impl:               code-pattern

forbid_1_pattern:      在待匹配内容可能含正则元字符的场景下使用 grep 而不用 grep -F
forbid_1_reason:       ( ) [ $ 等字符在 BRE 中是元字符, 导致意外匹配失败
forbid_1_consequence:  版本检测、条件判断等静默失败, 后续逻辑走错分支
fallback_priority:      2
fallback_approach:      consult-knowledge
fallback_description:   推荐方案不适用时，查阅 knowledge/error-patterns.md 中相似条目的替代方案
fallback_command:      grep -r "关键词" knowledge/graph/index.tsv
fallback_auto_fix:     false
fallback_impl:          none
principles:

causes:                 []
caused_by:              []
similar_to:             [E010]   # 都是工具行为差异/AI 疏忽类
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E067.md
last_updated:           2026-04-10
source_event:           internal (AI programming mistake)
