#====================================================================
# E011.kv — HMDFS 文件系统 umask 077 权限问题
#====================================================================

id:                     E011
title: HMDFS 文件系统 umask 077 权限问题
trigger_tool:           configure|config.status
phase:                  configuration
error_signature:        Permission denied.*conf.*\.tmp|
                         cannot create.*subs[0-9]*\.awk.*Permission denied|
                         cannot create.*subs[0-9]*\.sed.*Permission denied|
                         config\.status.*error.*creating.*tmp|
                         umask 077.*mktemp

severity:               3
category:               platform|hmdfs|permissions
match_keywords:         umask 077, Permission denied, config.status,
                         mktemp, HMDFS, setgid, temp directory,
                         subs1.awk, subs1.sed, confXXXXXX,
                         cannot create temp file

root_cause:             HMDFS 文件系统的 UID 映射机制导致 umask 077 创建的
                         临时目录无法被当前进程写入。autotools 的 configure 脚本
                         在生成 config.status 时，使用 `mktemp -d "./confXXXXXX"`
                         创建临时目录，并先执行 `umask 077` 设置权限。
                         在 HMDFS 上，目录所有者 UID 被映射为 20001006，
                         而进程实际 UID 为 20020083，导致 0700 权限的目录
                         对当前进程不可写。
                         此外 HMDFS 可能给目录设置 setgid 位（02700），
                         进一步加剧权限问题。
affected_scope:         **所有使用 autotools 的项目**在 HMDFS 上 configure 时
                         均会遇到此问题（xz, tar, wget, texinfo, vala 等已确认）
verification_cmd:       grep "umask 077" configure | head -3;
                         mktemp -d "./confXXXXXX" && ls -ld conf* 2>/dev/null;
                         id -u

rec_priority:           1
rec_approach:           edit-umask-in-configure
rec_description:        修改 configure 脚本中 `umask 077` 为 `umask 022`（或 000/007）。
                         方法 1（推荐）: `./configure --no-create` → 编辑 config.status
                         将 `umask 077` 改为 `umask 022` → 手动运行 `./config.status`。
                         方法 2: 直接 `sed -i 's/umask 077/umask 022/g' configure`
                         然后正常运行 `./configure`。
                         umask 022 允许同组用户写入，在无多用户场景下安全。
rec_command:            sed -i 's/umask 077/umask 022/g' configure && ./configure --prefix=$DEFAULT_PREFIX
rec_auto_fix:           true
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      edit-config-status
fallback_description:   在 configure --no-create 后，直接编辑 config.status
                         中的 umask 077 为 umask 000，然后运行 ./config.status
fallback_command:       ./configure --no-create --prefix=$DEFAULT_PREFIX && sed -i 's/umask 077/umask 000/g' config.status && ./config.status
fallback_auto_fix:      true
fallback_impl:          source-patch

fallback2_priority:     3
fallback2_approach:     manual-config-generation
fallback2_description:  当 umask 修改仍无法解决时（HMDFS 极端限制：即使 umask 000
                         临时目录仍不可写），完全绕过 config.status 机制，手动生成
                         配置文件：
                         方案 A: 从 config.h.in 手动创建 config.h，将所有
                         #undef 改为 #define（根据 configure 的 --no-create
                         阶段输出的检测结果决定哪些需要 define）；
                         方案 B: 从 Makefile.in 手动创建 Makefile，使用
                         ?= 条件赋值替代 = 赋值，保留可覆盖性；
                         方案 C: 创建独立 Makefile.manual，硬编码所有编译
                         参数（prefix, CC, CFLAGS, LDFLAGS 等），完全
                         脱离 autotools 体系。
fallback2_command:      # 方案 A: 手动生成 config.h
                         ./configure --no-create --prefix=$DEFAULT_PREFIX 2>&1 | tee config.log;
                         sed 's/^#undef \(.*\)/#define \1 1/' config.h.in > config.h;
                         # 方案 B: 手动生成 Makefile
                         sed 's/ = / ?= /g' Makefile.in > Makefile;
                         # 方案 C: 独立 Makefile（见 doc/E011.md 极端方案章节）
fallback2_auto_fix:     false
fallback2_impl:         manual

forbid_1_pattern:       --build=|--host=|--target=
forbid_1_reason:         禁止用交叉编译参数绕过 configure。
                         这会让 AC_RUN_IFELSE 全部跳过，
                         但 umask 问题本身并没有被解决，
                         后续 config.status 仍会失败
forbid_1_consequence:   configure 看似通过但 config.h 检测结果全部为默认值，
                         编译阶段出现级联错误

principles:             P-PATCH-001

causes:                 []
caused_by:              []
similar_to:             [E002]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E011.md
last_updated:           2026-04-21
source_event:           archives/x/xz/5.6.2, archives/t/tar/1.35, archives/w/wget/1.19.1

