# Layer 0: 错误面
id: E174
title:                  install 命令缺失
trigger_tool:          make|install
phase:                  installation
error_signature:        make: install: No such file or directory|install: command not found|make\[\d+\]: install: No such file or directory

# Layer 1: 识别层
severity:               2
category:              tool-missing|platform-limitation
match_keywords:         install, No such file or directory, make, coreutils, installation failed

# Layer 2: 诊断层
root_cause:             OpenHarmony 缺少 GNU coreutils 的 install 命令。
                        install 命令是 GNU coreutils 的一部分，用于安装文件到指定位置并设置权限。
                        OpenHarmony 的工具集不包含完整的 GNU coreutils，导致 make install 失败。
                        需要使用 cp + chmod 手动安装，或制作 Makefile 补丁。
affected_scope:         使用 Makefile install 目标的项目，依赖 install 命令的安装脚本
verification_cmd:       which install || echo "install command missing"

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           manual-install
rec_description:        手动使用 cp + chmod 替代 install 命令进行文件安装
rec_command:            # 示例：手动安装二进制文件
                        cp binary ~/usr/local/bin/
                        chmod 0755 ~/usr/local/bin/binary

                        # 示例：创建目录并安装
                        mkdir -p ~/usr/local/share/man/man1
                        cp doc/manpage.1 ~/usr/local/share/man/man1/
                        chmod 0644 ~/usr/local/share/man/man1/manpage.1
rec_auto_fix:          false
rec_impl:               manual-copy

fallback_priority:      2
fallback_approach:      makefile-patch
fallback_description:   修改 Makefile，将 install 命令替换为 cp + chmod 组合
fallback_command:       # 在 Makefile 中查找 install 命令并替换
                        sed -i 's/install -m \([0-9]*\) \([^ ]*\) \([^ ]*\)/cp \2 \3 \&\& chmod \1 \3/g' Makefile
fallback_auto_fix:      false
fallback_impl:          makefile-modify

# 禁止策略
forbid_1_pattern:       apt-get install.*coreutils|yum install.*coreutils
forbid_1_reason:        OpenHarmony 不是标准 Linux 发行版，不支持 apt/yum 包管理器
forbid_1_consequence:   命令执行失败，无法解决问题

# Layer 4: 原则引用
principles:             P-PLATFORM-001

# 关系图
causes:                 []
caused_by:              []
similar_to:             [E001, E080]
conflicts_with:         []
prerequisite_of:        []

# 元数据
doc_file:               doc/E105.md
last_updated:           2026-05-27
source_event:           incron 0.5.12 安装（2026-05-26）

