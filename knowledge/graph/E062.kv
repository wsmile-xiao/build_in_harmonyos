#====================================================================
# E062.kv — FLEXIBLE_ARRAY_MEMBER 未定义
#====================================================================

id:                     E062
title: FLEXIBLE_ARRAY_MEMBER 未定义
trigger_tool:           cc|clang|make
phase:                  compilation
error_signature:        FLEXIBLE_ARRAY_MEMBER.*undeclared|use of undeclared identifier.*FLEXIBLE_ARRAY_MEMBER|
                         flexible array member.*not defined

severity:               2
category:               gnulib|c99|compat|headers
match_keywords:         FLEXIBLE_ARRAY_MEMBER, FAM, flexmember, gnulib, C99,
                         dfa.h, xalloc.h, include order, sed, undeclared identifier

root_cause:             C99 的灵活数组成员(Flexible Array Member)在某些平台上需要宏定义。
                         gnulib 的 flexmember.h 提供可移植实现, 但如果头文件包含顺序错误或
                         gnulib 检测失败(通常由 E064 conftest 失败导致), 该宏未被定义
affected_scope:         使用 gnulib FAM 的软件(sed 4.9 等)
verification_cmd:       grep FLEXIBLE_ARRAY_MEMBER config.h

rec_priority:           1
rec_approach:           add-cflags-or-fix-include
rec_description:        方案1: export gl_cv_flexmember=yes 让 configure 正确检测;
                         方案2: 在受影响 .c 文件顶部添加 #include 缺失头文件或手动定义宏
rec_command:            export gl_cv_flexmember=yes
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:
principles:

causes:                 [E064]
caused_by:              []
similar_to:             [E061,E065]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E062.md
last_updated:           2026-04-10
source_event:           archives/s/sed/4.9/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
