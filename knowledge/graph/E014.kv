#====================================================================
# E014.kv — 系统调用不可用
#====================================================================

id:                     E014
title: 系统调用不可用
trigger_tool:           ld|clang|configure
phase:                  linking|compilation
error_signature:        undefined reference.*syslog|
                         undefined reference.*getrandom|
                         undefined reference.*unimplemented

severity:               2
category:               syscall|compat
match_keywords:         syslog, getrandom, unimplemented, syscall,
                         NO_SYSLOG, -DNO_, disable feature,
                         undefined reference, not available

root_cause:             鸿蒙内核未实现某些 POSIX 系统调用,
                         或 musl 未导出对应符号(syslog/getrandom 等)
affected_scope:         使用 syslog 日志、getrandom 随机数等 API 的项目
verification_cmd:       nm -D /usr/lib/libc.so | grep -E "syslog|getrandom"

rec_priority:           1
rec_approach:           add-cflags-disable
rec_description:        通过 -D 宏禁用不可用的功能模块
rec_command:            CFLAGS="-DNO_SYSLOG $CFLAGS"
rec_auto_fix:          true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      source-patch-hilog
fallback_description:  用鸿蒙 hilog 接口替代 syslog (OH_LOG_INFO/HiLogInfo)
fallback_auto_fix:     false
fallback_impl:          none

forbid_1_pattern:
principles:

causes:                 []
caused_by:              []
similar_to:             [E020]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E014.md
last_updated:           2026-04-09
resolved_in:            HongMeng Kernel 1.12.0
resolved_note:          getrandom() 和 syslog() 系统调用已在 musl/libc 中正确导出，可正常调用
source_event:           多个构建事件
