#====================================================================
# E043.kv — activate.sh 中 ${BASH_SOURCE} 在 HiShell 不可用
#====================================================================

id:                     E043
trigger_tool:           shell|runtime
phase:                  runtime
error_signature:        BASH_SOURCE.*empty|PYTHON_DIR.*empty|
                         environment variable.*not set.*activate

severity:               1
category:               shell|compat|portability
match_keywords:         BASH_SOURCE, toybox ash, HiShell, activate.sh,
                         $0, dirname, shell script, POSIX, bashism

root_cause:             鸿蒙 HiShell 的 /bin/sh 是 toybox ash,
                         不支持 bash 特有的 ${BASH_SOURCE} 变量。
                         脚本中 $(dirname "${BASH_SOURCE[0]}") 返回空值, 导致 PYTHON_DIR 为空
affected_scope:         所有使用 ${BASH_SOURCE} 的 shell 脚本 (Python activate.sh 等)
verification_cmd:       echo "${BASH_SOURCE[0]}"  # 输出为空 (toybox ash 下)

rec_priority:           1
rec_approach:           source-patch
rec_description:        POSIX 兼容方式: "$(cd "$(dirname "$0")" && pwd)" 替代
                         "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
rec_command:
rec_auto_fix:          true
rec_impl:               batch-sed

forbid_1_pattern:      在目标平台为鸿蒙的 shell 脚本中使用 ${BASH_SOURCE} 或 ${BASH_SOURCE[0]}
forbid_1_reason:       toybox ash 不支持该变量, 结果为空, 导致所有基于脚本路径的逻辑失效
forbid_1_consequence:  环境变量为空, PATH/LD_LIBRARY_PATH/PYTHONHOME 全部指向错误路径
fallback_priority:      2
fallback_approach:      manual-workaround
fallback_description:   如果自动补丁不适用，手动在源码中做最小兼容修改并记录到 notes.md
fallback_command:      # 手动编辑源码后记录:
# 1. 修改文件列表
# 2. 修改原因
# 3. 验证方式
fallback_auto_fix:     false
fallback_impl:          manual
principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        [E044]

doc_file:               doc/E043.md
last_updated:           2026-04-10
source_event:           archives/s/python/3.9.0/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
