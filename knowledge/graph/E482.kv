#====================================================================
# E290-draft — zsh heredoc 在 /tmp 只读时失败（需设置 TMPPREFIX）
#====================================================================
id:                     E482
trigger_tool:           zsh|bash|sh
phase:                  configuration|compilation|testing
error_signature:        can't create temp file for here document|read-only file system|here document
severity:               2
category:               environment
match_keywords:         heredoc, here document, TMPPREFIX, zsh, TMPDIR, read-only, zsh daemon
title:                  zsh heredoc 用 $TMPPREFIX（默认 /tmp/zsh）创建临时文件，/tmp 只读时失败

root_cause:             鸿蒙系统 /tmp 是只读，而 zsh 的 heredoc（<<'EOF'）临时文件目录由
                        $TMPPREFIX 决定（默认 /tmp/zsh），**不随 $TMPDIR 变化**。
                        只设 TMPDIR 无法解决 zsh heredoc 失败；症状是脚本静默退出
                        （set -e 下），报 "can't create temp file for here document: read-only file system"。
affected_scope:         所有用 zsh 脚本跑 heredoc 的构建/CI（如 build_and_test.sh 的 python3 heredoc）
verification_cmd:       在 zsh 里跑一段 heredoc；或检查 zsh -c 'echo $TMPPREFIX'

rec_priority:           1
rec_approach:           set-env-var
rec_description:        同时设置 TMPDIR 与 TMPPREFIX 指向可写目录
rec_command:            TMPDIR=$HOME/tmp TMPPREFIX=$HOME/tmp/zsh zsh build_and_test.sh
rec_auto_fix:          true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      env-var
fallback_description:   在脚本开头 export TMPPREFIX=/storage/Users/currentUser/tmp/zsh
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:              P014

causes:                 []
caused_by:              [E002]
similar_to:             [E002]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E290.md
source_pr: !5848
last_updated: 2026-08-20
source_event:           opencascade 7.9.2 W3 本地 CI 模拟（build_and_test.sh L0i python3 heredoc）
