#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E100.kv，填写各字段
# 对应的人类文档: doc/E100.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E159
trigger_tool:           cmake
phase:                  configuration
error_signature:        CMake Error: TRY_RUN\\(.*\\) failed to compile|cannot run test executables on this platform|The test executable was not built|TRY_RUN not supported in cross-compiling mode

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               cmake, cross-compile
match_keywords:         TRY_RUN, cross-compiling, cmake, configuration, cache file

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             CMake 检测到交叉编译模式(CMAKE_SYSTEM_NAME != host)时，TRY_RUN() 宏会尝试编译并运行测试程序，但目标平台二进制无法在宿主机执行
affected_scope:         使用 CMake 构建且检测为交叉编译的所有软件，特别是 OHOS/musl 平台
verification_cmd:       grep -r "TRY_RUN" CMakeLists.txt && cmake --system-information | grep CMAKE_SYSTEM_NAME

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           cmake-cache-preset
rec_description:        创建 TryRunResults-<platform>.cmake 缓存文件，预先设置所有 TRY_RUN 变量的结果值，避免实际执行测试程序
rec_command:            cmake -C TryRunResults-ohos.cmake -DCMAKE_SYSTEM_NAME=Linux ..
rec_auto_fix:           false
rec_impl:               manual-cache-file

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      disable-cross-compile-mode
fallback_description:   使用 CMAKE_SYSTEM_NAME=Linux（而非 OHOS），让 CMake 认为是本地编译，避免 TRY_RUN 限制
fallback_command:       cmake -DCMAKE_SYSTEM_NAME=Linux ..
fallback_auto_fix:      true
fallback_impl:          auto-system-name

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       CMAKE_SYSTEM_NAME=OHOS
forbid_1_reason:        OHOS 不是 CMake 标准平台名，会触发未知平台警告和更多交叉编译限制
forbid_1_consequence:   配置失败或需要更多手动修复
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:               

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E159.md
last_updated: 2026-05-20
source_event:           hdf5-1.13.0 cmake configuration


