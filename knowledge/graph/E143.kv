id: E143
title: bscalc Python 脚本在 HarmonyOS 上受限：ctypes dlopen 权限拒绝 + shebang 不存在
trigger_tool:           runtime|python
phase:                  runtime
error_signature:        /usr/bin/python3: no such file or directory|
                         ctypes.CDLL.*Permission denied|
                         OSError.*Error loading shared library.*Permission denied|
                         bad interpreter.*python3

severity:               2
category:               platform-runtime
match_keywords:         bscalc, ctypes, dlopen, Permission denied,
                         Python shebang, /usr/bin/python3,
                         PYTHONPATH, bytesize module

root_cause:             bscalc 是 Python 脚本（#!/usr/bin/python3），HarmonyOS 上 /usr/bin/python3 不存在；且 bytesize.py 通过 ctypes.CDLL("libbytesize.so.1") 加载共享库时，HarmonyOS 动态链接器拒绝非系统信任路径的未签名库
affected_scope:         所有通过 Python ctypes dlopen 加载自定义共享库的脚本工具
verification_cmd:       /data/service/hnp/bin/python -c "import ctypes; ctypes.CDLL('/path/to/lib.so')" 2>&1

rec_priority:           1
rec_approach:           fix-shebang-plus-env
rec_description:        1) 修改 bscalc shebang 为 /data/service/hnp/python.org/python_3.12/bin/python3.12；2) 设置 PYTHONPATH 和 LD_PRELOAD 环境变量运行
rec_command:            PYTHONPATH=$PREFIX/lib/python3.12/site-packages LD_PRELOAD=$PREFIX/lib/libintl_glib.so /data/service/hnp/bin/python /path/to/bscalc
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      wrapper-script
fallback_description:   创建 wrapper 脚本设置环境变量后调用 bscalc
fallback_command:       echo 'PYTHONPATH=... LD_PRELOAD=... python3.12 /usr/local/bin/bscalc' > /usr/local/bin/bscalc.sh
fallback_auto_fix:      false

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:             []

causes:                 []
caused_by:              [E085]
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E086.md
last_updated: 2026-06-02
source_event:           libbytesize-2.11-functional-test

draft: false
contributor_id: 0DCD

