# Knowledge draft — calc musl fpos_t position tracking (已修复)
# Layer 0: 错误面
id:                     E414
trigger_tool:           make check
phase:                  testing
error_signature:        search.*!=.*failed|ftell.*big.*value|fopen.*wb.*failed|fpos_t.*struct|file.*position.*tracking

# Layer 1: 识别层
severity:               2
category:               musl, file-position, fpos-t, regression-test
match_keywords:         calc, fpos_t, fseeko, ftello, file-position, musl, HarmonyOS, regress.cal, fgetpos, fsetpos

# Layer 2: 诊断层
root_cause:             在 HarmonyOS musl libc 上，fpos_t 是 struct { off_t __pos; mbstate_t __state; }，
                        而 calc 的 f_tell/f_seek_set 宏按整数类型处理 fpos_t（FILEPOS 类型），
                        导致 fgetpos/fsetpos 返回的 struct 数据被解释为巨大整数，
                        造成 ftell 返回乱码（例：7170310590227061835506233901086），
                        文件位置跟踪（search、fseek 等）全部失效。
                        文件内容读写（fgetline、fgets、fputs）不受影响。
affected_scope:         所有使用 fpos_t 作为整数类型的文件位置跟踪调用。
                        具体表现为 calc 的 fsearch 函数（file.c:2639）和
                        f_tell/f_seek_set 宏。
verification_cmd:       |
  calc -q -f test_package/test_fpos.cal
  # 修复前输出：PASS 6  FAIL 7（含 ftell 巨大乱码）
  # 修复后输出：PASS 13 FAIL 0, TEST_FPOS_PASSED

# Layer 3: 方案层 ★（已修复）
rec_priority:           1
rec_approach:           source-patch
rec_description:        将 FILEPOS 类型从 fpos_t 改为 off_t（64 位整数），
                        f_tell/f_seek_set 宏从 fgetpos/fsetpos 改为 ftello/fseeko。
                        涉及两个补丁：
                        1) have_fgetsetpos.c: typedef off_t FILEPOS（替代 typedef fpos_t FILEPOS）
                        2) file.h: 使用 ftello/fseeko 替代 fgetpos/fsetpos
                        补丁位置：archives/c/calc/2.15.1.0/patches/
rec_command:            patch -p1 < patches/0001-have-fgetsetpos-use-off_t-instead-of-fpos_t.patch
                        patch -p1 < patches/0002-file-h-use-ftello-fseeko-over-fgetpos-fsetpos.patch
rec_auto_fix:           true

fallback_priority:      2
fallback_approach:      skip-test
fallback_description:   在 HarmonyOS 上标记文件位置相关测试为已知失败，跳过执行。
                        类似 Debian 跳过 tty 依赖测试 951/5984 的做法。
fallback_command:       在 regress.cal 调用 test_fileop() 处添加条件跳过
fallback_auto_fix:      false

forbid_1_pattern:       忽略 ftell 乱码继续依赖文件位置跟踪
forbid_1_reason:        fpos_t 结构体兼容性是系统级差异，不会因重试而改变
forbid_1_consequence:   文件位置跟踪持续返回错误，所有依赖文件位置的测试失败

# 修复证据

# 元数据
rec_impl:               manual
doc_file: doc/E414.md

