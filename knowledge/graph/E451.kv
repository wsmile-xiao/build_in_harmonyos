#====================================================================
# E2162 — 消费 clang/LLVM 包时 find_package(Clang) 被 CMakeDeps 生成的
# ClangConfig 遮蔽，clangIndex/clang-cpp 等目标找不到
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E451
trigger_tool: conan|conan-verify|conan create|CMake
phase:                  configuration|compilation|linking
error_signature: Target "ccls" links to target "clangIndex" but the target was not found|No rule to make target.*clangIndex|clangIndex.*not found|find_package\(Clang\).*target.*not found|CLANG_LINK_CLANG_DYLIB.*not defined

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, cmake, conan
match_keywords:         find_package(Clang), CMakeDeps, CMakeToolchain, CMAKE_PREFIX_PATH,
                        ClangConfig.cmake, LLVMConfig.cmake, clangIndex, clang-cpp,
                        CLANG_LINK_CLANG_DYLIB, LLVM_LINK_LLVM_DYLIB, rapidjson,
                        RapidJSON_INCLUDE_DIRS, cmake_find_mode, LLVMVersionMajor
title:                  消费 clang/LLVM 包时用 CMakeDeps 导致自带 ClangConfig 被遮蔽，clang 组件目标找不到

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             CMake 工程（如 ccls）需要 find_package(Clang REQUIRED) 解析到 clang 包自带的
                        LLVM ClangConfig.cmake（定义 clangIndex/clangFormat/clangTooling 等组件目标，
                        并设置 CLANG_LINK_CLANG_DYLIB=ON -> 链接 clang-cpp、LLVM_LINK_LLVM_DYLIB=ON ->
                        链接 LLVM 聚合库）。但 conanfile 若同时生成 CMakeDeps，CMakeToolchain 生成的
                        toolchain 会把 CMakeDeps 输出目录 PREPEND 到 CMAKE_PREFIX_PATH，CMakeDeps 生成的
                        ClangConfig.cmake（只定义 clang::clang 聚合目标、无组件目标、无 *_DYLIB 变量）
                        会遮蔽包内自带的 LLVM ClangConfig.cmake，导致链接 clangIndex/... 报 target 不存在。
                        clang 包自身是 cmake_find_mode=config（包内含 lib/cmake/clang + lib/cmake/llvm）。
                        另注意 rapidjson 包自带 config 只设 RapidJSON_INCLUDE_DIR（无 S），下游 CMakeLists
                        若读 RapidJSON_INCLUDE_DIRS 变量会拿到空值导致 rapidjson 头找不到。
affected_scope:         HarmonyOS PC 上所有链接 LLVM/clang 库的 CMake 工程（language server、静态分析器、
                        编译器前端等）
verification_cmd:       grep -E "Clang_DIR|LLVM_DIR" build/CMakeCache.txt 检查是否指向 clang 包内
                        lib/cmake/clang；grep CLANG_LINK_CLANG_DYLIB build/CMakeCache.txt

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           cmake-only-cmake-toolchain     # 只用 CMakeToolchain，不用 CMakeDeps
rec_description:        conanfile generate() 只生成 CMakeToolchain，显式把依赖包目录写入
                        CMAKE_PREFIX_PATH，find_package(Clang)/find_package(RapidJSON) 即命中
                        包内自带的 LLVM/RapidJSON config；CMakeLists 需要的 *_INCLUDE_DIRS 变量显式补齐
rec_command:            tc = CMakeToolchain(self); tc.variables["CMAKE_PREFIX_PATH"] = ";".join(
                        [self.dependencies["clang"].package_folder,
                         self.dependencies["rapidjson"].package_folder]);
                        tc.variables["RapidJSON_INCLUDE_DIRS"] =
                        os.path.join(rapidjson_pkg, "include"); tc.generate()
rec_auto_fix:           true
rec_impl:               cmake-prefix-path-to-package-config

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      cmakedeps-patch-generated-config
fallback_description:   仍用 CMakeDeps 时，在 generate() 里删除/覆盖生成的 ClangConfig.cmake，
                        或把 clang 包目录 prepend 到 CMakeDeps 输出之前
fallback_command:       （不推荐）generate() 中手动 rm CMakeDeps 生成的 ClangConfig* 并
                        调整 CMAKE_PREFIX_PATH 顺序
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       CMAKE_PREFIX_PATH.*conanbuild|conandeps_legacy|CMakeDeps.*ClangConfig
forbid_1_reason:        toolchain 已把 CMakeDeps 输出目录 prepend 到 CMAKE_PREFIX_PATH，
                        再手动加路径无法抵消遮蔽
forbid_1_consequence:   遮蔽依旧存在，clangIndex 等目标仍然找不到
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E216, E221, E300]
conflicts_with:         []
prerequisite_of:        []

