# Layer 0: 错误面
id: E169
trigger_tool:           clang|clang++|gcc|g++
phase:                  compilation
error_signature:        fatal error: 'argp\.h' file not found|argp\.h: No such file or directory

# Layer 1: 识别层
severity:               3
category:               missing-header|platform-limitation
match_keywords:         argp.h, fatal error, file not found, GNU argp, command-line parsing

# Layer 2: 诊断层
root_cause:             OpenHarmony 系统缺少 GNU argp.h 头文件。argp.h 是 GNU C 库的一部分，
                        用于命令行参数解析，但 OpenHarmony 使用 musl libc，不包含此头文件。
                        需要安装 argp-standalone 库或手动安装相关文件。
affected_scope:         使用 GNU argp 进行命令行参数解析的项目（如 incron, util-linux 部分工具）
verification_cmd:       test -f ~/usr/local/include/argp.h && echo "argp.h exists" || echo "argp.h missing"

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           install-prebuilt-package
rec_description:        安装 argp-standalone 预编译包（包含 argp.h 和 libargp.a）
rec_command:            curl -k -LO https://example.com/argp-standalone-1.5.0-ohos-aarch64.tar.gz &&
                        tar -xzf argp-standalone-1.5.0-ohos-aarch64.tar.gz -C ~/usr/local
rec_auto_fix:           false
rec_impl:               package-install

fallback_priority:      2
fallback_approach:      compile-from-source
fallback_description:   从源码编译 argp-standalone 库（需要预先存在的 argp.h 或使用替代方案）
fallback_command:       cd ~/tmp/builds && curl -k -LO https://github.com/argp-standalone/argp-standalone/archive/refs/tags/1.5.0.tar.gz &&
                        tar -xzf 1.5.0.tar.gz && cd argp-standalone-1.5.0 &&
                        ./configure --prefix=$HOME/usr/local && make && make install
fallback_auto_fix:      false
fallback_impl:          manual-compile

# 禁止策略
forbid_1_pattern:       apt-get install.*argp|yum install.*argp
forbid_1_reason:        OpenHarmony 不是标准 Linux 发行版，不支持 apt/yum 包管理器
forbid_1_consequence:   命令执行失败，无法解决问题

# Layer 4: 原则引用
principles:               

