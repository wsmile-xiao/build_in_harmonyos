#====================================================================
# DRAFT-gtkmm-4.0-ohos-display-adaptation.kv — GUI 绑定库在无显示服务器
#   环境（OHOS 无 X11/Wayland/EGL）的测试分类与验证边界：
#   显示依赖测试 vs 无显示 API 测试的区分、failing suite 排除、
#   fontconfig 注入、无显示 API 探针与统计口径
#   实例：gtkmm 4.0.0（archives/g/gtkmm/4.0.0），r3/r4 真实证据
#   stem/ID：DRAFT-gtkmm-4.0-ohos-display-adaptation（与配对 .md 相同）
#====================================================================

# --- frontmatter 检索字段 ---

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E471
trigger_tool:       meson-test|gtk_init|runtime|broadwayd
phase:              testing,runtime
error_signature:    Failed to open display|
                    Gtk-WARNING.*Failed to open display|
                    Fontconfig error: Cannot load default config file|
                    gtk_init.*failed|
                    gtk4-broadwayd.*Operation not permitted|
                    exit status 1.*display

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:           3
category:               platform, meson, testing, binding, display
match_keywords:     gtkmm, gtk_init, gdk_rgba, Gdk::RGBA, Gdk::Rectangle,
                    Failed to open display, FONTCONFIG_FILE, FONTCONFIG_PATH,
                    fonts.conf, failing suite, --no-suite=failing,
                    broadwayd, broadway, display server, GUI binding,
                    test classification, headless, no display

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:         OHOS PC 无任何原生显示后端；gtkmm 4.0.0 tests/meson.build
                    的「可执行测试」(execute=true) 与「GUI 测试」标志不等价——
                    4 个 execute=true 测试中 3 个仍调用 gtk_init()（需显示服务
                    器），无显示环境下 gtk_init() 失败、进程 exit 1；gtk_init()
                    前置 fontconfig 在无 /etc/fonts/fonts.conf 的 OHOS 上也失败；
                    提供显示服务的 gtk4-broadwayd 在 OHOS 因签名约束不可执行
                    (EPERM)。这些是真实显示依赖而非库缺陷，需按显示依赖分类，
                    不能写成库测试失败或强行 headless 假装通过。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:       1
rec_approach:       display-test-classification-and-no-display-api-probes
rec_description:    ① tests/meson.build 把真实调用 gtk_init()/建窗口的测试标记
                    failing suite（suite:['failing']），CI/构建统一
                    meson test --no-suite=failing 排除并记录真实原因（glibmm
                    E215 同款）；② build() 运行 meson test 前注入 fontconfig
                    包真实配置 FONTCONFIG_FILE/PATH（否则无显示 API 测试也因
                    fonts.conf 缺失失败）；③ 新增不依赖显示器的公开 API 探针
                    （Gdk::RGBA set_rgba_u/get_red_u、Gdk::Rectangle、sigc++-3.0
                    连接）作为鸿蒙特有测试并单独统计；④ 显示依赖测试不可运行
                    （broadwayd EPERM）时如实记录「需 Broadway 服务或真实显示
                    环境」，禁止跳过填 100% 或将 EPERM 写成构建失败。
rec_command:        |
  # tests/meson.build（0003 补丁同款）
  if ex[4]
    if ex_name in ['bitset_iterator_test', 'object_move_test', 'tree_model_iterator_test']
      test(ex_name, exe_file, suite: ['failing'])
    else
      test(ex_name, exe_file)
    endif
  endif
  # conanfile.py build()（fontconfig 注入）
  #   os.environ["FONTCONFIG_FILE"] = f"{fontconfig_pkg}/etc/fonts/fonts.conf"
  #   os.environ["FONTCONFIG_PATH"] = f"{fontconfig_pkg}/etc/fonts"
  # 测试运行：
  #   meson test -v -C {build} --timeout-multiplier=16 --no-rebuild --no-suite=failing
  #   测试统计口径：真实运行 / 显示依赖不可运行(failing 排除) / 构建但不执行
rec_auto_fix:       true
rec_impl:           recipe-options+patch(test/meson.build)

# ═══ Layer 4: 验证层 (Verification) ═══
# 适用边界 (Applicability Boundary)

# --- 关联边界与查重说明 ---
doc_file: doc/E471.md
affected_scope: >
  platform, meson, testing, binding, display 场景（关键词: gtkmm, gtk_init, gdk_rgba, Gdk::RGBA, Gdk::Rectangle, Failed to open display, FONTCONFIG_FILE, FONTC）。根因: OHOS PC 无任何原生显示后端；gtkmm 4.0.0 tests/meson.build 的「可执行测试」(execute=true) 与「GUI 测试」标志不等价—— 4 个 execute=true 测试中 3 个仍调用 gtk_

