#====================================================================
# E096-draft-0D0A.kv — Rust 工具链不可用
# 创建者: 0D0A
# 创建日期: 2026-05-09
# 来源事件: gleam 1.13.0-r0 编译失败
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E154
trigger_tool:           cargo|rustc|make|configure
phase:                  configuration|compilation
error_signature:        rustc not found|cargo not found|command not found: rustc|command not found: cargo|unrecognized OS type: HarmonyOS|no such file: Cargo.toml parser

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               toolchain|platform|rust
match_keywords:         rustc, cargo, rustup, Rust, Cargo.toml, unrecognized OS type
title:                  Rust 工具链不可用 — HarmonyOS 不在 Rust 官方支持平台

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HarmonyOS 不在 Rust 官方支持平台列表中, rustup 无法识别操作系统类型, 且系统中未预装 Rust/Cargo 工具链
affected_scope:         所有 Rust 项目 (使用 Cargo.toml 构建的软件), 包括 gleam, ripgrep, fd, bat 等
verification_cmd:       which rustc && which cargo && rustc --version && cargo --version

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           install-rust-prebuilt
rec_description:        安装预编译的 Rust 工具链包 (需先将其加入 cmd-pkgs 仓库)
rec_command:            curl -fsSL https://gitcode.com/OpenHarmonyPCDeveloper/cmd-pkgs/releases/download/pkgs/install.sh | sh -s -- rust 1.81.0
rec_auto_fix:           false
rec_impl:               manual-install

fallback_priority:      2
fallback_approach:      download-rust-tarball
fallback_description:   从 rust-lang.org 下载预编译 tarball (约 465MB, 速度极慢)
fallback_command:       curl -L -o rust.tar.gz https://static.rust-lang.org/dist/rust-1.81.0-aarch64-unknown-linux-gnu.tar.gz && tar xf rust.tar.gz && ./rust-1.81.0-aarch64-unknown-linux-gnu/install.sh --prefix=$HOME/usr/local
fallback_auto_fix:      false
fallback_impl:          manual-download

# ★ 禁止策略 ★
forbid_1_pattern:       rustup.*sh.*--default-toolchain
forbid_1_reason:        rustup 不支持 HarmonyOS, 执行会报错 "unrecognized OS type: HarmonyOS"
forbid_1_consequence:   安装失败, 浪费时间

forbid_2_pattern:       cargo build.*--release.*make install
forbid_2_reason:        没有 Rust 工具链, cargo build 无法执行
forbid_2_consequence:   编译阻塞, 任务无法继续

# ═══ Layer 4: 原则引用 ═══
principles:             P-TOOLCHAIN-001

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E001, E012]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E096.md
