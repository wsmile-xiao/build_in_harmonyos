#====================================================================
# E057.kv — regrtest 默认多 worker 导致并发竞态
#====================================================================

id:                     E057
trigger_tool:           python|testing
phase:                  testing
error_signature:        regrtest.*parallel.*worker|load avg.*high|
                         locale was modified by test|flaky.*re-run|cpu_count

severity:               1
category:               python|testing|concurrency
match_keywords:         regrtest, parallel worker, cpu_count, MAKEFLAGS,
                         TESTOPTS, -j, load average, global state pollution, flaky

root_cause:             regrtest 默认按 os.cpu_count() 开启 worker(鸿蒙=18),
                         与 MAKEFLAGS=-j1 独立: make 编译串行化(必需,FIFO 限制),
                         但 regrtest 测试仍并行, 导致全局状态污染和资源争用
affected_scope:         Python regrtest 测试框架运行
verification_cmd:       python3 -c "import os; print(os.cpu_count())"  # 鸿蒙上通常=18

rec_priority:           1
rec_approach:           env-var-override
rec_description:        显式限制 regrtest worker 数为 1:
                         MAKEFLAGS="-j1" make test TESTOPTS="-j1 --ignore=smtpnet ..."
rec_command:            MAKEFLAGS="-j1" make test TESTOPTS="-j1"
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:
principles:

causes:                 []
caused_by:              []
similar_to:             [E046,E047,E048,E055]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E057.md
last_updated:           2026-04-10
source_event:           archives/p/python/3.9.0/manifest.yaml
