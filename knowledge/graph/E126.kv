#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E081.kv，填写各字段
# 对应的人类文档: doc/E081.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E126
trigger_tool:           configure
phase:                  configuration
error_signature:        can't create ./conf[a-zA-Z0-9]+/subs[0-9]+\.awk: Permission denied|config\.status.*Permission denied|HMDFS.*temporary file

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               platform_limitation
match_keywords:         HMDFS, config.status, Permission denied, temporary file, autotools

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             HarmonyOS HMDFS 文件系统不支持 GNU autotools 的 config.status 创建临时目录和文件（confXXXX/subs1.awk 等），导致 configure 生成的 config.status 无法执行
affected_scope:         所有使用 GNU autoconf 的软件编译，包括 MPFR、GMP、openssl 等 autotools 项目
verification_cmd:       df -h ~/tmp | grep hmdfs

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           use_precompiled_package          # 见 DESIGN §5 impl 列表
rec_description:        使用预编译包替代手动编译（R18 预编译包优先原则）
rec_command:            curl -fsSL https://gitcode.com/OpenHarmonyPCDeveloper/cmd-pkgs/releases/download/pkgs/install.sh | sh -s -- {software} {version}
rec_auto_fix:           true                  # 引擎能否自动执行
rec_impl:               install_precompiled                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      use_cmake_alternative
fallback_description:   使用 CMake 构建系统替代 autotools（如果软件支持）
fallback_command:       cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$DEFAULT_PREFIX ..
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       HMDFS|/storage/Users/currentUser/tmp|~/tmp
forbid_1_reason:        HMDFS 文件系统不支持 autotools 临时文件操作，在这些目录编译 autotools 项目必定失败
forbid_1_consequence:   编译失败，浪费时间调试无法解决的平台限制

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:               

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E126.md
last_updated: 2026-05-30
source_event:           MPFR 4.2.1 编译失败（config.status 无法创建临时文件）


