#====================================================================
# E047.kv — 文件权限 other-read bit 被额外屏蔽
#====================================================================

id:                     E047
trigger_tool:           python|runtime|testing
phase:                  runtime|testing
error_signature:	 assertionError.*440.*413|assertionError.*432.*292|
                         file permission.*other.*read.*masked|mode.*diff.*004

severity:               1
category:               filesystem|testing|hmdfs
match_keywords:         other-read, 0o004, umask, file permission, HMDFS,
                         assertion error, test_dbm_dumb, test_uu, mode diff

root_cause:             HarmonyOS 文件系统(HMDFS)在文件创建时会额外清除
                         "other read" 权限位(0o004), 与 umask 设置无关
affected_scope:         Python 测试中断言精确文件权限的测试 (test_dbm_dumb, test_uu 等)
verification_cmd:       python3 -c "
import os, tempfile, stat
old = os.umask(0o022)
tmpf = tempfile.NamedTemporaryFile(delete=False); tmpf.write(b'test'); tmpf.close()
mode = stat.S_IMODE(os.stat(tmpf.name).st_mode)
print(f'got {oct(mode)}, expected {oct(0o644)}, diff {oct(0o644-mode)}')
os.unlink(tmpf.name); os.umask(old)
"

rec_priority:           1
rec_approach:           relax-assertion
rec_description:        放宽权限断言容差: 在鸿蒙上允许 other-read 位差异
                         expected_mode &= ~0o004
rec_command:
rec_auto_fix:          true
rec_impl:               source-patch

forbid_1_pattern:
principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E047.md
last_updated:           2026-04-10
source_event:           archives/s/python/3.9.0/manifest.yaml

