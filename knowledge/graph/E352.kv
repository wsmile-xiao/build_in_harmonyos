#====================================================================
# E324 draft - Pure Lua 5.1 module packaging and target-side validation
# Source package: acf-lib-lua5.1/0.11.1
#====================================================================

id:                     E352
trigger_tool:           conan|lua|test
phase:                  packaging|runtime|testing
error_signature:        module '.*' not found|no file '.*/share/lua/5\.1/.*\.lua'|cannot open .*\.lua|attempt to call .* nil value

severity:               2
category:               hmdfs, lua, conan, packaging, target-validation
match_keywords:         pure Lua, Lua 5.1, LUA_PATH, share/lua/5.1, require, compatibility module, HMDFS, symlink, test_package
title:                  Pure Lua 5.1 modules need interpreter-aware layout and target-side require validation

root_cause:             Pure Lua modules are executable interpreter resources rather than opaque data files.
                        A generic data-only recipe can preserve files while still breaking the Lua contract:
                        versioned module roots may be absent from LUA_PATH, legacy top-level require names may
                        depend on upstream symlinks that HMDFS cannot follow, and host-only file checks do not
                        prove that the target Lua 5.1 interpreter can parse and execute the packaged modules.
affected_scope:         Pure Lua 5.1 packages whose upstream install rules place modules below a namespace,
                        expose compatibility names through symlinks, have no formal test suite, or contain
                        optional runtime integrations that are unavailable as OHOS Conan dependencies.
verification_cmd:       CI_PACKAGES="archives/a/acf-lib-lua5.1/0.11.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           lua-module-dual-layout-target-require
rec_description:        Declare all four OHOS profile settings and clear them only in package_id; validate an
                        exact non-empty module inventory; install real file copies under both the namespaced
                        and compatibility module paths; publish a versioned LUA_PATH through Conan buildenv/runenv;
                        then compile or obtain the target Lua interpreter and execute require plus behavior
                        assertions against the packaged files. Keep optional-dependency stubs in test_package
                        only and prove that they drive the real packaged module.
rec_command:            conan create archives/a/acf-lib-lua5.1/0.11.1 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      namespaced-layout-only
fallback_description:  If upstream does not promise top-level compatibility imports, install only the canonical
                        namespace and test every documented require name; do not invent compatibility aliases.
fallback_command:       lua -e "assert(require('package.namespace'))"
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       ln -s .*share/lua|os\.symlink\(.*share/lua
forbid_1_reason:        HMDFS may preserve a link entry but fail to resolve it, so compatibility require names become runtime-only failures.
forbid_1_consequence:   File inventory checks can pass while Lua reports module not found on the HarmonyOS target.

forbid_2_pattern:       test.*exists.*\.lua|host.*lua.*require
forbid_2_reason:        Existence checks and host-interpreter tests do not prove target Lua version compatibility or packaged-module execution.
forbid_2_consequence:   Syntax, module search path, dependency loading, and behavior regressions can reach consumers undetected.

principles:             P016

causes:                 []
caused_by:              []
similar_to:             [E050,E132,E216,E241]
conflicts_with:         []
prerequisite_of:        []

