#====================================================================
# E029.kv — bash 内置 malloc 与 musl 不兼容
#====================================================================

id:                     E029
trigger_tool:           configure|runtime
phase:                  configuration|runtime
error_signature:        memory.*abnormal|malloc.*incompatible|
                         bash-malloc.*musl|runtime.*memory error

severity:               2
category:               libc|compat|memory
match_keywords:         bash, malloc, musl, incompatible, --without-bash-malloc,
                         memory management, runtime crash, glibc allocator

root_cause:             bash 默认使用内置 malloc 实现,
                         与 musl libc 的内存管理机制不兼容,
                         导致运行时出现内存异常(编译不报错)
affected_scope:         bash 及其他有内置 malloc 替代的项目
verification_cmd:       ./configure --help | grep bash-malloc; ldd $(which bash) | grep musl

rec_priority:           1
rec_approach:           configure-disable-feature
rec_description:        禁用内置 malloc, 使用系统(musl)的 malloc
rec_command:            ./configure --without-bash-malloc --prefix=$HOME/usr/local
rec_auto_fix:          true
rec_impl:               reconfigure

forbid_1_pattern:
principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E029.md
last_updated:           2026-04-09
source_event:           archives/b/bash/5.3/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
