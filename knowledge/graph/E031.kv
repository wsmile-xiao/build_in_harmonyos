#====================================================================
# E031.kv — /proc 文件系统 SELinux 访问限制
#====================================================================

id:                     E031
trigger_tool:           htop|runtime
phase:                  runtime
error_signature:        Cannot open /proc/stat.*Permission denied|
                         /proc/.*Permission denied.*selinux

severity:               2
category:               selinux|filesystem|runtime
match_keywords:         /proc, Permission denied, SELinux, htop,
                         proc/stat, proc/meminfo, cannot open

root_cause:             鸿蒙 SELinux 策略限制普通用户访问 /proc 文件系统,
                         导致读取 /proc/stat、/proc/meminfo 等失败
affected_scope:         htop 及其他直接读取 /proc 的运行时工具
verification_cmd:       cat /proc/stat  # Permission denied

rec_priority:           1
rec_approach:           sudo-run
rec_description:        使用 sudo 运行程序, 继承终端环境变量
rec_command:            sudo -E TERM=xterm-256color htop
rec_auto_fix:          false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      skip-proc-reading
fallback_description:   对于自定义工具, 改用 sysinfo() 等 syscall 替代 /proc 解析
fallback_auto_fix:     false

forbid_1_pattern:
principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E031.md
last_updated:           2026-04-10
source_event:           archives/s/htop/3.4.1/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

