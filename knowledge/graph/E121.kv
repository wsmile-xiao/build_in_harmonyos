#====================================================================
# E081.kv — OHOS 缺少 utmpx API
# 对应的人类文档: doc/E081.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E121
trigger_tool:           ld|clang
phase:                  linking
error_signature:        undefined symbol: setutxent|undefined symbol: pututxline|undefined symbol: endutxent|did you mean: setutent|did you mean: pututline|did you mean: endutent

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               api-missing|platform-limitation
match_keywords:         setutxent,pututxline,endutxline,utmpx,OMIT_UTMP
title:                  OHOS 不支持 utmpx API（只有 utmp API）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS 系统只提供 utmp API（setutent/pututline/endutent），不提供 utmpx API（setutxent/pututxline/endutxent），导致链接失败
affected_scope:         使用 utmpx.h 和 utmp 记录功能的程序（如 SSH 服务器、终端工具）
verification_cmd:       grep -r "setutxent|pututxline|endutxent" *.c

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           add_compile_definition
rec_description:        添加 OMIT_UTMP 编译定义，禁用 utmp 记录功能（对非桌面终端程序核心功能非必需）
rec_command:            target_compile_definitions(target PRIVATE OMIT_UTMP)
rec_auto_fix:           false
rec_impl:               none

fallback_priority:      2
fallback_approach:      replace-api
fallback_description:   将 utmpx API 替换为 utmp API（setutxent → setutent，pututxline → pututline，endutxent → endutent）
fallback_command:       sed -i 's/setutxent/setutent/;s/pututxline/pututline/;s/endutxent/endutent/' pty.c
fallback_auto_fix:      false
fallback_impl:          none

# ★ 禁止策略 ★
forbid_1_pattern:       utmpx\.h
forbid_1_reason:        OHOS 不提供 utmpx.h，必须禁用或替换
forbid_1_consequence:   链接失败：undefined symbol

# ═══ Layer 4: 原则引用 ═══
principles:  # TODO: map iron rules to principle IDs

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

