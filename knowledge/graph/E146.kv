#====================================================================
# E092: 外部依赖预编译包处理
# 对应的人类文档: doc/E092.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E146
trigger_tool:           configure|make
phase:                  configuration|compilation
error_signature:        checking for .*... no|Package '.*' not found|cannot find -l.*|fatal error: .*: No such file

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               dependency_handling
match_keywords:         dependency, missing, precompiled, external, Alpine, cmd-pkgs

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             编译过程中发现缺少库依赖（如 libpcap/zlib/openssl），但本地编译遇到工具链限制（如 bison/flex pipe 问题）
affected_scope:         编译流程中依赖处理阶段
verification_cmd:       ls ~/usr/local/lib/lib*.a | grep <dependency_name>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           use_precompiled_package
rec_description:        从 cmd-pkgs 获取预编译包，避免本地编译工具链问题
rec_command:            curl -fsSL https://gitcode.com/OpenHarmonyPCDeveloper/cmd-pkgs/releases/download/pkgs/install.sh | sh -s -- <name> <ver>
rec_auto_fix:           true
rec_impl:               precompiled_package_resolver

fallback_priority:      2
fallback_approach:      manual_compile_dependency
fallback_description:   手动编译依赖（当预编译包不可用或不兼容时）
fallback_command:       python3 $SKILL_ROOT/scripts/ohc-run.py build <dependency_name> <version>
fallback_auto_fix:      false
fallback_impl:          manual_dependency_compile

# ★ 禁止策略 ★
forbid_1_pattern:       --build=|--host=|--target=
forbid_1_reason:        本平台是 native 编译，禁止使用 cross-compile 参数绕过 config.guess
forbid_1_consequence:   虽能暂时通过 configure，但会引入隐患且违反 R15

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E146.md
last_updated:           2026-05-14
source_event:           hping 3.0.0-alpha-1 编译（libpcap 依赖处理）


# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
