#====================================================================
# DRAFT-pico-sdk-shadow-ci-isolated-home-pythonpath — shadow HOME 隔离时复用已安装 Conan 依赖
# Source event: pico-sdk 2.2.0 shadow CI r1 setup failed with missing distro after pip partial install
#====================================================================

id:                     E427
trigger_tool:           shadow-ci|setup.sh|python|pip|conan
phase:                  environment|setup
error_signature:        ModuleNotFoundError: No module named 'distro'|Conan not found or broken|pip subprocess.*did not run successfully|ReadTimeoutError.*files.pythonhosted.org
severity:               2
category:               network, python, conan, environment
match_keywords:         pico-sdk, shadow CI, isolated HOME, CONAN_HOME, PYTHONPATH, distro, conan 2.29.1, pip timeout, files.pythonhosted.org
title:                  shadow CI 隔离 HOME 后不要只改 HOME；需给 Python 保留真实 site-packages 或预装完整 Conan 依赖

root_cause:             影子 CI 用 env -i + 独立 HOME/CONAN_HOME 可以隔离 Conan cache，但若 PATH 指向真实 conan 入口而 PYTHONPATH 不含真实 ~/.local/site-packages，setup.sh 会认为 Conan broken 并尝试联网安装；受限网络下 pip 可能超时或只装部分依赖，随后 conan 启动缺 distro。
affected_scope:         使用自建 shadow runner 在 HarmonyOS 真机上复刻 CI，并把 HOME 改到 run 目录的场景。
verification_cmd:       env -i HOME=$RUN_HOME PATH=$REAL_HOME/usr/local/bin:$REAL_HOME/.local/bin:/data/service/hnp/bin PYTHONPATH=$REAL_HOME/.local/lib/python3.12/site-packages conan --version

rec_priority:           1
rec_approach:           isolate-cache-keep-python-import-path
rec_description:        HOME/CONAN_HOME/TMPDIR 使用 run/job 隔离目录；PATH 保留 REAL_HOME/usr/local/bin 与 REAL_HOME/.local/bin；PYTHONPATH 追加 REAL_HOME/.local/lib/python3.12/site-packages、REAL_HOME/usr/local/lib/python3.12/site-packages 和 shadow python-user site-packages，避免重复联网安装 Conan。
rec_command:            env -i HOME="$RUN_HOME" CONAN_HOME="$RUN_HOME/conan-home" PATH="$REAL_HOME/usr/local/bin:$REAL_HOME/.local/bin:/data/service/hnp/bin:/bin:/usr/bin" PYTHONPATH="$REAL_HOME/.local/lib/python3.12/site-packages:$REAL_HOME/usr/local/lib/python3.12/site-packages" conan --version
rec_auto_fix:           false
rec_impl:               runner-env

fallback_priority:      2
fallback_approach:      preinstall-conan-deps-offline
fallback_description:   如果必须完全隔离 Python site-packages，需要离线 wheelhouse 或预先在 shadow HOME 中安装 Conan 完整依赖，不能依赖实时公网 pip。
fallback_command:       python3 -m pip install --no-index --find-links=$WHEELHOUSE conan
fallback_auto_fix:      false
fallback_impl:          offline-wheelhouse

forbid_1_pattern:       env -i HOME=.* conan --version.*without PYTHONPATH|pip install.*conan.*files.pythonhosted.org
forbid_1_reason:        真机网络不稳定时会把 shadow CI 卡在环境安装阶段，失败与当前库无关。
forbid_1_consequence:   setup 阶段失败，无法验证 recipe；日志出现 pip ReadTimeout 或 ModuleNotFoundError: distro。

principles:             P014
causes:                 []
caused_by:              []
similar_to:             [E290]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-pico-sdk-shadow-ci-isolated-home-pythonpath.md
last_updated:           2026-08-25
source_event:           pico-sdk 2.2.0 shadow CI r1 setup failed after pip timeout and missing distro; runner fixed by adding real site-packages to PYTHONPATH
