#====================================================================
# E093.kv — musl 缺 getpass() GNU 扩展
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E093
trigger_tool:           cc|clang|make
phase:                  compilation
error_signature:        implicit declaration of function.*getpass|
                         undefined reference to.*getpass

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               libc-compat|musl
match_keywords:         getpass, GNU extension, musl, missing function,
                         undeclared, implicit function declaration

# ═══ Layer 2: 诊断层 ═══
root_cause:             getpass() 是 GNU 扩展函数（POSIX 已标记为废弃），
                        musl libc 不实现此函数。
                        软件源码中直接调用 getpass() 时，
                        musl 环境下无此符号声明，导致编译报
                        "implicit declaration" 或链接时报 "undefined reference"。
affected_scope:         需要终端密码输入的命令行工具。
verification_cmd:       echo '#include <unistd.h>\nint main(){getpass("x");}' | cc -xc - -c 2>&1 | grep getpass;
                         grep -rn "getpass" src/ lib/ 2>/dev/null | head -5

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description:        添加 getpass() 的简单实现，或通过 --disable-feature
                        绕过密码输入功能。实现方式：在源码中用
                        #ifdef __OHOS__ 守卫，提供基于 fgets 的替代实现。
rec_command:            |
                        #ifdef __OHOS__
                        static char *getpass(const char *prompt) {
                            static char buf[256];
                            fprintf(stderr, "%s", prompt);
                            fflush(stderr);
                            if (fgets(buf, sizeof(buf), stdin) == NULL) return NULL;
                            buf[strcspn(buf, "\n")] = '\0';
                            return buf;
                        }
                        #endif
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      configure-disable-feature
fallback_description:   通过 configure 选项禁用需要 getpass 的功能模块
fallback_command:       ./configure --prefix=$DEFAULT_PREFIX --disable-password
fallback_auto_fix:      false
fallback_impl:          configure-disable-feature

# ★ 禁止策略 ★
forbid_1_pattern:       -DHAVE_GETPASS
forbid_1_reason:        强制声明 getpass 存在但 musl 无此符号，
                        导致链接阶段 undefined reference
forbid_1_consequence:   链接失败，undefined reference to getpass

# ═══ Layer 4: 原则引用 ═══
principles:             

# ═══ 关系图 ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

