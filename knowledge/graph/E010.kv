#====================================================================
# E010.kv — toybox 兼容性问题
#====================================================================

id:                     E010
title: toybox 兼容性问题
trigger_tool:           configure|make|sed|expr
phase:                  configuration|compilation
error_signature:        sed.*hang|sed.*stuck|Makefile.*garbled|
                         expr.*invalid|config\.status.*corrupt|
                         toybox.*sed.*unsupported

severity:               2
category:               tool-compat
match_keywords:         toybox, sed, expr, GNU coreutils, GNU sed,
                         garbled, hang, stuck, unsupported command,
                         label, branch, regex, \|

root_cause:             鸿蒙默认的 toybox 工具链(sed/expr)对 POSIX
                         复杂脚本支持不完整, autotools 生成的
                         configure/Makefile 使用了 toybox 不支持的特性
affected_scope:         使用 autotools 构建系统的大型项目(ncurses, bash 等)
verification_cmd:       expr X"test" : 'X\(.*\)' \| . : '\(.\)';
                         sed --version | head -1

rec_priority:           1
rec_approach:           install-gnu-tools
rec_description:        通过预编译安装脚本安装 GNU sed + GNU coreutils 替代 toybox,
                         并将 $HOME/usr/local/bin 加入 PATH 前端
rec_command:            curl -fsSL https://gitcode.com/OpenHarmonyPCDeveloper/cmd-pkgs/releases/download/pkgs/install.sh | sh -s -- sed 4.9 && curl -fsSL https://gitcode.com/OpenHarmonyPCDeveloper/cmd-pkgs/releases/download/pkgs/install.sh | sh -s -- coreutils 9.10 && export PATH=$HOME/usr/local/bin:$PATH
rec_auto_fix:          true
rec_impl:               install-script

forbid_1_pattern:
# (无特殊禁止策略)

principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E010.md
last_updated:           2026-04-09
resolved_in:            HongMeng Kernel 1.12.0
resolved_note:          GNU sed/coreutils 已预装并替代 toybox 默认工具链，expr \| 复合正则正常工作
source_event:           archives/c/coreutils/9.10/manifest.yaml, archives/s/sed/4.9/manifest.yaml
