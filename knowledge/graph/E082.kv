#====================================================================
# E082.kv — gnulib configure conftest 需二次运行
#====================================================================

id:                     E082
trigger_tool:           configure
phase:                  configuration
error_signature:        sed: can't read conftest.c.*No such file or directory|
                         checking for bool, true, false\.\.\. no|
                         checking for stdlib\.h\.\.\. no|
                         checking for stdint\.h\.\.\. no|
                         checking for stdbool\.h\.\.\. no|
                         unknown type name.*bool

severity:               3
category:               autotools, configure, gnulib
match_keywords:         conftest.c, gnulib, bool not detected, stdbool.h,
                         configure second run, E064, HAVE_STDBOOL_H undef,
                         stdlib.h no, stdint.h no, checking for bool

root_cause:             gnulib 项目的 configure 使用大量 AC_RUN_IFELSE 运行时检测。
                         首次运行时 conftest 程序触发 HarmonyOS 安全弹窗(E064)，
                         弹窗超时后进程被杀，configure 误判检测结果（如 stdbool.h 不存在）。
                         第二次运行时弹窗已被接受，检测结果恢复正常。
                         这是 E064 在 gnulib 项目中的特异性表现：
                         gnulib 的 AC_RUN_IFELSE 密度远高于普通 autotools 项目，
                         单次弹窗超时会导致数十个检测结果同时出错。
affected_scope:         **所有使用 gnulib 的 autotools 项目**（libpipeline, coreutils,
                         sed, grep, diffutils, gzip, tar, wget, man-db 等）
verification_cmd:       grep "HAVE_STDBOOL_H" config.h | grep undef && echo "NEED_RERUN" || echo "OK";
                         grep "HAVE_STDLIB_H" config.h | grep undef && echo "NEED_RERUN" || echo "OK";
                         grep "cannot run.*compiled" config.log && echo "E064_DETECTED" || echo "OK"

rec_priority:           1
rec_approach:           configure-twice
rec_description:        运行 configure 两次。第一次触发安全弹窗并接受（或超时），
                         第二次获得正确的检测结果。
                         gnulib 项目特有的修复方案，适用于 AC_RUN_IFELSE 密度高的场景。
rec_command:            ./configure --prefix=$TEST_PREFIX && make distclean && ./configure --prefix=$TEST_PREFIX
rec_auto_fix:           true
rec_impl:               configure-rerun

fallback_priority:      2
fallback_approach:      config-cache-override
fallback_description:   创建 site.config.cache 文件预填充正确的检测值，
                         用 --cache-file= 绕过 conftest 执行。
                         适用于反复编译同一软件时避免二次 configure。
fallback_command:       
fallback_auto_fix:      false
fallback_impl:          

# ★ 禁止策略 ★
forbid_1_pattern:       --build=|--host=|--target=
forbid_1_reason:         禁止用交叉编译参数绕过检测。
                         gnulib 根据检测结果选择替换模块，
                         --host 导致 AC_RUN_IFELSE 全部跳过，
                         gnulib 基于错误的平台假设选择替换模块
forbid_1_consequence:   级联错误链:
                         → HAVE_STDBOOL_H 未定义 → gnulib 生成错误的 stdbool 替换
                         → E062(unknown type name 'bool')
                         → E063(-Werror 级联失败)
                         → E005(链接错误)
                         → 编译完全失败

# ═══ Layer 4: 原则引用 ═══
principles:               

