#====================================================================
# DRAFT-glib-2.88.0-gobject-explicit-init — HarmonyOS native GLib/GObject
#   cannot assume ELF .init_array constructors run before first type use
# 触发事件: glib 2.88.0 HarmonyOS PC 适配（archives/g/glib/2.88.0）
# 非重复: 区别于 E321 gobject-2.0 .pc 转发，也区别于 E337 工具 bootstrap；
#         本条只覆盖 GLib/GObject 运行时类型系统初始化入口问题。
#====================================================================

id:                     E444
trigger_tool:           conan|meson|test_package|runtime
phase:                  testing|runtime
error_signature:        GObject.*type system.*not initialized|G_IS_OBJECT.*failed|g_object_new.*failed|first GObject use.*HarmonyOS|constructor.*init_array.*not run|g_type_ensure_initialized

severity:               3
category:               ohos, constructors, glib, gobject, runtime-init
match_keywords:         GLib, GObject, g_type_ensure_initialized, gobject_init, .init_array, constructor, HarmonyOS, OHOS, G_TYPE_OBJECT, g_object_new, type system, test_package
title:                  HarmonyOS 原生 GLib/GObject 消费方不要假设 ELF .init_array 构造器已完成类型系统初始化

root_cause:             GLib/GObject 通常依赖库构造器在进程启动或动态库装载时自动运行 gobject_init()。
                        HarmonyOS 原生 Conan 测试环境中，首次使用 GObject 类型系统前不能总是假设 ELF
                        .init_array 构造器已经按上游预期执行。若消费方直接进入 g_object_new()、
                        G_IS_OBJECT()、GType 查询或 GIO 对象构造，可能暴露类型系统未初始化风险。
                        glib 2.88.0 适配通过新增显式、幂等、线程安全的
                        g_type_ensure_initialized() 入口，在首次 GObject/GIO 使用前兜底调用。

affected_scope:         在 HarmonyOS/OHOS native 环境中直接消费 GLib/GObject/GIO 的 Conan 包和
                        test_package，尤其是第一步就调用 g_object_new(), G_IS_OBJECT(),
                        g_file_new_for_path() 或上游测试依赖 GObject 基础类型注册的场景。
                        该问题不是 pkg-config 找不到 gobject-2.0，也不是 GLib 命令行工具缺运行权限。

verification_cmd:       |
  CI_PACKAGES="archives/g/glib/2.88.0" zsh ci/conan/build_and_test.sh
  # 期望:
  # - upstream Meson tests: 302 ok, 0 failed, 6 skipped
  # - test_package: test glib 2.88.0: OK (string/hashtable/variant/gobject/gio)
  # - L1e destructive negative test confirms the smoke test depends on glib artifacts

rec_priority:           1
rec_approach:           explicit-idempotent-gobject-init-entry
rec_description:        在 GLib/GObject 适配补丁中提供公开入口 g_type_ensure_initialized()，
                        通过 g_once_init_enter()/g_once_init_leave() 保证幂等和线程安全；
                        若构造器已运行则不重复初始化，若 HarmonyOS 上构造器未先运行则显式执行
                        gobject_init()。消费方 test_package 在首次 GObject/GIO 使用前调用该入口两次，
                        同时覆盖重复调用不会破坏状态的场景。
rec_command:            |
  g_type_ensure_initialized();
  g_type_ensure_initialized();
  GObject *o = g_object_new(G_TYPE_OBJECT, NULL);
  g_assert(G_IS_OBJECT(o));
rec_auto_fix:           false
rec_impl:               source-patch-and-test-package-smoke

fallback_priority:      2
fallback_approach:      avoid-gobject-in-smoke-test
fallback_description:   只测 g_strdup()/GHashTable 等 glib-core API 可以绕过 GObject 初始化问题，
                        但会让 test_package 对 gobject/gio 组件覆盖不足，L1e 负向验证价值下降。
fallback_command:       test only glib core APIs
fallback_auto_fix:      false
fallback_impl:          test-scope-reduction

forbid_1_pattern:       rely only on library constructor|assume .init_array
forbid_1_reason:        HarmonyOS 原生执行环境中该假设已经被 glib 2.88.0 适配验证为风险点。
forbid_1_consequence:   首次 GObject 使用可能在类型系统未完成初始化时运行，导致测试或消费方启动不稳定。

forbid_2_pattern:       fake test by only printing version|skip all GObject/GIO API use
doc_file: doc/E444.md

source_pr: !6619
last_updated:               2026-08-31
authors: wxjshr <wxjshr@noreply.gitcode.com>
