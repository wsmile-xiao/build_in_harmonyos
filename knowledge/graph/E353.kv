id:                     E353
trigger_tool:           cmake|ld|ctest
phase:                  linking|testing
error_signature:        cannot find -lgd|No rule to make target.*libgd|GD_LIB.*gd_static|static.*test.*target

severity:               1
category:               cmake, static-library, target-identity, upstream-tests
match_keywords:         CMake, static, upstream tests, gd_static, GD_LIB, ctest, target dependency, -lgd
title:                  CMake static upstream tests must link the real target

root_cause:             Static-only CMake variants can create a different target name than the upstream test helper expects, so the helper falls back to a bare linker name and loses the target dependency.
affected_scope:         CMake recipes that enable upstream tests in static-only builds and whose test helper variables name a logical library instead of the actual CMake target.
verification_cmd:       conan create ${RECIPE} -pr:h=${OHOS_PROFILE} -pr:b=${OHOS_PROFILE} -o ${REF}:with_upstream_tests=True --build=missing --build=${REF}

rec_priority:           1
rec_approach:           test-helper-target-alias
rec_description:        When upstream tests are enabled, patch the test helper variable to the actual CMake target produced by the selected static/shared variant.
rec_command:            ctest --test-dir ${BUILD_DIR} --output-on-failure
rec_auto_fix:           false
rec_impl:               cmake-test-target-alias

fallback_priority:      2
fallback_approach:      disable-upstream-tests-only-with-blocker
fallback_description:   If the target mapping cannot be made safely, document the exact blocker rather than publishing a guessed passed/total rate.
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       skip.*ctest|0/.*from CI|CI.*pass rate
forbid_1_reason:        CI package summaries and unstarted CTest runs are not HarmonyOS PC upstream-test evidence.
forbid_1_consequence:   The PR body would publish an unsupported test rate.
forbid_2_pattern:       global.*GD_LIB|package.*runtime.*test-only
forbid_2_reason:        The fix belongs to upstream-test source preparation unless the delivered package also requires it.
forbid_2_consequence:   Test-only build wiring may leak into the normal package surface.


causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

