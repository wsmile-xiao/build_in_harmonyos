#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E103.kv，填写各字段
# 对应的人类文档: doc/E103.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E165
trigger_tool:           configure
phase:                  configuration
error_signature:        bad interpreter: /bin/bash: no such file or directory|configure 失败 \(exit 127\)|#!/bin/bash|^#! /bin/bash

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               platform
match_keywords:         shebang, bash, interpreter, configure failed, exit 127, bin/bash, bin/sh, OpenHarmony, HongMeng
title:                  OpenHarmony shebang 路径错误（/bin/bash 不存在）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             OpenHarmony 系统没有传统的 /bin 目录，bash 位于 /data/service/hnp/bin/bash，sh 位于 /system/bin/sh。脚本 shebang 指向不存在的路径导致脚本无法执行。
affected_scope:         所有使用 #!/bin/bash 或 #!/bin/sh 作为 shebang 的脚本文件，特别是 configure、install.sh、shorewall 等构建和运行脚本
verification_cmd:       head -1 configure install.sh shorewall | grep -E "hnp/bin/bash|system/bin/sh"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           shebang-fix
rec_description:        修改脚本 shebang：/bin/bash -> /data/service/hnp/bin/bash，/bin/sh -> /system/bin/sh
rec_command:            sed -i '1s|#!/bin/bash|#!/data/service/hnp/bin/bash|' configure; sed -i '1s|#!/bin/sh|#!/system/bin/sh|' install.sh shorewall uninstall.sh wait4ifup
rec_auto_fix:           true
rec_impl:               sed-shebang-replace

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      env-substitution
fallback_description:   使用环境变量或符号链接替代
fallback_command:       ln -sf /data/service/hnp/bin/bash /bin/bash 2>/dev/null || true
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       --build=.*|--host=.*|--target=.*
forbid_1_reason:        OpenHarmony 是 native 编译平台，不应使用 --build/--host/--target 参数绕过 shebang 问题
forbid_1_consequence:   可能导致路径硬编码问题，脚本在其他平台无法运行
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E103.md
last_updated: 2026-05-15
source_event:           # 触发此条目创建的编译事件(如有)

draft: false
