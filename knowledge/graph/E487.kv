#====================================================================
# DRAFT-kdnssd-6.29.0-qtlinguisttools-consumption.kv
# 主题: Qt6LinguistTools 发布版本消费 — Conan tool_requires + Qt6LinguistTools_DIR
# 来源: kdnssd 6.29.0 r03 实测（build_in_harmonyos, archives/k/kdnssd/6.29.0）
#====================================================================

id:                     E487
trigger_tool:           cmake|conan
phase:                  configuration
error_signature:        Could NOT find Qt6LinguistTools (missing: Qt6LinguistTools_DIR)|
                         Failed to find required Qt component "LinguistTools"|
                         Expected Config file at .*lib/cmake/Qt6LinguistTools/Qt6LinguistToolsConfig.cmake.* does NOT exist|
                         ECMPoQmTools\.cmake:155 \(find_package\)|

severity:               2
category:               cmake, conan, kf6, linguisttools, qt6
match_keywords:         Qt6LinguistTools, LinguistTools, qt6linguisttools, qttools,
                         ECMPoQmTools, poqm, lrelease, lupdate, lconvert,
                         tool_requires, Qt6LinguistTools_DIR, Qt6_DIR, find_package

root_cause:             KF6 上游（ECMPoQmTools.cmake:155）在 configure 阶段调用
                         find_package(Qt6 COMPONENTS LinguistTools) 做 poqm 翻译。
                         qtbase 包不提供 Qt6::LinguistTools 组件（LinguistTools 实体
                         由 qttools 构建产生：lrelease/lupdate/lconvert +
                         Qt6LinguistToolsConfig.cmake）。Qt6Config.cmake 的组件解析
                         锚定 Qt6_DIR（qtbase 的 lib/cmake/Qt6）相对路径，因此
                         单独发布安装的 qt6linguisttools 包不会被自动发现，
                         即使其 builddirs 已加入 CMAKE_PREFIX_PATH，configure 仍报
                         "Failed to find required Qt component LinguistTools"。

affected_scope:         使用 ECMPoQmTools/poqm 且 Qt 组件分包发布的 KF6/Qt6 库
                        （kdnssd、其他含翻译的 KF6 库）在 HarmonyOS PC 上的适配

verification_cmd:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=same; r03 实测：接入 tool_require + Qt6LinguistTools_DIR 后 conan create 全绿 （ECMPoQmTools find_package 成功，libKF6DNSSD 构建成功， test_package 2/2 通过含鸿蒙特有测试 test_kdnssd_ohos）

rec_priority:           1
rec_approach:           qt6linguisttools-tool-require-plus-pin-DIR
rec_description: >
  1) 将 qt6linguisttools/6.11.1（ohpcd 已发布，revision 021a6867…，与 Qt 6.11.1 匹配）
  作为构建期 tool_requires 声明；
  2) generate() 中显式设置 CMakeToolchain 变量
  Qt6LinguistTools_DIR = <qt6linguisttools 包>/lib/cmake/Qt6LinguistTools，让
  ECMPoQmTools 的 find_package(Qt6 COMPONENTS LinguistTools) 直接命中独立包；
  3) 在 conan_cmakedeps_paths.cmake 追加其 lib/cmake 与 lib/cmake/Qt6LinguistTools
  到 CMAKE_PREFIX_PATH/CMAKE_MODULE_PATH。禁止 --build=missing 从源码重编 qttools。

rec_command:            self.tool_requires("qt6linguisttools/6.11.1")  +  tc.variables["Qt6LinguistTools_DIR"]=os.path.join(ltt.package_folder,"lib","cmake","Qt6LinguistTools")
rec_auto_fix:           false

fallback_priority:      2
fallback_approach:      禁用 poqm（不推荐：丢失上游翻译）
fallback_description:   在 generate() 关闭 ecm_install_po_files_as_qm / 跳过 poqm 步骤
fallback_command:
fallback_auto_fix:      false

forbid_1_pattern:       --build=missing.*qttools|--build=missing.*qt6linguisttools

rec_impl:               manual
doc_file: doc/E487.md
source_pr: !7134
last_updated:               2026-08-31
authors: junshi_liu <liujsh2023@lzu.edu.cn>
