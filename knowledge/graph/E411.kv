#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E321.kv，填写各字段
# 对应的人类文档: doc/E321.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E411
trigger_tool:           conan|libtool|make|autotools
phase:                  packaging|linking
error_signature:        not a valid libtool object|Copied .*\.lo file|invalid libtool object

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               autotools, conan, libtool, compat-shim, export-sources
match_keywords:         not a valid libtool object, export_sources, compat, .lo, .dirstamp, libtool, conan create
title: compat/export_sources 目录残留 libtool 构建产物导致 conan create 链接失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: explore 阶段直接在源码树 compat/ 内执行 make 后，compat/ 残留 .lo/.o/.dirstamp/.Plo 等 libtool 构建产物；conanfile.py export_sources 用 copy(self,"*",...) 全量复制 compat/，把构建产物当作源码发布进 recipe，conan create 在干净源码树重建时混入脏 .lo，链接报 not a valid libtool object
affected_scope:         依赖 compat shim + export_sources 发布的 abiword 系插件（clarisworks/paint/bmp/pdb 等 autotools 插件）
verification_cmd:       归档前 `find compat tests -type d \( -name .deps -o -name .libs \) -exec rm -rf {} +; find compat tests -type f \( -name '*.lo' -o -name '*.o' -o -name '*.Plo' -o -name '*.Po' -o -name '*.dirstamp' -o -name '*.la' \) -delete` 后 conan create 不再报 not a valid libtool object

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: 归档前清理 compat/、tests/ 下全部构建产物（find .deps/.libs -type d -exec rm -rf + 与 *.lo/*.o/*.Plo/*.Po/*.dirstamp 删除），只保留源文件；或 export_sources 用白名单复制 *.h/*.cpp
rec_description:        explore 阶段在源码树内执行 make 后，compat/ 会混入 libtool 构建产物；export_sources 全量复制会把脏 .lo 当源码发布。归档前必须清理，或用白名单只复制源文件。
rec_command:            find compat tests -type d \( -name .deps -o -name .libs \) -exec rm -rf {} + 2>/dev/null; find compat tests -type f \( -name '*.lo' -o -name '*.o' -o -name '*.Plo' -o -name '*.Po' -o -name '*.dirstamp' -o -name '*.la' -o -name '*.lai' \) -delete
rec_auto_fix:           true
rec_impl:               cleanup-build-artifacts-before-archive

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      conanfile.py export_sources 改为白名单 glob（*.h/*.cpp/*.m4）而非 copy("*")
fallback_description:   从源头避免构建产物混入：export_sources 只复制纯源码扩展名。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       conan create.*already installed|\.lo.*Copied
forbid_1_reason:        残留 .lo 被 export_sources 发布后，conan create 复用脏缓存产生假通过
forbid_1_consequence:   G2 门禁误判通过，产物链接到脏 .o，发布后运行时行为不可预期
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P018, P002

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              [E258]
similar_to:             [E114]
conflicts_with:         []
prerequisite_of:        []

