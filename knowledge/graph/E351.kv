#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E321.kv，填写各字段
# 对应的人类文档: doc/E321.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E351
trigger_tool: make|build
phase: compilation
error_signature: xxx_UT_DEBUGMSG.*undeclared|gsf_off_t.*unknown type|UT_ASSERT.*undeclared identifier|GsfOutput.*no member|recognizeSuffix.*GsfOutput

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category:               ohos, abiword, compat-shim, export-direction, gsf-output
match_keywords: GsfOutput, gsf_output_write, gsf_output_seek, gsf_output_tell, xxx_UT_DEBUGMSG, UT_ASSERT, gsf_off_t, AbiWord plugin, ie_exp, IE_Exp, export plugin, PalmDoc, compat shim
title: AbiWord 导出方向插件（GsfOutput）需要扩展 compat shim：可增长内存缓冲 gsf-output.h + IE_Exp 导出框架；并补齐上游被禁用的 xxx_UT_DEBUGMSG 宏

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: AbiWord 插件若含导出方向（IE_Exp），上游代码依赖 libgsf GsfOutput API（gsf_output_write/seek/tell）与 AbiWord IE_Exp 框架。clarisworks 版 compat shim 只覆盖导入方向（GsfInput+IE_Imp）。此外上游 ie_exp_PalmDoc.cpp 使用永久禁用的调试宏 xxx_UT_DEBUGMSG、ie_impexp_PalmDoc.cpp 经 ie_imp.h 传递使用 UT_ASSERT，ut_debugmsg.h/ie_imp.h 若不补齐则编译报 undeclared identifier；gsf_off_t 在 gsf-input.h/gsf-output.h 各自 typedef 需要统一守卫。
affected_scope: AbiWord 3.x 带导出方向的插件（pdb/PalmDoc、wpdoc 等）在 OHOS 的 compat shim 适配；任何需要 GsfOutput 内存流 API 的鸿蒙适配
verification_cmd: cd  && grep -n gsf_output_write plugins/pdb/xp/ie_exp_PalmDoc.cpp && grep -n xxx_UT_DEBUGMSG compat/ut_debugmsg.h && grep -n GSF_OFF_T_DEFINED compat/glib.h && make check -j1

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 2
rec_approach: extend-compat-shim-export-direction
rec_description: compat/ 新增 gsf/gsf-output.h（可增长内存缓冲 + gsf_output_write/seek/tell/get_data/get_size 测试钩子）、ie_exp.h（IE_ExpSniffer/IE_Exp 导出框架 + registerExporter）、ie_exp_Text.h（文本导出基类，遍历 PD_Document 文本 span 调 _writeBytes）；glib.h 增加 gsf_off_t 统一守卫 typedef、GObject ref/unref、g_ascii_strcasecmp；ut_debugmsg.h 补齐 xxx_UT_DEBUGMSG；ie_imp.h include ut_assert.h；新增源码走 conanfile.py export_sources（不生成 new-file 补丁，E258 草稿）。
rec_command: cp -r archives/a/abiword-plugin-clarisworks/3.0.8/compat compat && (按上述描述扩展 compat 后) autoreconf -fi && ./configure --prefix=$DEFAULT_PREFIX --build=aarch64-unknown-linux-ohos --host=aarch64-unknown-linux-ohos && make -j1 && make check -j1
rec_auto_fix: false
rec_impl: export-sources-compat

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

