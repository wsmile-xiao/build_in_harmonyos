#====================================================================
# E085.kv — musl pthread_cancel 缺失导致线程检测失败
#====================================================================

id:                     E085
trigger_tool:           configure|make|clang|gcc
phase:                  compilation|linking
error_signature:        undefined reference to pthread_cancel|
                         pthread_cancel.*weak|
                         PTHREAD_IN_USE_DETECTION|
                         posix-lock\.c.*pthread_cancel|
                         lock.*pthread.*fail

severity:               2
category:               libc-compat|musl|threading
match_keywords:         pthread_cancel, PTHREAD_IN_USE_DETECTION,
                         posix-lock, musl, weak symbol,
                         pthread threading detection,
                         lock hard, _hard

root_cause:             musl libc（OpenHarmony 使用）不实现 pthread_cancel()。
                         部分 GNU 软件（如 libgpg-error）使用
                         `#pragma weak pthread_cancel` 来运行时检测
                         pthread 是否可用。但在 musl 上，链接器
                         找不到 pthread_cancel 的 weak symbol，
                         导致检测逻辑失败或链接错误。
                         需要#define PTHREAD_IN_USE_DETECTION_HARD=1
                         切换到使用 pthread_create 做检测。
affected_scope:         libgpg-error 及所有使用 gnulib/gcry 线程检测的 GnuPG 生态软件
verification_cmd:       echo '#include <pthread.h>' | clang -E - 2>&1 | grep pthread_cancel;
                         grep -r "pthread_cancel" src/ 2>/dev/null | head -3

rec_priority:           1
rec_approach:           define-pthread-detection-hard
rec_description:        在 config.h 中定义 PTHREAD_IN_USE_DETECTION_HARD=1，
                         将线程检测从 weak symbol 方式切换到 pthread_create 运行时检测
rec_command:            echo '#define PTHREAD_IN_USE_DETECTION_HARD 1' >> config.h
rec_auto_fix:           true
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      stub-pthread-cancel
fallback_description:   添加空的 pthread_cancel() stub 函数以满足链接
fallback_command:       echo 'void pthread_cancel(void* t) { (void)t; }' >> src/stubs.c
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       -lpthread.*-static
forbid_1_reason:        静态链接 pthread 在 musl 上会拉入不兼容的符号
forbid_1_consequence:   链接阶段出现多个 undefined reference 错误

principles:             P-PATCH-001

causes:                 []
caused_by:              []
similar_to:             [E003]
conflicts_with:         []
prerequisite_of:        [E086]

doc_file:               doc/E085.md
last_updated:           2026-04-21
source_event:           archives/l/libgpg-error/1.55
