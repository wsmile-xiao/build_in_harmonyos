id:                     E449
trigger_tool:           clang|objc|cmake|conan|test_package
phase:                  compilation|linking|testing
error_signature:        Foundation/Foundation.h.*not found|undefined reference.*objc|objc_msg_lookup|NSConstantString|cannot find -lobjc|symbol lookup error.*libgnustep-base

severity:               3
category:               ohos, conan, runtime, gnustep, objective-c
match_keywords:         libobjc2, Objective-C runtime, -fobjc-runtime=gcc, -fconstant-string-class=NSConstantString, -fblocks, Foundation, NSConstantString, LD_LIBRARY_PATH, runenv_info
title:                  Publish GNU Objective-C runtime flags and run paths for GNUstep consumers

root_cause:             A GNUstep Foundation consumer needs the same GNU
                        Objective-C runtime ABI and constant-string class as the
                        library package. Conan's C and CMake consumers do not
                        infer these flags automatically from the presence of
                        libobjc2. If the recipe only publishes the library name,
                        downstream Objective-C code can compile or link with the
                        wrong runtime, miss Foundation headers, or fail at target
                        execution because libobjc, libffi, curl, or
                        libgnustep-base are not on the runtime library path.
affected_scope:         Conan recipes that package GNUstep Base or libraries
                        depending on GNUstep Base for OHOS and expose Objective-C
                        Foundation APIs to downstream consumers.
verification_cmd:       CI_PACKAGES="archives/g/gnustep-base/1.31.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           objc-runtime-flags-in-package-info
rec_description:        Publish GNUstep Base headers and libraries with
                        transitive libobjc2, libffi, and curl requirements. Add
                        -fobjc-runtime=gcc, -fblocks, and
                        -fconstant-string-class=NSConstantString to consumer
                        compile flags, add the runtime flags to executable and
                        shared link flags, and prepend the GNUstep Base and
                        dependency libdirs to buildenv_info and runenv_info.
                        Verify with an Objective-C test_package that imports
                        Foundation/Foundation.h, constructs Foundation objects,
                        links, signs/runs under shadow CI, and exits cleanly.
rec_command:            conan create archives/g/gnustep-base/1.31.1 -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      explicit-consumer-cflags
fallback_description:   If a downstream build system ignores Conan cpp_info
                        flags, inject the same Objective-C runtime and constant
                        string flags into that consumer's toolchain while
                        keeping gnustep-base package_info as the source of truth.
fallback_command:
fallback_auto_fix:      false
fallback_impl:          conan-recipe

forbid_1_pattern:       test_package.*\\.c$|main\\(.*printf.*only
forbid_1_reason:        A C-only consumer cannot prove Objective-C runtime ABI,
                        Foundation headers, constant strings, or message dispatch.
forbid_1_consequence:   The package can look green while real GNUstep consumers
                        fail to compile, link, or run.
forbid_2_pattern:       rely.*system.*libobjc|omit.*fobjc-runtime|omit.*NSConstantString
forbid_2_reason:        GNUstep Base and downstream Objective-C objects must use
                        the same runtime ABI and constant-string representation.
forbid_2_consequence:   Linkage succeeds inconsistently or target execution fails
                        with missing Objective-C runtime symbols.

principles:             P010,P014,P017
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

