#====================================================================
# E094.kv — CMake 平台检测失败
# 问题描述: CMake 的 check_c_source_compiles 等检测函数在 OHOS 平台上可能失败
# 对应的人类文档: doc/E094.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E151
trigger_tool:           cmake|cc|clang
phase:                  configuration|compilation
error_signature:        check_c_source_compiles.*failed|check_function_exists.*failed|HAVE_SNPRINTF.*not found|HAVE_DECL_ISNAN.*undefined|macro redefined.*HAVE_|config\.h.*missing HAVE_

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, detection, cmake
match_keywords:         check_c_source_compiles, check_function_exists, HAVE_SNPRINTF, HAVE_DECL_ISNAN, cmake detection, config.h, platform detection, musl, undefined, macro redefined

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             CMake 的 check_c_source_compiles 和 check_function_exists 检测函数在 OHOS 平台上可能因 musl libc 与检测逻辑不兼容而失败，导致 config.h 缺少必要的 HAVE_* 定义
affected_scope:         使用 CMake 构建的 C 库（如 json-c, libxml2, curl 等），特别是使用 check_c_source_compiles/check_function_exists 进行特性检测的项目
verification_cmd:       grep -E "HAVE_SNPRINTF|HAVE_DECL_ISNAN" config.h || echo "HAVE_* defines missing"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           manually-add-have-defines
rec_description:        手动在 config.h 添加缺失的 HAVE_* 定义，绕过 CMake 检测失败问题
rec_command:            echo '#define HAVE_SNPRINTF 1' >> config.h && echo '#define HAVE_DECL_ISNAN 1' >> config.h
rec_auto_fix:           true
rec_impl:               patch-config-h

fallback_priority:      2
fallback_approach:      cmake-toolchain-fix
fallback_description:   修改 CMake toolchain 文件，添加 musl 平台检测和兼容性设置
fallback_command:       
fallback_auto_fix:      false
fallback_impl:          

# ★ 禁止策略 ★
forbid_1_pattern:       sed.*config\.h.*HAVE_
forbid_1_reason:         不要使用 sed 盲目修改生成的 config.h，应该在配置后精确添加缺失的定义
forbid_1_consequence:    可能破坏其他正确的检测结果，导致编译错误

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E151.md
last_updated:            2026-04-22
source_event:           json-c 0.17 编译发现 CMake 平台检测失败


# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
