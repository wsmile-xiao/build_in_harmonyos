# Layer 0: 错误面
id: E132
title:                  OHOS SDK 链接器 LD_LIBRARY_PATH 缺失
trigger_tool:           configure
phase:                  configuration
error_signature:        Toolchain is unable to link executables|Error loading shared library libxml2.so|ld.lld: symbol not found

# Layer 1: 识别层
severity:               3
category:               environment
match_keywords:         LD_LIBRARY_PATH, libxml2, lld, linker, unable to link, Toolchain, ohos-sdk

# Layer 2: 诊断层
root_cause:             OHOS SDK 的 lld 链接器依赖 libxml2.so.16，但运行时 LD_LIBRARY_PATH 未包含 SDK 的 llvm/lib 路径。
                        导致 configure 测试链接时失败。
affected_scope:         使用 OHOS SDK LLVM 工具链编译的所有软件
verification_cmd:       ldd /data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/bin/lld | grep libxml2

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           set-environment-path
rec_description:        在编译前设置 LD_LIBRARY_PATH 包含 OHOS SDK 的 llvm/lib 路径。
rec_command:            |
  export LD_LIBRARY_PATH="/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib:${LD_LIBRARY_PATH:-}"
  # 或创建 hints/environment.sh 文件固化依赖
rec_auto_fix:           false
rec_impl:               environment-hints

fallback_priority:      2
fallback_approach:      create-hints-file
fallback_description:   创建 archives/{软件}/hints/environment.sh 固化环境依赖，确保 G0 干净构建验证可复现。
fallback_command:       |
  mkdir -p archives/l/{软件}/hints
  echo 'export LD_LIBRARY_PATH="/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib:${LD_LIBRARY_PATH:-}"' > archives/l/{软件}/hints/environment.sh
fallback_auto_fix:      true
fallback_impl:          create-hints-file

# Layer 4: 原则引用
principles:             P-ENV-001,P-STAGING-001

# 关系图
causes:                 []
caused_by:              []
similar_to:             [E002]  # /tmp 只读问题也是环境限制
conflicts_with:         []
prerequisite_of:        []

# 元数据
doc_file:               doc/E081.md
last_updated:           2026-05-29
source_event:           libvpx 1.14.1 编译

