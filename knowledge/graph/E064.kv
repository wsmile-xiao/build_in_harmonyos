#====================================================================
# E064.kv — conftest 无法执行导致配置检测失败
#====================================================================

id:                     E064
trigger_tool:           configure|autotools
phase:                  configuration
error_signature:        cannot run C compiled programs|conftest.*inaccessible or not found|
                         configure.*cross compile|config.log.*exit 127|conftest.*Permission denied

severity:               3
category:               autotools|configuration|security
match_keywords:         conftest, cross compile, configure, autotools, ac_cv_,
                         cache file, security dialog, Permission denied, exit 127,
                         config.log, cannot run compiled programs

root_cause:             autotools configure 通过编译并运行小测试程序(conftest)来检测平台能力。
                         鸿蒙上首次执行非系统二进制需要安全确认弹窗(E054), 弹窗超时未点则进程被杀,
                         configure 误判为"此平台不能运行编译出的程序"→ 错误地进入交叉编译模式,
                         导致大量检测使用硬编码默认值而非实际检测结果
affected_scope:         **所有 autotools 项目**(鸿蒙编译最常见的根因性问题)
verification_cmd:       grep "cannot run\|inaccessible\|conftest.*exit" config.log
                         # 弹窗超时特征: ./conftest: inaccessible or not found, $?=127
                         # 真交叉编译特征: file format not recognized, Exec format error

rec_priority:           1
rec_approach:           trigger-security-dialog
rec_description:        手动触发弹窗后再跑 configure:
                         先跑一次 configure(会卡在弹窗) → 快速点击所有弹窗 → 等 configure 完成;
                         如果超时被杀则重新跑(此时弹窗已确认过)
rec_command:
rec_auto_fix:          false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      cache-file-override
fallback_description:   从成功的 config.log 中提取关键变量创建 cache 文件,
                         ./configure --cache-file=config.cache 绕过 conftest 执行
fallback_auto_fix:     false

forbid_1_pattern:      在非真交叉编译场景下使用 --host 参数绕过 conftest 执行
forbid_1_reason:       --host 导致 configure 进入真正的交叉编译模式,
                         预定义宏、库路径、AC_RUN_IFELSE 全部基于假设而非实际检测
forbid_1_consequence:  级联错误链: E061(gnulib选错) → E062(符号未声明) → E063(Werror级联)
principles:             P-AUTOTOOLS-001

causes:                 [E054]   # 安全弹窗是直接原因
caused_by:              [E007]   # E007(config.guess) 被 E064 的错误结论触发重编号需求
similar_to:             [E008]
conflicts_with:         []
prerequisite_of:        [E061,E062,E063,E065]   # E064 是这些条目的共同根因

doc_file:               doc/E064.md
last_updated:           2026-04-10
source_event:           archives/s/sed/4.9/manifest.yaml
