#====================================================================
# Draft: zlib static PIC archive when OHOS already has system libz.so
#====================================================================

id:                     E541
trigger_tool:           conan|clang|ld|zlib
phase:                  packaging|linking
error_signature:        R_AARCH64_ADR_PREL_PG_HI21|z_errmsg|libz.so|libz.a|non-PIC|shared library

severity:               2
category:               ohos, system-same-name-static-pic
match_keywords:         zlib, libz.so, libz.a, -fPIC, static-only, shared object, Python extension, AArch64 relocation
title:                  zlib on OHOS should stay static-only but use PIC objects for DSO consumers

root_cause:             HarmonyOS provides a system libz.so, so publishing another shared libz.so from Conan can collide with system loader paths. However, a plain static libz.a built without -fPIC cannot be linked into shared libraries or Python extension modules on AArch64.
affected_scope:         zlib packages and downstream OHOS consumers that link zlib transitively into shared libraries, modules, or plugin DSOs.
verification_cmd:       CI_PACKAGES="archives/z/zlib/1.3.1.1.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           static-only-pic-archive
rec_description:        Build zlib with upstream configure in static mode, keep the package artifact as lib/libz.a, and force CFLAGS to include -fPIC. This avoids publishing a competing libz.so while still allowing downstream shared objects to absorb zlib objects safely.
rec_command:            CONFIG_SHELL=/data/service/hnp/bin/bash CC=/data/service/hnp/bin/clang CFLAGS="-O3 -fPIC" /data/service/hnp/bin/bash ./configure --static --prefix=/ && make -j1 && make check
rec_auto_fix:           false
rec_impl:               conanfile.py build() sets --static and appends -fPIC when missing

fallback_priority:      2
fallback_approach:      consumer-side-version-pin
fallback_description:   If older zlib packages already exist, add a suffix package version for the PIC archive and pin DSO-building consumers to that version.
fallback_command:       self.requires("zlib/1.3.1.1.1")
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       publish Conan libz.so on OHOS|drop -fPIC from static zlib|replace system libz.so
forbid_1_reason:        Shared libz.so can collide with the platform library, while non-PIC libz.a breaks DSO and Python extension links.
forbid_1_consequence:   Downstream consumers can fail with AArch64 relocation errors or load the wrong libz implementation at runtime.


causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

