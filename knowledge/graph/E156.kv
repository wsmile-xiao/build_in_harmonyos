#====================================================================
# E097.kv — fbida 自定义 Autoconf 构建系统问题
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E156
trigger_tool:           make|autoconf|configure
phase:                  configuration
error_signature:        GNUmakefile.*mk/Autoconf.mk|
                        make.*No rule to make target.*configure|
                        make config.*needed|
                        mk/Autoconf.mk.*No such file

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, autotools
match_keywords:         fbida, Autoconf.mk, GNUmakefile, make config, custom build system, non-standard configure

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             **fbida 使用自定义的 autoconf 系统（mk/Autoconf.mk），不是标准的 autotools**。
                         1. 没有 ./configure 脚本，而是使用 GNUmakefile 和 mk/Autoconf.mk
                         2. 配置命令是 `make config`，而不是 `./configure`
                         3. 配置过程通过 scripts/ 目录下的脚本完成
                         这是 fbida 项目特有的构建方式，需要按照其文档进行配置。
affected_scope:         fbida 及其衍生项目、所有使用类似自定义 autoconf 系统的项目。
verification_cmd:       # 1. 检查是否有 configure 脚本：ls -la configure 2>&1;# 输出: No such file (不存在);# 2. 检查构建系统：head -20 GNUmakefile | grep -i autoconf;# 输出: include mk/Autoconf.mk;# 3. 检查配置命令：grep -r "make config" README 2>&1 | head -5

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           standard-fbida-config
rec_description:        使用 fbida 标准的配置命令 `make config`。这会生成 Make.config 文件，包含编译配置。如果需要自定义配置，可以手动编辑 Make.config 或设置环境变量。
rec_command:            # Step 1: 运行配置：make config;# Step 2: 检查生成的配置：cat Make.config;# Step 3: 如需修改，编辑 Make.config 或设置环境变量：export HAVE_LINUX_FB_H=no && make config
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      manual-makeconfig
fallback_description:   手动创建 Make.config 文件，设置必要的编译变量。适用于 make config 失败或需要精细控制的情况。
fallback_command:        cat > Make.config << 'EOF'
                        RESOURCES := /usr/share/fbida
                        JPEG_VER := 62
                        HAVE_LINUX_FB_H := no
                        HAVE_MOTIF := no
                        HAVE_LIBSANE := no
                        HAVE_GLIBC := yes
                        EOF
fallback_auto_fix:      false
fallback_impl:          manual

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        [E098, E099]

