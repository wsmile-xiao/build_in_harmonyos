#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E321.kv，填写各字段
# 对应的人类文档: doc/E321.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E517
trigger_tool: clang|configure|dlopen|runtime
phase: configuration|testing|runtime
error_signature: Error loading shared library .*: Permission denied|Permission denied .needed by

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 1
category:               security, dynamic-loading
match_keywords: codesign,binary-sign-tool,selfSign,Permission denied,dlopen,shared library,published package,signature invalid,E135
title: Published Conan package .so can carry a signature the consuming device rejects (dlopen: Permission denied)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS 拒绝映射签名不被本机接受的共享库，且错误文案是 Permission denied 而不是 No such file。与 E135（完全未签名）不同：本例中文件确实带 .codesign 段（llvm-readelf -SW 计数为 1），但该签名在消费端设备上无效——已发布包在构建机上签名后随二进制分发，落到另一台设备就可能不被接受。同一目录里其他依赖库可正常 dlopen，因此极易被误判为路径问题或符号链接问题。
affected_scope: 任何把已发布 Conan 包的 .so 直接映射进本进程的构建或测试阶段（autoconf 运行探测、test_package 消费者、ctypes/dlopen 插件加载）。
verification_cmd: dlopen 绝对路径逐个探测：对同一目录内相邻库能成功、目标库报 Permission denied，即判定为签名无效而非路径缺失

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: remove-then-resign-in-task-local-view
rec_description: 把目标库复制进任务私有视图后，先用 llvm-objcopy --remove-section .codesign 去掉旧段（binary-sign-tool 无法覆盖已有段），再用 binary-sign-tool sign -selfSign 1 重新签名，最后校验 .codesign 计数恰为 1 且保留 owner 可执行位。绝不修改依赖包本体。
rec_command: llvm-objcopy --remove-section .codesign $VIEW/libfoo.so.1 && binary-sign-tool sign -inFile $VIEW/libfoo.so.1 -outFile $VIEW/libfoo.so.1.signed -selfSign 1 && mv $VIEW/libfoo.so.1.signed $VIEW/libfoo.so.1 && llvm-readelf -SW $VIEW/libfoo.so.1 | grep -c codesign
rec_auto_fix: false
rec_impl: 

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: per-file-absolute-dlopen-triage
fallback_description: 先用绝对路径 dlopen 逐个隔离，确认是签名、符号链接还是路径问题，再决定是否需要重签名；不要直接改成静态链接来掩盖（AGENTS 禁止）。
fallback_command: clang -o dl_probe dl_probe.c && ./dl_probe /abs/path/libfoo.so.1.2.3
fallback_auto_fix: false
fallback_impl: 

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 看到 Permission denied 就改成静态链接或放宽 chmod
forbid_1_reason: 静态链接只掩盖了本机加载问题；HMDFS 的 chmod 会被归一化，且权限位不是最终权限（MAC 优先）
forbid_1_consequence: 产物语义被改变、问题被推迟到下游消费端爆发
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

