#====================================================================
# E114.kv — C++ 前向声明 class/struct 不匹配 (-Wmismatched-tags)
# 来源事件: libfreehand 0.1.1 编译
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E114
trigger_tool:           clang|make
phase:                  compilation
error_signature:        error: conflicting declaration.*struct|error: conflicting declaration.*class|-Wmismatched-tags

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               c++|compiler-warning|platform
match_keywords:         Wmismatched-tags, conflicting declaration, struct, class, forward declaration, FHTransform
title:                  C++ 前向声明 class/struct 标签不匹配

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             头文件中前向声明使用 class X，但实际定义使用 struct X（或相反），clang -Wmismatched-tags 将其视为错误
affected_scope:         使用 clang 编译的 C++ 项目，前向声明与实际定义不一致的情况（如 libfreehand, libcdr 等 LibreOffice 系列）
verification_cmd:       grep -rn "class FHTransform\|struct FHTransform" src/lib/FHPath.h src/lib/FHTransform.h

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description:        将前向声明的 class 改为 struct（或反之），使其与实际定义一致
rec_command:            sed -i 's/class FHTransform/struct FHTransform/' src/lib/FHPath.h
rec_auto_fix:           true
rec_impl:               source-patch

# 回退方案
fallback_priority:      2
fallback_approach:      disable-warning
fallback_description:   使用 -Wno-mismatched-tags 禁用此警告（不推荐，可能隐藏其他问题）
fallback_command:       sed -i 's/-Wall/-Wall -Wno-mismatched-tags/' configure
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       --build=|--host=
forbid_1_reason:        R23: 不要用 --build/--host 绕过平台检测
forbid_1_consequence:   误判为交叉编译，AC_RUN_IFELSE 全部跳过

# ═══ Layer 4: 原则引用 ═══
principles:             P-PATCH-001

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E115]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E114.md
last_updated:           2026-06-25
source_event:           libfreehand-0.1.1

draft: false
contributor_id:         F7B1
