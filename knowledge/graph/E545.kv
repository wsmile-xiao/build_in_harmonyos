#====================================================================
# 来源事件: libcolord 1.4.8 HarmonyOS 适配（archives/l/libcolord/1.4.8）
#====================================================================

id:                     E545
trigger_tool:           meson|conan
phase:                  configuration|build|package
error_signature:        skip.*client.*subdir|daemon=false.*libcolord|colord.*client.*library
severity:               2
category:               build-system, packaging, portability
match_keywords:         colord, libcolord, client subdir, daemon=false, pure library, commands.json, meson, colormgr, cd-iccdump

title:                  colord 客户端库（libcolord）作为纯库包单独适配：daemon=false 且跳过 client/ 子目录，产物无 bin/，按 R38 无需 commands.json

root_cause:             colord 上游同一仓库同时产出 daemon、客户端 CLI 工具（colormgr、cd-iccdump 等，位于 client/）与客户端库 libcolord；纯库适配需 daemon=false 并跳过 client/ 子目录，避免引入需要 D-Bus / 构建期 ELF 签名二进制的 CLI 产物。产物仅 lib/+include/+pkgconfig，无 bin/ 可执行文件，按 R38 不需要 commands.json。
affected_scope:         colord 家族（libcolord / colord）及同类『上游整体包拆客户端库』的 OHOS 纯库适配
verification_cmd:       grep -rn 'client' archives/l/libcolord/*/conanfile.py && ls archives/l/libcolord/1.4.8/ 2>/dev/null | grep commands.json; echo rc=$?

rec_priority:           1
rec_approach:           pure-library-subset-packaging
rec_description:        适配 colord 客户端库时 -Ddaemon=false 并跳过 client/ 子目录，纯库包无需 commands.json（R38）；与同源 colord 包共用 meson 选项与补丁方案
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

