#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E112.kv，填写各字段
# 对应的人类文档: doc/E112.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E194
trigger_tool:           cc|clang|perl|make
phase:                  compilation
error_signature:        bits/alltypes.h.*No such file|sys/types.h.*No such file|fatal error.*bits/alltypes.h

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               platform|headers|musl|perl-xs
match_keywords:         musl, bits/alltypes.h, sys/types.h, Perl XS, header missing, OpenHarmony SDK, DateTime
title:                  OpenHarmony SDK 缺少 musl libc 头文件导致 Perl XS 模块编译失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             OpenHarmony SDK 提供的 musl libc 头文件集不完整，缺少 bits/alltypes.h 等核心类型定义文件。
                        Perl XS 模块的 C 代码依赖标准 POSIX 头文件（sys/types.h），而 sys/types.h 又依赖 bits/alltypes.h。
affected_scope:         所有包含 C 代码的 Perl 模块（XS 模块），以及其他依赖完整 musl libc 头文件的软件。
verification_cmd:       |
  # 检查 OpenHarmony SDK 头文件目录是否包含 bits/alltypes.h
  find /usr/include -name "alltypes.h" 2>/dev/null | grep bits
  # 如果返回空 → 确认命中 E112

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           platform-limitation-record    # 见 DESIGN §5 impl 列表
rec_description:        标记为平台限制，记录到 manifest.yaml 的 knowledge_gained，跳过编译，等待 OpenHarmony 完善系统头文件支持。
rec_command:            |
  # 无法通过源码修改解决，记录平台限制
  echo "Platform limitation: OpenHarmony SDK lacks musl libc headers (bits/alltypes.h)" >> notes.md
  # 更新 manifest.yaml
  sed -i 's/^status: built$/status: failed/' manifest.yaml
rec_auto_fix:           false                        # 引擎能否自动执行
rec_impl:               platform-limitation-record   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      cross-compile-suggestion
fallback_description:   建议使用交叉编译方式，在完整的 Linux 环境中编译 Perl XS 模块，然后移植到 OpenHarmony。
fallback_command:       |
  # 提示用户可能的解决方案（非自动执行）
  echo "Alternative: Cross-compile on full Linux environment with complete musl headers"
fallback_auto_fix:      false
fallback_impl:          none

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       手动创建 bits/alltypes.h 文件|复制 glibc 头文件到 musl
forbid_1_reason:        musl 和 glibc 的类型定义不同，手动创建或复制会导致 ABI 不兼容、运行时崩溃等严重问题。
forbid_1_consequence:   编译可能成功但运行时出现类型大小不匹配、结构体布局错误、内存访问违规等难以排查的问题。
# forbid_2_pattern:     sed -i.*bits/alltypes.h
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P-PLATFORM-001

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             [E020,E026,E078]
conflicts_with:         []
prerequisite_of:        []

