#====================================================================
# E104-draft-5FC0.kv — verify_build.py 检查 build_system 字段不一致
#====================================================================

id: E170
trigger_tool:           verify_build
phase:                  verify
error_signature:        manifest 缺少 build_system|
                        G4 Archive FAIL.*manifest|
                        verify_build.*build_system

severity:               1
category:               toolchain
match_keywords:         verify_build, manifest, build_system, G4, archive, 

root_cause:             verify_build.py 在 G4 检查中查找 build_system: 字段（顶级），
                        但版本级 manifest.yaml 规范使用 build.system:（嵌套结构），
                        导致检查失败
affected_scope:         所有使用版本级 manifest.yaml 的软件
verification_cmd:       grep -n "build_system:" archives/*/manifest.yaml; grep -n "build:" archives/*/manifest.yaml

rec_priority:           1
rec_approach:           add-compat-field
rec_description:        在版本级 manifest.yaml 中添加顶级 build_system: 字段作为兼容性方案
rec_command:            sed -i '/^status:/a build_system: cmake' archives/{letter}/{name}/{version}/manifest.yaml
rec_auto_fix:           true
rec_impl:               yaml-edit

fallback_priority:      2
fallback_approach:       fix-verify-script
fallback_description:   修改 verify_build.py，检查 build.system 字段或软件级 manifest
fallback_command:       修改 verify_build.py gate4_archive 中的字段检查逻辑
fallback_auto_fix:      false
fallback_impl:           script-edit

forbid_1_pattern:       none
forbid_1_reason:        none
forbid_1_consequence:   none

principles:              

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E170.md
last_updated:           2026-05-20
source_event:           fmt 11.0.2 编译失败于 verify-build G4

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
