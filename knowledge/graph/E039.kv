#====================================================================
# E039.kv — musl iconv 不支持 //IGNORE 后缀
#====================================================================

id:                     E039
title: musl iconv 不支持 //IGNORE 后缀
trigger_tool:           man-db|iconv|runtime
phase:                  runtime
error_signature:        iconv_open.*//IGNORE.*Invalid argument|
                         iconv.*//IGNORE.*Invalid|musl.*iconv.*not support

severity:               2
category:               libc|compat|encoding
match_keywords:         iconv, //IGNORE, //TRANSLIT, musl, glibc, UTF-8,
                         encoding conversion, man-db, manconv, mandb, whatis

root_cause:             glibc 的 iconv 支持 //IGNORE(忽略不可转换字符) 和 
                         //TRANSLIT(音译) 后缀扩展, 但 musl libc 的 iconv 不支持这些后缀。
                         man-db 的 manconv 工具使用 iconv_open("UTF-//IGNORE", ...)
affected_scope:         man-db 的 whatis/apropos 搜索功能失效; man 命令本身显示不受影响
verification_cmd:       mandb 2>&1 | grep -i "iconv"

rec_priority:           1
rec_approach:           source-patch
rec_description:        musl 兼容方案: 去掉 //IGNORE 后缀, 使用标准编码名
rec_command:
rec_auto_fix:          false
rec_impl:               patch

forbid_1_pattern:      在代码中使用 iconv_open("...//IGNORE", ...) 或 "...//TRANSLIT" 格式
forbid_1_reason:       musl iconv 不支持 glibc 扩展后缀, 导致 Invalid argument 错误
forbid_1_consequence:  字符编码转换完全失败; man-db whatis 解析全部失败
fallback_priority:      2
fallback_approach:      manual-workaround
fallback_description:   如果自动补丁不适用，手动在源码中做最小兼容修改并记录到 PROGRESS.md
fallback_command:      # 手动编辑源码后记录:
# 1. 修改文件列表
# 2. 修改原因
# 3. 验证方式
fallback_auto_fix:     false
fallback_impl:          manual
principles:             P-PATCH-001

causes:                 []
caused_by:              [E038]
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E039.md
last_updated:           2026-04-10
source_event:           archives/s/man-db/2.13.1/manifest.yaml
