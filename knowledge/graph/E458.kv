#====================================================================
# E327-draft-D4B1.kv — restinio 0.6.19 header-only 适配：官方 tarball 未打包 bundled 依赖 +
#                     sendfile 部分读 Broken pipe → SIGSEGV + http-parser 依赖闭环
#
# ⚠️ DRAFT：未提升为正式条目，禁止 promote。草稿归属：Agent D4B1
#====================================================================

# ═══ Layer 0: 错误面 ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E458
trigger_tool:           cmake|ctest|conan
phase:                  configuration,testing
error_signature:        add_subdirectory given source.*which does not contain a CMakeLists.txt|Compatibility with CMake < 3\.5 has been removed|unable to openfile.*\.dat|send file data error: 32 \(Broken pipe\)|Signal 11|_unit\.test\.sendfile|read_until: End of file

# ═══ Layer 1: 识别层 ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               platform, headers, dependency, testing
match_keywords:         restinio, header-only, C++14, sendfile, SIGSEGV, Signal 11, broken pipe, read_until, End of file, http-parser, asio, fmt, RESTINIO_FIND_DEPS, RESTINIO_USE_EXTERNAL_HTTP_PARSER, externals.rb, dependency closure, ohpcd, HTTP server, 127.0.0.1

# ═══ Layer 2: 诊断层 ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             restinio 0.6.19 官方 release tarball 未打包 bundled 依赖源码
                        （dev/asio、dev/fmt、dev/nodejs/http_parser 的 .c/.h 均缺失，
                        仅含 CMakeLists 骨架，需按 externals.rb 另行下载），CMake 默认路径
                        （RESTINIO_FIND_DEPS=OFF）add_subdirectory 直接失败；必须
                        RESTINIO_FIND_DEPS=ON + RESTINIO_USE_EXTERNAL_HTTP_PARSER=ON 走外部
                        依赖。http-parser 为 restinio 必需依赖且未发布 ohpcd 制品仓
                        → R36 依赖闭环。sendfile 测试在客户端中途断开时（Broken pipe）
                        触发 Signal 11 SIGSEGV，3/3 可复现（EXIT=139），根因待进一步
                        对照上游 issue 与 Linux x86_64 确认是否平台特有。
affected_scope:         所有 header-only C++14 HTTP 服务库（restinio 及同类），以及
                        依赖 nodejs/http-parser 的库在 OHOS 上的适配与测试执行。
verification_cmd:       ctest --output-on-failure && cd build/test/sendfile && ./_unit.test.sendfile; echo $?

# ═══ Layer 3: 方案层 ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           probe-only-then-publish-deps
rec_description:        header-only 库先以官方 tarball + externals.rb 装配依赖做
                        probe_only_no_upload 最小构建与上游测试，确认真实症状与数据路径；
                        required 依赖（http-parser）未发布时停止正式适配，按 R36 先发布
                        依赖到 ohpcd，再继续 conanfile 归档，不把依赖源码混入 restinio PR。
rec_command:            cmake ../src/dev -DRESTINIO_SAMPLE=OFF -DRESTINIO_BENCH=OFF -DRESTINIO_ALLOW_SOBJECTIZER=OFF -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && cmake --build . -j4 && ctest --output-on-failure
rec_auto_fix:           false
rec_impl:               probe-and-publish

fallback_priority:      2
fallback_approach:      fix-test-data-cwd
fallback_description:   sendfile 类测试从 build 根目录跑会因测试数据相对路径
                        （test/sendfile/f1.dat）与 configure_file 复制位置
                        （${CMAKE_CURRENT_BINARY_DIR}/test/sendfile/）不一致而失败；
                        应从正确 CWD（build/test/sendfile）运行或把数据文件放到
                        测试期望的相对路径，再区分数据路径问题与真实崩溃。
fallback_command:       cd build/test/sendfile && ./_unit.test.sendfile
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       sed.*main\.cpp.*REQUIRE|remove.*TEST_CASE|skip.*sendfile
forbid_1_reason:        禁止修改上游测试断言、skip 条件、测试数据或预期结果
forbid_1_consequence:   掩盖真实症状，伪造通过
forbid_2_pattern:       cp.*http_parser.*conanfile|include.*http_parser.*in PR
forbid_2_reason:        required 依赖未发布时不得把依赖源码混入 restinio PR
forbid_2_consequence:   R36 依赖闭环被绕过，CI L0i Hard Fail
forbid_3_pattern:       print.*passed|echo.*success.*skip.*test
forbid_3_reason:        不得用空壳 self.run/echo/mock 代替真实测试运行（R34）
forbid_3_consequence:   破坏性反向验证无法证明测试依赖被测包

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:               P010, P013, P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:
caused_by:
similar_to:               E103, E187, E307
conflicts_with:
prerequisite_of:

