#=============================================================================
# busybox-ohos-musl-gnu-ext.kv — OHOS musl 缺失 GNU/BSD 扩展函数的 BusyBox 兼容层
# 库: busybox 1.36.1
# 适配轮次: R01 (2026-08-22)
# 关联: E093 (musl 缺 getpass), E213 (musl 缺 l64a), E094 (musl 缺 pthread_attr_setaffinity_np)
# 非重复: 本条目验证的具体函数(gethostid/strverscmp/sigisemptyset/getusershell)未被任何已有条目覆盖
#=============================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E534
trigger_tool:           clang|ld.lld|conan
phase:                  link|compilation
error_signature:        undefined symbol: gethostid|undefined symbol: strverscmp|undefined symbol: sigisemptyset|call to undeclared function 'getusershell'|call to undeclared function 'gethostid'|implicit declaration.*getusershell|implicit declaration.*gethostid

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               portability, libc, musl, gnu-extensions
match_keywords:         gethostid, strverscmp, sigisemptyset, getusershell, endusershell, GNU extension, musl, OHOS, missing libc, compat, missing_syscalls, hostid, sort, hush, su, loginutils

# ═══ Layer 2: 诊断层 ═══
title:                  OHOS musl 缺失 GNU/BSD 扩展函数的 BusyBox 兼容层与配置规避
root_cause:            OHOS musl libc 基于 musl 标准实现，不提供 gethostid、strverscmp、sigisemptyset、getusershell 等 GNU/BSD 扩展函数。这些函数在 glibc 中属于标准扩展，但 musl 项目明确选择不实现非 POSIX 扩展。BusyBox 的某些 applet（hostid、sort -V、ls -v、hush shell、su）直接调用这些函数，编译时产生隐式声明警告/错误，链接时产生未定义符号错误。
affected_scope:        BusyBox 1.36.1 及同类基于 musl 的 OHOS 环境中使用 gethostid/strverscmp/sigisemptyset/getusershell 调用的软件。已知: hostid (coreutils), sort -V (coreutils), ls -v (coreutils), hush shell (shell/hush.c), su (loginutils)。
verification_cmd:      echo '#include <string.h>' | clang -x c - -c -E -dM 2>/dev/null | grep HAVE_STRVERSCMP; echo '#include <signal.h>' | clang -x c - -c -E -dM 2>/dev/null | grep sigisemptyset; echo '#include <unistd.h>' | clang -x c - -c -E -dM 2>/dev/null | grep gethostid; nm -D /lib/ld-musl-aarch64.so.1 2>/dev/null | grep -E 'gethostid|strverscmp|sigisemptyset'

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           compat-patch-in-missing-syscalls
rec_description:       在 libbb/missing_syscalls.c 中添加 gethostid/strverscmp/sigisemptyset 的兼容实现，用 __attribute__((weak)) 弱符号（无需平台条件编译，链接时自动检测：glibc 强符号优先，musl 缺时弱定义生效）。getusershell 因逻辑较复杂（需扫描 /etc/shells），建议直接禁用 applet（CONFIG_SU=n）。实现原则：最小化、不改变调用语义、仅填补 libc 空缺。
rec_command:            |
  diff --git a/libbb/missing_syscalls.c b/libbb/missing_syscalls.c
  --- a/libbb/missing_syscalls.c
  +++ b/libbb/missing_syscalls.c
  +__attribute__((weak)) long gethostid(void) { return 0; }
  +__attribute__((weak)) int strverscmp(const char *l0, const char *r0) { /* 标准 GNU 算法，长度比较优先，无溢出；详见 patch */ }
  +__attribute__((weak)) int sigisemptyset(const sigset_t *set) { for(i=1;i<_NSIG;i++) if(sigismember(set,i)) return 0; return 1; }
  (完整实现见 BusyBox 1.36.1 适配 patches/0001-ohos-compat-missing-libc-functions.patch)
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      config-disable-applets
fallback_description:   若不愿提供源码补丁，可通过 .config 禁用调用这些函数的 applet（CONFIG_HOSTID=n, CONFIG_FEATURE_SORT_BIG=n, CONFIG_SU=n），但 hush 调用 sigisemptyset 无法通过 config 禁用，必须提供补丁。

# ═══ Layer 4: 验证层 ★ ═══

# ═══ Layer 5: 排除层 ═══
doc_file: doc/E534.md
source_pr: !6286
last_updated:               2026-08-31
authors: junshi_liu <liujsh2023@lzu.edu.cn>
