id: E135
title: libintl.so.8 未 ELF 签名导致动态链接器拒绝加载
trigger_tool:           ld|runtime
phase:                  runtime|linking
error_signature:        Error loading shared library libintl\.so\.8|libintl\.so\.8.*not found|
                         symbol not found.*libintl_gettext|dlopen.*libintl\.so

severity:               3
category:               platform-elf-signature
match_keywords:         libintl, ELF signature, signing,
                         dynamic linker, Error loading shared library,
                         symbol not found, dlopen

root_cause:             HarmonyOS 动态链接器要求所有 .so 文件必须经过 ELF 签名，未签名的库即使路径正确也会被拒绝加载
affected_scope:         所有依赖 gettext/libintl 的软件在 HarmonyOS 上运行
verification_cmd:       LD_LIBRARY_PATH=$DEFAULT_PREFIX/lib msgmerge --version

rec_priority:           1
rec_approach:           sign-elf-library
rec_description:        使用 ohc-run.py sign-elf 对 libintl.so.8 及相关 gettext 库进行 ELF 签名
rec_command:            python3 $SKILL_ROOT/scripts/ohc-run.py sign-elf /path/to/libintl.so.8
rec_auto_fix:           true
rec_impl:               sign-elf

fallback_priority:      2
fallback_approach:      LD_LIBRARY_PATH
fallback_description:   设置 LD_LIBRARY_PATH 环境变量（仅临时方案，不解决签名问题）
fallback_command:       LD_LIBRARY_PATH=$DEFAULT_PREFIX/lib ./configure
fallback_auto_fix:      false

forbid_1_pattern:       ln -sf.*libintl
forbid_1_reason:        HMDFS 不支持 ln -sf 覆盖（R5）
forbid_1_consequence:   符号链接创建失败或覆盖失败

principles:             R7

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E082.md
last_updated: 2026-06-01
source_event:           libbytesize-2.11-compile

draft: false
contributor_id: 0BE3