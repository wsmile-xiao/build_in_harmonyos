#====================================================================
# E069.kv — automake 鸡生蛋问题 (build-systems.md §10.1)
# make 过程需调用尚未构建好的 automake 重新生成 Makefile.in
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E069
title: automake 鸡生蛋问题
trigger_tool:           make
phase:                  compilation
error_signature:        @am_AUTOCONF@|@am_AUTOMAKE@|unresolved.*Makefile\.in|timestamp.*regenerate|automake.*not found

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               autotools|circular-dependency
match_keywords:         automake, circular dependency, Makefile.in, regenerate, @am_, gen-all.pl, timestamp

# ═══ Layer 2: 诊断层 ═══
root_cause:             编译 automake 自身时，make 过程调用尚未构建好的 automake
                         重新生成 Makefile.in，形成循环依赖。
                         config.status 执行后 Makefile 中存在未替换变量(@am_AUTOCONF@等)
affected_scope:         automake 及其依赖链软件（如需要 re-autoconf 的项目）
verification_cmd:       grep -n '@am_' Makefile 2>/dev/null | head -5

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           use-gen-perl-script
rec_description:        使用 automake 自带的 gen-all.pl 手动生成所有模板文件，
                         然后手动 sed 修补残留变量
rec_command:            |
  # 1. 用 gen-all.pl 预生成模板
  perl gen-all.pl
  # 2. sed 修补残留变量
  sed -i 's/@am_AUTOCONF@/autoconf/g' Makefile
  sed -i 's/@am_AUTOMAKE@/automake/g' Makefile
rec_auto_fix:           false
rec_impl:               manual-fix

fallback_priority:      2
fallback_approach:      bypass-autotools-env
fallback_description:   设置 ACLOCAL/AUTOHEADER/AUTOMAKE=/bin/true 绕过 autotools 调用
                       （仅当 tarball 已包含正确生成的 Makefile.in 时可用）
fallback_command:      ACLOCAL="/bin/true" AUTOHEADER="/bin/true" AUTOMAKE="/bin/true" ./configure --prefix=$PREFIX
fallback_auto_fix:      true
fallback_impl:          set-env-var

forbid_1_pattern:       aclocal.*--force(?!.*预生成后)
forbid_1_reason:        强制重新生成会再次触发循环依赖
forbid_1_consequence:   无限循环或同样的未替换变量错误

# ═══ Layer 4: 原则引用 ═══
principles:             P-PATCH-001,P-AUTOTOOLS-001

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             [E041]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E069.md
last_updated:           2026-04-10
source_event:           automake 自身编译 (archives/p/automake)
