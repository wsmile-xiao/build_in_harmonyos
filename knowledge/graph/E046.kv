#====================================================================
# E046.kv — chmod() 完全不生效
#====================================================================

id:                     E046
trigger_tool:           python|runtime|testing
phase:                  runtime|testing
error_signature:	 chmod.*not effective|os\.chmod.*no effect|
                         permission.*assertion.*fail.*chmod|test.*chmod.*fail

severity:               1
category:               filesystem|selinux|testing
match_keywords:         chmod, not effective, SELinux, HMDFS, os.access,
                         permission, test failure, stat, mode unchanged, HarmonyOS

root_cause:             HarmonyOS 的 SELinux 或 HMDFS 文件系统忽略了 POSIX chmod() 调用。
                         chmod() 返回成功但不实际修改文件权限。
                         所有依赖 chmod() 创建受限权限文件的测试逻辑都会失效
affected_scope:         Python 测试套件中依赖 chmod 的测试 (至少 7 个: test_httpservers, test_argparse 等)
verification_cmd:       python3 -c "
import os, tempfile, stat
tmpf = tempfile.NamedTemporaryFile(delete=False); tmpf.close()
os.chmod(tmpf.name, 0o000)
print('Mode:', oct(stat.S_IMODE(os.stat(tmpf.name).st_mode)))
print('Readable:', os.access(tmpf.name, os.R_OK))
os.unlink(tmpf.name)
"

rec_priority:           1
rec_approach:           skip-test
rec_description:        对于测试代码, 跳过依赖 chmod 的测试:
                         检测 chmod 是否生效, 不生效则 raise unittest.SkipTest
rec_command:
rec_auto_fix:          true
rec_impl:               skip-test

forbid_1_pattern:
principles:              P013
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E046.md
last_updated:           2026-04-10
source_event:           archives/s/python/3.9.0/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

