#====================================================================
# Knowledge Entry: E103 — Go link 工具在 HMDFS 上 SELinux 权限限制
# Contributor: 44C1
# Date: 2026-06-04
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E166
trigger_tool:           go|link
phase:                  linking
error_signature:        link: mapping output file failed: permission denied|Go build failed: link tool permission denied|fork/exec.*link.*permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               platform_limitation|selinux|hmdfs|go
match_keywords:         Go,link,permission denied,mapping output file,HMDFS,SELinux,Go build,link tool,ELF 签名

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HMDFS(鸿蒙分布式文件系统)的SELinux强制访问控制(MAC)策略限制了Go link工具的某些操作(如mmap、临时文件创建或文件映射)。即使Go工具链二进制文件已通过ELF签名,仍无法绕过SELinux系统级安全策略。
affected_scope:         所有Go项目在HMDFS文件系统上的编译。受影响软件:pumba、任何使用go build的项目。
verification_cmd:       尝试编译任何Go项目(如go build -v ./cmd),观察是否出现"link: mapping output file failed: permission denied"错误。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           platform_limitation
rec_description:        Go link工具在HMDFS上遇到SELinux权限限制,无法正常工作。目前无即时解决方案,需等待鸿蒙系统更新SELinux策略或使用其他编译环境(非HMDFS)。建议记录为平台限制,不阻塞其他软件编译流程。
rec_command:            无可行修复命令。建议: 1) 记录为平台限制(E046类似问题); 2) 在其他环境(非HMDFS)编译Go项目; 3) 等待鸿蒙系统SELinux策略更新
rec_auto_fix:           false
rec_impl:               manual_skip

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      workaround
fallback_description:   尝试在/tmp或其他非HMDFS目录编译,但可能仍然无效(因为link工具本身受SELinux限制)
fallback_command:       TMPDIR=/storage/Users/currentUser/tmp && go build -v -o /storage/Users/currentUser/tmp/output ./cmd
fallback_auto_fix:      false
fallback_impl:          manual

# ═══ Layer 4: 原则引用 ═══
principles:               

