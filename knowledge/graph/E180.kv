# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E180
trigger_tool:           cargo|rustc|rust
phase:                  configuration|compilation
error_signature:        cargo: No such file or directory|rustc: command not found|ld-linux-aarch64.so.1: No such file

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               1
category:               toolchain, rust
match_keywords:         rust, cargo, rustc, glibc, musl, OHOS target

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             新HNP工具链已添加Rust 1.95.0，支持OHOS target
affected_scope:         50+ Rust项目（ripgrep, fd, bat, htop, procs等）
verification_cmd:       rustc --version && cargo --version

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           rust-native-compile
rec_description:        直接使用rustc/cargo编译，默认target已是aarch64-unknown-linux-ohos
rec_command:            rustc main.rs -o hello || cargo build --release
rec_auto_fix:           true
rec_impl:               rust-compile

# ★ 禁止策略 ★
forbid_1_pattern:       
forbid_1_reason:        
forbid_1_consequence:   

