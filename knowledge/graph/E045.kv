#====================================================================
# E045.kv — mmap RWX 被拒（W^X 策略）
#====================================================================

id:                     E045
trigger_tool:           python|ctypes|runtime
phase:                  runtime
error_signature:        MemoryError|ctypes.*CFUNCTYPE|mmap.*PROT_WRITE.*PROT_EXEC.*Invalid argument|
                         W^X|mmap.*RWX

severity:               3
category:               kernel|security|memory|compat
match_keywords:         mmap, RWX, W^X, ctypes, CFUNCTYPE, MemoryError,
                         libffi, closure, JIT, PROT_EXEC, mprotect, Invalid argument

root_cause:             HarmonyOS 内核强制 W^X(Write XOR Execute) 安全策略,
                         禁止同时可写且可执行的内存映射。
                         libffi 创建回调 closure 时需要分配 RWX 内存页存放动态生成的跳转代码
affected_scope:         Python ctypes CFUNCTYPE 回调、libffi closure、JIT 编译器(PyPy/numba)、动态代码生成
verification_cmd:       python3 -c "
import ctypes
t = ctypes.CFUNCTYPE(None, ctypes.c_void_p)
try:
    @t
    def f(ptr): pass
except MemoryError:
    print('W^X: blocked')
"

rec_priority:           1
rec_approach:           no-fix-platform-limitation
rec_description:        当前无法在 Python 层修复。需在 libffi 层使用 RW→RX 分步映射:
                         mmap(RW) → memcpy → mprotect(RX)。临时绕过: subprocess 替代进程内回调
rec_command:
rec_auto_fix:          false
rec_impl:               none

forbid_1_pattern:      在鸿蒙目标平台上使用 mmap(PROT_READ|PROT_WRITE|PROT_EXEC) 申请 RWX 内存
forbid_1_reason:       鸿蒙内核 W^X 策略拒绝 RWX 映射, 返回 Invalid argument 或导致 MemoryError
forbid_1_consequence:  ctypes 回调包装器创建失败(MemoryError); libffi closure 分配返回 NULL
fallback_priority:      2
fallback_approach:      consult-knowledge
fallback_description:   推荐方案不适用时，查阅 knowledge/error-patterns.md 中相似条目的替代方案
fallback_command:      grep -r "关键词" knowledge/graph/index.tsv
fallback_auto_fix:     false
fallback_impl:          none
principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E045.md
last_updated:           2026-04-10
resolved_in:            HongMeng Kernel 1.12.0
resolved_note:          W^X 策略已放宽，mmap(PROT_READ|PROT_WRITE|PROT_EXEC) 正常工作，ctypes CFUNCTYPE 回调可用
source_event:           archives/s/python/3.9.0/manifest.yaml
