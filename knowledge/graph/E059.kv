# Layer 0: 错误面
id: E059
title:                  aclocal.m4 包含未替换的 @am_AUTOM4TE@ 占位符
trigger_tool:           aclocal/autogen.sh
phase:                  configuration

# Layer 1: 识别层
severity:               3
category:               autotools-bootstrap
error_signature:        @am_AUTOM4TE@.*inaccessible|sh: @am_AUTOM4TE@.*not found|aclocal.*error.*@am_AUTOM4TE@
match_keywords:         AUTOM4TE, aclocal.m4, placeholder, automake, bootstrap, configure.ac

# Layer 2: 诊断层
root_cause:             aclocal.m4 文件在打包时未正确处理 automake 宏变量，导致 @am_AUTOM4TE@ 占位符未被替换为实际路径。
                        这是打包脚本或 autotools 配置文件的问题，而非源码本身的问题。
affected_scope:         所有包含不完整 aclocal.m4 的 Autotools 项目
verification_cmd:       grep "@am_AUTOM4TE@" aclocal.m4 || grep "@am_" aclocal.m4

# Layer 3: 方案层
rec_priority:           1
rec_approach:           use-stable-release
rec_description:        使用稳定版本的源码包（包含完整的 aclocal.m4），避免开发版本打包不完整的问题。
rec_command:            |
  # 检查 aclocal.m4 是否包含占位符
  grep "@am_" aclocal.m4
  # 如果有占位符，说明源码包不完整，应使用稳定版本
  cd ..
  curl -LO <stable-version-url>
  tar xf <stable-version.tar>
  cd <stable-version>
  ./configure --prefix=$DEFAULT_PREFIX

fallback_priority:      2
fallback_approach:      regenerate-aclocal
fallback_description:   使用系统的 automake/aclocal 重新生成 aclocal.m4 文件（需要完整的 automake 安装）。
fallback_command:       |
  # 删除有问题的 aclocal.m4
  rm aclocal.m4
  # 使用系统 automake 重新生成
  aclocal -I /usr/share/aclocal
  automake --add-missing
  autoconf
fallback_impl:          regenerate-autotools

forbid_1_pattern:       手动替换 @am_AUTOM4TE@ 为具体路径
forbid_1_reason:        占位符表明 aclocal.m4 不完整，手动替换可能遗漏其他问题
forbid_1_consequence:   编译看似通过但生成文件不完整，后续步骤可能失败

# Layer 4: 原则引用
principles:             P-BOOTSTRAP-001

# 关系图
causes:                 [E073]
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# 元数据
doc_file:               doc/E059.md
last_updated:           2026-06-05
source_event:           libfm-1.4.0 autogen.sh 失败（@am_AUTOM4TE@ 占位符）

