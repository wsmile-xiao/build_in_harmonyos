#====================================================================
# E033.kv — ncurses 宽字符函数需要 _XOPEN_SOURCE_EXTENDED
#====================================================================

id:                     E033
trigger_tool:           cc|clang|configure
phase:                  compilation
error_signature:        unknown type name 'cchar_t'|call to undeclared function 'setcchar'|
                         undeclared.*cchar_t|undeclared.*setcchar|ncurses.*wide

severity:               2
category:               libc|compat|headers
match_keywords:         cchar_t, setcchar, ncurses, wide char, _XOPEN_SOURCE_EXTENDED,
                         _XOPEN_SOURCE, musl, Python curses, undefined reference

root_cause:             musl 下 ncurses 宽字符接口需要显式定义 _XOPEN_SOURCE_EXTENDED
                         才能暴露 cchar_t 等类型和 setcchar 等函数
affected_scope:         Python curses 模块及其他使用 ncurses 宽字符 API 的软件
verification_cmd:       grep -r "_XOPEN_SOURCE" 源码目录

rec_priority:           1
rec_approach:           add-cflags
rec_description:        通过 CFLAGS 添加 _XOPEN_SOURCE_EXTENDED 和 _XOPEN_SOURCE=600
rec_command:            export CFLAGS="-D_XOPEN_SOURCE_EXTENDED -D_XOPEN_SOURCE=600 $CFLAGS"
rec_auto_fix:          true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      disable-feature
fallback_description:   回退方案: 禁用宽字符功能编译 (--disable-widec)
fallback_auto_fix:     false

forbid_1_pattern:
principles:             P-CFLAGS-001

causes:                 []
caused_by:              []
similar_to:             [E032,E026]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E033.md
last_updated:           2026-04-10
source_event:           archives/s/python/3.9.0/manifest.yaml
