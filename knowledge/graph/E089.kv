#====================================================================
# E089.kv — aclocal @am_AUTOM4TE@ 未替换导致 PKG_INSTALLDIR 缺失
# 预装的 aclocal 脚本中 @am_AUTOM4TE@ 占位符未被正确替换
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E089
trigger_tool:           aclocal|autoreconf|automake
phase:                  configuration
error_signature:        @am_AUTOM4TE@ inaccessible or not found|aclocal: error: @am_AUTOM4TE@ failed with exit status|WARNING.*aclocal.*is missing|'pkgconfig_DATA' is used but 'pkgconfigdir' is undefined

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               platform, build-system, autotools
match_keywords:         aclocal, am_AUTOM4TE, autom4te, PKG_INSTALLDIR, pkg.m4, aclocal.m4, pkgconfigdir undefined, pkgconfig_DATA

# ═══ Layer 2: 诊断层 ═══
root_cause:             OHOS 预装的 aclocal 脚本中 @am_AUTOM4TE@ 占位符未被替换为实际 autom4te 路径，
                        导致 aclocal 执行时调用字面字符串作为命令失败。
                        configure 生成时缺少 pkgconfigdir 变量定义，
                        automake 报 "pkgconfig_DATA is used but pkgconfigdir is undefined"。
                        release tarball 通常已包含完整 aclocal.m4。
affected_scope:         所有使用 PKG_INSTALLDIR 宏且需要运行 aclocal 的 autotools 项目
verification_cmd:       grep "@am_AUTOM4TE@" $(which aclocal) | head -3

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           replace-pkginstalldir
rec_description:        在 configure.ac 中删除 PKG_INSTALLDIR() 调用，
                        手动用 AC_SUBST([pkgconfigdir], [\${libdir}/pkgconfig]) 替代。
                        同时在 Makefile.am 中显式定义 pkgconfigdir = $(libdir)/pkgconfig。
rec_command:            sed -i 's/PKG_INSTALLDIR/AC_SUBST([pkgconfigdir], [\\${libdir}\\/pkgconfig])/' configure.ac && echo 'pkgconfigdir = $(libdir)/pkgconfig' >> Makefile.am
rec_auto_fix:           true
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      manual-m4-copy
fallback_description:   手动将 PKG_INSTALLDIR 的 AC_DEFUN 定义追加到 aclocal.m4，跳过 aclocal 重新生成。
fallback_command:       echo 'AC_DEFUN([PKG_INSTALLDIR], [AC_SUBST([pkgconfigdir], [${libdir}/pkgconfig])])dnl' >> aclocal.m4
fallback_auto_fix:      false
fallback_impl:          manual-fix

# ★ 禁止策略 ★
forbid_1_pattern:       apt-get.*install.*automake
forbid_1_reason:         鸿蒙系统非 Debian/Ubuntu，无法使用 apt 安装
forbid_1_consequence:   command not found

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E089.md
last_updated:           2026-04-21
source_event:           musl-fts 1.2.7 编译

