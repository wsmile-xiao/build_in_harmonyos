#====================================================================
# E032.kv — _GNU_SOURCE 未定义导致 dirent API 不完整
#====================================================================

id:                     E032
trigger_tool:           cc|clang|configure
phase:                  compilation
error_signature:        unknown type name 'DIR'|call to undeclared function 'opendir'|
                         undeclared.*opendir|undeclared.*readdir

severity:               2
category:               libc|compat|headers
match_keywords:         _GNU_SOURCE, _BSD_SOURCE, DIR, opendir, readdir,
                         dirent, unknown type, undeclared, musl, gawk

root_cause:             musl 需要 _GNU_SOURCE 而非 _BSD_SOURCE 来暴露完整 dirent API,
                         部分软件使用 _BSD_SOURCE 不足以在 musl 下获得完整接口
affected_scope:         使用 dirent API 的软件 (gawk 等)
verification_cmd:       grep -r "_BSD_SOURCE\|_GNU_SOURCE" 源码目录

rec_priority:           1
rec_approach:           add-cflags
rec_description:        通过 CFLAGS 添加 _GNU_SOURCE 宏定义
rec_command:            export CFLAGS="-D_GNU_SOURCE $CFLAGS"
rec_auto_fix:          true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      source-patch
fallback_description:   修改源码中的 _BSD_SOURCE 为 _GNU_SOURCE
fallback_auto_fix:     false

forbid_1_pattern:      使用 _BSD_SOURCE 替代 _GNU_SOURCE
forbid_1_reason:       musl 下 _BSD_SOURCE 不暴露完整 dirent API (DIR/opendir/readdir)
forbid_1_consequence:  编译报错: unknown type name 'DIR', undeclared function 'opendir'
principles:              P006
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E032.md
last_updated:           2026-04-10
source_event:           archives/s/gawk/5.3.0/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
