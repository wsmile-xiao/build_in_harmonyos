#====================================================================
# E336-draft-gtk-broadway-display-backend.kv — GTK 系 GUI 库在 OHOS 无原生显示
#   后端的适配模式：broadway(HTML5) 后端替代 X11/Wayland + 构建时 glib 工具
#   native 包装 + 转发型别名 .pc
#   实例：gtk+ 3.24.43（archives/g/gtk/3.24.43），下游 klavaro 3.14 可复用
#====================================================================

# --- frontmatter 检索字段 ---

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E527
trigger_tool:       meson|pkg-config|runtime
phase:              configuration,runtime
error_signature:    Dependency ".*" not found|
                    X11 backend.*not found|
                    wayland.*not found.*try.*broadway|
                    Neither x11_backend nor wayland_backend nor broadway_backend is true|
                    Cannot open display|
                    cannot connect to X server|
                    gtk_init.*failed

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:           3
category:               platform, meson, pkg-config, display, gnome
match_keywords:     gtk, gtk+, gdk, broadway, broadwayd, X11, wayland, quartz,
                    win32, epoxy, libepoxy, display backend, glib-mkenums,
                    glib-genmarshal, native wrapper, PkgConfigDeps, alias-pc,
                    forwarding pc, gtk+-3.0.pc, GUI, klavaro

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:         OHOS PC 无 X11/Wayland/Quartz/Win32 任何原生显示后端，
                    GTK3 的 meson.build 要求至少启用一个后端
                    （x11_backend/wayland_backend/broadway_backend 全 false 时
                    直接 configuration 失败），且默认后端连带依赖 epoxy(GL)、
                    xinerama、cloudproviders 等平台组件；
                    同时运行期 gtk_init() 需要 DISPLAY/连接显示服务，
                    纯编译通过不等于可运行（R40 深度适配边界）。
                    另有两类伴生问题：① glib-mkenums/glib-genmarshal 是构建时
                    Python 工具，交叉编译时必须在 build machine 执行而非 host；
                    ② 上游是 .pc 多文件体系，Conan PkgConfigDeps 只生成声明
                    的主 .pc，消费方 dependency('gtk+-3.0') 会找不到（同 E321）。
affected_scope:     所有 GTK/GDK 系 GUI 库与应用在 OHOS PC 的适配
                    （gtk+/gtksourceview3/klavaro/goocanvas 等 GNOME 生态）。
verification_cmd:   |
  # 后端配置生效（configure 日志应出现 broadway: YES）
  grep -E "broadway|x11_backend" builddir/meson-logs/meson-log.txt
  # 产物含 libgtk-3 且 NEEDED 无 libX11/libwayland
  readelf -d <prefix>/lib/libgtk-3.so | grep NEEDED
  # 消费方 .pc 检测
  pkg-config --modversion gtk+-3.0

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:       1
rec_approach:       broadway-backend-native-tools-wrapper
rec_description:    三件套组合：① meson 选项切 broadway HTML5 后端
                    （-Dx11_backend=false -Dwayland_backend=false
                    -Dbroadway_backend=true，纯 HTTP/WebSocket 输出无原生显示
                    依赖），同时禁 xinerama/cloudproviders/profiler/introspection/
                    gtk_doc/man/demos/examples/tests；② generate() 里把
                    glib-mkenums/glib-genmarshal 包装为 native 可执行 wrapper
                    （shebang 指向 build machine python3，注入 pkg-config 变量
                    让 meson 找到构建时工具）；③ PkgConfigDeps.generate() 后补
                    转发型别名 .pc（Version 动态继承主 .pc，Requires 主 .pc，
                    同 E321 手法）。运行期标注 R40 partial：需 broadwayd 服务 +
                    浏览器访问，GUI 行为不在 CI 断言范围。
rec_command:        |
  # ① meson 选项（conanfile.py layout()/build() 中经 MesonToolchain 注入）
  #   -Dx11_backend=false -Dwayland_backend=false -Dbroadway_backend=true
  #   -Dxinerama=no -Dcloudproviders=disabled -Dintrospection=disabled
  #   -Dgtk_doc=false -Ddemos=false -Dexamples=false -Dtests=false
  # ② 构建 glib-mkenums native wrapper（generate() 内，参考
  #    archives/g/gtk/3.24.43/conanfile.py::_build_python_tool_wrapper）
  #    shebang: #!/usr/bin/env python3 → 指向 build machine 解释器
  # ③ 别名 .pc：_create_pkg_config_alias("gtk+-3.0", ...) 参考
  #    gdk-pixbuf 配方同名函数 / pango 配方 --alias-pc 生成
rec_auto_fix:       false
rec_impl:           recipe-options

fallback_priority:  2
fallback_approach:  offscreen-headless-partial
fallback_description: 无法启用任何后端时（如上游移除 broadway），改编译
                    headless 能力子集并在 manifest/notes 显式标注 R40 partial
                    （仅 API 层可用，无窗口能力），禁止 stub 假装后端存在。
fallback_command:
fallback_auto_fix:  false
fallback_impl:      recipe

# ★ 禁止策略 ★
forbid_1_pattern:   stub.*(libX11|libwayland)|LD_PRELOAD.*libX11
forbid_1_reason:    用空实现 X11/Wayland 库欺骗链接期检查，运行期 gtk_init()
                    仍会失败且崩溃点远离真实根因
forbid_1_consequence: 二进制进入制品仓后下游全部踩坑，且 R40 审计判 fail
forbid_2_pattern:   把 host 的 glib-mkenums/glib-genmarshal 路径写死进配方
forbid_2_reason:    conan 缓存目录随 HOME/缓存策略漂移，写死路径在其他环境必炸
forbid_2_consequence: 换机器/CI 后 enumeration 步骤找不到工具，构建随机失败

# ═══ Layer 4: 原则引用 ═══
principles:         P014

# ═══ 关系图 (Relations) ═══
causes:
caused_by:
similar_to:         E318, E321
conflicts_with:
prerequisite_of:

