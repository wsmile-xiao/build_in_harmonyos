id: E108
title: HarmonyOS 缺少 GNU install 命令，Makefile 中硬编码 install 调用失败
trigger_tool:           make
phase:                  installation
error_signature:        install: No such file or directory|install.*not found|
                         make.*install.*Error 127|install -d.*No such file|
                         install -m.*No such file

severity:               2
category:               platform-install
match_keywords:         install, ginstall, GNU install, HarmonyOS,
                         install -d, install -m0755, Error 127,
                         Makefile, install-exec-local

root_cause:             HarmonyOS 缺少 GNU install 命令，Makefile.in 中硬编码 install 导致 make install 失败
affected_scope:         所有在 Makefile.in 中硬编码 install 命令的 autotools 项目
verification_cmd:       which install; which ginstall

rec_priority:           1
rec_approach:           patch-makefile-in-ginstall
rec_description:        在 Makefile.in 源文件中将硬编码 install 替换为 ginstall（R6铁律：修改源文件而非生成文件）
rec_command:            sed -i 's/install -d/ginstall -d/g; s/install -m0755/ginstall -m0755/g' tools/Makefile.in
rec_auto_fix:           false
rec_impl:               manual-patch

fallback_priority:      2
fallback_approach:      patch-makefile-ginstall
fallback_description:   在生成的 Makefile 中将 install 替换为 ginstall（违反 R6，仅作为兼容保障）
fallback_command:       sed -i 's/install -d/ginstall -d/g' tools/Makefile
fallback_auto_fix:      false
fallback_impl:          manual-patch

forbid_1_pattern:       --build=|--host=
forbid_1_reason:        native 编译禁止使用 --build/--host 参数（R15 铁律）
forbid_1_consequence:   config.guess 检测被绕过，可能导致平台识别错误

principles:             R6

causes:                 []
caused_by:              []
similar_to:             [E007, E072]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E080.md
last_updated: 2026-06-01
source_event:           libbytesize-2.11-compile

draft: false
contributor_id: 0BE3

