#====================================================================
# E012.kv — 找不到 llvm-ar
#====================================================================
id:                     E012
title: 找不到 llvm-ar
trigger_tool:           configure|make|ar
phase:                  configuration|compilation
error_signature:        ar.*command not found|ar.*invalid option|
                         llvm-ar.*not found|RANLIB.*not found
severity:               3
category:               toolchain
match_keywords:         ar command not found, llvm-ar, RANLIB,
                         LLVM toolchain, NM, archive, invalid option
root_cause:             使用 GNU ar 而非 LLVM ar,
                         鸿蒙 SDK 只提供 LLVM 工具链, 没有 binutils
affected_scope:         所有 autotools 项目 (ar/RANLIB/NM 是标准工具)
verification_cmd:       which ar, which llvm-ar, ar --version

rec_priority:           1
rec_approach:           set-env-var
rec_description:        设置 AR/RANLIB/NM/STRIP 为 LLVM 版本
rec_command:            AR=llvm-ar RANLIB=llvm-ranlib NM=llvm-nm STRIP=llvm-strip
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:
principles:             P-TOOLCHAIN-001
causes:                 []
caused_by:              []
similar_to:             [E053]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E012.md
last_updated:           2026-04-09
