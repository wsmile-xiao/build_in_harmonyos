error_signature=Can't load.*\.so.*Permission denied|Error loading shared library.*\.so.*Permission denied|DynaLoader.*Permission denied|XSLoader.*Permission denied
root_cause=HarmonyOS SELinux 策略限制，用户路径 (hmdfs:s0 标签) 的 .so 文件无法被动态链接器加载，只有系统路径 (hnp_file:s0 标签) 的 .so 可以加载
match_keywords=SELinux,hmdfs,hnp_file,.so,Permission denied,DynaLoader,Perl XS,shared library, XSLoader
rec_description=将 Perl XS 模块安装到系统 Perl 目录 (/data/service/hnp/perl.org/perl_5.42.0/lib/)，或通过预编译包安装脚本处理 SELinux 标签
rec_command=预编译包需要安装到系统目录，手动安装需要特殊权限
affected_scope=所有 Perl XS 模块，Python 扩展模块，任何需要动态加载 .so 的软件
verification_cmd=ls -laZ /path/to/.so | grep hnp_file && echo "SELinux label correct"
category=security,selinux,perl,dynamic_loader,harmonyos
severity=3
contributor=A53B
rec_priority=1