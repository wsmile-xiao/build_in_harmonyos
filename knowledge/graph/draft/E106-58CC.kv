#====================================================================
# E106-58CC.kv — HMDFS临时文件创建限制
# 对应的人类文档: draft/E106-58CC.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E106
trigger_tool:           configure|config.status
phase:                  configuration
error_signature:        can't create.*confXXXXXX.*Permission denied|mktemp -d.*./conf

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform|hmdfs|autotools|filesystem
match_keywords:         HMDFS, Permission denied, confXXXXXX, mktemp, config.status
title:                  HMDFS分布式文件系统限制临时目录创建

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HMDFS禁止在当前目录创建子目录后再写入文件（分布式一致性要求）
affected_scope:         所有使用autotools的软件（smartmontools, procps-ng, groff, tmux等）
verification_cmd:       mktemp -d "./confXXXXXX" && ls "./confXXXXXX"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           autoreconf-regenerate
rec_description:        使用autoreconf -fvi重新生成configure脚本（需要automake 1.17+）
rec_command:            autoreconf -fvi && ./configure --prefix=$DEFAULT_PREFIX
rec_auto_fix:           true
rec_impl:               autoreconf

fallback_priority:      2
fallback_approach:      mktemp-wrapper
fallback_description:   创建mktemp wrapper重定向到$TMPDIR
fallback_command:       创建~/usr/local/bin/mktemp脚本，将./conf重定向到$TMPDIR/conf
fallback_auto_fix:      true
fallback_impl:          wrapper

fallback_priority:      3
fallback_approach:      vpath-build
fallback_description:   在$TMPDIR下使用VPATH构建
fallback_command:       cd $TMPDIR && $BUILD_SRC_DIR/configure --srcdir=$BUILD_SRC_DIR
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       mktemp -d "./
forbid_1_reason:        HMDFS不允许在当前目录下创建临时子目录
forbid_1_consequence:   config.status执行失败，Permission denied

# ═══ Layer 4: 原则引用 ═══
principles:             P10-use-tmpdir

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             E079
conflicts_with:         []
prerequisite_of:        [E107]

# ═══ 元数据 ═══
doc_file:               draft/E106-58CC.md
last_updated:           2026-05-19
source_event:           Phase2 机器E编译smartmontools失败