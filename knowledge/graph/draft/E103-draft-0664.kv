id:                     E103
trigger_tool:           clang|gcc|make
phase:                  compilation
error_signature:         'string' file not found|'vector' file not found|'algorithm' file not found|'stdlib.h' file not found|'time.h' file not found|'pthread.h' file not found

severity:               3
category:               environment
match_keywords:         libc++, libcxx, LLVM, nostdinc++, standard headers, OHOS, HMDFS, sysheaders
title:                  OHOS HMDFS missing C/C++ standard library headers

root_cause:             OHOS HMDFS filesystem does not include standard C and C++ library headers in the default search paths. The system has a _sysheaders_backup directory with C headers but no C++ standard library headers.
affected_scope:         Any C/C++ compilation on OHOS HMDFS filesystem
verification_cmd:       ls /storage/Users/currentUser/usr/local/include/_sysheaders_backup/

rec_priority:           1
rec_approach:           configure-env
rec_description:        Copy C headers from _sysheaders_backup. Use LLVM 18.1.8 source tree for libc++ headers at ~/tmp/builds/llvm-project-18.1.8.src/libcxx/include. Create __config_site with _LIBCPP_HAS_MUSL_LIBC, _LIBCPP_HAS_THREAD_API_PTHREAD, _LIBCPP_HARDENING_MODE_DEFAULT=_LIBCPP_HARDENING_MODE_NONE. Use -nostdinc++ to disable default C++ header search.
rec_command:            cp -r /storage/Users/currentUser/usr/local/include/_sysheaders_backup/* /storage/Users/currentUser/usr/local/include/
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:              R1

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

software:               pycxx-iter
version:                6.2.8
build_system:           script
problem:                OHOS HMDFS filesystem lacks standard C and C++ library headers
solution:               Copy C headers from _sysheaders_backup. Use LLVM 18.1.8 source tree for libc++ headers. Create __config_site with musl/pthread/hardening macros. Use -nostdinc++ to disable default C++ header search.
files:                  setup_makefile.py
doc_file:               doc/E103.md
last_updated:           2026-06-23
source_event:

