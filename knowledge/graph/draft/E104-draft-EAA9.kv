id:                     E104
trigger_tool:           ld|clang|gcc|make
phase:                  linking
error_signature:         unable to find library -lc\+\+|unable to find library -lc\+\+abi|unable to find library -lunwind|unable to find library -lm|unable to find library -lc

severity:               3
category:               environment
match_keywords:         ld.lld, nostdlib++, libc++, libc++abi, libunwind, linking, OHOS
title:                  OHOS linker cannot find libc++ and related libraries

root_cause:             OHOS default library search paths do not include the custom installation directory. The linker tries to find libc++, libc++abi, libunwind, libm, and libc separately, but libc++abi does not exist as a separate file (its symbols are included in libc++.so).
affected_scope:         Any C++ linking on OHOS that uses custom library paths
verification_cmd:       nm -D /storage/Users/currentUser/usr/local/lib/libc++.so | grep cxa_throw

rec_priority:           1
rec_approach:           configure-env
rec_description:        Use -nostdlib++ to disable default C++ library linking, then manually link with -L<lib_dir> -lc++. The libc++.so already includes cxxabi symbols so libc++abi is not needed separately.
rec_command:            LDEXE='%(CCC)s -g -nostdlib++ -L/storage/Users/currentUser/usr/local/lib -lc++'
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:              R1

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

software:               pycxx-iter
version:                6.2.8
build_system:           script
problem:                Default linker tries to find libc++abi which doesn't exist as separate library on OHOS
solution:               Use -nostdlib++ to disable default C++ library linking, then manually link with -L<lib_dir> -lc++. The libc++.so already includes cxxabi symbols.
files:                  setup_makefile.py
doc_file:               doc/E104.md
