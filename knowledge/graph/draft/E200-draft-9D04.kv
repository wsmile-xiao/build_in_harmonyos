id:                     E200
trigger_tool:           make|configure
phase:                  compilation|configuration
error_signature:        cpp: command not found|SHELL=bash|config.status.*mktemp.*Permission denied|config.guess.*unknown-linux-gnu

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               postgresql-extension
match_keywords:         cpp, SHELL, bash, pgxs, config.guess, mktemp, hmdfs, postgresql, citus
title:                  PostgreSQL extension build requirements on HarmonyOS (cpp wrapper, SHELL=bash, config.guess, mktemp)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HarmonyOS lacks cpp command (only clang), musl sh doesn't support PGXS heredoc, HMDFS blocks mktemp, config.guess misidentifies platform
affected_scope:         postgresql-citus, postgresql-pg_cron, all PostgreSQL extensions on HarmonyOS
verification_cmd:       which cpp; echo $SHELL; python3 scripts/ohc-run.py engine "cpp: command not found"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           platform-adaptation
rec_description:        Create cpp wrapper using clang -E, use SHELL=bash for make, fix config.guess, use $TMPDIR for mktemp
rec_command:            printf '#!/bin/sh\nclang -E "$@"' > $DEFAULT_PREFIX/bin/cpp && chmod +x $DEFAULT_PREFIX/bin/cpp; SHELL=bash make USE_PGXS=1
rec_auto_fix:           true
rec_impl:               shell-wrapper

fallback_priority:      2
fallback_approach:      env-override
fallback_description:   Use environment variables and wrapper scripts
fallback_command:       export SHELL=/usr/local/bin/bash
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       --build=.*-linux-gnu|--host=.*-linux-gnu
forbid_1_reason:        Native build on HarmonyOS, cross-compile flags are wrong approach
forbid_1_consequence:   Misconfigured build targets, wrong RPATH

principles:             P01,P02,P07

causes:                 []
caused_by:              [E007,E011]
similar_to:             [E007]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E200.md
last_updated:           2026-06-10
source_event:           postgresql-citus 14.0.0 build

draft:                  true
contributor_id:         9D04