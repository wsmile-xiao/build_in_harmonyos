#====================================================================
# E083.kv — HMDFS 文件系统 autotools config.status 失败
#====================================================================

id:                     E083
title: HMDFS 文件系统 autotools config.status 无法创建配置文件
trigger_tool:           configure
phase:                  configuration

error_signature:        config.status.*could not setup config files machinery|
                         config.status.*error.*setup|
                         mktemp.*Permission denied.*HMDFS|
                         cannot create.*config.status|
                         temporary directory.*failed.*hmdfs

severity:               2
category:               filesystem-hmdfs
match_keywords:         HMDFS, config.status, autotools, mktemp,
                         temporary directory, Permission denied,
                         config files machinery, setup failed,
                         HarmonyOS filesystem, cross-compilation bypass

root_cause:             HarmonyOS HMDFS 文件系统对临时文件创建有特殊权限限制。
                         autotools 的 config.status 脚本使用 `mktemp -d "./confXXXXXX"`
                         在当前目录创建临时目录，HMDFS 的 SELinux/HMMAC 机制禁止此操作。

affected_scope:         **所有使用 autotools 构建系统的软件**（在 HMDFS 目录中编译）
                         典型案例: libmicrohttpd, openldap, xapian-core

                         注意: 使用 Meson/CMake 构建的软件不受影响。

verification_cmd:       mount | grep hmdfs;
                         echo "当前目录文件系统: $(df -T . | tail -1)";
                         mktemp -d "./confXXXXXX" 2>&1 || echo "HMDFS mktemp 失败";

rec_priority:           1
rec_approach:           tmpdir-patch
rec_description:        ⭐ **已验证有效方案** - 修改 configure 脚本使用 TMPDIR 环境变量

                         **具体步骤**:
                         1. 设置 TMPDIR: `export TMPDIR="$HOME/tmp/config-tmp"; mkdir -p "$TMPDIR"`
                         2. 修改 configure 脚本:
                            ```bash
                            sed -i 's|mktemp -d "./conf|mktemp -d "$TMPDIR/conf|g' configure
                            sed -i 's|tmp=./conf|tmp=$TMPDIR/conf|g' configure
                            ```
                         3. 运行 configure: `./configure --prefix=$DEFAULT_PREFIX`
                         4. 如 config.status 失败（umask 077 权限过严），去掉 umask 077

                         **验证案例**: OpenLDAP 2.6.9 成功编译
                         - 补丁文件: 0003-configure.patch (archives/o/openldap/2.6.9/patches/)
                         - 归档路径: archives/o/openldap/2.6.9/

                         **备选方案**: Meson/CMake 构建系统不受 HMDFS 限制

rec_command:           # TMPDIR 方案（推荐，已验证）
                         export TMPDIR="$HOME/tmp/config-tmp"
                         mkdir -p "$TMPDIR"
                         sed -i 's|mktemp -d "./conf|mktemp -d "$TMPDIR/conf|g' configure
                         sed -i 's|tmp=./conf|tmp=$TMPDIR/conf|g' configure
                         ./configure --prefix=$DEFAULT_PREFIX

                         # 如 config.status 失败，去掉 umask 077
                         sed -i 's/umask 077 &&/umask 022 \&\&/' config.status

                         # 备选: Meson/CMake（不受 HMDFS 影响）
                         meson setup build --prefix=$DEFAULT_PREFIX || cmake -B build

rec_auto_fix:          true
rec_impl:               sed-patch

forbid_1_pattern:      --build=*|--host=*|--target=*
forbid_1_reason:        导致 configure 误判为交叉编译(cross_compiling=yes),
                         AC_RUN_IFELS 等运行时检测全部跳过,
                         生成的 config.h 与实际平台不匹配

fallback_priority:      2
fallback_approach:      consult-precompiled-packages
fallback_description:   查询 cmd-pkgs README 中是否有预编译包
fallback_command:      curl -s https://gitcode.com/OpenHarmonyPCDeveloper/cmd-pkgs/README.md | grep <软件名>
fallback_auto_fix:     false
fallback_impl:          none

principles:             P-FILESYSTEM-001, P-AUTOTOOLS-002

causes:                 [E007, E046]
caused_by:              [E007]  # config.guess 问题常与此问题同时出现
similar_to:             [E046]  # chmod 权限问题
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E083.md
last_updated:           2026-06-08
source_event:           OpenLDAP 2.6.9 编译成功（TMPDIR 方案验证）