#====================================================================
# E080.kv — musl libc pthread_cancel 缺失
# 问题: 鸦蒙系统使用 musl libc，不支持 POSIX 线程取消功能
# 解决: 创建存根函数提供空实现
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E080
trigger_tool:           ld|clang|gcc
phase:                  linking
error_signature:        undefined symbol: pthread_cancel|undefined symbol: pthread_testcancel

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               platform-musl-pthread
match_keywords:         pthread_cancel, pthread_testcancel, undefined symbol, musl, HarmonyOS
title:                  musl libc 缺失 pthread_cancel 和 pthread_testcancel

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HarmonyOS 使用 musl libc，不完整支持 POSIX 线程取消 API（pthread_cancel/pthread_testcancel）
affected_scope:         所有使用线程取消功能的 C/C++ 软件（如 squashfs-tools）
verification_cmd:       nm -D /system/lib/llvm/libc.so | grep pthread_cancel || echo "Not found"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           pthread-compat-stub
rec_description:        创建 pthread_compat.c 提存根函数（空实现）
rec_command:            cat > pthread_compat.c << 'EOF'\n#include <pthread.h>\nint pthread_cancel(pthread_t t) { return 0; }\nvoid pthread_testcancel(void) { }\nEOF
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:      disable-thread-cancel
fallback_description:   修改源码移除线程取消调用
fallback_command:       # 需要修改源码，移除 pthread_cancel 和 pthread_testcancel 调用
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       --build=.*|--host=.*
forbid_1_reason:         本平台是 native 编译，不应使用 build/host 参数绕过检测
forbid_1_consequence:   二进制路径错误，运行时失败

# ═══ Layer 4: 原则引用 ═══
principles:             R23-platform-detection-first

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E080.md
last_updated:           2026-04-24
source_event:           squashfs-tools 4.6.1 编译

draft:                  true
contributor_id:         0D0A