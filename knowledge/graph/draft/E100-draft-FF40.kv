id:                     E100
trigger_tool:           clang|gcc|make
phase:                  compilation
error_signature:         Py_UNICODE.*has not been declared|use of undeclared identifier.*Py_UNICODE|PyUnicode_FromUnicode.*undeclared|PyUnicode_GET_SIZE.*undeclared|PyUnicode_AS_UNICODE.*undeclared

severity:               3
category:               compatibility
match_keywords:         Py_UNICODE, PyUnicode_FromUnicode, PyUnicode_GET_SIZE, PyUnicode_AS_UNICODE, Python 3.12, wchar_t
title:                  Python 3.12 Py_UNICODE type and related API removal

root_cause:             Python 3.12 removed the deprecated Py_UNICODE typedef and all APIs that used it (PyUnicode_FromUnicode, PyUnicode_GET_SIZE, PyUnicode_AS_UNICODE) as part of the ongoing cleanup of the Python C API.
affected_scope:         Any C/C++ extension using Py_UNICODE, PyUnicode_FromUnicode, PyUnicode_GET_SIZE, or PyUnicode_AS_UNICODE with Python 3.12+
verification_cmd:       python3 -c "import sys; print(sys.version_info[:2])"

rec_priority:           1
rec_approach:           source-patch
rec_description:        Replace Py_UNICODE with wchar_t, PyUnicode_FromUnicode with PyUnicode_FromWideChar, PyUnicode_GET_SIZE with PyUnicode_GetLength, PyUnicode_AS_UNICODE with PyUnicode_AsWideCharString. Rewrite as_unicodestring() to use PyUnicode_AsWideCharString(ptr(), &sz).
rec_command:            sed -i 's/Py_UNICODE/wchar_t/g; s/PyUnicode_FromUnicode/PyUnicode_FromWideChar/g; s/PyUnicode_GET_SIZE/PyUnicode_GetLength/g; s/PyUnicode_AS_UNICODE/PyUnicode_AsWideCharString/g' CXX/Python3/Objects.hxx
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:              R6

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

software:               pycxx-iter
version:                6.2.8
build_system:           script
problem:                Python 3.12 removed Py_UNICODE type and related APIs (PyUnicode_FromUnicode, PyUnicode_GET_SIZE, PyUnicode_AS_UNICODE)
solution:               Replace Py_UNICODE with wchar_t, PyUnicode_FromUnicode with PyUnicode_FromWideChar, PyUnicode_GET_SIZE with PyUnicode_GetLength, PyUnicode_AS_UNICODE with PyUnicode_AsWideCharString. Rewrite as_unicodestring() to use PyUnicode_AsWideCharString(ptr(), &sz).
files:                  CXX/Python3/Objects.hxx
doc_file:               doc/E100.md
last_updated:           2026-06-23
