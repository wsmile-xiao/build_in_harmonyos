# E081: HMDFS config.status 临时文件创建失败

error_signature = config\.status\[\d+\]: can't create \./conf[A-Za-z0-9]+/subs1\.awk: Permission denied|could not setup config files machinery|could not setup config headers machinery
root_cause = HMDFS 文件系统对临时文件创建有特殊限制，导致 autotools 的 config.status 无法在当前目录创建临时目录和文件。这是平台特定的行为，与标准 Linux 文件系统不同。
match_keywords = HMDFS, config.status, Permission denied, subs1.awk, defines.awk, temporary directory, autotools
rec_description = 对于 header-only 库（如 sparsehash），可以手动创建配置文件并安装头文件：1) 从 config.log 提取配置值；2) 手动创建 config.h 和 sparseconfig.h；3) 手动复制头文件到目标目录。
rec_command = 手动安装头文件：mkdir -p $PREFIX/include/google && mkdir -p $PREFIX/include/sparsehash && cp -r src/google/* $PREFIX/include/google/ && cp -r src/sparsehash/* $PREFIX/include/sparsehash/
affected_scope = sparsehash, header-only libraries, autotools-based libraries on HMDFS
verification_cmd = clang++ -std=c++11 -I$PREFIX/include test_sparsehash.cpp -o test && ./test
category = platform_limitation, build_system, hmdfs
related_patterns = E002 (TMPDIR 只读), E053 (平台限制)
severity = medium