#====================================================================
# EXXX (draft) — Go 工具链缺失导致 go build 失败
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     EXXX-draft-2699
trigger_tool:           make|go
phase:                  compilation
error_signature:        go.*inaccessible or not found|go: command not found|make.*go.*not found|go: No such file or directory|go not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               build_tool_missing|go
match_keywords:         go, golang, go toolchain, go not found, build tool missing, command not found, Go compiler
title:                  OHOS 原生环境不含 Go 工具链，go build 失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OpenHarmony PC 原生环境未预装 Go 工具链（/bin/sh: go: inaccessible or not found），导致所有 Go 语言项目的编译步骤失败。PATH 中不包含 go 二进制。
affected_scope:         所有 Go 语言项目（如 flow-cli, croc, gh-dash 等依赖 go build 的软件）
verification_cmd:       which go 2>/dev/null || echo "Go toolchain NOT available"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           download-go-sdk
rec_description:        在 conanfile.py build() 中自动下载 Go SDK 二进制发布版，解压后设置 GOROOT 和 PATH，然后执行 go build。使用 conan.tools.files.get() 下载并验证 SHA256。
rec_command:            get(self, url=f"https://go.dev/dl/go{go_version}.linux-arm64.tar.gz", sha256=go_sha256, destination=go_dest, strip_root=False)  # 设置 os.environ["GOROOT"] 和 os.environ["PATH"]
rec_auto_fix:           true
rec_impl:               inline-build-method

# 回退方案
fallback_priority:      2
fallback_approach:      use-prebuilt-package
fallback_description:   从 cmd-pkgs 仓库安装预编译的 Go 工具链（如已有 signed 版本）
fallback_command:       curl -fsSL https://gitcode.com/OpenHarmonyPCDeveloper/cmd-pkgs/releases/download/pkgs/install.sh | sh -s -- go <version>
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       shutil.which\("go"\) or "go"
forbid_1_reason:         仅仅 shutil.which("go") or "go" 不能解决 Go 缺失的问题，Worker 上无 Go 时命令仍会失败
forbid_1_consequence:    编译失败（Error 127）

# ═══ Layer 4: 原则引用 ═══
principles:             R11, R12, R33

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E109, E128, E184, E105]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:
last_updated:           2026-07-17
source_event:           flow-cli/homebrew CI 编译失败 (build #5914)

draft: true
contributor_id: 2699