#====================================================================
# E110 — Rust项目在OHOS上cargo无法加载libz.so
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E110
trigger_tool:           ld
phase:                  runtime
error_signature:        Error loading shared library libz\.so.*needed by.*cargo.*Error relocating.*cargo.*zlibVersion: symbol not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               rust-toolchain
match_keywords:         cargo, libz.so, Error loading shared library, musl ldso, RUNPATH, patchelf
title:                  Rust cargo在OHOS上无法加载libz.so（musl ldso namespace机制）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS musl ldso使用namespace机制解析库路径,LD_LIBRARY_PATH对非标准路径的二进制无效,cargo的RUNPATH($ORIGIN/../lib)中缺少libz.so
affected_scope:         所有Rust项目编译（cargo命令本身无法运行）
verification_cmd:       /storage/Users/currentUser/tmp/cargo --version

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           patchelf-fix-runpath
rec_description:        复制cargo到可写目录,用patchelf修改RUNPATH添加用户lib路径,再用sign-elf签名
rec_command:            cp ${HNP_CARGO} ~/tmp/cargo-local && patchelf --set-rpath '$ORIGIN/../lib:/storage/Users/currentUser/usr/local/lib' ~/tmp/cargo-local && ohc-run.py sign-elf ~/tmp/cargo-local
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      separate-cargo-home
fallback_description:   使用独立CARGO_HOME避免与其他并行构建的文件锁冲突
fallback_command:       export CARGO_HOME=/storage/Users/currentUser/tmp/cargo-home-${软件名} && cargo build --release
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       cargo.*Blocking waiting for file lock
forbid_1_reason:        并行构建共享CARGO_HOME会导致锁冲突
forbid_1_consequence:   cargo无限阻塞等待文件锁

# ═══ Layer 4: 原则引用 ═══
principles:             P10,P18

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E002,E007]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E110.md
last_updated:           2026-05-26
source_event:           viu-v1.6.1编译