error_signature=Unbound module Stdlib|ocaml.*cannot find|bytecode.*path.*hardcoded|Caml1999X031.*wrong path
root_cause=OCaml bootstrap 编译的顶层解释器字节码头部包含编译时的源码目录路径，而非安装后的标准库路径
match_keywords=Stdlib,ocamlrun,CAMLLIB,bytecode,bootstrap,topstart,ocaml toplevel
rec_description=设置 CAMLLIB 环境变量指向标准库位置，或重新编译 OCaml 顶层解释器确保路径正确
rec_command=export CAMLLIB=/storage/Users/currentUser/usr/local/lib/ocaml && ocamlrun -I $CAMLLIB ocaml
affected_scope=OCaml 及其衍生项目，opam 冷启动编译，所有需要 OCaml 环境的项目
verification_cmd=ocamlrun -config | grep -q "standard_library" && echo "OCaml path configured"
category=ocaml,toolchain,bytecode,bootstrap
severity=3
contributor=0D0A