#====================================================================
# E216-draft-nmrpflash-fuzzcorpus — AFL/fuzz corpus 替代测试框架
# 适用于 OHOS CI 无法原样运行 AFL/tmux/sudo/sysfs/TFTP 网络交互测试
# 的 C/C++ 命令行库
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E216-draft
trigger_tool:           test|smoke_test|conan_test|finish
phase:                  testing
error_signature:        pcap_activate:.*CAP_NET_RAW|
                        Timeout while waiting for ACK|
                        afl-fuzz: command not found|
                        tmux: command not found|
                        sudo:.*not found|
                        sysfs.*not available|
                        TFTP.*timeout|
                        no CAP_NET_RAW|
                        Cannot open raw socket

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               testing-alternative|fuzz-corpus-runner
match_keywords:         fuzz, AFL, afl-fuzz, fuzz.c, fuzz.bash, fuzzin, corpus,
                        tmux, sudo, sysfs, CAP_NET_RAW, TFTP, tftp_put, nmrp_do,
                        raw socket, pcap, pcap_open_live, ethsock, nmrpflash,
                        deterministic runner, corpus runner, alternative test,
                        network interactive, nmrp, .pkts
title:                  AFL/fuzz corpus 替代测试框架 — 基于上游 fuzzin 语料
                        的确定性 runner，适用于 OHOS CI 无法原样运行
                        AFL/tmux/sudo/sysfs/TFTP 网络交互测试的场景

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:            部分 C/C++ 命令行工具（如 nmrpflash）上游提供 AFL 模糊测试
                        入口（fuzz.c + fuzz.bash + fuzzin/ 语料），但原样运行依赖
                        AFL/tmux/sudo/Linux sysfs/CAP_NET_RAW/TFTP 网络交互环境，
                        这些在 OHOS 交叉编译 CI 中无法满足。具体障碍：
                        1) AFL 编译器（afl-clang-fast）不可用
                        2) tmux 终端复用器不可用
                        3) sudo 无 raw socket 权限（鸿蒙 sudo 为自研简化版）
                        4) /proc/sys/kernel/core_pattern 等 sysfs 不可写
                        5) CAP_NET_RAW 未授予，pcap_open_live 失败
                        6) TFTP 网络服务无法在 CI 中部署
                        7) /tmp 只读（erofs），AFL 需要可写临时目录
affected_scope:         所有带 AFL fuzz 入口、fuzz corpus、网络交互测试、
                        原始 socket 操作但 OHOS CI 无法原样运行的 C/C++ 命令行库。
                        已知适用：nmrpflash 0.9.27（已验证）
verification_cmd:       # 编译 fuzz.c（无 AFL 依赖，替换 AFL_CC → CC）
                        CC=clang
                        CFLAGS="-I\$SRC -I\$LIBNL_INC -I\$LIBPCAP_INC -D_DEFAULT_SOURCE -D_GNU_SOURCE"
                        LDFLAGS="-L\$LIBNL_DIR -L\$LIBPCAP_DIR -lnl-route-3 -lnl-3 -lpcap"
                        \$CC -c \$CFLAGS \$SRC/fuzz.c
                        \$CC fuzz.o tftp.o util.o nmrp.o ethsock.o -o fuzz \$LDFLAGS
                        # 运行 corpus
                        ./fuzz nmrp
                        ./fuzz tftp <corpus_file>

# ═══ Layer 3: 修复层 (Remediation) ═══
rec_approach:           fuzz-corpus-deterministic-runner
rec_description:        使用上游 fuzz.c + fuzzin/ 语料，替换 AFL 编译器为
                        标准 CC 编译，构建确定性 corpus runner。fuzz.c 本身无
                        AFL 依赖（仅需标准 C 库和项目头文件），AFL 依赖仅在
                        Makefile 的 fuzz target 中（afl-clang-fast）。编译后
                        运行 fuzzin/ 语料文件，验证无崩溃（segfault/abort）即
                        通过。注意：这不是上游原样测试通过率，不能替代真实
                        网络服务测试。
rec_command:            # 见 verification_cmd 编译命令。运行：
                        # NMRP 模式：./fuzz nmrp
                        # TFTP 模式：./fuzz tftp <path/to/fuzzin/tftp.bin>
rec_verification:       # 预期结果：
                        # NMRP：exit 1（no CAP_NET_RAW，graceful）
                        # TFTP：exit 255（timeout，graceful）
                        # 无 segfault/abort 即通过
fallback_command:       # 如果 fuzz.c 不可用，可退而求其次：
                        # 1. 仅运行二进制 smoke test（-V 版本检查）
                        # 2. 在 PR 正文中详细说明上游测试入口核验结果
                        # 3. 创建 test_package 验证二进制基本运行

# ═══ Layer 4: 预防层 (Prevention) ═══
auto_fix:               false
implementation:         manual-patch
pr_commit:              ef869b5816540b5e2d2efbf43ad7cb490d99256c
pr_link:                https://gitcode.com/OpenHarmonyPCDeveloper/build_in_harmonyos/pull/2171
verified:               true
verification_date:      2026-07-23
verification_env:       OHOS aarch64 cross-compile, clang 15, libnl 3.7.0, libpcap 1.10.6

# ═══ Layer 5: 元数据 (Metadata) ═══
author:                 junshi_liu
source:                 nmrpflash 0.9.27 adaptation
keywords:               nmrpflash, fuzz, AFL, corpus, runner, alternative test,
                        CAP_NET_RAW, TFTP, pcap, OHOS, CI
related_entries:        E031, E098, E175

# ═══ Layer 6: 语料统计 ═══
corpus_count_total:     8
corpus_nmrp:            5
corpus_tftp:            3
corpus_dir:             fuzzin/
corpus_files:           fuzzin/nmrp/{badorder1,badorder2,badorder3,badorder4,normal}.pkts,
                        fuzzin/tftp/{fsize_4096_blksize_1k,fsize_4096_default}.bin,
                        fuzzin/tftp.bin
test_result:            "8/8 no crash (graceful handling)"
test_detail_nmrp:       "exit 1: pcap_activate: no CAP_NET_RAW (expected)"
test_detail_tftp:       "exit 255: timeout (no TFTP server, expected)"
note:                   "This is NOT upstream test pass rate. It is alternative framework verification."