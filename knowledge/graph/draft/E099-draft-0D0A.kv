error_signature=config.guess: unable to guess system type|cannot determine system type|HarmonyOS.*unknown
root_cause=uname 返回 "HarmonyOS"，config.guess 脚本中没有对应的匹配模式，导致无法识别系统类型
match_keywords=config.guess,HarmonyOS,uname,system type,aarch64,linux-gnu
rec_description=修改 config.guess 添加 HarmonyOS 到匹配模式：Linux|GNU|GNU/*|HarmonyOS 和 aarch64:HarmonyOS:*:*
rec_command=sed -i 's/Linux|GNU|GNU/\/*/Linux|GNU|GNU/*|HarmonyOS/' config.guess && sed -i 's/aarch64:Linux:\*:\*/aarch64:Linux:*:*|aarch64:HarmonyOS:*:*/' config.guess
affected_scope=所有使用 autotools 的项目，configure 需要识别系统类型的软件
verification_cmd=./config.guess | grep -E "aarch64.*linux.*gnu" && echo "HarmonyOS recognized correctly"
category=platform,detection,autotools,configure
severity=2
contributor=0D0A