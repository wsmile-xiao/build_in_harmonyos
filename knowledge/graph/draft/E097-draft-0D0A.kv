error_signature=can't create.*Permission denied|config.status.*could not setup|cannot create.*in temporary directory
root_cause=HMDFS 文件系统在 umask 077 创建的目录下无法写入文件，这是鸿蒙分布式文件系统的安全策略限制
match_keywords=HMDFS,umask 077,permission denied,configure,temporary directory,mktemp,config.status
rec_description=修改 config.guess/config.status 脚本，移除 umask 077 或设置 TMPDIR 环境变量到不受限制的目录
rec_command=sed -i 's/(umask 077 && mktemp/mktemp/g' config.guess config.status && export TMPDIR=/storage/Users/currentUser/.tmp
affected_scope=所有使用 autotools 的项目，configure 脚本，OCaml bootstrap
verification_cmd=export TMPDIR=/storage/Users/currentUser/.tmp && tmp=$(mktemp -d "$TMPDIR/testXXXXXX") && touch "$tmp/test_file" && rm -rf "$tmp" && echo "HMDFS umask 077 test passed"
category=filesystem,permission,autotools,configure
severity=3
contributor=0D0A