#====================================================================
# E200 — Python distutils build system (setup.py) for header-only libraries
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E200
trigger_tool:           python|install
phase:                  installation
error_signature:        No module named CXX|setup\.py install|No such file.*configure|cannot run configure

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               1
category:               build_system
match_keywords:         setup.py, distutils, python package, header-only, pycxx, --root, install --prefix
title:                  Python distutils project uses setup.py install instead of configure/make

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Software uses Python distutils (setup.py) as its build system, not autotools/cmake. The ohc-run.py G0 clean-verify tries to run ./configure which does not exist for Python distutils projects.
affected_scope:         pycxx and similar Python distutils header-only + source libraries
verification_cmd:       python3 -c "import CXX; print('CXX import OK')"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           manual-python-install
rec_description:        Use python3 setup.py install --prefix=$DEFAULT_PREFIX --root=$TEST_PREFIX for DESTDIR mode
rec_command:            python3 setup.py install --prefix=$DEFAULT_PREFIX --root=$TEST_PREFIX
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      pip-install
fallback_description:   Use pip install . --prefix=$DEFAULT_PREFIX --root=$TEST_PREFIX as alternative
fallback_command:       pip install . --prefix=$DEFAULT_PREFIX --root=$TEST_PREFIX
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       ./configure --prefix
forbid_1_reason:        Python distutils projects do not have configure scripts
forbid_1_consequence:   configure: command not found, build fails

# ═══ Layer 4: 原则引用 ═══
principles:             R1,R20

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
software:               pycxx
version:                6.2.8
build_system:           script
description:            PyCXX uses Python distutils setup.py for installation, not configure/make. Use --root for DESTDIR mode. Header-only + source library, no compiled binaries.
solution:               python3 setup.py install --prefix=$DEFAULT_PREFIX --root=$TEST_PREFIX
doc_file:               doc/E200.md
last_updated:           2026-06-23
source_event:           pycxx-6.2.8-compile

draft:                  true
contributor_id:         6E9E
