#====================================================================
# E108.kv — HMDFS heredoc 限制：手动修改 Makefile 绕过
# 对应的人类文档: draft/E108-heredoc-makefile.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E108
trigger_tool:           configure|make
phase:                  configuration
error_signature:        cat.*<<.*EOF.*Permission denied|cannot create temp file for here-document|heredoc.*failed|config.mak.*incomplete

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               filesystem|hmdfs|autotools|build-system
match_keywords:         heredoc, cat << EOF, Permission denied, HMDFS, config.mak, configure
title:                  HMDFS 不支持 heredoc 导致 configure 失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HMDFS 分布式文件系统不支持 shell heredoc（cat << EOF）语法，
                        configure 脚本无法创建配置文件（config.h、config.mak 等），
                        导致生成的配置文件内容不完整（只有 3 行而非几十行）。
affected_scope:         所有使用 heredoc 创建配置文件的 autotools 项目：
                        x264、ffmpeg、libav、smartmontools 等
verification_cmd:       cat > test.h << EOF
                        #define TEST 1
                        EOF
                        cat test.h
                        # 如果只有空文件或 Permission denied，则确认问题

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           manual-makefile-modify
rec_description:        手动修改 Makefile，添加缺失的目标和变量定义，
                        强制编译所有需要的模块（如 8-bit、10-bit）。
                        适用于 Makefile 结构清晰、可手动补全的项目。
rec_command:            # 分析 Makefile 结构，添加缺失的定义：
                        # OBJS += $(SRCS_X:%.c=%-8.o) $(SRCS_X:%.c=%-10.o)
                        # 强制编译 threadpool：SRCS += common/threadpool.c
                        make -j$(nproc)
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      python-script-replace
fallback_description:   使用 Python 脚本替代 heredoc，手动创建配置文件。
                        见 E109（推荐方案）。
fallback_command:       python3 create_config.py && make
fallback_auto_fix:      false
fallback_impl:          python-script
                        # 参考 E109 完整脚本模板

fallback_priority:      3
fallback_approach:      printf-echo-replace
fallback_description:   使用 printf/echo 多行写入替代 heredoc。
                       适用于配置文件内容较少的场景。
fallback_command:       printf '#define PACKAGE "x264"\n' > config.h
                        printf '#define VERSION "1.0"\n' >> config.h
                        echo 'PREFIX=/usr/local' > config.mak
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       cat.*<<.*EOF
forbid_1_reason:        HMDFS 不支持 heredoc 语法，Permission denied 或空文件
forbid_1_consequence:   configure 失败，config.mak/config.h 内容不完整

# ═══ Layer 4: 原则引用 ═══
principles:             P-PATCH-001

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E011]  # HMDFS umask 077 权限问题的扩展
similar_to:             [E109]  # Python 替代脚本方案
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               draft/E108-heredoc-makefile.md
last_updated:           2026-05-31
source_event:           x264 编译：手动修改 Makefile 绕过 heredoc 限制（方案 1）
contributor_id:         system

draft:                  true