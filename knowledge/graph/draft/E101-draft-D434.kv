id:                     E101
trigger_tool:           clang|gcc|make
phase:                  compilation
error_signature:         no member named 'tp_print' in '_typeobject'

severity:               3
category:               compatibility
match_keywords:         tp_print, _typeobject, Python 3.9, Python 3.12
title:                  Python 3.9 removed tp_print field from _typeobject

root_cause:             The tp_print field was deprecated since Python 3.0 and removed from _typeobject in Python 3.9. Code that directly assigns to tp_print will fail to compile.
affected_scope:         Any C/C++ extension that sets tp_print on type objects with Python 3.9+
verification_cmd:       python3 -c "import sys; print(sys.version_info[:2])"

rec_priority:           1
rec_approach:           source-patch
rec_description:        Guard tp_print usage with #if PY_VERSION_HEX < 0x03090000 preprocessor directive.
rec_command:            sed -i 's/^\(\s*\)table->tp_print/\1#if PY_VERSION_HEX < 0x03090000\n\1table->tp_print\n\1#endif/' Src/Python3/cxx_extensions.cxx
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:              R6

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

