#====================================================================
# E082: OHOS 平台 POSIX clock_gettime 兼容性问题
# 对应的人类文档: doc/E082.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E082
trigger_tool:           gcc|clang|make|cmake
phase:                  compilation
error_signature:        error: 'CLOCK_REALTIME' undeclared|error: 'CLOCK_MONOTONIC' undeclared|error: implicit declaration of function 'clock_gettime'|error: storage size of 'ts' isn't known

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               posix-compatibility|ohos-porting|time-functions
match_keywords:         CLOCK_REALTIME, CLOCK_MONOTONIC, clock_gettime, timespec, time.h, POSIX timer
title:                  OHOS 平台 POSIX clock_gettime/CLOCK_* 常量未定义

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS SDK 的 sysroot 中 time.h 定义了 clock_gettime，但 CLOCK_REALTIME/CLOCK_MONOTONIC 等常量需要特定的宏定义或头文件包含顺序
affected_scope:         使用 POSIX timer 的跨平台库（如 raylib、SDL 等）
verification_cmd:       echo '#include <time.h>\nint main() { return CLOCK_REALTIME; }' | clang -E -dM - | grep CLOCK

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           disable-posix-timer
rec_description:        禁用 POSIX timer 功能，使用替代计时方案（如 gettimeofday）
rec_command:            cmake .. -DSUPPORT_POSIX_TIMERS=OFF -DUSE_POSIX_TIMERS=OFF
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:      sdl-backend
fallback_description:   使用 SDL backend 替代原生平台后端（SDL 已处理平台兼容性）
fallback_command:       cmake .. -DPLATFORM=SDL
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       -D_TIME_H|undef.*clock_gettime
forbid_1_reason:        不应通过禁用系统头文件来绕过问题
forbid_1_consequence:   可能导致其他时间相关函数失效

# ═══ Layer 4: 原则引用 ═══
principles:             P003,P008

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E082.md
last_updated: 2026-05-29
source_event:           raylib 6.0 编译失败 - CLOCK_REALTIME/CLOCK_MONOTONIC 未定义

draft: true
contributor_id: AC04