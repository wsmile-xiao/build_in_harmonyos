error_signature=ENXIO.*create_process|ELF.*signature.*required|binary-sign-tool.*failed|cannot execute.*ELF
root_cause=HarmonyOS/OpenHarmony 安全机制要求 ELF 二进制文件必须签名才能执行，未签名的二进制返回 ENXIO 错误
match_keywords=ENXIO,ELF,signature,binary-sign-tool,HarmonyOS,security,executable,ocamlc.opt
rec_description=使用字节码编译器替代优化编译器（ocamlc.byte），或将二进制文件签名（需要信任路径）
rec_command=ln -sf ocamlc.byte ocamlc.opt && ln -sf ocamlc.byte ocamlopt.opt && export PATH=...
affected_scope=所有生成 ELF 二进制的项目，OCaml 优化编译器，任何编译产物的执行
verification_cmd=file ocamlc.opt | grep -q "script" && echo "Bytecode compiler linked"
category=security,elf,signature,harmonyos,execution
severity=3
contributor=0D0A