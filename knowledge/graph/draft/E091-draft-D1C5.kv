#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E091.kv，填写各字段
# 对应的人类文档: doc/E091.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E091
trigger_tool:           meson
phase:                  configuration
error_signature:        ERROR: Unknown variable "have_arm_intrinsics_or_asm"

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               meson|variable_undefined|subdir_order
match_keywords:         meson, Unknown variable, have_arm_intrinsics_or_asm, subdir, silk, celt, opus
title:                  meson subdir 顺序导致的变量未定义错误

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             meson.build 的 subdir() 调用顺序错误, silk/meson.build 使用了在 celt/meson.build 中定义的变量 have_arm_intrinsics_or_asm, 但 silk 在 celt 之前被调用导致变量未定义
affected_scope:         opus 1.4 及其他 meson 构建系统中存在跨 subdir 变量依赖的项目
verification_cmd:       grep -n "have_arm_intrinsics_or_asm" */meson.build

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           source-patch
rec_description:        在主 meson.build 的第一个 subdir() 调用之前添加变量定义, 将 celt/meson.build 中的变量定义移到主文件中
rec_command:            sed -i '/subdir('include')/i # Define have_arm_intrinsics_or_asm before silk subdir\nhave_arm_intrinsics_or_asm = have_arm_ne10\nif (intrinsics_support.length() + asm_optimization.length() + inline_optimization.length()) > 0\n  have_arm_intrinsics_or_asm = true\nendif\n' meson.build
rec_auto_fix:           true
rec_impl:               source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      subdir-reorder
fallback_description:   调整 subdir 调用顺序, 将 celt 放在 silk 之前
fallback_command:       sed -i "s/subdir('silk')/subdir('celt')/; s/subdir('celt')/subdir('silk')/" meson.build
fallback_auto_fix:      true
fallback_impl:          source-patch

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       have_arm_intrinsics_or_asm\s*=\s*true\s*$
forbid_1_reason:        不要在主 meson.build 中直接设置为 true, 应该使用条件判断
forbid_1_consequence:   可能在不支持 ARM intrinsics 的平台上启用错误的优化路径

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

