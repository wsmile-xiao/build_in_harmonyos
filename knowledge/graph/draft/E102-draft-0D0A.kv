error_signature=undefined symbol: pthread_setcancelstate|ld.*error.*pthread|PTHREAD_CANCEL_DISABLE.*undeclared
root_cause=HarmonyOS musl libc 不支持 pthread_setcancelstate 和 pthread_cancel 函数，这些是 POSIX 线程取消功能的可选实现
match_keywords=pthread_setcancelstate,pthread_cancel,musl,HarmonyOS,threads,cancel,state
rec_description=修改 C 代码添加平台条件检查：#if !defined(__ANDROID__) && !defined(__OHOS__) && !defined(__harmonyos__)
rec_command=sed -i 's/#if !defined(__ANDROID__)/#if !defined(__ANDROID__) \&\& !defined(__OHOS__) \&\& !defined(__harmonyos__)/' spawn_stubs.c
affected_scope=使用 pthread_cancel 功能的 C 代码，spawn 库，OCaml spawn 模块，进程管理工具
verification_cmd=grep -q "__OHOS__" spawn_stubs.c && echo "HarmonyOS pthread patch applied"
category=libc,pthread,musl,harmonyos,cancel
severity=2
contributor=0D0A