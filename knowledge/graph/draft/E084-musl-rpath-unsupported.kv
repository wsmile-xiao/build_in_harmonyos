#====================================================================
# E084 — musl动态链接器不支持$ORIGIN RPATH
# 发现于: lm-sensors 3.6.0 编译
# 日期: 2026-04-27
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E084
trigger_tool:           dynamic-linker
phase:                  runtime
error_signature:        error while loading shared libraries:.*cannot open shared object file|No such file or directory.*lib.*\.so

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               linker|musl|rpath|runtime
match_keywords:         $ORIGIN,RPATH,runpath,musl,动态链接,shared library,loading failed
title:                  musl动态链接器不支持$ORIGIN RPATH

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             鸿蒙系统使用musl libc，其动态链接器不支持$ORIGIN RPATH扩展。设置-Wl,-rpath,'$ORIGIN/../lib'后程序仍无法找到相对路径的共享库，导致运行时加载失败。
affected_scope:         所有使用动态链接且依赖RPATH定位共享库的软件
verification_cmd:       readelf -d program | grep RPATH && ./program

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           static-link
rec_description:        使用静态链接编译程序，避免动态链接器的RPATH问题。添加-static或-static-libgcc编译选项
rec_command:            clang -static -o program program.c libdep.a
rec_auto_fix:           true
rec_impl:               static-link-compile

# ═══ Layer 4: 预防层 (Prevention) ═══
prevention:             对于小型工具类程序，优先考虑静态链接；大型软件可使用绝对路径RPATH
workaround:             将共享库安装到系统标准路径（/lib,/usr/lib）或设置LD_LIBRARY_PATH
