#====================================================================
# E082 — HMDFS文件系统mktemp临时目录权限限制
# 发现于: tmux 3.4, zsh 5.9, hwloc 2.11.0 编译
# 日期: 2026-04-27
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E082
trigger_tool:           config.status
phase:                  configure
error_signature:        can't create ./confXXXXXX/subs1.awk: Permission denied|config.status.*could not setup config files machinery

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform|filesystem|hmdfs|autotools
match_keywords:         mktemp,permission denied,config.status,confXXXXXX,HMDFS,临时文件
title:                  HMDFS文件系统mktemp临时目录权限限制

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HMDFS（鸿蒙分布式文件系统）对mktemp创建的临时目录有特殊权限限制。mktemp -d "./confXXXXXX"创建的目录权限为drwx--S---（仅owner有权限+setgid位），config.status无法在其中创建subs1.awk等临时文件。chmod命令也无法修改HMDFS上的目录权限。
affected_scope:         所有使用autotools构建系统且在当前目录执行config.status的软件
verification_cmd:       mktemp -d "./testXXXXXX" && ls -la ./testXXXXXX && rm -rf ./testXXXXXX

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           fixed-tmp-dir
rec_description:        修改config.status脚本，使用固定的预创建目录（如tmp_work）替代mktemp动态创建临时目录，避开HMDFS权限限制
rec_command:            mkdir -p tmp_work && sed -i 's/mktemp -d "./confXXXXXX"/mkdir -p "tmp_work"/' config.status
rec_auto_fix:           false
rec_impl:               manual-patch-config-status

# ═══ Layer 4: 预防层 (Prevention) ═══
prevention:             对于autotools软件，优先使用简单Makefile编译方式，或在非HMDFS目录（如~/tmp）中执行configure
workaround:             手动编译绕过configure（如直接make、手动指定编译参数）
