error_signature=llvm-as: error: expected top-level entity|llvm-as.*\.file \"\"|Assembly.*empty filename
root_cause=LLVM assembler (llvm-as) 不接受空字符串作为 .file 伪指令参数，与 GNU as 的行为不同
match_keywords=llvm-as,.file,empty filename,assembly,ASM,GNU as,LLVM assembler
rec_description=使用 GNU as 替代 llvm-as，设置 ASM=/data/service/hnp/bin/as 环境变量或在 Makefile.config 中修改
rec_command=export ASM=/data/service/hnp/bin/as && sed -i 's/ASM=llvm-as/ASM=/data/service/hnp/bin/as/' Makefile.config
affected_scope=OCaml 编译，Dune 编译，所有使用 llvm-as 作为汇编器的项目
verification_cmd=$ASM --version | grep -q GNU && echo "GNU as configured correctly"
category=toolchain,assembler,llvm,ocaml
severity=2
contributor=0D0A