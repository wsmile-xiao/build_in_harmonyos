id:                     E102
trigger_tool:           clang|gcc|make
phase:                  compilation
error_signature:         use of undeclared identifier '_Py_PackageContext'

severity:               3
category:               compatibility
match_keywords:         _Py_PackageContext, undeclared identifier, Python 3.12
title:                  Python 3.12 removed _Py_PackageContext global variable

root_cause:             Python 3.12 removed the _Py_PackageContext global variable that was used to track the current package context during module initialization.
affected_scope:         Any C/C++ extension that references _Py_PackageContext global variable with Python 3.12+
verification_cmd:       python3 -c "import sys; print(sys.version_info[:2])"

rec_priority:           1
rec_approach:           source-patch
rec_description:        Guard _Py_PackageContext reference with #if PY_VERSION_HEX < 0x030C0000, return nullptr for Python 3.12+.
rec_command:            sed -i 's/return _Py_PackageContext;/#if PY_VERSION_HEX < 0x030C0000\n    return _Py_PackageContext;\n#else\n    return nullptr;\n#endif/' Src/IndirectPythonInterface.cxx
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:              R6

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

