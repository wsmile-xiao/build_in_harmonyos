[E105]
title=GLFW 3.4 在 OpenHarmony 上只支持 Null platform
category=platform_support
severity=1
phase=configure
trigger=cmake

symptom=
GLFW 编译时无法找到 X11 或 Wayland 库

rootcause=
OpenHarmony 不支持 X11 和 Wayland 图形系统，GLFW 只能构建 Null platform（用于测试）

solution=
CMake 配置时禁用 X11 和 Wayland：
-DGLFW_BUILD_X11=OFF -DGLFW_BUILD_WAYLAND=OFF

verify=
grep -r "Null platform" build/CMakeCache.txt

software=
glfw 3.4
