# Layer 0: 错误面
id:                     E104
title:                  euidaccess 函数未定义
trigger_tool:           clang++|clang|gcc|g++
phase:                  compilation
error_signature:        use of undeclared identifier 'euidaccess'|error: 'euidaccess' was not declared|undefined reference to 'euidaccess'

# Layer 1: 识别层
severity:               3
category:               api-difference|platform-adaptation
match_keywords:         euidaccess, undeclared identifier, eaccess, unistd.h, OpenHarmony, permission check

# Layer 2: 诊断层
root_cause:             OpenHarmony 使用 eaccess 函数替代 GNU 的 euidaccess 函数。
                        euidaccess 是 GNU 扩展，用于检查有效用户 ID 的文件访问权限，
                        而 OpenHarmony 的 unistd.h 中只定义了 eaccess 函数（OHOS API 12+）。
                        需要修改源码将 euidaccess 替换为 eaccess。
affected_scope:         使用 GNU euidaccess 函数的项目（如 incron）
verification_cmd:       grep -r "euidaccess" *.cpp *.c 2>/dev/null && echo "Found euidaccess usage" || echo "No euidaccess found"

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           source-code-patch
rec_description:        修改源码，将 euidaccess 替换为 eaccess
rec_command:            sed -i 's/euidaccess/eaccess/g' source.cpp
rec_auto_fix:           true
rec_impl:               sed-replace

fallback_priority:      2
fallback_approach:      define-macro
fallback_description:   在源文件顶部添加宏定义，将 euidaccess 映射到 eaccess
fallback_command:       echo '#define euidaccess(path, mode) eaccess(path, mode)' >> config.h
fallback_auto_fix:      false
fallback_impl:          macro-define

# 禁止策略
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

# Layer 4: 原则引用
principles:             P-PLATFORM-001

# 关系图
causes:                 []
caused_by:              []
similar_to:             [E025, E042]
conflicts_with:         []
prerequisite_of:        []

# 元数据
doc_file:               doc/E104.md
last_updated:           2026-05-27
source_event:           incron 0.5.12 编译（2026-05-26）

