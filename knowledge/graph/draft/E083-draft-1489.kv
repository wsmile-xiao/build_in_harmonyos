id:                     E083
title: GMP 预编译包只有静态库，链接共享库版本失败
trigger_tool:           configure|ld
phase:                  configuration|linking
error_signature:        libgmp\.so.*not found|cannot find -lgmp|
                         checking for libgmp.*no|GMP shared library missing|
                         Package 'gmp'.*not found

severity:               2
category:               dependency-library
match_keywords:         GMP, gmp, shared library, static library,
                         libgmp.so, -lgmp, precompiled package

root_cause:             cmd-pkgs 预编译包的 GMP 只提供静态库（libgmp.a），缺少共享库（libgmp.so），configure 检测需要共享库版本
affected_scope:         所有需要 GMP 共享库的软件（libbytesize, mpfr 等）
verification_cmd:       ls $DEFAULT_PREFIX/lib/libgmp.so* && pkg-config --modversion gmp

rec_priority:           1
rec_approach:           compile-gmp-shared
rec_description:        从源码编译 GMP 6.3.0 --enable-shared，提供共享库版本
rec_command:            ./configure --prefix=$DEFAULT_PREFIX --enable-shared && make -j1 && make install
rec_auto_fix:           false
rec_impl:               manual-compile

fallback_priority:      2
fallback_approach:      static-link-gmp
fallback_description:   使用静态库链接 GMP（可能导致 -fPIC 错误）
fallback_command:       ./configure --prefix=$DEFAULT_PREFIX LDFLAGS="-L$DEFAULT_PREFIX/lib -lgmp"
fallback_auto_fix:      false

principles:             R18

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E083.md
last_updated: 2026-06-01
source_event:           libbytesize-2.11-compile

draft: true
contributor_id: 0BE3