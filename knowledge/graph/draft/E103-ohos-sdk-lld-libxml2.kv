[E103]
title=OHOS SDK lld 链接器缺少 libxml2.so.16
category=environment
severity=3
phase=configure
trigger=clang cmake link

symptom=
CMake 编译器检测失败，lld 链接器报 "Error loading shared library libxml2.so.16"

rootcause=
OHOS SDK 的 lld 链接器依赖 libxml2.so.16，但 LD_LIBRARY_PATH 未包含 SDK 的 llvm/lib 路径

solution=
设置 LD_LIBRARY_PATH 包含 OHOS SDK 的 llvm/lib 路径：
export LD_LIBRARY_PATH="/data/service/hnp/ohos-sdk.org/ohos-sdk_*/ohos/native/llvm/lib:$LD_LIBRARY_PATH"

verify=
lldd /data/service/hnp/ohos-sdk.org/ohos-sdk_*/ohos/native/llvm/bin/lld | grep libxml2

software=
glfw 3.4, cmake projects on OpenHarmony
