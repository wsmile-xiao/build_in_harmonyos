#====================================================================
# E081 — LD env var interferes with dlopen/.so loading on OpenHarmony
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E081
trigger_tool:           runtime|test|perl
phase:                  runtime
error_signature:        Error loading shared library.*\.so.*Permission denied|Can't load.*\.so.*Permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
severity: 2
category: environment
match_keywords:         Permission denied, loading shared library, LD environment variable, dlopen, Perl XS, DynaLoader
title: LD env var interferes with dlopen/.so loading on OpenHarmony

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: Setting LD=<value> as environment variable causes musl's dynamic linker to fail loading .so files via dlopen() with "Permission denied". The LD variable is interpreted by the linker subsystem and interferes with normal .so resolution. This particularly affects Perl XS modules where CC=cc LD=cc are set during compilation (to override Perl's default clang 18 without sysroot) but must be unset at runtime.
affected_scope: Perl XS modules and any software using dlopen when LD env var is set
verification_cmd: env | grep "^LD=" → if set, try: env -u LD <command>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority: 1
rec_approach: unset-env-var
rec_description: Unset LD (and CC) environment variables before runtime/test operations
rec_command: env -u CC -u LD perl -Mmodule -e '...'
rec_auto_fix: false
rec_impl: manual-hint

# 回退方案
fallback_priority: 2
fallback_approach: wrapper-script
fallback_description: Create a wrapper script that unsets LD before exec
fallback_command: sh -c 'unset LD; exec "$@"' -- perl ...
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern: export LD=
forbid_1_reason: Do not set LD as persistent env var - it will break all .so loading
forbid_1_consequence: All Perl XS modules and dlopen-based software fail with Permission denied

# ═══ Layer 4: 原则引用 ═══
principles: P010

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E002, E046]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
trigger: runtime loading of .so files via dlopen
solution: Unset LD before runtime: env -u CC -u LD perl -Mmodule. For Perl XS modules set CC=cc LD=cc only during build step.
platform_only: true
doc_file: doc/E081.md
last_updated: 2026-06-17
source_event: perl-meta 0.015-r0 compilation

draft: true
contributor_id: F615
