#====================================================================
# E083 — OHOS SDK头文件sockaddr_storage重复定义冲突
# 发现于: libusb 1.0.27, usbutils 017 编译
# 日期: 2026-04-27
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E083
trigger_tool:           clang/gcc
phase:                  compile
error_signature:        error: redefinition of 'struct sockaddr_storage'|struct sockaddr_storage has different sizes in different translation units

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               header|sdk|conflict|struct
match_keywords:         sockaddr_storage,redefinition,linux/socket.h,sys/socket.h,OHOS SDK
title:                  OHOS SDK头文件sockaddr_storage重复定义冲突

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS SDK中sys/socket.h（musl libc定义）和linux/socket.h（内核UAPI定义）都定义了struct sockaddr_storage，导致同时包含时出现重复定义错误。musl使用32位sa_family_t，内核使用16位__kernel_sa_family_t。
affected_scope:         同时包含sys/socket.h和linux/socket.h的软件，特别是网络相关库（libusb, usbutils等）
verification_cmd:       echo '#include <sys/socket.h>\n#include <linux/socket.h>' | clang -c -xc -

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           guard-linux-socket-h
rec_description:        在包含linux/socket.h之前定义_UAPI_LINUX_SOCKET_H宏，阻止内核头文件重复定义sockaddr_storage；或修改代码添加#include守卫
rec_command:            sed -i '#include <linux/socket.h>/#define _UAPI_LINUX_SOCKET_H\n#include <sys/socket.h>/g' source.c
rec_auto_fix:           true
rec_impl:               header-guard-patch

# ═══ Layer 4: 预防层 (Prevention) ═══
prevention:             检查源码是否同时包含sys/socket.h和linux/socket.h，提前添加守卫
workaround:             使用#ifdef __OHOS__条件编译选择正确的头文件
