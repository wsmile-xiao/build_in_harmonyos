#====================================================================
# E081 — OHOS SDK libc++ headers require C++17 minimum
#====================================================================

id:                     E081
trigger_tool:           clang|cmake|make
phase:                  compilation
error_signature:        no member named 'nullptr_t' in the global namespace|unknown type name 'nullptr_t'|'__abi_tag__' attribute only applies to

severity:               3
category:               platform-libcxx-stdlib
match_keywords:         nullptr_t, __abi_tag__, libcxx-ohos, c++17, c++11, OHOS SDK
title:                  OHOS SDK libc++ headers require C++17 minimum standard

root_cause:             OHOS SDK (ohos-sdk_26.0.0.18) ships custom libc++ headers at libcxx-ohos/include/c++/v1/ designed for C++17+, projects using -std=c++11 fail with nullptr_t, __abi_tag__, and constexpr errors
affected_scope:         any C++ project compiled with -std=c++11 or lower on OpenHarmony
verification_cmd:       echo '#include <string>' | clang++ -x c++ -std=c++11 -fno-rtti -isystem ~/usr/local/include - -o /dev/null

rec_priority:           1
rec_approach:           change-cxx-standard
rec_description:        Change -std=c++11 to -std=c++17 in CMakeLists.txt or build config, also disable -Werror
rec_command:            sed -i 's/-std=c++11/-std=c++17/' CMakeLists.txt && cmake .. -DFAIL_ON_WARNINGS=OFF
rec_auto_fix:           false
rec_impl:               manual-edit

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E081.md
last_updated:           2026-06-23
source_event:           rocksdb 6.4.6 compile

draft: true
contributor_id: EFAD
