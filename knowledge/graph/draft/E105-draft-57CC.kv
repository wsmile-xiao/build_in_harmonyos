id:                     E105
trigger_tool:           clang|gcc|make
phase:                  compilation
error_signature:         'sys/time.h' file not found

severity:               2
category:               environment
match_keywords:         sys/time.h, WrapPython.h, OHOS, include guard
title:                  OHOS sys/time.h not available in expected include path

root_cause:             On OHOS, the sys/time.h header is not available in the standard include search path that PyCXX's WrapPython.h expects.
affected_scope:         Any code that includes sys/time.h through PyCXX's WrapPython.h on OHOS
verification_cmd:       ls /storage/Users/currentUser/usr/local/include/sys/time.h

rec_priority:           1
rec_approach:           source-patch
rec_description:        Add #if defined(__OHOS__) guard around #include <sys/time.h> in WrapPython.h. The __OHOS__ macro is predefined by the OHOS clang compiler.
rec_command:            sed -i 's/#include <sys\/time.h>/#if defined(__OHOS__)\n#include <sys\/time.h>\n#endif/' CXX/WrapPython.h
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:              R6

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

software:               pycxx-iter
version:                6.2.8
build_system:           script
problem:                sys/time.h not available on OHOS in the expected location
solution:               Add #if defined(__OHOS__) guard around #include <sys/time.h> in WrapPython.h
files:                  CXX/WrapPython.h
