[E104]
title=POSIX 时钟常量未定义 (CLOCK_REALTIME/CLOCK_MONOTONIC)
category=libc_compat
severity=2
phase=compilation
trigger=clang cc

symptom=
编译报错 "use of undeclared identifier 'CLOCK_REALTIME'" 或 "CLOCK_MONOTONIC"

rootcause=
musl libc 的 time.h 中 CLOCK_* 常量定义在条件编译块内：
#if defined(_POSIX_SOURCE) || defined(_GNU_SOURCE) || ...

solution=
编译时添加 -D_GNU_SOURCE 或 -D_POSIX_C_SOURCE=200809L 宏定义，启用 POSIX 扩展

verify=
echo '#include <time.h>' | clang -E -dM | grep GNU_SOURCE

software=
glfw 3.4, posix_time.c
