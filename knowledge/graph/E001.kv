#====================================================================
# E001.kv — 找不到编译器
#====================================================================
id:                     E001
title: 找不到编译器
trigger_tool:           configure
phase:                  configuration
error_signature:        C compiler cannot create executables|cc not found|
                         C compiler.*not found|clang.*not found
severity:               3
category:               toolchain
match_keywords:         cc not found, C compiler, clang, PATH, compiler,
                         cannot create executables
root_cause:             PATH 中没有 cc 软链接, 只有 clang 可用,
                         configure 默认查找 cc 找不到
affected_scope:         所有 autotools 项目 (configure 阶段)
verification_cmd:       which clang, which cc

rec_priority:           1
rec_approach:           set-env-var
rec_description:        设置 CC=clang 让 configure 使用正确的编译器
rec_command:            CC=clang
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:
principles:             P-TOOLCHAIN-001
causes:                 []
caused_by:              []
similar_to:             [E053]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E001.md
last_updated:           2026-04-09

