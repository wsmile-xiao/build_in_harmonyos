#====================================================================
# E061.kv — gnulib stdbool.h 模块缺失
#====================================================================

id:                     E061
title: gnulib stdbool.h 模块缺失
trigger_tool:           configure|cc|make
phase:                  configuration|compilation
error_signature:        stdbool\.h.*does not exist|gnulib.*stdbool.*module|
                         use gnulib module 'stdbool-c99' instead.*stdbool

severity:               2
category:               gnulib|compat|compilation
match_keywords:         gnulib, stdbool, stdbool-c99, stdbool.h, deprecated,
                         configure detection, conftest, config.h, sed, GNU software

root_cause:             gnulib 的 stdbool 模块在新版本中被标记为 deprecated,
                         应使用 stdbool-c99 替代。但 configure 检测时如果 conftest 无法执行(E064),
                         会回退到错误的默认值, 选择 fallback 模块(stdbool 而非 stdbool-c99)
affected_scope:         使用新版 gnulib 的 GNU 软件(sed 4.9, grep, coreutils, gawk 等)
verification_cmd:       grep 'stdbool' config.h | head -3

rec_priority:           1
rec_approach:           fix-conftest-first
rec_description:        根因是 E064(conftest 无法执行), 先解决弹窗确认问题让 configure 正确检测;
                         或通过环境变量强制: export gl_cv_header_stdbool_h=yes;
                         或在 configure.ac 中将 gl_STDBOOL_H 改为 gl_STDLIB_H(源码级修改)
rec_command:
rec_auto_fix:          false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      env-var-override
fallback_description:   export gl_cv_header_stdbool_h=yes 强制跳过错误检测
fallback_auto_fix:     true

forbid_1_pattern:
principles:

causes:                 [E064]
caused_by:              []
similar_to:             [E062,E063]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E061.md
last_updated:           2026-04-10
source_event:           archives/s/sed/4.9/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

