#====================================================================
# E023.kv — locale 支持不完整
#====================================================================

id:                     E023
trigger_tool:           python|ctest|runtime
phase:                  runtime|testing
error_signature:        test_locale.*FAIL|test_strcoll.*FAIL|
                         LC_ALL.*invalid|locale.*not found

severity:               1
category:               compat, posix
match_keywords:         locale, UTF-8, LC_ALL, strcoll, FAIL,
                         en_US, locale -a, test_locale, collation

root_cause:             鸿蒙 locale 数据不完整,
                         缺少 en_US.UTF-8 等常用 locale 定义
affected_scope:         依赖 locale 的测试和程序(字符串比较/格式化)
verification_cmd:       locale -a | head -10

rec_priority:           1
rec_approach:           skip-test
rec_description:        跳过 locale 相关测试或设置 LC_ALL=C 使用默认 locale
rec_command:            export LC_ALL=C; python3 -m test -x test_locale
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:
principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E023.md
last_updated:           2026-04-09
source_event:           archives/p/python/3.9.0/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
