#====================================================================
# E084.kv — Java JNI 库鸿蒙手动构建（无 ant/maven）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E084
title: Java/JNI 库手动编译模式
trigger_tool:           javac|clang|jar
phase:                  compilation|packaging
error_signature:        TEMPLATE version mismatch|
                         harmonyos-aarch64 not found in JAR|
                         ant.*not found|mvn.*not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               java|jni|build-pattern
match_keywords:         JNA, JNI, Java, javac, jar, libjnidispatch, libffi,
                         ffi_closure, callback, Native.load,
                         Java Native Access, TEMPLATE, Version.java

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Java 库（如 JNA）的鸿蒙适配需要同时编译 Java 层和 Native JNI 层，
                        但鸿蒙环境通常缺少 ant/maven 等构建工具。
                        需要手动构建：javac 编译 Java + 生成 JNI 头文件，
                        clang 编译 native .c 并静态链接 libffi，
                        最后 jar 打包。
                        JNA 的 Version.java 使用 TEMPLATE 占位符需替换为实际版本号。
                        JNA 在鸿蒙识别为 harmonyos-aarch64（不是 linux-aarch64），
                        JAR 需包含对应路径。
affected_scope:         HarmonyOS 上所有含 JNI native 层的 Java 库。
                        受影响库: JNA, JNR, JFFI, lwjgl 等。
                        Java: BiSheng JDK 17+。
verification_cmd:       |
  # 验证 JNA 加载
  java -cp dist/jna.jar com.sun.jna.Native
  # 验证平台识别
  java -cp dist/jna.jar -Djna.debug_load=true TestMain 2>&1 | grep harmonyos-aarch64

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           manual-java-native-build
rec_description:        手动构建 JNI 库：(1) 替换版本号占位符；(2) javac 编译 Java 源码并生成 JNI 头文件；
                        (3) clang 编译 native .c，静态链接 libffi.a；
                        (4) jar 打包含 harmonyos-aarch64 平台 native library；(5) 签名 ELF。
rec_command:            |
  # 1. 修改版本号: Version.java 中 VERSION = "5.19.0", VERSION_NATIVE = "5.19.0"
  # 2. 编译 Java 源码 + 生成 JNI 头文件
  javac -d build/classes -h build/jni-headers \
    -sourcepath src $(find src/com/sun/jna -name "*.java")
  # 3. 编译 Native 层（静态链接 libffi）
  clang -O2 -fPIC -D_REENTRANT -DHAVE_PROTECTION -DNO_JAWT \
    -DJNA_JNI_VERSION='"5.19.0"' -DCHECKSUM='"0"' \
    -I$JAVA_HOME/include -I$JAVA_HOME/include/linux \
    -I$FFI_HOME/include -Ibuild/jni-headers -Inative/ \
    -c native/dispatch.c -o build/dispatch.o
  clang -O2 -fPIC ... -c native/callback.c -o build/callback.o
  clang -shared -o build/libjnidispatch.so \
    build/dispatch.o build/callback.o $FFI_HOME/lib/libffi.a
  # 4. 打包 JAR（含平台 native library）
  mkdir -p build/classes/com/sun/jna/harmonyos-aarch64/
  cp build/libjnidispatch.so build/classes/com/sun/jna/harmonyos-aarch64/
  cd build/classes && jar cf dist/jna.jar com/sun/jna/
  # 5. 签名
  python3 $SKILL_ROOT/scripts/ohc-run.py sign-elf build/libjnidispatch.so
rec_auto_fix:           false
rec_impl:               manual-java-native-build

fallback_priority:      2
fallback_approach:      prebuilt-jar-inject
fallback_description:   从预编译 JAR 中注入 harmonyos-aarch64 平台的 native library，
                        跳过完整编译流程。适用于快速验证。
fallback_command:       
fallback_auto_fix:      false
fallback_impl:          

# ★ 禁止策略 ★
forbid_1_pattern:       -DJNA_JNI_VERSION.*TEMPLATE
forbid_1_reason:         Version.java 的 TEMPLATE 占位符必须替换为实际版本号，
                         否则运行时版本校验失败。
forbid_1_consequence:   JNA 运行时版本不匹配异常，native library 无法加载。

# ═══ Layer 4: 原则引用 ═══
principles:             P-JNI-001

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E083]
similar_to:             [E077]
conflicts_with:         []
prerequisite_of:        []

