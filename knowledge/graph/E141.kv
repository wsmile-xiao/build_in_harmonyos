id: E141
title: manifest.yaml configure_options YAML 空列表被 regex 解析为 shell 参数
trigger_tool:           clean_verify
phase:                  verification
error_signature:        no closing quote|configure_options.*\[\]|
                         /bin/sh.*no closing quote|YAML list.*regex parse

severity:               2
category:               manifest-yaml
match_keywords:         configure_options, YAML list, regex, [],
                         no closing quote, shell argument, manifest.yaml

root_cause:             clean_verify.py 用 regex 解析 manifest.yaml 的 configure_options 字段，YAML 空列表 [] 被解析为字面字符串 "[]" 并拼到 shell 命令行导致 quoting 错误
affected_scope:         所有 configure_options 为 YAML 列表格式的软件归档
verification_cmd:       python3 -c "import re; m=re.search(r'configure_options:\s*[\"\']?(.*?)[\"\']?\n', open('manifest.yaml').read()); print(repr(m.group(1)))"

rec_priority:           1
rec_approach:           use-empty-string
rec_description:        将 configure_options 从 YAML 列表 [] 改为空字符串 ""，避免 regex 解析错误
rec_command:            在 manifest.yaml 中设置 configure_options: ""
rec_auto_fix:           false
rec_impl:               manual-edit

fallback_priority:      2
fallback_approach:      filter-brackets
fallback_description:   在 clean_verify.py 中过滤掉 [] 和空字符串值
fallback_command:       configure_options = configure_options.strip() if configure_options not in ('[]', '') else ''
fallback_auto_fix:      true

forbid_1_pattern:       configure_options:\s*\[.*\]
forbid_1_reason:        YAML 列表格式的 configure_options 不被 regex 解析器支持
forbid_1_consequence:   [] 被传递给 shell 导致 quoting 错误

principles:             []

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E084.md
last_updated: 2026-06-01
source_event:           libbytesize-2.11-compile

draft: false
