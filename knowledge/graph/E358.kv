#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E327.kv，填写各字段
# 对应的人类文档: doc/E327.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E358
trigger_tool: cargo|rustc
phase: compilation
error_signature: unresolved import.*libc|mismatched types.*nix|target_env.*ohos|could not compile.*libc

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category:               rust, cargo-ohos-lock-compatibility
match_keywords: Rust,Cargo.lock,nix,libc,ctrlc,target_env=ohos,--locked,legacy lock graph
title: 旧 Rust Unix 依赖锁图在 OHOS target_env 下的确定性迁移

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 旧 Cargo.lock 固定的 libc/nix/ctrlc 版本早于 OHOS target_env 支持，并与现代 Rust 1.97 的目标 ABI/cfg 组合不兼容；仅设置 linker 无法修复依赖源码和锁图。
affected_scope: 在 HarmonyOS/OHOS 上使用现代 Rust 编译器构建、且 Cargo.lock 固定旧 libc/nix/ctrlc Unix 依赖图的 Rust CLI 和库。
verification_cmd: cargo build --release --locked && cargo test --workspace --release --locked --tests

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: semver-bounded-deterministic-lock-migration
rec_description: 先定位引入旧 nix/libc 的直接依赖，在上游 Cargo.toml 允许的 semver 范围内升级最小根依赖，让 Cargo 重解确定性传递锁图；把 Cargo.lock 差异作为可审计补丁导出，并保持 --locked 构建、上游测试和消费者负测。
rec_command: cargo update -p ctrlc --precise 3.5.2 && cargo build --release --locked && cargo test --workspace --release --locked --tests
rec_auto_fix: false
rec_impl: cargo-lock-portability-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: patch-minimal-transitive-crate
fallback_description: 若上游直接依赖约束不允许兼容版本，拆分依赖适配或对最小传递 crate 提交独立平台补丁，不在消费者配方中修改 registry cache。
fallback_command:
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: cargo build(?!.*--locked)|cargo update$
forbid_1_reason: 无边界更新或移除 --locked 会掩盖实际依赖图并破坏可复现性。
forbid_1_consequence: CI 与真机解析到不同依赖版本，无法审计真正的 OHOS 修复。
forbid_2_pattern: \.cargo/registry/src|site-packages.*cargo
forbid_2_reason: 禁止修改设备全局 Cargo registry cache。
forbid_2_consequence: 污染共享真机缓存并让其他任务结果不可复现。

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P004,P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes: []
caused_by: []
similar_to: []
conflicts_with: []
prerequisite_of: []

