#====================================================================
# E333-draft-nymphrpc-make-j1-unify.kv — OHOS 下 make 应统一 -j1：
#   仓库 Makefile 模板（如 7zip）仍用 -j$(nproc) 需修正
#   实例：nymphrpc 0.1.1 make lib -j1 PASS
#====================================================================

# --- frontmatter 检索字段 ---

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E525
trigger_tool:       make|conan|recipe
phase:              compilation
error_signature:    make.*-j.*hang|make.*stuck|FIFO.*Permission denied|make.*-j.*nproc

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:           2
category:               selinux, build-system, filesystem
match_keywords:     make -j, nproc, -j1, FIFO, jobserver, 7zip, Makefile, OHOS, 并行构建
title:              OHOS 下 make 应统一 -j1：仓库 Makefile 模板（如 7zip）仍用 -j$(nproc) 需修正

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:         鸿蒙 SELinux 策略禁止用户进程创建 FIFO，GNU make jobserver 依赖
                    FIFO 传递并行令牌，make -j>1 会卡住或报错（E074）。仓库部分
                    Makefile 型 recipe 模板（archives/7/7zip/23.01 与 25.01
                    conanfile.py）仍用 make -j$(nproc)，新 recipe 照抄会踩 FIFO 坑。
affected_scope:     OHOS 上所有使用 make -j>1 的 Autotools/CMake/Makefile 型 recipe
verification_cmd:   mkfifo /tmp/test_fifo 2>&1   # 应报 Permission denied

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:       1
rec_approach:       force-j1
rec_description:    Makefile 型 recipe 的 self.run 统一 make -j1；E074 增补模板不一致提示。
rec_command:        make lib -j1
rec_auto_fix:       true
rec_impl:           env-var-override

fallback_priority:  2
fallback_approach:  add-makeflags
fallback_description: 必须保留部分并行时用 MAKEFLAGS 禁用 jobserver（E074 fallback 同款），
                    仍不可行则整体 -j1。
fallback_command:   export MAKEFLAGS="--no-builtin-rules --no-builtin-variables -j1"
fallback_auto_fix:  true
fallback_impl:      set-env-var

forbid_1_pattern:   make.*-j.*nproc
forbid_1_reason:    OHOS FIFO 权限限制使 jobserver 初始化失败，并行构建卡住/报错。
forbid_1_consequence: 编译进程永久挂起，占用资源不产出。
forbid_2_pattern:   把 jobserver 报错误判为编译命令错误去改 Makefile 目标
forbid_2_reason:    FIFO 是系统级限制，改 Makefile 目标不解决；且会污染上游构建。
forbid_2_consequence: 无谓修改 Makefile 且并行仍失败，浪费调试轮次。

# ═══ Layer 4: 原则引用 ═══
principles:         P013, P014, P020

# ═══ 关系图 (Relations) ═══
causes:
caused_by:          E074
similar_to:         E074
conflicts_with:
prerequisite_of:

