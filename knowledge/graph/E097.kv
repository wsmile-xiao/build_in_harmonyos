#====================================================================
# E097.kv — BearSSL 自定义 Makefile 构建系统
# 问题: 无标准 configure/make install 流程，需自定义配置
# 解决: 创建 Ohos.mk 配置文件，手动安装
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E097
trigger_tool:           make
phase:                  configuration
error_signature:        No rule to make target.*install|No configure script found|make:.*mk/SingleUnix.mk.*No such file

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, make
match_keywords:         bearssl, mk/, conf/, SingleUnix.mk, no configure, custom Makefile, manual install

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             BearSSL 使用自定义 Makefile 构建系统（mk/*.mk, conf/*.mk），不支持 autotools/cmake 标准流程，需手动创建平台配置文件并手动安装
affected_scope:         BearSSL 及类似使用自定义构建系统的小型 TLS/加密库
verification_cmd:       ls conf/ mk/ && echo "Custom build system detected"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           custom-config-mk
rec_description:        创建 conf/Ohos.mk 配置文件，指定 clang/llvm-ar，禁用共享库（API 不稳定），手动安装头文件和静态库
rec_command:            cat > conf/Ohos.mk << 'EOF'\ninclude conf/Unix.mk\nCC = clang\nCFLAGS = -W -Wall -Os -fPIC\nAR = llvm-ar\nDLL = no\nEOF\nmake CONF=Ohos
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:      cmake-alternative
fallback_description:   寻找是否有 CMake 支持的 fork 或替代库（如 mbedTLS, wolfSSL）
fallback_command:       
fallback_auto_fix:      false
fallback_impl:          none

# ═══ Layer 4: 原则引用 ═══
principles:             

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E097.md
last_updated:           2026-04-27
source_event:           bearssl 0.6 编译


