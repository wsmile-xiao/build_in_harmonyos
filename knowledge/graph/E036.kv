#====================================================================
# E036.kv — 平台字符串含空格导致构建路径错误
#====================================================================

id:                     E036
trigger_tool:           python|configure|make
phase:                  configuration|compilation
error_signature:        No module named '_sysconfigdata'.*ohos_aarch64|
                         build path.*space|platform string.*space|uname.*space

severity:               2
category:               python|platform|filesystem
match_keywords:         sysconfig, get_platform, uname, space, ohos-aarch64,
                         _sysconfigdata, BUILDEXEEXT, Python platform, path resolution

root_cause:             uname -r 返回 "HongMeng Kernel 1.11.0"(含空格),
                         Python 的 get_platform() 将其拼入路径, 导致模块路径解析失败
affected_scope:         Python 构建及依赖 sysconfig.get_platform() 的工具链
verification_cmd:       python3 -c "import sysconfig; print(sysconfig.get_platform())"

rec_priority:           1
rec_approach:           source-patch
rec_description:        修改 sysconfig.py / distutils/util.py,
                         跳过 release 字段, 使用 "ohos-aarch64" 作为平台标识
rec_command:
rec_auto_fix:          false
rec_impl:               patch

fallback_priority:      2
fallback_approach:      env-override
fallback_description:   设置 PYTHON_PLATFORM 环境变量覆盖 (如果 Python 版本支持)
fallback_auto_fix:     false

forbid_1_pattern:      在路径处理代码中直接拼接 uname -r 输出而不做空格过滤
forbid_1_reason:       鸿蒙内核版本字符串含空格, 直接拼接导致路径解析失败
forbid_1_consequence:  ImportError: No module named '_sysconfigdata_xxx'
principles:               

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E036.md
last_updated:           2026-04-10
source_event:           archives/s/python/3.9.0/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

