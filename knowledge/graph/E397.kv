# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E257.kv，填写各字段
# 对应的人类文档: doc/E257.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E397
trigger_tool: clang|clang++
phase: compilation
error_signature: missing 'typename' prior to dependent type name

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: cxx-compiler-compat
match_keywords:         missing typename, dependent type name, P0634R3, typename elision, C++20 clang
title: C++20 typename elision (P0634R3) not supported by clang 15

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: entt v4.0.0 uses C++20 P0634R3 (typename elision in dependent type names), but OHOS SDK clang 15.0.4 has incomplete support for this feature. The compiler reports 'missing typename prior to dependent type name' for all usages of X<...>::type, Y::template Z, etc. without the typename keyword.
affected_scope: header-only C++20 libraries using P0634R3 typename elision (e.g. entt v4.0.0+), any C++20 code compiled with clang < 16
verification_cmd: clang++ -std=c++20 -I src test.cpp -o test && ./test

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: Add 'typename' keyword before all dependent type names in source headers. Three patterns: (1) using X = Y<...>::type -> using X = typename Y<...>::type; (2) using X = Y::template Z<...> -> using X = typename Y::template Z<...>; (3) using X = alloc_traits::member -> using X = typename alloc_traits::member. Apply systematically using clang error output to locate all positions.
rec_description:        Insert 'typename' keyword before all dependent type names reported by clang error output
rec_command: clang++ -std=c++20 -I src -ferror-limit=0 test.cpp -o /dev/null 2> errors.txt && python3 fix_typename.py errors.txt
rec_auto_fix:           false                  # 引擎能否自动执行
rec_impl:               manual-edit                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

