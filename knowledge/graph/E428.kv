#====================================================================
# DRAFT-pico-sdk-test-package-absolute-pioasm — test_package 子脚本不要依赖 PATH 找 CLI 工具
# Source event: pico-sdk 2.2.0 shadow CI r3 failed, r4 passed after absolute pioasm path
#====================================================================

id:                     E428
trigger_tool:           conan|test_package|python|bash|pioasm
phase:                  testing
error_signature:        FileNotFoundError: \[Errno 2\] No such file or directory: 'pioasm'|PICO_SDK_PATH missing|bash: /etc/profile: Permission denied
severity:               3
category:               conan, packaging, testing, cli-tool, runtime-env
match_keywords:         pico-sdk, pioasm, test_package, VirtualRunEnv, env=conanrun, subprocess.run, PATH, absolute path, FileNotFoundError
title:                  pico-sdk test_package 的 Python 子脚本应接收 bin/pioasm 绝对路径，避免 OHOS bash 环境丢 PATH

root_cause:             test_package/conanfile.py 使用 self.run(..., env="conanrun") 能注入 PICO_SDK_PATH/PATH，但当它再通过 bash -lc 调 Python，Python 子脚本内 subprocess.run(["pioasm", ...]) 仍可能找不到工具。OHOS 的 bash 登录包装还会打印 /etc/profile: Permission denied，进一步说明不应依赖登录 shell PATH。
affected_scope:         Conan application 包 test_package 中“Python/sh 子脚本再调用包内 CLI”的所有场景，尤其是 OHOS profile + bash -lc 包装。
verification_cmd:       conan create archives/p/pico-sdk/2.2.0 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing

rec_priority:           1
rec_approach:           pass-packaged-tool-absolute-path
rec_description:        在 test_package/conanfile.py 中从 dep.package_folder/bin 计算 pioasm 绝对路径，确认文件存在后作为参数传给 smoke.py；smoke.py 使用该绝对路径运行 --version 和 .pio->.h，不再依赖 PATH 解析。
rec_command:            pioasm_path = os.path.join(dep.package_folder, "bin", "pioasm"); self._run_tool([sys.executable, smoke_script, pioasm_path, smoke_pio, smoke_header])
rec_auto_fix:           false
rec_impl:               test-package-fix

fallback_priority:      2
fallback_approach:      run-cli-directly-in-conanfile
fallback_description:   不拆 Python 子脚本，直接在 test_package/conanfile.py 的 self.run 中调用绝对路径的 pioasm；但可读性和 L0 test source 证据较弱。
fallback_command:       self.run(f"{pioasm_path} --version", env="conanrun")
fallback_auto_fix:      false
fallback_impl:          conanfile-only

forbid_1_pattern:       subprocess\.run\(\["pioasm"|self\.run\("pioasm"
forbid_1_reason:        子进程和登录 shell 的 PATH 继承在 OHOS shadow CI 中不稳定，容易出现 r3 的 FileNotFoundError。
forbid_1_consequence:   L1 conan create/test_package 失败，即使包内 bin/pioasm 已经真实存在。

principles:             P014, P016
causes:                 []
caused_by:              []
similar_to:             [E290]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-pico-sdk-test-package-absolute-pioasm.md
last_updated:           2026-08-25
source_event:           pico-sdk 2.2.0 shadow CI r3 failed because smoke.py could not find pioasm; r4 passed after passing absolute tool path
authors: wxjshr <wxjshr@noreply.gitcode.com>
source_pr: !6613
source_commit:          0ad30b6f0d

metrics_success_count:  1
metrics_fail_count:     1
metrics_confidence:     0.5
metrics_last_used:      2026-08-25

