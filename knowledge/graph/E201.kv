id: E201
trigger_tool:           runtime
phase:                  runtime
error_signature:        test_run\.sh|/bin/bash.*not found|strace.*not available
severity:               1
category:               testing-limitation
match_keywords:         test_run.sh, /bin/bash, strace, OHOS
title:                  test_run.sh wrapper unavailable on OHOS (bash/strace missing)
root_cause:             test_run.sh requires /bin/bash (not at standard path on OHOS) and strace (not available on OHOS)
affected_scope:         All autotools-based test suites using test_run.sh on OHOS
verification_cmd:       test -x /bin/bash && which strace
rec_priority:           1
rec_approach:           manual-test-execution
rec_description:        Run test binaries directly instead of through test_run.sh wrapper
rec_command:            LD_PRELOAD=$DEFAULT_PREFIX/lib/libXXX.so ./test_binary
rec_auto_fix:           false
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
