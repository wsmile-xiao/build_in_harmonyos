#====================================================================
# E009.kv — SELinux 域转换限制
#====================================================================

id:                     E009
trigger_tool:           python|make|shell|runtime
phase:                  runtime|compilation
error_signature:        Permission denied.*clang|
                         subprocess.*exit code.*1.*clang|
                         cannot execute.*hnp_file|
                         adhoc_bin.*hnp_file

severity:               2
category:               selinux|security
match_keywords:         SELinux, domain transition, adhoc_bin,
                         hishell_hap, hnp_file, Permission denied,
                         subprocess, pipe, | cat, 2>&1

root_cause:             鸿蒙 SELinux 策略限制域转换:
                         Shell 进程(hishell_hap:s0)执行用户二进制时
                         域转换为 adhoc_bin:s0, 后者无权执行
                         hnp_file 类型的 SDK 工具(如 clang)
affected_scope:         Python subprocess、Makefile 子进程调用、
                         shell 脚本中调用 SDK 工具
verification_cmd:       python3 -c "import subprocess; subprocess.run(['clang','--version']); print('OK' if _ else 'FAIL')"

rec_priority:           1
rec_approach:           pipe-bypass
rec_description:        使用管道语法绕过 SELinux 域限制:
                         将 "cmd" 改为 "cmd | cat" 或 "cmd 2>&1 | cat"
rec_command:
rec_auto_fix:          true
rec_impl:               pipe-bypass

principles:

causes:                 []
caused_by:              []
similar_to:             [E008, E054]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E009.md
last_updated:           2026-04-09
source_event:           archives/p/python/*/manifest.yaml
