#====================================================================
# E092.kv — CMake 不识别 HarmonyOS 平台
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E092
trigger_tool:           cmake
phase:                  configuration
error_signature:        System is unknown to cmake|
                         CMAKE_SYSTEM_NAME.*ohos|
                         not find toolchain|
                         harmonyos.*not supported|
                         Unknown system.*harmonyos

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               platform_detection|cmake
match_keywords:         CMAKE_SYSTEM_NAME, CMakeLists.txt, ohos, harmonyos,
                         cmake, platform detection, unknown system,
                         check_c_source_compiles, check_function_exists,
                         HAVE_SNPRINTF, HAVE_DECL_ISNAN

# ═══ Layer 2: 诊断层 ═══
root_cause:             CMake 不认识 HarmonyOS 作为目标平台，
                        没有对应的 platform module。
                        当 CMake 检测到系统名称为 harmonyos/ohos 时，
                        无法匹配任何已知平台（Linux, Darwin, Windows 等），
                        导致 configure 阶段失败或生成错误的构建文件。
                        HarmonyOS 基于 Linux 内核，CMake 的 Linux 平台
                        模块通常可以直接使用。
affected_scope:         所有使用 CMake 构建系统的跨平台软件。
verification_cmd:       cmake --system-information 2>&1 | grep CMAKE_SYSTEM_NAME;
                         grep -rn "CMAKE_SYSTEM_NAME" CMakeLists.txt cmake/ 2>/dev/null

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           cmake-toolchain
rec_description:        通过 -DCMAKE_SYSTEM_NAME=Linux 配合 toolchain 文件，
                        让 CMake 将 HarmonyOS 视为 Linux 平台。
                        在 toolchain 文件中设置 CMAKE_SYSTEM_PROCESSOR=aarch64
                        和编译器路径。
rec_command:            cmake -B build -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=aarch64 -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ --prefix=$DEFAULT_PREFIX
rec_auto_fix:           true
rec_impl:               cmake-override

fallback_priority:      2
fallback_approach:      cmake-vars-manual
fallback_description:   手动设置 CMAKE_SYSTEM_PROCESSOR=aarch64 及相关变量，
                        不通过 toolchain 文件。
fallback_command:       cmake -B build -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=aarch64 -DCMAKE_INSTALL_PREFIX=$DEFAULT_PREFIX
fallback_auto_fix:      false
fallback_impl:          

                        当 check_c_source_compiles/check_function_exists 在 HarmonyOS
                        上因工具链差异误判为失败时使用。
                        # 在 CMakeLists.txt 中添加:
                        target_compile_definitions(mytarget PRIVATE
                            HAVE_SNPRINTF=1
                            HAVE_DECL_ISNAN=1
                        )
                        # 或直接修改生成的 config.h:
                        echo "#define HAVE_SNPRINTF 1" >> config.h

# ★ 禁止策略 ★
forbid_1_pattern:       CMAKE_SYSTEM_NAME.*ohos|CMAKE_SYSTEM_NAME.*HarmonyOS
forbid_1_reason:        不要将 CMAKE_SYSTEM_NAME 设为 ohos/harmonyos，
                        CMake 不认识此平台名称，会导致更多构建错误
forbid_1_consequence:   CMake 无法加载任何平台模块，构建系统完全失效

# ═══ Layer 4: 原则引用 ═══
principles:               

