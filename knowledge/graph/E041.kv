#====================================================================
# E041.kv — automake 版本不匹配触发重生成
#====================================================================

id:                     E041
trigger_tool:           configure|automake|make
phase:                  configuration|compilation
error_signature:        requires automake.*but.*installed|AM_INIT_AUTOMAKE.*too old|
                         autotools.*version mismatch

severity:               2
category:               autotools|compat|build-system
match_keywords:         automake, version mismatch, aclocal, autoheader,
                         autoreconf, VPATH, timestamp, Makefile.am, configure.ac

root_cause:             上游 tarball 的 configure 用较新 automake 生成,
                         但 configure.ac 声明的版本要求更高; 或 VPATH 构建中源码时间戳更新触发 autotools 重生成
affected_scope:         使用 autotools 的项目 (man-db 等)
verification_cmd:       grep -i "automake" configure.ac | head -5

rec_priority:           1
rec_approach:           bypass-autotools
rec_description:        使用 /bin/true 绕过 autotools 重生成工具:
                         ACLOCAL=/bin/true AUTOHEADER=/bin/true AUTOMAKE=/bin/true ./configure
rec_command:            ACLOCAL="/bin/true" AUTOHEADER="/bin/true" AUTOMAKE="/bin/true" \
                           ./configure --prefix=$HOME/usr/local && make -j1
rec_auto_fix:          true
rec_impl:               set-env-var

fallback_priority:      2
fallback_approach:      vpath-build
fallback_description:   VPATH 构建(源码与构建目录分离), 避免触碰源码时间戳
fallback_auto_fix:     false

forbid_1_pattern:      在已包含正确生成的 Makefile.in 的 tarball 上运行 autoreconf 或手动 touch 源码文件
forbid_1_reason:       会触发 autotools 重生成, 而系统 automake 版本可能不满足要求
forbid_1_consequence:  大量版本不匹配错误, 构建失败
principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E041.md
last_updated:           2026-04-10
source_event:           archives/s/man-db/2.13.1/manifest.yaml
