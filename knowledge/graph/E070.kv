#====================================================================
# E070.kv — 无 32 位兼容层 (build-systems.md §10.2)
# 软件默认启用 m32 personality 在纯 aarch64 上无法编译
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E070
trigger_tool:           configure|cc|clang
phase:                  configuration|compilation
error_signature:        m32.*personality|32-bit.*compat|cannot create .*32 bit|invalid arch.*m32|-m32.*unsupported

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               compat, architecture
match_keywords:         m32, 32-bit, personality, aarch64, multiarch, cross compile, strace, --disable-mpers

# ═══ Layer 2: 诊断层 ═══
root_cause:             部分软件默认启用 32 位兼容支持(m32 personality)，
                         鸿蒙是纯 aarch64 系统，无 32 位兼容层
affected_scope:         strace、gdb 等支持多架构调试的软件
verification_cmd:       ./configure --help | grep -i "32\|m32\|multi\|personality"

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           reconfigure-disable-feature
rec_description:        通过 --disable-mpers 或类似选项禁用 32 位兼容支持
rec_command:            ./configure --disable-mpers --prefix=$HOME/usr/local
rec_auto_fix:           true
rec_impl:                configure-disable-feature

fallback_priority:      2
fallback_approach:      add-cflags-filter-m32
fallback_description:   如果无 configure 选项，尝试过滤 CFLAGS 中的 -m32 标志
fallback_command:      export CFLAGS=$(echo $CFLAGS | sed 's/-m32//g')
fallback_auto_fix:      false
fallback_impl:          add-cflags

forbid_1_pattern:       force.*m32(?!.*filter)
forbid_1_reason:        鸿蒙无 32 位兼容层，强制启用必然失败
forbid_1_consequence:   linker error: cannot create executable / invalid arch

# ═══ Layer 4: 原则引用 ═══
principles:               

# ═══ 关系图 ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E070.md
last_updated:           2026-04-10
source_event:           strace 6.19 编译

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

