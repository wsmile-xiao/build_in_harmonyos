#====================================================================
# E081.kv — config.sub kernel-os 验证缺少 linux-ohos
#====================================================================

id: E122
title: config.sub kernel-os 验证缺少 linux-ohos
trigger_tool:           config.sub
phase:                  configuration
error_signature:        Invalid configuration.*Kernel.*linux.*not known to work with OS.*ohos|
                         Kernel.*linux.*not known to work with OS.*ohos|
                         linux-ohos.*not recognized

severity:               2
category:               autotools-config
match_keywords:         config.sub, kernel-os, linux-ohos, Invalid configuration,
                         not known to work, kernel validation

root_cause:             GNU config.sub 脚本的 kernel-os 组合验证（case $kernel-$os-$obj in）
                         只包含 linux-gnu、linux-android、linux-musl 等已知组合，
                         不包含 linux-ohos。当 config.guess 输出 aarch64-unknown-linux-ohos
                         时，config.sub 在最终验证阶段拒绝此三元组。
                         patch-autotools-ohos.pl 脚本只修改了 OS 列表和基本三元组，
                         但未修改 kernel-os 验证列表。
affected_scope:         **所有 autotools 项目**（在应用 patch-autotools-ohos.pl 后仍可能遇到）
verification_cmd:       grep "linux-gnu\*-" build-aux/config.sub;
                         grep "linux-ohos" build-aux/config.sub;
                         ./build-aux/config.sub aarch64-unknown-linux-ohos

rec_priority:           1
rec_approach:           add-linux-ohos-to-validation
rec_description:        在 config.sub 的 kernel-os 验证列表中添加 linux-ohos*-。
                         定位到 "case $kernel-$os-$obj in" 分支，
                         在 linux-uclibc*- 后添加 linux-ohos*-。
rec_command:            sed -i '/linux-uclibc\*- )/a\            | linux-ohos*- )/' build-aux/config.sub
rec_auto_fix:           false
rec_impl:               source-patch

forbid_1_pattern:       --build=*|--host=*
forbid_1_reason:        导致 configure 误判为交叉编译，
                         AC_RUN_IFELSE 等运行时检测全部跳过，
                         生成的 config.h 与实际平台不匹配
forbid_1_consequence:   级联错误链

principles:             P-AUTOTOOLS-001, P-AUTOTOOLS-002

causes:                 []
caused_by:              [E007]
similar_to:             [E007]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E081.md
last_updated:           2026-04-30
source_event:           archives/l/libseccomp/2.6.0

