#====================================================================
# E332-draft-nymphrpc-sha256-multipath.kv — scout/recipe 创建期 SHA-256
#   必须多网络路径交叉验证
#   实例：nymphrpc 0.1.1 scout 误测 5470a997 → 交叉验证定 63bc35e8
#====================================================================

# --- frontmatter 检索字段 ---

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E406
trigger_tool:       scout|conan|curl|recipe
phase:              source|download|recipe-creation
error_signature:    sha256 hash failed.*Provided.*Computed|hash.*mismatch|scout.*sha256

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:           2
category:               dependency, download, scout, sha256
match_keywords:     sha256, SHA-256, 交叉验证, 多路径, codeload, 代理, 直连, 误测,
                    scout, recipe 创建, hash mismatch, conandata.yml
title:              scout/recipe 创建期 SHA-256 必须多网络路径交叉验证

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:         scout 或 recipe 创建阶段只走单一网络路径（直连或某一代理）采集
                    上游源码 SHA-256 时，若该路径返回被改动的内容，采集到的 hash
                    会偏离官方字节；错误 hash 写进 conandata.yml/manifest，
                    直到 CI 下载校验才暴露。
affected_scope:     所有需在 recipe 创建期声明上游源码 SHA-256 的适配流程
verification_cmd:   curl -fsSL <official-tar.gz> | sha256sum   # 至少两条网络路径比对

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:       1
rec_approach:       multi-path-cross-verify
rec_description:    创建期 hash 必须多网络路径交叉验证：官方 codeload/直连 + 独立本机
                    路径 + 至少 1 个代理；对比字节与 hash，一致才可写入 conandata.yml。
rec_command:        curl -fsSL <official-tar.gz> | sha256sum; 对第二网络路径重复，比对一致
rec_auto_fix:       false
rec_impl:           manual

fallback_priority:  2
fallback_approach:  official-first-adjudicate
fallback_description: 多路径结果不一致时以官方发布物（codeload/直连）为准，排查污染源；
                    仍无法一致则按 E299 分层诊断（网络/URL/可信 hash 分别处理）。
fallback_command:   curl -fsSL <official-tar.gz> | sha256sum
fallback_auto_fix:  false
fallback_impl:      manual

forbid_1_pattern:   单一路径采集 hash 直接写入 conandata.yml
forbid_1_reason:    代理/直连返回内容可能被改动，scout 期误测会污染 conandata.yml 并浪费后续 CI 轮。
forbid_1_consequence: CI source() 阶段 sha256 hash failed，需回溯重测。
forbid_2_pattern:   把 hash 校验失败一律当作网络问题换镜像
forbid_2_reason:    校验失败根因可能在采集期污染而非网络，盲目换镜像会再次采到错误内容。
forbid_2_consequence: 反复换镜像浪费 CI 轮次，且可能引入新的被改动内容。

# ═══ Layer 4: 原则引用 ═══
principles:         P013

# ═══ 关系图 (Relations) ═══
causes:
caused_by:
similar_to:         E299, E271, E285
conflicts_with:
prerequisite_of:

