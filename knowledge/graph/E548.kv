#====================================================================
# 来源事件: libcolord 1.4.8 HarmonyOS 适配（archives/l/libcolord/1.4.8）
#====================================================================

id:                     E548
trigger_tool:           test|runtime
phase:                  testing|runtime
error_signature:        G_IS_FILE.*assert|G_TYPE_CHECK_INSTANCE_TYPE.*failed|cd_icc_load_file.*failed|cd_it8_load_from_file.*failed
severity:               2
category:               testing, limitation, linking
match_keywords:         static glib, GType, G_IS_FILE, GFile, double copy, cross library, test_package, cd_icc_load_file, CdColorRGB, CdIcc, 静态 glib, llvm-nm

title:                  静态 glib 双副本 GType 不互通导致跨库 GFile* 的 G_IS_FILE 断言失败：test_package 应避免跨库传递 GObject，改用纯 struct API

root_cause:             glib2 为静态库时，被测库（如 libcolordprivate.so，内嵌 6166 个 glib 局部符号）与测试二进制各链一份静态 glib，GType 类/实例类型注册表不互通；测试侧创建的 GFile*（测试二进制 glib 的 GType 表）传入库内（另一份 glib 的 GType 表）时 G_IS_FILE 跨类型系统检查失败。属构建环境限制（原生 Linux glib 为动态库共享 GType，无此问题），非库代码缺陷。test_package 应只用纯 struct API（如 CdColorRGB/CdIcc）做实质验证，避免跨库传 GObject。
affected_scope:         静态 glib 配置下跨库传 GObject 的上游测试与 test_package（colord/libcolord 等）
verification_cmd:       llvm-nm -g build/lib/colord/libcolordprivate.so 2>/dev/null | grep -c -E 'g_file_|g_type_' ; ./build/tests/colord-test-private 2>&1 | grep -c 'G_IS_FILE'

rec_priority:           1
rec_approach:           avoid-cross-library-gobject-in-tests
rec_description:        静态 glib 下涉及跨库 GFile/GObject 的上游测试必然失败（环境限制，非适配缺陷，报告中如实回填原因）；test_package 改用不跨库传 GObject 的纯 struct API 做实质验证
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

