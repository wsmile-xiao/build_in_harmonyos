#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E080.kv，填写各字段
# 对应的人类文档: doc/E080.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E110
trigger_tool:           configure
phase:                  configuration
error_signature:        config.status: can't create ./confXXXXXX/subs1.awk: Permission denied|could not setup config files machinery

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               platform_limitation
match_keywords:         HMDFS, config.status, Permission denied, confXXXXXX, temp file, autotools

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HMDFS (HarmonyOS Distributed File System) restricts temporary file creation in source directories. Autoconf config.status script needs to create temp directories like ./confXXXXXX in the source tree, which fails due to HMDFS permission restrictions.
affected_scope:         All autotools-based software (cannot compile on HMDFS without workaround)
verification_cmd:       cd $HOME/tmp && echo 'AC_INIT([test],[1.0]) AM_INIT_AUTOMAKE AC_CONFIG_FILES([Makefile]) AC_OUTPUT' > configure.ac && autoreconf -i && ./configure 2>&1 | grep -i permission || echo "configure works"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           use_alternate_build_dir
rec_description:        Use VPATH build (build outside source tree) or compile in non-HMDFS location
rec_command:            mkdir -p ~/tmp/build && cd ~/tmp/build && ../source/configure --prefix=$DEFAULT_PREFIX
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      use_precompiled_package
fallback_description:   Install precompiled package from cmd-pkgs if available
fallback_command:       curl install.sh | sh -s -- <package> <version>
fallback_auto_fix:      false
fallback_impl:          manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

