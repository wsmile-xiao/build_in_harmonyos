#====================================================================
# E321 draft — Conan 原始 makefile 软件适配的三个通用陷阱
#
# 场景: endlessh 1.1 (2026-08-19) 使用 raw POSIX Makefile 构建（无
#       configure/cmake/meson），适配 OHOS 平台时遇到三个其他软件也会
#       遇到的通用问题。本条目将这三个问题合并记录为"raw makefile
#       Conan 配方"模式的知识沉淀。
# 适用: 所有使用 raw makefile（非 autotools/cmake/meson 生成）构建的
#       Conan 配方，尤其是从 GitHub codeload 下载源码的单文件程序。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E392
trigger_tool:           conan|make
phase:                  source|compilation
error_signature:        BadZipFile.*File is not a zip file|conan.*get.*BadZipFile|No targets specified.*No makefile found|make.*No rule to make target|KeyError.*compiler_executables|AttributeError.*str.*has no attribute.*get|tools\.build:compiler_executables

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               ohos, make, compiler, conan, packaging
match_keywords:         BadZipFile, File is not a zip file, codeload.github.com, get(), filename, strip_root, tar.gz, zip, Conan, compiler_executables, dict, check_type, make, No targets specified, No makefile found, cwd, source_folder, build_folder, raw makefile, single-file, install, copy, OHOS
title:                  Raw makefile Conan 配方的三个通用陷阱：BadZipFile 编码器误选 / compiler_executables 字典获取 / make 默认 cwd 错误

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             Raw makefile（非 autotools/cmake/meson 生成）软件适配 Conan 时有三个通用陷阱：(1) codeload URL 末段是 tag 名无扩展名，Conan get() 按末段推断文件名默认用 zip 解码器解压 tar.gz 报 BadZipFile；(2) OHOS profile 的 tools.build:compiler_executables 是字典 {'c':...,'cpp':...} 而非单独键，直接用 conf.get 取值返回字符串或报错无法 .get()；(3) raw makefile 的 Makefile 在 source_folder，self.run("make") 默认在 build_folder 执行找不到 Makefile。
affected_scope:         所有使用 raw POSIX Makefile（无 configure 生成 Makefile）构建的 Conan 配方，从 GitHub codeload 下载源码、且需在 OHOS 交叉编译环境用 profile 指定编译器的软件。典型如 endlessh、其他单文件 C 程序。autotools/cmake/meson 生成的构建系统不受影响（它们把 Makefile 生成到 build 目录，且有自己的编译器获取机制）。
verification_cmd:       python3 scripts/ohc-run.py conan-verify endlessh 1.1 2>&1 | grep -E "BadZipFile|No makefile found|KeyError|AttributeError"

# 真实证据: endlessh 1.1 (2026-08-19) conan-verify G2 三次失败后修复
# URL: https://codeload.github.com/skeeto/endlessh/tar.gz/refs/tags/1.1
# 修复1: source() get() 增加 filename="endlessh-1.1.tar.gz"
# 修复2: conf.get("tools.build:compiler_executables", default={}, check_type=dict) 再 .get("c")
# 修复3: self.run("make ...", cwd=self.source_folder)

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           raw-makefile-conan-recipe-pattern
rec_description:        Raw makefile Conan 配方采用三要素模式：(1) get() 显式传 filename="软件名-版本.tar.gz" 避免编码器误选；(2) 用 check_type=dict 整体获取 compiler_executables 字典再 .get("c") 取编译器；(3) self.run("make ...") 必须加 cwd=self.source_folder。三者缺一不可。
rec_command:            get(self, **self.conan_data["sources"], strip_root=True, filename="<name>-<ver>.tar.gz")  # 修复1
rec_auto_fix:           false
rec_impl:               conanfile-edit

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      manual-compiler-env-override
fallback_description:   若无法用 check_type=dict（旧 Conan 版本），可用 os.environ.get("CC") 或 self.conf.get("tools.build:compiler_executables") 解析字符串，但不推荐，R33 要求从 Conan conf 获取而非环境变量。
fallback_command:       cc = os.environ.get("CC", "clang")
fallback_auto_fix:      false
fallback_impl:          conanfile-edit

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       get\(self,\s*\*\*self\.conan_data\[.sources.\],\s*strip_root=True\s*\)
forbid_1_reason:        当 conandata URL 末段无扩展名（codeload 的 .../tar.gz/refs/tags/X.Y 末段是 tag 名）时，此写法必然触发 BadZipFile。
forbid_1_consequence:   conan create 在 source() 阶段失败，配方无法构建。

forbid_2_pattern:       self\.conf\.get\(.tools\.build:compiler_executables.\)
forbid_2_reason:        OHOS profile 中该字段是字典 {'c':...,'cpp':...}，不加 check_type=dict 会返回字符串导致后续 .get() 报 AttributeError。
forbid_2_consequence:   build() 阶段获取编译器失败，make 命令使用错误或缺失的编译器。

forbid_3_pattern:       self\.run\(.make.*\)
forbid_3_reason:        raw makefile 的 Makefile 在 source_folder，self.run 不指定 cwd 默认在 build_folder 执行，找不到 Makefile 报 "No targets specified. No makefile found."
forbid_3_consequence:   build() 阶段 make 失败，无法编译。

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

