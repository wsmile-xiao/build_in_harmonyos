id: E179
trigger_tool:           python
phase:                  runtime
error_signature:        ImportError: Error loading shared library.*Permission denied
severity:               3
category:               platform-limitation
match_keywords:         ELF签名, Python扩展模块, Permission denied, ImportError

root_cause:             鸿蒙系统要求 ELF 文件签名才能执行，HMDFS + SELinux 限制导致 Python 无法加载自定义编译的扩展模块
affected_scope:         所有包含 Python 扩展模块（.so）的软件
verification_cmd:       python3 -c "import _module" 2>&1 | grep "Permission denied"

rec_priority:           1
rec_approach:           configure-option
rec_description:        禁用需要加载 Python 扩展模块的功能
rec_command:            添加构建选项: -Dbuild_introspection_data=false (meson) 或 --disable-introspection (autotools)
rec_auto_fix:           true

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
