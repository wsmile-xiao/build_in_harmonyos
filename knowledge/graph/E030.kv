#====================================================================
# E030.kv — 鸿蒙无 32 位兼容层导致编译失败
#====================================================================

id:                     E030
title: 鸿蒙无 32 位兼容层导致编译失败
trigger_tool:           configure|cc
phase:                  configuration
error_signature:        m32.*personality.*fail|32-bit.*not supported|
                         --disable-mpers|aarch64.*only

severity:               1
category:               architecture|configure
match_keywords:         m32, 32-bit, personality, strace, aarch64 only,
                         --disable-mpers, cross compile, architecture mismatch

root_cause:             某些工具(strace 等)默认启用 32 位程序追踪支持(m32 personality),
                         鸿蒙系统仅有 aarch64 架构, 无 32 位兼容层
affected_scope:         strace 等需要多架构支持的调试/追踪工具
verification_cmd:       uname -m; file /bin/ls | grep -o 'aarch64\|arm'

rec_priority:           1
rec_approach:           configure-disable-feature
rec_description:        禁用 32 位支持(--disable-mpers), 仅保留 aarch64 支持
rec_command:            ./configure --disable-mpers --prefix=$HOME/usr/local
rec_auto_fix:          true
rec_impl:               reconfigure

forbid_1_pattern:
principles:

causes:                 []
caused_by:              []
similar_to:             [E016]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E030.md
last_updated:           2026-04-09
source_event:           archives/s/strace/6.19/manifest.yaml
