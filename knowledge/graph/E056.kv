#====================================================================
# E056.kv — @unittest.skipIf reason 换行反转导致 IndentationError
#====================================================================

id:                     E056
trigger_tool:           python|testing
phase:                  testing
error_signature:        IndentationError.*unexpected indent|skipIf.*reason.*wrap|
                         @unittest.skipIf.*multiline.*IndentationError

severity:               1
category:               python|testing|patch-quality
match_keywords:         IndentationError, skipIf, reason wrap, multiline decorator,
                         unittest, py_compile, patch quality, test file

root_cause:             编辑器/补丁工具将多行 reason 的后续行放到装饰器声明之前,
                         导致 Python 解析器将后续行的 def 识别为缩进错误。
                         每次修改测试文件后必须 py_compile 验证
affected_scope:         Python 测试文件中使用多行 @unittest.skipIf reason 的模块
verification_cmd:       python3 -m py_compile test_os.py  # 应无输出(成功)

rec_priority:           1
rec_approach:           source-patch
rec_description:        将多行 reason 改为单行或用括号包裹保持在一行内;
                         修改后必须 py_compile 验证语法正确性
rec_command:            python3 -m py_compile <modified_test_file>
rec_auto_fix:          true
rec_impl:               patch

forbid_1_pattern:      在 Python 补丁中生成跨多行的 @unittest.skipIf reason 且不验证 py_compile
forbid_1_reason:       多行 reason 的后续行可能被放到装饰器前导致 IndentationError
forbid_1_consequence:  整个测试模块无法加载, 全部测试 skipped
fallback_priority:      2
fallback_approach:      manual-workaround
fallback_description:   如果自动补丁不适用，手动在源码中做最小兼容修改并记录到 PROGRESS.md
fallback_command:      # 手动编辑源码后记录:
# 1. 修改文件列表
# 2. 修改原因
# 3. 验证方式
fallback_auto_fix:     false
fallback_impl:          manual
principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E056.md
last_updated:           2026-04-10
source_event:           archives/p/python/3.9.0/manifest.yaml
