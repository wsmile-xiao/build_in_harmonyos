#====================================================================
# E081: OHOS 平台 clang/lld 动态链接器路径问题
# 对应的人类文档: doc/E081.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: E120
trigger_tool:           ld|clang|cmake|make
phase:                  linking
error_signature:        error while loading shared libraries: libxml2\.so\.16|cannot open shared object file: libxml2\.so\.16|lld: error:.*libxml2

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               environment|linking|ohos-sdk
match_keywords:         libxml2.so.16, lld, shared libraries, LD_LIBRARY_PATH, OHOS SDK

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS SDK 的 lld 动态链接到 libxml2.so.16，但系统库路径未包含该路径
affected_scope:         使用 OHOS SDK 26.0.0+ 的所有编译，尤其是链接阶段
verification_cmd:       ldd /data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/bin/lld | grep libxml2

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           env-library-path
rec_description:        设置 LD_LIBRARY_PATH 包含 OHOS SDK 的 lib 目录
rec_command:            export LD_LIBRARY_PATH=/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib:$LD_LIBRARY_PATH
rec_auto_fix:           true
rec_impl:               set-env

fallback_priority:      2
fallback_approach:      static-link
fallback_description:   使用静态链接的 lld 版本（如果可用）
fallback_command:        
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       LD_LIBRARY_PATH=.*libxml2
forbid_1_reason:         不应直接指向 libxml2 库目录，应指向 OHOS SDK 的 lib 目录
forbid_1_consequence:   可能导致其他库加载问题

# ═══ Layer 4: 原则引用 ═══
principles:              

# ═══ 关系图 (Relations) ═══
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

# ═══ 元数据 ═══
doc_file:               doc/E120.md
last_updated: 2026-05-29
source_event:           raylib 6.0 编译失败 - 链接阶段 lld 找不到 libxml2.so.16


