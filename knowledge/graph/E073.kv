# Layer 0: 错误面
id:                     E073
title: 动态库符号链接运行时无法加载
trigger_tool:           ld|runtime
phase:                  runtime
error_signature:        error while loading shared libraries.*lib.*\.so|cannot open shared object file.*No such file

# Layer 1: 识别层
severity:               3
category:               filesystem|hmdfs|runtime-linking
match_keywords:         shared library, .so, symbolic link, symlink, cannot load, exists but not loadable, runtime, dlopen, cp replace, static link

# Layer 2: 诊断层
root_cause:             鸿蒙 HMDFS 文件系统对 .so 符号链接的运行时加载支持不完整。
                        ln -s 创建可能成功（区别于 E018 的创建阶段 Permission denied），
                        但进程 dlopen 该符号链接时无法解析到实际库文件。
affected_scope:          所有安装共享库并通过动态链接运行的软件
verification_cmd:       |
  ls -la /path/to/libxxx.so              # 确认存在且是符号链接 -> lrwxrwxrwx
  file /path/to/libxxx.so                # 确认是 symbolic link
  LD_LIBRARY_PATH=/path/to ldd /path/to/binary  # 仍报找不到

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           configure-static-only
rec_description:        编译时只生成静态库（.a），彻底避免 .so 符号链接的运行时加载问题。
rec_command:            ./configure --enable-static --disable-shared LDFLAGS=-static
rec_auto_fix:          true
rec_impl:               configure-disable-feature

fallback_priority:      2
fallback_approach:       copy-replace-symlink
fallback_description:   安装后用 cp -p 将 .so 符号链接替换为实体文件副本，
                        使 dlopen 直接加载实体文件而非跟随符号链接。
fallback_command:      |
  # 安装后批量处理：将所有 .so 符号链接替换为实体文件
  find $HOME/usr/local/lib -type l -name "*.so*" | while read link; do
    target=$(readlink "$link")
    if [ -f "$target" ]; then
      cp -p "$target" "${link}.tmp" && mv "${link}.tmp" "$link"
    fi
  done
fallback_auto_fix:     true
fallback_impl:          post-install-script

forbid_1_pattern:      仅设置 LD_LIBRARY_PATH 或 RPATH 尝试解决
forbid_1_reason:        问题不在搜索路径而在符号链接本身不可被 dlopen 解析
forbid_1_consequence:   浪费时间排查路径问题，实际文件就在眼前但就是加载不了

# Layer 4: 原则引用
principles:             P-LINKAGE-001

# 关系图
causes:                 [E019]
caused_by:              [E018]
similar_to:             [E018,E019,E050]
conflicts_with:         []
prerequisite_of:        []

# 元数据
doc_file:               doc/E073.md
last_updated:           2026-04-10
source_event:           troubleshooting.md §5.5 + file 5.45/htop 3.4.1 实际案例
