#====================================================================
# E049.kv — 脚本 shebang 硬编码绝对路径导致不可移植
#====================================================================

id:                     E049
trigger_tool:           perl|automake|shell|install
phase:                  installation|runtime
error_signature:        shebang.*hardcoded.*path|interpreter.*not found.*shebang|
                         #!.*/data/service/|#!.*/usr/local/

severity:               2
category:               portability|shell|build-system
match_keywords:         shebang, hardcoded path, interpreter, perl, python,
                         automake, gen-all.pl, portable, #!/data/, #!/usr/local/

root_cause:             构建脚本(如 automake 的 gen-all.pl)在生成输出脚本时,
                         将解释器路径硬编码到 shebang 中。
                         生成的 bin/automake、bin/aclocal 等第一行变成硬编码路径, 换机即失效
affected_scope:         automake 生成的脚本(aclocal/automake等)、所有构建系统生成的脚本
verification_cmd:       head -1 $PREFIX/bin/* | grep -E '^#!.*/(data|usr/local)/'

rec_priority:           1
rec_approach:           shebang-portable-fix
rec_description:        两步修复:
                         1) 已有硬编码 shebang → 改为 #!/bin/env xxx (可移植格式)
                         2) 新生成脚本 → 确保 gen-all.pl 等生成器输出 #!/bin/env 格式
rec_command:            sed -i 's|^#!.*perl.*$|#!/usr/bin/env perl|' bin/automake bin/aclocal
rec_auto_fix:          true
rec_impl:               batch-sed

forbid_1_pattern:      构建系统生成脚本时将解释器绝对路径硬编码写入 shebang
forbid_1_reason:       硬编码路径绑定特定构建环境, 换机/换路径后全部脚本不可执行
forbid_1_consequence:  所有生成脚本 bad interpreter 错误, 包不可用
fallback_priority:      2
fallback_approach:      consult-knowledge
fallback_description:   推荐方案不适用时，查阅 knowledge/error-patterns.md 中相似条目的替代方案
fallback_command:      grep -r "关键词" knowledge/graph/index.tsv
fallback_auto_fix:     false
fallback_impl:          none
principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E049.md
last_updated:           2026-04-10
source_event:           archives/s/automake/1.16.5/manifest.yaml

