#====================================================================
# E051.kv — 未实现 syscall 触发 SIGSYS 导致进程崩溃
#====================================================================

id:                     E051
title: 未实现 syscall 触发 SIGSYS 导致进程崩溃
trigger_tool:           runtime|cc|python
phase:                  runtime
error_signature:        exit code 159|SIGSYS|killed.*signal 31|
                         setreuid.*killed|setregid.*SIGSYS|unimplemented syscall

severity:               3
category:               kernel|syscall|compat|security
match_keywords:         SIGSYS, signal 31, exit 159, setreuid, setregid,
                         chroot, clock_settime, unimplemented syscall, core dump,
                         sigaction, ENOSYS, __OHOS__

root_cause:             鸿蒙内核对未实现的 syscall 发送 SIGSYS 信号(signal 31),
                         但其行为与 Linux seccomp SIGSYS 完全不同:
                         部分 syscall(setreuid/setregid)的 SIGSYS 不可捕获,
                         进程直接被终止, 信号处理方案完全不可行
affected_scope:         所有调用未实现 syscall 的 C/C++/Python 程序
verification_cmd:       python3 -c "import os; os.setreuid(0,0)"; echo "exit=$?"
                         # 预期: exit=159 (128+31=SIGSYS)

rec_priority:           1
rec_approach:           source-patch
rec_description:        在 C 源码中用 #ifdef __OHOS__ 守卫,
                         在 syscall 调用前直接返回 errno=ENOSYS 并 return -1,
                         完全跳过未实现的 syscall 调用
rec_command:
rec_auto_fix:          false
rec_impl:               patch

forbid_1_pattern:      在鸿蒙平台上尝试用 signal(SIGSYS, handler) 或 sigaction 捕获未实现 syscall 的 SIGSYS
forbid_1_reason:       setreuid/setregid 的 SIGSYS 不触发任何 signal handler(包括 C 层 sigaction), 进程直接终止
forbid_1_consequence:  signal handler 从不被调用, 进程仍被 kill, 方案完全无效
fallback_priority:      2
fallback_approach:      manual-workaround
fallback_description:   如果自动补丁不适用，手动在源码中做最小兼容修改并记录到 PROGRESS.md
fallback_command:      # 手动编辑源码后记录:
# 1. 修改文件列表
# 2. 修改原因
# 3. 验证方式
fallback_auto_fix:     false
fallback_impl:          manual
principles:             P-PATCH-001

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E051.md
last_updated:           2026-04-10
source_event:           archives/p/python/3.9.0/manifest.yaml
