#====================================================================
# E037.kv — shebang 兼容性 (/usr/bin/env 缺失 + 可移植性)
#====================================================================

id:                     E037
trigger_tool:           shell|runtime|install
phase:                  installation|runtime
error_signature:        /usr/bin/env.*bad interpreter.*No such file|
                         /usr/bin/env.*No such file or directory|shebang.*env.*fail

severity:               2
category:               filesystem|compat|shell|portability
match_keywords:         /usr/bin/env, shebang, bad interpreter, No such file,
                         env not found, shell script, #!/usr/bin/env, portable

root_cause:             鸿蒙系统没有 /usr/bin/env, 使用 #!/usr/bin/env xxx shebang 的脚本无法执行。
                         同时, 硬编码解释器绝对路径(如 #!/data/service/hnp/bin/perl) 导致不可移植。
affected_scope:         所有使用不兼容 shebang 的脚本 (libtool、automake 生成的脚本等)
verification_cmd:       ls /usr/bin/env  # 文件不存在

rec_priority:           1
rec_approach:           shebang-fix
rec_description:        分两步处理:
                         1) 先检查目标系统是否存在 /usr/bin/env, 若存在则用 #!/bin/env xxx (可移植优先)
                         2) 若不存在(如鸿蒙), 则降级为直接 shebang: #!/bin/sh, #!/bin/bash, #!/usr/bin/perl 等
                         对于已安装的包, 批量 sed 替换修复
rec_command:            # 检测并批量修复
                         if [ ! -e /usr/bin/env ]; then
                           find $PREFIX -type f -exec sed -i 's|#!/usr/bin/env \([^ ]*\)|#!/\1|g' {} +
                         fi
rec_auto_fix:          true
rec_impl:               batch-sed

fallback_priority:      2
fallback_approach:      install-env-symlink
fallback_description:   创建 /usr/bin/env 软链接指向 /bin/sh (需 root 权限)
fallback_auto_fix:     false

forbid_1_pattern:      构建生成的脚本中使用硬编码平台特定路径作为 shebang
forbid_1_reason:       如 #!/data/service/hnp/bin/perl, 换机后路径不同导致全部失效
forbid_1_consequence:  所有生成脚本无法执行: bad interpreter: No such file or directory
forbid_2_pattern:      在已知无 /usr/bin/env 的目标平台上新写脚本用 #!/usr/bin/env xxx
forbid_2_reason:       该 shebang 格式在目标平台不可执行
forbid_2_consequence:  脚本执行失败: bad interpreter
principles:

causes:                 []
caused_by:              []
similar_to:             [E043,E049]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E037.md
last_updated:           2026-04-10
resolved_in:            HongMeng Kernel 1.12.0
resolved_note:          /usr/bin/env 现已存在（指向 toybox 的符号链接），shebang 兼容性问题已解决
source_event:           archives/s/libtool/2.4.7/manifest.yaml; archives/s/automake/1.16.5/manifest.yaml
