#====================================================================
# E006.kv — OpenSSL BAD_SIGNATURE
#====================================================================

id:                     E006
trigger_tool:           openssl|python|curl|wget
phase:                  runtime
error_signature:        SSL.*BAD_SIGNATURE.*bad signature|
                         RSA_verify_PKCS1_PSS_mgf1.*last octet invalid|
                         tls_process_cert_verify.*bad signature

severity:               3
category:               ssl|asm
match_keywords:         OpenSSL, BAD_SIGNATURE, RSA_verify, PSS,
                         no-asm, ARM64, assembly, ssl.SSLError,
                         cert_verify, last octet invalid

root_cause:             OpenSSL 的 ARM64 汇编优化代码在 RSA-PSS
                         签名验证时存在 bug，导致签名校验失败，
                         影响 pip/https 下载等所有 TLS 连接
affected_scope:         所有依赖 OpenSSL TLS 的操作(pip install, wget https)
verification_cmd:       openssl s_client -connect pypi.org:443 </dev/null;
                         openssl version -f | grep ASM

rec_priority:           1
rec_approach:           reconfigure-no-asm
rec_description:        使用 no-asm 重新编译 OpenSSL，禁用汇编优化
rec_command:            ./Configure --prefix=$HOME/usr/local --openssldir=$HOME/usr/local/ssl no-asm && make clean && make && make install
rec_auto_fix:          false
rec_impl:               none

forbid_1_pattern:      Configure.*(?!no-asm).*(OPENSSL_BN_ASM_MONT|SHA1_ASM|BN_ASM)
forbid_1_reason:        启用汇编优化的 OpenSSL 在 aarch64 上有 RSA-PSS bug,
                         导致所有 TLS 连接签名验证失败
forbid_1_consequence:   pip install 失败、https 下载失败、SSL 握手异常
fallback_priority:      2
fallback_approach:      manual-workaround
fallback_description:   如果自动补丁不适用，手动在源码中做最小兼容修改并记录到 notes.md
fallback_command:      # 手动编辑源码后记录:
# 1. 修改文件列表
# 2. 修改原因
# 3. 验证方式
fallback_auto_fix:     false
fallback_impl:          manual

principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E006.md
last_updated:           2026-04-09
source_event:           archives/o/openssl/*/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
