#====================================================================
# E044.kv — 可移植包缺少 PYTHONHOME 导致标准库找不到
#====================================================================

id:                     E044
trigger_tool:           python|runtime
phase:                  runtime
error_signature:        Fatal Python error.*init_sys_streams|ModuleNotFoundError.*encodings|
                         No module named.*encodings|PYTHONHOME

severity:               3
category:               portability, python, runtime
match_keywords:         PYTHONHOME, encodings, standard library, sys.prefix,
                         portable package, Fatal Python error, init_sys_streams

root_cause:             Python 使用 PYTHONHOME 环境变量定位标准库目录(lib/python3.x/)。
                         如果不设置, Python 使用编译时硬编码路径, 可移植包解压到其他位置时找不到标准库
affected_scope:         Python 可移植包运行
verification_cmd:       python3 -c "import sys; print(sys.prefix, sys.exec_prefix)"
                         # 如果输出编译路径而非包解析路径则需设置 PYTHONHOME

rec_priority:           1
rec_approach:           env-var-activate
rec_description:        在 activate.sh 中必须设置 export PYTHONHOME="$PYTHON_DIR"
rec_command:            PYTHON_DIR="$(cd "$(dirname "$0")" && pwd)"
                         export PYTHONHOME="$PYTHON_DIR"
                         export PATH="$PYTHON_DIR/bin:$PATH"
                         export LD_LIBRARY_PATH="$PYTHON_DIR/lib:$PYTHON_DIR/lib/external${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
rec_auto_fix:          true
rec_impl:               set-env-var

forbid_1_pattern:      Python 可移植包的 activate.sh 中缺少 PYTHONHOME 设置
forbid_1_reason:       不设 PYTHONHOME 则 Python 回退到编译时硬编码路径, 换位置即崩
forbid_1_consequence:  Fatal Python error: init_sysstreams / ModuleNotFoundError: No module named 'encodings'
fallback_priority:      2
fallback_approach:      shell-profile
fallback_description:   如果临时设置不生效，将环境变量写入 ~/.profile 或项目 .env 文件持久化
fallback_command:      echo 'export VAR=value' >> ~/.profile && source ~/.profile
fallback_auto_fix:     true
fallback_impl:          set-env-var
principles:

causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E044.md
last_updated:           2026-04-10
source_event:           archives/s/python/3.9.0/manifest.yaml

