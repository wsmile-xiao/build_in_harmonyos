#====================================================================
# E004.kv — 符号找不到（musl BIND_NOW）
#====================================================================

id:                     E004
title: 符号找不到（musl BIND_NOW）
trigger_tool:           python|ld|runtime
phase:                  linking|runtime
error_signature:        ImportError.*symbol not found|
                         undefined symbol.*ImportError|
                         symbol not found:.*_Py|
                         cannot open shared object.*

severity:               3
category:               runtime-linking
match_keywords:         symbol not found, ImportError, undefined symbol,
                         BIND_NOW, musl, dlopen, dlsym, NEEDED,
                         shared library, LD_LIBRARY_PATH, libpython

root_cause:             musl 默认启用 BIND_NOW 标志,
                         dlopen() 加载 .so 时要求所有符号在加载时即可解析,
                         扩展模块(.so)的 NEEDED 只有 libc.so(无 libpython),
                         导致 Python API 符号无法解析 → ImportError
affected_scope:         Python/Perl/Ruby 等带 C 扩展模块的解释型语言,
                         特别是 Python 的 lib-dynload/*.so
verification_cmd:       llvm-readelf -d module.so | grep -E "NEEDED|BIND"

rec_priority:           1
rec_approach:           modify-ldshared
rec_description:        修改 LDSHARED 添加主库链接(-L. -lpython),
                         让扩展模块在链接时记录对 libpython 的依赖
rec_command:
rec_auto_fix:          false
rec_impl:               none

forbid_1_pattern:      LDSHARED.*-lpython.*BLDSHARED
forbid_1_reason:        BLDSHARED(构建 libpython.so 本身)不能包含 -lpython,
                         否则产生循环依赖导致链接失败
forbid_1_consequence:   链接阶段报错: could not read symbols: Illegal seek
fallback_priority:      2
fallback_approach:      consult-knowledge
fallback_description:   推荐方案不适用时，查阅 knowledge/error-patterns.md 中相似条目的替代方案
fallback_command:      grep -r "关键词" knowledge/graph/index.tsv
fallback_auto_fix:     false
fallback_impl:          none

principles:             P-RUNTIME-002

causes:                 []
caused_by:              []
similar_to:             [E003, E013, E019, E042]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E004.md
last_updated:           2026-04-09
source_event:           archives/p/python/3.9.0/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

