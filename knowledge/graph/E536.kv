#====================================================================
# firmware-resource-package — Broadcom (brcm) 固件资源包验证方法
# 关联库: linux-firmware-brcm 20260622
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E536
trigger_tool:           conan-create|conan-verify|finish
phase:                  packaging|verification
error_signature:        brcm.*firmware|firmware.*blob|binary.*resource|firmware.*resource.*package|no.*compile|resource.*only.*package

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               1
category:               firmware-resource-package
match_keywords:         firmware, brcm, broadcom, linux-firmware-brcm, resource package, binary blob, firmware blob, no compile, data-only, resource-only
title:                  Broadcom (brcm) 固件资源包验证方法 — 适用于纯二进制固件资源包

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             linux-firmware 项目包含各厂商的二进制固件 blob，brcm 子目录为 Broadcom 无线网卡固件。
                        此类资源不含 C/C++ 编译产物、无构建系统、无传统测试框架。Conan 适配为纯资源包模式。
affected_scope:         所有基于 linux-firmware 的厂商固件资源包子包（brcm, iwlwifi, ath10k, rtlwifi 等）
verification_cmd:       # 验证是否为纯固件资源包:
                        # 检查文件类型是否全为二进制 blob:
                        file brcm/*.bin brcm/*.fw brcm/*.hcd 2>/dev/null | grep -c "data\|MS Windows" 
                        # 确认无 ELF / 可执行文件:
                        find brcm/ -type f -exec file {} \; | grep -iE "ELF|executable" | wc -l

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           firmware-resource-package-validation
rec_description:        Broadcom 固件资源包的完整验证流程，包括：固定 URL/版本/sha256、许可证验证、
                        文件清单/类型/非空/hash 校验、目录结构验证、无 ELF 检查、资源安装路径验证、
                        package_info 约束、无 Conan 第三方依赖、无硬件功能验证。
rec_command:            # conanfile.py 关键模式:
                        #   package_type = "unknown"（无编译产物）
                        #   def build(): pass  # 无编译
                        #   def package(): copy(self, "*", src=..., dst="res/brcm")
                        #   def package_info(): self.cpp_info.resdirs = ["res"]  # 资源包声明
                        # test_package 验证：
                        #   conanfile.py 中 test() 调用 shell 脚本验证文件和路径
rec_auto_fix:           false
rec_impl:               firmware-resource-package-conan-recipe

# 回退方案
fallback_priority:      2
fallback_approach:      upstream-verify-and-download
fallback_description:   直接从官方 CDN 下载并 sha256 验证，提取厂商子目录作为独立资源包
fallback_command:       # 从官方 CDN 获取 tar.xz（recipe conandata 实际使用）:
                        curl -sSL -o linux-firmware-${VER}.tar.xz \
                          "https://cdn.kernel.org/pub/linux/kernel/firmware/linux-firmware-${VER}.tar.xz"
                        # 验证 sha256:
                        echo "${SHA256}  linux-firmware-${VER}.tar.xz" | sha256sum -c
                        # 提取 brcm 子目录（strip-root=1 与 recipe source() strip_root=True 一致）:
                        tar xJf linux-firmware-${VER}.tar.xz --strip-components=1 linux-firmware-${VER}/brcm
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       requires.*=.*["']firmware-tools["']|tool_requires.*=.*firmware
forbid_1_reason:        固件资源包不需要任何编译工具或 firmware-tools 依赖
forbid_1_consequence:   引入不必要依赖导致 CI 失败

forbid_2_pattern:       cpp_info\.libs\s*=|cpp_info\.bindirs\s*=
forbid_2_reason:        固件资源包不提供库文件和二进制目录
forbid_2_consequence:   下游编译会错误链接到固件数据，导致链接失败

