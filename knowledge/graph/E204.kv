# Layer 0: 构建模式
id: E204
title:                  libvpx 自定义 configure 脚本
trigger_tool:           configure
phase:                  configuration
error_signature:        build/make/configure.sh.*No such file|Unknown target

# Layer 1: 识别层
severity:               2
category:               build-system
match_keywords:         libvpx, configure.sh, target, arm64-linux-gcc, custom configure

# Layer 2: 诊断层
root_cause:             libvpx 使用自定义 configure 脚本（非标准 autotools），需要指定 --target 参数。
                        GitHub tarball 可能缺少 build/make/ 目录。
affected_scope:         libvpx 所有版本
verification_cmd:       head -20 configure | grep "build/make/configure.sh"

# Layer 3: 方案层 ★
rec_priority:           1
rec_approach:           fix-tarball-and-specify-target
rec_description:        
  1. 检查 build/make/ 目录是否存在，缺失则从 orig 复制
  2. 使用 --target=arm64-linux-gcc 参数（不是 --host/--build）
rec_command:            |
  # Step 1: 修复缺失目录
  if [ ! -d "build/make" ]; then
    cp -r "$BUILD_SRC_ORIG_DIR/build" ./
  fi
  
  # Step 2: configure
  ./configure --prefix=$DEFAULT_PREFIX --target=arm64-linux-gcc
rec_auto_fix:           false
rec_impl:               manual-fix

# 注意事项
notes:                  |
  - libvpx configure 不是标准 autotools，不接受 --host/--build 参数
  - --target 必须精确指定（如 arm64-linux-gcc），不能使用三元组
  - 支持的 target 列表见 configure --help 输出

# Layer 4: 原则引用
principles:             P-AUTOTOOLS-002

# 元数据
doc_file:               doc/B015.md
last_updated:           2026-05-29
source_event:           libvpx 1.14.1 编译