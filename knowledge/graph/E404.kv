#====================================================================
# E999.kv — OHOS zsh missing autoload functions (is-at-least, compinit)
# 对应的人类文档: doc/E999.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E404
trigger_tool:           zsh|runtime
phase:                  runtime
error_signature:        is-at-least:.*function definition file not found|compinit:.*function definition file not found|zsh:.*function definition file not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, compat, shell
match_keywords:         zsh,autoload,is-at-least,compinit,function definition file not found,fpath,OHOS
title:                  OHOS zsh 5.9 missing standard autoload functions (is-at-least, compinit)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:              OHOS zsh 5.9 (aarch64-unknown-linux-musl) is installed without the standard autoload function files directory. Functions like is-at-least and compinit are part of zsh's standard distribution but the function files are not installed in the fpath on OHOS, causing any zsh script using autoload -Uz to fail.
affected_scope:          All zsh scripts on OHOS that use autoload -Uz is-at-least or compinit, including install.sh scripts and CLI tools like arttime
verification_cmd:        zsh -c 'autoload -Uz is-at-least && is-at-least 5.7' 2>&1 | grep "function definition file not found"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:            1
rec_approach:            create-missing-zsh-function
rec_description:         Create the missing is-at-least autoload function file in a directory on the zsh fpath (e.g., ~/.local/share/zsh/site-functions/). The function is a simple version comparison that can be recreated from the zsh source.
rec_command:             mkdir -p ~/.local/share/zsh/site-functions && cat > ~/.local/share/zsh/site-functions/is-at-least << 'EOF'\nemulate -L zsh\nlocal i\nif [[ "$1" == *.* ]]; then\n  local IFS=.\n  local -a v1 v2\n  v1=(${=1})\n  v2=(${=ZSH_VERSION})\n  for ((i = 1; i <= ${#v1}; i++)); do\n    if (( ${v2[i]:-0} > ${v1[i]:-0} )); then return 0; elif (( ${v2[i]:-0} < ${v1[i]:-0} )); then return 1; fi\n  done\n  return 0\nelse\n  [[ ${ZSH_VERSION} -ge $1 ]]\nfi\nEOF
rec_auto_fix:            false
rec_impl:                manual

# 回退方案
fallback_priority:       2
fallback_approach:       bypass-install-script
fallback_description:   For Conan recipes packaging shell scripts, avoid running install.sh directly and instead use conan.tools.files.copy() to replicate the install logic, bypassing zsh function dependencies.
fallback_command:        N/A (modify conanfile.py package() to use copy())
fallback_auto_fix:       false
fallback_impl:           manual

# ★ 禁止策略 ★
forbid_1_pattern:        rm -rf.*fpath|rm -rf.*site-functions
forbid_1_reason:         Never delete the entire fpath directory to "fix" missing functions — this breaks other zsh functionality
forbid_1_consequence:    Other zsh autoload functions will stop working

# ═══ Layer 4: 原则引用 ═══

# ═══ 关系图 (Relations) ═══
causes:                  []
caused_by:               []
similar_to:              []
conflicts_with:          []
prerequisite_of:         []

