#====================================================================
# E018.kv — 软链接创建失败
#====================================================================

id:                     E018
trigger_tool:           ln|make|install|configure
phase:                  installation|configuration
error_signature:        ln.*cannot create symbolic link.*Permission denied|
                         ln.*sf.*garbled|No such file or directory.*symlink|
                         symlink.*Permission denied

severity:               2
category:               selinux, filesystem
match_keywords:         ln, symlink, Permission denied, wrapper script,
                         soft link, SELinux, ln -sf, garbled,
                         readlink, exec, copy instead of link

root_cause:             鸿蒙 SELinux 策略限制用户进程在特定目录
                         创建和访问软链接, ln -sf 可能创建异常文件,
                         已有软链接可能无法被进程正确解析
affected_scope:         make install 阶段、configure 创建工具链软链接、
                         任何需要 ln -s 的构建步骤
verification_cmd:       ls -la /path/to/link; readlink /path/to/link; /path/to/link --version

rec_priority:           1
rec_approach:           wrapper-script
rec_description:        用 shell wrapper 脚本替代软链接:
                         #!/bin/sh; exec /real/path "$@"
rec_command:            cat > link << 'EOF'; chmod +x link
rec_auto_fix:          true
rec_impl:               wrapper-script

fallback_priority:      2
fallback_approach:      copy-instead-of-link
fallback_description:  用 cp 复制真实文件替代软链接
fallback_command:      cp $(readlink -f target) destination
fallback_auto_fix:     true
fallback_impl:          shell-cmd

forbid_1_pattern:
principles:              P016, P020
causes:               
caused_by:               
similar_to:               
conflicts_with:               
prerequisite_of:        

doc_file:               doc/E018.md
last_updated:           2026-04-09
source_event:           多个构建事件

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 0
metrics_fail_count: 0
metrics_confidence: 0.0
metrics_last_used:
