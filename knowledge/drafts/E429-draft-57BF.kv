#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: lit|pytest|python|test
phase: testing
error_signature: fatal: Setting a timeout per test not supported.*psutil|'riscemu': command not found|'riscemu' is not recognized|FileNotFoundError.*riscemu_history|No such file or directory.*\.riscemu_history|EXPECTED: \[CPU\] Program exited with code

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: python, test_package, conan, detection, portability
match_keywords: lit, ShTest, TestingConfig, pass_vars 白名单, HOME 不转发, PYTHONPATH 不转发, --timeout=5, psutil, readline history, riscemu debug.py, lit.local.cfg, 平台 shim, xdsl_src, filecheck 套件假失败
title: lit 为每个用例重建最小环境（只保留 PATH + pass_vars 白名单），HOME 与 PYTHONPATH 都不转发：上游 lit 用例会假失败（调试器写 history 抛 FileNotFoundError、python3 -m <pkg> 解析不到被测包），--timeout 还需要 psutil；用 lit.local.cfg 平台 shim 显式补回，不改上游测试文件

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: lit 的 TestingConfig.fromdefaults() 从零构造 environment（只有 PATH + LLVM_DISABLE_CRASH_REPORT + pass_vars 固定白名单），不继承调用者环境；riscemu 的 fibs.asm 用例走到 ebreak 时 debug.py 会 write_history_file(expanduser('~/.riscemu_history'))，HOME 缺失导致 expanduser 失败抛 FileNotFoundError 中断，CHECK 行永不出现（同一条命令手工带 HOME 跑必过）；同因 PYTHONPATH 也被丢弃，lit RUN 行里的 python3 -m riscemu 会解析到环境里别的 riscemu 或直接 ModuleNotFoundError，使被测对象不是本次 conan 包
affected_scope: 所有把上游 lit/llvm-lit（ShTest）套件接进 test_package 的适配；凡上游用例 RUN 行依赖 HOME、PYTHONPATH、PATH 之外环境变量（或依赖 cwd 恰好是源码树的相对导入）都会同型假失败；lit --timeout 在缺 psutil 时直接 fatal
verification_cmd: lit --timeout=5 -v test_package/filecheck  # 未加 shim: Passed: 10 Failed: 1（fibs.asm）；加上转发 HOME/PYTHONPATH 的 lit.local.cfg: Passed: 11；python3 -c 'import psutil' 缺则 lit 报 fatal: Setting a timeout per test not supported

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: lit-local-cfg-platform-shim
rec_description: 在 test_package 的 lit 测试目录放一个最小的 lit.local.cfg 平台 shim：把 HOME（无则 tempfile.mkdtemp 兜底）与 PYTHONPATH 显式写回 config.environment；test_package/conanfile.py 的 test() 里再确保 psutil（lit --timeout 依赖，上游 dev 依赖同版本区间）已安装，并用 PATH 检查 filecheck CLI；上游测试文件逐字节不改
rec_command: config.environment['HOME']=_home; config.environment['PYTHONPATH']=os.environ['PYTHONPATH']  # lit.local.cfg；pip install 'psutil>=5.9,<6' 'lit>=16,<17' 'filecheck==0.0.23'
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 修改上游 .asm/.s 用例去掉 CHECK 行|sed -i .*filecheck
forbid_1_reason: 为让 lit 通过而改上游测试断言，等于丢掉上游行为基线（R34/R51）；问题在 lit 环境而不在断言
forbid_1_consequence: 上游真实回归无法发现，且测试副本与上游不再逐字节一致，无法用 sha256 复核
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

