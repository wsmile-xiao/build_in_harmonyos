#====================================================================
# DRAFT 定稿版 v2（Curator 重判轮修订；回应 Auditor F4）
# slug: ac-path-prog-caches-broken-device-global-tool
#
# ★ 状态：B-2 CONFIRMED（Auditor 独立核验；本轮按 F4 低 materiality 修订
#   查重节与探针，修复范式结论不变且与候选
#   archives/l/libido3/13.10.0/conanfile.py:288-306 一致——已逐行复核）
#
# 申报域：构建系统｜机理层：L1（autotools 工具探测/缓存语义 × 设备全局
#   工具目录遮蔽 × shebang 硬编码解释器）
#====================================================================

# --- Layer 0: 错误面 ---
id:                     DRAFT-ac-path-prog-caches-broken-device-global-tool
trigger_tool:           autotools|configure|make|AC_PATH_PROG
phase:                  configuration|build
error_signature:        bad interpreter: No such file or directory|
                        No such file or directory.*glib-mkenums|
                        make.*Error 126|checking for .*-mkenums.* /data/service/hnp/bin/

# --- Layer 1: 识别层 ---
severity:           2
category:           build-system, toolchain, autotools
match_keywords:     AC_PATH_PROG, glib-mkenums, gdbus-codegen,
                    glib-compile-resources, glib-genmarshal, GLIB_MKENUMS, hnp,
                    /data/service/hnp/bin, perl, shebang, exit 126, ENOENT
title:              AC_PATH_PROG 缓存设备全局目录的坏 glib-mkenums（shebang 硬编码 /usr/bin/perl → exec ENOENT → make Error 126）：钉 GLIB_MKENUMS 环境变量是根治点

# --- Layer 2: 诊断层 ---
root_cause:         完整因果链（重判轮按探针实测精化）：
                    (1) 设备全局目录 /data/service/hnp/bin（hnp 包管理安装面）
                    在 PATH 前部，内含 glib-mkenums 等脚本工具。
                    (2) 该包装脚本 shebang 硬编码 "#! /usr/bin/perl"，而 OHOS
                    设备的解释器实际在 /data/service/hnp/bin/perl——
                    /usr/bin/perl 路径不存在（注意：设备并非无 perl，失效点
                    是 shebang 硬编码路径；exec 对缺失解释器报 ENOENT，
                    "No such file or directory" 指解释器而非脚本本身）。
                    (3) configure 的 AC_PATH_PROG 在该目录先命中并缓存：
                    "checking for glib-mkenums... /data/service/hnp/bin/glib-mkenums"
                    （configure 探测行实测）。
                    (4) make 期枚举生成规则执行缓存路径 →
                    "/data/service/hnp/bin/bash: /data/service/hnp/bin/glib-mkenums:
                    /usr/bin/perl: bad interpreter: No such file or directory"
                    → "Error 126" → 全构建失败。
                    (5) 事后把依赖包 bin 目录 prepend 到 PATH 无效——缓存已定；
                    AC_PATH_PROG 类宏 honour 预设环境变量才是根治点。
                    归类：构建系统——autotools 工具探测+缓存语义、设备全局
                    工具遮蔽与 shebang 硬编码解释器的三重组合，复发面由平台
                    保证（L1，单库可申报）。
affected_scope:     任何在 OHOS 设备上跑 autotools configure 并以 AC_PATH_PROG
                    探测脚本工具（glib-mkenums/gdbus-codegen/
                    glib-compile-resources/glib-genmarshal 等）的项目；
                    GNOME/glib 家族几乎全覆盖。

# --- 查重修正（Auditor F4：撤销原"graph mkenums 0 命中"的绝对表述）---
# 原检索工具缺陷（设备 grep 不支持 BRE \| 交替）致虚假 0 命中；-E 修正后
# graph 概念级近邻命中 E348/E443/E527，如实列入并区分：
# - E443（E337 draft，task-local Autotools bootstrap closure）：trigger_tool
#   即含 glib-genmarshal|glib-mkenums；其机理面是 HMFS cross-UID 拒绝直接
#   shebang 执行（Permission denied/cannot execute）+ 安装期 prefix 重定位；
#   其 fallback（explicit-interpreter-tool-overrides：工具变量直指"固定解释
#   器+包内脚本"）与本条 rec 属同族手法。本条残差：失效机理不同（shebang
#   硬编码解释器 ENOENT，非 cross-UID 执行拒绝）+ 失效源不同（设备全局 hnp
#   目录经 PATH 遮蔽并被 AC_PATH_PROG 缓存，非 conan 包内脚本执行受阻）。
# - E527（E336 draft，gtk broadway + glib 工具 native 包装）：meson 场景把
#   glib-mkenums/glib-genmarshal 包装为 native wrapper——同为"glib 构建期
#   脚本工具在 OHOS 不可直接执行"族，未覆盖 AC_PATH_PROG 缓存/遮蔽面。
# - E348：pkg-config 工具面（转发 .pc），仅工具处理语境相邻。
# - drafts 近邻：DRAFT-buildtime-tool-dep-blocks-adaptation-scan-ac-path-tool
#   （构建期外部程序硬依赖的开工前扫描，gperf/eudev）——适配扫描面，非
#   运行期工具解析面。
# 本条相对上述条目的独立价值：AC_PATH_PROG 缓存动力学 + 设备全局 hnp 目录
# 遮蔽 + shebang 硬编码解释器三者的具体组合，以及 GLIB_MKENUMS 这一具体
# 预设变量落点（E443 已列 ACLOCAL/AUTOMAKE 等变量但未列 GLIB_MKENUMS，
# 未覆盖"configure 缓存坏工具后 make 期才爆"的时序陷阱）。

verification_cmd: |
  # 设备新 shell 可复跑（全只读）
  p=$(command -v glib-mkenums); echo "resolved=$p"
  # 实测：resolved=/data/service/hnp/bin/glib-mkenums
  if [ -n "$p" ]; then head -1 "$p"; else echo "glib-mkenums not on PATH"; fi
  # 实测输出：#! /usr/bin/perl
  command -v perl || echo no-perl
  # 实测输出：/data/service/hnp/bin/perl   ← 设备有 perl（hnp 路径），
  # 失效点是包装脚本 shebang 硬编码的 /usr/bin/perl 不存在
  glib-mkenums --version 2>&1; echo "rc=$?"
  # 实测输出：sh: /data/service/hnp/bin/glib-mkenums: No such file or directory
  #（CI 实测形态：/usr/bin/perl: bad interpreter: No such file or directory
  #  + make Error 126；不带管道取 rc 以免取到 head 的退出码）
  # 修复方向验证：GLIB_MKENUMS 钉到 conan glib 包内真实脚本后重新
  # configure，config.log 中 'checking for glib-mkenums' 应解析到包内路径

# --- Layer 3: 方案层 ---
rec_priority:       1
rec_approach:       pin-tool-env-var-ac-path-prog
rec_description:    AC_PATH_PROG 类宏 honour 预设环境变量（GLIB_MKENUMS/
                    GDBUS_CODEGEN/GLIB_COMPILE_RESOURCES 等）。配方 generate()
                    内探测依赖包内真实脚本（bin/glib-mkenums）并
                    env.define("GLIB_MKENUMS", 绝对路径)，使 configure 缓存
                    包内脚本；同时把 dep bin 目录加入构建 PATH。与 pkg-config
                    固定名 shim 同属"钉环境变量/shim"家族。（重判轮复核：与
                    候选 conanfile.py:288-306 实现逐行一致，范式不变。）
rec_command:        env.define("GLIB_MKENUMS", <glib 包内 bin/glib-mkenums 绝对路径>)
                    （参考实现 archives/l/libido3/13.10.0/conanfile.py 的
                    _find_glib_mkenums 与 generate() 内对应段；注意：该段注释
                    引用的"E543"编号在 drafts 中已被两个不同草稿主张
                    （E543-draft-GADA.kv 的 id: E543 与
                    DRAFT-libical3-pkgconfig-consumer-chain 的 id: E543-候选），
                    graph 中无 E543——引用悬空且编号归属混乱，定稿时改为
                    "本 run 新发现"或由主编统一编号）
rec_auto_fix:       false
rec_impl:           recipe-env

fallback_priority:  2
fallback_approach:  fixed-name-shim-dir-first-on-path
fallback_description: 为脚本工具建固定名 shim 目录（内容 exec 真实脚本）并
                    prepend 到 PATH（本配方对 pkg-config 已用此法；与 E443
                    rec 的 native launcher 手法同族）。诚实权衡：只管住 PATH
                    解析面，对不查 PATH 的 configure 片段无效；且每工具逐一
                    建 shim，维护面大于环境变量钉法。
fallback_command:   参考 archives/l/libido3/13.10.0/conanfile.py generate() 内
                    hmbs-pkgconf-shim 构造段
fallback_auto_fix:  false
fallback_impl:      recipe-env

forbid_1_pattern:   删除/改写设备全局 /data/service/hnp/bin 下的工具
forbid_1_reason:    污染设备全局状态，不可复现、越权，破坏其他 run 与系统工具
forbid_1_consequence: CI worker 不可复制；同机其他任务出现连带失败
forbid_2_pattern:   只调 PATH 顺序而不钉环境变量
forbid_2_reason:    AC_PATH_PROG 缓存首个命中；hnp 目录先于 conan env prepend
                    生效时仍会命中坏工具
forbid_2_consequence: 修复无效，make 期 Error 126 复现

# --- Layer 4: 原则引用 ---
principles:         P-ENV-001（环境变量与构建系统语义冲突陷阱）

# --- 关系图 ---
similar_to:         E443（工具闭包族，fallback 手法同族——机理面不同：cross-UID
                    执行拒绝 vs shebang 硬编码 ENOENT+遮蔽缓存）,
                    E527（glib 工具 native 包装，meson 场景）,
                    E405（posix_spawn 不搜 PATH——工具解析语义族）,
                    E002（TMPDIR 重定向——环境钉法族）
conflicts_with:
prerequisite_of:
doc_file:           knowledge/drafts/DRAFT-ac-path-prog-caches-broken-device-global-tool.md
source_event:       libido3-13.10.0 适配（CI round 9）
