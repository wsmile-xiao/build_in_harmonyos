#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E605.kv，填写各字段
# 对应的人类文档: doc/E605.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E605
trigger_tool: meson
phase: configuration
error_signature: Function does not take positional arguments|i18n.merge_file\('.*'

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: meson,build-system,portability
match_keywords: meson, i18n.merge_file, positional arguments, meson 1.12, merge_file, output keyword
title: 新版 meson i18n.merge_file 不再接受位置参数 output（报 Function does not take positional arguments）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游元老式 meson.build 用 i18n.merge_file('out.policy', input:, output: ...) 的位置参数形式传入 output；新版 meson（≥1.12）不再接受位置参数，必须用 output: 关键字，否则配置阶段直接报错
affected_scope: 所有使用旧式 i18n.merge_file 位置参数的 glib/meson 系软件适配到新版 meson 工具链时
verification_cmd: meson setup builddir（配置阶段复现ERROR: Function does not take positional arguments）；改为 output: 关键字后配置通过

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: patch meson.build，将 i18n.merge_file('xxx', input:, output:...) 改为 i18n.merge_file(input:, output:...) 纯关键字形式（删除位置参数、保留 input/output 关键字）
rec_description: 位置参数只用于 output 文件名，删掉后 output 关键字仍提供同一值，行为不变；libmalcontent 0.10.2 accounts-service/meson.build 修复先例
rec_command:            sed -i 's/i18n.merge_file(.*\.policy./i18n.merge_file(/ ' accounts-service/meson.build 并删除位置参数行
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

