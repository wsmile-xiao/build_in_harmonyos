#====================================================================
# DRAFT-libvpd-2.2.11-autotools-bootstrap-perl-interpreter-and-prefix-relocation
#   OHPC conan tool_requires（autoconf/automake/libtool/perl 包）的
#   Perl 解释器与数据路径不可重定位，导致 tag 源码 autotools bootstrap
#   失败（strict.pm 缺失 / Perl_my_cxt_init symbol not found / m4sugar.m4
#   找不到）——用系统 perl + 环境变量重定位包装器统一解释器
# 来源: task libvpd-2.2.11-r01-pc7-28 (feat/libvpd-2.2.11)
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-libvpd-2.2.11-autotools-bootstrap-perl-interpreter-and-prefix-relocation
trigger_tool:           aclocal|automake|autoconf|autom4te|autoheader|perl
phase:                  configuration
error_signature:        Can't locate strict\.pm in @INC|
                         Can't locate Automake/Config\.pm in @INC|
                         Perl_my_cxt_init: symbol not found|
                         symbol not found.*auto/Cwd/Cwd\.so|
                         autom4te.*m4sugar/m4sugar\.m4: no such file or directory|
                         cannot create.*conf[a-zA-Z0-9]+/subs1\.awk.*Permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               autotools, toolchain, conan, tool_requires, perl,
                        relocatability, hmfs, bootstrap
match_keywords:         autom4te_perllibdir, AC_MACRODIR, AUTOM4TE_CFG,
                        AUTOM4TE, AUTOCONF, AUTOHEADER, PERL5LIB, shebang,
                        hardcoded path, //share/autoconf, conan perl,
                        system perl, ABI, XS, Cwd.so, strict.pm, automake
                        bootstrap, aclocal, ltmain.sh, config.guess,
                        tag tarball, no generated configure
title:                  OHPC conan tool_requires 的 autoconf/automake/perl 包 Perl 解释器与数据前缀不可重定位：bootstrap 各 perl 助手统一改由系统 perl 执行并钉住 autom4te_perllibdir/AC_MACRODIR/AUTOM4TE_CFG/AUTOM4TE/AUTOCONF/AUTOHEADER
prescan_pattern:        autom4te_perllibdir|AC_MACRODIR|AUTOM4TE|AUTOCONF|
                        PERL5LIB|bootstrap\.sh|bootstrap.*autotools
prescan_globs:          conanfile.py, patches/*.patch, Makefile.am, configure.ac, bootstrap.sh

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             ohpcd 制品仓的 autoconf/automake/perl tool_requires 包
                        打包时把 Perl 解释器绝对路径烘焙进脚本 shebang
                        （automake 包的 .aclocal-real/.automake-real 硬编码
                        系统 perl；autoconf 包的 .autom4te-real/.autoconf-real/
                        .autoheader-real 硬编码 conan perl），并把数据前缀
                        烘焙成损坏的 '//share/autoconf'、'//share/libtool'
                        （autom4te.cfg 的 --prepend-include、autom4te-real 的
                        autom4te_perllibdir/AC_MACRODIR 默认值）。当 conan
                        build 环境把 ohpcd perl/5.42.2 的模块目录前置到
                        PERL5LIB 后：系统 perl（5.42.0）加载 5.42.2 的 XS
                        模块（Cwd.so）报 ABI 符号缺失；conan perl（5.42.2）
                        编译期 @INC 为损坏的 '//lib/perl5' 找不到 strict.pm；
                        autom4te 引 m4sugar 时又因 --prepend-include 指向
                        不存在的 '//share/autoconf' 而失败。一句话：同一
                        bootstrap 进程里出现了两个 ABI 不兼容的 perl 解释器
                        加一套损坏的绝对前缀。
affected_scope:         所有以 tag tarball（无生成 configure）为源码、需在
                        conan recipe build() 内跑 aclocal/automake/autoconf
                        bootstrap 的 autotools 库；OHPC 平台（HMFS + 系统
                        perl 5.42.0 + ohpcd 工具包）。
verification_cmd:       head -1 <conan cache>/bin/.aclocal-real;
                        grep -n "pkgauxdir=" <cache>/bin/libtoolize;
                        grep -n "prepend-include" <cache>/share/autoconf/autom4te.cfg;
                        echo $PERL5LIB

rec_priority:           1
rec_approach:           system-perl-wrapper-env-pins
rec_description:        在 conan build() 里生成包装器目录
                        (build_folder/autotools-bin)：为 autom4te/autoconf/
                        autoheader 各写一个 sh 包装器，用系统 perl
                        (/data/service/hnp/bin/perl) 执行包内的
                        .autom4te-real/.autoconf-real/.autoheader-real，并
                        export autom4te_perllibdir、AC_MACRODIR、
                        AUTOM4TE_CFG（指向把 '//share/autoconf' 替换为真实
                        包路径的 autom4te.cfg 副本）。bootstrap 全部命令前缀
                        PATH=<wrapper>:/data/service/hnp/bin:$PATH
                        AUTOM4TE=<wrapper>/autom4te AUTOCONF=<wrapper>/autoconf
                        AUTOHEADER=<wrapper>/autoheader PERL5LIB=<automake 包
                        share/automake-1.18>。libtool 包 libtoolize 前缀损坏
                        时跳过 libtoolize：直接 cp 其
                        share/libtool/build-aux/ltmain.sh 到 config/，aclocal
                        用 ACLOCAL_PATH 指向其 share/aclocal。
rec_command:            |
  sh = ("PATH={w}:/data/service/hnp/bin:$PATH "
        "AUTOM4TE={w}/autom4te AUTOCONF={w}/autoconf "
        "AUTOHEADER={w}/autoheader PERL5LIB={p}")
  self.run("{e} aclocal".format(e=sh), cwd=self.source_folder)
  self.run("cp {lt}/share/libtool/build-aux/ltmain.sh config/".format(lt=lt),
           cwd=self.source_folder)
  self.run("{e} autoheader".format(e=sh), cwd=self.source_folder)
  self.run("{e} automake --add-missing --copy".format(e=sh), cwd=self.source_folder)
  self.run("{e} autoconf".format(e=sh), cwd=self.source_folder)
rec_auto_fix:          true
rec_notes:             与 E011/E052/E060/E110/E112/E114/E118/E125（HMFS
                        config.status umask077 临时目录）配套：后者还需
                        sed config.status 's/umask 077/umask 002/g' 后重跑。
                        与 E116（Automake::Config @INC）同族但本条目覆盖
                        conan 工具包 bake 前缀/双 perl ABI 的具体机制与
                        完整包装器方案，属新增差异。
applicable_boundary:   OHPC/HMFS 上使用 ohpcd autoconf/automake/libtool/
                        perl tool_requires 做 tag 源码 bootstrap 的场景；
                        标准 Linux 工具链（单 perl、非 HMFS）无此问题。