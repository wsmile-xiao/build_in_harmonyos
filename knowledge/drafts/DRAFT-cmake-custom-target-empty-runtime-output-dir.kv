#====================================================================
# DRAFT-cmake-custom-target-empty-runtime-output-dir
# CMake custom target 引用空全局 CMAKE_RUNTIME_OUTPUT_DIRECTORY → copy 到根目录
# 触发/来源: config-loader 1.0 R01 适配（feat/config-loader-1.0, 2026-09-25）
# Status: DRAFT — 同 stem 配对 knowledge/drafts/DRAFT-cmake-custom-target-empty-runtime-output-dir.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-cmake-custom-target-empty-runtime-output-dir
trigger_tool:           cmake|cmake --build|make
phase:                  configuration|compilation
error_signature:        Error copying directory from .* to /configs|
                        copy_directory.*\{CMAKE_RUNTIME_OUTPUT_DIRECTORY\}|
                        copy.*to /[A-Za-z]*|cannot create directory.*\/(usr|etc|configs|bin)

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               cmake, build-system, portability
match_keywords:         CMAKE_RUNTIME_OUTPUT_DIRECTORY, RUNTIME_OUTPUT_DIRECTORY,
                        custom target, add_custom_target, copy_directory, copy 到根目录,
                        空变量, empty variable, CMake 4, 全局目录变量, CMAKE_BINARY_DIR,
                        目标属性, target property, configs
title:                  CMake custom target 命令引用空全局 CMAKE_RUNTIME_OUTPUT_DIRECTORY 时复制到根目录；应使用显式 CMAKE_BINARY_DIR 路径

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游 test/ut/CMakeLists.txt 的 add_custom_target(copy_configs)
                        COMMAND ${CMAKE_COMMAND} -E copy_directory
                        ${CMAKE_CURRENT_SOURCE_DIR}/configs
                        ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/configs 中，
                        CMAKE_RUNTIME_OUTPUT_DIRECTORY 是全局目录变量而非目标属性；
                        上游仅用 set_target_properties(RUNTIME_OUTPUT_DIRECTORY ...)
                        设置目标属性，未设置全局变量。旧 CMake 某些路径下该全局变量
                        恰好有值，CMake 4.x 下为空 → 目标路径被拼成 "/configs"（根目录），
                        复制因权限失败（Error copying directory）。
affected_scope:         上游在 add_custom_target/add_custom_command 的命令串里引用全局
                        CMAKE_RUNTIME_OUTPUT_DIRECTORY（而非目标属性/显式路径）的 CMake 项目；
                        CMake 4.x 与 Conan 交叉构建环境必然暴露；测试数据/资源文件通过
                        custom target 复制到运行目录的库。

# ═══ Layer 3: 方案层 (Approach) ═══
rec_priority:           1
rec_approach:           explicit-binary-dir-in-custom-target-copy
rec_approach_detail:    把 custom target 的 copy 目标路径改为显式构建目录
                        ${CMAKE_BINARY_DIR}/bin/configs（与目标属性 RUNTIME_OUTPUT_DIRECTORY
                        输出一致），不依赖全局变量：
                        COMMAND ${CMAKE_COMMAND} -E copy_directory
                        ${CMAKE_CURRENT_SOURCE_DIR}/configs
                        ${CMAKE_BINARY_DIR}/bin/configs
                        若上游目标属性输出目录可配置，用 set_target_properties 中同一变量。

verification_cmd:       cmake --build <build> -j2 && <build>/bin/<test_bin>  # 测试数据可被读取
                        # 回归：故意删除全局变量时不应再复制到根目录
                        grep -n 'CMAKE_RUNTIME_OUTPUT_DIRECTORY' <src>/CMakeLists.txt

similar_to:             DRAFT-ohos-cmake-add-test-target-file（CTest add_test 路径定位，
                        同属测试构建目录路径问题，根因/方案不同）
