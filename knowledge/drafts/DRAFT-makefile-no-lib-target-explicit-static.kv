#====================================================================
# DRAFT-makefile-no-lib-target-explicit-static.kv
# 上游 Makefile 无库/install 目标 (单文件实现库): 配方显式编译静态库
#====================================================================

id:                     DRAFT-makefile-no-lib-target-explicit-static
trigger_tool:           make|conan
phase:                  compilation
error_signature:        install: \$\{BIN\}|nothing to be done for 'install'|
                         no rule to make target 'install'|ar: cannot find|
                         package\(\) got no files|No such file.*\.a
severity:               2
category:               makefile|conan|build|static-lib|ohos
match_keywords:         Makefile, no library target, 无库目标, install, $(BIN) 未定义,
                        单文件实现, 函数级库, ar rcs, libasprintf.a, 显式静态库,
                        package 无产物, G4, R33, compiler_executables
title:                  上游 Makefile 无库/install 目标 (单文件实现): 配方 build()
                        显式编译静态库并运行上游 make test

root_cause: >
  纯 Makefile 小型 C 库的 Makefile 通常只有 all: clean test / test 目标,
  install 目标依赖未定义变量 (如 install: $(BIN)), 不产出任何库文件。
  官方发布形式是源码文件本身, 库产物的"构建"责任落在 Conan 配方上。
  若配方只 make install 或等待 Makefile 产出 .a, package() 拿不到产物,
  G4 产物完整性失败且消费者无法链接。
affected_scope:         >
  Makefile 只提供测试目标、无库/install 目标、官方发布为单文件实现的 C 库
  (asprintf/snprintf/strsep/ringbuffer 等函数级库), 且 Conan 配方需产出
  静态库供消费者链接的适配场景。
verification_cmd:       grep -nE "^(all|test|install):" <Makefile>
                        ; # 无 .a/.so 目标且 install 依赖未定义变量即命中

rec_priority:           1
rec_approach:           recipe-explicit-static-lib
rec_description:        配方 build() 内 1) 用 self.conf.get("tools.build:
                        compiler_executables") 取 R33 合规编译器链 (clang/
                        llvm-ar/llvm-ranlib) 运行上游 make test (满足 L1 与
                        双口径台账); 2) cc -c asprintf.c + ar rcs + ranlib
                        显式产出 libasprintf.a; package() 只装 include 头文件
                        与 lib 静态库; package_info() 声明 libs/libdirs/includedirs。
rec_command:            self.run(f"make CC={cc} AR={ar} RANLIB={ranlib} "
                        f"CFLAGS=\"{cflags}\" test", cwd=self.source_folder);
                        self.run(f"{cc} {cflags} -c asprintf.c -o libasprintf.a.tmp.o "
                        f"&& {ar} rcs libasprintf.a libasprintf.a.tmp.o "
                        f"&& {ranlib} libasprintf.a", cwd=self.source_folder)
rec_auto_fix:           false
rec_impl:               explicit-static-lib-in-build

fallback_priority:      2
fallback_approach:      header-only-consumer
fallback_description:   若库官方定位为 header-only/编译期包含 (无 .a 亦无 ABI
                        需求), 可声明 header-only 包 (仅装头文件, 不产 .a);
                        仅当上游确实按源码包含方式消费且无链接需求时使用。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       copy\(.*test\)|copy\(.*\.c.*package_folder
forbid_1_reason:        把测试可执行文件 test 或源码 .c 冒充库产物, 消费者无法
                        链接, L1e 负向测试会拦截, 审核判定虚假交付。
forbid_2_pattern:       \$\(CC\)|\$\{CC\}|os\.environ\[.CC.\]|shell\(.cc .*\) 裸编译器变量
forbid_2_reason:        R33: 禁止在 self.run 中使用裸 shell 编译器变量, 必须经
                        self.conf.get("tools.build:compiler_executables") 获取。

principles:

causes:                 []
caused_by:              []
similar_to:             [E097]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-makefile-no-lib-target-explicit-static.md
last_updated:           2026-09-20
source_event:           asprintf.c 0.0.3 OHOS 适配: Makefile 仅 all/test 目标,
                        install 依赖未定义 $(BIN), 配方显式编译 libasprintf.a,
                        G2 干净构建 + L1 + 消费者 test_consume 全部通过
contributor_id:         pc7-1
authors:                pc7-1
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.85
