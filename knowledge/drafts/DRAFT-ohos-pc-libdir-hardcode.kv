#====================================================================
# DRAFT-ohos-pc-libdir-hardcode — 部分 .pc（libucontext.pc 等）把
#   libdir/includedir 硬编码为 /usr/lib、/usr/include 而非 ${prefix}，
#   改写 prefix= 不生效——链接报 "unable to find library -lxxx"；需同时
#   改写 libdir/includedir/static_libdir 指向 conan 包实际路径
# 对应人类文档: knowledge/drafts/DRAFT-ohos-pc-libdir-hardcode.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR systemd/261 适配 HarmonyOS PC（链接 libsystemd-shared 时
#           unable to find library -lucontext）
#====================================================================

id:                     DRAFT-ohos-pc-libdir-hardcode
trigger_tool:           meson|cmake|configure|pkg-config|cc|ld
phase:                  configuration|linking
error_signature:        unable to find library -l|
                         Package .*\.pc.*libdir.*/usr/lib|
                         pkg-config.*/usr/lib.*not found|
                         -L/usr/lib.*unable to find|
                         libdir=.*/usr/lib

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               conan, pkg-config, .pc, libdir, hardcode, linking, ohos
match_keywords:         libdir, includedir, static_libdir, /usr/lib, /usr/include,
                         .pc, pkg-config, prefix, unable to find library,
                         hardcoded, conan package, generators_folder
title:                  .pc 把 libdir/includedir 硬编码为 /usr/lib、/usr/include
                         而非 ${prefix} 时，改写 prefix= 不生效——需同时改写
                         libdir/includedir/static_libdir 指向 conan 包实际路径

# ═══ Layer 2: 诊断层 ═══
root_cause:             Conan PkgConfigDeps 生成的 .pc 通常用 ${prefix} 派生 libdir/
                         includedir，改写 prefix= 即可重定向。但部分包自带的 .pc
                         （如 libucontext.pc）把 libdir=/usr/lib、includedir=
                         /usr/include、static_libdir=/usr/lib 硬编码为绝对路径，
                         不引用 ${prefix}——只改 prefix= 不生效，meson 链接时 -L
                         指向 /usr/lib（无该库）报 "unable to find library -lxxx"
affected_scope:         所有依赖这类"libdir/includedir 硬编码" .pc 的 conan 配方
                         （复制依赖 .pc 到 generators_folder 并改写 prefix 的场景；
                         dconf/polkit 的 _fix_pc_prefix 只改 prefix= 未覆盖此变体）
verification_cmd:       conan create archives/s/systemd/261 --build=missing
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 覆盖前链接 libsystemd-shared 报 unable to find
                         # library -lucontext；覆盖后链接成功

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           fix-pc-libdir-hardcode
rec_description:        改写 .pc 的 prefix= 后，同时把硬编码的 libdir/static_libdir/
                         includedir 绝对路径（/usr/lib、/usr/include）改为指向
                         conan 包实际路径（prefix/lib、prefix/include）。一条正则
                         处理，零补丁、零源码改动
rec_command:            (conanfile _fix_pc_prefix 扩展)
                         data = sub(r"(?m)^(libdir|static_libdir|includedir)=/usr/lib$",
                                    rf"\1={os.path.join(prefix,'lib')}", data)
                         data = sub(r"(?m)^(includedir)=/usr/include$",
                                    rf"\1={os.path.join(prefix,'include')}", data)
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      source-patch-link-flag
fallback_description:   若 .pc 改写不可行，配方在链接参数显式加 -L<conan 包 lib>——
                         治标不治本且不通用，不推荐
fallback_command:       (LDFLAGS 显式 -L)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       skip.*链接.*-lucontext|忽略.*unable to find library
forbid_1_reason:        .pc 改写可无损解决；跳过/忽略属"有可运行子集未尝试"
forbid_1_consequence:   被 rule 4 打回；且掩盖依赖链真实问题面
forbid_2_pattern:       sed.*/usr/lib.*删除|patch.*去掉.*libdir 行
forbid_2_reason:        删变量行会破坏 pkg-config 解析；改写路径才是正解
forbid_2_consequence:   换依赖版本即失效

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             E123
conflicts_with:         []
prerequisite_of:        []

