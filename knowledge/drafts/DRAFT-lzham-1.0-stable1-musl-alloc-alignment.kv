caused_by:              []
similar_to:             [E476]
conflicts_with:         []
prerequisite_of:        []
doc_file:               drafts/DRAFT-lzham-1.0-stable1-musl-alloc-alignment.md
last_updated:           2026-09-08
source_event:           lzham 1.0-stable1 r01 OHOS/aarch64: Release flaky
                         "lzham_realloc: bad ptr"，ASan 稳定通过，memalign 修复后
                         8/8 + 全矩阵通过
authors:                pc4-3
source_pr:              (lzham 1.0-stable1 知识库扩展 PR)
metrics_success_count:  1
metrics_fail_count:     1
metrics_confidence:     0.6
