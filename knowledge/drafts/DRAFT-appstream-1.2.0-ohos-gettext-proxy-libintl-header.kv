#====================================================================
# DRAFT-appstream-1.2.0-ohos-gettext-proxy-libintl-header.kv
# OHOS sysroot libintl.h 空 stub 无 gettext 声明 → 编译期未声明函数；
# 复制 glib 包内 proxy libintl.h 到构建 include 目录并前置 -I
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R02）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           clang
phase:                  compilation
error_signature:        call to undeclared function 'gettext'|
                        -Werror,-Wimplicit-function-declaration.*gettext|
                        undeclared function .*dgettext
severity:               2
category:               compilation, gettext, libintl, glib, ohos, portability
match_keywords:         gettext, dgettext, libintl.h, sysroot, stub, glib, proxy-libintl,
                        g_libintl, declared, -Werror implicit-function-declaration, gi18n-lib.h,
                        OHOS, musl, at-spi2-core
title:                  OHOS sysroot libintl.h 空 stub 无 gettext/dgettext 声明 → 复用 glib 包 proxy libintl.h 编译期补位
root_cause:             OHOS sysroot 的 libintl.h 是空 stub（无 gettext/dgettext/
                        textdomain 声明）；glib 头 gi18n-lib.h 无条件 include <libintl.h>，
                        源码直接调用 gettext() 时编译期报 undeclared function
                        （-Werror=implicit-function-declaration）。glib 包内
                        proxy libintl.h 把 gettext 等宏映射到 g_libintl_*
                        （链接期由 proxy-libintl 提供符号）。
affected_scope:         所有依赖 glib 家族（gi18n-lib.h）且源码直接调用 gettext()/
                        dgettext() 的 C 库在 OHOS 上的适配（gtk 系、appstream 系等）。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing
rec_priority:           1
rec_approach:           proxy-libintl-header-include
rec_description:        从 glib 包（或其他含 proxy libintl.h 的包）复制 libintl.h 到构建
                        私有 include 目录，并把它前置到 MesonToolchain extra_cflags -I
                        最前（sysroot 空 stub 之前），使 gettext → g_libintl_gettext 宏
                        生效（at-spi2-core 配方同款手法）。
rec_command:            |
  proxy_intl_dir = os.path.join(self.build_folder, "proxy-libintl-include")
  os.makedirs(proxy_intl_dir, exist_ok=True)
  shutil.copyfile(proxy_intl_src, os.path.join(proxy_intl_dir, "libintl.h"))
  tc.extra_cflags.append(f"-I{proxy_intl_dir}")   # 置于 sysroot stub 之前
rec_auto_fix:           false
rec_impl:               conan-recipe-generate
forbid_1_pattern:       -D.*nls=false.*gettext.*仍有声明问题
forbid_1_reason:        关 NLS 会改变运行语义（gettext 全部变字符串）且方案更重
forbid_2_pattern:       sysroot.*libintl\.h.*patch.*直接改
forbid_2_reason:        不改系统 sysroot；在构建私有目录复制 proxy 头即可
principles:             R6, R8
causes:                 []
caused_by:              []
similar_to:             [E015, E027, E107, E142]
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-ohos-gettext-proxy-libintl-header.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R02（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.8