#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E544.kv，填写各字段
# 对应的人类文档: doc/E544.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E544
trigger_tool: make|automake|conan
phase: linking|compilation
error_signature: cannot remove 'linuxpba': Is a directory|rm: cannot remove .*: Is a directory|make.*Error 1

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: hmdfs, autotools, build-system, portability
match_keywords: HMDFS, case-insensitive, 大小写不敏感, autotools, linuxpba, LinuxPBA, sbin_PROGRAMS, 目标名冲突
title: OHOS HMDFS 大小写不敏感下 autotools 目标名与源码目录同名冲突

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS HMDFS 文件系统大小写不敏感（case-insensitive），autotools 的 sbin_PROGRAMS 目标可执行文件名（如 linuxpba）与源码目录名（如 LinuxPBA）大小写仅不同时被视作同一路径，链接时 make 先执行 rm -f 目标名即误伤源码目录，报 'Is a directory'。
affected_scope: OHOS 上所有 autotools 构建的可执行目标名与源码子目录名存在大小写差异的软件
verification_cmd: stat -c %i linuxpba LinuxPBA 对比 inode 相同；make -j1 观察 rm: cannot remove 'linuxpba': Is a directory

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: rename-target-avoid-case-collision
rec_description: 将可执行目标改名为与源码目录大小写不同的名字（如 linuxpba → sedutil-pba），同步修改 sbin_PROGRAMS 与对应 _SOURCES 变量
rec_command: sed -i 's/linuxpba/sedutil-pba/g' Makefile.am && sed -i 's/linuxpba_SOURCES/sedutil_pba_SOURCES/' Makefile.am && automake && ./config.status Makefile && make -j1
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      rename-source-dir
fallback_description:   若目标名不可改（如被外部脚本引用），可改源码目录名为全小写并同步更新 _SOURCES 引用；但需评估上游 patch 体积与可维护性
fallback_command:       mv LinuxPBA linuxpba-src && sed -i 's#LinuxPBA/#linuxpba-src/#g' Makefile.am && automake && ./config.status Makefile
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       rm -rf linuxpba|rm -fr linuxpba
forbid_1_reason:        HMDFS 大小写不敏感下该路径即源码目录 LinuxPBA/，rm -rf 会误删整个源码目录
forbid_1_consequence:   源码树被破坏，无法继续构建，需重新解压
forbid_2_pattern:       ln -sf linuxpba
forbid_2_reason:        HMDFS 软链接行为受限，且软链接与目录同名仍冲突
forbid_2_consequence:   链接失败或链接指向自身，构建仍失败

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             E416
conflicts_with:         []
prerequisite_of:        []

