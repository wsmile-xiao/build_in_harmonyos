#====================================================================
# DRAFT-ohos-std-ranges-for-each.kv
# OHOS clang/libc++ 不提供 std::ranges::for_each（C++20 Ranges 库缺失）
# 触发事件: ausweisapp 2.5.4 HarmonyOS PC 适配（archives/a/ausweisapp/2.5.4，PR #7912）
#====================================================================

id:                     DRAFT-ohos-std-ranges-for-each
trigger_tool:           clang|cmake|conan
phase:                  compilation
error_signature:        std::ranges::for_each|
                         no member named 'ranges' in namespace 'std'|
                         'ranges' is not a member of 'std'|
                         for_each is not a member of 'std::ranges'

severity:               3
category:               c++|compiler|compat|clang|libc
match_keywords:         std::ranges, for_each, C++20, Ranges, libc++, clang,
                         range-for, <algorithm>, cpp20, OHOS, UiPluginDev
title:                  OHOS clang/libc++ 不提供 std::ranges::for_each（C++20 Ranges 库缺失），需用等价 range-for 循环替代

root_cause: >
  OHOS 交叉工具链的 clang/libc++（OHOS SDK 裁剪/适配版本）不提供 C++20
  Ranges 库实现，<algorithm> 等头文件里 std::ranges 命名空间缺失或
  for_each 不可用。上游以 C++20 编译的代码（如 AusweisApp 的
  src/ui/dev/UiPluginDev.cpp）一旦使用 std::ranges::for_each 就在编译期
  报 "std::ranges::for_each ... is not a member / no member named 'ranges'"
  ——是 libc++ 头文件/实现缺功能，而非项目 include 路径或 -std 级别问题。
affected_scope: >
  使用 C++20 <algorithm>/Ranges API（std::ranges::*，含视图适配器等）的
  C++ 项目在 OHOS 上的适配；凡目标代码依赖 Ranges 库的，均可能命中。
verification_cmd: >
  conan create 复验编译通过；或最小探针：
  echo '#include <algorithm>\nint main(){int a[]={1};std::ranges::for_each(a,a+1,[](int){});}' |
  $OHOS_SDK/native/llvm/bin/clang++ -std=c++20 -x c++ - -c

rec_priority:           1
rec_approach:           range-for-loop-replacement
rec_description: >
  用标准 range-for 循环（或其等价物）替换 std::ranges::for_each 调用；
  该模式最常见（for_each 语义与 range-for 一一对应），一行改动即可消除
  Ranges 依赖。对依赖视图/管道等更复杂 Ranges 语义的代码，再评估改用
  普通 STL 算法 + 迭代器组合。可在 conanfile.py source() 中动态改写
  源码文件，避免维护独立补丁。
rec_command:            >
  // 原: std::ranges::for_each(platformFiles, [&](QString& s){ ... });
  // 改: for (QString& s : platformFiles) { ... }
  // conanfile.py source() 内做等价的字符串替换/行重写后写回
rec_auto_fix:           false
rec_impl:               source-rewrite-range-for

fallback_priority:      2
fallback_approach:      upgrade-libcxx-toolchain
fallback_description: >
  若项目大量依赖 C++20 Ranges 无法逐处改写，评估升级/更换 OHOS 工具链
  的 libc++ 实现（或引入独立的 libc++ Ranges 支持）；改动面大、风险高，
  且受 OHOS SDK 版本约束，一般作为回退。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       -DRANGES_DISABLE|#include <ranges>.*skip|using namespace std::ranges
forbid_1_reason:        用宏屏蔽/强行 using 命名空间无法弥补实现缺失，编译仍失败
forbid_1_consequence:   编译失败依旧，且掩盖真实根因
forbid_2_pattern:       delete.*UiPluginDev|sed.*for_each.*delete
forbid_2_reason:        删除整个功能文件是功能裁剪，非适配修复
forbid_2_consequence:   应用功能残缺（dev 插件缺失）

principles:             P005, P011
similar_to:             E032
conflicts_with:
prerequisite_of:

