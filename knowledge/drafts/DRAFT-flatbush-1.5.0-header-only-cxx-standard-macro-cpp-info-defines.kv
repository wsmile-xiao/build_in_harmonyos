#====================================================================
# DRAFT-flatbush-1.5.0-header-only-cxx-standard-macro-cpp-info-defines -
# header-only INTERFACE 库的 C++ 标准门控宏须经 cpp_info.defines 传播
# （flatbush 1.5.0 实测：WITH_SPAN=ON → FLATBUSH_SPAN，OHOS cppstd=17
#   消费方无宏则报 "no template named 'span'"）
#
# 场景: flatbush 1.5.0 (chusitoo/flatbush, C++ 移植 packed Hilbert R-tree,
#       header-only INTERFACE target) OHOS armv8 Conan 2.x 适配。
#       上游 CMake 默认 WITH_SPAN=ON，把 FLATBUSH_SPAN 作为 INTERFACE
#       编译定义启用自带 C++11 兼容 span；关闭时要求 cxx_std_20 的
#       std::span。OHOS profile 固定 cppstd=17，消费方若收不到该宏，
#       直接编译报 "no template named 'span'"。
# 适用: 所有 header-only / INTERFACE 库，其头文件用编译宏门控 C++ 标准
#       特性（自带 span/optional/variant 等），且目标平台 profile 的
#       cppstd 低于宏关闭分支要求的标准；配方必须把宏放进
#       cpp_info.defines 传播给消费方。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-flatbush-1.5.0-header-only-cxx-standard-macro-cpp-info-defines
source_lib:             flatbush 1.5.0
trigger_tool:           clang|clang++|cmake|conan create|conan-verify|test_package
phase:                  compilation|configuration|packaging|testing
error_signature:        no template named 'span'|std::span|cxx_std_20|cppstd=17|FLATBUSH_SPAN|WITH_SPAN|INTERFACE.*compile_definitions|compile definition.*missing

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               headers, cmake, conan, packaging, compat
match_keywords:         header-only, INTERFACE, span, std::span, cxx_std_20, cppstd=17, FLATBUSH_SPAN, WITH_SPAN, cpp_info.defines, compile definition, 编译宏, 宏传播, package_type=header-library, no template named, C++17, C++20
title:                  header-only INTERFACE 库的 C++ 标准门控宏必须经 cpp_info.defines 传播（OHOS cppstd=17 消费方否则报 no template named 'span'）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  header-only 库（add_library(X INTERFACE)）为兼容低 C++ 标准，常把
  "用自带 span/optional 还是 std:: 版本"做成编译宏门控：
  #ifndef FLATBUSH_SPAN
  #include <span>         // 需要 cxx_std_20
  using std::span;
  #else
  class span { ... };     // 自带实现，C++11/17 可用
  #endif
  上游 CMake 用 option(WITH_SPAN ON) + target_compile_definitions(... INTERFACE
  FLATBUSH_SPAN) 把宏挂到 INTERFACE target 上——但这只对"走上游 CMake 目标"
  的消费者生效。Conan 配方打包后，宏不会自动进包；若配方不显式
  self.cpp_info.defines = ["FLATBUSH_SPAN"]，CMakeDeps 生成的
  flatbush-config.cmake 就没有该宏，C++17（OHOS profile cppstd=17）消费方
  编译 flatbush.h 走 std::span 分支 → "no template named 'span'"。

affected_scope:         所有 header-only / INTERFACE 库的 OHOS(arm64) Conan 2.x 配方；
                        任何 cppstd 低于宏关闭分支标准的消费方 profile
verification_cmd:       # 直接编译已安装包头文件（不传宏）应报 no template named 'span':
                        #   clang++ -std=c++17 -I <pkg>/include -c consumer.cpp
                        # 传 -DFLATBUSH_SPAN 或经配方 cpp_info.defines 后编译通过

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           propagate-cxx-standard-macro-via-cpp-info-defines
rec_description:        header-only 配方的 package_info() 中，把上游 INTERFACE 宏
                        （如 FLATBUSH_SPAN）显式写入 self.cpp_info.defines，
                        使 CMakeDeps 生成的 config 携带该宏；与上游
                        WITH_SPAN=ON 默认一致（本库上游默认 ON → C++11 兼容），
                        从而 OHOS cppstd=17 消费方直接可用。
rec_command:            # conanfile.py package_info():
                        #   self.cpp_info.set_property("cmake_file_name", "flatbush")
                        #   self.cpp_info.set_property("cmake_target_name", "flatbush::flatbush")
                        #   self.cpp_info.defines = ["FLATBUSH_SPAN"]
                        #   self.cpp_info.includedirs = ["include"]; bindirs=[]; libdirs=[]
rec_auto_fix:           false
rec_impl:               manual-conan-recipe-edit

# ═══ Layer 4: 验证层 (Verification) ★ ═══
verification:           |
  (1) conan create（ohos-aarch64 profile）G2 PASS；
  (2) 鸿蒙专项测试 reports/ohos-test.cpp（-std=c++17 -DFLATBUSH_SPAN，
      经 conan 已安装 include 编译）运行 exit 0：
      "PASS: OHOS C++17/FLATBUSH_SPAN + JS-compatible roundtrip ok"；
  (3) 对照失败路径已实测：不传宏时 clang++ -std=c++17 编译
      "no template named 'span'"（15 errors），传宏后通过；
  (4) test_package L1 消费者（conan create 内执行）exit 0。
  真实日志: archives/f/flatbush/1.5.0/reports/ohos-test-run.log

# ═══ Layer 5: 查重层 (Dedup) — 七轴 ═══
dedup:
  exact_duplicate:       false
  causal_duplicate:      false     # E321 根因是 Conan 1→2 迁移，非宏传播
  trigger_overlap:       partial   # 与 E321/E322 同 header-only+conan 触发面
  solution_overlap:      partial   # E321/E322 讲 package_info 的 cmake_file/target_name，
                                   # 未覆盖 cpp_info.defines 传播标准门控宏
  combination_novelty:   true      # 宏门控 C++ 标准分支 + cpp_info.defines 传播 = 新增差异
  boundary_novelty:      true      # 边界: 上游默认宏 ON 时消费方无需 C++20；
                                   # 配方漏宏 → cppstd=17 直接编译失败
  test_migration_novelty: false
  similar_to:            [E321, E322, E257, E293]
  caused_by:             []
  prerequisite_of:       []
  conflicts_with:        []

