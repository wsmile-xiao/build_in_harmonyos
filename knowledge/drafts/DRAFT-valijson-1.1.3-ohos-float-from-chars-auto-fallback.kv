#====================================================================
# DRAFT-valijson-1.1.3-ohos-float-from-chars-auto-fallback.kv
# 主题: OHOS libcxx 缺浮点 from_chars，上游已内置编译期自动检测回退（零补丁）
# 来源: valijson 1.1.3 第一轮适配（pc3-8，task valijson-1.1.3-r01-pc3-8-20260904T192801Z）
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     DRAFT-valijson-1.1.3-ohos-float-from-chars-auto-fallback
trigger_tool:           clang|cmake|conan
phase:                  compilation
error_signature:        std::from_chars.*double.*not supported|
                        call to deleted function 'from_chars'|
                        no matching function for call to 'from_chars'.*float|
                        from_chars.*is_integral.*not satisfied|
                        VALIJSON_HAS_STD_FROM_CHARS

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               platform, libcxx, charconv, portability, adaptation-decision
match_keywords:         from_chars, charconv, float, double, libc++, OHOS, libcxx-ohos,
                        istringstream, double_parser, strtod, VALIJSON_HAS_STD_FROM_CHARS,
                        _LIBCPP_VERSION, fast_float, feature detection

# ═══ Layer 2: 诊断层 ═══
title:                  OHOS libcxx 缺浮点 from_chars：先查上游是否已内置自动检测回退，再决定是否补丁
root_cause:             OHOS SDK libcxx（clang 15，_LIBCPP_VERSION=15004）的 <charconv>
                         不提供浮点 from_chars 重载。上游库若按编译器版本/标准库版本号
                         编译期检测（如 _LIBCPP_VERSION>=200000、_GLIBCXX_RELEASE>=11）
                         并内置 istringstream/fast_float 回退链，则 OHOS 下自动走回退，
                         零补丁；若库未检测而直接调用浮点 from_chars，才需补丁关闭能力
                         或替换为 strtod（参见 DRAFT-bitserializer-0.85.0）。
affected_scope:         C++17 库在 OHOS aarch64 的字符串→浮点转换路径；
                         上游 1.1.x→1.1.3 类演进中已内置回退的库（valijson 实例）
verification_cmd:       grep -n "VALIJSON_HAS_STD_FROM_CHARS\|double_parser.hpp" include/valijson/internal/;
                         # 编译探针: clang++ -std=c++17 -dM -E -x c++ /dev/null | grep LIBCPP_VERSION
                         # 运行探针: 见鸿蒙专项测试 test_valijson_ohos.cpp（9 合法+5 非法输入）

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           check-upstream-builtin-from-chars-fallback
rec_description:        适配前先检查上游当前版本是否已内置 from_chars 编译期检测与回退：
                         (1) 查 include 内 double_parser/from_chars 检测头；
                         (2) 确认 _LIBCPP_VERSION/_GLIBCXX_RELEASE 阈值在 OHOS 工具链
                             下不命中（VALIJSON_HAS_STD_FROM_CHARS=0）；
                         (3) 确认回退实现严格性（istringstream: classic locale +
                             noskipws + 全串消费 peek==eof）。
                         命中则零补丁直接适配；未命中再按 bitserializer 式补丁
                         （关闭能力宏 + strtod 回退）。
rec_command:            valijson 1.1.3 实例：无需任何补丁，conanfile 仅需
                         E092 CMake 平台映射（CMAKE_SYSTEM_NAME=Linux）即可通过
                         conan create 与全部上游测试。
rec_auto_fix:           true

fallback_priority:      2
fallback_approach:      patch-disable-float-from-chars-macro
fallback_description:   若上游未内置回退：打补丁在能力宏处按 __OHOS__ 关闭浮点
                         from_chars（=0），转换实现走 strtod/istringstream 回退；
                         补丁经 conandata.yml patches 声明（bitserializer 先例）。

# ★ 禁止策略 ★
forbid_1_pattern:       chars_format::general.*from_chars.*float|from_chars\(.*float.*chars_format
forbid_1_reason:        OHOS libcxx 无该重载，硬传 chars_format 仍编译失败
forbid_1_consequence:   继续编译失败，浪费循环
forbid_2_pattern:       为已内置回退的上游版本盲目复制 1.1.1 式 strtod 补丁
forbid_2_reason:        上游已修复，补丁冗余且偏离官方源码
forbid_2_consequence:   无意义 diff，PR 质量门禁扣分

# ═══ Layer 4: 原则引用 ═══
principles:             P003
causes:
caused_by:
similar_to:             DRAFT-bitserializer-0.85.0-ohos-float-from-chars-fallback, E455, E092
conflicts_with:
prerequisite_of:

# ═══ 元数据 ═══
