# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E543
trigger_tool:           configure|config.status|make
phase:                  configuration
error_signature:        Permission denied.*\.tmp|
                         cannot create temp file.*Permission denied|
                         mktemp.*failed.*Permission denied|
                         umask 077.*not writable|
                         drwx-----.*not writable.*owner

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               hmdfs, platform, permissions, autotools, portability
prescan_pattern:        umask 077
match_keywords:         umask 077, 0700 属主目录不可写, HMDFS, mktemp, Permission denied, 属主不可写, chmod 不生效, UID 映射, config.status, config.guess, 目录权限, owner cannot write, 复现 3/3
title:                  HMDFS 上 umask 077 创建的 0700 属主目录连属主都不可写（chmod 也无法恢复）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HMDFS 文件系统的 UID 映射机制与 autotools 的 `umask 077` 组合陷阱：
                        configure/config.status/config.guess 运行 `umask 077` 后用 mktemp 创建的
                        0700 属主临时目录（confXXXXXX/subsN.awk 等），在 HMDFS 上**连属主本人都不可写**。
                        复现实验 3/3 全部命中：`umask 077; mkdir d; touch d/f` → Permission denied，
                        且 chmod 0700→0777 也无法恢复写入（SELinux/HMDFS 双重限制，E046 同源）。
                        与 E011 同根因（E011 记录现象与 sed 修法），本条补强"属主也不可写 + chmod 失效 +
                        复现 3/3"的平台真理证据，并把范围从 configure 扩展到 config.guess 等任何
                        umask 077 + mktemp 的 shell 片段。
affected_scope:         所有在 HMDFS 上执行且脚本内含 `umask 077` + mktemp/临时文件写入的构建系统
                        （autotools 全家桶：configure、config.status、config.guess、config.sub；
                        以及任何打包了 autotools 生成脚本的 release tarball）。已确认：xz、tar、wget、
                        texinfo、tmux、hwloc、gdb、pmix 等。
verification_cmd:       umask 077 && mkdir -p /tmp/umask-probe 2>/dev/null; d=$(mktemp -d); touch $d/probe 2>&1; echo "exit=$?"; ls -ld $d; chmod 777 $d 2>&1 && touch $d/probe2 2>&1; echo "after-chmod exit=$?"; rm -rf $d

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           edit-umask-in-configure
rec_description:        将脚本中所有 `umask 077` 改为 `umask 022`（sed 全局替换），覆盖 configure、config.guess、
                        以及 configure 内嵌的 config.status 模板三处来源；umask 022 创建 0755 目录在
                        HMDFS 上属主可写，单用户构建场景安全。
rec_command:            sed -i 's/umask 077/umask 022/g' configure config/config.guess config/config.sub
rec_auto_fix:           true
rec_impl:               source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      fixed-workdir
fallback_description:   用固定目录（mkdir -p tmp_work）替代 mktemp 动态目录，配合 umask 022；
                        若目录已被创建为 0700 不可写，删除后以 umask 022 重建。
fallback_command:       mkdir -p tmp_work && sed -i 's|mktemp -d "\./confXXXXXX"|mkdir -p "tmp_work"|g' config.status
fallback_auto_fix:      true
fallback_impl:          source-patch

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       chmod 777|chmod u\+w
forbid_1_reason:         HMDFS 上 chmod 对已创建目录不生效（E046），试图用 chmod 恢复 0700 目录
                         可写性是死路，只会浪费排障时间
forbid_1_consequence:   chmod 命令成功返回但目录依然不可写，误判为其他根因继续排障

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P006

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E011, E046]
conflicts_with:         []
prerequisite_of:        []

