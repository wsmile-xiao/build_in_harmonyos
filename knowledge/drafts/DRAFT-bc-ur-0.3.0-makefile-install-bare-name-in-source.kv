last_updated:           2026-09-25
source_event:           bc-ur 0.3.0 r01 conan-verify G2 两次失败（E540 误命中后定位到 install 裸名）
source_pr:              (待 PR 编号)
source_commit:          (待 push 后填充)
metrics_success_count:  1
metrics_fail_count:     2
metrics_confidence:     0.8
