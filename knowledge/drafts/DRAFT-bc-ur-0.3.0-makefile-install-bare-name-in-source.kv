#====================================================================
# DRAFT-bc-ur-0.3.0-makefile-install-bare-name-in-source —
# autotools 手写 Makefile.in（无 Makefile.am）out-of-source 构建下
# install 规则以裸名引用头文件 → 配方折叠 folders.build='.' 强制 in-source
# 关联库: bc-ur 0.3.0（r01，OHOS aarch64 实测）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# 触发: conan create package() 阶段 make install DESTDIR=... 在 out-of-source
# build 目录报 "install: bad '<header>': No such file or directory"
id:                     DRAFT-bc-ur-0.3.0-makefile-install-bare-name-in-source
trigger_tool:           conan|make|autotools
phase:                  packaging|install
error_signature:        install: bad '.*\.hpp': No such file or directory|
                         install: bad '.*\.h': No such file or directory|
                         make\[[0-9]+\].*install.*Error 1

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, autotools, conan, packaging, in-source
match_keywords:         Makefile.in, Makefile.am, install, HEADERS, srcdir, VPATH,
                         out-of-source, in-source, folders.build, basic_layout,
                         install: bad, No such file or directory, libbc-ur
title:                  autotools 手写 Makefile.in（无 Makefile.am）install 规则以裸名引用头文件时，
                         out-of-source 构建 install 失败，配方须折叠 folders.build='.' 强制 in-source

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游发布 tarball 只含手写 Makefile.in（无 Makefile.am，
                         非 automake 生成）：configure 生成的 Makefile 虽带 VPATH
                         （out-of-source 下 make all 编译正常），但 install 规则形如
                         `install $(HEADERS) $(includedir)` 以裸名引用头文件（未加
                         $(srcdir)/ 前缀）。GNU make 的 VPATH 只对目标/依赖文件路径生效，
                         不会重写 recipe 中变量展开后的裸名 —— 在 conan Autotools 默认
                         out-of-source（basic_layout → build-release/）目录中，
                         install 在 CWD 找不到头文件，报 install: bad 'bc-ur.hpp'。
                         automake 生成的 Makefile 会用 $(srcdir) 前缀，故不触发。
affected_scope:         任何"发布 tarball 无 Makefile.am、install 规则裸名引用头文件"的
                         autotools 库在 Conan（或任何 out-of-source 构建）下的适配；
                         仓库同类先例 abc/abduco/acpitool/adjtimex 等手写 Makefile 库。
verification_cmd:       conan create（OHOS profile）→ package() 报 install: bad '<h>':
                         No such file or directory；layout() 加 self.folders.build = "."
                         后重跑 conan create → package 通过，test_package 2/2。

rec_priority:           1
rec_approach:           in-source-layout
rec_description:        layout() 中 basic_layout(self) 后追加 self.folders.build = "."
                         强制 in-source 构建：configure/make/make install 全在源码目录，
                         install 规则裸名即刻解析。最小改动、不触上游源码。
rec_command:            def layout(self):\n    basic_layout(self)\n    self.folders.build = "."
rec_auto_fix:           false
rec_impl:               manual-conan-recipe

fallback_priority:      2
fallback_approach:      srcdir-prefix-patch
fallback_description:   若项目强制要求 out-of-source（如与其它工具冲突），以 conandata 补丁
                         将 install 规则头文件变量改写为 $(srcdir)/ 前缀；改动面大于方案一。
fallback_command:       patches/*.patch:  -s/install $(HEADERS) $(includedir)/install $(addprefix $(srcdir)\/, $(HEADERS)) $(includedir)/
fallback_auto_fix:      false
fallback_impl:          manual-patch

forbid_1_pattern:       treat.*install.*as.*upstream.*defect|rerun.*conan.*create.*without.*layout.*change
forbid_1_reason:        失败根因是本库手写 Makefile 的 VPATH/install 交互，非上游代码缺陷，
                        也非平台限制；只重跑不修 layout 属无效重试。
forbid_1_consequence:   反复 conan create 浪费预算且掩盖真实方案。

# ═══ Layer 3: 治理层 (Governance) ═══
principles:             []
causes:                 []
caused_by:              []
similar_to:             DRAFT-audacious-buildsys-in-source-static-chain
conflicts_with:         []
prerequisite_of:        []

# ═══ Layer 4: 证据层 (Evidence) ═══
