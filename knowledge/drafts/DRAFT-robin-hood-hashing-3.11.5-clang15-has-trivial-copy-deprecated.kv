#====================================================================
# DRAFT-robin-hood-hashing-3.11.5-clang15-has-trivial-copy-deprecated -
# clang 15+ 弃用 __has_trivial_copy：clang 定义 __GNUC__=4 误入 g++<5
# 兼容分支导致 -Wdeprecated-builtins 编译失败（robin-hood-hashing 3.11.5
# OHOS armv8 实测）。
#
# 场景: robin-hood-hashing 3.11.5 (martinus, C++14 header-only hash map)
#       OHOS arm64 (clang 15.0.4, OHOS SDK 26.0.0.18) 编译上游测试时，
#       src/include/robin_hood.h 的
#       `#if defined(__GNUC__) && __GNUC__ < 5` 分支被 clang 命中
#       （clang 定义 __GNUC__=4），调用被弃用的内建宏 __has_trivial_copy，
#       配合 -Werror,-Wdeprecated-builtins 直接编译失败。
# 适用: 所有在 clang 15+ 上编译且含 `__GNUC__ < 5` 兼容分支或直接使用
#       __has_trivial_copy / 其他被弃用内建宏的 C/C++ 库。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-robin-hood-hashing-3.11.5-clang15-has-trivial-copy-deprecated
source_lib:             robin-hood-hashing 3.11.5
trigger_tool:           clang|clang++|cmake|make
phase:                  compilation
error_signature:        builtin __has_trivial_copy is deprecated|use __is_trivially_copyable instead|Wdeprecated-builtins|__has_trivial_copy\(

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               portability, compat, clang, c++, headers
match_keywords:         __has_trivial_copy, __is_trivially_copyable, deprecated builtins, __GNUC__, g++<5, clang 15, Wdeprecated-builtins, Werror, robin_hood.h, trivial copy, is_trivially_copyable, Wsign-conversion, PERF_EVENT_IOC_ID
title:                  clang 15+ 弃用 __has_trivial_copy：clang 定义 __GNUC__=4 误入 g++<5 分支需排除 clang

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  clang 编译器会预定义 __GNUC__=4（兼容 GNU 语义）。上游代码常用
  `#if defined(__GNUC__) && __GNUC__ < 5` 为老 g++ 选择 __has_trivial_copy
  内建宏。clang 15+ 将 __has_trivial_copy 标记为 deprecated，配合
  -Werror,-Wdeprecated-builtins 时报编译错误；即使不加 -Werror，该分支
  也会产生弃用警告并让 CI 的 warnings-as-errors 策略失败。正确语义是
  g++ < 5 才用内建宏，clang 一律使用标准 trait。
affected_scope:         所有在 clang 15+ 上编译且含 `__GNUC__ < 5` 兼容分支或
                        直接使用 __has_trivial_copy 的 C/C++ 库；常见于
                        header-only 哈希/容器库（robin-hood-hashing 系）
verification_cmd:       grep -nE '__GNUC__ < 5|__has_trivial_copy' src/include/robin_hood.h

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           source-patch-exclude-clang
rec_description:        补丁把条件改为 `__GNUC__ < 5 && !defined(__clang__)`，
                        clang 一律走 std::is_trivially_copyable 标准 trait 分支
rec_command:            sed -i 's/#if defined(__GNUC__) \&\& __GNUC__ < 5/#if defined(__GNUC__) \&\& __GNUC__ < 5 \&\& !defined(__clang__)/' <header>
rec_auto_fix:           true
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      disable-werror
fallback_description:   若库不能打补丁（第三方固定源码），可临时在编译命令加
                        -Wno-deprecated-builtins 或去掉 -Werror 中的对应项
fallback_command:       cmake -DCMAKE_CXX_FLAGS="-Wno-deprecated-builtins" ..
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       define __has_trivial_copy|#undef __has_trivial_copy
forbid_1_reason:        重新定义编译器内建宏属于 UB，破坏 __is_trivially_copyable 等其它内建宏
forbid_1_consequence:   后续编译不可预测，CI 干净环境可能行为不同

principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

