#====================================================================
# Draft: CMake 静态库 PRIVATE 链接 zlib 的 Conan 静态包消费者链接报 undefined symbol，
#        用上游自带 zlib 开关（OWN_ZLIB）归档内自包含
#====================================================================

draft: DRAFT-tng-1.8.2-static-zlib-priv-link-self-contained
status: pending-editor-review
id: DRAFT-tng-1.8.2-static-zlib-priv
doc_file: tng-1.8.2-static-zlib-priv-link-self-contained.md
title: CMake 静态库以 target_link_libraries(PRIVATE ZLIB::ZLIB) 链接 zlib 时，Conan 静态包消费者链接 libtng_io.a 报 undefined symbol（uncompress/compressBound/compress）——用上游 TNG_BUILD_OWN_ZLIB=ON 把内部 zlib 对象编入归档自包含
category: cmake, linking, conan, packaging, zlib, static-library
match_keywords: >
  undefined symbol, uncompress, compressBound, compress, libtng_io.a,
  ZLIB::ZLIB, PRIVATE, static archive, 静态库, 链接依赖不传播,
  TNG_BUILD_OWN_ZLIB, internal zlib, external/zlib, self-contained,
  static package consumer, CMakeDeps, test_package
error_signature: >
  ld\.lld: error: undefined symbol: uncompress|compressBound|compress.*in archive .*\.a
root_cause: >
  上游 CMake 以 target_link_libraries(<static> PRIVATE ZLIB::ZLIB) 链接 zlib；
  动态库场景 PRIVATE 不泄漏给消费者，但静态归档会把 zlib 符号扇入归档，
  而链接 zlib 的链接行不进入归档导出元数据。Conan 静态包只写 cpp_info.libs
  时，消费者链接静态归档出现 zlib 符号未定义。同类问题见 E247（pkg-config
  Libs.private 静态 C++ 运行时传播），本条目为 CMake PRIVATE 链接触发面。
affected_scope: >
  CMake 工程以 PRIVATE 链接 zlib 且以静态归档 + Conan 静态包交付的场景
  （如 tng 1.8.2 libtng_io.a）；上游自带内部 zlib 实现时适用。
verification_cmd: >
  ohc-run.py conan-verify tng 1.8.2（G2 conan create 含 test_package 链接）；
  clang consumer_test.c -I<install>/include <install>/lib/libtng_io.a -lm 编译链接运行 exit 0
rec_priority:           1
rec_approach:           upstream-own-zlib-bundle-in-archive
rec_description: >
  在配方 generate() 中设置上游自带的内部 zlib 构建开关（TNG_BUILD_OWN_ZLIB=ON），
  使 zlib 源文件作为 OBJECT 库编入 libtng_io 归档；package_info 无需 system_libs
  或传递 requires，消费者零感知。
rec_command: >
  tc.variables["TNG_BUILD_OWN_ZLIB"] = "ON"
rec_auto_fix:           true
rec_impl:               conanfile.py generate() 变量 + 上游 OWN_ZLIB 分支
fallback_priority:      2
fallback_approach:      conan-requires-zlib-transitive-link
fallback_description: >
  上游无内部 zlib 时：配方 requires("zlib/...") 并在 package_info 声明传递链接
  （cpp_info.system_libs 或依赖传播），或改动态库交付。
fallback_command: >
  self.requires("zlib/1.3.1") ; self.cpp_info.requires = ["zlib::zlib"]
fallback_auto_fix:      false
forbid_1_pattern:       test_package 只打印版本不链接真实 API
forbid_1_reason:        空壳测试无法暴露静态归档链接缺陷
forbid_1_consequence:   消费者在生产链接时才发现 undefined symbol
source_event:           tng 1.8.2 第一轮适配（task tng-1.8.2-r01-pc7-2）
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
