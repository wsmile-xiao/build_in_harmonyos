#====================================================================
# DRAFT-libnss_nis-3.4-glibc-nss-compat-headers.kv
# glibc NSS 模块在 OHOS/musl 缺 glibc 专有头（nss.h/aliases.h/rpc/netdb.h）
# 触发事件: libnss_nis 3.4 HarmonyOS PC 适配（archives/l/libnss_nis/3.4）
# 与 E544-draft 关系: E544 覆盖 musl netdb.h 宏缺项（NETDB_INTERNAL），
#                    本条覆盖 glibc NSS 框架头整体缺失的树内最小声明方案
#====================================================================
id:                     DRAFT-libnss_nis-3.4-glibc-nss-compat-headers
trigger_tool:           clang|make|conan|configure
phase:                  compilation|configuration
error_signature:        fatal error: 'nss.h' file not found|
                         fatal error: 'aliases.h' file not found|
                         fatal error: 'rpc/netdb.h' file not found|
                         use of undeclared identifier 'NETDB_INTERNAL'|
                         incomplete type 'struct gaih_addrtuple'|
                         symbol not found.*__mempcpy

severity:               2
category:               musl, libc, portability, compat, ohos, headers, nss
match_keywords:         nss.h, aliases.h, rpc/netdb.h, NSS_STATUS, nss_status,
                         gaih_addrtuple, NETDB_INTERNAL, __mempcpy, mempcpy,
                         glibc, musl, OHOS, Name Service Switch, NSS module,
                         libnss_, 兼容头, compat header
title:                  glibc NSS 模块在 OHOS/musl 需要树内最小兼容头

# ═══ Layer 2: 诊断层 ═══
root_cause:             libnss_nis 是 glibc NSS（Name Service Switch）模块，
                         源码无条件 include glibc 专有头 <nss.h>/<aliases.h>/
                         <rpc/netdb.h>。OHOS 用 musl libc，既无 NSS 框架也
                         不提供这些头；连带缺 NETDB_INTERNAL 宏、
                         struct gaih_addrtuple（gethostbyname4_r NSS 接口）、
                         glibc 内部符号 __mempcpy（musl 只导出 mempcpy()）。
affected_scope:         所有依赖 glibc NSS 基础设施头的库（libnss_* 家族、
                         NSS 模块、直接引用 nss_status/NSS_STATUS_* 的项目）
                         迁移到 OHOS/musl。
verification_cmd:       grep -rn "nss.h\|aliases.h\|rpc/netdb.h\|__mempcpy" src/;
                         编译报 "fatal error: 'nss.h' file not found" 即命中

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           in-tree-minimal-compat-headers
rec_description:        在源码树 src/ 下新增最小兼容声明头（非复制 glibc 头），
                         利用 AM_CPPFLAGS 的 -I$(srcdir) 使 #include <nss.h>
                         等解析到树内文件：
                         1) src/nss.h: enum nss_status + NSS_STATUS_* 五常量
                            （TRYAGAIN=-2/UNAVAIL/NOTFOUND/SUCCESS/RETURN，
                            对齐 glibc nss/nss.h）；gethostbyname4_r 需要的
                            NETDB_INTERNAL(-1)/NETDB_SUCCESS(0) 与
                            struct gaih_addrtuple（布局对齐 glibc
                            inet/getaddrinfo.h: next/name/family/addr[4]/scopeid）；
                            #define __mempcpy mempcpy（musl 无 glibc 内部名）
                         2) src/aliases.h: struct aliasent
                            （alias_name/alias_members/alias_members_len/
                            alias_local，对齐 glibc inet/aliases.h）
                         3) src/rpc/netdb.h: 仅 #include <rpc/rpcent.h>
                            （rpc 模块只用到 struct rpcent，由 libtirpc 提供）
                         不修改任何 .c 文件。补丁文件加补丁说明（R8 例外）。
rec_command:            参考 archives/l/libnss_nis/3.4/patches/0001-ohos-glibc-compat-headers.patch
rec_auto_fix:           false
rec_impl:               manual-patch

# ★ 边界（与 E194 forbid 的关系）★
boundary_1:             本方案是树内最小声明头（仅本库编译可见），不是把
                         glibc 头复制进系统 include 或 usr/local/include；
                         E194 forbid "复制 glibc 头文件到 musl" 不冲突。
boundary_2:             NSS 模块配方 package_info 需清空 includedirs
                         （E498 覆盖）；共享库默认 shared=True（dlopen 消费，
                         同 nss-wrapper）。

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P012
related_entries:        E544-draft, E194, E498, E020, E007, E072
