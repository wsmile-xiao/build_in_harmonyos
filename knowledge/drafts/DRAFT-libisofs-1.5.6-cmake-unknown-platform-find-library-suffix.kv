#====================================================================
# DRAFT-libisofs-1.5.6-cmake-unknown-platform-find-library-suffix - CMake unknown HarmonyOS platform breaks CMakeDeps find_library
#====================================================================

id:                     DRAFT-libisofs-1.5.6-cmake-unknown-platform-find-library-suffix
library:                libisofs
version:                1.5.6
trigger_tool:           cmake|conan|cmakedeps
phase:                  configure|linking
error_signature:        Library '.*' not found in package.*If '.*' is a system library|
                         System is unknown to cmake.*Platform/HarmonyOS.*find_library|
                         CMAKE_FIND_LIBRARY_SUFFIXES.*empty.*HarmonyOS|
                         conan_package_library_targets.*not found in package

severity:               2
category:               cmake, conan, cmakedeps, ohos, find_library
match_keywords:         CMAKE_FIND_LIBRARY_SUFFIXES, CMAKE_FIND_LIBRARY_PREFIXES,
                         System is unknown to cmake, Platform/HarmonyOS,
                         find_library, CMakeDeps, cmakedeps_macros.cmake,
                         not found in package, static library, .a,
                         test_package, HarmonyOS, OHOS, unknown platform
title:                  CMake 不识别 HarmonyOS 导致 find_library 无默认库后缀，CMakeDeps 报 "Library not found in package"

root_cause:             CMake 没有 Platform/HarmonyOS.cmake 平台模块，系统名识别为
                         HarmonyOS 后不加载任何平台默认后缀集合（Linux 平台会设置
                         CMAKE_FIND_LIBRARY_SUFFIXES=.so;.a 等，Windows 会设置
                         .lib/.dll）。CMakeDeps 的 cmakedeps_macros.cmake 在
                         conan_package_library_targets() 中用 find_library 定位
                         cpp_info.libs 声明的库文件时，CMAKE_FIND_LIBRARY_SUFFIXES
                         为空 → 找不到包内 lib/xxx.a（静态库场景），报
                         "Library 'xxx' not found in package"。头文件包含与
                         linker flags 正常，仅有 find_library 失败，因此 CMake
                         项目 configure 阶段即中断。
                         与 E092（unknown platform 配置失败）互补：E092 是平台
                         宏/工具链检测问题，本条目是 CMakeDeps find_library
                         后缀缺失导致的消费者配置失败。

affected_scope:         所有在 HarmonyOS PC（CMake unknown platform）上用 Conan 2
                         CMakeDeps 消费静态库（或静态+动态混合）的 test_package /
                         消费者 CMake 项目；libisofs 1.5.6 实测受影响。

verification_cmd:       conan create archives/l/libisofs/1.5.6 -pr:h=ci/conan/profiles/ohos-aarch64
                         -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing
                         --user=ohpcd --channel=stable
                         # 修复前 test_package configure 报 not found in package；
                         # 修复后 configure/build/test 全过即验证。

rec_priority:           1
rec_approach:           declare-find-library-suffixes-in-consumer
rec_description:        在 test_package（或消费者）CMakeLists.txt 中，在
                         find_package(<pkg> REQUIRED) 之前显式声明 HarmonyOS 下
                         find_library 的默认前缀/后缀：
                         if(CMAKE_SYSTEM_NAME MATCHES "HarmonyOS|OHOS")
                             set(CMAKE_FIND_LIBRARY_SUFFIXES ".so" ".a" )
                             set(CMAKE_FIND_LIBRARY_PREFIXES "lib" "" )
                         endif()
                         使 CMakeDeps 生成的 conan_package_library_targets()
                         能被 find_library 定位到包内静态库。
rec_command:            test_package/CMakeLists.txt 顶部：
                         if(CMAKE_SYSTEM_NAME MATCHES "HarmonyOS|OHOS")
                             set(CMAKE_FIND_LIBRARY_SUFFIXES ".so" ".a" )
                             set(CMAKE_FIND_LIBRARY_PREFIXES "lib" "" )
                         endif()
                         然后 find_package(<pkg> REQUIRED) 照常使用。
rec_auto_fix:           true
rec_impl:               consumer-cmakelists

fallback_priority:      2
fallback_approach:      absolute-link-path
fallback_description:   在 test_package 中放弃 CMakeDeps target，改为用
                         find_library(FOO_LIB NAMES <lib> PATHS
                         ${<pkg>_LIB_DIRS_RELEASE}) 手动定位并把 include/lib 目录
                         显式加入 target；或直接用 source() 里拿到的绝对路径
                         target_link_libraries(... $<LINK_ONLY:绝对路径>)。较繁琐，
                         且丢失传递依赖元数据。
fallback_command:       find_library(LIBISOfs_LIB libisofs PATHS
                         ${libisofs_LIB_DIRS_RELEASE} REQUIRED);
                         target_link_libraries(test_libisofs ${LIBISOfs_LIB})
fallback_auto_fix:      false
fallback_impl:          manual-find-library

forbid_1_pattern:       set\(CMAKE_SYSTEM_NAME "Linux"\)
forbid_1_reason:        将 HarmonyOS 伪装为 Linux 会让 CMake 加载 Linux 平台逻辑
                         （/proc、systemd、dbus 探测等），对纯 POSIX 库可能无害
                         但对平台集成类项目引入错误依赖，且 W4 审计视为平台伪装。
forbid_1_consequence:   configure 通过但产物链接或运行时引用错误平台组件。

principles:             P004, P006
causes:                 []
caused_by:              []
similar_to:             [E092, DRAFT-tinyspline-0.6.0-cmake-libdir64-cmakedeps]
conflicts_with:         []
prerequisite_of:        []

