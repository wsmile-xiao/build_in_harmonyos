#====================================================================
# E999-draft-23FF - OHOS libcxx-ohos 缺 C++20 std::ranges 算法时的
# 迭代器版等价替换（含测试源同步替换）
#
# 场景: clang21-ccache 21.1.8（ccache v4.14 源码，CMake C++20，CLI 工具包）
#       在 OHOS armv8（OHOS SDK 26.0.0.18, clang 15.0.4, libcxx-ohos）上
#       编译失败: std::ranges::all_of / any_of / equal 均报
#       "no member named 'xxx' in namespace 'std::ranges'"。
# 适用: 所有在 OHOS 上编译且使用 C++20 std::ranges 算法（all_of/any_of/
#       equal/find_if 等）的库，含其上游测试源需要同步替换的场景。
# 与 DRAFT-graaf-1.1.0-ohos-libcxx-std-ranges-missing（max_element/
#       min_element/count_if 替换）同方案族；本条目新增：all_of/any_of/
#       equal 三个算法实例 + 上游 unittest 测试源（test_util_tokenizer.cpp
#       ranges::equal）一并替换的 CLI 工具包边界。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E999
trigger_tool:           clang|clang++|cmake|conan|make|test
phase:                  compilation|testing
error_signature:        no member named 'all_of' in namespace 'std::ranges'|no member named 'any_of' in namespace 'std::ranges'|no member named 'equal' in namespace 'std::ranges'|std::ranges::all_of|std::ranges::any_of|std::ranges::equal|libcxx-ohos|ranges algorithm not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               platform, ohos, toolchain, libcxx, portability, headers
match_keywords:         std::ranges, all_of, any_of, equal, libcxx-ohos, OHOS, HarmonyOS, clang 15, C++20, no member named, std::all_of, std::any_of, std::equal, iterator, tokenizer, unittest
title:                  OHOS libc++ (libcxx-ohos) 未提供 C++20 std::ranges::all_of/any_of/equal，需替换为迭代器版 std:: 算法（需同步替换上游测试源）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  OHOS PC SDK（OHOS SDK 26.0.0.18，clang 15.0.4）自带 libcxx-ohos（LLVM 15
  基线）未实现 <ranges> 中的算法重载（std::ranges::all_of / any_of / equal
  等），仅提供概念与范围基础件。上游源码在标准 libc++（Linux）上编译正常，
  OHOS 工具链直接报 "no member named 'xxx' in namespace 'std::ranges'"。
  经典迭代器算法（std::all_of/std::any_of/std::equal）在 libcxx-ohos 完整可用，
  可安全等价替换。属工具链能力缺口（与 E130 的 nullptr_t/__abi_tag__ 同源
  不同面；与 E292 的 Arrow ctest 迁移场景无关）。
affected_scope: 所有在 OHOS (SDK 26 clang15/libc++) 上编译且使用 C++20
  std::ranges 算法（all_of/any_of/equal 等）的第三方库；尤其 CLI 工具包
  （application）连同上游测试源（unittest/doctest 等）均需同步替换。
verification_cmd: grep -rn "std::ranges::" <src>; clang++ -std=c++20 -c <src>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description: >
  将 std::ranges::all_of/any_of/equal 调用替换为等价的迭代器版
  std::all_of/std::any_of/std::equal（range 形式改为 begin()/end()）；
  上游测试源中同类调用必须一并替换（否则测试目标编译失败）。
rec_command: |
  // std::ranges::all_of(range, pred)  →  std::all_of(begin, end, pred)
  const auto tokens = util::Tokenizer(options, ",", util::Tokenizer::Mode::include_empty);
  return std::all_of(tokens.begin(), tokens.end(), is_macro_option);
  // std::ranges::any_of(safe_dirs, pred)  →  std::any_of(safe_dirs.begin(), safe_dirs.end(), pred)
  // std::ranges::equal(a, b)  →  std::equal(a.begin(), a.end(), b.begin(), b.end())
rec_auto_fix:           false
rec_impl:               source-patch

# 回退方案
fallback_priority:      2
fallback_approach:      polyfill
fallback_description:   若库本体需保持 std::ranges 命名空间形态，可参照
  DRAFT-ohos-libcxx15-missing-cpp20-ranges-algorithms（ada 4.0.0）在
  namespace std::ranges 内提供减量 polyfill 委托经典迭代器算法
fallback_auto_fix:      false
fallback_impl:          none

# ★ 禁止策略 ★
forbid_1_pattern:        -std=c++2b|-std=c++23
forbid_1_reason:         通过抬高 C++ 标准绕过 libcxx-ohos ranges 缺失会引入 C++23 编译面与后续不可移植性，且不解决测试源真实编译
forbid_1_consequence:    编译过但行为/厂商语义未核验，CI 或消费者构建漂移
forbid_2_pattern:        /UNCOMMENT.*ranges|#pragma clang diagnostic ignored "-W.*ranges"
forbid_2_reason:         仅压制诊断不修复缺项，等于伪造编译结论
forbid_2_consequence:    质量审计判为伪造编译证据

# ═══ Layer 4: 原则引用 ═══
principles:             R8, R32, R51

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E130]
similar_to:             [DRAFT-graaf-1.1.0-ohos-libcxx-std-ranges-missing, DRAFT-ohos-libcxx15-missing-cpp20-ranges-algorithms, DRAFT-icecream-cpp-1.0.0-cpp20-ranges-toolchain-gap]
conflicts_with:         []
prerequisite_of:        []

