#====================================================================
# DRAFT-libspecbleach-0.4.1-conan-prebuild-pc-stale-cache-path
#    conan 预编译依赖包的 .pc 内嵌构建机缓存绝对路径失效
#    → sed 修复 .pc + PKG_CONFIG_PATH 重定向恢复被跳过的上游测试入口
# 来源: libspecbleach 0.4.1 适配（Path B 知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-libspecbleach-0.4.1-conan-prebuild-pc-stale-cache-path
trigger_tool:           pkg-config|cmake|conan|ctest
phase:                  testing|configuration|dependency-resolution
error_signature:        Imported target "PkgConfig::\w+" includes non-existent path|
                        non-existent path.*\.cache/conan2/p/b/|
                        No package '\w+' found|
                        error loading shared libraries|pkg-config.*not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, dependency, pkg-config, testing
match_keywords:         conan, 预编译包, prebuilt, .pc, pkg-config, 缓存路径,
                        .cache/conan2/p/b, 内容寻址, prefix, PKG_CONFIG_PATH,
                        non-existent path, 失效路径, sndfile, test 入口恢复,
                        上游测试, ctest, libsndfile, PkgConfig::SNDFILE
title:                  conan 预编译依赖包 .pc 内嵌构建机缓存绝对路径失效：sed 修复 .pc + PKG_CONFIG_PATH 重定向恢复被跳过的上游测试入口

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  conan2 下载的预编译依赖包（libsndfile/1.2.2 等）内 <dep>.pc 的
  prefix/libdir/includedir 写死为原构建机的缓存路径
  （~/.cache/conan2/p/b/<hash>/p，内容寻址目录）。当前机器 conan 实际把
  包解包到 ~/.conan2/p/<hash>/p（哈希不同），因此 .pc 内全部路径失效。
  pkg-config --cflags 能"找到"包名（Name/Version 解析自 .pc 本身），但
  CMake 的 pkg_check_modules 构造 Imported target 时校验 include 路径，
  直接报 "Imported target includes non-existent path" 配置失败，进而
  该依赖门控的上游测试用例（如 test_audio_file_regression、
  test_integration_realworld_quality）不会被实例化——表现与"缺依赖"相似，
  极易误导为依赖未安装。

# ═══ Layer 3: 修复层 (Remediation) ═══
rec_approach:           repair-pc-prefix-and-redirect-pkgconfig-path
rec_description: >
  1) 定位 .pc 实际所在：conan cache path <ref>:<package_id>（如
     libsndfile/1.2.2#<rrev>:<prev>），其 lib/pkgconfig/<dep>.pc 为源；
  2) sed 将 .pc 内 .cache/conan2/p/b/<hash>/p 批量替换为实际解包路径
     ~/.conan2/p/<hash>/p，输出到可写目录 $TMPDIR/pkgfix/；
  3) export PKG_CONFIG_PATH=$TMPDIR/pkgfix，重新 configure + build +
     ctest，被跳过的入口实例化并实际运行。
  注意事项: .pc 是依赖包交付物，直接修改包内文件属越权；正确做法是生成
  "修复副本"并仅通过 PKG_CONFIG_PATH 优先指向它，不影响包本身。
  验证: pkg-config --cflags --libs sndfile 输出实际存在路径后，
  再重新配置目标库，避免"找到但路径死"的假阳性。
rec_command: |
  REALP=$(conan cache path 'libsndfile/1.2.2#<rrev>:<prev>')
  FIXDIR="${TMPDIR:-/tmp}/pkgfix"
  mkdir -p "$FIXDIR"
  sed "s|/storage/Users/.*\.cache/conan2/p/b/[^/]*/p|$REALP|g" \
      "$REALP/lib/pkgconfig/sndfile.pc" > "$FIXDIR/sndfile.pc"
  PKG_CONFIG_PATH="$FIXDIR" pkg-config --cflags --libs sndfile
  PKG_CONFIG_PATH="$FIXDIR" cmake -DENABLE_TESTS=ON …
  ctest --output-on-failure
rec_auto_fix:           false
rec_impl:               manual-repair-pc-copy

# ═══ Layer 4: 验证层 (Verification) ═══
verification_cmd:       pkg-config --exists sndfile && pkg-config --cflags --libs sndfile; ctest -N | tail -1; ctest --output-on-failure
verification_result:    libspecbleach 0.4.1：修复后 41/41 CTest 入口全注册并 PASS
                        （原 39/39，另恢复 test_audio_file_regression 与
                        test_integration_realworld_quality 两个 sndfile 门控入口）

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:                pc7-37
source_library:         libspecbleach 0.4.1
source_pr:              待定（feat/libspecbleach-0.4.1）
source_commit:          待定

