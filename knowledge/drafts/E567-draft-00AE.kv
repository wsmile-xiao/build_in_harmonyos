id:                     E567
trigger_tool: cmake|configure
phase: configuration
error_signature: No cmake_minimum_required command is present

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: build-system,cmake,compat,portability
match_keywords: cmake_minimum_required,CMP0000,CMake 4,present
title: 工程完全没有 cmake_minimum_required 时 CMake 4 直接硬报错，CMAKE_POLICY_VERSION_MINIMUM 不生效

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: grep -q '^cmake_minimum_required(VERSION 3.5)' CMakeLists.txt && cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=ohos.toolchain.cmake && cmake --build build 验证诊断是否正确的命令
root_cause: CMake 4.x 对缺少 cmake_minimum_required 的工程直接报错（CMP0000 硬错误）；-DCMAKE_POLICY_VERSION_MINIMUM 仅对已声明 <3.5 的工程生效，对完全没有该命令的工程无效
affected_scope: 2000 年代老 CMake 工程（如 dictconv 0.2）在 CMake 4.1.2 下交叉编译
verification_cmd: grep -q '^cmake_minimum_required(VERSION 3.5)' CMakeLists.txt && cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=ohos.toolchain.cmake && cmake --build build

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: patch-cmake-minimum
rec_description: 在顶层 CMakeLists.txt 顶部补 cmake_minimum_required(VERSION 3.5) 并以补丁归档（与 E321 的 cache_variables 路线区分；E321 适用已声明旧版本的工程）
rec_command: cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=ohos.toolchain.cmake && cmake --build build
rec_auto_fix: false
rec_impl: manual-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

