#====================================================================
# DRAFT-libbig_int-2.6-cmake-install-headers
#   上游 CMake 只 INSTALL(TARGETS) 不装头文件 → 包内 include/ 为空
#   —— 补 INSTALL(DIRECTORY include/ DESTINATION include)（尾斜杠勿丢）
# 来源: PR feat(libbig_int-2.6) libbig_int 2.6 适配 HarmonyOS PC
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-libbig_int-2.6-cmake-install-headers
trigger_tool:           cmake|conan
phase:                  installation|testing
error_signature:        make\s+install.*后\s+include/.*为空|
                        头文件.*未安装|
                        fatal error:.*\.h'?\s+file not found|
                        INSTALL\(TARGETS.*DESTINATION lib\)[^\n]*$(
                        不含\s+INSTALL\(DIRECTORY)

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               cmake, install, headers, consumer-packaging
match_keywords:         INSTALL(TARGETS), INSTALL(DIRECTORY include/),
                        DESTINATION include, 头文件未安装, include/include,
                        双层目录, only installs library, no headers,
                        libbig_int, CMakeLists, 尾斜杠, trailing slash
title:                  CMake 工程上游仅装库不装头：补 INSTALL(DIRECTORY include/ DESTINATION include) 且必须保留尾斜杠

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             老式单库 CMake 工程（如 libbig_int）只写
                        INSTALL(TARGETS big_int DESTINATION lib)，头文件留在 include/
                        但从不安装；Conan 包化后包内无 include/，消费者
                        #include <big_int.h> 失败。修复时若把尾斜杠写成
                        INSTALL(DIRECTORY include DESTINATION include)，会把
                        include/ 目录整体装成 include/include/（双层目录），
                        修复失效。
affected_scope:         上游 CMake 只 INSTALL(TARGETS ...) 不装头文件、且头文件
                        位于顶层 include/ 的库（libbig_int 类单库工程）。
                        airspyhf 类（头文件装到 include/<subdir>）不在此列，见 E217。
verification_cmd:       make install DESTDIR=$(pwd)/inst 2>&1 &&
                        find inst -name '*.h' | head &&
                        [ -f inst/usr/local/include/big_int.h ] &&
                        [ ! -d inst/usr/local/include/include ]

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           cmake-install-directory-headers
rec_description:        在上游 CMakeLists 补一行
                        INSTALL(DIRECTORY include/ DESTINATION include)；
                        include/ 的尾斜杠必须保留（=复制目录内容到
                        <prefix>/include），否则生成 include/include/ 双层目录。
                        与 E217（改 recipe package_info includedirs）互补：
                        本条修上游安装规则，E217 修消费者头文件路径。
rec_command:            sed -i '/^INSTALL(TARGETS/a INSTALL(DIRECTORY include/ DESTINATION include)' CMakeLists.txt
rec_auto_fix:           true
rec_impl:               source-patch

# 回退方案
fallback_priority:      2
fallback_approach:      recipe-copy-headers
fallback_description:   若上游 install 规则不可动（framework 工程等），在 recipe
                        package() 里 copy include/*.h 到 package include/。
fallback_command:       copy(self, "*.h", src=os.path.join(self.source_folder, "include"),
                        dst=os.path.join(self.package_folder, "include"))
fallback_auto_fix:      false
fallback_impl:          recipe-package

# ═══ Layer 4: 原则引用 ═══
principles:             P006, P011

# ═══ Layer 5: 关系 ═══
causes:                 []
caused_by:              []
similar_to:             [E217]
conflicts_with:         []
reuse:                  false
evidence_files:         ["archives/l/libbig_int/2.6/patches/0001-CMakeLists.txt.patch",
                         "archives/l/libbig_int/2.6/reports/knowledge-candidate-ledger.md"]