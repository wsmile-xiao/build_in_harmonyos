#====================================================================
# DRAFT-minlzma-1.1.5-github-tag-v-prefix-404
#    GitHub 上游 tag 名带 v 前缀时，conandata.yml 的 refs/tags/<ver>
#    直接 404 → 必须补 v 前缀 refs/tags/v<ver>
# 来源: minlzma 1.1.5 适配（Path B 知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-minlzma-1.1.5-github-tag-v-prefix-404
trigger_tool:           conan|ohc-run.py conan-verify|ohc-run.py conan create
phase:                  source|download
error_signature:        NotFoundException: Not found: .*refs/tags/[0-9]+\.[0-9]+|
                         Error in source\(\) method.*get\(self, \*\*self.conan_data\["sources"\]|
                         NotFoundException

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, packaging, source-url, github, tag-naming
match_keywords:         refs/tags, v 前缀, v-prefix, tag 名, GitHub tag, conandata,
                        sources url, NotFoundException, 404, tag archive, codeload
title:                  GitHub 上游 tag 带 v 前缀时 conandata.yml 必须写 refs/tags/v<ver>，写 refs/tags/<ver> 会 NotFoundException 404

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             部分 GitHub 仓库（ionescu007/minlzma 等）的 release tag 名为
                        "v1.1.5"（带 v 前缀）。conan-init 自动生成的 conandata.yml 默认按
                        version 名拼 refs/tags/1.1.5.tar.gz；GitHub 返回 404，conan 的
                        get() 抛 NotFoundException: Not found: <镜像>/.../refs/tags/<ver>。
                        仅凭 GitHub API tags 列表即可确认 tag 实际名（含 v）。
affected_scope:         任何上游 tag 带 v 前缀的 GitHub 源；conan create / conan-verify
                        source() 阶段直接失败，与配方编译、补丁无关。
verification_cmd:       curl -sS https://api.github.com/repos/<owner>/<repo>/tags \\
                        查看 name 字段是否带 v 前缀；curl -sSI <refs/tags/v<ver>>.tar.gz 应 200

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           conandata-tag-v-prefix-fix
rec_description:        conandata.yml（及外层 URL）的 sources.url 改为官方 tag 全名：
                        https://github.com/<owner>/<repo>/archive/refs/tags/v<ver>.tar.gz。
                        tag 名以 v 开头时保持 v 前缀不变；不带 v 的仓库不要加。改后重跑
                        conan-verify，source() 下载并 SHA-256 校验通过即为修复完成。
rec_command:            curl -sS https://api.github.com/repos/<owner>/<repo>/tags | head -20 && \\
                        （确认 tag 名后）编辑 conandata.yml url 为 refs/tags/v<ver>.tar.gz && \\
                        python3 scripts/ohc-run.py conan-verify <lib> <ver>
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:      gha-codeload-direct
fallback_description:   若官方 tag 不可达，可改用 https://codeload.github.com/<owner>/<repo>/tar.gz/refs/tags/v<ver>
                        官方 codeload 通道（写入 conandata 时仍需镜像可及性评估，R39 官方源约束）。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       file://|\.build-cache|predl_cache
forbid_1_reason:        本地缓存/文件路径不是官方源，违反 R39
forbid_1_consequence:   local_file_url 命中，PR 被拒

# ═══ Layer 4: 原则引用 ═══
principles:             R39, G1

# ═══ 关系图 (Relations) ═══
causes:
caused_by:
similar_to:             E276, E299, E483
conflicts_with:
prerequisite_of:

