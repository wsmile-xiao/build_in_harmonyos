#====================================================================
# DRAFT-gnustep-gui-gnustep-env-closure
# GNUstep GUI build must inherit the full GNUstep Make/Base environment closure
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: gnustep-gui 0.32.0 HarmonyOS PC 适配（PR #7095）
#====================================================================

id:                     DRAFT-gnustep-gui-gnustep-env-closure
trigger_tool:           configure|make|conan
phase:                  configure|build|testing
error_signature:        GNUSTEP_MAKEFILES.*not set|GNUstep makefiles not found|AppKit/AppKit.h file not found|gnustep-base.*headers.*not found|cannot find -lgnustep-base|undefined reference to objc_getClass

severity:               2
category:               autotools|gnustep|environment|objc|appkit
match_keywords:         GNUstep, GNUSTEP_MAKEFILES, GNUSTEP_CONFIG_FILE, GNUSTEP_SYSTEM_ROOT,
                         GNUSTEP_INSTALLATION_DOMAIN, gnustep-make, gnustep-base, AppKit,
                         Objective-C, CPPFLAGS, LDFLAGS, LD_LIBRARY_PATH

title:                  GNUstep GUI requires the full GNUstep Make/Base environment closure during configure, build, and test
root_cause: >
  GNUstep GUI is not a plain C library. Upstream configure and the generated GNUstep build
  rules expect GNUstep Makefiles, a configured GNUstep installation domain, and the base
  package's headers, libraries, and tools to be present in the same build and test context.
  If PATH, GNUSTEP_MAKEFILES, GNUSTEP_CONFIG_FILE, GNUSTEP_SYSTEM_ROOT, CPPFLAGS, LDFLAGS,
  or LD_LIBRARY_PATH are only partially propagated, configure can resolve the tree but the
  actual AppKit build or the consumer test_package will later miss headers, libraries, or
  helper tools.
affected_scope: >
  GNUstep AppKit packages built through Conan on OHOS/Linux targets, especially when the
  recipe uses gnustep-make as a tool requirement and gnustep-base as a public dependency.
verification_cmd: >
  Inspect the recipe's _gnustep_environment helper and use the same env for configure, build,
  and test_package; require the AppKit consumer to compile with AppKit/AppKit.h and the
  gnustep-base/gnustep-make package folders only.

rec_priority:           1
rec_approach:           environment-closure-from-package-folders
rec_description: >
  Prepend the gnustep-make bin directory and share/GNUstep/Makefiles to PATH and
  GNUSTEP_MAKEFILES, export GNUSTEP_CONFIG_FILE and GNUSTEP_SYSTEM_ROOT from the gnustep-base
  package folder, and inject base include/library paths into CPPFLAGS, LDFLAGS, and
  LD_LIBRARY_PATH before both configure and test_package. Keep GNUSTEP_INSTALLATION_DOMAIN at
  SYSTEM so the package does not drift to host-specific user domains.
rec_command: >
  export PATH="<gnustep-make>/bin:<gnustep-base>/Tools:$PATH";
  export GNUSTEP_MAKEFILES="<gnustep-make>/share/GNUstep/Makefiles";
  export GNUSTEP_SYSTEM_ROOT="<gnustep-base>";
  export GNUSTEP_CONFIG_FILE="<gnustep-base>/GNUstep.conf";
  export GNUSTEP_INSTALLATION_DOMAIN=SYSTEM;
  export CPPFLAGS="-I<gnustep-base>/Library/Headers $CPPFLAGS";
  export LDFLAGS="-L<gnustep-base>/Library/Libraries $LDFLAGS";
  export LD_LIBRARY_PATH="<gnustep-base>/Library/Libraries:$LD_LIBRARY_PATH"
rec_auto_fix:           false
rec_impl:               conan-recipe-environment-closure

fallback_priority:      2
fallback_approach:      source-tree-local-makefiles-with-explicit-prefix
fallback_description: >
  If the helper cannot synthesize the full environment, configure directly from a sourced
  GNUstep environment rooted in the package folders; do not rely on host /usr/share/GNUstep
  or host base headers.
fallback_command:       configure and build from the same package-folder GNUstep environment
fallback_auto_fix:      false
fallback_impl:          package-folder-env

forbid_1_pattern:       /usr/share/GNUstep|/System/Library/Frameworks|host-specific GNUstep path
forbid_1_reason:        Host paths make the package non-reproducible and break clean build/test sandboxes.
forbid_1_consequence:   A clean Conan consumer can pick up the wrong GNUstep installation or fail on another machine.

principles:             P016
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

