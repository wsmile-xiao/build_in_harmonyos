#====================================================================
# DRAFT-matchit-r01-gtest-ohpcd-offline-run
# 上游 gtest 套件在无 GitHub 直连 worker 上经 ohpcd 已发布 gtest 制品完整运行
# 触发事件: matchit 1.0.0 HarmonyOS PC 路径 B 适配（task matchit-1.0.0-r01-pc1-19）
#====================================================================

id:                     DRAFT-matchit-r01-gtest-ohpcd-offline-run
trigger_tool:           cmake|conan|ctest|clang++
phase:                  testing|configuration
error_signature:        FetchContent.*googletest.*failed|
                         Performing download step.*googletest|
                         curl.*github.com.*timed out|
                         googletest.*archive.*refs/tags.*failed
severity:               2
category:               testing, network, conan, ohos
match_keywords:         gtest, googletest, FetchContent, ExternalProject,
                         GitHub, offline, worker, ohpcd, registry, static lib,
                         clang++, gtest_main, gtest_discover_tests, unittests,
                         BUILD_TESTING, conan install, offline CI
title:                  上游 gtest 套件无 GitHub 直连时经 ohpcd 制品直链完整运行

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  上游 CMake 通过 FetchContent（如 cmake/FetchGTest.cmake 的 GIT_REPOSITORY
  github.com/google/googletest）在 configure 期拉取 gtest 源码；而 CI/worker 网络策略
  禁止直连 github.com（curl 超时），导致上游测试无法按原始配置构建。与 E342 的不同点：
  E342 主路径是 BUILD_TESTING=OFF 放弃网络化上游测试；本候选在 gtest 已由 ohpcd registry
  发布（本基线 gtest/1.17.0）时，可用 conan 制品直链完整编译运行上游测试套件，
  不牺牲上游测试覆盖，也无须注入第三方源码。

affected_scope: >
  所有上游测试以 FetchContent/ExternalProject 引导 googletest、且 ohpcd registry 已发布
  gtest 制品的 Conan 包（Conan 2，OHOS/Linux 交叉编译环境）。可跨库复用：得到 gtest 头文件与
  静态库即可直接链接，无需上游 FetchContent 网络路径。

verification_cmd: >
  conan install --requires=gtest/1.17.0 -r=ohpcd -pr:h=ci/conan/profiles/ohos-aarch64 --build=missing;
  clang++ -std=c++17 -Iinclude -I<gtest>/include <test_srcs...> -L<gtest>/lib -lgtest_main -lgtest
  -lpthread -o unittests; ./unittests

principles:             P014
rec_priority:           1
rec_approach:           registry-gtest-offline-run-upstream-suite
rec_description: >
  (1) conan install gtest 制品（-r=ohpcd）拿到 include/ 与 libgtest_main.a/libgtest.a；
  (2) 用目标工具链 clang++ 直接编译上游用户测试源（test/**/*.cpp），链接 gtest 静态库；
  (3) 运行 ./unittests 获得真实上游套件结果，计入全量通过率；
  (4) 保持配方 build() 不依赖网络（header-only 库为接口库时 build() 可为 no-op），
      上游套件结果以本地适配证据回报，不注入配方网络依赖；
  (5) gtest 仅测试期使用，不入配方运行时 requirements（测试框架属 tool_requires 语义）。
rec_command: >
  conan install --requires=gtest/1.17.0 -r=ohpcd -pr:h=ci/conan/profiles/ohos-aarch64 --build=missing
  && /data/service/hnp/bin/clang++ -std=c++17 -I include -I $GT_INC test/matchit/*.cpp
     -L $GT_LIB -lgtest_main -lgtest -lpthread -o unittests && ./unittests
rec_auto_fix:           false
rec_impl:               knowledge-draft
caused_by:              E342
causes: