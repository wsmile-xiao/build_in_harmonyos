#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E545.kv，填写各字段
# 对应的人类文档: doc/E545.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E545
trigger_tool: configure
phase: configuration
error_signature: OS .*ohos.*not recognized|Kernel .*linux.*not known to work with OS .*ohos

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: autotools, detection, compat
match_keywords: config.sub, kernel-os-obj, kernel-os, linux-ohos*-, suffix arity, case expression
title: config.sub 组合校验的字段数决定 OHOS 分支尾部连字符

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: E122/E268 的 linux-ohos*- 是三字段 kernel-os-obj 模式；两字段 kernel-os 中匹配值为 linux-ohos，不含尾部空 obj 分隔符，照搬该模式会永远不匹配。 Even a tiny valid binary parser fixture can be lost by a text-only PR diff. Text encoding does not permit replacing it with an empty or header-only sample: validate the complete decoded size/hash before the original positive parser test reads it. Autoconf creates config.status scratch directories in two branches with owner-only masks. On HMDFS, changing file modes later or repairing PR transport cannot establish creation-time access. Replace both creation branches with exclusive mkdir under the recipe-private TMPDIR, use umask 022 at creation, restore configure timestamps, and prefix TMPDIR after Conan environment activation. Preserve cleanup and every original test.
affected_scope: 具有独立 kernel/OS 验证的 GNU config.sub；不适用于只使用单一带前导连字符 os 的旧解析器。
verification_cmd: 从官方 release 源码检查 case 表达式、分支顺序及 ;;；对正式补丁执行干净源码 dry-run 与目标机端到端验证

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: inspect-real-case-control-flow
rec_description: 先读取实际 case 表达式而非按年份选方案；kernel-os 使用 linux-ohos*，kernel-os-obj 使用 linux-ohos*-。分别核对 OS 表和组合表，不以全文件关键词存在代替。 Even a tiny valid binary parser fixture can be lost by a text-only PR diff. Text encoding does not permit replacing it with an empty or header-only sample: validate the complete decoded size/hash before the original positive parser test reads it. Autoconf creates config.status scratch directories in two branches with owner-only masks. On HMDFS, changing file modes later or repairing PR transport cannot establish creation-time access. Replace both creation branches with exclusive mkdir under the recipe-private TMPDIR, use umask 022 at creation, restore configure timestamps, and prefix TMPDIR after Conan environment activation. Preserve cleanup and every original test.
rec_command: sh -n config.sub; sh config.sub aarch64-unknown-linux-ohos; 核对输出逐字等于输入并检查 configure build/host 身份
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: timestamp-only-hunk-count|blind-linux-ohos-suffix-copy
forbid_1_reason: 脚本年代和全文关键词不能证明匹配值、字段数或路径可达性。
forbid_1_consequence: 未命中补丁或重复死分支，仍可能错误归一为 Linux GNU。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E072, E122, E268
conflicts_with:         []
prerequisite_of:        []

