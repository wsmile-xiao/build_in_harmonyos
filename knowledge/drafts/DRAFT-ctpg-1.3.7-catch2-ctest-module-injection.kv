#====================================================================
# DRAFT-ctpg-1.3.7-catch2-ctest-module-injection - 上游 CMake 用
# include(Catch)/catch_discover_tests 注册 Catch2 用例时，已打包的
# header-only catch2 包缺 CTest 集成模块 → 注入最小 Catch.cmake
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-ctpg-1.3.7-catch2-ctest-module-injection
source_lib:             ctpg 1.3.7
trigger_tool:           conan|conan create|cmake|catch2|ctest
phase:                  configuration|testing
error_signature:        include could not find requested file: Catch|Unknown CMake command "catch_discover_tests"|Catch\.cmake.*not found|include\(Catch\)

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan|packaging|header-only|catch2|cmake|ctest|testing
match_keywords:         include(Catch), catch_discover_tests, Catch.cmake, Catch2::Catch2, find_package(Catch2), ctest, CTest integration, header-only, ohpcd, contrib 模块, CMAKE_MODULE_PATH
title:                  上游 CMake 用 include(Catch)/catch_discover_tests 时，ohpcd header-only catch2 包缺 CTest 集成模块 → 注入最小 Catch.cmake 到 CMAKE_MODULE_PATH

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  Catch2 2.x 官方把 ctest 用例注册宏 catch_discover_tests 随框架安装的 contrib
  模块（Catch.cmake）提供，上游项目在 CMakeLists 中直接写
  `find_package(Catch2 2 REQUIRED)` + `include(Catch)` +
  `catch_discover_tests(testbin)`。ohpcd 制品仓的 catch2/2.13.10-r0 配方按
  header-library 最小打包只复制 single_include/catch2 头文件，不含
  Catch.cmake/contrib 模块。因此 CMakeDeps 生成 Catch2Config.cmake 后
  find_package 命中 Catch2::Catch2 target，但 include(Catch) 仍报
  "include could not find requested file: Catch"，随后
  catch_discover_tests 报 "Unknown CMake command"。这是"测试框架包已发布但
  打包不完整"导致的配置期失败，不是当前库源码缺陷。

affected_scope: >
  所有上游 CMakeLists 用 find_package(Catch2 2 REQUIRED) + include(Catch) +
  catch_discover_tests 注册用例的 C++ 库，在 ohpcd catch2/2.13.10-r0（或任何
  不含 contrib 模块的 header-only catch2 打包）下的 Conan 2.x 配方落地；
  对 header-only 库测试仅秒级时无条件运行测试（R51 上游测试三步法）。

verification_cmd: >
  conan create archives/c/ctpg/1.3.7 -pr:h=ci/conan/profiles/ohos-aarch64
  -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing --user=ohpcd --channel=stable
  2>&1 | grep -qE 'Test #1: testbin.*Passed'; testbin 实跑输出
  "All tests passed (319 assertions in 52 test cases)"

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           minimum-catch-cmake-injection
rec_description: >
  conanfile.py generate() 中当 can_run(self)（本机构建可运行测试）时，创建
  最小 Catch.cmake 模块文件到 build_folder 下的 cmake-modules 目录，内容为：
  function(catch_discover_tests TARGET) add_test(NAME ${TARGET} COMMAND ${TARGET})
  endfunction()；并把该目录设为 CMakeToolchain 变量 CMAKE_MODULE_PATH。这样
  上游 include(Catch) 找到模块、catch_discover_tests 把 testbin 注册为单个
  ctest 用例（testbin 内含全部 Catch2 TEST_CASE，52 个用例全执行），
  build() 中 CMake.build() + CMake.test() 正常驱动上游测试，不改上游源码、
  不产生补丁 diff、不影响 package() 产物。同时用 generators="CMakeDeps"
  保证 find_package(Catch2) 命中制品仓包。
rec_command: >
  conanfile.py: generators = "CMakeDeps"; requirements(): can_run(self) 时
  self.requires("catch2/2.13.10-r0"); generate(): 写最小 Catch.cmake 到
  os.path.join(self.build_folder, "cmake-modules") 并
  tc.variables["CMAKE_MODULE_PATH"] = mod_dir; build(): cmake.configure/build/test
rec_auto_fix:           false
rec_impl:               conan-recipe-cmake-module-injection

fallback_priority:      2
fallback_approach:      refresh-patch-patch-out-catch-discover
fallback_description:   若不允许注入 CMAKE_MODULE_PATH（如严格只读工具链场景），
                        可把 include(Catch)/catch_discover_tests 两行从上游
                        CMakeLists 以 refresh-patch --auto 打补丁移除，
                        改用手写 add_test 注册，但会改动上游源码产生补丁 diff。
fallback_command:       python3 scripts/ohc-run.py refresh-patch ctpg 1.3.7 --auto
fallback_auto_fix:      false
fallback_impl:          patch-pipeline

forbid_1_pattern:       FetchContent_Declare.*(Catch2|catch2)|add_subdirectory\(.*Catch2[^)]*\).*empty|只注释掉测试
forbid_1_reason:        上游测试必须真实构建运行（R51）；用 network fetch 或空
                        submodule 回退会引入外部源依赖或破坏测试入口。

# ═══ Layer 4: 防护层 (Guard) ═══
guard_pattern:          include\(Catch\)|catch_discover_tests\(
guard_check:            配置期若报 "include could not find requested file: Catch"
                        或 "Unknown CMake command catch_discover_tests" 即命中本模式

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:                pc3-6
source_lib:             ctpg 1.3.7
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.95
metrics_last_used:      2026-09-05

doc_file:               drafts/DRAFT-ctpg-1.3.7-catch2-ctest-module-injection.md