#====================================================================
# DRAFT-libpano13-2.9.23-cmake-if-unix-silent-ansi-macro
# 上游 CMakeLists 用 IF(UNIX) ADD_DEFINITIONS 定义功能宏，OHOS 上 UNIX 为假
# 宏静默缺失 → C 源码条件编译落入 X11/GUI 分支需要 GIMP/GTK 头文件；
# 用 conanfile 的 CMAKE_C_FLAGS 注入 -D__Ansi__ 切回纯 ANSI 分支
#====================================================================

id:                     DRAFT-libpano13-2.9.23-cmake-if-unix-silent-ansi-macro
trigger_tool:           cmake|conan|gcc|clang
phase:                  compilation
error_signature:        sys_X11\.h.*libgimp/gimp\.h.*not found|sys_X11\.h.*gtk/gtk\.h.*not found|PTDialogs\.c.*fatal error|IF\(UNIX\).*ADD_DEFINITIONS|#if.*__Mac__.*__Win__.*__Ansi__

severity:               2
category:               ohos, cmake, platform-detection, gui
match_keywords:         __Ansi__, sys_X11.h, PTDialogs.c, libgimp, gtk, GIMP, IF(UNIX), ADD_DEFINITIONS, UNIX 变量, 平台宏, 条件编译分支, GUI 头文件, HarmonyOS, CMAKE_C_FLAGS

title:                  上游 CMakeLists 的 IF(UNIX) ADD_DEFINITIONS 在 OHOS 静默失效，C 源码落入 X11/GUI 分支报 libgimp/gtk 头缺失；conanfile 用 CMAKE_C_FLAGS 注入 -D__Ansi__ 切回 ANSI 分支

root_cause:             CMake 在 OHOS 工具链下将 CMAKE_SYSTEM_NAME 设为 "HarmonyOS"，UNIX 变量为假，CMakeLists 里 `IF(UNIX) ADD_DEFINITIONS(-D__Ansi__)` 静默不生效、宏缺失；源码条件编译 `#if !__Mac__ && !__Win__ && !__Ansi__` 落入 X11 分支 include sys_X11.h（依赖 libgimp/gimp.h + gtk/gtk.h）→ fatal error。与 E532 同根（CMake UNIX 变量在 OHOS 为假），但 E532 是显式三分支 FATAL_ERROR，本条目是 IF(UNIX) 静默失效导致功能宏未定义、编译期 GUI 头报错。

affected_scope:         上游用 IF(UNIX) 控制功能宏、且源码用条件编译平台宏选择
                        GUI/X11/终端分支的 CMake 库；libpano13 2.9.23 实证
                        （PTDialogs.c + sys_X11.h）；无 GUI 依赖的纯 ANSI 分支存在时适用

verification_cmd:       |
  conan create . --version=<ver> -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing 2>&1 | grep -E "libgimp|sys_X11|fatal error"
  # 修复前：PTDialogs.c:35 include sys_X11.h → libgimp/gimp.h not found
  # 修复后：无 GUI 头错误，全量编译通过

rec_priority:           1
rec_approach:           inject-ansi-macro-via-cmake-c-flags
rec_description:        在 conanfile.py build() 的 cmake 参数加 -DCMAKE_C_FLAGS=-D__Ansi__，
                        使 C 源码条件编译选择纯 ANSI 分支（无 GIMP/GTK/X11 依赖），
                        不改上游源码、不打补丁。原理：功能宏由编译标志注入，绕开
                        CMakeLists 里依赖 UNIX 变量（OHOS 上为假）的 ADD_DEFINITIONS。
rec_command:            defs.append("-DCMAKE_C_FLAGS=-D__Ansi__")
rec_auto_fix:           true
rec_impl:               conanfile-cmake-flag

fallback_priority:      2
fallback_approach:      harmonyos-into-unix-branch
fallback_description:   E532 的方案：把 CMakeLists 平台判定改为 elseif(UNIX OR CMAKE_SYSTEM_NAME
                        STREQUAL "HarmonyOS") 使 HarmonyOS 落入 UNIX 分支，恢复 ADD_DEFINITIONS。
                        需打 patch 且改动上游 CMakeLists，仅在无 ANSI 分支可选时使用。
fallback_command:       sed -i 's/IF(UNIX)/IF(UNIX OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS")/' CMakeLists.txt
fallback_auto_fix:      false
fallback_impl:          conanfile-patch

principles:             P010
causes:                 []
caused_by:              []
similar_to:             [E532, E463]
conflicts_with:         []
prerequisite_of:        []

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:                OpenDesk
source_event:           libpano13-2.9.23-adaptation
