# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool:           configure|cmake|meson|make|gcc|clang|ld|python|pip|install|test|runtime
phase: compilation|linking
error_signature: Error running link command: no such file or directory

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: ohos, cmake, toolchain, archive
match_keywords: llvm-ranlib, CMAKE_RANLIB, CMAKE_AR, llvm-ar, static archive, cmake_link_script
title: OHOS SDK 缺 llvm-ranlib：纯 CMake 项目显式指定 CMAKE_RANLIB 引用 hnp/bin 预置 softlink

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS SDK native/llvm/bin 缺 llvm-ranlib，CMake 推断 RANLIB 为不存在路径；/data/service/hnp/bin/llvm-ranlib 是 SDK 预置 multi-call softlink 可直接引用
affected_scope: 纯 CMake 顶层项目静态库构建（非 Cargo 子构建场景）
verification_cmd: test ! -x /data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/bin/llvm-ranlib; test -x /data/service/hnp/bin/llvm-ranlib; cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=ohos.toolchain.cmake -DCMAKE_AR=/data/service/hnp/bin/llvm-ar -DCMAKE_RANLIB=/data/service/hnp/bin/llvm-ranlib && cmake --build build

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: cmake-configure-explicit-ranlib
rec_description: CMake 配置时显式指定 CMAKE_AR/CMAKE_RANLIB 指向 /data/service/hnp/bin 下 SDK 预置的 llvm multi-call softlink，无需 wrapper 或 overlay
rec_command: cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=<ohos.toolchain.cmake> -DCMAKE_AR=/data/service/hnp/bin/llvm-ar -DCMAKE_RANLIB=/data/service/hnp/bin/llvm-ranlib
rec_auto_fix:           false
rec_impl:               cmake-configure-flags

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
