#====================================================================
# DRAFT-ohos-rust-cargo-no-toolchain.kv — OHOS 无 Rust 工具链，Rust/cargo 项目不可适配
#====================================================================

id:                     DRAFT-ohos-rust-cargo-no-toolchain
trigger_tool:           conan|rust|cargo
phase:                  selection|build
error_signature:        rustc.*not found|cargo.*not found|No matching toolchain.*rust|rust-unsupported-platform

severity:               3
category:               toolchain, rust, ohos, selection
match_keywords:         rust, cargo, rustc, toolchain, crate, cargoHash, buildRustPackage,
                        linux-ohos, 不可适配, hmmac, static ELF, execve
title:                  Rust/cargo 项目在 OHOS 无 linux-ohos 官方工具链端口且 hmmac 封锁预构建 ELF——选型阶段即判不可适配（adguardhome/illuminanced 先例）

root_cause:             OHOS 沙箱无 linux-ohos 官方 Rust 工具链端口（rustc/cargo 目标 triples 不含 OHOS，与 Go 相同），ohpcd 制品仓亦无 Rust 工具链包；且 hmmac MAC 安全策略封锁"下载来的预构建静态 ELF"执行（execve errno=13，官方 Go 工具链先例）——Rust 项目（cargo build，依赖 crates.io）在 OHOS 上无任何可编译路径。
affected_scope:         所有 Rust/cargo 项目（含纯 Rust daemon/工具，如 illumina/illuminanced、AdGuardHome(Go 同型)）；选型阶段可判不可适配，避免创建分支浪费。
verification_cmd:       which rustc cargo 2>/dev/null；ls /data/service/hnp/bin | grep -iE 'rust|cargo'；conan search rust -r=ohpcd

rec_priority:           1
rec_approach:           reject-at-selection
rec_description:        contrib 候选评估阶段即检测语言：Rust/cargo 项目（有 Cargo.toml）直接判不可适配，同 Go 项目先例；不必创建纯净分支/四件套/消费者用例（无法本地/CI 构建验证）。可选走路径 B 沉淀"不可适配原因"知识。
rec_command:            选型检查：上游仓库根目录存在 Cargo.toml → 判 Rust；沙箱 which rustc/cargo 无结果 → 不可适配
rec_auto_fix:           false
rec_impl:               selection-check

fallback_priority:      2
fallback_approach:      knowledge-contribution
fallback_description:   若项目要求该库仍须申报，走路径 B（知识库贡献）：以"OHOS 无 Rust 工具链"为问题层写 DRAFT 条目并申报【知识库扩展】PR（同 adguardhome 先例已申报）。
fallback_command:       编写 DRAFT-ohos-rust-cargo-no-toolchain.{kv,md}，PR 标题【知识库扩展】
fallback_auto_fix:      false

forbid_1_pattern:
principles:
causes:
caused_by:
similar_to:             adguardhome（Go 无 OHOS 工具链先例）；E057/E074（MAKEFLAGS/工具链类）
conflicts_with:
prerequisite_of:

doc_file:               doc/DRAFT-ohos-rust-cargo-no-toolchain.md
last_updated:           2026-09-21
