#====================================================================
# Draft knowledge entry - eigen header-only L5 evidence standard
# Source package: eigen/3.4.1
#====================================================================

id:                     DRAFT-eigen-3.4.1-header-only-l5-evidence
trigger_tool:           conan|cmake|shadow-ci
phase:                  packaging|testing|ci-gate
error_signature:        L2_RESULT=skip: no bin/ dir|L5_RESULT=warn: no artifacts found|no bin/ dir|no artifacts found

severity:               2
category:               conan|header-only|test-package|artifact-validation
match_keywords:         eigen, header-only, L5 warning, no artifacts, no bin directory, include/eigen3, CMakeDeps, pkgconfig, destructive negative test
title:                  Header-only eigen packages need include and consumer evidence when L5 has no binaries

root_cause:             Binary-oriented gates cannot validate a header-only package by finding bin/lib
                        artifacts. The relevant artifact contract is the installed include tree plus
                        consumer metadata, and false positives are possible if the test uses source-tree
                        headers.
affected_scope:         Header-only C++ packages with no bin/lib output, especially those that install CMake
                        package files or pkg-config metadata for downstream consumers.
verification_cmd:       CI_PACKAGES="archives/e/eigen/3.4.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           header-only-consumer-plus-negative-test
rec_description:        Accept L2 skip and L5 warning only after verifying installed include/metadata
                        directories, building the consumer through Conan CMakeDeps/CMakeToolchain, running
                        the target binary, and confirming a destructive negative test fails without the
                        packaged headers.
rec_command:            conan create archives/e/eigen/3.4.1 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
rec_auto_fix:           false
rec_impl:               test-package

fallback_priority:      2
fallback_approach:      metadata-only-warning
fallback_description:   If target execution is not allowed, record the executable policy skip and keep the
                        package as compile-only evidence until a device run is available.
fallback_command:       find <package-folder> -maxdepth 4 -type d -o -type f | sort | sed -n '1,80p'
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       no artifacts found.*pass|header-only.*skip.*complete
forbid_1_reason:        A header-only package can still be unusable if include paths or generated consumer metadata are wrong.
forbid_1_consequence:   Downstream builds fail even though CI recorded a harmless-looking L5 warning.

similar_to:             [E035,E307,E309]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-eigen-3.4.1-header-only-l5-evidence.md
last_updated:           2026-08-28
source_event:           eigen/3.4.1 shadow CI r2 header-only L2 skip and L5 warning with passing consumer test

authors:                codex <codex@noreply.local>
