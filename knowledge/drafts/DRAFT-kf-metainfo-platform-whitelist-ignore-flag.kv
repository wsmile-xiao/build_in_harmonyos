#====================================================================
# DRAFT - ECM KDEMetaInfoPlatformCheck 按 metainfo.yaml 平台白名单比对 CMAKE_SYSTEM_NAME，未收录平台（HarmonyOS/OHOS）FATAL_ERROR
# contributor: why6666666
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-kf-metainfo-platform-whitelist-ignore-flag
trigger_tool:           cmake|ECM
phase:                  configuration
error_signature:        Your current platform '.*' is not supported|KDEMetaInfoPlatformCheck|KF_IGNORE_PLATFORM_CHECK|metainfo\.yaml

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               平台探测, cmake, kf6-ecm, ohos
match_keywords:         KF_IGNORE_PLATFORM_CHECK, KDEMetaInfoPlatformCheck, metainfo.yaml, Your current platform, not supported, find_package(KF6, HarmonyOS, platforms
title:                  ECM KDEMetaInfoPlatformCheck 按 metainfo.yaml 平台白名单硬性 FATAL，未收录平台（HarmonyOS/OHOS）须显式设 KF_IGNORE_PLATFORM_CHECK=ON

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             >
  完整因果链（各环均有设备实测证据，见 verification_cmd）：
  ① KF6/ECM 生态项目经平台门禁链路 include KDEMetaInfoPlatformCheck.cmake，
  模块在 :23 option(KF_IGNORE_PLATFORM_CHECK ... OFF)，:24-28 同时接受环境变量
  KF_IGNORE_PLATFORM_CHECK=ON；
  ② 未设开关时 :32 file(STRINGS metainfo.yaml) 解析源码目录 metainfo.yaml 的
  platforms: 清单，仅按硬编码映射比对 Linux/FreeBSD/OpenBSD/Windows/macOS/
  Android/iOS/All（:39-70），HarmonyOS/OHOS 不在映射中 →
  _MetainfoFoundSupportedPlatform 保持 FALSE；
  ③ :79 message(FATAL_ERROR "Your current platform 'HarmonyOS' is not
  supported...")，configure 直接终止（设备探针无开关 RUN1_EXIT=1，真实失败
  日志见 evidence 归档路径）；注意白名单解析按 "name:" 子串匹配，注释行
  "#- name: Android" 也会被计入候选清单（探针实证的解析 quirk）；
  ④ 归类：上游发行策略白名单（metainfo.yaml 是 release-metadata 声明面）在
  未知平台上的平台探测门禁，非技术能力缺失——设备上 clang/ECM/KF6 全链路
  可用（libkomparediff2 26.04.0 上游 2/2 ctest 实证），故走官方开关放行并
  在 PR 披露是合规解法。
affected_scope:         任何在 KDE/ECM 白名单外平台（CMAKE_SYSTEM_NAME 不为 Linux/FreeBSD/OpenBSD/Windows/Darwin/Android/iOS）上配置含 metainfo.yaml 平台门禁的 KF6/ECM 生态项目的项目
verification_cmd:       |
  # 自包含探针：真实 tarball 的 metainfo.yaml + 真实 ECM 模块，project(NONE) 无需编译器
  # ECM 路径按设备实际调整（示例为 ecm/6.26.0 conan cache）
  ECMK=/storage/Users/currentUser/.conan2/p/ecm8b92b6d048cee/p/share/ECM/kde-modules
  mkdir -p probeA && cd probeA
  printf 'cmake_minimum_required(VERSION 3.16)\nproject(p NONE)\ninclude("${ECM_KDE_MODULES}/KDEMetaInfoPlatformCheck.cmake")\nmessage(STATUS "CHECK_PASSED")\n' > CMakeLists.txt
  cp <tarball 解压目录>/metainfo.yaml .   # libkomparediff2-26.04.0.tar.xz（sha256 b05d1eed…；platforms: Linux/FreeBSD/Windows）
  # 1) 无开关：FATAL_ERROR，非 0 退出
  cmake -S . -B b1 -DECM_KDE_MODULES=$ECMK ; echo "exit=$?"      # → exit=1；"Your current platform 'HarmonyOS' is not supported. The list of supported platorms is 'Linux;FreeBSD;Windows;Android'"
  # 2) 有开关：通过
  cmake -S . -B b2 -DECM_KDE_MODULES=$ECMK -DKF_IGNORE_PLATFORM_CHECK=ON ; echo "exit=$?"   # → exit=0；CHECK_PASSED
  # 设备实证归档（含工具实现证据 grep）：/storage/Users/currentUser/tmp/oh-device-porting-v2/libkomparediff2-26.04.0/probe-kf-ignore-platform-check.log

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           kf-ignore-platform-check-flag
rec_description:        显式设 KF_IGNORE_PLATFORM_CHECK=ON（CMakeToolchain 变量、cmake -D 或同名环境变量三者皆可，模块 :23-28 全认）。白名单是上游发行策略声明而非技术能力探测：OHOS 上 clang/ECM/KF6 全链路可用（libkomparediff2 26.04.0 上游 2/2 ctest 实证），放行后必须在 PR 适配路径披露白名单外平台身份并保留真实构建+上游测试证据。配方树 113 个 conanfile.py 同模式实践（grep archives --include=conanfile.py 实测），L2 第二实例成立。
rec_command:            conanfile.py generate(): tc.variables["KF_IGNORE_PLATFORM_CHECK"]="TRUE"；或 cmake -DKF_IGNORE_PLATFORM_CHECK=ON；或 env KF_IGNORE_PLATFORM_CHECK=ON
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      system-name-lower-to-linux
fallback_description:   以 -DCMAKE_SYSTEM_NAME=Linux 使白名单比对通过（HarmonyOS 内核兼容 Linux 用户态子集，部分上游检测据此放行）。诚实权衡：掩盖真实系统名，后续所有平台相关检测（Platform 模块加载链、E383 的 SONAME flag 缺失面、系统 API 探测）都会按 Linux 走，问题归因难度显著上升；仅个别上游检测确需"视为 Linux"时局部使用，不作主方案。
fallback_command:       cmake -DCMAKE_SYSTEM_NAME=Linux ...（并在 PR 披露该伪装面）
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       修改 ECM/KDEMetaInfoPlatformCheck.cmake|注释掉上游 include 或平台检查
forbid_1_reason:        污染共享 ECM 安装（conan cache 为多 run 共享状态）与上游判定面；官方本就提供 KF_IGNORE_PLATFORM_CHECK 开关，改模块毫无必要，且 ECM 升级即丢失改动。
forbid_1_consequence:   隐性改动被其他 run 继承，门禁与复现全部失真，属于态度审计"不污染上游判定"的违反。

forbid_2_pattern:       仅设开关放行、无真实构建与上游测试证据即宣称已适配
forbid_2_reason:        白名单是声明面，放行不等于可用；能力必须以真实构建+上游测试证据支撑（本 run：BUILD_TESTING=ON 上游 2/2 ctest + test_package 1/1）。
forbid_2_consequence:   依赖缺失/测试空转的"假适配"进入发布面，L1 门禁与态度审计双双失守。

# ═══ Layer 4: 原则引用 ═══
principles:             [P-BUILD-001, P-ENV-001]

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E092, E090, E383]
conflicts_with:         []
prerequisite_of:        []

