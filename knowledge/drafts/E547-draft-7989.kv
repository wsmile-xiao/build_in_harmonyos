#====================================================================
# E547 draft - automake all-local/clean-local 相对 cd 在 out-of-tree 构建失败
# 触发事件: maxminddb 1.13.3 HarmonyOS PC 适配（archives/m/maxminddb/1.13.3）
# 主从明确：这是 autotools out-of-tree 构建的 VPATH 适配知识，与 E434(earlier
#           copystamp) 不同签名；conan basic_layout build_folder 构建时必然命中。
#====================================================================

id:                     E547
trigger_tool:           make / conan create
phase:                  compilation
error_signature:        cd libtap: No such file or directory.*all-local|cd [a-zA-Z0-9_-]+: No such file or directory.*make\[[0-9]+\].*all-local

severity:               2
category:               autotools, out-of-tree, conan, all-local, VPATH
match_keywords:         all-local, clean-local, out-of-tree, cd libtap, No such file or directory, automake, VPATH, top_srcdir, conan build_folder, basic_layout
title:                  automake all-local/clean-local 的 `cd <相对子目录>` 在 out-of-tree 构建（conan build_folder）中找不到源码子目录，需改用 $(top_srcdir) 前缀

root_cause:             上游 t/Makefile.am 的 all-local/clean-local 写死 `cd libtap` 相对路径
                        （内嵌独立子目录如 t/libtap 的构建目标）；in-tree 构建可用，但
                        conan basic_layout 将构建放到 build-release 独立目录，该目录无
                        libtap 子目录，cd 失败导致整树 make 中止（E052 之外的另一类
                        autotools 目录假设）。

affected_scope:         含 automake all-local/clean-local 且内嵌独立子目录（如 t/libtap）
                        的 autotools 项目，被 conan 以 out-of-tree（basic_layout
                        build_folder）构建时都受影响；非 conan 的 out-of-tree VPATH
                        构建同样命中。

verification_cmd:       |
                        cd <build-dir> && make -j1   # 复现: cd libtap: No such file or directory
                        grep -n 'cd libtap' t/Makefile.in  # 定位 all-local
                        # 修复后: make -j1 通过；conan create 通过 G2

rec_priority:           1
rec_approach:           use-top-srcdir-in-all-local
rec_description:        将 t/Makefile.in（或 ac 源）all-local/clean-local 的 `cd libtap && $(MAKE)`
                        改为 `cd $(top_srcdir)/t/libtap && $(MAKE)`（clean 同理）；
                        out-of-tree 构建目录不再需要镜像源码子目录。VPATH 友好修复，无平台宏。

forbid_1_pattern:       修改 ci/ 或 SKILL 框架文件规避
forbid_1_reason:        框架只读；应修配方补丁
forbid_1_consequence:   PR 被框架混入检查拦截

similar_to:             E434
caused_by:              []
causes:                 []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E547.md
last_updated:           2026-09-07
source_event:           maxminddb 1.13.3 HarmonyOS PC 适配
authors:                AtomCode（oh-executor pc4-5）
