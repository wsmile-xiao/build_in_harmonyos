#====================================================================
# DRAFT-ayatana-accountsservice-required-dep-optional-stub.kv
# pkg_check_modules REQUIRED 系统级依赖缺失 → CMake 选项降级 + #ifdef 编译开关 + stub
# Draft only. Do not promote into knowledge/graph until promoted.
#====================================================================

id:                     DRAFT-ayatana-accountsservice-required-dep-optional-stub
trigger_tool:           conan|cmake|pkg-config|make
phase:                  configuring|building|linking
error_signature:        Unable to find a build system|The pkg-config script .* could not be found|
                         Package .* not found|accountsservice|REQUIRED|No package .* found|
                         error: No package '.*' found
severity:               2
category:               dependency|pkgconfig|cmake|system-daemon|stub|toolchain
match_keywords:         accountsservice, pkg_check_modules, REQUIRED, pkg-config missing,
                         system daemon, GSettings, Intltool, stub, compile switch, ENABLE_*
                         option, HAVE_*, HarmonyOS, OHOS
title:                  pkg_check_modules REQUIRED 系统级依赖缺失（如 accountsservice）→ 降级为 CMake 可选选项 + #ifdef 编译开关 + stub 实现
root_cause:             Ayatana/GNOME 系服务把系统守护进程的客户端库（如 accountsservice，
                         GSettings/Intltool CMake 模块）列为 pkg_check_modules REQUIRED 依赖。
                         HarmonyOS 无对应制品仓配方、无 AccountsService 守护进程，REQUIRED
                         直接 configure 失败。正确做法是给 CMake 增加 ENABLE_* 可选选项：
                         关闭时不 REQUIRED，并把依赖源码以 HAVE_* 编译开关包裹，OFF 时编译
                         stub（符号齐全、行为退化），保证服务主体可构建、可链接、可运行。
affected_scope:         Ayatana indicator 家族（display/session/messages/a11y/power）、
                         任何依赖 accountsservice/GSettings/Intltool/gtk-doc 的 GNOME/桌面服务
                         在 HarmonyOS 上的适配。
verification_cmd:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing

rec_priority:           1
rec_approach:           dep-optional-plus-compile-switch-plus-stub
rec_description:        (1) 顶层 CMakeLists 给每个缺失依赖加 option(ENABLE_* "..." ON)；
                        关闭时把该依赖从 pkg_check_modules REQUIRED 列表移除（保留
                        glib/gio 等真实存在的依赖）。(2) 源文件里用
                        #ifdef HAVE_ACCOUNTS_SERVICE 包裹 act/act.h 实现，OFF 分支编译
                        stub——ref_default 返回空 GObject、set_* 为 no-op、get_* 恒 FALSE，
                        保证对外符号齐全。(3) 找到依赖时 list(APPEND *_INCLUDE_DIRS/*_LIBRARIES)
                        并 add_definitions(-DHAVE_*)，未找到时静默跳过。配套 SKIP_DATA_PO /
                        SKIP_DOC 选项跳过 GSettings/Intltool/gtk-doc 子目录。
rec_command:            # conanfile.py generate():
                        #   tc.variables["ENABLE_ACCOUNTS_SERVICE"] = "OFF"
                        #   tc.variables["SKIP_DATA_PO"] = "ON" ; SKIP_DOC = "ON"
                        #   tc.variables["ENABLE_INTROSPECTION"] = "OFF"
                        # patches/0001: CMakeLists 加选项 + 条件 REQUIRED + 条件 add_subdirectory
                        # patches/0002: im-accounts-service.c 加 #ifdef HAVE_ACCOUNTS_SERVICE stub
                        # patches/0003: libmessaging-menu/CMakeLists 加 ENABLE_INTROSPECTION
                        # patches/0004: src + libmessaging-menu 补 target_link_directories(${*_LIBRARY_DIRS})
                        conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing
