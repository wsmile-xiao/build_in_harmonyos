#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: clang|clang++|make|conan
phase: build|compilation
error_signature: no viable conversion from returned value of type 'std::ostream' to function return type 'bool'|unknown type name 'uint'|return out << in.rdbuf

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: portability, cpp, libcxx, clang, legacy-code
match_keywords: legacy C++, old C++ code, libc++, clang 15, explicit operator bool, operator void*, ostream rdbuf, copyFile, unknown type name uint, BSD sys/types.h, -Wdeprecated-copy-with-user-provided-copy, portability patch, C++98 source under C++17
title: 2003 年前后的老 C++ 源码在 clang 15 + libc++ 下两处典型不可编译：隐式 ostream→bool 转换与老 BSD 非标准类型 uint

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: libc++ 移除了 std::ostream 的隐式 operator void*（operator bool 为 explicit），老代码 return out << in.rdbuf();（函数返回 bool）不再能隐式转换；同时 uint 是老 BSD sys/types.h 的非标准 typedef，glibc/libc++ 不提供，clang 报 unknown type name 'uint'。两者都是语言/运行库现代化问题，与平台无关，但只在换成 clang+libc++ 后才暴露（上游当年用 gcc+libstdc++ 编译通过）。
affected_scope: 所有 2000-2010 年代老 C++ 项目适配 OHOS（clang 15 + libc++）时；典型信号是 configure/make 阶段报 no viable conversion / unknown type name。上游 vbrfix 0.24（2003 年 KDevelop 工程）实测两处同时命中。
verification_cmd: grep -n 'return out << in.rdbuf' <src>/wputil.h; grep -n '\buint\b' <src>/vbrfix.cpp; 打补丁后 make -j4 应 0 error

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: minimal-source-portability-patch
rec_description: 最小改动：① 把 'return out << in.rdbuf();' 改为 'out << in.rdbuf(); return !out.fail();'（语义等价于原隐式转换的 !fail()）；② 非标准类型 uint → unsigned int。不做平台宏守卫（属通用编译器可移植性修复，非 OHOS 专属），不改语义、不引第三方依赖。
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: false
rec_impl: manual-source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

