#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E321.kv，填写各字段
# 对应的人类文档: doc/E321.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E321
trigger_tool: clang|make
phase: compilation
error_signature: error:.*-Wbitwise-instead-of-logical|use of bitwise.*boolean operands|warnings and.*errors generated

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: compat, compiler, warnings, c++
match_keywords: -Werror, -Wbitwise-instead-of-logical, boolean operands, bitwise &, logical &&, clang, Makefile
title: Legacy boolean bitwise operators become Clang -Werror failures

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Legacy C++ code uses bitwise & between boolean expressions. Clang diagnoses this as -Wbitwise-instead-of-logical, and an upstream -Werror policy turns the warning into a build failure even though the intended operation is logical conjunction.
affected_scope: Legacy C or C++ projects built with Clang and -Werror, especially small Makefile or header-only projects whose source is compiled directly by consumers.
verification_cmd: clang++ -Wall -Werror source.cc -o probe; inspect that no -Wbitwise-instead-of-logical error remains

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: source-warning-fix
rec_description: Replace boolean bitwise operators with logical operators when the operands are predicates, preserving the intended short-circuit semantics and keeping the strict warning policy.
rec_command: Apply a narrow source patch changing predicate & predicate to predicate && predicate, then rebuild with the original -Wall -Werror command.
rec_auto_fix: false
rec_impl: source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: warning-policy-scope
fallback_description: If the expression is intentionally bitwise, keep the operator and narrowly disable only the diagnostic rather than removing all -Werror checks.
fallback_command: Add -Wno-error=bitwise-instead-of-logical only when source review proves bitwise semantics are intentional.
fallback_auto_fix: false
fallback_impl: compiler-flag

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: disable-all-warnings|remove-Werror|replace-with-g++
forbid_1_reason: Broad warning suppression or compiler substitution hides real portability errors and does not repair a semantically incorrect boolean operator.
forbid_1_consequence: Future Clang builds can pass while retaining incorrect evaluation semantics or unrelated warning regressions.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P002, P003, P006

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

