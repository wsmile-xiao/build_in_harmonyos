#====================================================================
# E547 (draft) — pty 测试用 script 时 typescript 指向 /dev/null 会丢光输出
# 对应人类文档: knowledge/drafts/E547-draft-996F.md
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E547
trigger_tool:           test|script|runtime
phase:                  testing
error_signature:        daemon run on a pty emits output \(bytes=0\)|pty output contains ESC7|assertions passed: [0-9]+/[0-9]+ \(skipped: 0\).*FAIL E1

# ═══ Layer 1: 识别层 ═══
severity:               3
category:               testing,portability,runtime,posix
match_keywords:         script,pty,typescript,/dev/null,stdout,ESC[7m,daemon,probe,tty
title:                  pty 测试里把 script 的 typescript 指向 /dev/null，在只写 typescript 的实现上会丢光全部输出

# ═══ Layer 2: 诊断层 ═══
root_cause: script(1) 各实现对"会话输出写到哪里"不一致：util-linux 版同时 tee 到 stdout 与 typescript 文件，而部分实现（含实测的 HarmonyOS worker 上的 script）只写 typescript 文件、stdout 为空。测试若统一写 `script -qc CMD /dev/null > out`，在本地 util-linux 上能从 out 取到数据因而掩盖缺陷，到 worker 上则 bytes=0。另有一层风险：合并写法 -qc 并非所有实现都接受，严格实现会直接报错退出
affected_scope: 所有用 script(1) 分配 pty 采集子进程输出的 test_package；被测程序若是"fork 后前台父进程退出"的守护进程，必须额外挂住 pty 才能抓到连续帧
verification_cmd: script -qc "printf PTYPROBE" /tmp/probe.ts > /tmp/probe.out 2>&1; grep -c PTYPROBE /tmp/probe.ts /tmp/probe.out   # 期望两个文件至少各命中一次

# ═══ Layer 3: 方案层 ═══
rec_priority: 1
rec_approach: typescript 指向真实文件而非 /dev/null，并在断言前把 typescript 与 stdout 两个通道 cat 成并集再统计；同时用与被测程序无关的探针命令（PTYPROBE）依次尝试 `-qc` 与 `-q -c` 两种调用形式判定 harness 可用性，探针失败才 skip
rec_description: 双通道并集统计 + 探针判活，让 runner 差异不会伪装成被测程序缺陷
rec_command: script $style "sh -c '<prog>; sleep 6'" spin.ts > spin.out 2>spin.err; cat spin.ts spin.out > spin.all
rec_auto_fix:           false
rec_impl:               pty-harness-probe

fallback_priority:      2
fallback_approach: 用 python3 的 pty.fork()/pty.spawn() 自己分配 pty 并直接读 master，不依赖 script 的输出通道语义
fallback_description: 绕过 script 实现差异，直接用 pty 模块控制会话
fallback_command: python3 -c "import pty,select,os; pid,fd=pty.fork(); ..."
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern: script\s+(-qc|-q -c)\s+.*\s/dev/null\b
forbid_1_reason: typescript 指向 /dev/null 时，只写 typescript 的实现会把全部会话输出丢弃，且 stdout 侧无任何可断言内容
forbid_1_consequence: 字节数恒为 0，pty 相关断言在真实 worker 上必然失败，而本地 util-linux 环境仍显示通过

forbid_2_pattern: 跳过探针、直接断言被测程序的 pty 输出
forbid_2_reason: 无法区分"harness 在该 runner 不可用"与"被测程序不输出"，属于把环境问题误报为缺陷
forbid_2_consequence: 红色 CI 指向错误的根因，浪费修复轮次

forbid_3_pattern: script\s+-qc\s+"[^\"]*"\s*/dev/null\s*;?\s*$|&\s+sleep\s+\d+
forbid_3_reason: 守护进程若被 & 放到后台会失去控制终端，写入已销毁的 pty 触发 SIGSEGV
forbid_3_consequence: 抓不到任何帧，且掩盖"子进程必须保持前台"这一必要条件

# ═══ Layer 4: 原则引用 ═══
principles:            R34

