#====================================================================
# E6341 — 现代 cpp 塌缩宏展开制表符，X11 imake 生成坏 Makefile
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E6341
trigger_tool:           make|configure
phase:                  configuration
error_signature: fatal error: 'Imake.tmpl' file not found|invalid preprocessing directive|*** missing separator

# ═══ Layer 1: 识别层 (Recognition) ═══
severity: 2
category: build-system,toolchain,portability
match_keywords:         imake, Imakefile, Imake.tmpl, FIXUP_CPP_WHITESPACE, X11R5, clang-cpp, KludgeOutputLine, PRIVCONFIGDIR
title:                  现代 cpp 塌缩多行宏调用内的制表符，使 X11 imake 生成语法错误的 Makefile

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: |
  X11R5 imake 把 Imakefile 交给 cpp 展开，Imake.rules 用 @@ 作软换行标记，
  imake 再把每个 @@ 还原成换行。1991 年的 cpp 在展开多行宏调用时保留每行开头的
  制表符，还原出来的配方行天然带 tab；现代 clang/gcc 的 cpp 按 C 标准把宏调用
  内部的换行与制表符合并成一个空格，imake 得到的配方行只剩一个前导空格。
  imake 自带的修正（需定义 FIXUP_CPP_WHITESPACE，imakemdep.h 只在 sun/SYSV/SVR4/hcx
  下自动定义它）用行内是否出现冒号判断 target 行，判据过宽：配方行不含冒号时不会
  补 tab，make 报 missing separator；含冒号的对齐宏定义被当成 target 行并剥掉前导
  空格，变量消失，子目录 imake 拿不到 -I<TOP>/config，报 Imake.tmpl file not found。
  症状出现在下游目录，报错位置不指向真正的补丁点。
affected_scope:         所有用 X11 imake 体系构建的老软件；imake 已从发行版消失，需现场引导
verification_cmd: |
  printf '#define IMAKE_TEMPLATE\t"<abs>/config/Imake.tmpl"\n#define INCLUDE_IMAKEFILE\t<Imakefile>\n#include IMAKE_TEMPLATE\n' > in.txt
  clang-cpp -P -I. -I<abs>/config - < in.txt | grep -n 'all::' | cat -A
  grep -n 'PRIVCONFIGDIR = ' Makefile

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           imake-kludge-target-vs-assignment
rec_description: |
  编译 imake 时定义 FIXUP_CPP_WHITESPACE，并把 KludgeOutputLine 的判据从
  行内有冒号改成首个空白分隔的词里含冒号：只有首个词含冒号才算 target；
  单个前导空格且在规则内的行还原成 tab；NAME = 形式的缩进行视为宏定义回到第 0 列。
  CPP_PROGRAM 指向读 stdin 的 clang-cpp 并加 -P，否则它插入的空行会重置 InRule。
rec_command: |
  ${CC} -std=gnu89 -w -DFIXUP_CPP_WHITESPACE -o ${BIN}/imake -I${IMAKE_SRC}/config -I${IMAKE_SRC}/include -DCPP_PROGRAM="\"${BIN}/cpp\"" ${IMAKE_SRC}/config/imake.c
  grep -q '^ *PRIVCONFIGDIR = ' Makefile
rec_auto_fix:           false
rec_impl:               conan-recipe-hosttools

fallback_priority:      2
fallback_approach:      traditional-cpp-for-imake
fallback_description: |
  不改 imake 源码，改为给 imake 提供一个在宏展开中保留制表符的传统 cpp
  （老 gcc 的 cpp -traditional）。OHOS 上没有 gcc，需要自行引入该工具。
fallback_command:       CPP_PROGRAM=/path/to/traditional/cpp
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       post-process.*Makefile|sed .*Makefile
forbid_1_reason:        imake 每轮重新生成 Makefile，对生成物补 tab 只撑得过一次构建；子目录 Makefile 由 make Makefiles 二次生成，补丁覆盖不到
forbid_1_consequence:   首次 make 可能通过，随后任何 Makefile 目标都会重新生成坏文件，问题以完全不同的报错再次出现
forbid_2_pattern:       core\.ignorecase
forbid_2_reason:        生成的 Makefile 不是根因所在，掩盖生成物会隐藏真实回归
forbid_2_consequence:   上游同步或下一轮重验时重复踩坑

# ═══ Layer 4: 原则引用 ═══
principles:             R8

