#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E431.kv，填写各字段
# 对应的人类文档: doc/E431.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E431
trigger_tool:           cmake|configure|make|gcc|clang|compile
phase:                  compilation
error_signature: gmp\.h.*No such file|'gmp\.h' file not found|gmp\.h: No such file or directory|Cannot find include file.*gmp

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               headers, ohos, conan, dependency, cmake
match_keywords:         gmp.h, gmp_INCLUDE_DIRS, includedirs, nettle.h, Nettle, CMakeDeps, 空数据文件, 未导出, include directory, imported target
title: 制品仓 gmp/6.3.0.1 已发布包未导出 include 目录（includedirs 为空），nettle 公开头里的 <gmp.h> 在编译期找不到

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 制品仓里 gmp/6.3.0.1 的已发布制品（含 revision）在 Conan 元数据中未声明 include 目录，CMakeDeps 生成的 `gmp-release-<arch>-data.cmake` 里 `set(gmp_INCLUDE_DIRS_RELEASE )` 为空；而 nettle 的公开头（nettle/*.h）会 include <gmp.h>，于是任何包含 nettle.h 的编译单元（gnutls、以及被适配库本身）都因找不到 gmp.h 失败。包内其实装了 <pkg>/include/gmp.h，只是没有通过 cpp_info 暴露出来。
affected_scope: 所有在 OHOS 上依赖 gnutls / nettle（进而依赖 gmp）的 Conan 包；只 include gnutls.h 也可能间接触发
verification_cmd: grep -n 'gmp_INCLUDE_DIRS' <build_folder>/generators/gmp-*-data.cmake ; ls <gmp_package_folder>/include/gmp.h

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: inject-dependency-include-dir
rec_description: 在配方 generate()/build() 里取依赖包的私有 prefix（<dep_package_folder>/include）注入到上游构建，使 <gmp.h> 可达：CMake 工程可用 `tc.variables["GMP_INCLUDE_DIR"]=...` 再由补丁把它 append 到 Nettle 目标；Makefile/autotools 工程用 `CPPFLAGS=-I<dep_package_folder>/include`。绝不写死 /usr/include。
rec_command:            python3 -c "import os;print(os.path.join(self.dependencies['gmp'].package_folder,'include'))"  # 配方内取路径，禁止硬编码
rec_auto_fix: false
rec_impl: conan-recipe-inject-dep-include-dir

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: sed .*-i.*nettle.*\.h| 复制 gmp\.h 进系统 /usr/include| cp .*gmp\.h /(usr|system)/include
forbid_1_reason: 改上游公开头会污染其他包并破坏补丁可复现性（R8）；往系统 /usr/include 或 /usr/local 写文件污染共享环境（R49/R26），在 CI 干净环境不可复现
forbid_1_consequence: 补丁无法 refresh-patch 复现、CI 干净环境中再次失败，且可能让其他包误用宿主同名库
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

