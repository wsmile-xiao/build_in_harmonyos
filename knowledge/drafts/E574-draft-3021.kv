#====================================================================
# E574.kv — OHOS 上 libusb-0.1 API 消费者应直接使用已发布的 libusb-compat/0.1.7
#====================================================================
# 编号说明: E543–E573 已全部占用（跨 worktree 文件形态扫描 ∪ 主线文本引用整词扫描，
#   最小空号 = E574）。本条创建后立即回查同 ID 无并发草稿。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 字面子串（engine 只做字面包含，不解析正则），| 分隔，忽略大小写
id:                     E574
trigger_tool:           configure|cmake|make|clang|ld|conan
phase:                  configuration|compilation|linking
error_signature:        fatal error: 'usb.h' file not found|usb.h: No such file or directory|cannot find -lusb|undefined reference to `usb_init'|undefined reference to `usb_open'|libusb-1.0 not found|libusb-0.1 not found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
prescan_pattern:        ^\s*#\s*include\s*<usb\.h>
prescan_globs:          *.c, *.cc, *.cpp, *.h, *.hpp, Makefile*, *.mk, configure.ac, CMakeLists.txt
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, dependencies, portability, libusb, ohos
match_keywords: usb.h, libusb-0.1, libusb-compat, libusb-1.0, -lusb, usb_open, usb_bulk_write, stub, 空实现, ohos, ohpcd, pkg-config
title: OHOS 上使用 libusb-0.1 API（<usb.h>/-lusb）的软件不缺依赖：ohpcd 已发布 libusb-compat/0.1.7 + libusb/1.0.27，直接真编译真链接，不需要 stub

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 制品仓里没有名为 libusb 的 0.1.x 包，只按「软件名 libusb + 头文件 usb.h」检索会得出「OHOS 缺 libusb-0.1」的结论。既有草稿 E485 在 2026-08-22 记录该结论时其正文即写明前提「libusb-compat 无配方/不在制品仓——无法直接依赖」，当时用 stub 头 + 空实现绕过是唯一出路；该前提**现在已不成立**：`libusb-compat/0.1.7` 已发布到 ohpcd（0.1 兼容层：include/usb.h、静态 lib/libusb.a、libusb.pc 里自述 emulated=1/emulated_by=libusb-1.0），并传递依赖 `libusb/1.0.27`（libusb-1.0.so.0，linux_usbfs/netlink 后端）。因此 0.1 API 消费者应直接 `requires("libusb-compat/0.1.7")`，不需要 stub、空实现或平台条件编译
affected_scope: 所有用 libusb-0.1 API 的软件（#include <usb.h> 或 <usb.h> 变体、链接 -lusb、调用 usb_init/usb_busses/usb_open/usb_bulk_* 系列）：USB 设备编程器与烧录工具（cycfx2prog、avarice、fxload、lpc21isp 类）、老式 USB 仪器与调试工具的构建期依赖判定。已在 OHOS 上靠 stub 绕过 libusb-0.1 的历史适配（E485 来源的 avarice 2.14）应回头复核：stub 形态下 USB 功能不可用，改用本包后可恢复真实功能。反向不适用：已经直接使用 libusb-1.0 API（#include <libusb-1.0/libusb.h>、-lusb-1.0）的软件只需要 libusb/1.0.27
verification_cmd: conan install --requires="libusb-compat/0.1.7" --profile:host="$HOST_PROFILE" --build=never -of /tmp/w0  # 期望 Install finished successfully；随后 nm -g --defined-only <pkg>/lib/libusb.a | grep -cE ' T usb_' 应为 27（含 cycfx2prog 用到的全部 14 个 usb_* 符号）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           use-published-libusb-compat
rec_description:        配方 requires("libusb-compat/0.1.7")（它自己 requires libusb/1.0.27）；-I/-L/-l 从 cpp_info 取（libusb-compat 的 libs=["usb"]、libusb-1.0 的 libs=["usb-1.0"]，顺序为直接依赖在前），链接 -lusb -lusb-1.0；不要给依赖加 stub、空实现或 __OHOS__ 条件编译（R8），也不要把 PKG_CONFIG_PATH 指向包内 lib/pkgconfig（该 .pc 的 prefix 固化在打包机路径上）
rec_command:            self.requires("libusb-compat/0.1.7")  # 链接：-lusb（静态 libusb.a，fPIC=True）+ -lusb-1.0（动态 libusb-1.0.so.0）
rec_auto_fix:           false
rec_impl:               conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      build-libusb01-from-source
fallback_description:   仅当制品仓确实取不到 libusb-compat binary 时，才在任务私有 prefix 从源码构建 libusb-compat 0.1.7（上游 autotools，需注意 HMDFS 下 mktemp/权限限制），仍不使用 stub；得到发布版 binary 可用即回到推荐方案
fallback_command:       conan create <libusb-compat 配方> -pr:h="$HOST_PROFILE" --build=missing
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       stub.*usb\.h|usb\.h.*stub|fake.*usb\.h|typedef.*usb_dev_handle.*stub
forbid_1_reason:        在 libusb-compat/0.1.7 已发布之后仍按旧口径用自建 stub 头 + 空实现让编译链接变绿；这违反 R34（禁止空 stub 与固定成功返回）与 R8（OHOS 条件编译默认禁止），也掩盖了 compat 包已经可用这一事实
forbid_1_consequence:   产出无法访问任何 USB 设备的空壳产物（USB 功能 100% 不可用），测试也只能自证 stub 被调用；后续真实消费者一旦链接就暴露，返工成本高于一次 W0 核查
forbid_2_pattern:       PKG_CONFIG_PATH.*\.conan2/p/.*lib/pkgconfig|PKG_CONFIG_PATH.*<compat>/lib/pkgconfig
forbid_2_reason:        包内 .pc 的 prefix 固化在打包机路径（实测 libusb.pc 的 prefix 指向 /storage/Users/currentUser/.cache/conan2/p/b/libus8c4e8f03c5cab/p，本机不存在），pkg-config 报 Found 也不代表路径正确
forbid_2_consequence:   编译期拿到死路径 -I/-L，链接报找不到 -lusb 或链接到错误版本；错误信息不指向 .pc 来源，排查成本高

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# 说明: conflicts_with 声明 E485。E485 的 stub 方案在其自身声明的前提（「libusb-compat
#       无配方/不在制品仓」）下成立，而该前提已随 libusb-compat/0.1.7 发布而失效；两条的
#       error_signature 有重叠字面（usb.h No such file / undefined reference to usb_*），
#       engine 可能同时召回，若不显式声明冲突会把「stub 绕过」当成逐字可选方案交给使用者，
#       从而把已可真实链接的场景做成空壳产物。
#       差异论证（含 E485 前提原文引用与三条实测反证）见本草稿的人类文档
#       knowledge/drafts/E574-draft-3021.md 的「与既有条目的差异」一节；晋升时该节将随
#       doc/E574.md 一并落地，故此处不指向尚未存在的 doc/E574.md。
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         E485
prerequisite_of:        []

