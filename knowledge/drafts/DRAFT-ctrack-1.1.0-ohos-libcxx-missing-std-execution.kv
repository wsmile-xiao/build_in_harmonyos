#====================================================================
# DRAFT-ctrack-1.1.0-ohos-libcxx-missing-std-execution
#   OHOS libc++（libcxx-ohos）缺失 <execution>/std::execution 并行执行策略：
#   C++17 header-only 库裸用 std::execution::par_unseq 编译失败，
#   需上游官方禁用宏 + cpp_info.defines 传播
# 来源: PR feat(ctrack): 1.1.0 适配 HarmonyOS PC（第一轮）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-ctrack-1.1.0-ohos-libcxx-missing-std-execution
trigger_tool:           clang|clang++|cmake|conan
phase:                  compilation
error_signature:        no member named 'execution' in namespace 'std'|
                        std::execution::par_unseq|par_unseq|
                        #include <execution>|execution_policy

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               ohos, libcxx, headers, compiler, conan, recipe
match_keywords:         std::execution, par_unseq, <execution>, execution_policy,
                        transform_reduce, libcxx-ohos, OHOS SDK, clang, C++17,
                        header-only, single-header, cpp_info.defines,
                        CTRACK_DISABLE_EXECUTION_POLICY, TBB
title:                  OHOS libc++ 无 std::execution 并行执行策略：C++17 header-only 库
                        裸用 std::execution::par_unseq 编译失败，用上游官方
                        CTRACK_DISABLE_EXECUTION_POLICY 降级宏并经
                        cpp_info.defines 传播给消费者
prescan_pattern:        #include <execution>|std::execution|execution_policy|par_unseq
prescan_globs:          *.hpp, **/*.hpp, *.h, **/*.h, conanfile.py, CMakeLists.txt

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS SDK（ohos-sdk_26.0.0.18）自带的 libc++ 实现
                        （libcxx-ohos）不提供 <execution> 头 / std::execution
                        并行执行策略。上游 ctrack.hpp 在未定义
                        CTRACK_DISABLE_EXECUTION_POLICY 时无条件
                        `#include <execution>` 并设
                        `constexpr auto execution_policy = std::execution::par_unseq;`
                        C++17 header-only 消费者直接 include 即报
                        "no member named 'execution' in namespace 'std'"
                        （libcxx-ohos 意外建议成员 'exception'）。错误会级联
                        蔓延：同一头文件内后续模板（如 sum_field 里
                        std::transform_reduce 的 OPT_EXEC_POLICY 实参）全部
                        跟着 substitution failure。注意：上游 CMakeLists 自己
                        在 find_package(TBB) 未命中时就会定义
                        CTRACK_DISABLE_EXECUTION_POLICY 作为官方降级路径；
                        OHOS 无 TBB 预编译包，必须走该官方宏，而不是改上游
                        源码硬删并行代码。
affected_scope:         所有依赖 std::execution 并行执行策略（par/par_unseq）
                        的 C++17 及以上 header-only/头部内联库，在 OHOS
                        （libcxx-ohos）下裸 include 即命中。典型：benchmark /
                        profiling 单头库、数值算法单头库。Linux/macOS/Windows
                        原生 libstdc++/MSVC 均提供 <execution>，该场景仅在
                        OHOS 的 libcxx-ohos 复现。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           upstream-official-disable-macro-via-cpp_info-defines
rec_description:        检查上游是否已有官方禁用宏（ctrack 为
                        CTRACK_DISABLE_EXECUTION_POLICY，其 CMakeLists 在
                        TBB 缺失时即定义该宏）；conanfile.py 的 package_info()
                        用 self.cpp_info.defines = ["CTRACK_DISABLE_EXECUTION_POLICY"]
                        把宏作为 INTERFACE 编译定义传播给所有消费者——
                        header-only 库无编译产物，宏传播是唯一可靠路径。
                        消费者即可零额外参数 include 使用（本地编译验证：
                        clang++ -std=c++17 -DCTRACK_DISABLE_EXECUTION_POLICY ...）。
                        cpp_info.defines 由 CMakeDeps 自动写入传递依赖的
                        INTERFACE_COMPILE_DEFINITIONS，test_package 亦自动继承。
rec_command:            self.cpp_info.defines = ["CTRACK_DISABLE_EXECUTION_POLICY"]
rec_auto_fix:           false
rec_impl:               cpp_info-defines-propagation

fallback_priority:      2
fallback_approach:      patch-upstream-header-with-guard
fallback_description:   若上游没有官方禁用宏且库导出并行路径，用最小补丁在头文件
                        加 #ifndef 守卫包住 <execution>/std::execution 用法，
                        patch_type: build-fix，逐条在 PR「文件修改说明」披露。
                        仅当前者不可用时使用（侵入上游头文件，影响面大）。
fallback_command:       patches/000X-guard-std-execution.patch
fallback_auto_fix:      false
fallback_impl:          source-patch

# ★ 禁止策略 ★
forbid_1_pattern:       -Dexecution|-include.*execution|伪造.*std::execution|namespace execution
forbid_1_reason:         禁止伪造 std::execution 命名空间或强塞编译器参数绕过——
                        libcxx-ohos 无该头，任何伪造都会在 consumer 编译期再次
                        爆头或行为未定义
forbid_1_consequence:   消费者编译仍失败或运行期未定义行为
forbid_2_pattern:       TBB.*tool_requires|tool_requires.*tbb|把 TBB 当依赖硬拉
forbid_2_reason:        若库仅用 TBB 的可选路径，硬拉 TBB 依赖扩大依赖面且
                        registry 无预编译 TBB 时 conan create 从源码编 TBB，
                        耗时且易失败（R36）；走官方禁用宏更轻
forbid_2_consequence:   依赖链膨胀、构建变慢、R36 门禁风险

# ═══ Layer 4: 原则引用 ═══
principles:             P013, P014

# ═══ 关系图 (Relations) ═══
similar_to:             E130（libcxx-ohos C++11→C++17 标准切换：同为 libcxx-ohos
                        头文件能力缺口，但 E130 是标准版本问题、本条是
                        <execution> 头缺失，根因/解法均不同）、
                        E322（header-only CMake INTERFACE 配方模式：同为
                        header-only 配方，但 E322 管 build 选项与 package_id，
                        本条管 std::execution 编译定义传播）
caused_by:
conflicts_with:
prerequisite_of:

# ═══ 元数据 ═══
verification_cmd:       cd <build> && clang++ -std=c++17 -O2 \
                        -DCTRACK_DISABLE_EXECUTION_POLICY \
                        -I$TEST_PREFIX/.../include test_package.cpp -o t && ./t
                        # 期望：编译通过，消费者程序运行 rc=0；
                        # conan create 依赖 self.cpp_info.defines 自动注入，
                        # test_package 无需显式 -D
doc_file:               knowledge/drafts/DRAFT-ctrack-1.1.0-ohos-libcxx-missing-std-execution.md
last_updated:           2026-09-20
source_event:           ctrack 1.1.0 第一轮适配：consumer_app.cpp / ohos_special_test.cpp
                        / test_package.cpp 在 OHOS libc++ 下裸 include 报
                        "no member named 'execution' in namespace 'std'";
                        conanfile.py package_info 注入
                        CTRACK_DISABLE_EXECUTION_POLICY 后全部编译运行通过，
                        上游 69 个 TEST_CASE 全量通过
authors:                pc7-10
source_pr:              <ctrack-1.1.0-pr-number>
source_commit:          <ctrack-1.1.0-commit>

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9
metrics_last_used:      2026-09-20