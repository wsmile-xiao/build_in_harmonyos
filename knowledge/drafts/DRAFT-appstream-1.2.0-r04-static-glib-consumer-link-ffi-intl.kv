#====================================================================
# DRAFT-appstream-1.2.0-r04-static-glib-consumer-link-ffi-intl.kv
# 静态 glib（shared=False，pango 链强制）下可执行目标/消费者链接缺
# libffi（ffi_type_void/ffi_call）与 g_libintl_gettext（intl）→
# 静态 glib 场景按 shared 选项条件补 -lffi / 组件 libs 追加 intl
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R04）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           conan|linker
phase:                  linking
error_signature:        undefined symbol: ffi_type_void|
                        undefined symbol: ffi_call|
                        undefined symbol: g_libintl_gettext|
                        undefined symbol: ffi_prep_cif
severity:               3
category:               conan, glib, static-linking, pango, ohos
match_keywords:         libffi, ffi_type_void, libintl, g_libintl_gettext, static glib,
                        shared=False, pango, extra_ldflags, glib-pc-fix, Requires.private
title:                  静态 glib 消费者/可执行目标链接缺 libffi 与 intl → 按 shared 条件补 -lffi 与组件 libs intl
root_cause:             R02/R03 的 glib pc-fix 剥离 Requires.private 的 zlib/libffi/pcre2
                        （当时 glib 动态，符号由 .so 提供）；R04 pango/harfbuzz 链强制
                        glib shared=False（静态）后，libgobject-2.0.a 需 libffi、
                        libappstream.a → 静态 glib 需 intl，干净构建（无 conf 注入）
                        链接缺符号。
affected_scope:         pango/gtk 链强制静态 glib 且上层含可执行目标或 public 消费者的 Conan 项目。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing
rec_priority:           1
rec_approach:           static-glib-conditional-extra-ldflags-ffi-intl
rec_description:        generate() 中对静态 glib 场景补链接参数：主体配方 tc.extra_ldflags
                        追加 -L<libffi>/lib -lffi（libffi 为 override 依赖 package_folder
                        可能 None → 兜底用静态 glib 包内自带 libffi.a，实测存在）；消费者
                        （test_package）generate() 给 glib 组件 libs 追加 "intl"。
rec_command:            |
  _ffi_pkg = self.dependencies["libffi"].package_folder if "libffi" in self.dependencies else None
  if not _ffi_pkg and glib_pkg and os.path.isfile(os.path.join(glib_pkg, "lib", "libffi.a")):
      _ffi_pkg = glib_pkg
  if _ffi_pkg:
      tc.extra_ldflags.append(f"-L{os.path.join(_ffi_pkg, 'lib')}")
      tc.extra_ldflags.append("-lffi")
rec_auto_fix:           false
rec_impl:               conan-recipe-generate
forbid_1_pattern:       .*static glib.*不加 -lffi.*直接链接
forbid_1_reason:        静态 glib 下不补 libffi → appstreamcli/asc-mediaworker 链接必现
                        undefined symbol（G2 干净构建实测）
principles:             R33, R49
causes:                 [DRAFT-appstream-1.2.0-ohos-gettext-proxy-libintl-header]
caused_by:              []
similar_to:             [DRAFT-appstream-1.2.0-ohos-gettext-proxy-libintl-header]
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-r04-static-glib-consumer-link-ffi-intl.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R04（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.85