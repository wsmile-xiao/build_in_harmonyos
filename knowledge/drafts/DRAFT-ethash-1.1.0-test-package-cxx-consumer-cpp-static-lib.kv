#====================================================================
# DRAFT: ethash-1.1.0 — test_package CXX 消费者（C-API C++ 静态库）
#====================================================================

id:                     DRAFT-ethash-1.1.0-test-package-cxx-consumer-cpp-static-lib
trigger_tool:           conan|cmake|clang|ld.lld
phase:                  testing
error_signature:        undefined symbol: __cxa_begin_catch|undefined symbol: std::terminate|undefined symbol: __gxx_personality_v0|linker command failed with exit code 1
severity:               2
category:               conan, test-package, linking, libcxx
match_keywords:         test_package, CXX project, static library, C API, libc++, __cxa_begin_catch, __gxx_personality_v0, undefined symbol, consumer test
title:                  C-API C++ 静态库的 test_package 消费者工程必须用 CXX（C 工程链接会缺 C++ 运行时符号）

root_cause:             库导出 C API（ethash.h/keccak.h 等），但实现（libethash.a/libkeccak.a 内的 .cpp/.c
                        混合对象）含 C++ 运行时符号（__cxa_begin_catch、std::terminate、
                        __gxx_personality_v0）。test_package 若生成 project(test_ethash C) 的 C 工程，
                        链接器用 C 调用约定且不携带 libc++，静态库中的 C++ 运行时符号全部 undefined。
                        conan create 阶段 test_package 链接失败 → G2/test() 失败。

affected_scope:         所有"公开 C API、内部 C++ 实现、静态链接"的库（ethash、libXext 类、加密/哈希库等）
                        的 Conan test_package；同样影响任何 C 消费者工程直接链接该类静态库的场景。

verification_cmd:       cd $REPO_DIR && python3 scripts/ohc-run.py conan-verify ethash 1.1.0
                        # 修复后 G2 PASS；test_package 内 CTest test_ethash PASS（4 项消费者断言）

rec_priority:           1
rec_approach:           test-package-cxx-project
rec_description:        test_package 的 CMakeLists.txt 用 project(<name> CXX)，测试源用 .cpp
                        （保持对 C API 的纯 extern "C" 调用），link 目标不变；C 头文件声明仍是
                        C 兼容的，无需改库侧。
rec_command:            # test_package/CMakeLists.txt
                        #   cmake_minimum_required(VERSION 3.15)
                        #   project(test_ethash CXX)
                        #   find_package(ethash REQUIRED)
                        #   add_executable(test_ethash test.cpp)
                        #   target_link_libraries(test_ethash ethash::ethash)
                        #   enable_testing(); add_test(NAME test_ethash COMMAND test_ethash)
rec_auto_fix:           false
rec_impl:               manual-recipe-edit

# 关联候选（C3/C5 合并在 companion draft：lang-preflight 绑定误判 + 本地 conan gtest 运行上游测试）
similar_to:             E247（pkg-config 侧同类根因：静态 C API 归档缺 C++ 运行时元数据）
caused_by:              C 消费者 × C++ 静态库的链接模型（C 链接器不带 libc++）
prerequisite_of:        —
conflicts_with:         —