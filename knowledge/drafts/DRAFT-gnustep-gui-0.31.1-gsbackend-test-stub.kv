#====================================================================
# DRAFT-gnustep-gui-0.31.1-gsbackend-test-stub
# GSBackend 由应用侧后端库提供，test_package 需最小 stub
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: gnustep-gui 0.31.1 HarmonyOS PC 适配（PR #7408）
#====================================================================

id:                     DRAFT-gnustep-gui-0.31.1-gsbackend-test-stub
trigger_tool:           conan|clang|ld.lld|test_package|objc
phase:                  testing|linking|packaging
error_signature:        GSBackend|backend.*class.*not.*found|NSBackend|undefined reference.*GSBackend|backend bundle|AppKit.*back.*not.*loaded
severity:               2
category:               ohos|objective-c|gnustep|conan|testing|linking
match_keywords:         GSBackend, backend, AppKit, test_package, stub, gnustep-gui, ObjC, bundle
title:                  GSBackend backend classes are provided by the app-linked backend library; test_package needs a minimal stub
root_cause:             GNUstep GUI's AppKit relies on a backend (e.g. gnustep-back) for
                        window/graphics services. On OHOS, the backend library is linked by
                        the application side, not bundled in gnustep-gui itself. A standalone
                        test_package that instantiates AppKit classes will fail unless it
                        supplies a minimal GSBackend stub satisfying the backend linkage.
affected_scope:         GNUstep AppKit consumers' test_package on OHOS that do not link a real
                        gnustep-back backend.
verification_cmd:       Run the gnustep-gui 0.31.1 test_package (ObjC AppKit smoke test with
                        GSBackend stub) during conan create; verify it compiles, links, and
                        executes.

rec_priority:           1
rec_approach:           minimal-gsbackend-stub
rec_description:        Provide a minimal GSBackend class stub in test_package that satisfies
                        AppKit's backend lookup, so the consumer test can compile and link
                        without a real gnustep-back backend.
rec_command:            add gsbackend_stub.m to test_package and reference it in the build
rec_auto_fix:           false
rec_impl:               conan-recipe-test-package

fallback_priority:      2
fallback_approach:      skip-backend-tests
fallback_description:   If a backend stub cannot satisfy the linkage, restrict the consumer
                        test to non-backend AppKit APIs (views, classes, strings) that do not
                        require a live backend.
fallback_command:       test only non-backend AppKit APIs
fallback_auto_fix:      false
fallback_impl:          conan-recipe-test-package

forbid_1_pattern:       assume.*backend.*bundled.*in.*gnustep-gui
forbid_1_reason:        Backend classes are not part of the gnustep-gui package on OHOS.
forbid_1_consequence:   Consumer tests fail at link/runtime when the backend is missing.
forbid_2_pattern:       skip.*test_package.*entirely
forbid_2_reason:        SKILL requires a real consumer test (L0c gate).
forbid_2_consequence:   PR fails W3/CI test substance gate.

principles:             P016
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

