#====================================================================
# E670-draft-421B.kv — gengetopt 生成的命令行解析器只随 release tarball 发布
# 来源: shishi 1.0.3 适配（任务卡 10568）, 2026-09-23
# 状态: 草稿（待人工审核后 promote 为正式条目）
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E670
trigger_tool:           make
phase:                  compilation
error_signature:        gengetopt.*(not found|No such file|inaccessible or not found)|make\[.*\].*gengetopt

# ═══ Layer 1: 识别层 ═══
severity:               3
category:               build-system, autotools, portability, limitation
prescan_pattern:        gengetopt|BUILT_SOURCES.*_cmd
prescan_globs:          Makefile*, *.ggo, *.am
match_keywords:         gengetopt, ggo, BUILT_SOURCES, release tarball, git 快照, 解析器, 生成物, shishi
title:                  gengetopt 生成的 *_cmd.c 解析器只在 release tarball，git 快照/本地补生成必断

# ═══ Layer 2: 诊断层 ═══
root_cause:             GNU shishi 这类包用 gengetopt 从 *.ggo 生成命令行解析器 src/*_cmd.c 与 *_cmd.h，并登记进 BUILT_SOURCES 显式规则；release tarball 自带这些生成物且 mtime 新于 .ggo 因 make 不重算，git 树只有 .ggo 源定义。设备与 CI worker 都没有 gengetopt（ohpcd 也未发布），一旦源来自 git 快照/归档或时间戳倒挂，make 就在 BUILT_SOURCES 处报 gengetopt not found
affected_scope:         所有用 gengetopt（以及 gperf/bison/flex autogen 类）预生成源文件、且生成物只进 release tarball 的 autotools 包
verification_cmd:       command -v gengetopt || echo "gengetopt missing - release tarball required"; tar tzf <release-tarball> | grep -c "_cmd\.c"

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           sources 锚定官方 release tarball
rec_description:        conandata.yml 的 sources 必须指向官方 release tarball 并 sha256 实核（ftp.gnu.org/GitHub releases），不使用 git snapshot 或 /archive/ 归档；打包后可用 tar tzf 核对生成物在位，tar 内生成物 mtime 新于 .ggo 时 make 不会触发 gengetopt
rec_command:            tar tzf <release-tarball> | grep -q "src/.*_cmd\.c" && echo "generated parsers present" || echo "NEED gengetopt"
rec_auto_fix:           false
rec_impl:               recipe-option

fallback_priority:      2
fallback_approach:      有 gengetopt 的环境预生成后提交生成物
fallback_description:   确需 git 源时，先在装有 gengetopt 的机器跑 gengetopt --input *.ggo 生成 *_cmd.c/_cmd.h，再把生成物随归档提供；设备侧不跑 gengetopt
fallback_command:        command -v gengetopt && gengetopt --input src/shishi.ggo --file-name shishi_cmd
fallback_auto_fix:      false
fallback_impl:

# ═══ 禁止策略 ═══
forbid_1_pattern:       sources:.*(codeload\.github|/archive/)[^" ]*(tar\.gz|zip)|--url=[^ "]*\.git
forbid_1_reason:        git 快照/归档不含 gengetopt 生成的 *_cmd.c，只有 .ggo，设备与 CI 均无 gengetopt
forbid_1_consequence:   make 在 BUILT_SOURCES 处报 gengetopt not found，构建必失败（或在设备上装工具造成设备绿 CI 红）
forbid_2_pattern:       tool_requires\(["']gengetopt
forbid_2_reason:        ohpcd 未发布 gengetopt，且为绕过该问题引入新工具依赖会扩大依赖面
forbid_2_consequence:   conan 拉不到包，R36 依赖闸失败

# ═══ Layer 4: 原则引用 ═══
principles:             P011

