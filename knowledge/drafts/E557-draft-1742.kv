# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E557
trigger_tool: cmake|clang|ld|configure
phase: configuration
error_signature: Error loading shared library [^ ]+: \(needed by .*llvm/bin/(ld\.lld|lld)\)|cannot open shared object file.*libxml2|The C compiler is not able to compile a simple test program|The C\+\+ compiler is not able to compile a simple test program|Error relocating .*llvm/bin/(ld\.lld|lld): [A-Za-z]+: symbol not found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category:               ohos, toolchain, llvm, conan, environment
match_keywords: libxml2.so.16, lld, ld.lld, host runtime, LD_LIBRARY_PATH, compiler_executables, is not able to compile a simple test program, compiler probe, print-prog-name, resource-dir, realpath, OHOS SDK, test_package, 消费者配方
title: OHOS 交叉工具链宿主动态库缺失导致 compiler/linker probe 失败的诊断与恢复

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS SDK 的 clang/lld 等宿主工具自身是动态链接 ELF，其 NEEDED 依赖（如 libxml2.so.16）在某些宿主环境无法解析（如 lld 的 RUNPATH $ORIGIN/../lib 未被加载器展开），宿主工具启动即失败。CMake/Autotools 的 compiler probe（编译+链接最小程序）在链接步死于该宿主运行时问题，被构建系统表面化报为编译器无法编译简单测试程序。目标源码本身无错。
affected_scope: 所有在 OHOS 交叉编译中调用 SDK clang/clang++/ld.lld/lld 的构建（CMake/Conan/Meson/Autotools），宿主工具因自身 .so 缺失无法启动的场景；不依赖具体 SDK 版本，任何缺失宿主动态库均适用；主 recipe 与 Conan test_package 等每个独立调用 compiler/linker 的消费者配方/build context 都可能单独触发
verification_cmd: ldd <sdk>/native/llvm/bin/lld 2>&1 | grep "not found"; <cc> -print-prog-name=ld.lld; <cc> -print-resource-dir; echo "int main(void){return 0;}" > /tmp/p.c && <cc> /tmp/p.c -o /tmp/p; echo rc=$?

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: host-runtime-discovery-scoped-retry
rec_description: 先在环境现状（ambient）下用配置的 compiler/linker 做真实 compile+link probe；失败且日志属于宿主动态库缺失时，从工具链自身派生宿主运行时候选目录（clang realpath 上级 lib、ld.lld realpath 上级 lib、resource-dir 上级、PATH 各 bin 目录、现有 LD_LIBRARY_PATH、受限向上遍历），只接受实际包含缺失 .so 的目录，重试 probe；成功后通过 Conan Environment 局部 prepend LD_LIBRARY_PATH 作用于构建；仍失败则输出 compiler/linker、缺失库、候选目录、probe 输出等诊断并 fail closed。全程不硬编码个人绝对路径、不全局污染环境。该发现/probe/作用域序列必须由每个独立调用 compiler/linker 的 recipe 或 build context 各自执行——Conan test_package 是独立消费者配方，主 recipe 的局部 Environment 不会自动传播到它；多处实现必须保持行为一致（无跨 recipe 复用基础设施时可等价最小实现，但候选派生、probe、fail-closed 诊断需同步维护）。
rec_command: cc=$(conan conf get tools.build:compiler_executables.c 2>/dev/null); lld=$($cc -print-prog-name=ld.lld); lib=$(grep -oE 'lib[^ :]*\.so[^ :]*' /tmp/probe.log | head -1); for d in $(dirname $(dirname $(realpath $cc)))/lib $(dirname $(dirname $(realpath $lld)))/lib; do [ -f $d/$lib ] && LD_LIBRARY_PATH=$d:$LD_LIBRARY_PATH $cc /tmp/p.c -o /tmp/p; done
rec_auto_fix: false
rec_impl: discover-host-runtime-scoped-env

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

