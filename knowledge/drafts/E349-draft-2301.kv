#====================================================================
# E349 draft - X11 扩展库头文件来源归属
# 触发事件: libXv 1.0.13 HarmonyOS PC 适配（archives/l/libxv/1.0.13）
# 主从明确：X11 扩展库的协议头/常量来自 xorgproto、Xext 内部工具头来自 libxext、
#           扩展自身公有头来自本库；按头文件归属精确列出依赖，同轨可用时零 vendoring。
#====================================================================

id:                     E349
trigger_tool:           configure|cmake|pkg-config|preprocess|#include
phase:                  configure
error_signature:        Xv\.h.*No such file|XShm\.h.*No such file|extutil\.h.*No such file|fatal error: X11/.*\.h|X11/extensions/.*\.h

severity:               3
category:               ohos, x11, headers, provenance, dependency, vendoring
match_keywords:         xorgproto, libxext, Xv.h, XShm.h, extutil.h, transitive_headers, vendoring, header provenance, NEEDED, libx11, libxv
title:                  X11 扩展库头文件来源归属：按头文件决定依赖与是否 vendoring

root_cause:             X11 扩展库头文件来源分散：协议头/常量→xorgproto、Xext 内部
                        工具头→libxext、扩展公有头→本库。不逐一映射来源会多依赖（重复
                        vendoring 已在轨的头）或少依赖（漏链接级 NEEDED 库），并污染
                        package_info.requires。

affected_scope:         X11 家族扩展客户端库（Xv/XShm/Xrandr/Xcursor/Xcomposite 等）及
                        一切依赖 xorgproto/libxext 的 X 库在 OHOS 的适配。

verification_cmd:       CI_PACKAGES="archives/l/libxv/1.0.13" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           header-provenance-mapping
rec_description:        列出本库所有 #include 的 X11 头并归属到来源包（xorgproto/libxext/
                        对应扩展库）；头文件级依赖用 transitive_headers=True，链接级依赖进
                        package_info.requires；readelf NEEDED 校验；同轨全可用则零 vendoring。
rec_command:            CI_PACKAGES="archives/l/libxv/1.0.13" zsh ci/conan/build_and_test.sh
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:       vendor-if-off-track
fallback_description:   若来源包不在同轨（如跨轨 pin 冲突），才 vendor 头 + 桩 .pc（见 E338）；
                        同轨可用时禁用，避免符号分叉。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          stub-pc

forbid_1_pattern:       vendor.*Xv\.h|vendor.*XShm\.h|vendor.*extutil\.h
forbid_1_reason:        来源包同轨可用时 vendoring = 重复维护 + 符号分叉。
forbid_1_consequence:   与已发布包头文件分叉，消费者行为不一致。
forbid_2_pattern:       package_info.*requires.*x11|requires.*xorgproto.*link
forbid_2_reason:        把纯头文件级依赖写进 requires 让消费者链接错误库。
forbid_2_consequence:   消费者链接多余/错误库，NEEDED 失真。
principles:             P013,P014
causes:                 []
caused_by:              []
similar_to:             E340,E338
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E349.md
last_updated:           2026-08-31
source_event:           libXv 1.0.13 HarmonyOS PC 适配
authors:                2301_76770579 <noreply@gitcode.com>
source_pr:              7219
source_commit:          afeff4686fc2be82b4609b395e890803c39c1518

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.8
metrics_last_used:      2026-08-31

