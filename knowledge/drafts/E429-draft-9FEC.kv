#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: ohc-run.py init-build|conan create
phase: extract|packaging
error_signature: 嵌套源码检测: 找到源码在 example|no such file or directory: CANopen.c|tools.build:compiler_executables:c.*does not exist

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: build-system|conan
match_keywords: no-build-system,无构建系统,嵌入式协议栈,example 提升,源码集合,直接编译栈源码,CO_driver_target
title: 无构建系统的非 header-only C 库（嵌入式协议栈）conan 直接编译打包 + example 演示目录误提升

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: init_build._promote_nested_source 仅按 C/C++ 构建标记识别源码子目录；无顶层构建标记的嵌入式协议栈 tarball 会把含 Makefile 的 example/ 演示目录误提升为源码根；且 conanfile build() 用相对路径编译 + 默认 cwd 为 build 目录时找不到源文件
affected_scope: 以源码集合分发的无构建系统嵌入式 C/C++ 库；上游 tarball 顶层无 configure/CMakeLists/Makefile 的协议栈/驱动类库
verification_cmd: ohc-run.py conan-verify canopennode 4.1 && ohc-run.py finish canopennode 4.1 published

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 2
rec_approach: 1) 误提升时手动重建 .orig/.work（rm -rf; tar xzf --strip-components=1; cp -a; 重写 .tarball-sha256 并核对）; 2) conanfile build() 用 self.conf.get("tools.build:compiler_executables", default={}) dict 形式取编译器（R33），源码全部绝对路径并 cwd=src 编译，llvm-ar 归档; 3) package() 保留子目录头文件布局（CANopen.h include "301/CO_driver.h"）; 4) test_package 用上游 blank 驱动作为消费者硬件抽象层，调用 CO_new/CO_CANinit/CO_LSSinit/CO_CANopenInit/CO_CANopenInitPDO/CO_process/CO_delete 验证真实运行; 5) 提交前清理 conan-verify 残留 .ghfast-bak/.orig 并恢复官方 URL
rec_description: 无构建系统嵌入式协议栈 C 库适配要点：手动重建 .orig/.work 修正 example/ 误提升；dict 形式 compiler conf + 绝对路径 cwd=src 编译；头文件保留子目录布局；test_package 用 blank 驱动做消费者用例
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

