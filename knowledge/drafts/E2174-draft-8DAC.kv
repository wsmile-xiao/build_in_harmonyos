# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E2174.kv，填写各字段
# 对应的人类文档: doc/E2174.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E2174
trigger_tool: clang
phase: compilation
error_signature: expected readable system register|ID_AA64ZFR0_EL1

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: portability,detection,ohos,compiler,architecture
match_keywords: StringZilla,ID_AA64ZFR0_EL1,expected readable system register,HarmonyOS Clang,Arm capability probe
title: HarmonyOS Clang 上 Arm 能力寄存器读取必须降级为保守探测

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: StringZilla 的 Arm SIMD 能力检测在 HarmonyOS Clang 目标上读取 ID_AA64ZFR0_EL1 等系统寄存器；该寄存器对当前用户态工具链不可读，导致跨编译阶段直接失败。
affected_scope: 在 HarmonyOS aarch64 上使用 Arm SIMD 能力检测或直接读取系统寄存器的 C/C++ 库。
verification_cmd: 使用 ohos-aarch64 Conan profile 构建目标库并运行已安装 C consumer；确认编译、链接和消费者执行均通过。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: ohos-conservative-capability-probe
rec_description: 在 OHOS shared target 复用上游已有的 SZ_AVOID_LIBC=1 保守能力探测路径，避免 Linux POSIX Arm 系统寄存器读取，同时关闭 libc 符号覆盖；不新增平台条件宏。
rec_command: Set CMake's OHOS shared target to SZ_AVOID_LIBC=1 and SZ_OVERRIDE_LIBC=0, then validate the Conan consumer.
rec_auto_fix: false
rec_impl: cmake-avoid-libc-capability-fallback

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: disable-optional-simd-detection
fallback_description: 若无法使用上游 SZ_AVOID_LIBC=1 路径，则禁用可选 SIMD 能力检测并使用串行实现。
fallback_command:
fallback_auto_fix: false
fallback_impl: conservative-serial-fallback

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: mrs ID_AA64|SZ_DYNAMIC_DISPATCH.*system register
forbid_1_reason: 跨编译器无法读取的 Arm 系统寄存器不是可用能力证明，保留该读取会让目标库在编译阶段失败。
forbid_1_consequence: 适配在 OHOS Clang 编译阶段失败，无法产生可供 Conan consumer 验证的包。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E266, E302
conflicts_with:         []
prerequisite_of:        []

