#====================================================================
# DRAFT-aflplusplus-ohos-posix-types.kv
# aflplusplus 4.33c OHOS 适配: musl libc 不传递包含 POSIX 类型, 需显式 include <sys/types.h>
#====================================================================

id:                     DRAFT (proposed E###)
trigger_tool:           clang|cc
phase:                  compilation
error_signature:        unknown type name 'uid_t'|unknown type name 'pid_t'|unknown type name 'mode_t'|unknown type name 'gid_t'|unknown type name 'off_t'
severity:               2
category:               platform|headers|posix|libc|ohos
match_keywords:         uid_t, pid_t, mode_t, gid_t, off_t, sys/types.h, unknown type name,
                         forkserver.h, sharedmem.h, POSIX 类型, 传递包含, 隐式 include,
                         musl, glibc, OHOS
title:                  OHOS musl libc 不传递包含 POSIX 类型, 头文件须显式 #include <sys/types.h>

root_cause:             OHOS SDK 的 libc (musl) 不像 glibc 那样通过 <unistd.h>/<stdio.h>/
                        <fcntl.h> 等头文件传递包含 <sys/types.h> 中的 POSIX 类型定义
                        (uid_t/pid_t/mode_t/gid_t/off_t/ssize_t 等)。上游代码在头文件中
                        直接使用这些类型却未显式 include <sys/types.h>, 依赖 glibc 的
                        传递包含在 Linux 上能通过编译; 移植到 OHOS 后传递包含失效, 编译
                        报 "unknown type name 'uid_t'" 等错误。
                        (AFL++ 实锤: include/forkserver.h 用 uid_t/pid_t/mode_t,
                        include/sharedmem.h 用 mode_t, 均未 include <sys/types.h>,
                        只 include "types.h" 自定义头)

affected_scope:         所有在头文件/源文件中使用 POSIX 类型 (uid_t/pid_t/mode_t/
                        gid_t/off_t/ssize_t 等) 但未显式 include <sys/types.h> 的
                        C/C++ 库 (典型: fuzzer、系统工具、网络服务等系统级软件)
verification_cmd:       grep -rnE "uid_t|pid_t|mode_t|gid_t|off_t" <头文件> | grep -v "sys/types.h"

rec_priority:           1
rec_approach:           patch-add-sys-types-include
rec_description:        在报错的每个头文件顶部 (首次使用 POSIX 类型的 #include 块后)
                        补丁添加 #include <sys/types.h>。这是最小、可移植、不改变 ABI
                        的修复, 遵循 R6 (只改源文件不改生成文件)。
rec_command:            # 生成最小 diff (每个头文件只加一行):
                        # 在 #include "types.h" 后插入 #include <sys/types.h>
                        # patch 用 difflib.unified_diff 生成, 保持最小化
rec_auto_fix:           false
rec_impl:               manual-hint

fallback_priority:      2
fallback_approach:      compile-flag-include
fallback_description:   不改源码, 在 recipe 的 CFLAGS 中追加 -include sys/types.h
                        强制每个编译单元先包含该头文件 (暴力兜底, 会污染所有编译单元,
                        仅在无法 patch 头文件时使用)。
fallback_command:       CFLAGS += -include sys/types.h
fallback_auto_fix:      false
fallback_impl:          none

# ★ 禁止策略 ★
forbid_1_pattern:       手动 typedef uid_t|手动 typedef pid_t|手动 typedef mode_t
forbid_1_reason:        手写类型定义可能与 musl 的真实定义冲突 (大小/符号不一致),
                        导致 ABI 不兼容或类型重定义错误。
forbid_2_pattern:       sed -i.*#include(整文件重写)
forbid_2_reason:        违反 R6; 整文件重写 patch 变更过大, 审查困难 (tre PR 教训:
                        78KB 整文件替换被 CI bot 跳过)。

principles:

causes:                 []
caused_by:              []
similar_to:             [E032, E033, E113, E152, E194, E367, E086]
conflicts_with:         []
prerequisite_of:        []

doc_file:               drafts/DRAFT-aflplusplus-ohos-posix-types.md
last_updated: 2026-08-23
source_event:           aflplusplus 4.33c 适配 + afl++-tools 4.40c 适配均命中: forkserver.h/
                        sharedmem.h 使用 uid_t/pid_t/mode_t 未 include <sys/types.h>,
                        OHOS musl 编译报 unknown type name (补丁 0001/0002 修复)

authors:                atomcode-executor
