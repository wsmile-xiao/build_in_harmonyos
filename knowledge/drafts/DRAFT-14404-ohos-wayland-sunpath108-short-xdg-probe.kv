id:                     DRAFT-14404
trigger_tool:           test
phase:                  testing
error_signature:        socket path .*exceeds 108|plus null terminator exceeds 108|sun_path
severity:               2
category:               ohos, socket, limitation
match_keywords:         sun_path, 108, socket path, XDG_RUNTIME_DIR, TMPDIR, libwayland, wayland display, 短路径, conan 深路径
title:                  libwayland sun_path 108 字节硬限 × conan 缓存深路径 → 短路径候选探测 + 失败即抛（DRAFT-10004 的跨机通用化）

root_cause:             libwayland 在 bind 前对解析后 socket 全路径校验 ≤108 字节（POSIX sun_path 上限）；conan 缓存构建树路径深（实例 69+ 字符前缀）+ XDG_RUNTIME_DIR 前缀 + 测试最长 50 字符 socket 名 → 超限 → display.start() 直接失败（bind 前的库内校验，LD_PRELOAD 拦不到）
affected_scope:         所有 in-process 测试用 wayland display socket 且构建树位于 conan 缓存深路径的包
verification_cmd:       [ $(( ${#XDG_RUNTIME_DIR} + 1 + 50 )) -le 108 ] && echo OK  # 长度预算断言

rec_priority:           1
rec_approach:           short-xdg-candidate-probe
rec_description:        测试环境 XDG_RUNTIME_DIR/TMPDIR 用短路径候选按序探测（/tmp/<name> → $HOME/.kf5/<name>，可写探测首个胜出；OHOS /tmp 只读（E002）时自然落到 $HOME/.kf5）+ 长度断言（len(xdg)+1+最长 socket 名 ≤108）失败即 RuntimeError fail-fast——不让错误深到 libwayland 层变成晦涩的 socket path 报错
rec_command:            候选探测 + 断言参考 kf5wayland/5.116.0 conanfile _short_dir；实例取值 $HOME/.kf5/xfullxdg（38 字符，+1+50=89≤108）
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      declare-boundary
fallback_description:   无短可写路径（HOME 树也深/只读）→ socket 依赖测试不可跑，排除并声明平台边界（不伪造短路径）
fallback_command:
fallback_auto_fix:      false
fallback_impl:          manual

causes:                 []
caused_by:              []
similar_to:             [DRAFT-10004-qtwayland-qt-tests-deep-path-socket-tmpdir-qpa]
conflicts_with:         []
prerequisite_of:        []

verify_builds:          kf5wayland/5.116.0 PR #13869（XDG=$HOME/.kf5/xfullxdg 38 字符；ctest 29/29 全过）
source_pr:              https://atomgit.com/OpenHarmonyPCDeveloper/build_in_harmonyos/merge_requests/13869
