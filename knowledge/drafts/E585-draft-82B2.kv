#====================================================================
# E585 (draft) — conandata.yml 数字型版本键未加引号被 YAML 解析成 float/int，
#                conan_data["sources"][self.version] 抛 KeyError
# Source: usleep 20160311.094456 适配（HarmonyOS PC aarch64）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E585
trigger_tool:           conan|python
phase:                  configuration
error_signature:        KeyError: '[0-9]+(\.[0-9]+)?'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               conan, packaging, version
match_keywords:         conandata.yml, KeyError, conan_data, sources, self.version, version key, YAML, float, int, safe_load, quoted, 版本键, 引号, date version, YYYYMMDD, snapshot version
title:                  conandata.yml 版本键形如 N 或 N.N（日期/快照/两段版本）不加引号时被 YAML 解析成 int/float，按 self.version 查 sources 抛 KeyError

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Conan 用 yaml.safe_load（YAML 1.1）读 conandata.yml：只含数字且至多一个点的裸键被解析成数字，
                        20160311.094456 / 20240116.1 / 2.5 → float，20260609 → int，1.10 → float 1.1（尾零丢失）；
                        三段版本 1.2.3 不是合法数字才保持字符串。self.version 永远是 str，
                        conan_data["sources"][self.version] 找不到数字键 → source() 抛 KeyError: '<版本>'；
                        patches 若也用版本键，apply_conandata_patches 执行 patches.get(str(version), []) 拿到默认空列表，
                        不打印任何日志、一个补丁都不打（export_conandata_patches 同理）。
                        conan-init 生成的是扁平 sources（url/sha256 不带版本键）所以不会触发，
                        一旦按仓库主流写法改成版本键而没加引号就会中招。
affected_scope:         所有版本号为纯数字或「数字.数字」形式的配方：日期版本（YYYYMMDD、YYYYMMDD.N、YYYYMMDD.HHMMSS 快照）、
                        两段版本（2.5、3.0、1.10），且 conandata.yml 的 sources/patches 用版本作键、配方按 self.version 查找；
                        本仓库 conandata.yml 版本键 945 份加引号、25 份未加引号（其中 unilog/2.5 为 float 键，因配方未按版本查找而未触发）
verification_cmd:       python3 -c 'import yaml;print({k:type(k).__name__ for k in yaml.safe_load(open("conandata.yml"))["sources"]})'  # 任何非 str 的键即命中

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           quote-conandata-version-keys
rec_description:        conandata.yml 的 sources/patches 版本键一律加双引号（"20160311.094456":），与仓库 945 份配方主流写法一致；配方保持 get(self, **self.conan_data["sources"][self.version], strip_root=True)
rec_command:            sed -i -E 's/^(  )([0-9]+(\.[0-9]+)?):[[:space:]]*$/\1"\2":/' conandata.yml && python3 -c 'import yaml;d=yaml.safe_load(open("conandata.yml"));assert all(isinstance(k,str) for k in d["sources"]),d["sources"].keys()'
rec_auto_fix:           true
rec_impl:               yaml-quote-version-key

fallback_priority:      2
fallback_approach:      flat-sources-without-version-key
fallback_description:   单版本配方也可用扁平 sources（url/sha256 直接挂在 sources 下）配合 get(self, **self.conan_data["sources"])，从根上不出现版本键；patches 用 list 格式
fallback_command:       get(self, **self.conan_data["sources"], strip_root=True)
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       conan_data\["sources"\]\[float\(|conan_data\["sources"\]\[int\(|str\(k\) *== *self\.version
forbid_1_reason:        在配方里把 self.version 转成 float/int 或遍历键做 str 比较来迁就 YAML 类型推断：1.10 → 1.1、前导零丢失，结果不可靠且掩盖真正的数据问题
forbid_1_consequence:   版本 1.10 与 1.1 撞键或查错源码包；审计判定为绕过而非修复
forbid_2_pattern:       ^\s+[0-9]+(\.[0-9]+)?:\s*$
forbid_2_reason:        conandata.yml 中出现未加引号的纯数字/单点数字版本键
forbid_2_consequence:   source() KeyError（W3/CI conan create 失败）或 patches 零日志跳过（编译可能照常通过但补丁未生效）

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E392]
conflicts_with:         []
prerequisite_of:        []

