# ═══ Draft knowledge entry — CMake 自带 Find 模块的单复数变量错配与静态 readline 的 terminfo 并链 ═══
# Timestamp: 2026-09-24
# Software: sjaakii 1.4.1
# Gate: G2/conan create（configure + link）
# Status: DRAFT — needs human/AI review to promote to E-entry（E722 已取号占位）
#
# To promote:
#   1. Review the error excerpt below
#   2. Rename to E722.kv and move to knowledge/graph/
#   3. Add a row to knowledge/graph/index.tsv
#   4. Write knowledge/doc/E722.md

id:                     DRAFT-E722
trigger_tool:           cmake|conan|clang|ld
phase:                  configuration|linking
error_signature:        readline\.h.*(No such file|file not found)|undefined reference to `(tgetent|tgetflag|tgoto|tputs)'|Found candidate FindReadline

severity:               3
category:               toolchain|cmake|find-module|static-link|readline
prescan_pattern:        (READLINE_INCLUDE_DIRS|undefined reference to .?t(getent|getflag|goto|puts)|libreadline\.a)
match_keywords:         FindReadline, READLINE_INCLUDE_DIR, READLINE_INCLUDE_DIRS, 单复数变量, readline.h, libreadline.a, tgetent, tgoto, tputs, terminfo, ncursesw, 静态链接, conan 包目录, 非系统前缀
title:                  上游自带 Find 模块的单复数变量错配只在非系统前缀下暴露；静态 libreadline.a 必须并链 ncurses terminfo 后端

root_cause: >
  两个叠加的"系统前缀依赖"缺陷：(1) 上游 FindReadline.cmake 只 set 单数
  READLINE_INCLUDE_DIR，而消费方 CMakeLists 使用复数 READLINE_INCLUDE_DIRS —— 系统
  前缀（/usr/include）下 include 恒可达，错配被掩盖；一旦依赖来自非系统前缀（conan
  包目录），include_directories 收到空值，readline.h 找不到。(2) conan 静态
  libreadline.a 未定义 terminfo 后端符号（tgetent/tgetflag/tgoto/tputs/BC/PC/UP），
  这些符号在 ncurses 中（nm 实证 libncursesw.a 提供 T tgetent）；只链 readline 不链
  ncurses 时链接期 undefined reference。两缺陷都只在"非系统前缀 + 静态库"组合下出现，
  在常规 Linux 发行版开发机上不可复现。
affected_scope:         所有上游自带简化版 Find 模块、且以 conan/system-root 提供
                        readline 之类"带 terminfo 依赖的静态库"的 CMake 项目；
                        aarch64/OHOS conan 交叉构建必然命中。

verification_cmd:       nm -g <conan>/p/readl*/p/lib/libreadline.a | grep -E 'U (tgetent|tgoto|tputs)' ; nm -g --defined-only <conan>/p/ncur*/p/lib/libncursesw.a | grep ' T tgetent'

rec_priority:           1
rec_approach:           fix-find-module-plural-and-chain-ncurses
rec_description:        Find 模块在 FIND_PATH 后补 set(READLINE_INCLUDE_DIRS ${READLINE_INCLUDE_DIR}) 对齐消费方变量名；READLINE_FOUND 分支内 find_library(NCURSES_LIBRARY NAMES ncursesw ncurses) 并链到 target_link_libraries，条件存在才链（conan toolchain 已把依赖包目录前置进 CMAKE_LIBRARY_PATH，find_library 直接命中）
rec_command:            set(READLINE_INCLUDE_DIRS ${READLINE_INCLUDE_DIR}) && find_library(NCURSES_LIBRARY NAMES ncursesw ncurses) && target_link_libraries("sjaakii" ${READLINE_LIBRARY} ${NCURSES_LIBRARY})
rec_auto_fix:           false
rec_impl:               archives/s/sjaakii/1.4.1/patches/0001-CMakeLists.txt.patch + 0002-cmake-FindReadline.cmake.patch

fallback_priority:      2
fallback_approach:      conanfile-cache-variables-bridge
fallback_description:   不改上游 Find 模块时，可在 conanfile generate() 里用 tc.cache_variables 预置 READLINE_INCLUDE_DIRS/READLINE_LIBRARY 绝对路径（find_ 命令对已设值跳过），ncurses 并链仍需补丁或同样预置——预置法对 transitive 依赖路径变化更脆，仅当补丁被拒时使用
fallback_command:       tc.cache_variables["READLINE_INCLUDE_DIRS"] = os.path.join(dep.package_folder, "include")
fallback_auto_fix:      false
fallback_impl:          conanfile-generate

forbid_1_pattern:       -lncurses.*--as-needed.*-lreadline|-lreadline.*--as-needed.*-lncurses
forbid_1_reason:        静态链接顺序敏感，readline 在前 ncurses 在后（readline 引用 ncurses 符号），把 ncurses 提前或加 --as-needed 剪枝会重新触发 undefined reference
forbid_1_consequence:   链接期 undefined reference to tgetent/tgoto/tputs，G2 失败

forbid_2_pattern:       CMAKE_C_FLAGS.*-DHAVE_READLINE.*-I/usr/include|include_directories.*/usr/include/readline
forbid_2_reason:        绕开 Find 模块直接指系统前缀，掩盖变量错配且在无系统 readline 的 worker 上必败
forbid_2_consequence:   设备/CI 前缀不一致，本地绿 CI 红（假绿）

