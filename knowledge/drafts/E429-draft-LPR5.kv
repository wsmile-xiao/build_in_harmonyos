#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: libtoolize|autoreconf
phase: configuration
error_signature: libtoolize:\s+error: '.*share/libtool-conan/libltdl/.*' not found|autoreconf: error: .*libtoolize failed with exit status: 1

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: autotools, conan, packaging
match_keywords: libtoolize, libltdl, share/libtool-conan, not found, autoreconf failed with exit status 1, LT_CONFIG_LTDL_DIR, ohpcd libtool
title: ohpcd libtool 制品把独立 libltdl 发行版装在 share/libtool/，libtoolize --ltdl 复制失败导致 autoreconf 终止

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: libtool/2.5.4 制品的 package() 把上游独立 libltdl 发行版（含 pregenerated configure、ltdl.c、loaders/、Makefile.in）装到 share/libtool/，而 libtoolize 查找 ltdl 的路径是 <pkgdatadir>/libltdl（该包里是 share/libtool-conan/libltdl，只剩头文件）→ LT_CONFIG_LTDL_DIR 声明的项目（libprelude、Gnumeric 等）无法用 libtoolize --ltdl 自举
affected_scope: 所有 configure.ac 里有 LT_CONFIG_LTDL_DIR 且归档无 configure 的项目（libprelude 5.2.0 实测）
verification_cmd: ls <libtool 包>/share/libtool/configure && (libtoolize -c --force --ltdl --automake; echo $?)

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: materialize-libltdl-from-libtool-package
rec_description: 不跑 autoreconf；在 conanfile.build() 里依次执行 libtoolize -c --force --automake（忽略其 ltdl 复制失败）→ 从 tool_requires 的 libtool 包把 share/libtool 复制成源码树的 libltdl/ → 清掉 libltdl/Makefile.in 里未被替换的 @MAINTAINER_MODE_TRUE@ 字面量 → 手工跑 aclocal/autoconf/autoheader/automake 完成自举
rec_command: self.run('"$LIBTOOLIZE" -c --force --automake', ignore_errors=True); shutil.copytree(<libtool>/share/libtool, <src>/libltdl)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

