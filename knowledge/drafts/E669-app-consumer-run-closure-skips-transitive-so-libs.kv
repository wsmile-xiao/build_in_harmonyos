#====================================================================
# E669-app-consumer-run-closure-skips-transitive-so-libs
#   application 型消费者的 conan 运行闭包会 Skipped 掉 DT_NEEDED 的
#   传递共享库 → test_package 拿不到其 libdir → musl 报 symbol not found
# 来源: PR feat(lnav): 0.13.2 适配 HarmonyOS PC
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E669-app-consumer-run-closure-skips-transitive-so-libs
trigger_tool:           conan|test
phase:                  runtime
error_signature:        Error relocating .*symbol not found|Error loading shared library lib|deflateBound|curl_easy_cleanup

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, runtime, shared-libs, test_package, musl,
                        application-package, run-closure
match_keywords:         Skipped binaries, Computing necessary packages,
                        VirtualRunEnv, self.dependencies, package_folder,
                        LD_LIBRARY_PATH, DT_NEEDED, NEEDED, libarchive.so,
                        readelf, run closure, 运行闭包, 再导出, relocation,
                        symbol not found, test_package, application
prescan_pattern:        Error relocating|symbol not found|Skipped binaries|
                        Computing necessary packages
prescan_globs:          'conanfile.py, **/test_package/conanfile.py, **/conan-verify-report.md, **/*.log'

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             conan 2 对消费者图计算「necessary packages」时，传递
                        依赖只在贡献 runenv（包自身 runenv_info 有 PATH 等）
                        或被依赖方 package_info 访问过 package_folder 时才
                        计入运行闭包，其余落进 Skipped binaries（实测
                        necessary=lnav/curl/tzdata，DT_NEEDED 的 libarchive
                        被 skip）。被 skip 的包：①不进 test_package 的
                        self.dependencies.host，test() 按
                        package_folder 枚举 lib/lib64 注入 LD_LIBRARY_PATH
                        时拿不到它的目录；②VirtualRunEnv 也不为其生成
                        libdir。musl 在设备上没有 /system/lib 同名库兜底，
                        加载即失败。更隐蔽的变体：符号 provider 不是
                        DT_NEEDED 本身——zlib 静态链入 libarchive.so.13
                        后以全局符号再导出，bin/lnav 的 deflate* 为 UND、
                        又无 DT_NEEDED libz，唯一 provider 就是
                        libarchive.so.13（readelf 实测），缺它的目录时报
                        「deflateBound：symbol not found」，极易误判成
                        zlib 装错。
affected_scope:         package_type=application（包内只有 bin/、无 lib/）
                        且依赖图含共享库的包，在 test_package/任何消费者
                        运行阶段；conan 2.x 图算法，与具体包无关。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           declare-runtime-so-requires-in-test-package
rec_description:        test_package 的 requirements() 除 tested_reference
                        外显式 self.requires 运行期 .so 直依赖（与配方同
                        版本，去重无冲突），使其成为消费者直依赖、必然计入
                        necessary packages；test() 再枚举
                        self.dependencies.host 各 package_folder 下
                        lib/lib64 拼进 LD_LIBRARY_PATH（组件化包
                        cpp_info.libdirs 为空，不能只读 cpp_info）。
                        两层叠加后包目录既进依赖表又进运行环境。
rec_command:            self.requires("libarchive/3.8.7")
rec_auto_fix:           false
rec_impl:               conan-test-package-requires

fallback_priority:      2
fallback_approach:      recipe-package-info-runenv-prepend
fallback_description:   在配方 package_info() 里访问该依赖的
                        package_folder 并 runenv_info.prepend_path
                        （LD_LIBRARY_PATH, <包目录>/lib）——tzdata 的
                        TZDIR 同款通道，把包重新拉回运行闭包并注入所有
                        消费者（含 CI shadow 轮）。
fallback_command:       self.runenv_info.prepend_path("LD_LIBRARY_PATH", os.path.join(self.dependencies["libarchive/3.8.7"].package_folder, "lib"))
fallback_auto_fix:      false
fallback_impl:          conan-runenv-info

# ★ 禁止策略 ★
forbid_1_pattern:       echo .*PASS|exit 0.*skip|assertion.*(removed|disabled)
forbid_1_reason:        为消错误而弱化/删除 test_package 断言或空跑通过——
                        把运行期失败藏成绿灯，属假绿通道
forbid_1_consequence:   打包出跑不起来的二进制仍判 PASS，CI/用户侧才爆
forbid_2_pattern:       /system/lib.*LD_LIBRARY_PATH|patchelf.*--replace-needed
forbid_2_reason:        把 DT_NEEDED/LD_LIBRARY_PATH 指向设备系统库或改写
                        依赖库名——设备与 CI worker 库形态不同，形成静默
                        错配与不可复现（共享前缀禁令 R49/E524 同族）
forbid_2_consequence:   本机过、CI 挂；或运行期加载到错误版本库

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P006

# ═══ 关系图 (Relations) ═══
similar_to:             E540-shadow-ci-hnp-tool-path（同为运行期 PATH/库
                        解析错位导致假失败，但那条是构建工具链 PATH、本条
                        是消费者运行期共享库闭包）、
                        DRAFT-conan-dep-shared-libs-break-configure-conftest
                        （同属 conan 依赖注入与真实运行/链接面的错配）
caused_by:
conflicts_with:
prerequisite_of:

# ═══ 元数据 ═══
verification_cmd:       readelf -d <bin> | grep NEEDED
                        # ① 列出 DT_NEEDED 共享库；② conan install
                        #   <test_package 目录> -pr:h=<profile> --format=json
                        #   看 graph.nodes[].binary：provider 为 Skip 即命中本条
                        #   （lnav 实测：显式 requires 后转 Cache、test.sh 6/6）
doc_file:               knowledge/drafts/E669-app-consumer-run-closure-skips-transitive-so-libs.md
last_updated:           2026-09-22
source_event:           lnav 0.13.2 适配（feat/lnav-0.13.2）：test_package G2
                        连续 4 轮 FAIL（deflateBound：symbol not found），
                        定位为 libarchive 被 Skipped 不进消费者依赖表；
                        显式 requires 后 conan graph 实测 binary=Cache、
                        LD 注入后 test.sh 6/6
authors:                lnav-0.13.2 任务
source_pr:              feat/lnav-0.13.2
source_commit:          待 PR 建立后回填

