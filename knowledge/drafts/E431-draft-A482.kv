#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E431.kv，填写各字段
# 对应的人类文档: doc/E431.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E431
trigger_tool: cmake|make
phase: build
error_signature: Error 127|inaccessible or not found|::

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: cmake, cross-compile, build-system, host-tools
match_keywords: CMake, ALIAS, add_custom_command, COMMAND, TARGET_FILE, toolchain, CMAKE_SYSTEM_NAME, host tool, cross-compile, Error 127, BifCl, BinPAC, gen-zam
title: CMake 4.x 工具链模式下 add_custom_command COMMAND 不展开 :: 命名空间 ALIAS 目标名：host 生成器被字面执行报 Error 127

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: CMake 4.1.2 在设置 toolchain（CMAKE_SYSTEM_NAME 置位=交叉模式）后，add_custom_command(COMMAND ...) 中 :: 命名空间的 ALIAS 目标名不再展开为可执行文件真实路径，build.make 里保留字面量（cd ... && Zeek::BifCl ...）。host 生成器本身（bifcl/binpac/gen-zam）已真实构建成功且可执行，只有命令行未展开。交叉编译私有工具链（host 工具+目标产物）场景的典型陷阱。
affected_scope: 所有交叉编译（CMAKE_SYSTEM_NAME 置位）且用 add_custom_command(COMMAND <ALIAS 目标>) 运行 host 生成器工具（词法/语法/绑定生成器及自研工具链）的 CMake 项目。
verification_cmd: grep -n '::' build.make | head（出现字面 ALIAS 名=命中）；grep -n 'TARGET_FILE' build.make（应已展开为真实路径）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: generator-expression-target-file
rec_description: 把 CMake 源中 COMMAND Zeek::BifCl/Zeek::BinPAC/gen-zam 改为生成器表达式 $<TARGET_FILE:Zeek::BifCl> 等，generate 期展开真实路径。重配置后验证 build.make 命令已展开为 ../tools/binpac/src/binpac，三生成步骤全过。通用做法，其他 host 生成器目标同样适用，无平台宏。
rec_command: cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=<toolchain.cmake> && grep -n 'TARGET_FILE' cmake/BifCl.cmake && make bif-std-types.bif
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

