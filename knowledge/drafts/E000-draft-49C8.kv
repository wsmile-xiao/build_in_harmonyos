#====================================================================
# E000-draft-49C8.kv — CMake 4 不识别 HarmonyOS 平台导致 SONAME 缺失
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E000
trigger_tool:           cmake|ld|runtime
phase:                  linking|runtime
error_signature:        System is unknown to cmake|readelf.*-d.*无 SONAME|NEEDED.*\.\./.*\.so|Error loading shared library \.\./.*\.so|SONAME.*not set

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, linking, portability
match_keywords:         HarmonyOS, CMake, SONAME, VERSION, SOVERSION, LINK_FLAGS,
                        相对路径链接, ../lib, NEEDED, RUNPATH, RPATH, $ORIGIN,
                        shared library, 内部库链接, unknown system
title:                  CMake 4 不识别 HarmonyOS 平台导致 SONAME 缺失：LINK_FLAGS 显式 -soname + RUNPATH 修复

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             CMake 4.1.2 不识别 HarmonyOS 平台（configure 报 "System is unknown to cmake"，
                        无 Platform/HarmonyOS.cmake 模块），因此 set_target_properties 的
                        VERSION/SOVERSION 链接命名机制未应用——生成的共享库无 SONAME 字段，
                        同一项目内可执行文件链接该库时 NEEDED 记录相对路径（如
                        ../librazer/librazer.so）而非标准 SONAME。安装到 bin/ 与 lib/ 分离
                        布局后，动态链接器按相对路径解析失败，程序无法启动。
affected_scope:         使用 CMake 构建、包含"项目内共享库 + 链接该库的可执行文件"结构、
                        在 HarmonyOS/OHOS 平台（或任何 CMake 不识别的新平台）上打包的软件。
verification_cmd:       1) cmake -B build 2>&1 | grep "System is unknown to cmake" 确认平台不识别;
                        2) readelf -d lib/*.so | grep SONAME 确认共享库无 SONAME;
                        3) readelf -d bin/* | grep NEEDED 确认 NEEDED 为相对路径 ../xxx/xxx.so;
                        4) 安装到 bin/ lib/ 分离布局后运行可执行文件报 Error loading shared library

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           soname-link-flags-injection
rec_description:        绕过 CMake 平台命名机制：在共享库 target 的 set_target_properties 中
                        用 LINK_FLAGS 显式注入 "-Wl,-soname,libxxx.so"，使生成的 .so 带标准
                        SONAME；同时在可执行文件 target 注入 "-Wl,-rpath,'$ORIGIN/../lib'"
                        （RUNPATH），使安装到 bin/ 后可定位 lib/ 下的共享库。
rec_command:            set_target_properties(razer PROPERTIES LINK_FLAGS "-Wl,-soname,librazer.so");
                        set_target_properties(razerd PROPERTIES LINK_FLAGS "-Wl,-rpath,'\\$ORIGIN/../lib'")
rec_auto_fix:           true
rec_impl:               cmake-patch

fallback_priority:      2
fallback_approach:      install-symlink-or-copy
fallback_description:   若无法修改链接 flag（如无法 patch），可在 package() 中为版本化 SONAME
                        创建符号链接（os.symlink）或将库复制为 NEEDED 期望的文件名，
                        使运行时解析成功（参考 E274 create-soname-symlink）。
fallback_command:       os.symlink("librazer.so", "librazer.so.1")
fallback_auto_fix:      false
fallback_impl:          conan-recipe-helper

# ★ 禁止策略 ★
forbid_1_pattern:       mkdir -p .*/libxxx && cp .*/lib/.*\.so .*/libxxx/
forbid_1_reason:        仅创建同名目录的临时 workaround 依赖可执行文件在特定相对位置运行，
                        无法在 bin/ lib/ 分离的安装布局下工作，也不是根本修复。
forbid_1_consequence:   安装到标准布局后程序仍报 Error loading shared library，测试假通过。
forbid_2_pattern:       RPATH.*\$ORIGIN|INSTALL_RPATH.*\$ORIGIN
forbid_2_reason:        仅设置 RPATH/INSTALL_RPATH 无法修复——问题根因是 NEEDED 本身是相对
                        路径而非标准 SONAME，链接器按 NEEDED 名称解析；必须同时修 SONAME。
forbid_2_consequence:   只加 RUNPATH 而共享库无 SONAME 时，动态链接器仍按相对路径查找，修复无效。

# ═══ Layer 4: 原则引用 ═══
principles:             P012

