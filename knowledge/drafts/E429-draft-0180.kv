#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: javac|maven|mvn
phase: compilation
error_signature: Source option 5 is no longer supported|Target option 5 is no longer supported|maven-compiler-plugin

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: build-system, portability, compat
match_keywords: maven, maven-compiler-plugin, source option 5, target option 5, JDK 17, pom.xml, javac, 1.5
title: Legacy Maven pom hardcodes source/target 1.5 and JDK 17 rejects it

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Legacy pom.xml pins maven-compiler-plugin <source>/<target> to 1.5 as explicit plugin configuration; JDK 17 removed javac support for source/target below 7, and an explicit plugin <configuration> outranks the maven.compiler.source property, so a command-line -D cannot override it.
affected_scope: Maven projects whose pom predates ~2016 and therefore inherits maven-compiler-plugin 3.1's 1.5 default, built on an OHOS worker (BiSheng JDK 17 is the only JVM available). Observed on weupnp 0.1.4 (pom.xml:17-25).
verification_cmd: sh <maven>/bin/mvn clean package -B   # in a JDK 17 environment, expect "[ERROR] Source option 5 is no longer supported"; grep -A8 maven-compiler-plugin pom.xml | grep -E '<source>|<target>'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:            1
rec_approach:           patch-build-file-compiler-level
rec_description:        Raise the compiler level inside the build file itself: patch maven-compiler-plugin <source>/<target> from 1.5 to 8 (>= 7) through patches/0001-*.patch, generated with "ohc-run.py refresh-patch --auto". Do not touch the Java sources.
rec_command:            mvn clean package -B -DskipTests=false   # after apply_conandata_patches() has applied patches/0001-pom.xml.patch
rec_auto_fix:           false
rec_impl:               refresh-patch-auto

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      direct-javac-jar
fallback_description:   Only when Maven itself cannot be provisioned at all: compile the sources directly with javac + jar (equivalent only for zero-dependency JVM libraries) and record the deviation; still prefer the Maven path so the upstream build system keeps producing the artifact.
fallback_command:       javac -d classes $(find src/main/java -name '*.java') && jar cf <pkg>-<ver>.jar -C classes . -C src/main/resources .
fallback_auto_fix:      false
fallback_impl:          manual-javac-jar

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       -Dmaven\.compiler\.(source|target)=|maven\.compiler\.release
forbid_1_reason:        Explicit plugin <configuration> wins over the maven.compiler.source property, and maven-compiler-plugin 3.1 has no 'release' parameter at all — the override silently does nothing.
forbid_1_consequence:   The build keeps failing with the identical "Source option 5 is no longer supported" error (weupnp 0.1.4 measured: EXIT_CODE=1 after 4s, unchanged message), i.e. a wasted rebuild cycle plus a false "already fixed" claim.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

