# DRAFT-pex-1.20140409-tap-evidence-boundary.kv - pex test evidence boundary

id: "DRAFT-pex-1.20140409-tap-evidence-boundary"
pr_ref: 9365
trigger_tool: "conan|prove|make|TAP|pex|test_package"
phase: "testing|packaging|ci"
error_signature: "audit\\.t.*YAML.*not installed|Files=16, Tests=88, Failed=1|upstream.*test.*0|unit.*0.*integration.*0"
severity: 2
category: "ohos|testing|tap|evidence-boundary|conan"
match_keywords: "pex, 1.20140409, TAP, Test::Harness, prove, make check, audit.t, Perl YAML, pg_config.t, upstream test, test_package, unit test count, integration test count"
title: "pex 的上游测试必须按 shell TAP 真实入口统计，不能把单元测试和集成测试分类为 0/0 通过"

root_cause: "pex 没有 C/C++ 单元测试框架或单独的集成测试目录，官方测试实际是 17 个 t/*.t shell TAP 文件、98 个计划断言；audit.t 缺少 Perl YAML 时应记录 skipped，不能把 unit=0 和 integration=0 解释成上游测试总数为 0。"

affected_scope: |
  所有使用 shell TAP、Makefile 测试入口或可选测试工具的纯脚本 Conan
  application，尤其是测试分类表要求填写 unit/integration/other 三类
  数量的适配 PR。

verification_cmd: |
  make check
  prove --exec /system/bin/sh t/*.t
  sed -n '1,120p' test_package/MANIFEST.yml
  git diff -- archives/p/pex/1.20140409/README.md archives/p/pex/1.20140409/manifest.yaml

rec_priority: 1
rec_approach: "upstream-tap-and-consumer-evidence-separated"
rec_description: |
  把官方 `t/*.t` 作为上游测试整体统计，在 PR 表格中将 unit/integration
  记为“不适用/0”，同时将 17 个 shell TAP 文件和 98 个计划断言放入
  “其他测试/上游 TAP”并说明来源。CI 结果按实际文件、断言和退出码记录：
  audit.t 因 Perl YAML 缺失而 skipped；其余 16 个文件运行 88 个断言，
  其中 87 个通过、1 个在 pg_config.t 失败。`test_package` 的 15 项消费
  断言另行统计，不能与上游断言相加后伪装成上游通过率。

rec_command: |
  prove --exec /system/bin/sh t/*.t
  /system/bin/sh test_package/test_pex.sh <package_folder> <work_folder>

rec_auto_fix: false
rec_impl: "manifest-and-pr-evidence-classification"

fallback_priority: 2
fallback_approach: "dependency-limited-test-report"
fallback_description: |
  当 CI 缺少 Perl YAML 时，保留 `audit.t` 的 skipped 状态和缺失依赖，
  继续运行可执行的其余 TAP 文件和 test_package；不得将跳过项写成 PASS，
  也不得因为分类表没有 unit/integration 项而报告 0/0。
fallback_command: ""
fallback_auto_fix: false
fallback_impl: ""

forbid_1_pattern: "单元测试 0.*集成测试 0.*上游测试为 0|0/0.*100%|把分类项 0 当成套件未测试"
forbid_1_reason: "pex 的测试模型是 shell TAP，分类项名称不覆盖官方 t/*.t 入口。"
forbid_1_consequence: "PR 测试证据失真，无法复核实际运行了哪些上游测试。"

forbid_2_pattern: "audit.t skipped.*PASS|88/88.*通过|跳过 Perl YAML 后宣称全量测试通过"
forbid_2_reason: "skipped 不是 PASS，且本轮 CI 实际有 pg_config.t 断言失败。"
forbid_2_consequence: "审查者会误判适配质量，后续环境无法定位缺失依赖或平台差异。"

principles: "P004, P006"
causes: []
caused_by: []
similar_to: ["E232", "E253"]
conflicts_with: []
prerequisite_of: []

