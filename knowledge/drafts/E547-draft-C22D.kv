id:                     E547
trigger_tool:           cmake
phase:                  configuration
error_signature:        tiff-cxx.*unused|libtiffxx\.so.*意外构建|Unused variable.*tiff-cxx|CMake.*tiff-cxx
severity:               1
category:               build-system, cmake, portability, ohos, detection
match_keywords:         libtiff, tiff-cxx, cxx option, 4.7.0, libtiffxx, option renamed
title:                  libtiff 4.7.0→4.7.2 CMake C++ 库选项改名（cxx→tiff-cxx）：照搬新版配方开关静默失效
root_cause:             libtiff 上游在 4.7.0 与 4.7.2 之间把 CMake 选项 cxx 改名为 tiff-cxx（cmake/CXXLibrary.cmake: option(cxx ...) → option(tiff-cxx ...)）。CMake 对未定义变量的 -D 开关不报错（只是无效 cache 条目），因此把 4.7.2 配方的 -Dtiff-cxx=OFF 照搬到 4.7.0 构建时静默失效——libtiffxx.so（C++ stream 封装）被意外构建进产物，导致包体积膨胀、package_info.cpp_info.libs 与实际产物不一致、C++ 运行时依赖（libc++_shared.so）被无谓引入。
affected_scope:         libtiff 4.7.0 及以下版本（cxx 时代配方）；任何从 4.7.2+ 配方回移植到 4.7.0 的适配
verification_cmd:       grep -rn "option(cxx\|option(tiff-cxx" cmake/CXXLibrary.cmake; ls build-ohos/lib/libtiffxx.so 2>/dev/null && echo "UNEXPECTED libtiffxx built" || echo "OK: no libtiffxx"
rec_priority:           1
rec_description:        按实际源码的 cmake/CXXLibrary.cmake 选项名传开关：4.7.0 用 -Dcxx=OFF，4.7.2+ 用 -Dtiff-cxx=OFF
rec_command:            grep -n "option(" cmake/CXXLibrary.cmake && cmake -B build-ohos -S . -Dcxx=OFF -Dtiff-tools=OFF -Dtiff-tests=OFF -Dtiff-docs=OFF -Dtiff-contrib=OFF
rec_auto_fix:           false
rec_impl:               manual
fallback_priority:      2
fallback_description:    构建后检查产物清单，发现 libtiffxx.so 即回查选项名并修正重构建
fallback_command:        find build-ohos -name "libtiffxx*" -not -type l
fallback_auto_fix:      false
fallback_impl:           manual
forbid_1_pattern:       直接照搬其他版本配方的 -D 开关不比对源码
forbid_1_reason:         CMake 对未知 -D 开关静默忽略，不产生任何报错
forbid_1_consequence:    开关失效→意外产物（libtiffxx.so）混入包，与 package_info 声明不符，且引入不必要的 C++ 运行时 NEEDED
principles:             P015-verify-each-version, P018-diff-upstream-versions
causes:                 [upstream-option-rename, cmake-silent-ignore-unknown-d]
caused_by:              []
similar_to:             []
