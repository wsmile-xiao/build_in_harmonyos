#====================================================================
# DRAFT-appstream-1.2.0-ohos-toybox-tar-longopts.kv
# OHOS toybox tar 不支持 GNU 长选项 --no-xattrs/--no-acls → tar 子进程报
# "Unknown option" 退出；移除不支持的选项（保留 --no-same-owner/
# --no-same-permissions + 安全 umask）即可
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R03）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           tar (toybox)
phase:                  runtime-extract
error_signature:        Unknown option 'no-xattrs'|
                        Unknown option 'no-acls'|
                        tar: Unknown option
severity:               2
category:               build, tooling, tar, portability, toybox
match_keywords:         tar, toybox, no-xattrs, no-acls, no-same-owner, no-same-permissions,
                        OHOS, extract, tarball, GNU long option
title:                  OHOS toybox tar 不支持 GNU 长选项（--no-xattrs/--no-acls）——移除并保留安全子集
root_cause:             toybox tar 仅实现 GNU tar 长选项子集，未知长选项直接报错；
                        上游防 setuid/xattr 恢复的选项在 toybox 上不可用。
affected_scope:         任何在 toybox tar 平台用长选项 tar 提取的库/脚本。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing; meson test as-test_basic
rec_priority:           1
rec_approach:           tar-longopts-subset
rec_description:        保留 toybox 支持的 --no-same-owner/--no-same-permissions 与安全
                        umask（child_setup），移除 --no-xattrs/--no-acls；toybox 本
                        就不恢复 xattr/ACL，安全语义不损失。
rec_command:            |
  tar -x --no-same-owner --no-same-permissions -C <target_dir>
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       --no-xattrs
forbid_1_reason:        toybox 平台会直接报错退出
principles:             R6, R8
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-ohos-toybox-tar-longopts.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R03（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.85
