#====================================================================
# DRAFT-tidy-5.8.0-cmake4-minimum-version-compat-removed
#   平台 cmake 4.4.3 移除 <3.5 兼容：老工程 cmake_minimum_required(VERSION 2.8.x)
#   直接 configure 失败，须抬到 3.5
# 来源: tidy 5.8.0 适配（本配方 PR；CMakeLists.txt:20 VERSION 2.8.12）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-tidy-5.8.0-cmake4-minimum-version-compat-removed
trigger_tool:           cmake
phase:                  configure
error_signature:        Compatibility with CMake < 3.5 has been removed from CMake\.|
                        Update the VERSION argument <min> value\.|
                        CMAKE_POLICY_VERSION_MINIMUM=3\.5

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               1
category:               build-system, cmake4, compatibility, policy
match_keywords:         cmake_minimum_required, CMake < 3.5, removed,
                        CMAKE_POLICY_VERSION_MINIMUM, cmake 4, 2.8.12,
                        compat, configure failed, 兼容移除
title:                  cmake 4.x 移除 <3.5 兼容：老工程 cmake_minimum_required(VERSION 2.8.x) configure 即死，抬到 3.5 即可
prescan_pattern:        cmake_minimum_required\s*\(VERSION\s+[23]\.[0-4]|
                        Compatibility with CMake < 3\.5
prescan_globs:          CMakeLists.txt, */CMakeLists.txt, **/CMakeLists.txt

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             平台工具链 cmake 为 4.4.3（harmonybrew，环境 PATH 直取，
                        制品仓无 cmake 包）。CMake 4.0 起移除了对
                        cmake_minimum_required(VERSION < 3.5) 的兼容：凡
                        2014-2020 年代工程在顶层 CMakeLists 声明
                        VERSION 2.8.x/3.0 的，configure 第 20 行级即报
                        "Compatibility with CMake < 3.5 has been removed"。
                        注意两点：①该检查发生在 project() 之前，
                        conan_toolchain.cmake 此时还未被读入——因此经
                        CMakeToolchain variables 注入
                        CMAKE_POLICY_VERSION_MINIMUM 无效，必须走命令行
                        -D 或直接改声明；②本仓惯例不 tool_requires cmake
                        （制品仓无 cmake 包，环境直取 harmonybrew 4.4.3），
                        所以"换 cmake 3"的绕法在平台不成立。

affected_scope:         所有 cmake_minimum_required(VERSION < 3.5) 的 CMake
                        工程（2014-2020 年代项目普遍命中）。本题实证：
                        tidy-html5 5.8.0 顶层声明 VERSION 2.8.12。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           bump-minimum-to-3.5-via-patch
rec_description:        一行补丁把 cmake_minimum_required 抬到 3.5（配方的
                        conandata patches 声明，patch_type: build-fix）。
                        语义零变化：3.5 早已是事实基线，上游只是没回头改。
                        不要用 CMakeToolchain variables 注入
                        CMAKE_POLICY_VERSION_MINIMUM（检查先于 toolchain
                        读入，实测无效）；-D 命令行注入可行但 conan
                        CMake helper 不易落位，补丁最稳。
rec_command:            cmake_minimum_required (VERSION 3.5)
rec_auto_fix:           false
rec_impl:               source-patch

# ★ 禁止策略 ★
forbid_1_pattern:       降级.*cmake|安装.*cmake\s*3\.|tool_requires.*cmake/3\.16
forbid_1_reason:        制品仓无任何 cmake 包（实测 conan list "cmake/*"
                        -r=ohpcd = 0），环境 cmake 4.4.3 是唯一工具；
                        试图装旧 cmake 徒劳且违背单工具链原则
forbid_1_consequence:   解析失败绕一圈回到原点，浪费时间
forbid_2_pattern:       CMakeToolchain.*CMAKE_POLICY_VERSION_MINIMUM|variables\[.CMAKE_POLICY_VERSION_MINIMUM.\]
forbid_2_reason:        该检查先于 project()/toolchain 读入（实测：注入后
                        依旧报同一错误），写进配方制造"已处理"假象
forbid_2_consequence:   configure 依旧失败，误导下一轮排查

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P006

# ═══ 关系图 (Relations) ═══
similar_to:             11301-ohos-compile-fail-suite（构建失败面族谱）；
                        E540（hnp 工具路径，同为工具链环境类）
caused_by:
conflicts_with:
prerequisite_of:

# ═══ 元数据 ═══
verification_cmd:       grep -n "cmake_minimum_required" CMakeLists.txt
                        # 期望：VERSION >= 3.5
doc_file:               knowledge/drafts/DRAFT-tidy-5.8.0-cmake4-minimum-version-compat-removed.md
last_updated:           2026-09-22
source_event:           tidy 5.8.0 适配：VERSION 2.8.12 被 cmake 4.4.3 拒绝；
                        抬到 3.5 后全链路（库+console+消费者测试）通过
authors:                sunjunyang
source_pr:              本 PR（tidy 5.8.0 配方 PR，合并后回填编号）
source_commit:          本分支 HEAD

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.95
metrics_last_used:      2026-09-22
