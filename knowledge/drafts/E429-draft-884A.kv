#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: conan|create|curl|codeload|github
phase: source
error_signature: 404: Not Found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, build-system, environment
match_keywords: 404, Not Found, release tag, -RELEASE, v prefix, refs/tags, codeload, 仓库名与制品坐标不一致, jaf-api, jakarta.activation-api, 14 字节
title: 按版本号直接拼 GitHub 归档 URL 会 404（tag 形态有 v<v>/<v>/<v>-RELEASE 三种）；且上游仓库名常与制品坐标不同（如 jaf-api ↔ jakarta.activation-api）——拼 URL 前必须探测 tag 形态并核对仓库名

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 各上游仓库的 release tag 命名不统一：jakartaee/servlet 用 `<version>-RELEASE`（6.1.0、v6.1.0 均 404，仅 6.1.0-RELEASE 为 200）；jakartaee/jaf-api、jakartaee/cdi 用裸 `<version>`。另外 Jakarta EE 系列常见"仓库名 ≠ 制品坐标"：activation 的上游仓库是 jakartaee/jaf-api，而制品坐标是 jakarta.activation:jakarta.activation-api。若按制品名拼仓库 URL 或不加探测，会得到 404（下载到 14 字节的 "404: Not Found" 文本，而非压缩包）。
affected_scope: 所有从 GitHub 拉归档的配方（尤其 Jakarta EE / 规范类仓库）；一旦 URL 错，Conan 侧可能表现为下载成功但内容异常（后续解压/sha256 才报错）
verification_cmd: for t in v6.1.0 6.1.0 6.1.0-RELEASE; do printf "%-14s " "$t"; curl -sS -o /dev/null -w "%{http_code}\n" -L "https://codeload.github.com/jakartaee/servlet/tar.gz/refs/tags/$t"; done

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: probe-tag-shapes-and-verify-archive-bytes
rec_description: ①先用 HTTP 状态码探测候选 tag 形态（`v<version>`、`<version>`、`<version>-RELEASE`），取 200 的那个写进 conandata.yml 并在注释里记录探测结论；②不要假定仓库名 = 制品名，用上游 CONTRIBUTING/SCM 段或搜索确认仓库；③下载后除 sha256 外，顺带校验文件大小与魔数（gzip 头 1f 8b），可第一时间发现把 "404: Not Found" 文本当成压缩包的情况。
rec_command: curl -sS -o /dev/null -w "%{http_code}" -L "https://codeload.github.com/<owner>/<repo>/tar.gz/refs/tags/<candidate>"
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: use-maven-central-sources-jar
fallback_description: 若上游 tag/仓库确实难查明，可退回从 Maven Central 取 `<group>:<artifact>:<version>:jar:sources`（官方源），但会失去"GitHub 源码树 + 完整 reactor"口径，且部分规范仓库的 spec/tck 不发布到 Central
fallback_command:
fallback_auto_fix: false
fallback_impl: forbid_1_pattern:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E429.md
last_updated: 2026-10-08
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

draft: true
contributor_id: 884A
