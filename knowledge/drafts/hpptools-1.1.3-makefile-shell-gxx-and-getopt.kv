# ═══ Draft knowledge entry — OHOS 上上游手写 .make 测试文件硬编码 SHELL := /bin/bash 与 g++，
# 以及 OHOS libc++ <iostream> 不隐式声明 getopt（需显式 #include <getopt.h>）
# Software: hpptools 1.1.3
# Gate: Step2 样例/测试编译 + 实跑（test-alg 410 assertions、zstr 往返）+ conan-verify G2 + W3
# Status: DRAFT

id: hpptools-1.1.3-makefile-shell-gxx-and-getopt
severity: 2
category: ohos|portability|make|compilation|testing
trigger_tool: make|clang++|g++
phase: compilation

keywords: SHELL := /bin/bash, /bin/bash No such file, g++ not found, clang++, header-only, .make, undeclared identifier getopt, optarg, optind, getopt.h, iostream, libc++, POSIX CLI
error_signature: make: /bin/bash: No such file or directory|g\+\+ .*not found|Error 127.*bin/bash|use of undeclared identifier 'getopt'|use of undeclared identifier 'optarg'|use of undeclared identifier 'optind'
match_keywords: SHELL := /bin/bash, /bin/bash No such file or directory, g++, clang++, examples .make, getopt, optarg, optind, getopt.h, iostream, undeclared identifier

root_cause: |
  (1) 上游手写 Makefile/.make 首行 `SHELL := /bin/bash` 时，make 执行每条规则都用
  /bin/bash 启动子 shell；OHOS 无 /bin/bash（bash 在 /storage/Users/currentUser/usr/local/bin/bash
  或 /data/service/hnp/bin/bash），make 报 "/bin/bash: No such file or directory" 并 Error 127。
  同时规则若直接调 g++，OHOS 工具链只有 clang/clang++ 无 g++，同样失败。
  (2) POSIX CLI 源码依赖 glibc 头文件链隐式暴露 getopt/optarg/optind 声明（仅 include
  <iostream>/<string> 等）；OHOS libc++（musl 系）的 <iostream> 不隐式引入 getopt.h，
  -std=c++11 下编译报 "use of undeclared identifier 'getopt'/'optarg'/'optind'"。

rec_approach: clangxx-equivalent-commands + explicit-getopt-include
rec_description: |
  (1) 不依赖硬编码 SHELL/g++ 的 .make 文件：用 clang++ 按 makefile 等价命令直接编译
  （如 `clang++ -std=c++11 -O0 -g3 -Wall -Wextra -pedantic -D SAMPLE_XXX -x c++ ../include/alg.hpp -o sample-alg`），
  需要 -pthread 的补 -pthread，需要 zlib 的 -lz -L<zlib lib>。实测 hpptools examples 全部
  样例 + 测试目标编译通过并实跑。
  (2) 对使用 getopt/optarg/optind 的 POSIX CLI 源文件，在文件顶部显式
  `#include <getopt.h>`（OHOS sysroot 存在
  /data/service/hnp/ohos-sdk.org/*/ohos/native/sysroot/usr/include/getopt.h），
  作为 patches/ 补丁提交。实测 zc.cpp 补 include 后编译通过，全部往返用例一致。

rec_command: |
  # (1) 样例/测试直编（在 examples/ 目录，cwd=源码 examples）:
  clang++ -std=c++11 -O0 -g3 -ggdb -fno-eliminate-unused-debug-types -Wall -Wextra -pedantic -D SAMPLE_ALG -x c++ ../include/alg.hpp -o sample-alg
  clang++ -std=c++11 -pthread -O0 -g3 -ggdb -fno-eliminate-unused-debug-types -Wall -Wextra -pedantic -D SAMPLE_PFOR -x c++ ../include/pfor.hpp -o sample-pfor
  clang++ -std=c++11 -I../include -I<boost include> -o test-alg test-alg.cpp -lz -L<zlib lib>
  # (2) getopt 补丁（patches/0001-*.patch）:
  #   zc.cpp 顶部增加一行: #include <getopt.h>
rec_auto_fix: false
rec_impl: manual

fallback_priority: 2
fallback_approach: make-SHELL-override
fallback_description: |
  若必须用 make 执行 .make：可用 `make -f xxx.make SHELL=/storage/Users/currentUser/usr/local/bin/bash`
  覆盖 SHELL（make 命令行变量优先），但 g++ 缺失仍需 CXX=clang++ 覆盖或直编；仅作降级兜底。
fallback_command: make -f sample-alg.make SHELL=/storage/Users/currentUser/usr/local/bin/bash CXX=clang++
fallback_auto_fix: false
fallback_impl: manual

# 禁止策略
forbid_1_pattern: ln -sf /bin/bash /bin/bash|cp .*/bash /bin/bash   # 不建 /bin/bash 软链污染系统
forbid_2_pattern: #define getopt\(|static.*getopt\(\)            # 不得自定义伪造 getopt 宏

# 关联既有条目
similar_to: E346, E165, E493, E503
caused_by: ""
prerequisite_of: ""
conflicts_with: ""
