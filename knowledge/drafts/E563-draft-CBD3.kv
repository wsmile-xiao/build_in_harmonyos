#====================================================================
# E563-draft-CBD3 — OHOS musl 空 libutil.a：上游 -lutil 探测成功但零贡献
# （bsdutils/dtach/mtm 三例：forkpty/openpty/login_tty 已并入 libc）
# 触发事件: mtm/1.2.1 HarmonyOS PC 适配（Makefile 第 9 行 LIBS ?= -lncursesw -lutil）
#====================================================================

id:                     E563
trigger_tool:           make|clang|ld
phase:                  linking
error_signature:        (unable to find library -lutil)|(ld\.lld.*cannot open.*libutil\.a)|(-lutil.*no such file)|(^ar t .*libutil\.a$)

severity:               2
category:               linking, ohos, libc, musl, portability
match_keywords:         lutil, libutil, forkpty, openpty, login_tty, pty\.h, util\.h, empty archive, zero members, musl, OHOS sysroot
title:                  OHOS musl 的 libutil.a 是零成员空档案：链接探测“成功”但零符号贡献，BSD pty 函数已并入 libc

root_cause:             OHOS musl 把 BSD pty 接口（forkpty/openpty/login_tty 等）
                        并入 libc 直接导出，sysroot 只为兼容构建脚本保留一个
                        空壳 libutil.a（!<arch> 头、0 成员）。上游 Makefile/
                        configure 用 -lutil 链接时：ld 在库搜索路径上找到
                        空档案即认为满足 -l，不报错（区别于 musl 上游完全
                        不提供 libutil 时的 hard error）；但 -Wl,-t 追踪显示
                        归档从未提供任何成员，undefined forkpty 实际由 libc.so
                        解析（nm -D --defined-only libc.so 可见导出）。若链接行
                        因 HMDFS/E050 类问题丢失真实库文件，才会落到
                        "unable to find library -lutil"。
affected_scope:         上游 Makefile/configure 写死 -lutil 的终端/pty 软件
                        （mtm、bsdutils、dtach 等）；任何对 libutil 有符号
                        依赖、按 -l 探测"成功即用"的构建系统。仅 OHOS musl
                        sysroot 受影响（musl 上游本身不带 libutil.a）。
verification_cmd:       ar t /storage/.../usr/lib/aarch64-linux-ohos/libutil.a | wc -l  # → 0
                        nm -D --defined-only .../libc.so | grep -E "forkpty|openpty"     # → 命中
                        clang --sysroot=$SR probe.c -lutil -o p -Wl,-t 2>&1 | grep -c libutil  # → 0
rec_priority:           1
rec_approach:           drop-unused-ldflags
rec_description:       配方不执行上游的 -lutil：直接按上游源码同义改写链接
                        命令（mtm 案例：复制 Makefile 的 mtm 规则去掉
                        -lutil 与 strip），或 patch 上游 Makefile 的 LIBS 行
                        去掉 -lutil；因为目标函数已在 libc 中，去掉后链接
                        依然解析成功。保留 -lutil 也无害（空档案无成员、
                        无符号贡献），但按"上游语义等价 + 可审计性"原则应
                        去除，避免维护者误以为存在 libutil 依赖。
rec_command:            sed -n '9p' Makefile  # LIBS ?= -l$(CURSESLIB) -lutil
                        # conanfile: build() 内联同规则链接（见 mtm 1.2.1 conanfile.py build()）
rec_auto_fix:           false
rec_impl:
rec_description_detailed:
verification_evidence:  mtm/1.2.1：去掉 -lutil 后 conan create（OHOS armv8 profile）
                        通过；forkpty 测试程序带/不带 -lutil 双路径链接成功，
                        -Wl,-t 追踪 0 次 libutil 引用；空档案 ar t 计数 0。
                        bsdutils/4.4.1.1 已有先例（conanfile 第 60 行注释
                        "-lutil 保留（musl 兼容空库）"）；dtach/0.9 patch 0002
                        调整 openpty 探测保留 -lutil。本条目统一三例的证据。

doc_file:               knowledge/drafts/E563-draft-CBD3.md
last_updated:           2026-09-08
source_event:           mtm/1.2.1 HarmonyOS PC 适配（上游 Makefile LIBS ?= -lncursesw -lutil）
source_commit:          ab78c0f7
draft:                  true
contributor_id:         CBD3
patches_referenced:     archives/m/mtm/1.2.1/conanfile.py
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.85
