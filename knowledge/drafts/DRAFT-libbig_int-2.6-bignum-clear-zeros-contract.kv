#====================================================================
# DRAFT-libbig_int-2.6-bignum-clear-zeros-contract
#   bignum 算术结果长度不规范化 → to_int 溢出误判
#   —— 消费者导出前须调用 clear_zeros 规范化（API 契约知识）
# 来源: PR feat(libbig_int-2.6) libbig_int 2.6 适配 HarmonyOS PC
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-libbig_int-2.6-bignum-clear-zeros-contract
trigger_tool:           cc|clang|conan
phase:                  testing|runtime
error_signature:        big_int_to_int.*return\s+1|
                        big_int_add.*to_int.*overflow|
                        result.*overflow.*big_int|
                        clear_zeros.*before.*to_int|
                        big_int_mul.*len.*not normalized

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               api-contract, bignum, consumer-test, libbig_int
match_keywords:         big_int, bignum, clear_zeros, to_int, overflow,
                        length normalization, 长度规范化, 溢出误判,
                        add, mul, div, 消费者契约, consumer contract
title:                  bignum 库算术结果长度不自动规范化：导出为 int 前必须先调用 clear_zeros 规范化长度，否则溢出误判

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             libbig_int 的 addsub/mul 保持 answer 的 len 为创建值
                        （如 big_int_create(8) 后 len=8），不清零高位 word。
                        big_int_to_int 按 a->len * BIG_INT_WORD_BYTES_CNT 与
                        sizeof(int) 比较判溢出 —— 未规范化长度的小数被误判为
                        整数溢出并返回 rc=1，而数值本身完全正确。
affected_scope:         直接消费 libbig_int 并把 big_int 值导出为 int 的
                        消费者 / test_package 用例；同类"结果长度不自动规范化"
                        的 bignum 库消费者亦适用。
verification_cmd:       消费者用例对 add/mul/div 结果先调用 big_int_clear_zeros(r)
                        再 big_int_to_int：12345+6789=19134、
                        12345*6789=83810205、整除 83810205/12345=6789、
                        gcd(1071,462)=21 全部断言通过（10/10，exit 0）。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           bignum-clear-zeros-before-export
rec_description:        消费者把 bignum 算术结果导出为 int（或任何按 len 判溢出的
                        导出 API）之前，先调用公开的 clear_zeros / normalize
                        API 规范化结果长度。test_package 消费者用例应覆盖这一
                        契约，避免把库的"正确结果"误判为失败。
rec_command:            big_int_add(a, b, r); big_int_clear_zeros(r); big_int_to_int(r, &v);
rec_auto_fix:           false
rec_impl:               consumer-code

# 回退方案
fallback_priority:      2
fallback_approach:      检查上游是否提供导出专用 API（如 to_str 按实际数值长度）
fallback_description:   部分 bignum 库的 to_str/串导出按数值实际位数处理，不依赖
                        len 字段；此类导出无需 clear_zeros，可用串往返替代 to_int 验证。
fallback_command:       big_int_to_str(r, 10, s) -> big_int_from_str(s, 10, b) -> to_int(b)
fallback_auto_fix:      false
fallback_impl:          consumer-code

# ═══ Layer 4: 原则引用 ═══
principles:             P014

# ═══ Layer 5: 关系 ═══
causes:                 []
caused_by:              []
similar_to:             [E398]
conflicts_with:         []
reuse:                  false
evidence_files:         ["archives/l/libbig_int/2.6/test_package/test.c",
                         "archives/l/libbig_int/2.6/reports/knowledge-candidate-ledger.md"]