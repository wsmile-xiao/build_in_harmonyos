#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E2166.kv，填写各字段
# 对应的人类文档: doc/E2166.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E2166
trigger_tool:           make|automake|test
phase:                  testing
error_signature:        FAIL:.*\.pl|FAIL:.*\.yaml|binaryload_event_call

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               build-system, autotools, testing, portability
match_keywords:         LOG_COMPILE, LOG_COMPILER, YAML_LOG_COMPILER, Automake test extension, Perl script, Libtool wrapper
title:                  混合语言 Automake 测试须分别绑定实际展开的测试驱动入口

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             Automake 发布包的生成规则可把 C 测试的 LOG_COMPILE 直接定义为其他变量，并给 YAML 等扩展名注册独立的 YAML_LOG_COMPILER；直接设置 LOG_COMPILER 只覆盖默认路径。Perl 测试内部再 exec 相对 Libtool wrapper，完全绕过 Automake 的外层 launcher。因此单一测试启动覆盖无法保证全量 make check 真正执行。
affected_scope:         在 OpenHarmony PC 等需要通过 shell 解释部分 Libtool wrapper 的环境中，使用 Automake parallel-tests 且包含 C 可执行、脚本和自定义扩展名测试的项目；亦适用于其他平台上排查测试驱动变量被生成规则覆盖的情况。
verification_cmd:       grep -n -e '^LOG_COMPILE' -e '^YAML_LOG_COMPILER' tests/Makefile; inspect each test driver command and per-test .trs/.log records

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           bind-effective-test-drivers
rec_description:        从生成的 Makefile 而非变量惯例确认每类测试的真实入口；分别覆盖 LOG_COMPILE 与扩展名专用 *_LOG_COMPILER。条件 launcher 只对有 .libs 同名 ELF 的 Libtool wrapper 使用 shell，真实 ELF 原样执行；脚本内部直接调用的 wrapper 须以最小源码补丁显式交给 shell。保持原 TESTS 集、断言、退出码和日志分母。
rec_command:            make check LOG_COMPILE='<shell> <conditional-launcher>' YAML_LOG_COMPILER='<shell> <yaml-launcher>'
rec_auto_fix:           false
rec_impl:               recipe-and-test-source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      relocate-test-tree
fallback_description:   若目标文件系统允许原始 wrapper 直接执行，可迁移到该文件系统并保留上游原始启动路径，但须重新验证完整测试集及消费者。
fallback_command:      make check
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       LOG_COMPILER=.*sh.*all|skip.*\.yaml|skip.*\.pl
forbid_1_reason:        LOG_COMPILER 可能根本未被生成规则读取；对所有测试统一套 shell 会把直接 ELF 当脚本；跳过某类用例会缩小分母。
forbid_1_consequence:   表面成功或局部通过不能证明上游 N/N，全量覆盖与失败归因失真。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P010,P013

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             E228,E259
conflicts_with:         []
prerequisite_of:        []

