#====================================================================
# DRAFT-cppcmd-0.1.0-catch2-full-ctest-module-injection
# 上游 CMake 用 include(Catch)/catch_discover_tests 时，Conan 版 catch2
# 包缺 contrib 模块 → 注入完整上游 Catch.cmake + CatchAddTests.cmake，
# 保留下游逐用例 CTest 注册（区别于 DRAFT-ctpg 的最小 shim）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-cppcmd-0.1.0-catch2-full-ctest-module-injection
source_lib:             cppcmd 0.1.0
trigger_tool:           conan|cmake|catch2|ctest
phase:                  configuration|testing
error_signature:        include could not find requested file: Catch|Unknown CMake command "catch_discover_tests"|CatchAddTests\.cmake.*Not a file|catch_discover_tests.*Unknown CMake command

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan|packaging|header-only|catch2|cmake|ctest|testing
match_keywords:         include(Catch), catch_discover_tests, Catch.cmake, CatchAddTests.cmake, Catch2::Catch2, find_package(Catch2), ctest, CTest 集成, header-only, ohpcd, contrib 模块, CMAKE_MODULE_PATH, TEMPLATE_LIST_TEST_CASE, 双口径台账, source_declared_total
title:                  上游 CMake 用 include(Catch)/catch_discover_tests 时，注入完整上游 Catch.cmake+CatchAddTests.cmake 保留下游逐用例 CTest 注册（支撑双口径台账逐项映射）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  Catch2 2.x 把逐用例 CTest 注册宏 catch_discover_tests 放在框架安装目录的
  contrib 模块 Catch.cmake + 运行期辅助脚本 CatchAddTests.cmake 中；ohpcd
  制品仓 catch2/2.13.10 header-only 包只复制 single_include/catch2 头文件，
  不含 contrib 模块。CMakeDeps 提供 Catch2Config.cmake / Catch2::Catch2 target
  （find_package 命中），但 include(Catch) 找不到模块、catch_discover_tests
  未知 —— "测试框架包已发布"与"CTest 集成模块缺失"同时成立，
  属打包完整性问题，不是当前库源码缺陷。

affected_scope: >
  所有上游 tests/CMakeLists.txt 用 find_package(Catch2 REQUIRED) +
  include(Catch) + catch_discover_tests 的 Catch2 2.x 库，在 Conan 版
  catch2 包（2.13.10 / 2.13.10-r0）下适配 OHOS/arm64；需要 ctest -N
  逐用例粒度支撑双口径台账（source_declared -> ctest 注册项）映射的任务。

verification_cmd: >
  cd <build-native> && ctest -N 2>&1 | grep -c 'Test #';
  ctest --output-on-failure; 日志 SHA-256 3550645a4bdc142ba72559cf489c15457be7ace877d04a7147c786caedb48951

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           full-upstream-catch-ctest-module-injection
rec_description: >
  取 Catch2 v2.13.10 官方 contrib/Catch.cmake（206 行）与 contrib/CatchAddTests.cmake
  （135 行）放到构建目录，CMake 配置时把该目录加入 CMAKE_MODULE_PATH；
  两个文件必须配套（缺 CatchAddTests.cmake 时报 "Not a file: .../CatchAddTests.cmake"）。
  catch_discover_tests 按上游语义将 TEST_CASE 与 TEMPLATE_LIST_TEST_CASE 的各
  类型实例逐项注册进 CTest，ctest -N 可见 6 个独立用例，与源码声明一一对应，
  支撑双口径台账逐项映射。模块文件为本地构建支持物，不入配方/不入 PR；
  如需在 conan create 内保留上游测试逐用例注册，可参考 DRAFT-ctpg 在
  generate() 注入的路径把完整模块一并注入（待后续库验证扩展）。
rec_command: >
  curl -sS --resolve raw.githubusercontent.com:443:185.199.108.133 \
  -o build-native/Catch.cmake \
  https://raw.githubusercontent.com/catchorg/Catch2/v2.13.10/contrib/Catch.cmake;
  curl -sS --resolve raw.githubusercontent.com:443:185.199.108.133 \
  -o build-native/CatchAddTests.cmake \
  https://raw.githubusercontent.com/catchorg/Catch2/v2.13.10/contrib/CatchAddTests.cmake;
  cmake -S . -B build-native -DCMAKE_MODULE_PATH=$(pwd)/build-native ...
rec_auto_fix:           false
rec_impl:               build-env-module-injection

# ═══ Layer 4: 关联 (Relations) ═══
similar_to:             DRAFT-ctpg-1.3.7-catch2-ctest-module-injection;DRAFT-cdt-1.4.5-catch2-21310-amalgamated-test-adaptation
caused_by:              ohpcd-catch2-header-only-package-lacks-contrib-modules
prerequisite_of:        upstream-tests-dual-caliber-ledger
conflicts_with:         none
# canonical_duplicate / new_draft 判定
dedup_verdict:          new_draft
dedup_detail:           trigger 与 DRAFT-ctpg 相同，但 DRAFT-ctpg 注入最小 shim
                        （单 add_test，ctest 只见二进制一个用例）；本轮注入完整上游
                        模块，catch_discover_tests 逐用例注册（ctest -N 见 6 例），
                        对双口径台账逐项映射为实质新增差异，已验证且可跨库复用。
last_updated:           2026-09-22