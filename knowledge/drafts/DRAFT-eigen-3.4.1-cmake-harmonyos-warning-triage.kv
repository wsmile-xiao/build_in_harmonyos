#====================================================================
# Draft knowledge entry - eigen CMake HarmonyOS warning triage
# Source package: eigen/3.4.1
#====================================================================

id:                     DRAFT-eigen-3.4.1-cmake-harmonyos-warning-triage
trigger_tool:           cmake|conan|shadow-ci
phase:                  configuration|consumer-test
error_signature:        System is unknown to cmake|Platform/HarmonyOS|CMAKE_SYSTEM_NAME=HarmonyOS

severity:               2
category:               cmake|platform-detection|header-only|triage
match_keywords:         eigen, CMake, HarmonyOS, Platform/HarmonyOS, CMAKE_SYSTEM_NAME, header-only, Eigen3::Eigen, non-blocking warning
title:                  CMake HarmonyOS platform warnings are non-blocking for eigen header-only consumers when target tests pass

root_cause:             CMake 4.x has no built-in Platform/HarmonyOS module, so the OHOS Conan
                        toolchain's CMAKE_SYSTEM_NAME=HarmonyOS can emit an unknown-system warning.
                        For eigen, no shared library or platform source routing depends on that module.
affected_scope:         Header-only CMake packages whose consumer tests exercise generated package
                        metadata but do not link package-built shared libraries or rely on UNIX macros.
verification_cmd:       CI_PACKAGES="archives/e/eigen/3.4.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           warning-triage-before-platform-patch
rec_description:        For header-only packages, record the CMake HarmonyOS warning as non-blocking
                        only after configure, build, target runtime, and destructive negative tests pass.
                        Escalate to the CMake platform knowledge when shared libraries, SONAME, or
                        platform branches are involved.
rec_command:            grep -R -n "CMAKE_SYSTEM_NAME\\|UNIX\\|OS_LINUX" CMakeLists.txt cmake 2>/dev/null || true
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      platform-module-or-branch-fix
fallback_description:   If the warning changes compile/link behavior, add a narrow HarmonyOS/OHOS
                        branch or provide a project-local Platform/HarmonyOS.cmake according to the
                        existing CMake platform knowledge.
fallback_command:       grep -R -n "SOVERSION\\|VERSION\\|add_library" CMakeLists.txt cmake 2>/dev/null || true
fallback_auto_fix:      false
fallback_impl:          cmake-patch

forbid_1_pattern:       CMAKE_SYSTEM_NAME=Linux.*silence|set\(CMAKE_SYSTEM_NAME Linux\)
forbid_1_reason:        Forcing Linux can hide the target identity and make downstream package metadata diverge from CI.
forbid_1_consequence:   A warning is silenced while platform-specific behavior remains unverified.

similar_to:             [E140,E267,E322]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-eigen-3.4.1-cmake-harmonyos-warning-triage.md
last_updated:           2026-08-28
source_event:           eigen/3.4.1 shadow CI r2 passed with header-only consumer validation

authors:                codex <codex@noreply.local>
