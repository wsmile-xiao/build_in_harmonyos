#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: runtime|test|numdiff
phase: runtime|testing
error_signature: Segmentation fault.*numdiff|numdiff.*-D.*SIGSEGV|ssplit.*uninitialized.*vector|is_char_in_vector.*SIGSEGV|core dumped.*numdiff

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: runtime, musl, portability, libc
match_keywords: ssplit, calloc, malloc, uninitialized, SIGSEGV, segmentation fault, core dumped, delimiter, -D, musl, numdiff, vector
title: numdiff/ssplit(): 分隔符串以分隔符结尾时指针向量槽位未初始化，musl 上向量扫描 SIGSEGV（malloc → calloc）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: ssplit(str, sep) 统计子串数 n 时，若 str 以 sep 结尾会把 n 多计 1；分配 n+1 个指针后仅填充 [0,i-1]，[i,n-1] 未初始化。glibc malloc 常返回清零内存掩盖该 UB，musl malloc 返回非零内存 → is_char_in_vector/remove_duplicates_from_string_vector 对垃圾指针 strchr/strcmp → 崩溃
affected_scope: 任何在 musl（OHOS/HarmonyOS PC 等）上调用此类"计数多于实际填充"的指针向量构造的 C 程序；本例为 numdiff 5.9.0 linesplit.c 的 ssplit()，触发点是把以空格结尾的字符串传给 numdiff -D（如 -D 'x ' 或 -D '1:   ##  ###  $  \s  \n '），影响 numdiff 官方测试套件 test32 的 k1vs4/k1vs4.5/kX4_1vs2 三个用例
verification_cmd: printf '1  2\n3  4\n' > a; printf '1  2\n3  4\n' > b; numdiff -D 'a ' a b; echo "exit=$?"（修复前 exit=139 SIGSEGV，修复后正常比较）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach:          fix-uninitialized-pointer-vector-malloc-to-calloc
rec_description:        将 ssplit() 中 `malloc((n+1)*sizeof(char*))` 改为 `calloc(n+1, sizeof(char*))`，使所有槽位初始为 NULL，向量在正确位置终止；或等价地在填充循环后补 `sv[i] = NULL;`
rec_command:            sed -i 's/malloc ((n+1)\\*sizeof(char\\*))/calloc ((n+1), sizeof(char*))/' linesplit.c
rec_auto_fix:           false
rec_impl:               source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 在测试或构建脚本中删除/跳过失败用例以掩盖崩溃|mark.*test.*skip|rm .*test3[0-9]
forbid_1_reason: 症状是内存未初始化 UB；跳过测试只掩盖问题，numdiff 对真实合法的 -D 参数（以分隔符结尾）仍会崩溃
forbid_1_consequence: 交付二进制在 musl 上对合法输入 SIGSEGV，功能缺陷被隐藏（R34/欺骗检测档）
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

