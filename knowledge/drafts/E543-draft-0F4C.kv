#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: configure|make|clang|ld
phase: linking
error_signature: libtool: Version mismatch error\. +This is libtool|func_opt_split: inaccessible or not found|func_mode_link: inaccessible or not found|package_revision=1\.3017

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: build-system, autotools, libtool, linking
match_keywords: libtool, ltmain.sh, package_revision, macro_revision, Version mismatch error, func_opt_split, func_mode_link, aclocal.m4, autoreconf, generated libtool truncated, silent no .so
title: 上游 tarball 的 ltmain.sh 与 aclocal.m4 版本错配导致生成的 libtool 被截断、--mode=link 静默不产出 .so

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游发布包混入了与其 m4 宏不匹配的 ltmain.sh（本例 Debian ltmain 2.2.6b package_revision=1.3017 vs aclocal.m4 macro_version=2.4 macro_revision=1.3293），且该 ltmain.sh 缺失它自己调用的 9 个内建函数定义（func_dirname/func_basename/func_stripname/func_opt_split/func_append/func_arith/func_len/func_lo2o/func_xform）；configure 生成 libtool 时用 sed 区间替换注入这些函数，区间终点注释不存在导致后续内容被整段吞掉，生成的 libtool 只剩 header（本例 588 行、缺 func_mode_link），链接不报错但静默不产出 .so
affected_scope: 自带 ltmain.sh 的 autotools 上游 tarball（尤其 distro 打包/重打包的发布包）；本地与交叉编译同样受影响
verification_cmd: grep -m1 "^package_revision=" ltmain.sh; grep -m1 "macro_revision=" aclocal.m4; wc -l libtool

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: replace-ltmain-with-matching-official
rec_description: 用与 aclocal.m4 版本精确匹配的官方 GNU libtool 的 ltmain.sh 覆盖上游残缺文件（本例 libtool 2.4 official release），再重新 configure
rec_command: curl -fsSL https://ftp.gnu.org/gnu/libtool/libtool-2.4.tar.gz | tar xz -C "$BUILD_DIR" && cp "$BUILD_DIR/libtool-2.4/libltdl/config/ltmain.sh" "$SRC_DIR/ltmain.sh" && (cd "$SRC_DIR" && ./configure --prefix="$PREFIX")
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: regenerate-with-toolchain
fallback_description: 取不到匹配 ltmain.sh 时：用 CONFIG_SHELL 指向无扩展语法替换的 POSIX shell 跑 configure 以避开 xsi_shell=yes 分支（本例未验证）；或 tool_requires libtool/autoconf/automake 后 autoreconf -fi 重生成整套构建系统
fallback_command: CONFIG_SHELL=/bin/ash ./configure --prefix="$PREFIX"
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: macro_revision=.?1\.3017|macro_version=.?2\.2\.6b
forbid_1_reason: 把 m4 宏版本改成迁就残缺 ltmain.sh（或短路 func_check_version_match）只是掩盖错配，缺失的内建函数无法补齐
forbid_1_consequence: 构建仍失败或产出不可预期，配方不可复现且污染后续维护
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
prescan_pattern: ^package_revision=|macro_revision=
prescan_globs: *.sh, aclocal.m4, configure.ac, m4/*.m4
doc_file: doc/E543.md
last_updated: 2026-09-25
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

draft: true
contributor_id: 0F4C
