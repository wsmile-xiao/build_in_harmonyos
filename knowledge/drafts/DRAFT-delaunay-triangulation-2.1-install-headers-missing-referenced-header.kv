#====================================================================
# DRAFT-delaunay-triangulation-2.1-install-headers-missing-referenced-header
#   构建系统安装头列表遗漏被引用头（install_headers 漏装 numeric.h），
#   消费者用已安装公开头编译报 '<X>.h' file not found
# 来源: delaunay-triangulation 2.1 第一轮适配（任务 delaunay-triangulation-2.1-r01-pc1-17）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: DRAFT-delaunay-triangulation-2.1-install-headers-missing-referenced-header
trigger_tool: meson|install|clang|cmake
phase: packaging|compilation
error_signature: fatal error: '(numeric|.+)\\.h' file not found|
                install_headers\\(|
                include/dt/|headers? not installed|referenced header

# ═══ Layer 1: 识别层 ═══
severity:                 2
category:                 build-system, packaging, headers
match_keywords:           install_headers, numeric.h, meson, header, includedirs, dt, fatal error, file not found, consumer, public header, self-reference, install list
title:                    Meson install_headers() 漏装被公开头自引用的头文件 → 消费者编译 file not found

root_cause:               构建系统 install_headers()/安装清单遗漏被已安装头自引用的头文件（源码头
                          自身可编译——头在源码树中存在，编译目标正常；但安装清单不完整），
                          package 后的 include/ 下 A 头 include 的 B 头缺失，任何只消费
                          已安装公开头的下游（test_package、业务上层组件）在编译期报
                          `fatal error: '<B>.h' file not found`。本案例：上游 meson.build
                          `install_headers('include/vector2.h', 'include/edge.h',
                          'include/triangle.h', 'include/delaunay.h', subdir: 'dt')`
                          漏掉 `numeric.h`，而 vector2.h/triangle.h 均 `#include "numeric.h"`。
affected_scope:           所有 Meson/CMake/autotools 安装头文件列表遗漏被引用头的库；检测面：
                          package 后对每个已安装头做「自包含编译」即可暴露。
verification_cmd:         ls <pkg>/include/dt/ && git diff HEAD -- <pkg>/conanfile.py  # 核对安装列表；
                          clang++ -std=c++17 -I<pkg>/include -c consumer.cpp 2>&1

# ═══ Layer 2: 诊断层 ═══
rec_priority:             1
rec_approach:             install-headers-complete-list
rec_description:          在构建系统安装清单（meson install_headers / CMake install(FILES) / make install
                          头规则）里补全所有被公开头自引用的头文件；并在 test_package 或报告里做
                          「自包含编译」回归（仅用已安装头 include 被测库入口头编译一个空 TU）。
rec_command:              sed 或编辑器在 meson.build install_headers 列表补 'include/numeric.h'；
                          复跑 conan create 并确认安装日志出现 numeric.h；test_package 头改为
                          #include "dt/delaunay.h" 后 ctest PASS
rec_auto_fix:             false
rec_impl:                 manual

fallback_priority:        2
fallback_approach:        package-headers-copy
fallback_description:     若不便改上游安装清单（如 autotools 复杂分发），可在 conanfile.py
                          package() 中把缺失头一并 copy 进 pack 的 include/dt/。
fallback_command:
fallback_auto_fix:        false
fallback_impl:            manual

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             E309
conflicts_with:         []
prerequisite_of:        []

