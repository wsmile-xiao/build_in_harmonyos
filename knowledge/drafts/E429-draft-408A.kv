#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: strip|llvm-strip|ld.so|musl|binary-sign-tool|llvm-objcopy
phase: packaging|runtime|testing
error_signature: interposition silently inactive|LD_PRELOAD.*(ignored|no effect)|SO_KEEPALIVE is OFF|hooked function never called|preload.*not applied

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: ohos, elf, packaging, runtime
match_keywords: strip, strip -s, --strip-debug, .codesign, codesign, LD_PRELOAD, LD_PRELOAD interposition, silent failure, no error, OHOS loader, signature invalidated, stale signature, libkeepalive, keepalive, socket hook, re-sign
title: OHOS: strip 使 .codesign 失效后加载器静默忽略 LD_PRELOAD 拦截（无任何报错）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS 链接器为 ELF 注入 .codesign 代码签名块；strip 的任意变体（-s/--strip-debug/--strip-unneeded/-S）只重排节区布局、不改 .text/.dynsym 内容，却使覆盖整文件的签名失配。加载器对签名失配的 preload 库既不报错也不加载，于是 LD_PRELOAD 拦截静默失效，表现为 socket() 未被 hook / SO_KEEPALIVE 仍为 OFF，极易误判为 OHOS 不支持 LD_PRELOAD 或配方/源码错误。
affected_scope: 所有产出 LD_PRELOAD/拦截型 .so 且构建流程含 strip 的配方（上游 Makefile 常自带 strip -s），以及任何 strip 后再分发 .so 的打包步骤（含 package_builder.py 的 --strip-debug 步骤）
verification_cmd: LD_PRELOAD=<lib.so> ./probe 应被拦截 -> strip 后同一命令静默不拦截；readelf -SW <lib.so> 两版 .codesign 均存在且内容哈希一致；llvm-objcopy --remove-section .codesign 加 binary-sign-tool sign -selfSign 1 后拦截恢复

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: skip-strip-or-resign-after-strip
rec_description: 首选：配方不执行上游的 strip 步骤（本库改用 make -C src/ 避开根 Makefile 的 strip -s）。若下游或打包环节必须 strip，则 strip 后必须重签：llvm-objcopy --remove-section .codesign 后 binary-sign-tool sign -inFile X -outFile X.signed -selfSign 1 并替换原文件（参考 E077 四步）。
rec_command: make -C src CC=<cc> -j1  # 跳过顶层 Makefile 的 cp+strip -s；如需 strip：llvm-objcopy --remove-section .codesign X.so && binary-sign-tool sign -inFile X.so -outFile X.signed.so -selfSign 1 && mv X.signed.so X.so
rec_auto_fix: false
rec_impl: recipe-skip-strip

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
