#====================================================================
# DRAFT-libfastcommon-1.0.88-makesh-uname-probe-ohos — make.sh 系
#   uname 平台探测在 HarmonyOS 落空：OS_UNKOWN/IOEVENT_USE_NONE 退化，
#   需在 Conan 配方内显式生成 _os_define.h 并复刻 Makefile 渲染
# 对应人类文档: knowledge/drafts/DRAFT-libfastcommon-1.0.88-makesh-uname-probe-ohos.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: libfastcommon 1.0.88 适配 HarmonyOS PC（make.sh raw Makefile 构建）
#====================================================================

id:                     DRAFT-libfastcommon-1.0.88-makesh-uname-probe-ohos
trigger_tool:           make|sh|cc|clang
phase:                  source|compilation
error_signature:        uname -s.*HarmonyOS.*OS_UNKOWN|
                         IOEVENT_USE_NONE.*undefined|
                         OS_UNKOWN.*not defined|
                         make\.sh.*gcc not found|
                         gcc not found.*please install gcc

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               ohos, make, platform-detection, raw-makefile, portability
match_keywords:         make.sh, uname -s, HarmonyOS, OS_UNKOWN, IOEVENT_USE_NONE,
                         OS_LINUX, IOEVENT_USE_EPOLL, _os_define.h, Makefile.in,
                         sed_replace, CC=gcc, gcc not found, FastDFS, libfastcommon,
                         raw makefile, platform probe, 平台探测
title:                  make.sh 系 uname 平台探测在 HarmonyOS 落空——配方内显式
                         生成 _os_define.h（OS_LINUX+IOEVENT_USE_EPOLL）并复刻
                         Makefile 渲染

# ═══ Layer 2: 诊断层 ═══
root_cause:             FastDFS 家族的 make.sh 用 `uname -s` 做平台分支枚举
                         （Linux/FreeBSD/Darwin/SunOS/AIX/HP-UX），HarmonyOS
                         不在枚举内，落入 else → OS_NAME=OS_UNKOWN 且
                         IOEVENT_USE=IOEVENT_USE_NONE（网络事件后端退化、无
                         epoll/io_uring/kqueue）。且 make.sh 硬编码 `gcc`
                         （export CC=gcc + sed 替换），OHOS PC 工具链只有
                         clang，直接运行即 "gcc not found" 退出。
affected_scope:         所有用 make.sh/自研 shell 脚本驱动 raw Makefile、以
                         uname 探测生成平台头（_os_define.h 类）的 FastDFS
                         家族项目（libfastcommon/libserverframe/fastdfs 等）
                         及其同类 C 库
verification_cmd:       conan create archives/l/libfastcommon/1.0.88
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=... 
                         # 期望: G2 通过; src/_os_define.h 含 OS_LINUX+IOEVENT_USE_EPOLL

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           replicate-makesh-render-in-recipe
rec_description:        不直接运行 make.sh：在 conanfile.py build() 中①显式生成
                         src/_os_define.h（OS_LINUX+IOEVENT_USE_EPOLL、64 位、
                         dirent 字段按 OHOS sysroot 实际存在性 d_type/d_reclen/
                         d_off 有、d_namlen 无）；②复刻 make.sh 的 sed 替换，
                         用 tools.build:compiler_executables 字典的 C 编译器替换
                         $(CC)，CFLAGS/INCS/LIBS/TARGET_PREFIX/LIB_VERSION 全部
                         由配方确定；③在 cwd=<source>/src 下 make all+install
                         到 staging。
rec_command:            save(src/_os_define.h, _OS_DEFINE_H)
                         makefile = render(Makefile.in, CC=..., CFLAGS=...)
                         self.run("make -j1 all", cwd=os.path.join(src_dir,"src"))
rec_auto_fix:           false
rec_impl:               conanfile-edit

fallback_priority:      2
fallback_approach:      env-compiler-override
fallback_description:   若上游 make.sh 支持环境变量覆盖 CC（如 ${CC:-gcc}），
                         优先用该开关，不必复刻渲染；否则走推荐方案。
fallback_command:       make.sh CC=${CC} (在 conanbuild 环境内)
fallback_auto_fix:      false
fallback_impl:          conanfile-edit

forbid_1_pattern:       run make\.sh
forbid_1_reason:        make.sh 硬编码 gcc 且 uname 探测在 HarmonyOS 落空，直接
                         运行必然失败或生成退化的 OS_UNKOWN/IOEVENT_USE_NONE。
forbid_1_consequence:   构建失败或 ioevent 功能静默退化。

# ═══ Layer 4: 原则引用 ═══
principles:             R33

# ═══ 关系图 (Relations) ═══
similar_to:             E140, E267, E160, E392
prerequisite_of:        []

