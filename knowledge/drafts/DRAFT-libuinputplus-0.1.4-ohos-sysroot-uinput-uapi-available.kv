#====================================================================
# ohos-sysroot-uinput-uapi-available.kv
# OHOS SDK sysroot 已内置 linux/uinput.h 全套 UAPI: uinput/evdev 类库零补丁可编译
# 触发实例: libuinputplus 0.1.4 (辅证: libevdev 1.13.7)
#====================================================================

trigger_tool:            uinput|evdev|virtual input|ydotool|wtype|dotool|evtest|input
phase:                   analysis
error_signature:         fatal error: 'linux/uinput\.h' file not found|
                          fatal error: 'linux/input\.h' file not found|
                          fatal error: 'linux/input-event-codes\.h' file not found
severity:                3
category:                platform, headers, ohos, input
match_keywords:          uinput, evdev, linux/uinput.h, linux/input.h,
                          UAPI, sysroot, 内核头, input-event-codes,
                          虚拟输入设备, ioctl, musl, OHOS SDK,
                          零补丁, 平台能力

root_cause:              预期层知识(非缺陷): 迁移 uinput/evdev 类库时通常
                          假设鸿蒙 musl sysroot 缺 Linux 内核 UAPI 头而提前
                          引入内核头包或补丁。实测 OHOS SDK(sysroot API 26,
                          26.0.0.105)已内置 usr/include/linux/{uinput.h,
                          input.h, input-event-codes.h}, 且 uinput.h 含
                          uinput_setup/uinput_abs_setup/UI_DEV_SETUP/
                          UI_ABS_SETUP/UI_SET_{EV,KEY,REL,ABS,PROP}BIT/
                          UI_DEV_CREATE 全套定义(满足 Linux 4.4+ UAPI);
                          musl 覆盖 open/ioctl/close/write/read/usleep。
                          若真出现上述 file not found, 根因通常是 sysroot
                          版本过旧或 --sysroot/include 配置错误, 而非平台
                          缺头, 不要急着打包内核头。
affected_scope:          所有依赖 Linux 输入子系统 UAPI 的库/工具:
                          libuinputplus(已实证), libevdev(已实证),
                          ydotool/wtype/dotool/evtest/input-remapper 类
verification_cmd:        ls <sysroot>/usr/include/linux/{uinput,input,input-event-codes}.h
                          grep -c "UI_DEV_SETUP\|uinput_abs_setup" <sysroot>/usr/include/linux/uinput.h

rec_priority:            1
rec_approach:            use-sysroot-uapi-directly
rec_description:         直接 #include <linux/uinput.h>(或让上游原样编译),
                          不引入内核头依赖包、不打补丁、不降级; W0 依赖
                          结论可记为"仅 sysroot UAPI 头, 无第三方依赖"。
                          R40 提醒: 编译通过≠适配完成, /dev/uinput 节点的
                          存在性与权限属真机运行层验证, 与编译层解耦
rec_command:             clang++ --target=aarch64-linux-ohos --sysroot=<sysroot> \
                          -shared uInput*.cpp -o libuInputPlus.so
rec_auto_fix:            false
rec_impl:                manual

fallback_priority:      2
fallback_approach:       old-sysroot-bundle-uapi-headers
fallback_description:    仅当设备/CI 的 sysroot 确实过旧缺头时, 参考 libevdev
                          先例在配方内为缺失的 UAPI 头做软链/携带, 并在
                          notes 说明 sysroot 版本下限; 先实测再动手
fallback_auto_fix:       false

forbid_1_pattern:        未实测 sysroot 就预置"鸿蒙缺内核头"的假设性补丁
principles:

causes:                  与 E169(argp.h 类 glibc 专属头缺失)相反方向的
                          预期校准: UAPI 头在, glibc 专属头不在
