#====================================================================
# Draft: lang-preflight treats KDE/Qt apps as "java" because the
# release tarballs carry src/android/build.gradle (ECMAddAndroidApk
# helper, if(ANDROID)-gated). The filename-based manifest scan ranks
# gradle above CMake -> detected_language=mixed -> env_unsupported.
# Trust the root build definition + source census instead; never
# edit sources to please the detector.
#====================================================================

id:                     DRAFT-KDE-APP-ANDROID-GRADLE-LANG-MISJUDGE
trigger_tool:           lang-preflight
phase:                  pre-analysis
error_signature:        env_unsupported|detected_language=mixed|build.gradle manifest scan|java 工具链不在支持矩阵

severity:               2
category:               tooling|preflight|kde
match_keywords:         lang-preflight, env_unsupported, mixed, build.gradle, android, KDE, Release Service, Qt, ecm_add_android_apk, kirigami-gallery, 误判, R47, language detect

title:                  lang-preflight 按文件名把 KDE/Qt 应用误判为 java（src/android/build.gradle 是 Android APK 打包辅助文件而非构建系统）：复核根级 CMakeLists.txt 与源码统计后按真实语言继续，不改源码、终态以真实结果上报

root_cause:             lang_detect.py 的 _manifest_scan 按文件名递归匹配且 gradle 优先于 CMake。KDE Release Service 应用源码包携带 src/android/build.gradle（ECM 的 ecm_add_android_apk() 使用的 Qt for Android 打包辅助文件，if(ANDROID) 守卫，通用平台不使用），命中 java manifest 规则与根级 CMakeLists.txt 的 cpp 统计并存 → mixed → env_unsupported，实际项目为纯 C++17+QML。
affected_scope:         所有携带 src/android/build.gradle 的 KDE Release Service 应用（26.04 滚动发布的源码包普遍包含）；任何按文件名扫描语言/构建系统的预检遇到辅助性构建文件的场景；后果形态是被误导终止适配或删除源码迎合检测器（伪造证据，违反 R8/R10）。
verification_cmd:       head -5 <src>/CMakeLists.txt && find <src> -maxdepth 2 -name "build.gradle" && grep -rn "android" <src>/CMakeLists.txt | head && find <src> \( -name "*.cpp" -o -name "*.qml" \) | wc -l && find <src> -name "*.java" | wc -l   # 期望: cmake+project / android 辅助目录 / cpp+qml 为主体 / java=0
rec_priority:           2
rec_approach:           evidence-over-detector-snapshot
rec_description:        (1) 复核证据链：根级构建定义（CMakeLists.txt 等）+ 源码主体语言统计（辅助脚本/打包文件不算主体）+ 确认 build.gradle 所在目录是 if(ANDROID) 守卫的打包辅助目录；(2) 绝不修改源码迎合检测器（删 build.gradle 或改名都是伪造证据）；(3) notes.md 如实记录误判分析，按真实语言（C++）继续适配；(4) 终态 result 上报真实状态（必要时 --force 覆盖误判阶段写入的 env_unsupported 占位终态），终态与 conan-verify/本地 CI 证据一致；(5) 若条件允许，向 lang_detect.py 反馈：android/ 打包辅助目录应排除出 manifest 扫描，或 gradle 判定要求 build.gradle 位于根级。
rec_command:            conan create <archive_dir> -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing   # C++ 工具链全绿即证伪 java 判定
rec_auto_fix:           false

# ═══ 知识协作 (Authorship & Provenance) ═══
# PR 交付后回填（与仓内绝大多数草稿同阶段做法一致）
source_pr:
source_commit:
