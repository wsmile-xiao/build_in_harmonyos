#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: clang|cc|ld
phase: runtime
error_signature: Signal 11 (core dumped)|SIGSEGV.*xode|xode_from_str.*(crash|segv)|空指针.*atts|_xode_put_expatattribs

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: headers, runtime
match_keywords: xode, xode_from_str, _xode_put_expatattribs, expat, atts, XML_Parse, SIGSEGV, kamailio, xmpp, 空指针
title: 上游 xode XML 解析器对无属性元素的空指针解引用（expat atts[0]==NULL）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: expat 对无属性元素的 start 回调传入「非 NULL 数组且 atts[0]==NULL」（实测 expat 2.7.3 与 2.8.2 一致）；kamailio xode 的 _xode_put_expatattribs() 循环条件只判 atts==NULL、不判 atts[i]==NULL 即解引用 → 任何无属性元素（<body>/<status>）解析即 SIGSEGV。跨平台缺陷，与 OHOS 无关。
affected_scope: kamailio src/modules/xmpp 内嵌 xode 解析器；所有 expat>=2.x 平台；触发形态=任何无属性 XML 元素
verification_cmd: 探针1：dlopen libexpat -> XML_SetElementHandler + XML_Parse("<a/>") 打印 atts/atts[0]（实测 非NULL + 0）；探针2：对模块 xode_from_str("<a/>") 装 SIGSEGV handler 定位 pc 落在 _xode_put_expatattribs 的 ldrb [x8]（x8=0）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: define-guard
rec_description: 循环条件补判空：while(atts[i] != NULL && *(atts[i]) != '\0')。有属性元素行为不变；无属性元素不再崩溃。参考：archives/k/kamailio-xmpp/6.0.6/patches/0001-src-modules-xmpp-xode_from.c.patch
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: false
rec_impl: source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

