#====================================================================
# harmonyos-proc-diskstats-root-only-degrade.kv
# HarmonyOS PC: /proc/diskstats 仅 root 可读, 监控工具需代码级优雅降级
#====================================================================

id:                     E429
trigger_tool:           topline|iostat|dstat|nmon|sysstat|monitoring
phase:                  runtime
error_signature:        Can't open /proc/diskstats.*Permission denied|
                         fopen.*/proc/diskstats.*EACCES|
                         /proc/diskstats.*Permission denied

severity:               2
category:               runtime, filesystem
match_keywords:         /proc/diskstats, /sys/block, diskstats,
                         Permission denied, EACCES, monitoring,
                         iostat, degrade, graceful

root_cause:             HarmonyOS PC 虚拟化环境将磁盘统计以
                         /proc/diskstats -> /sys/block/diskstats 符号链接
                         暴露且仅 root 可读(普通用户 fopen 报 EACCES),
                         而 /proc/stat、/proc/meminfo 仍普通用户可读;
                         监控工具若对 diskstats 打不开即 die() 则整个
                         进程无法启动
affected_scope:         所有读取 /proc/diskstats 的监控类工具
                         (topline、sysstat/iostat、dstat、nmon、
                         htop disk 模式等)在 HarmonyOS PC 的适配
verification_cmd:       head -c 100 /proc/diskstats  # Permission denied
                         head -c 60 /proc/stat  # 正常可读

rec_priority:           1
rec_approach:           degrade-gracefully
rec_description:        代码级优雅降级: fopen(/proc/diskstats) 失败时
                         输出 stderr 告警并短路磁盘采样路径(保留 CPU/
                         内存等可用维度), 禁止 die() 退出; CI/conan 包
                         环境无 sudo, E031 的 sudo-run 方案在 CI 不可用
rec_command:            patch: init_disks() 失败改 fprintf(stderr,...)
                         + do_disks() 增加 if (!ds) return;
                         (实例: archives/t/topline/0.6/patches/0001-disk.c.patch)
rec_auto_fix:          false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      alt-source-or-unsupportable
fallback_description:   磁盘统计为核心功能的工具(如 iostat 本体)不可
                         降级: 尝试逐设备读 /sys/block/<dev>/stat
                         (同样受限则按无法适配上报), 不要静默删功能
fallback_auto_fix:     false

forbid_1_pattern:
principles:

causes:                 E031(近亲: htop 的 /proc 整体受限, 方案 sudo-run
                         在 CI 不可用), E303(受限进程文件系统探测)
