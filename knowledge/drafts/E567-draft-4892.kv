#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E567.kv，填写各字段
# 对应的人类文档: doc/E567.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E567
trigger_tool: cmake|conan|conan create
phase: configuration|compilation
error_signature: 'talloc.h' file not found|Target .* links to: .*::.* but the target was not found|INTERFACE_LINK_LIBRARIES.*libosmocore::osmogsm

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, cmake, dependency, static-linking
match_keywords: CMakeDeps, transitive_headers, transitive_libs, static-library, cpp_info.components, target was not found, file not found, 组件引用丢失, 依赖不传递, FIND_DEPENDENCY_NAMES
title: CMakeDeps 丢弃 static-library 依赖的组件引用：下游编译报依赖头文件 file not found（libosmocore 1.11.0）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan 2 对 package_type=static-library 的依赖默认 headers=False/libs=False，只要未声明 transitive_headers/transitive_libs，CMakeDeps 生成 *.cmake 时会把该依赖从 FIND_DEPENDENCY_NAMES 与 INTERFACE_LINK_LIBRARIES 中静默剔除；配方 cpp_info.components 里写的 talloc::talloc 引用随之丢失，下游（CI test_package）编译期 #include <talloc.h> 报 file not found，链接期报 undefined reference。实测 talloc/2.4.4 为 static-library 类型命中此行为，libusb/pcsc-lite 非 static-type 故保留。
affected_scope: 所有 requires 了 static-library 类型依赖、且该依赖头文件出现在自身公有头文件中的配方（libosmocore、以及任何暴露 talloc.h/libusb.h/libmnl 头的中层库）
verification_cmd: grep -n FIND_DEPENDENCY_NAMES <pkg>-config.cmake；conan install --requires=<pkg>/<ver> -g CMakeDeps 后确认依赖名与 <dep>::<dep> 出现在生成物

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: declare-transitive-headers-libs
rec_description: 在 requirements() 里对所有头文件/组件被公共头暴露或组件 requires 引用的依赖显式声明 transitive_headers=True, transitive_libs=True，使 CMakeDeps 保留组件引用与包含目录。
rec_command: self.requires("talloc/2.4.4", transitive_headers=True, transitive_libs=True)
rec_auto_fix: manual
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

