#====================================================================
# DRAFT-lurlparser-1.1-upstream-test-stale-api-port
#   上游 tag 内测试引用与同 tag 头文件不一致的已移除旧 API
#   （clParseURL/m_* -> ParseURL/scheme_*），原始测试无法编译：
#   以最小补丁移植测试到当前公开 API 后真实运行
# 来源: PR feat(lurlparser): 1.1 适配 HarmonyOS PC
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-lurlparser-1.1-upstream-test-stale-api-port
trigger_tool:           cmake|ctest|gtest|cc|clang
phase:                  testing|compilation
error_signature:        (clParseURL|m_Scheme|m_Host|m_Port|m_Path|m_Query|m_Fragment)|
                         No such file or directory.*test/.*\.cpp|
                         undefined reference to.*ParseURL|
                         'clParseURL' (was )?not declared in this scope|
                         error: no member named 'm_Scheme'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               upstream-tests, api-migration, testing, gtest, porting
match_keywords:         上游测试, 旧 API, 已移除, 类重命名, clParseURL, ParseURL,
                        m_Scheme, scheme_, 无法编译, 移植测试, release tag 不一致,
                        头文件与测试不同步, stale test, TEST_F, gtest,
                        R51, 双口径, 通过率 8/8
title:                  上游 release tag 内测试引用与同 tag 头文件不一致的旧 API（类/成员重命名后测试未同步），需以最小补丁把测试用例移植到当前公开 API 后真实编译运行，不得把"无法编译"写成失败或跳过
prescan_pattern:        clParseURL|\bm_[A-Z]\w*\b|IsValid\(\)|ParseURL::ParseURL
prescan_globs:          test/**, tests/**, */test.cpp, */tests.cpp

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游在版本演进中重命名了公共 API（本库 release-1.1 把
                        clParseURL 类改为 LUrlParser::ParseURL，成员由
                        m_Scheme/m_Host/m_Port/m_Path/m_Query 改为
                        scheme_/host_/port_/path_/query_/fragment_，
                        IsValid() 改 isValid()，ParseURL() 静态方法改
                        parseURL()），但 tag 内的 test/test.cpp 停留在旧 API，
                        未随头文件同步。因此 `make tests`（gcc test.cpp
                        ../LUrlParser.cpp -lgtest）直接编译失败：
                        clParseURL not declared / no member named 'm_Scheme'。
                        这是上游自身的一致性缺陷（stale test），不是平台问题，
                        也不是"上游没有测试"——8 个 TEST_F 用例真实存在于
                        tag 源码，只是引用了已移除的 API。
affected_scope:         所有"release tag 内 test 与头文件 API 不同步"的小型
                        C++ 库（单头/单文件实现、API 重命名/迁移而未更新
                        测试目录）。实证：lurlparser 1.1（8 用例）。
                        同构场景：类名大小写/成员前缀变更、命名空间迁移、
                        静态工厂改名、enum 常量改名。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           minimal-patch-port-upstream-test-to-current-api
rec_description:        【第一步 定性】先按双口径清点：test/test.cpp 中活跃
                        TEST_F/TEST 用例数 = source_declared_total；尝试原样
                        编译并记录首个错误（clParseURL not declared）——证明
                        "测试存在但无法编译"而非"没有测试"。
                        【第二步 最小补丁移植】在 recipes 允许范围内，仅把
                        test/test.cpp 的 API 调用逐字映射到当前公开头文件：
                        clParseURL -> LUrlParser::ParseURL（静态工厂
                        ParseURL(...) -> parseURL(...)；IsValid() -> isValid()；
                        m_Scheme -> scheme_ 等）。保持每条断言语义不变，
                        不新增/删除断言、不改预期值。补丁写入 patches/，
                        conandata.yml 声明（可配 WITH_TESTS 选项经
                        CMakeDeps 接入 gtest/1.17）。
                        【第三步 真实运行】构建并实际执行移植后的测试
                        （ctest -R <test_target> 或直接运行二进制），以
                        executed_passed_total/source_declared_total 如实回填
                        双口径通过率（本库 8/8 = 100%），附逐用例输出日志
                        与 SHA-256。被注释的上游用例（如 controlchars）
                        不计入活跃声明，但要在台账中列出。
                        【铁律】禁止把"测试无法编译"写成测试失败或平台限制；
                        禁止删测试或改断言预期来"修绿"；禁止用只打印字符串的
                        空壳替代真实用例执行。
rec_command:            # 定性（原样编译记录首错）
                        cd <src>/test && gcc -std=c++11 test.cpp ../LUrlParser.cpp -lgtest -o /dev/null 2>&1 | head -5
                        # 补丁后经配方真实运行（示例）
                        ctest -R lurlparser_tests --output-on-failure
                        # 或直接运行
                        ./lurlparser_tests   # => [  PASSED  ] 8 tests.
rec_auto_fix:           false
rec_impl:               patch-port-upstream-gtest-tests

fallback_priority:      2
fallback_approach:      report-stale-test-with-evidence
fallback_description:   若移植补丁仍因真实上游条件/外部依赖无法运行（如 gtest
                        未发布、测试依赖网络等），保留最小补丁并在台账中如实
                        记录尝试命令、退出码、首错与恢复条件；不得静默省略
                        或改判通过。
fallback_command:       无（保留补丁 + 台账 + quality_warnings）
fallback_auto_fix:      false
fallback_impl:          conan-recipe-test-evidence