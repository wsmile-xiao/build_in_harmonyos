#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E731.kv，填写各字段
# 对应的人类文档: doc/E731.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E731
trigger_tool: configure
phase: configuration
error_signature: Interactive (Y/N|enter|choice)|Invalid entry|g\+\+ -[IO]|cc -[IO].*\.c

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: build-system,portability,autotools
match_keywords: interactive configure, hard-coded compiler, g++, no make check, configure script
title: Legacy interactive configure hardcodes g++/cc and defines no test target

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: The upstream configure script is an interactive prompts-only wrapper that asks for memory/terrain limits and then emits hard-coded g++/cc compile commands, so it cannot be driven non-interactively in CI and ignores the Conan toolchain.
affected_scope: Legacy scientific/engineering packages shipping hand-written configure+build+install shell scripts instead of autotools/CMake/Meson (e.g. SPLAT! 1.4.2). Usually also has no make check/test/CTest target.
verification_cmd: grep -nE 'read |g\+\+|cc ' configure | head -20

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           recipe-side-source-replay           # 见 DESIGN §5 impl 列表
rec_description:        Bypass the interactive script in the recipe's build(): replay its documented non-interactive choices as a written config header, then compile the same upstream sources directly with the Conan toolchain compilers.
rec_command:            ${CONAN_FILE}: self.run("cp -f ${SRC}/Makefile.ohos .") && self.run('${CC} ${CFLAGS} ...')  # toolchain from tools.build:compiler_executables
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      wrapper-stdin-pipe
fallback_description:    If the script cannot be bypassed, feed its prompts from a here-doc/expect wrapper and post-process the emitted command lines to substitute the OHOS compilers (last resort; brittle against prompt changes).
fallback_command:       printf '1\n1\n1\n' | ./configure --prefix=${PREFIX}
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       ./configure\s*(&&|\||;)?\s*$|\./configure\s*--prefix
forbid_1_reason:        The upstream configure is interactive; called from build() it blocks on stdin forever (or fails on a read-only /tmp here-doc redirect) and never reaches compilation.
forbid_1_consequence:   conan create hangs until the W3/CI timeout budget is exhausted and the package is reported as build failure.
forbid_2_pattern:       (^|[^a-zA-Z_])g\+\+ |(^|[^a-zA-Z_])cc -
forbid_2_reason:        Hard-coded g++/cc invocations ignore the OHOS cross toolchain and silently produce host objects that fail at link/stage anyway (violates R33: never rely on shell compilers).
forbid_2_consequence:   Host-architecture objects leak into the OHOS package; linking fails or the artifact is unusable on device.

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P004, P011

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

