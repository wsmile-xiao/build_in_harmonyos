#====================================================================
# DRAFT-matchit-r01-conan-copy-pattern-dir-keep
# Conan 2 配方 copy() 保留 pattern 尾部目录 → include/include 双层嵌套
# 触发事件: matchit 1.0.0 HarmonyOS PC 路径 B 适配（task matchit-1.0.0-r01-pc1-19）
#====================================================================

id:                     DRAFT-matchit-r01-conan-copy-pattern-dir-keep
trigger_tool:           conan|cmake|conan-create
phase:                  packaging|recipe
error_signature:        matchit.h file not found|
                         include/include/|package_folder/include/include|
                         INTERFACE_INCLUDE_DIRECTORIES.*/include
severity:               2
category:               conan, recipe, packaging, headers
match_keywords:         conanfile, package(), copy(), conan.tools.files.copy,
                         header-only, include, pattern, src, dst, double-nested,
                         CMakeDeps, INTERFACE_INCLUDE_DIRECTORIES, test_package,
                         header file not found, include path
title:                  Conan 2 package() copy() 保留 pattern 尾部目录导致 include/include/ 双层嵌套

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  conan.tools.files.copy(pattern, src, dst) 在 pattern 含目录（如 "include/matchit.h"）时，
  复制会保留该尾部目录层级。若 dst 又指向 package_folder/include，落盘为
  package_folder/include/include/matchit.h，而 CMakeDeps 生成的
  INTERFACE_INCLUDE_DIRECTORIES 指向 package_folder/include（matchit_INCLUDE_DIRS_RELEASE=
  "${matchit_PACKAGE_FOLDER_RELEASE}/include"），consumer 的 #include <matchit.h> 找不到头文件，
  在 conan create 的 test_package 编译阶段报 fatal error。
  根因在 recipe 编写语义（copy 保留 pattern 目录），而非上游 CMake install 目标
  （后者见 E217，是另一侧问题）。

affected_scope: >
  所有 header-only / 手工 copy 头文件的 Conan 2 配方：凡 copy() 的 pattern 带目录层级且
  dst 也含相同目录（include/include 式）即触发；单文件无目录 pattern（"*.h"）不受影响。

verification_cmd: >
  conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
  --build=missing; 检查 package folder 布局与 CMakeDeps 的 INTERFACE_INCLUDE_DIRECTORIES

principles:             P012
rec_priority:           1
rec_approach:           copy-src-dst-symmetric-include-join
rec_description: >
  将 copy() 的 src 与 dst 双侧都 join 到 include/，pattern 用裸文件名：
  copy(self, "matchit.h", src=os.path.join(self.source_folder, "include"),
       dst=os.path.join(self.package_folder, "include"))
  → 落盘为 package_folder/include/matchit.h，与 includedirs=["include"] 一致。
  若确需按子目录分装，应让 dst 保留 pattern 尾部目录之外的父目录（src 侧剥离同名前缀）。
rec_command: >
  copy(self, "matchit.h", src=os.path.join(self.source_folder, "include"),
       dst=os.path.join(self.package_folder, "include"))
rec_auto_fix:           true
rec_impl:               recipe-package-info
caused_by:
causes:                 E217
