#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: make|sscanf|kernel|conan
phase: testing|runtime
error_signature: FAIL: library/tests/test_version|procps_linux_version.*rc=1|cat /proc/sys/kernel/osrelease -> HongMeng Kernel [0-9.]+|/proc/version 不可读

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: ohos, kernel, procfs, testing, version
match_keywords: HongMeng Kernel, osrelease, /proc/version, Permission denied, procps_linux_version, test_version, sscanf 版本解析, 非标准版本串, kernel version parse, 7 PASS 1 FAIL, 环境性失败
title: HongMeng 内核版本串非标准（a.b.c 解析失败 + /proc/version 不可读）导致版本解析类测试环境性失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS 的 /proc/sys/kernel/osrelease 返回非标准串 "HongMeng Kernel 1.12.0"（非数字开头的 a.b.c 格式），且 /proc/version 不可读（cat 返回 Permission denied）；依赖 sscanf("%d.%d.%d") 类格式从这两个文件解析 Linux 版本号的库（如 procps-ng libproc2 的 procps_linux_version()）解析失败返回 0，上游 test 断言 rc==0 && ver>0 不满足。procps 4.0.7 实测：8 个测试程序 7 PASS / 1 FAIL，唯一 FAIL 即 test_version 的 procps_linux_version 子用例（同程序 LINUX_VERSION macro 编译期子用例 PASS，证明仅运行时 /proc 解析路径受影响）
affected_scope: 所有在运行时用 sscanf/正则解析 /proc/sys/kernel/osrelease 或 /proc/version 获取内核版本号的软件及其测试；uname 语义差异同源。典型场景：make check 的 version 类 CUnit/断言测试
verification_cmd: cat /proc/sys/kernel/osrelease; cat /proc/version; make check 后 grep FAIL

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: treat-as-environment-limitation
rec_description: 定性为环境性失败而非适配缺陷：禁止修改上游断言（R9/G 门禁语义），不 patch 测试期望值。处理方式：1) conanfile.py build() 中 make check 用 try/except 包裹，捕获后 output.info 记录已知环境性失败继续构建；2) notes.md 如实记录统计（7 PASS/1 FAIL）与定性证据（osrelease 实际串 + /proc/version 不可读 + macro 子用例 PASS 对照）；3) 沉淀知识草稿；4) 若软件功能强依赖运行时版本号，优先走编译期 LINUX_VERSION 宏等已知常量路径而非运行时解析
rec_command: cat /proc/sys/kernel/osrelease; make check 2>&1 | tee check.log; grep -E "^(PASS|FAIL)" check.log | sort | uniq -c
rec_auto_fix: false
rec_impl: notes-documentation

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: compile-time-version-macro
fallback_description: 若下游软件必须获得数值版本：优先使用编译期宏（如 LINUX_VERSION_CODE，由 headers 提供，测试证明可用）替代运行时 /proc 解析；仅在用户显式要求且上游接受时才考虑 __OHOS__ 守卫的解析替代实现，且不得绕过上游测试断言语义
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

