#====================================================================
# Draft: conan MesonToolchain remaps libexecdir to the bindir, so GNOME
#        installed-tests land in bin/installed-tests (not libexec)
#====================================================================

id:                     DRAFT-LIBXMLB-MESON-INSTALLED-TESTS-BINDIR
trigger_tool:           meson|conan|install
phase:                  packaging
error_signature:        bin/installed-tests|libexecdir.*bindir|installed_test_bindir|expected.*libexec/installed-tests

severity:               2
category:               conan, meson, packaging, gnome
match_keywords:         installed-tests, libexecdir, bindir, MesonToolchain, meson install, gnome, glib, destdir, rmdir, install_dir

title:                  conan MesonToolchain remaps libexecdir to the conan bindir, so GNOME installed-tests (binaries + data) are installed under bin/installed-tests instead of libexec/installed-tests

root_cause:             Conan's MesonToolchain (_get_default_dirs) maps the meson
                        libexecdir to cpp.package.bindirs ("bin") to keep the conan
                        package layout flat. GNOME projects (glib, libxmlb, ...)
                        install their installed-tests suite via
                        installed_test_bindir = join_paths(libexecdir, 'installed-tests', ...)
                        so the test executable and its data files land in
                        <pkg>/bin/installed-tests/<project>/ rather than
                        libexec/installed-tests/<project>/. Recipes that rmdir the
                        legacy libexec path after install silently keep the junk in
                        bin/, and the unsigned (rpath-rewritten by meson install)
                        test binary then ships inside the package.

affected_scope:         Any meson package declaring installed-tests (or any tool
                        installed into libexecdir) on conan 2.2x: the artifact path
                        differs from the upstream/Debian convention. Verified
                        instance: libxmlb 0.3.19 (archives/l/libxmlb/0.3.19).

verification_cmd:       conan create archives/l/libxmlb/0.3.19 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 && ls <pkg>/bin/installed-tests

rec_priority:           1
rec_approach:           rmdir-bin-installed-tests
rec_description:        After meson.install(), remove the installed-tests tree from
                        ALL remapped locations: bin/installed-tests (conan dir
                        mapping), plus libexec/installed-tests and
                        share/installed-tests as belt-and-braces (conan rmdir
                        tolerates missing paths). The suite has already run in
                        build() via `meson test` on the OHOS target, so dropping
                        the installed copy matches the glib packaging convention.
rec_command:            rmdir(self, os.path.join(self.package_folder, "bin", "installed-tests")); rmdir(self, os.path.join(self.package_folder, "share", "installed-tests")); rmdir(self, os.path.join(self.package_folder, "libexec", "installed-tests"))
rec_auto_fix:           false
rec_impl:               package() in archives/l/libxmlb/0.3.19/conanfile.py

fallback_priority:      2
fallback_approach:      keep-and-sign
fallback_description:   If the installed-tests suite must ship (distro-style
                        installed-test harness), keep bin/installed-tests but
                        extend the ELF re-sign glob to `bin/**/*` so the
                        rpath-rewritten test binary is re-signed (an unsigned
                        meson-install copy fails OHOS loader validation).
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       rmdir.*libexec/installed-tests(?!.*bin/installed-tests)
forbid_1_reason:        Removing only libexec/installed-tests leaves the actual
                        remapped copy in bin/installed-tests inside the package.
forbid_1_consequence:   Junk test binary/data shipped; unsigned test ELF may
                        break downstream signature validation.

principles:

causes:
caused_by:
similar_to:             E090
conflicts_with:
prerequisite_of:
