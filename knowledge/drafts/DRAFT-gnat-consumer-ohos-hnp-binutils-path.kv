#====================================================================
# DRAFT-gnat-consumer-ohos-hnp-binutils-path
# GNAT 消费端需要 GNU binutils 在 PATH（/usr/bin/as 受 SELinux 保护，前置 /data/service/hnp/bin）
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: adacgi 1.6 HarmonyOS PC 适配（shadow CI isolated job）
#====================================================================

id:                     DRAFT-gnat-consumer-ohos-hnp-binutils-path
trigger_tool:           gcc|gnatmake|gnatbind|gnatlink|as|ld|conan|test_package|binary-sign-tool
phase:                  build|packaging|testing|runtime
error_signature:        'gcc\.real: fatal error: cannot execute ''as'': execvp: Permission denied|cannot execute ''as''|/usr/bin/as.*Permission denied|run-time library not installed correctly'

severity:               2
category:               toolchain-consumer|gnu-binutils|selinux|path-b|OHOS
match_keywords:         gcc-ada, GNAT, gnatmake, gcc.real, execvp, as, ld, GNU binutils,
                         /usr/bin/as, /data/service/hnp/bin, SELinux, Permission denied,
                         binary-sign-tool, llvm-objcopy, llvm-readelf, PATH prepend,
                         conanbuild, isolated job, shadow CI
title:                  GNAT 消费端需要 GNU binutils 在 PATH（前置 /data/service/hnp/bin）

root_cause: >
  GNAT 的 gcc 驱动在汇编阶段用 execvp("as") 在 PATH 里找汇编器，运行时忽略 AS 环境变量
  （AS 是 GCC 构建期变量）。OHOS 上 /usr/bin/as 受 SELinux 保护，任何进程 execvp 它都
  Permission denied；可用的 GNU Binutils 2.45 在 /data/service/hnp/bin。隔离 shadow CI
  job 的基础 PATH 不含该目录，导致编译在汇编阶段失败。
affected_scope: >
  在 OHOS 上用 gcc-ada（或任何 GCC 系工具链）作为 tool_requires 消费、由 gcc/gnatmake 驱动
  现场编译 .adb/.c 的下游库，尤其是隔离 shadow CI job（PATH 无 /data/service/hnp/bin）。
verification_cmd:       CI_PACKAGES="archives/a/adacgi/1.6" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           prepend-hnp-binutils-path-in-generate
rec_description: >
  在配方 generate() 用 Environment 对 OHOS 前置 PATH=/data/service/hnp/bin，save_script 成
  独立环境脚本；self.run 用 env=["conanbuild", <该脚本>] 叠加。签名阶段的 shutil.which 走
  Python 进程 PATH，不受 self.run env 影响，需为 binary-sign-tool/llvm-objcopy/llvm-readelf
  显式 fallback 到 /data/service/hnp/bin/...。
rec_command:            env.prepend_path("PATH", "/data/service/hnp/bin"); self.run(cmd, env=["conanbuild","<env>"])
rec_auto_fix:           false
rec_impl:               conan-generate-env-prepend-path

fallback_priority:      2
fallback_approach:      sign-and-embed-binutils-in-toolchain-package
fallback_description: >
  若希望消除消费端对 /data/service/hnp/bin 的隐式依赖，可由 gcc-ada 工具链包在 package()
  阶段把所需 as/ld 等 GNU binutils 复制进包内 bin/ 并通过 package_info 的 PATH 暴露，使下游
  无需自行前置 HNP 路径。这属于工具链包职责，不应由每个下游库重复实现。
fallback_command:       bundle GNU as/ld into gcc-ada package bin/ and expose via package_info PATH
fallback_auto_fix:      false
fallback_impl:          toolchain-bundles-binutils

forbid_1_pattern:       export AS=/data/service/hnp/bin/as|AS=.*hnp.*as
forbid_1_reason:        GCC 驱动运行时用 execvp("as") 在 PATH 查找，忽略 AS 环境变量。
forbid_1_consequence:   '设了 AS 仍报 cannot execute ''as'': Permission denied，浪费一轮构建。'

forbid_2_pattern:       package_info.*PATH.*data/service/hnp|global.*PATH.*hnp
forbid_2_reason:        把设备绝对路径写进 package_info 或污染全局环境，破坏包的可移植性与隔离性。
forbid_2_consequence:   下游在非 OHOS 或不同布局环境失效，且违反包边界。

forbid_3_pattern:       shutil\.which\("objcopy"\)|shutil\.which\("readelf"\)|which.*binary-sign-tool.*no-fallback
forbid_3_reason:        隔离 job 的 Python 进程 PATH 无 HNP bin，裸名查找必然失败。
forbid_3_consequence:   签名阶段抛 Invalid configuration，构建通过但测试无法运行。

principles:             P005, P013, P016, P019, P023
causes:                 []
caused_by:              []
similar_to:             [E012, E450, DRAFT-below-ohos-unsigned-rust-toolchain]
conflicts_with:         []
prerequisite_of:        gcc-ada/GNAT 工具链下游库的 OHOS 消费适配

