#====================================================================
# DRAFT-13401-consolation-0.0.10-cross-build-man-rule-runs-binary - man page rule executes the cross-built binary
#====================================================================

id:                     DRAFT-13401-consolation-0.0.10-cross-build-man-rule-runs-binary
trigger_tool:           make|automake|clang
phase:                  build
error_signature:        "Exec format error|cannot execute binary file|consolation.8|help2man|man.*rule.*fail|make.*MANS.*fail"

severity:               2
category:                autotools|man|cross-build|makefile
match_keywords:         dist_man_MANS, man_MANS, help2man, all-am, cross build, Makefile.in, --disable-manpages, man 规则
title:                  上游 man 页规则执行编译产物:交叉构建必失败

root_cause:             上游 man 页由"执行刚编译出的守护进程"排版生成(src/Makefile.am 内联规则,help2man 风格),且 automake 把 $(MANS) 挂进 all-am——make 阶段即执行目标架构二进制,交叉构建宿主无法运行(Exec format error);该包无 --disable-manpages 开关,配置层无法规避。
affected_scope:         man 页/文档由运行编译产物生成、无交叉守卫、无禁用开关的 autotools 包;consolation/0.0.10 实测受影响。
verification_cmd:       grep -n "MANS" src/Makefile.am 看规则是否执行程序;构建应在 configure 前中性化 src/Makefile.in 的 dist_man_MANS 行后进行;CI conan create 构建成功即验证。

rec_priority:           1
rec_approach:           blank-dist-man-mans-before-configure
rec_description:        configure 前把 src/Makefile.in 的 dist_man_MANS 行清空,使生成的 Makefile 不含 man 目标(all-am 不再触发、install-man 变 no-op);与 -Ddocumentation=false / --disable-manpages 同口径,在配方内做,不占补丁位。
rec_command:            conanfile.py build() 前置: sed 's|^dist_man_MANS = .*|dist_man_MANS =|' src/Makefile.in(或读文件做行替换)
rec_auto_fix:           false
rec_impl:               recipe-source-mutation

fallback_priority:      2
fallback_approach:      stub-man-page
fallback_description:   若必须保留 man 页安装,可在 make 前预生成一个静态 stub consolation.8 放到规则目标路径,使 make 认为目标已最新而跳过执行规则;依赖时间戳,较脆弱。
fallback_command:       touch/写入 stub 到 $(top_srcdir)/consolation.8 于 autotools.make 之前
fallback_auto_fix:      false
fallback_impl:          recipe-timestamp-trick

forbid_1_pattern:       (dist_man_MANS|man_MANS)\s*=\s*\S+
forbid_1_reason:        man 规则执行交叉编译产物的包,保留 MANS 变量会让 make(all)在宿主执行目标二进制。
forbid_1_consequence:   make 阶段 Exec format error 失败。

forbid_2_pattern:       patch.*src/Makefile\.am(?!.*Makefile\.in)
forbid_2_reason:        只补 Makefile.am 不补 Makefile.in 无效——构建用的是随 tarball 分发的 Makefile.in;改 .am 需重新 automake,交叉环境通常不可行。
forbid_2_consequence:   补丁看似应用但生成的 Makefile 仍含 man 目标,构建照样失败。

principles:             []
causes:                 []
caused_by:              []
similar_to:             [DRAFT-libinput-1.28.1-musl-program-invocation-name-third-fallback]
conflicts_with:         []
prerequisite_of:        []

