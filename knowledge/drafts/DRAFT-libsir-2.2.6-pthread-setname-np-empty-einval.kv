#====================================================================
# Draft knowledge entry - OHOS/musl pthread_setname_np 空名 EINVAL
# Source package: libsir/2.2.6
#====================================================================

id:                     DRAFT-libsir-2.2.6-pthread-setname-np-empty-einval
trigger_tool:           clang|tests|runtime
phase:                  testing|runtime
error_signature:        pthread_setname_np.*EINVAL|Invalid argument.*pthread_setname|setthreadname.*22:|Platform error code 22.*thread name
severity:               2
category:               pthread|musl|ohos|runtime-behavior
match_keywords:         pthread_setname_np, empty string, EINVAL, glibc, musl, OHOS,
                        thread name, threadid, sanity-thread-ids, libsir
title:                  OHOS/musl 的 pthread_setname_np 拒绝空字符串（EINVAL），glibc 允许——清空线程名的库代码需按 no-op 处理

root_cause:             glibc 的 pthread_setname_np(thread, "") 允许把线程名清空；
                        OHOS 使用的 musl 系 libc 对空字符串返回 EINVAL (22)。
                        因此依赖"传空串清空线程名"的上游库（如 libsir 的
                        `_sir_setthreadname("")`）在 OHOS 上调用失败，其测试
                        sanity-thread-ids 在"clearing thread name"步骤失败。
affected_scope:         在 OHOS/musl 上运行的、通过 pthread_setname_np 设置/清空线程名的
                        C/C++ 库及其测试。
verification_cmd:       cat > /tmp/t.c <<'EOF'
#define _GNU_SOURCE
#include <pthread.h>
#include <errno.h>
#include <stdio.h>
int main(void){int r=pthread_setname_np(pthread_self(),"");printf("%d %d\n",r,errno);return 0;}
EOF
clang -D_GNU_SOURCE -pthread /tmp/t.c -o /tmp/t && /tmp/t   # OHOS/musl: r=22 EINVAL

rec_priority:           1
rec_approach:           empty-name-noop-guard
rec_description:        调用 pthread_setname_np 前对空名字做 no-op 成功守卫：空串直接
                        return true，不调用平台 API。行为上与 glibc 兼容（glibc 本就能
                        清空），且无平台宏，符合 R8 补丁规则。
rec_command:            sed -i '/bool _sir_setthreadname(const char\* name) {/a\\    if (0 == name[0])\\n        return true;' src/sirinternal.c
rec_auto_fix:           true
rec_impl:               patches/0001-src-sirinternal.c.patch（libsir 2.2.6 示例：
                        `_sir_setthreadname` 函数入口加 `if (0 == name[0]) return true;`，
                        测试 36/36 通过）

fallback_priority:      2
fallback_approach:      skip-clearing-test
fallback_description:   若无法改库代码，在测试侧跳过"清空线程名"步骤，但会掩盖真实行为差异。
fallback_command:       （不推荐；优先 API 修正）
fallback_auto_fix:      false
fallback_impl:          test-only

forbid_1_pattern:       对空线程名调用 pthread_setname_np 并期望成功；把 EINVAL 当成本库
                        编译错误去改测试断言掩盖
forbid_1_reason:        平台行为差异应修在库 API 侧（no-op 守卫），不是弱化测试

principles:             R8（补丁默认禁止平台宏，空名 no-op 守卫无平台宏）、R51（上游测试如实回填）
caused_by:              OHOS/musl libc pthread_setname_np 空串实现与 glibc 不同
similar_to:             E202（musl PTHREAD_KEYS_MAX 差异）、E085/E127（OHOS pthread 面差异）
conflicts_with:

# ═══ 质量度量 ═══
metrics_success_count: 1
metrics_fail_count: 0
metrics_confidence: 0.8
metrics_last_used: 2026-09-27