#====================================================================
# DRAFT-netcdf-c-4.9.3-ddispatch-tmpdir-env
# netcdf-c ddispatch 硬编码 /tmp 在 OHOS erofs 只读下 DAP cookie jar 失败
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: key: > 后每行两个空格缩进
#   - 数组: key: [a, b, c]
#   - 布尔: true/false
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: DRAFT-netcdf-c-4.9.3-ddispatch-tmpdir-env
trigger_tool: conan|make|test|DAP
phase: testing|runtime
error_signature: state->auth->curlflags.cookiejar != NULL|ocinternal.c: oc_set_curlproperties: 585|Signal 6|core dumped|Unable to create.*temporary.*file|cookiejar

# ═══ Layer 1: 识别层 (Recognition) ═══
severity: 2
category: platform|filesystem|tmpdir|erofs
match_keywords: tempdir, /tmp, erofs, read-only, TMPDIR, TMP, cookiejar, OCASSERT,
  ocinternal.c, ddispatch, curlflags, cookie jar, HMDFS, DAP3, DAP4

# ═══ Layer 2: 根因层 (Root Cause) ═══
root_cause: >
  libdispatch/ddispatch.c 非 Windows 分支把 tempdir 硬编码为 "/tmp" 且不读取
  TMPDIR/TMP 环境变量；OHOS /tmp 为 erofs 只读挂载，DAP client (oc2/ocinternal.c:585)
  创建 cookie jar 临时文件失败，curlflags.cookiejar 保持 NULL → OCASSERT，DAP3 测试
  Signal 6。设备可写候选穷举后 HMDFS 不保留 0700、/dev/shm 不可写，纯设环境变量无效。

# ═══ Layer 3: 方案层 (Approach) ═══
rec_priority: 1
rec_approach: patch-source-tmpdir-env-read
rec_description: >
  库源码非 Windows 分支先读 getenv("TMPDIR") 再 getenv("TMP") 最后回退 "/tmp"；
  运行环境 export TMPDIR=<可写目录>。可移植性修复，不改测试逻辑。
rec_command: >
  mount | grep ' /tmp '；export TMPDIR=<任务可写目录>；
  make -C ncdap_test check -j1  # 修复前 4 FAIL(Signal 6) → 修复后 4 PASS
rec_auto_fix: false
rec_impl: source-patch（配方补丁，随库交付）

fallback_priority: 2
fallback_approach: preset-writable-env-only
fallback_description: >
  仅当库源码已读 TMPDIR 时，export TMPDIR=<可写目录> 即可（E002 常规路径）；
  库硬编码 /tmp 时必须走源码补丁（本条边界）。

# ═══ Layer 4: 验证层 (Verification) ═══
verification_cmd: >
  export TMPDIR=<可写目录> && make -C ncdap_test check -j1
verification_expected: 4/4 PASS，rc=0；test-suite.log 无 FAIL
metrics_success_count: 1
metrics_fail_count: 0
metrics_confidence: 0.95
metrics_last_used: 2026-09-16

# ═══ 关联 (Relations) ═══
similar_to: [E002, DRAFT-E547, DRAFT-E571]
caused_by: [OHOS /tmp erofs 只读, ddispatch 硬编码 /tmp 不读环境变量]
prerequisite_of: []
conflicts_with: []
affected_scope: >
  非 Windows 分支硬编码 /tmp 且不读 TMPDIR/TMP 的 C 库，在 /tmp 只读平台
  （OHOS erofs）上需要临时文件/cookie jar 的场景；依赖 DAP client 的库。

# ═══ 元数据 ═══
doc_file: knowledge/drafts/DRAFT-netcdf-c-4.9.3-ddispatch-tmpdir-env.md
last_updated: 2026-09-16
source_event: >
  netcdf-c 4.9.3 鸿蒙 PC 适配：ncdap_test 4 项 FAIL（t_dap3a/test_cvt3/test_vara/
  tst_ncdap3.sh，Signal 6，OCASSERT cookiejar）；ddispatch.c 补丁读取 TMPDIR/TMP
  后重建，ncdap_test 4/4 PASS。与 E002（仅环境变量）、E547/E571（libcheck 测试框架
  临时目录优先级）同族不同触发库。
source_pr: (随 netcdf-c 4.9.3 PR 提交后回填)
source_commit: (随 netcdf-c 4.9.3 PR 提交后回填)
authors: pc1-22