id: DRAFT-release-tarball-missing-cmake-submodule
severity: 2
category: build-system|cmake|conan|source
trigger_tool: cmake|git|conan
phase: source|build|package
approach: verify-release-completeness-and-package-header-only-directly
keywords: release tarball, git submodule, CMake, cmake/common, header-only, OHOS, Conan
error_signature: "include could not find requested file: tools; Unknown CMake command configure_and_install"
match_keywords: "gitmodules,cmake/common,include(tools),configure_and_install,release tarball"
title: Verify release tarballs before relying on CMake submodules
root_cause: "The release archive preserves references to a CMake helper submodule but omits the submodule files, so configure-time includes and custom install macros are unavailable. Fetching the SSH submodule from inside a recipe is not a pinned, reproducible source boundary."
affected_scope: "CMake C/C++ projects whose release archives omit a referenced helper submodule, especially header-only libraries with independently compilable public headers."
verification_cmd: "inspect the official tarball for .gitmodules and the referenced directory; compile shipped examples with the OHOS profile compiler; conan create <archive> -pr:h=<ohos-profile> --build=missing"
rec_priority: 1
rec_approach: "verify archive completeness, avoid unpinned submodule fetches, and use a deterministic header-only recipe when the public API is independent"
rec_description: "Separate source completeness from compiler compatibility. For a header-only library, package the public headers with a deterministic Conan recipe, compile real shipped examples using the profile compiler, and exercise the generated package target in test_package."
rec_command: "test -d cmake/common || fail; clang++ -std=c++17 -Isrc/include example/connection_fsm/connection_fsm_tests.cpp -o connection_fsm"
rec_auto_fix: false
forbid_1_pattern: "git submodule update"
forbid_1_reason: "A recipe-side SSH submodule fetch is not reproducible unless the dependency source and revision are explicitly locked and vendored."
forbid_1_consequence: "Clean CI can fail on network/authentication or silently build with a different helper revision."
forbid_2_pattern: "dummy.*cmake/common"
forbid_2_reason: "A fake helper can hide missing install logic and produce an unverified package."
forbid_2_consequence: "The package may compile but omit required targets, headers, or installation metadata."
fallback_priority: 2
fallback_approach: "create an explicit patch that vendors a pinned helper or replaces only the packaging macros"
fallback_description: "Use this only when the complete helper source/revision is available and the resulting patch is independently verified by upstream examples and a real consumer."
fallback_command: "record the pinned helper source and regenerate the patch through the repository patch pipeline"
fallback_auto_fix: false
