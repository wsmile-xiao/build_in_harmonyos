#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E580.kv，填写各字段
# 对应的人类文档: doc/E580.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E580
trigger_tool: cmake
phase: configuration|compilation
error_signature: __thread/support\.h|__libcpp_aligned_free|source_location|_LIBCPP_HAS_LIBRARY_ALIGNED_ALLOCATION

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: compat, headers, libc, platform, build-system
match_keywords: libcxxabi, libc++abi, libc++, llvm-project, __thread/support.h, __config_site, __libcpp_aligned_free, clang 15, SDK headers, LIBCXXABI_LIBCXX_PATH
title: libc++abi 22 构建依赖 clang19+ 的 libc++ 头文件，改用设备 SDK libc++ 15 头文件并收敛差异

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: libcxxabi 22 源码必须搭配同一版本的 libc++ 22 头文件，而 libc++ 22 头文件要求 clang 19+（设备与 CI 工具链为 clang 15），故无法直接用源码树自带头文件构建
affected_scope: 所有构建 libc++abi/libc++ 22.x 且工具链低于 clang 19 的适配任务
verification_cmd: conan create . -pr:h=ci/conan/profiles/ohos-aarch64 通过且 libcxxabi/test 全量 pass

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: sdk-libcxx15-headers
rec_description: 改用设备 SDK 随附的 libc++ 15 头文件（CMAKE_CXX_FLAGS 中 -isystem 注入，libcxxabi 22 无独立 libcxx includes 变量），命令行补 libc++ 22 配置宏（线程模型/异常/对齐分配），并用补丁收敛三类 API 差异：<__thread/support.h> 用 __has_include 守卫、fallback_malloc 改用 SDK15 <new> 的 __libcpp_aligned_*、stdlib_new_delete 用 libc++ 版本宏区分 __libcpp_aligned_free 重复定义
rec_command: cmake -DCMAKE_CXX_FLAGS="-isystem $SDK/include/libcxx-ohos/include/c++/v1 -D_LIBCPP_HAS_THREADS=1 -D_LIBCPP_HAS_THREAD_API_PTHREAD=1 -D_LIBCPP_HAS_EXCEPTIONS=1 -D_LIBCPP_HAS_LIBRARY_ALIGNED_ALLOCATION=1 -fPIC" -DLIBCXXABI_LIBCXX_PATH=<src>/libcxx -DLIBCXXABI_LIBCXX_LIBRARY_PATH=$SDK/lib/aarch64-linux-ohos
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: use-clang19-toolchain
fallback_description: 若环境提供 clang 19 及以上工具链，可直接用源码树自带 libc++ 22 头文件构建，无需本补丁
fallback_command:
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E580.md
last_updated: 2026-09-16
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
