#====================================================================
# DRAFT-enet-2.7.0-single-header-impl-lib - stb-style 单头实现库
# （实现体在头文件，宏实例化）经 CMake 小 TU 编译为真实静态库的配方形态
#
# 场景: enet 2.7.0（zpl-c/enet）为单头实现库：include/enet.h 内含完整
#       实现体，消费者 `#define ENET_IMPLEMENTATION` + `#include "enet.h"`
#       实例化。上游 CMake 用 3 行 test/library.c（仅做上述两行）编译
#       libenet.a。配方按普通 CMake library 打包（非 package_type=
#       header-library、非 no-op build），测试目标（enet_test 等）与库
#       目标共存，ENET_TEST 控制测试构建。
# 适用: 所有 stb 风格单头实现 C/C++ 库（stb_image/cglm/flecs/enet 等）
#       在 Conan 2 + OHOS/CI clean 环境下落地配方。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-enet-2.7.0-single-header-impl-lib
source_lib:             enet 2.7.0
trigger_tool:           conan|conan-verify|cmake
phase:                  recipe|packaging|testing
error_signature:        ENET_IMPLEMENTATION|single-header|单头实现|header-only.*INTERFACE|no build\(\)|G1.*build

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, cmake, headers, packaging, single-header, stb-style
match_keywords:         ENET_IMPLEMENTATION, IMPLEMENTATION 宏, 单头实现, single-header,
                        stb-style, stb_image, cglm, 实现体在头文件, header body, header-only 误判,
                        package_type=header-library 误用, test/library.c, 静态库
title:                  stb-style 单头实现库（实现体在头文件、宏实例化）应作为普通 CMake 静态库打包，勿误用 header-only/INTERFACE 或无构建系统配方

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  单头实现库的实现体虽在头文件中，但产物是经一小段 TU（如 3 行 .c 定义
  ENET_IMPLEMENTATION 并 include 头文件）编译出的真实静态库（libenet.a），
  与 header-only INTERFACE 库（add_library(X INTERFACE)、无 .a 产物）和
  无构建系统库（E257 场景）边界不同。若按 package_type=header-library 或
  no-op build() 处理，会丢失真实库产物与链接目标，下游 find_package/
  target_link_libraries 失败。
affected_scope:         stb 风格单头实现库的 Conan 配方（单头实现 + 上游自带 CMake/
                        Makefile 编译小 TU 成库）；判断"单头实现==header-only"的适配任务。
verification_cmd:       grep -nE 'IMPLEMENTATION|ENET_IMPLEMENTATION' <source>/*.h;
                        grep -nE 'add_library' <source>/CMakeLists.txt  # 目标为 STATIC 而非 INTERFACE

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           package-as-regular-static-lib
rec_description:        按普通 CMake library 配方打包：package_type="library"、
                        ENET_STATIC=ON（R26 系统同名库静态）、ENET_TEST=OFF 仅打包；
                        上游测试目标以 ENET_TEST=ON 单独构建运行（双口径台账），
                        不进配方 build()。package_info 填真实 libs=["enet"]。
                        若上游无 CMake，可自建小 TU（define ENET_IMPLEMENTATION +
                        include 头文件）用 conan 编译为静态库重复同样形态。
rec_command:            conanfile.py: tc.variables["ENET_STATIC"]="ON"; tc.variables["ENET_TEST"]="OFF";
                        cmake.configure(); cmake.build(); cmake.install()
rec_auto_fix:           false
rec_impl:               conan-recipe
fallback_priority:      2
fallback_approach:      header-library-with-implementation-tu
fallback_description:   若上游无构建系统，采用 package_type="library" + 自建实现 TU
                        （复制 3 行实例化 .c）+ CMake 编译，保持真实库产物。
fallback_command:       mkdir -p src; printf '#define ENET_IMPLEMENTATION\n#include "enet.h"\n' > src/impl.c
fallback_auto_fix:      false
fallback_impl:          manual
forbid_1_pattern:       误用 package_type=header-library|no-op build\(\) 丢库产物|伪造测试通过

# ═══ Layer 4: 验证层 (Validation) ═══
verified_on:            enet 2.7.0（OHOS armv8，clang 15.0.4，conan 2.29.1）
verification_result:    libenet.a 正常产出（ar archive）；conan-verify G0-G4+L2/L4/L5
                        全 PASS；W3 100%；消费者 test_package 回环测试 7 项 API 调用
                        全过（enet_initialize/host_create/host_connect/peer_send/
                        packet/peer_disconnect/host_destroy）。
# 反例/限制
limitations: >
  - 仅适用"实现体在头文件但产物为真实库"的形态；纯 INTERFACE header-only 库
    仍走 E321/E322。判断依据：上游 CMake add_library 是否 STATIC/SHARED。
  - ENET_TEST=OFF 不替代上游测试验证；MANIFEST.yml 如实记录独立测试结果。