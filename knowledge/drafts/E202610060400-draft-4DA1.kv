#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E202610060400.kv，填写各字段
# 对应的人类文档: doc/E202610060400.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E202610060400
trigger_tool: runtime
phase: testing
error_signature: arithmetic syntax error|syntax error in expression|cache.*not.*refresh

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: shell-scalar-argv-portability
match_keywords: scalar argv, embedded quotes, Toybox stat, xargs, arithmetic syntax error, mtime, cache invalidation
title: 标量命令中的字面引号破坏数值输出与缓存失效

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Shell 参数展开不会重新解释变量值中的引号；把 stat -c 的格式写成内嵌单引号会将引号传给工具，后续 Toybox 管线可保留它，导致整数比较失败且缓存不刷新。
affected_scope: 以标量拼接命令并将输出交给整数比较的 POSIX 脚本；包括补全缓存、构建增量检查和状态探针。
verification_cmd: 真实目标上依次验证首次生成、缓存复用、确定性 mtime 变更后重生成；保留原始输出与 RC。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: preserve-token-boundaries-and-test-invalidation
rec_description: 对不含空格的格式 token 删除变量内部装饰引号；复杂参数改成实际 argv 数组。不得用 eval。通过真实工具链执行缓存三段式测试，外部业务命令可用确定性夹具，但不替换缓存产品或框架。
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: eval .*MTIME|stub.*stat|stub.*completion.framework
forbid_1_reason: 二次解析扩大注入面；替换关键框架或工具会掩盖兼容性故障。
forbid_1_consequence: 伪 PASS 或未发现缓存永不失效。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

