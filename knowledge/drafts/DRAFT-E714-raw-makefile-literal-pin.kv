# ═══ Draft knowledge entry — 手写 Makefile 字面量陷阱与 make 调用行全钉法 ═══
# Timestamp: 2026-09-24
# Software: psignifit 2.5.6（samhain/aa3d/meschach 同族）
# Gate: W0 + 真机 conan build（gcc 缺失 / OUTDIR=~/bin / 缺 -lm 三个坑同框）
# Status: DRAFT — needs human/AI review to promote to E-entry

draft:                 "E714-raw-makefile-literal-pin"
status:                "pending-editor-review"
id:                    "E714"
trigger_tool:          "make|conan"
phase:                 "build"
error_signature:       "gcc.*not found|cc.*command not found|No such file or directory.*/bin/psignifit|undefined reference to .(sqrt|exp|log|pow)|~\\/bin"

severity:              3
category:              "build-system,toolchain,portability,ohos"
prescan_pattern:       "\\b(CC|LD|OUTDIR|CFLAGS|LDFLAGS)\\s*\\+?="
match_keywords:        "手写 Makefile, 字面量 CC, gcc, OUTDIR, ~/bin, LDFLAGS -lm, make 调用行钉死, R33, 先例4, aa3d, samhain"
title:                 "手写 Makefile 把 CC/LD/OUTDIR/CFLAGS/LDFLAGS 写成字面量：在 make 调用行一次性全钉（编译旗标 + 链接旗标双钉）并做 rc=0 产物核对"

root_cause: >-
  90 年代—2000 年代初的裸 Makefile 习惯把工具链与输出目录写死为文件级字面量
  （如 `CC = gcc`、`LD = gcc $(CYGFLAG) $(DBFLAG)`、`OUTDIR = ~/bin`、`LDFLAGS = ` 空值）。
  在 OHOS/CI 上有三个确定性后果：① 设备与 worker 无 gcc（连 cc 别名都没有，先例7 裸命令名族）
  → 立即 "gcc: not found"；② `OUTDIR = ~/bin` 使目标成为 `<HOME>/bin/psignifit`，
  目录不存在时报 "No such file or directory"，且产物污染构建机 HOME；③ 上游漏写 `-lm`
  → 链接期 undefined reference（Debian 靠自己的补丁加 LIBS=-lm 解决）。
  环境变量 CC/CFLAGS 对**文件级赋值不生效**（make 只有 `-e` 才让环境覆盖文件），
  因此必须在 **make 调用行**传变量（命令行赋值优先级最高）；这与 autotools 包
  「configure 期 + make 调用行双钉」是同一原则在无 configure 形态下的对应形态。

affected_scope: >-
  一切无 configure 的手写 Makefile 项目（bzip2/samhain/meschach/aa3d/psignifit 族）；
  尤其 2010 年前的单目录 C 项目。

verification_cmd: >-
  grep -nE '^\\s*(CC|LD|OUTDIR|CFLAGS|LDFLAGS)\\s*\\+?=' <src>/Makefile
  # 命中即按 rec_approach 钉；钉后核产物存在：
  test -x <outdir>/psignifit || echo "产物缺失"

rec_priority:          1
rec_approach:          pin-all-make-variables-on-call-line
rec_description: >-
  在 build() 的 make 调用行一次性钉死全部相关变量：CC/LD 取自
  `self.conf.get("tools.build:compiler_executables")`（R33，绝不读 shell 环境）；
  CFLAGS/CXXFLAGS 钉 `-O2 -pipe -DNDEBUG`；CYGFLAG/DBFLAG 置空吃掉 -g 默认值；
  LDFLAGS 补 `-lm`（编译旗标 + 链接旗标双钉，先例4）；OUTDIR 指到 source 树内
  可写目录（禁 ~/bin）。固定 -j1（R9）。
rec_command:           'make -j1 gnu CC="$CC" LD="$CC" CFLAGS="-O2 -pipe -DNDEBUG" CXXFLAGS="-O2 -pipe -DNDEBUG" CYGFLAG= DBFLAG= LDFLAGS="-lm" OUTDIR="$SRC/bin"'
rec_auto_fix:          false
rec_impl:              "archives/p/psignifit/2.5.6/conanfile.py :: build()"

fallback_priority:     2
fallback_approach:      patch-makefile-literals
fallback_description:  变量在 include 的子 Makefile 或递归 make 层被 `override` 重置、或调用行不可达（如通过 wrapper 脚本调 make）时，用包内补丁改字面量本身；改完必须 refresh-patch 两面同步并跑补丁三关（NUL=0 / @@≥1 / 真 apply 后 cmp 一致）
fallback_command:      "patch -p1 < patches/000x-pin-toolchain.patch && make -j1"
fallback_auto_fix:     false
fallback_impl:         ""

forbid_1_pattern:      "export\\s+CFLAGS|environment\\s+-e"
forbid_1_reason:       环境变量对 make 文件级赋值无效（除非 -e），export CC/CFLAGS 造成"已修复"错觉
forbid_1_consequence:  本地与 CI 结果分叉，排障绕远

forbid_2_pattern:      "make\\s+-j\\$\\(nproc\\)|-j\\$\\(shell"
forbid_2_reason:       conan 取 os.cpu_count=20 而 affinity=8（§一.7），nproc 超订
forbid_2_consequence:  内存耗尽窗口把构建打死，且失败形态像配方错误

principles:            P003
caused_by:             raw-makefile-literal-toolchain
causes:                build-entry-missing-compiler|artifact-in-home
related:               DRAFT-E713
doc_file:              "doc/E714.md"
last_updated:          "2026-09-24"
