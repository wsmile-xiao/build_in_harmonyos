# DRAFT-dynamite-0.1.1-libtool-1.5.22-echo-undefined.kv
# 草稿：libtool 1.5.22 生成脚本缺 $echo 定义与 $tool_oldlib 空引用（OHOS bash）

id:                     DRAFT-dynamite-0.1.1-libtool-1.5.22-echo-undefined
trigger_tool:           make|libtool|conan-verify
phase:                  build
error_signature:        X--tag=CC: command not found|libtool: ignoring unknown tag|ranlib.*Usage: ranlib|cannot infer operation mode from.*clang|tool_oldlib
severity:               2
category:               autotools, libtool, toolchain, conan
match_keywords:         libtool 1.5.22, $echo undefined, tool_oldlib, print -r --, bash,
                         X--tag, ranlib no argument, generated libtool, OHOS, config.status --recheck
title:                  libtool 1.5.22 生成脚本在 OHOS bash 缺 $echo / $tool_oldlib 导致 make 失败

root_cause:             2005 年 libtool 1.5.22 ltmain.sh 生成的 libtool 脚本大量使用
                        小写 $echo 变量（479 处）却从不定义；ECHO 依赖 ksh 风格
                        print -r --，而 OHOS Conan profile 用 /data/service/hnp/bin/bash
                        无 print 内建。old_archive_cmds/old_postinstall_cmds 引用
                        未赋值的 $tool_oldlib → ranlib 空参数失败。
affected_scope:         使用 2005 年代 Autotools（configure.ac.in + bootstrap、
                        AC_PROG_LIBTOOL 老宏）且构建 SHELL 为 bash 的项目

verification_cmd:       conan-verify <pkg> <ver>  G2 conan create 通过;
                        grep -c '^echo=' <build>/libtool;
                        grep -c 'tool_oldlib' <build>/libtool   # 期望 0

rec_priority:           1
rec_approach:           patch-generated-libtool
rec_description:        对生成的 libtool 加 echo='echo'、sharedlib_from_linklib_cmd=echo、
                        $tool_oldlib → $oldlib；必须在 autotools.configure() 之后、
                        make() 之前对 build/source 两棵树 os.walk 覆盖所有 libtool
                        实例并校验；同步 touch config.status/Makefile 阻止
                        --recheck 二次生成覆盖修复。
rec_command:            |
  echo='echo'           # 插到 ECHO="print -r --" 之后
  sharedlib_from_linklib_cmd="echo"
  sed 's/\$RANLIB \$tool_oldlib/\$RANLIB \$oldlib/g' -i libtool
  # 覆盖 build 树所有 libtool + touch config.status/Makefile
rec_auto_fix:           false
rec_impl:               conan-recipe-build-time-patch

forbid_1_pattern:       只改 ltmain.sh 源码
forbid_1_reason:        configure 生成 libtool 时 echo= 定义不在 ltmain.sh 主体，改源码无效
forbid_2_pattern:       修复后不 touch config.status/Makefile
forbid_2_reason:        configure 新于 config.status 触发 --recheck 二次 configure，覆盖修复

principles:             P003, P011
caused_by:
similar_to:             E236, E411, E522, E228
conflicts_with:
prerequisite_of:

doc_file:               knowledge/drafts/DRAFT-dynamite-0.1.1-libtool-1.5.22-echo-undefined.md
last_updated:           2026-09-26
source_event:           dynamite 0.1.1 (twogood/dynamite commit ccf573ad71ce) 适配

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 1
metrics_fail_count: 0
metrics_confidence: 0.8
metrics_last_used: 2026-09-26
