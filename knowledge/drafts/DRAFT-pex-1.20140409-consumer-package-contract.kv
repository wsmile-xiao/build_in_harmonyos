# DRAFT-pex-1.20140409-consumer-package-contract.kv - pex installed consumer contract
# Directly related Path B knowledge draft for PR #9365.

id: "DRAFT-pex-1.20140409-consumer-package-contract"
pr_ref: 9365
trigger_tool: "conan|test_package|pex|shebang|XDG|git"
phase: "packaging|runtime|testing|ci"
error_signature: "package.*missing|bad interpreter|XDG.*pex|init.*repository|invalid command"
severity: 2
category: "ohos|conan|consumer-test|packaging|runtime"
match_keywords: "pex, 1.20140409, test_package, MANIFEST.yml, Conan consumer, package layout, shebang, XDG_CACHE_HOME, XDG_DATA_HOME, git repository, diagnostics"
title: "pex 的 Conan 消费者契约必须与上游 TAP 套件分开复核"

root_cause: "上游 t/*.t 覆盖源码工作树行为，但不能证明 Conan 安装结果包含正确文件、可执行入口、OHOS shebang、XDG 路径和可消费的本地仓库操作；如果只报告上游 TAP，安装后的消费者契约没有证据。"

affected_scope: |
  纯 shell 或脚本型 Conan application，尤其是上游测试依赖源码目录、
  但最终消费者通过 PATH 直接调用安装文件的 OHOS 适配包。

verification_cmd: |
  /system/bin/sh test_package/test_pex.sh <package_dir> <work_dir>
  head -n 1 <package_dir>/bin/pex
  test -x <package_dir>/bin/pex
  test -f <package_dir>/share/man/man1/pex.1

rec_priority: 1
rec_approach: "separate-upstream-and-installed-consumer-evidence"
rec_description: |
  将上游 TAP 作为官方源码行为证据，将 test_package 作为安装后消费
  契约证据，两者分开计数。对 pex 的 15 项消费者断言逐项覆盖安装
  文件、可执行位、OHOS 兼容 shebang、--help、XDG cache/repository
  路径、本地 Git 仓库 init/search/cat，以及非法命令的退出码和诊断。
  在 MANIFEST.yml 中同时记录测试文件、命令、断言数和最近 CI 结果，
  不把消费者通过率冒充上游通过率。

rec_command: |
  /system/bin/sh test_package/test_pex.sh <package_dir> <work_dir>

rec_auto_fix: false
rec_impl: "test_package-test_pex-sh-plus-manifest-evidence"

fallback_priority: 2
fallback_approach: "host-shell-syntax-only"
fallback_description: |
  Windows 主机没有目标 shell 和 Conan 时，只能执行 Git Bash 语法检查
  和临时 package-layout 级脚本验证；必须把 Conan test_package 作为
  未替代的目标环境证据，并在后续 shadow CI 复核。
fallback_command: "bash -n test_package/test_pex.sh"
fallback_auto_fix: false
fallback_impl: ""

forbid_1_pattern: "把上游 TAP 通过率当作安装包可用|只检查文件存在不执行 bin/pex"
forbid_1_reason: "文件清单不能证明 PATH 入口、shebang、XDG 路径和运行时命令真的可用。"
forbid_1_consequence: "消费者可能在安装后遇到 bad interpreter、错误数据目录或不可诊断的命令失败。"

forbid_2_pattern: "test_package 通过.*上游测试全部通过|消费者断言与上游断言混为一个总数"
forbid_2_reason: "两套测试验证的生命周期不同，且上游存在可选依赖和 OHOS 权限前提边界。"
forbid_2_consequence: "审查者无法判断是源码行为、安装布局还是平台运行时导致失败。"

principles: "P004, P006, P017"
causes: []
caused_by: []
similar_to: ["E232", "E253"]
