#====================================================================
# Draft knowledge entry - jnoise 0.6.0 raw Makefile: the compiler NAME is
# written as a literal in the RECIPE COMMAND POSITION (no variable behind
# it) -> neither `make CXX=...` nor an exported CXX can reach it.
# Source package: jnoise/0.6.0  (archives/j/jnoise/0.6.0)
#====================================================================

id:                     DRAFT-jnoise-0.6.0-makefile-linkline-literal-cxx-name
draft:                  true
trigger_tool:           make
phase:                  linking
error_signature:        'make: g\+\+: No such file or directory|make: \*\*\* \[Makefile:[0-9]\+\+: all\] Error 127|Error 127|sh: g\+\+: inaccessible or not found'

severity:               2
category:               build-system|make|toolchain
match_keywords:         Makefile, raw Makefile, no configure, no CMake, link rule, recipe command position, hardcoded g++, make CXX=clang++ ineffective, exported CXX ignored, Error 127, clang-only toolchain, OHOS PC, R33, patch required, GNU make

title:                  'Compiler name written as a literal in the Makefile recipe command position: make CXX=... and env CXX are both inert - only a patch fixes it'

prescan_pattern:        '^[[:space:]]+(g\+\+|gcc|cc)[[:space:]]'
prescan_globs:          Makefile, makefile, GNUmakefile, */Makefile, source/Makefile

root_cause:             >
    jnoise 0.6.0 ships a hand-written source/Makefile whose link rule puts the
    compiler name directly in the command position, with no variable behind it:

        jnoise:   $(JNOISE_O)
            g++ $(LDFLAGS) -o $@ $(JNOISE_O) $(LDLIBS)

    The implicit compile rule does read $(CXX), so `make CXX=clang++` fixes
    compilation and the build then dies on the very last step. There is no
    `CXX := g++` assignment to shadow, therefore a make command-line variable
    and an exported CXX are BOTH inert for that recipe: make expands the text
    as written and exec's it. Controlled reproduction on the OHOS PC builder
    (GNU make + toybox sh; Makefile = `all:` / TAB `g++ -v`), run as
    `make -j1 CXX=clang++`:

        g++ -v
        make: g++: No such file or directory
        make: *** [Makefile:2: all] Error 127

    A recipe line that make execs directly reports the `make: ...` form; the
    same command driven by the shell (`sh -c "g++ --version"`) reports
    `sh: g++: inaccessible or not found` on toybox. `command -v g++` is empty
    (RC=1): OpenHarmony PC ships only clang/clang++ under /data/service/hnp/bin.
    So the only compliant fix is a patch that turns the literal into $(CXX) and
    lets the Conan profile provide the compiler (R33 forbids g++ shims).

affected_scope:         >
    Any raw-Makefile (no configure / no CMake) C or C++ project whose recipes
    exec the compiler by literal name, adapted to a clang-only toolchain.
    It does NOT apply when the Makefile keeps the compiler in a variable
    (CC := g++, LD := g++): that variant stays overridable from the make
    command line and is covered by DRAFT-cohomcalg-0.32-makefile-gxx-override.

verification_cmd:       |
  grep -nE '^[[:space:]]+(g\+\+|gcc|cc)[[:space:]]' source/Makefile
  python3 scripts/ohc-run.py conan-verify jnoise 0.6.0

rec_priority:           1
rec_approach:           patch-command-position-literal-to-cxx-var
rec_description:        >
    One portability patch rewrites the command-position literal to $(CXX)
    (g++ $(LDFLAGS) -o $@ ... becomes $(CXX) $(LDFLAGS) -o $@ ...) and, in the
    same patch, parameterises any bare install command as INSTALL ?= /bin/install.
    The recipe then resolves the compiler from tools.build:compiler_executables
    (R33) and passes it on the make command line, so profile and build agree:
    make -C source -j1 PREFIX=/ CXX=<profile clang++> jnoise.
rec_command:            |
  make -C source -j1 PREFIX=/ CXX="/data/service/hnp/bin/clang++" jnoise
rec_auto_fix:           true
rec_impl:               patch

fallback_priority:      2
fallback_approach:      prescan-all-command-position-literals-before-building
fallback_description:   >
    When a Makefile may contain several such recipes, enumerate them all with
    the prescan pattern before the first build instead of discovering one
    failing link per build cycle - each cycle costs a full compile of the
    package and lands the error at the most expensive step.
fallback_command:       >-
  grep -rnE '^[[:space:]]+(g\+\+|gcc|cc)[[:space:]]' --include='Makefile*' --include='makefile*' .
fallback_auto_fix:      false
fallback_impl:          patch

forbid_1_pattern:       'make -j1 CXX=clang++ alone, or export CXX=clang++, against a recipe that names the compiler literally'
forbid_1_reason:        'A make command-line variable only reaches rules that reference $(CXX); a recipe that execs g++ by name never reads it, so the override is silently inert.'
forbid_1_consequence:   'Compilation succeeds and the build fails at the final link with Error 127 - the most expensive place to discover the defect (one full compile per attempt).'
forbid_2_pattern:       'ln -s clang++ <dir>/g++ plus a PATH prepend (g++ shim)'
forbid_2_reason:        'R33: the compiler must come from the Conan profile tools.build:compiler_executables; a PATH shim bypasses profile auditing and the CI worker PATH is not recipe-controlled.'
forbid_2_consequence:   'Green locally, identical failure on CI, and the real compiler source is hidden from review.'

similar_to:             [DRAFT-cohomcalg-0.32-makefile-gxx-override, E174]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-jnoise-0.6.0-makefile-linkline-literal-cxx-name.md
last_updated:           2026-09-25
source_event:           jnoise/0.6.0 first OHOS adaptation - raw Makefile link rule execs g++ by name, make CXX= ineffective, fixed by portability patch
contributor_id:         主理-32
source_commit:          816c91f2243a2de5f33471f0a98ae87e678be041
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.8
