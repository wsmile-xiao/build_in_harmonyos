#====================================================================
# DRAFT-E998-draft-E047 — 无构建系统纯 C 库注入 CMakeLists.txt
# 来源: PR feat/error-detection-2.1.1（error-detection 2.1.1 适配 HarmonyOS PC）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E998
trigger_tool:           clang|cmake|conan
phase:                  configuration|compilation
error_signature:        no such file or directory: '.*\.c'|no input files|System is unknown to cmake|ConanException: \[conf\] 'tools\.build:archiver' does not exist

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, cmake, conan
match_keywords:         无构建系统, 注入 CMakeLists, save CMakeLists, CMakeToolchain, source_folder, 纯 C 库, no configure, no Makefile
title:                  无构建系统纯 C 库：source() 阶段 save() 注入最小 CMakeLists.txt，走标准 CMakeToolchain 流程（区别于手写 clang/llvm-ar 直接编译）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游仅含 .c/.h 源文件、无 configure/make/CMake 任何构建入口；init-build 按 autotools 模板生成的配方在 conan create 中失败；手写 clang 直接编译需处理 basic_layout 的 source_folder 路径，且 Conan 2.29 无 tools.build:archiver conf
affected_scope:         无任何构建系统（无 configure/make/CMake）的纯 C 源文件库
verification_cmd:       conan create . -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing（test_package 全部断言通过）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           2
rec_approach:           inject-cmakelists-at-source
rec_description:        source() 内 save() 注入最小 CMakeLists.txt（add_library + PUBLIC_HEADER + install EXPORT + cmake_target_name），generate() 用 CMakeToolchain，build() 走标准 CMake configure/build，package() 用 cmake.install()；比手写 clang/llvm-ar 更贴近 CI 常规路径、免去 basic_layout 路径坑与 archiver conf 问题
rec_command:            conan create . -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing
rec_auto_fix:           false
rec_impl:               conan-recipe-cmake-inject

fallback_priority:      1
fallback_approach:      custom-build-direct-compile-with-source-folder
fallback_description:   见 DRAFT-cobs-c-0.4-no-build-system-pure-c-conan-recipe：手写 clang -c + llvm-ar rcs 直接编译，注意 basic_layout 源文件在 source_folder、G1 需 export_sources/apply_conandata_patches 声明
fallback_command:       cd $BUILD_SRC_DIR && clang -fPIC -O2 -c err.c -o $BUILD_FOLDER/err.o && llvm-ar rcs $BUILD_FOLDER/liberror-detection.a $BUILD_FOLDER/err.o
fallback_auto_fix:      false
fallback_impl:          conan-recipe-custom-build

principles:             P004

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [DRAFT-cobs-c-0.4-no-build-system-pure-c-conan-recipe]
conflicts_with:         []
prerequisite_of:        []

