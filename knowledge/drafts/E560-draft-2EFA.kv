#====================================================================
# E560-draft-2EFA — 知识图谱条目
# Meson install 改写 .dynstr 内 DT_RUNPATH 字节使 hnp clang 产物内嵌
# .codesign 哈希失效（dlopen Permission denied / Error loading shared
# library），用 build-tree 原始产物覆盖安装副本修复
# 触发事件: coeurl 0.3.2 HarmonyOS PC 适配
#====================================================================

id: E560
trigger_tool:           meson|readelf|dlopen
phase:                  installation
error_signature:        Error loading shared library|Permission denied.*dlopen|dlopen.*Permission denied|symbol not found.*NEEDED|Error relocating

severity:               2
category:               packaging, signing, meson, ohos
match_keywords:         meson install, .codesign, dynstr, DT_RUNPATH, dlopen, Permission denied, Error loading shared library, Error relocating, readelf, destdir, soversion
title:                  Meson install rewrites DT_RUNPATH bytes inside .dynstr and invalidates the embedded .codesign hash; overwrite the installed .so with the pristine build-tree artifact

root_cause:             hnp 工具链的 ELF 产物自带链接器签名（.codesign section，
                        内嵌哈希覆盖整个文件映像）；meson install --destdir 在
                        安装副本的 .dynstr 区内原位改写 DT_RUNPATH 字符串字节
                        （不做整文件重写），文件哈希变化而 .codesign 哈希未更新，
                        本机 musl 加载器校验失败——dlopen/加载报
                        Error loading shared library 或 Permission denied。
                        与 strip 破坏签名是同族根因的不同触发面。
affected_scope:         所有经 meson install 安装的 hnp clang 产物（特别是带
                        version/soversion 的 shared library）；Conan 配方
                        package() 阶段直接消费 meson install 结果时必现
verification_cmd:       readelf -S <安装副本.so> | grep -c codesign; sha256sum <build-tree .so> <安装副本 .so> —— 两文件哈希不同且安装副本仍带 .codesign section 即确认

rec_priority:           1
rec_approach:           overwrite-installed-so-with-build-artifact
rec_description:        package() 阶段把 build 目录中的原始 .so 复制覆盖安装后的
                        .so（shutil.copy2 保持元数据）；仅覆盖 shared 变体；
                        static .a 不受影响（无 .codesign 签名，meson install 可直接用）
rec_command:            shutil.copy2(os.path.join(self.build_folder, "<lib>.so.<ver>"), os.path.join(self.package_folder, "lib", "<lib>.so.<ver>"))
rec_auto_fix:           false
rec_impl:               overwrite-installed-so-with-build-artifact

fallback_priority:      2
fallback_approach:      meson-install-skip-strip
fallback_description:   若上游 meson.build 的 install 逻辑可加 install_strip 取 false / strip 取 false 选项，先禁 strip（E077 同族）；但 dynstr 改写仍需覆盖法兜底
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       binary-sign-tool sign -selfSign.*\.so|selfSign.*codesign
forbid_1_reason:        对 hnp clang 产物重签会在本机 musl 加载器上 SIGSEGV（workflow §5.3 实测）；签名校验失败的正确修法是保持原始产物字节，不是重新签名
forbid_1_consequence:   产物在本机直接 SIGSEGV，且掩盖真实的安装层字节破坏

principles:

causes:                 []
caused_by:              []
similar_to:             [E077, E083, E295]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/E560-draft-2EFA.md
last_updated:           2026-09-09
source_event:           coeurl/0.3.2 HarmonyOS PC 适配

authors:
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
