id:                     E580
trigger_tool: cmake
phase: package
error_signature: Cflags:.*-I/storage/|Cflags:.*-I.*/\.conan2/p/|Cflags:.*-I/usr/local|pkgconfig.*构建机绝对路径

severity: 3
category: cmake, build-system, portability, ohos, conan
match_keywords: CMAKE_CROSSCOMPILING, pkgconfig 绝对路径, Cflags -I 构建机路径, 原生 OHOS 构建, relocatable pkg-config, .pc path leak
title: 上游用 IF(CMAKE_CROSSCOMPILING) 守卫构建路径剥离，原生 OHOS 构建下守卫恒假导致缓存绝对路径写入 .pc 并随制品发布

root_cause: 上游 CMakeLists 将"剥离构建机路径"的逻辑包在 IF(CMAKE_CROSSCOMPILING) 内（意图是仅在交叉编译时清理）；但 ohpcd 的 OHOS 构建是原生构建，conan toolchain 不下发 CMAKE_SYSTEM_NAME/CMAKE_SYSROOT，故 CMAKE_CROSSCOMPILING 恒为假，该分支永不执行。结果依赖的绝对 -I 路径（如 /storage/.../.conan2/p/<pkg>/p/include/...）被原样写入安装出的 .pc 的 Cflags，随制品发布，下游在别的机器上解析即失效。
affected_scope: 上游在 .pc / *Config.cmake 中用 IF(CMAKE_CROSSCOMPILING) 守卫路径剥离逻辑的 CMake/autotools 项目；native OHOS 构建下守卫失效；受影响文件 .pc / *Config.cmake
verification_cmd: grep -E "^(prefix|Cflags|includedir)" <package_folder>/lib/pkgconfig/*.pc

rec_priority: 1
rec_approach: conanfile-package-postprocess
rec_description: 在 conanfile.py 的 package() 阶段规范化安装出的 .pc：删除 Cflags 中指向构建机的绝对 -I 项，仅保留可重定位的 ${includedir}；不改上游源码（上游意图正确，只是守卫在原生构建下不成立）。
rec_command: grep -nE "^Cflags" ${PACKAGE_FOLDER}/lib/pkgconfig/*.pc
rec_auto_fix: false
rec_impl: manual

fallback_priority: 2
fallback_approach: upstream-patch
fallback_description: 若 .pc 之外还有 *Config.cmake 泄漏构建机路径，则打补丁把剥离逻辑改为无条件执行（去 IF(CMAKE_CROSSCOMPILING) 包裹），并在 PR 说明理由。
fallback_command:
fallback_auto_fix: false
fallback_impl: manual

forbid_1_pattern: ^\s*CFLAGS=.*-I/storage
forbid_1_reason: 用 shell 环境变量注入构建机路径会随制品固化，导致制品不可重定位
forbid_1_consequence: 下游 pkg-config 拿到不存在路径，CI/其他机器编译失败

principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

