#====================================================================
# E700 — 上游 CMakeLists set(CMAKE_CXX_STANDARD 11) 硬编码 + 测试代码使用
#       C++17 特性 (CTAD std::array / if 初始化语句) → clang 15 默认
#       gnu++14 + -Wall -Wextra -Wpedantic -Werror 报 -Wc++17-extensions
# 来源: caches 0.1.1 (vpetrigo/caches) 第一轮适配
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E700
trigger_tool:           clang|cmake|make
phase:                  compilation
error_signature: -Wc++17-extensions|-Werror|requires template arguments|use of class template 'std::array'|'if' initialization statements are a C\+\+17 extension

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               toolchain|cmake
match_keywords:         CMAKE_CXX_STANDARD, C++17 extension, CTAD, if initialization, Werror, Wpedantic, std::array, header-only
error_excerpt: "error: use of class template 'std::array' requires template arguments; error: 'if' initialization statements are a C++17 extension [-Werror,-Wc++17-extensions]"
prescan_pattern:        "CMAKE_CXX_STANDARD 11|CMAKE_CXX_STANDARD [0-9]+"

# ═══ Layer 2: 根因层 (Root Cause) ═══
root_cause: 上游 CMakeLists.txt 用 set(CMAKE_CXX_STANDARD 11) 硬编码 C++11，
  但测试源文件使用了 C++17 特性（CTAD：constexpr std::array access_order = {...}；
  if 初始化语句：if (const auto key = ...; cond)）。OHOS 工具链 clang 15 默认
  gnu++14，且测试目标带 -Wall -Wextra -Wpedantic -Werror，导致
  -Wc++17-extensions 升级为硬错误。上游 CI 使用现代 clang/gcc（默认 C++17）
  因此绿，问题只在默认标准 <17 的工具链（含 OHOS clang 15）暴露。
  关键机制：set(CMAKE_CXX_STANDARD 11) 写入 CMakeLists 为普通变量，会覆盖
  命令行 -DCMAKE_CXX_STANDARD=17 的 cache 变量；仅加 -DCMAKE_CXX_STANDARD
  无效，必须让 -std=c++17 出现在编译命令后段（CMAKE_CXX_FLAGS）或改 set()。

# ═══ Layer 3: 方案层 (Solution) ═══
rec_approach: ① 最简：给测试构建加 CMAKE_CXX_FLAGS=-std=c++17（位于编译命令
  后段，可压过 set(CMAKE_CXX_STANDARD 11) 生成的 -std=gnu++11）；
  ② 配方侧：conanfile generate() 或 CMakeToolchain 显式设置
  CMAKE_CXX_STANDARD=17 + CMAKE_CXX_STANDARD_REQUIRED=ON；
  ③ 若需补丁：将 CMakeLists 的 set(CMAKE_CXX_STANDARD 11) 改为 17。
  验证命令: cmake --build . -j4 && ctest（35/35 通过）
affected_scope: 所有默认标准 <17 的工具链（OHOS clang 15、gcc 9/10/11 等）下
  构建声明 C++11 但测试代码用 C++17 特性的 CMake 项目；header-only 库测试构建常见。

# ═══ Layer 4: 关联层 (Relations) ═══
similar_to:             E096|E130|E293
conflicts_with:         none
prerequisite_of:        none
caused_by:              none
last_updated:           2026-09-05
