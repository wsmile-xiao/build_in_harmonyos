#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E545.kv，填写各字段
# 对应的人类文档: doc/E545.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E545
trigger_tool: conan|pkg-config|clang
phase: configure|compilation
error_signature: json_tokener.h: No such file or directory|fatal error: json_tokener.h file not found|json-c.pc|Package json-c was not found|PKG_CHECK_MODULES

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 1
category: conan|pkg-config|dependency|compilation|ohos-platform
match_keywords: json-c, json_tokener.h, pkg-config, .pc, PKG_CONFIG_PATH, PkgConfigDeps, prefix, includedir, nested include, broken pc file, PKG_CHECK_MODULES, configure, generators_folder
title: 依赖自带 pkg-config 文件破损（prefix 指向已删除的构建目录）且头文件嵌套在子目录时：必须让 PkgConfigDeps 生成的 .pc 优先，并把嵌套 include 目录一并注入

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 制品包内自带 json-c.pc 的 prefix 指向导出时的构建目录（已被 conan 清掉），pkg-config 因此解析出并不存在的 -I/-L；而上游源码用扁平写法 include json_tokener.h，包内头文件实际位于 include/json-c/（自带 .pc 原本靠 Cflags 里的 -I<includedir>/json-c 兜住），.pc 一坏这层兜底也消失。结果 configure 的 PKG_CHECK_MODULES(JSON, json-c) 或编译期 include 直接失败，看起来像源码问题，实为依赖元数据问题。
affected_scope: 依赖包内自带 .pc/.cmake 元数据在打包后被改写或指向临时目录的所有场景；尤其上游源码使用扁平 include（不带包名前缀目录）而制品把头文件放在 <prefix>/include/<pkg>/ 的依赖。
verification_cmd: printf include-json_tokener.c | clang -x c - -I<pkg>/include -I<pkg>/include/json-c -c -o /dev/null && echo HEADERS_OK

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: prefer-generator-generated-pc-and-add-nested-include-dirs
rec_description: (1) generate() 里显式调用 PkgConfigDeps(self).generate()，并把 self.generators_folder 放在 PKG_CONFIG_PATH 最前，压过依赖包内自带的破损 .pc；(2) CPPFLAGS 除依赖 includedirs 外，补齐 <include>/<pkg> 这类嵌套目录（json-c 即 include/json-c）；(3) 验证要覆盖编译+链接两阶段，不要只看 configure 是否通过；(4) 若依赖的 .pc 确实不可用，直接在 flags 侧注入绝对 -I/-L，不依赖 pkg-config 解析。
rec_command: PKG_CONFIG_PATH=<generators_folder>:<dep_pkgconfig_dirs> conan create . -pr:h=ohos-aarch64
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

