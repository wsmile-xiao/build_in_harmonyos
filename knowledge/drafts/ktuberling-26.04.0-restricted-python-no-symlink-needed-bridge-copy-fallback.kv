#====================================================================
# Draft: ktuberling 26.04.0 - artifact-repo prebuilt KDE libs embed the
#        build machine's absolute conan cache paths; bridging them with
#        os.symlink fails with EACCES on hosts whose python3 sandbox
#        domain denies the symlink syscall (cmd-pkgs python3 on HarmonyOS
#        PC) - the fix is a copy2 fallback, and the diagnosis tool is a
#        python/ln x src/dst 2x2 matrix
#====================================================================

id:                     DRAFT-KTUBERLING-2604-RESTRICTED-PYTHON-NO-SYMLINK-NEEDED-BRIDGE-COPY-FALLBACK
trigger_tool:           conan|test_package|runtime-loader
phase:                  testing
error_signature:        os.symlink|Errno 13|Permission denied|cannot create NEEDED fallback|Error relocating|symbol not found|Error loading shared library

severity:               2
category:               ohos-platform|packaging|elf|test-harness
match_keywords:         os.symlink, EACCES, Errno 13, Permission denied, symlink, NEEDED fallback, absolute path, .cache/conan2, .conan2, symbol not found, Error relocating, cmd-pkgs python3, /data/app/bin/python3, copy2, DT_NEEDED, libKF6, KDEGames, conan home, cache layout

title:                  受限沙箱域 python3 禁 symlink 系统调用（任意路径 EACCES）——ELF 绝对路径 NEEDED 桥接必须带 copy2 兜底；诊断靠 python/ln × src/dst 2×2 矩阵

root_cause:             制品仓预编译二进制（如 libKDEGames6.so）内嵌构建机的绝对缓存路径 ~/.cache/conan2/p/<short>/p/lib/libKF6NewStuff*.so；消费端本机 conan 缓存为默认 ~/.conan2 时该路径不原生存在，test_package 的桥接逻辑（DT_NEEDED 扫描 + 建链）用 os.symlink 兜路径。鸿蒙 PC 上用 cmd-pkgs 安装的 python3 沙箱域被平台策略禁 symlink 系统调用：2×2 矩阵实证（python/ln × src∈{.conan2, /etc/hostname} × dst∈{.cache, ~/tmp}），python 侧任意组合均 [Errno 13] Permission denied，ln 二进制相同参数全部成功——限制跟随进程域而非路径。CI 端 python3 是 /data/app/bin/python3（另一域），不受限（kfourinline / kgoldrunner / libktorrent 同机制先例 CI 全绿可证）。故障链为：os.symlink EACCES → 代码仅 warning 后继续 → musl loader 重定位失败 "Error relocating ... symbol not found"，表面症状（KNSWidgets 符号缺失）与根因（syscall 权限）相距两层，极易误诊为缺库或版本不匹配。
affected_scope:         所有消费制品仓 KDE/Qt 预编译库、且 test_package 做绝对路径 NEEDED 桥接的包（ktuberling 及后续 KDE Games/KF6 消费者）；任何在鸿蒙 PC 本机以 cmd-pkgs python3 执行含 os.symlink 的桥接/准备逻辑的场景；亦适用于其他在受限域进程里建软链的 harness 代码。
verification_cmd:       python3 -c "import os,os.path; os.symlink('/etc/hostname', os.path.expanduser('~/tmp/symlink-probe'))" （EACCES=受限域，ln 同参数成功即坐实进程域限制）&& CI_REPO_ROOT="$PWD" CI_PACKAGES="archives/k/ktuberling/26.04.0" CI_BRANCH="feat/ktuberling-26.04.0" CI_PR_NUMBER="11760" zsh ci/conan/build_and_test.sh （修复后 rc=0，"created N absolute-NEEDED compatibility links"）

rec_priority:           1
rec_approach:           symlink-try-copy2-fallback-and-diagnose-with-2x2-matrix
rec_description:        桥接逻辑必须 try os.symlink / except OSError → shutil.copy2 兜底：实文件拷贝对 loader 语义等价、不依赖 symlink 权限，与文件内相对路径桥接 _prepare_runtime_links 既有兜底同款；CI 端 python 可 symlink 故兜底不触发、行为不变。诊断口诀：先跑 2×2 矩阵（python/ln × 任意 src/dst）区分"进程域限制"与"路径策略"——ln 成功而 python 同参数失败即进程域问题，不要在路径权限/HMDFS 上空耗。另注意表象差异的另一来源是缓存布局：CONAN_HOME=~/.cache/conan2 时内嵌路径原生存在（os.path.exists 短路，完全不走建链分支），默认 ~/.conan2 时才走建链；9 月 21 日本地绿跑与次日红跑的差异即源于此，CI worker 端（默认 ~/.conan2）始终走建链分支且其 python 不受限。
rec_command:            python3 -c "import shutil,os; src=os.path.expanduser('~/.conan2/p/knews8e3b6e11174be/p/lib/libKF6NewStuffWidgets.so'); dst=os.path.expanduser('~/.cache/conan2/p/knews8e3b6e11174be/p/lib/libKF6NewStuffWidgets.so'); os.makedirs(os.path.dirname(dst),exist_ok=True); shutil.copy2(src,dst); print('OK')" && CI_REPO_ROOT="$PWD" CI_PACKAGES="archives/k/ktuberling/26.04.0" CI_BRANCH="feat/ktuberling-26.04.0" CI_PR_NUMBER="11760" zsh ci/conan/build_and_test.sh
rec_auto_fix:           false

# ═══ 知识协作 (Authorship & Provenance) ═══
source_pr:              11760
source_commit:          b1b63ca82
