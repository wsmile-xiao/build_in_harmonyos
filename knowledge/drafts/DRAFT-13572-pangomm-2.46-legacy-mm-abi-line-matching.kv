#====================================================================
# DRAFT-13572-pangomm-2.46-legacy-mm-abi-line-matching
#   GNOME C++ 绑定家族双 ABI 线的识别与依赖版本匹配（版本号高 ≠ 新 ABI）
# 来源: PR feat(pangomm-2.46): 2.46.5 适配 HarmonyOS PC（任务 13572）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-13572-pangomm-2.46-legacy-mm-abi-line-matching
trigger_tool:           conan|meson|pkg-config
phase:                  planning|dependency-resolution|build
error_signature:        dependency.*not found|
                         pkg-config.*<旧abi名>.*not found|
                         meson.*Dependency.*glibmm-2\.4.*found: NO|
                         requires.*>= 2\.48\.0.*but.*2\.68.*is.*incompatible|
                         同族包版本号越新反而 configure 失败

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               1
category:               dependency-resolution, abi-line, gnome-mm, meson
match_keywords:         pangomm, glibmm, cairomm, gtkmm, atkmm, mm-common,
                        ABI line, api_version, pcname, pkg-config name,
                        MM_INIT_MODULE, pangomm-1.4, pangomm-2.48, glibmm-2.4,
                        glibmm-2.68, cairomm-1.0, cairomm-1.16, legacy ABI
title:                  GNOME C++ 绑定家族（glibmm/cairomm/pangomm/gtkmm）按上游 pc 名（ABI 线）反向匹配依赖版本，禁止按「同族最新版」选依赖
prescan_pattern:        (pangomm|glibmm|cairomm|gtkmm|atkmm)
prescan_globs:          archives/p/pangomm*/**, archives/g/glibmm/**,
                        archives/c/cairomm/**, archives/g/gtkmm/**

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             GNOME C++ 绑定家族（gtkmm 生态：glibmm/cairomm/pangomm/
                        atkmm/gtkmm）从 2022 年前后开始双 ABI 线并行发布，
                        每族分「旧 ABI 线」与「新 ABI 线」，两线可平行安装、
                        互不兼容，且**旧线至今仍在发维护版**：
                        - pangomm：旧线 pangomm-1.4（版本号 2.46.x 封顶），
                          新线 pangomm-2.48/2.50/2.56（版本号 2.48+）；
                        - glibmm：旧线 glibmm-2.4（版本号 2.66.x，configure.ac
                          MM_INIT_MODULE([glibmm-2.4]) 生成 glibmm-2.4.pc），
                          新线 glibmm-2.68（版本号 2.68+）；
                        - cairomm：旧线 cairomm-1.0（版本号 1.14.x），
                          新线 cairomm-1.16（版本号 1.16+）。
                        陷阱点：**版本号的高低与 ABI 线的新旧没有一一对应**。
                        glibmm 2.66.9（2022 年版本号）是旧 ABI 线的最后维护版；
                        而 pangomm 2.46.5 2026-06-25 还在发（NEWS 维护记录），
                        它依赖的是旧线 glibmm-2.4 >= 2.48.0。若按「同族选最新
                        已适配版本」的惯性拿 glibmm/2.68.2（生成 glibmm-2.68.pc），
                        meson 的 dependency('glibmm-2.4') 直接 configure 失败——
                        这与「任务 13756 同款 MR 两次 CI 挂掉」的现象吻合。
                        正确判定三件套（tarball 内实测）：
                        ① configure.ac 的 MM_INIT_MODULE([glibmm-2.4]) /
                           MM_INIT_MODULE([giomm-2.4])（pc 名真身）；
                        ② meson.build 的 <pkg>_api_version / <pkg>_pcname
                           （pangomm 2.46.5: pangomm_api_version='1.4'，
                           pcname=pangomm-1.4）；
                        ③ NEWS 看版本系列归属（2.46.5 标注 legacy 维护）。
                        再按 dependency('X') 里 X 的**精确字符串**（pc 名）
                        去 repo 的 archives/ 反查哪个版本生成同名 .pc。

affected_scope:         仓内已适配的 glibmm（2.66.7/2.66.7.1/2.66.9 旧线、
                        2.68.2 新线）、cairomm（1.14.5/1.14.5.1 旧线、1.16.2/
                        1.18.0 新线）、pangomm（2.50.1/2.56.2 新线）全部双向
                        可用；本任务 pangomm-2.46 2.46.5 首次补上旧线末代。跨库
                        适用：gtkmm-2.4/gtkmm-3.0（旧线栈 glibmm-2.4+cairomm-1.0+
                        pangomm-1.4）vs gtkmm-4.0（新线栈）。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           match-deps-by-pcname-not-version
rec_description:        【第一步 读上游 tarball 定 ABI 线】下载任务版本的 tarball，
                        三处取证（configure.ac 的 MM_INIT_MODULE、meson.build 的
                        *_api_version/*_pcname、NEWS 的系列标注），确定本包的
                        pc 名与各依赖的 pc 名需求。
                        【第二步 反查 repo】对每个 dependency('<pc名>') 需求，
                        在 archives/ 家族目录找「生成同名 .pc」的版本：
                        - 需求 glibmm-2.4 >= 2.48.0 → repo 的 glibmm/2.66.9
                          （configure.ac MM_INIT_MODULE([glibmm-2.4])，包组件名
                          pkg_config_name 即 glibmm-2.4；版本 2.66.9 >= 2.48.0
                          且同一 pc 名 → 满足）；
                        - 需求 cairomm-1.0 >= 1.2.2 → cairomm/1.14.5.1
                          （pkg_config_name cairomm-1.0，ABI 系列 <=1.14.z）；
                        - 需求 pangocairo >= 1.45.1 → pango/1.56.4（版本达标）。
                        查配方 package_info 的 pkg_config_name 与依赖方的
                        dependency() 字符串是否**逐字节一致**。
                        【第三步 对齐后照家族模板】repo 内已有同族新线模板
                        （pangomm/2.50.1）时，模板机制照搬、只换 ABI 标识：
                        包名（按任务卡 pangomm-2.46）、pc 名（pangomm-1.4）、
                        头文件布局（include/pangomm-1.4 + lib/pangomm-1.4/
                        include）、链接名（-lpangomm-1.4 -lcairomm-1.0
                        -lglibmm-2.4 -lsigc-2.0）、gmmprocdir 变量值
                        （${libdir}/glibmm-2.4/proc）、extra_defs 工具库名
                        （glibmm_generate_extra_defs-2.4）。
                        【第四步 版本冲突对齐】旧线栈的精确钉版冲突：glibmm/
                        2.66.9 钉 libsigc/2.10.8、cairomm/1.14.5.1 钉
                        libsigc/2.12.1 → 配方 override=True 统一到 2.12.1
                        （sigc++-2.0 在 2.x 内 SONAME libsigc-2.0.so.0 不变，
                        ABI 稳定）；fontconfig 同款 override 见家族模板。
rec_command:            # ① ABI 取证
                        tar xJf pangomm-2.46.5.tar.xz pangomm-2.46.5/configure.ac
                        grep -n MM_INIT_MODULE glibmm-*/configure.ac   # → glibmm-2.4
                        grep -n "api_version\|pcname" pangomm-*/meson.build
                        # ② repo 反查（pc 名逐字节比对）
                        grep -rn "pkg_config_name" archives/g/glibmm/*/conanfile.py
                        grep -rn "pkg_config_name" archives/c/cairomm/*/conanfile.py
rec_auto_fix:           false
rec_impl:               recipe-requires-pcname-match

fallback_priority:      2
fallback_approach:      adapt-missing-abi-line-package-first
fallback_description:   若所需 pc 名在 repo 全家族版本中都不存在（例如未来出现
                        依赖 glibmm-2.66.pc 中间线的包），先适配提供该 pc 名的
                        依赖版本（或与官方核对是否有等价版本），再回来做本包；
                        不要试图用 sed 改上游 meson.build 硬换 pc 名——ABI 线
                        不兼容是符号表层面的，改名救不了链接。
fallback_command:       —
fallback_auto_fix:      false
fallback_impl:          human-clarification

# ★ 禁止策略 ★
forbid_1_pattern:       同族.*最新版本.*所以.*依赖最新|2\.68.*>=.*2\.48.*所以.*可用
forbid_1_reason:         版本号比较（2.68.2 >= 2.48.0）成立 ≠ pc 名匹配：glibmm
                        2.68.2 生成 glibmm-2.68.pc，dependency('glibmm-2.4')
                        根本找不到它。ABI 线判定必须按 pc 名，禁止按版本号大小
forbid_1_consequence:   meson configure 失败（CI 挂），或更糟：版本检查侥幸通过
                        但符号不兼容 → 链接期满屏 undefined reference
forbid_2_pattern:       sed.*meson.build.*glibmm-2\.4.*→.*2\.68
forbid_2_reason:         改 pc 名不能改变 ABI：pangomm 2.46 源码调用的是旧 ABI
                        API/符号，链接新 ABI 库必然 undefined reference；且改
                        上游源码违反无 patch 原则（R?；能不改上游就不改）
forbid_2_consequence:   链接失败 + 配方 patch 包袱，审查 rule 挂掉
forbid_3_pattern:       只看.*manifest.yaml.*abi_series.*不读.*configure.ac
forbid_3_reason:         仓内 manifest 的 abi_series（如 cairomm-1.0 <= 1.14.z）
                        是摘要，版本边界可能滞后；判定以 tarball 内
                        configure.ac/meson.build 实读为准（本任务即由
                        MM_INIT_MODULE([glibmm-2.4]) 实锤）
forbid_3_consequence:   依赖版本选错方向，全线返工

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P006

# ═══ 关系图 (Relations) ═══
similar_to:             DRAFT-13572-pangomm-2.46-meson-pkgconfigdeps-gap-trio
                        （同一任务的配方侧补齐，ABI 选对之后的下游坑）
caused_by:
conflicts_with:
prerequisite_of:

# ═══ 元数据 ═══
verification_cmd:       tar xJf <pkg>-<ver>.tar.xz && \
                        grep -n "MM_INIT_MODULE\|api_version" \
                          <pkg>-<ver>/configure.ac <pkg>-<ver>/meson.build
doc_file:               knowledge/drafts/DRAFT-13572-pangomm-2.46-legacy-mm-abi-line-matching.md
last_updated:           2026-09-27
source_event:           任务 13572 pangomm-2.46 2.46.5 适配：
                        meson.build pangomm_api_version='1.4'（pc pangomm-1.4），
                        依赖 glibmm-2.4 >= 2.48.0 / cairomm-1.0 >= 1.2.2 /
                        pangocairo >= 1.45.1；repo 侧 glibmm/2.66.9 即旧线
                        （MM_INIT_MODULE([glibmm-2.4])），cairomm/1.14.5.1 即
                        cairomm-1.0 线；任务 13756 同款 MR 两次 CI 挂与误选
                        glibmm/2.68.2 的现象吻合
authors:                LIMInGZE666
