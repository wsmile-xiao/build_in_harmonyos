#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E11574.kv，填写各字段
# 对应的人类文档: doc/E11574.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E11574
trigger_tool:           test|runtime|python
phase:                  testing|runtime
error_signature: TimeoutExpired.*timed out after|finite timer.*stdin|background.*fgetc.*exit

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               libc, posix, threading, testing, portability
match_keywords:         stdin, fgetc, EOF, descriptor read, finite timer, input watcher, stdio lock, process exit
title: 有限生命周期程序的后台 stdin 读取：区分 EOF 忙循环与 stdio 锁阻塞退出

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 后台键盘监视线程把 stdin 流读取与有限生命周期进程的退出耦合；EOF 未处理会继续循环，保持输入打开时阻塞的 fgetc 则可能占有 stdio 流锁。仅用关闭输入的测试不能证明正常退出边界。
affected_scope: POSIX 命令行工具同时具有后台 stdin 键盘监视与由定时器或工作线程自主结束的任务；不适用于混合 stdio/descriptor 读取同一输入的实现。
verification_cmd: conan create <recipe> -pr:h=<native-profile> -pr:b=<native-profile> --build=<package>/*; 分别验证关闭 stdin 与保持 stdin 打开时有限命令自然退出且没有发送退出键或信号。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           descriptor-input-watcher-with-independent-eof
rec_description: 单一输入所有者以 read(STDIN_FILENO,&byte,1) 读取按键，EINTR 重试，EOF/真实输入错误只结束监视线程，不冒充有限任务完成；保持计时任务自己的回调与退出码。
rec_command:            使用 read 的 ssize_t 返回值判断 0/负值；不要把 EOF 分支接到成功退出回调。
rec_auto_fix:           false
rec_impl:               source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      event-loop-owned-input
fallback_description: 需要多路输入、取消或复杂生命周期时，由主事件循环管理输入源与终止，完整验证取消和 EOF 状态。
fallback_command:      根据实际事件框架实现；不能只增大 timeout。
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       timeout.*increase|stdin.*quit key.*success|EOF.*quitloop
forbid_1_reason:        超时扩大、主动发送退出键、在 EOF 直接判成功都无法证明原本的有限任务自然完成。
forbid_1_consequence:   测试假通过或掩盖退出阻塞。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
