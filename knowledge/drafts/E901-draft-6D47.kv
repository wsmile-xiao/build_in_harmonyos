#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E901.kv，填写各字段
# 对应的人类文档: doc/E901.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E901
trigger_tool: make
phase: linking
error_signature: Error relocating.*__vsprintf_chk: symbol not found|Error relocating.*__strcat_chk: symbol not found|Error relocating.*__strlen_chk: symbol not found|undefined symbol: __vsprintf_chk

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: toolchain
match_keywords: FORTIFY_SOURCE, vsprintf_chk, strcat_chk, strlen_chk, Error relocating, musl, symbol not found, stack-protector-strong
title:                musl 系平台（含 OHOS）上 -D_FORTIFY_SOURCE 使二进制装载期 __*_chk symbol not found

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游 Makefile 硬写 -D_FORTIFY_SOURCE=2。OHOS 的 libc 是 musl 系，nm -D 实测 musl 仅导出 __stack_chk，不提供 glibc 专有的 fortify 变体 __vsprintf_chk/__strcat_chk/__strlen_chk。clang 仍按 glibc 语义把 sprintf/strcat/strlen 重定向到 __*_chk，产物因此引用 OHOS libc 不存在的符号。编译/链接/打包全绿，程序却在装载阶段失败。影响所有上游硬写 -D_FORTIFY_SOURCE 的 C/C++ 项目（musl 系目标，含 OHOS）。
affected_scope: 所有上游硬写 -D_FORTIFY_SOURCE=1/2/3 的 C/C++ 项目（musl 系目标平台，含 OHOS）
verification_cmd: nm -D --undefined-only <bin> | grep -i _chk

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 在【追加型】CFLAGS 变量里用 -U_FORTIFY_SOURCE 抵消上游宏（必须排在 -D_FORTIFY_SOURCE 之后才生效），并用 -fstack-protector-strong 保留栈保护加固；不要为迁就门禁改上游源码逻辑。
rec_description: 追加 -U_FORTIFY_SOURCE 抵消 glibc 专有 fortify 符号，保留栈保护
rec_command: EXTRA_CFLAGS='-U_FORTIFY_SOURCE -fstack-protector-strong'
rec_auto_fix: true
rec_impl: compiler-flag

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

