{
  "library_name": "mysql-connector-c",
  "upstream_version": "26.7.0",
  "upstream_repo": "https://github.com/mysql/mysql-connector-cpp",
  "upstream_tag": "26.7.0",
  "license": "GPL-2.0 + Universal FOSS Exception 1.0",
  "adaptation_path": "B",
  "knowledge_base": "知识库扩展 Issue #2559",
  "adaptation_patches": [
    {
      "id": "0001",
      "path": "patches/0001-ohos-disable-glibc-resolver-api.patch",
      "target_file": "cdk/foundation/socket_detail.cc",
      "problem": "上游使用 glibc resolver API（res_ninit / res_nsearch / res_nclose），在 OpenHarmony/musl 环境下不可用",
      "fix": "在 OHOS 平台条件裁剪 SRV resolver 路径，SRV lookup 返回空结果，普通 MySQL X Protocol 连接逻辑保持不变",
      "known_limitation": "OpenHarmony 下暂不支持基于 DNS SRV 的服务发现"
    },
    {
      "id": "0002",
      "path": "patches/0002-ohos-support-conan-gtest-imported-targets.patch",
      "target_file": "cdk/cmake/gtest.cmake",
      "problem": "Conan 2.x / CMake find_package(GTest) 返回的 GTEST_LIBRARIES 可能为 GTest::gtest target name，上游旧逻辑直接将其作为 IMPORTED_LOCATION 使用，导致 legacy gtest imported target 无法正确定位实际静态库；同时现代 GTest::gtest / GTest::gtest_main target 的 INTERFACE_INCLUDE_DIRECTORIES 无法传递给上游 legacy target",
      "fix": "区分文件路径与 imported target 模式，定位 Conan GTest package 安装前缀下的 libgtest.a / libgtest_main.a；将 GTest::gtest 与 GTest::gtest_main 的 INTERFACE_INCLUDE_DIRECTORIES 传递给 legacy gtest / gtest_main target",
      "known_limitation": "无"
    }
  ],
  "core_issues": [
    {
      "id": "issue-1",
      "title": "glibc resolver API 在 OpenHarmony/musl 下不可用",
      "summary": "上游 cdk/foundation/socket_detail.cc 使用 res_ninit / res_nsearch / res_nclose 等 glibc resolver API，在 musl 环境无等价实现",
      "solution": "不要通过伪造 glibc 符号方式强行通过编译；保留非 OHOS 平台原始 resolver 行为，OHOS 下禁用 SRV resolver 查询路径，SRV lookup 返回空结果，并明确记录功能限制",
      "patch_ref": "0001-ohos-disable-glibc-resolver-api.patch"
    },
    {
      "id": "issue-2",
      "title": "Conan 2.x GTest imported target 与旧 CMake 集成方式不兼容",
      "summary": "旧项目 CMake 假设 GTEST_LIBRARIES 返回实际库文件路径（如 /xxx/lib/libgtest.a），而现代 CMake + Conan 2.x find_package(GTest) 返回 GTest::gtest imported target；继续使用 list(GET GTEST_LIBRARIES 0 ...) + IMPORTED_LOCATION 会错误地将 target name 当作文件路径",
      "solution": "Step1 区分文件路径与 imported target；Step2 将 GTest::gtest / GTest::gtest_main 的 INTERFACE_INCLUDE_DIRECTORIES 传递给 legacy imported target；Step3 优先修改 test framework integration / build-system bridge / imported target compatibility，不修改单个 TEST / TEST_F 源码",
      "patch_ref": "0002-ohos-support-conan-gtest-imported-targets.patch"
    }
  ],
