#====================================================================
# Draft knowledge entry - eigen make jobserver mkfifo non-fatal signal
# Source package: eigen/3.4.1
#====================================================================

id:                     DRAFT-eigen-3.4.1-make-jobserver-mkfifo-nonfatal
trigger_tool:           make|cmake|shadow-ci
phase:                  build|test-package
error_signature:        make: jobserver mkfifo: .*Operation not permitted|jobserver mkfifo

severity:               3
category:               build-tool|filesystem|parallelism|triage
match_keywords:         eigen, make, jobserver, mkfifo, Operation not permitted, CMake test_package, non-fatal warning, OHOS
title:                  make jobserver mkfifo can be non-fatal for tiny eigen CMake consumer builds

root_cause:             The OHOS user filesystem may reject the FIFO used by make jobserver coordination.
                        In the eigen test_package run, make continued without that coordination and the
                        requested target still built and executed.
affected_scope:         Small CMake consumer builds on OHOS shadow CI where make emits jobserver mkfifo
                        warnings but the build target and runtime test complete successfully.
verification_cmd:       CI_PACKAGES="archives/e/eigen/3.4.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           classify-by-exit-and-runtime
rec_description:        Treat jobserver mkfifo as non-fatal only after confirming the build exits zero,
                        the requested binary exists, and the target runtime test passes.
rec_command:            cmake --build . --target test_eigen
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      serialized-build
fallback_description:   If the warning correlates with build failure or hang, serialize make/CMake build
                        parallelism instead of patching unrelated package sources.
fallback_command:       cmake --build . --parallel 1
fallback_auto_fix:      false
fallback_impl:          build-option

forbid_1_pattern:       jobserver mkfifo.*source patch|mkfifo.*patch package
forbid_1_reason:        The warning is usually a build environment parallelism issue, not a package source bug.
forbid_1_consequence:   Unnecessary source patches hide the real CI environment behavior and add maintenance cost.

similar_to:             [E292]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-eigen-3.4.1-make-jobserver-mkfifo-nonfatal.md
last_updated:           2026-08-28
source_event:           eigen/3.4.1 shadow CI r2 passed despite make jobserver mkfifo warning

authors:                codex <codex@noreply.local>
source_pr:
source_commit:          48f48aced7

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.75
metrics_last_used:      2026-08-28

draft:                  true
