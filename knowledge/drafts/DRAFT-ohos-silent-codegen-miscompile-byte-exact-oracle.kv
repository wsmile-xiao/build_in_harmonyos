#====================================================================
# DRAFT knowledge entry — silent codegen miscompile under -O2
#====================================================================
id:                     DRAFT-ohos-silent-codegen-miscompile-byte-exact-oracle
software:               uasm
version:                2.57
trigger_tool:           clang
phase:                  compilation
error_signature:        c4 e2 59 8c f0 00|c4 e2 69 45 d6 00|-O2.*(VEX|EVEX)|optimized build emits wrong machine code
severity:               2
category:               testing, compiler, toolchain
match_keywords:         -O2, miscompile, codegen, VEX, EVEX, encoding, strict-aliasing,
                        byte-exact, regression oracle, silent wrong output,
                        aarch64, assembler backend
title:                  优化构建会静默改变后端机器码（VEX/EVEX 编码错误）；须靠字节级上游对照发现
root_cause:             codegenv2.c 中的类型双关/共用体别名等在 aarch64 clang23 -O2 下被优化器
                        按 UB 处理，生成错误的 VEX/EVEX 编码；编译器不报错、单独跑传统指令正常，
                        因此“能编译 + 部分用例通过”会掩盖错误，只有与上游期望字节逐一比对才暴露。
affected_scope:         汇编器/编译器/JIT/编解码器等以“输出机器码或编码字节”为产物的工具，
                        在开启优化的构建下发生静默错误；传统 x86 路径可能不受影响。
verification_cmd:       printf '    .x64\\n    .model flat\\n    .code\\n    vpmaskmovd xmm6,xmm4,OWORD PTR [rcx]\\nend\\n' > v.asm;
                        uasm -q -bin v.asm && od -An -tx1 -N5 v.BIN
                        # -O2 构建 => c4 e2 59 8c f0（错）；-O0 构建 => c4 e2 59 8c 31（对）
rec_priority:           1
rec_approach:           byte-exact-upstream-oracle
rec_description:        以定向上游“期望产物”做逐字节 oracle，对后端/编码类工具在 aarch64 上先用 -O0
rec_command:            make CFLAGS="-O0 ..."; <runner> <bin> <upstream-exp-dir> ; cmp each output
rec_auto_fix:           false
rec_impl:               upstream-expected-artifacts-cmp
fallback_priority:      2
fallback_approach:      locate-ub-and-fix
fallback_description:   定位触发误编译的 UB（别名/类型双关）并加 -fno-strict-aliasing 或修正源码
fallback_command:       clang CFLAGS="-O2 -fno-strict-aliasing"   # 实测对 uasm CodeGenV2 不足
fallback_auto_fix:      false
fallback_impl:          source-level-ub-fix
forbid_1_pattern:       (-O2|-O3).*(&&|;).*(pass|green|发布)
forbid_1_reason:        仅凭“能编译 + 部分测试通过”在优化构建下发版，会漏掉静默编码错误
forbid_1_consequence:   交付物生成错误机器码，下游消费者才炸，且难以回溯
forbid_2_pattern:       自写.*(近似|简化).*(测试|oracle).*替代上游
forbid_2_reason:        简化 oracle 无法覆盖后端编码的完整指令矩阵，掩盖 -O2 差异
forbid_2_consequence:   假绿；上游真实期望仍不符
principles:             []
causes:                 []
caused_by:              []
similar_to:             DRAFT-clang-o2-unobservable-alloc
conflicts_with:         []
prerequisite_of:        []
