#====================================================================
# DRAFT-icecream-cpp-1.0.0-libc-nullptr-format - OHOS libc 对 printf %p
# 空指针输出 "0"（glibc 为 "(nil)"），上游测试断言需按平台最小适配
#
# 场景: icecream-cpp 1.0.0 (renatoGarcia/icecream-cpp) 在 OHOS PC aarch64
#       (clang15 + libc++ + OHOS/musl 系 libc) 上跑官方上游测试:
#       test_c++11.cpp:789/805 REQUIRE(str == "ic| v0: (nil)\n") 失败
#       (实际输出 "ic| v0: 0\n")；test_clang.cpp:46 正则 \\(nil\\) 匹配失败。
#       根因是 OHOS libc 的 %p 空指针输出与 glibc 不同, 与库逻辑无关。
# 适用: 所有在 libc++ + musl 系 libc 平台上运行、断言 %p 空指针输出
#       为 glibc 风格 "(nil)" 的上游测试。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-icecream-cpp-1.0.0-libc-nullptr-format
source_lib:             icecream-cpp 1.0.0
trigger_tool:           clang++|ctest|conan create
phase:                  test
error_signature:        REQUIRE\( str == "ic\| v0: \(nil\)\\n" \).*FAILED|with expansion:.*"ic\| v0: 0|\(nil\)\\\]\\\}\\n"|Matches\(result\)

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               compat|libc|testing|test-expectation
match_keywords:         (nil), %p, nullptr, printf, glibc, musl, libc++, test assertion, Catch::Matches, REQUIRE, OHOS libc, null pointer, pointer format
title:                  OHOS/musl 系 libc 的 %p 空指针输出为 "0"（glibc 为 "(nil)"）：上游测试断言按平台最小适配

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  printf("%p", nullptr) 的输出是平台 libc 行为：glibc 输出 "(nil)"，
  OHOS/musl 系 libc 输出 "0"。上游测试在 libc++ 分支（!__APPLE__ &&
  _LIBCPP_VERSION）硬编码 glibc 的 "(nil)"，在 OHOS（libc++ + musl 系 libc）
  上必然失败；同一测试在 glibc 平台不受影响。库逻辑本身无缺陷。
affected_scope:         libc++ + musl 系 libc（OHOS/HarmonyOS 等）平台上断言 %p 空指针输出格式的上游测试
verification_cmd:       clang++ -std=c++11 -I <src> -I <catch2-inc> tests/test_c++11.cpp && ./test_c++11

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           platform-libc-test-assertion-adaptation
rec_description: >
  (1) 保持测试结构与断言强度，仅将 libc++ 分支的精确串断言改为
      Catch::Matches("(\\(nil\\)|0x0|0)")（或等价），同时兼容 glibc "(nil)"
      与 OHOS "0"/"0x0"；(2) 补丁标记 platform_only=true，并在 notes.md/
      PR「上游测试用例修改说明」如实记录；(3) 不改库逻辑、不禁用/排除测试。
rec_command:            >
  clang++ -std=c++11 -O1 -I <src> -I <catch2> -o test_c++11 tests/test_c++11.cpp && ./test_c++11
rec_auto_fix:           false
rec_impl:               test-edit|patch-generate

# 回退方案
fallback_priority:      2
fallback_approach:      document-only
fallback_description:   若不允许修改上游测试，则台账如实记录失败用例（原因/首错/命令/退出码/恢复条件），
                        通过率按全量口径计算（失败计入分母）
fallback_auto_fix:      false
fallback_impl:          ledger-only

# ═══ Layer 4: 证据层 (Evidence) ═══
evidence: >
  icecream-cpp 1.0.0: patches/0001-tests-test_c++11.cpp.patch（2 处）、
  patches/0002-tests-test_clang.cpp.patch（1 处）；适配后 test_c++11
  115/115 assertions（16 test cases）与 test_clang 4/4 assertions 全过，
  日志 任务日志目录（$TMPDIR/icecream-cpp-r01-logs/upstream-test-c++11-c++11.adapted.log、
  upstream-test-clang-c++17.adapted.log）（SHA-256 见任务最终报告）；
  最小探针 printf("%p", (void*)0) 在 OHOS 输出 "0"（本机实测）。

# 查重结论 (Path B 必需)
dedup_conclusion: >
  index.tsv grep nil/%p/printf 仅命中 musl 兼容类 E020/E026/E029/E032/
  E033/E039/E078（编译/链接/运行时崩溃场景，非输出格式断言差异）；engine
  命中 E040（man-db NULL 解引用，场景不同）；drafts 中 ghc-filesystem
  草稿含 nil 但为 filesystem 权限语义，正交。未命中 → 新建本条草稿。
related_entries:        E020, E026, E040
