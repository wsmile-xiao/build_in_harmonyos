#====================================================================
# E563-draft-CF74 — 知识图谱条目
# ohpcd 发行 libcurl 为无 TLS 后端变体：上游 TLS 测试/https 运行时
# 返回 CURLE_UNSUPPORTED_PROTOCOL；测试专用 TLS curl 按私有 prefix
# 自建（CMake + 设备 OpenSSL），仅测试用不进包依赖链
# 触发事件: coeurl 0.3.2 HarmonyOS PC 适配
#====================================================================

id: E563
trigger_tool:           curl|meson|conan
phase:                  testing
error_signature:        CURLE_UNSUPPORTED_PROTOCOL|error_code\(\) == 1|with_openssl|SSL.*symbol not found|https.*response_code\(\) == 0

severity:               2
category:               network, conan, ohos, testing
match_keywords:         libcurl, TLS, OpenSSL, CURLE_UNSUPPORTED_PROTOCOL, with_openssl, curl-config, pkg-config, test prefix, harmonybrew, https, doctest
title:                  ohpcd libcurl ships a TLS-less variant (https -> CURLE_UNSUPPORTED_PROTOCOL); build a test-only TLS curl into a private prefix from source + device OpenSSL

root_cause:             ohpcd 发行 libcurl/8.5.0 的 .so 无任何 TLS 后端：
                        strings 无 OpenSSL 版本串、nm -D 无 SSL_* 符号、
                        DT_NEEDED 仅 libc.so；https 传输在运行时直接返回
                        CURLE_UNSUPPORTED_PROTOCOL(1)。该变体的 options 未
                        暴露 with_openssl 开关（-o "libcurl/*:with_openssl=True"
                        解析到同一 package_id），remote 仅此一个 binary。
                        设备系统 curl 静态链接自带 TLS，但无共享 libcurl/
                        头文件可复用——上游 TLS 测试因此 16/17 失败。
affected_scope:         任何链接 conan libcurl 并使用 https 的包（运行时）与
                        上游 TLS 测试套件（原生测试阶段）；不影响纯 http 场景
verification_cmd:       strings <conan curl p>/lib/libcurl.so | grep -c 'OpenSSL/[0-9]'; readelf -d <同上> | grep NEEDED —— 均 0/仅 libc 即确认无 TLS 变体；运行时 LD_LIBRARY_PATH=<curl lib> curl 形消费者 https 返回 CURLE_UNSUPPORTED_PROTOCOL(1)

rec_priority:           1
rec_approach:           test-only-curl-private-prefix
rec_description:        按 workflow §7.3「测试依赖自建私有 prefix」路径：下载与
                        发行版本一致的 curl 源码（核对官方 SHA-256），CMake 配置
                        -DCURL_USE_OPENSSL=ON -DOPENSSL_ROOT_DIR=<设备
                        harmonybrew OpenSSL>，加 -DHAVE_LINUX_TCP_H=OFF 绕开
                        OHOS musl/内核头冲突（E091/E119 同根因），构建安装到
                        任务私有 prefix（$TASK_DIR/test-prefix），PKG_CONFIG_PATH
                        前置该 prefix 的 pkgconfig。仅测试用、不进包依赖链，
                        不把测试库发布为包依赖。
rec_command:            cmake -S . -B build-cmake -G Ninja -DCMAKE_INSTALL_PREFIX=$TASK_DIR/test-prefix -DBUILD_CURL_EXE=OFF -DBUILD_TESTING=OFF -DCURL_USE_OPENSSL=ON -DOPENSSL_ROOT_DIR=$HOME/.harmonybrew -DHAVE_LINUX_TCP_H=OFF -DCURL_USE_LIBPSL=OFF -DUSE_LIBIDN2=OFF -DUSE_NGHTTP2=OFF -DCURL_ZLIB=OFF && ninja -C build-cmake -j1 && cmake --install build-cmake
rec_auto_fix:           false
rec_impl:               test-only-curl-private-prefix

fallback_priority:      2
fallback_approach:      promote-tls-curl-variant
fallback_description:   长期方案：推动 ohpcd 发布带 TLS 后端的 libcurl 变体（recipe 暴露 with_openssl 选项并按选项区分 package_id）；在其发布前本模式是唯一可行路径
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       PKG_CONFIG_PATH=.*lib/pkgconfig.*curl-config|curl-config --libs
forbid_1_reason:        发行 curl 包自带 curl-config 的 prefix 固化打包机路径（实测指向已不存在的 p/b/libcu8e3caef60472e/p），--cflags/--libs 输出死路径（workflow §5.1）；pkg-config 探测一律用消费方 PkgConfigDeps 再生成的 .pc
forbid_1_consequence:   构建期吸收死路径 -L/-I，产物链接失败或携带无效 rpath

forbid_2_pattern:       requires.*curl/.*#测试库进包依赖
forbid_2_reason:        测试专用 curl 私有自建只服务原生测试阶段；把它写进 conanfile requires 会把无 TLS 变体换成未发布变体并污染包依赖链
forbid_2_consequence:   依赖图引入 remote 不存在的 ref，conan create --build=never 直接失败

principles:

causes:                 []
caused_by:              []
similar_to:             [E091, E119, E216]
conflicts_with:         []
prerequisite_of:        []

