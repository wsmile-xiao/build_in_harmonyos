#====================================================================
# E543-draft-TOMMYDS — 上游 Makefile 硬编码 -march=native 破坏 Conan 交叉构建
#====================================================================

id:                     E543-draft-TOMMYDS
trigger_tool:           make|conan
phase:                  compilation|configuration
error_signature:        -march=native|march=native|invalid arch|unsupported architecture.*native|CMAKE_SYSTEM_PROCESSOR|target-cpu native

severity:               2
category:               makefile|cross-compile|conan|ohos|arch-flags
match_keywords:         march, native, CFLAGS, hardcoded, cross-compile, OHOS, armv8, toolchain, CI worker
title:                  上游 Makefile 硬编码 -march=native 在 Conan 交叉构建（OHOS armv8）下会导致目标 CPU/arch 错误，需绕过 Makefile 或移除该 flag

root_cause:             许多 C 库的上游 Makefile 直接把 -march=native 写死在 CFLAGS 里（如 tommyds 3.0）。在本地原生编译时可行，但 Conan 交叉构建（os=OHOS, arch=armv8）或 CI worker 上，-march=native 会让编译器按构建主机/工具链默认 CPU 生成代码，与目标平台不一致，且上游 Makefile 也不读 Conan 传入的 CC/CFLAGS。更糟的是这类项目往往同时没有 configure / install 目标。
affected_scope:         上游 Makefile 硬编码 -march=native 且无标准构建/安装流程的 C/C++ 库，采用 Conan 配方交叉编译时。
verification_cmd:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing

rec_priority:           1
rec_approach:           bypass-upstream-makefile-direct-compile
rec_description:        不要在 build() 里调用上游 make（其 CFLAGS 含 -march=native 且不读 Conan 环境）。改为：从 self.conf.get("tools.build:compiler_executables") 取 cc/ar/ranlib（R33，禁止裸用 ${CC}），直接用工具链默认 arch flags 编译聚合源文件生成静态库（如 libtommy.a: cc -fPIC -O3 -c tommy.c; ar rcs; ranlib），再按需编译运行上游自检程序作为测试门。
rec_command:            build() 内 self.run(f'"{cc}" -fPIC -O3 -c "{src}" -o "{obj}"') 与 self.run(f'"{ar}" rcs "{lib}" "{obj}"')；package() 手动安装头文件与 .a
rec_auto_fix:            false
rec_impl:                manual-conan-recipe

fallback_priority:      2
fallback_approach:       strip-march-native-via-patch
fallback_description:   若必须走上游 Makefile，用补丁移除/替换 CFLAGS 中的 -march=native（改 -march=armv8-a 或留空），并在 build() 显式传 CC/AR/RANLIB。
fallback_command:       sed -i 's/-march=native//' Makefile && make CC={cc} AR={ar} RANLIB={ranlib} -j1
fallback_auto_fix:      false
fallback_impl:          package-patch

forbid_1_pattern:       -march=native|self\.run\(.*make.*\)\s*$
forbid_1_reason:        直接在 build() 调用上游 make 会把其硬编码的 -march=native 传给 Conan 交叉编译器，生成目标 CPU/arch 错误的代码；且上游 Makefile 不读 Conan 传入的 CC/CFLAGS。
forbid_1_consequence:   交叉构建（OHOS armv8）产物目标 arch 错误，CI 门禁失败或产物在目标机无法运行。

principles:             P006, P010
causes:                 []
caused_by:              []
similar_to:             [E097]
conflicts_with:         []
prerequisite_of:        []

