id: DRAFT-ohos-libcxx-missing-std-views
severity: 2
category: compiler|stdlib|test|ohos
trigger_tool: clang++|libc++|cmake|catch2
phase: build|test
approach: probe-feature-and-rewrite-test-only
keywords: C++20, ranges, std::views, libc++, OHOS, test compatibility
error_signature: "no member named 'views' in namespace std"
match_keywords: "std::views,views::take,include <ranges>,CMAKE_CXX_STANDARD=20,libc++"
title: Probe C++20 std::views separately from language mode on OHOS
root_cause: "The OHOS compiler accepts C++20 syntax while the shipped libc++ lacks the std::views implementation used by a test. The failure is a standard-library feature gap, not a language classification mismatch."
affected_scope: "C++20 Conan projects whose tests use ranges views on OHOS libc++ versions without the complete views implementation."
verification_cmd: "clang++ -std=c++20 -stdlib=libc++ probe.cpp; conan create <archive> -pr:h=<ohos-profile> --build=missing"
rec_priority: 1
rec_approach: "probe the target stdlib, preserve test intent with an equivalent bounded loop when only test syntax depends on the missing view"
rec_description: "Confirm the feature gap with a minimal target-compiler probe, then replace only the affected test expression with an equivalent bounded iteration. Keep the upstream test count and run a real consumer; do not remove tests or claim full views support."
rec_command: "cat > probe.cpp <<'EOF'
#include <ranges>
int main(){ auto v = std::views::iota(0) | std::views::take(1); (void)v; }
EOF
clang++ -std=c++20 -stdlib=libc++ probe.cpp"
rec_auto_fix: false
forbid_1_pattern: "GENERATOR_BUILD_TESTS=OFF"
forbid_1_reason: "Disabling the complete upstream test suite hides a standard-library feature gap and loses regression coverage."
forbid_1_consequence: "A package can appear to build while the published test evidence no longer covers the generator behavior."
forbid_2_pattern: "remove.*TEST_CASE|skip.*views"
forbid_2_reason: "Removing or skipping the affected test is not an equivalent compatibility adaptation."
forbid_2_consequence: "The reported test count becomes false and the C++20 range behavior is unverified."
fallback_priority: 2
fallback_approach: "stop with a complete partial/unsupported report if the public library itself requires the unavailable stdlib feature"
fallback_description: "Use only after probing the public headers and recording source-level dependency evidence; this fallback is not for task-language mismatch."
fallback_command: "record compiler, libc++, feature probe, source locations, and all attempted equivalent implementations"
fallback_auto_fix: false
