#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E432.kv，填写各字段
# 对应的人类文档: doc/E432.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E432
trigger_tool: ld
phase: linking
error_signature: undefined symbol: g_libintl_|libintl\.h|proxy-libintl

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: linking,glib,i18n,dependency-graph
match_keywords: g_libintl_bindtextdomain, g_libintl_dgettext, undefined symbol, proxy-libintl, -lintl
title: glib 的 proxy-libintl 未被 .pc 暴露：g_libintl_* 未定义

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: <glib/gi18n-lib.h> 把 gettext()/dgettext() 等映射到 glib 自带 proxy-libintl 提供的 g_libintl_* 包装；conan glib 包安装的 glib-2.0.pc/gio-2.0.pc 的 Libs 未列 -lintl，-Wl,--no-undefined 链接共享库时报 undefined symbol: g_libintl_bindtextdomain
affected_scope: 所有链接 conan glib 且包含 glib/gi18n*.h 的 C 工程（autotools/meson/cmake 均会中）
verification_cmd: nm -D <glib>/lib/libintl.so | grep g_libintl；grep -n '^Libs' <generators>/glib-2.0.pc（无 -lintl 即命中）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: augment-dependency-pkgconfig
rec_description: 消费侧给 glib 各组件 cpp_info.libs 追加 'intl'（或后处理 .pc 的 Libs 行补 -lintl）
rec_command: for c in dep.cpp_info.components.values(): c.libs.append("intl")
rec_auto_fix: false
rec_impl: 

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: --allow-shlib-undefined.*gi18n|LDFLAGS.*-Wl,--unresolved-symbols=ignore
forbid_1_reason: 掩盖真实未定义符号，运行期崩溃
forbid_1_consequence: dlsym/首次 gettext 调用时崩溃
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P001,P009

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

