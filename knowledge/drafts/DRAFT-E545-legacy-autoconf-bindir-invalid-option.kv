#====================================================================
# DRAFT-E545 — 1994 年 autoconf configure 拒绝 Conan AutotoolsToolchain
# 追加的 --bindir/--libdir 等现代选项（rsynth 2.0 适配时发现）
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E545
trigger_tool: configure
phase: configuration
error_signature: --bindir=${prefix}/bin: invalid option|invalid option; use --help|configure: error: --.*: invalid option

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: autotools-conan
match_keywords: AutotoolsToolchain, --bindir, --libdir, --includedir, invalid option, 1994 configure, legacy autoconf, old configure script, configure_args, prune, prefix
title: 1994 年 autoconf configure 拒绝 Conan AutotoolsToolchain 追加的 --bindir/--libdir 等现代选项

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 1994 年 autoconf 2.0 生成的 configure 只支持 --prefix/--srcdir 等少量选项；Conan AutotoolsToolchain 默认追加 --bindir=${prefix}/bin --sbindir --libdir --includedir --oldincludedir --datarootdir 等现代选项，configure 无法识别直接 abort（error: invalid option）。
affected_scope: 所有使用 1990s 年代 autoconf 生成的 configure 脚本的遗留 C 项目
verification_cmd: conan create ... | grep 'configure.*--prefix=/'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: prune-toolchain-flags
rec_description: conanfile.py generate() 中裁剪 AutotoolsToolchain 自动追加的 install flags，仅保留 --prefix=/：遍历 tc.configure_args 删除以 --bindir/--sbindir/--libdir/--includedir/--oldincludedir/--datarootdir 开头的项，再 tc.generate()。
rec_command: for flag in ('--bindir','--sbindir','--libdir','--includedir','--oldincludedir','--datarootdir'): tc.configure_args=[a for a in tc.configure_args if not a.startswith(flag)]
rec_auto_fix:           true
rec_impl:               prune-toolchain-flags

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
notes: rsynth 2.0 首次适配时发现；同时配合 Makefile.in DESTDIR 补丁与 config.guess/sub 现代化（1994 脚本不识 aarch64-ohos）
doc_file:               doc/E545.md
last_updated: 2026-10-06
source_event: rsynth 2.0 适配 HarmonyOS PC 时 configure 报 "--bindir=/bin: invalid option"

# ═══ 知识协作 (Authorship & Provenance) ═══
