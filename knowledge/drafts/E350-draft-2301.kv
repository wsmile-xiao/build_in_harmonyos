#====================================================================
# E350 draft - OHOS autoconf works-check 执行 conftest 被沙箱拦截
# 触发事件: libXdamage 1.1.6 HarmonyOS PC 适配（archives/l/libxdamage/1.1.6）
# 主从明确：autotools 库原生模式（--build==--host）works-check 执行 conftest 被
#           OHOS 沙箱拦截，报 C compiler cannot create executables；必须 build≠host
#           交叉模式规避。libxrender 交叉过 / libxcursor 原生败同批实证。
#====================================================================

id:                     E350
trigger_tool:           autoconf|configure|works-check
phase:                  configure
error_signature:        C compiler cannot create executables|checking whether the C compiler works|conftest|AC_PROG_CC

severity:               3
category:               ohos, autotools, configure, cross-compile, works-check
match_keywords:         works-check, conftest, cross_compiling, aarch64-linux-ohos, native mode, --host, --build, C compiler cannot create executables, libxdamage
title:                  OHOS 上 autotools 原生模式 works-check 执行 conftest 被沙箱拦截，必须以 build≠host 交叉规避

root_cause:             autoconf 原生模式（--build==--host）下 works-check 会真实执行
                        conftest 二进制，被 OHOS worker 沙箱拦截（无法 exec 自定义 ELF），
                        报 C compiler cannot create executables。build≠host 进入
                        cross_compiling=yes，works-check 只链接不运行即通过。

affected_scope:         一切 autotools（configure 脚本）库在 OHOS worker 上的适配；
                        X11 家族（Xdamage/Xcursor/Xrender/Xcomposite 等）及 libxrender/0.9.12
                        实证。与 worker 抽签问题（clang 链接管线损坏）需按跨配方稳定性区分。

verification_cmd:       CI_PACKAGES="archives/l/libxdamage/1.1.6" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           force-cross-build-neq-host
rec_description:        conanfile generate() 传 --build=aarch64-unknown-linux-ohos
                        --host=aarch64-linux-ohos 保证 build≠host 进入交叉分支，works-check
                        仅链接不运行即通过；用 configure 日志 "checking whether the C compiler
                        works... yes" 判定健康，勿盲目 /rebuild。
rec_command:            CI_PACKAGES="archives/l/libxdamage/1.1.6" zsh ci/conan/build_and_test.sh
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:       standalone-link-only-probe
fallback_description:   若无法改变 build/host（少见），在 configure 外单独构造一个只链接的
                        works-check 探针绕过执行；但会脱离 autoconf 正常流程，优先级低。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          patch-configure

forbid_1_pattern:       /rebuild.*C compiler cannot create executables
forbid_1_reason:        原生模式下重复 rebuild 每次都在 configure 期失败，浪费 CI 配额。
forbid_1_consequence:   反复触发 CI 仍失败，延误并掩盖真正的交叉模式修复。
forbid_2_pattern:       --build=\-\-host|build == host|native mode
forbid_2_reason:        build==host 走原生分支，works-check 执行 conftest 必被沙箱拦截。
forbid_2_consequence:   configure 期稳定失败，7 次 CI 全挂（libXdamage 实证）。
principles:             P013,P014
causes:                 []
caused_by:              []
similar_to:             E344
conflicts_with:         []
prerequisite_of:        []

