#====================================================================
# DRAFT-solid-6.26.0-conan-toolchain-cppstd17-blocks-ecm-cpp20
# conan_toolchain.cmake 预设 CMAKE_CXX_STANDARD=17，压制 ECM 的 C++20 自动判定，
# KF6 6.2x 源码（std::map::contains 等 C++20 特性）编译失败
#====================================================================

id:                     DRAFT-solid-6.26.0-conan-toolchain-cppstd17-blocks-ecm-cpp20
trigger_tool:           conan|cmake|clang|make
phase:                  configuration|compilation
error_signature:        no member named 'contains' in 'std::map'|
                         no member named 'ranges' in namespace 'std'|
                         no member named .* in 'std::(map|set|vector|span)'|
                         Conan toolchain: C\+\+ Standard 17

severity:               2
category:               build-system, cmake, portability, compat, cppstd
match_keywords:         no member named contains, std::map::contains, CMAKE_CXX_STANDARD,
                         cppstd, conan_toolchain.cmake, KDECompilerSettings,
                         KF6, KDE Frameworks, C++20, variable_watch, compiler.cppstd
title:                  conan toolchain 预设 C++17 压制 ECM C++20 自动判定，KF6 6.2x 源码编译失败

root_cause:             conan_toolchain.cmake 在 project() 之前执行
                        set(CMAKE_CXX_STANDARD 17)（取自 profile 的
                        compiler.cppstd），因此 ECM KDECompilerSettings.cmake
                        的 `if (NOT CMAKE_CXX_STANDARD)`（:403-408，接近编译器时自动
                        选择 C++20）永远不成立。KDE Frameworks 6.2x 起源码使用
                        C++20（实测 solid 6.26.0
                        src/solid/devices/frontend/device.cpp:226 的
                        std::map::contains），在 C++17 下报
                        "no member named 'contains'"，构建中止。
                        注意 -DCMAKE_CXX_STANDARD=20 无效：toolchain 内的
                        set() 覆盖 cache 值，且 toolchain 还注册了
                        variable_watch 只提示不改值。

affected_scope:         所有以 conan 构建、profile 中 compiler.cppstd 低于项目实际
                        需求（尤其 KF6/KDE Frameworks 6.2x 与其它要求 C++20 的 CMake
                        项目）的任务。实测：solid/6.26.0；同族
                        kcoreaddons/6.26.0（std::ranges）同类问题。

verification_cmd:       grep -n 'C++ Standard' <generators>/conan_toolchain.cmake
                        # 修复前: "Conan toolchain: C++ Standard 17"
                        # 修复后: "Conan toolchain: C++ Standard 20"
                        cmake -B b -DCMAKE_CXX_STANDARD=20 <src> && grep -n 'C++ Standard' <generators>/conan_toolchain.cmake
                        # 仍为 17 —— 证明必须改 cppstd 而非传 -D

rec_priority:           1
rec_approach:           conan-recipe-configure-cppstd
rec_description:        在 conanfile.py 的 configure() 中覆盖
                        self.settings.compiler.cppstd = "20"。conan 随即生成
                        set(CMAKE_CXX_STANDARD 20) 并保留 conan 自己的编译标志
                        （-stdlib=libc++ 等），无需改上游源码、无需补丁。
rec_command:            def configure(self):
                            self.settings.compiler.cppstd = "20"
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      toolchain-cache-variables
fallback_description:   设置 tc.variables['CMAKE_CXX_STANDARD']='20' +
                        CMAKE_CXX_STANDARD_REQUIRED + CMAKE_CXX_FLAGS='-std=c++20'
                        （kcoreaddons/6.26.0 口径）。注意 CMAKE_CXX_FLAGS 会整体
                        覆盖 cache 变量，可能挤掉 conan 注入的编译标志，仅在
                        cppstd 覆盖不可行时使用。
fallback_command:       tc.variables["CMAKE_CXX_STANDARD"] = "20"; tc.variables["CMAKE_CXX_STANDARD_REQUIRED"] = "ON"; tc.variables["CMAKE_CXX_FLAGS"] = "-std=c++20"
fallback_auto_fix:      false
fallback_impl:          conan-recipe

forbid_1_pattern:       -DCMAKE_CXX_STANDARD=20|set\(CMAKE_CXX_STANDARD 20\)\s*(#.*)?$.*conanfile
forbid_1_reason:        仅靠 -D 或配方里写 tc.variables 的 CMAKE_CXX_STANDARD 无法
                        覆盖 conan_toolchain 内的 set()，会造成"看起来改了却仍按 17
                        编译"的假修复
forbid_1_consequence:   反复调参但仍报 no member named 'contains'，浪费构建轮次
forbid_2_pattern:       把 C\+\+20 特性改写回 C\+\+17 兼容代码
forbid_2_reason:        源码级降级属于无必要修改上游（R1/R8 口径），且脱离 KDE 上游
                        主线，后续版本升级成本更高
forbid_2_consequence:   PR 被打回；后续 KF6 版本升级需重复改造

principles:

causes:                 []
caused_by:              []
similar_to:             [E293]
conflicts_with:         []
prerequisite_of:        []

