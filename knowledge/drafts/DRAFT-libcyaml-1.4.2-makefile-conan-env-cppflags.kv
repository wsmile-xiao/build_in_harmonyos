#====================================================================
# Draft knowledge entry - libcyaml 1.4.2 raw Makefile conan recipe
# Source package: libcyaml/1.4.2
#====================================================================

id:                     DRAFT-libcyaml-1.4.2-makefile-conan-env-cppflags
trigger_tool:           make|conan
phase:                  configuration|compilation
error_signature:        No targets specified and no makefile found|use of undeclared identifier 'VERSION_MAJOR'|undeclared identifier 'VERSION_(MAJOR|MINOR|PATCH)'

severity:               2
category:               build-system|make|conan-recipe
match_keywords:         libcyaml, raw Makefile, no configure, make -C, CPPFLAGS, +=, VERSION_FLAGS, command line override, basic_layout, build-release, env injection, conan recipe

title:                  Raw Makefile Conan recipe: run make -C {source_folder}, inject dependency flags via env not command line

root_cause:             >
    libcyaml is a pure Makefile project (no configure script); the Conan recipe template
    for Autotools does not apply. Two independent traps:
    1) basic_layout puts the Conan build cwd in build-release/ while the Makefile lives
       in the source root -> `make: *** No targets specified and no makefile found`.
    2) The upstream Makefile uses `CPPFLAGS += $(VERSION_FLAGS)`; passing CPPFLAGS on the
       make command line overrides the += and drops -DVERSION_MAJOR/MINOR/PATCH ->
       `use of undeclared identifier 'VERSION_MAJOR'` in src/util.c.
    Dependency include/lib paths must be injected through the environment
    (CPPFLAGS=/LDFLAGS= prefixed on the make invocation), which GNU make appends to
    via +=, rather than through make command-line variable assignments.

affected_scope:         Any pure-Makefile C project (no configure) adapted to OHOS with a Conan recipe.

verification_cmd:       |
  cd <worktree> && python3 scripts/ohc-run.py conan-verify libcyaml 1.4.2

rec_priority:           1
rec_approach:           make-c-source-folder-env-cppflags
rec_description: >
    In conanfile.py build(): run `make -C {self.source_folder} VARIANT=release CC=clang
    AR=llvm-ar` and prefix dependency flags as environment variables:
    `CPPFLAGS='-I<dep>/include' LDFLAGS='-L<dep>/lib -l<dep>' make -C {source_folder} ...`.
    Package artifacts from {source_folder}/build/release.
rec_command:            |
  make -C $BUILD_SRC_DIR VARIANT=release CC=clang AR=llvm-ar \
    CPPFLAGS='-I<libyaml>/include' LDFLAGS='-L<libyaml>/lib -lyaml'
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      patch-makefile-version-flags
fallback_description:   If the upstream Makefile cannot be driven without CLI CPPFLAGS, patch VERSION_FLAGS into the Makefile directly (needs PR rationale per R8).
fallback_command:       sed -i 's/^CPPFLAGS +=/CPPFLAGS += $(VERSION_FLAGS)/' Makefile
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       make -j$(nproc)|-j[0-9]+ on HMDFS
forbid_1_reason:        GNU make jobserver uses a FIFO; HMDFS/SELinux rejects mkfifo (E074) -> build fails or hangs.
forbid_1_consequence:   Build failure with `make: jobserver mkfifo: Operation not permitted`; use serial make.

similar_to:             [E097]
conflicts_with:         []
prerequisite_of:        []

