#====================================================================
# DRAFT-yaku-ns-0.2-vendored-bsd-nameser-needs-sys-cdefs.kv — 草稿
# 内置的旧 BSD arpa/nameser.h 用了 __BEGIN_DECLS/__P 却未 include → musl 全量编译失败
#====================================================================
# 来源: yaku-ns 0.2 OHOS aarch64 适配, 2026-10-03
# 状态: 草稿（待人工审核后 promote 为正式条目）

id:                     DRAFT-yaku-ns-0.2-vendored-bsd-nameser-needs-sys-cdefs
trigger_tool:           clang|gcc
phase:                  compilation
error_signature:        'unknown type name .__BEGIN_DECLS.|unknown type name .__END_DECLS.|expected .;.'' after top level declarator|unknown type name .HEADER.'

severity:               3
category:               headers, libc, musl, portability, build-system, compile
match_keywords:         __BEGIN_DECLS, __END_DECLS, __P, arpa/nameser, nameser.h, sys/cdefs.h, u_char, u_int16_t, HEADER, features.h, vendored BSD header, self-contained, unknown type name
title:                  项目内置的 1993 年版 BSD arpa/nameser.h 用了 __BEGIN_DECLS/__P 却没 include <sys/cdefs.h>，glibc 靠 <features.h> 侥幸能编过，musl 每个编译单元都失败

root_cause: |
  一些老 C 项目把当年的 <arpa/nameser.h>（BSD 4.4 / BIND 8 时代）**逐字拷进源码树**
  当私有头文件用，而不是 include 系统的。这类头文件：

  1. 用 `__BEGIN_DECLS` / `__END_DECLS` / `__P(...)` 控制 C++ 链接可见性与原型形态；
  2. 用 `u_char` / `u_int16_t` / `u_int32_t` 等 BSD 传统 typedef；
  3. **但不 include 定义它们的任何头文件**——当年靠某个"总是先被包含"的头顺带带入。

  glibc 下侥幸成立：<features.h> 会 include <sys/cdefs.h>，而几乎每个 .c 都先
  include 了 <stdio.h>/<sys/types.h>，链条最终把 <sys/cdefs.h> 拉进来。
  musl（OHOS 的 libc）**不做这件事**：<features.h> 里没有 __BEGIN_DECLS，__P 也没人定义。

  于是每个翻译单元都在这个私有头里炸掉，且因为该头定义了 `HEADER`（DNS 报文头结构），
  错误会连带扩散成一串看似无关的 `unknown type name 'HEADER'`：

      nameser.h:253:1: error: unknown type name '__BEGIN_DECLS'
      nameser.h:304:27: error: expected ';' after top level declarator
             extern  u_int16_t  _getshort __P((const u_char *));
      ens.h:279:31: error: unknown type name 'HEADER'
             int build_header(byte **dest, HEADER *hdr, int aa);

affected_scope:         凡把老 BSD 头文件（arpa/nameser.h、sys/param.h、arpa/nameser_compat.h
                        等 BSD 4.4 时代产物）内联进源码树的 C 项目：DNS/网络类老工具
                        尤甚（antirez yaku-ns、djbdns 血统、以及大量 1990-2000 年代
                        的守护进程）。这类包在 glibc 上"能编过"，一迁到 musl 就全红。

verification_cmd:       grep -n '__BEGIN_DECLS\|__P((\|u_int16_t' <vendored header>
rec_priority:           1
rec_approach:           make-vendored-header-self-contained
rec_description: |
  判定：先确认这些符号是**未定义**而非拼错——
      grep -n '__BEGIN_DECLS\|__P(\|u_char\|u_int16_t' <头文件>
  若是历史遗留用法（成对出现、无自定义同名宏），即为"依赖传递包含"。

  修法：让该头文件自包含。补两行 include 即可，两种 libc 下都正确，**不动任何逻辑**：

      #include <sys/cdefs.h>   /* __BEGIN_DECLS/__END_DECLS/__P */
      #include <sys/types.h>   /* u_char / u_int16_t / u_int32_t */

  glibc 与 musl 都从 `<sys/cdefs.h>` 提供前三者；`<sys/types.h>` 提供 BSD typedef。
  glibc 下这两行是冗余的（本来就能编过），但显式声明依赖是正确写法，不引入平台宏、
  不改行为，零风险。

rec_command: |
  # 在 patch 中对内联头文件补 include（示例：nameser.h）
  #   +#include <sys/cdefs.h>
  #   +#include <sys/types.h>
  # 置于该头第一个实际声明之前
  patch -p1 --dry-run < 0001-*.patch     # 先在 pristine 上验证
rec_auto_fix:           true
rec_impl:               explicit-include-in-vendored-header

prescan_pattern:        __BEGIN_DECLS|__END_DECLS|__P\(\(|u_int16_t|u_int32_t
prescan_globs:          *.h

forbid_1_pattern:       #define __BEGIN_DECLS|#define __P
forbid_1_reason:        在包内自己定义这些宏会把 glibc/musl 的原型形态与链接可见性语义搅乱，且掩盖真正的缺失包含；应 include 官方头
forbid_2_pattern:       -D__BEGIN_DECLS|__OHOS__.*nameser|#ifdef __OHOS__.*nameser
forbid_2_reason:        平台宏分支会给两个 libc 走出两套头文件内容，掩盖缺陷并制造维护分叉（踩 R8）
principles:             P002, P005, P011
similar_to:
caused_by:
prerequisite_of:
conflicts_with:

doc_file:               DRAFT-yaku-ns-0.2-vendored-bsd-nameser-needs-sys-cdefs.md