#====================================================================
# DRAFT-ohos-userdb-file-stub — OHOS musl 不提供 passwd/group/shadow 文件
#   访问函数（getspnam/getspnam_r/putpwent/putspent/putgrent/fgetpwent/
#   fgetspent/fgetgrent），OHOS 不管理这些文件——musl 兼容头补声明 +
#   实现 stub（读返回 NULL/ENOENT、写返回 ENOSYS）
# 对应人类文档: knowledge/drafts/DRAFT-ohos-userdb-file-stub.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR systemd/261 适配 HarmonyOS PC（user-util.c/user-record-nss.c/
#           firstboot.c 编译报 putpwent/putspent/getspnam_r/getspnam 未声明）
#====================================================================

id:                     DRAFT-ohos-userdb-file-stub
trigger_tool:           cc|clang|make|meson
phase:                  compilation|linking
error_signature:        call to undeclared function 'getspnam|
                         call to undeclared function 'putpwent|
                         call to undeclared function 'putspent|
                         call to undeclared function 'putgrent|
                         call to undeclared function 'fgetpwent|
                         call to undeclared function 'fgetspent|
                         call to undeclared function 'fgetgrent

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               ohos, musl, passwd, shadow, group, stub, compilation
match_keywords:         getspnam, getspnam_r, putpwent, putspent, putgrent,
                         fgetpwent, fgetspent, fgetgrent, pwd.h, grp.h, shadow.h,
                         /etc/passwd, /etc/shadow, /etc/group, musl, undeclared,
                         userdb, ENOSYS
title:                  OHOS musl 不提供 passwd/group/shadow 文件访问函数——musl
                         兼容头补声明 + stub 实现（读 NULL/写 ENOSYS）

# ═══ Layer 2: 诊断层 ═══
root_cause:             glibc 的 <pwd.h>/<grp.h>/<shadow.h> 声明 passwd/shadow/
                         group 文件访问函数（getspnam/getspnam_r/putpwent/
                         putspent/putgrent/fgetpwent/fgetspent/fgetgrent）。
                         OHOS musl 不提供这些函数（OHOS 不管理 /etc/passwd、
                         /etc/shadow、/etc/group 文件）——使用这些接口的库
                         （systemd 的 user-util.c/user-record-nss.c/firstboot.c）
                         编译报 "call to undeclared function"
affected_scope:         所有在 OHOS 上编译、读取/写入 passwd/group/shadow 文件
                         的库（systemd 即此类）
verification_cmd:       conan create archives/s/systemd/261 --build=missing
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 覆盖前 getspnam/putpwent 等系列报 undeclared；
                         # 覆盖后编译通过

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           musl-userdb-file-stub
rec_description:        在 musl 兼容头（src/include/musl/pwd.h、grp.h、shadow.h）
                         include_next 后补函数声明；实现放 src/libc/musl/userdb.c：
                         读函数（getspnam/getspnam_r/fgetpwent/fgetspent/fgetgrent）
                         返回 NULL/ENOENT（OHOS 无这些文件），写函数（putpwent/
                         putspent/putgrent）返回 -1 + errno=ENOSYS（与 polkit 的
                         getspnam 存根语义一致）；注册进 musl 编译单元
rec_command:            (musl 兼容头 pwd.h/grp.h/shadow.h + userdb.c)
                         int putpwent(const struct passwd *pw, FILE *stream);
                         struct passwd *fgetpwent(FILE *stream);
                         int putspent(const struct spwd *sp, FILE *stream);
                         struct spwd *fgetspent(FILE *stream);
                         struct spwd *getspnam(const char *name);
                         int getspnam_r(const char *name, struct spwd *result_buf,
                                        char *buf, size_t buflen, struct spwd **result);
                         /* 实现: 读→NULL+ENOENT / EACCES，写→-1+ENOSYS */
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      source-patch-disable-userdb-usage
fallback_description:   若 stub 不可行，patch 源码绕开 passwd/shadow 文件访问——
                         改动面大，不推荐
fallback_command:       (逐文件补丁)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       skip.*getspnam|禁用.*userdb|N/A（未运行）
forbid_1_reason:        stub 可无损解决（OHOS 无这些文件，读 NULL/写 ENOSYS 语义
                         正确）；跳过/禁用属"有可运行子集未尝试"
forbid_1_consequence:   被 rule 4 打回
forbid_2_pattern:       sed.*user-util\.c.*删除.*putpwent|patch.*去掉.*getspnam
forbid_2_reason:        删功能治标不治本；stub 是标准做法
forbid_2_consequence:   换库/换平台即失效

# ═══ Layer 4: 原则引用 ═══
principles:

