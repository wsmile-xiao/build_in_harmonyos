#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: clang|conan create|make
phase: compilation
error_signature: emmintrin.h.*only meant to be used on x86|FILE.*undeclared identifier|posix_memalign.*EINVAL

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: portability, single-header, aarch64, ohos, allocator
match_keywords: zpl, single-header, stb-style, emmintrin, xmmintrin, SIMD, ZPL_CPU_X86, stdio.h, FILE, tmpfile, ZPL_THREADING, posix_memalign, aligned_alloc, EINVAL, base64
title: 单头文件 C 库在 aarch64/OHOS 上三处可移植性缺陷：x86 SIMD 头无条件包含、stdio.h 条件包含位置、heap allocator 误用 posix_memalign

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: zpl 9.8.0 上游三处平台分支缺陷：(1) 非 Android/iOS/Emscripten 分支无条件包含 x86 专用 <emmintrin.h>，aarch64 编译失败；(2) <stdio.h> 仅出现在 Windows/OSX/与 ZPL_THREADING affinity 段，而 ZPL_THREADING 在 ARM 上被禁用，导致 FILE/tmpfile 未声明；(3) heap allocator 对 x86 Linux 用 aligned_alloc、ARM Linux 误用 posix_memalign，posix_memalign 对入参对齐 4（base64 解码路径）返回 EINVAL。
affected_scope: stb 式单头文件 C 库在 aarch64/OHOS 的交叉编译
verification_cmd: clang -I<src> -I<src>/code -std=gnu99 -O1 -o base64 test/base64.c && ./base64

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: (1) SIMD 头以 ZPL_CPU_X86 守卫，否则包含 <sched.h>；(2) 主头非 Windows 分支无条件包含 <stdio.h>；(3) ARM Linux 与 x86 一致使用 aligned_alloc
rec_description:        一句话描述这个推荐方案
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: true
rec_impl: patch-zpl-h-aarch64-portability

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

