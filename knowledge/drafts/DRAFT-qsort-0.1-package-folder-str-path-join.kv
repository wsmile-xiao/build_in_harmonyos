#====================================================================
# DRAFT-qsort-0.1-package-folder-str-path-join
# 触发事件: qsort 0.1 R01 正式适配（pc3-3, 2026-09-18）
# 主从明确: header-only 配方 package() 中 package_folder 为 str 时 / 拼接 TypeError
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-qsort-0.1-package-folder-str-path-join
trigger_tool:           conan|conan-create|conan-verify|ohc
phase:                  packaging
error_signature:        TypeError: unsupported operand type\(s\) for /: 'str' and 'str'|package_folder.*include|os\.path\.join\(self\.package_folder

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               1
category:               conan, packaging, headers
match_keywords:         package_folder, str, Path, basic_layout, header-only, 单头文件,
                         no cmake, copy, include, TypeError, os.path.join, conan create,
                         header-library
title:                  header-only 配方 package() 中 package_folder 为 str 时 / 拼接报
                          TypeError，须用 os.path.join

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  OHOS 适配版 Conan（2.29.1）+ basic_layout 下 self.package_folder 返回 str 而非
  pathlib.Path，模板式 `self.package_folder / "include"` 写法对 str 使用 / 运算符
  触发 TypeError，package() 阶段中止；header-only 库常手工 copy 头文件到 include/，
  最容易踩中。conanfile 模板中的 Path 除法写法并非在所有布局/环境下成立。
affected_scope: >
  所有 basic_layout / header-library 配方中手工 copy 头文件到
  os.path.join(package_folder, "include") 路径的库；使用 CMake install/export
  自动安装头文件的 INTERFACE 库配方（E321/E322 形态）不触发。
verification_cmd: >
  conan create archives/<字母>/<库>/<版本> -pr:h=...ohos-aarch64
  -pr:b=...ohos-aarch64 --build=missing --user=ohpcd --channel=stable

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           use-os-path-join-for-package-folder
rec_description: >
  conanfile.py 顶部 import os，package() 中用
  os.path.join(self.package_folder, "include") 替代 / 拼接；
  头文件拷贝目标统一用 os.path.join 保证 str/Path 两兼容。
rec_command: >
  copy(self, "qsort.h", self.source_folder, os.path.join(self.package_folder, "include"))
rec_auto_fix:           false
rec_impl: >
  import os
  def package(self):
      copy(self, "qsort.h", self.source_folder, os.path.join(self.package_folder, "include"))

# 回退方案
fallback_priority:      2
fallback_approach:      use-pathlib-explicit
fallback_description: >
  显式 pathlib: from pathlib import Path;
  copy(..., str(Path(self.package_folder) / "include"))
fallback_command: ""
fallback_auto_fix:      false
fallback_impl: ""

# 禁止策略
forbid_1_pattern:        str\.replace\(.*package_folder|package_folder.*\+.*['\"]/
forbid_1_reason:         字符串 + 拼接易引入路径分隔符错误，且不具类型兼容性
forbid_1_consequence:    路径拼接结果在跨平台/跨环境不一致，可能损坏 package 布局
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
principles:              P016

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因
causes:
# caused_by:       本模式的根因是这些模式
caused_by:
