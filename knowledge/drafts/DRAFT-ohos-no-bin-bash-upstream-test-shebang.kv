#====================================================================
# DRAFT-ohos-no-bin-bash-upstream-test-shebang
#   OHOS PC 无 /bin/bash（只有 /bin/sh）→ 上游 #!/bin/bash 测试脚本
#   直接执行报 "exec: No such file or directory"（exit 127）
#   → 上游测试统计前必须按 shebang 显式选择解释器
# 来源: kamailio-lua 6.0.6 适配的上游测试环节（kamailio test/unit，36/49 用例 #!/bin/bash）
# 状态: 草稿（待审核 promote）
#====================================================================

id:                     DRAFT-ohos-no-bin-bash-upstream-test-shebang
trigger_tool:           bash|sh|make
phase:                  testing
error_signature:        /bin/bash: No such file or directory|
                        exec \./.*\.sh: No such file or directory|
                        timeout: exec .*No such file or directory
match_keywords:         /bin/bash, shebang, 127, No such file or directory, 上游测试, test suite,
                        uname, HarmonyOS, OHOS PC, bash, sh, 解释器, 用例统计
severity:               P2
category:               testing, shell, ohos, platform
title:                  OHOS PC 无 /bin/bash，上游 #!/bin/bash 测试脚本直接执行报 ENOENT(127)，需按 shebang 选解释器
prescan_pattern:        ^#!/bin/bash
prescan_globs:          tests/*.sh|test/*.sh|*.sh

# ═══ 诊断层 ═══
root_cause:             OHOS PC（HarmonyOS）根文件系统不提供 /bin/bash，只有 /bin/sh；
                        bash 实体位于 /data/service/hnp/bin/bash（hnp 工具链目录）。
                        上游测试脚本若以 `#!/bin/bash` 为 shebang，直接 `./script.sh` 时内核按
                        绝对路径 exec `/bin/bash` → ENOENT → shell 报 127（"No such file or
                        directory" / "inaccessible or not found"）。若用 `sh script.sh` 显式执行
                        则可绕过（但会改变 POSIX/bash 语义，且与上游意图不符）。
affected_scope:         任何"在上游源码树内直接执行上游测试脚本"的适配流程；
                        具象实证：kamailio 6.0.6 `test/unit/`（49 个 .sh 中 36 个为 #!/bin/bash），
                        未处理时 36 个用例全部以 127 假失败，污染上游测试统计。

# ═══ 方案层 ★ ═══
rec_priority:           1
rec_approach:           per-shebang-interpreter
rec_description:        执行上游测试前读取脚本首行 shebang，按 shebang 显式选择解释器：
                        `#!/bin/bash` → /data/service/hnp/bin/bash；`#!/bin/sh` → /bin/sh；
                        并保留每个用例的真实退出码与输出（不改上游测试文件本身）。
rec_command:            interp=$(head -1 "$f" | grep -q bash && echo /data/service/hnp/bin/bash || echo /bin/sh)
                        timeout 120 "$interp" "./$f"
rec_auto_fix:           false
rec_impl:               per-shebang-interpreter

fallback_priority:      2
fallback_approach:      posix-sh-substitute
fallback_description:   统一用 /bin/sh 执行全部用例。仅当用例语法与 POSIX sh 兼容时成立，
                        且改变了上游执行语义（bash 专有语法如 `[[ ]]`、`&>` 会失败），
                        故仅作最后手段。
fallback_command:       for f in *.sh; do /bin/sh "./$f"; done
fallback_auto_fix:      false
fallback_impl:          posix-sh

forbid_1_pattern:       创建.*/bin/bash.*软链|把 bash 拷到 /bin|/bin/bash -> .*
forbid_1_reason:        / 为只读系统分区，且改共享系统目录会污染其他会话与 CI worker（不可逆）
forbid_1_consequence:   局部可用、环境不一致；CI worker 重建后失效

# ═══ 关系图 ═══
similar_to:             E037（bash 专用语法/shebang 预扫描族）
caused_by:
conflicts_with:
prerequisite_of:

# ═══ 元数据 ═══
verification_cmd:       head -1 -q test/unit/*.sh | sort | uniq -c
                        # 36 #!/bin/bash / 13 #!/bin/sh
                        ls -l /bin/bash ; ls -l /data/service/hnp/bin/bash
                        # /bin/bash: No such file or directory ; bash 5.3.0 实体在 hnp/bin
authors:                ohc-worker <ohc-worker@local>
source_commit:          0
metrics_success_count:  1
metrics_fail_count:     1
metrics_confidence:     1.0
metrics_last_used:      2026-10-02

draft: true
contributor_id:         KML-LUA
