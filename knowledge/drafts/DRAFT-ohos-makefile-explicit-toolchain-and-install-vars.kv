id: DRAFT-ohos-makefile-explicit-toolchain-and-install-vars
severity: 2
category: build-system|make|conan|ohos
trigger_tool: make|conan|clang|install
phase: build|package
approach: explicit-profile-compiler-and-conan-copy
keywords: Makefile, CC, install, OpenHarmony, OHOS, Conan, compiler_executables
error_signature: "make: cc: No such file or directory; install: No such file or directory"
match_keywords: "CC=cc,install,compiler_executables,OHOS,Makefile"
title: Makefile recipes on OHOS must bind the profile compiler and package with Conan copy
root_cause: "Portable Makefiles often default to host command names such as cc and install. The OHOS Conan profile can provide a target clang path without changing those Makefile defaults, and the target environment may not provide a standalone install command."
affected_scope: "C/C++ libraries built by Makefile on OpenHarmony or other cross-compilation environments with explicit compiler paths and minimal host utilities."
verification_cmd: "conan create <archive> -pr:h=<ohos-profile> -pr:b=<ohos-profile> --build=missing; test_package must link and execute a real API consumer"
rec_priority: 1
rec_approach: "read tools.build:compiler_executables, pass CC/CXX to make, and use Conan copy() for package layout"
rec_description: "Keep the toolchain boundary in the recipe: pass the profile compiler to upstream make and copy only verified library/header outputs in package(). Run the upstream test target with the same compiler and verify the package with a real consumer."
rec_command: 'compiler = (self.conf.get("tools.build:compiler_executables", default={}, check_type=dict) or {}).get("c", "cc"); self.run(f"make CC={compiler} test", cwd=self.source_folder)'
rec_auto_fix: false
forbid_1_pattern: 'make(\s+[^\n]*)?\bcc\b'
forbid_1_reason: "The host-name cc may not exist or may be the wrong architecture in an OHOS cross-build."
forbid_1_consequence: "Compilation can fail before any source diagnostic, or silently select a host compiler."
forbid_2_pattern: 'make(\s+[^\n]*)?\binstall\b'
forbid_2_reason: "A library package does not need to depend on an unavailable host install utility when Conan can stage files."
forbid_2_consequence: "The upstream install target fails even after the library itself has built and tested successfully."
fallback_priority: 2
fallback_approach: "provide a pinned tool_requires only when the upstream test/build genuinely requires that utility"
fallback_description: "Do not install tools globally or alter the device PATH as a recipe side effect; use a declared tool requirement or Conan packaging primitives."
fallback_command: "declare the required tool in the recipe and keep package() deterministic"
fallback_auto_fix: false
