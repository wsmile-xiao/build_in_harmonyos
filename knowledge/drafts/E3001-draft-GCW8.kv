#====================================================================
# Draft E3001 — Waf 私有 Python 构建系统跨平台适配（OHOS aarch64）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E3001
trigger_tool:           waf|configure|make|python
phase:                  configuration|compilation
error_signature:        The configuration failed|IN_LAUNCH_DIR|PYTHONHASHSEED=1 missing|Don't use waf directly|Could not build a python embedded interpreter

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               build-system, waf, ohos, python, configure
match_keywords:         waf, wafsamba, CROSS_COMPILE, cross-answers, configure wrapper, make wrapper, IN_LAUNCH_DIR, PYTHONHASHSEED, WAF_MAKE, python-config, pyembed, samba, tdb, talloc, tevent, ldb
title:                  Waf 私有 Python 构建系统跨平台（OHOS）适配：`configure`/`make` 包装脚本调用链 + CROSS_COMPILE 真实语义注入 + 禁止直接调用 waf
prescan_pattern:        Don't use waf directly|PYTHONHASHSEED=1 missing|IN_LAUNCH_DIR
prescan_globs:          *.py, wscript, wscript_build, configure, Makefile*, *.sh

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Samba 系（samba/tdb/talloc/tevent/ldb）使用自带 waf（wafsamba），非 autotools/cmake。其 waf 目录不能直接执行：`configure`/`make` 包装脚本要求 `$PYTHON` 指向可用 python3、自行 `export PYTHONHASHSEED=1`、`unset LD_PRELOAD`，且 `wscript` 的 `conf.IN_LAUNCH_DIR()` 要求源码根目录原地构建；交叉编译时必须用 CROSS_COMPILE 注入目标三元组/clang 绝对路径，并注意 pyembed 探针（python3-config --embed 可能输出 musl 缺失的 -lintl）在 OHOS 上不可通过。以上任一不满足即 configure 中断或产出非目标产物。
affected_scope:         所有用 wafsamba/自带 waf 的 Samba 系包（含独立库）在 OHOS aarch64 的 configure/编译；已实锤实例：samba 4.21.0、tdb 1.4.15。
verification_cmd:       PYTHON=python3 ./configure --prefix=$PREFIX && make -j$$(nproc)

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           ohos-waf-build-policy
rec_description:        用 `configure`/`make` 包装脚本走 waf 调用链（源码根目录原地构建，`$PYTHON=python3` + PYTHONHASHSEED/WAF_MAKE 由脚本注入）；交叉编译经 `CROSS_COMPILE=<triplet>-` + `--cross-answers`（仅当确有真实语义依据时）注入，把 clang 绝对路径写进 conan 的 build env（CC/CXX/AR/RANLIB/PKG_CONFIG_PATH/CPATH/LIBRARY_PATH/PERL5LIB 单点注入）；C-only 包用官方 `--disable-python` 规避 pyembed 失败，并用 `PYTHONHASHSEED` 保证可复现。
rec_command:            PYTHON=python3 ./configure --prefix=${PREFIX} && make -j$$(nproc) && make install
rec_auto_fix:           false
rec_impl:               conanfile.py `_waf`/`_build_env` 封装 + `--without-*` 裁剪透传

fallback_priority:      2
fallback_approach:      waf-cross-answers-file
fallback_description:   个别必须通过才继续的探针，用 `waf --cross-answers` 预填答案，但仅当该答案符合目标平台真实语义且不伪造探测失效项；不做任何无条件 cross-answers 全量预填。
fallback_command:       python3 buildtools/bin/waf --help   # 列出 --cross-compile/--cross-answers
fallback_auto_fix:      false

# ★ 禁止策略 ★
forbid_1_pattern:       hardcode /tmp|inject -D__OHOS__|point probe at device-only path
forbid_1_reason:        R8/PF5 禁平台宏；硬编码设备路径不跨 CI；伪造探针通过=欺骗式适配。
forbid_1_consequence:   W4/preflight 欺骗式适配发现；CI 不可复现。

# ═══ Layer 4: 原则引用 ═══
principles:             minimal-patch, platform-agnostic-fix, real-evidence-over-assumption, verify-not-fake

# ═══ 关系图 ═══
causes:                 []
caused_by:              [E3006]
similar_to:             [E11055]
conflicts_with:         []
prerequisite_of:        []

