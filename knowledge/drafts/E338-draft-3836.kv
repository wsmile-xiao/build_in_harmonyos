#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E338.kv，填写各字段
# 对应的人类文档: doc/E338.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E338
trigger_tool: conan-verify
phase: verify
error_signature: conan-verify.*无法找到程序包 ID|Package ID not found.*dotted version|G4.*package ID

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: conan
match_keywords: conan-verify, package id, dotted version, G4, conan create
title: conan-verify 无法解析点号版本号的 package ID（G4/L2/L4/L5 跳过）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: conan_verify.py G2 用正则 (\w+/\w+@\w+/\w+):(\w+) 从 conan create 日志提取 package ID，\w+ 不匹配含点号的版本号（如 20160310.da66f51），导致 _package_id 为空，G4/L2/L4/L5 因拿不到 cache 路径而跳过
affected_scope: 所有带点号/连字符版本号的三方库配方验证
verification_cmd: conan cache path asplib/20160310.da66f51@ohpcd/stable:4b977264131a1c74e82bd6bb51b63cc9aadc4cfa

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 版本号含点号时 G4/L2/L4/L5 会被跳过但标记 PASS；需手动用 conan cache path '<ref>:<pkgid>' + readelf/sha256 验证产物完整性（或用 conan list 获取 package id）
rec_description: 版本号含点号（或连字符）时 conan-verify 的 package ID 正则不匹配，G4/L2/L4/L5 被跳过但标记 PASS；需手动验证产物完整性
rec_command: conan cache path asplib/20160310.da66f51@ohpcd/stable:4b977264131a1c74e82bd6bb51b63cc9aadc4cfa
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: 用 conan list '<ref>:*' 输出解析 package id 后手动执行 L4/L5
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

