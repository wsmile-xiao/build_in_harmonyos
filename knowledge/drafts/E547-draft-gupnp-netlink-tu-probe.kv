#====================================================================
# E547-draft-gupnp-netlink-tu-probe
# Meson 单头 has_header 平台探测假阳性：用与真实翻译单元一致的组合
# 编译探测修复探测逻辑本身（gupnp netlink 案例）
# 触发事件: gupnp 1.6.10 HarmonyOS PC 适配
#====================================================================

id:                     E547
trigger_tool:           meson|clang|cc
phase:                  configure
error_signature:        redefinition of 'struct sockaddr_storage'|linux/socket.h.*redefinition|gupnp-linux-context-manager|has_header.*rtnetlink|netlink headers

severity:               2
category:               build-system, detection, kernel-headers
match_keywords:         has_header, cc.compiles, netlink, rtnetlink, sockaddr_storage, linux/socket.h, sys/socket.h, false positive, meson probe, context manager, OHOS
title:                  Meson standalone cc.has_header is a false positive when the header only breaks in combination with another system header; probe the realistic TU instead

root_cause:             Meson 的 cc.has_header() 把被测头放在一个独立的最小编译
                        单元里探测。OHOS musl sysroot 中 linux/netlink.h（经
                        linux/socket.h）与 sys/socket.h 各自定义 struct
                        sockaddr_storage，单独包含各自都能编译通过，只有同一翻译
                        单元才触发 redefinition。上游 gupnp 1.6.10 用
                        cc.has_header('linux/rtnetlink.h') 探测 netlink 可用性，
                        在 OHOS 上得到假阳性 true，随后真实源文件
                        gupnp-linux-context-manager.c（同 TU 含 sys/socket.h +
                        linux/netlink.h + linux/rtnetlink.h）编译失败。
                        E091 记录了该头冲突现象本身；本条目记录的是其上的探测
                        逻辑缺陷形态与修法。

rec_approach:           detection-patch
rec_description:        修探测逻辑而不是打平台宏：把单头 has_header 换成
                        cc.compiles()，让探测试图包含与真实源文件完全相同
                        的头组合（sys/socket.h + linux/netlink.h +
                        linux/rtnetlink.h 同 TU）。glibc 系通过、OHOS 失败
                        → netlink_available=false → 构建自动走上游为非
                        netlink 平台维护的回退路径（gupnp 即 ifaddrs 的
                        unix context manager，与 BSD 同路径）。无平台宏
                        （R8 合规）、无功能删减、上游可接受的正向改进。
rec_command:            netlink_available = cc.has_header('linux/rtnetlink.h') and cc.compiles('#include <sys/socket.h>\n#include <linux/netlink.h>\n#include <linux/rtnetlink.h>\nint main(void) { return 0; }\n', name: 'netlink headers usable together with sys/socket.h')

forbid_1_pattern:       #if defined\(__OHOS__\).*netlink|netlink.*#ifdef __OHOS__
forbid_1_reason:        平台宏把适配绑定到宏名而非真实能力，且无法解释为何"可用性探测通过但源码编译失败"。
forbid_1_consequence:   其他 musl 系平台同样存在该冲突时补丁不生效；上游拒收平台宏。

doc_file:               knowledge/drafts/E547-draft-gupnp-netlink-tu-probe.md
last_updated:           2026-09-06
source_event:           gupnp/1.6.10 HarmonyOS PC 适配
draft:                  true
contributor_id:         Awstme
source_commit:          86955451322c66caaef5f83560d0c14c0ce1bb5e
patches_referenced:     archives/g/gupnp/1.6.10/patches/0001-meson-build-harden-netlink-detection.patch
verification_cmd:       printf '#include <sys/socket.h>\n#include <linux/netlink.h>\n#include <linux/rtnetlink.h>\nint main(void){return 0;}\n' | clang -fsyntax-only -xc -
verification_exit:      1
verification_log:       archives/g/gupnp/1.6.10/reports/conan-create.log (meson 探测行 "netlink headers usable together with sys/socket.h: NO")
verification_evidence:  单头 has_header 探测 YES、组合 TU 探测 NO（实测并存）；修复后 7/7 上游测试通过；readelf 证实 libgupnp NEEDED 无 netlink 相关、unix context manager 生效
value_scope:            OHOS/HarmonyOS musl sysroot 上任何"单头探测通过但与系统头同 TU 冲突"的 meson 特性探测；典型头集：linux/netlink.h、linux/rtnetlink.h、linux/if_addr.h、linux/wireless.h 与 sys/socket.h 组合
limits:                 仅适用 meson cc.has_header/cc.compiles 形态；autotools 的 AC_CHECK_HEADER 同样存在单头探测缺陷，修法对应改为组合头编译探测（AC_COMPILE_IFELSE）

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9
metrics_last_used:      2026-09-06
