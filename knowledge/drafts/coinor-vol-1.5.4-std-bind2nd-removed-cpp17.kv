#====================================================================
# DRAFT-coinor-vol-1.5.4-std-bind2nd-removed-cpp17
# C++17 移除 std::bind2nd/ptr_fun 等仿函数适配器，2003 年代代码须替换为 lambda/std::bind
#====================================================================

id:                     DRAFT-coinor-vol-1.5.4-std-bind2nd-removed-cpp17
trigger_tool:           clang|make|conan
phase:                  compilation
error_signature:        no member named 'bind2nd' in namespace 'std'|
                         no member named 'bind1st'|
                         error:.*bind2nd.*C\+\+17|ptr_fun.*deprecated

severity:               2
category:               c++, cppstd-17, legacy-code, standard-library
match_keywords:         bind2nd, bind1st, ptr_fun, mem_fun, std::multiplies,
                         std::transform, C++17 removed, functor adapters, lambda,
                         std::bind, legacy C++ code, Osi interface layer
title:                  C++17 移除 std::bind2nd 等仿函数适配器，2003 年代代码须替换为 lambda/std::bind

root_cause:             std::bind2nd/std::bind1st 等旧仿函数适配器在 C++11 标记
                        deprecated、C++17 正式移除。2003 年代 C++ 代码
                        （std::transform + std::bind2nd(std::multiplies<T>(), k)）
                        在 OHOS 固定 cppstd=17 下直接编译失败。与 E293
                        （register 关键字移除）同族：均为旧代码在 C++17 下的
                        标准库/语言特性移除。
affected_scope:         所有 2003 年代 C++ 库在 compiler.cppstd=17 下使用
                        std::bind1st/bind2nd/ptr_fun/mem_fun 的代码。实测：
                        coinor-vol 1.5.4 OsiVol 接口层
                        （Vol/src/OsiVol/OsiVolSolverInterface.cpp:471）。
verification_cmd:       grep -nE 'bind2nd|bind1nd|bind1st|ptr_fun' <src>/*.cpp 应 0 命中；
                        clang++ -std=c++17 -stdlib=libc++ -c <src>.cpp 应 rc=0

rec_priority:           1
rec_approach:           source-patch-lambda-replacement
rec_description:        用 lambda（或 std::bind + std::placeholders）替换
                        std::bind2nd/bind1st。重点：lambda 捕获须按上下文选择
                        [value] 或 [this]（成员函数内访问成员变量时必须 [this]，
                        直接写 [member] 会报 "does not name a variable"）。
rec_command:            OsiVolSolverInterface.cpp:471:
                        std::transform(rowprice_, rowprice_+dsize, dsol.v,
                          std::bind2nd(std::multiplies<double>(), objsense_));
                        -> std::transform(rowprice_, rowprice_+dsize, dsol.v,
                          [this](double v) { return v * objsense_; });
                        补丁随 exports_sources 打包；test_package 消费者以
                        cppstd=17 编译验证。
rec_auto_fix:           false
rec_impl:               conan-recipe-source-patch

fallback_priority:      2
fallback_approach:      toolchain-flag-only
fallback_description:   与 E293 同：-Wno-error 类 flag 无法移除已失效的 API，
                        C++17 下 bind2nd 是硬错误，无 toolchain-flag 兜底。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          none

forbid_1_pattern:       --build=|--host=.*ohos|set\(CMAKE_CXX_STANDARD 11\)
forbid_1_reason:        禁止用 --build/--host 绕过（误判交叉编译），也禁止把
                        cppstd 降到 11 掩盖问题（OHOS profile 固定 17）
forbid_1_consequence:   级联错误链：交叉编译误判 → AC_RUN_IFELSE 跳过 → config.h 错误

principles:

causes:                 []
caused_by:              []
similar_to:             [E293]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/coinor-vol-1.5.4-std-bind2nd-removed-cpp17.md
last_updated:           2026-09-10
source_event:           coinor-vol 1.5.4 R03 赛事 PR 审查返工（OsiVol 接口层 C++17 编译）

