#====================================================================
# Draft: CMake 4 no longer ships FindBoost; upstreams that use the legacy
#        ${Boost_INCLUDE_DIRS} / ${Boost_<COMPONENT>_LIBRARY_RELEASE}
#        variables (or find_package(Boost) without CONFIG mode) fail on
#        a clean cross-compile.  Source event: schroot 1.6.13, 2026-10-01.
#====================================================================

id:                     DRAFT-SCHROOT-1613-CMAKE4-FINDBOOST
trigger_tool:           cmake
phase:                  configuration
error_signature:        Could NOT find Boost|Boost_INCLUDE_DIRS.*empty|Boost_.*_LIBRARY_RELEASE|no module named FindBoost|BoostConfig\.cmake not found

severity:               2
category:               cmake, build-system, compat, portability, limitation
prescan_pattern:        find_package\(\s*Boost|Boost_INCLUDE_DIRS|Boost_[A-Z_]+_LIBRARY_RELEASE|Boost_LIBRARIES
match_keywords:         CMake 4, FindBoost removed, BoostConfig, Boost_INCLUDE_DIRS, Boost_LIBRARIES, Boost_<COMPONENT>_LIBRARY_RELEASE, CMAKE_FIND_PACKAGE_PREFER_CONFIG, BOOST_ROOT, imported target

title:                  CMake 4 起不再提供 FindBoost 模块：上游用 ${Boost_INCLUDE_DIRS}/${Boost_<COMPONENT>_LIBRARY_RELEASE} 等旧式变量时，交叉编译须由配方给出 Boost 头/库目录与各组件库文件路径（BoostConfig 只提供 imported target）

root_cause:             CMake 4 移除了 FindBoost 模块，Boost 只能以 BoostConfig.cmake（CONFIG 模式）被找到；BoostConfig 只定义 imported target（Boost::filesystem 等），不设 Boost_INCLUDE_DIRS / Boost_LIBRARIES / Boost_<COMPONENT>_LIBRARY_RELEASE 这些旧式变量。上游 CMakeLists 若依赖旧式变量（尤其交叉编译时还关掉了系统路径搜索），configure 阶段就找不到头或组件库，报 Could NOT find Boost 或后续编译缺头。
affected_scope:         用 find_package(Boost) 且读取旧式变量的上游项目（boost 1.60-1.7x 时代写法最常见）；交叉编译 + conan 依赖提供的 Boost 场景。schroot 1.6.13（filesystem/iostreams/program_options/system/regex 五组件）为实证。
verification_cmd:       cmake -DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON -DBOOST_ROOT=<boost pkg> ... && grep -n "Boost_INCLUDE_DIRS" CMakeCache.txt

rec_priority:           1
rec_approach:           provide-boost-legacy-variables-from-recipe
rec_description:        ①配方侧置 CMAKE_FIND_PACKAGE_PREFER_CONFIG=ON 与 BOOST_ROOT=<boost 包目录>，让 BoostConfig 生效；②把 Boost 头/库目录通过工具链 extra_cflags/extra_cxxflags/extra_linkflags（列表）注入，绕开上游找不到头的问题；③显式设置上游读取的旧式变量：Boost_INCLUDE_DIRS、Boost_LIBRARY_DIRS 及各 Boost_<COMPONENT>_LIBRARY_RELEASE / _DEBUG 指向包内 .a/.so 实体路径；④注意 boost ≥1.84 不再有独立 libboost_system（组件为 header-only），给 Boost_SYSTEM_LIBRARY_RELEASE 之类的赋值会导致链接期 -lboost_system 找不到库——须按组件实际产物（有 .a/.so 才赋值）判断；⑤验证要走到链接（只 configure 通过不够）。
rec_command:            tc.cache_variables["CMAKE_FIND_PACKAGE_PREFER_CONFIG"]="ON"; tc.cache_variables["BOOST_ROOT"]=boost_pkg; tc.cache_variables["Boost_<COMP>_LIBRARY_RELEASE"]=<boost pkg>/lib/libboost_<comp>.a
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:      patch-upstream-cmake-to-use-imported-targets
fallback_description:   若上游 CMakeLists 结构复杂、旧式变量散落多处，可打补丁改为 Boost::<component> imported target（更现代、更稳）。但需评估补丁侵入面与上游是否接受，并在 notes.md 说明；优先用配方变量而非改上游。
fallback_command:       patch: target_link_libraries(foo PRIVATE Boost::filesystem)   # 替代 ${Boost_LIBRARIES}
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       link_libraries\(.*boost_system|find_library\(BOOST_SYSTEM
forbid_1_reason:        盲目给 header-only 组件（如 boost ≥1.84 的 system）加 -lboost_system，会在链接期失败且掩盖真实的组件变量缺失问题。
forbid_1_consequence:   链接期 "cannot find -lboost_system"，排查方向被带偏到 Boost 安装位置

principles:             P0

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/schroot-1.6.13-cmake4-no-findboost.md
last_updated:           2026-10-01
source_event:           schroot 1.6.13：上游 CMakeLists 用 ${Boost_INCLUDE_DIRS} 与 Boost_<COMP>_LIBRARY_RELEASE，CMake 4 下 configure/编译均失败，改由配方注入后通过

