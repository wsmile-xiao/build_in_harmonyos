#====================================================================
# E637.kv — dfsg 后缀版本的源取法（上游官网死链 → Debian/Ubuntu pool）
# 对应的人类文档: doc/E637.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E637
trigger_tool:           install
phase:                  configuration
error_signature: 'ERROR: Error downloading file|The requested URL returned error: 404|sha256 signature failed for file|ERROR: Invalid configuration'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, portability, detection
match_keywords:         dfsg, orig.tar, deb.debian.org, ports.ubuntu.com, 404, 下载失败, sha256, conandata.yml, 上游官网
title:                  版本串带 dfsg 后缀且上游官网已死链时，源从 Debian/Ubuntu pool 的 .orig.tar.xz 取，包版本串保持任务分支同形

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Debian 系发行版对上游源码做 DFSG 重打包（剥离不可再分发文档/字体等），版本串变成 <上游版本>+dfsg.N；若干年后上游站点改版（如 LBNL crd-legacy.lbl.gov/~dhbailey/mpdist 重定向到门户页、davidhbailey.com/dhbpapers 404），原始 tarball 只剩发行版 pool 里还有副本
affected_scope:         所有 Debian 衍生版本号的任务（版本串含 dfsg/dfsg.1）；也适用于上游官网死链但 Debian 曾打包过的任意软件
verification_cmd:       curl -sI "https://deb.debian.org/debian/pool/main/<首字母>/<包名>/" | grep -o 'href="[^"]*orig[^"]*"'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           debian-pool-source
rec_description:        从 deb.debian.org/debian/pool/main/<首字母>/<包名>/ 找 <包名>_<上游版本>+dfsg*.orig.tar.*，实际下载并计算 sha256 写入 conandata.yml（同机从 deb.debian.org 与 ports.ubuntu.com 下载各验一次一致性）；包版本串保持任务分支门禁同形（如 2.3.23-dfsg.1，连字符形），不必改写成 Debian 的 +dfsg.1 形态——conan get(strip_root=True) 会剥掉 tarball 顶层目录（qd-2.3.23+dfsg.1），顶层目录名与包版本串不一致无影响
rec_command:            curl -sL -o src.tar.xz "https://deb.debian.org/debian/pool/main/q/qd/qd_2.3.23+dfsg.1.orig.tar.xz" && sha256sum src.tar.xz
rec_auto_fix:           false
rec_impl:               manual-edit

fallback_priority:      2
fallback_approach:      ubuntu-ports-mirror
fallback_description:   deb.debian.org 不可达时用 ports.ubuntu.com/pool/universe/<首字母>/<包名>/（同一重打包文件）；国内可加 mirrors.tuna.tsinghua.edu.cn/ubuntu-ports 前缀
fallback_command:
fallback_auto_fix:      false
fallback_impl:          manual-edit

# ★ 禁止策略 ★
forbid_1_pattern:       debian\.tar\.xz|\.debian\.tar\.
forbid_1_reason:        Debian 差分包是发行版维护补丁不是上游源码，把 debian/ 目录改动当源码会引入非上游内容
forbid_1_consequence:   PR 里的 sha256 对不上真实上游基线，且 CI 源 URL 校验与审方复算都会失败

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             E425
conflicts_with:         []
prerequisite_of:        []

