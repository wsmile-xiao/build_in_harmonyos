#====================================================================
# Draft: klibc-dash 2.0.14 (klibc 的 usr/dash) — kernel-style kbuild 子目录用
#        EXTRA_KLIBCCFLAGS/EXTRA_KLIBCLDFLAGS 承载「目录级配置宏」时，用 GNU make
#        命令行变量注入架构标志会把它们整体覆盖掉，导致 dash 丢失 config.h 与
#        -DBSD -DSMALL -DJOBS=0 -DHAVE_CONFIG_H，编译在 system.h 报错
# 来源: klibc-dash 2.0.14 适配（2026-09-25，本机 OHOS PC aarch64 + clang 15）
#====================================================================

id:                     DRAFT-KBUILD-EXTRA-KLIBCCFLAGS-CMDLINE-OVERRIDE
trigger_tool:           make|clang|gcc|conan
phase:                  compilation|configuration
error_signature:        expected '\)'|cannot redeclare builtin function '__builtin_constant_p'|long sysconf\(int\) __attribute__\(\(__noreturn__\)\)

severity:               2
category:               build-system|portability|headers|compile
match_keywords:         kbuild, klibc, klibc-dash, dash, usr/dash, EXTRA_KLIBCCFLAGS, EXTRA_KLIBCLDFLAGS, Kbuild.klibc, Kbuild, make command line variable, command line override, config-cppflags, -include config.h, HAVE_CONFIG_H, HAVE_SYSCONF, sysconf, sysconf macro, __builtin_constant_p, system.h, cross compile, KLIBCARCH

title:                  kernel-style kbuild 包（klibc 家族）用命令行变量注入 EXTRA_KLIBCCFLAGS 会整体覆盖目录级配置宏：dash 的 config.h 与 -DBSD/-DSMALL/-DHAVE_CONFIG_H 丢失，system.h 的 sysconf() 声明被 klibc 函数式宏展开而编译失败

root_cause:             GNU make 的命令行变量赋值优先级最高，会覆盖 Makefile 内所有同名赋值（含 := 与 +=）。klibc 的 usr/dash/Kbuild 用 EXTRA_KLIBCCFLAGS 承载三类必需内容：-I$(srctree)/$(src) -I$(objtree)/$(obj)、-include $(srctree)/$(src)/config.h、以及 $(config-cppflags)（-DBSD=1 -DSMALL -DJOBS=0 -DHAVE_CONFIG_H -DSHELL -DGLOB_BROKEN -DIFS_BROKEN）。一旦为了交叉编译在命令行写 EXTRA_KLIBCCFLAGS="--target=aarch64-linux-ohos"，这些内容全部失效：config.h 不再被 -include，HAVE_SYSCONF 未定义，于是 usr/dash/system.h 的 `long sysconf(int) __attribute__((__noreturn__));` 生效，而 klibc 的 usr/include/sys/sysconf.h 把 sysconf 定义为函数式宏 `#define sysconf(x) (__builtin_constant_p(x) ? __sysconf_inline(x) : sysconf(x))`，展开后产生 'expected )' 与 'cannot redeclare builtin function __builtin_constant_p' 两个看似无关的报错，错误行完全指向 system.h，容易误导到「上游代码不兼容」。注意 usr/klibc/Kbuild 不设置该变量，所以同一份配方对 libc 本体（klibc）构建正常——只有 dash/gzip 这类设置了 EXTRA_KLIBCCFLAGS 的子目录会踩中。
affected_scope:         kernel-style kbuild 项目（klibc 及其内嵌组件 usr/dash、usr/gzip、usr/kinit、usr/utils；其他复刻 Kbuild.klibc 的早期用户空间包）。凡是 Kbuild 中把「必需的 include/宏」放在 EXTRA_KLIBCCFLAGS/EXTRA_KLIBCAFLAGS/EXTRA_KLIBCLDFLAGS 的目录都会命中。
verification_cmd:       grep -n "EXTRA_KLIBCCFLAGS\|EXTRA_KLIBCLDFLAGS" <src>/usr/*/Kbuild <src>/Kbuild; grep -n "sysconf" <src>/usr/include/sys/sysconf.h <src>/usr/dash/system.h

rec_priority:           1
rec_approach:           inject-arch-flags-via-cc-ld-content-not-extra-vars
rec_description:        交叉编译的架构标志不要走 EXTRA_KLIBCCFLAGS/EXTRA_KLIBCLDFLAGS，而是写进 CC/LD 自身的「命令行内容」：CC="clang --target=aarch64-linux-ohos"、LD="ld.lld -m aarch64linux"（HOSTCC 保持本机 clang，hostprogs 如 mkinit/mknodes/mksyntax 在本机 OHOS 上运行）。kbuild 通过 $(CC)/$(LD) 调用工具，工具内的 --target/-m 会被正确传递；同时 cc-option、--print-libgcc-file-name、--print-file-name=include 等探测也在带 target 的 CC 下工作。若确实必须传 EXTRA_*，只能改用 Kbuild 里的 `override` 或在配方侧不设置该变量（本轮采用前者）。修复后 kbuild 的 `KLIBCRANLIB := $(RANLIB) -D` 等仍正常。
rec_command:            make KLIBCARCH=arm64 KLIBCKERNELSRC="<kernel-headers>" KLIBCASMDIR="aarch64-linux-ohos/asm" CC="clang --target=aarch64-linux-ohos" HOSTCC=clang AR=llvm-ar RANLIB=llvm-ranlib STRIP=llvm-strip NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump LD="ld.lld -m aarch64linux" PERL=perl -j1
rec_auto_fix:           false

# ═══ 知识协作 (Authorship & Provenance) ═══
# 首次记录于 klibc-dash/2.0.14 适配（archives/k/klibc-dash/2.0.14/notes.md 错误 #4）
