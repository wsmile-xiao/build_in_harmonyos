#====================================================================
# DRAFT-conandata-version-nested-sources-get-typeerror — conandata.yml
#   按版本嵌套 sources + get(self, **conan_data["sources"]) → TypeError
# 对应文档: knowledge/drafts/DRAFT-conandata-version-nested-sources-get-typeerror.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。正式编号由 graph promote 分配。
#====================================================================

id:                     DRAFT-conandata-version-nested-sources-get-typeerror
trigger_tool:           conan|conan create
phase:                  source
error_signature:        TypeError:\s*get\(\)\s*got an unexpected keyword argument\s*['"]?\d+\.\d+

severity:               2
category:               conan, conandata, packaging, recipe-structure
match_keywords:         conandata.yml, sources, 版本嵌套, get() got an unexpected
                         keyword argument, conan_data["sources"], 扁平结构,
                         strip_root, TypeError, source() method
title:                  conandata.yml 按官方惯例加版本嵌套层，与本仓库配方的
                         **conan_data["sources"] 展开写法不匹配 → source() 即 TypeError

# ═══ Layer 2: 诊断层 ═══
root_cause:             Conan 官方文档惯例 conandata.yml 按版本嵌套
                        (sources: "X.Y.Z": {url, sha256})，而本仓库通行配方写法
                        get(self, **self.conan_data["sources"], strip_root=True)
                        要求 sources 直接是扁平的 {url, sha256}。混搭时 ** 展开把
                        版本号字符串变成关键字参数名，source() 阶段直接 TypeError。
                        L0 系静态门禁不校验 conandata 内部结构，所以门禁全绿后
                        才在 conan create 运行期爆出。
affected_scope:         所有用 conandata.yml + get(**conan_data["sources"]) 范式
                        的新写配方；从 Conan 官方示例/其它仓库复制 conandata.yml
                        模板时最容易触发。
verification_cmd:       head -5 conandata.yml
                        # 嵌套结构显示 "  \"X.Y.Z\":" 一层；扁平结构直接是 url:/sha256:

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           flatten-conandata-sources
rec_description:        去掉 conandata.yml 里 sources 下的版本嵌套层，对齐仓库
                        惯例（参照 archives/n/ncdu/2.9.2/conandata.yml）。配方保持
                        get(self, **self.conan_data["sources"], strip_root=True)。
                        CI 的 Mirror fallback / Pre-download 对扁平结构兼容
                        （实测：URL 重写镜像 → 无 curl 时降级 conan 内建下载 →
                        conan create 全绿）。
rec_command:            # conandata.yml 改为：
                        # sources:
                        #   url: "https://.../x.tar.gz"
                        #   sha256: "<sha256>"
rec_auto_fix:           false
rec_impl:               flatten-conandata-sources

fallback_priority:      2
fallback_approach:      index-version-in-recipe
fallback_description:   若需保留官方嵌套结构（如多版本共存），配方改为
                        get(self, **self.conan_data["sources"][str(self.version)],
                        strip_root=True)。注意仓库内此写法少见，需确认 CI 预下载
                        环节对该结构的解析行为后再用。
fallback_command:       # get(self, **self.conan_data["sources"][str(self.version)], strip_root=True)
fallback_auto_fix:      false
fallback_impl:          index-version-in-recipe

forbid_1_pattern:       反复检查.*(url|sha256).*(正确|下载)|怀疑.*(下载地址|哈希).*(有错)
forbid_1_reason:        报错的 keyword 是版本号字符串本身，问题在 conandata 结构
                        而非 url/sha256 内容；此时反复复核下载源是错误方向。
forbid_1_consequence:   在正确的 URL/SHA256 上浪费排查轮次（实测 r2 轮即为此类）。

principles:             align-repo-convention, fail-fast-structure-check

causes:                 []
caused_by:              []
similar_to:             [E276, E483]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-conandata-version-nested-sources-get-typeerror.md
last_updated:           2026-09-29
source_event:           mdns-reflector 0.0.1 真机 shadow CI r2 轮：conandata.yml
                        带版本嵌套 → conan create source() 阶段 TypeError；扁平化
                        后 r3 轮全绿（L0/L1/L4/L5 pass）

authors:                AtomCode <noreply@atomgit.com>
