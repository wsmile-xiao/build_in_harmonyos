#====================================================================
# DRAFT: ethash-1.1.0 — lang-preflight 对非 pybind11 标记 Python 绑定库误判 mixed
#====================================================================

id:                     DRAFT-ethash-1.1.0-lang-preflight-setuptools-cmake-binding
trigger_tool:           lang-preflight|ohc-run.py
phase:                  configuration
error_signature:        task=cpp.*detected=mixed|env_unsupported.*detected_language|mixed（setuptools）|无法按 cpp 适配
severity:               2
category:               lang-preflight, binding, language-detection
match_keywords:         lang-preflight, mixed, setuptools, pyproject.toml, setup.py, bindings,
                        pybind11, boost_python, CMake, 主体语言, D.4-2, R47
title:                  lang-preflight 对 setuptools+CMake 封装 Python 绑定的 C/C++ 库误判 mixed

root_cause:             lang_detect.py 的 _manifest_scan 把根目录 pyproject.toml/setup.py 判为
                        python/setuptools（优先级高于 CMakeLists.txt），而 _detect_binding 只认
                        pybind11/boost_python/find_package(Python) 标记。ethash 的 Python 绑定
                        （bindings/python）用 setup.py 的 build_ext 子进程调用 CMake 构建 C++ 库
                        后封装（非 pybind11），不命中绑定标记 → 冲突规则（manifest=python vs
                        统计 cpp 88%）触发 → 误判 mixed → 自动写终态 env_unsupported。

affected_scope:         带 Python 绑定但绑定实现不经 pybind11 标记（setuptools build_ext→cmake、
                        cffi、手写 CPython 扩展）的 C/C++ 库；R47 D.4-2 边界规则的正确语义
                        是"按主体源码判"，工具实现标记集过窄。

verification_cmd:       python3 scripts/ohc-run.py lang-preflight ethash 1.1.0 --src $BUILD_SRC_DIR
                        # 复现: 输出 detected=mixed（当前工具版本）；人工复核主体 88% C/C++ → cpp

rec_priority:           2
rec_approach:           binding-scope-manual-override
rec_description:        语言预检工具命中 mixed 且任务为 cpp 时，先按 R47 边界规则人工复核：
                        若 Python 文件全部位于 bindings/ 或仅为 setup.py/pyproject.toml 打包
                        声明，且 .cpp/.c 主体 ≥70%，判定 cpp 继续适配；同时本地用 conan 缓存
                        gtest 构建运行上游测试（见 C5）验证适配路径有效。
rec_command:            # 人工复核证据采集:
                        find $SRC -name "*.cpp" | wc -l; find $SRC -name "*.py" | wc -l
                        # 上游测试本地运行（github/Hunter 不可达时）:
                        conan install --requires=gtest/1.17.0 -pr:h=ci/conan/profiles/ohos-aarch64 \
                          -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing -of=$PREFIX
                        GT=$(conan cache path gtest/1.17.0); # p/ 目录下取 include 与 libgtest*.a
                        clang++ -std=c++17 -I include -I $GT/include test/unittests/*.cpp \
                          build/lib/**/*.a $GT/lib/libgtest*.a -lpthread -o ethash-test
rec_auto_fix:           false
rec_impl:               manual-lang-override

# 关系
similar_to:             R47（协议 v0.8 附录 D 边界规则 D.4-2）
caused_by:              lang_detect.py _detect_binding 标记集仅 pybind11/boost_python/Python
prerequisite_of:        —
conflicts_with:         —
