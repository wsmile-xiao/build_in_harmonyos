#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: make|conan|ar
phase: build|package
error_signature: No rule to make target.*install|make:.*No such file or directory|make install:.*No rule|asprintf.*implicit-function-declaration

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: build-system|make|packaging|custom-recipe
match_keywords:         make test, No rule to make target install, custom conanfile, llvm-ar, libbytes, raw makefile, single-file C library, no configure, no make install
title: clibs 单文件 C99 库（Makefile 无 configure 无 make install 仅 make test）的自定义 Conan 配方：直接 CC 编译 bytes.c + llvm-ar 归档 libbytes.a + 手动安装头文件/静态库

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: clibs 风格单文件 C99 库的 Makefile 只提供 test 目标（编译运行断言式测试），无 configure、无 make install、无库目标；通用 Autotools/CMake 模板配方无法直接使用
affected_scope: clibs 风格单文件 C99 库（Makefile 仅 test 目标）；任何无 configure/无 make install/无库构建目标的 raw Makefile 库
verification_cmd: make test && conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing && ctest 在 test_package build 目录执行

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach:           custom-conanfile-single-file-lib
rec_description:        自定义 Conan 配方：CC 直接编译 bytes.c 并用 llvm-ar/ranlib 归档 libbytes.a，package() 手动安装头文件与静态库
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix:           false
rec_impl:               custom-build-package

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
approach: 自定义 build(): 编译器取自 Conan conf（tools.build:compiler_executables，R33 不依赖空 shell 环境变量），直接 cc -std=c99 -fPIC -c bytes.c -o bytes.o && llvm-ar rcs libbytes.a；package() 手动安装 bytes.h + libbytes.a；上游测试入口为 make test 单入口全量运行（断言式函数非框架 TEST_CASE，双口径台账时按独立断言函数计数）
verification: conan-verify G0-G4/L2/L4/L5 全通过；make test exit 0；test_package 消费者 + 鸿蒙专项测试 ctest 全通过
doc_file:               doc/E429.md
last_updated: 2026-09-18
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

