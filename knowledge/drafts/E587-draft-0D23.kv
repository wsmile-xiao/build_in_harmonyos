#====================================================================
# OHOS libc++15 默认禁用 C++20 ranges 算法（_LIBCPP_HAS_NO_INCOMPLETE_RANGES 宏开关）
# 触发/来源: scite 5.6.4 适配（scite/scintilla/lexilla 三合一 tarball）
#   24 处 std::ranges::sort/replace/find/count/transform 改写为 C++17 标准算法
#   FilePath.cxx operator<=> 改写为 compare() 映射 weak_ordering
#====================================================================

id:                     E587
trigger_tool:           clang|make
phase:                  compilation
error_signature:        no type named '.*' in namespace 'std::ranges'|
                        no member named '.*' in namespace 'std.*ranges'|
                        _LIBCPP_HAS_NO_INCOMPLETE_RANGES|
                        std::ranges::sort|std::ranges::replace

severity:               2
category:               libcxx, toolchain, cxx20, portability
match_keywords:         std::ranges, _LIBCPP_HAS_NO_INCOMPLETE_RANGES,
                        _LIBCPP_ENABLE_EXPERIMENTAL, libc++, clang 15, C++20,
                        ranges algorithm, spaceship, operator<=>, weak_ordering,
                        clang15, OHOS SDK, FilePath

title:                  OHOS libc++15 默认禁用 C++20 ranges 算法（_LIBCPP_HAS_NO_INCOMPLETE_RANGES 宏主动关停）：加 -D_LIBCPP_ENABLE_EXPERIMENTAL 即可启用，或改写为 C++17 标准算法

root_cause:             OHOS SDK 配套 libc++（clang 15.0.4，_LIBCPP_VERSION=15004）的
                        __config 中，在未定义 _LIBCPP_ENABLE_EXPERIMENTAL 且非
                        _LIBCPP_BUILDING_LIBRARY 时主动定义
                        _LIBCPP_HAS_NO_INCOMPLETE_RANGES，把整个 std::ranges 命名空间
                        的算法（sort/replace/find/count/transform 等）全部关停。上游源码
                        在 -std=c++20 下直接使用 std::ranges::* 会报
                        "no type named 'sort' in namespace 'std::ranges'"。
                        与既有 E5xx 草稿（kholidays none_of）的"裁剪版只含 C++17 版本"
                        归因不同：实际 <algorithm> 内含完整 ranges 实现，只是被该宏
                        屏蔽；实测 clang++ -std=c++20 -D_LIBCPP_ENABLE_EXPERIMENTAL
                        后 std::ranges::sort 立即可用，证实是宏开关而非头文件缺失。

affected_scope:         所有以 C++20（-std=c++20/cppstd=20）为目标、直接使用
                        std::ranges::* 算法的 OHOS PC arm64 项目（clang15/libc++15
                        工具链）；以及依赖 ranges 语义的 C++20 比较运算（spaceship）

verification_cmd:       printf '#include <algorithm>\n#include <ranges>\n#include <vector>\nint main(){std::vector<int> v{2,1}; std::ranges::sort(v); return 0;}\n' > /tmp/t.cxx && clang++ --std=c++20 /tmp/t.cxx -o /tmp/t   # 报错 no type named 'sort'；加 -D_LIBCPP_ENABLE_EXPERIMENTAL 后编译通过（scite 5.6.4 实测）

rec_priority:           1
rec_approach:           rewrite-ranges-to-std-algorithm
rec_description:        为 CI 可复现、不依赖实验宏，将 std::ranges::sort/replace/find/count/transform
                        改写为 C++17 标准算法 + begin()/end()（scite 5.6.4 采用路径，24 处）。
                        若项目可接受编译参数扩展，更省事路径为加 -D_LIBCPP_ENABLE_EXPERIMENTAL
                        直接启用完整 ranges（同样实测可行）。
rec_command:            sed 批量改写源码：std::ranges::sort(v[,cmp]) → std::sort(v.begin(), v.end()[,cmp])；
                        std::ranges::replace(c,o,n) → std::replace(c.begin(), c.end(), o, n)；
                        std::ranges::find(c,v) → std::find(c.begin(), c.end(), v)；
                        std::ranges::count(c,v) → std::count(c.begin(), c.end(), v)；
                        std::ranges::transform(r,out,f) → std::transform(r.begin(), r.end(), out, f)
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      enable-experimental-macro
fallback_description:   CI/本地 build 方法统一追加 -D_LIBCPP_ENABLE_EXPERIMENTAL 编译宏启用完整
                        ranges（实测 sort/replace/none_of 等全部恢复）；注意属实验特性开关，
                        与 libc++ 后续版本行为可能变化，仅作过渡
fallback_command:       export CXXFLAGS="$CXXFLAGS -D_LIBCPP_ENABLE_EXPERIMENTAL"; make
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       #ifdef __OHOS__.*std::ranges|使用 <experimental/ranges> 头文件
forbid_1_reason:        patches 中禁止平台宏（R8）；<experimental/ranges> 在 clang15/libc++15 上也不可用
forbid_1_consequence:   PR 被 PF5 平台宏闸拦截或编译仍失败

principles:             P014
similar_to:             DRAFT-E5xx-ohos-libcpp-missing-ranges-algorithms

