#====================================================================
# E256-draft-OSTR.kv — Shadow CI 只看 git archive HEAD 快照，dirty worktree 不会自动进入验证
#====================================================================

id:                     E256
trigger_tool:           shadow-ci|git|conan
phase:                  testing|ci
error_signature:        No packages to build|Path in CI_PACKAGES has no conanfile.py|shadow.*exit_code=1
severity:               2
category:               ci|git|workflow
match_keywords:         git archive, HEAD snapshot, worktree, dirty tree, shadow CI,
                        No packages to build, conanfile.py, staged commit, package snapshot
title:                  Shadow CI 只看 git archive HEAD 快照，dirty worktree 不会自动进入验证

root_cause:             Shadow CI 运行脚本会先执行 `git archive --format=tar HEAD`，
                        再在远端解包成干净源码树。未提交的 worktree 改动不会进入
                        这个快照，因此本地看起来已改好的包，远端可能还是旧版本。
affected_scope:         所有依赖 shadow CI 验证、且在独立 worktree 中准备包改动的
                        HarmonyOS Conan 适配流程。
verification_cmd:       在存在未提交改动时对比 `git status --short` 与 `git archive HEAD`
                        的内容，确认快照里是否真的包含目标包目录。

rec_priority:           1
rec_approach:           snapshot-before-shadow-ci
rec_description:        在跑 shadow CI 前，先把目标包改动提交到临时快照，或者复制成
                        一个干净的临时仓库再验证；不要直接指望 dirty worktree 被自动带上。
rec_command:            git add archives/o/ostra && git commit -m "shadow snapshot for ostra" && sh "$HOME/bin/run-ohos-shadow-ci.sh" archives/o/ostra/0.000709606481481482
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      clean-temp-repo
fallback_description:   如果不能提交，就把目标包目录复制到一个临时干净仓库，再按
                        shadow CI 的入口脚本运行。
fallback_auto_fix:      false

principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E256.md
last_updated:           2026-08-29
source_event:           ostra 0.000709606481481482 HarmonyOS adaptation

authors:                wxjshr <wxjshr@noreply.gitcode.com>
source_pr:
source_commit:

