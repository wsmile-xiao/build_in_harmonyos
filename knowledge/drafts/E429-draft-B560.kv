#====================================================================
# E429 — Imakefile/xmkmf 项目在无 imake 工具链环境下绕过 xmkmf 直接 clang++ 编译
# 来源事件: wmsmixer 0.5.1 OHOS 适配（上游 Imakefile/xmkmf 构建，本机与 CI 均无 imake）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E429
trigger_tool:           make|clang
phase:                  compilation
error_signature:        xmkmf: (command )?not found|imake: (command )?not found|Imake\.tmpl.*not found|Makefile generated by imake|ComplexProgramTarget.*imake

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system|toolchain|portability
match_keywords:         Imakefile, xmkmf, imake, ComplexProgramTarget, DEPXLIB, XPMLIB, XLIB,
                        make install DESTDIR, BINDIR, 老 X11 项目, dockapp, 无 imake 工具链,
                        Imake.tmpl, X11R6, 直接编译, clang++
title:                  Imakefile/xmkmf 项目在无 imake 工具链环境下绕过 xmkmf 直接 clang++ 编译

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游用 X11R6 时代的 Imakefile + xmkmf（imake）生成 Makefile 的构建体系，
                        imake/xmkmf 工具链在现代发行版与 OHOS 环境（本机与 CI）均不存在；
                        且上游 Imakefile 常硬编码 32 位编译标志（如 CC = c++ -m32），在
                        arm64 目标上不可用。Imakefile 生成的 Makefile 还引用系统 X11 安装路径
                        （/usr/X11R6 等），无法直接复用。
affected_scope:         所有使用 Imakefile/xmkmf 构建体系的 X11 老项目（dockapp 类、2000 年代
                        前后的小型 X11 工具）在无 imake 工具链的 OHOS 环境的适配。
verification_cmd:       which xmkmf imake; echo $?  # 非 0 即确认工具链缺失；
                        clang++ -O2 -fPIC -std=c++17 wmsmixer.cc -o wmsmixer \
                          -I<deps include...> -L<deps lib...> -lX11 -lXpm -lXext

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           bypass-xmkmf-direct-compile
rec_description:        不依赖 imake/xmkmf 生成 Makefile，在 conanfile.py build() 中直接调用
                        clang++ 编译上游源文件（单一源文件场景），依赖 include/lib 路径从
                        conan 依赖（libx11/libxpm/libxext 等）注入，链接 -lX11 -lXpm -lXext。
                        上游 Imakefile 的 -m32 等过时标志直接忽略。
rec_command:            clang++ -O2 -fPIC -std=c++17 ${incs} wmsmixer.cc -o wmsmixer \
                          ${libdirs} -lX11 -lXpm -lXext   # incs/libdirs 遍历 self.dependencies 注入
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      fix-xmkmf-makefile
fallback_description:   若源文件较多不适用直接编译，可将 imake 生成的 Makefile 中 X11 路径替换为
                        conan 依赖路径后复用（参考 E6341 imake 坏 Makefile 修复），或移植为
                        CMake/Makefile。
fallback_command:       sed -i 's#/usr/X11R6/##g' Makefile && make -f Makefile
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       CC = c\+\+ -m32|LD = c\+\+ -m32
forbid_1_reason:        上游 Imakefile 硬编码 32 位编译标志，arm64 OHOS 目标不可用
forbid_1_consequence:   clang 报 unsupported option '-m32' 编译失败
forbid_2_pattern:       ./xmkmf|make -f Imakefile
forbid_2_reason:        无 imake 工具链时 xmkmf 不存在，命令必然失败
forbid_2_consequence:   make 报 xmkmf: not found 卡死在配置阶段

# ═══ Layer 4: 原则引用 ═══
principles:             P011

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             E6341
conflicts_with:         []
prerequisite_of:        []

