#====================================================================
# DRAFT-ncurses-widec-bridge.kv — ncurses widec 库名桥接
# 对应的人类文档: doc/DRAFT-ncurses-widec-bridge.md
#====================================================================

id:                     DRAFT-ncurses-widec-bridge
trigger_tool:           configure
phase:                  configuration
error_signature:        checking for initscr in -lcurses\.\.\. no|AC_CHECK_LIB.*curses.*initscr|initscr.*not found|ncurses.*widec.*libname

severity:               2
category:               build-system, autotools, linking, dependency
match_keywords:         ncurses, widec, libncursesw, libcurses, AC_CHECK_LIB, initscr, symbol link, symlink, configure, autotools
title:                  ncurses --enable-widec 库名 libncursesw.a 与 configure 探测 -lcurses 不匹配，需符号链接桥接

root_cause:             ncurses --enable-widec 编译后库名为 libncursesw.a（w=wide char），
  而多数上游 configure.ac 通过 AC_CHECK_LIB(curses, initscr) 探测 -lcurses，
  两者文件名不匹配导致 configure 静默失败或跳过 curses 支持
affected_scope:         所有使用 autotools + AC_CHECK_LIB(curses, ...) 的终端/编辑器类库
  （readline、joe、nano、mutt、irssi、slang、tmate、tina 等）
verification_cmd:        conan create <lib> -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 2>&1 | grep "checking for initscr"

rec_priority:           1
rec_approach:           ncurses-widec-symlink-bridge
rec_description:        在 conanfile build() 入口（configure 之前）创建 libcurses.a → libncursesw.a 符号链接，
  并在 generate() 中注入 -I<ncurses_include> -L<ncurses_libdir> 到 CPPFLAGS/LDFLAGS
rec_command:            os.symlink(os.path.join(libdir, "libncursesw.a"), os.path.join(libdir, "libcurses.a"))
rec_auto_fix:           false
rec_impl:               conanfile-build-symlink

fallback_priority:      2
fallback_approach:      configure-arg-override
fallback_description:   若 configure 支持 --with-ncurses 参数，直接指向 libncursesw.a 路径
fallback_auto_fix:      false
fallback_impl:          configure-with-ncurses

forbid_1_pattern:       --without-ncurses|disable-curses
forbid_1_reason:        用 --without-ncurses 绕过探测会导致终端功能缺失，不解决根因
forbid_1_consequence:   功能缺失，CI 门禁 L0 功能验证失败

causes:                 []
caused_by:              []
similar_to:             E033, E028
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/DRAFT-ncurses-widec-bridge.md
last_updated:           2026-09-20
source_event:           tina/0.1.14 OHOS 适配

authors:                AtomCode (qwen38) <noreply@atomgit.com>
