#====================================================================
# DRAFT-etl-20.38.4-char-signedness-upstream-tests.kv
# 主题: aarch64/OHOS 默认无符号 char 使上游测试的"char 当作有符号"假设失败
# 来源: etl 20.38.4 上游测试复现与归因（R03 证据，task etl-20.38.4-r03-*）
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     DRAFT-etl-20.38.4-char-signedness-upstream-tests
trigger_tool:           clang|ctest|unit-test
phase:                  testing
error_signature:        Failure in test_[:alnum:]+: Expected [-0-9.]+(\+/- [-0-9.]+)? but was [-0-9.]+|
                        25 out of 8440 tests failed|
                        Expected 165 but was -91|
                        Expected 11 but was 247|
                        Expected -8.25 +/- 0.1 but was 106.95|
                        Expected 5.21 +/- 0.05 but was 167.721

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               platform, toolchain, c++, upstream-tests, char-signedness
match_keywords:         char signedness, unsigned char, signed char, -fsigned-char, plain char,
                        上游测试, upstream tests, aarch64, OHOS, char 无符号, integer promotion,
                        bit_stream, bresenham, correlation, covariance, rms, UnitTest++

# ═══ Layer 2: 诊断层 ═══
title:                  aarch64/OHOS 默认无符号 char 使上游测试的"char 当作有符号"假设失败（ETL 等 C++ 模板库上游测试套件）
root_cause:             C/C++ 中 plain char 的符号性由实现定义。aarch64（含 OHOS）默认 plain char
                        为无符号，而上游测试代码按"char 有符号"编写：把 char 用于位流存储
                        （std::array<char> 存 int8_t 负值）、坐标值（bresenham_line<char>）、
                        数值统计输入（correlation/covariance/rms 的 char 采样）。同一字节存储
                        不变，但整数提升成 0..255，比较/断言只在目标平台失败。
affected_scope:         以 CMake/UnitTest++ 等框架跑上游测试套件的 C++ 模板库，
                        若测试代码用 plain char 承载有符号数值/坐标/统计采样，
                        且在默认无符号 char 的目标（aarch64/OHOS）上运行
verification_cmd:       ./etl_tests   # 或 ctest; 复现见 rec_command 最小复现

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           upstream-test-char-signedness
rec_description:        归因为上游测试可移植性假设，而非库缺陷：不修改库、不改断言、
                        不禁用测试；用 -fsigned-char 控制组证明同套件全绿，
                        并在 signed-char 语义下运行上游测试。
rec_command:            # 复现（默认，无符号 char -> 25/60 失败）
                        cmake -B build-upstream -DBUILD_TESTS=ON -DCMAKE_CXX_COMPILER=/data/service/hnp/bin/clang++ && \
                        cmake --build build-upstream -j4 && ./build-upstream/test/etl_tests
                        # 控制组（-fsigned-char -> 8440/8440 全绿）
                        cmake -B build-upstream-signed -DBUILD_TESTS=ON -DCMAKE_CXX_COMPILER=/data/service/hnp/bin/clang++ \
                        -DCMAKE_CXX_FLAGS=-fsigned-char && \
                        cmake --build build-upstream-signed -j4 && ./build-upstream-signed/test/etl_tests
rec_auto_fix:           true
rec_impl:               use-fsigned-char-control-group

fallback_priority:      2
fallback_approach:      consumer-verification-only
fallback_description:   若上游测试套件无法在目标语义下运行，以实际消费者测试为准：
                        OHOS profile test_package 1/1 Passed 证明库本身可用，
                        上游失败不影响库交付，但需在报告中说明恢复条件。
fallback_command:       conan create . --build=missing -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       CHECK_EQUAL.*关闭|#if 0|skip\(.*test|禁用.*测试|断言.*修改.*通过
forbid_1_reason:        修改上游断言、禁用测试或宽泛排除以伪造全绿，掩盖平台差异，违反 R6/诚实归因
forbid_1_consequence:   掩蔽真实平台差异，后续平台迁移时再次踩坑且无法追溯

# ═══ Layer 4: 原则引用 ═══
principles:             R6, R11, R12

# ═══ 关系图 ═══
causes:
caused_by:
similar_to:             E2158-draft-2301
conflicts_with:
prerequisite_of:

