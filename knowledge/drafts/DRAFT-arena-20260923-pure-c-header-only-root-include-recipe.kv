#====================================================================
# DRAFT-arena-20260923-pure-c-header-only-root-include-recipe
#   无 include/ 子目录的纯 C 单头文件库（stb 风格，ARENA_IMPLEMENTATION
#   消费者模式）Conan 配方：copy 到包根 + cpp_info.includedirs=["."]
# 来源: PR feat/arena-20260923（arena 20260923 适配 HarmonyOS PC, pc2-47）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-arena-20260923-pure-c-header-only-root-include-recipe
trigger_tool:           conan|conan-verify|cmake
phase:                  packaging|configuration|testing
error_signature:        Imported target.*includes non-existent path.*/p/include|
                         conanfile\.py 缺少: build\(\) 方法|
                         conanfile\.py 缺少: export_sources\(\) 方法|
                         conanfile\.py 缺少: 补丁应用调用

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, header-only, pure-c, no-include-dir, recipe,
                        no-build-system, G1, includedirs, package-folder
match_keywords:         单头文件, header-only, ARENA_IMPLEMENTATION, stb 风格,
                        无 include 子目录, 头文件在源码根, copy 到包根,
                        includedirs=["."], package_folder, G1, no build system,
                        pure C, arena
title:                  无 include/ 子目录的纯 C 单头文件库（stb 风格）Conan 配方：
                        copy() 到头文件包根 + cpp_info.includedirs=["."]，并显式声明
                        build()/export_sources()/apply_conandata_patches 满足 G1；
                        区别于 include/ 子目录形态（E470/E321/E322）与有 .c 源文件的
                        无构建系统库（DRAFT-cobs-c）
prescan_pattern:        Imported target.*includes non-existent path.*/p/include|
                         header-only.*no include dir|ARENA_IMPLEMENTATION

# ═══ Layer 2: 根因层 (Root Cause) ═══
root_cause:             >
  库形态为"头文件在源码根、无 include/ 子目录"的 stb 风格纯 C 单头文件库：
  ① init-build 默认 autotools 模板与无构建系统库不匹配，conan create 直接失败；
  ② conan-verify G1 硬性要求配方文本含 build()/export_sources()/apply_conandata_patches
     （即使 0 补丁、无编译）；
  ③ 照抄既有 header-only 条目的 copy(dst="include")+includedirs=["include"] 形态，
     在无 include/ 子目录的库上造成包内路径空洞——CMakeDeps 生成的
     INTERFACE_INCLUDE_DIRECTORIES 指向不存在的包路径，test_package 配置期报错。

affected_scope:         所有"头文件在源码根、无 include/ 子目录"的纯 C 单头文件库
                        （stb 风格，ARENA_IMPLEMENTATION 消费者模式；tsoding 系单头库等）

# ═══ Layer 3: 方案层 (Solution) ═══
rec_priority:           1
rec_approach:           copy-to-package-root-with-includedirs-dot
rec_description:        【header-only 包根形态】conanfile.py：
                        package_type="header-library"; settings=os/compiler/build_type/arch;
                        no_copy_source=True; export_sources()=export_conandata_patches(self);
                        source()=get(strip_root=True)+apply_conandata_patches(self);
                        build()=pass（header-only，无伪造编译日志 R34）;
                        package()=copy("arena.h", src=source_folder, dst=package_folder)
                        +copy("LICENSE*", dst=package_folder, keep_path=False);
                        package_id()=self.info.clear();
                        package_info(): cpp_info.libs=[], cpp_info.includedirs=["."]。
                        消费者 test_package：#define ARENA_IMPLEMENTATION + #include "arena.h"
                        真实调用 API（R34）。
rec_command:            python3 scripts/ohc-run.py conan-verify <sw> <ver>
rec_auto_fix:           false
rec_impl:               conan-recipe-header-only-root-include

fallback_priority:      2
fallback_approach:      use-include-subdir-recipe
fallback_description:   若上游确有 include/ 子目录 → 走 E470/E321/E322 include/ 形态；
                        若有 .c 源文件需编译 → DRAFT-cobs-c 自定义编译；
                        若有真实 .a 产物 → DRAFT-enet（勿误用 header-only）
fallback_command:       （视库形态选择）
fallback_auto_fix:      false
fallback_impl:          conan-recipe

principles:             P004, P014
