#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E434.kv，填写各字段
# 对应的人类文档: doc/E434.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E434
trigger_tool: ld
phase: linking
error_signature: undefined symbol: sqlite3_vfs_find|undefined symbol: sqlite3_release_memory|undefined symbol: sqlite3_vfs_register

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: linking,sqlite,lib-order,dependency-graph
match_keywords: sqlite3_vfs_find, sqlite3_release_memory, undefined symbol, nss bundled sqlite3, -L order
title: nss 包内裁剪版 libsqlite3.so 按 -L 顺序遮蔽独立 sqlite3 静态库

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: nss 包 lib/ 里带了自用的 libsqlite3.so（版本脚本裁剪导出，缺 sqlite3_vfs_find/vfs_register/release_memory），而独立 sqlite3/3.49.1 包只有静态 libsqlite3.a；pkg-config 按模块顺序输出 -L，nss 的 libdir 排在 sqlite3 之前时 -lsqlite3 命中前者，camel-db.c 等需要 vfs 注册的代码链接失败
affected_scope: 同时使用 nss 与 sqlite3 的 pkg-config 驱动工程（camel、evolution-data-server 系）
verification_cmd: llvm-readelf --dyn-syms <nss>/lib/libsqlite3.so | grep -c sqlite3_vfs_find（0 即裁剪版）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: reorder-link-modules
rec_description: 把 pkg_check_modules 里的 sqlite3 提到 nss 之前，使 -L 顺序让独立 sqlite3（静态归档）先命中
rec_command: pkg_check_modules(CAMEL REQUIRED gio-2.0 gmodule-2.0 sqlite3>=... ${mozilla_nss} ${mozilla_nspr})
rec_auto_fix: false
rec_impl: 

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: -lnss.*-lsqlite3
forbid_1_reason: nss libdir 在 sqlite3 libdir 之前时 -lsqlite3 会命中裁剪版
forbid_1_consequence: 链接期 undefined symbol: sqlite3_vfs_find
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P001,P007

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

