#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E607
trigger_tool: conan
phase: configuration
error_signature: Could not detect Ninja v1.8.2 or newer|Error loading shared library libc\+\+_shared\.so|Error relocating /data/service/hnp/bin/cmake

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: ohos,toolchain,conan,environment
match_keywords: libc++_shared.so, ninja, cmake, LD_LIBRARY_PATH, llvm, aarch64-linux-ohos, Could not detect Ninja, OHOS SDK
title: OHOS SDK 的 ninja/cmake 依赖 libc++_shared.so，必须向 LD_LIBRARY_PATH 注入 llvm/lib/aarch64-linux-ohos（否则报 Could not detect Ninja / Error relocating）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS SDK 的 ninja/cmake 二进制链接 libc++（libc++_shared.so），该库位于 /data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib/aarch64-linux-ohos/ 而非 llvm/lib；LD_LIBRARY_PATH 缺该子目录时 ninja 启动失败（meson 报 Could not detect Ninja）、cmake 报 Error relocating symbol not found
affected_scope: 所有在 OHOS SDK 环境用 conan create 调 meson/ninja/cmake 的软件适配（目录名含 aarch64-linux-ohos 子路径）
verification_cmd: export LD_LIBRARY_PATH=/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib/aarch64-linux-ohos:$LD_LIBRARY_PATH && ninja --version （修复前 rc=127 libc++_shared.so 加载失败，修复后 1.13.1）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: conanfile 的 _build_environment()/build() 中把 llvm/lib/aarch64-linux-ohos 目录 prepend 进 LD_LIBRARY_PATH（Environment.prepend_path 或 os.environ 前缀），并保证 meson configure/compile 及 test_package 的子进程均继承该环境
rec_description: 与 E540（PATH 缺 /data/service/hnp/bin）同族但不同变量：E540 是 PATH，本条是 LD_LIBRARY_PATH 且指向 SDK 的 aarch64-linux-ohos 子目录；libmalcontent 0.10.2 与 test_package 同时修复先例
rec_command:            export LD_LIBRARY_PATH=/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib/aarch64-linux-ohos:$LD_LIBRARY_PATH
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
