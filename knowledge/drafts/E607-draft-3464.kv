#====================================================================
# E607 — 上游 CMake 平台分支只判 Linux/Darwin/Windows，HarmonyOS 下
#        漏编 POSIX 源文件导致链接期 undefined symbol
# 用法: 验证后由主编提升为正式 E607 条目
# 对应的人类文档: knowledge/drafts/E607-draft-3464.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E607
trigger_tool: cmake|make|clang|ld
phase: compilation|linking
error_signature: ld.lld: error: undefined symbol: osqp_start_interrupt_listener|undefined symbol: osqp_is_interrupted|undefined symbol: osqp_end_interrupt_listener

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform, detection, build-system, cmake, linking
match_keywords: CMAKE_SYSTEM_NAME, HarmonyOS, OHOS, IS_LINUX, IS_MAC, target_sources, undefined symbol, interrupt_unix.c, 平台分支漏编
title: 上游 CMake 平台分支只判 Linux/Darwin/Windows，HarmonyOS 下漏编 POSIX 源文件导致链接期 undefined symbol

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游以 CMAKE_SYSTEM_NAME 精确匹配 Linux/Darwin/Windows 推导 IS_LINUX/IS_MAC/IS_WINDOWS，再据此挑选平台源文件。OHOS 上 CMAKE_SYSTEM_NAME=HarmonyOS，三个变量全 OFF，POSIX 实现源文件被静默剔除；而功能开关（如 OSQP_ENABLE_INTERRUPT）默认 ON 且公共代码无条件引用其符号 → 链接期 undefined symbol。
affected_scope: 所有用 CMAKE_SYSTEM_NAME 字符串匹配做平台判定并按分支挑选源文件的 CMake 工程（osqp 1.0.0 src/CMakeLists.txt 中断监听为实测案例）
verification_cmd: grep -n 'CMAKE_SYSTEM_NAME STREQUAL "Linux"' CMakeLists.txt; cmake --build build 2>&1 | grep 'undefined symbol'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: cmake-platform-branch-add-harmonyos-ohos
rec_description: 在构建系统补丁里为该分支同时追加 HarmonyOS 与 OHOS 两种系统名（覆盖 conan 映射前后的差异），把 POSIX 实现纳入编译。禁止改用 __OHOS__ 源码宏（R8/PF5 禁补丁引入平台宏）。
rec_command: elseif(IS_MAC OR IS_LINUX OR CMAKE_SYSTEM_NAME STREQUAL "HarmonyOS" OR CMAKE_SYSTEM_NAME STREQUAL "OHOS")
rec_auto_fix: false
rec_impl: cmake-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: map-harmonyos-into-is-linux
fallback_description: 在平台探测处把 HarmonyOS 归入 IS_LINUX，一处覆盖所有下游分支；但会连带启用 -lrt -ldl 等 Linux 专属链接项，需先确认目标 sysroot 具备这些库。
fallback_command:
fallback_auto_fix: false
fallback_impl: cmake-patch

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

