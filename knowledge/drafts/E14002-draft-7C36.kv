#====================================================================
# E14002-draft-7C36.kv — Conan ncurses 为 opaque API，WINDOW 内部字段不可访问
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E14002
trigger_tool:           clang|cc|gcc
phase:                  compilation
error_signature:        member access into incomplete type 'WINDOW'|incomplete type 'WINDOW' \(aka '_win_st'\)|forward declaration of '_win_st'|_maxx|_maxy|_clear

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, compat, headers, portability
match_keywords:         NCURSES_OPAQUE, opaque, WINDOW, _win_st, incomplete type, getmaxx, getmaxy, clearok, ncurses, curses, conan dependency
title:                  依赖的 ncurses 以 NCURSES_OPAQUE=1 生成头文件：访问 WINDOW 内部字段编译失败，需换 getmaxx()/getmaxy()/clearok() 公共 API

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             制品仓的 ncurses 包按 --enable-opaque-curses 生成头文件，
                        其 curses.h 中 #define NCURSES_OPAQUE 1，struct _win_st 不再暴露
                        （仅 typedef struct _win_st WINDOW;）。上游程序若直接读写
                        stdscr->_maxx / stdscr->_maxy / win->_clear 等内部字段，在编译期
                        即报 "member access into incomplete type 'WINDOW'"。
                        宿主发行版的 ncurses 通常非 opaque，因此本地手工编译可能通过、
                        而 conan 构建失败——易被误判为编译器差异。
affected_scope:         所有链接制品仓/Conan 提供的 ncurses、且直接访问 WINDOW 内部字段的
                        curses 程序（终端类、TUI 工具）。
verification_cmd:       grep -n "NCURSES_OPAQUE" <ncurses_pkg>/include/curses.h → "#define NCURSES_OPAQUE       1"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           opaque-api-translate
rec_description:        用公共 API 等价替换内部字段访问：
                        win->_maxx / win->_maxy → getmaxx(win) / getmaxy(win)（返回值完全相同）；
                        win->_clear = TRUE → clearok(win, TRUE)（语义即“强制整屏重绘”标志）。
                        两者都是 ncurses 长期稳定的公共接口，改动最小且行为不变。
rec_command:            maxx = getmaxx(stdscr); maxy = getmaxy(stdscr); clearok(main_window, TRUE);
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      rebuild-ncurses-non-opaque
fallback_description:   自建一份 --disable-opaque-curses 的 ncurses 作为依赖（或在依赖包中提供
                        非 opaque 头文件）。成本高：需重编依赖并重新发布，且可能影响其它消费者；
                        仅在无法修改上游源码时使用。
fallback_command:       ./configure --disable-opaque-curses --enable-widec --without-shared
fallback_auto_fix:      false
fallback_impl:          configure-option

forbid_1_pattern:       #define\s+NCURSES_OPAQUE\s+0
forbid_1_reason:        用宏强开内部结构只能骗过头文件，与已编译的库在结构布局约定上不一致
forbid_1_consequence:   未定义行为；一旦库对其内部结构做了隐藏化改动即崩溃

