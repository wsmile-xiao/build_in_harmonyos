#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E601.kv，填写各字段
# 对应的人类文档: doc/E601.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E601
trigger_tool: ohc-run.py finish (Step1 refresh-patch --auto)
phase: finish
error_signature: 补丁数不一致: manifest=0 vs disk=[0-9]+|0003-configure.ac.patch.*\+1097|G0 干净构建验证失败.*No such file or directory

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: conan, build-system
match_keywords:         refresh-patch, prebuild, autoreconf, 生成物误判, 零补丁, G0 干净构建
title: refresh-patch 把 prebuild/autoreconf 生成物误判为源码补丁

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游 tarball 无预生成 configure 的项目（如 povray 需 unix/prebuild.sh、abiword 需 autoreconf -fi）在探索树里会生成大量构建系统文件（根 Makefile.am/Makefile.in/configure.ac 副本、aclocal.m4、unix/config/config.guess 等）；refresh-patch --auto 对比 orig 与 work 差异时把这些【构建期生成物】全部打成补丁；但配方 build() 里会重新跑 prebuild/autoreconf 生成它们，补丁冗余且不含最终 configure 脚本，导致 G0 干净构建验证失败（./configure: No such file or directory）
affected_scope: 所有 GitHub tag 无预生成 configure 的 autotools 项目（需 prebuild.sh/autoreconf 生成 configure 的归档）
verification_cmd: ls archives/<软件>/<版本>/patches/ 2>/dev/null | wc -l  # 非 0 而 manifest patches_applied 为 [] 即误判补丁

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: 配方在 build() 内跑 prebuild/autoreconf 的项目应保持【零补丁】设计：删除 refresh-patch 误生成的 patches/ 目录、清理 manifest 的 patch_generation/patch_classification 块、manifest patches_applied 保持 []；G0 干净构建验证的 ⚠️ 警告对 conan 配方流程可接受（conan-verify G2 才是权威门禁）
rec_description:        删除 refresh-patch 误生成补丁保持零补丁设计，prebuild/autoreconf 逻辑内联配方 build()
rec_command:            rm -rf ${ARCHIVE_DIR}/patches && git -C ${ARCHIVE_DIR} add -A
rec_auto_fix:           false
rec_impl:

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
keywords: refresh-patch, prebuild, autoreconf, 生成物误判, 零补丁, patch_classification, G0 干净构建, configure.ac
software: povray/3.7.0.10
doc_file:               doc/E601.md
last_updated: 2026-09-03
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

