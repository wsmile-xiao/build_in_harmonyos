#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E577.kv，填写各字段
# 对应的人类文档: doc/E577.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E577
trigger_tool: conan
phase: patching
error_signature: hunk no.[0-9]+ doesn't match source file at line|doesn't match source file at line|Apply patch failed

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: build-system, tooling
match_keywords: patch-ng, hunk, doesn't match source file, apply patch, conan create, offset
title:

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: patch-ng 是 Conan 的补丁器，严格按 hunk 行号定位，不做 GNU patch 式上下文偏移搜索；同一文件被多个补丁依次修改时，前序补丁的行数增删（本例 configure 被前序补丁改动 +16 行）使后续补丁整块失配，apply 返回 False；而同样两个补丁用 GNU patch 顺序应用却成功——差异只在补丁器实现
affected_scope: 所有把同一目标文件拆成多个补丁的 conan recipe（configure 等预生成文件尤甚）
verification_cmd: cd 目标文件所在目录 && python3 -c 'import patch_ng; p=patch_ng.fromfile("patches/x.patch"); print(p.apply(strip=1))'（False 即复现）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: merge_patches_per_file
rec_description: 把同一目标文件的多个补丁合并为一个补丁：所有 hunk 行号统一基于原始文件，patch-ng 一次应用即通过；不要依赖 patch 的模糊偏移能力
rec_command: diff -u --label a/configure --label b/configure orig/configure work/configure > patches/0003-configure.patch
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E041,E071
conflicts_with:         []
prerequisite_of:        []

