#====================================================================
# E543-draft-B4CF.kv — 无 VPATH 的老 Makefile.in 在 Conan out-of-source
# 构建下报 "No rule to make target"（compface 1.5.2 实证）
# 对应的人类文档: knowledge/drafts/E543-draft-B4CF.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E543
trigger_tool:           make
phase:                  compilation
error_signature:        No rule to make target '[a-z0-9._-]+\.c', needed by '[a-z0-9._-]+\.o'|No targets specified and no makefile found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               autotools, build-system
match_keywords:         No rule to make target, VPATH, in-source, out-of-source, srcdir, Makefile.in, build-release, folders.source
title:                  无 VPATH 支持的老 Makefile.in 在 Conan 默认 out-of-source 构建下找不到源文件

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             2010 年代早期及更老的 Makefile.in 把编译规则写成 foo.o: foo.c（无 $(srcdir) 前缀、无 VPATH 支持），Conan 2 默认 out-of-source 布局（basic_layout，构建目录与源码目录分离），make 在构建目录里找不到源文件。
affected_scope:         老 automake/手写 Makefile.in 且规则不含 $(srcdir) 的软件（compface 1.5.2 实证：cmain.o: cmain.c）在 conan create 的 out-of-source 构建下必现
verification_cmd:       grep -c 'srcdir' Makefile.in 为 0 且 Makefile 规则形如 foo.o: foo.c 即中招

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           in-source-layout
rec_description:        conanfile 的 layout() 改为源码目录就地构建（folders.source 与 folders.build 同置 "."），使 configure/make 与源码同目录，老 Makefile 规则原样可用
rec_command:            def layout(self): self.folders.source = "."; self.folders.build = "."
rec_auto_fix:           false
rec_impl:               conanfile-layout

# 回退方案
fallback_priority:      2
fallback_approach:      vpath-patch-makefile
fallback_description:   给 Makefile.in 补 $(srcdir) 前缀或 VPATH 支持（改动面大、需逐规则核对，不推荐）
fallback_command:
fallback_auto_fix:      false
fallback_impl:          source-patch

# ★ 禁止策略 ★
forbid_1_pattern:       sed -i .*Makefile\.in
forbid_1_reason:        老 Makefile.in 无 VPATH 语义，靠 sed 加 srcdir 前缀需逐规则核对，漏一处即隐性错构建
forbid_1_consequence:   构建产物混入错误对象文件或半成品，问题后移到测试/运行期

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             E519, E434
conflicts_with:         []
prerequisite_of:        []

