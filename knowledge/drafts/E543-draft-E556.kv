# 对应的人类文档: doc/E430.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: cmake|make|conan
phase: configuration|compilation
error_signature: glib-mkenums: No such file or directory|Error 126|find_program

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: cmake, toolchain, conan, ohos
match_keywords: glib-mkenums,No such file or directory,find_program
title: find_program 缓存断链符号链接 (glib-mkenums) 导致 idotypebuiltins 生成失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: CI bundle 的 /data/service/hnp/bin/glib-mkenums 是指向旧版阐库 glib_2.38.2 的断链符号链接; CMake find_program 在 configure 期按 PATH 缓存该坏路径, build 期执行失败 (Error 126)
affected_scope: 所有依赖 glib 构建工具 (glib-mkenums/glib-genmarshal/gdbus-codegen) 的 CMake 库在含阐库 bundle 的 OHOS 环境; ayatana-ido 0.10.4 实测
verification_cmd: conan create 成功生成 idotypebuiltins.h 并完整构建; test_package ctest PASS

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach:           cmaketoolchain-variable-override-find_program-cache
rec_description:        CMakeToolchain 变量显式覆盖 find_program 缓存的坏路径: tc.variables["GLIB_MKENUMS"] 指向 glib 包内真实脚本绝对路径, 并把 glib 包 bin/ 前置 PATH 兜底, 绕过断链符号链接缓存
rec_command:            tc.variables["GLIB_MKENUMS"] = os.path.join(self.dependencies["glib"].package_folder, "bin", "glib-mkenums"); env.prepend_path("PATH", glib_bin)
rec_auto_fix:           false
rec_impl:               conanfile-cmaketoolchain-variable-injection

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      patch-upstream-find_program-hints
fallback_description:   若变量注入仍不生效，退而 patch 上游 CMakeLists 为 find_program 增加 HINTS 指向包内脚本路径（需走补丁流程，R1 参数最少化下仅在注入不可行时使用）
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       /data/service/hnp/bin/.*=.*rm -f|file://|/storage/
forbid_1_reason:        依赖环境清理 (rm -f 坏链接) 不可移植且越权；硬编码绝对路径违反 R39 并破坏原子性审计
forbid_1_consequence:   其他机器/CI 上不生效，或 W4 审计判 P1 拒绝合入
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P004

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
approach: conanfile generate() 用 tc.variables["GLIB_MKENUMS"] 显式指向 glib 包内真实脚本绝对路径, 覆盖 find_program 缓存的断链符号链接; 同时把 glib 包 bin/ 前置到 PATH
keywords: find_program, glib-mkenums, idotypebuiltins, CMakeCache, GLIB_MKENUMS, broken symlink, dangling, /data/service/hnp/bin, CMakeToolchain variables
