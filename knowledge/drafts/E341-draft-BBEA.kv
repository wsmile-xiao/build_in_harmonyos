#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E341.kv，填写各字段
# 对应的人类文档: doc/E341.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E341
trigger_tool: make|conan|test
phase: installation|testing
error_signature: bind: Operation not permitted|make: install: No such file or directory|install: command not found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: ohos,portability,testing,packaging
match_keywords: SOCKET99_SKIP_UNIX,AF_UNIX,bind,Operation not permitted,install,make test,conan.tools.files.copy
title: Evidence-bound OHOS test gating and Conan-native packaging for minimal Make projects

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: On the OHOS PC runner, pathname AF_UNIX bind is denied even in a user-writable directory, while the minimal device toolset may not provide the GNU install utility. A small Make project can therefore compile successfully but fail in its upstream socket harness or Conan package() stage for two independent platform/tool boundaries.
affected_scope: Minimal C libraries with Makefile-based socket integration tests and install targets, especially Conan recipes built on restricted OHOS/HMDFS workers.
verification_cmd: command -v install; run the unmodified upstream socket harness in a writable user directory and record the errno; then run the same harness with an explicit capability gate, build the package with conan create, and execute an installed-package consumer.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: evidence-bound-test-gate-plus-conan-copy
rec_description: Probe the platform capability first, gate only the proven unsupported upstream test subset with an explicit environment variable, preserve all supported tests, and use conan.tools.files.mkdir/copy for package outputs when install is unavailable.
rec_command: SOCKET99_SKIP_UNIX=1 make -j1 test; conan create <recipe-dir> --build=missing -pr:h=<ohos-profile> -pr:b=<ohos-profile>
rec_auto_fix: false
rec_impl: manual-review

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: platform-native-upstream-test
fallback_description: If a later OHOS environment proves pathname AF_UNIX bind and install available, run the unchanged upstream test harness and retain the upstream install path; otherwise keep the evidence-bound gate and Conan-native packaging.
fallback_command: make -j1 test
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: skip.*test.*||true|make.*test.*||true|return 0.*unsupported|chmod.*install.*system
forbid_1_reason: Do not turn an unverified failure into a pass, skip the whole suite, or change system permissions to conceal a platform boundary.
forbid_1_consequence: The package would lose supported-socket coverage or report a false portability result.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P001

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

