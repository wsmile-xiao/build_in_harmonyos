#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E257.kv，填写各字段
# 对应的人类文档: doc/E257.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E257
trigger_tool:           clang|cmake|ctest|conan|runtime
phase:                  testing|runtime
error_signature:        reference is not finite|std::log.*-inf|std::log10.*-inf|std::log2.*-inf|long double.*(128|16 bytes)|numeric_limits<long double>::min

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               ohos, libc, numerical, testing, portability
match_keywords:         HarmonyOS PC, aarch64, long double, 128-bit, std::log, std::log10, std::log2, non-finite oracle, std::isfinite, finite input
title:                  OHOS long-double math references can be non-finite for representable inputs

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             On HarmonyOS PC aarch64 the C++ long-double representation has extended range, but the device libc math reference functions can return -inf for representable subnormal-range inputs such as 1e-500L and numeric_limits<long double>::min(). An upstream comparison against that reference is not a valid oracle for those cases; this is a platform libc/reference limitation, not evidence that the library implementation itself produced the wrong value.
affected_scope:         C/C++ numerical libraries whose upstream tests compare extended-precision constexpr or runtime algorithms against std::log, std::log10, std::log2, or similar device-libc reference functions at the edge of the long-double range.
verification_cmd:       Check sizeof(long double) and numeric_limits<long double>::min(), evaluate std::log/std::log10/std::log2 for 1e-500L and min(), require explicit finite-oracle evidence, then rerun the complete upstream suite and an independent consumer regression.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           finite-oracle-guard-with-independent-regression
rec_description:        Keep every upstream test active, guard only the comparison when the device reference is non-finite, emit a named skip containing the exact function and input, and validate the library result through the remaining upstream cases plus a consumer check that uses a finite ordinary-range oracle.
rec_command:            cmake --build build --target gcem_tests && for t in build/tests/*.test; do "$t" || exit $?; done
rec_auto_fix:           false
rec_impl:               conan-recipe-and-minimal-upstream-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      platform-specific-oracle
fallback_description:   If the upstream contract permits it, add a target-specific oracle file or a platform-specific expected value generated from a verified independent implementation. Do not convert a real library failure into a skip and do not weaken the comparison tolerance globally.
fallback_command:       Record the exact input, reference output, implementation output, type width, and libc/toolchain versions before selecting a platform oracle.
fallback_auto_fix:      false
fallback_impl:           manual-diagnosis

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       ignore.*test|return.*0|true.*skip.*all|ctest.*\|\|.*true
forbid_1_reason:        A blanket skip or masked exit code removes the distinction between a bad device oracle and a failing library implementation.
forbid_1_consequence:   The package can report success while ordinary-range or edge-range numerical behavior is unverified.
forbid_2_pattern:       non-finite.*reference.*skip.*without.*input|skip.*without.*reason
forbid_2_reason:        A skip is acceptable only for the exact reference call proven invalid on the target; the reason and input must remain auditable.
forbid_2_consequence:   Future libc or toolchain changes can silently reduce coverage without detection.

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

