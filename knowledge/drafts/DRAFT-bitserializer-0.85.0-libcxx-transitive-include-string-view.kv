#====================================================================
# DRAFT-bitserializer-0.85.0-libcxx-transitive-include-string-view.kv
# 主题: OHOS libc++ 裁剪传递包含，头文件需显式 include <string_view>
# 来源: bitserializer 0.85.0 首轮适配（conan create test_package 消费者编译）
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     DRAFT-bitserializer-0.85.0-libcxx-transitive-include-string-view
trigger_tool:           clang|cmake|conan
phase:                  compilation
error_signature:        no member named 'basic_string_view' in namespace 'std'|
                        'TChar' does not refer to a value|variable has incomplete type 'void'.*string_view

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               platform, libcxx, headers, portability
match_keywords:         string_view, basic_string_view, transitive include, libc++,
                         OHOS, header, include

# ═══ Layer 2: 诊断层 ═══
title:                  OHOS libc++ 裁剪传递包含，使用 basic_string_view 的头文件必须显式 include <string_view>
root_cause:             libcxx-ohos 启用了传递包含裁剪（transitive include 削减），
                         上游头文件仅 include <cstddef> 等少量标准头却直接使用
                         std::basic_string_view，依赖其它标准头间接注入 <string_view>
                         的写法在 OHOS 上失效，编译报 basic_string_view 不在 std 命名空间。
affected_scope:         header-only 库或在公开/内部头直接使用 std::string_view /
                         basic_string_view 但未显式 include <string_view> 的 C++17 库
verification_cmd:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing
                         # 复现: grep -L '#include <string_view>' <header> && 该 header 用 basic_string_view

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           explicit-string-view-include
rec_description:        在使用 std::basic_string_view / std::string_view 的头文件中
                         显式添加 #include <string_view>（C++17），消除对传递包含的依赖；
                         以补丁形式固化进 conandata.yml patches。
rec_command:            在受影响的公共/内部头文件顶部补 #include <string_view>
rec_auto_fix:           true

fallback_priority:      2
fallback_approach:      audit-transitive-includes
fallback_description:   若多个头文件受影响，逐一审计所有用 string_view 的头文件并统一补齐 include。

# ★ 禁止策略 ★
forbid_1_pattern:       using namespace std;.*string_view|typedef.*string_view
forbid_1_reason:        掩盖而非修复缺失 include，且污染命名空间
forbid_1_consequence:   其他平台仍可编译但 OHOS 修复不彻底，消费者报错再现

# ═══ Layer 4: 原则引用 ═══
principles:             P003
causes:
caused_by:
similar_to:             E130, E455
conflicts_with:
prerequisite_of:

# ═══ 元数据 ═══
doc_file:               knowledge/drafts/DRAFT-bitserializer-0.85.0-libcxx-transitive-include-string-view.md
last_updated:           2026-09-03
authors:                pc1-5
source_event:           bitserializer 0.85.0 首轮适配, test_package 消费者编译