#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E582.kv，填写各字段
# 对应的人类文档: doc/E582.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E582
trigger_tool: lit|llvm-lit|cmake|ninja
phase: testing
error_signature: fatal: Did not find (count|not|FileCheck) in|llvm-lit.*(cannot find|did not find)|map_config|Unable to find.*lit.*suite

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: ohos, testing, llvm, detection
match_keywords: llvm-lit, lit, map_config, FormatTests, FileCheck, llvm-config, count, not, LLVM_INCLUDE_TESTS, clang/test/Format, 构建目录, 源码树
title: llvm-lit 上游测试套件在源码构建下的两个隐式执行前提：构建目录须位于源码树内 + 测试工具目标（count/not/llvm-config/FileCheck）须一并构建

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: llvm-lit 以构建目录为基准解析测试套件（其 map_config 按 bdir/../<子项目> 定位源码目录），构建目录放在源码树外时套件无法定位；同时 lit 的 RUN 行依赖 count/not/FileCheck/llvm-config 等测试工具，未列入构建目标时 lit 直接 fatal 退出（Did not find count in .../bin）——两者都会让上游测试看似不存在或无法执行
affected_scope: 以 llvm-lit 为测试框架、采用源码构建（非 SDK 工具链）的 LLVM 家族包，及任何需要执行 LLVM lit 套件的三方库
verification_cmd: ls build-ohos/bin/llvm-lit build-ohos/bin/FileCheck build-ohos/bin/count build-ohos/bin/not build-ohos/bin/llvm-config && cd build-ohos && bin/llvm-lit -sv ../clang/test/Format

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: in-source-build-dir-with-test-tools-targets
rec_description: 把构建目录放在源码树内（如 source_folder/build-ohos），保证 llvm-lit 的 bdir/../<子项目> 可解析；构建目标列表必须包含测试工具 count/not/FileCheck/llvm-config 与单测目标（如 FormatTests）；随后单测与 lit 套件即可真实运行并回填通过率
rec_command: cmake --build build-ohos --target clang-format FileCheck FormatTests count not llvm-config -j 4
rec_auto_fix: false
rec_impl: documentation

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: standalone-lit-with-injected-site-config
fallback_description: 构建目录无法置于源码树内时，参考 E387 的自包含替换式 lit.cfg.py（注入 site 属性）独立运行 lit 套件
fallback_command:
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             [E387,E286,E581]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E582.md
last_updated: 2026-09-18
source_event:           clang-format-11 11.1.0 适配：lit 首行 fatal: Did not find count；补齐 count/not/llvm-config/FileCheck 目标并把构建目录置于源码树内后，FormatTests 760/760、clang/test/Format 21/21 通过

# ═══ 知识协作 (Authorship & Provenance) ═══
