#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:                openharmony-pc-adaptor <adaptor@openharmony.pc>
source_pr:              "!10604"
source_commit:

