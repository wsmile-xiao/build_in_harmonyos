#====================================================================
# E634.kv (draft) — setuptools_scm 无法从发布 tarball 取版本，需注入 PRETEND_VERSION
#====================================================================

id:                     E634
trigger_tool:           pip|python|install
phase:                  installation
error_signature:        LookupError: setuptools-scm was unable to detect version|SETUPTOOLS_SCM_PRETEND_VERSION|VCS_VERSIONING_PRETEND_VERSION|error: metadata-generation-failed

severity:               2
category:               build-system, packaging, python, pip, portability
match_keywords:         setuptools_scm, SETUPTOOLS_SCM_PRETEND_VERSION, use_scm_version, unable to detect version, metadata-generation-failed, git archive, release tarball, pyproject.toml
title:                  setuptools_scm 包从发布 tarball 构建时取不到版本，需注入 SETUPTOOLS_SCM_PRETEND_VERSION

root_cause:             pyproject.toml 声明 setuptools_scm 为版本来源（setup.py 里 use_scm_version=True），
                        版本是从 git tag 推导的。配方的 source() 用的是上游发布 tarball（git archive 产物，
                        不含 .git 目录），构建时没有 VCS 可读，setuptools_scm 抛 LookupError，pip 报
                        metadata-generation-failed，构建在"生成元数据"阶段就终止。
affected_scope:         所有以 setuptools_scm（或同类 VCS 版本插件）为版本来源、且由配方从发布 tarball 构建的
                        Python 包。tarball 若带 .git_archival.txt 且配置了 archival 支持可豁免，但上游多数
                        发布包并不包含它。
verification_cmd:       python3 -m pip install --no-deps --no-build-isolation --prefix=$HOME/tmp/pfx <源码目录>
                        # 不注入时: LookupError: setuptools-scm was unable to detect version for <源码目录>
                        # 注入 SETUPTOOLS_SCM_PRETEND_VERSION=<version> 后: Successfully installed

rec_priority:           1
rec_approach:           inject-pretend-version-env
rec_description:        在调用 pip 构建时给子进程注入 SETUPTOOLS_SCM_PRETEND_VERSION=<本配方 version>，
                        让 setuptools_scm 跳过 VCS 探测直接采用配方声明的版本
rec_command:            SETUPTOOLS_SCM_PRETEND_VERSION=4.3.1 python3 -m pip install --no-deps
                        --no-build-isolation --prefix=<私有 prefix> <源码目录>
rec_auto_fix:           false
rec_impl:               recipe-subprocess-env

fallback_priority:      2
fallback_approach:      switch-source-to-vcs-checkout
fallback_description:   改用带 .git 的完整 checkout（或在 source() 里补 .git_archival.txt / 写 PKG-INFO），
                        代价大且依赖网络，通常不如注入环境变量直接
fallback_command:       git clone --depth 1 --branch 4.3.1 https://gitlab.com/anarcat/undertime undertime-src
fallback_auto_fix:      false
fallback_impl:          vcs-checkout

forbid_1_pattern:       手改 setup.py/pyproject.toml 把版本写死成字面量
forbid_1_reason:        改动上游源码来绕过构建期问题，破坏源码一致性，后续升级容易漏改
forbid_1_consequence:   版本号与上游 tag 脱钩，配方与源码不一致
forbid_2_pattern:       pip install 后手工拼接/伪造 dist-info 元数据
forbid_2_reason:        伪造产物元数据，importlib.metadata 读到的版本不可信
forbid_2_consequence:   消费者 `--version` 与实际包内容不符

principles:
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E634.md
last_updated:           2026-09-24
source_event:           undertime 4.3.1 适配：pyproject.toml 用 setuptools_scm，源码为 GitLab 发布 tarball；
                        注入 SETUPTOOLS_SCM_PRETEND_VERSION=4.3.1 后 pip install 成功，`undertime --version` 输出 4.3.1

authors:                HouYuxuan <f24011422@st.sandau.edu.cn>
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
