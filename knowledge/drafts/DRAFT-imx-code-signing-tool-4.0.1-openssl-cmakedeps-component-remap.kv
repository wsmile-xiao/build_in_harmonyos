#====================================================================
# DRAFT-imx-code-signing-tool-4.0.1 — OHOS 上为 find_package(OpenSSL)
# 消费者重映射 Conan openssl 组件（OpenSSL::Crypto / OpenSSL::SSL）
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-imx-code-signing-tool-4.0.1-openssl-cmakedeps-component-remap
trigger_tool:           cmake|conan
phase:                  configuration
error_signature:        Target "\S+" links to:\s*\n?\s*OpenSSL::Crypto|Target "\S+" links to:\s*\n?\s*OpenSSL::SSL|OpenSSL::Crypto.*target was not found|OpenSSL::SSL.*target was not found|FATALCannot find OpenSSL|Cannot find OpenSSL, please check environment

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, cmake, conan, cross-compile, openssl
match_keywords:         openssl, OpenSSL::Crypto, OpenSSL::SSL, CMakeDeps, cpp_info, components,
                         cmake_target_name, find_package(OpenSSL), openssl::openssl, target not found
title:                  ohpcd openssl 配方只导出 openssl::openssl，上游 find_package(OpenSSL)/OpenSSL::Crypto 消费者需在 generate() 先重映射组件再生成 CMakeDeps

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             ohpcd openssl 配方的 package_info() 只声明包级目标 openssl::openssl（cmake_file_name=openssl），
                        不导出 CMake 官方 FindOpenSSL 风格的 OpenSSL::Crypto / OpenSSL::SSL 组件目标。
                        上游直接 find_package(OpenSSL)+OpenSSL::Crypto 链接时，CMakeDeps 生成的
                        openssl-config.cmake 无法提供该目标名；且 CMakeDeps 惰性读取 cpp_info，
                        组件属性与 cmake_target_name 必须在 CMakeDeps.generate() 之前写入才生效。
affected_scope:         OHOS 上以 Conan 构建、上游 CMake 用官方 find_package(OpenSSL) 并链接
                        OpenSSL::Crypto / OpenSSL::SSL 目标的 C/C++ 库。
verification_cmd:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           remap-openssl-components-before-cmakedeps
rec_description:        在 conanfile.py generate() 中，先把 openssl 依赖的 cpp_info 重映射为
                        OpenSSL::Crypto / OpenSSL::SSL 组件目标（cmake_file_name=OpenSSL，
                        组件 libs/includedirs/libdirs/system_libs 展开），
                        再调用 CMakeDeps.generate()，最后生成 CMakeToolchain。
rec_command:            conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
rec_auto_fix:           false
rec_impl:               conanfile-generate-remap

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      openssl-root-dir-module-mode
fallback_description:   上游自带 FindOpenSSL.cmake / 期望 MODULE 模式时，改用 OPENSSL_ROOT_DIR 指向
                        openssl 包目录并禁用 CMAKE_FIND_PACKAGE_PREFER_CONFIG（CMAKE_PROJECT_INCLUDE
                        注入），让 find_package(OpenSSL) 走 CMake 内置 Find 模块。
fallback_command:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
fallback_auto_fix:      false
fallback_impl:          toolchain-inject

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       deps\.generate\(\).*self\.dependencies\["openssl"\]|改组件.*之后.*deps\.generate
forbid_1_reason:        CMakeDeps 惰性读取 cpp_info，先 generate 再改组件不会进 config，目标仍 not found。
forbid_1_consequence:   配置期继续报 OpenSSL::Crypto target was not found。
forbid_2_pattern:       只改 cmake_target_name.*不清.*libs|清空.*openssl\.libs.*不.*system_libs
forbid_2_reason:        包级默认 libs 未清空会与组件 libs 重复；system_libs（dl/pthread）未复制到组件
                        会导致静态链接 OpenSSL 时缺系统库。
forbid_2_consequence:   链接行重复 -lcrypto 或缺 dl/pthread 未定义符号。

# ═══ Layer 4: 原则引用 ═══
principles:             R26

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E412]
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

