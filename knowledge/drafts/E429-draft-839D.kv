#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: npm|conan|cargo|rustup|wasm
phase: investigation
error_signature: unrecognized OS type: HarmonyOS|no acceptable cc|需要 cargo 编译但本机无 Rust|发布物已含预构建产物

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: feasibility, toolchain, packaging
match_keywords: 预构建产物, prebuilt, wasm-bindgen, postinstall 编译, rustup 拒绝 HarmonyOS, 比赛版本不存在, 最新可获取版本, 可行性判据
title: 判断一个库"能不能在本环境适配"，**要看它的发布物里是否已含构建产物，而不是看实现语言**——同为 Rust 系：`install-mimic` 只发源码（Debian 用 `cargo build --release`）→ 本机无 Rust（rustup 直接拒绝 HarmonyOS）→ **系统级不可用、放弃**；而 `ink-generator` 上游把 **wasm 预构建好**随 npm 发布 → **零工具链、零依赖，直接可打包**。另：比赛/清单里的版本号可能**在任何公开发布渠道都不存在**（本例要 0.4、npm 只到 0.3.8）→ 按既定规则用最新可获取版本并在 manifest/notes/PR 显著披露

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 同一语言生态里，包的"发布形态"差异极大：有的只发布源码+构建脚本（消费方必须自带编译器）， 有的把产物（wasm/字节码/jar/预编译二进制）一起发布。前者对缺失工具链的环境是硬阻塞， 后者则与语言无关地可用。适配侦察若只按"语言/依赖列表"判断，就会把可行的包误判为不可行 （或反之，浪费时间在必然失败的构建上）。 另外清单版本号常来自需求方而非发布方，可能对应不到任何真实发布物。
affected_scope: 所有"上游是解释型/编译型混合生态"的适配：npm 包（Rust/Go/C++ 编译成 wasm/native）、Python 轮子（有无预编译 wheel）、Java 多模块、perl XS 等
verification_cmd: ①`npm pack --dry-run`/下载 tarball 后 `tar tzf` 看是否含 `*.wasm`/`*.node`/预编译产物；②`npm view <pkg>@<ver> scripts.postinstall`（有无编译钩子）；③`npm view <pkg> versions`（清单版本是否存在）；④对照 `rustup` 类工具链在本平台是否可用（`rustup` 会直接报 `unrecognized OS type: HarmonyOS`）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: check-published-artifacts-before-language-and-pin-but-disclose-missing-versions
rec_description: ①**先看发布物**：下载上游发布包（npm tarball / wheel / jar）列出内容，若已含预构建产物（wasm/so/node/jar）→ 该包**不需要**相应工具链，直接按"解包+自检+打包"处理；②**再看构建钩子**：`scripts.postinstall`/`build.rs`/`configure` 是否要求本地编译器；③**最后才看依赖列表**（有预构建产物时，语言级依赖往往不适用）；④**版本核对**：清单版本若在任何渠道都不存在 → 用最新可获取版本，并在 manifest/notes/PR 三处披露（不默默换版本、也不因版本不符就放弃一个可做的包）；⑤把"哪些证据支持该判定"写进 notes（本例：`ink_generator_bg.wasm` 1020564 B 随包发布 vs install-mimic 的 `cargo build --release`）。
rec_command: curl -sSL <npm tarball> -o p.tgz && tar tzf p.tgz | head -20 ; npm view <pkg> versions --json ; rustup --version 2>&1 | head -2
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: vendor-the-toolchain-if-the-artifact-is-absent
fallback_description: 若发布物确实不含产物，则只能自带工具链（如装 Rust/Go SDK）；但需先确认该工具链在本平台可用（rustup 对 HarmonyOS 直接拒绝 → 属系统级阻塞，按规则记录并放弃，不要反复尝试）。
fallback_command:
fallback_auto_fix: false
fallback_impl: manual forbid_1_pattern:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

