#====================================================================
# E676-draft-421B.kv — configure 补丁触发 doc 时间戳链重算，缺 makeinfo 报 Error 127
# 来源: shishi 1.0.3 适配（任务卡 10568）, 2026-09-23
# 状态: 草稿（待人工审核后 promote 为正式条目）
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E676
trigger_tool:           make
phase:                  testing
error_signature:        makeinfo.*(missing|inaccessible or not found|No such file)|Error 127|failed parsing 'ls -L -l -d -n /' output

# ═══ Layer 1: 识别层 ═══
severity:               3
category:               build-system, autotools, hmdfs, portability
prescan_pattern:        stamp-vti:.*configure|info_TEXINFOS|MAKEINFO = .*missing
prescan_globs:          Makefile*, *.texi, *.am
match_keywords:         makeinfo, stamp-vti, version.texi, shishi.info, mdate-sh, 时间戳链, Error 127, texinfo
title:                  configure 补丁让 doc 时间戳链重算，缺 makeinfo 时 make check/install 全挂（mdate-sh 空输出还会把环境写进文档）

# ═══ Layer 2: 诊断层 ═══
root_cause:             上游 doc/Makefile 链条 stamp-vti（依赖 shishi.texi 与 configure）→ version.texi → shishi.info，对 configure 打过补丁（mtime 变新）后链条重算，make 调 missing 包装的 makeinfo 重建 info 手册；设备与 CI 均无 makeinfo，ohpcd 也未发布 texinfo → make check 与 make install 双双 Error 127。设备上连锁反应更重：mdate-sh 解析 toybox ls 输出失败返回空，stamp 规则里零参数 set 在 mksh 系 shell 下把整个 shell 环境（含 GITCODE_TOKEN）写进 version.texi，refresh-patch --auto 会把它打成补丁准备入库
affected_scope:         所有随 tarball 发布 info 手册（info_TEXINFOS + stamp-vti 规则）且需要对 configure 等文件打补丁的 GNU autotools 包；设备侧连锁影响所有依赖 mdate-sh 的 automake 包
verification_cmd:       command -v makeinfo; grep -n "stamp-vti" <builddir>/doc/Makefile; grep -c "^+" <package>/patches/*.patch | grep -v ":0"   # 补丁行数异常大即疑似环境泄漏

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           对齐 info 时间戳链
rec_description:        配方 build() 在 apply_conandata_patches 之后、configure 之前，对 doc/stamp-vti、doc/version.texi、doc/shishi.info（含 shishi.info-1..N）只调 os.utime 对齐到当前时刻：stamp 新于补丁后的 configure、info 新于 version.texi，链条不再重算，makeinfo 不再被调用，mdate-sh 也不会跑。只改 mtime 不改内容，零 diff 零补丁
rec_command:            '# conanfile.py build(): for f in ("doc/stamp-vti","doc/version.texi","doc/shishi.info","doc/shishi.info-1","doc/shishi.info-2","doc/shishi.info-3"): p=os.path.join(self.source_folder,f); os.path.exists(p) and os.utime(p,None)'
rec_auto_fix:           true
rec_impl:               recipe-option

fallback_priority:      2
fallback_approach:      提供 makeinfo
fallback_description:   若时间戳方案不可行，可在有 texinfo 的环境重建 info 手册随包发布，或以 tool_requires 提供 makeinfo（前提 ohpcd 已发布 texinfo，当前未发布）
fallback_command:       conan list "texinfo/*" -r=ohpcd
fallback_auto_fix:      false
fallback_impl:

# ═══ 禁止策略 ═══
forbid_1_pattern:       MAKEINFO=true
forbid_1_reason:        automake 的 .texi.info 规则先把已发布的 shishi.info* 挪进临时备份目录再调 MAKEINFO；指向 true 时退出码 0 但不生成新文件，随后备份被 rm -rf，已发布 info 手册被删，make install 丢文档
forbid_1_consequence:   check/install 表面通过或换个错误码失败，且 info 文档静默丢失
forbid_2_pattern:       rm .*stamp-vti|patch.*mdate-sh
forbid_2_reason:        删时间戳文件会强制重跑 mdate-sh，触发环境变量写入文档的凭证泄漏路径
forbid_2_consequence:   version.texi 被 shell 环境覆盖，可能把 token 打进 PR 补丁

# ═══ Layer 4: 原则引用 ═══
principles:             P011

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             E011, E670
conflicts_with:         []
prerequisite_of:        []

