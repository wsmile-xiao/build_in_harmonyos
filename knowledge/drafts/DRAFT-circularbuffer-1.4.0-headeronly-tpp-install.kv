#====================================================================
# DRAFT-circularbuffer-1.4.0-headeronly-tpp-install -
# header-only 库 .tpp/.ipp 实现文件必须随 .hpp 一起安装进 include/
#
# 场景: circularbuffer 1.4.0 (rlogiacco/CircularBuffer, Arduino 风格
#       环形缓冲模板库) OHOS armv8 Conan 2.x 适配。CircularBuffer.hpp
#       末尾 #include <CircularBuffer.tpp>（模板实现分离文件），配方
#       package() 只复制 *.h/*.hpp 时消费者编译报
#       "fatal error: 'CircularBuffer.tpp' file not found"（间接，通常
#       表现为 test_package 编译失败或 package 缺文件）。
# 适用: 所有把模板实现放在 .tpp/.ipp/.tcc 等分离文件、由主头文件
#       #include 的 header-only 库；conanfile.py package() 必须连同
#       实现分离文件一起复制。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-circularbuffer-1.4.0-headeronly-tpp-install
source_lib:             circularbuffer 1.4.0
trigger_tool:           conan|conan create|clang|clang++
phase:                  packaging|installation|compilation
error_signature:        CircularBuffer\.tpp.*file not found|'[A-Za-z0-9_]+\.tpp' file not found|fatal error: .*\.tpp|No files in this package

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               headers, packaging, conan, header-only, template
match_keywords:         header-only, .tpp, .ipp, .tcc, .inc, 模板实现, template implementation, package(), copy, include, #include <, file not found, CircularBuffer, 分离文件, 实现文件, conanfile.py
title:                  header-only 库 .tpp/.ipp 实现分离文件必须随 .hpp 一起安装，否则消费者编译报文件不存在

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  header-only 模板库为可读性把模板/非模板实现拆分到 .tpp（或 .ipp/
  .tcc）文件，主头文件（.hpp）末尾以 #include <CircularBuffer.tpp>
  引入。conanfile.py package() 若只复制 *.h/*.hpp（常见 header-only
  配方模板默认只含这两类），.tpp 不进 include/ → 消费者（test_package
  或下游）编译时主头展开 #include <CircularBuffer.tpp> 找不到文件。
  这是安装完整性错误，与平台无关；CircularBuffer.tpp 自身是模板实现
  无 ODR 问题，与 graaf .tpp 链接重复符号（需标 inline）是不同模式。
affected_scope: 所有 .tpp/.ipp/.tcc 分离实现 header-only 库的 Conan 配方
  package()；上游只提供单头分发或只复制 *.h/*.hpp 的配方。
verification_cmd: cd $ARCHIVE_DIR && grep -n '#include <.*\.tpp' $SRC/*.hpp &&
  conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
  # 期望 package() 含 copy(self, "*.tpp", ...) 后 test_package 编译通过

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           headeronly-package-tpp-impl
rec_description:        package() 中除 *.h/*.hpp 外增加 copy(self, "*.tpp", src=self.source_folder, dst=os.path.join(self.package_folder, "include"))，把模板实现分离文件与主头一并安装；同时 *.ipp/*.tcc/*.inc 视上游包含方式复制。
rec_command: |
  from conan.tools.files import copy
  def package(self):
      copy(self, "*.h",  src=self.source_folder, dst=self.package_folder + "/include")
      copy(self, "*.hpp",src=self.source_folder, dst=self.package_folder + "/include")
      copy(self, "*.tpp",src=self.source_folder, dst=self.package_folder + "/include")  # 关键
      copy(self, "LICENSE*", src=self.source_folder, dst=self.package_folder + "/licenses", keep_path=False)
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:      headeronly-merge-impl-into-hpp
fallback_description:   若无安装需求（如仅本库内部使用），可把 .tpp 内容合并进 .hpp 后只装 .hpp；或改用 cmake install 由上游 CMakeLists 统一安装。
fallback_command:       ""
fallback_auto_fix:      false

# ═══ 证据与验证 (Evidence) ═══
evidence_source:        circularbuffer 1.4.0 真实适配（2026-09-23）
evidence_log:           conan create 全流程通过；test_package test_circularbuffer 1/1 Passed（消费者调用 push/shift/pop/copyToArray 等公开 API，退出码 0）
evidence_sha256:        源码 tarball e01a837d2fe46fea168e8d36e1a4225d9414a855484d55b5a240f239ab53fc0a
