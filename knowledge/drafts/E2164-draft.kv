#====================================================================
# E2164-draft.kv — 知识图谱条目草稿
# 对应的人类文档: E2164-draft.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E2164
trigger_tool: runtime
phase: runtime|testing
error_signature: stoi: no conversion|std::invalid_argument.*stoi|C\+\+ exception with description "stoi

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: portability|version-parsing|runtime
match_keywords: stoi, uname, kernel release, HongMeng, version parsing, invalid_argument
title: Tolerate non-numeric kernel release strings when parsing version numbers at runtime

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: std::stoi on the leading token of a kernel release string assumes a pure numeric format; OHOS returns "HongMeng Kernel 1.12.0" so the first token is non-numeric and the exception propagates from an unguarded global/platform singleton, failing every test that touches it.
affected_scope: Any runtime code or tests that parse uname release fields or similar version strings on non-Linux kernels.
verification_cmd: Run the failing test binary before the fix to see 'stoi: no conversion'; apply the tolerant parse; re-run and observe the exception disappear.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: tolerant-version-parse
rec_description: Wrap stoi in try/catch for std::invalid_argument and std::out_of_range; on parse failure default the version to 0.0 so downstream feature detection falls back to safe paths.
rec_command: try { major = std::stoi(parts[0]); minor = std::stoi(parts[1]); } catch (const std::invalid_argument&) { major = 0; minor = 0; } catch (const std::out_of_range&) { major = 0; minor = 0; }
rec_auto_fix: true
rec_impl: source-patch-try-catch-version-default

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:       numeric-prefix-extraction
fallback_description:   Extract only the leading numeric prefix of each token before conversion.
fallback_command:       Use a regex or manual scan for the first digit run, convert that substring, ignore the rest.
fallback_auto_fix:      true
fallback_impl:          source-patch-numeric-prefix

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       std::stoi\([^)]*\)(?![\s\S]*catch)
forbid_1_reason:        An unguarded stoi propagates std::invalid_argument to the caller; a global singleton constructor turns one bad string into a whole-suite failure.
forbid_1_consequence:   Every test that touches the singleton dies with 'stoi: no conversion' instead of reporting the real assertion.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
principles:

