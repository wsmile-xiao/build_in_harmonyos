#====================================================================
# DRAFT-test-package-shell-set-u-pwd-unbound.kv
# test_package shell 脚本 set -u 下 $PWD unbound 变量
# (OHOS bash 启动 getcwd 失败 → PWD 未绑定 → ${TMPDIR:-$PWD} 报
#  "PWD: unbound variable"，test() 直接 exit 1)
#====================================================================

id:                     DRAFT-test-package-shell-set-u-pwd-unbound
trigger_tool:           bash|conan|test_package|VirtualRunEnv
phase:                  test
error_signature:        PWD: unbound variable|
                         shell-init: error retrieving current directory|
                         job-working-directory: error retrieving current directory

severity:               2
category:               ohos, test_package, shell, conan, hmdfs
match_keywords:         PWD, unbound variable, set -u, test_package, test.sh, TMPDIR,
                         getcwd, bash, workdir, HMDFS, current directory,
                         ${TMPDIR:-$PWD}, fallback
title:                  test_package shell 脚本在 OHOS set -u 下 $PWD unbound（workdir fallback 避免裸引用 $PWD）

root_cause:             |
  OHOS 上以 /data/service/hnp/bin/bash 执行 test_package 的 shell 脚本时，
  若脚本声明 set -u 且用 ${TMPDIR:-$PWD} 之类裸引用 $PWD 作为临时目录
  fallback，会报 "PWD: unbound variable"。根因同
  DRAFT-ohos-autotools-configure-re-exec-cwd-env：bash 启动时 getcwd()
  在 HMDFS 父目录链上失败（EPERM）→ 进程环境无 PWD → $PWD 未绑定。
  但触发面是 test.sh 脚本自身（非 autotools configure 重执行），修复
  也应在脚本内完成，而非配方 os.environ 预置。rgbds 1.0.1 真机实测命中。

affected_scope:         所有 OHOS 上由 conan test() 以 bash 包装执行、且脚本 set -u
                         并裸引用 $PWD 的 test_package 脚本

verification_cmd:       |
  /data/service/hnp/bin/bash -c 'set -u; echo "${TMPDIR:-$PWD}"'
  # 触发: PWD: unbound variable（bash 启动 getcwd 失败时）

rec_priority:           1
rec_approach:           avoid-bare-pwd
rec_description:        test.sh 内临时目录 fallback 不用 $PWD 裸引用，改用
                         ${TMPDIR:-${HOME:-/data/service/hnp}} 链式 fallback。
rec_command:            workdir="${TMPDIR:-${HOME:-/data/service/hnp}}/<name>-$$"
rec_auto_fix:           false
rec_impl:               manual-test-script

fallback_priority:      2
fallback_approach:      preset-pwd
fallback_description:   在 test_package/conanfile.py 的 test() 里 os.environ["PWD"]=<目录>
                         预置 PWD（同 DRAFT-ohos-autotools-configure-re-exec-cwd-env 方案），
                         但脚本内改 fallback 更自包含、可读。
fallback_command:       os.environ["PWD"] = os.path.join(self.build_folder, "test_package")
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       ${TMPDIR:-$PWD}|workdir="$PWD"|cd $PWD
forbid_1_reason:        set -u 下 $PWD 未绑定直接报错退出，误判为测试逻辑失败
forbid_1_consequence:   反复排查断言而忽略环境变量未绑定

principles:

causes:                 []
caused_by:              []
similar_to:             [DRAFT-ohos-autotools-configure-re-exec-cwd-env,E330-draft-2301]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-test-package-shell-set-u-pwd-unbound.md
last_updated:           2026-09-20
source_event:           rgbds/1.0.1 真机 shadow CI（test_package/test_rgbds.sh line 21 命中 PWD: unbound variable）

draft:                  true
contributor_id:         0
authors:                codex
source_pr:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.85
metrics_last_used:      2026-09-20
