#====================================================================
# Draft: configure-time generated PUBLIC header is not installed by the
#        upstream install rules, yet the installed public headers
#        #include it -> every consumer fails to compile.  Source event:
#        schroot 1.6.13 (sbuild-config.h), 2026-10-01.
#====================================================================

id:                     DRAFT-SCHROOT-1613-GENERATED-PUBLIC-HEADER
trigger_tool:           cmake|gcc|clang|make
phase:                  compilation
error_signature:        fatal error: .*\.h: No such file or directory|sbuild-config\.h|generated configuration header not found

severity:               3
category:               headers, cmake, build-system, packaging, detection
prescan_pattern:        configure_file\(.*\.h|#include\s+<[a-z_-]+config\.h>|#include\s+"[a-z_-]+config\.h"
match_keywords:         generated header, configure_file, AC_CONFIG_HEADERS, config.h, sbuild-config.h, 生成的公共头, 消费者编译失败, includedirs, package()

title:                  configure 期生成的公共头（如 sbuild-config.h）未被上游 install 规则安装，而已安装的公共头会 include 它——消费者必然编译失败；configure/CMake 生成的对外头须在 package() 中一并装入 include/

root_cause:             上游用 configure_file()/AC_CONFIG_HEADERS 生成平台配置宏头，构建树内可见，且公共头（如 sbuild-i18n.h、sbuild-util.h）会 #include 它。但生成的头通常落在构建目录、不在源码树的 install 清单里，上游 install 规则只装 include/ 下的源文件——结果是包内公共头齐全、唯独缺生成头，任何消费者（含 test_package）编译即 fatal error。早期症状更隐晦：构建期自身的编译能过（构建目录里该头存在），只有独立消费者才暴露。
affected_scope:         所有 autotools/CMake 项目中用 configure_file/AC_CONFIG_HEADERS/xgettext 模板生成"对外可见"头文件的包；生成头放在构建目录、而 install 只装源码树 include/ 的情况。schroot 1.6.13（sbuild/sbuild-config.h）为实证。
verification_cmd:       find <package_folder>/include -name '*config.h' -o -name 'SCHROOT_*'   # 为空即缺失；再用包内头做最小 include 编译验证

rec_priority:           1
rec_approach:           install-generated-public-header-in-package
rec_description:        ①在 package() 中把构建树里生成的公共头复制进 <package_folder>/include/<namespace>/（保持包内目录与上游 #include 路径一致）；②同时用 package_info().includedirs 暴露 include/（本包为 include），确保 CMakeDeps/PkgConfigDeps 能给出正确 -I；③验证不能只看"本包构建通过"，必须有一个独立消费者（test_package）只 include 公共头并编译，才能暴露缺头；④若上游 install 规则可通过变量（如 CONFIGURE_HEADER/HEADER_INSTALL_DIR）补齐，优先在配方里传该变量而非拷贝。
rec_command:            python: shutil.copyfile(os.path.join(build_tree, "build", "Release", "sbuild", "sbuild-config.h"), os.path.join(package_folder, "include", "sbuild", "sbuild-config.h"))
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:      declare-header-in-package-info-includedirs
fallback_description:   若生成头路径与上游 #include 约定不一致，可额外补一个兼容 include 目录（复刻上游安装布局）并在 package_info() 中一并暴露，避免改上游头文件内容。
fallback_command:       -D<UPSTREAM_VAR>=<build-generated-header-dir>
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       #include\s+"\.\./.*config\.h"|sed.*config\.h.*include
forbid_1_reason:        用相对路径改写上游公共头来"绕过"缺头，会把构建目录布局写死进对外接口，消费者环境必然不同；正确做法是把头装进包内。
forbid_1_consequence:   包内公共头仅在原构建树下可用，换机器/换消费者即失败（假绿）

principles:             P0

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/schroot-1.6.13-generated-public-header.md
last_updated:           2026-10-01
source_event:           schroot 1.6.13：test_package 消费者编译头链到 sbuild/sbuild-config.h 报 No such file or directory（构建树存在、包内缺失）

authors:                weijiapan <weijiapan@noreply.gitcode.com>
