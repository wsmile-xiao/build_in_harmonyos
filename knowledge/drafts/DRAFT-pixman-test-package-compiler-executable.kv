#====================================================================
# DRAFT-pixman-test-package-compiler-executable - Use Conan compiler_executables in ad-hoc test_package builds
#====================================================================

id:                     DRAFT-pixman-test-package-compiler-executable
trigger_tool:           conan|test_package|clang|ohos-test-runner
phase:                  testing|build
error_signature:        /system/bin/sh: clang: inaccessible or not found|Error 127 while executing|test package.*Calling build\(\)

severity:               2
category:               conan|test_package|toolchain|ohos-runner
match_keywords:         test_package, compiler_executables, clang, /data/service/hnp/bin/clang, OHOS, ConanFile.conf, pixman
title:                  test_package 手写编译命令应优先使用 Conan profile 的 compiler_executables

root_cause: >
  pixman 0.46.4 的 test_package 直接使用 os.environ.get("CC", "clang") 拼接编译命令。
  真机 runner 的 Conan profile 已设置 tools.build:compiler_executables={'c':
  '/data/service/hnp/bin/clang'}，主包 Meson 构建可正常使用该编译器；但 test_package
  的裸 self.run("clang ...") 不读取 profile 配置，runner PATH 中没有裸名 clang，导致
  /system/bin/sh: clang: inaccessible or not found。

affected_scope: >
  不用 CMakeToolchain/MesonToolchain，而是在 test_package build() 中手写 cc/clang/gcc
  命令的 OHOS Conan recipe。

verification_cmd: >
  conan create archives/p/pixman/0.46.4 -pr:h=ci/conan/profiles/ohos-aarch64
  -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing --build=pixman/*;
  test_package 日志中应调用 /data/service/hnp/bin/clang 并完成 API smoke。

rec_priority:           1
rec_approach:           read-tools-build-compiler-executables
rec_description: >
  test_package build() 中优先读取 self.conf.get("tools.build:compiler_executables", ...)
  的 c 编译器，其次才使用环境变量 CC 或裸名 clang。拼接命令时用 shlex.quote 处理路径
  和宏定义，避免设备路径中出现特殊字符时被 shell 误解析。
rec_command: >
  executables = self.conf.get("tools.build:compiler_executables", default={}, check_type=dict) or {};
  cc = os.environ.get("CC") or executables.get("c") or "clang"
rec_auto_fix:           false
rec_impl:               conan-test-package

fallback_priority:      2
fallback_approach:      use-standard-toolchain-generators
fallback_description: >
  如果 test_package 足够复杂，优先改为 CMakeToolchain/CMakeDeps 或 MesonToolchain，
  让 Conan 生成器统一处理编译器、sysroot、include、libdir 和运行环境。
fallback_command:       CMakeToolchain(self).generate(); CMakeDeps(self).generate(); cmake.build(); cmake.test()
fallback_auto_fix:      false
fallback_impl:          conan-test-package

forbid_1_pattern:       os\.environ\.get\("CC", "clang"\)|self\.run\("clang .*
forbid_1_reason:        OHOS runner/profile 可能只提供绝对编译器路径，不保证 PATH 有裸名 clang。
forbid_1_consequence:   主包构建成功，test_package 在 build() 阶段 Error 127。

principles:             P014, P016
causes:
caused_by:
similar_to:             DRAFT-clang-ohos-native-llvm-toolchain
conflicts_with:
prerequisite_of:

