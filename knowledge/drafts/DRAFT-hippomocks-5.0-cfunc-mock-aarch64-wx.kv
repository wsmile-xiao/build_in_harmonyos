#====================================================================
# DRAFT-hippomocks-5.0-cfunc-mock-aarch64-wx
#   aarch64/OHOS 上 hippomocks CFUNC 打桩不可用：禁用该特性并保留
#   虚拟函数打桩（含 __clear_cache 内建签名修复）
# 来源: PR feat/hippomocks-5.0（任务 hippomocks-5.0-r01-pc7-36）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-hippomocks-5.0-cfunc-mock-aarch64-wx
trigger_tool:           clang++|clang|cmake|test
phase:                  compilation|runtime|testing
error_signature:        conflicting types for '__clear_cache'|
                         extern "C" void __clear_cache\(char \*beg, char \*end\)|
                         Signal 11|SIGSEGV|
                         mprotect.*Invalid argument|mprotect.*EINVAL|
                         _HIPPOMOCKS__ENABLE_CFUNC_MOCKING_SUPPORT

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               platform, portability, ohos, aarch64, mock, w-x, memory
match_keywords:         hippomocks, mock framework, CFUNC, 打桩, __clear_cache,
                         mprotect, RWX, W^X, aarch64, arm64, conflicting types,
                         builtin, EINVAL, vtable, MockRepository
title:                  hippomocks CFUNC 打桩在 aarch64/OHOS 不可用：上游 ARM 路径仅写 32 位 ARM 指令，且文本页 mprotect RWX 被 OHOS W^X 拒绝（EINVAL）；应禁用该特性，虚拟函数打桩不受影响
prescan_pattern:        _HIPPOMOCKS__ENABLE_CFUNC_MOCKING_SUPPORT|
                         __clear_cache|mprotect\(|SOME_ARM

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             hippomocks 5.0 的 CFUNC 打桩 Replace 类在 SOME_ARM 分支
                         只写入 32 位 ARM 指令（rawptr[0]=0xE59FF000 等），
                         aarch64 上执行即 SIGSEGV；且打桩本身需将目标函数所在
                         文本页 mprotect 为 PROT_READ|PROT_WRITE|PROT_EXEC，
                         OHOS 内核 W^X 策略拒绝（实测 EINVAL，与 E045 mmap RWX
                         同族）。另外 hippomocks.h 声明 `extern "C" void
                         __clear_cache(char*, char*)` 与 clang 内建
                         `void __clear_cache(void*, void*)` 冲突，
                         编译期 conflicting types。
affected_scope:         aarch64/OHOS 上使用 hippomocks 的 C++ 项目；
                         任何依赖文本页打桩/自修改代码的 C/C++ mock 框架
verification_cmd:       cmake -S . -B build-ohos -DCMAKE_CXX_COMPILER=clang++ -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && cmake --build build-ohos -j4 && ./build-ohos/HippoMocksTest/HippoMocksTests

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           source-code-patch
rec_description:        在 hippomocks.h 中把 _HIPPOMOCKS__ENABLE_CFUNC_MOCKING_SUPPORT
                         的 SOME_ARM 分支加 `&& !defined(__aarch64__)` 禁用；
                         __clear_cache 声明 char* 改 void*。CFUNC 测试由上游宏
                         门控（"If it's not supported, then don't test it"），
                         禁用后自动排除，虚拟函数打桩（MockRepository/vtable）
                         不受影响，上游测试仍全量通过。
rec_command:            apply patches/0001-HippoMocks-hippomocks.h.patch && cmake --build build-ohos -j4 && ./build-ohos/HippoMocksTest/HippoMocksTests
rec_auto_fix:           false
fallback_priority:      2
fallback_approach:      platform-limitation
fallback_description:   若下游必须使用 CFUNC 打桩（罕见），OHOS 内核 W^X 为硬限制，
                         与 E045 同族，无用户态绕过；应改设计为虚拟函数打桩。
fallback_command:       python3 -c "import ctypes"  # E045 佐证 W^X 策略存在
fallback_auto_fix:      false

# ═══ Layer 4: 边界与验证 ═══
forbid_1_pattern:       force.*mprotect|disable.*W\^X|exec.*stack.*gcc|sigaction.*write.*text
boundary_conditions:    仅 aarch64 受影响；32 位 ARM 保留上游原行为；x86/Apple 不受影响
