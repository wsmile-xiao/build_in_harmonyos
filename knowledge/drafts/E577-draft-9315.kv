# E577 — CMake project() 声明 Fortran 语言时即便禁用 Fortran 特性仍强制查找 Fortran 编译器

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E577
trigger_tool:           cmake
phase:                  configuration
error_signature:        No CMAKE_Fortran_COMPILER could be found|CMAKE_Fortran_COMPILER|project\(.*C Fortran\)|Fortran language

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, cmake, toolchain, portability
match_keywords:         cmake, Fortran, project, compiler, FORTRAN_LIB, option, CMAKE_Fortran_COMPILER, ccp4, gfortran, flang
title:                  CMake project() 语言列表含 Fortran 时强制探测 Fortran 编译器，与相关 option 关闭无关

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             CMake 的 project(<name> C Fortran) 在 configure 阶段无条件要求每个声明语言都有可用编译器；即使 CMakeLists.txt 中提供了关闭该语言相关特性的 option（如 FORTRAN_LIB=OFF），编译器探测仍在 project() 处发生，缺失 Fortran 编译器即报 No CMAKE_Fortran_COMPILER could be found
affected_scope:         OHOS/无 Fortran 工具链平台上的 CMake 项目；混合语言（C+Fortran）项目只保留 C 核心库的场景
verification_cmd:       cmake .. -DFORTRAN_LIB=OFF 2>&1 | grep "No CMAKE_Fortran_COMPILER" || echo fixed

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           remove-language-from-project-declaration
rec_description:        从 project() 语言列表移除 Fortran（project(libccp4 C Fortran) → project(libccp4 C)），同时以 option 关闭 Fortran 库构建；适用于 Fortran 部分为可裁剪特性、核心功能在 C 库的场景
rec_command:            sed -i 's/project(\([^)]*\) C Fortran)/project(\1 C)/' CMakeLists.txt
rec_auto_fix:           false

fallback_priority:      2
fallback_approach:      skip-or-cross-compile
fallback_description:   E109：整个项目需 Fortran 时 OHOS 无 gfortran，只能交叉编译或等待官方预编译包
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       CMAKE_Fortran_COMPILER=/bin/true|CMAKE_Fortran_COMPILER=echo
forbid_1_reason:        用假编译器占位会绕过探测但后续 .f 文件编译/链接必然失败，产生更难排查的错误
forbid_1_consequence:   构建中断于编译期，错误信息与真实缺陷混淆
forbid_2_pattern:       -DCMAKE_POLICY_VERSION_MINIMUM
forbid_2_reason:        CMAKE_POLICY_VERSION_MINIMUM 只解决 cmake_minimum_required 版本兼容（E103/E187），不解决 Fortran 编译器缺失
forbid_2_consequence:   误以为同一参数可解决两类问题，修复无效

# ═══ Layer 4: 原则引用 ═══
principles:             P017

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E109]
conflicts_with:         []
prerequisite_of:        []

