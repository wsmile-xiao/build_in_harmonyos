#====================================================================
# DRAFT-alpaca-vector-bool-proxy — vector<bool> 代理引用序列化
#====================================================================

id:                     DRAFT-alpaca-vector-bool-proxy
trigger_tool:           clang|ld|conan|test
phase:                  compilation|linking|testing
error_signature:        undefined symbol.*bit_const_reference|undefined symbol.*bit_reference|to_bytes.*__bit_const_reference

severity:               2
category:               cxx|libcxx|header-only|serialization|proxy-reference|portability
match_keywords:         std::vector<bool>, bit_const_reference, bit_reference, proxy reference, to_bytes, undefined symbol, libc++
title:                  vector<bool> 迭代器代理引用必须在容器专用重载中转成 bool

root_cause:             std::vector<bool> 使用位压缩存储，其迭代器元素不是 bool，而是实现相关的代理引用类型。若通用容器循环把该代理直接送入仅声明的 class 序列化模板，编译可通过但链接阶段会留下未定义的代理类型 to_bytes 符号。
affected_scope:         直接迭代 std::vector<bool> 并通过泛型路由序列化元素的 C++ header-only 容器库，尤其是不同标准库实现暴露不同代理类型的 OHOS/libc++ 组合。
verification_cmd:       cmake -S . -B build -DALPACA_BUILD_TESTS=ON && cmake --build build -j1 && ./build/test/tests --test-suite=vector

rec_priority:           1
rec_approach:           vector-bool-specialized-value-routing
rec_description:        在 std::vector<bool> 专用序列化重载中先写入 size，再以 bool 值循环调用标量序列化路由，避免把实现相关代理引用暴露给通用 class 模板；反序列化仍按 bool 元素恢复。
rec_command:            for (const bool value : input) to_bytes_router<O>(value, bytes, byte_index)
rec_auto_fix:            false
rec_impl:               upstream-portability-patch

fallback_priority:      2
fallback_approach:      explicit-vector-bool-test
fallback_description:   至少保留 vector<bool> 的编译、链接和往返测试；不能只删掉该测试或把链接失败归因于工具链。
fallback_command:       编译并运行覆盖 std::vector<bool> 的最小消费者。
fallback_auto_fix:      false
fallback_impl:          manual-review

forbid_1_pattern:       disable.*vector<bool>|skip.*vector<bool>|-Wl,.*undefined.*ignore
forbid_1_reason:        关闭测试或忽略未定义符号会隐藏容器公开 API 的真实链接缺陷。
forbid_1_consequence:   消费者在使用 vector<bool> 时仍会链接失败，包的上游测试覆盖不可信。

principles:             P005
causes:
caused_by:
similar_to:
conflicts_with:
prerequisite_of:

