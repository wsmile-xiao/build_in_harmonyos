#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E583.kv，填写各字段
# 对应的人类文档: doc/E583.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E583
trigger_tool: python|pip|wheel|conan|EXT_SUFFIX
phase:                  configuration|compilation|linking|installation|testing|runtime
error_signature: E580 guard FAIL: extension suffix normalisation regressed, still platform-tagged (CI 假失败)；同轮日志 normalised 0 extension module(s) to .cpython-312-aarch64-linux-ohos.so

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: packaging,python,wheel
match_keywords: EXT_SUFFIX|EXTENSION_SUFFIXES|platform tag|normalised 0|extension suffix|wheel|E580
title: CI worker 与设备 Python 的 EXT_SUFFIX 口径不同：扩展后缀归一化与静态守卫必须环境驱动

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: CI worker 的 HNP python 其 EXT_SUFFIX/SOABI 带 MULTIARCH 平台标签（.cpython-312-aarch64-linux-ohos.so），设备侧为 .cpython-312.so（MULTIARCH 为空）。同一份 wheel 在两环境里「归一化动作」与「合法文件名」都不同：sysconfig 归一化在 CI 退化为 no-op（renamed 0），而导入器接受的名字只有平台标签形式。若守卫再硬编码平台标签正则，就会把 CI 上本可加载的文件名判成归一化回归 → CI 假失败。
affected_scope:
verification_cmd: 在 CI 与设备各跑一次 rec_command 比对；守卫 4 场景自检：设备真包(短名)=PASS、CI 形态(平台名+接受集含平台形式)=PASS、设备侧回归(平台名+只认短名)=FAIL、扩展数不足=FAIL

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:
rec_approach: 归一化目标一律取运行环境 EXT_SUFFIX（CI 上保持 no-op，设备上改名 93 个）；静态守卫的合法性判据改为运行解释器的 importlib.machinery.EXTENSION_SUFFIXES——文件名须能按「模块名(不含点)+接受后缀」解析，否则判回归，并断言扩展数不低于基线（93）。禁用硬编码平台标签正则。
rec_description:        一句话描述这个推荐方案
rec_command: /data/service/hnp/bin/python3 -c "import importlib.machinery, sysconfig; print(sysconfig.get_config_var('EXT_SUFFIX'), importlib.machinery.EXTENSION_SUFFIXES)"
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
