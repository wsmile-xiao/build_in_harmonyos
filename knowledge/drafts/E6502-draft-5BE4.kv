#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E6502.kv，填写各字段
# 对应的人类文档: doc/E6502.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E6502
trigger_tool: autoreconf|libtoolize|autoconf
phase: configuration
error_signature: possibly undefined macro: AC_PROG_LIBTOOL|\$pkgauxdir is not a directory|configure.ac: not using Libtool

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: build-system,autotools,conan,portability
match_keywords: AC_PROG_LIBTOOL,libtoolize,_lt_pkgdatadir,ACLOCAL_PATH,autoreconf,automake,tool_requires,perl
title: Autotools autoreconf under Conan needs the conanbuild env (ACLOCAL_PATH/LIBTOOLIZE/_lt_pkgdatadir); hand-assembled PATH skips libtoolize

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: conan automake/libtool packages set buildenv_info vars (ACLOCAL_PATH->libtool share/aclocal, LIBTOOLIZE, _lt_pkgdatadir->source-tree-shaped dir) that autoreconf needs to trace AC_PROG_LIBTOOL. Without ACLOCAL_PATH, aclocal cannot find libtool.m4 so the autom4te trace does not see AC_PROG_LIBTOOL and autoreconf prints "configure.ac: not using Libtool" and never runs libtoolize; autoconf then errors "possibly undefined macro: AC_PROG_LIBTOOL". With ACLOCAL_PATH but without _lt_pkgdatadir, libtoolize fails with "$pkgauxdir is not a directory: //share/libtool/build-aux" (baked empty @datadir@).
affected_scope: Any autotools project using tool_requires(automake/libtool) and running autoreconf manually or in a recipe that does not inherit the conanbuild env
verification_cmd: env | grep -E "ACLOCAL_PATH|LIBTOOLIZE|_lt_pkgdatadir" ; sh -c "autoreconf -v -i -f" 2>&1 | grep -i libtool

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: use-conanbuild-env
rec_description: Let Conan build the env: call Autotools(self).configure()/self.run(..., env="conanbuild") or `source` the conanbuild.sh generated by conan install (VirtualBuildEnv). Do NOT hand-assemble PATH from package bin dirs; that omits ACLOCAL_PATH/LIBTOOLIZE/_lt_pkgdatadir.
rec_command: autoreconf -v -i -f   # 在 conanbuild env 下执行（ACLOCAL_PATH/LIBTOOLIZE/_lt_pkgdatadir 已注入）
rec_auto_fix: false
rec_impl: conanbuild-env

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

