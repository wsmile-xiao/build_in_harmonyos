#====================================================================
# E429 — Makefile 项目默认 CXXFLAGS 含 x86 专属 -msse4 等标志
#====================================================================

id:                     E429
trigger_tool:           make|clang|gcc
phase:                  compilation
error_signature:        argument unused during compilation: '-msse4'|unknown argument: '-msse4'|unrecognized command-line option '-msse|invalid feature.*sse4

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, compat, portability, build-system
match_keywords:         msse4, sse4, CXXFLAGS, x86 flag, aarch64, arm64, NEON, unused-command-line-argument, SIMD
title:                  Makefile 默认 CXXFLAGS 含 x86 专属 SIMD 标志（-msse4/-msse）在 aarch64/arm64 上不适用

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  上游为 x86 SSE4 优化在 Makefile 默认 CXXFLAGS 硬编码 -msse4（LAST
  last-align 1652 即此例）。aarch64 clang 上该标志不可用：clang 15 报
  "argument unused during compilation: '-msse4' [-Wunused-command-line-argument]"
  （不阻断但污染日志），部分编译器/老版本可能报 hard error 阻断编译。
affected_scope: >
  携带 x86 专属优化标志的 plain Makefile / autotools C++ 项目迁移到
  HarmonyOS aarch64 平台时；若源码含 SSE 内建函数需同步检查 __ARM_NEON 分支。
verification_cmd: >
  make -n CXXFLAGS=... | grep -c msse4; 或查看编译日志中
  "argument unused during compilation: '-msse4'"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           override-build-flags
rec_description:        conanfile build() 中覆盖 CXXFLAGS，移除 -msse4，保留 -O3 -std=c++11 -pthread
rec_command:            make -j1 CC={cc} CXX={cxx} CXXFLAGS="-O3 -std=c++11 -pthread" CFLAGS="-Wall -O2" CPPFLAGS={include_flags} LDFLAGS={libdir_flags}
rec_auto_fix:           false

fallback_priority:      2
fallback_approach:      source-patch
fallback_description:   修改源码 Makefile 默认 CXXFLAGS（R6 禁改生成文件，Makefile 属源码可改），或用 `#if defined __ARM_NEON` 选择 NEON 路径
fallback_command:
fallback_auto_fix:      false

# ★ 禁止策略 ★
forbid_1_pattern:        -msse[0-9] 无条件传递到 aarch64 编译
forbid_1_reason:         该标志在 arm64 无意义，可能被部分工具链拒绝
forbid_1_consequence:    编译失败或日志污染导致误判

principles:             P001, P014

causes:                 []
caused_by:              []
similar_to:             E006, E016, E100
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E429.md
last_updated: 2026-09-19
source_event:           last-align-1652 适配（CXXFLAGS -msse4 → 覆盖移除）

authors:                compile-agent
source_pr:
source_commit:

metrics_success_count:  0
metrics_fail_count:     0
