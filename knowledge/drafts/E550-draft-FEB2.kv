#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E550.kv，填写各字段
# 对应的人类文档: doc/E550.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E550
trigger_tool:           qt|runtime|install
phase:                  runtime
error_signature: QProcess.*pkexec|start.*pkexec.*failed|pkexec: not found|设备列表为空.*无报错|smartctl.*空结果|polkit.*missing|权限提升.*静默失败

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: ohos,compat,portability,qt6,runtime
match_keywords: pkexec, polkit, QProcess, start failed, 静默失败, 空结果, 特权命令, smartctl, 设备列表为空, HarmonyOS PC, findExecutable, 直接执行回退
title: HarmonyOS PC 无 polkit/pkexec：上游固定 QProcess::start("pkexec", ...) 提权失败但 exitCode()==0，功能静默失效

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: HarmonyOS PC 没有 polkit/pkexec（真机 command -v pkexec 无输出）。上游 GUI 应用常把特权外部命令写成 QProcess::start("pkexec", {tool, args})，在缺失 pkexec 时 QProcess::start 失败但 exitCode()==0、isOpen()==false，上层若只判断 exitCode 就会把失败当成功，最终表现为"功能静默失效/列表为空/无任何报错"（qdiskinfo 的设备列表即如此）。
affected_scope: 所有在 OHOS PC 上调用 pkexec/polkit 提权的 GUI 或 CLI 应用（磁盘/分区工具、包管理器、系统设置类），以及任何用 QProcess/tool_requires 外部命令且只检查 exitCode 的代码路径
verification_cmd: QT_QPA_PLATFORM=offscreen HOME=$PWD/home TMPDIR=$PWD/tmp PATH=<stub_bin>:$PATH <pkg>/bin/<app> & sleep 8; kill $!; grep -c -- "--scan" smartctl-calls.log

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach:           runtime-probe-with-fallback
rec_description: 把固定调用改为运行时探测 + 回退：定义 findExecutable(name)（按 PATH 逐个目录探测可执行文件，避免依赖 which 命令）与 getPrivilegeElevator()（探测 pkexec）；startProcess(proc, program, args, needs_root) 中若 needs_root 且 elevator 非空则执行 "pkexec program args"（保持 Linux 上游语义），elevator 为空则直接执行 "program args"。同时把外部工具缺失（如 smartctl 不在 PATH）转成明确的用户可见错误，而不是返回空字符串。
rec_command: command -v pkexec || echo NO_POLKIT; python3 scripts/ohc-run.py graph show E550
rec_auto_fix:           false
rec_impl:               runtime-probe-with-fallback

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
