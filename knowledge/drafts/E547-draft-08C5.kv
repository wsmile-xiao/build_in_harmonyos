#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E547.kv，填写各字段
# 对应的人类文档: doc/E547.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E547
trigger_tool: conan
phase: configure|link
error_signature: attempted static link of dynamic object|Library 'xml2' not found in package|set(CMAKE_FIND_LIBRARY_SUFFIXES .a)|ld.lld: error: undefined symbol

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: build-system|cmake|linker
match_keywords: CMAKE_FIND_LIBRARY_SUFFIXES,-static,LINK_SEARCH_END_STATIC,static link,dynamic object,shared-only,libxml2,partial static
title: 静态库配方 + 制品仓 shared-only 依赖：FIND_LIBRARY_SUFFIXES 钉 .a 找不到依赖、test/工具目标全静态链接拒绝动态对象

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游静态构建分支常把 CMAKE_FIND_LIBRARY_SUFFIXES 钉成 .a（期望依赖也静态），但制品仓该依赖只有共享二进制（如 libxml2/2.15.3 配方硬编码 BUILD_SHARED_LIBS=ON）→ find_library 必败；即便放宽后缀让 find_library 找到 .so，test/工具目标常再叠 -static CXX 标志与 LINK_SEARCH_END_STATIC（追加 -Wl,-Bstatic），ld.lld 直接拒绝链接动态对象。
affected_scope: 所有静态构建（options.shared=False）且依赖在制品仓只有共享二进制的包；症状序列：Library not found in package → NOTFOUND → attempted static link of dynamic object
verification_cmd:

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:
rec_approach: ①补丁把后缀放宽为 .a;.so（静态优先共享兜底）；②给 -static 与 LINK_SEARCH_END_STATIC 加开关变量（如 OHOS_BUILD_PARTIAL_STATIC），OHOS 下保留部分静态（libopenbabel.a + NEEDED libxml2.so.16），运行期靠 conanrun env LD_LIBRARY_PATH 指向 conan 包目录；③conan 缓存内依赖 .so 的 symlink 链要在 generate() 实体化（HMDFS symlink 间歇 EACCES 会让 CMakeDeps 库扫描找不到 libxml2.so）。实例：openbabel/3.1.1 patches/0001/0002/0005
rec_description:        一句话描述这个推荐方案
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
