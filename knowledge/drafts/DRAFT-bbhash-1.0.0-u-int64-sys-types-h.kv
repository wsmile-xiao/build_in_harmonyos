#====================================================================
# DRAFT-bbhash-1.0.0-u-int64-sys-types-h — OHOS 上 BSD 遗留 typedef
# u_int64_t 不随传递包含提供，需显式包含 <sys/types.h>
# 关联库: bbhash 1.0.0（r01，OHOS aarch64 实测）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# 触发: clang++ (aarch64-linux-ohos) 编译 BooPHF.h（header-only），
# 报 "unknown type name 'u_int64_t'; did you mean 'uint64_t'?"
id:                     DRAFT-bbhash-1.0.0-u-int64-sys-types-h
trigger_tool:           clang|make
phase:                  compilation
error_signature:        unknown type name 'u_int64_t'|unknown type name 'u_int32_t'|unknown type name 'u_int16_t'|did you mean 'uint64_t'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               headers, portability, ohos, libc, compat, typedef
match_keywords:         u_int64_t, u_int32_t, sys/types.h, uint64_t, BSD typedef, unknown type name, OHOS, header-only, transitive include
title:                  OHOS 上使用 BSD 遗留 typedef（u_int64_t 等）的头文件需显式包含 <sys/types.h>

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             BSD 遗留整数 typedef（u_int64_t/u_int32_t/u_int16_t/u_int8_t）在 glibc 上由 <sys/types.h> 定义，且经常被其他头文件（<unistd.h>/<stdio.h> 等）传递引入；OHOS（musl 系 libc）不会传递提供这些名字，上游头文件未显式包含 <sys/types.h> 即报 unknown type name。与 uint64_t（<stdint.h>/<cstdint> 标准名）不同，u_int64_t 属 BSD 扩展名。
affected_scope:         任何在 OHOS 上编译时使用 u_int64_t/u_int32_t 等 BSD 遗留 typedef 的 C/C++ 库（尤其 header-only 单头文件库，无构建系统兜底）；Linux/glibc 与 macOS 上因传递包含通常正常，属 OHOS 平台差异。
verification_cmd:       grep -nE 'u_int(64|32|16|8)_t' 源码目录 | head; # 存在则查翻译单元是否显式 #include <sys/types.h>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           add-sys-types-h-include
rec_description:        在使用 u_int64_t 的翻译单元/头文件显式添加 #include <sys/types.h>（普适 POSIX 头，非平台宏），一行最小补丁
rec_command:            sed -i 's/#include <unistd.h>/#include <unistd.h>\n#include <sys\/types.h> \/\/ u_int64_t (not pulled in transitively on all libc)/' BooPHF.h
rec_auto_fix:           false
rec_impl:               patch-source

fallback_priority:      2
fallback_approach:      cstdint-rename
fallback_description:   将 u_int64_t 全局替换为 uint64_t（<cstdint> 标准名），改动面更大但更彻底；仅在无法加 POSIX 头时选用
fallback_auto_fix:      false
