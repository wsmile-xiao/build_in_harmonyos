#====================================================================
# Draft E3004 — PIDL + Parse::Yapp 生成器依赖降级（vendored + 预生成）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E3004
trigger_tool:           waf|configure|perl|pidl
phase:                  configuration|compilation
error_signature:        Can't locate Yapp|Parse::Yapp|pidl.*yapp|Could not find perl module Yapp|pidl:.*failed

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, perl, pidl, IDL, generated-code
match_keywords:         pidl, Parse::Yapp, yapp, IDL, NDR, RPC, perl module, generated parser, pre-generated, vendored
title:                  PIDL 生成器的 Parse::Yapp 依赖：vendored Driver.pm + release tarball 预生成解析器，缺失时降级为 warning（OHOS）
prescan_pattern:        Can't locate Yapp|Parse::Yapp|Could not find perl module Yapp
prescan_globs:          wscript, wscript_build, *.pl, *.pm, Makefile*

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Samba 的 PIDL（IDL→NDR/RPC 代码生成器）依赖 Perl 模块 Parse::Yapp（yapp 命令）对 IDL 文法做 LR 解析。OHOS 无 yapp/Parse::Yapp（perl tool_requires 也不含）。但 **release tarball 自带预生成的解析器**（IDL.pm/Expr.pm 等），因此"yapp 缺失"不一定致命——上游把它当硬失败是过度防御；本地构建失败点恰在 `Can't locate Yapp/Parse::Yapp`。
affected_scope:         所有在 OHOS 上构建 Samba 系（用 PIDL 生成 NDR/RPC 代码）的包；以及其它依赖 Perl 生成器且缺模块的软件。
verification_cmd:       perl -MParse::Yapp -e1 2>&1   # 观察是否可加载；不装源下跑 waf 观察 yapp 降级日志

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           ohos-pidl-yapp-degrade
rec_description:        ① 配方 `tool_requires` 声明 perl；② 把 vendored `Parse::Yapp::Driver.pm`（CPAN Parse-Yapp 1.21，注入 export_sources）放进程可加载路径；③ PIDL wscript 把"yapp 缺失"由硬失败改为 `Logs.warn` 降级——release tarball 带预生成解析器，生成阶段用预生成产物即足够。
rec_command:            (export PERL5LIB=<vendored-parse-yapp>; export PATH=$PATH:<perl-tools>; python3 buildtools/bin/waf pidl)
rec_auto_fix:           false
rec_impl:               archives/s/samba/4.21.0/patches/0004-pidl-wscript.patch + export_sources(parse-yapp/Parse/Yapp/Driver.pm)

fallback_priority:      2
fallback_approach:      install-perl-module
fallback_description:   若平台允许（CI worker 可写内网源），用 cpanm 安装 Parse-YYapp 到 tool_requires 环境；否则依赖预生成产物。
fallback_command:       cpanm Parse::Yapp
fallback_auto_fix:      false

# ★ 禁止策略 ★
forbid_1_pattern:       fake the generated parser|ship hand-made IDL.pm away from release|hardcode /data paths to pm
forbid_1_reason:        R8 禁平台宏；伪造生成器=剑走偏锋；硬编码设备路径不跨 CI。
forbid_1_consequence:   生成器语义被破坏，生成的 NDR/RPC 代码失真；CI 不可复现。

# ═══ Layer 4: 原则引用 ═══
principles:             minimal-patch, real-evidence-over-assumption, vendor-what-missing

# ═══ 关系图 ═══
causes:                 [E3004]
caused_by:              []
similar_to:             [E3001]
conflicts_with:         []
prerequisite_of:        []

