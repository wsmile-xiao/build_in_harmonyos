#====================================================================
# DRAFT-appstream-1.2.0-ohos-meson-usr-include-hardcode.kv
# meson.build 硬编码 include_directories(['/usr/include']) 在 OHOS 构建机
# 无 /usr/include 目录 → meson 配置期直接报错；移除硬编码路径，头文件由
# Conan 依赖 extra_cflags -I 提供
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R02）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           meson
phase:                  configuration
error_signature:        Include dir /usr/include does not exist|
                        ERROR: Include dir /usr/include does not exist|
                        include_directories.*usr/include
severity:               2
category:               build-system, meson, platform, portability
match_keywords:         meson, include_directories, /usr/include, OHOS, hardcoded path,
                        cc.find_library, cc.has_header, stemmer, libstemmer, extra_cflags,
                        pkg-config, conan, configuration
title:                  meson 源硬编码 include_directories(['/usr/include']) 在 OHOS 构建机（无 /usr/include）配置期直接报错
root_cause:             OHOS 构建机不存在 /usr/include 目录（工具链 sysroot 布局不同）；
                        上游 meson.build 对某些按 cc.find_library / cc.has_header 探测的
                        依赖（如 Snowball libstemmer）硬编码
                        `include_directories(['/usr/include'])` 作为后备头目录。
                        meson 对绝对路径 include_directories 在配置期做存在性校验，
                        目录不存在直接 ERROR（非警告）。
affected_scope:         任何 meson 项目在 OHOS 上依赖按裸库名+系统头目录探测的 C 库
                        （stemmer/xxhash 等），且上游硬编码 /usr/include 或
                        /usr/include/<sub> 的 include_directories。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing
rec_priority:           1
rec_approach:           remove-hardcoded-usr-include-patch
rec_description:        最小补丁移除 meson.build 中硬编码的 include_directories(['/usr/include'])
                        （补丁内不留平台宏，遵循 iron-rules R8）；头文件由 Conan 依赖
                        经 MesonToolchain extra_cflags -I<dep>/include 提供，
                        cc.has_header('xxx.h') 经 c_args 探测成功即可；include_directories()
                        留空等价于仅依赖 c_args 的 -I。
rec_command:            tc.extra_cflags.append(f"-I{os.path.join(dep_pkg, 'include')}")
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       include_directories\(['"]/usr/include
forbid_1_reason:        OHOS 无该目录，配置期 ERROR；不能作为后备路径
forbid_2_pattern:       sed.*-i.*usr/include.*build\.ninja
forbid_2_reason:        改生成文件违反 R6，且构建目录每次重建丢失
principles:             R6, R8
causes:                 []
caused_by:              []
similar_to:             [E075, E238]
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-ohos-meson-usr-include-hardcode.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R02（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.8
