# ═══ Draft knowledge entry — Catch2 TEST_CASE 注释块计数陷阱（rule4 少报误判） ═══
# Timestamp: 2026-09-25
# Software: libnpy 1.0.1（任何 Catch2/GTest 宏式测试套件的 N 清点）
# Gate: 上游测试清点（R51 第一步）与 W4 审计 N 复核
# Status: DRAFT — needs human/AI review to promote to E-entry

id: DRAFT-E732
title: "Catch2 TEST_CASE 源码 grep 会数进块注释——libnpy 实测 16 vs 注册 15、REQUIRE 93 vs 实跑 87，声明 N 取源码宏最大候选并把注释块差额归因 NOT_RUN，断言口径另列不混用"
trigger_tool: "tests|audit|prescan"
phase: "testing|pre-pr-audit"
error_signature: 'All tests passed \(\d+ assertions in \d+ test cases\)|TEST_CASE\( "Load bool data"|bool not supported|实测 N > 声明 N|少报'
severity: 2
category: "test-counting|rule4|catch2|audit"
match_keywords: "TEST_CASE, REQUIRE, grep -c, 注册数, 候选数法, NOT_RUN, 少报, rule4, block comment"
prescan_pattern: "TEST_CASE\\s*\\("
keywords: "Catch2, TEST_CASE, REQUIRE, 用例数, N 口径, 块注释, 少报, rule4, 源码宏, 框架注册"
approach: >
  同一测试套件的"用例数"至少两个口径：源码宏 grep 数 vs 框架注册/实跑数。二者差额
  通常来自上游块注释（本例 /* bool not supported */ 整块注释掉 1 个 TEST_CASE +
  6 条 REQUIRE）。声明 N 取源码宏最大候选（本例 16），实跑 N′=15，差额 1 逐项归因为
  NOT_RUN（写明上游注释证据行），保证 TOTAL=PASS+FAIL+SKIP+NOT_RUN 恒等；断言数
  （93 源码 / 87 实跑）是另一口径，必须单独成行说明、绝不用例数混用。
root_cause: >
  grep 按行匹配不解析注释，块注释内的宏被计入；框架（Catch2）只注册可编译的宏。
  审方"独立克隆清点"最常见动作是 grep——若声明按注册数（15）而审方 grep 得 16，
  即触发「实测 N > 声明 N → 少报直接不通过」（rule4，外部审查第二大失败项）。
affected_scope: >
  所有用宏注册式测试框架（Catch2 TEST_CASE / GTEST_TEST 族）且上游曾注释停用用例的
  包；也适用于任何"源码宏数 > 框架注册数"的测试清点。
verification_cmd: >
  SRC="$HOME/ws/tmp/builds/libnpy-1.0.1.work/tests" &&
  echo "src_macros=$(grep -c TEST_CASE "$SRC/test-read.cpp") registered=$("$SRC/builddir/test-read" --list-test-names-only | wc -l)"
  # 期望 src_macros=16、registered=15；差额在 test-read.cpp:194-210 块注释
rec_priority: 1
rec_approach: "max-candidate-with-attribution"
rec_description: >
  清点时并列记录四口径（源码宏 / 框架注册 / 断言源码 / 断言实跑）+ meson/ctest 层注册；
  声明 N 用源码宏最大值；差额按"注释块/条件编译/未注册"逐项归因写进 notes.md 申报表与
  PR 正文；TOTAL 四分项恒等式必写；断言口径另列并标注"不与用例口径混用"。
rec_command: "grep -c TEST_CASE <test-src> && ./<binary> --list-test-names-only | wc -l && ./<binary> 2>&1 | grep 'assertions in'"
rec_auto_fix: false
rec_impl: "test-count-census-four-calibers"
fallback_priority: 2
fallback_approach: "declare-registered-with-max-note"
fallback_description: >
  若上游宏不可读（生成式测试），以框架注册数为 N，但在说明列同时写出源码 grep 数与
  差额归因，保证任何口径的实测值都 <= 声明面披露的最大值。
fallback_command: "grep -c TEST_CASE <src> ; <binary> --list-test-names-only | wc -l"
fallback_auto_fix: false
fallback_impl: "census-note"
principles: "声明面要覆盖审方可能用的所有计数口径；差额归因比压小 N 更安全（N 少报是硬性不通过）"
caused_by: "grep 不解析块注释 + 审方独立清点最常用 grep"
causes: "声明 15、审方实测 16 → rule4 少报 FAIL；或四分项与恒等式对不上"
similar_to: "E730、E733（同任务）；jsoncons 计数先例（宏 907 vs 注册 869）"
conflicts_with:
prerequisite_of:
doc_file: "knowledge/drafts/DRAFT-E732-catch2-testcase-comment-block-count.md"
last_updated: "2026-09-25"
source_event: "libnpy 1.0.1 上游测试清点：grep 16/93 vs Catch2 注册/实跑 15/87，差额全落块注释"
authors: "libnpy-1.0.1-executor"
source_pr:
source_commit:
metrics_success_count: 1
metrics_fail_count: 0
metrics_confidence: 0.9
metrics_last_used: "2026-09-25"
