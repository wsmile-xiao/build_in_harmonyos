#====================================================================
# DRAFT-fabric-completion-conan-pkg-bookkeeping
# conan 2 writes conaninfo.txt/conanmanifest.txt into package root
#====================================================================

id:                     DRAFT-fabric-completion-conan-pkg-bookkeeping
trigger_tool:           conan|test_package
phase:                  test
error_signature:        conaninfo.txt|conanmanifest.txt|包全树恰.*文件.*FAIL
severity:               1
category:               conan|test-package|probe|harmonyos
match_keywords:         conaninfo.txt, conanmanifest.txt, 全树计数, 文件计数探针, 簿记文件, package folder, 纯数据包, 本机通过真机失败
title:                  conan 2.x 在包根写入 conaninfo.txt/conanmanifest.txt 簿记文件，探针全树文件计数必须排除（真机 2 内容文件 + 2 簿记 = 4 ≠ 2 FAIL）

root_cause:             conan 2 create 会在 package_folder 根目录写入 conaninfo.txt 与 conanmanifest.txt 两个簿记文件；对包根做全树精确文件计数的消费者探针把簿记文件计入上游内容清单 → 计数偏大 FAIL。手工搭建的本机模拟包根没有簿记文件，所以本机全过、真机才暴露——「本机过、真机挂」的经典环境差。

affected_scope:         所有对包根/子树做精确文件计数断言的 test_package 探针（纯数据包范式常见，kicad-demos/ldraw-parts 系）。

verification_cmd:       conan create . --build=missing  # 真机 probe: [FAIL] 包全树恰 2 文件（4!=2）；计数排除簿记后 all assertions passed

rec_priority:           1
rec_approach:           exclude-bookkeeping-in-count
rec_description:        探针递归计数函数跳过 conaninfo.txt/conanmanifest.txt（与配方 build() 防漂移计数口径一致）；completions/doc 等子目录本身不含簿记文件，子目录断言无需改变。
rec_command:            grep -n 'is_bookkeeping' test_package/*.cpp && conan create . --build=missing
rec_auto_fix:           false
rec_impl:               none

fallback_priority:      2
fallback_approach:      count-only-known-paths
fallback_description:   若不想引入排除名单，改为只对已知安装路径逐一断言（completions 恰 1 + doc 恰 1），取消全树递归计数；防漂移能力略降（包根出现意外文件不再报错）。
fallback_command:       sed -n '/count_recursive/p' test_package/*.cpp
fallback_auto_fix:      false
