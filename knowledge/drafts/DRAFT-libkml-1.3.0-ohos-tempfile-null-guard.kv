id:                     DRAFT-libkml-1.3.0-ohos-tempfile-null-guard
severity:               3
category:               platform, limitation, ohos, filesystem, tempfile
trigger_tool:           cmake|conan|make|test
phase:                  compilation|testing|runtime
error_signature:        mkstemp: No such file or directory|Read-only file system|TempFile::CreateTempFile|CreateNewTempFile|SIGSEGV|exit 139|/tmp/libkmlXXXXXX|TestCreateFromParseOfKmz
match_keywords:         OHOS, /tmp, read-only, erofs, TMPDIR, mkstemp, CreateNewTempFile, TempFile, null dereference, SIGSEGV, 139, libkml, temp dir
title:                  OHOS /tmp 只读下源码硬编码 mkstemp(/tmp/...) 临时文件失败 + 失败路径测试 NULL 解引用的可复用源码修复边界
root_cause: |
  鸿蒙 OHOS 系统 /tmp 为只读挂载(E002)。libkml 1.3.0 的
  src/kml/base/file_posix.cc File::CreateNewTempFile() 硬编码
  mkstemp("/tmp/libkmlXXXXXX") 不读取 $TMPDIR，导致临时文件创建失败返回 false；
  测试辅助 KmlToKmz() 对 CreateTempFile() 返回 NULL 未做防护，直接调用
  tempfile->name() 触发空指针解引用，上游测试 test_kml_file 以 SIGSEGV(exit 139) 崩溃。
affected_scope:         所有源码硬编码 /tmp 且未读取 $TMPDIR 的 C/C++ 库（CMake/make 系），
                        以及临时文件创建失败路径未做 NULL 防护的上游测试/辅助函数。
verification_cmd:       cd build/bin && TMPDIR=/可写目录 ./test_kml_file; echo rc=$?
rec_priority:           1
rec_approach: |
  1) 源码级: CreateNewTempFile() 改为优先读取 $TMPDIR 回退 /tmp(非设备硬编码路径)。
  2) 防护级: 临时文件创建失败(NULL)路径必须检查, 不得直接解引用。
  3) 测试: 新增经库 API 的 OHOS 特定临时文件 consumer 测试。
rec_description:        可复用边界: 优先 $TMPDIR 回退 /tmp 的临时目录解析 + 创建失败 NULL 防护 + 库 API 级 OHOS 测试
rec_command: |
  # build: cmake -DBUILD_TESTING=ON ...; make
  # verify: cd bin && TMPDIR=/可写目录 ./test_kml_file && ./test_ohos_tempfile
rec_auto_fix:           true
rec_impl:               source-patch-tmpdir-null-guard
principles:             P014
doc_file:               doc/E-draft-libkml-1.3.0-ohos-tempfile-null-guard.md
error_text_excerpt: |
  [ RUN      ] KmlFileTest.TestCreateFromParseOfKmz
  timeout: the monitored command dumped core
  Signal 11 (core dumped)
source_lib:             libkml 1.3.0
draft_status:           pending_editor_review
