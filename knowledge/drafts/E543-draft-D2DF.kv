#====================================================================
# Draft: init-build URL 关键字启发式把 CMake 项目误判为 autotools，
#        且 Conan CMakeDeps 下 Catch2 测试体系缺 CMAKE_MODULE_PATH
#        （microservice-essentials 0.1.0 适配实证）
#====================================================================

id:                     E543
trigger_tool:           init-build|conan-init|cmake|conan|conan create
phase:                  configuration|testing
error_signature:        BUILD_SYSTEM="autotools"|include could not find requested file: Catch|Unknown CMake command "catch_discover_tests"|conanfile\.py 模板不可用（autotools）

severity:               2
category:               build-system, cmake, detection, conan, ohos
match_keywords:         init-build, autotools, CMakeLists.txt, codeload, refs/tags, URL, build system detection, conan-init, catch_discover_tests, include(Catch), Catch.cmake, CMAKE_MODULE_PATH, CMakeDeps, Catch2

title:                  init-build 按 URL 关键字检测构建系统：无 "cmake" 字样的 CMake 项目被误判为 autotools，生成错误配方模板；上游 Catch2 测试体系在 Conan CMakeDeps 下还缺 Catch.cmake 模块路径

root_cause:             init_build.py 的构建系统检测用 URL 关键字启发式（url 含 "cmake" → cmake，否则回退 autotools）；codeload.github.com 形如 .../tar.gz/refs/tags/<tag> 的官方归档 URL 不含 "cmake" 字样 → CMake 项目被误判为 autotools，conan-init 生成 autotools 模板配方（configure/make）。另外，上游 tests/CMakeLists.txt 用 include(Catch) + catch_discover_tests() 时，Conan 2 CMakeDeps 生成的 Catch2 config 不把 Catch.cmake 模块目录（lib/cmake/Catch2）加入 CMAKE_MODULE_PATH，CMake 报 "include could not find requested file: Catch" 与 "Unknown CMake command catch_discover_tests"。

affected_scope:         所有源 URL 不含 "cmake" 字样的 CMake 项目（codeload/镜像 refs/tags 归档 URL 常见）；以及任何上游测试用 Catch2 include(Catch)/catch_discover_tests 且以 Conan 2 CMakeDeps 构建的配方。

verification_cmd:       grep -E "CMakeLists.txt" $BUILD_SRC_DIR/CMakeLists.txt && test -f "$BUILD_SRC_DIR/CMakeLists.txt" && echo "真实构建系统=cmake" ; python3 scripts/ohc-run.py conan-verify microservice-essentials 0.1.0

rec_priority:           1
rec_approach:           source-marker-over-url-heuristic
rec_description:        init-build/conan-init 后必须按源码实际构建系统标记（CMakeLists.txt/configure/Makefile/meson.build）核对，URL 关键字检测仅作参考；CMake 项目用 templates/conanfile-cmake.py.tmpl 重写配方。Catch2 测试配置显式传 -DCMAKE_MODULE_PATH=<catch2 包>/lib/cmake/Catch2。
rec_command:            python3 scripts/ohc-run.py init-build <lib> <ver> --url=<官方URL> && ls $BUILD_SRC_DIR/CMakeLists.txt && cp templates/conanfile-cmake.py.tmpl archives/<l>/<lib>/<ver>/conanfile.py && cmake -S . -B build -DCMAKE_TOOLCHAIN_FILE=conan_toolchain.cmake -DCMAKE_MODULE_PATH=<catch2>/lib/cmake/Catch2
rec_auto_fix:           false
rec_impl:               manual-source-marker

fallback_priority:      2
fallback_approach:      keep-toolchain-module-path
fallback_description:   若上游 CMake 用 add_subdirectory 聚合 Catch2 且模块路径由 find_package 自带，可仅在配置命令层补充 CMAKE_MODULE_PATH，不改上游 CMakeLists。
fallback_command:       cmake -S . -B build -DCMAKE_MODULE_PATH=$(find ~/.conan2/p -name Catch.cmake -path "*cmake/Catch2*" | xargs dirname)
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       sed -i .*BUILD_SYSTEM|伪造 configure 脚本|手写 .ci-result.json
forbid_1_reason:        改检测逻辑/伪造构建系统标记绕过会掩盖真实构建系统，导致配方与源码不符（R33/R34 精神）。
forbid_1_consequence:   配方使用错误构建系统模板，conan create 在 CI 环境失败，且下游消费者链接不到正确产物。
forbid_2_pattern:       空壳 test_package|print-only test
forbid_2_reason:        R34/PF3 禁止空壳测试；test_package 必须实际调用被测包 API。
forbid_2_consequence:   CI L0c/PF3 拦截，PR 无法合入。

principles:             real-evidence-over-assumption, minimal-recipe-change, official-source-first

causes:                 []
caused_by:              []
similar_to:             [E195, E216, E393]
conflicts_with:         []
prerequisite_of:        []

