#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: python|clang|ld|conan
phase: compilation|linking|packaging|testing
error_signature: command 'cc' failed: No such file or directory|fatal error: Python.h file not found|ImportError:.*undefined symbol|PyInit_.*not found|Permission denied.*_fastconstmap.*\.so|temporary directory .* is not owned

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: ohos,python,packaging,portability
match_keywords: Python C extension,python3.12,PyInit,OHOS,Conan
title: OHOS Python C 扩展必须使用 Conan Python 头文件与共享库路径

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Python C 扩展的构建解释器、头文件、libpython 和 OHOS 加载权限若依赖设备私有 PATH，会导致编译器缺失、ABI 符号缺失或 HMDFS 拒绝加载
affected_scope: 使用 setuptools 或直接 C 编译构建 Python C 扩展的 Conan 配方与 test_package
verification_cmd: conan create archives/f/fastconstmap/0.9.0 --build=fastconstmap/* -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 -s:h os.version=6.0 -s:b os.version=6.0

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: conan-python-build-path
rec_description: 将 python/3.12.9 作为 Conan 依赖，动态发现其头文件与 libpython，并从 profile/conf 或 PATH 发现编译器和签名工具；test_package 用 ensurepip 加官方固定 wheel 的 SHA-256 校验安装 pytest 到一次性目录，并以显式 --basetemp 规避 HMDFS 所有权元数据问题，最终通过 runenv 暴露包的 Python 路径
rec_command: conan create archives/f/fastconstmap/0.9.0 --build=fastconstmap/* -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
rec_auto_fix: false
rec_impl: source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: /data/service/hnp/bin/clang|/data/service/hnp/bin/binary-sign-tool|/data/storage/el2/base/cache
forbid_1_reason: 将设备私有路径固化到配方会使干净 CI 和其他 OHOS 设备不可复现
forbid_1_consequence: 构建或 test_package 只能在单一设备上偶然通过
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: R01,R18,R35

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

