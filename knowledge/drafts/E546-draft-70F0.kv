entry_id: E546
title: aarch64 pt_regs 结构使用 regs[] 而非 ARM32 的 uregs[]
category: architecture, arm, aarch64
severity: high
error_signature: 'struct pt_regs'.*has no member named 'uregs'|ARM_r\d+.*uregs
root_cause: ARM32 的 pt_regs 使用 uregs[] 数组存储通用寄存器，而 aarch64 使用 regs[] 数组。直接访问 uregs[] 在 aarch64 上编译失败。
match_keywords: pt_regs, uregs, regs, aarch64, ARM register, user_pt_regs
rec_approach: |
  创建兼容宏抽象差异：
  #ifdef __aarch64__
  #define PT_REGS_GET_REG(pregs_ptr, n) ((pregs_ptr)->regs[n])
  #else
  #define PT_REGS_GET_REG(pregs_ptr, n) ((pregs_ptr)->uregs[n])
  #endif
  
  然后统一使用 PT_REGS_GET_REG(&regs, ARM_r0) 访问寄存器
rec_description: 使用宏抽象 ARM32 和 aarch64 的 pt_regs 结构差异
rec_command: |
  # 在头文件中添加兼容宏
  cat >> trace.h << 'END'
  #ifdef __aarch64__
  #define PT_REGS_GET_REG(pregs_ptr, n) ((pregs_ptr)->regs[n])
  #else
  #define PT_REGS_GET_REG(pregs_ptr, n) ((pregs_ptr)->uregs[n])
  #endif
  END
  
  # 替换直接访问
  sed -i 's/regs\.uregs\[ARM_r\([0-9]\)\]/PT_REGS_GET_REG(\&regs, ARM_r\1)/g' *.c
affected_scope: ARM 调试工具（strace, ltrace, gdb），内核交互代码
verification_cmd: grep -n "\.uregs\|\.regs\[" *.c
related_entries: E547
last_updated: 2026-09-03
notes: |
  ltrace 0.7.3 案例：trace.c 需要修复寄存器访问
  注意：头文件是 <asm/ptrace.h>，结构在 aarch64 上是 user_pt_regs
example_fix: |
  // 原代码（仅 ARM32）
  long ret = regs.uregs[0];
  
  // 修复后（ARM32 + aarch64）
  #ifdef __aarch64__
  #define PT_REGS_GET_REG(pregs_ptr, n) ((pregs_ptr)->regs[n])
  #else
  #define PT_REGS_GET_REG(pregs_ptr, n) ((pregs_ptr)->uregs[n])
  #endif
  
  long ret = PT_REGS_GET_REG(&regs, 0);
