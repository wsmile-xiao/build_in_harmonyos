#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: runtime
phase: runtime
error_signature: Can't initialize libusb|libusb_init.*r=-1|sysfs_get_device_list.*errno=13|libusb_get_device_list.*NULL

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform, ohos, limitation, compat, portability
match_keywords: libusb_init, libusb_get_device_list, sysfs_get_device_list, errno=13, EACCES, /dev/bus/usb, SIGSEGV, 139, FEL, HongMeng kernel
title: OHOS 受限 /dev/bus 下 libusb_init() 失败 + 未检查返回值 → NULL context SIGSEGV

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: libusb_init() 在 OHOS 受限环境（无 /dev/bus/usb 访问权限；sysfs_get_device_list opendir /sys/bus/usb/devices 返回 EACCES/13）下返回 -1，ctx 保持 NULL。调用方若忽略返回值并把 NULL 传给 libusb_get_device_list()，会解引用 libusb 默认 context 而 SIGSEGV(139)。
affected_scope: 经 libusb 访问 USB 的命令行工具（FEL/烧录/调试类）在 OHOS 沙箱/容器/CI（无 USB 设备节点访问权）下的启动路径
verification_cmd: LIBUSB_DEBUG=4 ./tool  # 观察 libusb_init r=-1；./tool <subcmd>; echo $?  # 修复前 139，修复后 255

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: check-libusb-init-return
rec_description: 调用 libusb_init() 后必须检查返回值；非 0 时打印可读错误并退出，禁止把可能为 NULL 的 context 继续传给 libusb_get_device_list()。
rec_command: if(libusb_init(&context) != 0) { printf("ERROR: Can't initialize libusb\r\n"); return -1; }
rec_auto_fix: false

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: env-libusb-debug-diagnose
fallback_description: 用 LIBUSB_DEBUG=4 定位 libusb 内部失败点（如 opendir /sys/bus/usb/devices errno=13），确认是环境权限问题而非内核不识别——libusb 1.0.27 已能识别 HongMeng/OHOS 内核。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: libusb_get_device_list|libusb_init
forbid_1_reason: 在未检查 libusb_init() 返回值的前提下继续使用 context
forbid_1_consequence: 进程崩溃且无任何诊断输出（rc=139），CI/test_package 误判为随机失败
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
prescan_pattern: libusb_init\([[:space:]]*&
prescan_globs: *.c, *.h, *.cc, *.cpp
doc_file:               doc/E429.md
last_updated: 2026-10-03
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

