#====================================================================
# E544 draft — 在 x86 runner 上用 QEMU 强制执行静态 AArch64 CLI 功能测试
# 对应文档: knowledge/drafts/E544-draft-0ADA.md
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E544
trigger_tool:           conan|test_package|qemu-aarch64|make|clang
phase:                  testing|runtime
error_signature:        Exec format error|qemu-aarch64.*not found|Could not open '/lib/ld-musl-aarch64.so.1'|target execution requires an AArch64 runner

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               testing, conan, cross-compile, toolchain
match_keywords:         qemu-aarch64, static CLI, test_package, AArch64 runner, cross-architecture, Exec format error, ld-musl-aarch64, successful skip, libc-only
title:                  静态 libc-only CLI 在 x86 runner 上必须经 QEMU 执行功能断言，缺模拟器即失败

# ═══ Layer 2: 诊断层 ═══
root_cause:             Conan profile 可将目标设为 OHOS/armv8，但实际 test_package runner 仍可能是 x86_64；直接启动目标 ELF 会报 Exec format error。动态 OHOS ELF 即使用 qemu-aarch64 也可能因缺少 /lib/ld-musl-aarch64.so.1 或目标运行库而无法启动。若 test_package 在非 AArch64 runner 上成功退出，仅检查文件存在，就会把未执行的功能断言误记为通过。
affected_scope:         只依赖 libc、适合静态链接、且其真实行为可在命令行驱动的 AArch64 CLI 工具包。非 CLI 库或依赖动态运行库的程序不适用；它们必须提供目标运行环境，或如实记录未运行的功能覆盖。
verification_cmd:       make CC='<ohos-clang> -static' -j1 && qemu-aarch64 ./<tool> --help && bash test_package/test.sh <tool> ...

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           qemu-run-static-cli-consumer-test
rec_description:        对仅依赖 libc 的 CLI，在 Conan 配方中从 profile compiler 配置取得 CC 并以 -static 链接；test_package 先验证包内绝对二进制路径存在，再在 AArch64 runner 直接运行、在非 AArch64 runner 解析 qemu-aarch64 的绝对路径并运行同一组正常与错误路径断言。QEMU 缺失必须使测试失败，不能 success-skip。
rec_command:            runner=(); case "$(uname -m)" in aarch64|arm64) ;; *) runner=("$(command -v qemu-aarch64)") || exit 1;; esac; "${runner[@]}" "$tool" <real-input>
rec_auto_fix:           false
rec_impl:               conan-test-package-qemu-static-cli

fallback_priority:      2
fallback_approach:      target-runner-required
fallback_description:   无 QEMU 或工具依赖动态 OHOS 运行库时，不伪造通过；改在真实 AArch64 HarmonyOS runner 执行同一 test_package，或将运行时覆盖如实标记为未完成。
fallback_command:       hdc shell '<installed-tool> <real-input>'
fallback_auto_fix:      false
fallback_impl:          external-target-runner

# ═══ 禁止策略 ═══
forbid_1_pattern:       uname -m.*(x86|amd64).*exit 0|skip.*target.*execution.*exit 0
forbid_1_reason:        跨架构不能执行目标 ELF 不是成功测试的理由；仅文件存在性检查不能证明 CLI 行为正确。
forbid_1_consequence:   test_package 在未执行功能断言时仍返回成功，形成假绿并绕过 R34 的真实使用要求。
forbid_2_pattern:       qemu-aarch64.*<dynamic-target>.*without.*loader|qemu-aarch64.*exit 0.*skip
forbid_2_reason:        QEMU 不自带 OHOS musl loader 或动态依赖；对动态目标盲目执行会失败，随后跳过会掩盖运行时缺口。
forbid_2_consequence:   动态加载失败被误分类为测试已覆盖，真实目标行为没有验证。

# ═══ Layer 4: 原则引用 ═══
principles:             P010, P013

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             [E423, E294]
conflicts_with:         []
prerequisite_of:        []

