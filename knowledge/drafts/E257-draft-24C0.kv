#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E257.kv，填写各字段
# 对应的人类文档: doc/E257.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E257
trigger_tool: clean-verify|configure
phase: configuration
error_signature: G0.*configure.*failed.*exit 127|./configure: No such file or directory|clean-verify.*configure 失败

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 1
category: build-system, makefile, clean-verify
match_keywords: clean-verify,G0,configure,No such file,makefile,NetSurf,NSSHARED,standalone Makefile,exit 127,no configure script
title: clean-verify G0 对无 configure 的 Makefile 项目硬失败属预期（框架 autotools 假设）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: clean_verify.py 的 G0 阶段硬编码先执行 ./configure（autotools 框架假设）。纯 Makefile 项目（NetSurf 系 libwapcaplet/libnsutils 等，无 configure 脚本）在此阶段必然 exit 127 失败。此为框架层 G0 的构建系统假设局限，不是配方缺陷；且 clean-verify 属非阻塞门禁（finish [3/10]），权威干净构建可复现验证是 conan-verify G2 的 conan create（从干净源码 build+test）。
affected_scope: 所有无 configure 的纯 Makefile/自有构建系统项目（NetSurf NSSHARED 系：libwapcaplet、libnsutils、libnslog、libdom 等）
verification_cmd: python3 scripts/ohc-run.py conan-verify libwapcaplet 0.4.3.2（G2 conan create 通过即视为干净构建可复现）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: verify-via-conan-create
rec_description: clean-verify G0 configure 失败标记为预期（参考 notes.md 记录），不修改配方伪造 configure；以 conan-verify G2 真实 conan create 作为干净构建验证
rec_command: python3 scripts/ohc-run.py conan-verify <软件> <版本>
rec_auto_fix: false
rec_impl: 

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: document-in-notes
fallback_description: 在 notes.md 的注意事项中记录 clean-verify G0 失败为预期（本配方 0.4.3.2 已记录）
fallback_command: 
fallback_auto_fix: false
fallback_impl: 

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 手动编写 configure 脚本
forbid_1_reason: E058 明令禁止手动编写 configure（autoconf 生成物），Makefile 项目本身不需要
forbid_1_consequence: 破坏构建系统正确性，本地/CI 行为不一致，画蛇添足
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: 

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes: 
caused_by: 
similar_to: E058, E168
conflicts_with: 
prerequisite_of: 

