#====================================================================
# DRAFT-libfastcommon-1.0.88-glibc-stat-nsec-fields — glibc 专有
#   struct stat 纳秒字段（st_atimensec/st_mtimensec/st_ctimensec）
#   在 OHOS musl 缺失，需改用 POSIX st_atim.tv_nsec
# 对应人类文档: knowledge/drafts/DRAFT-libfastcommon-1.0.88-glibc-stat-nsec-fields.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: libfastcommon 1.0.88 上游测试 test_mblock.c 编译失败
#====================================================================

id:                     DRAFT-libfastcommon-1.0.88-glibc-stat-nsec-fields
trigger_tool:           cc|clang
phase:                  compilation
error_signature:        no member named 'st_atimensec'|
                         no member named 'st_mtimensec'|
                         no member named 'st_ctimensec'|
                         st_atimensec.*struct stat

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               ohos, musl, glibc-isms, struct-stat, portability
match_keywords:         st_atimensec, st_mtimensec, st_ctimensec, st_atim.tv_nsec,
                         struct stat, tv_nsec, musl, glibc, no member named,
                         nanosecond, 纳秒字段, POSIX, timespec
title:                  glibc 专有 struct stat 纳秒字段在 OHOS musl 缺失——
                         改用 POSIX st_atim.tv_nsec

# ═══ Layer 2: 诊断层 ═══
root_cause:             glibc 的 struct stat 提供 st_atimensec/st_mtimensec/
                         st_ctimensec 直接整数纳秒成员；musl（OHOS libc）只提供
                         POSIX 标准的 st_atim.tv_nsec/st_mtim.tv_nsec/
                         st_ctim.tv_nsec（内嵌 struct timespec）。上游代码按
                         glibc 形态写死字段，OHOS musl 编译即报
                         "no member named"。
affected_scope:         在 OHOS/musl 上编译、源码（库或测试）使用 glibc 专有
                         struct stat 直接纳秒成员的任意 C/C++ 项目
verification_cmd:       clang -c test.c  # 含 st_atimensec 的源码 → no member named
                         # 修复后: st_atim.tv_nsec 编译通过（glibc/musl 通用）

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           use-posix-tv-nsec
rec_description:        将 glibc 专有字段 st_atimensec/st_mtimensec/st_ctimensec
                         替换为 POSIX 标准 st_atim.tv_nsec/st_mtim.tv_nsec/
                         st_ctim.tv_nsec（cast 为 long 保持打印格式）。tv_nsec
                         在 glibc 与 musl 均存在，两平台通用，无需平台宏双份维护。
rec_command:            st.st_atim.tv_nsec  # 替代 st.st_atimensec
rec_auto_fix:           false
rec_impl:               source-edit

fallback_priority:      2
fallback_approach:      musl-compat-header-alias
fallback_description:   若无法改源码（第三方私有），可在 musl 兼容头为
                         struct stat 补 st_atimensec 别名宏/成员；不推荐，
                         污染全局头且与 POSIX 形态并存。
fallback_command:       (不推荐) #define st_atimensec st_atim.tv_nsec
fallback_auto_fix:      false
fallback_impl:          compat-header

forbid_1_pattern:       #ifdef __OHOS__.*atimensec
forbid_1_reason:        同一字段两种写法平台宏双份维护，徒增复杂度；POSIX
                         tv_nsec 两平台通用。
forbid_1_consequence:   维护负担与潜在行为分叉。

# ═══ Layer 4: 原则引用 ═══
principles:             []

# ═══ 关系图 (Relations) ═══
similar_to:             E081, E493, E203, DRAFT-ohos-statx-musl-compat
prerequisite_of:        []

