#====================================================================
# DRAFT-ncmpc-libcpp15-cxx20-compat
# C++23 upstream surface on OHOS clang/libc++ 15: use C++20 plus narrow patches
#====================================================================

id:                     DRAFT-ncmpc-libcpp15-cxx20-compat
trigger_tool:           clang++|meson|conan|libc++
phase:                  compilation|configuration
error_signature:        std::span.*-std=c\+\+17|constexpr.*reinterpret_cast|
                         std::compare_three_way.*time_point|operator<=>.*chrono|
                         no matching function.*compare_three_way

severity:               2
category:               cxx20|cxx23|libcpp15|harmonyos|meson|conan|source-patch
match_keywords:         ncmpc, C++23, C++20, clang 15, libc++ 15, std::span,
                         constexpr reinterpret_cast, std::compare_three_way,
                         chrono time_point, IntrusiveTreeSetOperators, weak_ordering
title:                  Build narrow C++23 Meson applications on OHOS clang 15 with C++20 plus targeted libc++ patches

root_cause: >
  ncmpc 0.53 declares C++23, but its validated build path only needs C++20 for
  std::span. The OHOS profile's C++17 setting exposes an immediate language-level
  failure, while forcing C++20 reaches the true libc++ 15 incompatibilities:
  constexpr address-span accessors using reinterpret_cast, and
  std::compare_three_way failing to compare chrono time_point keys. Both issues
  are local source-library compatibility problems and can be patched without
  changing dependency versions or introducing platform macros.

affected_scope: >
  HarmonyOS PC recipes for upstream C++20/C++23 Meson applications that compile
  with clang 15/libc++ 15, especially projects using std::span and defaulted
  three-way comparison helpers over chrono time_point keys.

verification_cmd: >
  conan create archives/n/ncmpc/0.53 -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing --build=ncmpc/*
  ncmpc --version

rec_priority:           1
rec_approach:           package-local-cppstd20-plus-libcpp15-source-patches
rec_description: >
  Keep the standard override local to the Conan recipe by setting
  self.settings.compiler.cppstd = "20". Patch only the rejected source surface:
  remove constexpr from runtime address-span accessors and provide an explicit
  std::weak_ordering comparator that uses < and > for chrono time_point values.
  Apply patches in build(), where settings are legal to inspect.
rec_command: >
  def configure(self):
      self.settings.compiler.cppstd = "20"
  # OHOS build(): apply_conandata_patches(self)
rec_auto_fix:           false
rec_impl:               conan-recipe-cppstd20-and-patch-ng

fallback_priority:      2
fallback_approach:      upstream-cxx23-when-worker-toolchain-supports-it
fallback_description: >
  If the OHOS worker moves to a newer clang/libc++ pair with a complete chrono
  spaceship path, try the upstream C++23 configuration again and drop source
  patches only after the same run_hscroll and consumer CLI tests pass.
fallback_command:       conan create archives/n/ncmpc/0.53 -pr:h=ohos-aarch64 -pr:b=ohos-aarch64
fallback_auto_fix:      false
fallback_impl:          retest-native-cxx23-on-new-toolchain

forbid_1_pattern:       compiler.cppstd.*17.*std::span
forbid_1_reason:        std::span is C++20 and lowering the package to C++17 hides the real compatibility surface.
forbid_1_consequence:   Build fails early with language errors and never reaches the actionable libc++ issue.
forbid_2_pattern:       __OHOS__.*compare|time_since_epoch.*compare
forbid_2_reason:        A standard comparator using < and > solves the chrono ordering issue without platform macros or semantic shortcuts.
forbid_2_consequence:   Patch becomes less portable and may change ordering semantics.

principles:             P017,P019
causes:                 []
caused_by:              []
similar_to:             [E296,E221]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-ncmpc-libcpp15-cxx20-compat.md
last_updated:           2026-09-12
source_event:           ncmpc 0.53 HarmonyOS PC shadow CI

authors:
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     2
metrics_confidence:     0.75
metrics_last_used:      2026-09-12

