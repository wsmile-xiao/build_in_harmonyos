#====================================================================
# E549 — MinGW DLL 导出闭包与 Windows test_package shell 边界
#====================================================================

id:                     E549
trigger_tool:           cmake|ld|gcc|conan
phase:                  linking|testing|packaging
error_signature:        undefined reference.*fftw|cannot find.*internal.*symbol|linking C shared library.*threads|syntax error: unterminated quoted string|cmd.exe.*bash -c
severity:               2
category:               mingw, windows, dll, linker, conan, test_package, runtime
match_keywords:         CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS, --export-all-symbols, dllexport, import library, MinGW, GNU ld, DLL symbol closure, test_probe.exe, VirtualRunEnv, cmd.exe, bash -c, Windows path separator

root_cause:             MinGW/GNU ld 会在 DLL 中出现显式 dllexport 时关闭隐式 export-all；若基础 DLL 没有导出线程模块所需的内部 API，线程 DLL 的 import-library 链接会失败。另一个独立边界是 Conan Windows 执行器通过 cmd.exe 调用 test()：POSIX 风格 bash -c '...' 的单引号不会由 cmd.exe 去除，反斜杠路径和 shell 展开会进一步造成未闭合引号。两类问题都可能在库本体编译成功后才暴露。
affected_scope:         所有使用 CMake 生成 MinGW shared DLL、存在显式 dllexport/线程或插件子库、并在 Conan Windows test_package 中执行运行期探针的 C/C++ 库。若目标平台是 POSIX，或 Windows 测试只做交叉编译，则不适用运行器分支。
verification_cmd:       cmake --build <build> --parallel 2；llvm-nm/objdump 检查基础 DLL 与 import library 的必需符号；Conan Windows test_package 使用 VirtualRunEnv 直接运行 test_probe.exe；目标 OHOS 侧独立执行上游 CTest 与消费者程序并回读 ELF SONAME/NEEDED/.codesign。
rec_priority:           1
rec_approach:           explicit-dll-export-closure-and-platform-test-runner
rec_description:        对 MinGW shared 构建，仅在 Windows profile 下启用 CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS 与 -Wl,--export-all-symbols，确保基础 DLL 的导出闭包覆盖子 DLL 链接需求；test_package 在 Windows 直接运行 VirtualRunEnv 提供 PATH 的 .exe，POSIX 才拼 bash -c 与 LD_LIBRARY_PATH。不要用全局 shell 权限或关闭链接错误绕过。
rec_command:            tc.variables["CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS"] = True；tc.variables["CMAKE_SHARED_LINKER_FLAGS"] = "-Wl,--export-all-symbols"；if self.settings.os == "Windows": self.run("test_probe.exe", env="conanrun")；else: self.run("<bash> -c 'export LD_LIBRARY_PATH=...; ./test_probe'", env="conanrun")
rec_auto_fix:           false
rec_impl:               conan-recipe-and-test-package

fallback_priority:      2
fallback_approach:      static-build-or-shell-wrapper
fallback_description:   如果上游 ABI 明确要求有限导出，优先逐项补齐公开符号并保留 ABI 证据；若无法证明导出闭包或 test runner 的 PATH 语义，停止发布并记录失败，不以 -Wl,--unresolved-symbols 或全局权限绕过。
fallback_command:       inspect import library symbols; run the Windows probe as a native executable with a task-local PATH
fallback_auto_fix:      false
fallback_impl:          fail-closed

principles:             P003, P005, P011, P013
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

