#====================================================================
# DRAFT-gzip-hpp-0.1.0-catch1-include-shim — 上游测试 Catch v1 单头
#   include 在制品仓仅有 catch2/2.13.10 (v2 合并头) 时用 include shim
#   目录转发适配, 不改上游源码与 CMake
# 对应人类文档: knowledge/drafts/DRAFT-gzip-hpp-0.1.0-catch1-include-shim.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: gzip-hpp 0.1.0 适配 HarmonyOS PC（test/main.cpp 等
#           #include <catch.hpp>, 制品仓无 catch/1.9.6 仅有 catch2/2.13.10）
#====================================================================

id:                     DRAFT-gzip-hpp-0.1.0-catch1-include-shim
trigger_tool:           clang/cmake/conan
phase:                  testing
error_signature:        catch\.hpp.*file not found|fatal error: 'catch\.hpp'|
                         catch2/catch\.hpp.*file not found|Catch v1.*include

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               headers, testing, conan, build-system
match_keywords:         catch.hpp, catch2, include shim, Catch v1, TEST_CASE,
                         amalgamated header, header-only, upstream test
title:                  上游测试 Catch v1 单头 include 用 include shim 目录转发到 catch2/2.13.10 合并头, 不改上游源码

# ═══ Layer 2: 诊断层 ═══
root_cause:             上游测试按 Catch v1 约定 include 顶层 catch.hpp,
                         制品仓仅发布 catch2/2.13.10 (v2 合并头,
                         包内头为 include/catch2/catch.hpp, 无顶层 catch.hpp);
                         -I 指向 v2 包根时 <catch.hpp> 解析失败。Catch v1
                         常用宏 (TEST_CASE/SECTION/REQUIRE/CHECK/
                         CHECK_THROWS_WITH/Catch::Contains) 在 v2.13
                         合并头全部保留, 仅 include 路径不同
affected_scope:         上游测试主体为 Catch v1 单头 include 的库;
                         制品仓只有 catch2 v2.13 合并头布局时
verification_cmd:       见 md 文件: 编译 + 运行 (cwd 需为源码根以命中
                         ./test/data 相对路径), gzip-hpp 实测
                         "All tests passed (34 assertions in 7 test cases)" RC=0

# ═══ Layer 3: 方案层 ═══
rec_approach:           include-shim-forwarding: 建 shim/catch.hpp
                         转发 #include <catch2/catch.hpp>, 编译时
                         -I shim 置于 catch2 include 根之前; 上游源码/CMake
                         零改动; 测试数据相对路径需从源码根 cwd 运行
rec_examples:           gzip-hpp-0.1.0 (mapbox) — 见对应 md
rec_commands:           mkdir shim && printf '#pragma once\n#include <catch2/catch.hpp>\n' > shim/catch.hpp && clang++ -std=c++11 -I shim -I <catch2 include> -I <lib include> test/*.cpp -o unit-tests

# ═══ Layer 4: 边界/反例 ═══
applicability:          适用: 上游 #include <catch.hpp> 风格 + 制品仓仅
                         catch2 v2.13 合并头; 测试宏面须在 v2.13 存在
counterexamples:        上游已用 <catch2/catch.hpp> → test_requires+CMakeDeps
                         (kangaru 式); 上游 v3 多头 include → cdt 式合并头化
                         + CMake 修改; vendored Catch1 + libc++ URNG 断言
                         → mapbox-geometry 式幂等补丁 (shim 不解决 URNG)

# ═══ Layer 5: 查重/关系 ═══
seven_axes:
  exact_duplicate:       false
  causal_duplicate:      false
  trigger_overlap:       true
  solution_overlap:      partial
  combination_novelty:   true
  boundary_novelty:      true
  test_migration_novelty: true
similar_to:             DRAFT-cdt-1.4.5-catch2-21310-amalgamated-test-adaptation,
                         DRAFT-kangaru-4.3.2-catch2-submodule-test-requires
caused_by:              -
prerequisite_of:        -
conflicts_with:         -