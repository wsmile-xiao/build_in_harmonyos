#====================================================================
# E322-draft — CI git-clone 步骤失败: Worker 的 git 二进制缺 libz.so
# 对应的人类文档: E322-draft-2FFB.md (draft)
#
# 触发事件: PR !6547 aeolus 0.10.4, 构建 #32879/#32887/#32916
# 证据: 故障 Worker (CI-005/CI-009/CI-020) 报 libz.so 缺失; 健康 Worker
#       (CI-002/CI-012/CI-036) 同一 git 2.45.2 可正常 clone。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E322
trigger_tool:           git|buildbot|git-clone
phase:                  installation|configuration
error_signature:        Error loading shared library libz\.so.*needed by /data/service/hnp/bin/git|Error loading shared library libz\.so.*git.*exit code 127|git-clone.*exit code 127|libz\.so.*Permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
severity: 3
category:               environment, toolchain, ohos
match_keywords: git-clone, libz.so, /data/service/hnp/bin/git, exit code 127, buildbot, worker, RUNPATH, /code/deps_install, zlib, 环境故障, shared library, musl ldso
title: CI git-clone 步骤失败——Worker 上 /data/service/hnp/bin/git 缺 libz.so (RUNPATH 硬编码构建机路径 /code/deps_install/lib, musl ldso 不解析)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: buildbot worker 使用 /data/service/hnp/bin/git (git 2.45.2) 执行 git-clone,
           该二进制 NEEDED libz.so, 但其 RUNPATH 硬编码为 /code/deps_install/lib
           (构建 git 的机器路径, worker 上不存在)。musl ldso 不解析 $ORIGIN,
           只能靠系统默认加载路径。健康 worker 的 /usr/lib/libz.so.1 存在,
           故障 worker 缺失 → git 启动失败 exit 127, 构建在 git-clone 步骤即失败。
           该步骤发生在 checkout-pr / conan 配方可见之前, 配方代码无法干预。
affected_scope: 所有在该类 worker 上触发 CI 构建的 PR; 表现为 git-clone 步骤
                "Error loading shared library libz.so" exit 127
verification_cmd: /data/service/hnp/bin/git --version; ldd /data/service/hnp/bin/git 2>/dev/null; ls -la /usr/lib/libz.so.1; readelf -d /data/service/hnp/git.org/git_2.45.2/bin/git | grep -E 'NEEDED|RUNPATH'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority: 1
rec_approach: worker-env-fix-zlib
rec_description: CI 维护者修复 worker 环境: 安装 zlib (libz.so.1) 到系统默认库路径 /usr/lib, 使 git 可加载; 该 worker 上所有 PR 恢复正常
rec_command: 将 libz.so.1 安装到 /usr/lib (或从 cmd-pkgs 拉 zlib 包), 然后 /data/service/hnp/bin/git --version 验证
rec_auto_fix: false
rec_impl: environment

fallback_priority: 2
fallback_approach: patchelf-fix-git-runpath
fallback_description: 按 E186 先例用 patchelf 修改 git 的 RUNPATH 添加 /usr/lib: 复制 git 到可写目录, patchelf --set-rpath, 再用 binary-sign-tool 签名 (ELF 修改后必须重签)
fallback_command: cp /data/service/hnp/git.org/git_2.45.2/bin/git ~/tmp/git-local && patchelf --set-rpath '/usr/lib:/code/deps_install/lib' ~/tmp/git-local && binary-sign-tool sign ~/tmp/git-local
fallback_auto_fix: false
fallback_impl: post-install-script

# ★ 禁止策略 ★
forbid_1_pattern: 认为是 PR 配方问题反复 /rebuild
forbid_1_reason: git-clone 发生在配方可见之前, 配方无法干预; 反复 rebuild 只会命中故障 worker
forbid_1_consequence: 无限重试无效, 延误修复
forbid_2_pattern: 在配方/仓库内尝试修改 /data/service/hnp/bin/git 或 /usr/lib
forbid_2_reason: 配方在 git-clone 之后才可见, 无法触达; 修改系统库属 worker 环境操作
forbid_2_consequence: 无效且越权

