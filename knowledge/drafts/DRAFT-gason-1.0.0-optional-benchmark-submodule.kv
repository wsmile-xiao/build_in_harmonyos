id: DRAFT-gason-1.0.0-optional-benchmark-submodule
severity: 2
category: build-system|cmake|conan|source|benchmark
trigger_tool: cmake|conan|W3|build_and_test.sh
phase: source|build|package
approach: option-gate-optional-target-for-missing-submodule
keywords: benchmark, submodule, release tarball, rapidjson, file not found, option,
  BUILD_GASON_BENCHMARK, cmake, optional target, gason, target_include_directories
error_signature: "fatal error: 'rapidjson/document.h' file not found|src/benchmark.cpp:
  35:10: fatal error"
match_keywords: "rapidjson/document.h,benchmark.cpp,file not found,target_include_directories"
title: Gate optional benchmark/demo targets behind a CMake option when their submodule
  headers are absent from the release tarball
root_cause: "The release archive (git archive) omits submodule contents but the upstream
  CMakeLists adds a benchmark/demo target referencing the submodule include dir
  unconditionally, so a clean build fails on that optional target even though the
  deliverable library and its tests are unaffected."
affected_scope: "CMake C/C++ projects whose release tarballs omit a submodule that only
  an optional (non-deliverable) benchmark/demo target references; the deliverable
  library and tests build fine."
verification_cmd: "cmake --build . --target test-suite && ./test-suite; conan create <archive>
  -pr:h=<ohos-profile> --build=missing"
rec_priority: 1
rec_approach: "wrap the optional target in option() default OFF via a minimal source patch,
  set the same variable OFF in recipe generate(), add install() rules, then verify upstream
  tests and test_package."
rec_description: "Distinguish deliverable targets (must vendor/document the submodule, see
  E150 manual-download) from optional benchmark/demo targets (gate them OFF instead of
  downloading the submodule, which adds unmaintained source for a non-deliverable)."
rec_command: "option(BUILD_GASON_BENCHMARK \"...\" OFF)\nif(BUILD_GASON_BENCHMARK)\n
  add_executable(benchmark src/benchmark.cpp)\n
  target_include_directories(benchmark PRIVATE rapidjson/include)\nendif()"
rec_auto_fix: false
forbid_1_pattern: "git submodule update"
forbid_1_reason: "An unpinned SSH submodule fetch for an optional non-deliverable target
  breaks reproducibility and adds network/source maintenance for nothing."
forbid_2_pattern: "dummy submodule dir"
forbid_2_reason: "A fake header can hide real compile issues and produce an unverified package."
forbid_2_consequence: "The package may compile but skip the actual benchmark/API surface."
fallback_priority: 2
fallback_approach: "manual-download of the pinned submodule (E150) when the target is a
  real deliverable."
fallback_description: "Only for deliverable components; record the pinned source and hash."
fallback_command: "git clone --depth=1 <submodule-url> && checkout <pinned commit>"
fallback_auto_fix: false