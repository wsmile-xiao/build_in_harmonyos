#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E577.kv，填写各字段
# 对应的人类文档: doc/E577.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E577
trigger_tool: conan
phase: testing
error_signature: Skipped binaries|expected str, bytes or os.PathLike object, not NoneType

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, testing, dependencies, packaging
match_keywords: Skipped binaries, package_folder None, test_package, transitive dependency, self.dependencies, requires, conan create, TypeError
title: test_package 访问传递依赖产物时 package_folder 为 None（Conan 判 Skipped binaries）——须显式 requires 该依赖

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan 计算 test_package 依赖图时只实例化「被测引用及其被实际消费的依赖」：被测包为 application 且静态链接该依赖、test_package 自身又不链接它时，该传递依赖的 binary 被判为不需要并打印 Skipped binaries <pkg>/<ver>，其 Dependency.package_folder 保持 None，配方里 os.path.join(..., None, 'bin') 于是抛 TypeError
affected_scope: 所有 test_package 需要传递依赖提供的可执行工具或数据文件（非头文件/库）的配方，例如被测包静态链接 cdb 而测试要用 cdb 包的 cdbmake/cdbtest 生成并校验夹具；与「test_package 需要传递依赖头文件必须显式 requires」同族但触发面不同：本条是 package_folder 为 None，后者是 include 目录为空
verification_cmd: 复现：test_package/conanfile.py 只写 self.requires(self.tested_reference_str)，test() 用 self.dependencies[<dep>].package_folder 时 conan create 先打印 Skipped binaries <dep>/<ver> 再抛 TypeError: expected str, bytes or os.PathLike object, not NoneType（dbskkd-cdb 3.00 实测）；在 requirements() 增加与配方完全同版本的 self.requires(<dep>/<ver>) 后同一条命令通过

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: explicit-require-transitive-dep-in-test-package
rec_description: 在 test_package/conanfile.py 的 requirements() 内显式声明 self.requires(<dep>/<ver>)（版本与被测配方声明完全一致），使 Conan 实例化该 binary 并填充 package_folder；再用 os.path.join(self.dependencies[<dep>].package_folder, 'bin') 定位工具，不从 PATH 取
rec_command: def requirements(self): self.requires(self.tested_reference_str); self.requires("cdb/20251021")
rec_auto_fix: false
rec_impl: manual-edit

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: tool-requires-or-search-path
fallback_description: 若该依赖根本不在包的依赖图中（纯测试侧工具），改用 build_requirements() 的 self.tool_requires(<tool>/<ver>) 并在 test() 中用 env='conanbuild' 生成的 VirtualBuildEnv；不要手工拼 os.environ['PATH']（与 VirtualRunEnv 环境脚本冲突，仓库内 nng 草稿已记录）
fallback_command: def build_requirements(self): self.tool_requires("<tool>/<ver>")
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes: test_package 在 conan create 的测试阶段直接失败，CI 的 L1/L2/L4/L5 拿不到任何证据；若把 package_folder 为 None 误判为路径不存在，容易改成从 PATH 调用工具而掩盖依赖未被实例化
caused_by: Conan 2 对 test_package 依赖图的裁剪（Skipped binaries）与该依赖提供的产物类型（可执行工具/数据文件）不匹配
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

