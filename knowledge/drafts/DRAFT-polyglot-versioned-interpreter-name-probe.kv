#====================================================================
# DRAFT-polyglot-versioned-interpreter-name-probe
# — sh/Tcl polyglot 脚本 exec 重启探测仅尝试版本化旧解释器名（tclsh8.5）
#   在仅提供新版本名（tclsh8.6）的平台全部入口 exit 1
# 触发事件: combat 0.8.1 HarmonyOS PC 适配（archives/c/combat/0.8.1，
#           24 个入口脚本 = bin/{idl2tcl,iordump} + test/{1..11}/{dotest,server.tcl}）
# 主从明确：平台探测（解释器命名约定差异），非库内私有 quirk
#====================================================================

id:                     DRAFT-polyglot-versioned-interpreter-name-probe
trigger_tool:           shell|tclsh|polyglot
phase:                  runtime|test
error_signature:        This software requires Tcl 8\.5 to run|requires Tcl 8\.5|tclsh8\.5.*not found

severity:               2
category:               platform|interpreter|portability
match_keywords:         polyglot, 双语脚本, tclsh8.5, tclsh8.6, exec 重启探测,
                         版本化解释器名, 注释续行, dotest, type tclsh

title:                  sh/Tcl polyglot 脚本体内 exec 重启探测只尝试版本化旧解释器名（tclsh8.5/tclsh85）时，仅提供新版本名（tclsh8.6）的平台全部入口脚本 exit 1，补丁必须沿注释续行结构插入新探测分支

root_cause: >
  Tcl 生态经典 sh/Tcl 双语包装：首行 #!/bin/sh，其后以"行尾反斜杠的注释行 +
  无反斜杠的 if 探测行"构成 polyglot 探测段——sh 侧注释不吸收反斜杠续行，
  if 行是可执行语句；tclsh 侧行尾反斜杠把 if 行吸收进注释块（探测行同时是
  注释块终结符）。上游 combat 0.8.1 的 24 个入口脚本只探测 tclsh8.5/tclsh85，
  探测失败即 `echo "This software requires Tcl 8.5 to run."; exit 1`。
  平台消费环境由平台本身保证只提供 tclsh8.6（tcl 包 bin/ 无 8.5 名），全部
  入口（工具与测试 harness）未进任何业务逻辑即退出。触发命令如 `./dotest`。
  补丁插入点受结构约束：新探测分支必须插在既有探测行之后、并以
  "# 注释 \\" + if 行"的同构对插入，否则 sh 侧可执行但 tclsh 重启解析时
  会把探测行当作可执行 Tcl 语句导致语法错误。

affected_scope: >
  任何以 sh/Tcl（或同类 shell+脚本语言）polyglot 结构包装、exec 重启探测
  使用版本化解释器名的入口脚本/测试 harness；移植到仅提供单一新版本名
  解释器的平台时全部入口失效。

verification_cmd: >
  # 前置条件：PATH 必须先前置 tcl 包 bin（等价 conan runenv PATH）。
  # 裸 shell 无任何 tclsh（8.5/8.6/85/tclsh 均 not found），无法区分故障面。
  # （tcl 包 conan 缓存路径随设备 cache 状态变化，可用 conan install 物化后替换。）
  export PATH=/storage/Users/currentUser/.conan2/p/tcla4d5206af411b/p/bin:$PATH
  type tclsh8.5 || echo "tclsh8.5 MISSING（平台仅发 8.6）"
  # => tclsh8.5 not found
  type tclsh8.6 || echo "tclsh8.6 MISSING"
  # => （命中，无输出）
  # 从 pinned 归档解包 pristine 副本再执行（零污染：不依赖任何已打补丁的
  # 工作副本；SHA256 与 combat conandata.yml 一致）：
  BASE="${TMPDIR:-/storage/Users/currentUser/tmp}/oh-device-porting-v2/combat-0.8.1"
  T="$BASE/polyglot-probe.$$.$(date +%s)" && mkdir -p "$T"
  curl -sL --max-time 300 -o "$T/combat.tar.gz" https://deb.debian.org/debian/pool/main/c/combat/combat_0.8.1.orig.tar.gz
  echo "1923fa19f55a03f720f0444d6edffe7dad246c2c4be82453b8d2c5b4922d99a8  $T/combat.tar.gz" | sha256sum -c -
  # => .../combat.tar.gz: OK
  tar xzf "$T/combat.tar.gz" -C "$T"
  cd "$T/combat-0.8.1/test/1" && ./dotest ; echo "rc=$?"
  # => This software requires Tcl 8.5 to run.
  #    Make sure that "tclsh8.5" or "tclsh85" is in your $PATH
  #    rc=1
  cd / && rm -rf "$T"   # 临时目录自清理（设备实测无残留）

rec_priority:           2
rec_approach:           insert-versioned-probe-branch-preserving-polyglot-structure
rec_description: >
  主案：按上游 polyglot 结构插入同构探测对——"# the next line restarts
  using tclsh8.6 on unix \\" 注释行 + `if type tclsh8.6 > /dev/null 2>&1 ;
  then exec tclsh8.6 "$0" ${1+"$@"} ; fi` 探测行，位置放在既有 8.5 探测行
  之后、cygwin 分支之前；保留上游 8.5/85/cygwin 分支与提示文本不动
  （combat patch 0001 实测：每文件恰 +2 行，sh -n 的"语法错误"为上游
  polyglot 尾部 Tcl 代码固有、非补丁引入）。
rec_command: >
  # 在每个入口脚本的 tclsh8.5 探测行之后插入两行（保持注释续行同构）：
  # # the next line restarts using tclsh8.6 on unix \
  # if type tclsh8.6 > /dev/null 2>&1 ; then exec tclsh8.6 "$0" ${1+"$@"} ; fi
rec_auto_fix:           false
rec_impl:               polyglot-comment-continuation-probe-insert

fallback_priority:      2
fallback_approach:      shebang-env-tclsh
fallback_description: >
  shebang 改 #!/usr/bin/env tclsh。诚实权衡：丢失 Windows/cygwin 分支与
  版本保证（env tclsh 可能解析到不兼容版本），仅作上游 polyglot 结构无法
  保持时的退路。
fallback_command:       逐文件修改首行：#! /bin/sh → #!/usr/bin/env tclsh
fallback_auto_fix:      false
fallback_impl:          shebang-env-tclsh-rewrite

forbid_1_pattern:       tclsh8\.5 → tclsh8\.6 全文字面改写|sed s/tclsh8\.5/tclsh8\.6/g
forbid_1_reason: >
  禁止把上游 tclsh8.5 字样直接全文改写为 8.6——丢失 8.5/85 环境回退语义
  与上游提示文本，且探测行在 tclsh 侧是注释块终结行，改写属语义级修改
  而非能力探测扩展，环境回退不可逆、补丁不可向上游提交。
forbid_1_consequence:   在仍提供 8.5 的其他平台破坏上游行为；补丁膨胀且失去可逆性/可解释性

principles:             P-ENV-001
similar_to:             E037,E049（增量：E037/E049 问题面限 shebang 首行——env 缺失/硬编码绝对路径；本条问题面在脚本体内 exec 重启探测行的版本化名称维度，以及注释续行结构对补丁插入点的约束，shebang 家族条目均未覆盖）
conflicts_with:
prerequisite_of:

doc_file:               knowledge/drafts/DRAFT-polyglot-versioned-interpreter-name-probe.md
last_updated:           2026-09-11
source_event:           archives/c/combat/0.8.1

