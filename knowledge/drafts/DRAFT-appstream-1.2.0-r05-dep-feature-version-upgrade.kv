#====================================================================
# DRAFT-appstream-1.2.0-r05-dep-feature-version-upgrade.kv
# 依赖能力缺口时先查制品仓同源增强小版本：vips/8.18.4（全特性禁用）→
# 8.18.4.1（启用 PNG/JPEG，libjpeg-turbo/3.2.0 + libpng/1.6.58 +
# zlib/1.3.1.1），以正确依赖版本恢复配置并复验
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R05）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           conan recipe dependency (vips)
phase:                  dependency-resolution
error_signature:        built without PNG support|libvips.*disabled.*feature|
                        VipsForeignLoad.*not found|dependency feature missing
severity:               2
category:               conan, dependency, version-upgrade, feature-matrix, portability
match_keywords:         vips, 8.18.4, 8.18.4.1, _disabled_optional_features,
                        dependency, feature, registry, version bump, R37, OHOS
title:                  依赖能力缺口 → 查制品仓同源增强小版本并升级配方（R37 补充）
root_cause:             当前配方声明的依赖小版本在制品仓为能力受限构建（vips/8.18.4
                        全 codec 禁用）；制品仓已发布同源增强版本（8.18.4.1 启用
                        PNG/JPEG），旧版本声明无法满足下游硬性能力要求。
affected_scope:         Conan 配方消费依赖能力（codec/loader/feature）的库。
verification_cmd:       conan list "vips/*" -r=ohpcd → 8.18.4 / 8.18.4.1；
                        conan download "vips/8.18.4.1" -r=ohpcd（R35 二进制确认）；
                        conan create appstream 1.2.0 -pr:h=ohos-aarch64 --build=missing。
rec_priority:           1
rec_approach:           registry-feature-version-check
rec_description:        依赖能力缺口时，先 conan list/download 查制品仓同源增强版本
                        （含选项/特性描述），存在则升级配方 require 并复验；确无
                        才按外部依赖阻塞记录。与 R37（版本号后缀惯例）互补：
                        R37 管"同上游版本适配修复后缀"，本候选管"制品仓已有
                        能力增强版本的回查与采用"。
rec_command:            |
  conan list "vips/*" -r=ohpcd
  conan download "vips/8.18.4.1" -r=ohpcd -pr:h=ohos-aarch64 -pr:b=ohos-aarch64
  # conanfile.py: self.requires("vips/8.18.4.1")
rec_auto_fix:           false
rec_impl:               recipe-change
forbid_1_pattern:       vips/8.18.4.*without.*registry-check
forbid_1_reason:        不得在制品仓已有增强版本时沿用旧能力受限版本并报外部阻塞
principles:             R35, R37, R39
causes:                 []
caused_by:              []
similar_to:             R37
conflicts_with:         []
prerequisite_of:        DRAFT-appstream-1.2.0-r05-mediaworker-capability-adaptive
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-r05-dep-feature-version-upgrade.md
last_updated:           2026-09-25
source_event:           appstream-1.2.0 R05（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.85