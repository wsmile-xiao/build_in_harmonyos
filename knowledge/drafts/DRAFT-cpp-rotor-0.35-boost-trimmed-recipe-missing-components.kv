#====================================================================
# DRAFT-cpp-rotor-0.35-boost-trimmed-recipe-missing-components.kv
# 草稿条目 — cpp-rotor 0.35 经验
# 问题: 制品仓 Boost 裁剪版配方缺失 date_time 组件目标与 lockfree 头文件
# 方案: conanfile requirements() 选用制品仓完整配方版本 (boost/1.84.0)
# 对应文档: knowledge/drafts/DRAFT-cpp-rotor-0.35-boost-trimmed-recipe-missing-components.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-cpp-rotor-0.35-boost-trimmed-recipe-missing-components
trigger_tool:           cmake|conan|conan create|make
phase:                  configuration|compilation
error_signature:        Target .* links to: Boost::[A-Za-z_]+ but the target was not found|boost/lockfree/.*file not found|Component 'boost::[a-z_]+' not found in 'boost' package requirement

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               cmake, conan, boost, dependency, ohos
match_keywords:         boost, Boost::date_time, Boost::system, Boost::regex, lockfree, CMakeDeps, target not found, 制品仓, 裁剪版配方, component not found, transitive_headers

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
title:                  制品仓 Boost 裁剪版配方缺失组件目标/头文件时选用完整配方版本 (cpp-rotor 0.35)
root_cause:             制品仓存在裁剪版 Boost 配方（如 1.90.0.4/1.91.0/1.91.0.1），_components 仅含编译组件子集（缺 date_time），且头文件按组件裁剪导出（缺 include/boost/lockfree、posix_time）；CMakeDeps 不生成对应 Boost::xxx 目标，下游配置期 target not found 或编译期头文件缺失。完整配方（如 1.84.0）导出全部组件与完整头文件。
affected_scope:         依赖 Boost 多组件/header-only 头文件的 C++ 库在 OHOS aarch64 + Conan 2 适配
verification_cmd:       conan list "boost/<版本>/*" -r=ohpcd; conan install --requires=boost/1.84.0 -pr:a=ci/conan/profiles/ohos-aarch64 -g CMakeDeps; grep -c "COMPONENT Boost::date_time" Boost-Target-release.cmake

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           select-full-boost-recipe
rec_description:        conanfile.py requirements() 选用制品仓完整配方 Boost 版本（本项目 boost/1.84.0）并声明 transitive_headers=True；generate() 输出 CMakeDeps + CMakeToolchain（BUILD_SHARED_LIBS 按 shared 选项）；package_info() 的 cpp_info.requires 使用 conan 组件名（boost::boost_date_time 等，非 CMake 目标名 Boost::date_time）
rec_command:            self.requires("boost/1.84.0", transitive_headers=True)  # + generate() CMakeDeps/CMakeToolchain

# ═══ Layer 4: 证据层 (Evidence) ═══
verified_in:            cpp-rotor 0.35 本地门禁 (Bootstrap/Adapt/upstream_tests 25-25/conan-verify G0-G4 PASS/finish W2-W3 exit 0)
verified_date:          2026-09-03
status:                 draft