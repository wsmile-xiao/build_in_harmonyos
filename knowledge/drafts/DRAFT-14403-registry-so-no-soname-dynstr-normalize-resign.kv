id:                     DRAFT-14403
trigger_tool:           conan|ld
phase:                  linking|testing
error_signature:        \(NEEDED\)\s+/.*\.conan2/p/.*\.so|DT_NEEDED 含绝对路径|soname_gate_failed|L5b
severity:               2
category:               conan, linking, ohos
match_keywords:         SONAME, DT_NEEDED, NEEDED, 绝对路径, 无 SONAME, libexpat, L5b, soname_gate_failed, dynstr, 归一化, 重签
title:                  制品仓 .so 无 DT_SONAME → 下游 DT_NEEDED 烙上 conan 缓存绝对路径；package() 同长度 .dynstr 原位归一化 + 重签修复

root_cause:             部分制品仓二进制包（实例 expat）.so 无 DT_SONAME → 链接器把链接期缓存绝对路径记为 DT_NEEDED → CI L5b 门禁 fail + 跨机/跨用户消费者按路径解析必败（绝对路径不可移植）；--as-needed 不可行（下游直接引用符号无法剔除，实例：kf5wayland 两 .so 各 ~16 个未定义 XML_* 符号）
affected_scope:         所有直接链接无 SONAME 仓内包（实例 expat）的下游配方
verification_cmd:       readelf -d <dep>.so | grep -E 'SONAME|NEEDED'  # 依赖无 SONAME 行 + 下游 NEEDED 为绝对路径 = 命中

rec_priority:           1
rec_approach:           dynstr-inplace-basename-resign
rec_description:        package() 签名前对打包 .so 字节级原位补丁：NUL 结尾、/ 开头、basename 匹配 lib*.so(\.N)* 的字符串 → basename + NUL 补零（同长度，DT_NEEDED 偏移不变，dynamic section 结构不动，仅 .dynstr 内容变化）；随后按生态惯例重签（objcopy 去旧 .codesign + binary-sign-tool）；验证 = readelf 全按名 + test_package 真实 dlopen 加载（证明补丁后重签 .so 可被平台加载）
rec_command:            字节补丁参考 kf5wayland/5.116.0 conanfile _normalize_dyn_needed_paths；验证：readelf -d pkg/lib/*.so | grep NEEDED  # 应全为库名
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      baked-path-symlink
fallback_description:   目标 .so 不可重签/不可改时 → DRAFT-E5xx 烙印路径 symlink 方案（在烙印绝对路径处 ln -s 指向真实库，文件内容不变签名有效）；长期正解 = 依赖配方补 SONAME 重发布
fallback_command:       readelf -d <dep>.so | grep NEEDED  # 找烙印路径; mkdir -p <烙印父目录> && ln -s <真实库> <烙印绝对路径>
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       patchelf
forbid_1_reason:        patchelf 改写 dynamic section 结构且补丁后未重签 → OHOS 签名校验拒载（Permission denied，DRAFT-E5xx 实测）
forbid_1_consequence:   加载直接失败，比绝对路径更难排查

causes:                 []
caused_by:              []
similar_to:             [DRAFT-E5xx-registry-so-baked-absolute-needed-symlink]
conflicts_with:         []
prerequisite_of:        []

verify_builds:          kf5wayland/5.116.0 PR #13869（L5b 清零；readelf NEEDED=libexpat.so 按名；test_package dlopen 5 断言全过 = 重签后加载实证）
source_pr:              https://atomgit.com/OpenHarmonyPCDeveloper/build_in_harmonyos/merge_requests/13869
