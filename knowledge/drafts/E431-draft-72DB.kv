#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E431.kv，填写各字段
# 对应的人类文档: doc/E431.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E431
trigger_tool: conan
phase: test
error_signature: /usr/bin/ld: skipping incompatible .../p/lib/liblzma.a when searching for -llzma ; /usr/bin/ld: cannot find -llzma ; clang-15: error: linker command failed with exit code 1  (test_package test() 失败)

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, cross-compile, build-system, portability
match_keywords: test_package, self.run, clang, skipping incompatible, cannot find -llzma, cross_building, tools.build:compiler_executables, conanbuild, test(), consumer test
title: test_package 里写死 clang：交叉编译时用的是宿主编译器/链接器，链接 aarch64 静态库必然失败；应按 cross_building 取 profile 里的交叉编译器

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: test_package 的 test() 里直接执行 clang（如 self.run("clang -o test_xz test_xz.c -I... -L... -llzma", env=conanbuild)）。在交叉编译（host=OHOS aarch64、build=x86_64 Linux）下，conanbuild 环境里的 clang 是宿主 x86-64 编译器/链接器，而 -L 指向的是 aarch64 的 liblzma.a，于是 ld 报 skipping incompatible 并最终 cannot find -llzma。该写法只在 设备端原生构建（host==build）时才成立。
affected_scope: 所有 test_package/conanfile.py 的 test() 中写死 clang/gcc 的配方；在交叉编译（本机 WSL 对 OHOS）下 conan create 必然在 test 阶段失败，导致本地无法完成端到端验证
verification_cmd: grep -n 'self.run(f"clang' archives/*/*/*/test_package/conanfile.py   # 命中即为写死宿主编译器

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: recipe-conditional
rec_description: test() 里按 cross_building(self) 分支：交叉编译时从 self.conf 读取 tools.build:compiler_executables 的 c 项（profile 里配置的 OHOS 交叉编译器包装脚本）并追加 -static（静态链接后产物可在本机 QEMU/binfmt 下真实执行）；设备端原生构建保持原样调用系统 clang，命令与既有配方一致。
rec_command: cc = self.conf.get("tools.build:compiler_executables", default={}, check_type=dict).get("c") or "clang"
rec_auto_fix: false
rec_impl: recipe-edit

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: skip-local-test
fallback_description: 本机验证时用 conan create -tf="" 跳过 test_package，只验证 build()+package()，再另写脚本用交叉编译器静态链接消费者代码并在 QEMU 下执行（等价证据）。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
principle: test_package 是消费者视角验证，必须能在“当前这台机器”上真正跑起来；写死编译器等于把测试绑死在原生构建环境上。
doc_file:               doc/E431.md
last_updated: 2026-09-21
source_event:           # 触发此条目创建的编译事件(如有)

