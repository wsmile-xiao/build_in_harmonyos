#====================================================================
# E6342 (draft) — OHOS SDK 26 fpos_t 为无 __pos 成员的 union，源码读取其内部字段编译失败
# 来源: open-jtalk 1.11 HarmonyOS PC 适配（私有内建 hts_engine_API 1.10）, 2026-09-13
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E6342
trigger_tool:           clang|clang++|gcc|make
phase:                  compilation
error_signature:        no member named '__pos'|union _G_fpos64_t|__opaque[16]|_G_fpos64_t

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               musl,fpos-t,sdk-header,portability
match_keywords:         fpos_t, __pos, _G_fpos64_t, __opaque, __lldata, fgetpos, fsetpos, ftell, ftello, musl, HarmonyOS, OHOS SDK 26, hts_engine_API
title: OHOS SDK 26 的 fpos_t 是无 __pos 成员的 union，源码取 fpos_t 内部字段编译失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: OHOS SDK 26.0.0.18 sysroot 的 stdio.h 定义
            typedef union _G_fpos64_t { char __opaque[16]; long long __lldata; double __align; } fpos_t;
            它是 16 字节 union，既不是 glibc 的 struct，也没有 __pos 成员；上游为 glibc/Apple/Windows
            写的 `#else return (size_t) pos.__pos;` 兼容分支在 OHOS 上成为编译期硬错误，无法用 -Wno-* 降级。
affected_scope: 在 OHOS 上编译、且代码读取 fpos_t 内部字段（pos.__pos 之类）的老 C/C++ 代码；
            open_jtalk 1.11 的私有依赖 hts_engine_API 1.10 lib/HTS_misc.c 的 HTS_ftell() 实测命中
            （clang 15.0.4，configure 已通过，编译 mak 阶段失败）。
verification_cmd: /data/service/hnp/bin/clang -I. -Iinclude -c lib/HTS_misc.c -o /dev/null
            # → error: no member named '__pos' in 'union _G_fpos64_t'
            grep -A5 'typedef union _G_fpos64_t' /data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/bin/../../sysroot/usr/include/stdio.h

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach: source-patch
rec_description: 把“读取 fpos_t 内部整数成员”的写法替换为标准接口调用：
            fgetpos()+pos.__pos → ftell()（与同文件用 fseek 的 seek 语义自洽）；
            若上游 seek 用 fseeko()，对应改 ftello() 并把返回类型改 off_t。
            需要“不透明保存/恢复位置”时用 fgetpos/fsetpos 整对象传递，不读内部字段。
            不要尝试 -Wno-* 压制：成员不存在是硬错误，不是可降级告警。
rec_command: 见 patches 形式：HTS_ftell() 内 fpos_t pos; fgetpos(...); return (size_t) pos.__pos;
            → return (size_t) ftell((FILE *) fp->pointer);
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach: include-shim
fallback_description: 仅当无法改上游源码（例如生成物/第三方 amalgamation）时，才在本地兼容头里
            以 off_t 包装位置记录（typedef off_t <PKG>_filepos，用 ftello/fseeko 实现），
            禁止伪造出 __pos 成员（E235 同类禁令：私造 libc 结构成员会让 ABI 假设失真）。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          source-patch

# ★ 禁止策略 ★
forbid_1_pattern: define.*__pos|#define __pos|struct.*fpos_t.*__pos
forbid_1_reason: 私造/重定义 OHOS libc 的 fpos_t 内部布局，把编译错误转成未定义行为，
            且与 SDK 头文件冲突（同 E235 对 libc 内部语义的禁令）
forbid_1_consequence: 编译可能通过，但位置语义与 libc 实现不一致，读写错位且不可追溯

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P012

