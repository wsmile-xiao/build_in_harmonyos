#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E612.kv，填写各字段
# 对应的人类文档: doc/E612.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E612
trigger_tool: conan|ld|runtime
phase: runtime
error_signature: Error loading shared library libgnutls\.so\.[0-9]+: \(needed by .*\)|Error relocating .*: gnutls_[a-z_]+: symbol not found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, packaging, linking, runtime
match_keywords: require.run, LD_LIBRARY_PATH, VirtualRunEnv, conanrun, shared option 与内容不一致, Error loading shared library, gnutls, package_info, runenv_info
title: 依赖制品 option 声明 shared=False 却只发布 .so，require.run 为 False 导致下游没有 LD_LIBRARY_PATH

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: gnutls/3.8.10 配方的 default_options 是 shared=False，package() 却无条件 cp .libs/libgnutls.so.* 进包（无 .a）；Conan 的 VirtualRunEnv 只在 require.run（共享库或可执行）为真时才把该依赖的 libdir 写进 LD_LIBRARY_PATH，因此下游消费者拿到 .so 需求却没有搜索路径，加载 libprelude.so 时先报找不到 libgnutls.so.30、再级联一串 gnutls_* symbol not found
affected_scope: 所有链接 gnutls/3.8.10（及同类 option/内容不一致制品）的共享库包
verification_cmd: conan install --requires=gnutls/3.8.10 -g VirtualRunEnv 后检查 conanrunenv 的 LD_LIBRARY_PATH 是否含 gnutls 包 libdir（现状：不含）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: consumer-runenv-compensation
rec_description: 消费方在 package_info() 里遍历 host 依赖，凡其 libdir 内确有 .so 就 self.runenv_info.append_path('LD_LIBRARY_PATH', libdir)；根治方案是由依赖方重新按 shared=True 发布或补 .a，之后可删除该补偿逻辑
rec_command: for dep in self.dependencies.host.values(): self.runenv_info.append_path('LD_LIBRARY_PATH', os.path.join(dep.package_folder,'lib'))
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

