#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: refresh-patch|conan|finish
phase: patch-generation|verification
error_signature: patch 文件路径或格式错误| conandata.yml 中 patch_file 路径与 patches/ 目录下文件不一致| L1_RESULT=fail: conan create failed| G2: FAIL

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: ohos, conan, patch, workflow
match_keywords: refresh-patch, refresh_patch, --auto, 补丁重命名, 改名, patch_file, conandata.yml, apply_conandata_patches, patches/ 文件名不一致, conan-verify, G2, W3, patch 文件路径或格式错误
title: refresh-patch --auto 自动重命名补丁文件后 conandata.yml 的 patch_file 路径失效，conan-verify G2 与本地 CI W3 连锁失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: scripts/ohc/refresh_patch.py 的 --auto 模式固定按源文件相对路径命名补丁（NNNN-<路径，/ 换成 ->.patch，也是仓库内主流命名约定），且不回写 conandata.yml。作者若先把补丁命名成描述式（如 0001-ohos-cmake-portability.patch）并在 conandata.yml 中引用，finish 内部再次调用 refresh-patch --auto 会按工具约定重命名补丁文件，而 conandata.yml 仍指向旧名 → conan apply_conandata_patches() 找不到补丁 → conan create 失败 → G2 与 W3 连锁失败，finish 只给「patch 文件路径或格式错误」提示。
affected_scope: 所有用 refresh-patch --auto 生成补丁的 Conan 配方（OHOS PC 适配），尤其手工命名过 patches/ 内文件的包
verification_cmd: ls archives/<字母>/<包>/<版本>/patches/ && grep -n patch_file archives/<字母>/<包>/<版本>/conandata.yml && cd <纯净源码> && for f in archives/<字母>/<包>/<版本>/patches/*.patch; do patch --dry-run -p1 < $f; done

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: align-patch-filenames-with-tool-convention
rec_description: 以 patches/ 目录内实际文件名为唯一事实来源，把 conandata.yml 每个 patch_file 改成工具自动命名（NNNN-<文件名>.patch），不要手工重命名补丁文件；改完在纯净源码上 patch --dry-run -p1 验证可应用，再跑 conan-verify 确认 G2 通过。
rec_command:            python3 -c 'import pathlib;d=pathlib.Path("archives/<字母>/<包>/<版本>");t=(d/"conandata.yml").read_text();print("\n".join(f"{p.name} {\"ok\" if p.name in t else \"*** MISSING in conandata.yml ***\"}" for p in sorted((d/"patches").glob("*.patch"))))'
rec_auto_fix: false
rec_impl: conan-recipe-patch-name-align

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 直接 mv/sed 改 patches/ 内文件名而不更新 conandata.yml| 手写补丁文件绕过 refresh-patch
forbid_1_reason: patches/ 内的文件名是 patch_file 的唯一事实来源；改名不同步 conandata.yml 会让 apply_conandata_patches() 找不到补丁，且手写补丁无法保证与工作目录源码逐字一致（R8）
forbid_1_consequence: conan create 直接失败，G2 与 W3 连锁失败，finish 每轮都中断并浪费一次完整验证周期
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             E484, E254, E282
conflicts_with:         []
prerequisite_of:        []

