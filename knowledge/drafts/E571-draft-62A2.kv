#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E571.kv，填写各字段
# 对应的人类文档: doc/E571.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E571
trigger_tool: conan|test_package|make|ctest
phase: testing
error_signature: tolerance.*1e-3.*(julian|angle|sidereal|position)|FAIL.*diff=|assert.*fabs.*<.*1e-6|ok.*calc=.*diff=

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: libc, portability, testing
match_keywords: libnova, tolerance, epsilon, algorithm precision, julian day, sidereal time, nutation, VSOP87, ELP, Meeus, false positive, upstream fixtures
title: Scientific library cross-libc/arch validation: derive numeric tolerances from algorithm precision instead of one loose epsilon

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Single uniform epsilon cannot span algorithm precision classes: exact unit conversion rounds at ~1e-12 deg, julian day arithmetic at ~1e-9 day, IAU-1980 nutation truncates at ~1e-5 deg, VSOP87 at ~3e-4 deg, lunar ELP at ~1e-2 deg; a one-size-fits-all 1e-3/1e-6 epsilon either masks real algorithm errors (false pass) or flags precision-limited fixtures as failures. Upstream fixtures may also be frozen stale: libnova v0.16 ships 24/340 lntest expectations that disagree with the shipped algorithm identically on a second OHOS SDK clang/musl native build and the cross/OHOS package build (platform-independent); only expectations with authoritative proof (upstream master commit 7b60adc of 2016-09-12 for 3 nutation items, Meeus printed values, or epoch-correct independent reduction) may be corrected, all others must stay reported as failures
affected_scope: test_package numeric assertions and upstream test triage for scientific computing libraries (astronomy, geodesy) validated across libc (musl vs glibc) and architectures (arm64 vs amd64)
verification_cmd: grep -nE "EPS|TOL" test_package/*.c && conan create -pr:b=default -pr:h=ci/conan/profiles/ohos-aarch64 . --build missing

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: derive-tolerance-from-algorithm-precision
rec_description: Derive each asserted tolerance from the algorithm class of the tested API: exact unit conversion 1e-8..1e-12 deg, julian day 1e-9 day, sidereal/nutation at print rounding (1e-7 h) or series truncation (1e-5 deg), planetary VSOP87 3e-4 deg, lunar ELP 1e-2 deg, rise/set/transit 1e-3 day with minute-granularity integer comparison; document the derivation in source comments and grade expected-value provenance (authoritative literature like Meeus, upstream fixture passed on this platform, or library output cross-checked by independent reduction)
rec_command: grep -nE "EPS|TOL" archives/l/libnova/0.16/test_package/
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: upstream-commit-oracle-backport
fallback_description: When literature values are unavailable, use upstream master commit history as oracle: only expectations actually corrected by an upstream commit (e.g. libnova 7b60adc nutation fix) may be backported into a declared patch with the commit disclosed; host/target bit-identical output alone never proves an expectation stale, and failures without authoritative proof must remain counted as failures
fallback_command:
fallback_auto_fix:      false
fallback_impl: manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: (eps|epsilon|tolerance).*1e-[36].*(julian|angle|position|sidereal)|assert.*fabs.*<.*1e-3.*(julian|angle|position)
forbid_1_reason: A single loose epsilon absorbs algorithm-level errors of 0.1 deg magnitude into passes, producing false positives that hide real regressions
forbid_1_consequence: Consumer smoke test stays green while the underlying API computes wrong values; regression coverage silently lost
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: [E401]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
forbid_2_pattern: skip.*(lntest|upstream test)|ignore.*FAILED|failed\s*>\s*[0-9]+|allow.*known.*fail
forbid_2_reason: Gate logic that tolerates a known-failure threshold (failed > N) or silently skips upstream tests abandons the regression axis; stale expectations must be fixed by attributed backport or the failures reported honestly
forbid_2_consequence: New failures hide inside the tolerated budget and platform regressions get attributed to known stale expectations
doc_file:               doc/E571.md
last_updated: 2026-09-06
source_event: libnova/0.16 OHOS PC aarch64 adaptation: 24 of 340 lntest expectations in the v0.16 tag disagree with the shipped algorithm identically on a second OHOS SDK clang/musl native build and the cross/OHOS package build; consumer test_package 39 algorithm-graded checks pass on static/shared products

# ═══ 知识协作 (Authorship & Provenance) ═══
