#====================================================================
# DRAFT-build-dir-path-with-space-make-target-split.kv
# 构建路径含空格: Makefile 不引号展开 $(abs_builddir), make 把路径拆词当成目标
#====================================================================

id:                     DRAFT-build-dir-path-with-space-make-target-split
trigger_tool:           make|configure|shell
phase:                  compilation
error_signature:        overriding recipe for target .*build_in_harmonyos|
                         ignoring old recipe for target .*build_in_harmonyos|
                         Resource temporarily unavailable|
                         make.*\*\*\* .*build_in_harmonyos.*Error

severity:               2
category:               make, build-system, filesystem, configure, portability
match_keywords:         路径含空格, space in path, abs_builddir, overriding recipe,
                         build directory, 构建目录, make target split, 拆词,
                         unquoted variable

title:                  构建目录路径含空格时 autotools Makefile 的未加引号 $(abs_builddir) 被 make 拆词，把路径前缀当目标反复构建

root_cause:             autotools 生成的 Makefile 里 `abs_builddir` 是**未加引号**的
                         绝对路径变量（如 `abs_builddir = /a/b 工作目录/c`），
                         而 INN 这类工程把它直接用在目标/依赖位置：
                           `$(LIBINN): ; (cd ../lib ; $(MAKE))`
                           `LIBINN = $(abs_builddir)/lib/libinn.a`
                         make 的目标列表按空白分词，含空格路径被切成两段，
                         后半段成为**伪目标**，于是日志出现
                           `Makefile:96: warning: overriding recipe for target '/storage/.../build_in_harmonyos-main'`
                         —— 路径前缀被当成 target 反复"构建"，子 make 递归爆炸，
                         最终以 `/bin/sh: Resource temporarily unavailable`
                         （进程/资源耗尽）和 `Error 127 / Error 2` 收场。
                         报错信息完全不提"空格"，极具误导性。
affected_scope:         所有在**含空格的绝对路径**下构建的 autotools/make 工程
                         （本仓库检出目录名若含空格同样命中，与具体库无关）

verification_cmd:       # 观察伪目标告警即可确认
                         make -n 2>&1 | grep -c 'overriding recipe for target'
                         # 对照: 把源码放到无空格路径后同一命令输出为 0
                         pwd | grep -q ' ' && echo 'BUILD PATH CONTAINS SPACE'

rec_priority:           1
rec_approach:           build-in-space-free-directory
rec_description:        把源码/构建目录放到**不含空格**的路径下再构建。
                         本仓库的 init-build 已默认解压到
                         `~/builds/<name>-<ver>.work`（无空格），因此正常走
                         `ohc-run.py build` 不会命中；只有手工在含空格目录
                         （如桌面上的中文命名工作目录）里直接 configure/make 才会踩到。
rec_command:            mkdir -p ~/builds && tar xf pkg.tar.gz -C ~/builds && cd ~/builds/pkg-1.0 && ./configure && make
rec_auto_fix:           true
rec_impl:               path-relocation

fallback_priority:      2
fallback_approach:      quote-variable-in-makefile
fallback_description:   不迁移目录时，可打补丁给 Makefile/Makefile.global 里
                         `abs_builddir` 的每个使用点加引号（`"$(abs_builddir)/lib"`）。
                         ⚠️ 使用点可能很多且随 configure 重新生成，成本高、
                         易漏，故仅作退路。
fallback_auto_fix:      false

forbid_1_pattern:       把 Error 127 / Resource temporarily unavailable 当成
                         目标库自身的源码或依赖问题去排查
forbid_1_reason:        根因是路径分词，与库代码无关；照此方向改动会白费大量时间
forbid_1_consequence:   误改下游依赖或源码，引入无关改动（本仓库曾因此把
                         父目录当作 target 反复构建、日志数万行）

forbid_2_pattern:       用 `make -k` / `make -i` 忽略错误"压过"构建
forbid_2_reason:        忽略错误后产物不完整，属掩盖而非解决
forbid_2_consequence:   消费者链接失败或运行期缺符号

principles:             报错与根因可能不在同一层(环境/路径 vs 源码);
                         先确认构建路径等环境前提再改代码

causes:
caused_by:
similar_to:             E392(make/no-makefile 类构建通道问题，同样表现为
                         make 报错但根因在路径/目录布局);
                         DRAFT-cd-hit-4.8.1-make-conan-recipe(同"make 报错
                         但根因是工作目录/构建目录选择")
conflicts_with:
prerequisite_of:

doc_file:               doc/DRAFT-build-dir-path-with-space-make-target-split.md
last_updated:           2026-09-25
source_event:           inn2/2.7.4 在含空格工作目录内手工 make 失败;
                         迁到 ~/builds/inn-2.7.4.work 后 make -j2 exit 0
first_seen_project:     inn2/2.7.4
contributor_id:         ATOMCODE

authors:
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-09-25
