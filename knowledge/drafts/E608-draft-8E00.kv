#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E608.kv，填写各字段
# 对应的人类文档: doc/E608.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E608
trigger_tool: meson
phase: compilation
error_signature: cannot locate ITS rules for .*\.policy\.in|msgfmt.*ITS rules

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: meson,ohos,gettext,portability
match_keywords: ITS rules, msgfmt, gettext, polkit, policy, i18n.merge_file, GETTEXTDATADIR, polkit.loc
title: meson i18n.merge_file 合并 polkit policy 需注入 GETTEXTDATADIR 指向 polkit 包 its 目录

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 对 .policy（polkit 策略）等 XML 文件做 i18n.merge_file 翻译合并时，msgfmt 需要 gettext ITS 定位规则（polkit.its/polkit.loc）。OHOS 工具链的 msgfmt 数据目录（usr/local/share/gettext/its）不含 polkit 规则，而 conan polkit 包将 ITS 规则装在包内 share/gettext/its/，默认搜索路径找不到
affected_scope: 所有用 meson i18n.merge_file 合并 polkit/XML policy 文件并依赖 conan polkit 包的软件适配
verification_cmd: GETTEXTDATADIR=/storage/.../polkit.../share/gettext ninja <policy 目标>（修复前 msgfmt: cannot locate ITS rules；注入后 Merging translations 通过）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: conanfile 构建环境注入 GETTEXTDATADIR 指向 polkit 依赖包 package_folder/share/gettext（其下有 its/ 子目录）；或用 configure_file(copy:) 跳过翻译合并（accountsservice 0005 先例）
rec_description: 两条路径：注入 ITS 规则保留翻译（本方案），或退化无翻译安装（accountsservice 先例）；libmalcontent 0.10.2 注入方案实测通过
rec_command:            conanfile _build_environment(): environment.define_path('GETTEXTDATADIR', polkit_pkg/share/gettext)
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

