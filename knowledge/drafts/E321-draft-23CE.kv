# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E321
trigger_tool: meson
phase: configure
error_signature: Could not get pkg-config variable and no default provided|gmodule-no-export-2.0

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: meson|pkgconfig|glib
match_keywords:         gmodule-no-export-2.0, PkgConfigDeps, gmodule_supported, pkg-config variable, meson configure, glib, .pc 文件
title: PkgConfigDeps 不生成 gmodule-no-export-2.0.pc 导致 meson configure 失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: PkgConfigDeps 只从依赖 recipe 的 package_info components 生成 .pc；glib recipe 只声明 gmodule-2.0，未声明 gmodule-no-export-2.0。gdk-pixbuf 等 GNOME 库 meson.build 用 dependency('gmodule-no-export-2.0') 且要 get_variable('gmodule_supported')，configure 直接失败
affected_scope: 所有基于 glib 的 GNOME meson 库（gdk-pixbuf/pango/gtk 等）
verification_cmd: conan create gdk-pixbuf/2.44.6.1 -o gdk-pixbuf:shared=True && grep -n "gmodule-no-export-2.0" ~/.conan2/p/gdk-pixbuf*/b/build-release/meson-info/intro-buildoptions.json

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 在 recipe 的 generate() 中手工合成 gmodule-no-export-2.0.pc 写入 generators_folder（指向 glib 包 lib/include，含 gmodule_supported=true、Requires: glib-2.0）
rec_description:        在 conanfile.py 的 generate() 中用 write_text 合成 gmodule-no-export-2.0.pc 到 generators_folder，prefix 指向 glib package_folder，声明 gmodule_supported=true 与 Requires: glib-2.0，使 meson dependency('gmodule-no-export-2.0').get_variable('gmodule_supported') 正常解析
rec_command: def _write_gmodule_no_export_pc(self): 见 gdk-pixbuf 2.42.12 conanfile.py
rec_auto_fix:           false                  # 引擎能否自动执行
rec_impl:               conan-recipe                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      在 glib recipe 中补充 gmodule-no-export-2.0 组件声明（package_info.components 增加 gmodule-no-export-2.0，生成对应 .pc）
fallback_description:   直接修改依赖 glib 的 recipe，在 package_info().components 中声明 gmodule-no-export-2.0 组件，让 PkgConfigDeps 自动生成 .pc；代价是需要维护下游 glib 配方
fallback_command:       patch -p1 < glib.patch && conan create glib/2.82.6.1 -o glib:shared=True
fallback_auto_fix:      false
fallback_impl:          source-patch

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       --wrap-mode|pkg-config.*gmodule-no-export-2.0.*--with
forbid_1_reason:        --wrap-mode 或手工塞宿主机 .pc 会引入宿主机 glib，污染 OHOS 环境
forbid_1_consequence:   链接到宿主机 glib，构建产物不可运行或 CI 交叉校验失败
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

