#====================================================================
# DRAFT-plink-1.07-legacy-cpp-nested-iterator-shadowing.kv
# 配对文档: knowledge/drafts/DRAFT-plink-1.07-legacy-cpp-nested-iterator-shadowing.md
# 来源: archives/p/plink/1.07 (PLINK 1.07 适配)
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-plink-1.07-legacy-cpp-nested-iterator-shadowing
trigger_tool:           clang|gcc|make
phase:                  compilation
error_signature:        error: redefinition of 'i' with a different type|error: redeclaration
                         of 'j' with a different type|note: previous definition is here|for
                         \(int i=0;

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               compat, cpp, legacy-source, toolchain
match_keywords:         redefinition of, different type, previous definition is here,
                         shadowing, nested declaration, iterator, std::vector,
                         std::map, std::set, 2009-era source
title:                  2009 年代 C++ 在现代 clang 上的「迭代器遮蔽外层循环变量」硬错误

# ═══ Layer 2: 诊断层 ═══
root_cause:             老代码在 for 初始化语句里声明 int 循环变量，随后又在同一
                         作用域声明同名容器迭代器。现代 clang/gcc 按 C++ 作用域规则
                         判为硬错误（不是 warning），整个 TU 编不过。
                         clang 的报错形态是
                         `redefinition of 'i' with a different type: 'X::iterator' vs 'int'`
                         加 `note: previous definition is here` 指向那行 for。
affected_scope:         2005-2012 年的 C/C++ 统计/生物信息/科研代码；与 OHOS 无关，
                         任何新工具链都会踩（因此不能归因于交叉编译）
verification_cmd:       grep -nE 'for \(int [a-z]+ ?=' <file> && grep -nE '(vector|map|set)<.*>::iterator [a-z]+ ?=' <file>

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_description:        给被遮蔽的迭代器变量改名（i -> i_iter / j -> j_iter），不改算法、
                         控制流与输出。改动越小越好，且必须能在 notes 里说明输出等价
rec_command:            patch -p1 -i 0001-nested-iterator-shadowing.patch
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_description:   若改名面太大（同一函数里几十处），可给该 TU 单独放宽到旧标准
                         （-std=gnu++98）——但 libc++ 已移除部分旧特性，且会与仓内
                         cppstd=17 基线不一致，仅作最后手段
fallback_command:       make CXX="<cc> -std=gnu++98"
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       把这类问题当作 OHOS/musl 平台差异来"适配"
forbid_1_reason:        与平台无关，x86 Linux + 现代 clang 同样失败；归因错了会写进
                         notes 误导后人
forbid_1_consequence:   知识库沉淀成假平台知识，下一个包照抄错误的"平台方案"

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P008, P031

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             pcapfix-1.1.7-musl-legacy-uint-bsd-types,
                         DRAFT-E687-raw-makefile-cmdline-flag-pin-static-openblas-l2,
                         DRAFT-argyll-cms-jam-host-toolchain-env-shadowing
