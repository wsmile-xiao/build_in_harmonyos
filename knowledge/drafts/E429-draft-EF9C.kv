#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: make
phase: compilation
error_signature: js0n\.h' file not found|fatal error: '[a-z0-9_]+\.h' file not found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
prescan_pattern:              CFLAGS\s*\?=\s*.*-I\$\(
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: build-system,make,environment,headers,compat
match_keywords: CFLAGS,js0n.h,file not found,vendored include,Makefile,environment CFLAGS,LDFLAGS
title: Makefile CFLAGS ?= 被环境 CFLAGS 顶掉导致 vendored include 目录丢失

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游 Makefile 使用 CFLAGS ?= -O3 -g -Wall -I$(JSONDIR) 形式,环境里已导出的 CFLAGS（conan MakeToolchain/设备 profile/worker shell）会让 ?= 完全不赋值,整条默认值连同 vendored 头文件目录一起被丢弃,LDFLAGS ?= -lm 同理
affected_scope: 所有以裸 Makefile 交付且用 ?= 定义 CFLAGS/LDFLAGS 的上游项目（pktriggercord/libpktriggercord 实测命中）
verification_cmd: grep -n 'CFLAGS ?=' Makefile; echo CFLAGS=$CFLAGS

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 始终用 make 命令行变量显式传入完整 CFLAGS/LDFLAGS（命令行优先级高于环境）并补齐 -I<vendored include> 与 -lm;编译器取自 conan conf tools.build:compiler_executables 而非 shell ${CC}（R33）
rec_description: make 命令行变量优先级高于环境，显式传完整 CFLAGS/LDFLAGS 即可保住上游默认值
rec_command:            make <target> CFLAGS="${UPSTREAM_DEFAULT_CFLAGS} -fPIC -I<vendored include>" LDFLAGS="-lm" -j1
rec_auto_fix:           false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: 用 sed 把上游 Makefile 的 `CFLAGS ?=` 改成 `CFLAGS +=`（保留默认值再追加），走 patches/ 交付
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:        unset CFLAGS|export CFLAGS=\"\"
forbid_1_reason:      在配方里清空/绕过环境 CFLAGS 只是把问题挪走，别的变量（LDFLAGS/PKG_CONFIG_PATH）仍会踩同一 `?=` 语义
forbid_1_consequence:    换 worker 或换 profile 后再次失败，且掩盖上游可复现性缺陷
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P001,P011

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
solution_cmd: make cli CFLAGS="-O3 -g -Wall -fPIC -Isrc/external/js0n" LDFLAGS="-lm" -j1
doc_file:               doc/E429.md
last_updated: 2026-09-17
source_event:           libpktriggercord/0.85.1-20221221181244 探索编译 make cli（首个真实错误）

# ═══ 知识协作 (Authorship & Provenance) ═══
