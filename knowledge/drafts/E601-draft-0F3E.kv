#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E601.kv，填写各字段
# 对应的人类文档: doc/E601.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E601
trigger_tool: clang|cc|make
phase: compilation
error_signature: fatal error: 'ieee754.h' file not found|ieee754.h.*No such file|'bits/.*\.h' file not found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: portability,libc,headers,musl
match_keywords: ieee754.h,glibc header,musl,OHOS libc,header not found,portable union,bit-field
title: glibc 专属头文件（如 ieee754.h）在 OHOS musl 系 libc 缺失，需用可移植位域 union/内联定义替代

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 部分上游 C/C++ 测试或工具代码包含 glibc 专属头文件（如 <ieee754.h> 的 ieee754_float 位域联合）。OHOS 基于 musl 的 libc/sysroot 不提供该头，clang 报 file not found。修复思路不是换 libc，而是把用到的位域布局（sign/exp/mantissa）内联为可移植 union，保持字段名不变。
affected_scope: 包含 glibc 专属头文件（<ieee754.h> 等）的上游 C/C++ 测试/工具源码，在 OHOS（musl 系 libc）编译时头文件缺失
verification_cmd: make -C /storage/Users/currentUser/tmp/builds/symfpu-0.0-git.40bdec00.work CXX=clang++ -j1 && ./test --allTests --specialValues

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: inline-portable-bitfield-union
rec_description: 移除 glibc 专属 include，在测试/工具源码内联等价的 IEEE-754 单精度位域 union（mantissa:23 exponent:8 negative:1），字段名与 glibc 一致（.ieee.negative/.exponent/.mantissa），无需改动其余逻辑；属于 portability patch。
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

