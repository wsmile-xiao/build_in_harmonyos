# ═══════════════════════════════════════════════════════════════════
# E673 上游 CMake 头文件桥接：用 CMAKE_PROJECT_<name>_INCLUDE 在
#      project() 之后注入片段，替代改 CMAKE_CXX_FLAGS 硬塞 -I
# 来源: feat/lapackpp-2024.10.26（conan create 实测，2026-09-28）
# 路径: 依赖项任务 lapackpp/2024.10.26 首轮即红（'blas.hh' file not found ×200+ TU）
# 状态: 草稿（待审核 promote）
# ═══════════════════════════════════════════════════════════════════

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E673
trigger_tool:           cmake|conan
phase:                  compilation|configuration
error_signature:        'blas\.hh' file not found|
                        'blas/defines\.h' file not found|
                        fatal error: '.*\.hh' file not found|
                        Could not find a package configuration file provided by ".*"

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, cmake, conan
match_keywords:         CMAKE_PROJECT_INCLUDE, CMAKE_PROJECT_<name>_INCLUDE,
                        CMAKE_PROJECT_TOP_LEVEL_INCLUDES, include_directories,
                        CMAKE_PREFIX_PATH, find_package, imported target,
                        INTERFACE_INCLUDE_DIRECTORIES, CMakeDeps, include path
title:                  上游 CMake 工程以引号包含引用"兄弟包"公共头但不把其导入目标
                        链到自身；Conan 下需用 CMAKE_PROJECT_<name>_INCLUDE 注入
                        find_package+include_directories 桥接（勿改 CMAKE_CXX_FLAGS）
prescan_pattern:        find_package\([A-Za-z0-9_]+\)|#include\s*"[A-Za-z0-9_/]+\.hh"
prescan_globs:          conanfile.py, CMakeLists.txt, cmake/*.cmake

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             经典「原生构建隐式成立、换包管理即失效」模式。上游
                        lapackpp（icl-utk-edu）执行 find_package(blaspp) 后**只取
                        其配置变量**，从不 target_link_libraries(... blaspp::blaspp)，
                        而 include/lapack/util.hh 直接 #include "blas.hh"。原生构建
                        里 blaspp 与 lapackpp 同前缀安装（/opt/slate），该头落在
                        编译器默认搜索路径上，故"能用"；Conan 包布局下每个依赖在
                        各自 package_folder 的 include/ 里，不在任何默认路径上，
                        于是 200+ 个 src/*.cc 全部 fatal error: 'blas.hh' not found。
                        两类修法：
                        ① 改 CMAKE_CXX_FLAGS/CMAKE_CXX_STAGING_INCLUDE_DIRECTORIES
                           塞 -I <dep>/include —— 污染全量编译、顺序不可控、
                           且把环境耦合写进配方（CI 静态闸会挑）；
                        ② 改上游 CMakeLists 加 target_link_libraries —— 要打补丁，
                           违背"零补丁/零源码改动"且升级易冲突。
affected_scope:         任何"上游 find_package(X) 只取变量、不链目标，却用引号包含
                        引用 X 的公共头"的 CMake 工程（SLATE 族 blaspp/lapackpp
                        为典型；同类结构在 SLATE 本体、若干 Fortran/C++ 包装层也有）。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           cmake-project-include-bridge
rec_description:        用 CMake 官方注入点 CMAKE_PROJECT_<PROJECT_NAME>_INCLUDE
                        （CMake 在 project() 之后**立即** include 该文件；另有
                        CMAKE_PROJECT_INCLUDE / CMAKE_PROJECT_TOP_LEVEL_INCLUDES
                        两个等价作用域更广的变体）指向一个随配方导出到源码树的短
                        桥接片段：
                            if (NOT TARGET <pkg>::<pkg>)
                                find_package(<pkg> CONFIG REQUIRED)
                            endif()
                            include_directories(${<pkg>_INCLUDE_DIRS})
                        要点：
                        (1) 用 include_directories()（目录作用域）而不是给某个
                            target 补 include——本包无法改上游 target 属性，而
                            include_directories() 在 project() 之后、add_library
                            之前生效，自动覆盖其后创建的全部目标；
                        (2) 变量名 <pkg>_INCLUDE_DIRS 由 CMakeDeps 生成，用它
                            而非手拼路径，保持依赖图单一事实源；
                        (3) 片段文件用 save() 写到 source 树（generate() 里
                            tc.variables 指向它），随 export_sources 一起进缓存，
                            CI 从源码重建时同样可用，无需下载任何额外产物；
                        (4) 配方类属性需 generators = "CMakeDeps"，否则构建树内
                            根本没有 <pkg>-config.cmake。
rec_command:            save(self, os.path.join(self.source_folder, "conan", "bridge.cmake"), BRIDGE)
                        tc.variables["CMAKE_PROJECT_<project>_INCLUDE"] = os.path.join(
                            self.source_folder, "conan", "bridge.cmake")
rec_auto_fix:           false
rec_impl:               conanfile-generate-cmake-project-include-bridge

# ★ 禁止策略 ★
forbid_1_pattern:       tc\.variables\["CMAKE_CXX_FLAGS"\].*(-I|-isystem).*include|
                        -DCMAKE_CXX_FLAGS=.*-I
forbid_1_reason:        污染每一次编译（含 try_compile 探针），丢失目录作用域
                        控制，且把宿主绝对路径固化进配方（CI 换机即错）
forbid_1_consequence:   编译日志被无关头路径淹没；CI 静态闸判环境耦合；换机失败
forbid_2_pattern:       用上游安装生成的 <pkg>Config\.cmake（内嵌构建机绝对路径）
forbid_2_reason:        上游 install 出来的 config 常内嵌构建期绝对路径
                        （实测 blaspp 包内为 /storage/Users/currentUser/.cache/conan2/...）
forbid_2_consequence:   换 cache 根/换机后 include 与库路径全部错，且难以察觉
forbid_3_pattern:       patch 上游 CMakeLists 加 target_link_libraries\(.*blaspp::blaspp
forbid_3_reason:        本场景零补丁可解；打补丁会引入升级冲突面并触发 PF5/补丁审查
forbid_3_consequence:   补丁漂移、评审负担、后续上游升级需重做

# ═══ Layer 4: 原则引用 ═══
principles:             P012, P014

# ═══ 关系图 (Relations) ═══
similar_to:             E671（同一 BLAS++/LAPACK++ 族的另一半问题：私有变量面）、
                        E447（conan 配方 cache-variable bridge）、
                        E473（build-module imported-target injection）、
                        E284（cross-compile 下生成式 config 头）
caused_by:
conflicts_with:
prerequisite_of:        SLATE 及任何以 Conan 消费 blaspp 的下游包

# ═══ 元数据 ═══
verification_cmd:       conan create archives/l/lapackpp/2024.10.26 -pr:h=ohos-aarch64-wsl -pr:b=ohos-aarch64-wsl --build=missing
                        # 期望：编译 100% 通过并产出 lib/liblapackpp.a；
                        # configure 段 "Found BLAS++: …/generators"

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:                ohc-worker <ohc-worker@local>
source_pr:              # PR 创建后由知识库主编回填
source_commit:          # 随 PR 合并时由知识库主编回填

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count:  1
