#====================================================================
# DRAFT-ohos-autotools-dep-detection-macro-flag-injection.kv
# autotools 依赖检测宏（ACX_*/AC_CHECK_LIB/AC_CHECK_HEADER）只做存在性
# 检查，不把构建期 -I 写入 AM_CPPFLAGS、不注入静态库传递依赖的 -L/-l
# → Conan 依赖头/库须经 AutotoolsToolchain.extra_cflags/extra_ldflags
# 显式注入（含 cfitsio.a→zlib deflate/inflate）
#====================================================================

id:                     DRAFT-ohos-autotools-dep-detection-macro-flag-injection
trigger_tool:           configure|conan|clang|libtool
phase:                  configuration|compilation
error_signature:        fftw3.h.*No such file|
                         CFITSIO library not found|
                         .*library not found|
                         .*\.h.*No such file.*(AM_CPPFLAGS|include)

severity:               2
category:               ohos, autotools, conan, configure, build-system, dependency, static-linking
match_keywords:         ACX_FFTW, ACX_OPENBLAS, ACX_CFITSIO, AC_CHECK_LIB, AC_CHECK_HEADER,
                         AM_CPPFLAGS, extra_cflags, extra_ldflags, AutotoolsToolchain,
                         transitive, static library, zlib, cfitsio, fftw3.h, fitsio.h
title:                  autotools 依赖检测宏只做存在性检查 → 依赖头/库须经 toolchain 注入（含静态库传递依赖）

root_cause:             |
  ACX_FFTW/ACX_OPENBLAS/ACX_CFITSIO 与 AC_CHECK_LIB 等宏只做存在性检查：
  头文件用 AC_CHECK_HEADER（只探测路径存在，把 FFTW_H/CFITSIO_H 定义为路径
  字面量），不把 -I 写入 AM_CPPFLAGS；库链接探测只带宏内 libdir -L$1
  （如 AC_CHECK_LIB(cfitsio, ffopen, ..., [-L$1])），不含静态库传递依赖
  （cfitsio.a→zlib deflate/inflate），AC_CHECK_LIB 链接探测缺 -L<zlib>/lib
  -lz 时报 "CFITSIO library not found"。configure.ac 只 AC_SUBST
  (AM_CPPFLAGS/AM_LDFLAGS) 但宏内从不写 AM_CPPFLAGS。因此 Conan 依赖
  头/库必须经 AutotoolsToolchain.extra_cflags(-I) / extra_ldflags(-L + -l)
  显式注入。

affected_scope:         Conan+autotools 且依赖检测走宏探测（非 pkg-config）的项目；
                         静态库依赖链上存在传递依赖（如 cfitsio.a→zlib）的链接探测

verification_cmd:       |
  grep -n -e "AC_CHECK_HEADER" -e "AC_CHECK_LIB" m4/acx_*.m4
  grep -n -e "AM_CPPFLAGS" -e "AM_LDFLAGS" configure.ac
  conan create archives/s/source-extractor/2.28.2（round-2 权威 CI：
  configure 头文件检查通过 433-445 行、链接行含 -I/-Lz -lz 999-1002 行）

rec_priority:           1
rec_approach:           toolchain-flag-injection
rec_description:        generate() 内对检测宏涉及的 Conan 依赖显式注入头文件与库
                        路径（含静态库传递依赖），configure 的 AC_CHECK_HEADER/
                        AC_CHECK_LIB 即可命中。
rec_command:            tc.extra_cflags.append("-I%s" % os.path.join(dep.package_folder, "include"))
                        tc.extra_ldflags.append("-L%s" % os.path.join(zlib.package_folder, "lib"))
                        tc.extra_ldflags.append("-lz")
rec_auto_fix:           false
rec_impl:               manual-conan-recipe

fallback_priority:      2
fallback_approach:      configure-arg-override
fallback_description:   若项目用 configure 文档化覆盖变量（如 --with-*-incdir/
                        --with-*-libdir），可直接把 conan 包路径传入 configure args
                        （source-extractor 即用此 + extra_cflags 双路）；仅改覆盖
                        变量仍缺 -I 时仍需 extra_cflags。
fallback_command:       "--with-fftw-incdir=%s" % os.path.join(fftw.package_folder, "include")
fallback_auto_fix:      false
fallback_impl:          configure-arg-override

forbid_1_pattern:       依赖 AC_CHECK_LIB 自动带出传递依赖|忽略 zlib 直接链 cfitsio
forbid_1_reason:        宏的链接探测只带 -L$1（libdir），静态库传递依赖（deflate/
                        inflate）不在此探测内，缺 -lz 必失败
forbid_1_consequence:   configure 报 CFITSIO library not found，误判为缺依赖

principles:

causes:                 []
caused_by:              []
similar_to:             [E075,E277,E327-draft-configure-raw-lib-probe,DRAFT-conan-staticlib-transitive-headers]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-ohos-autotools-dep-detection-macro-flag-injection.md
last_updated:           2026-08-25
source_event:           source-extractor/2.28.2 OHOS PC 适配（round-1 实测 fftw3.h not found / CFITSIO library not found 后修复；round-2 权威 CI 链接行验证 -I/-Lz -lz 生效，make check 1/1 PASS）

