#====================================================================
# DRAFT-libint-2.13.1-pre-generated-library-tarball.kv
# 候选：libint 类"编译器+预生成库"双态架构应使用官方 release 预生成库 tarball
#====================================================================

id:                     DRAFT-libint-2.13.1-pre-generated-library-tarball
title:                  libint 等"编译器+预生成库"双态架构：用官方 release 预生成库 tarball 而非 git tag 源码包
severity:               2
category:               build-system, source-selection
trigger_tool:           cmake|conan-create|init-build
phase:                  configuration|bootstrap
error_signature:        libint.*build_libint|libint.*generator|configure.*No such file or directory.*libint|
                         libint.*export.*slow|LIBINT2_LIBRARY_CXX_SRC|7887.*source files

match_keywords:         libint, libint2, build_libint, generator, export, pre-generated,
                         release asset, tarball, GitHub archive, cmake, quantum chemistry,
                         molecular integrals, source selection, tag archive

root_cause:             libint 仓库是"编译器 + 库"双态架构：GitHub tag 源码 tarball 是完整仓库，
                         含 libint 编译器（src/bin/libint）与 export 机制；若直接用该源码包走 CMake
                         默认构建，需要先编译 build_libint 再运行导出生成库源码（串行、极慢、依赖
                         生成器配置），不适合 Conan 干净构建。官方 release 提供预生成 lmax=6 标准库
                         tarball（libint-2.13.1.tgz），内含完整可直接构建的 CMake 库工程（约 7887
                         个库源文件 + tests/unit + python 测试），这才是配方应选用的官方源。

rec_approach:           source-selection
rec_approach_detail:    conandata.yml sources.url 指向官方 release 预生成库 tarball
                         （https://github.com/evaleev/libint/releases/download/v2.13.1/libint-2.13.1.tgz），
                         而非 refs/tags/v2.13.1.tar.gz 源码包；sha256 按该资产实际校验。配方用 CMake
                         模板（非 autotools），关闭可选构建（LIBINT2_ENABLE_FORTRAN/MPFR/PYTHON=OFF），
                         C++11 API 需要 header-only Eigen（requires eigen/3.4.1, transitive_headers），
                         Boost 可选（缺失时构建期自动解包 external/boost.tar.gz）。libint2 2.13 的
                         Engine 为非模板类，构造参数 (operator, max_nprim, max_l)，如
                         libint2::Engine engine(libint2::Operator::overlap, 1, 0)。

rec_command:            cmake -S . -B build -DCMAKE_PREFIX_PATH=<eigen> && cmake --build build -j<N>
rec_auto_fix:           false
rec_impl:               conan-recipe-source-selection

verification_cmd:       conan create ... -pr:h=ci/conan/profiles/ohos-aarch64 --build=missing
verification_note:      conan-verify G2 通过；test_package 消费者验证重叠积分 S_ss ≈ 1.0（R34 实跑）

applicable_scope:       同样"编译器生成库源码"双态架构的项目（libint 后续版本、依赖 libint 的
                         mpqc 系、以及其它 codegen 型库）；OHOS/Linux 交叉编译均适用
counter_examples:       不需要生成器的纯 CMake 库仍直接用官方 tag 源码包；libintl/gettext 类
                         NLS 库与本候选无关
limitations:            预生成库 tarball 的 lmax 与积分类型由官方发布固定；需要自定义 AM/orderings
                         时必须走源码包 + build_libint 流程
kb_ref:                 E017, E092
library:                libint
version:                2.13.1
source_url:             https://github.com/evaleev/libint/releases/download/v2.13.1/libint-2.13.1.tgz
sha256:                 029e1347774bbf740e8ef9118d736413b52c023b85a5f76b61ce6fbf1ab8e43b
last_updated:           2026-09-22
