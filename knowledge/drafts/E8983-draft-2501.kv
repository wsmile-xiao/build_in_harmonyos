#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E8983.kv，填写各字段
# 对应的人类文档: doc/E8983.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E8983
trigger_tool: configure
phase: configuration
error_signature: could not find required installation of FLEX|could not find required installation of BISON

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: autotools, build-system, conan, portability
match_keywords: AC_PROG_LEX, AC_PROG_YACC, unconditional configure tool check, generated parser, paired parser headers, stable release archive
title: Release 自带完整解析器时，区分 configure 的强制工具探测与真实再生成依赖

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: AC_PROG_LEX/AC_PROG_YACC 后的无条件报错并不检查归档是否含完整生成物，因而即使发布包已有双前缀 parser/lexer C 与匹配头文件，configure 仍拒绝缺少开发期生成器的目标。
affected_scope: 带完整生成器输出的稳定 C/C++ 源码发布包；不适用于缺失生成物、改动 grammar 或生成 ABI 不匹配的源码快照。
verification_cmd: 核对官方归档 SHA-256、所有 Makefile.am 生产源与成对生成头文件；在无 flex/bison 的目标运行完整 Conan create 与安装后解析/算法/错误输入测试。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: release-generated-parser-build-equivalence
rec_description: 以官方发行归档为输入，保留全部生产翻译单元和匹配 parser/lexer 输出；逐项补齐真实配置宏与安装契约，不调用无必要的生成器探测；保持所有注册上游测试，不用消费者测试冒充上游。
rec_command: 核对官方发行包中每份 grammar 的生成 C/头文件与完整生产源清单；只在无需再生成时用 Conan CMakeToolchain 构建完整生成物，并执行上游及安装消费者测试。
rec_auto_fix: false
rec_impl:

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: stub parser|delete grammar functionality|skip upstream tests|unverified generated sources
forbid_1_reason: 生成物缺失或与 grammar 不匹配时生成器是真依赖；不能靠删功能、替代实现或少报上游测试绕过。
forbid_1_consequence: 包功能或 ABI 失真，消费者通过不能证明完整适配。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E543
conflicts_with:         []
prerequisite_of:        []

