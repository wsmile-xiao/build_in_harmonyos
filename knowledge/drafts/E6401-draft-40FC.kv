#====================================================================
# E6401-draft-40FC.kv — CMake find_program(clang-tidy) 的多行参数会
#   生成语法损坏的 build.make（*** missing separator）。
#   必须用 Conan CMakeToolchain 的 cache_variables（而非 variables）
#   把 CLANG_TIDY_EXE 设为 -NOTFOUND 禁用。
#   实例：cpp-smtpclient-library 1.1.14 全量验证通过
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E6401
trigger_tool:           cmake|make|conan
phase:                  configuration|compilation
error_signature:        CMakeFiles/.*build\.make:\d+: \*\*\* missing separator|missing separator\.  Stop\.|__run_co_compile --tidy

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               cmake, build-system, toolchain, compat
match_keywords:         clang-tidy, CLANG_TIDY_EXE, find_program, build.make, missing separator, CMakeToolchain, cache_variables, __run_co_compile
title:                  CMake find_program(clang-tidy) 多行参数生成坏 build.make（missing separator）；Conan 配方须用 cache_variables 禁用 clang-tidy

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: |
  上游 CMakeLists.txt 用 find_program(CLANG_TIDY_EXE NAMES clang-tidy) 探测到
  clang-tidy 后，把一段含换行/分号的多行 --tidy 参数（header-filter、checks 列表）
  注入每个目标命令。CMake 在生成 Unix Makefiles 时把该多行字符串直接展开进
  build.make 的配方行，换行后未以 tab 起始的行被 make 判定为 "missing separator"，
  配置成功但 make 一启动即停止。我方案例的 build.make:82 即命中。用 tc.variables
  传 CLANG_TIDY_EXE 无效：find_program 优先读 cache 变量，variables 写入的
  toolchain 变量不阻止 find_program 重新探测。
affected_scope:         OHOS/任何安装了 clang-tidy 且上游 CMakeLists 用 find_program(clang-tidy)
                        + 多行 tidy 参数的 CMake 库；典型症状 "CMakeFiles/<tgt>.dir/build.make:N:
                        *** missing separator"。
verification_cmd:       grep -c 'clang-tidy' <build>/CMakeFiles/<tgt>.dir/build.make
                         # 修复前 >0（且 make 报 missing separator）；修复后 =0 且 make 通过

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           disable-clang-tidy-via-cache-variables
rec_description: |
  Conan 配方 generate() 中用 tc.cache_variables["CLANG_TIDY_EXE"] =
  "CLANG_TIDY_EXE-NOTFOUND"（必须 cache_variables，find_program 优先读 cache；
  用 variables 无效）。clang-tidy 不是构建必需项，禁用不改变产物。
rec_command: |
  def generate(self):
      tc = CMakeToolchain(self)
      tc.cache_variables["CLANG_TIDY_EXE"] = "CLANG_TIDY_EXE-NOTFOUND"
      tc.generate()
rec_auto_fix:           true
rec_impl:               conan-recipe-cache-variable

fallback_priority:      2
fallback_approach:      configure-flag
fallback_description:   无 Conan 时在 cmake 命令行传 -DCLANG_TIDY_EXE=CLANG_TIDY_EXE-NOTFOUND
fallback_command:       cmake .. -DCLANG_TIDY_EXE=CLANG_TIDY_EXE-NOTFOUND
fallback_auto_fix:      true
fallback_impl:          cmake-flag

# ★ 禁止策略 ★
forbid_1_pattern:       tc\.variables\["CLANG_TIDY_EXE"\]|tc\.variables\['CLANG_TIDY_EXE'\]
forbid_1_reason:        variables 不阻止 find_program 探测，clang-tidy 仍被找到，多行参数仍生成坏 build.make
forbid_1_consequence:   make 继续报 missing separator，浪费整轮调试
forbid_2_pattern:       sed.*build\.make|手改 build\.make
forbid_2_reason:        build.make 是生成物，改动不可提交、不可复现
forbid_2_consequence:   本地可编译但 CI 干净构建仍失败

# ═══ Layer 4: 原则引用 ═══
principles:             P006, P013

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             E6341
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               knowledge/drafts/E6401-draft-40FC.md
last_updated:           2026-09-22
source_event:           cpp-smtpclient-library 1.1.14 适配：conan-verify G2 conan create 构建失败
                        （clang-tidy 多行参数破坏 build.make.missing separator），
                        修复后用 tc.cache_variables 禁用 clang-tidy，conan-verify G0-G4 全 PASS

