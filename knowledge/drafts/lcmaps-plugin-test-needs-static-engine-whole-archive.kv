#====================================================================
# Draft: LCMAPS plugins reference internal framework symbols
#        (lcmaps_log etc.) that are NOT exported by
#        liblcmaps_without_gsi.so (absent from its dynsym; defined only
#        in the .a). In production the engine is statically linked into
#        the consumer with -rdynamic. A test_package must reproduce
#        that image: --whole-archive the engine .a + -rdynamic, then
#        dlopen(RTLD_NOW) of the plugins resolves. Linking the shared
#        framework can never work.
#====================================================================

id:                     DRAFT-LCMAPS-PLUGIN-TEST-NEEDS-STATIC-ENGINE-WHOLE-ARCHIVE
trigger_tool:           conan|cmake
phase:                  testing
error_signature:        Error relocating .*lcmaps_log: symbol not found|Error relocating .*: lcmaps_log|symbol not found.*dlopen

severity:               2
category:               testing|packaging|upstream-semantics
match_keywords:         lcmaps, plugin, dlopen, RTLD_NOW, lcmaps_log, liblcmaps_without_gsi, dynsym, nm -D, static link, whole-archive, rdynamic, musl, test_package, LCMAPS engine, voms

title:                  LCMAPS 插件 test_package 须 --whole-archive 静态链接引擎库 + -rdynamic 模拟 LCMAPS 引擎进程映像（框架 .so 不导出 lcmaps_log 等内部符号，链接 .so 版框架永远解析不了插件重定位）

root_cause:             lcmaps 插件引用 lcmaps_log 等框架内部符号，nm -D 证实这些符号不在 liblcmaps_without_gsi.so 的 dynsym（只定义于 .a）。LCMAPS 生产形态是评估引擎静态嵌入消费程序、经 -rdynamic 导出到主程序 dynsym，插件 dlopen 从主程序全局命名空间解析。所以测试程序即使 NEEDED 了框架 .so 也解析不了；且 .a 静态库按需拉取——程序不引用 lcmaps_log 时定义它的 TU 根本不进主程序，-rdynamic 无从导出，必须 --whole-archive。
affected_scope:         lcmaps-plugins-* 全系列插件包的 test_package 与 CI 冒烟；其他"插件引用宿主内部符号、宿主静态嵌入"型上游（判断方法：nm -D <宿主>.so 判导出性、nm <宿主>.a 判归属）。
verification_cmd:       llvm-nm -D $LCPKG/lib/liblcmaps_without_gsi.so | grep -c lcmaps_log   # 0；llvm-nm $LCPKG/lib/liblcmaps_without_gsi.a | grep -w "T lcmaps_log"   # 有定义
rec_priority:           3
rec_approach:           static-engine-whole-archive-rdynamic
rec_description:        (1) test_package 的 CMakeLists 用 target_link_libraries(... -Wl,--whole-archive ${lcmaps_PACKAGE_FOLDER_RELEASE}/lib/liblcmaps_without_gsi.a -Wl,--no-whole-archive) 全量拉入引擎库；(2) target_link_options(... -rdynamic) 把引擎符号导出到主程序 dynsym（musl 的 dlopen 解析范围）；(3) ${lcmaps_PACKAGE_FOLDER_RELEASE} 是 CMakeDeps 注入的包根变量避免硬编码；(4) conanfile.py 需显式 self.requires("lcmaps/1.6.7")——CMakeDeps 只为直接 requires 生成 config（版本与主配方同步）；(5) test() 运行时 LD_LIBRARY_PATH 只需插件目录 <tested>/lib/lcmaps（引擎已静态进程序）；(6) 验证口令：修复后 test_package 应 RESULT: PASS 且 6 插件 dlopen+dlsym 全过、0 skip。
rec_command:            llvm-nm -D <pkg>/lib/liblcmaps_without_gsi.so | grep lcmaps_log; cmake --build <test_build_dir> && LD_LIBRARY_PATH=<pkg>/lib/lcmaps ./test_lcmaps_plugins_voms <pkg>
rec_auto_fix:           false

