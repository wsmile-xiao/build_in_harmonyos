#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E6341.kv，填写各字段
# 对应的人类文档: doc/E6341.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E6341
trigger_tool: ohc-run.py lang-preflight
phase: preflight
error_signature: 语言不匹配: task=bash, detected=c → env_unsupported|build_system.*make|source_stats.*c:1

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: lang-preflight, bash, makefile, env_unsupported, false-positive
match_keywords: lang-preflight, detected_language, env_unsupported, bash, pure script, install-only Makefile, autopkgtest fixture, D.4 边界规则, d-shlibs, dh-* 脚本包
title: 纯 bash 脚本 + install-only Makefile 的包会被 lang-preflight 判为 c（bash 永不参与主体统计）→ env_unsupported；按 R47 §D.4 复核为 bash

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: lang_detect.py 三级判定对纯脚本包结构上无解：①_manifest_scan 只要顶层存在名为 Makefile 的文件就返回 (c/cpp, make)，而 d-shlibs 的 Makefile 是 install-only（all: 为空规则）；②_source_stats 按扩展名统计并把 bash 排除在 total/dominant 之外（D.4 视 bash 为辅助脚本），而 d-shlibmove/d-devlibdeps 本身无扩展名（只有 #!/bin/bash 头），永远计不进来；③唯一被统计到的 c 文件是上游 autopkgtest 夹具 debian/tests/uppercase.d/libUppercase.c。三者叠加 → detected=c，与 task=bash 不匹配 → 自动写终态 env_unsupported。该工具在结构上无法产出 detected_language=bash。
affected_scope: 一切纯 bash/sh 脚本 + install-only 或 packaging-only Makefile 的包（Debian native 脚本包、dh-* 系列、*-tools），以及源码树内附带 autopkgtest/debian-tests C 夹具的脚本包
verification_cmd: python3 scripts/ohc-run.py lang-preflight <软件> <版本> --src <源码目录> --lang bash

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: manual-boundary-rule-override
rec_description: 收到 detected=c/env_unsupported 时先按 R47 §D.4 边界规则人工复核：确认 Makefile 的 all: 为空且无 C 编译目标、被统计的 .c/.cpp 均为测试夹具而非产品源码、主体是可执行脚本（无扩展名 + shebang）→ 判误报，任务语言成立。保留 lang-preflight 完整输出与它自动写入的 env_unsupported result.json 作为证据，继续按任务语言适配，终态用 result --force 覆盖。不改框架、不删上游夹具。
rec_command: （流程决策；证据记录于 notes.md 的 language_evidence 与最终回报）
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: report-env-unsupported-with-language-fields
fallback_description: 若复核后确认主体确为非 bash/c 的其他语言（例如真的以某个 .c 为主体的库），才按 env_unsupported 上报并附 detected_language 与 language_evidence 三项
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: R47

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E543
conflicts_with:         []
prerequisite_of:        []

