#====================================================================
# DRAFT-guilite-2.1-configure-time-telemetry-script.kv — 知识图谱草稿
# 来源: guilite 2.1 适配（2026-09-19, executor pc4-11）
# 状态: DRAFT（待评审转正）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
trigger_tool:           cmake|configure|make
phase:                  configuration
error_signature:        execute_process.*sync\.sh|\.sync\.sh.*GuiLite|PowerBI.*datasets|curl ipinfo\.io|telemetry.*build|build.*report.*external

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, cmake, portability, network
match_keywords:         telemetry, sync.sh, execute_process, PowerBI, ipinfo, build info upload,
                        遥测, 统计上报, configure 期外联, /tmp 依赖, CMakeLists, build-time external call
title:                  构建期遥测/统计上报脚本（如 CMake configure 期 execute_process 调 .sync.sh）应补丁移除或降级
error_excerpt:          "execute_process(COMMAND ${CMAKE_SOURCE_DIR}/.sync.sh GuiLite)"

# ═══ Layer 2: 根因与方案 ═══
root_cause:             上游为统计构建信息（如 GuiLite 的 .sync.sh 上传 PowerBI + curl ipinfo.io 采集地域），
                        在 CMakeLists.txt configure 期用 execute_process 无条件调用遥测脚本。
                        问题：a) configure 期发起外联网络请求（沙箱/CI 中失败或挂起、泄漏信息）；
                        b) 依赖 /tmp 写临时文件（HMDFS/只读 /tmp 下失败）；
                        c) 该调用与构建产物、测试完全无关。
rec_approach:           补丁删除 CMakeLists.txt 中的 execute_process(.sync.sh) 调用（或降级为本地幂等、无外联实现）；
                        删除前确认遥测调用与产物/功能无关；删除后复跑 conan create 验证。
                        反例/边界：官方授权类上报（许可证检查）不可盲删；有功能副作用的调用需改为本地探测。

# ═══ Layer 3: 验证与适用 ═══
verification:           guilite 2.1: 补丁 0001 删除 execute_process(.sync.sh)，conan-verify G2（conan create
                        + test_package）通过；构建无外联依赖。
applicable_scope:       任何在 configure/build 期无条件外联遥测或依赖 /tmp 的上游 C/C++ 库（CMake/Makefile 皆适用）。
prescan_pattern:         execute_process.*\.sync\.sh|curl ipinfo\.io|powerbi\.com.*datasets
prescan_globs:          CMakeLists.txt, *.cmake, Makefile, *.mk, *.sh
