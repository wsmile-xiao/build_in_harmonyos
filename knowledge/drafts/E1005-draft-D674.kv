#====================================================================
# E1005-draft-D674.kv
# HarmonyOS PC: /proc 数据源选择性暴露，监控工具须按 PMDA/维度优雅降级
# (pcp 7.1.5 适配任务沉淀)
#====================================================================

id:                     E1005
trigger_tool:           make|runtime|pcp|pmda
phase:                  runtime
error_signature:        /proc/diskstats.*Permission denied|
                         /proc/pressure/(cpu|io).*No such file or directory|
                         open(/proc/[a-z_]+).*EACCES|
                         /proc/cmdline.*Permission denied

severity:               2
category:               runtime, filesystem
match_keywords:         /proc/diskstats, /proc/pressure, PSI, procfs,
                         pcp, linux_proc, pmda, root-only, EACCES,
                         ENOENT, degrade, graceful, monitoring

title:                  HarmonyOS PC /proc 部分暴露：diskstats root-only、PSI cpu/io 缺失、cmdline 受限；监控工具须按维度优雅降级

root_cause:             HarmonyOS PC 的 procfs 是选择性暴露的（pcp 7.1.5
                         任务机 2026-10-09 实测，普通用户）：
                         /proc/stat、/proc/meminfo、/proc/net/dev、
                         /proc/loadavg、/proc/pressure/memory、
                         /proc/self/status 可读；
                         /proc/diskstats 仅 root 可读（EACCES；
                         DRAFT-11233 记录其为 /sys/block/diskstats 符号
                         链接），/proc/pressure/cpu、/proc/pressure/io、
                         /proc/cmdline 受限或缺失。
                         监控工具（PCP linux/linux_proc PMDA、sysstat
                         iostat/sar、dstat、topline 等）若硬依赖某数据
                         源且打不开即 die()，在 OHOS 上直接无法启动。
                         特别注意：PSI 三件套不是全有/全无——
                         pressure/memory 可读而 pressure/cpu、pressure/io
                         不可读，代码不能假设三者同生共死。
affected_scope:         所有在 HarmonyOS PC 上读取 /proc 数据源的监控/
                         统计类工具（PCP linux、linux_proc PMDA、sysstat、
                         dstat、nmon、topline、htop 等）
verification_cmd:       for f in stat meminfo net/dev diskstats loadavg \
                         pressure/cpu pressure/memory pressure/io cmdline; \
                         do head -c 1 /proc/$f >/dev/null 2>&1 \
                         && echo "/proc/$f 可读" || echo "/proc/$f 受限"; \
                         done
rec_priority:           1
rec_approach:           degrade-gracefully
rec_description:        按维度优雅降级：fopen 失败 → 该指标源标记
                         unavailable（PMDA 语义），绝不 die()。PCP 的
                         linux/linux_proc PMDA 天然具备此设计（文件缺失
                         时指标 unavailable，无需补丁，见 pcp 7.1.5 适配）；
                         die() 型工具（topline 类）需补丁降级为告警
                         （E429/DRAFT-11233 实例）。CI/conan 包环境无
                         sudo，E031 的 sudo-run 方案不可用——不要期望
                         /proc/diskstats 可读。逐文件探测数据源，禁止
                         假设 /proc 家族整体可读。
rec_command:            for f in stat meminfo net/dev diskstats loadavg; do \
                         head -c 1 /proc/$f >/dev/null 2>&1 \
                         || echo "warn: /proc/$f unavailable"; done
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      alt-source-or-unsupportable
fallback_description:   磁盘统计为核心功能的工具（iostat 本体等）不可
                         降级：尝试逐设备 /sys/block/<dev>/stat，同样受限
                         则按无法适配上报（env_unsupported），不要静默删
                         功能。

forbid_1_pattern:
principles:

causes:                 E429(DRAFT-11233 diskstats root-only 同机实测),
                         E031(sudo-run 在 CI 不可用)

doc_file:               doc/E1005.md
last_updated:           2026-10-09
source_event:           pcp 7.1.5 HarmonyOS PC 适配（task 9361，
                         积分赛-依赖类）
authors:                D674
source_pr:
draft:                  true
contributor_id:         D674
