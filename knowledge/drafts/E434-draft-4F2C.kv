#====================================================================
# E434 — OHOS /bin/sh 缺 POSIX 信号语义：编译期子进程 shell 覆盖
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E434
trigger_tool: test|runtime|make|cmake
phase: testing|runtime
error_signature: WIFSIGNALED|ExitInterrupted.*vs|kill -HUP|SIGHUP.*129|128\+1

# ═══ Layer 1: 识别层 (Recognition) ═══
severity: 2
category: ohos, shell, signal, portability, compat
match_keywords: SIGHUP, WIFSIGNALED, WIFEXITED, subprocess shell, /bin/sh, bash, NINJA_SUBPROCESS_SHELL, interrupt, exit 129, ExitInterrupted
title: OHOS /bin/sh 对 SIGHUP 以 WIFEXITED(129) 退出而非 WIFSIGNALED：编译期子进程 shell 覆盖修复

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: OHOS 设备 /bin/sh（toybox 系，musl aarch64）收到 SIGHUP 时以 exit(128+1)=129 正常退出（WIFEXITED）而非被信号杀死（WIFSIGNALED）；依赖 WIFSIGNALED(SIGHUP) 做中断检测的上游测试（如 ninja SubprocessTest.InterruptChildWithSigHup 期望 ExitInterrupted=130）在 OHOS 上失败（实际 129）。POSIX 信号语义 shell（如 /data/service/hnp/bin/bash）实测 WIFSIGNALED(SIGHUP) 正确
affected_scope: 通过硬编码 /bin/sh 派生子进程并依赖信号语义的 C/C++ 构建工具与测试（ninja 子进程调度、SIGHUP 中断检测）
verification_cmd: ./ninja_test --gtest_filter=SubprocessTest.InterruptChildWithSigHup  → PASSED（补丁后 130==ExitInterrupted）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority: 1
rec_approach: subprocess-shell-compile-override
rec_description: 把子进程 shell 路径改为编译期宏（如 NINJA_SUBPROCESS_SHELL，默认 /bin/sh 保持其他平台不变），OHOS 构建以 -DNINJA_SUBPROCESS_SHELL=/data/service/hnp/bin/bash 覆盖为 POSIX 信号语义 shell
rec_command: cmake . -DNINJA_SUBPROCESS_SHELL=/data/service/hnp/bin/bash && cmake --build . --target ninja_test
rec_auto_fix:           false
rec_impl:               cmake-cache-var-compile-definition

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern: __OHOS__
forbid_1_reason: 平台宏直接写死编码平台差异，违反配方补丁平台宏禁令（R8）
forbid_1_consequence: PF5 平台宏闸拦截，PR 需额外说明豁免
forbid_2_pattern:
forbid_2_reason:
forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
principles: R8, R33

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              [E043]
similar_to:             [E043, E051]
conflicts_with:         []
prerequisite_of:        []

