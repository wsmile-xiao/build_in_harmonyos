#====================================================================
# DRAFT-nut-autotools-ohos-upstream-check-chain
# NUT 2.8.5 OHOS Autotools 生成规则、工具环境与上游测试闭环
# 路径 B 候选；不预占正式 E 编号
#====================================================================

id:                     DRAFT-nut-autotools-ohos-upstream-check-chain
trigger_tool:           configure|make|conan|gawk|sh|test_package
phase:                  configuration|build|testing|packaging
error_signature:        ln -fs.*docs/man|
                         driver-list-format[.]sh.*Permission denied|
                         make check.*gawk.*not found|
                         sbin/upsd.*not found|
                         upsc -V.*Network UPS Tools upsc 2[.]8[.]5

severity:               2
category:               ohos, autotools, hmdfs, upstream-test, conan, shell
match_keywords:         NUT, nut, Autotools, Makefile.in, LN_S, SHELL,
                         driver-list-format.sh, gawk, HNP PATH, make check,
                         test_package, upsc, upsd, dummy-ups, package layout
title:                  OHOS 旧式 Autotools 包的生成规则、HNP 工具环境与上游测试闭环

root_cause:             传统 Autotools 发布包可能同时包含 configure、Makefile.in、递归文档/测试规则和数据校验 hook；configure 选择的 LN_S/SHELL 只对使用变量的规则生效，手写的 ln -fs 或直接执行 .sh 仍会在 HMDFS 上失败。OHOS CI profile 即使通过绝对路径提供 clang/clang++，也不保证 make check 后续调用的 gawk 等 HNP 工具位于 PATH。最后，Conan package() 的实际 bin/sbin 布局和上游命令输出可能不同于传统 FHS/文案假设；若只验证 configure/make，不能证明上游测试和消费者包契约成立。

affected_scope:         >
  在 OHOS/HMDFS 上构建带预生成 Autotools 文件、递归 make check、文档链接、
  shell 校验 hook 或 CLI/daemon 安装规则的旧式 C/C++ 包。
verification_cmd:       >
  CI_PACKAGES="archives/n/nut/2.8.5" zsh ci/conan/build_and_test.sh;
  require make -j1, make check -j1, package bin/upsc/bin/upsd, and test_package
  upsc -V/-h evidence; revised test_package also requires upsd --version

rec_priority:           1
rec_approach:           audit-generated-rules-and-close-test-contract
rec_description:        >
  配置后审计所有递归 Makefile.in/Makefile 中的 ln -fs、脚本直接执行和工具
  变量；OHOS 分支统一让文档/测试规则使用 $(LN_S)/$(SHELL)，并为完整
  configure/build/check 进程前置 HNP 工具 PATH、显式 AR/RANLIB；test_package
  按实际 package tree 和真实 CLI 输出建立消费者断言；最后用真机 make check
  与 Conan test_package 同时收集证据。
rec_command:            >
  rg -n 'ln -f|driver-list-format[.]sh|SHELL|LN_S|AWK' . Makefile.in docs data tests;
  make -j1 && make check -j1; test -x bin/upsc; test -x bin/upsd; upsc -V; upsc -h; upsd --version
rec_auto_fix:           false
rec_impl:               source-patch|conan-recipe|upstream-test|consumer-test

fallback_priority:      2
fallback_approach:      isolate-the-first-failing-rule-layer
fallback_description:   >
  按 configure、编译、文档/测试规则、工具 PATH、package tree、消费者输出
  六层分别复现；每次只修复首个失败层，并保留前一轮失败日志，避免把设备
  工具缺失、上游规则缺陷和测试断言错误混成一个“权限问题”。
fallback_command:       >
  grep -nE 'ln -f|driver-list-format[.]sh|AWK|SHELL|LN_S' <generated-makefiles>;
  command -v gawk; find <package-folder> -maxdepth 2 -type f
fallback_auto_fix:      false
fallback_impl:          layered-shadow-ci-diagnosis

forbid_1_pattern:       make[[:space:]]+passed.*make[[:space:]]+check.*passed|make check.*not run
forbid_1_reason:        >
  make 成功只证明编译目标完成，不能证明递归 check 目标执行了上游测试；
  必须提供 make check 日志和实际测试计数。
forbid_1_consequence:   形成假测试证据，B 类评审无法复核适配闭环。

forbid_2_pattern:       chmod.*(driver-list-format|[.]sh)|only.*chmod.*script
forbid_2_reason:        >
  HMDFS 的限制发生在直接 exec 语义，chmod 不能替代显式 shell 解释；
  规则应经 $(SHELL) 调用脚本。
forbid_2_consequence:   make check 在设备上仍以 Permission denied/exit 126 失败。

forbid_3_pattern:       sbin/upsd|grep.*NUT.*upsc.*-V
forbid_3_reason:        >
  不能凭 FHS 习惯猜测 Conan package tree，也不能凭项目简称猜测版本输出；
  必须以 package() 实际结果和生产者命令契约为断言来源。
forbid_3_consequence:   消费者测试产生误报，或修复错误地改变打包布局。

forbid_4_pattern:       remove.*make check|disable.*upstream.*test|L2.*warning.*skip
forbid_4_reason:        >
  单个规则或非核心命令的失败应被隔离、修复或如实标记，不能删除上游测试
  来制造全绿结果。
forbid_4_consequence:   失去对真实 OHOS 适配质量的证据，且无法迁移到同类包。

principles:             P004, P006, P013, P016
causes:                 []
caused_by:              [E007, E011, E018, E079, E093]
similar_to:             [DRAFT-hmdfs-script-exec-interpreter, DRAFT-dejagnu-runtest-ohos-test-runtime]
conflicts_with:         []
prerequisite_of:        legacy Autotools packages with recursive upstream checks on OHOS

