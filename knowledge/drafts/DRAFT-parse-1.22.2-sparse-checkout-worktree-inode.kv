#====================================================================
# DRAFT-parse-1.22.2-sparse-checkout-worktree-inode
#    大仓库 + inode 受限共享文件系统下 git worktree 完整 checkout 失败
#    → --no-checkout 骨架 + sparse-checkout cone 只物化必要路径
# 来源: parse 1.22.2 适配（Path B 知识库扩展）R01 worktree 创建
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-parse-1.22.2-sparse-checkout-worktree-inode
trigger_tool:           git|worktree
phase:                  preparation|bootstrap
error_signature:        unable to create file archives/.*|
                        cannot create directory at .*archives/|
                        fatal: cannot create directory at|
                        git worktree add.*error: unable to create file

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               fs|git|ohos|infrastructure|environment
match_keywords:         git worktree add, inode, HMDFS, 共享存储, inode 耗尽,
                        sparse-checkout, sparse index, cone 模式, read-tree,
                        No space left on device, unable to create file,
                        worktree 创建失败, 大仓库, checkout 失败
title:                  inode 受限共享文件系统上 git worktree 完整 checkout 失败：用 --no-checkout 骨架 + sparse-checkout cone 只物化必要路径

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >-
  worker 共享分布式文件系统（HMDFS）inode 池全局 100% 水位（df -i
  IUse%=100%，剩余 <8 万 inode）。本仓库 ~4.1 万跟踪文件 + HMDFS 每文件
  多 inode 开销 + 230+ 个既有 worktree 占满 inode 池；`git worktree add`
  默认完整 checkout 全部文件时必然在某个目录创建点失败（失败路径逐轮
  漂移：knewstuff/6.14.0、libupnpp、liburcu……）。`df -h` 块空间仍充足。
affected_scope:         大仓库（数万文件）+ inode 受限共享文件系统 worker 上
                        创建任何新库专用 worktree 的场景；同一 worker 上所有
                        新库 R01 均受影响。
verification_cmd:       df -i /storage/Users/currentUser | tail -1（IUse%=100）；
                        git worktree add ... 2>&1 | grep 'unable to create file'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           sparse-checkout-cone-worktree
rec_description:        分四步规避全量 checkout 的 inode 需求：
                        1) `git worktree add --no-checkout <path> <branch>` 只建
                           骨架（.git 元数据 + 目录）；
                        2) `git sparse-checkout init --cone` 启用 cone 稀疏；
                        3) `git sparse-checkout set <dir1> <dir2> ...` 仅注册
                           必要目录（当前库归档目录 + knowledge + scripts +
                           templates + ci + references + docs 等流程依赖）；
                        4) `git read-tree HEAD` 加载 index 后
                           `git sparse-checkout reapply` 物化文件，磁盘文件数
                           降到全量 1/10 量级，`git status` 干净。注意稀疏检出
                           下 cone 外路径显示为 D（删除）属正常，物化后消失。
rec_command:            git worktree add --no-checkout <path> <branch> && \\
                        git sparse-checkout init --cone && \\
                        git sparse-checkout set <dirs> && \\
                        git read-tree HEAD && git sparse-checkout reapply
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      inode-relief-then-full-checkout
fallback_description:   若必须完整 checkout（如全仓审计），先按
                        DRAFT-shared-fs-inode-exhaustion 清理已完成任务的再生
                        构建目录释放 inode 至安全水位（建议 >10 万）再重跑
                        `git worktree add`（仍可能被其他并发任务重新占满）。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          scheduling

# ★ 禁止策略 ★
forbid_1_pattern:       在他人 worktree 内 checkout 切换分支绕过创建
forbid_1_reason:        任务约束：本库任务只能在专属 worktree 内工作
forbid_1_consequence:   worktree 污染、身份/branch 不一致
forbid_2_pattern:       重复完整 checkout 无限重试
forbid_2_reason:        inode 未释放时重试必在同族错误失败（失败路径漂移）
forbid_2_consequence:   浪费时间且不收敛

# ═══ Layer 4: 原则引用 ═══
principles:             W1, W2

# ═══ 关系图 (Relations) ═══
causes:
caused_by:              DRAFT-shared-fs-inode-exhaustion
similar_to:             E497, DRAFT-astronomy-2.1.9-upstream-test-data-external-repo-drift
conflicts_with:
