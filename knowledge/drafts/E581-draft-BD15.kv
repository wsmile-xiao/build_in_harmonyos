#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E581.kv，填写各字段
# 对应的人类文档: doc/E581.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E581
trigger_tool: make|gcc|clang|g++
phase: compilation
error_signature: fatal error: 'bits/byteswap.h' file not found|fatal error: 'byteswap.h' file not found|features.h: No such file or directory|__GLIBC__.*byteswap

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: compat, headers, libc, portability, ohos
match_keywords: byteswap.h, bits/byteswap.h, features.h, glibc-only header, compat shim, bswap_16, bswap_32, bswap_64, __GLIBC__, ohos sysroot
title: 源码自带 compat/ 头若直接 include glibc 专属头，在 OHOS 上必须改为自包含实现

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 部分软件为兼容老系统自带 compat/byteswap.h，其内部 include <features.h>/<bits/byteswap.h> 等 glibc 专属头；OHOS musl 系 sysroot 不含这些头，编译即 fatal error
affected_scope: 自带 compat/ 或 src/compat 目录、且该头内部 include glibc 专属头的老式 C 软件（多为民用/通信类老库）
verification_cmd: grep -rn 'bits/byteswap.h\|features.h' compat/ src/compat/ 2>/dev/null

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: patch-compat-header-self-contained
rec_description: 用补丁把 compat/ 头替换为自包含可移植实现（内联字节序探测 + __builtin_bswap16/32/64），不再 include 任何 glibc 专属头
rec_command: python3 $SKILL_ROOT/scripts/ohc-run.py refresh-patch --auto <pkg> <ver>  # 或手工维护 patches/NNNN-compat-<name>-portable.patch
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: toolchain-include-shadowing
fallback_description: 在 conanfile 工具链追加 include 路径指向自备的兼容头目录，避免改动上游源码（优先级低于打补丁，因不易复现）
fallback_command:
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
knowledge_ref: libcapi20-3.27 实测：compat/byteswap.h include <features.h>/<bits/byteswap.h>，补丁 0002-compat-byteswap-portable.patch 改为自包含实现后编译通过
doc_file:               doc/E581.md
last_updated: 2026-09-16
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

