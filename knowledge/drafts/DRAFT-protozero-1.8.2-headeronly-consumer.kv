#====================================================================
# DRAFT-protozero-1.8.2-headeronly-consumer — protozero 1.8.2 header-only
# 适配经验：Conan/CMake 消费边界 + NDEBUG 消费者测试陷阱
# 触发/来源: protozero 1.8.2 首轮 Bootstrap+Adapt+本地验证（pc1-41），
#   conan-verify G2 首次失败调试与修复（2026-08-28）
#====================================================================

id:                     DRAFT-protozero-1.8.2-headeronly-consumer
trigger_tool:           conan|cmake|clang|runtime|test
phase:                  configuration|compilation|testing|runtime
error_signature:        invalid_tag_exception: invalid tag exception|
                         protozero_assert\(.*tag\(\) != 0.*call next\(\)|
                         no matching member function for call to 'add_packed_uint32'|
                         'add_packed_varint' is a private member|
                         Error in test\(\) method.*ConanException

severity:               2
category:               conan,cmake,testing,headers,ohos
match_keywords:         protozero, header-only, pbf_reader, pbf_writer,
                         packed_field_uint32, NDEBUG, assert, test_package,
                         invalid_tag_exception, reader state, getter
title:                  protozero header-only 适配：CMake 消费边界与 NDEBUG 下 getter 失步陷阱

root_cause: >
  protozero 是 header-only C++14 库：上游 CMake 仅 install
  include/protozero 头文件，无编译产物，因此 Conan 配方必须用
  package_type=header-library、package_info 不声明 libs，并暴露
  protozero::protozero CMake target。两个真实陷阱：(1) protozero getter
  （get_uint32/get_string/get_packed_*）会推进 pbf_reader 内部状态机，
  若 test_package 把 getter 调用写在 assert(...) 内，-DNDEBUG 构建
  （conan create 默认 -O3 -DNDEBUG）会整段删除调用，导致 reader 失步、
  下一条目解析出 tag 0 抛 invalid_tag_exception；(2) packed 字段写入必须
  用公开的 packed_field_uint32/packed_field_varint 辅助类（add_element），
  add_packed_varint 是私有成员，add_packed_uint32 在该版本不存在；且子写器
  需先析构/commit（close_submessage）后再读回 buffer。
affected_scope: >
  header-only C++ 库的 Conan 配方与 test_package；使用 protozero 或同类
  "getter 推进读取状态" 的流式解析库的消费者测试；CI/conan create 采用
  -O3 -DNDEBUG 的构建环境。
verification_cmd: >
  clang++ -std=c++17 -fPIC -O2 -stdlib=libc++ -O3 -DNDEBUG -isystem
  <pkg>/include test_pbf.cpp && ./a.out; 预期输出
  "protozero 1.8.2 test_package: OK"；或直接运行
  python3 scripts/ohc-run.py conan-verify protozero 1.8.2（G2 通过）。

rec_priority:           1
rec_approach:           header-only-conan-consumer-test
rec_description: >
  header-only 库配方用 package_type=header-library 暴露 CMake target；
  test_package 中所有会推进 reader 状态的 getter 必须无条件执行、结果存
  变量后再断言，禁止写在 assert() 内；packed 字段用公开 packed_field_*
  辅助类写入，并在读回前确保子写器析构/commit。
rec_command: >
  test_package/test_pbf.cpp 模板：
  uint32_t v1 = reader.get_uint32(); assert(v1 == 42u);
  ...
  { protozero::packed_field_uint32 packed(writer, 3); packed.add_element(1u); }
  // packed 析构提交后，再构造 pbf_reader 读回 buffer
rec_auto_fix:           false
rec_impl:               conan-header-library-recipe

fallback_priority:      2
fallback_approach:      explicit-run-env-test
fallback_description: >
  若 conan create test() 阶段仍复现运行时崩溃，改用
  self.run(test_bin, env="conanrun") 显式运行并捕获输出定位
  （virtual-run-env-explicit-run，参考 E298）
fallback_command:       generators="CMakeDeps","CMakeToolchain","VirtualRunEnv"; self.run(".../test_protozero", env="conanrun", cwd=self.build_folder)
fallback_auto_fix:      false

# 审计提示（本条目非阻塞）
# 知识类型: 新增草稿，不预占正式 E 编号；promote 决策由人工审核决定。