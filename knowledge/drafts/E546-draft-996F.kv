#====================================================================
# E546 (draft) — L4 把补丁说明里的英文单词误报为危险函数
# 对应人类文档: knowledge/drafts/E546-draft-996F.md
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     E546
trigger_tool:           test|patch
phase:                  testing
error_signature: L4: Dangerous functions found in patches|L4_RESULT=warn: dangerous functions in patches

# ═══ Layer 1: 识别层 ═══
severity:               3
category:               testing,portability,build-system
match_keywords:         L4,dangerous functions,strcpy,sprintf,gets,strcat,patch,false positive
title:                  L4 危险函数扫描对整个补丁文件做无上下文 grep，命中英文单词内嵌的 strcpy/sprintf/gets/strcat 子串

# ═══ Layer 2: 诊断层 ═══
root_cause: L4 用 grep -rlE '(strcpy|sprintf|gets|strcat)\b' 扫描 patches/ 下的所有文件，包含补丁的人类可读说明头（commit-message 式前言）。说明里引用构建工具原始报错时，普通英文单词恰好内嵌了这些子串即误报——实测 spinner 的补丁说明里引用上游 make 报错 "No targets specified and no makefile found"，其中 "tar-gets" 内嵌 gets（\b 词边界只要求前一字符非词字符，不要求整词匹配），于是 L4 报 warn，尽管补丁 hunk 里根本没有这些函数
affected_scope: 所有 patches/ 下带说明头的补丁；说明里出现 target(s)/budgets/strategies 等含 gets 子串的英文单词，或引用含 strcat/sprintf 的构建输出时触发。纯代码 hunk 不会触发
verification_cmd: grep -rlE '(strcpy|sprintf|gets|strcat)\b' <pkg>/patches; grep -noE '(strcpy|sprintf|gets|strcat)\b' <pkg>/patches/*.patch

# ═══ Layer 3: 方案层 ═══
rec_priority: 1
rec_approach: 只改写补丁说明里的措辞以避开内嵌子串（例如把 "No targets specified..." 的引用改成 "there is no makefile for it to read"），保持 hunk 内容一字不动；随后用 grep -rlE 复扫确认无输出，并严格验证 patch --fuzz=0 仍能干净应用
rec_description: 只动说明文字、不动 hunk，绕开无上下文子串误报
rec_command: grep -rlE '(strcpy|sprintf|gets|strcat)\b' <pkg>/patches   # 必须无输出
rec_auto_fix:           false
rec_impl:               reword-patch-prose

fallback_priority:      2
fallback_approach: 删除补丁说明头（只留裸 diff），或把说明文字挪到 manifest.yaml/notes.md 而不放进 .patch 文件
fallback_description: 让补丁文件只包含 unified diff，彻底消除扫描面
fallback_command: diff -u a/configure b/configure > <pkg>/patches/0001-xxx.patch
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern: 在补丁说明里直接写出 strcpy|sprintf|gets|strcat 以声明"我没用到它们"
forbid_1_reason: 说明文字同样被扫描，写出这些词本身就会触发 L4 warn
forbid_1_consequence: L4_RESULT=warn，PR 评论里出现"发现危险函数"的误报警报

forbid_2_pattern: 为绕过 L4 而删除 patches/ 目录或篡改 hunk 行
forbid_2_reason: 这是为迎合误报而破坏真实修复，且触碰 CI 门禁不可绕过红线
forbid_2_consequence: 适配回退到 HMDFS 上的失败（config.status Permission denied）

# ═══ Layer 4: 原则引用 ═══
principles:            R52

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

