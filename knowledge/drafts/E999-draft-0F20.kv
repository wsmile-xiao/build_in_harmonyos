#====================================================================
# E999 — conanfile generate() 中 save_script("conanbuild") 覆盖 Conan 聚合 env 脚本 → 自引用递归 SIGSEGV
# 来源: knowthelist 2.3.1 适配（qmake/Qt5 配方）
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具
# phase:         出错阶段
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E999
trigger_tool:           conan|qmake|make
phase:                  building|configuration
error_signature:        Error -11 while executing|Signal 11 \(core dumped\)|conanbuild\.sh.*sources.*itself|RecursionError|qmake.*Error -11

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签
# match_keywords: 纯文本关键词(逗号分隔)
# title:         简短标题
severity:               3
category:               conan, build-system, env
match_keywords:         conanbuild, save_script, Environment, SIGSEGV, Error -11, qmake, self-recursive, env script
title:                  conanfile generate() 中 save_script("conanbuild") 覆盖 Conan 聚合 env → 自引用递归 SIGSEGV

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             Conan 自身在生成目录写入 conanbuild.sh（聚合 profile buildenv），配方 generate() 里再调用 Environment().vars(self).save_script("conanbuild") 会覆盖/改写该脚本，使其 . 自引用自身造成无限递归（栈溢出 → Signal 11 / Error -11），qmake 等子进程崩溃。
affected_scope:         任何在 generate() 中用 save_script("conanbuild") 注入自定义环境且随后 build() 用 env="conanbuild" 运行的 Conan 配方（qmake/Qt、autotools、cmake 均可能）。
verification_cmd:       在 build 目录 bash -c '. conanbuild.sh && <tool> --version' 观察 SIGSEGV；或检查生成的 conanbuild.sh 内容是否包含对自身路径的 . 引用。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先)
rec_priority:           1
rec_approach:           env-apply-context           # 用 with env.vars(self).apply() 替代 save_script
rec_description:        generate() 只生成 PkgConfigDeps/.pc；build()/package() 中创建 Environment 并用 with env.vars(self).apply(): 包裹 self.run()（不写 conanbuild.sh，避免覆盖聚合脚本）
rec_command:            def _build_env(self): env=Environment(); env.prepend_path(...); return env\nwith self._build_env().vars(self).apply():\n    self.run('qmake ...', cwd=src_dir)
rec_auto_fix:           false
rec_impl:               env-apply-context

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      save-script-other-name
fallback_description:   若必须用 save_script，改用非 "conanbuild" 的其他名字（如 save_script("conanbuild_custom")），并在 self.run(..., env="conanbuild_custom") 中引用。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       save_script\("conanbuild"\)|env\("conanbuild"\)
forbid_1_reason:        覆盖 Conan 聚合 conanbuild.sh 导致自引用递归崩溃；或引用被覆盖的脚本
forbid_1_consequence:   qmake/编译器子进程 Signal 11 / Error -11，构建失败难定位
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔)
principles:             P017

