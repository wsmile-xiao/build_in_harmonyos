#====================================================================
# Draft: hand-written autotools Makefile written for BSD make
#        ($(.TARGET)) breaks under GNU make + Conan out-of-source builds
#====================================================================

id:                     E639
trigger_tool:           make|conan
phase:                  compilation
error_signature:        No rule to make target '.*\.o'|clang: error: no input files|\[<builtin>: \.o\]|\(\.TARGET\)

severity:               2
category:               autotools, make, build-system, portability, conan
prescan_pattern:        \$\(\.TARGET\)
match_keywords:         .TARGET, BSD make, bmake, GNU make, static pattern rule, VPATH, out-of-source, Makefile.in, udfclient

title:                  BSD make $(.TARGET) 语法的手写 Makefile 在 GNU make/Conan out-of-source 构建下的两类规则失效与等价改写

root_cause:             上游手写 Makefile.in 的链接规则使用 BSD make 专有自动变量 $(.TARGET)（GNU make 无此变量，展开为空），规则退化并触发内建 .o 规则（clang -o .o / no input files）；同时该 Makefile 没有 VPATH，Conan 在独立 build folder 中 configure 后 GNU make 无法在 srcdir 定位 .c 源文件（No rule to make target '<app>.o'）。
affected_scope:         所有面向 bmake/pmake 的手写 Makefile 项目（NetBSD/13thmonkey 系源码、FreeBSD ports 来源、发行版 makedep 标注 bmake 的包）；在只提供 GNU make 的 Conan/CI 环境中首次构建即失败。
verification_cmd:       grep -n '(\$\.TARGET)' Makefile.in; ./configure --prefix=/tmp/p && make -j1
rec_priority:           1
rec_approach:           rewrite-bsd-make-rules-to-gnu-make
rec_description:        将 $(.TARGET) 链接规则等价改写为 GNU make 静态模式规则（$(APPS): %: %.o ... + $@.o），并在 Makefile 头部增加 VPATH= @srcdir@ 支持 out-of-source 构建；不改上游源码逻辑。
rec_command:            patches/0001-Makefile.in.patch (udfclient 0.8.21, PR #13235)
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:      tool-requires-bmake
fallback_description:   制品仓已有 bmake/20200710，可 tool_requires 后使用 bmake 构建；注意其 sys.mk 位于 <pkg>/share/mk，需 -r 或 -m 指定（见 DRAFT-9200-lddtree-shell-tool-portability）。
fallback_command:       tool_requires("bmake/20200710"); bmake -r
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       conanfile\.py.*sed|os\.system\(.*sed.*Makefile
forbid_1_reason:        在 conanfile 运行时用 sed 改写 Makefile 绕过 patches/ 审计（违反 R3/R6，不可复现）
forbid_1_consequence:   W4 审计 / 平台检视拦截，补丁与归档不一致

principles:
causes:                 []
caused_by:              []
similar_to:             [E074]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E639.md
last_updated:           2026-09-27
source_event:           conan create udfclient/0.8.21：$(.TARGET) 规则退化为 clang -o .o；补规则后 out-of-source 缺 VPATH 再报 No rule to make target 'udfdump.o'

authors:                kasumizawa-miyuu <241250031@smail.nju.edu.cn>
source_pr:              13235
source_commit:

