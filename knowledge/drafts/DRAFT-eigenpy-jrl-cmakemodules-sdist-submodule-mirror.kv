# Draft knowledge entry: eigenpy PyPI sdist needs pinned jrl-cmakemodules
id: DRAFT-eigenpy-jrl-cmakemodules-sdist-submodule-mirror
trigger_tool: conan|cmake|source
phase: source|configure
error_signature: "JRL cmakemodules not found|FetchContent_MakeAvailable|jrl-cmakemodules|codeload.github.com.*timeout|cmake/base.cmake"

severity: 2
category: eigenpy|cmake|submodule|source|ohos
match_keywords: eigenpy, jrl-cmakemodules, PyPI sdist, cmake/base.cmake, FetchContent, gh-proxy, codeload

title: eigenpy PyPI sdist requires a pinned jrl-cmakemodules source fallback
root_cause: >
  eigenpy 3.13.0 publishes a PyPI source distribution that contains .gitmodules but does
  not vendor the cmake/ jrl-cmakemodules submodule. If the recipe leaves upstream CMake to
  run FetchContent at configure time, OHOS CI may need live GitHub access during build.
affected_scope: >
  eigenpy 3.13.0 Conan recipes on HarmonyOS PC and similar jrl-cmakemodules-based projects
  whose release archives omit required git submodules.
verification_cmd: |
  conan source archives/e/eigenpy/3.13.0 --name=eigenpy --version=3.13.0
  test -f cmake/base.cmake

rec_priority: 1
rec_approach: download-submodule-in-source-step-with-sha256
rec_description: >
  Resolve the exact submodule commit from the upstream release, add a separate conandata entry
  for that archive, and unpack it into source_folder/cmake during source(). Keep the original
  main eigenpy tarball and the submodule tarball protected by pinned SHA256 values.
rec_command: |
  get(self, **self.conan_data["sources"], strip_root=True)
  get(self, **self.conan_data["cmake_submodule"], destination=os.path.join(self.source_folder, "cmake"), strip_root=True)
rec_auto_fix: false
rec_impl: conan-source-pinned-submodule

fallback_priority: 2
fallback_approach: mirror-github-archive-with-identical-sha256
fallback_description: >
  When direct GitHub codeload is slow or times out, list a verified gh-proxy GitHub archive URL
  before the original codeload URL. The mirror is acceptable only when the downloaded archive
  matches the same pinned SHA256.
fallback_command: |
  curl -L -o jrl-cmakemodules.tar.gz https://gh-proxy.com/https://github.com/jrl-umi3218/jrl-cmakemodules/archive/<commit>.tar.gz
  sha256sum jrl-cmakemodules.tar.gz
fallback_auto_fix: false
fallback_impl: verified-url-list-fallback

forbid_1_pattern: "FetchContent.*jrl-cmakemodules.*GIT_REPOSITORY"
forbid_1_reason: Build-time GitHub FetchContent makes CI dependent on live network and bypasses Conan source hashing.
forbid_1_consequence: Source or configure can fail intermittently even when the recipe is otherwise correct.
forbid_2_pattern: "download.*submodule.*without sha256|verify=False without sha256"
forbid_2_reason: A fallback mirror must still prove content identity.
forbid_2_consequence: The package source is not reproducible.

principles: source-reproducibility, no-build-time-fetchcontent, mirror-with-hash
causes:
caused_by:
similar_to:
conflicts_with:
prerequisite_of:

