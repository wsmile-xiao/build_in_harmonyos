#====================================================================
# DRAFT-delaunay-triangulation-2.1-ohos-conan-meson-helper-api
#   OHOS 适配版 conan 的 Meson helper API 面差异：
#   conan.tools.meson 无 meson_layout；Meson 无 compile()（用 basic_layout / build()）
# 来源: delaunay-triangulation 2.1 第一轮适配（任务 delaunay-triangulation-2.1-r01-pc1-17）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id: DRAFT-delaunay-triangulation-2.1-ohos-conan-meson-helper-api
trigger_tool: conan|conan create
phase: configuration|compilation
error_signature: cannot import name 'meson_layout' from 'conan\\.tools\\.meson'|
                'Meson' object has no attribute 'compile'|
                meson_layout|Meson\\.compile

# ═══ Layer 1: 识别层 ═══
severity:                 2
category:                 conan, build-system, meson, platform, api-surface
match_keywords:           conan, meson, meson_layout, basic_layout, Meson.compile, Meson.build, conan.tools.meson, ImportError, AttributeError, OHOS, helper API
title:                    OHOS 适配版 conan (2.29.1) 的 Meson helper 缺 meson_layout 与 compile()，需用 basic_layout/build()

root_cause:               OHOS 社区适配版 conan（基线 2.29.1，私有 PyPI 提供）的
                          conan.tools.meson 仅导出 Meson/MesonToolchain/helpers，
                          无 meson_layout；Meson helper 仅有 configure/build/install/test，
                          无 compile()。按官方 conan 文档模板（meson_layout / compile）
                          编写的配方在 import 期/构建期分别报
                          ImportError / AttributeError。版本库差异（官方 conan 有
                          meson_layout 与 compile，OHOS 适配版无）是根因。
affected_scope:           所有在 OHOS 适配版 conan 环境使用 Meson 构建的配方；
                          官方模板（conan.tools.meson.meson_layout / Meson.compile）
                          在此环境不可用。
verification_cmd:         python3 -c "import conan.tools.meson as m; print([x for x in dir(m) if not x.startswith('_')])";
                          python3 -c "from conan.tools.meson import Meson; print([x for x in dir(Meson) if not x.startswith('_')])"

# ═══ Layer 2: 诊断层 ═══
rec_priority:             1
rec_approach:             ohos-conan-meson-compat-imports
rec_description:          conanfile.py 中 layout() 用 from conan.tools.layout import basic_layout
                          （替代 meson_layout）；build() 中 meson.configure() 后调用
                          meson.build()（替代 meson.compile()）。conandata 增加 filename
                          字段确保 codeload 无扩展名 URL 正确解压（相关条目 E276/E483）。
rec_command:              python3 scripts/ohc-run.py conan-verify <name> <ver>  # G2 PASS 为验收
rec_auto_fix:             false
rec_impl:                 manual

fallback_priority:        2
fallback_approach:        toolchain-only
fallback_description:     若 build() 仍需逐命令控制，可用 MesonToolchain 生成 native 文件后
                          经 self.run(meson setup/build ...) 直跑（E373 提示走
                          conanbuild scope 的 ConanFile.run），但标准路径优先 build()。
fallback_command:
fallback_auto_fix:        false
fallback_impl:            manual

forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             E355, E296
conflicts_with:         []
prerequisite_of:        []

