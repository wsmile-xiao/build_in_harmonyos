#====================================================================
# E999 draft — 上游硬编码 /tmp 且不读 TMPDIR → OHOS 运行时 SIGABRT
# 实证来源: podiff 1.4 适配（2026-09-03, feat/podiff-1.4）
# 格式规则见 _template.kv
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E999
trigger_tool:           runtime|test|make
phase:                  runtime|testing
error_signature:        cannot create temporary: Read-only file system|mkstemp.*EROFS|Read-only file system.*mkstemp|Abort trap.*podiff

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, portability, libc
match_keywords:         /tmp, read-only, mkstemp, TMPDIR, 硬编码临时目录, SIGABRT, abort, tmpdir
title:                  上游工具硬编码 /tmp 临时目录且不读 TMPDIR 环境变量，OHOS /tmp 只读导致运行时崩溃

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: 上游 C 源码把临时目录硬编码为 "/tmp"（未遵循 GNU TMPDIR 环境变量惯例），
 OHOS /tmp 只读（EROFS，E002），mkstemp() 返回 -1 后错误路径直接 abort() 崩溃
affected_scope: 所有硬编码 /tmp 且不读 TMPDIR 的 C 程序（实证：podiff 1.4 main.c `char *tmpdir = "/tmp";`，比对模式必崩 rc=134）
verification_cmd: grep -n '"/tmp"' *.c（定位硬编码）; TMPDIR=$HOME/tmp ./tool a b; echo $?（适配前 134/SIGABRT，适配后正常 0/1）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description:        补丁让临时目录优先读 TMPDIR 环境变量（GNU 惯例），未设置时回落 /tmp 保持上游默认行为
rec_command:            patch: tmpdir = (env = getenv("TMPDIR")) && *env ? env : "/tmp";（见 archives/p/podiff/1.4/patches/0002-main.c.patch）
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      source-patch
fallback_description:   若改动入口不便，直接把默认常量 "/tmp" 改为可写路径（可移植性差，仅作兜底）
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       export TMPDIR=.*&&.*tool
forbid_1_reason:         程序不读 TMPDIR 时设置环境变量完全无效（podiff 实证：TMPDIR 已设置仍崩）
forbid_1_consequence:    误判"已修复"，CI/用户环境复崩

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              E002
similar_to:             E482, E325, E265
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E999.md
last_updated: 2026-09-03
source_event:           podiff 1.4 适配（feat/podiff-1.4，2026-09-03，比对模式 SIGABRT 实证）

