#====================================================================
# E740 — header-only 单头库的上游测试面是"自研单翻译单元 unittest 程序"
#        （无 ctest/无测试框架）：N 按 ifdef 感知的宏展开断言清点，
#        build() 复刻相对目录驱动上游 Makefile，rc/stderr 双判绿。
# 来源: crcpp 1.2.1.0（d-bahr/CRCpp release-1.2.1.0）适配任务
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E740
trigger_tool:           conan|make|clang
phase:                  testing
error_signature: "Invalid CRC:|CRC parameters:|Expected CRC:|Computed CRC:|声明 N 与实测 N 不符"

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               "testing|rule4-counting|header-only"
match_keywords: crcpp, CRC++, CRC.h, header-only, unittest, 自研测试程序, 宏展开断言, ifdef 感知清点, CRCPP_INCLUDE_ESOTERIC_CRC_DEFINITIONS, 候选数法, rule4, 上游测试清点, Makefile CXX 覆盖, static-libstdc++, PrintResult, returnCode, 失败才打印, 声明 N
error_excerpt: "上游测试无框架（单 main.cpp + 失败才向 stderr 打印 + returnCode=1），按源码宏数申报 N=62 而断言实测 242 → rule4 少报"
prescan_pattern: "CRC_TEST\\(|CRC_PARTIAL_BYTE_TEST\\(|Invalid CRC"
title: "header-only 库上游测试面为自研单翻译单元 unittest：build() 复刻相对目录驱动上游 Makefile（只覆盖 CXX/LINKER/LDFLAGS）+ ifdef 感知断言清点（宏×展开取候选数最大并归因）+ rc 与失败打印行双判绿"

# ═══ Layer 2: 根因层 (Root Cause) ═══
root_cause: |
  上游测试面既无 ctest/meson test 注册，也无测试框架（gtest/catch2/doctest），
  只有一个自研单翻译单元程序（crcpp: test/src/main.cpp），其形态是：
  ① 测试用例由宏（CRC_TEST / CRC_PARTIAL_BYTE_TEST）声明，每个宏在定义处
     展开成 4 条/2 条独立断言（逐位、逐位续算、查表、查表续算…）；
  ② 部分用例包在 #ifdef CRCPP_INCLUDE_ESOTERIC_CRC_DEFINITIONS 条件编译区，
     宏数与断言数随宏开关变化（62 宏 → 242 断言，关掉 esoteric 只剩 13 宏/52 断言）；
  ③ 程序只在断言失败时向 stderr 打印（"Invalid CRC: …"）并置 returnCode=1，
     全过时 stdout/stderr 皆空、rc=0——没有 "N tests passed" 类汇总行。
  若按"源码宏数"申报 N（rule4 的候选数法必须取最大口径并归因差额），
  实测断言数 242 > 声明 62，即被判少报硬 FAIL；反之若把 test_package 消费者
  断言混进上游分母，又违反四口径不混用。判绿若只看 rc=0 也会漏掉
  "程序没跑到断言就提前退出"的假绿（须同时核 stderr 无失败打印行）。

# ═══ Layer 3: 处置层 (Resolution) ═══
rec_priority:           1
rec_approach:           ifdef-aware-assertion-counting-plus-upstream-makefile-driver
rec_description: |
  1) N 清点用 ifdef 感知计数（候选数法取最大）：解析 #ifdef CRCPP_INCLUDE_ESOTERIC…
     区段，统计各用例宏调用点数 × 宏展开断言数（crcpp: (13+46)×4 + 3×2 = 242），
     差额逐项归因到条件编译区；宏数（62）作为次口径写进说明，不与断言口径混用。
  2) 上游测试进配方 build()：在 build 目录复刻上游相对结构（inc/、test/src/、
     test/prj/gcc/），直接驱动上游 Makefile（make -C test/prj/gcc），只覆盖
     CXX/LINKER 为设备 clang++（设备无 g++）并在 LDFLAGS 追加 -static-libstdc++
     （测试二进制无 LD_LIBRARY_PATH 也能跑）；测试源与宏定义保持上游原样。
  3) 判绿双条件：unittest rc==0 **且** stderr 无 "Invalid CRC" 行——失败才打印的
     程序必须用"失败打印行计数"交叉，单看 rc 会漏掉提前退出的假绿。
  4) 消费者 test_package 独立计数（鸿蒙特有测试行 ≥1），断言交付头自报版本宏
     （CRCPP_MAJOR/MINOR/PATCH/REVISION）+ 计算值，证明打包的就是被测那一份头。
rec_command: "cd $HOME/ws/worktrees/crcpp-1.2.1.0 && conan create archives/c/crcpp/1.2.1.0 -pr:h=$HOME/ws/worktrees/crcpp-1.2.1.0/ci/conan/profiles/ohos-aarch64 -pr:b=$HOME/ws/worktrees/crcpp-1.2.1.0/ci/conan/profiles/ohos-aarch64 --build=missing"
rec_auto_fix:           false
