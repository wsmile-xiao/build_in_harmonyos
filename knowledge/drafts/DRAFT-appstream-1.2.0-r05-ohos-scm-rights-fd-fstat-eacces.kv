#====================================================================
# DRAFT-appstream-1.2.0-r05-ohos-scm-rights-fd-fstat-eacces.kv
# OHOS 对通过 SCM_RIGHTS 跨进程传递的 fd 拒绝 fstat()（EACCES 13），
# 但 fcntl(F_GETFL/F_GET_SEALS)、lseek()、mmap() 可用 —— 改用这些
# API 面做 fd 校验/取尺寸，替代 fstat 路径
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R05）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           compose worker IPC (SCM_RIGHTS) / GLib g_mapped_file
phase:                  runtime-ipc
error_signature:        Unable to stat received fd: Permission denied|
                        Failed to get attributes of file .fd.: fstat\(\) failed: Permission denied|
                        fstat.*errno=13|fstat.*EACCES.*SCM_RIGHTS
severity:               2
category:               ipc, fd, SCM_RIGHTS, fstat, EACCES, portability, glib
match_keywords:         SCM_RIGHTS, fstat, EACCES, Permission denied, memfd,
                        g_mapped_file_new_from_fd, F_GETFL, F_GET_SEALS, lseek,
                        fd passing, OHOS, unix socket, worker
title:                  OHOS 拒绝跨进程 SCM_RIGHTS fd 的 fstat → fcntl/lseek/mmap 替代
root_cause:             OHOS（HMDFS/安全策略）对 SCM_RIGHTS 跨进程收到的 fd 拒绝
                        fstat()（EACCES），但同 fd 的 fcntl(F_GETFL)/F_GET_SEALS、
                        lseek()、mmap() 均被允许（最小 C 复现确认）。
affected_scope:         通过 Unix socket SCM_RIGHTS 传 fd 给子进程处理的服务；
                        在接收侧用 fstat 校验类型/取尺寸的库。
verification_cmd:       最小复现: socketpair+SCM_RIGHTS+fstat 得 EACCES，
                        F_GETFL/lseek/mmap 正常；conan create appstream 1.2.0 -
                        pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing 后
                        as-test_compose/as-test_compose-worker 通过。
rec_priority:           1
rec_approach:           scm-rights-fd-stat-alternatives
rec_description:        memfd 校验改用 fcntl(F_GET_SEALS) 为主、尺寸用 lseek；
                        输出/只读 fd 校验改用 fcntl(F_GETFL) 访问模式；
                        g_mapped_file_new_from_fd 内部 fstat 失败时直接
                        lseek+mmap 映射数据。
rec_command:            |
  /* asw_memfd_verify_sealed: fstat 失败(EACCES)时 F_GET_SEALS+ lseek 取尺寸 */
  if (fstat (fd, &st) != 0 && errno != EACCES) { /* 真错误 */ }
  seals = fcntl (fd, F_GET_SEALS);            /* 安全门仍有效 */
  if (fstat 被拒) size = lseek (fd, 0, SEEK_END);
  /* asw_font_new_from_fd: 改 lseek + mmap 直映（见 0015 补丁） */
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       ignore.*fstat.*error
forbid_1_reason:        不得简单忽略 fstat 错误或伪造 st_mode，须换 API 面校验
principles:             R6
causes:                 []
caused_by:              []
similar_to:             E008
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-r05-ohos-scm-rights-fd-fstat-eacces.md
last_updated:           2026-09-25
