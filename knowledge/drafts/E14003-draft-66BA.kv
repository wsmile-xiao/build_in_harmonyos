#====================================================================
# E14003-draft-66BA.kv — OHOS 无 /var 目录：FHS 硬编码运行时路径需可写回落
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E14003
trigger_tool:           runtime
phase:                  runtime
error_signature:        Cannot create the lockfile /var/lock/.*|/var/lock.*No such file or directory|/var/run.*No such file or directory|/var/spool.*No such file or directory

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, limitation, portability, filesystem
match_keywords:         /var/lock, /var/run, /var/spool, FHS, lockfile, lock file, pidfile, runtime directory, XDG_RUNTIME_DIR, TMPDIR, No such file or directory, startup failure
title:                  OHOS 根文件系统没有 /var：硬编码 FHS 路径（/var/lock 等）的锁文件/pid 文件需回落到可写运行目录

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OpenHarmony 根文件系统**没有 /var 目录**（/var/lock、/var/run、
                        /var/spool 一并缺失，`ls -d /var` 直接报 No such file or directory；
                        /tmp 存在但属 root 且不可写）。沿用 FHS 硬编码路径创建锁文件/pid 文件
                        的程序在启动阶段即 fopen/open 失败并 exit(1)，表现为“程序装好了却
                        起不来”。仅编译期看不出问题，属纯运行期平台差异。
affected_scope:         启动/运行期在 /var/... 下创建锁文件、pid 文件、unix socket 的程序
                        （终端类应用、守护进程、邮件/打印等系统服务）；同类问题也适用于
                        其它 FHS 固定路径（/etc 只读、/usr/var 等）。
verification_cmd:       ls -d /var ; ls -d /var/lock ; touch /var/lock/probe → 全部报 No such file or directory

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           runtime-dir-fallback
rec_description:        把固定路径改为“候选目录列表 + 首个可写者”策略：按
                        $<APP>_LOCKDIR（显式覆盖）→ 历史 FHS 路径（/var/lock）→
                        $XDG_RUNTIME_DIR → $TMPDIR 顺序用 access(dir, W_OK) 探测，
                        取第一个可写目录。两个实施要点：
                        (1) access(W_OK) 之外还要校验拼接后的完整路径能放进缓冲——
                            snprintf 返回 >= size 表示截断，必须跳过该候选，
                            否则会静默生成**名字错误**的锁文件（实测 char[64] 会把长
                            $TMPDIR 路径截断成 “LinPa”，导致单实例保护失效）；
                        (2) 同时把调用方的缓冲扩大（本例全局 char keyfile[64] → 256），
                            否则长路径必然被拒绝回落到不可写的 /var/lock。
rec_command:            static const char *dirs[] = {getenv("APP_LOCKDIR"), "/var/lock", getenv("XDG_RUNTIME_DIR"), getenv("TMPDIR")}; /* 取首个 access(W_OK) 且 snprintf 未截断者 */
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      env-override-only
fallback_description:   若不便改代码，可在启动脚本/包运行环境中把 $TMPDIR 或
                        $XDG_RUNTIME_DIR 指向可写目录，并让程序本身支持该变量；
                        但多数老程序把路径写死，仍需源码改动，故仅作补充。
fallback_command:       export TMPDIR=$HOME/tmp; export XDG_RUNTIME_DIR=$HOME/tmp
fallback_auto_fix:      false
fallback_impl:          env-vars

forbid_1_pattern:       mkdir\s+-p\s+/var|install.*-d\s+/var
forbid_1_reason:        根文件系统只读/无权限，且伪造系统目录不属于库适配范围
forbid_1_consequence:   打包或安装阶段失败；即使创建成功也污染系统目录

# ═══ Layer 4: 原则引用 ═══
