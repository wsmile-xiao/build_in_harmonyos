#====================================================================
# Draft knowledge entry - libconfigini 22d700ab76 Makefile top-level
# toolchain-variable hardcode (`CC = gcc`, literal `ar rcs`) fails under
# Conan toolchain env on OHOS; relax to `?=` / `$(AR)`.
# Source package: libconfigini/22d700ab76
#====================================================================

id:                     DRAFT-makefile-toolchain-vars-equals-hardcode
trigger_tool:           make|conan|ar
phase:                  compilation|package
error_signature:        make: gcc: No such file or directory|
                         CC = gcc.*toolchain|
                         ar rcs.*invalid option|
                         conan create.*toolchain env.*not honored|
                         make.*uses.*gcc.*instead.*of.*clang

severity:               2
category:               build-system|make|toolchain|conan
match_keywords:         Makefile, CC = gcc, CFLAGS =, hardcoded compiler, hardcoded archiver,
                         literal ar rcs, $(CC), $(AR), ?=, toolchain env, R33,
                         conanbuild env, clang-only, OHOS, no configure, raw Makefile,
                         variable assignment, llvm-ar, CMakeToolchain env injection

title:                  Raw-Makefile top-level `CC = gcc` (hard `=` assignment) and a literal
                        `ar rcs` archive step override the Conan toolchain env on OHOS —
                        patch `=` to `?=` and `ar rcs` to `$(AR) rcs` (R33)

root_cause:             >
    Some raw-Makefile projects declare the compiler at the TOP LEVEL with a hard
    `=` assignment:

        CC = gcc
        CFLAGS = -g -Wall
        ...
        $(LIBARCH): $(OBJS)
            ar rcs $(LIBARCH) $(OBJS)

    Unlike `?=` (only-set-if-unset), a plain `=` always overrides the
    environment. Conan's AutotoolsToolchain/CMakeToolchain inject CC/CFLAGS/AR
    (clang / llvm-ar on OHOS) through the generated `conanbuild` env, but the
    Makefile's `=` assignment wins over env, so the build still calls gcc and
    the literal `ar`, both of which do not exist in the OHOS clang-only
    toolchain. Command-line `make CC=clang` would work interactively, but that
    violates R33 (compilers must come from the Conan toolchain, not hand-written
    shell vars) and is not reproducible inside `conan create`.

affected_scope:         Any raw-Makefile (no configure/CMake) C/C++ project whose top-level
                        Makefile hard-assigns `CC =`/`CFLAGS =` and calls the archiver
                        literally (`ar rcs ...`) instead of `$(AR)`, adapted to
                        clang-only toolchains (OHOS PC).

verification_cmd:       |
  cd <worktree> && make -j1 all && make -j1 test

rec_priority:           1
rec_approach:           patch-makefile-toolchain-vars
rec_description: >
    Patch the Makefile: change top-level hard assignments to conditional
    assignments (`CC = gcc` -> `CC ?= gcc`, `CFLAGS = ...` -> `CFLAGS ?= ...`)
    and change the literal archive command to `$(AR) rcs ...`. Then let the
    Conan recipe run `make` with env="conanbuild" (AutotoolsToolchain generate),
    so CC/CFLAGS/AR from the toolchain are honored (R33). Use `make -j1`
    (HMDFS/SELinux workers deny jobserver mkfifo). Upstream Makefile may use
    CRLF line endings: keep the generated patch LF-only with correct hunk
    counts so conan's patch_ng parses it.
rec_command:            |
  make -j1 all
rec_auto_fix:           true
rec_impl:               patch-makefile

fallback_priority:      2
fallback_approach:      make-cmdline-cc-override (cohomcalg draft) — works when the
                        Makefile already uses `?=`/variable; NOT sufficient when `=`
                        hard-assignment or literal `ar` is present (R33 violation)

# Relations
similar_to:             DRAFT-cnrbtree-0.3-makefile-recipe-gcc-hardcode, DRAFT-cohomcalg-0.32-makefile-gxx-override, E012
caused_by:              ""
prerequisite_of:        ""
conflicts_with:         ""

