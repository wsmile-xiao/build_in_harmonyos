#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E552.kv，填写各字段
# 对应的人类文档: doc/E552.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E552
trigger_tool:           configure|cmake|meson|make|gcc|clang|ld|python|pip|install|test|runtime
phase:                  configuration|compilation|linking|installation|testing|runtime
error_signature: Dependency "gobject-introspection-1.0" not found|Program .*g-ir-scanner.*not found|generate_gir.*requires.*gobject-introspection

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: meson, introspection, gir, ohos, portability
match_keywords:         keyword1, keyword2, keyword3
title: meson GIR (generate_gir) 选项化以适配无 gobject-introspection 工具链的 OHOS 目标

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS 目标侧无 gobject-introspection 工具链（g-ir-scanner/g-ir-compiler 不可执行，pygobject 无法 dlopen glib 共享库——HMDFS exec 限制）；上游 meson.build 无条件调用 gnome.generate_gir 导致 configure 硬失败
affected_scope: 所有用 meson 构建、依赖 gobject-introspection 生成 GIR/typelib 的 GObject 家族库（GLib 系/GNOME 系）
verification_cmd: conan create archives/l/libhitaki/0.2.1 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: meson-optionize-generate-gir
rec_description: 给上游 meson 打最小补丁：meson_options.txt 新增 introspection 布尔选项（默认 true 保持上游行为），src/meson.build 的 gnome.generate_gir 以 get_option("introspection") 包裹；配方 MesonToolchain 传 -D introspection=false。库本体/头文件/pkg-config 正常交付；无 GIR typelib 不影响 C API 类型注册（鸿蒙专项测试回归验证）
rec_command: (conanfile generate()) tc.project_options["introspection"] = "false"; 详见 archives/l/libhitaki/0.2.1/patches/0001-meson_options.txt.patch + 0002-src-meson.build.patch
rec_auto_fix:           false
rec_impl:               conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by: E090
similar_to: E179, E348
conflicts_with:         []
prerequisite_of:        []

