#====================================================================
# DRAFT-lcdproc-0.5.9-fno-common-tentative-def-in-header
#   头文件里的 tentative definition + clang>=11 默认 -fno-common
#   -> ld.lld: error: duplicate symbol: <sym>
# 来源: PR feat(lcdproc): 0.5.9 适配 HarmonyOS PC（分支 feat/lcdproc-0.5.9）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# 辨别性指纹：duplicate symbol 的定义点落在**头文件**被 include 的位置，
# 且报错方是 ld.lld（OHOS 工具链用 lld，宿主 gcc 默认 bfd 常常静默通过）。
id:                     DRAFT-lcdproc-0.5.9-fno-common-tentative-def-in-header
trigger_tool:           clang|ld.lld|make
phase:                  link
error_signature:        duplicate symbol:\s*\S+|ld\.lld.*duplicate symbol|
                         multiple definition of ['`]\w+['`]

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               compilation, link, clang, coding-style
match_keywords:         duplicate symbol, multiple definition, ld.lld,
                        -fno-common, -fcommon, tentative definition,
                        头文件里的定义, extern, common symbol, .bss,
                        clang 11, clang 15, C89 老代码, 1990s C 代码
title:                  -fno-common 重复符号：头文件里的 tentative definition 被多个 TU include，clang>=11 默认 -fno-common 后各生成强 .bss 定义
prescan_pattern:        ^\s*[A-Za-z_][A-Za-z0-9_ ]*\s+\**[A-Za-z_][A-Za-z0-9_]*\s*\[[^]]*\]\s*;|extern\s+.*\[.*\]\s*;
prescan_globs:          *.h, **/*.h

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             C89/C90 时代的"tentative definition"（暂定定义）：
                        在**头文件**里写一个无 initializer 的带数组/结构体
                        声明，它在 C89 下是"一个定义"而不是"一个声明"，
                        于是每个 include 它的 .c 文件都会生成一份定义。
                        GCC 老版本默认 -fcommon，把跨 TU 的这些定义合并成一个
                        COMMON 符号（同 size 同 type 时静默合并），所以**能编过**。
                        clang >= 11 默认改成 -fno-common（跟随上游 GCC 10+），
                        每个 TU 各自生成一个**强 .bss 定义**，链接期撞车：

                            ld.lld-15: error: duplicate symbol: iface
                            >>> defined at main.c
                            >>> main.o:(iface)
                            >>> defined at iface.c
                            >>> iface.o:(.bss+0x0)

                        报错文本里的 "defined at main.c" 有误导性——它指的是
                        **main.c 展开 include 的 iface.h 那一行**，不是 main.c
                        自己写的定义。定位时要去头文件里找。

                        关键陷阱：同样的代码在宿主 gcc + bfd 上**可能照编不误**
                        （宿主 gcc 版本旧、用 -fcommon），所以"在 Linux 上
                        能编过"不能作为"代码没问题"的证据——必须用目标工具链
                        （clang + ld.lld）编一遍。
affected_scope:         任何 1990s-2010s 的 C 代码 + clang>=11 工具链。
                        在 HarmonyOS PC 上是**默认命中**（NDK 就是 clang 15 + lld），
                        宿主 gcc 上则可能潜伏多年不暴露。
verification_cmd:       # 1) 找出全树的头文件 tentative definition（无 extern、有数组/结构体、无 = initializer）
                        grep -rnE '^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]*]*[[:space:]]+[A-Za-z_][A-Za-z0-9_]*\[[^]]*\][[:space:]]*;' \
                          --include='*.h' . | grep -v 'extern'
                        # 2) 确认被几个 TU include
                        grep -rl '#include "iface.h"\|#include <iface.h>' . | wc -l
                        # 3) 目标工具链实测（宿主 gcc 不可信）
                        clang --target=aarch64-linux-ohos -c a.c -o a.o   # 看是否报 -fno-common 冲突

# ═══ Layer 3: 方案层 (Solution) ═══
rec_priority:           1
rec_approach:           extern-plus-single-definition
rec_description:        正解是把它拆成"头文件 extern 声明 + 一个 .c 里的唯一定义"，
                        这也是 C89 之后的标准写法：

                          /* iface.h */
                        - IfaceInfo iface[MAX_INTERFACES];   /* tentative def */
                        + extern IfaceInfo iface[MAX_INTERFACES];

                          /* iface.c —— 挑一个"拥有"该对象的 .c，通常写接口实现的那个 */
                        + /** Shared interface table: defined here, declared (extern)
                        +  *  in iface.h so every including TU links to this one copy. */
                        + IfaceInfo iface[MAX_INTERFACES];

                        lcdproc 0.5.9 实例：
                          clients/lcdproc/iface.h  的 IfaceInfo iface[MAX_INTERFACES];
                          被 clients/lcdproc/main.c 与 clients/lcdproc/iface.c 同时 include
                          -> 改为 iface.h 的 extern + iface.c 的唯一定义
                        已核实这是**全树唯一**的头文件 tentative definition。
rec_command:            |
  # 1) 头文件：无 initializer 的数组/结构体定义 -> 加 extern
  #    例： sed -i 's/^IfaceInfo iface\[/extern IfaceInfo iface[/' clients/lcdproc/iface.h
  # 2) .c：补唯一定义（放在"拥有"该对象的实现文件里）
  #    例： 在 clients/lcdproc/iface.c 的 include 段之后插入
  #        IfaceInfo iface[MAX_INTERFACES];
  # 3) 目标工具链重编，确认 duplicate symbol 消失
  make -j1
rec_auto_fix:           false
rec_impl:               manual-patch

fallback_priority:      2
fallback_approach:      add-fcommon-flag
fallback_description:   加 -fcommon 编译开关恢复 GCC 老行为。
                        代价：用旗标掩盖根因，且**掩盖而非修复**——后续任何人
                        再往头文件里写 tentative definition 都不会再暴露。
                        只在本树唯一一处问题、且改不动上游源码时用。
fallback_command:       |
  # conan 配方里：
  tc.cflags.append("-fcommon")
  # 或 CMake： target_compile_options(<tgt> PRIVATE -fcommon)
fallback_auto_fix:      false
fallback_impl:          compiler-flag

fallback_2_priority:    3
fallback_2_approach:    make-symbol-static
fallback_2_description:  若该对象其实不需要跨 TU 共享，直接在头文件里写
                        `static`（内部链接），每个 TU 一份副本，天然不冲突。
                        前提是该对象无跨 TU 的可变状态共享需求——**先确认**，
                        否则会引入更难查的"每个副本状态不同步"问题。
fallback_2_auto_fix:   false
fallback_2_impl:       none

# ═══ Layer 4: 原则引用 ═══
principles:             P001, P003, P011

# ═══ 关系图 ═══
causes:
