#====================================================================
# DRAFT-musl-linkable-stub-ac-check-funcs-cache-override.kv
# musl 把 mallinfo/mallinfo2 作可链接兼容桩但不定义 struct,
# autoconf 链接级 AC_CHECK_FUNCS 误判 HAVE_MALLINFO,须缓存覆盖
# 触发事件: i686-elf-binutils 2.46.1 HarmonyOS PC 适配 (round 5)
#====================================================================

id:                     DRAFT (proposed E###)
trigger_tool:           configure|make|clang|ld
phase:                  configuration|compilation
error_signature:        incomplete type.*mallinfo|struct mallinfo.*not defined|
                         error: variable has incomplete type .struct mallinfo.|
                         checking for mallinfo.*cached. no|HAVE_MALLINFO

severity:               2
category:               detection|libc|musl|autotools|build-system
match_keywords:         mallinfo, mallinfo2, AC_CHECK_FUNCS, HAVE_MALLINFO,
                         linkable stub, struct mallinfo, incomplete type,
                         ldmain.c, ac_cv_func_mallinfo, cache override, musl,
                         malloc statistics, optional feature
title:                  musl 提供可链接的 mallinfo 桩但无 struct,AC_CHECK_FUNCS 链接级误判,须 ac_cv_func_mallinfo=no 缓存覆盖让 ld 跳过可选 malloc 统计

root_cause: >
  musl 对 glibc 专属 malloc 统计 API (mallinfo/mallinfo2) 提供可链接兼容桩,但不
  在 <malloc.h> 定义 struct mallinfo/struct mallinfo2。autoconf 链接级 AC_CHECK_FUNCS
  探测通过 → HAVE_MALLINFO(_2)=1 → ld 的 ldmain.c 在 incomplete type 上编译失败。
  该 API 在 musl 上实际不可用,以 ac_cv_func_mallinfo=no / ac_cv_func_mallinfo2=no
  缓存覆盖使 ld 跳过可选 malloc 统计 (功能降级)。

affected_scope: >
  GNU 工具链族 (binutils/gdb) 及其他引用 malloc 统计 API 的 autotools 项目在
  musl/OHOS 上的适配。i686-elf-binutils、x86_64-elf-binutils、riscv64-elf-gdb
  三库同款修复;与 E320 (fmemopen 运行时语义)/E302/E230 同族但机制不同。

verification_cmd: >
  grep -e "checking for mallinfo" -e "checking for mallinfo2" configure.log
  # 应输出 "(cached) no"
  grep -n "ac_cv_func_mallinfo" archives/*/*/*/conanfile.py

rec_priority:           1
rec_approach:           env-ac-cache-override-absent-func
rec_description: >
  build() 设 os.environ["ac_cv_func_mallinfo"]="no" 与
  os.environ["ac_cv_func_mallinfo2"]="no",令 autoconf 对 musl 上仅有链接桩、
  无类型定义的可选 API 判为缺失,源码按可选功能降级编译。
rec_command:            os.environ["ac_cv_func_mallinfo"] = "no"; os.environ["ac_cv_func_mallinfo2"] = "no"
rec_auto_fix:           false
rec_impl:               conan-recipe-environment

fallback_priority:      2
fallback_approach:      source-patch-struct-and-stub
fallback_description:   确需 mallinfo 语义时,在源码侧提供 struct 定义或私有回退实现;
                        对 binutils/gdb 这类可选统计,缓存覆盖 (降级) 更符合上游意图。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       "#ifdef __OHOS__|defined\\(__OHOS__\\)|is_ohos\\(\\)|#define HAVE_MALLINFO"
forbid_1_reason:        musl 无该 struct 是 libc 特性差异,不是 OHOS 平台宏;平台宏硬编码
                        (R8) 无法覆盖 musl 或其他无 mallinfo struct 的 libc。
forbid_1_consequence:   PR 审查被拒 (R8 违规);同类 libc 上仍会复发。
forbid_2_pattern:       AC_CHECK_FUNCS.*mallinfo
forbid_2_reason:        链接级探测无法发现"符号存在但类型缺失",保留链接级探测会重复
                        误判 HAVE_MALLINFO。
forbid_2_consequence:   HAVE_MALLINFO 误判 → incomplete type 编译失败反复出现。

principles:             P013, P007

causes:                 []
caused_by:              []
similar_to:             [E320, E302, E230]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-musl-linkable-stub-ac-check-funcs-cache-override.md
last_updated:           2026-08-23
source_event:           i686-elf-binutils 2.46.1 适配 (round 5): configure full.log
                        L2787/L2790 "checking for mallinfo... (cached) no" 生效,
                        ldmain.c 无 incomplete type 错误;x86_64-elf-binutils 2.46.1
                        与 riscv64-elf-gdb 17.2 同款修复 (注释逐字一致)

authors:                atomcode-executor
source_pr:
source_commit:

metrics_success_count:  3
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-08-23
