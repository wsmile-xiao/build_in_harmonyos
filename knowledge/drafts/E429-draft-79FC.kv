# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E429
trigger_tool: conan
phase: build/test_package
error_signature: Permission denied|configure: Permission denied|exit 126|Error loading shared library|EACCES execve

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: high
category: platform
match_keywords: hmdfs,selinux,adhoc_bin,conan,execve,permission denied,shared library
title: HMDFS 上执行的 ELF 降级到 SELinux adhoc_bin 域后无法 execve/加载 HMDFS 文件

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 在 HarmonyOS PC 上，凡是从 HMDFS（/storage/Users/...）执行的可执行文件（如 pip 装在 ~/usr/local/bin 的 conan、python3 包装脚本背后的 ad-hoc ELF）都会触发域转换到受限 SELinux 域 u:r:adhoc_bin:s0；该域被策略禁止 execve HMDFS 上的任何文件（包括本进程刚创建并 chmod 755 的脚本），也无法从 HMDFS 加载 .so。症状极易误判为文件权限位问题：stat 显示 0o770/0o755、os.access(X_OK)=true、shell 侧（u:r:develop_tools_hap:s0 域）执行同一文件却成功，且 HMDFS 忽略 chmod（E046）进一步误导排查方向。实测：bash/python3(受信任)域 develop_tools_hap 可执行；conan/用户目录 python3 进程域 adhoc_bin 对 configure 直接 execve、sh -c、conanbuild.sh 环境、自建 0o755 脚本全部 EACCES；Conan 缓存迁到 appdat(el2 cache) 也无效
affected_scope: 所有在 HarmonyOS PC 上通过 HMDFS 路径下的解释器/工具启动构建的流程：conan create 的 build()/test() 子进程、autotools configure/make、test_package 运行期加载依赖 .so；同样影响 /proc/net/dev 等敏感 procfs 的读取（EACCES）
verification_cmd: cat /proc/self/attr/current; ~/usr/local/bin/python3 -c "print(open('/proc/self/attr/current').read().strip())"; /data/storage/el1/bundle/libs/arm64/python/bin/python3 -c "print(open('/proc/self/attr/current').read().strip())"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: trusted-python-shim
rec_description: 用受信任 bundle python 建 shim 统一入口替代 ~/usr/local/bin/conan；ohc-run.py 同理需要 python3 shim。进程保持在 u:r:develop_tools_hap:s0 域，execve HMDFS 脚本与加载 HMDFS .so 恢复正常。完整 test_package（需加载 HMDFS 上的依赖 .so）还需把 CONAN_HOME 指向非 HMDFS 目录（如 /data/storage/el2/base/cache/conan-home）
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: none
rec_impl: mkdir -p ~/.shimfix; printf '%s\n' '#!/bin/sh' "exec /data/storage/el1/bundle/libs/arm64/python/bin/python3 -c 'import sys; from conans.conan import run; sys.exit(run())' \"\\"" > ~/.shimfix/conan; chmod 755 ~/.shimfix/conan; export PATH=~/.shimfix:$PATH; export CONAN_HOME=/data/storage/el2/base/cache/conan-home

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
