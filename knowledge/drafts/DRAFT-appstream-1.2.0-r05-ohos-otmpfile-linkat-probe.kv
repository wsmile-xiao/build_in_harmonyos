#====================================================================
# DRAFT-appstream-1.2.0-r05-ohos-otmpfile-linkat-probe.kv
# OHOS 允许 O_TMPFILE 打开但不允许 linkat(/proc/self/fd) 发布（EACCES 13）；
# 配方/库内探针实测 O_TMPFILE+linkat，失败即回退命名临时文件 + renameat
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R05）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           asc-media out-slot (O_TMPFILE rendition commit)
phase:                  runtime-filesystem
error_signature:        Unable to store the rendition.*Permission denied|
                        linkat.*Permission denied|O_TMPFILE.*EACCES.*linkat|
                        /proc/self/fd.*EACCES
severity:               2
category:               filesystem, O_TMPFILE, linkat, /proc, EACCES, portability
match_keywords:         O_TMPFILE, linkat, /proc/self/fd, EACCES, renameat,
                        unnamed inode, AT_SYMLINK_FOLLOW, temp file, OHOS
title:                  O_TMPFILE 打开成功但 linkat(/proc/self/fd) 发布被禁 → 探测回退命名文件+renameat
root_cause:             OHOS 挂载 /proc，但 seccomp/权限层面拒绝 linkat 经
                        /proc/self/fd 发布 O_TMPFILE 匿名 inode（EACCES 13）；
                        O_TMPFILE open 本身可用，命名临时文件 + renameat 可用。
affected_scope:         用 O_TMPFILE 写临时产物、再经 /proc/self/fd linkat 发布的服务。
verification_cmd:       conan create appstream 1.2.0 -pr:h=ohos-aarch64 -pr:b=ohos-aarch64
                        --build=missing；as-test_compose MediaImage 渲染落盘通过。
rec_priority:           1
rec_approach:           otmpfile-linkat-probe-fallback
rec_description:        能力探针在受信目录实测 openat2(O_TMPFILE)+linkat(/proc/self/fd/N)；
                        失败即回退"命名隐藏临时文件 + renameat"路径（先建临时名再原子改名）。
rec_command:            |
  probe_fd = openat (AT_FDCWD, ".", O_TMPFILE|O_WRONLY|O_CLOEXEC, 0644);
  if (probe_fd >= 0) {
      if (linkat (AT_FDCWD, "/proc/self/fd/N", AT_FDCWD, ".asc-tmp-xxx",
                  AT_SYMLINK_FOLLOW) != 0) found = FALSE;  /* 回退命名文件 */
      unlinkat (AT_FDCWD, ".asc-tmp-xxx", 0);
      close (probe_fd);
  }
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       ignore.*linkat.*error
forbid_1_reason:        linkat 失败必须真实回退，否则产物丢失
principles:             R6
causes:                 []
caused_by:              []
similar_to:             DRAFT-ohos-otmpfile-tmpdir-shim
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-r05-ohos-otmpfile-linkat-probe.md
last_updated:           2026-09-25
source_event:           appstream-1.2.0 R05（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9