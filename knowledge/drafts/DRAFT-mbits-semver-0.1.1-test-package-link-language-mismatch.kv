#====================================================================
# DRAFT-mbits-semver-0.1.1-test-package-link-language-mismatch
#   test_package 源文件扩展名与工程语言声明不一致 → CMake 无法判定
#   链接语言（Cannot determine link language）
# 来源: mbits-semver 0.1.1 适配（task mbits-semver-0.1.1-r01-pc4-36）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-mbits-semver-0.1.1-test-package-link-language-mismatch
trigger_tool:           cmake
phase:                  linking|configuration
error_signature:        Cannot determine link language for target|
                         CMake can not determine linker language for target

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               cmake, linking, test-package, recipe, cxx, ohos,
                        conan, language-declaration
match_keywords:         Cannot determine link language, 链接语言, test_package,
                        CXX-only, project CXX, 扩展名, .c 与 .cpp, CMakeLists,
                        语言声明, linker language, C 源, C++ 工程, test_package
                        源文件, 重命名, target_link_languages
title:                  test_package 工程声明 CXX-only（project(... CXX)）但测试源文件命名 .c：CMake 按扩展名把源当 C 语言却无 C 语言可用 → Cannot determine link language；将源文件重命名为 .cpp（或声明 C 语言）即可
prescan_pattern:        project\s*\([^)]*CXX\)|add_executable\([^)]*\.c\)
prescan_globs:          test_package/CMakeLists.txt, test_package/*.c,
                        test_package/*.cc, test_package/*.cpp

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             CMake 依据源文件扩展名推断其语言（.c=C、.cpp/.cc=C++）。
                        test_package 的 CMakeLists 若声明 project(... CXX)
                        （CXX-only，未启用 C 语言），而 add_executable 的源文件
                        扩展名为 .c，则 CMake 无法为该目标确定链接语言：
                        "Cannot determine link language for target"。
                        常见于"内容实际是 C++ 但文件命名为 .c"或"工程语言声明
                        与源文件语言不一致"的配方编写错误。conan create 在
                        test_package 配置阶段即失败，早于任何编译。
affected_scope:         CMake 驱动的 test_package（及一般 CMake 目标）。实证：
                        mbits-semver 0.1.1（test_package/test.c 内容为 C++，
                        工程 CXX-only → Cannot determine link language）。
verification_cmd:       重命名为 .cpp 后 conan create 配置通过（G2 PASS），
                        test_package ctest 通过

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           rename-source-to-match-declared-language
rec_description:        核对 test_package 源文件实际语言与 CMakeLists 语言声明；
                        内容为 C++ 时把 .c 源重命名为 .cpp（同步更新
                        CMakeLists/MANIFEST 引用），或为工程声明启用对应语言
rec_command:            conan create ${RECIPE} -pr:h=${OHOS_PROFILE} -pr:b=${OHOS_PROFILE} --build=missing --user=ohpcd --channel=stable
rec_auto_fix:           false
rec_impl:               cmake-source-rename

fallback_priority:      2
fallback_approach:      declare-language-in-project
fallback_description:   必须保留 .c 扩展名时，在 project(...) 中显式声明 C 语言
                        （如 project(... C CXX)），使 CMake 具备该语言链接规则
fallback_command:
fallback_auto_fix:      false
fallback_impl:          cmake-project-language

forbid_1_pattern:       skip.*test_package|空壳|print.*OK.*only|pass-only
forbid_1_reason:        修复语言判定后 test_package 必须真实编译链接运行被测包
                        （R34），禁止退回空壳测试

# ═══ Layer 4: 知识层 (Knowledge) ═══
similar_to:             E353
caused_by:
prerequisite_of:
conflicts_with:
example:                mbits-semver 0.1.1：test_package/test.c（C++ 内容）→
                        重命名 test.cpp → conan create G2 PASS，ctest 2/2 Passed
