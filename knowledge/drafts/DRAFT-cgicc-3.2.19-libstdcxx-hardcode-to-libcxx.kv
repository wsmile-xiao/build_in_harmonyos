#====================================================================
# DRAFT-cgicc-3.2.19-libstdcxx-hardcode-to-libcxx.kv
# 主题: 上游 autotools Makefile 硬编码 -lstdc++，OHOS 工具链仅 libc++ → 链接失败
# 来源: cgicc 3.2.19 首轮本地适配（conan create / make 链接阶段）
# 状态: draft（路径 B，跨库可复用候选）
#====================================================================

id:                     DRAFT-cgicc-3.2.19-libstdcxx-hardcode-to-libcxx
trigger_tool:           make|libtool|conan|ld
phase:                  linking
error_signature:        unable to find library -lstdc\+\+|ld\.lld: error: unable to find library.*stdc\+\+|libstdc\+\+.*Makefile.*LDFLAGS

severity:               2
category:               ohos, toolchain, linking, autotools
match_keywords:         libstdc++, libc++, lld, unable to find library, Makefile.am,
                         LDFLAGS, autotools, OHOS, clang, link error

root_cause:             OHOS 工具链（clang 15 + lld + libc++）不提供 libstdc++；
                         上游 autotools C++ 项目的 Makefile.am/Makefile.in 在 lib*_la_LDFLAGS
                         硬编码 -lstdc++ 时，libtool 链接阶段 ld.lld 报 unable to find library -lstdc++。
                         与 E455（Conan profile 注入 -stdlib=libstdc++）机制不同，此为上游构建文件硬编码。

affected_scope:         所有硬编码 -lstdc++ 的 autotools C++ 库/程序（HarmonyOS PC aarch64 目标）

verification_cmd:       grep -n 'lstdc++' <src>/Makefile.am <src>/Makefile.in;
                         make -j1  # 复现 ld.lld: unable to find library -lstdc++

rec_priority:           1
rec_approach:           patch-makefile-LDFLAGS-stdcxx-to-cxx
rec_description:        将 Makefile.am（源头）与 Makefile.in（tarball 模板）中 -lstdc++ 改为 -lc++，
                         若已 configure 则用 ./config.status cgicc/Makefile 重新生成 Makefile（不手改生成文件）。
rec_command:            sed 's/-lstdc++/-lc++/' cgicc/Makefile.am cgicc/Makefile.in
                         && ./config.status cgicc/Makefile && make -j1

fallback_priority:      2
fallback_approach:      none-required

forbid_1_pattern:       仅修改生成的 Makefile
forbid_1_reason:        干净构建重跑 configure 后会回归；必须改 .am + .in 源头

ref_entries:            E191 (reverse: unable to find library -lc++), E455 (profile-level -stdlib=libstdc++)
cross_library_value:    true
applicable_boundary:    OHOS clang+lld+libc++；若错误为 -stdlib=libstdc++ 属 E455（改 profile 非补丁）