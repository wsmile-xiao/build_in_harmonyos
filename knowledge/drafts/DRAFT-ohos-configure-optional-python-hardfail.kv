#====================================================================
# DRAFT-ohos-configure-optional-python-hardfail — autotools configure
#   对可选 python 模块用 AC_MSG_FAILURE 硬失败（本体构建不需要）——
#   补丁改非致命警告，让无该模块的环境（CI/沙箱）可通过 configure
# 对应人类文档: knowledge/drafts/DRAFT-ohos-configure-optional-python-hardfail.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR zeitgeist/1.0.4 适配 HarmonyOS PC（autotools + Vala）
#====================================================================

id:                     DRAFT-ohos-configure-optional-python-hardfail
trigger_tool:           configure
phase:                  configuration
error_signature:        Please install the .*python.*package|
                         AC_MSG_FAILURE.*rdflib|
                         failed\.  Please install|
                         configure: error:.*package

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               autotools, configure, python, portability, detection
match_keywords:         python3-rdflib, AC_MSG_FAILURE, optional dependency,
                         configure hard fail, ontology parsing, python module,
                         configure: error, please install, zeitgeist
title:                  autotools configure 对可选 python 模块用 AC_MSG_FAILURE 硬失败——
                         本体构建不需要时补丁改非致命警告

# ═══ Layer 2: 诊断层 ═══
root_cause:             部分 autotools 项目把"可选"工具依赖（如 python 模块 rdflib，
                         仅 ontologies 解析/文档生成脚本需要）写成 AC_MSG_FAILURE
                         （configure 硬失败），而不是 AC_MSG_WARN/条件跳过。本体
                         （C 库/引擎）编译根本不需要该模块，但 configure 阶段即
                         报错终止——在缺少该 python 模块的环境（CI 沙箱、无 pip
                         安装的干净镜像）直接构建失败，属于过度约束
affected_scope:         所有用 autotools 构建、configure.ac 把可选 python 模块写成
                         AC_MSG_FAILURE 的库（zeitgeist 即此类，rdflib 仅 ontologies
                         解析工具需要，本体库/引擎不需要）
verification_cmd:       conan create archives/z/zeitgeist/1.0.4
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 未打补丁时 configure 报
                         #   "failed.  Please install the python3-rdflib package."；
                         # 打 0001-relax-rdflib-check.patch 后 configure 通过

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           configure-patch-softfail
rec_description:        patch configure（及 configure.ac 同步），把该检查从
                         AC_MSG_FAILURE 改为非致命（打印 no 警告继续）。本体构建
                         不依赖该模块，软放行无损；补丁单一职责、可复现
rec_command:            (patches/0001-relax-rdflib-check.patch)
                         @@ -21487,16 +21487,17 @@
                          echo "import rdflib" | $PYTHON - 2>/dev/null
                          if test $? -ne 0 ; then
                         -  as_fn_error $? "failed.  Please install the python3-rdflib package."
                         +  printf "%s\n" "no (optional; ... disabled)"
                          else ... fi
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      tool-requires-python-module
fallback_description:   若 configure 的检查逻辑确实需要该模块（不是纯可选），用
                         tool_requires/python 或 build 环境预装模块——改动面大，
                         且 CI 沙箱装模块不可控，不推荐
fallback_command:       (tool_requires 提供 python + 模块)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       跳过.*configure|N/A（未运行）|不跑.*configure
forbid_1_reason:        补丁软放行可无损解决；跳过 configure 属"有可运行子集未尝试"
forbid_1_consequence:   被 rule 4 打回；且掩盖真实构建能力
forbid_2_pattern:       sed.*AC_MSG_FAILURE.*删除|patch.*configure\.ac.*整体删.*rdflib
forbid_2_reason:        只应软放行（保留检查输出 no 警告），整体删除会丢诊断信息
forbid_2_consequence:   换环境重新出现问题时无法定位

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             E007
conflicts_with:         []
prerequisite_of:        []

