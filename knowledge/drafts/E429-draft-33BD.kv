#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: cmake|clang|ld|conan
phase: configuration|linking
error_signature: unable to find library -l(jpeg|turbojpeg|zstd|cairo-gobject)|PROJECT_DEPS_LIBRARIES

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: cmake, linking, conan, pkg-config
match_keywords: unable to find library,PROJECT_DEPS_LIBRARIES,pkg_check_modules,-L
title: CMake pkg_check_modules 只链接 ${PROJECT_DEPS_LIBRARIES} 未用 _LIBRARY_DIRS 导致传递 -L 丢失

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游 CMakeLists 只用 target_link_libraries(${PROJECT_DEPS_LIBRARIES}) 而未用 pkg_check_modules 的 PROJECT_DEPS_LIBRARY_DIRS, 传递依赖 (cairo-gobject/libjpeg-turbo/zstd/tiff/webp) 的 -L 路径全部丢失, ld 无法解析
affected_scope: 所有用 CMake pkg_check_modules + Conan PkgConfigDeps 且上游未链接 LIBRARY_DIRS 的库; gtk/glib 系 CMake 库 (ayatana-ido 0.10.4 实测)
verification_cmd: conan create 链接通过 (libayatana-ido3-0.4.so 完整, 含 cairo-gobject/jpeg/zstd/tiff/webp 传递依赖); test_package ctest 1/1 PASS

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach:           conanfile-generate-inject-all-dependency-libdirs
rec_description:        conanfile.py generate() 中遍历 self.dependencies 全部包, 把存在的 <package_folder>/lib 以 -L 追加注入 CMAKE_SHARED_LINKER_FLAGS 与 CMAKE_EXE_LINKER_FLAGS, 弥补上游只链接 ${PROJECT_DEPS_LIBRARIES} 而未用 PROJECT_DEPS_LIBRARY_DIRS 丢失的传递 -L
rec_command:            见 conanfile.py generate()（tc.variables["CMAKE_SHARED_LINKER_FLAGS"] 与 CMAKE_EXE_LINKER_FLAGS 赋值为 sorted(link_dirs) 拼接）
rec_auto_fix:           false
rec_impl:               conanfile-generate-libdir-flag-injection

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      patch-upstream-target_link_directories
fallback_description:   若依赖图 libdir 注入受并发/链接顺序限制，退而 patch 上游 CMakeLists 增补 target_link_directories(${PROJECT_DEPS_LIBRARY_DIRS})（需走补丁流程，R1 参数最少化原则下仅在配方注入不可行时使用）
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       file://|/storage/|/usr/local|=${PROJECT_DEPS_LIBRARIES}.*替换式
forbid_1_reason:        覆盖式赋值会丢已有 flags；硬编码绝对路径违反 R39/R49 并破坏原子性审计
forbid_1_consequence:   CI 干净环境不可复现 或 W4 审计判 P1 拒绝合入
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P004

