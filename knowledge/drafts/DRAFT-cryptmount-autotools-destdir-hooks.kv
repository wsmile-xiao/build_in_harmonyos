id:                     DRAFT-cryptmount-autotools-destdir-hooks
trigger_tool:           install|make|conan
phase:                  installation
error_signature:        chown:.*Operation not permitted|install-sh:.*does not exist|DESTDIR.*setuid
severity:               2
category:               autotools, build-system, packaging, ohos
match_keywords:         DESTDIR, install-exec-hook, chown root, setuid, sysinit
title:                  Autotools 安装钩子会在 DESTDIR 打包时执行系统级副作用
root_cause:             DESTDIR 只重定向安装路径，不会自动屏蔽 install-exec-hook 中的 chown/setuid 或 Linux init 子目录安装
affected_scope:         使用 Automake 自定义 install hook、提权文件属性或 Linux init/systemd 安装目标的跨平台 Conan 包
verification_cmd:       grep -nE 'install-exec-hook|chown|chmod|SUBDIRS' Makefile.am; conan create <recipe> --profile:host=<target> --profile:build=<build>
rec_priority:           1
rec_approach:           source-patch
rec_description:         将仅供系统部署的权限变更限制在 DESTDIR 为空或根路径时，并从目标子目录中排除 Linux 专用服务安装
rec_command:             if test -z "$(DESTDIR)" -o "$(DESTDIR)" = "/"; then chown root:root ...; chmod u+s ...; fi
rec_auto_fix:            false
rec_impl:               source-patch
fallback_priority:      2
fallback_approach:      source-patch
fallback_description:   对目标平台不使用的 sysinit/systemd 目录，从 Automake SUBDIRS 中移除
fallback_command:       inspect generated install-recursive output and remove only unsupported platform targets
fallback_auto_fix:      false
fallback_impl:         source-patch
forbid_1_pattern:       chown.*DESTDIR|chmod.*setuid.*DESTDIR
forbid_1_reason:        DESTDIR 仍是包暂存树；跨设备构建用户通常无权执行 root 所有权变更
forbid_1_consequence:   make install 失败，或把不应进入二进制包的提权权限写入暂存产物
principles:             R34, R51
causes:                 []
caused_by:              []
similar_to:             E453
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-cryptmount-autotools-destdir-hooks.md
last_updated:           2026-09-29
source_event:           cryptmount 6.4.0 HarmonyOS PC Conan package install
source_pr:
source_commit:
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:      2026-09-29
draft:                  true
contributor_id:         iKalous_OscarP
