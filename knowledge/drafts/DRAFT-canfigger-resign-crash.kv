# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     DRAFT-canfigger-resign-crash
trigger_tool: test
phase: runtime
error_signature: Signal 11 \(core dumped\)|ConanException: Error 139 while executing

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: ohos, portability, musl, packaging, runtime
match_keywords: binary-sign-tool, selfSign, codesign, shared library, musl loader, SIGSEGV, re-sign, dlopen
title: hnp clang已内嵌codesign签名的共享库被binary-sign-tool selfSign重签后musl加载器SIGSEGV

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: hnp clang驱动在链接期已对输出ELF内嵌ad-hoc .codesign签名段(readelf -S在本地meson产物与Conan包产物均见该段);binary-sign-tool selfSign生成的重签段与本机musl加载器不兼容,加载重签产物即SIGSEGV core dump;对照实验:剥离重签产物的.codesign段后同一消费者二进制立即恢复可加载(40/40断言通过)
affected_scope: 所有在package()阶段对hnp clang链接的共享库做binary-sign-tool selfSign二次签名的配方(libavtp/0.2.0的签名流程在本机复测即触发);E318 go test可执行文件流程未复现本问题,本条目限定共享库场景
verification_cmd: readelf -S libcanfigger.so.0 | grep -c codesign; LD_LIBRARY_PATH=<pkg>/lib ./test_canfigger # 重签产物exit 139, 剥离.codesign后PASS assertions=40

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: no-re-sign
rec_description: 共享库不做二次签名:保留链接器内嵌.codesign签名,package()只做版本别名实体化
rec_command: readelf -S /lib/libX.so* | grep -c codesign
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: strip-codesign
fallback_description: 若确需无签名产物,先llvm-objcopy剥离.codesign再验证可加载,不得默认重签
fallback_command: llvm-objcopy --remove-section .codesign <lib>.so
fallback_auto_fix: false
fallback_impl: manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: selfSign.*-inFile.*\.so|binary-sign-tool sign.*\.so
forbid_1_reason: hnp clang产物已带链接器签名,selfSign重签段与musl加载器不兼容
forbid_1_consequence: 包内共享库被加载即SIGSEGV(test_package Error 139)
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P007

