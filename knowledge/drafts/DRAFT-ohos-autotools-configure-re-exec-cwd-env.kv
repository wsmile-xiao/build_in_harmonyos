#====================================================================
# DRAFT-ohos-autotools-configure-re-exec-cwd-env.kv
# OHOS autotools configure 重执行 shell 的 cwd 环境变量坑
# (toybox sh 不 export 当前目录环境变量 → CONFIG_SHELL=bash 重执行时
#  bash 启动 getcwd() 失败 → "configure: error: working directory
#  cannot be determined")
#====================================================================

id:                     DRAFT-ohos-autotools-configure-re-exec-cwd-env
trigger_tool:           configure|conan|autoreconf|bash
phase:                  configuration
error_signature:        working directory cannot be determined|
                         getcwd: cannot access parent directories|
                         shell-init: error retrieving current directory|
                         configure: error: working directory cannot be determined

severity:               3
category:               ohos, autotools, conan, configure, build-system, shell
match_keywords:         CONFIG_SHELL, bash, getcwd, PWD, toybox, current directory,
                         autoconf, autoreconf, re-exec, os.environ, build_folder,
                         working directory cannot be determined, ac_pwd, config.status
title:                  OHOS autotools configure 重执行 shell 的 cwd 环境变量坑（working directory cannot be determined）

root_cause:             |
  OHOS 默认 /system/bin/sh 为 toybox sh，不 export 当前目录环境变量 PWD
  （真机探针: sh -c 'echo PWD=[$PWD]; env | grep -e ^PWD' → PWD 为 shell
  局部变量，env 中无 PWD）。GitHub archive 无 configure → 配方 build() 内
  autoreconf 自举；profile 设 CONFIG_SHELL=bash 后 configure 以 bash
  重执行。bash 启动时调用 getcwd() 解析当前目录，此时进程环境无 PWD 且
  HMDFS getcwd() 返回 EPERM（探针 env -u PWD bash -c 'pwd' → shell-init:
  error retrieving current directory: getcwd: cannot access parent
  directories: Operation not permitted）→ configure 的 ac_pwd 检查失败，
  报 "configure: error: working directory cannot be determined"。
  CONFIG_SHELL=/bin/sh 的绕过在 conanbuild 后置覆盖下无效（已证伪）。

affected_scope:         所有 OHOS 上 autoreconf 自举 + configure 以 CONFIG_SHELL=bash
                         重执行的 autotools/Conan 配方（enchant/gnumeric/goffice/
                         dejagnu 等同类 configure 含同一错误分支，已证跨库）

verification_cmd:       |
  sh -c 'echo PWD=[$PWD]; env | grep -e ^PWD'
  env -u PWD bash -c 'pwd'
  PWD=/storage/Users/currentUser bash -c 'pwd'   # 修复后语义

rec_priority:           1
rec_approach:           preset-current-dir-env
rec_description:        build() 内 configure 前用 os.environ 预置当前目录环境变量，
                        使 bash 启动时读 $PWD 不再 getcwd()。
rec_command:            os.environ["PWD"] = str(self.build_folder)
rec_auto_fix:           false
rec_impl:               manual-conan-recipe

fallback_priority:      2
fallback_approach:      none-valid
fallback_description:   CONFIG_SHELL=/bin/sh 在 conanbuild 后置覆盖下无效（已证伪）；
                        无其它稳定绕过，预置 PWD 为唯一修复。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       CONFIG_SHELL=/bin/sh|CONFIG_SHELL.*system/bin/sh
forbid_1_reason:        conanbuild 环境后置覆盖使该设置无效，configure 仍以 bash 重执行
                        并命中 working directory cannot be determined
forbid_1_consequence:   多轮试错浪费时间；错误签名不变

principles:

