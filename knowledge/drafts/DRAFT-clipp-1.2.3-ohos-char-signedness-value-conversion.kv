#====================================================================
# DRAFT-clipp-1.2.3-ohos-char-signedness-value-conversion.kv
# 主题: aarch64/OHOS 无符号 char 使 CLI 数值转换（strtoll+clamp）负值钳位，
#       上游 values_conversion_test 的 char 转换用例失败
# 来源: clipp 1.2.3 上游测试 39 可执行实测（R01 证据）
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     DRAFT-clipp-1.2.3-ohos-char-signedness-value-conversion
trigger_tool:           clang|test|unit-test
phase:                  testing
error_signature:        failed test test/values_conversion_test.cpp in line 165|
                        test<char>.*-128.*-128.*failed|
                        Expected -128 but was 0

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               platform, toolchain, c++, upstream-tests, char-signedness, value-conversion
match_keywords:         char signedness, unsigned char, signed char, -fsigned-char, plain char,
                        strtoll, clamped_on_limits, clamp, CLI parsing, 值转换, value conversion,
                        aarch64, OHOS, upstream tests, 上游测试

# ═══ Layer 2: 诊断层 ═══
title:                  aarch64/OHOS 无符号 char 使 CLI 数值转换（strtoll+clamp）负值钳位为 0，上游 char 转换用例失败
root_cause:             C/C++ plain char 符号性由实现定义，aarch64（含 OHOS）默认无符号。
                        clipp make<char> 用 std::strtoll 解析 "-128" 后经 clamped_on_limits<char>
                        钳位：无符号 char 下 numeric_limits 为 0..255，-128 被钳为 0，与上游
                        测试期望（有符号 char 语义下的 -128）不符。存储字节与解析结果均与
                        有符号 char 平台不同，属平台 ABI 语义差异而非库缺陷。
affected_scope:         将字符串数值转换到 plain char 的库（CLI 参数解析、配置解析、格式转换），
                        若转换实现走 strtoll/strtol + clamp，且在默认无符号 char 的目标
                        （aarch64/OHOS）上运行上游 char 转换测试

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           upstream-test-char-signedness
rec_description:        归因为平台 ABI 语义差异：不修改库、不改上游断言、不禁用测试；
                        用 -fsigned-char 控制组证明同套件全绿，并在报告中如实记录
                        38/39（char 转换 1 例为无符号 char 钳位边界）。
rec_command:            # 复现（默认，无符号 char -> values_conversion_test 失败）
                        clang++ -I include -std=c++11 -Wall -Wextra -Wpedantic -O0 \
                          -o bin/values_conversion_test test/values_conversion_test.cpp && \
                        ./bin/values_conversion_test
                        # 控制组（-fsigned-char -> 全绿）
                        clang++ -fsigned-char -I include -std=c++11 \
                          -o bin/values_conversion_test_signed test/values_conversion_test.cpp && \
                        ./bin/values_conversion_test_signed
rec_auto_fix:           true
rec_impl:               use-fsigned-char-control-group

fallback_priority:      2
fallback_approach:      consumer-verification-only
fallback_description:   若上游测试无法在目标语义下运行，以 test_package 消费者测试与
                        HarmonyOS 专项测试为准（clipp 1.2.3 二者均通过），
                        上游失败不影响库交付，但需在报告中说明恢复条件。
fallback_command:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       CHECK_EQUAL.*关闭|#if 0|skip\(.*test|禁用.*测试|断言.*修改.*通过
forbid_1_reason:        修改上游断言、禁用测试或伪造全绿掩盖平台差异，违反 R6/诚实归因
forbid_1_consequence:   掩蔽真实平台差异，后续平台迁移时再次踩坑且无法追溯

# ═══ Layer 4: 原则引用 ═══
principles:             R6, R11, R12

# ═══ 关系图 ═══
causes:
caused_by:
similar_to:             E419, DRAFT-etl-20.38.4-char-signedness-upstream-tests
conflicts_with:
prerequisite_of:

