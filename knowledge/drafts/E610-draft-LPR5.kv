#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E610.kv，填写各字段
# 对应的人类文档: doc/E610.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E610
trigger_tool: ld|make|libtool
phase: linking
error_signature: ld\.lld: error: undefined reference due to --no-allow-shlib-undefined: lt__argz_|llvm-nm.*libltdlc\.a.*U lt__argz

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: autotools, libtool, linking
match_keywords: LTDL_INIT, recursive, LTLIBOBJS, libltdlc.a, lt__argz, no-allow-shlib-undefined, undefined reference, AC_CONFIG_SUBDIRS, subproject
title: LTDL_INIT([recursive]) 下父 configure 替换 libltdl/Makefile，LTLIBOBJS 恒空导致 libltdlc.a 缺 lt__argz.lo

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: LTDL_INIT([recursive]) 不触发 AC_CONFIG_SUBDIRS，libltdl/Makefile 由父项目 config.status 替换；而 libltdl 的 _LT_LIBOBJ 探测（argz/dirent/strlcpy）只在它自己的 configure 里跑，父项目 LTLIBOBJS 为空 → libltdlc.a 少了 lt__argz.lo，ltdl.o 里的 5 个 U lt__argz_* 未定义；libprelude.so 照常链接出厂，直到链接下游可执行文件（prelude-admin）才被 lld 的 --no-allow-shlib-undefined 抓住
affected_scope: 所有以 recursive 模式内嵌独立 libltdl 的 autotools 项目（libprelude 5.2.0 实测；musl/OHOS 上因 gnulib 未提供 argz 探测而暴露）
verification_cmd: make -C <build>/libltdl >/dev/null; grep '^LTLIBOBJS' <build>/libltdl/Makefile; llvm-nm -A <build>/libltdl/.libs/libltdlc.a | grep -c ' U lt__argz'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: switch-libltdl-to-subproject-mode
rec_description: 给 configure.ac 打补丁：LTDL_INIT([recursive]) → LTDL_INIT([subproject])（触发 AC_CONFIG_SUBDIRS），并从顶层 AC_CONFIG_FILES 列表移除 libltdl/Makefile（否则与子配置冲突）；libltdl 跑自己的 configure 后 LTLIBOBJS 与 libltdl/config.h 均正确生成
rec_command: patch: LTDL_INIT([recursive]) -> LTDL_INIT([subproject])
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

