#====================================================================
# Draft: puzzles 20260720.3c36322 - HNP/HarmonyOS worker 上测试脚本
#        禁止硬编码 /tmp 路径（不可写）；必须用
#        "${TMPDIR:-$PWD}/<save-dir>" 动态工作目录
#====================================================================

id:                     DRAFT-PUZZLES-HNP-TEST-SCRIPT-TMPDIR
trigger_tool:           test|conan|conan-create|conan-verify
phase:                  testing
error_signature:        无法生成存档|failed to open.*save|Operation not permitted.*tmp|cannot create.*tmp|ohos-save

severity:               2
category:               testing, ohos, filesystem, shell
match_keywords:         /tmp, TMPDIR, SAVEDIR, 不可写, HNP, worker, test_puzzles.sh, shell script, 存档, fuzzpuzz, save, mktemp
title:                  HNP/HarmonyOS worker 测试脚本禁止硬编码 /tmp（不可写），必须用 "${TMPDIR:-$PWD}" 动态工作目录

root_cause:             HNP/HarmonyOS worker 上 /tmp 不可写（只读或未挂载）；测试脚本硬编码 /tmp/fuzzsave、/tmp/ohos_save 时写入失败——fuzzpuzz-setup 无法生成存档、ohos-save FAIL，导致 CI L1 测试阶段红
affected_scope:         所有在 HNP worker 上运行的 shell 测试脚本（test_package 的 .sh runner、保存存档/中间产物的测试）；本机 macOS 上 /tmp 可写掩盖问题，只有 worker 暴露
verification_cmd:       HNP CI 重跑 test_package（puzzles 构建 #66319 全绿）；本机 bash test_puzzles.sh 50/50 PASS

rec_priority:           1
rec_approach:           tmpdir-or-pwd-savedir-pattern
rec_description:        测试脚本默认 SAVEDIR="${TMPDIR:-$PWD}/<name>-save-$$"，mkdir -p 创建，trap 清理；全部 /tmp 引用替换为 $SAVEDIR
rec_command:            SAVEDIR="${TMPDIR:-$PWD}/puzzles-save-$$"; mkdir -p "$SAVEDIR"; trap 'rm -rf "$SAVEDIR"' EXIT
rec_auto_fix:           false

fallback_priority:      2
fallback_approach:      ci-injected-writable-dir
fallback_description:   若 TMPDIR 也指向不可写位置，由 CI/环境注入已确认可写目录（如 $PWD 下子目录），脚本优先读取该环境变量
fallback_command:       WRITE_DIR="${CI_WRITABLE_DIR:-${TMPDIR:-$PWD}}"
fallback_auto_fix:      false

forbid_1_pattern:       /tmp/[A-Za-z0-9_/]*(save|archive|out)|mktemp -d /tmp
forbid_1_reason:        HNP worker /tmp 不可写，硬编码 /tmp 路径直接写入失败
forbid_1_consequence:   fuzzpuzz-setup/存档类测试 FAIL（puzzles #66276 实例），CI L1 红，需整轮修复 + 重跑
forbid_2_pattern:       \$\{TMPDIR:-/tmp\}|TMPDIR="/tmp"
forbid_2_reason:        TMPDIR 兜底到 /tmp 仍在 worker 上不可写
forbid_2_consequence:   修复不彻底，换 worker/CI 环境仍可能红

principles:             []
causes:                 []
caused_by:              []
similar_to:             [E225, E253, E272]
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/puzzles-20260720.3c36322-hnp-test-script-tmpdir.md
last_updated:           2026-10-01
source_event:           CI #66276 fuzzpuzz-setup 无法生成存档 + ohos-save FAIL（/tmp 不可写）
source_pr:              14184
source_commit:          c47da6837a
