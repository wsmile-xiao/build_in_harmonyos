#====================================================================
# Draft: OHOS sysroot ships a STUB <libintl.h> and no libintl at all
#        (gettext lives in glibc's libc, not in musl/OHOS).  Any source
#        that calls dgettext()/bindtextdomain() directly must include
#        <libintl.h> explicitly and the recipe must link the gettext
#        artifact (-lintl + -L<gettext libdir>).  Source event:
#        schroot 1.6.13, 2026-10-01.
#====================================================================

id:                     DRAFT-SCHROOT-1613-OHOS-LIBINTL-STUB
trigger_tool:           make|gcc|clang|ld|cmake
phase:                  compilation
error_signature:        dgettext.*undeclared|bindtextdomain.*undeclared|undefined reference to .*(dgettext|bindtextdomain|gettext)|libintl\.h.*stub|cannot find -lintl

severity:               3
category:               libc, musl, headers, ohos, build-system
prescan_pattern:        dgettext\(|bindtextdomain\(|gettext\(|#include\s+<libintl\.h>
match_keywords:         libintl, gettext, dgettext, bindtextdomain, NLS, OHOS libintl.h stub, undefined reference, -lintl, libintl.so, i18n wrapper header, schroot

title:                  OHOS sysroot 的 <libintl.h> 是空壳且不提供 libintl（gettext 属 glibc 的 libc）：直接调用 dgettext()/bindtextdomain() 的源文件须显式包含 <libintl.h>，并由配方链接制品仓 gettext 包（-lintl + -L<gettext libdir>）

root_cause:             glibc 平台把 gettext 的 libintl 并进 libc，因此 GNU 工具链下「不显式包含 <libintl.h> 也能编译通过」是常见的历史写法；OHOS 基于 musl、sysroot 里的 <libintl.h> 仅为空壳且不提供 libintl 符号。后果有两个层面：①编译期——直接调用 dgettext()/bindtextdomain() 而未包含 <libintl.h> 的源文件报 undeclared（项目自身的 i18n 封装头若未包含 <libintl.h>，其使用者全部受影响）；②链接期——符号未解析，报 undefined reference。本仓制品仓的 gettext 包提供真实 libintl.h + libintl.so。
affected_scope:         所有启用 NLS 的上游项目（尤其 2010 年代 autotools/CMake 写法）：直接调用 gettext 家族函数而未包含 <libintl.h> 的源文件、以及未链接 libintl 的构建。schroot 1.6.13 为实证（3 处补 include + 配方加 gettext 依赖）。
verification_cmd:       printf '#include <libintl.h>\nint main(){dgettext("d","s");return 0;}\n' > t.c && clang -c t.c -o /dev/null && echo HEADER_OK; nm -D <gettext pkg>/lib/libintl.so | grep -w dgettext

rec_priority:           1
rec_approach:           include-libintl-and-link-gettext-artifact
rec_description:        ①确认 sysroot 头是空壳：读 OHOS sysroot 的 <libintl.h>（通常只有少量声明或为空）并用 nm 检查是否存在 libintl；②为上游那些直接调用 gettext 家族的源文件补 #include <libintl.h>（尤其项目自带的 i18n 封装头，补在封装头里可一次覆盖全部使用者，比逐文件补更稳）；③配方 requirements 加 gettext 依赖，并把 -lintl 与 -L<gettext libdir> 注入链接（autotools 用 LIBS/LDFLAGS，CMake 用 extra_linkflags）；④若上游有 NLS 开关而本次不需要翻译，也可 nls=OFF 规避——但这只是绕过，须在 notes.md 写明取舍；⑤注意区分「上游 NLS 特性位本身的 bug」（如 schroot 的 NLS 特性位误取自 ${pam}）与本模式——两者常同时出现，须分别定位。
rec_command:            -DLDFLAGS="-L<gettext pkg>/lib -lintl" ... ; recipes: self.requires("gettext/0.22.5.1")
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:      disable-nls-when-not-required
fallback_description:   若包本身不需要本地化（服务/工具类），直接关闭 NLS（-Dnls=OFF / --disable-nls）避免引入 libintl 依赖；但须在 notes.md、manifest.yaml 中说明该取舍，避免被误读为"未适配"。
fallback_command:       cmake -Dnls=OFF ...
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       \bdefine\s+(dgettext|bindtextdomain)\b|--wrap\s*=\s*(dgettext|bindtextdomain)
forbid_1_reason:        用宏/链接包装伪造 libintl 符号，会把"缺 gettext 依赖"的真实问题藏起来，运行时翻译行为与上游语义不符。
forbid_1_consequence:   包在本地看似可用，运行时 i18n 静默失效；下一个同类包继续踩同样的坑

principles:             P0

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/schroot-1.6.13-ohos-libintl-stub.md
last_updated:           2026-10-01
source_event:           schroot 1.6.13：make 阶段 dgettext/bindtextdomain undeclared → 补 3 处 include（含项目 i18n 封装头）+ 配方加 gettext 依赖与 -lintl 后通过

authors:                weijiapan <weijiapan@noreply.gitcode.com>
source_pr:
source_commit:
