#====================================================================
# E321-draft-F987.kv — gnulib weak-symbol 探测在 musl/OHOS 引用不存在的 pthread_cancel
# (与既有 E321-draft-5FC1/9758/B1GL 草稿主题不同, 由主编 promote 时重新分配编号)
#====================================================================

id:                     E321
trigger_tool:           configure|make|clang
phase:                  compilation
error_signature:        use of undeclared identifier 'pthread_cancel'|
                         weak identifier 'pthread_cancel' never declared|
                         regcomp\.c.*pthread_cancel|regexec\.c.*pthread_cancel

severity:               2
category:               compat, libc, gnulib, autotools
match_keywords:         gnulib, glthread, lock.h, USE_POSIX_THREADS_WEAK,
                         pthread_cancel, musl, weak symbol, pragma weak,
                         threadlib.m4, gl_cv_have_weak

root_cause:             内嵌旧版 gnulib 的 autotools 项目在 OHOS(musl libc) 上,
                         configure 检测出 USE_POSIX_THREADS_WEAK=1 后,
                         glthread/lock.h 走 #pragma weak pthread_cancel 探测路径,
                         而 musl 不提供 pthread_cancel 声明/符号 →
                         8 处 use of undeclared identifier 编译错误
                         (regcomp.c ×4 + regexec.c ×4)
affected_scope:         所有携带 gnulib glthread (regex/lock 模块) 的
                         autotools 包
verification_cmd:       grep "USE_POSIX_THREADS_WEAK" config.h
                         # =1 即命中; 编译日志 grep pthread_cancel

rec_priority:           1
rec_approach:           patch-threadlib-m4-force-no-weak
rec_description:        patch gl/m4/threadlib.m4, 在 AC_CACHE_CHECK
                         (gl_cv_have_weak) 前按 host_os 强制 cache 值:
                         case "$host_os" in linux-ohos*|ohos*)
                         gl_cv_have_weak=no ;; esac;
                         并在 configure 参数传 gl_cv_have_weak=no 双保险
                         (cache 变量可预设)
rec_command:            sed/patch gl/m4/threadlib.m4 + configure gl_cv_have_weak=no
rec_auto_fix:          false
rec_impl:               patch

fallback_priority:      2
fallback_approach:      configure-cache-preset
fallback_description:   仅在 configure 命令行传 cache 变量
                         gl_cv_have_weak=no (无需改源码)
fallback_auto_fix:     true

forbid_1_pattern:       直接注释掉 glthread/lock.h 的 pthread_cancel 引用
forbid_1_reason:        会被 autoreconf 重新生成的 gnulib 覆盖, 且破坏
                         其他平台的 weak 语义
forbid_1_consequence:   不可复现修补 + 非 OHOS 平台回归
principles:              P003, P004
caused_by:               E064 (conftest 运行问题常与 libc 差异伴生)
similar_to:
conflicts_with:
prerequisite_of:

doc_file:               E321-draft-F987.md
last_updated:           2026-09-03
source_event:           archives/l/libdap/3.20.6/manifest.yaml

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count: 1
metrics_fail_count: 0
metrics_confidence: 0.9
metrics_last_used: 2026-09-03

# 附带发现 (详见 .md):
# - musl loader LD_LIBRARY_PATH 空格段陷阱 (中段空格使后续段全部失效)
# - ohos-sdk lld NEEDED libxml2.so.16 被 conan 同名库遮蔽 → 链接器崩溃
# - /data/storage/el1/bundle/libs/arm64 的 libc++_shared.so 符号集不兼容
