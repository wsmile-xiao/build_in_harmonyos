#====================================================================
# Draft: conan's CMakeToolchain sets CMAKE_INSTALL_LIBEXECDIR=bin, which
#        makes upstream helper programs collide with same-named binaries
#        installed into bin/.  Fix: override the upstream CACHE variable
#        to keep the libexec/<pkg> layout.  Source event: schroot 1.6.13,
#        2026-10-01.
#====================================================================

id:                     DRAFT-SCHROOT-1613-LIBEXECDIR-BIN-CLASH
trigger_tool:           cmake|install
phase:                  installation
error_signature:        destination.*is not a directory|file INSTALL cannot|CMAKE_INSTALL_LIBEXECDIR|libexec.*bin.*conflict|install.*overwrite.*same name

severity:               2
category:               cmake, build-system, packaging, install, limitation
prescan_pattern:        CMAKE_INSTALL_LIBEXECDIR|GNUInstallDirs|_LIBEXEC_DIR|sbindir
match_keywords:         CMAKE_INSTALL_LIBEXECDIR, GNUInstallDirs, libexec, helper programs, install collision, conan toolchain, CACHE variable, schroot-mount, schroot-listmounts

title:                  conan CMakeToolchain 把 CMAKE_INSTALL_LIBEXECDIR 设为 bin，导致上游 helper 程序与 bin/ 内同名可执行文件安装冲突：用上游 CACHE 变量覆盖回 libexec/<pkg> 布局

root_cause:             conan 的 CMakeToolchain 为适配 conan 包布局，会设定一批 GNUInstallDirs 变量，其中 CMAKE_INSTALL_LIBEXECDIR=bin（工具链 `cmake_install_dir` 的既定行为）。上游若用 GNUInstallDirs 或把 helper 装到 ${CMAKE_INSTALL_LIBEXECDIR}，helper 程序（schroot 的 schroot-mount / schroot-listmounts）就会与 bin/ 下的主程序争用同一目录；当上游同时 install 该目录本身（DIRECTORY）与其中的文件时，会报 destination is not a directory / cannot install。上游把该路径实现为 CACHE 变量时，配方侧显式覆盖即可恢复 libexec/<pkg> 布局。
affected_scope:         CMake 项目，使用 GNUInstallDirs 或自定义 *_LIBEXEC_DIR CACHE 变量安装 helper/daemon 程序；在 conan 下构建且产物同时含 bin/ 主程序与 libexec/ helper 的包（application 类型最常见）。
verification_cmd:       grep -n "CMAKE_INSTALL_LIBEXECDIR" <build tree>/CMakeCache.txt; ls <package_folder>/libexec
rec_priority:           1
rec_approach:           override-upstream-cache-variable-for-libexec
rec_description:        ①先查 CMakeCache.txt 中 CMAKE_INSTALL_LIBEXECDIR 的取值（conan 下通常是 bin）与上游实际使用的变量名（可能是自家的 SCHROOT_LIBEXEC_DIR 等 CACHE 变量）；②在 generate() 中用 tc.cache_variables 把上游变量指向 <package>/libexec/<pkg>（保留上游预期的布局），而不是去改 conan 工具链或上游 CMakeLists；③若上游只认 CMAKE_INSTALL_LIBEXECDIR，则覆盖该变量本身，并确认包内 helper 与主程序不再同目录；④验证要看包内实际布局（ls libexec）与安装日志无 destination 冲突。
rec_command:            tc.cache_variables["SCHROOT_LIBEXEC_DIR"] = os.path.join(self.package_folder, "libexec", "schroot")
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:      post-install-move-helpers
fallback_description:   若上游硬编码 ${CMAKE_INSTALL_LIBEXECDIR} 且无 CACHE 变量可覆盖，可在 package() 中把被装进 bin/ 的 helper 移动到 libexec/<pkg>/（并修正配置文件中引用路径），但须在 notes.md 说明与上游布局的差异。
fallback_command:       python: shutil.move(pkg/bin/<helper>, pkg/libexec/<pkg>/<helper>)
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       rm.*-f.*/bin/(helper|mount|listmounts)|sed.*CMAKE_INSTALL_LIBEXECDIR.*libexec
forbid_1_reason:        删除/改写上游安装结果而不理解冲突来源，会让包内布局与上游文档/配置文件不一致（helper 路径常被上层脚本引用）。
forbid_1_consequence:   运行时找不到 helper 或配置指向不存在路径，问题延后到用户侧

principles:             P0

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/schroot-1.6.13-libexecdir-bin-clash.md
last_updated:           2026-10-01
source_event:           schroot 1.6.13：安装期 helper 与 bin/ 主程序目录冲突；generate() 覆盖 SCHROOT_LIBEXEC_DIR 后恢复 libexec/<pkg> 布局、冲突消失

authors:                weijiapan <weijiapan@noreply.gitcode.com>
