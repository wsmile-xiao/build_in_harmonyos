#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E557.kv，填写各字段
# 对应的人类文档: doc/E557.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E557
trigger_tool: gzip|runtime
phase: runtime
error_signature: gzip: no \.gz: .*\.tar\.z|gzip: no \.gz|cannot defeather .*\.tar\.z|gzip: Unknown option 'S'

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform, portability, ohos
match_keywords: gzip 后缀, toybox gzip, no .gz, .tar.z, .tgz, 解压失败, gzip -d -c, 管道解压, 脚本压缩前端, 后缀识别
title: HarmonyOS toybox gzip 解压仅识别 .gz 后缀 → 脚本解压 .tgz/.tar.z 需用 -c 管道输出

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: HarmonyOS gzip 为 toybox 0.8.12，gzip -d 仅识别 .gz 后缀文件名；脚本（如 z 工具）解压 .tgz 时先改名 .tar.z 再调 gzip -d，toybox 报 gzip: no .gz 拒绝解压，且 toybox gzip 不支持 -S 选项改后缀
affected_scope: 调用系统 gzip 解压 .z/.tgz/.tar.z 后缀文件的 shell 脚本工具与安装脚本
verification_cmd: cp x.tgz x.tar.z && gzip -d -n -c x.tar.z > out.tar && echo OK

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 解压调用改为 gzip -d -n -c "$arg" > "$tarf"（stdout 管道输出不检查后缀），失败回退原命令
rec_description: gzip 解压改 -c 管道重定向，绕过后缀检查（toybox 兼容）
rec_command:            sed -i 's|\$ucommand "\$arg"|if $ucommand -c "$arg" > "$tarf" 2>/dev/null; then rm -f "$arg"; else rm -f "$tarf"; $ucommand "$arg"; fi|' z
rec_auto_fix: false
rec_impl: conan-recipe-script-gzip-c-pipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: 先改名 .gz 后缀再 gzip -d，成功后恢复原名
fallback_description: 若无法改管道逻辑，临时以 .gz 后缀解压
fallback_command: mv x.tar.z x.tar.gz && gzip -d -n x.tar.gz && mv x.tar x.tar.gz.x && mv x.tar.gz.x x.tar
fallback_auto_fix: false
fallback_impl: script-gzip-rename-fallback

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: gzip -d -n [^|]*\.tar\.z(?! -c)
forbid_1_reason: toybox gzip 只认 .gz 后缀，直接解压 .tar.z 必报 no .gz
forbid_1_consequence: 解压失败，脚本输出 cannot defeather，功能不可用
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P003, P011

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E402
conflicts_with:         []
prerequisite_of:        []

