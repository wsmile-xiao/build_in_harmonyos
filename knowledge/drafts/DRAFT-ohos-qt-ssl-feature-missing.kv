#====================================================================
# DRAFT-ohos-qt-ssl-feature-missing.kv
# OHOS 下 Qt 应用编译报 QSslSocket/QSslCipher 未声明：
# qtbase 基座未启用 SSL 功能（FEATURE_openssl=OFF）
# 触发事件: ausweisapp 2.5.4 HarmonyOS PC 适配（archives/a/ausweisapp/2.5.4，PR #7912）
#====================================================================

id:                     DRAFT-ohos-qt-ssl-feature-missing
trigger_tool:           cmake|clang|conan
phase:                  configuration|compilation
error_signature:        use of undeclared identifier 'QSslSocket'|
                         use of undeclared identifier 'QSslCipher'|
                         Your OpenSSL library looks incompatible|
                         try_run.*openssl\.cpp

severity:               3
category:               network|cmake|conan|compat|linking
match_keywords:         QSslSocket, QSslCipher, QSslError, QT_NO_SSL,
                         FEATURE_openssl, OpenSSL, QtNetwork, qtbase,
                         SSL variant, undeclared identifier, openssl.cpp,
                         sslLibraryVersionString
title:                  OHOS 下 Qt6 应用编译报 QSslSocket/QSslCipher 未声明：依赖的 qtbase 基座以 FEATURE_openssl=OFF 构建，需改用带 SSL 支持的 qtbase 变体

root_cause: >
  Qt6 的 QSslSocket/QSslCipher/QSslError 等类仅在 Qt 构建时启用 SSL 功能
  （FEATURE_openssl=ON，即无 QT_NO_SSL）才被声明。若下游配方解析到的
  qtbase 基座以 FEATURE_openssl=OFF 构建，则 QtNetwork 头文件里这些类
  整体缺失，下游任何使用 Qt SSL API 的应用（如 AusweisApp 的
  cmake/tests/openssl.cpp OpenSSL 兼容性 try_run 测试）在编译期即报
  "use of undeclared identifier 'QSslSocket'/'QSslCipher'"，而非链接期
  符号缺失——错误形态是先编译失败，表象常被误判为头文件路径/包含问题。
affected_scope: >
  所有依赖 Qt Network SSL API（QSslSocket/QSslCipher/QSslError/
  QSslConfiguration）的 Qt6 应用与库在 OHOS 上的适配；以及上游 CMake
  在 LINUX/UNIX 分支用 try_run 编译 openssl.cpp 做 OpenSSL 兼容性校验
  的 Qt 项目（AusweisApp 2.x 系列均命中）。
verification_cmd: >
  conan create 复验：OpenSSL 兼容性 try_run（openssl.cpp）编译通过；
  grep -rn QT_FEATURE_ssl <qtbase_pkg>/include 确认基座 SSL 特性为 ON
  （无 QT_NO_SSL 时该宏存在）；readelf -d <bin> | grep -i ssl 确认
  链接了 libssl/libcrypto

rec_priority:           1
rec_approach:           use-qtbase-ssl-variant
rec_description: >
  将下游配方对 qtbase 的依赖改为带 SSL 支持的变体（如
  qtbase/6.11.1.1.1：FEATURE_openssl=ON + requires openssl/3.5.6.1），
  并用 override=True 强制整个依赖图（qtdeclarative/qtwebsockets 等按
  plain 6.11.1 构建的模块）统一解析到该 SSL 变体；SSL 变体包缺省时按
  相同思路给 qtbase 配方加 FEATURE_openssl=ON 与 openssl 依赖重发布。
rec_command:            >
  self.requires("qtbase/6.11.1.1.1", override=True,
                transitive_headers=True, transitive_libs=True)
rec_auto_fix:           false
rec_impl:               conan-qtbase-ssl-variant

fallback_priority:      2
fallback_approach:      add-openssl-feature-to-qtbase
fallback_description: >
  若远程 registry 无现成 SSL 变体，修改/新建 qtbase 配方：configure
  传 FEATURE_openssl=ON，requirements 加 openssl（注意需同时保证
  include/CMake 包文件可被下游 find_package 消费），构建并发布后下游
  再依赖该变体；改动基座配方需先过 L0j 版本门禁。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       -DQT_NO_SSL|#ifndef QT_NO_SSL|undef QT_NO_SSL
forbid_1_reason:        用编译宏屏蔽/绕开 QSslSocket 会让 SSL 功能缺失被隐藏，应用 TLS 通信（HTTPS/eID 传输）运行期不可用
forbid_1_consequence:   CI 绿但 consumer 网络功能残缺，且知识库无法沉淀真实根因
forbid_2_pattern:       sed.*QT_NO_SSL|patch.*QSslSocket.*delete
forbid_2_reason:        删除/改名 Qt SSL API 是 ABI 级破坏，下游无法链接
forbid_2_consequence:   链接期符号缺失 + 跨包 ABI 不兼容

principles:             P005, P011
similar_to:             E323, E441
conflicts_with:
prerequisite_of:

doc_file:               knowledge/drafts/DRAFT-ohos-qt-ssl-feature-missing.md
last_updated:           2026-09-06
source_event:           archives/a/ausweisapp/2.5.4 (PR #7912)

