#====================================================================
# E348 draft - 上游 GLib 单测在 OHOS test_package 中 vendored 实跑
# 触发事件: libXpm 3.5.17 HarmonyOS PC 适配（archives/l/libxpm/3.5.17）
# 主从明确：上游测试依赖 GLib+TAP（ENABLE_UNIT_TESTS/HAVE_GLIB 门控）时，把
#           display-independent 测试未修改 vendored 进 test_package，链接已鸿蒙化的
#           GLib::GLib，注入 G_TEST_SRCDIR/G_TEST_BUILDDIR 由 CI 实跑得真实通过率。
#====================================================================

id:                     E348
trigger_tool:           g_test|glib|make check|test_package|cmake
phase:                  test
error_signature:        g_test_run|g_assert|TestAllFiles|G_TEST_SRCDIR|glib|TAP|tap-driver|check_PROGRAMS

severity:               3
category:               ohos, glib, testing, test_package, rule4, vendoring
match_keywords:         GLib::GLib, g_test, G_TEST_SRCDIR, G_TEST_BUILDDIR, TestAllFiles.h, pixmaps, ENABLE_UNIT_TESTS, HAVE_GLIB, TAP, tap-driver.sh, libxpm, XpmCreate
title:                  上游 GLib 单测在 OHOS test_package 中 vendored 实跑：GLib::GLib 链接 + G_TEST_SRCDIR 注入

root_cause:             上游测试依赖 GLib 测试框架 + TAP，直接在 OHOS make check 不可行；
                        写 "0/N 未执行" 违反 rule4。当 GLib 已鸿蒙化（glib/2.88.0 提供
                        GLib::GLib），把 display-independent 测试未修改 vendored 进
                        test_package 并注入 G_TEST_SRCDIR/G_TEST_BUILDDIR，即可由 CI
                        实跑得到真实通过率；缺 configure 生成内部头的用例如实判 N/A。

affected_scope:         一切上游测试用 GLib/g_test 框架的库（Xpm/rgb 类、GNOME/GLib 生态），
                        在 OHOS CI 上需要 rule4 真实通过率的适配场景。

verification_cmd:       CI_PACKAGES="archives/l/libxpm/3.5.17" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           vendor-glib-tests-run-on-ci
rec_description:        上游测试源码未修改 vendored 到 test_package/upstream/test（.c+辅助头
                        +pixmaps 数据+最小 config.h），CMake find_package(GLib) 链接
                        GLib::GLib，运行期注入 G_TEST_SRCDIR/G_TEST_BUILDDIR 逐用例实跑，
                        真实通过率回填 PR body；缺内部头的用例如实 N/A。
rec_command:            CI_PACKAGES="archives/l/libxpm/3.5.17" zsh ci/conan/build_and_test.sh
rec_auto_fix:           false
rec_impl:               conan-test-package

fallback_priority:      2
fallback_approach:       path-b-declare
fallback_description:   若测试框架（GLib）整体未鸿蒙化，按赛事表格规则"依赖测试框架未鸿蒙化
                        → 申请路径 B"，走路径 B 声明 + 功能等价覆盖（version_contract
                        round-trip），并在 body 写明原因。优先级低于实跑。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          path-b

forbid_1_pattern:       0/[0-9]+.*未执行|待CI测试|test.*skipped.*all
forbid_1_reason:        上游有测试却写未执行 = rule4 少报，Septest 判 FAIL。
forbid_1_consequence:   PR 被驳回，需返工实跑。
forbid_2_pattern:       modify.*upstream.*test.*to pass|G_TEST_SRCDIR.*unset
forbid_2_reason:        改上游测试源码或漏注入 G_TEST_* 让测试数据找不到。
forbid_2_consequence:   测试假通过或运行期挂掉，评审不可信。
principles:             P013,P014
causes:                 []
caused_by:              []
similar_to:             E341
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E348.md
last_updated:           2026-08-31
source_event:           libXpm 3.5.17 HarmonyOS PC 适配
authors:                2301_76770579 <noreply@gitcode.com>
source_pr:              6743
source_commit:          6bb36f07e22a714c4a16edf26887e0cd3a151f46

metrics_success_count:  1
metrics_fail_count:     0
