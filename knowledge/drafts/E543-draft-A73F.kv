#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool:           configure|cmake|meson|make|gcc|clang|ld|python|pip|install|test|runtime
phase:                  configuration|compilation|linking|installation|testing|runtime
error_signature:        Target.*links to.*minilua::|target was not found|Conan: Target declared.*minilua

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               cmake, conan, headers, compat, testing
match_keywords:         CMakeDeps, cmake_target_name, minilua, target was not found, header-only, test_package, OHOS Conan
title:                  Conan CMakeDeps 导出目标名必须以实际生成结果为准

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             test_package 依据配方设置的 cmake_target_name 链接了命名空间目标 minilua::minilua，但设备端 Conan 2.29.1 的 CMakeDeps 根据该配置实际导出了未命名空间的 minilua 目标；错误发生在 CMake 生成阶段，不是编译器、链接器或上游 API 缺陷。
affected_scope:         所有使用 CMakeDeps 消费 Conan 包、并通过 cpp_info.set_property 设置 cmake_target_name 的 C/C++ 配方，尤其是 OHOS Conan 版本与主机 Conan 行为可能不一致的 header-only 包。
verification_cmd:       conan create archives/m/minilua/5.4.7 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           cmake-target-name-from-generated-config
rec_description:        先查看设备端 CMakeDeps 的实际导出目标，再让 test_package 的 target_link_libraries 与生成目标完全一致；配方属性和消费者写法必须作为一组验证。
rec_command:            conan create archives/m/minilua/5.4.7 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      inspect-cmake-deps-generated-files
fallback_description:   读取生成目录中的 minilua-config.cmake 和 targets 文件，确认 find_package 名称、别名及 cmake_target_name 的实际映射，再修正消费者或配方属性。
fallback_command:       rg -n "add_library|ALIAS|cmake_target_name" test_package/build/*/generators
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       assume.*namespace|skip.*CMake|remove.*target_link_libraries|rename.*target.*only
forbid_1_reason:        未核对生成配置就假设命名空间目标，或绕过链接调用，会掩盖包的真实消费路径。
forbid_1_consequence:   test_package 可能只完成配置或变成空壳，目标名问题会在下游项目中重新出现。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P010

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             E307, E309, E321
conflicts_with:         []
prerequisite_of:        []

