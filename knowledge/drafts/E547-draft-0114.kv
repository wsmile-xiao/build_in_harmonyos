#====================================================================
# E547-draft-0114 — OHOS 无 libudev：依赖 udev 设备枚举的外设库适配模式
# 来源: libfido2/1.15.0 适配（feat/libfido2-1.15.0, calbee21, 2026-09-04）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E547
trigger_tool:           cmake|ld|clang|gcc
phase:                  configuration|compilation|linking|runtime
error_signature:        fatal error: 'libudev.h' file not found|Could NOT find UDEV|pkg_search_module\(UDEV libudev REQUIRED\)|undefined reference to `udev_new'|udev_enumerate_new

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               ohos, platform, hid, usb, device-enumeration, stub, portability
match_keywords:         libudev, udev_new, udev_enumerate, hidraw, libudev.h, hid_linux, device enumeration, FIDO, Yubico, pkg_search_module UDEV
title:                  OHOS 无 libudev：udev 设备枚举依赖的 stub-libudev 适配模式（含 R40 功能降级声明）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS/HarmonyOS PC 不提供 libudev（无 systemd/udev 设备管理器）。上游为 Linux 编写的 USB/HID 外设库普遍通过 pkg-config 检测 libudev 并用 udev_enumerate 扫描 /sys/class/hidraw 等子系统发现设备。configure/cmake 阶段报 libudev.h 缺失或 pkg_search_module(UDEV libudev REQUIRED) 失败；链接阶段报 undefined reference to udev_new。注意分层：协议栈/加密/工具链（纯计算）与设备发现（平台强相关）是两个独立关注点，前者可完整移植，后者必须平台化。
affected_scope:         所有通过 libudev 做设备枚举的外设类库：libfido2（FIDO2 认证器）、hidapi（hidraw 后端）、libusb 相关工具链、pcsc-lite/acsccid（智能卡）、任何 pkg_search_module(UDEV ...) 的 CMake 项目。
verification_cmd:       grep -rn "libudev\|udev_" <src> | head; grep -rn "pkg_search_module(UDEV" <src>/CMakeLists.txt; ls /data/service/hnp/sysroot/usr/include/libudev.h 2>/dev/null || echo "no libudev in OHOS sysroot"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           static-inline-stub-libudev-h
rec_description:        新增 src/stub-udev/libudev.h 头文件，为上游用到的每个 udev API 提供 static-inline stub（udev_new 返回 NULL、枚举函数返回 -1/NULL），语义化为"设备发现禁用"而非崩溃；CMakeLists 在 HarmonyOS 分支 include 该目录并关闭 udev 依赖（NFC_LINUX OFF、pkg_search_module 跳过）。协议栈/加密/CLI 完整保留，BUILD_TESTS=ON 跑上游纯逻辑 regress 验证。R40 要求：notes.md 显式记录设备发现降级（fido_hid_manifest → FIDO_ERR_INTERNAL）并标注需人工确认，后续版本接 OHOS HID-DDK 或 /dev/hidraw 直连。禁止单纯 return 0 空壳宏（R8）——每个 stub 必须保持 API 语义（失败路径）。
rec_command:            # 参考实现: archives/l/libfido2/1.15.0/patches/0004-src-stub-udev-libudev.h.patch + 0001-CMakeLists.txt.patch（HarmonyOS 分支: NFC_LINUX OFF + stub include dir）
rec_auto_fix:           false
rec_impl:               patch

fallback_priority:      2
fallback_approach:      runtime-libudev-stub-target
fallback_description:   将 stub-udev.c 编译为独立 .a（如 hidapi 先例 507ce00c98 曾尝试）——不推荐：需干预上游目标链接（target_sources/ar 合并），5 轮修复仍未收敛（pr-547 回滚教训）。仅在源码树不可加头文件时考虑。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       #define udev_new\(\)[[:space:]]*return 0
forbid_1_reason:        把指针型 API stub 成返回 0（非 NULL）会造成调用方误判设备枚举成功、解引用 0x0 崩溃；stub 必须保持失败语义（NULL/-1）。
forbid_1_consequence:   运行时段错误或静默错误行为，比编译失败更难排查。
forbid_2_pattern:       patches 中仅 #ifdef __OHOS__\s*return 0;\s*#endif
forbid_2_reason:        R8 空壳守卫无实质逻辑；正确做法是提供完整 API 面的 stub + R40 功能降级声明。

# ═══ Layer 4: 原则引用 ═══
principles:             P010, P012

