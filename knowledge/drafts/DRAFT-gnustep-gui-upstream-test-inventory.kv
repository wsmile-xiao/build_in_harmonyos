#====================================================================
# DRAFT-gnustep-gui-upstream-test-inventory
# Record the discovered gnustep-gui upstream Tests/ inventory separately from the consumer gate
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: gnustep-gui 0.32.0 HarmonyOS PC 适配（PR #7095）
#====================================================================

id:                     DRAFT-gnustep-gui-upstream-test-inventory
trigger_tool:           tar|conan|ctest|make
phase:                  analysis|testing|reporting
error_signature:        upstream_tests_discovered.*true|no such test|0/0|inventory.*not recorded|TestInfo|GNUmakefile

severity:               3
category:               test-inventory|reporting|appkit|gnustep
match_keywords:         Tests/gui, Objective-C test sources, TestInfo, GNUmakefile,
                         upstream inventory, deferred tests, AppKit, test_package,
                         discovered-not-run-locally

title:                  Record gnustep-gui upstream Tests/ inventory separately from the package consumer gate
root_cause: >
  The gnustep-gui release tarball contains a real upstream Tests/ tree, but it is split across
  multiple file types and execution styles: Objective-C source tests, TestInfo descriptors, and
  GNUmakefile entry points. On a single-package HarmonyOS gate, not all of those can be executed
  locally, so the discovered inventory must be recorded explicitly instead of collapsing into
  an opaque pass/skip total.
affected_scope: >
  AppKit libraries with an upstream Tests/ tree whose inventory is easier to discover from the
  source tarball than to execute on the current target runtime.
verification_cmd: >
  Scan the release tarball Tests/ tree; record 30 Objective-C sources, 19 TestInfo files, and
  2 GNUmakefiles in the package manifest; keep the consumer smoke test separate.

rec_priority:           1
rec_approach:           split-discovered-upstream-inventory-from-consumer-gate
rec_description: >
  Keep upstream discovery and package-consumer validation as separate counts. Record the exact
  upstream Tests/ inventory in notes and MANIFEST.yml, distinguish discovered from executed, and
  keep the AppKit smoke consumer as an additional package-level test rather than mixing it into
  the upstream test tally.
rec_command: >
  update notes.md and test_package/MANIFEST.yml with the discovered Tests/ inventory counts,
  then run the AppKit consumer smoke test independently.
rec_auto_fix:           false
rec_impl:               test-inventory|reporting

fallback_priority:      2
fallback_approach:      mark-upstream-test-coverage-as-discovered-not-run-locally
fallback_description: >
  If the target runtime cannot run the upstream AppKit tests in this turn, record them as
  discovered inventory with reasons for deferral instead of inflating the pass count.
fallback_command:       record the discovered Tests/ inventory and defer the unavailable AppKit suite explicitly
fallback_auto_fix:      false
fallback_impl:          deferred-upstream-tests

forbid_1_pattern:       claim.*30.*19.*2.*passed|count.*consumer.*as.*upstream|0/0.*without inventory
forbid_1_reason:        A discovered inventory is not the same thing as a passed inventory.
forbid_1_consequence:   Reviewers cannot tell what was discovered, what was executed, and what remains deferred.

principles:             P016
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

