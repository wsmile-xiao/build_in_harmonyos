caused_by:              [E419]
similar_to:             [E419, DRAFT-8543-plain-char-eof-sentinel-infinite-loop, draft-9645-polyseed-aarch64-char-signed-utf8-lazy]
conflicts_with:         []
prerequisite_of:        []
