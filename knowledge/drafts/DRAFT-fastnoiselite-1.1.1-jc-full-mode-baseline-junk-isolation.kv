#====================================================================
# DRAFT-fastnoiselite-1.1.1-jc-full-mode-baseline-junk-isolation
#    W3/JC 全仓 full 模式命中其他库基线垃圾文件（cloog/kics）
#    → git rm --cached 临时取消跟踪 + restore 原样恢复的隔离手法
# 来源: fastnoiselite 1.1.1 适配（Path B 知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-fastnoiselite-1.1.1-jc-full-mode-baseline-junk-isolation
trigger_tool:           finish|build_and_test.sh|junk_check.sh
phase:                  CI/PR-validation|packaging
error_signature:        Junk Files: \d+|
                         JC_RESULT=fail|
                         JC1: \d+ 个运行时状态文件被跟踪|
                         JC5: \d+ 个 archives 下未登记的隐藏文件|
                         blocked_by_JC

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               packaging, junk-check, baseline, isolation, git, W3
match_keywords:         junk_check, JC1, JC5, build-closed, staging-verified,
                        full 模式, git ls-files, 基线垃圾, 隔离复验,
                        git rm --cached, git restore --staged, W3, blocked_by_JC
title:                  W3/JC 全仓 full 模式命中其他库基线垃圾文件：JC 检查的是 git 索引跟踪状态，必须 git rm --cached 临时取消跟踪再 restore 原样恢复

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             junk_check.sh 在本地无 PR diff 时回退 full 模式，用
                        git ls-files（索引跟踪状态）全仓扫描；其他库已合入
                        origin/main 的空运行时标记文件（.build-closed /
                        .staging-verified，blob e69de29b=空 blob）被全仓命中，
                        阻塞当前库的 W3 本地 CI 模拟。注意：JC 读的是 git
                        索引（ls-files），不是工作区文件——单纯 mv 工作区文件
                        无效，文件仍在索引中。
affected_scope:         任何仓库 main 基线已含其他库运行时标记文件、本地 W3
                        build_and_test.sh 走 full 模式全仓扫描的场景。
verification_cmd:       git ls-files archives/<l>/<lib>/<ver>/ 2>/dev/null | grep -E '\.(build-closed|staging-verified)'；
                        复跑 build_and_test.sh 观察 JC_RESULT

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           git-rm-cached-isolation
rec_description:        基线隔离复验四步：
                        1) 记录精确路径与隔离前 SHA-256（空文件为
                           e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855）；
                        2) git rm --cached <路径> 临时取消跟踪（文件保留在工作区，
                           并从索引移除，ls-files 不再命中）；
                        3) 复跑受影响门禁（finish W3 build_and_test.sh）；
                        4) git restore --staged <路径> 原样恢复，核对恢复后
                           SHA-256 与隔离前一致、git status 无该路径变更、
                           当前库 diff/staged/PR 不含该路径。
                        文件内容不得修改、提交或写入知识库/PR。
rec_command:            sha256sum <paths> && git rm --cached <paths> && \\
                        python3 scripts/ohc-run.py finish <lib> <ver> published && \\
                        git restore --staged <paths> && sha256sum <paths> && \\
                        git status --porcelain | grep -E '<lib>'
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:      worktree-recreate
fallback_description:   若隔离后仍有其他基线垃圾命中，可考虑基于最新 origin/main
                        重建 worktree 并逐一核对基线文件；仅在确认文件确属
                        "提交前已存在、其他库、空标记"时使用本方案。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       git add -A|git checkout \.|git reset --hard
forbid_1_reason:        全量 add 会把隔离状态或误改文件带进 commit；硬重置会丢失身份
forbid_1_consequence:   other_library_diff / baseline_diff 命中，PR 被拒

# ═══ Layer 4: 原则引用 ═══
principles:             W3, W2

# ═══ 关系图 (Relations) ═══
causes:
caused_by:
similar_to:             E256
conflicts_with:
prerequisite_of:

