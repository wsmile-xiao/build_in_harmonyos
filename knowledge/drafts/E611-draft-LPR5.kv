#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E611.kv，填写各字段
# 对应的人类文档: doc/E611.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E611
trigger_tool: autoreconf|automake|aclocal
phase: configuration
error_signature: Can't load '.*perl5/5\.42\.2/.*auto/Cwd/Cwd\.so' for module Cwd|Error loading shared library .*Cwd\.so: Permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: autotools, conan, toolchain, perl
match_keywords: Can't load, Cwd.so, Permission denied, PERL5LIB, autoreconf, automake, HNP perl, autoconf 制品, ABI 不匹配, VirtualBuildEnv
title: autoconf 与 automake 制品的 perl 依赖互相冲突：宿主 perl 被注入包内 5.42.2 的 PERL5LIB 后加载 Cwd.so 失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: autoconf/2.72 制品的 .autoreconf-real shebang 指向包内 perl/5.42.2、并由 buildenv 导出指向该包的 PERL5LIB；automake/1.18 制品的 .automake-real shebang 却写死宿主 /data/service/hnp/bin/perl。profile 的 buildenv 把 /data/service/hnp/bin 前插进 PATH，于是 autoconf/automake 脚本都用宿主 perl（5.42.0）去加载 5.42.2 的 XS 模块 → Cwd.so 加载失败，autoreconf/aclocal/automake 全线崩溃（把 autoconf 也 tool_requires 进图才会触发）
affected_scope: 所有需要 automake + autoconf 同时自举的 autotools 配方（CI 与本机一致复现）
verification_cmd: conan install --tool-requires=automake/1.18 --tool-requires=libtool/2.5.4 -pr=ohos-aarch64 && grep PERL5LIB <out>/conanbuildenv-*.sh

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: tool-require-only-automake-libtool-use-host-autoconf
rec_description: 不要 tool_requires autoconf：宿主 HNP 已提供 autoconf/autoreconf 2.72（与 69/78 既有自举配方口径一致），只 tool_requires automake + libtool，PERL5LIB 里就只剩 automake 自己的模块目录，宿主 perl 自洽。若必须引入 autoconf 制品，则需同时把 PATH 首位指向其配套 perl 包并显式管住 PERL5LIB
rec_command: self.tool_requires('automake/1.18'); self.tool_requires('libtool/2.5.4')   # 不要 autoconf/2.72
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach:
fallback_description: 如需完全制品化的 autoconf，先修 autoconf/automake 两个制品的 perl 绑定（shebang 改 env perl 或统一 perl 依赖），再恢复 tool_requires
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

