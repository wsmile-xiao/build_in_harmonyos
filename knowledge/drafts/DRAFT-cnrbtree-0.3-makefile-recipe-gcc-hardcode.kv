#====================================================================
# Draft knowledge entry - cnrbtree 0.3 raw Makefile recipe-embedded gcc hardcode
# Source package: cnrbtree/0.3
#====================================================================

id:                     DRAFT-cnrbtree-0.3-makefile-recipe-gcc-hardcode
trigger_tool:           make
phase:                  compilation
error_signature:        make: gcc: No such file or directory|No such file or directory

severity:               2
category:               build-system|make|toolchain
match_keywords:         Makefile, gcc, recipe, hardcoded compiler, clang-only, OHOS, raw Makefile, no configure, no CC variable, compiler override, $(CC), make CC=, GNU make

title:                  Raw Makefile embedding "gcc" inside recipe bodies (no CC variable) fails on OHOS (clang-only); rewrite recipe to $(CC) — command-line CC= override alone is insufficient

root_cause:             >
    Some raw-Makefile projects do not declare the compiler in a Makefile
    variable (e.g. `CC := g++`); instead the compile rule calls the compiler
    literally inside the recipe body, e.g. cnrbtree 0.3's Makefile:

        testtree : testtree.c
            gcc -o $@ $^ -Os -g -Wall ... -fsanitize=address,undefined

        simple : simple.c
            gcc -o $@ $^ -Os -g

    The OHOS PC toolchain ships clang/clang++ only (no gcc), so `make` fails
    immediately: `make: gcc: No such file or directory`.
    Because the compiler name is embedded in the recipe (and no CC variable
    exists anywhere), the GNU-make command-line override `make CC=clang`
    has NO effect — the recipe still calls `gcc` literally. This differs from
    projects that declare `CC := g++` as a variable (see
    DRAFT-cohomcalg-0.32-makefile-gxx-override), where a command-line
    override works.

affected_scope:         Any raw-Makefile (no configure/CMake) C/C++ project whose recipe
                        bodies hardcode the compiler name directly (rather than via a
                        CC/CXX variable), adapted to clang-only toolchains (OHOS PC).

verification_cmd:       |
  cd <worktree> && make clean && make CC=clang testtree simple && ./testtree && ./simple

rec_priority:           1
rec_approach:           make-recipe-cc-variable-rewrite
rec_description: >
    Edit the Makefile recipe to reference $(CC) instead of the literal compiler
    name (one edit per rule), then build with `make CC=clang` (or the Conan
    toolchain compiler per R33 — resolve from tools.build:compiler_executables,
    never a bare ${CC} shell variable). A minimal patch is appropriate; the
    upstream recipe flags (e.g. -fsanitize=address,undefined) must be kept.
    -j1 may be required on HMDFS/SELinux workers (make jobserver mkfifo denied).
rec_command:            |
  make CC=clang testtree simple
rec_auto_fix:           true
rec_impl:               patch-makefile-recipe

fallback_priority:      2
fallback_approach:      make-cmdline-cc-override (cohomcalg draft) — only works when
                        the Makefile declares CC/CXX as variables; NOT applicable to
                        recipe-embedded compiler names

# Relations
similar_to:             DRAFT-cohomcalg-0.32-makefile-gxx-override
caused_by:              ""
prerequisite_of:        ""
conflicts_with:         ""

