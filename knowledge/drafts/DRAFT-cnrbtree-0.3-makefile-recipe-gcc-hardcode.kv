source_package:         cnrbtree/0.3
source_event_date:      2026-09-22
verified:               true
verification_evidence:  |
  make CC=clang testtree simple -> rc=0; ./testtree rc=0; ./simple rc=0;
  W3 build_and_test.sh pass; conan create + test_package 1032 assertions PASS;
  conan-verify G1/G2/G3/G4 pass. Patch: archives/c/cnrbtree/0.3/patches/0001-Makefile.patch
