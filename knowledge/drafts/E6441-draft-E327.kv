#====================================================================
# E6441-draft-E327 —— test_package 自己解析 tested_reference_str 取版本/名字：
#   conan-verify（--user/--channel）能过，W3/CI（无 user/channel）引用带 #revision%timestamp 而失败
#
# 对应文档: knowledge/drafts/E6441-draft-E327.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。正式编号由 graph promote 分配。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E6441-draft-E327
source_lib:             shml 1.1.0
trigger_tool:           conan|python
phase:                  testing
error_signature:        [0-9][0-9A-Za-z._+-]*#[0-9a-f]{32}%[0-9]+\.[0-9]+|\(test package\): tested reference: .*#[0-9a-f]{32}%[0-9]+

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, testing, version
match_keywords:         tested_reference_str, recipe revision, "#", "%", 时间戳, split("@"), split("/"), test_package, test(), conan create, --user, --channel, conan-verify, W3, build_and_test.sh, ref.version, dependencies
title:                  test_package 用字符串切分 tested_reference_str 取版本：conan-verify（带 user/channel）通过，W3/CI（无 user/channel）引用形如 name/ver#<recipe-revision>%<timestamp>，比对失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             两道本地门禁用的 `conan create` 形态不同：`conan-verify` 传 `--user=ohpcd --channel=stable`，test_package 里 `self.tested_reference_str` 是 `shml/1.1.0@ohpcd/stable`；W3 的 `ci/conan/build_and_test.sh` 与 CI 不传 user/channel，Conan 2.29.1 下它形如 `shml/1.1.0#<recipe-revision>%<timestamp>`（例 `shml/1.1.0#c64f229a68c0ef1a356bc467219d1d75%1790670804.0011215`，revision 与时间戳每次不同）。用 `self.tested_reference_str.split("/", 1)[1].split("@")[0]` 取版本，前一形态得 `1.1.0`，后一形态得 `1.1.0#<recipe-revision>%<timestamp>`，与包自报的版本（如 `shml version 1.1.0`）比对失败，test() 抛自定义异常，W3 判 conan create failed。因为 conan-verify 先跑且通过，问题只在 finish 的 W3 才暴露。
affected_scope:         所有在 test_package（build()/test()）里自行字符串切分 `self.tested_reference_str` 来取版本号（或用 rsplit/正则假设只有 @user/channel 后缀）的配方；只取名字的 `split("/")[0]` 写法不受影响
verification_cmd:       python3 -c 'r="shml/1.1.0#c64f229a68c0ef1a356bc467219d1d75%1790670804.0011215"; print(repr(r.split("/",1)[1].split("@")[0]))'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           read-version-from-dependency-ref-object
rec_description:        不要切分引用字符串。在 build()/test() 里用 `dep = self.dependencies[self.tested_reference_str]` 取被测包，再用 `str(dep.ref.version)`（名字用 `dep.ref.name`）获得版本/名字；需要比对包自报版本时用它做期望值。把 `self.output.info(f"tested reference: {self.tested_reference_str} (version {version})")` 留在日志里，两种 conan create 形态的取值一眼可对。修完后必须两种形态都本地实跑（conan-verify 的带 user/channel 形态 + W3 的无 user/channel 形态）。
rec_command:            version = str(self.dependencies[self.tested_reference_str].ref.version)
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      regex-strip-revision-and-timestamp
fallback_description:   拿不到 dependencies 对象时用正则截取版本段：`re.match(r"[^/]+/([^@#%]+)", ref).group(1)`（同时排除 @user/channel、#recipe-revision、%timestamp 三种后缀）。不要只处理其中一种。
fallback_command:       python3 -c 'import re; print(re.match(r"[^/]+/([^@#%]+)", "shml/1.1.0#c64f229a68c0ef1a356bc467219d1d75%1790670804.0011215").group(1))'
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       tested_reference_str\.split\(["']@["']\)|tested_reference_str\.split\(["']/["']\s*,\s*1\)\[1\]\.split|tested_reference_str\.rsplit\(["']@
forbid_1_reason:        只假设 `@user/channel` 一种后缀；W3/CI 形态的引用带 `#revision%timestamp`，切分结果含脏后缀。
forbid_1_consequence:   conan-verify 绿、W3 红，白白多一轮 finish；若漏到 CI 则整轮 CI 与机器人检视作废。

