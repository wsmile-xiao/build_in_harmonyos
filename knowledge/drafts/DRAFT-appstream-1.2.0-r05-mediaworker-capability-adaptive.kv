#====================================================================
# DRAFT-appstream-1.2.0-r05-mediaworker-capability-adaptive.kv
# 依赖特性能力缺失（libjxl/librsvg 不可得）时：mediaworker backend 初始化
# 能力化（必须格式硬性、可选格式降级警告），worker hello 上报 image-formats，
# 客户端 asc_media_supports_image_format 供调用方/测试按能力选择格式
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R05）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           appstream-compose mediaworker / asc_media
phase:                  runtime-init
error_signature:        The libvips library was built without PNG support|
                        libvips.*without JPEG-XL|libvips.*without SVG|
                        absolute requirement.*libvips|jxlsave_target.*not found
severity:               2
category:               capability, init, vips, worker, feature-detect, portability
match_keywords:         asw_image_backend_init, vips, libjxl, librsvg, image-formats,
                        asc_media_supports_image_format, feature detection, worker hello,
                        capability, OHOS
title:                  mediaworker 按依赖能力上报并自适应初始化/测试格式选择
root_cause:             上游把 PNG/JPEG-XL/SVG 全当 backend 硬性要求；制品仓 vips
                        特性矩阵缺 libjxl/librsvg（真实外部依赖），硬失败使整个
                        worker 不可用，即使核心格式 PNG/JPEG 可用。
affected_scope:         mediaworker/IPC 服务消费具备部分能力依赖的库（vips 等）。
verification_cmd:       conan create appstream 1.2.0 -pr:h=ohos-aarch64 -pr:b=ohos-aarch64
                        --build=missing；as-test_compose 18/18；harmonyos_compose_test
                        supports(png)=TRUE / supports(jxl)=FALSE。
rec_priority:           1
rec_approach:           backend-capability-init + hello-capability-report
rec_description:        backend 初始化把必需格式（PNG/JPEG）硬性、可选格式
                        （JXL/SVG）降级为 g_message 警告；worker handshake 上报
                        image-formats（asw_image_supported_format_names 实测）；
                        客户端解析并暴露 asc_media_supports_image_format()；
                        测试/调用方按能力选格式（JXL 缺时回退 PNG）。
rec_command:            |
  if (vips_type_find ("VipsForeignLoad", "pngload_buffer") == 0) { /* 硬失败 */ }
  if (vips_type_find ("VipsForeignLoad", "jxlload_buffer") == 0)
      g_message ("libvips was built without JPEG-XL (libjxl) support; ...");
  /* worker hello: g_variant_builder_add (&pb, "{sv}", "image-formats", ...) */
  /* client: asc_media_supports_image_format (media, "png") */
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       g_test_skip.*jxl.*without.*reason
forbid_1_reason:        测试跳过须有真实能力缺失证据且与上游 skip 模式一致，不可伪造通过
principles:             R6, R8
causes:                 []
caused_by:              vips 特性矩阵（制品仓 libjxl/librsvg 不可得）
similar_to:             []
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-r05-mediaworker-capability-adaptive.md
last_updated:           2026-09-25
source_event:           appstream-1.2.0 R05（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  2
metrics_fail_count:     0
metrics_confidence:     0.9