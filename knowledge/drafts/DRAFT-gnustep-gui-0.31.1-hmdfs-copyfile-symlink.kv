#====================================================================
# DRAFT-gnustep-gui-0.31.1-hmdfs-copyfile-symlink
# hmdfs: 用 copyfile 生成 .so 别名，MKDIRS 覆写 mkinstalldirs exec 受限
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: gnustep-gui 0.31.1 HarmonyOS PC 适配（PR #7408）
#====================================================================

id:                     DRAFT-gnustep-gui-0.31.1-hmdfs-copyfile-symlink
trigger_tool:           conan|make|gnustep-make|shell
phase:                  build|install|packaging
error_signature:        ln -s.*Permission denied|Permission denied.*ln|mkinstalldirs|exec.*denied|ln: failed to create symbolic link|cannot create symlink

severity:               3
category:               ohos|hmdfs|filesystem|permissions|conan|packaging|make
match_keywords:         hmdfs, ln -s, symbolic link, Permission denied, copyfile, MKDIRS, mkinstalldirs, mkdir -p, conan packaging
title:                  On hmdfs, generate .so version aliases with copyfile and override GNUstep mkinstalldirs with MKDIRS='mkdir -p'
root_cause:             The OHOS hmdfs filesystem restricts symlink creation
                        (`ln -s` -> Permission denied) for subprocesses spawned inside
                        Conan. GNUstep's packaging step also calls the `mkinstalldirs`
                        script which is exec-restricted on hmdfs. Symlink-based `.so`
                        version aliases therefore cannot be produced by `ln -s`, and the
                        stock mkinstalldirs cannot run.
affected_scope:         GNUstep / autotools / shared-library packages built through Conan on
                        OHOS where the build root sits on hmdfs and packaging emits versioned
                        .so aliases.
verification_cmd:       After `conan create`, verify the package folder contains
                        libgnustep-gui.so.0.31.1 plus a working libgnustep-gui.so alias
                        (regular file copy), and that `conan create` passes the packaging step.

rec_priority:           1
rec_approach:           copyfile-alias-and-mkdirs-override
rec_description:        Replace `ln -s` with a file-copy of the versioned .so to the
                        unversioned alias (copyfile) to avoid hmdfs symlink restrictions;
                        override GNUstep's mkinstalldirs script by passing
                        MKDIRS='mkdir -p' so directory creation does not execute the
                        restricted helper script.
rec_command:            _link via copyfile; make ... MKDIRS='mkdir -p'
rec_auto_fix:           false
rec_impl:               conan-recipe-packaging

fallback_priority:      2
fallback_approach:      pre-stage-libraries
fallback_description:   Pre-stage libraries into the package layout before the GNUstep
                        install step, so the packaging step never needs to create symlinks
                        or run mkinstalldirs.
fallback_command:       stage .so files into <pkg>/lib then finalize packaging manually
fallback_auto_fix:      false
fallback_impl:          conan-recipe-packaging

forbid_1_pattern:       ln -s.*\.so|os\.symlink
forbid_1_reason:        hmdfs denies symlink creation for Conan subprocesses.
forbid_1_consequence:   Packaging step fails with Permission denied; .so alias missing.
forbid_2_pattern:       run.*mkinstalldirs|no.*MKDIRS
forbid_2_reason:        mkinstalldirs is exec-restricted on hmdfs.
forbid_2_consequence:   Install/packaging aborts before libraries are staged.

principles:             P013,P014
causes:                 []
caused_by:              []
similar_to:             E337
conflicts_with:         []
prerequisite_of:        []

