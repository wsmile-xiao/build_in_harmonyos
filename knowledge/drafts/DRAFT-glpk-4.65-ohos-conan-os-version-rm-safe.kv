#====================================================================
# DRAFT-glpk-4.65-ohos-conan-os-version-rm-safe — OHOS conan profile
#   的 os.version 子设置在配方 configure() 中 rm_safe 以通过 package_id 校验
# 对应人类文档: knowledge/drafts/DRAFT-glpk-4.65-ohos-conan-os-version-rm-safe.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: glpk 4.65 适配 HarmonyOS PC（conan create -pr:h/-pr:b=ohos-aarch64）
#          既有实证: 本仓 8+ 配方（afdko/au/expect/fcheck/loom/mdurl/
#          msgpack-cxx/astc-encoder）隐式使用同款 rm_safe 但未沉淀正式条目
#====================================================================

id:                     DRAFT-glpk-4.65-ohos-conan-os-version-rm-safe
trigger_tool:           conan
phase:                  packaging|verification
error_signature:        Invalid: 'settings\.os\.version' value not defined|
                         settings\.os\.version value not defined|
                         There are invalid packages

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               ohos, conan, packaging, settings
match_keywords:         os.version, rm_safe, conan create, Invalid, OHOS profile,
                         package_id, settings, value not defined
title:                  OHOS conan profile 的 os.version 子设置在配方 configure() 中 rm_safe 以修复 package_id 无效

# ═══ Layer 2: 诊断层 ═══
root_cause:             OHOS 配置文件 ci/conan/profiles/ohos-aarch64 设置
                         os.version=6.0 且 settings.yml 为 OHOS 定义了 version 子
                         设置；当配方 settings 声明未含 os.version 时，conan 计算
                         package_id 期间对 settings 树做 validate()，os.version
                         节点值缺失（None 不在定义列表内）即抛
                         "Invalid: 'settings.os.version' value not defined"。
                         实测从 profile 删除 os.version 行仍复现（settings.yml
                         定义仍在），故必须从配方侧 rm_safe。
affected_scope:         所有在含 os.version 的 OHOS profile 下执行 conan create /
                         conan-verify 的配方；registry 依赖（如 gmp/6.3.0）在相同
                         交互下也可能失配，需同法处理
verification_cmd:       conan create archives/g/glpk/4.65 \
                         -pr:h=ci/conan/profiles/ohos-aarch64 \
                         -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing \
                         && python3 scripts/ohc-run.py conan-verify glpk 4.65
                         # 期望: 配方 configure() 含 rm_safe 后 package_id 可计算、
                         # conan create 与 verify G1-G4 全绿（glpk 4.65 实测通过）

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           rm-safe-os-version-in-configure
rec_description:        在配方 configure() 中加入守卫后 rm_safe("os.version")：
                         仅当 os 存在且 os 下确有 version 子设置时删除之，使
                         package_id 校验与依赖图计算不再触发 os.version 无效，
                         又保证 Windows 等无该子设置平台不受影响。
rec_command:            def configure(self):
                            if hasattr(self.settings, "os") and hasattr(self.settings.os, "version"):
                                self.settings.rm_safe("os.version")
rec_auto_fix:           true

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:
caused_by:
similar_to:
conflicts_with:
prerequisite_of:

