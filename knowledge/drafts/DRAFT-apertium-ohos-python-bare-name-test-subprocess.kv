#====================================================================
# DRAFT-apertium-ohos-python-bare-name-test-subprocess — apertium 3.9.12
#   上游 Python unittest 套件内嵌裸名 Popen(["python3"...])/Popen(["cat"...])
#   在 OHOS worker 上 FileNotFoundError（E405 场景在上游测试源码中的变体）
# 触发事件: apertium 3.9.12 HarmonyOS PC 适配（PR #5126，CI 构建 #41152）
# 主从明确: E405（裸名命令不搜 PATH）为根条目；本条目补充
#   "上游测试源码内嵌裸名 subprocess 调用"这一触发面与修复手法
#====================================================================

id:                     DRAFT-apertium-ohos-python-bare-name-test-subprocess
trigger_tool:           python|test
phase:                  testing|build
error_signature:        FileNotFoundError: \[Errno 2\] No such file or directory: 'python3'|
                         FileNotFoundError: \[Errno 2\] No such file or directory: 'cat'|
                         unittest.*FAILED \(errors=[0-9]+\).*posix_spawn|
                         run_tests\.py.*failed with exit code 1

severity:               2
category:               ohos|python|testing|posix_spawn
match_keywords:         Popen, bare-name, python3, cat, FileNotFoundError, Errno 2,
                         posix_spawn, _IS_HARMONYOS, run_tests.py, unittest,
                         tests/adaptdocx, PATH, shutil.which, 绝对路径, wrapper,
                         subprocess, upstream test suite, apertium

title:                  上游 Python 测试套件内嵌裸名 Popen 调用在 OHOS worker 上 FileNotFoundError（posix_spawn 不搜 PATH）

root_cause:             HarmonyOS 的 hnp python3.12 subprocess 强制走 os.posix_spawn()（非
                         posix_spawnp），裸名命令不做 PATH 搜索直接抛 FileNotFoundError Errno 2
                         （E405 根因）。本条目的补充面：apertium 上游
                         tests/adaptdocx/__init__.py 源码内嵌 Popen(["python3", ...]) 与
                         Popen(["cat", ...]) 裸名调用——54 个用例中 52 个经
                         apertium-* 相对路径（可解析）通过，仅 2 个 adaptdocx 用例命中裸名
                         而失败。本地开发机 python3（~/usr/local/bin）subprocess 走
                         fork+exec 正常搜 PATH，故本地全绿、PR CI 红——典型本地/CI 环境差异。

affected_scope:         上游测试源码（非配方代码）内嵌裸名 subprocess 调用的 Python unittest
                         套件；conanfile.py build() 中以 subprocess 运行上游 run_tests.py 的
                         autotools 项目

rec_priority:           1
rec_approach:           env-path-prefix-via-test-run-env
rec_description: >
  不修改上游测试源码、不打补丁：在 conanfile.py 运行 run_tests.py 时，于 env 中
  把一个含 python3/cat 符号链接（或 shell wrapper）的临时 bin 目录前置到 PATH，
  使裸名调用解析到绝对路径目标。python3 用 shutil.which() 解析（失败回退
  /storage/Users/currentUser/usr/local/bin/python3），cat 在 OHOS worker 属 toybox
  /system/bin/cat，仅 python3 需注入。此法同样适用于测试源码硬编码其它裸名工具
  （sed/diff/grep）的场景，且保持补丁面为零。
rec_command: >
  import os, shutil
  py3 = shutil.which("python3") or "/storage/Users/currentUser/usr/local/bin/python3"
  shim = os.path.join(build_dir, ".test-shim-bin"); os.makedirs(shim, exist_ok=True)
  link = os.path.join(shim, "python3")
  if not os.path.exists(link): os.symlink(py3, link)
  env = {**os.environ, "PATH": shim + os.pathsep + os.environ.get("PATH", "")}
  subprocess.run(["python3", "tests/run_tests.py"], cwd=build_dir, env=env, ...)

rec_auto_fix:           false
rec_impl:               conan-recipe-env-shim

forbid_1_pattern:       patch.*tests/adaptdocx.*python3
forbid_1_reason:        为测试脚本裸名调用打源码补丁会偏离上游、增加维护面；
                        env shim 同样可靠且零补丁
forbid_1_consequence:   升级版本时补丁冲突、review 负担、R8 补丁规范风险

principles:             先复现再修（CI 日志中的 FileNotFoundError 精确到裸名）;
                        测试兼容优先 env/绝对路径而非改上游源码（P013）; E405 为根条目

related_docs:           doc/E405.md, doc/E055.md, doc/E106.md

source_event:           archives/a/apertium/3.9.12 PR#5126 CI#41152
first_seen_project:     apertium/3.9.12
last_updated:           2026-09-16
