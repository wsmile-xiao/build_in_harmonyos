#====================================================================
# DRAFT-iowow-1.4.18-cursor-direction-block-chain
#   iowow 1.4.x 块链游标方向与 1.5.x 相反：升序遍历须 AFTER_LAST+PREV
# 来源: iowow 1.4.18 适配 HarmonyOS PC（PR 关联）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-iowow-1.4.18-cursor-direction-block-chain
trigger_tool:           iowow|iwkv|conan
phase:                  verification|test-writing

error_signature:        cursor starts at smallest key.*FAIL|
                        iwkv_cursor_to_next.*largest|
                        cursor.*sorted order.*fail|
                        游标.*降序|游标.*方向

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               api-behavior, version-difference, iowow, kv-store, testing
match_keywords:         iowow, iwkv, cursor, IWKV_CURSOR_BEFORE_FIRST,
                        IWKV_CURSOR_AFTER_LAST, iwkv_cursor_to_next,
                        iwkv_cursor_to_prev, sorted order, ascending,
                        descending, block chain, 1.4.18, skiplist
title:                  iowow 1.4.x 游标升序遍历用 AFTER_LAST+PREV（BEFORE_FIRST+NEXT 是降序，与 1.5.x 相反）
prescan_pattern:        iwkv_cursor_(open|to_next|to_prev)|IWKV_CURSOR_(BEFORE_FIRST|AFTER_LAST)
prescan_globs:          **/*.c, **/*.h

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             1.4.x 块链游标 _cursor_to_lr（src/kv/iwkv.c:2763）：
                        BEFORE_FIRST 从索引尾部（KVBLK_IDXNUM-1）起，NEXT 沿
                        块链向键递减方向；AFTER_LAST 从链头（dbaddr=-1）起，
                        PREV 向键递增方向。1.5.x 重写后两方向均反转。上游
                        iwkv_test1.c L490-539 按各自版本语义断言，两边测试
                        都 PASS——版本行为差异而非 bug。
affected_scope:         所有 iowow 1.4.x 的游标消费者；从 1.5.x 降级/迁移到
                        1.4.x 的代码与测试；对 1.4.x 写有序遍历断言的场景。

# ═══ Layer 3: 方案层 (Solution) ═══
rec_priority:           1
rec_approach:           after-last-prev-ascending
rec_description:        升序遍历用 iwkv_cursor_open(db,&cur,IWKV_CURSOR_AFTER_LAST)
                        + iwkv_cursor_to_prev 循环；降序用 BEFORE_FIRST+NEXT。
                        不改库源码；断言方向按版本对照上游 iwkv_test1.c 期望
                        确认。游标返回 k/v 是堆分配，循环内 iwkv_kv_dispose()。
rec_command:            iwkv_cursor_open(db,&cur,IWKV_CURSOR_AFTER_LAST); while(iwkv_cursor_to_prev(cur,&k,&v)==0){ /* ascending */ iwkv_kv_dispose(db,&k,&v); }
rec_auto_fix:           false
rec_impl:               test-assertion-direction

# ═══ 验证与边界 ═══
verification_cmd:       test_package 游标断言（30/30）+ 独立 dbg_cursor.c 实测
verification_result:    30/30 PASS；方向差异两次复现；上游 23 执行器全 PASS
valid_boundary:         iowow 1.4.x 块链游标；不适用 1.5.x（方向已反）；
                        iwkv_get/put/del 非游标 API 无版本方向差异
similar_to:
prerequisite_of:
conflicts_with:

last_updated:           2026-10-09
authors:                AtomCode
