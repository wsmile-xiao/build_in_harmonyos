#====================================================================
# DRAFT-ohos-mqueue-stub — OHOS musl 只定义 struct mq_attr、不声明 POSIX
#   消息队列函数（mq_open/mq_getattr/mq_receive/mq_unlink），无消息队列
#   运行时——musl 兼容头补 stub（返回 -1 + ENOSYS）
# 对应人类文档: knowledge/drafts/DRAFT-ohos-mqueue-stub.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR systemd/261 适配 HarmonyOS PC（sd-daemon/socket-util/clean-ipc
#           编译报 mq_getattr/mq_receive/mq_unlink/mq_open 未声明）
#====================================================================

id:                     DRAFT-ohos-mqueue-stub
trigger_tool:           cc|clang|make|meson
phase:                  compilation
error_signature:        call to undeclared function 'mq_|
                         use of undeclared identifier 'mq_|
                         mq_open.*undeclared|mq_receive.*undeclared|
                         mq_getattr.*undeclared|mq_unlink.*undeclared

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               ohos, musl, mqueue, posix, stub, compilation, portability
match_keywords:         mq_open, mq_receive, mq_unlink, mq_getattr, mq_send,
                         struct mq_attr, mqd_t, mqueue.h, POSIX message queue,
                         musl, undeclared, ENOSYS
title:                  OHOS musl 只定义 struct mq_attr、不声明 POSIX 消息队列
                         函数（无 mqueue 运行时）——musl 兼容头补 stub（ENOSYS）

# ═══ Layer 2: 诊断层 ═══
root_cause:             OHOS musl 的 <mqueue.h> 只定义 struct mq_attr（mq_flags/
                         mq_maxmsg/mq_msgsize/mq_curmsgs）与 mqd_t 类型，**不声明**
                         任何 POSIX 消息队列函数（mq_open/mq_close/mq_getattr/
                         mq_receive/mq_send/mq_unlink 等）——OHOS 无消息队列运行时。
                         使用 mq 接口的库（systemd 的 sd-daemon 的 sd_is_mq、
                         socket-util 的 mq_receive、clean-ipc 的 mq_unlink、core 的
                         mq_open）编译报 "call to undeclared function"
affected_scope:         所有在 OHOS 上编译、使用 POSIX 消息队列接口的库
                         （systemd 即此类）
verification_cmd:       conan create archives/s/systemd/261 --build=missing
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 覆盖前 mq_* 系列报 undeclared；覆盖后编译通过

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           musl-mqueue-stub
rec_description:        在 musl 兼容头（src/include/musl/mqueue.h）include_next
                         <mqueue.h> 后补 mq_* 函数 stub：返回 -1 + errno=ENOSYS
                         （OHOS 无消息队列运行时，调用方如 sd_is_mq 据此走 -ENOSYS
                         表示不支持）。static inline 实现，零额外编译单元
rec_command:            (musl 兼容头 mqueue.h)
                         static inline mqd_t mq_open(const char *name, int oflag, ...) {
                             errno = ENOSYS; return (mqd_t)-1; }
                         static inline int mq_getattr(mqd_t mqdes, struct mq_attr *a) {
                             errno = ENOSYS; return -1; }
                         static inline ssize_t mq_receive(mqd_t mqdes, char *p, size_t n, unsigned int *prio) {
                             errno = ENOSYS; return -1; }
                         static inline int mq_unlink(const char *name) { errno = ENOSYS; return -1; }
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      source-patch-disable-mq-usage
fallback_description:   若 stub 不可行，patch 源码绕开 mq 调用——改动面大，不推荐
fallback_command:       (逐文件补丁)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       skip.*mq|禁用.*mq|N/A（未运行）
forbid_1_reason:        stub 可无损解决（OHOS 无 mqueue，ENOSYS 语义正确）；
                         跳过/禁用属"有可运行子集未尝试"
forbid_1_consequence:   被 rule 4 打回
forbid_2_pattern:       sed.*socket-util\.c.*删除.*mq_receive|patch.*去掉.*sd_is_mq
forbid_2_reason:        删功能治标不治本；stub 是标准做法
forbid_2_consequence:   换库/换平台即失效

# ═══ Layer 4: 原则引用 ═══
principles:

