#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: clang|configure
phase: compilation
error_signature: call to undeclared function 'setutxent'|call to undeclared function 'getutxent'|incompatible integer to pointer conversion assigning to 'utmp_t \*'|undefined symbol: setutxent

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform,headers,autotools
match_keywords: utmpx.h, setutxent, getutxent, HAVE_UTMPX_H, ac_cv_header_utmpx_h, utmp.h, w.c, procps
title: OHOS <utmpx.h> 只声明 struct utmpx：用 configure 缓存变量 ac_cv_header_utmpx_h=no 绕过（无平台宏）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS sysroot 存在 <utmpx.h>，AC_CHECK_HEADERS 判定 header 存在 → config.h 定义 HAVE_UTMPX_H；但该头只声明 struct utmpx，setutxent/getutxent/endutxent 等函数既未声明也未由 libc 导出，源码按 utmpx 分支编译即报隐式声明/类型转换错误。OHOS 的 <utmp.h> 提供可用的 stub API（setutent/getutent/endutent/utmpname，getutent() 返回 NULL）
affected_scope: procps-ng / libproc2 的 src/w.c、library/uptime.c 等使用 utmpx 分支的 autotools 项目
verification_cmd: clang -fsyntax-only -I. -Ilocal -Ilibrary/include -DHAVE_UTMPX_H src/w.c  # 复现报错

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: configure-cache-variable
rec_description: 配方 generate() 在 OHOS 下追加 configure 参数 ac_cv_header_utmpx_h=no，让源码走 <utmp.h> 分支；相比改源码插 __OHOS__ 守卫（E121 原方案），此写法不引入平台宏，满足 R8/PF5
rec_command: tc.configure_args.append('ac_cv_header_utmpx_h=no')  # 仅 self.settings.os == 'OHOS'
rec_auto_fix: false
rec_impl:               manual                      # 无内置实现：需在配方 generate() 中按平台追加 configure 缓存变量

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

