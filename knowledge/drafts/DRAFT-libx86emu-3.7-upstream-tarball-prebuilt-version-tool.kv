#====================================================================
# Draft: 上游发布 tarball 不含 git 派生版本文件（VERSION）且携带
#        异架构预编译版本工具（git2log）；aarch64 上运行报误导性的
#        "./git2log: No such file or directory"（文件存在、缺解释器），
#        Makefile 顶层 $(shell) 求值依赖它导致 VERSION 为空、产物命名错乱。
#        方案：构建前显式写 VERSION + 移除/规避预编译工具 + 直接构建
#        shared 目标；配方打包不依赖 coreutils install。
#====================================================================

id:                     DRAFT-LIBX86EMU-3.7-UPSTREAM-TARBALL-PREBUILT-VERSION-TOOL
trigger_tool:           make|git2log|perl|mktemp|conan|install
phase:                  build

error_signature:        \.\/git2log: No such file or directory|
                        cat: VERSION: No such file or directory|
                        cut: VERSION: No such file or directory|
                        make: .\/git2log: No such file or directory|
                        make: install: No such file or directory

severity:               3
category:               build-system, packaging, toolchain, portability, conan
match_keywords:         git2log, VERSION 缺失, 预编译二进制, 异架构, 解释器缺失,
                        No such file or directory, ELF, tarball 发布物,
                        Makefile 顶层 $(shell), libx86emu, aarch64, OHOS,
                        coreutils install, 纯 Makefile 工程, 无 configure

title:                  上游发布 tarball 缺 git 派生版本文件且携带异架构预编译版本工具（git2log）：aarch64 报误导性 "No such file or directory"，构建前显式写 VERSION 并移除工具、直接 make shared，配方手工打包

root_cause:             上游（如 wfeldt/libx86emu）用自研 git2log 从 git 历史生成
                        VERSION/changelog；GitHub tag tarball 不含 .git 与生成物
                        VERSION。同时 tarball 携带维护者平台（x86_64 Linux）预编译
                        的 git2log ELF。aarch64/OHOS 上执行该二进制因缺少
                        /lib64/ld-linux-x86-64.so.2 解释器，报与"文件不存在"相同的
                        "No such file or directory"（误导：文件明明存在）。
                        Makefile 顶层用 $(shell $(GIT2LOG) --version VERSION ; cat
                        VERSION) 求值 VERSION，git2log 失败使 VERSION 为空，.so 命名
                        （libx86emu.so.$(VERSION)）错乱；changelog 目标同样依赖
                        git2log 必失败。此外 OHOS 本机/CI 常缺 coreutils install，
                        make install 直接 "install: No such file or directory"。

rec_approach:           1) 构建前显式写入 VERSION（如 `echo 3.7 > VERSION`）；
                        2) 构建时移除/改名为预编译工具（`mv git2log git2log.upstream`），
                        Makefile 的 `[ -x ./git2log ]` 探测回退 `true`，VERSION 由
                        `cat VERSION` 确定，日志干净且行为跨环境确定；
                        3) 纯 Makefile 无 configure 工程：conan 配方不套 autotools
                        模板，build() 直接 `make shared CC=clang -j1`；
                        4) package() 不依赖 make install/install 命令，用 conan
                        copy + `ln -s` 手工落位 .so 与头文件；
                        5) 测试 harness 若硬编码 mktemp /tmp（只读），等价替换为
                        `$ENV{TMPDIR} || "/tmp"`（CI /tmp 可写时默认 /tmp，本地
                        TMPDIR 生效）。

affected_scope:         任何发布 tarball 缺构建期 git 派生版本文件、或随包分发
                        异架构预编译辅助工具、或纯 Makefile 无 configure 的 C 库。
                        已验证实例：libx86emu 3.7（上游 60 例测试 42/42 通过，
                        conan create ohos-aarch64 G2/L0-L5 全过）。

verification_cmd:       make shared CC=clang -j1 && ls libx86emu.so.3.7
                        conan create archives/l/libx86emu/3.7 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing

rec_priority:           2
