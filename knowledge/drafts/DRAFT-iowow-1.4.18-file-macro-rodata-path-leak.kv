#====================================================================
# DRAFT-iowow-1.4.18-file-macro-rodata-path-leak
#   Release 无 -g 时 __FILE__ 日志宏把构建机绝对路径固化进 .rodata：
#   CMake CMAKE_C_FLAGS 注入 -ffile-prefix-map（单映射 source）
# 来源: iowow 1.4.18 适配 HarmonyOS PC（PR 关联）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-iowow-1.4.18-file-macro-rodata-path-leak
trigger_tool:           cmake|conan|clang|strings
phase:                  packaging|verification

error_signature:        strings.*\.a.*\|.*grep /storage|
                        strings.*\|.*grep /home|__FILE__.*rodata|
                        宿主路径.*静态库|host path.*static lib

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               packaging, reproducibility, cmake, recipe, ohos
match_keywords:         __FILE__, rodata, .rodata.str1.1, prefix-map,
                        -ffile-prefix-map, CMAKE_C_FLAGS, strings scan,
                        absolute path, host path leak, Release, no debug info,
                        宿主路径, 构建路径泄漏, 可重现构建, 日志宏
title:                  __FILE__ 日志宏在 Release（无 -g）下仍把 conan 缓存绝对路径固化进 .rodata → CMake 注入 -ffile-prefix-map 单映射 source
prescan_pattern:        __FILE__|IWLOG|LOG_.*__FILE__
prescan_globs:          **/*.c, **/*.h, **/*.cpp

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游日志/断言宏引用 __FILE__（如 iowow IWLOG），CMake
                        编译源文件用绝对路径（clang -c /abs/path/iwstw.c），
                        宏展开把 Conan 缓存路径（~/.conan2/p/b/<hash>/b/...）
                        固化进 .rodata.str1.1。Release 无 -g 时 DWARF 段不
                        存在，但 rodata 宏泄漏照旧——"无 -g 就无泄漏"是错觉。
                        与 E579（DWARF comp_dir）不同载体：本条泄漏源仅
                        source_folder（编译命令实参），sysroot 不出现。
affected_scope:         用 __FILE__ 的 C/C++ 库 + CMake 构建的 Conan 打包；
                        所有 Release/无调试信息的交付产物"无宿主路径"验收。

# ═══ Layer 3: 方案层 (Solution) ═══
rec_priority:           1
rec_approach:           cmake-cflags-file-prefix-map
rec_description:        配方 build() 中 cmake.configure(variables={"CMAKE_C_FLAGS":
                        "-ffile-prefix-map=<source_folder>=<virtual>"})。
                        前提：核查上游 CMakeLists 对 CMAKE_C_FLAGS 是追加式
                        set(x "${x} ...")（iowow 如此，注入不丢）；若为覆盖式
                        set 需改用 CMakeToolchain variables 或 CFLAGS 环境变量
                        追加。单映射 source 即归零（无 -g 无 DWARF，工具链
                        路径不进入 rodata）。
rec_command:            cmake.configure(variables={"CMAKE_C_FLAGS": "-ffile-prefix-map={}=/_src".format(self.folders.base_source)})
rec_auto_fix:           false
rec_impl:               conan-recipe-cmake-prefix-map

# ═══ 验证与边界 ═══
verification_cmd:       strings -a <lib> | grep -E '/storage/|/home/|/Users/' （命中即泄漏）
verification_result:    注入前命中 1 处；注入后归零；conan create +
                        test_package 30/30 + 鸿蒙专项 12/12 PASS
valid_boundary:         CMake 构建 + __FILE__ 宏库；-g DWARF/sysroot 场景走
                        E579 三重映射；Makefile 项目直接追加 CFLAGS
similar_to:             DRAFT-E579（同根因家族 -ffile-prefix-map；触发面变体：
                        __FILE__/rodata/CMake vs DWARF/-g/Makefile）
prerequisite_of:
conflicts_with:

last_updated:           2026-10-09
authors:                AtomCode
