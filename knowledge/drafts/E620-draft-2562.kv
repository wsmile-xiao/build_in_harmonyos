#====================================================================
# E620 draft — musl <dirent.h> 不提供 BSD 宏 MAXNAMLEN
# 触发事件: ren 1.0 HarmonyOS PC 适配（archives/r/ren/1.0，
#           patches/0001-ren.c.patch）
# 查重: engine 对 "use of undeclared identifier 'MAXNAMLEN'" 误命中 E493
#       （program_invocation_name）；knowledge/ 全库 grep MAXNAMLEN 0 命中。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E620
trigger_tool:           clang|gcc|make
phase:                  compilation
error_signature:        use of undeclared identifier 'MAXNAMLEN'|'MAXNAMLEN' undeclared

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               musl, libc, headers, portability, compat
prescan_pattern:        \bMAXNAMLEN\b
prescan_globs:          *.c, *.h, *.cc, *.cpp
match_keywords:         MAXNAMLEN, sys/param.h, dirent.h, sys/dir.h, NAME_MAX, musl, glibc, __USE_MISC, undeclared identifier, BSD
title:                  musl <dirent.h> 不定义 BSD 宏 MAXNAMLEN（glibc 在 __USE_MISC 下定义）：老代码报 undeclared identifier 'MAXNAMLEN'，应补 #include <sys/param.h>

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             MAXNAMLEN 是 4.2BSD <sys/dir.h> 的文件名长度宏。glibc 的 <dirent.h> 在
                        __USE_MISC（默认 _DEFAULT_SOURCE）下仍以 NAME_MAX 定义它，所以只包含 <dirent.h>
                        的 Linux 移植代码在 glibc 上能编过；musl（OHOS libc）只在 <sys/param.h> 定义
                        MAXNAMLEN 255，<dirent.h>/<sys/dir.h> 都不提供，clang 报
                        use of undeclared identifier 'MAXNAMLEN'。与 -std、_GNU_SOURCE 等特性宏无关。
affected_scope:         只包含 <dirent.h>（或 <sys/dir.h>）就使用 MAXNAMLEN 的 BSD/glibc 移植 C 代码，
                        多见于 comp.sources/ibiblio 时代的老工具（实例 ren 1.0：ren.c makerep() 的
                        char b[MAXNAMLEN]）。NFS_MAXNAMLEN、CODA_MAXNAMLEN 等 linux/*.h 前缀宏不受影响。
verification_cmd:       grep -rn MAXNAMLEN "$SYSROOT/usr/include/sys/param.h" "$SYSROOT/usr/include/dirent.h"
                        （musl 仅 sys/param.h 命中）；
                        printf '#include <dirent.h>\nchar b[MAXNAMLEN];\n' | /data/service/hnp/bin/clang -x c -fsyntax-only -
                        （OHOS 目标编译器，如 NDK 的 aarch64-unknown-linux-ohos-clang；glibc 主机上的 clang/gcc 不复现）
                        → error: use of undeclared identifier 'MAXNAMLEN'；首行前加 #include <sys/param.h> → rc=0

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           include-sys-param-h
rec_description:        在使用 MAXNAMLEN 的源文件中补一行 #include <sys/param.h>（BSD 与 musl 的定义位置，
                        glibc 同样提供该头，补丁可原样回馈上游），改 .work 源码后用 refresh-patch --auto
                        生成补丁；不加 __OHOS__ 守卫，不在 CFLAGS 注入宏。
rec_command:            在 <file>.c 的 #include <sys/types.h> 之后插入 #include <sys/param.h>；
                        python3 $SKILL_ROOT/scripts/ohc-run.py refresh-patch --auto <软件> <版本>
rec_auto_fix:           false
rec_impl:               manual-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      guarded-name-max-fallback
fallback_description:   若 <sys/param.h> 引入的 MIN/MAX/howmany 等宏与项目标识符冲突，改为包含 <limits.h>
                        并在该文件内 #ifndef MAXNAMLEN / #define MAXNAMLEN NAME_MAX / #endif，
                        与 glibc 的定义语义一致。
fallback_command:       #include <limits.h> 后追加 #ifndef MAXNAMLEN\n#define MAXNAMLEN NAME_MAX\n#endif
fallback_auto_fix:      false
fallback_impl:          manual-patch

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       -DMAXNAMLEN
forbid_1_reason:        在配方 CFLAGS 里注入宏只掩盖头文件差异，补丁审查看不到；日后若头文件也定义
                        MAXNAMLEN 会产生重定义告警与取值漂移。
forbid_1_consequence:   可移植性修复游离在补丁之外，无法回馈上游，宏值与 libc 定义可能不一致。
forbid_2_pattern:       __OHOS__.*MAXNAMLEN|MAXNAMLEN.*__OHOS__
forbid_2_reason:        这是 libc 头文件布局差异，POSIX 可移植写法（包含 <sys/param.h>）即可覆盖，
                        补丁中加平台宏违反 R8。
forbid_2_consequence:   PF5 平台宏闸 / 检视拦截，并在其他 musl 平台上复发。

# ═══ Layer 4: 原则引用 ═══
principles:             P005

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E032, E420, E500]
conflicts_with:         []
prerequisite_of:        []

