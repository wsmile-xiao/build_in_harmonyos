#====================================================================
# E543-draft-58D4.kv — conan 库包公共头依赖第三方头/平台宏时未向消费者传播
#（transitive_headers + cpp_info.defines 缺失：消费者/ test_package 编译失败）
# 触发事件: kea-hooks 3.0.3 适配（ISC Kea hooks 框架库，meson + Conan，OHOS aarch64）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E543
trigger_tool:           conan|clang|cmake|gcc
phase:                  compilation
error_signature:        fatal error: 'boost/[a-z0-9_/]+\.hpp' file not found|use of undeclared identifier 'pthread_setcancelstate'|Could not find a package configuration file provided by "(Boost|boost|OpenSSL)"|find_package\(boost\) (failed|not found)

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, headers, compat, musl, threading
match_keywords:         conan, CMakeDeps, transitive_headers, cpp_info.defines, test_package, find_package, boost, multiprecision, cpp_int.hpp, sp_thread_sleep.hpp, pthread_setcancelstate, BOOST_SP_NO_PTHREAD_SETCANCELSTATE, OHOS, musl, consumer, header propagation
title:                  conan 包公共头依赖第三方头/平台宏却未传播给消费者（transitive_headers / cpp_info.defines 缺失）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             包内安装的公共头 include 了第三方头（如 kea/hooks/*.h → boost/any.hpp、
                        boost/multiprecision/cpp_int.hpp）或依赖平台专用宏（OHOS musl 的
                        pthread.h 不声明 pthread_setcancelstate，boost/core/detail/
                        sp_thread_sleep.hpp 需要外部定义 BOOST_SP_NO_PTHREAD_SETCANCELSTATE），
                        但 conanfile.py 只用默认的 self.requires()：Conan 2 的 CMakeDeps 默认
                        不把传递依赖的 include 目录/编译定义暴露给消费者，于是消费者（含
                        test_package）拿到 kea-hooks 的 -I 却没有 boost 的 -I 与宏，编译失败。
                        更隐蔽的是：库自身 build() 里用 tc.extra_cxxflags 加了宏，库能编过，
                        只有“编译一个消费者”时才暴露缺传播。
affected_scope:         任何“公共头泄漏第三方依赖”的 conan 库包（Kea 系、Qt 系、Boost 头非 header-only
                        暴露的包）；跨平台适配中平台所需宏/头被写入 generate() 而未写入
                        package_info() 的场景
verification_cmd:        grep -n "INTERFACE_INCLUDE_DIRECTORIES" -A3 <test_package_build>/generators/<pkg>-Target-*.cmake; grep -rn "^#include <\(boost\|openssl\|log4cplus\)/" <package_folder>/include

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           conan-declare-transitive-headers-and-defines
rec_description:        在 requirements() 里对“会被公共头 include”的依赖显式声明 transitive_headers=True
                        （boost/openssl/log4cplus）；在 package_info() 里把平台必需的编译宏经
                        cpp_info.defines 传播给消费者（仅目标平台生效）。
rec_command:            self.requires("boost/1.85.0", transitive_headers=True)  # requirements();  self.cpp_info.defines = ["BOOST_SP_NO_PTHREAD_SETCANCELSTATE"]  # package_info()，if self.settings.os == "OHOS"
rec_auto_fix:           false
rec_impl:               conan-package-info

fallback_priority:      2
fallback_approach:      self-contained-header-snapshot
fallback_description:   若第三方不足以稳定声明（包已停更/上游未适配），把该第三方头的必要部分随包安装
                        并在 package_info 中暴露 include 根（成本高、易漏，通常不推荐）
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       在 test_package/CMakeLists.txt 或 test_package/conanfile.py 里手工补 (find_package|requires|include_directories|add_definitions).*(boost|BOOST_SP_)|-I\$.*boost.*include
forbid_1_reason:        在测试端补依赖会掩盖包本身缺少头文件/宏传播的缺陷，CI 绿而真实消费者红
forbid_1_consequence:   违反 R34 精神（test_package 必须代表真实消费者）与配方质量要求（评审要求改回包内传播）
forbid_2_pattern:       跳过(test_package|测试)|def test\(self\):\s*pass|注释掉\s*(cmake|meson)\.build\(\)
forbid_2_reason:        编译失败不是通过“跳过测试”解决的，而是修包的头/宏传播
forbid_2_consequence:   违反 R9，CI 直接判欺骗性行为

