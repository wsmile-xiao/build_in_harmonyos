#====================================================================
# DRAFT-kangaru-4.3.2-catch2-submodule-test-requires - 上游测试框架以
# git submodule 打包的库：用 conan test_requires + CMakeDeps 替代空 submodule
#
# 场景: kangaru 4.3.2 (gracicot/kangaru, header-only DI) 在 OHOS armv8
#       Conan 2.29/ohpcd 适配。官方 GitHub tag tarball 不含 .gitmodules
#       指向的 submodule 内容：test/third_party/Catch2、benchmark/third_party/
#       benchmark 均为空目录。上游 test/CMakeLists.txt 用
#       find_package(Catch2 QUIET)，找不到时回退 add_subdirectory(third_party/Catch2)
#       → 空目录 → "does not contain a CMakeLists.txt file" → CMake configure 失败。
#
# 适用: 所有上游测试框架以 git submodule vendoring 的 C++ 库（Catch2/doctest/
#       gtest 等）在 Conan 2.x + 官方 release tarball（不含 submodule 内容）
#       下的配方落地；与 E150（manual-download 复制源码进树）和 E425/E426
#       （嵌入式 SDK 保持空占位）互补，本方案不改动源码树。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-kangaru-4.3.2-catch2-submodule-test-requires
source_lib:             kangaru 4.3.2
trigger_tool:           conan|conan create|cmake|find_package
phase:                  source|configuration|test
error_signature:        does not contain a CMakeLists.txt file|add_subdirectory\(third_party/Catch2\)|find_package\(Catch2 QUIET\)|No such file or directory.*third_party|submodule.*empty|\.gitmodules

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan|packaging|header-only|test-requires|submodule|cmake|catch2
match_keywords:         submodule, .gitmodules, empty submodule, Catch2, third_party, find_package, CMakeDeps, test_requires, Catch2Config, add_subdirectory, header-only, cmake, tarball, release asset
title:                  上游测试框架 submodule 空目录：conan test_requires + CMakeDeps 生成 Catch2Config 替代，不动源码树

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  GitHub 官方 release tarball 只打包 .gitmodules 描述的目录结构，不打包 submodule
  内容（git submodule 是 gitlink，tar 归档落空目录）。上游 CMake 常见写法是
  find_package(<Framework> QUIET) + 未命中时 add_subdirectory(third_party/<Framework>)；
  空 submodule 目录使回退路径失败（no CMakeLists.txt）。若把 submodule 内容
  manual-download 进源码树（E150）会改动源码树/污染 diff；若保持空占位（E425）
  则测试无法编译运行。对"测试框架"（非库本体功能）submodule，正确做法是让
  find_package 直接吃到 conan 提供的包：recipe 声明 test_requires(包) 并在
  generate() 用 CMakeDeps 生成 <Pkg>Config.cmake，上游 find_package 即命中，
  不再走空 submodule 回退路径。

affected_scope: >
  上游测试/基准以 git submodule vendoring（Catch2/doctest/gtest/google-benchmark
  等）的 C++ 库在 Conan 2.x（本项目 2.29.1）+ 官方 release tarball 下的配方
  编写与 conan-verify G2 通过；对 header-only 库测试仅秒级时无条件运行测试。

verification_cmd: >
  conan create archives/k/kangaru/4.3.2 -pr:h=ci/conan/profiles/ohos-aarch64
  --build=missing  (G2 全绿 + test_package + 上游测试全过)

# ═══ Layer 3: 修复层 (Fix) ═══
rec_priority:           1
rec_approach:           test-requires-plus-cmake-deps
rec_description: >
  conanfile.py requirements() 中 `self.test_requires("catch2/2.13.10-r0")`
  （test_requires 只进测试/消费者，不污染下游 requires）；generate() 中
  先 `deps = CMakeDeps(self); deps.generate()` 再 CMakeToolchain。CMakeDeps 依据
  catch2 配方的 cpp_info.set_property("cmake_file_name","Catch2") 生成
  Catch2Config.cmake，上游 test/CMakeLists.txt 的 find_package(Catch2) 命中
  Catch2::Catch2 target。submodule 空目录保留即可（不删除、不下载、不写入
  源码树），避免对官方源码产生 diff。
rec_command: >
  # conanfile.py
  def requirements(self):
      self.test_requires("catch2/2.13.10-r0")
  def generate(self):
      deps = CMakeDeps(self); deps.generate()
      tc = CMakeToolchain(self); ...
rec_auto_fix:           false
rec_impl:               conan-recipe-test-requires-cmake-deps

fallback_priority:      2
fallback_approach:      manual-download-into-source-tree
fallback_description:   若 conan 仓无对应测试框架包且不想建包，可退回 E150：
                        source() 中单独下载 submodule 内容放回 third_party 目录。

# ═══ Layer 4: 防护层 (Guard) ═══
guard_pattern:          find_package\(.*QUIET\).*add_subdirectory\(third_party
guard_check:            配置期若报 "does not contain a CMakeLists.txt file" 即命中本模式

# 关联文档: reports/knowledge-candidate-ledger.md (C2)
