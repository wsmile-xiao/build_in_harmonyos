#====================================================================
# E706-draft-paraglob-btest-tmp-readonly.kv — btest-diff 硬编码 /tmp 在只读 /tmp 设备恒假红
#====================================================================
# 来源: paraglob 0.6.0（Zeek 子组件）OHOS aarch64 适配, 2026-09-24
# 状态: 草稿（待人工审核后 promote 为正式条目）

id:                     E706-draft-paraglob-btest-tmp-readonly
trigger_tool:           btest|btest-diff
phase:                  testing
error_signature:        'btest-diff: TEST_DIFF_CANONIFIER failed on file|/tmp/test-diff\.\d+\..*\.tmp: Read-only file system|^[0-9] of [0-9] tests failed'

severity:               2
category:               testing, harness, device, tmp-readonly, false-failure
match_keywords:         btest, btest-diff, TEST_DIFF_CANONIFIER, /tmp/test-diff, Read-only file system, canonicalizer, baseline diff, Baseline, Zeek, paraglob, 假失败, 比对从未执行
title:                  btest-diff 硬编码 /tmp 临时文件 → 只读 /tmp 设备上整套 btest 恒判失败（比对从未执行）

root_cause: |
  /tmp 在鸿蒙 PC 设备上只读（device-facts §一.1 同族）。Zeek btest 的
  btest-diff 脚本把两处规范化输出**硬编码**到 /tmp：
    第 189 行  canon_output=/tmp/test-diff.$$.$canon.tmp
    第 204 行  canon_baseline=/tmp/test-diff.$$.$canon.baseline.tmp
  重定向失败 ⇒ `eval "$TEST_DIFF_CANONIFIER" ... >"$canon_output"` 非零退出
  ⇒ 脚本写 "TEST_DIFF_CANONIFIER failed" 并置 result=1 ⇒ **diff 一次都没跑**
  却把用例判 failed。形态是「假红」：与 §一.1 的「假绿」互为镜像，共同点是
  **测量装置本身没工作**，读数不可采信。此时 4/4 或 N/N 全红不代表上游回归。

affected_scope:         所有用 btest/btest-diff 做基线比对的包（Zeek 系、paraglob、
                        以及任何把输出写 /tmp 的 runner 类测试）；凡测试工具硬编码
                        临时目录而该目录只读，一律同族（含 make check/ctest 快照比对）。

verification_cmd:       PATH="$HOME/tmp/paraglob-0.6.0/btest-bin:$PATH" btest -c "$HOME/ws/tmp/builds/paraglob-0.6.0.work/testing/btest.cfg" -d
rec_priority:           1
rec_approach:           private-btest-bin-tmpdir
rec_description: |
  先修测量装置再读数：把 btest 包的 bin/ 整套复制成**任务私有副本**，仅把上述
  两处 `/tmp/` 改成 `${TMPDIR:-/tmp}/`（env.sh 已把 TMPDIR 指到工作区可写目录），
  私有副本置于 PATH 首位后重跑。**不修改共享 conan 缓存里的原文件**
  （sha256 保持 7a9dd830b9a2ba571f185656081c0e2a944875432902a7f30c1b4c5320e9c61c），
  也不改上游 paraglob 源码与 Baseline。修完必须重跑并保留 .tmp/driver.*/.diag 全套
  作为「比对确实执行了」的正面证据。
rec_command: |
  PRIV="$HOME/tmp/<任务>/btest-bin"; mkdir -p "$PRIV"
  cp -f "$HOME/.conan2/p/btest*/p/bin/"* "$PRIV"/
  python3 -c "
  import pathlib,sys
  p=pathlib.Path(sys.argv[1]); s=p.read_text()
  s=s.replace('canon_output=/tmp/test-diff','canon_output=\${TMPDIR:-/tmp}/test-diff')
  s=s.replace('canon_baseline=/tmp/test-diff','canon_baseline=\${TMPDIR:-/tmp}/test-diff')
  p.write_text(s)" "$PRIV/btest-diff"
  PATH="$PRIV:$PATH" btest -c testing/btest.cfg -d
rec_auto_fix:           true
rec_impl:               task-private-tool-copy

prescan_pattern:        canon_output=/tmp/|canon_baseline=/tmp/|btest-diff
prescan_globs:          btest-diff, testing/btest.cfg, btest.cfg

forbid_1_pattern:       btest\s+-U|btest\s+-u|--update-baseline|sed.*-i.*Baseline
forbid_1_reason:        用 btest -U/-u 回填基线会把设备读数固化成上游基线，等于篡改上游预期（真实回归会被抹平）
forbid_2_pattern:       conan cache.*btest|\.conan2/p/btest.*>\s*[^ ]*btest-diff
forbid_2_reason:        直接改共享 conan 缓存里的 btest 会污染同设备其他任务与后续轮次，且让「原文件未动」这一证据失效
principles:             P002, P003, P011
similar_to:             E708
caused_by:
prerequisite_of:
conflicts_with:

doc_file:               E706-draft-paraglob-btest-tmp-readonly.md
