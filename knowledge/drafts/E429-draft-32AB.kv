caused_by: []
similar_to: DRAFT-rungetty-1.2-tcflsh-eacces-on-owned-pty-slave,DRAFT-10861-splitvt-1.6.6-tioccsctty-needs-session-leader,DRAFT-E429-cfm-termios-tui-pty-consumer-test
conflicts_with: []
