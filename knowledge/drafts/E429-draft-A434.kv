#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E429
trigger_tool: cmake|conan
phase: configuration|dependency-resolution
error_signature: Qt6PrintSupportConfig.cmake|The following Qt components were not found: PrintSupport|Conflict between qtbase/6.11.1 and qtbase/6.11.1.3

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform, compat, cmake, ohos, conan
match_keywords: Qt6PrintSupport, qtbase/6.11.1.3, override=True, qttools, HarmonyOS aarch64, Conan
title: Prefer a published Qt feature variant before trimming required modules

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: The default published qtbase recipe can disable a module required by an upstream Qt application even though another published HarmonyOS qtbase recipe variant contains it. Transitive Qt packages may still pin the older recipe version, causing a Conan version conflict or a missing binary package after selecting the capable provider.
affected_scope: OHOS Qt applications whose required Qt module is absent from the default qtbase recipe but present in another published provider variant.
verification_cmd: Inspect the selected provider package for Qt6PrintSupportConfig.cmake, then run conan graph info with the OHOS aarch64 profile and verify every Qt requirement resolves to one qtbase version.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: select-published-provider-and-override-transitive-pin
rec_description: Check all published HarmonyOS qtbase variants for the required CMake module; if an enabled provider exists, require that version with override=True so transitive Qt recipes converge before building.
rec_command: self.requires("qtbase/6.11.1.3", override=True)
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: trim-only-optional-feature
fallback_description: If no published provider offers the module, assess upstream usage and trim or disable it only when the feature is demonstrably optional; preserve required modules and user-visible functionality.
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: remove.*PrintSupport|patch.*qtbase.*PrintSupport
forbid_1_reason: Do not remove a required upstream Qt module or fork the shared Qt provider before checking published compatible provider variants.
forbid_1_consequence: The application either loses required functionality or creates an unnecessary global package graph change.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: DRAFT-kuickshow-011-qt-module-absence-trim-and-stub
conflicts_with:         []
prerequisite_of:        []

