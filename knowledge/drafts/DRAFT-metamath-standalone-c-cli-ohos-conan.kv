last_updated:           2026-09-14
source_event:           metamath 0.198 local cross-build and W5 shadow CI; missing sysroot fixed before device validation, then L0/L1/L2/L4/L5 passed
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     1
metrics_confidence:     0.9
metrics_last_used:      2026-09-14

