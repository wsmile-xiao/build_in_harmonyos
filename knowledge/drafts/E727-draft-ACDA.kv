#====================================================================
# E727.kv — OHOS bionic 缺废弃 POSIX getwd()，替换为标准 getcwd()
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E727
trigger_tool:           clang|ld|make
phase:                  compilation|linking
error_signature:        undefined symbol:.*getwd|undefined reference to.*getwd|
                         implicit declaration of function.*getwd

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               compat, libc, posix
match_keywords:         getwd, getcwd, deprecated, posix, undefined symbol,
                         bionic, libc, missing function
title: OHOS bionic 缺废弃 POSIX getwd()，替换为标准 getcwd()

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             getwd() 是 POSIX 标记废弃的旧 API（XPG/BSD 遗留，
                        缓冲区无长度参数），OHOS bionic libc 不实现此函数。
                        遗留 C 源码在非 Windows 分支声明
                        extern char *getwd() 并调用时，
                        bionic 下无此符号导致链接报 undefined symbol。
affected_scope:         使用 getwd() 获取当前工作目录的遗留 C 程序
                        （1990-2000 年代代码常见）。
verification_cmd:       grep -rn "getwd" src/ lib/ 2>/dev/null | head -5;
                         clang -c 编译后链接验证 getcwd 替换是否通过

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description:        将 getwd() 替换为标准 getcwd(x, size)：把
                        GETWD 宏改为 getcwd(x,MAX_LINE) 并补充
                        #include <unistd.h>，与 #ifdef _WIN32 分支一致。
rec_command:            |
                        /* 修改前 */
                        extern char *getwd();
                        #define GETWD(x) getwd(x)
                        /* 修改后 */
                        #include <unistd.h>
                        #define GETWD(x) getcwd(x,MAX_LINE)
rec_auto_fix:           false
rec_impl:               source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      configure-disable-feature
fallback_description:   若软件允许，通过构建选项禁用依赖 getwd 的功能模块
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       -DHAVE_GETWD
forbid_1_reason:        强制声明 getwd 存在但 bionic 无此符号，
                        导致链接阶段 undefined reference
forbid_1_consequence:   链接失败，undefined reference to getwd

# ═══ Layer 4: 原则引用 ═══
principles:             P005

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             E093
conflicts_with:         []
prerequisite_of:        []

