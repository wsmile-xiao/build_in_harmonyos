#====================================================================
# DRAFT - Link-only OHOS SDK libunwind integration for GCC Ada 9
#====================================================================

id:                     DRAFT-gcc-ada-ohos-link-only-libunwind
trigger_tool:           gcc|gnatmake|gnatlink|ld|libunwind|conan|test_package
phase:                  linkage|runtime|testing|packaging
error_signature:        exception:before.*timeout|
                         Ada exception.*hang|
                         _Unwind_(RaiseException|Resume|GetIP)|
                         unwind-dw2|
                         ADA_UNWIND_DIAGNOSTIC

severity:               3
category:               harmonyos|gcc|ada|exceptions|unwind|linkage|toolchain
match_keywords:         GCC Ada, GNAT, unwind-dw2, OHOS SDK, libunwind.a,
                         exception propagation, link-only injection,
                         whole-archive, compiler driver wrapper
title:                  Inject the OHOS SDK libunwind only for GCC Ada link invocations

root_cause: >
  GCC 9's built-in unwind-dw2 can compile and link an Ada program on HarmonyOS
  but hang when an exception is raised. A compile-only test and even a linked
  executable therefore do not expose the defect. A same-source A/B device
  diagnostic showed the default unwinder timing out immediately after the
  pre-raise marker, while the program linked with the OHOS SDK AArch64
  libunwind.a completed exception propagation. Adding libunwind to every GCC
  invocation is also incorrect: compile-only commands do not link and GNAT
  invokes the driver in multiple phases.

affected_scope: >
  Native GCC Ada 9 toolchains packaged for HarmonyOS PC when Ada exceptions,
  tasking, protected objects, or other DWARF unwinding consumers are enabled.

verification_cmd: >
  Build the same Ada exception program twice; require the default unwind-dw2
  variant to reproduce the timeout, the SDK libunwind variant to emit
  ADA_UNWIND_DIAGNOSTIC=pass, and the final consumer to report
  gcc-ada checks passed: 6.

rec_priority:           1
rec_approach:           compiler-driver-link-only-sdk-libunwind
rec_description: >
  Keep GCC and Ada compilation unchanged. In the relocatable packaged driver,
  parse arguments conservatively to distinguish compile-only options from a
  real link with an input. Only for links, locate the SDK AArch64 libunwind.a
  relative to the active sysroot and prepend it under --whole-archive /
  --no-whole-archive. Fail explicitly if the SDK archive is missing. Validate
  compile-only traces contain no injection and link maps resolve the SDK
  archive.
rec_command: >
  if link_invocation_with_input; then
    gcc -Wl,--whole-archive <sdk>/llvm/lib/aarch64-linux-ohos/libunwind.a
        -Wl,--no-whole-archive <original-args>;
  else gcc <original-args>; fi
rec_auto_fix:           false
rec_impl:               relocatable-gcc-driver-wrapper

fallback_priority:      2
fallback_approach:      explicit-consumer-link-flag
fallback_description: >
  For diagnostics only, add the SDK archive to a single gnatlink or gcc link
  command. Do not use this as the published package contract because normal
  GNAT consumers would still hang without knowing the private workaround.
fallback_command:       gnatmake test.adb -largs -Wl,--whole-archive <libunwind.a> -Wl,--no-whole-archive
fallback_auto_fix:      false
fallback_impl:          diagnostic-only-link-args

forbid_1_pattern:       (CFLAGS|ADAFLAGS|compile).*(libunwind|whole-archive)
forbid_1_reason:        libunwind is a link-time runtime implementation and must not be injected into compile-only phases.
forbid_1_consequence:   GNAT multi-phase commands receive invalid or duplicated linker arguments.

forbid_2_pattern:       disable.*exception|stub.*_Unwind|catch.*skip
forbid_2_reason:        Disabling exception behavior hides a core Ada runtime failure instead of adapting it.
forbid_2_consequence:   The package compiles simple programs but fails real Ada exceptions and tasking consumers.

principles:             P014, P016
similar_to:             DRAFT-clang-ohos-native-llvm-toolchain
conflicts_with:
prerequisite_of:

doc_file:               knowledge/drafts/DRAFT-gcc-ada-ohos-link-only-libunwind.md
last_updated:           2026-08-26
source_event:           archives/g/gcc-ada/9.5.0 issue #2281

authors:                wxjshr
source_pr:              OpenHarmonyPCDeveloper/build_in_harmonyos!6116
source_commit:          8cd01df044

metrics_success_count:  2
