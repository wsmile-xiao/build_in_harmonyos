#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E16331.kv，填写各字段
# 对应的人类文档: doc/E16331.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E16331
trigger_tool: meson|clang
phase: testing
error_signature: needs-uinput|This test needs to run as root|static-symbols-leak|libc.a

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: testing, portability, runtime
match_keywords: needs-uinput, This test needs to run as root, static-symbols-leak, libc.a
title: Meson 测试权限标签与静态运行库符号的验证边界

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Meson suite 标签描述测试集合，不是 main 的权限门禁。共享标签中的无设备进程仍可执行；完全静态 test-link 还带入平台 libc 的 public 符号，原脚本不能仅凭符号数量把污染归咎于被测库。
affected_scope: 使用原生 Meson/Autotools 测试、发布依赖以及特权输入设备的 C/C++ 库与 CLI 工具。
verification_cmd: 核对精确发行源码与候选补丁，执行原测试框架及独立签名 HMDFS 探针，保全进程 RC 和回执链。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: source-bound-native-test-and-runtime-closure
rec_description: 先按实际 main/suite 注册和原框架输出统计进程与断言；TEMP 指向私有目录的修法复用 DRAFT-E571，不重复建立 Check 修复。保留原 test-link.c、libevdev.a 与原静态脚本，仅对平台运行库 libc.a 使用 --exclude-libs,libc.a；通过原断言验证后独立标注解释器适配。
rec_command: 设置任务私有 TEMP/TMPDIR 与运行库查找路径；运行原框架，不改断言；按入口与轮次回读 RC。
rec_auto_fix: false
rec_impl: native-test-controller

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: SKIP.*PASS|0/0.*100%|跨轮次.*整套PASS
forbid_1_reason: 跳过、无测试以及独立轮次不构成整套通过；旧证据不可改写。
forbid_1_consequence: 虚假测试覆盖率与平台能力声明。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

