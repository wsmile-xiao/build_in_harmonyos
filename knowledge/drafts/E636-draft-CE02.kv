#====================================================================
# E636.kv — autotools BUILT_SOURCES 指向生成的 PDF 文档
# 对应的人类文档: doc/E636.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E636
trigger_tool:           make
phase:                  compilation
error_signature: 'make\[\d+\]: \*\*\* docs?: No such file or directory\.  Stop\.|make: \*\*\* \[Makefile:\d+: docs?/[^]]*\.pdf\] Error \d+|No rule to make target .docs?/.*\.pdf. needed'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               autotools, build-system, portability
prescan_pattern:        ^\s*BUILT_SOURCES\s*=.*docs?/
prescan_globs:          'Makefile.am, Makefile.in'
match_keywords:         BUILT_SOURCES, BUILT_SOURCES docs, make -C docs, pdf, No such file or directory, dist_doc_DATA
title:                  autotools 把生成的 PDF 文档列进 BUILT_SOURCES，out-of-tree/无 LaTeX 构建在 make all 第一步即失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游 Makefile.am 把 docs/*.pdf 写进 BUILT_SOURCES（automake 在 all 之前必建）和 dist_doc_DATA；out-of-tree 构建目录里没有 docs/ 子目录（make -C docs 直接 No such file or directory），且设备/CI 都没有 LaTeX 工具链，即使补上目录也造不出 PDF
affected_scope:         所有带 TeX 文档且把 PDF 列入 BUILT_SOURCES 的 autotools 包（数学/科学计算包常见：qd 2.3.23、arprec 等）；in-tree 构建掩盖问题（源码树有 docs/），Conan/CMake out-of-tree 构建必现
verification_cmd:       grep -n "BUILT_SOURCES" Makefile.am Makefile.in

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           patch-makefile-in
rec_description:        补丁生成的 Makefile.in：BUILT_SOURCES 置空并从 dist_doc_DATA 移除 PDF（保留 README，automake 的 install 规则对缺失文件有 $(srcdir)/ 回退，README 在 out-of-tree 下可正常安装）
rec_command:            sed -i 's/^BUILT_SOURCES = docs\/qd.pdf$/BUILT_SOURCES =/; s/^dist_doc_DATA = README docs\/qd.pdf$/dist_doc_DATA = README/' Makefile.in
rec_auto_fix:           false
rec_impl:               patch-file

fallback_priority:      2
fallback_approach:      configure-flag
fallback_description:   若上游提供 --disable-doc/--without-docs 类开关则优先用配方参数关闭文档构建；只有上游无开关时才走补丁
fallback_command:
fallback_auto_fix:      false
fallback_impl:          configure-args

# ★ 禁止策略 ★
forbid_1_pattern:       touch\s+\S*docs?/\S*\.pdf|echo.*>\s*\S*docs?/\S*\.pdf
forbid_1_reason:        伪造空 PDF 顶替真实文档产物属于假产物
forbid_1_consequence:   安装进包的是损坏文件，且掩盖了文档本未构建的事实

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

