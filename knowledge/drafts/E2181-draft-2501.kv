id:                     E2181
trigger_tool:           cmake|conan|dpkg-source
phase:                  source|configuration|compilation
error_signature:        Cannot find source file:.*|No SOURCES given to target
severity:               3
category:               debian-repack|split-source|source-integrity|licensing
match_keywords:         Debian, +ds, Files-Excluded, debian.tar, orig.tar, debian/rules, missing CMake source, sidecar
title:                  Reconstruct a Debian +ds split source from its matching orig and Debian sidecar before CMake
root_cause:             A Debian repacked orig tar can intentionally exclude functional source files while the matching debian.tar carries them and debian/rules copies them into place before configuration. Consuming orig.tar alone therefore makes the untouched upstream CMakeLists refer to absent files.
affected_scope:         Conan recipes based on Debian +ds/repacked source archives where a missing build input is documented by Files-Excluded and restored by the matching Debian packaging source.
verification_cmd:       Verify both tarball SHA-256 values against the signed .dsc; inspect debian/copyright Files-Excluded and debian/rules; hash each sidecar file; run conan create, the upstream test driver, and an installed-package consumer on the target.
rec_priority:           1
rec_approach:           checksum-bound-matching-sidecar-restoration
rec_description:        Obtain the exact matching Debian source tar, export only the required sidecar files with their hashes, restore them before configure, and update the package license to include their actual license. Keep the official orig tar URL/hash and reject missing or changed sidecar inputs.
rec_command:            inspect .dsc and debian/rules; export matching sidecar files; verify SHA-256 before copying into source(); run complete target build and tests
rec_auto_fix:           false
rec_impl:               conan-exported-source-overlay
fallback_priority:      2
fallback_approach:      use-complete-official-upstream-release
fallback_description:   If the matching Debian sidecar is unavailable or incompatible, select the complete official upstream release of the task version and bind its authoritative hash; do not invent absent source.
fallback_command:
fallback_auto_fix:      false
fallback_impl:          manual
forbid_1_pattern:       stub.*missing.*source|remove.*source.*CMakeLists
forbid_1_reason:        Stubbing or removing a referenced implementation changes library behavior rather than reconstructing the release.
forbid_1_consequence:   A superficial build can omit an algorithm silently.
forbid_2_pattern:       label.*LGPL.*without.*sidecar.*license
forbid_2_reason:        Restored source may carry a stricter GPL license than the selected optional build mode suggests.
forbid_2_consequence:   Package metadata and redistribution obligations become misleading.
principles:             []
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/E2181-draft-2501.md
last_updated:           2026-09-29
source_event:           MathGL 8.0.3-ds.2 first target run CMake missing s_hull/s_hull_pro.cpp; Debian source tar SHA-256 6b00f972103701e600d614fcc3742c3531bb6b13ed13839bf45403de4aaed73c supplied GPL-3 files; final W3 log SHA-256 adf59f18d6c1fc010f9fe32e98ccf4738068a00d9c2525e4fe89e4106472e3d0, upstream 150/150, consumer 1/1.
metrics_success_count:  1
metrics_fail_count:     1
metrics_confidence:     1.0
metrics_last_used:      2026-09-29
