#====================================================================
# E400 — OHOS 平台 patch --dry-run 会真实创建新文件（污染 .orig 基线）
# 由 captive-browser 1.0.0 适配过程中发现（refresh-patch 的 _dry_run 触发）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E400
trigger_tool:           patch
phase:                  configuration
error_signature:        creating|patch --dry-run|--dry-run -p1|source/target file does not exist

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, ohos, limitation
match_keywords:         patch, dry-run, .orig, refresh-patch, source/target file does not exist
title:                  OHOS patch --dry-run 真实创建文件，污染 .orig 基线目录

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             HarmonyOS PC 的 GNU patch 在 --dry-run 模式下仍会真实创建新文件（0 字节占位），
                        而非仅预览。refresh-patch 的 _dry_run() 在 .orig 目录执行 patch --dry-run，
                        导致新增源文件（如 core.go）被写成 0 字节占位文件；下次 refresh-patch
                        据此误判该文件"已存在"，生成 --- a/xxx 而非 --- /dev/null 的新文件补丁，
                        conan apply_conandata_patches (patch_ng) 报 source/target file does not exist。
affected_scope:         HarmonyOS PC 上所有使用 refresh-patch --auto / patch 生成补丁的 Go/C 项目
verification_cmd:       printf -- '--- /dev/null\n+++ b/t.go\n@@ -0,0 +1 @@\n+x\n' | patch --dry-run -p1; ls t.go 2>/dev/null && echo "OHOS 上 dry-run 创建了文件"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           baseline-restore
rec_description:        每次 finish/refresh-patch 前，从原始 tarball 恢复干净的 .orig 基线目录，
                        删除其中的 0 字节占位文件，使新增文件被正确识别为 /dev/null 新文件
rec_command:            rm -f ${ORIG_DIR}/${REL_NEW_FILE}; # 或重新解压 tarball 到 .orig
rec_auto_fix:           false
rec_impl:               refresh-patch-baseline-restore

rec_priority:           2
rec_approach:           verify-format
rec_description:        补丁生成后校验新增文件补丁头为 --- /dev/null 而非 --- a/xxx，
                        并清空 conan 缓存（conan remove name/ver -c）确保 conan create 重新导出补丁
rec_command:            conan remove "${NAME}/${VERSION}*" -c
rec_auto_fix:           true
rec_impl:               conan-cache-invalidate
