#====================================================================
# E635 — init_build._promote_nested_source 误提升 projects/ 子目录为源码根
# 对应的人类文档: doc/E635.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E635
trigger_tool:           ohc-run.py init-build
phase:                  configuration
error_signature: 嵌套源码检测: 找到源码在 projects|\.work 顶层只剩 VC6|\.work 只有 projects 内容|提升完成: projects

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, detection, init-build, makefile, hmdfs
match_keywords:         nested source, promote, projects, makefile, init-build, F068, case-insensitive
title: init_build._promote_nested_source 在"构建文件位于 projects/ 子目录"的 C 包上误判，把 projects/ 提升为源码根并删除 src/lib/ 顶层文件

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: _promote_nested_source(_find_source_subdir) 仅按 configure/CMakeLists.txt/Makefile/meson.build 标记识别源码子目录；libsoil 这类"构建文件放在 projects/ 子目录、源码在顶层 src/"的 C 包，顶层无标记，递归命中 projects/makefile（HMDFS 大小写不敏感 FS 上 projects/Makefile 与 projects/makefile 目录同名匹配），于是把 projects/ 内容提升到源码根，并删除真正的顶层文件(src/lib/测试图)。
affected_scope: init-build 阶段所有"构建系统位于 projects/ 等子目录、源码在顶层"的 C/C++ 包（libsoil、部分老式单库）
verification_cmd: ls .work/ | grep -E 'src|lib' && test -f .work/src/SOIL.c   # 修复后应有顶层 src/ 与 lib/

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach: 手动修复源树：1) rm -rf 误提升的 .orig/.work；2) mkdir .orig && tar xzf --strip-components=1 -C .orig <tarball>（保留顶层布局，勿触发 F068）；3) cp -a .orig/. .work/；4) 写 .orig/.tarball-sha256；5) 重建 edit-tracker 基线（python -c "from ohc.edit_tracker import snapshot; snapshot('<work>')"）。配方 build() 直接 cd 到 projects/makefile 用 make CXX=clang 构建（conanfile 用绝对路径 cwd=self.source_folder/...）。
rec_description: C 包构建文件在 projects/ 子目录时，绕过 F068 嵌套提升，手动重建顶层布局；conanfile 用绝对路径驱动子目录 makefile
rec_command: tar xzf --strip-components=1 -C .orig <tarball> && cp -a .orig/. .work/
rec_auto_fix:           false
rec_impl:

fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:

# ═══ Layer 4: 原则引用 ═══
principles:             P-BUILD-SYSTEM

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             E466
conflicts_with:         []
prerequisite_of:        []

