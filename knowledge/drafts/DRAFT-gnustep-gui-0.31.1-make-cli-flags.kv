#====================================================================
# DRAFT-gnustep-gui-0.31.1-make-cli-flags
# ADDITIONAL_CPPFLAGS 必须作为 make 命令行参数传入
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: gnustep-gui 0.31.1 HarmonyOS PC 适配（PR #7408）
#====================================================================

id:                     DRAFT-gnustep-gui-0.31.1-make-cli-flags
trigger_tool:           gnustep-make|make|GNUmakefile
phase:                  build|compilation
error_signature:        ADDITIONAL_CPPFLAGS|CPPFLAGS.*not.*used|GNUSTEP_BASE_HAVE_LIBXML=|undefined.*macro|header.*not found|clang.*error
severity:               3
category:               ohos|gnustep|make|environment|compilation|configure
match_keywords:         ADDITIONAL_CPPFLAGS, CPPFLAGS, environment variable, make command line, GNUstep make, configure, clang
title:                  Pass ADDITIONAL_CPPFLAGS as a make command-line argument; GNUstep make does not read it from the environment
root_cause:             GNUstep make's build rules do not propagate
                        ADDITIONAL_CPPFLAGS (or other build flags) from the process
                        environment. Flags set via `export` before invoking `make` are
                        silently ignored, so macros like
                        `GNUSTEP_BASE_HAVE_LIBXML=` remain empty and headers/macros the
                        build depends on are missing at compile time.
affected_scope:         GNUstep packages built through gnustep-make on any target where
                        extra compile flags must be injected (OHOS, cross builds).
verification_cmd:       Build gnustep-gui 0.31.1 with the flags passed on the make command
                        line; verify the compiled clang invocation contains the expected
                        -D/ -I flags and the library links.

rec_priority:           1
rec_approach:           make-command-line-flags
rec_description:        Pass ADDITIONAL_CPPFLAGS (and any required LDFLAGS) directly on the
                        make command line, not via environment variables, so GNUstep make
                        rules pick them up for every compilation unit.
rec_command:            make ADDITIONAL_CPPFLAGS="-I<include> -DGNUSTEP_BASE_HAVE_LIBXML=0 ..."
rec_auto_fix:           false
rec_impl:               conan-recipe-build

fallback_priority:      2
fallback_approach:      GNUmakefile-preamble-injection
fallback_description:   When the top-level make invocation does not forward the variable,
                        append the flags in a GNUmakefile.preamble that GNUstep make always
                        reads.
fallback_command:       write GNUmakefile.preamble with ADDITIONAL_CPPFLAGS += ...
fallback_auto_fix:      false
fallback_impl:          conan-recipe-build

forbid_1_pattern:       export.*ADDITIONAL_CPPFLAGS|env.*ADDITIONAL_CPPFLAGS
forbid_1_reason:        GNUstep make ignores build flags from the environment.
forbid_1_consequence:   Compilation silently misses required -D/-I flags and fails late.
forbid_2_pattern:       hardcode.*absolute.*include.*path
forbid_2_reason:        Absolute paths make the recipe non-reproducible across machines.
forbid_2_consequence:   A clean consumer fails on a different worker.

principles:             P013,P014
causes:                 []
caused_by:              []
similar_to:             DRAFT-gnustep-gui-0.31.1-objc-runtime-gnu
conflicts_with:         []
prerequisite_of:        []

