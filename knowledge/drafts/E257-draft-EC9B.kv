#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E257.kv，填写各字段
# 对应的人类文档: doc/E257.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E257
trigger_tool:           configure|cmake|meson|make|gcc|clang|ld|python|pip|install|test|runtime
phase:                  configuration|compilation|linking|installation|testing|runtime
error_signature:         ctest.*1.*(105|logical)|upstream_test_count|test_package.*upstream|assertion_count.*8

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               cmake, testing, conan, headers, packaging
match_keywords:         CTest target count, logical test driver, header-only, INTERFACE, test_package, upstream_test_count, assertion_count
title:                  Header-only CMake 包的 CTest 目标数与逻辑用例数分层核对

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             CMake/CTest 把一个可执行测试驱动登记为一个 CTest target，但驱动的 main() 可能顺序调用多个逻辑测试并遍历数据回归；若适配只记录其中一个口径，或把 test_package 消费者断言并入上游统计，就会虚报覆盖范围。header-only INTERFACE 包还需要单独验证安装后的 CMake target 消费链路。
affected_scope:         带单一或少量 CTest 驱动、main() 内含多个逻辑测试的 C/C++ CMake header-only 或 INTERFACE 库，尤其是 Conan 2 + OHOS aarch64 适配。
verification_cmd:       cmake -S <src> -B <build> && cmake --build <build> && ctest --test-dir <build> --output-on-failure; awk '/int main\(/,/^}/' <src>/tests/unit.cpp; conan test <src>/test_package <ref>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           ctest-logical-test-inventory
rec_description:        先用 ctest -N/CTestTestfile.cmake 记录可执行 target 数，再源码核对测试驱动展开调用、逻辑测试族和数据循环数量；上游通过率只按上游入口报告，test_package 作为独立消费者验证并统计其真实断言。
rec_command:            ctest --test-dir <build> -N && ctest --test-dir <build> --output-on-failure
rec_auto_fix:           false
rec_impl:               manual-inventory

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      direct-test-driver-audit
fallback_description:   没有可用 CTest 时，直接运行上游测试驱动并保留命令、数据目录、退出码和输出；另外编译最小消费者测试验证安装包导出的 INTERFACE target。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       upstream_test_count.*1.*only|test_package.*upstream|ctest.*[0-9]+.*targets|100%.*without.*run
forbid_1_reason:        CTest target 数、上游驱动内逻辑测试数和消费者断言数是不同统计层级，不能互相替代。
forbid_1_consequence:   评审无法确认完整上游测试是否执行，路径 B 证据和适配覆盖率失真。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             E292, E307, E301
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
