#====================================================================
# DRAFT-cdb-20251021-hnp-clang15-no-bfd-linker.kv
# 部分真机 HNP clang 15 拒绝 -fuse-ld=bfd——旧 bfd 指引不可全局套用
# 触发事件: cdb 20251021 HarmonyOS PC 适配（PR #8907，真机 10.62.134.118）
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
#====================================================================

id:                     DRAFT-cdb-20251021-hnp-clang15-no-bfd-linker
trigger_tool:           clang|ld|conan
phase:                  link
error_signature:        clang(-[0-9]+)?: error: invalid linker name in argument '-fuse-ld=bfd'|
                         unable to find library.*-lbfd|ld.bfd.*not found

severity:               2
category:               toolchain|linker|ohos|environment-divergence|conan-conf
match_keywords:         fuse-ld=bfd, invalid linker name, HNP clang 15, clang 15.0.4,
                         ld.bfd 缺失, lld libxml2.so.16, 默认 linker, PIE ELF,
                         user.cdb:ld, conf 覆盖, 环境异构, tinycdb 对照

title:                  真机 HNP clang 15.0.4 直接拒绝 -fuse-ld=bfd（invalid linker
                        name）——"CI worker 需 bfd" 的旧指引不可全局硬编码，默认
                        不注入 linker、经 user.<pkg>:ld conf 按环境覆盖

root_cause: >
  旧知识链（tinycdb 时代经验、E544 pillow 草条的 CI worker 层）：部分 CI worker
  的 SDK ld.lld 因缺 libxml2.so.16 无法工作，规避法是 -fuse-ld=bfd。但真机
  10.62.134.118 的 HNP clang 15.0.4（/data/service/hnp/bin）工具链里没有 ld.bfd，
  驱动直接拒绝该参数：clang-15: error: invalid linker name in argument
  '-fuse-ld=bfd'——连回退机会都没有。该机 clang 默认 linker 与 -fuse-ld=lld
  均能正常产出 PIE ELF，且无 libxml2.so.16 问题。即 bfd 与 lld 各有"存在/可用"
  的反例环境，任何硬编码选择都会在另一类环境翻车。
affected_scope: >
  所有考虑注入 -fuse-ld=<name> 的配方。适用判据（真机两行命令即可定型）：
  echo 'int main(){}' > t.c && $CC t.c -fuse-ld=bfd -o t   # 报 invalid
  linker name → 本环境无 bfd；再试 -fuse-ld=lld 与不注入，能出 PIE ELF 即用默认。
verification_cmd: >
  真机对照：默认 linker / -fuse-ld=lld / -fuse-ld=bfd 三组链接 t.c——前两组
  rc=0 产出正常 PIE ELF（file: pie executable, aarch64），第三组报 invalid
  linker name。配方去掉默认 -fuse-ld 后 conan create 全绿（14 工具全部链接成功）。

rec_priority:           1
rec_approach:           default-linker-with-conf-override
rec_description: >
  ①配方默认不注入任何 -fuse-ld（跟随 clang 默认 linker）；
  ②提供 conf 开关（如 user.<pkg>:ld，接受名称或绝对路径）opt-in 注入
  -fuse-ld=<值>，CI worker 遇 lld/libxml2 问题时在 profile 设置即可，
  不改配方。
rec_command:            >
  # 配方: ld = self.conf.get("user.<pkg>:ld", default=None); flags += [f"-fuse-ld={ld}"] if ld
  # 环境探测: $CC t.c -o t && file t | grep -i pie; $CC t.c -fuse-ld=bfd -o t 2>&1 | grep -c "invalid linker name"
rec_auto_fix:           false
rec_impl:               conan-recipe-build

fallback_priority:      2
fallback_approach:      absolute-path-ld
fallback_description:   环境只有非标准路径的可用 linker 时，conf 里直接填绝对路径
                        （-fuse-ld=/path/to/ld）。
fallback_command:       user.<pkg>:ld=/abs/path/to/ld.lld
fallback_auto_fix:      false
fallback_impl:          conan-recipe-build

forbid_1_pattern:       -fuse-ld=bfd.*(default|默认|hardcode|硬编码)
forbid_1_reason:        bfd 在 HNP clang 15 真机不存在，硬编码使包在该类环境必挂。
forbid_1_consequence:   clang error: invalid linker name，构建零通过。
forbid_2_pattern:       -fuse-ld=lld.*(all|所有|default|默认)(?!.*worker)
forbid_2_reason:        部分 CI worker 的 lld 缺 libxml2.so.16（E544 层），反向硬编码同样有反例。
forbid_2_consequence:   在该类 worker 上链接失败（xmlFree symbol not found）。

principles:             P-TOOLCHAIN-001
causes:                 []
caused_by:              []
similar_to:             E544
conflicts_with:         []
prerequisite_of:        []

