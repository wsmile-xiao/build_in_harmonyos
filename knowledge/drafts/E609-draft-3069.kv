#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E609.kv，填写各字段
# 对应的人类文档: doc/E609.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E609
trigger_tool: conan
phase: configuration
error_signature: subprojects/.*/meson\.build: static_library got unknown keyword arguments|wrap-git|Could not resolve 'gitlab.gnome.org'|Unknown option

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: meson,conan,ohos,testing,portability
match_keywords: subproject, wrap-git, exports_sources, nodownload, libglib-testing, meson subproject, 拉取不可达, static_library soversion
title: meson subproject 上游 wrap-git 拉取不可达时，把修复后源码目录随 conan 包 exports_sources 预置 + wrap_mode=nodownload

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: meson 测试依赖常用 wrap-git 子项目（如 libglib-testing→gitlab.gnome.org）。OHOS CI 环境上游 git 服务不可达（503），且旧版子项目 meson.build 可能用了新版 meson 已拒绝的参数（static_library 带 version/soversion、docs 需 gtkdoc-scan），导致干净构建无法拉取也无法配置
affected_scope: 所有通过 meson subproject 拉取测试/构建依赖、且上游 wrap 源在 OHOS 环境不可达的软件适配
verification_cmd: conan create 干净构建（修复前 wrap 拉取失败/meson 配置报错；预置目录 + 本地修复后构建通过，测试正常执行）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 将修复后的子项目源码目录放进 conan 包（exports_sources = patches/*, subprojects/*），conan 自动复制到 source 目录；MesonToolchain project_options['wrap_mode']='nodownload' 禁止 meson 走 wrap 拉取；子项目 meson.build 做新 meson 兼容修复（static_library 去 version/soversion、docs 条件化）
rec_description: 预置目录 + nodownload 双保险：meson 检测到 subprojects/<name>/ 已存在就用本地，彻底绕开上游网络依赖；libmalcontent 0.10.2 + libglib-testing 0.1.0 先例
rec_command:            conanfile: exports_sources='patches/*','subprojects/*' + MesonToolchain project_options['wrap_mode']='nodownload'
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E609.md
last_updated: 2026-09-15
source_event: libmalcontent 0.10.2 适配（endlessm/malcontent）

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
