# DRAFT-pex-1.20140409-ohos-shell-entrypoint.kv - pex OHOS shell entrypoint
# Directly related Path B knowledge draft for PR #9365.

id: "DRAFT-pex-1.20140409-ohos-shell-entrypoint"
pr_ref: 9365
trigger_tool: "conan|shell|pex|/bin/sh|/system/bin/sh"
phase: "build|packaging|runtime|testing"
error_signature: "/bin/sh:.*not found|bad interpreter|Permission denied.*pex|pex.*not executable"
severity: 2
category: "ohos|shell|packaging|runtime|conan"
match_keywords: "pex, 1.20140409, petere/pex, POSIX shell, shebang, /bin/sh, /system/bin/sh, OHOS, test_package, application package, PATH"
title: "纯 POSIX shell 应用在 OHOS 上需要同时修正测试入口与安装后 shebang"

root_cause: "pex 1.20140409 的主脚本和上游测试使用 #!/bin/sh，而 OHOS 目标环境的可用系统 shell 是 /system/bin/sh；只改测试命令或只改安装文件都不能同时覆盖官方测试启动和安装后 CLI 直接执行。"

affected_scope: |
  在 OHOS 上打包纯 shell CLI、且上游脚本固定使用 /bin/sh 的 Conan
  application 配方。适用于 pex 及同类脚本应用，但复用时必须重新检查
  shell 语法、外部命令和目标镜像实际提供的解释器路径。

verification_cmd: |
  head -n 1 <package>/bin/pex
  test -x <package>/bin/pex
  /system/bin/sh test_package/test_pex.sh <package> <work>
  prove --exec /system/bin/sh t/*.t

rec_priority: 1
rec_approach: "ohos-shell-entrypoint-and-package-shebang"
rec_description: |
  在 OHOS build 阶段使用 `/system/bin/sh` 显式运行上游 TAP 文件，避免
  测试框架再次按 `/bin/sh` 查找解释器；在 package 阶段只对安装后的 pex
  副本替换 shebang 为 `#!/system/bin/sh`，保留上游脚本主体和参数语义。
  test_package 再检查可执行权限、shebang、帮助信息、XDG 路径和本地仓库
  操作，确认修正同时覆盖测试入口和消费入口。

rec_command: |
  conan create archives/p/pex/1.20140409 --build=missing
  /system/bin/sh test_package/test_pex.sh <package_folder> <work_folder>

rec_auto_fix: false
rec_impl: "recipe-specific-ohos-shebang-and-explicit-shell-runner"

fallback_priority: 2
fallback_approach: "explicit-shell-wrapper-only"
fallback_description: |
  如果目标环境不允许修改安装文件，只能通过 `/system/bin/sh <script>`
  调用；此方案不能证明用户直接执行 `bin/pex` 可用，不能作为完整包装
  结果或成功运行声明。
fallback_command: ""
fallback_auto_fix: false
fallback_impl: ""

forbid_1_pattern: "把 /bin/sh 存在当作 OHOS 前置条件|只修改 test_package 命令而不检查安装后的 shebang"
forbid_1_reason: "测试能被显式 shell 启动，不代表安装后的 CLI 入口能直接执行。"
forbid_1_consequence: "消费者通过 PATH 调用 pex 时会遇到 bad interpreter 或找不到 /bin/sh。"

forbid_2_pattern: "把 shebang 替换写成对上游源码逻辑的功能改写|用 bash 专有语法替代 POSIX shell 验证"
forbid_2_reason: "本适配的边界是解释器路径，不应借机改变 pex 的命令语义或引入额外 shell 依赖。"
forbid_2_consequence: "Linux/OHOS 行为分叉，后续问题无法判断来自目标 shell 还是来自配方改写。"

principles: "P004, P006"
causes: []
caused_by: []
similar_to: ["E010", "E018"]
