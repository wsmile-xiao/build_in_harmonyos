#====================================================================
# DRAFT-ohos-elf-skip-strip-codesign — 替代 E077 重签名流程的"跳过 strip、
#   直接打包 unstripped"路径（lld 链接期自动自签 .codesign）
# 触发事件: nymphcast 0.2-alpha0（0007 Makefile OHOS 跳过 strip）
# 扩展项：建议作为 E077 / harmonyos-specifics §5 的 similar_to/补充
#====================================================================

id:                     DRAFT-ohos-elf-skip-strip-codesign
trigger_tool:           strip|llvm-strip|make|runtime
phase:                  installation|post-install|runtime
error_signature:        operation not permitted|
                         exec format error|
                         EXIT=126|
                         strip.*codesign.*invalid|
                         strip.*signature

severity:               2
category:               linking|packaging|signing
match_keywords:         strip, llvm-strip, .codesign, signature, EPERM,
                         unstripped, self-sign, lld, link-time signing,
                         skip strip, codesign
title:                  OHOS strip→.codesign EPERM 的替代路径：Makefile 跳过
                        strip、直接打包 unstripped 二进制（无需重签名）

root_cause: >
  OHOS clang/lld 链接期会自动生成自签的 .codesign 段（lld 自签），
  strip/llvm-strip 修改 ELF 内容但不更新签名 → 内核拒绝加载，真机 exec
  报 operation not permitted / EXIT=126。E077/harmonyos-specifics §5 只给
  "重新签名"流程（objcopy 移除 .codesign → 重签 → chmod）；对"产物不需要
  瘦身/调试分离"的场景，更简单可靠的替代路径是**跳过 strip，直接打包
  unstripped 二进制**（体积增大，nymphcast 实测 53MB，但可执行且无重签名
  步骤）。这是对既有重签名知识的补充，不是替代。

affected_scope: >
  OHOS 上构建/打包后希望保留可执行产物的 C/C++ 软件，尤其是体积敏感度
  不高、无调试分离需求的 tool/app 型配方（nymphcast 类）。

verification_cmd: >
  readelf -x .codesign <binary> | head;    # 链接期自动自签段存在
  <binary> --version;                      # unstripped 直接可运行（EXIT=0）
  llvm-strip <binary> && <binary> --version  # 失败 EXIT=126 operation not permitted

rec_priority:           1
rec_approach:           skip-strip-package-unstripped
rec_description: >
  Makefile/recipe 层对 OHOS 跳过 strip 步骤（ifneq ($(OHOS),true) $(STRIP)...
  endif 或等价），打包 unstripped 二进制；README/notes 声明体积与无调试分离。
rec_command: >
  # Makefile（nymphcast 0007）
  ifneq ($(OHOS),true)
  $(STRIP) $(TARGET)
  endif
rec_auto_fix:           false
rec_impl:               makefile-ohos-skip-strip

fallback_priority:      2
fallback_approach:      E077-resign-flow
fallback_description: >
  若必须 strip/调试分离（体积敏感/需要 .debug），走 E077 四步重签名流程
  （objcopy 移除 .codesign → strip → 重签 → chmod a+x），顺序不可变。
fallback_command:       llvm-objcopy --remove-section .codesign ...; llvm-strip ...; binary-sign-tool sign ...
fallback_auto_fix:      false
fallback_impl:          post-install-script

forbid_1_pattern:       (strip|llvm-strip).*codesign.*不重签|直接 strip 不处理签名
forbid_1_reason:        裸 strip 使 lld 自签失效 → exec EPERM，且没有"移除旧段"
                        则 binary-sign-tool 无法覆盖（section already exists）。
forbid_1_consequence:   EXIT=126 operation not permitted，被误判为权限问题反复 chmod。

principles:             P017
similar_to:             E077
conflicts_with:
prerequisite_of:

doc_file:               knowledge/drafts/DRAFT-ohos-elf-skip-strip-codesign.md
last_updated:           2026-08-27
source_event:           archives/n/nymphcast/0.2-alpha0 patches/0007
                        （Makefile OHOS 跳过 strip）；round-5 真机实测

authors:                GoliWie <GoliWie@noreply.gitcode.com>
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-08-27
