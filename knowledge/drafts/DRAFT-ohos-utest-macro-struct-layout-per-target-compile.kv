#====================================================================
# 知识库草稿（DRAFT，待主编审核合入正式 E 编号条目）
# 来源: burp/3.3.0 适配——-DUTEST 改变 asfd 结构体布局，共享库 ODR 隐患
#====================================================================

id:                       DRAFT-ohos-utest-macro-struct-layout-per-target-compile
trigger_tool:              conan
phase:                     build
error_signature:           "struct.*size mismatch|ODR violation|undefined symbol.*asfd|mojibake.*mock|test binary crashes"
severity:                  high
category:                  build-system
match_keywords:            -DUTEST, test-only 宏, 结构体布局, ODR, mock 字段, 按目标编译, 共享库 ODR 隐患, main 保护, ifndef
title:                     test-only 编译宏（-DUTEST）给共用结构体加 mock 字段——镜像上游按 target 全量编译，勿建共享库

root_cause: >
  部分库的测试模式用编译宏（如 burp 的 -DUTEST）切换：宏开启时
  共用结构体（burp 的 asfd）追加 mock 字段（如 mock 的 send/recv 指针）、
  main() 被 #ifndef UTEST 保护。若 conanfile 图省事把主源文件抽成
  共享库 libburp（一次编译多目标复用），会出现两种 ODR 隐患：
  (a) 库与 runner 的宏定义不一致 → 同一结构体两处布局不同，
      跨 .so 边界读写即内存错乱（mojibake/崩溃，无编译报错）；
  (b) 符号重复/缺失（main 保护宏不一致时两个 main 或零个 main）。
  上游 autotools 的做法是每个 target 各自全量编译所需 .c（宏按
  target 设置），共享库根本不在这个设计里。

affected_scope: >
  所有"测试模式靠编译宏切换 + 共用结构体被宏改写"的 C/C++ 库
  （UTEST/TESTING/MOCK 类宏）。特征：上游 Makefile.am 中同一组
  源文件在多个 _SOURCES 里重复出现、且某 target 带额外 -D 标志。

verification_cmd: >
  # 确认哪些结构体被 test 宏改写
  grep -nE '#if(def| !defined)? *(defined\(UTEST\)|UTEST)' src/*.c src/*.h | head
  # 确认 main() 的保护宏
  grep -n 'ifndef UTEST' src/prog.c
  # 构建后对比两二进制的结构体大小（gdb/objdump 或 sizeof 打印）

rec_priority:              P1
rec_approach:              mirror-upstream-per-target
rec_description: >
  镜像上游编译结构，不要自创共享库：1) 主 target（burp）用主源集合
  编译（不带 -DUTEST）；2) test target（runner）用 主源集合 ∪ utest 源
  编译（带 -DUTEST），即上游 runner_SOURCES = main_SOURCES + utest
  的真实语义；3) 若 runner 要复用 main_SOURCES 里的 main() 文件
  （如 prog.c），先确认其 main() 包在 #ifndef UTEST 后（runner 带
  -DUTEST 编译时该 main 自动消失，不冲突）；4) conanfile/CMake
  overlay 按此拆两个 add_executable，源文件允许重复出现（各自编译，
  与上游 make 行为一致）；5) 绝不把带宏切换的结构体放进被多 target
  共享的 .so——布局不一致是静默内存 bug，不是链接错误。
rec_command: >
  # CMake overlay 示意
  add_executable(burp ${MAIN_SRCS})          # 不带 -DUTEST
  add_executable(runner ${MAIN_SRCS} ${UTEST_SRCS})
  target_compile_definitions(runner PRIVATE UTEST)
rec_auto_fix:              false
rec_impl: >
  手工：1) 从 Makefile.am 读出每个 target 的真实源集合与 CFLAGS
  差异；2) 结构体/宏改写点全量 grep 清单化；3) 按 target 全量编译
  生成 CMakeLists（源文件跨 target 重复是预期行为，勿"优化"成共享
  目标）；4) 验证：两 target 均编译通过、runner 跑通上游套件、
  主 target 行为不受 test 宏污染（用 sizeof 打印或断言核对关键
  结构体大小一致）。

prerequisite_of:           []
