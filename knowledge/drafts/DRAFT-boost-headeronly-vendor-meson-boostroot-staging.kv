#====================================================================
# DRAFT-boost-headeronly-vendor-meson-boostroot-staging.kv
# ohpcd boost 裁剪缺 header-only 组件：逐字 vendor + 官方单 TU src.hpp + meson boost_root staging
# 触发事件: bali-phy 4.1 HarmonyOS PC 适配（archives/b/bali-phy/4.1，patch 0001 + patches/boost-extra 183 头）
#====================================================================

id:                     DRAFT-boost-headeronly-vendor-meson-boostroot-staging
trigger_tool:           meson|conan|pkg-config|compile|clang
phase:                  configuration|compilation|link
error_signature:        boost/(json|uuid|convert|rational|compute).*No such file|
                         fatal error: 'boost/json\.hpp' file not found|
                         Dependency .*boost.*(json|chrono|program_options).* not found|
                         meson.build:.*(json|chrono|program_options).* not found

severity:               3
category:               boost|meson|conan|build-system|vendor|header-only|compat
match_keywords:         boost.json, boost/json, header-only, vendor, boost_root,
                         boost-bundle, src.hpp, single TU, uuid, convert, rational,
                         compute, BOOST_INCLUDE_LIBRARIES, version.hpp, meson,
                         PkgConfigDeps, eigen3.pc
title:                  ohpcd boost 只装精选头、缺 header-only 组件：逐字 vendor 缺失头 + 官方单 TU src.hpp 实例化 + meson boost_root staging bundle 使 meson 五模块解析

root_cause: >
  ohpcd/OHOS curated boost 配方用 BOOST_INCLUDE_LIBRARIES 只安装精选头文件子集，
  json/uuid/convert/rational/compute 这些 header-only 组件未安装，也没有配方导出
  Boost::json。bali-phy 硬依赖 <boost/json.hpp>（src/util/json.hh、src/mcon/mcon.H）
  及 <boost/convert.hpp>、<boost/rational.hpp>、<boost/compute/detail/sha1.hpp>，
  且 meson 需要 boost 根含 version.hpp 才能解析 program_options/random/system/
  chrono/json 五个模块；缺头直接编译失败，缺 boost_root 则 meson 依赖解析失败。
affected_scope: >
  所有依赖 boost header-only 组件（尤其 boost/json）的 OHOS 库；所有需要让 meson
  解析 boost 多模块的配方。与 E217-draft-4AC2 的区别：E217 面向编译库
  （locale.a 手工编译 + .pc prefix=/ + 平台映射），本条目面向 header-only 组件
  vendor + meson staging。
verification_cmd: >
  meson setup + meson compile 全量通过；最小探针：include <boost/json.hpp> 并
  parse value 编译链接运行；bali-phy 218/218 + test_package 10/10 + create_exit_code=0

rec_priority:           1
rec_approach:           vendor-headeronly-boost-staging
rec_description: >
  三步：①在配方 patches/ 内逐字 vendor Boost 1.91 缺失的 header-only 头
  （bali-phy boost-extra：json+uuid+convert+rational+compute，183 个文件，
  BSL-1.0，无 OHOS/musl 修改，不改任何 boost 配方）；②官方 header-only 用法 =
  恰一个 TU 包含 <boost/json/src.hpp>（0001 新增 src/util/boost-json-src.cc 注册进
  libutil_sources，所有可执行文件与 builtins 模块都链 libutil，json 符号全局可解析）；
  ③generate() 搭最小 meson boost 根（boost-bundle：真实 boost 的 version.hpp +
  vendor 头 + header-only boost/system + 编译件 .so 拷贝），经 meson [properties]
  注入 boost_root，使 meson 五个模块全部解析；真实 boost include 目录经 cpp_args
  -I 提供。
rec_command:            >
  # conanfile.py:
  #   tc.properties['boost_root'] = [<build>/boost-bundle]
  #   _stage_boost_bundle(): copy version.hpp + vendor json/... + boost/system + .so
  #   cpp_args.append('-I' + boost.package_folder + '/include')
  # 0001 patch: src/util/boost-json-src.cc 含 '#include <boost/json/src.hpp>'
rec_auto_fix:           false
rec_impl:               recipe-vendor-boost-staging

fallback_priority:      2
fallback_approach:      require-upstream-boost-json
fallback_description:   >
  若不允许 vendor 头（体积/合规要求），等待 ohpcd boost 配方补齐 json 组件并导出
  Boost::json；当前无该机制，故以 vendor+staging 为推荐方案。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       modify.*boost/.*conanfile|patch.*boost.*recipe
forbid_1_reason:        修改共享 boost 配方会污染其他依赖库（不污染上游/共享主检出纪律）
forbid_1_consequence:   其他库回归、交付边界失控
forbid_2_pattern:       download.*boost.*json.*(github|raw).*runtime|curl.*boost.*in.*build
forbid_2_reason:        构建期外网下载破坏可复现与离线构建
forbid_2_consequence:   设备直连 github 超时/无网构建失败（E017 场景）
forbid_3_pattern:       include.*<boost/json/src.hpp>.*(two|more than one).*TU
forbid_3_reason:        src.hpp 是"恰一个 TU"的 header-only 实例化模式，多处包含会重复定义
forbid_3_consequence:   链接期 duplicate symbol

principles:             P005, P011
similar_to:             E217, E035, E099, E153
conflicts_with:
prerequisite_of:

