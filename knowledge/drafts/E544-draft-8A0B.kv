#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E544.kv，填写各字段
# 对应的人类文档: doc/E544.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E544
trigger_tool: node|make|ohc-run
phase: testing
error_signature: No rule to make target 'check'|No rule to make target 'test'|tests/ 目录不存在|上游确无测试

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: testing|build-system|make
match_keywords: R51, upstream-test, node, vm, stub, webextension, pass-rate, test-report
title: 无测试上游（JS/webext）测试补充与 R51 通过率回填模板

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游 webext/JS 类源码无测试框架无 tests/（Makefile 仅 zip 打包）。R51 三步法要求清点证据 + 实际运行 + 通过率如实回填，且真人评审第一拒绝原因是测试未运行/通过率造假；需自行补充 node 单元测试
affected_scope: 上游无测试的 JS/webextension/脚本类软件；R51 清点(upstream-test-inventory.md)+补充单测+100% 通过率回填(test-report.md) 全链路
verification_cmd: /data/service/hnp/bin/node --jitless <test.js>; echo 0

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: ①R51 清点：源码树全文件清单+Makefile 原文+无 tests/ 证据 → upstream-test-inventory.md；②node+vm.createContext 注入 browser/document/navigator/window stub 真实执行源码，断言生成的 URL/行为（非 print-only）；沙箱禁 JIT 时用 node --jitless；③通过率=通过用例/N 必须 100%，失败修代码或修测试重跑；结果写入 test-report.md（含 N/N/通过率/运行命令/node 版本/关键断言）；④产物级消费者验证补齐「鸿蒙特有测试」口径（评审规则 12）：本机构建真实产物后以消费者视角装载验证（归档完整性/无路径穿越/manifest 元数据契约/引用资源闭包/脚本可装载/端到端查询链路/连续装载一致性），与源码级单测互不重复计数；归档产物的 sha256 因内嵌 mtime 不同，须以「逐条目字节比对」证明未篡改源码；⑤PR 描述表述合规（pc-pr-review 规则脚本判定，实测三例 debian 系包踩坑）：编译状态须写显式「编译状态：通过」否则 rule1/rule4 判 None；通过率禁占位符(N/A/待验证/TODO)且数字禁千分位逗号（46,525 会被读成 46 触发少报 FAIL）；上游 N=0 时适配后必须补测（rule8）；鸿蒙特有测试行缺行或为 0 均 FAIL（rule12）；PR 描述/MANIFEST.yml assertion_count/reports/草稿引用的断言数须完全一致（循环展开的断言按运行时计数）
rec_description: 无测试上游不谎报'无'，用 stub 注入补真实单测并回填通过率，满足 R51 评审口径
rec_command: /data/service/hnp/bin/node --jitless tmp/debianbuttons-tests/test-icedeb.js
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E544.md
last_updated: 2026-09-09
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

