#====================================================================
# DRAFT-appstream-1.2.0-r06-glib-host-tool-signing.kv
# OHOS 内核要求 ELF 含有效 .codesign 才能 exec；glib conan 包内宿主 ELF
# 工具（glib-compile-resources 等）在 CI 干净环境签名缺失/失效，构建期
# 直接 exec 报 EPERM code=126 → 消费者配方在构建私有目录复制工具后
# 移除旧签名并 binary-sign-tool 自签，wrapper exec 已签名副本
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R06）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           conan build (meson resource generation)
phase:                  build-host-tool
error_signature:        Operation not permitted.*glib-compile-resources|
                        code=126.*Generating.*as-resources|
                        glib-compile-resources.*Operation not permitted|
                        cannot execute.*glib.*bin.*ELF|exec.*EPERM.*host tool
severity:               1
category:               conan, signing, codesign, elf, host-tool, portability, build
match_keywords:         glib-compile-resources, glib-compile-schemas, .codesign,
                        binary-sign-tool, llvm-objcopy, selfSign, EPERM, code=126,
                        host tool, build-time exec, wrapper, conan, OHOS
title:                  构建期 exec 依赖包内 ELF 宿主工具：消费者侧复制→去旧签→自签→wrapper
root_cause:             OHOS 内核仅加载含有效 .codesign 签名段的 ELF。conan 依赖包
                        bin/ 下的宿主 ELF 工具（glib-compile-resources 等）在干净
                        环境签名缺失或失效；仅包装 LD_LIBRARY_PATH 不签名时，CI
                        干净重建 exec 即 EPERM（code=126），本地成功靠既有缓存。
affected_scope:         构建期 exec 依赖包 bin ELF 工具的 Conan 库（glib/meson 资源生成等）。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/
                        ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing
                        （全新 build 目录，须 [1/N]→[N/N] exit_code=0、0 命中 code=126）
rec_priority:           1
rec_approach:           consumer-side-host-tool-sign
rec_description:        在 generate() 中把依赖包 bin 宿主工具复制到构建私有目录；
                        对 ELF（魔数 \\x7fELF）先 llvm-objcopy --remove-section .codesign
                        清除旧签名残留，再 binary-sign-tool sign -inFile X -outFile X
                        -selfSign 1 自签；chmod 755 后 wrapper export 依赖库
                        LD_LIBRARY_PATH 并 exec 已签名副本；python 脚本直用。
rec_command:            |
  shutil.copy2 (glib_pkg/bin/tool, build_folder/glib-tools/tool.bin)
  if is_elf(tool.bin):
      llvm-objcopy --remove-section .codesign tool.bin   # 旧签名残留防护
      binary-sign-tool sign -inFile tool.bin -outFile tool.bin -selfSign 1
      os.chmod (tool.bin, 0o755)
  wrapper = '#!/bin/sh\nexport LD_LIBRARY_PATH=.../lib:$LD_LIBRARY_PATH\nexec "tool.bin" "$@"\n'
rec_auto_fix:           false
rec_impl:               recipe-change
forbid_1_pattern:       chmod.*glib-compile-resources.*without.*sign
forbid_1_reason:        未签名 ELF 无论权限如何都被内核拒（EPERM），chmod 无效
forbid_2_pattern:       wrapper.*exec.*original.*unsigned.*bin
forbid_2_reason:        wrapper 必须 exec 已签名副本，否则干净环境仍 code=126
principles:             P017
causes:                 []
caused_by:              glib 包宿主 ELF 签名缺口（依赖包现状）
similar_to:             E077
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-r06-glib-host-tool-signing.md
last_updated:           2026-09-25
source_event:           appstream-1.2.0 R06（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9