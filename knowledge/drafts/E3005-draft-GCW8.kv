#====================================================================
# Draft E3005 — cmocka uintptr_t 编译器内建宏守卫（typedef redefinition）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E3005
trigger_tool:           gcc|clang|cc
phase:                  compilation
error_signature:        redefinition of typedef .uintptr_t|conflicting types for .uintptr_t|typedef.*uintptr_t.*previously declared|__UINTPTR_TYPE__

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               headers, libc, musl, detection, compat
match_keywords:         uintptr_t, typedef, cmocka, __UINTPTR_TYPE__, redefinition, conflicting types, header guard, stdint
title:                  cmocka uintptr_t typedef 与新版 libc 冲突：用**编译器内建宏 __UINTPTR_TYPE__** 存在时跳过重复 typedef（避免 redefinition）
prescan_pattern:        redefinition of typedef .uintptr_t|typedef.*uintptr_t
prescan_globs:          *.h, *.c

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             cmocka.h 自行 `typedef unsigned long uintptr_t;`（或类似），而新版 libc（musl/glibc ≥某版本）已通过标准头提供 `uintptr_t`，二者叠加导致 `redefinition of typedef 'uintptr_t'` 编译错误。解决方式应优先用**编译器内建宏** `__UINTPTR_TYPE__`（编译器已定义的 `uintptr_t` 底层类型宏）做条件：若 `__UINTPTR_TYPE__` 已定义（即编译器会通过内建宏提供 uintptr_t），则跳过 cmocka 的重复 typedef——这与用平台宏不同，是**编译器内建/标准机制**，合规（非平台宏、非 R8 违规）。
affected_scope:         所有在 OHOS（新版 libc）上构建含 cmocka 的工程（third_party/cmocka 类 bundled 依赖）。
verification_cmd:       echo '__UINTPTR_TYPE__' | gcc -dM -E -x c - | grep UINTPTR   # 观察编译器是否内建提供 uintptr_t 底层类型

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           ohos-cmocka-uintptr-guard
rec_description:        在 cmocka.h 中，当 `__UINTPTR_TYPE__` 已定义时跳过自定义 `uintptr_t` typedef（`#ifdef __UINTPTR_TYPE__` 守卫），避免重复定义；这是编译器内建宏机制，非平台宏。
rec_command:            (echo '__UINTPTR_TYPE__' | gcc -dM -E -x c - )   # 先验证内建宏存在再决定是否守卫
rec_auto_fix:           false
rec_impl:               archives/s/samba/4.21.0/patches/0005-third_party-cmocka-cmocka.h.patch

fallback_priority:      2
fallback_approach:      use-stdint-native
fallback_description:   若编译器不提供 `__UINTPTR_TYPE__`，则走 `#include <stdint.h>` 原生 uintptr_t 分支，避免自定义 typedef。
fallback_command:       (make)   # 触发编译验证
fallback_auto_fix:      false

# ★ 禁止策略 ★
forbid_1_pattern:       #ifdef __OHOS__|#if.*(OHOS|aarch64).*uintptr|typedef.*uintptr_t.*#else.*__OHOS__
forbid_1_reason:        R8/PF5 禁平台宏；按平台分支隐藏真实头文件冲突。
forbid_1_consequence:   W4/preflight 宏检查命中；其它 libc 上误判。

# ═══ Layer 4: 原则引用 ═══
principles:             minimal-patch, platform-agnostic-fix, real-evidence-over-assumption

# ═══ 关系图 ═══
causes:                 [E3005]
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

