#====================================================================
# DRAFT-malint-0.2-legacy-automake-check-tests-environment
# 触发实例: malint 0.2 HarmonyOS PC shadow CI（2026-10-01）
# 主陈述: 老式 automake（并行 test-driver 之前）自定义 check 目标直接 exec
#          测试驱动脚本（$(srcdir)/runtest），HMDFS 无执行位全灭；Makefile.am
#          预留的 ${TESTS_ENVIRONMENT} 前缀占位可经 make 命令行注入 sh，
#          零补丁修复（make check TESTS_ENVIRONMENT=sh → All 6 tests passed）
#====================================================================

# ─── Layer 0: 错误面 ─────────────────────────────────────────────
id:                     DRAFT-malint-0.2-legacy-automake-check-tests-environment
source_lib:             malint 0.2
trigger_tool:           make|automake|check|sh
phase:                  testing
error_signature:        permission denied: \./runtest|
                        FAIL: .*\.test.*\n.*of 6 tests failed|
                        check-recursive.*Error

# ─── Layer 1: 识别层 ─────────────────────────────────────────────
severity:               2
category:               testing, hmdfs, autotools, build-system
match_keywords:         make check, TESTS_ENVIRONMENT, runtest, custom check
                        target, legacy automake, pre-test-driver, Permission
                        denied, no exec bit, HMDFS, command-line override
title:                  老式 automake 自定义 check 目标直接 exec 测试脚本：TESTS_ENVIRONMENT=sh 命令行注入（零补丁）

# ─── Layer 2: 诊断层 ─────────────────────────────────────────────
root_cause: >
  autoconf 2.5x 时代 Makefile.am 的自定义 check 目标在 for 循环里直接
  ${TESTS_ENVIRONMENT} $(srcdir)/runtest $$t —— 不经 test-driver，
  LOG_COMPILER 无效；HMDFS 不授予脚本执行位（E046，chmod 不生效），
  直接 exec ./runtest 即 Permission denied。
affected_scope: >
  Makefile.am 含 ${TESTS_ENVIRONMENT} 占位的自定义 check/test 目标
  （grep Makefile.am 确认），HMDFS 或任何不授予脚本执行位的文件系统。
verification_cmd: >
  grep -n "TESTS_ENVIRONMENT" regress/Makefile.am   # 占位存在即可用本方案;
  make check TESTS_ENVIRONMENT=sh                    # 期望 All N tests passed

# ─── Layer 3: 方案层 ─────────────────────────────────────────────
rec_priority:           1
rec_approach:           make-check-tests-environment-sh
rec_description: >
  make 命令行注入 TESTS_ENVIRONMENT=sh：每条测试命令展开为
  sh $(srcdir)/runtest $$t，由系统 sh 显式解释执行，绕开执行位要求。
  零补丁、零 Makefile.am 修改、无机械 diff，健康环境同样正确。
  修复优先级：命令行 TESTS_ENVIRONMENT > Makefile.am 补丁（libgctp 的
  LOG_COMPILER 场景）> 配方内手写循环（kakasi 场景，须容 77）。
rec_command: >
  make check TESTS_ENVIRONMENT=sh
rec_auto_fix:           false
rec_impl:               conanfile-run-kwarg

forbid_1_pattern:       TESTS_ENVIRONMENT 传值带尾随空格（"sh "）
forbid_1_reason:        make 命令行变量剥尾空格，得到空值注入，回到直接 exec
forbid_1_consequence:   伪修复——测试仍全灭，误判为方案无效
forbid_2_pattern:       在并行 test-driver 项目套用本方案
forbid_2_reason:        test-driver 不走 TESTS_ENVIRONMENT，须用 LOG_COMPILER
forbid_2_consequence:   注入无效，浪费排查轮次（先 grep Makefile.am 判型）

# ─── Layer 4: 原则引用 ───────────────────────────────────────────
principles:             []

# ─── 关系图 ─────────────────────────────────────────────────────
causes:                 []
caused_by:              [E046, E087]
similar_to:             [E386, E228]
conflicts_with:         []
prerequisite_of:        []

# ─── 元数据 ─────────────────────────────────────────────────────
