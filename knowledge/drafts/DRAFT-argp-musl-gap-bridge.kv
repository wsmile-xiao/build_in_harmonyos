#====================================================================
# DRAFT-argp-musl-gap-bridge.kv — musl/OHOS argp API 缺失补齐模式（路径 B 素材）
# 来源: argp-standalone 1.4.1 (ericonr fork) 适配，2026-09-04
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E-draft-argp-musl-gap
trigger_tool:           clang|ld|configure
phase:                  compilation|linking
error_signature:        fatal error: ['"]?argp\.h['"]?: No such file or directory|
                         undefined reference to ['"]?argp_parse|
                         undefined reference to ['"]?argp_usage|
                         undefined reference to ['"]?argp_help

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, libc, musl, ohos, portability
match_keywords:         argp, argp.h, argp_parse, musl, OHOS, api-gap,
                         glibc-only, libargp, argp-standalone,
                         command-line parsing, coreutils, elfutils,
                         gnulib, No such file or directory
title:                  musl/OHOS 无 glibc argp(3) API，用 argp-standalone 静态库补齐
prescan_pattern:        #include\s*<argp\.h>|argp_parse\s*\(
prescan_globs:          *.c, *.h, *.cc, *.cpp

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS 使用 musl libc，而 argp(3) 是 glibc 专属的
                        命令行解析 API（argp.h + argp_parse/argp_usage/
                        argp_help），musl 从未实现。大量 GNU 软件
                        （coreutils 系、elfutils、gnulib 生态）在源码里
                        #include <argp.h>，在 musl/OHOS 上编译直接报
                        fatal error: argp.h: No such file or directory；
                        或（自带 argp.h 副本时）链接期报 undefined
                        reference to argp_parse。
                        这不是单包 bug 而是 API 家族缺口：argp 与
                        musl-fts / musl-obstack 同属『glibc 有、musl 无』
                        补齐库家族。Alpine Linux 生态同款问题，
                        其解法就是 argp-standalone 包。
affected_scope:         所有用 argp 解析命令行的 GNU 软件适配。仓库内
                        下游实证：elfutils/0.195（self.requires
                        argp-standalone）、execstack/20130503、
                        addrwatch 系（系统装路径）。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           musl-argp-gap-bridge-via-argp-standalone
rec_description:        跨库可复用补齐模式：
                        【下游怎么消费】conan 配方写
                        self.requires("argp-standalone/<ver>")——注意是
                        host 依赖（requires）而非 tool_requires：argp 是
                        目标机运行时 API，参与目标机链接，随制品链分发
                        （elfutils/0.195 实证写法）。
                        【本包适配四要点】
                        ① GitHub archive tarball 不含 configure（autoreconf
                          产物不进版本库），须自举；设备/CI 无 automake 时
                          tool_requires automake/1.18 + libtool/2.5.4。
                        ② OHOS musl 的 libintl.h 是空壳（宏在、符号不在）：
                          configure 传 ac_cv_header_libintl_h=no，让
                          argp-help.c 走 #define dgettext(d,m) (m) 直通分支。
                          勿用 -Wno-int-conversion 糊（链接期照样缺
                          __dcgettext）；亦勿 LIBS=-lintl（引入 gettext
                          重依赖，--disable-nls 场景不需要）。
                        ③ 上游 Makefile.am 全是 noinst_*（设计为被内嵌
                          编译），make install 空操作 → package() 手工装
                          argp.h + libargp.a（Alpine APKBUILD 同法）。
                        ④ configure/config.status 内嵌 umask 077 在 HMDFS
                          上 mktemp 目录不可写（E011），autoreconf 之后
                          替换为 umask 022。
rec_command:            下游配方: self.requires("argp-standalone/1.4.1");
                        本包: conan create <dir> -pr:h=ohos-aarch64
                        -pr:b=ohos-aarch64 --build=missing
rec_auto_fix:           false
rec_impl:               recipe-pattern

fallback_priority:      2
fallback_approach:      gnulib-argp-module
fallback_description:   软件本身用 gnulib 时，可 gnulib-tool --import argp
                        把 argp 模块源码内嵌进项目（gettext/gnulib 系
                        软件的官方姿势）。重且侵入源码，仅当 conan 依赖
                        不可用时选。
fallback_command:       gnulib-tool --import argp
fallback_auto_fix:      false
fallback_impl:          source-import

# ★ 禁止策略 ★
forbid_1_pattern:       rm.*argp\.h|删除.*argp\.h|宏定义.*空壳.*argp_parse
forbid_1_reason:         禁止在下游源码里删 argp.h 引用或写空壳 stub 宏
                        （R8）：argp 是实质命令行解析逻辑，空壳=功能缺失，
                        --help/--usage/参数解析全部失效。
forbid_1_consequence:   程序接受所有参数但解析结果错误，测试期才暴露

# ═══ Layer 4: 原则引用 ═══
principles:              P004, P006

# ═══ 关系图 (Relations) ═══
similar_to:             musl-fts / musl-obstack（同族 glibc-有-musl-无 补齐库）
caused_by:              E011（HMDFS umask，本包适配子问题）、E015（argp
                        dgettext 链接，本包适配子问题）
prerequisite_of:        elfutils、execstack 等所有 argp 消费者

# ═══ 元数据 ═══
doc_file:               DRAFT-argp-musl-gap-bridge.md
last_updated:           2026-09-04
source_event:           archives/a/argp-standalone/1.4.1 适配（ericonr fork 1.4.1，上游测试 2/2，test_package 8/8）

