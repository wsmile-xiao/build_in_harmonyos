id:                     E999
trigger_tool:           python
phase:                  compilation
error_signature:        not a gzip file|tarfile\.open.*r:gz|EOFError: Compressed file ended

severity:               2
category:               build-system, autotools, portability
prescan_pattern:        tarfile\.open\(.*["']r:gz["']
prescan_globs:          conanfile.py, *.py

# ═══ Layer 2: 根因层 (Root Cause) ═══
root_cause:             Python tarfile.open 以 mode="r:gz" 打开 .tar.xz 归档时抛出 "not a gzip file"（read_gzip 魔数校验失败）。x.org 官方发布 .tar.xz，而常见镜像/文档示例默认 r:gz，导致 build() 内源码/SDK 提取静默失败，下游连锁报 fatal error: 'xxx.h' file not found（PR #6361 CI 25 连红的真实根因之一）。

# ═══ Layer 3: 处方层 (Prescription) ═══
rec_approach:           1) tarfile.open 一律用 mode="r:*"（自动识别 gz/xz/bz2，纯 Python 无需外部 xz 依赖）；2) 多镜像 fallback 逐个 try/except，全部失败才 raise；3) 下载后先 sha256 校验再解压；4) 提取结果做哨兵校验（关键文件存在才视为成功），防止"下载成功但解压为空"静默通过。参考实现: archives/x/xf86-video-r128/6.13.0/conanfile.py (_download_xorg_server_source/_extract_sdk_headers)。

verify_cmd:             python3 -c "import tarfile; t=tarfile.open('xorg-server-21.1.15.tar.xz','r:*'); print(len(t.getmembers()))"

# ═══ Layer 4: 证据层 (Evidence) ═══
evidence_url:           https://atomgit.com/OpenHarmonyPCDeveloper/build_in_harmonyos/merge_requests/6361
related_pkgs:           xf86-video-r128
