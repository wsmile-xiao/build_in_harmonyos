#====================================================================
# DRAFT-malint-0.2-device-shell-outage-autotools-survival
# 触发实例: malint 0.2 HarmonyOS PC shadow CI（2026-10-01）
# 主陈述: 真机 /bin/sh 与 hnp bash 同时不可用（设备级故障，同期其它库 run
#          同挂）时，autotools 构建需五环存活链：shutil.which 回退 shell、
#          zsh 副本作 PATH 首位 bash 入口、解释器直接执行 configure 绕
#          shebang exec、make SHELL= 注入、TMPDIR+TMPPREFIX 双注入（zsh
#          here-doc 不读 TMPDIR）
#====================================================================

# ─── Layer 0: 错误面 ─────────────────────────────────────────────
id:                     DRAFT-malint-0.2-device-shell-outage-autotools-survival
source_lib:             malint 0.2
trigger_tool:           bash|sh|zsh|configure|make|conan
phase:                  configuration|build|testing
error_signature:        permission denied: bash|
                        /bin/sh: bad interpreter: Permission denied|
                        unable to make temporary file: Read-only file system|
                        can't create temp file for here document: read-only file system|
                        KC: knowledge check failed

# ─── Layer 1: 识别层 ─────────────────────────────────────────────
severity:               2
category:               ohos, shell, autotools, toolchain, runtime
match_keywords:         bash permission denied, hnp/bin/bash, /bin/sh,
                        bad interpreter, shell outage, zsh fallback,
                        shutil.which, CONFIG_SHELL, TMPPREFIX, here document,
                        make SHELL=, device shell failure
title:                  设备系统 shell 双故障（/bin/sh + hnp bash 不可用）的 autotools 五环存活链

# ─── Layer 2: 诊断层 ─────────────────────────────────────────────
root_cause: >
  设备 shell 基础设施故障（疑似系统 bash ELF 签名/标签失效，E077/E009 家族）：
  /data/service/hnp/bin/bash 完全不可访问、/bin/sh 执行挂死、/tmp 只读。
  鉴别要点：同期其它库 shadow CI run 以相同方式失败（对比 ~/ohos-test-runs/
  最近 run），是设备级故障而非包问题。连锁：CI/配方调 bash 挂 → zsh 执行
  脚本时 exec shebang 的 /bin/sh 挂 → configure 探测到的 PATH 中 cc 是
  shebang 失效的 HMDFS 包装脚本，三次踩同一雷。
affected_scope: >
  shell 故障期所有依赖 bash//bin/sh 的 CI 门禁（KC）、autotools configure/
  make/check、以及任何经 shebang exec /bin/sh 的脚本执行路径。
verification_cmd: >
  ls -la /data/service/hnp/bin/bash 2>&1   # Permission denied 即故障态;
  /bin/sh -c true; echo rc=$?              # 挂死/非零即故障态;
  ls -dt ~/ohos-test-runs/*/ | head -3     # 对比同期 run 是否同挂（设备级判定）

# ─── Layer 3: 方案层 ─────────────────────────────────────────────
rec_priority:           1
rec_approach:           shell-fallback-chain-zsh-survival
rec_description: >
  五环存活链：1) CONFIG_SHELL 经 shutil.which 校验后回退 PATH bash/sh；
  2) 设备侧一次性：HMDFS→HMDFS 复制 zsh 为 bash 放 job env PATH 首位目录
  （系统分区→HMDFS 复制会被拒，标签不随复制）；3) {shell} ./configure
  解释器直接执行 + make SHELL={shell}（绕 shebang exec /bin/sh）；
  4) TMPDIR 与 TMPPREFIX 同时指向 build 目录自建 tmp/（zsh here-doc 只认
  TMPPREFIX，不读 TMPDIR）；5) CC 从 tools.build:compiler_executables
  conf 显式 env 注入（R33），绕开 PATH 中失效的 cc 包装脚本。
rec_command: >
  python: shell = CONFIG_SHELL if shutil.which(CONFIG_SHELL) else
  (bash if shutil.which("bash") else "sh"); env TMPDIR=x TMPPREFIX=x/zsh
  CC=<conf-c> {shell} ./configure --build=T --host=T; make SHELL={shell};
  make check SHELL={shell} TESTS_ENVIRONMENT=sh
rec_auto_fix:           false
rec_impl:               conanfile-shell-fallback-chain

forbid_1_pattern:       因 KC fail 修改 ci/ 公共基础设施脚本
forbid_1_reason:        设备级故障不该由包适配改动公共 CI 承担（基础设施红线）
forbid_1_consequence:   破坏一库一 PR 边界，CI 行为被单库私改
forbid_2_pattern:       把系统分区二进制复制到 HMDFS 当 shell 用
forbid_2_reason:        ELF 标签/签名不随复制保留，exec 必被拒（实测）
forbid_2_consequence:   permission denied，浪费排查轮次

# ─── Layer 4: 原则引用 ───────────────────────────────────────────
principles:             [R33, R49]

# ─── 关系图 ─────────────────────────────────────────────────────
causes:                 []
caused_by:              []
similar_to:             [E077, E009, E037, E165, E386, E002]
conflicts_with:         []
prerequisite_of:        []

