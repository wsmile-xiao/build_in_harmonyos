#====================================================================
# harmonyos-proc-net-stale-entry-correction.kv
# 知识库过时条目纠错机制: 旧条目与真机现状矛盾时, 实证边界→
# 新条目记录最新事实+修订证据→旧条目标注修订; 实例=E6400 的
# "/proc/net 其余项可读" 与 2026-09-26 实测 12/12 全线 EACCES 矛盾
#====================================================================

id:                     E434
trigger_tool:           netstat|route|arp|ifconfig|net-tools|iproute2|
                         知识库条目与真机现状矛盾(通用)
phase:                  runtime
error_signature:        旧条目断言 vs 真机实测矛盾|
                         /proc/net/route.*Permission denied|
                         /proc/net/arp.*Permission denied|
                         /proc/net/dev.*Permission denied

severity:               2
category:               knowledge-maintenance, runtime, filesystem
match_keywords:         stale entry, 过时条目, 纠错, 修订, correction,
                         /proc/net, Permission denied, EACCES,
                         restricted assert, 权限边界, 平台演进

root_cause:             知识库条目随平台演进过时: E6400 曾记
                         "/proc/net 其余项可读(仅 /proc/crypto 隐藏)",
                         2026-09-26 真机实测 /proc/net 文件内容 12/12
                         全线 EACCES(route/arp/dev/tcp/udp/unix/
                         sockstat/stat/wireless/protocols/netstat/
                         if_inet6), 仅目录列举 ls 可读; 旧条目继续
                         存在会误导后续网络工具适配(按"可读"写断言
                         →真机 FAIL), 而 Linux/Android 上这些文件
                         世界可读, 差异在 OHOS 沙箱权限模型

affected_scope:         所有依赖知识库条目做适配/断言决策的场景;
                         网络类 /proc 类工具尤甚(平台权限与文件系统
                         行为随版本演进, 历史条目易过时)

verification_cmd:       head -c 40 /proc/net/tcp 2>&1
                         # Permission denied(12/12 文件全拒)
                         ls /proc/net/ 2>&1 | head -3
                         # 目录列举正常(70+ 条目)
                         ifconfig -a 2>&1 | head -5
                         # Warning + 降级列出 lo/wlan0

rec_priority:           1
rec_approach:           stale-entry-correction
rec_description:        发现旧条目与真机矛盾→逐文件实证边界(矩阵)→
                         新条目记录最新事实+修订证据→旧条目标注修订
                         (新条目 causes 引用)→同时给出断言策略
                         (restricted-assert: 仅 rc!=0 且输出含
                         Permission denied 字样归平台受限, 其余非零
                         rc 仍硬 FAIL; 每个受限工具须另有真实 PASS
                         维度兜底, 全受限零 PASS 仍失败)
rec_command:            DRAFT-5919 草稿实例(12/12 矩阵 + E6400 修订
                         证据 + test.sh restrict() 模式):
                         archives/n/net-tools/2.1/test_package/test.sh
rec_auto_fix:          false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      evidence-partial
fallback_description:   无法实证全边界时至少记录矛盾点与触发实例,
                         勿删旧条目(保留历史轨迹), 新条目 causes
                         引用即可; 断言策略无法全覆盖时退化为逐工具
                         实测记录
fallback_auto_fix:     false

forbid_1_pattern:       不实证就改写旧条目(可能引入新错误, 修订必须
                         附日期+设备+uid+矩阵); 不把任何 Permission
                         denied 一律放行(其他文件/路径的权限拒绝可能
                         是真 bug, 放行必须限定 /proc/net 网络查询
                         语境 + rc 非零 + 输出佐证)

principles:

causes:                 E429(/proc/diskstats 仅 root 可读, 降级补丁
                         方案——事实条目近亲), E031(htop /proc 整体
                         受限——事实条目近亲), E303(受限进程文件系统
                         探测——事实条目近亲), E6400(被修订条目:
                         "/proc/net 其余项可读"已过时)
