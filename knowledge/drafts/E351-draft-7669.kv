#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E351.kv，填写各字段
# 对应的人类文档: doc/E351.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E351
trigger_tool: ohc-run.py init-build/conan-init/conan-verify/finish
phase: init
error_signature: 归档路径出现在 \$HOME/.opendesk/apps/skills/resources/openharmony-compile-agent/archives/|找不到 .build-context-<name>-<ver>

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: tooling, init-build, conan-init, project-dir
match_keywords: OHC_PROJECT_DIR, find_project_dir, project-dir, 归档路径错误, skill 目录, archives 写错位置
title: ohc-run.py 在仓库工作区运行时 find_project_dir 误指 skill 安装目录，归档/上下文文件写错位置

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: ohc.utils.find_project_dir() 的搜索序：①OHC_PROJECT_DIR 环境变量（要求该目录下有 SKILL.md）②从脚本位置向上找 SKILL.md（skill 安装目录自带 SKILL.md，优先命中）③ATOMCODE_HOME ④~/.opendesk。当在 build_in_harmonyos 仓库工作区执行 ohc-run.py 而未设置 OHC_PROJECT_DIR 时，②先命中 skill 安装目录（\$/storage/.../openharmony-compile-agent，其下有 SKILL.md 且自带完整 archives/ 镜像），归档骨架与 .build-context 被写到 skill 目录而非仓库
affected_scope: 一切在 build_in_harmonyos 仓库工作区直接执行 ohc-run.py 子命令（init-build/conan-init/conan-verify/finish/graph/result 等）且未设置 OHC_PROJECT_DIR 的场景；skill 安装目录自带 archives/ 镜像与 SKILL.md，误写会污染 skill 数据目录且仓库归档缺失
verification_cmd: echo \$OHC_PROJECT_DIR && ls \$OHC_PROJECT_DIR/archives/<字母>/<包名>/<版本>/manifest.yaml

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: export-project-dir
rec_description: 每次执行 ohc-run.py 前 export OHC_PROJECT_DIR=<仓库绝对路径>（仓库根有 SKILL.md 才生效），同时给子命令带 --project-dir <仓库路径> 双保险（init-build/conan-init/conan-verify/finish/graph 均支持）。若已误建：删除 skill 目录 archives/<字母>/<包名> 误建内容与误生成的 .build-context-*，然后带 --project-dir 重跑
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E351.md
last_updated: 2026-09-03
source_event: portablegl 0.100.0 HarmonyOS PC 适配（archives/p/portablegl/0.100.0）

# ═══ 知识协作 (Authorship & Provenance) ═══
