#====================================================================
# DRAFT-reactphysics3d-0.10.2-cmakedeps-plain-target - CMakeDeps
# 无命名空间裸 target：test_package 链接目标必须与生成器实际产物一致
#====================================================================

id:                     DRAFT-reactphysics3d-0.10.2-cmakedeps-plain-target
trigger_tool:           conan|conan-verify|conan create|cmake|CMakeDeps|test_package
phase:                  verification|testing|conan-create
error_signature:        Target .* links to: .* but the target was not found|
                         Possible reasons include.*typo in the target name.*find_package.*IMPORTED target|
                         CMake Generate step failed

severity:               3
category:               conan, cmake, testing
match_keywords:         CMakeDeps, cmake_file_name, cmake_target_name, 无命名空间, plain target,
                         test_package, target_link_libraries, find_package, ReactPhysics3DConfig,
                         IMPORTED target, namespace, ::, conan create, G2
title:                  CMakeDeps 无命名空间裸 target：package_info 显式设置不带 :: 的 cmake_target_name 时，
                         test_package 链接目标必须与生成器实际产物（裸名）一致

root_cause:             |
  Conan 2 CMakeDeps 按 package_info() 的 cmake_file_name / cmake_target_name
  生成 find_package 文件与 IMPORTED target。当 cmake_target_name 为不带 `::`
  的裸名（如 "reactphysics3d"）时，CMakeDeps 只创建无命名空间 target
  （<cmake_file_name>Targets.cmake 中 `add_library(<裸名> INTERFACE IMPORTED)`），
  不会自动产生 `<cmake_file_name>::<裸名>` 别名。若 test_package/CMakeLists.txt
  按惯例写命名空间目标（reactphysics3d::reactphysics3d 或 ReactPhysics3D::reactphysics3d），
  CMake configure 期即报 target not found，conan create 的 test_package 阶段失败。

affected_scope:         |
  CMake 库配方在 package_info() 显式设置非命名空间 cmake_target_name（无 ::），
  且 test_package 通过 CMakeDeps 消费自身包的场景（OHOS aarch64 交叉编译同样触发）。

verification_cmd:       grep 'add_library' <build>/generators/<cmake_file_name>Targets.cmake; conan create <recipe> -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing

rec_priority:           1
rec_approach:           match-generated-cmakedeps-target
rec_description:        |
  test_package 的链接目标名以 CMakeDeps 生成器实际产物为准：
  先查 generators/<cmake_file_name>Targets.cmake 中的 add_library 目标名，
  再用该名链接。裸名 cmake_target_name → 链接裸名；带命名空间
  （如 "ReactPhysics3D::reactphysics3d"）→ 链接命名空间目标。
  也可在配方 package_info 中把 cmake_target_name 写成带 :: 的形式，
  使下游得到命名空间目标，但 test_package 仍须与生成产物一致。
rec_command:            |
  # 生成器产物确认
  grep -n 'add_library' <build>/generators/ReactPhysics3DTargets.cmake
  # test_package/CMakeLists.txt
  find_package(ReactPhysics3D REQUIRED)
  add_executable(test_reactphysics3d test.cpp)
  target_link_libraries(test_reactphysics3d reactphysics3d)
rec_auto_fix:           false
rec_impl:               cmakedeps-target-name-align

fallback_priority:      2
fallback_approach:       namespaced-target-name
fallback_description:   |
  将配方 package_info 的 cmake_target_name 改为带命名空间形式
  （如 cmake_target_name="ReactPhysics3D::reactphysics3d"），生成器即产出
  命名空间目标；test_package 链接 ReactPhysics3D::reactphysics3d。
fallback_command:       self.cpp_info.set_property("cmake_target_name", "ReactPhysics3D::reactphysics3d")
fallback_auto_fix:      false
fallback_impl:          recipe-namespace-target

forbid_1_pattern:       伪造 target|cmake.test\(\) 委托 CTest 而忽略显式运行|硬编码 dev 机 conan 缓存路径
forbid_1_reason:        target 名必须与 CMakeDeps 生成产物一致，禁止臆测命名；测试须显式运行（E298）。

principles:             P012

causes:                 []
caused_by:              []
similar_to:             [E473, E321, E322]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-reactphysics3d-0.10.2-cmakedeps-plain-target.md
last_updated:           2026-09-07
source_event:           reactphysics3d/0.10.2 (pc5-14): R01 conan-verify G2 test_package 阶段 target not found
                          （reactphysics3d::reactphysics3d / ReactPhysics3D::reactphysics3d 均失败），
                          查生成器 ReactPhysics3DTargets.cmake 确认为裸 target reactphysics3d，
                          改为链接裸名后 G2-G4/L2/L4/L5 全 PASS
draft:                  true
contributor_id:         5-14
