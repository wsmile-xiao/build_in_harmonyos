#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: test|clang|ld
phase: testing
error_signature: assertion count|测试用例数|run [0-9]+ in|TEST_FILTER|RUN_TEST|strstr

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: testing, portability, ohos
match_keywords: TEST_FILTER, RUN_TEST, strstr, substring filter, duplicate count, assertion count, 用例数, 重复计数, 虚高
title: 子串匹配的单元测试过滤器会让逐用例断言数重复计数，必须按名字长度降序做超串归减法

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游测试框架用 strstr(#test, filter) 选测（Cesanta unit_test 等），一个过滤器会连带命中所有名字包含它的用例，逐个过滤器求和必然重复计数；同时该框架的 RUN_TEST 在首个失败即 return，全量跑一次只能拿到第一个失败之前的断言数，两个缺陷合起来让『用例数/断言数』无法直接照抄日志
affected_scope: 所有以字符串子串选择用例的 C 单元测试框架（fossa、mongoose 及其派生），以及任何需要在 CI 中如实上报用例数与断言数的适配任务
verification_cmd: python3 - <<'PY'  # 计算过滤器集合是否存在掩码对
import re,itertools
names=re.findall(r'RUN_TEST\((test_[a-z0-9_]+)\)', open('test/unit_test.c').read())
names=sorted(set(names))
print('mask pairs:', [(a,b) for a,b in itertools.permutations(names,2) if a!=b and a in b])
PY

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: desc-length-substring-subtraction
rec_description: 按用例名长度降序逐个以名字为过滤器运行，每个 run 的断言总数减去其中已计量过的长名字超串断言数，即得该用例真实断言数；求和即无重复的真实总数
rec_command: 
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: disjoint-greedy-groups
fallback_description: 按长度升序贪心构造不相交分组：已被前面分组覆盖的用例名不再作为过滤器，未跑到的用例如实记为未执行
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 直接求和|sum.*assert|789
forbid_1_reason: 把各过滤器 run 的断言数直接相加会重复计入超串用例，报告的用例数/断言数高于真实值
forbid_1_consequence: PR 描述与 MANIFEST 的测试统计虚高，评审按不实现场退回，且掩盖真实回归
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: 

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E410, E265
conflicts_with:         []
prerequisite_of:        []

