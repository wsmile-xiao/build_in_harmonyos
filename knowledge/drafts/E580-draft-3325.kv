#====================================================================
# E580.kv — conandata.yml 注释含 https URL 被 pre-download 正则误提取
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E580
trigger_tool:           conan|build_and_test.sh|python
phase:                  installation
error_signature:        NotADirectoryError: \[Errno 20\] Not a directory: '.*predl_cache.*/archive/v2\.0\.tar\.gz'|gh-proxy\.com/file://|Could not download from the URL .*file:///

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               ci-script, python, package, url-extraction
match_keywords:         predl_cache, pre-download, conandata.yml, 注释, comment, https URL, 误提取, NotADirectoryError, file://, gh-proxy, build_and_test.sh, 正则提取
title:                  conandata.yml 注释/非 sources 段含 https URL 被 build_and_test.sh pre-download 正则误提取为下载源

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             ci/conan/build_and_test.sh 的 pre-download 脚本用 url_pattern
                        '(?:^|\s)(?:url:?\s*)?["\']?-?\s*(https?://[^\s"\']+)' 对
                        conandata.yml 全文做 re.findall 提取源码 URL，该正则不区分配置段，
                        会把注释行（# upstream: https://github.com/...）中的 URL 也当作
                        下载源抓取。随后对误提取 URL 下载得到的文件做
                        content.replace(url, file://...)，用注释 URL 前缀替换完整 URL
                        （如 https://github.com/scality/Droplet 替换进
                        https://github.com/scality/Droplet/archive/v2.0.tar.gz 头部），
                        拼出 predl_cache/{hash}_Droplet/archive/v2.0.tar.gz 这种
                        "文件/子路径" 非法路径 → conan get() 抛 NotADirectoryError，
                        且镜像前缀叠加形成 gh-proxy.com/file:// 无效 URL。
affected_scope:         所有 conandata.yml 中存在注释含 https URL（或非 sources 段
                        含 URL）的包。全仓实证：237 个 conandata.yml 注释含 https://。
verification_cmd:       python3 -c "import re;raw=open('conandata.yml').read();\
                        p=r'(?:^|\s)(?:url:?\s*)?[\"\']?-?\s*(https?://[^\s\"\']+)';\
                        print([u for u in re.findall(p,raw,re.M)] );# 观察是否混入注释 URL

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           comment-url-free-conandata
rec_description:        conandata.yml 的注释行不得包含带 scheme 的 https:// URL，
                        改用纯文本描述（如 "# upstream: scality/Droplet (tag v2.0)"）；
                        若必须保留 URL 则放在 sources.url 正式字段内。
rec_command:            sed -i 's|# upstream: https://github.com/\(.*\)|# upstream: \1|' conandata.yml
rec_auto_fix:           false
rec_impl:               manual-edit

fallback_priority:      2
fallback_approach:      verify-restore-after-ci
fallback_description:   若 CI 已改写 conandata.yml 为 file:// 或镜像列表形式，在 CI 后
                        用 git checkout 恢复官方单值 URL 并做 predl_cache 清理
fallback_command:       git checkout -- archives/*/*/*/conandata.yml; rm -rf .build-cache/predl_cache
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       在 sources 段注释中书写 https?:// 完整 URL
forbid_1_reason:        pre-download 正则对全文提取 URL，注释中的 URL 会被当作下载源抓取
forbid_1_consequence:   conan create 报 NotADirectoryError/无效 file:// 路径，finish W3 阻塞失败

# ═══ Layer 4: 原则引用 ═══
principles:

