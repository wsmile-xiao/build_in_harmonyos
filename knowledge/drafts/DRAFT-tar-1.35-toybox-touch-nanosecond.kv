#====================================================================
# DRAFT-tar-1.35-toybox-touch-nanosecond.kv — OHOS toybox touch 无纳秒精度
#====================================================================

id:                     DRAFT-tar-1.35-toybox-touch-nanosecond
trigger_tool:           touch|runtime|test
phase:                  runtime|testing
error_signature:        touch: bad date .*\.0000000001|touch: bad date @-9223372036854775809|
                         bad date .*9999999999|touch: bad date 1970-01-01T00:00:00\.0000000001

severity:               2
category:               ohos, toolchain, platform, limitation, testing
match_keywords:         touch, bad date, toybox, nanosecond, 纳秒, coreutils,
                         GNU touch, mtime, time01, -d .*0000000001

prescan_pattern:

root_cause:             OHOS 设备唯一 touch 为 toybox 0.8.12（/usr/bin/touch ->
                         ../../bin/toybox），不支持纳秒精度日期参数；GNU coreutils touch
                         或等价纳秒精度实现不存在。上游测试用 `touch -d <纳秒时间>` 设置
                         mtime 时失败（"touch: bad date ..."），秒精度正常。

rec_approach:           安装 GNU coreutils touch（或纳秒精度 touch）并在 PATH 前端实测版本后
                         重跑受影响入口；设备无可用安装通道时，用真实命令证明（touch 枚举 +
                         纳秒/秒精度对照实测），如实记录工具阻塞与恢复条件，不得伪造通过。

verification_cmd:       ls -la /usr/bin/touch; /usr/bin/touch --version;
                         /usr/bin/touch -d '1970-01-01T00:00:00.0000000001' t1;
                         /usr/bin/touch -d '1970-01-01T00:00:01' t3

affected_scope:         上游测试/脚本用纳秒 touch 设置 mtime 的适配任务（tar time01 类）
source_pr:              feat/tar-1.35 (tar 1.35 R02, task tar-1.35-r02-pc3-13-20260913T113300Z)
contributor_id:         pc3-13
draft:                  true
