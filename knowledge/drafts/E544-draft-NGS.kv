#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E544
trigger_tool: python|conan
phase: configuration
error_signature: not found in the dependency set

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: conan,build-system,recipe
match_keywords:         self.dependencies, tool_requires, build context, host context, KeyError, not found in the dependency set, generate, LEG, SED
title:                  Conan 2 取 tool_requires 依赖必须走 self.dependencies.build，否则 generate() 抛 KeyError

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan 2 的 self.dependencies 默认只暴露 host context。tool_requires（build requires）的包在 build context，用 self.dependencies[pkg] 取值抛 KeyError not found in the dependency set，异常发生在 generate() 阶段，容易被误判为制品仓缺包而去补依赖。
affected_scope:   所有把 tool_requires 可执行路径注入构建系统变量的 conanfile.py（cmake cache 变量、configure --with-xxx、meson cross file 等场景通用）
verification_cmd: conan create <pkg>/<ver>  # generate() 不再抛 KeyError 'not found in the dependency set'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: 取 build context 依赖必须写 self.dependencies.build[pkg]；host 侧依赖才是 self.dependencies[pkg] 或 self.dependencies.host[pkg]。把 tool_requires 的可执行路径注入 CMake cache 变量时尤其容易踩到。
rec_description:        tool_requires 的包只在 build context，Conan 2 取用需显式 .build 层
rec_command:            sed -i 's/self\.dependencies\["pkg"\]/self.dependencies.build["pkg"]/' conanfile.py
rec_auto_fix:           false

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
keywords: self.dependencies, tool_requires, build context, host context, KeyError, generate, LEG, SED, conanfile
solution_cmd: peg = self.dependencies.build['peg']; tc.cache_variables['LEG'] = os.path.join(peg.cpp_info.bindirs[0], 'leg')
verification: conan create 能通过 generate()；禁止回退成宿主 PATH 上的同名工具（CI clean 环境可能缺失或版本不同）
notes: 实测于 ngs 0.2.17（tool_requires peg/sed/pkgconf，需把 leg/sed 绝对路径传给 CMake）。conan-verify G2 曾报该 KeyError。
doc_file:                 doc/E544.md
last_updated: 2026-09-16
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
