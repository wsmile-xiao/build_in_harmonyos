#====================================================================
# E543.kv — autoconf 2.72 config.status 损坏旧版 ltmain.sh 引号转义
#====================================================================

id:                     E543
trigger_tool:           configure|make|libtool
phase:                  linking|packaging
error_signature:        libtool: link: ar cru $|
                         libtool.*syntax error: unexpected|
                         libtool: install: chmod 644 $|
                         not a valid libtool archive|
                         lib\\\$name\.a|
                         print: command not found.*libtool

severity:               3
category:               autotools, libtool, compat
match_keywords:         libtool, ltmain.sh, autoconf 2.72, config.status,
                         old_archive_cmds, archive_cmds, libname_spec,
                         archive_expsym_cmds, ECHO print, ar cru,
                         chmod 644, lib$name.a, disable-symvers,
                         not a valid libtool archive, libpthread.a

root_cause:             2020 年代的 ltmain.sh（libtool 2.4.x，随 openconnect-8.10
                         等旧 release tarball 分发）早于 autoconf 2.72。新版
                         config.status 执行旧模板时，libtool 命令模板变量
                         （old_archive_cmds/archive_cmds/libname_spec 等）被双引号
                         包裹，$AR/$oldobjs/$libname 在赋值时提前展开为空
                         （应为单引号延迟到 libtool 运行时 eval）；部分字段被过度
                         转义（libname_spec='lib\$name'），eval 展开失败产出字面量
                         .libs/lib$name.a；ECHO 采用 ksh 风格 "print -r --"
                         （OHOS /bin/sh 无 print 内建）。叠加 ohpcd 二进制包
                         prefix=/ 构建的 .la 残留（libdir='//lib'、
                         dependency_libs 指向过期包目录、mtlibs 残留 -lpthread
                         使旧 libtool 推导 ../.libs/libpthread.a）导致
                         "not a valid libtool archive" 链接中止。
affected_scope:         所有自带旧版 ltmain.sh 且在新版 autoconf 2.72 环境下
                         构建的 autotools 项目（openconnect 8.10 实测；
                         GitHub tag 归档无 configure 需先 autogen 的同族项目
                         全部涉及）
verification_cmd:       grep -n 'old_archive_cmds=' <builddir>/libtool | head -2;
                         bash -n <builddir>/libtool; grep -n 'ECHO=' <builddir>/libtool | head -2
rec_priority:           1
rec_approach:           patch-generated-libtool-quoting
rec_description:        configure 后 make 前修补生成的 libtool：双引号模板赋值改单引号、\ 去转义、print→printf、损坏的 archive_expsym_cmds 置空（或 --disable-symvers）、依赖 .la libdir 重写 + -lpthread 剥离
rec_command:            参考实现 archives/o/openconnect/8.10/conanfile.py 的 _fix_libtool_quoting/_fix_dependency_la_paths/_strip_libpthread_from_makefile（确定性文本变换）
rec_auto_fix:           true
rec_impl:               edit-umask-in-configure
fallback_priority:      2
fallback_approach:      build-without-libtool-mode
fallback_description:   直接 clang 编译链接绕过 libtool，或升级上游版本（新 ltmain.sh 兼容 autoconf 2.72）
fallback_auto_fix:      false
principles:             P004, P006
caused_by:              []
similar_to:             [E011, E209]
doc_file:               doc/E543.md
