#====================================================================
# DRAFT-appstream-1.2.0-r04-conan-override-force-direct.kv
# conan 2 override=True 的 require 不算 direct requirement（package_info
# 组件 requires 校验报 "not a direct requirement"）→ 版本固化改用 force=True
# 保留 direct 语义 + 强制版本
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R04）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           conan
phase:                  generate|package_info
error_signature:        not a direct requirement of the recipe|
                        There are '\(cpp_info/components\)\.requires' that includes package 'glib::'
severity:               3
category:               conan, version-matrix, package_info, ohos
match_keywords:         override=True, force=True, direct requirement, package_info,
                        components.requires, Version conflict, libxmlb, exact require
title:                  conan 2 override=True 不算 direct requirement → force=True 保留 direct 语义并强制版本
root_cause:             conan 2 cpp_info._validate_required_components 用
                        `r.direct and ... and not r.override` 判定 direct dependency，
                        override=True 的 require 被排除 → package_info 组件 requires
                        引用该包时报 "not a direct requirement"；force=True 保留
                        direct 语义且强制图中版本，两难消解。
affected_scope:         需覆盖依赖精确 require 版本且自身 package_info 组件 requires
                        引用该包的 Conan 2 项目（版本矩阵场景）。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing
rec_priority:           1
rec_approach:           conan-version-fix-force-direct
rec_description:        用 `self.requires("glib/2.84.0.1", force=True)` 替代
                        override=True：force 保留 direct requirement 语义
                        （r.direct 默认 True 且不置 override），同时强制图中该包
                        版本；其余不参与 package_info 组件引用的 override 可保留。
rec_command:            |
  # requirements():
  self.requires("glib/2.84.0.1", force=True)   # 覆盖 libxmlb 精确 require glib/2.88.3
  self.requires("pcre2/10.45", override=True)   # 不参与组件引用，可保留 override
rec_auto_fix:           false
rec_impl:               conan-recipe-requirements
forbid_1_pattern:       .*override=True.*package_info.*components.*requires.*glib::
forbid_1_reason:        override=True 的 require 在 package_info 组件 requires 校验中
                        视为非 direct（实测 create4/5 G2 干净构建必现）
principles:             R33, R49
causes:                 [DRAFT-appstream-1.2.0-r04-glib-component-key-version-matrix]
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-r04-conan-override-force-direct.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R04（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  2
metrics_fail_count:     0
metrics_confidence:     0.9