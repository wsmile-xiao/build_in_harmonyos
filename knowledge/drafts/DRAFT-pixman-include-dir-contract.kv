#====================================================================
# DRAFT-pixman-include-dir-contract - Expose include/pixman-1 before include for pixman consumers
#====================================================================

id:                     DRAFT-pixman-include-dir-contract
trigger_tool:           conan|test_package|clang|cmake|pkg-config
phase:                  package|testing|consumer-build
error_signature:        pixman-version\.h.*file not found|fatal error: 'pixman-version.h' file not found|fatal error: pixman-version.h: No such file or directory

severity:               2
category:               conan|headers|include-dirs|consumer-contract
match_keywords:         pixman.h, pixman-version.h, include/pixman-1, cpp_info.includedirs, pkg_config_name, pixman
title:                  pixman 的 Conan cpp_info 需暴露 include/pixman-1 以满足公开头内部 include

root_cause: >
  pixman 安装公开头到 include/pixman-1/，其中 pixman.h 内部使用 #include <pixman-version.h>。
  如果 Conan recipe 只暴露 include，消费者使用 #include <pixman.h> 或通过 pkg-config/CMake
  消费时无法解析 pixman-version.h；如果测试写成 #include <pixman-1/pixman.h>，还可能掩盖
  cpp_info.includedirs 契约缺陷。

affected_scope: >
  pixman、cairo/xorg 依赖链，以及任何把公开头安装到 include/<pkg>-<abi>/ 且公开头内部使用
  angle include 引用同目录生成头的库。

verification_cmd: >
  test_package 编译 #include <pixman.h>，并让 compile command 仅来自 cpp_info.includedirs；
  运行 pixman_version_string() 和 pixman_region32_* API。

rec_priority:           1
rec_approach:           expose-versioned-include-dir-first
rec_description: >
  在 package_info() 中设置 self.cpp_info.includedirs = ["include/pixman-1", "include"]，
  并设置 pkg_config_name="pixman-1"。test_package 应 include <pixman.h> 而不是硬编码
  <pixman-1/pixman.h>，从消费者视角验证 Conan include 契约。
rec_command: >
  self.cpp_info.includedirs = ["include/pixman-1", "include"];
  self.cpp_info.set_property("pkg_config_name", "pixman-1")
rec_auto_fix:           false
rec_impl:               conan-recipe-package-info

fallback_priority:      2
fallback_approach:      component-level-include-dirs
fallback_description: >
  若包拆成多个组件，每个组件也要暴露对应的 include/<component> 目录，避免消费者只拿到
  顶层 include。
fallback_command:       self.cpp_info.components["..."] .includedirs = ["include/pixman-1"]
fallback_auto_fix:      false
fallback_impl:          conan-components

forbid_1_pattern:       '#include <pixman-1/pixman.h>' in test_package as only header check
forbid_1_reason:        这种写法绕过 Conan cpp_info.includedirs，不能证明消费者可按正常 pixman 方式 include。
forbid_1_consequence:   CI 可能通过，但下游 #include <pixman.h> 仍失败。

principles:             P014, P016
causes:
caused_by:
similar_to:
conflicts_with:
prerequisite_of:        cairo

doc_file:               knowledge/drafts/DRAFT-pixman-include-dir-contract.md
last_updated:           2026-08-25
source_event:           pixman/0.46.4 HarmonyOS PC adaptation

draft:                  true
contributor_id:         C0DX

authors:                codex
