#====================================================================
# DRAFT-appstream-1.2.0-ohos-meson-itstool-join-optional.kv
# meson i18n.itstool_join 无条件要求 itstool 程序（OHOS 无 itstool）→
# find_program(required:false) 回退未翻译 metainfo，校验测试仍运行
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R02）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           meson
phase:                  configuration
error_signature:        Program 'itstool' not found or not executable|
                        ERROR: Program 'itstool' not found|
                        i18n\.itstool_join
severity:               2
category:               build-system, meson, platform, portability
match_keywords:         meson, itstool, i18n, itstool_join, metainfo, translation, gettext,
                        find_program, required: false, OHOS, GNOME, appstream
title:                  meson i18n.itstool_join 无条件要求 itstool 程序（OHOS 无此程序）——find_program(required:false) 回退
root_cause:             meson i18n 模块的 itstool_join 无条件 find_program('itstool')
                        （合并 metainfo 翻译必需）；OHOS 无 itstool 且无预编译包，
                        meson 配置期直接 ERROR。
affected_scope:         任何使用 i18n.itstool_join 的 GNOME/AppStream 系 meson 项目
                        （data/metainfo 翻译合并）在无 itstool 平台上的适配。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing
rec_priority:           1
rec_approach:           itstool-join-optional-fallback
rec_description:        补丁把 itstool_join 改为 find_program('itstool', required:false) 门控：
                        itstool 可得时走原 i18n.itstool_join；不可得时 metainfo_i18n 回退为
                        未翻译版本（metainfo_with_relinfo 自定义目标产物），下游校验测试
                        （如 as-validate_metainfo.cli）仍注册并运行。
rec_command:            |
  itstool = find_program('itstool', required: false)
  if itstool.found()
      metainfo_i18n = i18n.itstool_join(...)
  else
      metainfo_i18n = metainfo_with_relinfo
  endif
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       -Dgettext=false|-Dnls=false.*itstool
forbid_1_reason:        关闭 NLS 影响整个翻译目录（po/），比仅跳过 metainfo 合并副作用大
forbid_2_pattern:       itstool\.found\(\).*skip.*test
forbid_2_reason:        不得把 itstool 缺失写成测试跳过——本方案保持测试仍运行
principles:             R6, R8
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-ohos-meson-itstool-join-optional.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R02（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.8