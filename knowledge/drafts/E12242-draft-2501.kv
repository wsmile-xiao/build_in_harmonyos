#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E12242.kv，填写各字段
# 对应的人类文档: doc/E12242.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E12242
trigger_tool:           configure|conan
phase:                  configuration
error_signature:        Required published feature was not detected|#define HAVE_[A-Z_]+ /\*\*/

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               autotools, detection, conan, compat
match_keywords:         AC_DEFINE, config.h, valueless macro, HAVE_, empty definition, feature detection
title:                  Autoconf 空值能力宏不能按数值 1 的正则误判为缺失

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             AC_DEFINE 的空 value 会生成 #define FEATURE /**/；它为 #ifdef/defined 提供真实能力，但仅接受空白或 1 的配置头解析器拒绝注释空值，把已成功编译链接的探测误判为缺失。
affected_scope:         原生 Autoconf 的存在性能力宏及其配方后置检查；不适用于数值大小、ABI 常量、#if FEATURE 语义或未知定义形式。
verification_cmd:       回读实际 config.h 和 configure 日志；最小检查接受空定义、1、/**/，拒绝 undef、0、未匹配宏；随后对修复候选执行原生构建和实质消费者。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           preserve-autoconf-presence-macro-semantics
rec_description:        先回读上游 AC_DEFINE、生成头与源码消费方式，确认这是存在性宏；后置检查按已证明的空值/1/空注释定义格式识别，仅修检查器，不改探测结果、不缓存伪成功、不关闭功能，未知或数值宏 fail closed。
rec_command:            re.search(r"^#define[ \t]+" + feature + r"[ \t]*(?:1|/\*\*/)?[ \t]*$", config, re.M)
rec_auto_fix:           false
rec_impl:               manual-recipe-feature-check

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: inspect-generated-definition-and-source-consumer
fallback_description: 未知定义形式保持失败，核对 AC_DEFINE 和源码 #ifdef/#if 消费语义，不将存在性检查推广到数值宏。
fallback_command: 回读原始探测输出、config.h 的精确整行及所有消费者条件，证据收敛后只更新该宏类型的观察器。
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       --without-ssh|ac_cv_.*=yes|修改生成.*config.h
forbid_1_reason:        为绕过解析器误判而禁用功能或改探测结果，会制造语义变化和假通过。
forbid_1_consequence:   功能退化或 worker 探测失真。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               knowledge/drafts/E12242-draft-2501.md
