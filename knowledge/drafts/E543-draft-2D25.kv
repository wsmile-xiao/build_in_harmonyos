#====================================================================
# DRAFT: OHOS CMake 无 sysroot → ECM FindInotify 静默失败 → KDE 测试树整体不注册
# 来源: baloo 6.28.0 适配（task 5856）
#====================================================================

id:                     E543-draft-2D25
trigger_tool:           cmake|ctest|conan|ecm
phase:                  configure|test
error_signature:        No tests were found|BUILD_KINOTIFY.*FALSE|Inotify.*not been found|find_path.*sys/inotify.h
severity:               2
category:               cmake, kde, ecm, testing, cross-compile
match_keywords:         FindInotify, BUILD_KINOTIFY, No tests were found, sysroot, CMAKE_SYSROOT, KDE, ECM, autotests, ctest, add_subdirectory
title:                  OHOS clang 包装器隐式 sysroot 使 CMake find_path 找不到内核头，ECM FindInotify 失败静默禁用 KDE 包的 KINOTIFY 门控测试树

root_cause: >
  OHOS 工具链的 clang 包装器（--target=aarch64-linux-ohos）自带隐式 sysroot
  （/data/service/hnp/ohos-sdk.org/ohos-sdk_*/ohos/native/sysroot），clang 编译时能
  找到 sys/inotify.h 等内核/系统头；但 CMake 侧没有设置 CMAKE_SYSROOT /
  CMAKE_FIND_ROOT_PATH（conan CMakeToolchain 对 os=OHOS 不注入），所以 configure 期
  的 find_path(sys/inotify.h)（ECM FindInotify 模块）在默认搜索路径中找不到头文件。
  Inotify_FOUND=FALSE → 上游 CMakeLists 的 BUILD_KINOTIFY 门控为假 → file 索引器、
  tools、autotests/tests 子目录整体不构建 → ctest 报 "No tests were found!!!"（若
  --no-tests=error 则直接失败；否则静默 0 测试通过，测试覆盖被无声丢弃）。

affected_scope: >
  任何在 OHOS 上用 CMake 交叉编译、依赖 ECM FindInotify（KDE 桌面搜索系组件：
  baloo 等）或类似 find_path(<sys/头>) 探测门控的 KDE/Linux 系软件包。

verification_cmd:       grep -i "Inotify" <build>/CMakeCache.txt; ctest --test-dir <build> -N
rec_priority:           1
rec_approach:           sysroot-prefix-injection
rec_description: >
  在 conanfile generate() 手写的 conan_cmakedeps_paths.cmake 中，把 OHOS SDK
  sysroot 的 usr 前缀注入 CMake_PREFIX_PATH 与 CMAKE_INCLUDE_PATH（glob 模式
  /data/service/hnp/ohos-sdk.org/ohos-sdk_*/ohos/native/sysroot/usr，SDK 版本无关）。
  find_path 随后命中 sysroot/usr/include/sys/inotify.h，Inotify_FOUND=TRUE，
  BUILD_KINOTIFY 恢复，autotests 全量注册。
rec_command:            list(PREPEND CMAKE_PREFIX_PATH "<sysroot>/usr")
rec_auto_fix:           false
rec_impl:               baloo 6.28.0 conanfile.py generate()（glob 注入）

fallback_priority:      2
fallback_approach:      explicit-cmake-sysroot
fallback_description:   在 CMakeToolchain 设 tc.variables["CMAKE_SYSROOT"] = sysroot 路径（同样 glob 探测）；适用面更广但会改变全部 find_* 的根路径行为，对已依赖包装器隐式 sysroot 的包可能引入双重前缀问题。
fallback_command:       tc.variables["CMAKE_SYSROOT"] = "<sysroot>"
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       用 --no-tests=error 前不确认测试已注册|把 "No tests were found" 当作测试通过
forbid_1_reason:         BUILD_KINOTIFY 静默失败时 ctest 零注册，会把测试覆盖无声清零。
forbid_1_consequence:    PR 声称的测试统计与实际执行不符（审核 clone 数会拆穿）。

causes:                 []
caused_by:              []
doc_file:               doc/E543-draft-2D25.md
source_pr:              baloo 6.28.0
last_updated:               2026-09-06
authors:                 calbee21 <calbee21@noreply.gitcode.com>
