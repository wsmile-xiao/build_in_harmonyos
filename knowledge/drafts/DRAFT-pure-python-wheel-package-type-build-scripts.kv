#====================================================================
# DRAFT-pure-python-wheel-package-type-build-scripts
# 纯 Python wheel 包适配: package_type=build-scripts(无 python 类型,
# library 会触发 E216), settings 必须四件套(否则 W3 L0p 拦截),
# wheel 解包到 lib/python3.X/site-packages + conf_info 传递站点目录
#====================================================================

id:                     DRAFT-pure-python-wheel-package-type-build-scripts
trigger_tool:           conan|pip|python3
phase:                  build
error_signature:        settings 缺少 'compiler' — OHOS profile 需要全部四项|
                         settings 缺少 'build_type' — OHOS profile 需要全部四项|
                         Package type is 'library', but self.options\['shared'\] is required|
                         gate failed: missing_setting_compiler missing_setting_build_type

severity:               2
category:               conan, python, packaging, wheel, ci-gate
match_keywords:         pure python, wheel, pip wheel, site-packages,
                         package_type, build-scripts, E216, L0p,
                         settings 四项, conf_info, PYTHONPATH, tornado

title:                  纯 Python 包的 Conan 配方范式: 用 package_type=build-scripts + settings 全四项 + wheel 解包到 site-packages, 站点路径经 conf_info 传给 test_package

root_cause:             (1) Conan 2 没有 "python" 这个 package_type。选 "library"
                         会被强校验要求声明 shared 选项(E216: Package type is
                         'library', but self.options['shared'] is required),
                         而纯 wheel 产物根本不是可链接库。语义上最贴近的是
                         "build-scripts"(不可链接的模块集合)。
                         (2) settings 若只写 "os", "arch", W3 的 L0p 闸会拦截:
                         "settings 缺少 'compiler'/'build_type' — OHOS profile
                         需要全部四项"。必须写全 os/arch/compiler/build_type。
                         (3) 产出的 wheel 需要为消费者(test_package)提供可发现的
                         站点目录, 否则消费者不知道从哪 import。

affected_scope:         tornado/6.5.2、snakeviz/2.2.2 等纯 Python(wheel)包在
                         HarmonyOS PC 上的适配; 同类可参考 aiohttp-fast-zlib/0.3.0

verification_cmd:       conan create archives/t/tornado/6.5.2 \
                          -pr:h=ci/conan/profiles/ohos-aarch64 \
                          -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing
                        # 期望: W3 L0/L1/L4/L5 全通过, test_package 断言通过

rec_priority:           1
rec_approach:           wheel-extract-to-sitedir-with-conf-info
rec_description:        build():  subprocess.run([python3, "-m", "pip", "wheel", ".",
                                 "--no-deps", "--wheel-dir", self.build_folder])
                        package(): zipfile 解包 wheel 到
                          <pkg>/lib/python3.12/site-packages
                        package_info():
                          self.conf_info.define("user.<name>:sitedir",
                              os.path.join(self.package_folder,
                                           "lib/python3.12/site-packages"))
                        消费者的 test_package 用
                          dep.conf_info.get("user.<name>:sitedir")
                        取路径并插入 sys.path。
                        可选 C 加速扩展(speedups)依赖上游 setup.py 的
                        optional=True 天然降级: 不设禁用开关, 构建失败自动回退
                        纯 Python, 由 test_package 报告实际状态。

related:
  - archives/t/tornado/6.5.2/conanfile.py
  - archives/s/snakeviz/2.2.2/conanfile.py
  - archives/a/aiohttp-fast-zlib/0.3.0/conanfile.py
last_updated:           2026-09-26
