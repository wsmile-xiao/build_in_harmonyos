#====================================================================
# DRAFT-lwow-4.0.0-cmakedeps-multi-libs-single-target
#   CMakeDeps 对多库 flat libs 包仅生成单一包 target 的消费约束
# 来源: lwow 4.0.0 适配（PR 待建，Path B 知识库扩展）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-lwow-4.0.0-cmakedeps-multi-libs-single-target
trigger_tool:           conan|cmake
phase:                  linking|configuration
error_signature:        the target was not found.*lwow_devices|
                         Library '.*' not found in package|
                         Target ".*" links to:.*but the target was not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               cmake, conan, packaging, linking
match_keywords:         CMakeDeps, cpp_info.libs, multiple libs, flat libs, single target,
                        aggregate target, components, cmake_target_name, test_package,
                        target_link_libraries, Library not found in package
title:                  多库 flat libs 包消费端只能链接包级 aggregate target（CMakeDeps 单 target）
prescan_pattern:        cpp_info\.libs\s*=\s*\[.*,.*\]|\.libs\s*=\s*\[
prescan_globs:          archives/*/*/conanfile.py

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:            package_info() 声明 cpp_info.libs = ["libA", "libB"]（flat，
                        未用 components）时，Conan 2 的 CMakeDeps 只为包生成
                        **一个** aggregate target（如 lwow::lwow），不会为
                        libA/libB 各生成独立 target。消费端若按库名臆想
                        lwow::libB（或 test_package 链接 lwow::lwow_devices），
                        CMake 报 "the target was not found"；若 CMakeDeps 尝试
                        检查每个 libs 项，报 "Library 'libB' not found in package"。
                        多 target 的唯一正规途径是 components（每个组件独立
                        cmake_target_name）。
affected_scope:         Conan 2 中 cpp_info.libs 声明多个库（flat，非 components）
                        且由 CMakeDeps 生成器消费的配方与其 test_package/
                        consumer。仓内实证：lwow 4.0.0（libs=["lwow_devices",
                        "lwow"]，生成 target 仅 lwow::lwow）。
verification_cmd:       conan create . --build=missing 后检查 test_package/
                        build/.../generators/lwow-Target-release.cmake 中声明的
                        target 集合；仅 lwow::lwow 存在。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           consume-aggregate-target-for-flat-libs
rec_description:        消费端（test_package/CMakeLists.txt、消费者工程）只
                        target_link_libraries(... <pkg>::<pkg>)（包级 aggregate
                        target），由 CMakeDeps 内部分发到多个 .a/.so，不按库名
                        构造 lwow::lwow_devices 之类子 target。libs 顺序即链接
                        顺序（依赖库在前：libs=["lwow_devices", "lwow"]，
                        devices 依赖 core）。
rec_command:            find_package(lwow REQUIRED CONFIG) \
                        target_link_libraries(test_package PRIVATE lwow::lwow)
rec_auto_fix:           false
rec_impl:               manual-consumer
fallback_priority:      2
fallback_approach:      components-per-library
fallback_description:   若确实需要为每个库提供独立 target（下游按库选择链接），
                        在 package_info() 用 components 建模：每个组件
                        cpp_info.components["devices"].libs=["lwow_devices"] +
                        .requires=["core"]，并为组件 set_property
                        cmake_target_name 生成 lwow::lwow_devices。
fallback_command:       cpp_info.components["devices"].set_property("cmake_target_name", \
                        "lwow::lwow_devices")
fallback_auto_fix:      false
fallback_impl:          manual-recipe
forbid_1_pattern:       target_link_libraries.*lwow::lwow_devices|find_package.*lwow.*components
forbid_1_reason:        臆造不存在的子 target 会直接 CMake configure 失败。
forbid_1_consequence:   test_package 构建失败，误判为库打包缺失。
forbid_2_pattern:       cpp_info\.libs.*库名.*cmake_target_name.*未设置
forbid_2_reason:        flat libs 不会自动生成子 target；需要子 target 必须用 components。
forbid_2_consequence:   消费者按组件链接失败，适配返工。
principles:             P012
