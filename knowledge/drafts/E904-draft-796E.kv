#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E904.kv，填写各字段
# 对应的人类文档: doc/E904.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E904
trigger_tool: test|conan
phase: testing
error_signature: dependency NOT in registry|Registry unreachable.*r-base|error:system acceleration policy not enabled

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan,detection,portability
match_keywords: r-base, ohpcd, 404, L0i, unpublished dependency, R CMD INSTALL, CRAN
title: ohpcd 无 r-base：CRAN R 包适配必须走零未发布依赖路线（CI L0i hard-fail）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: ohpcd 制品仓不含任何 R 系包（r-base/4.5.1 实测 HTTP 404，全量 7802 配方搜索无 R 系），而 CI 的 L0i 门禁自 commit 83c2f54f25 起对未发布的 requires 直接 hard-fail（本地对 archives/a/acepack/1.6.3 实测复现 L0_RESULT=fail: gate failed:registry_unreachable）
affected_scope: 所有 CRAN R 包在 OHOS conan 生态的适配（先例 acepack 1.6.3 / kernsmooth 2.23-26 / boot 1.3-32）
verification_cmd: conan download r-base/4.5.1 -r=ohpcd --only-recipe（rc=1，报 error:system acceleration policy not enabled）；对照 conan download kernsmooth/2.23-26 得 rc=0

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: dependency-free-adaptation
rec_description: 不声明任何 requires/tool_requires：纯 R 包（NeedsCompilation: no）直接做「上游 R 包树 → lib/R/library/<pkg>/」搬运，build() 只跑 R-free 的结构/数据校验；有 C/Fortran 源码的 R 包则把数值核心编成独立静态库（kernsmooth 路线，只依赖已发布的 flang-ohos+openblas）
rec_command:            conan create archives/b/boot/1.3-32 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing
rec_auto_fix: false
rec_impl:               conan-recipe-generate（boot 1.3-32 为可复制实现：package_type="library" + options shared=False + source() 里 get(strip_root=True) 后 apply_conandata_patches；package() 用 shutil 把上游整棵 R 包树搬到 lib/R/library/boot/；package_info() 只定义 R_BOOT_PACKAGE_DIR，不臆造 cpp_info.libs。有 C/Fortran 源码时改用 kernsmooth 2.23-26 的独立静态库路线）

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E904.md
last_updated: 2026-10-10
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

