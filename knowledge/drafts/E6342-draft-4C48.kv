#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E6342.kv，填写各字段
# 对应的人类文档: doc/E6342.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E6342
trigger_tool:           test|runtime|install
phase:                  testing|runtime
error_signature:        /dev/fuse.*Permission denied|fuse_session_mount.*Permission denied|open[(].*[/]dev[/]fuse|--version.*non-zero|--help.*non-zero|bad /etc/fstab|prove.*not found|gcc.*Permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               testing, runtime, limitation, ohos
match_keywords:         FUSE, /dev/fuse, ext2 image, mount, privilege, test_package, CLI smoke, capability gate, exit code 9, pjd-fstest, prove, test inventory
title:                  FUSE 文件系统测试必须拆分无特权 CLI 契约与授权挂载能力
prescan_pattern:        /dev/fuse|fuse_session_mount|test_package|mount
prescan_globs:          *.c, *.h, *.sh, conanfile.py

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             FUSE 文件系统程序同时包含可无特权验证的参数解析/可执行性契约和需要内核设备、挂载权限、文件系统镜像的运行时契约。vendored 上游 suite 还可能不接入顶层 make check，必须先完整盘点测试文件，再区分 runner、镜像、mount 和 /dev/fuse 阻塞。通用 CI 的 version/help smoke 还可能把上游约定的非零退出码误报为 warning，不能用单一返回码替代分层测试。
affected_scope:         ext2fuse、sshfs、rclone mount、用户态文件系统和任何需要 /dev/fuse 或真实块设备的包。
verification_cmd:       find tests/pjd-fstest-20080412/tests -name '*.t' | wc -l; $BIN/ext2fuse --version; test $? -eq 9; test -r /dev/fuse && test -w /dev/fuse

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           capability-gated-fuse-tests
rec_description:        test_package 固定验证安装后的二进制、版本输出、帮助输出和错误参数路径；递归盘点上游测试并记录 discovered/executed/passed/failed/blocked；单独检测 prove、/dev/fuse、可用 ext2 镜像和挂载权限，满足条件时再执行只读挂载闭环。
rec_command:            "$BIN/ext2fuse" --version; rc=$?; test "$rc" -eq 9; test -r /dev/fuse && test -w /dev/fuse
rec_auto_fix:           false
rec_impl:               layered-runtime-test

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      evidence-preserving-skip
fallback_description:   没有 /dev/fuse 授权或 ext2 设备时保留 CLI 和安装验证，明确记录 mount test 未运行及恢复条件，不修改配方伪造挂载通过。
fallback_command:       command -v mke2fs && ls -l /dev/fuse
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       chmod.*[/]dev[/]fuse|--version.*test.*-eq.*0|skip.*mount.*pass
forbid_1_reason:        设备节点权限和上游 CLI 退出码是外部契约，不能由包内脚本或配方擅自改写。
forbid_1_consequence:   产生虚假的功能通过证据，无法区分安装成功、参数解析成功和真实挂载成功。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             R6, R16, R29

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E6342.md
last_updated: 2026-09-13
source_event:           ext2fuse 0.8.1：test_package 4/4 通过；新真机上游 pjd-fstest 盘点 184 个文件，184 个 shell 脚本逐个启动，文件级 111 通过、73 失败、0 阻塞，并得到 1115 个 ok、833 个 not ok 断言；官方 prove/ext2/FUSE 挂载闭环仍因 prove/perl、mount 与 /dev/fuse 受能力限制单独记为 blocked。

# ═══ 知识协作 (Authorship & Provenance) ═══
