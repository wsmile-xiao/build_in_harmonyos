#====================================================================
# DRAFT-shadow-ci-isolated-conanhome-missing-ohpcd-remote — 隔离 job conan-home 缺 ohpcd remote 时依赖回落 conancenter 源码构建
# Source event: infgen 3.5 shadow CI r1 依赖 zlib 走 conancenter CMake 配方，真机无 cmake 失败
#====================================================================

id:                     DRAFT-shadow-ci-isolated-conanhome-missing-ohpcd-remote
trigger_tool:           ohos-prepare-isolated-conan-job|conan|shadow-ci
phase:                  shadow-ci|dependency-resolution
error_signature:        cmake: inaccessible or not found|Error in build\(\).*cmake\.configure|Error 127 while executing|Not found in local cache, looking in remotes|Checking remote: conancenter
severity:               2
category:               shadow-ci|conan-remote|dependency-resolution
match_keywords:         shadow CI, isolated job, conan-home, remotes.json, ohpcd, conancenter, dependency, zlib, cmake inaccessible, remote add, source build, prebuilt package
title:                  shadow CI 隔离 job 的 conan-home 缺 ohpcd remote 时，依赖解析回落 conancenter 源码构建失败

root_cause:             ohos-prepare-isolated-conan-job.sh 从已有 job 复制 repo 时，新 job 的 conan-home/remotes.json 可能只含默认 conancenter（无 ohpcd）。conan create 解析 self.requires() 依赖时只查 conancenter，命中其同名配方（如 zlib/1.3.1 用 CMake 构建），真机无 cmake，依赖从源码构建失败。全局 conan 配了 ohpcd 也不生效——隔离 job 用独立 CONAN_HOME，不继承全局 remote。
affected_scope:         所有用 ohos-prepare-isolated-conan-job.sh 创建的 shadow CI job；凡是 recipe 声明 self.requires() 依赖、且依赖仅发布在 ohpcd 制品仓（conancenter 同名配方构建系统不同）的库。
verification_cmd:       grep -c ohpcd "$JOB/conan-home/remotes.json"    # 期望 >=1；为 0 即触发此问题

rec_priority:           1
rec_approach:           add-ohpcd-remote-to-job-conanhome
rec_description:        创建隔离 job 后、跑 runner 前，给 job 的 conan-home 添加 ohpcd remote 并禁用 conancenter，使依赖解析命中 ohpcd 预编译包（R36 依赖先发布）。
rec_command:            export CONAN_HOME="$JOB/conan-home"; conan remote add ohpcd https://conan.cnb.cool/OpenHarmonyPCDeveloper/Conan/-/packages/; conan remote disable conancenter
rec_auto_fix:           false
rec_impl:               conan-remote

fallback_priority:      2
fallback_approach:      verify-ohpcd-prebuilt-before-run
fallback_description:   添加 remote 后，先用 conan download 验证依赖预编译包在 ohpcd 存在（R35 禁 conan list），再跑 runner，避免再次白跑。
fallback_command:       export CONAN_HOME="$JOB/conan-home"; conan download "zlib/1.3.1" -r=ohpcd
fallback_auto_fix:      false
fallback_impl:          conan-download

forbid_1_pattern:       依赖解析失败时改 conanfile.py 把依赖 vendor 进当前库|把依赖源码混入当前库 PR
forbid_1_reason:        这是 remote 配置问题，不是依赖缺失；依赖应走 ohpcd 预编译包或单独适配（R36），vendor 会违反一库一 PR 边界。
forbid_1_consequence:   PR 被 JC6/PF4 拦截；依赖源码混入导致审核困难与回滚困难。

principles:             dependency-first, single-package-ci, ohpcd-prebuilt
causes:                 []
caused_by:              []
similar_to:             [DRAFT-pico-sdk-shadow-ci-isolated-home-pythonpath, DRAFT-ZLIB-SHADOW-CI-HNP-TOOL-PATH]
conflicts_with:         []
prerequisite_of:        []

