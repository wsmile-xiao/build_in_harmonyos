#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E604.kv，填写各字段
# 对应的人类文档: doc/E604.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E604
trigger_tool:           autoreconf|config.guess|configure
phase:                  configuration
error_signature:        config\.guess.*unable to guess system type|cannot guess build type|can't create.*cgXXXXXX.*Permission denied|dummy\.c.*Permission denied

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               hmdfs, autotools, ohos, build-system
match_keywords:         autoreconf, config.guess, umask 077, cannot guess build type, dummy.c, Permission denied, configure-only patch
title: autoreconf --install 重新注入带 umask 077 的 config.guess，仅修 configure 的 HMDFS umask 方案失效

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 源码包无 configure/config.guess（仅 configure.ac）时配方须 autoreconf --force --install 引导，
                         --install 从当前 Automake 分发目录全新安装 config.guess/config.sub；若 umask 修补
                         只打在 configure 上，新注入的 config.guess 保留 umask 077 && mktemp -d，HMDFS 上
                         UID 映射 + setgid 使 0700 临时目录对进程不可写，dummy.c 创建失败 → cannot guess
                         build type；且 VPATH 每次全新构建重新注入，configure 独自修补永不生效
affected_scope: 上游发布包不含 configure/config.guess、需配方内 autoreconf 引导的所有 autotools 软件包
                         （libmobi 0.12 GitHub tag tarball 系；对照：发布 tarball 自带 configure 的老项目
                         configure 修补即够，不触发本模式）
verification_cmd:       grep -c "umask 077" config.guess; sh config.guess 2>&1 | tail -3  # 模板新注入时 1+ 且报 cannot create dummy.c
# （实测：conan automake/1.18 分发的 config.guess 为 2024-07-27 版含 umask 077；
#   本机 /usr/local/share/automake-1.16 版含 OHOS 分支但同为旧 umask 风格；
#   autoreconf 选中哪个取决于 effective-path 解析到的 automake）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           sed-umask-configure-and-config-guess
rec_description:        autoreconf --install 之后、configure 之前，对 configure 与 config.guess 同时替换
                         umask 077 → umask 000，并用 ! grep 断言两文件均无残留（fail closed，模板换代
                         漂移时中断而非带病走到 HMDFS 权限错误）
rec_command:            autoreconf --force --install -I m4 && sed -i 's/umask 077/umask 000/g' configure config.guess && ! grep -n 'umask 077' configure config.guess
rec_auto_fix:           true
rec_impl:               source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      config-guess-substitute
fallback_description:   预置一份已修补（umask 000）且含 __OHOS__ 分支的 config.guess/config.sub，
                         autoreconf 后覆盖回源目录（绕开 Automake 分发版的 umask 与平台识别双重问题）
fallback_command:       autoreconf --force --install -I m4 && cp ${PATCHED_AUX_DIR}/config.guess ${PATCHED_AUX_DIR}/config.sub ./
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       sed -i 's/umask 077.*' configure$
forbid_1_reason:        仅对 configure 单文件替换 umask，漏掉 autoreconf --install 同步注入的 config.guess
forbid_1_consequence:   config.guess 的 dummy.c 探测在 HMDFS 0700 临时目录内 Permission denied，
                         configure 报 cannot guess build type 退出 1，且每次 VPATH 构建复现
forbid_2_pattern:       git checkout.*config\.guess|预生成.*config\.guess.*入库
forbid_2_reason:        把生成产物 config.guess 提交进配方补丁目录对抗 --install 注入
forbid_2_consequence:   automake 分发版升级后补丁过期，平台识别（__OHOS__ 分支）与 umask 双重漂移难以审计

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             [E011, E175]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E604.md
last_updated: 2026-09-09
source_event:           libmobi 0.12 HarmonyOS 适配（feat/libmobi-0.12）；conan create 日志证据：
                         configure.ac:22: installing './config.guess'（autoreconf --install 注入）+
                         automake/1.18 分发 config.guess 含 umask 077（2024-07-27 版）

