#====================================================================
# E254-draft-OSTR.kv — 监控型程序在 OHOS 上应把单项指标失败降级为部分数据
#====================================================================

id:                     E254
trigger_tool:           conan|runtime|test_package
phase:                  runtime|testing
error_signature:        collect_cpu_usage.*return -1|collect_memory.*return -1|sysinfo.*return -1|getloadavg.*return -1|fatal.*metrics
severity:               2
category:               system-monitoring|runtime|portability
match_keywords:         /proc, /sys, sysinfo, getloadavg, meminfo, read_cpu_times,
                        disk usage, partial metrics, zero fill, best-effort,
                        ostra-sysctl
title:                  监控型程序在 OHOS 上应把单项指标失败降级为部分数据

root_cause:             这类系统监控程序往往把 CPU、内存、hostname、kernel、
                        loadavg、根分区信息视为同一条成功路径；但在 OHOS 上，
                        个别 /proc、sysinfo、getloadavg 或磁盘探测可能失败。
                        若任一探针直接返回错误，就会把可用的其余指标一起丢掉。
affected_scope:         读取多个系统指标的监控、状态栏、诊断和 CLI 统计工具，
                        尤其是把一组探针串成单个 fatal 返回值的实现。
verification_cmd:       在 OHOS 上运行包内二进制或 test_package，模拟部分探针失败后
                        仍能输出其余指标且退出码为 0。

rec_priority:           1
rec_approach:           best-effort-metric-aggregation
rec_description:        将每个指标探针拆成独立的失败边界，初始化结果为 0 或空值；
                        单项失败只跳过对应字段，不要把局部失败升级成整体 fatal。
rec_command:            在聚合函数中把 collect_* 改为 void 或返回局部状态；主路径只在
                        真正无法启动时才报错。
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      skip-unavailable-metrics
fallback_description:   如果某个指标在目标平台永远不可用，就在包层面显式标记为未实现
                        或以 0 占位，但继续验证可用指标和主命令输出。
fallback_auto_fix:      false

principles:

causes:                 []
caused_by:              []
similar_to:             [E031]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E254.md
last_updated:           2026-08-29
source_event:           ostra 0.000709606481481482 HarmonyOS adaptation

authors:                wxjshr <wxjshr@noreply.gitcode.com>
source_pr:
source_commit:

metrics_success_count:   0
metrics_fail_count:      0
