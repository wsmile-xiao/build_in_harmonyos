#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: conan|patch
phase: build
error_signature: 'source/target file does not exist: --- b.a/.+++ b.b/.'

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: build-system|patch|ohos
match_keywords: source/target file does not exist, apply_conandata_patches, /dev/null, new file mode, patch --dry-run
title: refresh-patch 新文件补丁被破坏（BusyBox patch --dry-run 在 orig 目录造 0 字节占位，致 /dev/null 标记丢失）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS 环境 refresh-patch 的 _dry_run 用 BusyBox 'patch --dry-run -p1' 校验每个补丁。对 --- /dev/null 新文件补丁，BusyBox 会在 orig 目录创建同名 0 字节占位文件。下一次 refresh-patch 因 orig 已存在该文件而把新文件当修改处理，生成 --- a/<path>（丢失 /dev/null 标记）；conan apply_conandata_patches 解析不到源文件即报 source/target file does not exist，conan create 在 build() 第一步就失败。kylin-burner 3.0.11 实测：intltool-merge-shim/m4-ohos-stubs/m4-pkg/ohos-stubs 5 个新文件全部被破坏。
affected_scope: refresh-patch --auto 与 finish step1（含新增文件即 new-file patch 的配方）；OHOS/BusyBox patch 环境；症状为 conan create 报 source/target file does not exist 且补丁首行变成 --- a/<path>
verification_cmd: ls -la $BUILD_SRC_ORIG_DIR/<new-file>（存在 0 字节即复现）；head -1 patches/<NNNN>-*.patch（应为 --- /dev/null，若为 --- a/<path> 即已破坏）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: delete-zero-byte-placeholders-before-refresh-patch
rec_description: finish/refresh-patch 前删除 orig 目录下新文件对应的 0 字节占位文件（find orig -type f -size 0c 对照 patches 新文件清单），使 refresh-patch 重新走新增分支生成 --- /dev/null 补丁；生成后再跑 conan-verify 验证 apply_conandata_patches 通过。禁止手写 patch 或用 sed 改补丁头。
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
keywords: refresh-patch, new file patch, /dev/null, patch --dry-run, busybox, 0-byte placeholder, source/target file does not exist, apply_conandata_patches
doc_file:               doc/E543.md
last_updated: 2026-09-23
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

draft: true
contributor_id: D287
