#====================================================================
# DRAFT-bison-ohos-datadir-m4sugar.kv
# bison/3.8.2 HNP 包 datadir 配错 → 运行时找不到 m4sugar.m4
# (tool_requires bison 生成 parser 时直接报
#  "bison: /share/bison/m4sugar/m4sugar.m4: cannot open")
#====================================================================

id:                     DRAFT-bison-ohos-datadir-m4sugar
trigger_tool:           bison|conan|tool_requires|make|cmake
phase:                  build
error_signature:        m4sugar.m4: cannot open: No such file or directory|
                         bison: /share/bison/m4sugar/m4sugar.m4|
                         bison: cannot open

severity:               3
category:               ohos, bison, tool_requires, build-system, packaging
match_keywords:         bison, m4sugar.m4, BISON_PKGDATADIR, datadir, pkgdatadir,
                         tool_requires, parser.y, parser.cpp, cannot open,
                         No such file or directory, HNP, share/bison
title:                  bison/3.8.2 在 OHOS 上找不到 m4sugar.m4（datadir 配错，BISON_PKGDATADIR 修复）

root_cause:             |
  bison/3.8.2 的 OHOS HNP 包在编译时把 datadir 配成了绝对路径 /share
  （而非相对包前缀），运行时按 ${pkgdatadir}/m4sugar/m4sugar.m4 定位
  自身 m4 宏，得到 /share/bison/m4sugar/m4sugar.m4（根目录下不存在），
  报 "m4sugar.m4: cannot open: No such file or directory"。实际宏文件
  在 bison 包内 <pkg>/share/bison/m4sugar/m4sugar.m4，只需用环境变量
  BISON_PKGDATADIR 显式重定向即可。rgbds 1.0.1 真机 shadow CI 实测命中
  （tag 归档不含 bison 生成物，build() 内直调 bison 生成 parser）。

affected_scope:         所有 OHOS 上用 tool_requires("bison/3.8.2") 且 build() 内调用
                         bison 生成 parser 的配方（含 -D/%define 参数的 .y 文件必触发 m4 处理）

verification_cmd:       |
  # 定位 bison 包内 m4 宏
  find "$CONAN_HOME/p" -name m4sugar.m4
  # 修复后语义：显式指向包内 share/bison
  BISON_PKGDATADIR="<bison-package>/share/bison" bison -d -o parser.cpp parser.y

rec_priority:           1
rec_approach:           set-env-var
rec_description:        build() 内调用 bison 前，从 self.dependencies.build["bison"] 取
                         package_folder，把 BISON_PKGDATADIR 指向包内 share/bison。
rec_command:            |
  bison_pkg = self.dependencies.build["bison"].package_folder
  bison_datadir = os.path.join(bison_pkg, "share", "bison")
  self.run(f'BISON_PKGDATADIR="{bison_datadir}" bison {flags} -d -o src/asm/parser.cpp src/asm/parser.y')
rec_auto_fix:           false
rec_impl:               manual-conan-recipe

fallback_priority:      2
fallback_approach:      avoid-bison
fallback_description:   若无法修复 bison 数据目录，改用 bison 2.7（同制品仓存在）或
                         预生成 parser 源文件随配方导出；均不如 BISON_PKGDATADIR 简洁。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       bison 直接生成到 /tmp|依赖系统 /share/bison
forbid_1_reason:        OHOS /tmp 只读（E002）；系统 /share 无 bison 数据，仍报同样错
forbid_1_consequence:   误判为缺 m4 工具或 bison 损坏，反复重装无效

principles:

causes:                 []
caused_by:              []
similar_to:             [E109,DRAFT-ohos-missing-awk-variant-supply]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-bison-ohos-datadir-m4sugar.md
last_updated:           2026-09-20
source_event:           rgbds/1.0.1 真机 shadow CI（task rgbds-1.0.1-shadow-20260920-144737），bison 生成 parser 阶段实测命中并修复

draft:                  true
contributor_id:         0
authors:                codex
