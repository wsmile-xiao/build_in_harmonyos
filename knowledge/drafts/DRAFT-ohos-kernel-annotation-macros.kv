#====================================================================
# DRAFT-ohos-kernel-annotation-macros — OHOS sysroot 内核风格头
#   （mtd-abi.h 等）用 __user/__force/__iomem 注解，musl 未定义这些宏，
#   编译报 "expected ';' at end of declaration list"——用 -D__user= 置空
# 对应人类文档: knowledge/drafts/DRAFT-ohos-kernel-annotation-macros.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR systemd/261 适配 HarmonyOS PC（编译 mtd_probe 时 mtd-abi.h）
#====================================================================

id:                     DRAFT-ohos-kernel-annotation-macros
trigger_tool:           cc|clang|make|meson|cmake
phase:                  compilation
error_signature:        expected ';' at end of declaration list|
                         expected ';' after expression|
                         __user.*undeclared|__force.*undeclared|
                         unknown type name '__user'|
                         mtd-abi\.h

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               ohos, musl, kernel-headers, macros, compilation, portability
match_keywords:         __user, __force, __iomem, __kernel, kernel style header,
                         mtd-abi.h, sysroot, expected ';', declaration list,
                         syscall interface, uapi, annotated
title:                  OHOS sysroot 内核风格头（mtd-abi.h 等）用 __user/__force
                         注解但 musl 不定义这些宏——编译参数 -D__user= 置空修复

# ═══ Layer 2: 诊断层 ═══
root_cause:             Linux uapi 头（如 mtd/mtd-abi.h、部分 syscall 接口头）为
                         配合 sparse 静态分析用 __user/__force/__iomem/__kernel
                         注解指针/参数。glibc 工具链通常经 linux/compiler.h 或
                         预定义提供这些宏；OHOS sysroot 直接暴露这些头给用户态，
                         但 OHOS 的 musl libc 不定义它们——编译含这类头的 .c 时
                         报 "expected ';' at end of declaration list"（如
                         "unsigned char __user * ptr;" 中 __user 未定义被当标识符）
affected_scope:         所有在 OHOS 上编译、间接 include 了带内核注解宏的 uapi 头
                         的库/工具（systemd 的 mtd_probe 即此类；mtd-abi.h 经
                         <mtd/mtd-abi.h> 引入）
verification_cmd:       conan create archives/s/systemd/261 --build=missing
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 覆盖前 mtd_probe 编译报 expected ';'（mtd-abi.h:33）；
                         # 覆盖后 mtd_probe 编译通过

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           define-empty-kernel-annotations
rec_description:        编译参数给这些内核注解宏加空定义（与内核编译时 sparse 关闭
                         的空宏一致）：-D__user= -D__force= -D__iomem= -D__kernel=。
                         一条 c_args 解决，零补丁、零源码改动
rec_command:            (meson/AutotoolsToolchain c_args 中)
                         for k in __user __force __iomem __kernel:
                             c_args.append(f"-D{k}=")
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      source-patch-strip-annotations
fallback_description:   若编译参数注入不可行，patch 源码中直接 include 的内核头
                         去掉 __user 等注解（或提供空宏定义头）——改动面大，不推荐
fallback_command:       (逐文件补丁)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       skip.*mtd_probe|禁用.*mtd.*编译|N/A（未运行）
forbid_1_reason:        空宏定义可无损解决；跳过/禁用属"有可运行子集未尝试"
forbid_1_consequence:   被 rule 4 打回；且掩盖 uapi 头在 OHOS 的真实兼容面
forbid_2_pattern:       sed.*mtd-abi\.h.*删除.*__user|patch.*去掉.*指针注解
forbid_2_reason:        改 sysroot 内核头治标不治本且不可分发；空宏定义是标准做法
forbid_2_consequence:   换编译单元/头即失效

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
# E025 为"内核头/kernel headers"主题（CAN socket 内核头探测失配）——与本草稿
# （OHOS sysroot 内核风格头 __user 注解）同属内核头/编译期问题；
# 原引用 E041（automake 版本不匹配）为错误引用（AI 检视 P3 指出）。
similar_to:             E025
conflicts_with:         []
prerequisite_of:        []

