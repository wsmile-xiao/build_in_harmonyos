#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E602.kv，填写各字段
# 对应的人类文档: doc/E602.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E602
trigger_tool: git add / finish
phase: commit
error_signature: git add archives/.*后 reports/ 下文件未被暂存|git check-ignore.*reports/test-report.md.*reports/

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: packaging, build-system
match_keywords:         gitignore, reports, 反选, audit-result.json, git add
title: 根 .gitignore 的 reports/ 规则吞掉归档报告目录，需局部反选

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 根 .gitignore 第 91 行的 unanchored 模式 reports/ 匹配任意深度的 reports 目录，归档目录（archives/p/povray/3.7.0.10/reports/）下的 test-report.md/audit-result.json 会被忽略；根 .gitignore 不允许协作者修改
affected_scope: 所有需将 test-report.md/audit-result.json 入库的归档（archives/<字母>/<软件>/<版本>/reports/）
verification_cmd: git check-ignore -v archives/p/povray/3.7.0.10/reports/test-report.md  # 命中根规则 reports/ 即复现

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: 在归档局部 .gitignore（archives/<字母>/<软件>/<版本>/.gitignore，随归档提交）写反选：!reports/ + !reports/*.md + !reports/audit-result.json，再用 git add 即可入库（tcping/handbrake/x3270 根反选先例；abiword 的归档局部 .gitignore 同款）；reports/conan-create.log 仍应显式忽略不入库
rec_description:        归档局部 .gitignore 反选 reports/ 必需文件（!reports/*.md + !reports/audit-result.json），conan-create.log/w3-local-ci.log 显式忽略
rec_command:            printf '!reports/\n!reports/*.md\n!reports/audit-result.json\n' >> ${ARCHIVE_DIR}/.gitignore && git add ${ARCHIVE_DIR}/reports/test-report.md
rec_auto_fix:           false
rec_impl:

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
keywords: gitignore, reports, 反选, test-report.md, audit-result.json, 归档, git add
software: povray/3.7.0.10
doc_file:               doc/E602.md
last_updated: 2026-09-03
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

