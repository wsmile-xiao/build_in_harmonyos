#====================================================================
# E543-draft-SP11 — spirit-po strict C++11/OHOS header portability and test evidence
#====================================================================

id:                     E543
trigger_tool:           clang|conan|make|test
phase:                  compilation|recipe|testing
error_signature:        unknown type name ['"]uint['"]|error: unknown type name 'uint'|libintl\.h.*not found|find_package\(Intl REQUIRED\).*Could NOT find

severity:               2
category:               ohos, portability, headers, conan, testing
match_keywords:         spirit-po, Boost.Spirit, boost/spirit, unknown type name uint, header-only, libintl.h, Intl, PO, test count
prescan_pattern:        unknown type name ['"]uint['"]
prescan_globs:          "*.h, *.hpp, *.cpp, Makefile*, CMakeLists.txt"
title:                  spirit-po 公开头文件严格 C++11 可移植性修复与上游 PO 测试分母/跳过证据

root_cause: >
  spirit-po v1.1.2 的 exceptions.hpp 和 debug-only po_message.hpp 使用未在公共头
  文件中声明的 uint；Linux 旧环境可能被系统头间接提供的 typedef 掩盖，但严格 OHOS
  clang 直接拒绝。其 test_libintl 对照 suite 还把 libintl.h、libintl 链接库作为硬依赖，
  OHOS worker 仅有 msgfmt 时不能构建运行时对照。
affected_scope: >
  依赖 spirit-po 公共头且启用标准 C++11/DEBUG 的 OHOS/aarch64 消费者；以及需要将
  unit assertion、PO 数据驱动对照 case 和消费者测试分栏统计的 header-only Conan 配方。
verification_cmd: >
  应用 conandata.yml 中两个 portability patch 后，用 OHOS clang 编译并运行上游
  test/main.cpp（126/126）；随后核对 test_libintl/CMakeLists.txt 的 Intl REQUIRED
  证据，并在缺少 libintl.h/库时保留 206 个 case 的明确 SKIP 分母；最后运行 test_package。

rec_priority:           1
rec_approach:           std-size-t-in-public-header-and-evidence-split
rec_description:        将未限定 uint 改成已有标准头支持的 std::size_t，并把上游不同测试层按真实可执行口径分栏，缺失 libintl 时保留完整分母并绑定具体原因。
rec_command:            "refresh-patch --auto; make -C test check; inspect test_libintl/CMakeLists.txt for Intl REQUIRED"
rec_auto_fix:           false
rec_impl:               recipe-portability-patch-and-test-inventory

fallback_priority:      2
fallback_approach:      wait-for-libintl-capability
fallback_description:   若目标环境补齐 libintl.h、libintl link library、CMake Intl 和 msgfmt，运行完整 test_libintl 206 case；不得用替身库冒充对照结果。
fallback_command:       "cmake -S test_libintl -B build && cmake --build build && ./build/test_libintl"
fallback_auto_fix:      false
fallback_impl:          

forbid_1_pattern:       "typedef.*uint.*(system|platform)|#define.*uint|return 0.*stub"
forbid_1_reason:        通过系统偶然 typedef、宏污染或空壳 stub 掩盖公共头文件的严格 C++11 可移植性错误。
forbid_1_consequence:   其他 OHOS/clang 消费者仍会在独立 include 顺序下失败，且适配不再保持可复现。
forbid_2_pattern:       "SKIP.*(remove|drop|exclude)|libintl.*fake|msgfmt.*replace.*libintl"
forbid_2_reason:        不能把有据环境跳过缩小分母，也不能将 msgfmt 编译工具当成 libintl 运行时对照库。
forbid_2_consequence:   通过率虚高、上游覆盖丢失，无法定位实际缺失能力。

principles:             P005, P011, P016
causes:                 []
caused_by:              []
similar_to:             E035, E099, E257, E307, E321, E322
conflicts_with:         []
prerequisite_of:        []

