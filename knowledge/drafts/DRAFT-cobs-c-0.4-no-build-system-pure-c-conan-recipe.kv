#====================================================================
# DRAFT-cobs-c-0.4-no-build-system-pure-c-conan-recipe
#   无构建系统（无 configure/make/CMake）的纯 C 源文件库
#   —— Conan 自定义配方直接编译 + basic_layout 路径坑 + G1 方法声明
# 来源: PR feat/cobs-c-0.4（cobs-c 0.4 适配 HarmonyOS PC）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-cobs-c-0.4-no-build-system-pure-c-conan-recipe
trigger_tool:           conan|clang|llvm-ar
phase:                  configuration|compilation|packaging
error_signature:        no such file or directory: '.*\.c'|
                         no input files|
                         conanfile\.py 缺少: export_sources\(\) 方法|
                         conanfile\.py 缺少: 补丁应用调用|
                         tools\.build:archiver.*does not exist

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, custom-build, no-build-system, pure-c,
                        basic-layout, source-folder, conan-verify, G1
match_keywords:         无构建系统, 无 configure, 无 Makefile, 裸 C 源文件,
                        conanfile.py, 自定义编译, source_folder, build_folder,
                        llvm-ar, G1, export_sources, apply_conandata_patches,
                        直接编译, basic_layout
title:                  无构建系统（无 configure/make/CMake）的纯 C 源文件库：conanfile.py 用自定义 build() 直接编译，注意 basic_layout 源文件在 source_folder、G1 需 export_sources/apply_conandata_patches 声明、Conan 2 无 tools.build:archiver
prescan_pattern:        no such file or directory: '.*\.c'|conanfile\.py 缺少: export_sources

# ═══ Layer 2: 根因层 (Root Cause) ═══
root_cause:             官方源码仅含 .c/.h 源文件（无 configure/make/CMake 任何构建入口）；
                        init-build 按 autotools 模板生成的配方在 conan create 中：
                        ① basic_layout 下 source() 解包到 source_folder，build() 的 cwd
                        是 build_folder，裸写 "clang -c cobs.c" 找不到源文件；
                        ② conan-verify G1 强制要求 export_sources()/apply_conandata_patches()
                        方法声明（即使无补丁）；
                        ③ Conan 2.29 无 tools.build:archiver conf，归档器需直接写 llvm-ar。

affected_scope:         所有无任何构建系统的纯 C 源文件库（单/少文件、自带头文件的轻量库）

# ═══ Layer 3: 方案层 (Solution) ═══
rec_priority:           1
rec_approach:           custom-build-direct-compile-with-source-folder
rec_description:        【自定义 build()】conanfile.py 不用 Autotools/CMake 工具链，直接：
                        `cd $source_folder && clang -fPIC -O2 -c cobs.c -o $build_folder/cobs.o`
                        （同一模式编其余源文件）→ `llvm-ar rcs $build_folder/libcobs.a ...`；
                        package() 用 copy() 把头文件与静态库拷到 include/lib；package_info()
                        填 cpp_info.libs；补 export_sources()/apply_conandata_patches() 声明
                        以满足 conan-verify G1 门禁。
rec_command:            cd $BUILD_SRC_DIR && clang -fPIC -O2 -c cobs.c -o $BUILD_FOLDER/cobs.o && clang -fPIC -O2 -c cobsr.c -o $BUILD_FOLDER/cobsr.o && llvm-ar rcs $BUILD_FOLDER/libcobs.a $BUILD_FOLDER/cobs.o $BUILD_FOLDER/cobsr.o
rec_auto_fix:           false
rec_impl:               conan-recipe-custom-build

fallback_priority:      2
fallback_approach:      conan-header-only-or-single-script
fallback_description:   若库只有头文件 → header-only 配方；若有 Makefile → 走 E097 自定义 Makefile 路径
fallback_command:       （视库形态选择）
fallback_auto_fix:      false
fallback_impl:          conan-recipe

principles:             P004
