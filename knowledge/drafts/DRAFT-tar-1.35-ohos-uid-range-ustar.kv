#====================================================================
# DRAFT-tar-1.35-ohos-uid-range-ustar.kv — OHOS 高 uid 超 ustar/v7 字段容量
#====================================================================

id:                     DRAFT-tar-1.35-ohos-uid-range-ustar
trigger_tool:           tar|configure|make|test
phase:                  runtime|testing
error_signature:        out of uid_t range 0\.\.2097151|out of gid_t range 0\.\.2097151|
                         value [0-9]+ out of uid_t range|uid_t range 0\.\.2097151

severity:               2
category:               ohos, hmdfs, platform, limitation, testing
match_keywords:         uid_t range, 2097151, ustar, v7, base-256, HMDFS, uid 空间,
                         out of uid_t range, UID_TO_CHARS, octal field, large uid

prescan_pattern:

root_cause:             OHOS/HMDFS 执行端用户 uid 映射（如 euid=20020101、文件属主 uid=20001006）
                         大于 ustar/v7 头字段 21-bit octal 容量（2097151=2^21-1）。
                         GNU tar 上游对超出字段容量的 uid 在 v7/ustar 格式下拒绝写入
                         （create.c UID_TO_CHARS 失败），报 "value N out of uid_t range 0..2097151"。
                         默认/gnu/posix 格式用 base-256/xheader 可正常存储，仅 v7/ustar 用例失败。
                         属格式规范 + 环境 uid 空间共同作用，非当前库适配缺陷。

rec_approach:           在 uid<=2097151 的低 uid 用户上下文重跑强制 v7/ustar 的用例；或
                         确认执行端低 uid 不可用后（os.setuid EPERM / su/setpriv 缺失等真实证据），
                         如实记录为平台/权限阻塞与恢复条件，不得伪造通过。
                         默认格式下大 uid 归档不受影响（可用鸿蒙专项测试证明 base-256 往返）。

verification_cmd:       tar cf a.tar f.txt && tar cf b.tar --format=v7 f.txt;
                         id; python3 -c 'import os;print(os.geteuid())';
                         os.setuid 尝试（EPERM 为不可切换证据）

affected_scope:         一切在 HMDFS 高 uid 映射执行端运行强制 v7/ustar 归档的上游 testsuite
                         或归档工具的适配任务
source_pr:              feat/tar-1.35 (tar 1.35 R02, task tar-1.35-r02-pc3-13-20260913T113300Z)
contributor_id:         pc3-13
draft:                  true
