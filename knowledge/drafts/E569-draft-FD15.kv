#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E569.kv，填写各字段
# 对应的人类文档: doc/E569.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E569
trigger_tool: conan, autotools, make, clang
phase:                  configuration|compilation|linking|installation|testing|runtime
error_signature: src/util/bitvector.c:1:10: fatal error: 'util/bitvector.h' file not found

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: high
category: autotools, include-path, out-of-tree, makefile
match_keywords: -I../../src/include, -I../.., top_srcdir, out-of-tree, build-release, fatal error: util/bitvector.h: No such file or directory
title: 上游 Makefile.in 把 in-tree 相对 include 路径(-I../../src/include)写死，conan 独立 build 目录下头文件找不到

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游 src 下的 Makefile.in 把 in-tree 相对路径直接写进编译选项, 形如 -I../../src/include, 而没有使用 automake 的 top_srcdir 变量; conan 2 的 layout 使用独立 build 目录 build-release/, 该相对路径被解析到 build-release/src/include 的空镜像 -> 头文件找不到; 本地手工 in-tree 编译不复现, 是本地过/CI 挂的典型差异
affected_scope: 所有 src 子目录含手写相对 -I 路径的老 autotools 工程(cpu 1.4.3 实测 src/util/Makefile.in), 尤其 conan/CI 走 out-of-tree 构建时; in-tree 手工编译不复现
verification_cmd: grep -rnE '\-I\.\./\.\.' src/*/Makefile.in | head, 并在 build 目录下确认该相对路径解析结果不存在

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 配方 generate() 用绝对路径补齐 include 根: 在 AutotoolsToolchain 上 tc.extra_cflags.append 追加 -I 加 self.source_folder 加 /src/include; extra_cflags 进入 CFLAGS 与 Makefile 自带 -I 叠加且顺序无关; 不要靠改 build 目录或用 --srcdir 规避
rec_description: generate() 中 tc.extra_cflags.append(f"-I{self.source_folder}/src/include") 注入绝对 include 根, 覆盖 Makefile 里失效的相对路径
rec_command: tc.extra_cflags.append("-I" + self.source_folder + "/src/include")
rec_auto_fix: true
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P005, P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

