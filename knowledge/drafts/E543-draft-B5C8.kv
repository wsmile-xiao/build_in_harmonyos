#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: gp
phase: test
error_signature: a5_r2_0_full_table FAIL|#A5F==[0-9]+|nflist: domain error

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: gp-script, testing, pari, determinism
match_keywords: nflist, A5 table, state pollution, same gp process, count assertion, separate process, pari-nflistdata
title: PARI gp nflist 同进程状态污染：前序 nflist([d,i],t) 批量查询改变后续 A5 精确计数断言结果，须按断言族分进程

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: nflist 在 gp 进程内维护已加载表的内部状态。同一 gp 进程里先跑 650 条 nflist([deg,idx],t) 再执行 #nflist("A5",[1,524286^2],0)，返回值不再等于表内数据行数（实测由 15184 变小），断言假 FAIL。判据：同一脚本对上游原始解包目录与 conan 打包产物表现完全一致（同样 2 项 FAIL），故非打包差异而是解释器进程内状态。分进程后 QT 650/650、A5 语义 8/8 全通过。
affected_scope: 所有以 gp 批量断言验证的 PARI 系数据包（nflist / galoisgetpol / ellinit / ellmodulareqn），以及任何在同一解释器进程内混跑不同数据族与精确计数断言的测试驱动
verification_cmd: python3 run-upstream-gp-sweep.py <pkg>/res/pari --gp <gp> --lib <pari/lib> --lib <gmp/lib> --out-cases upstream-test-cases.txt  # pari-nflistdata/20220729 打包产物实测 TOTAL=685 PASS=665 FAIL=0 SKIP=20 rc=0

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 测试驱动按断言族拆分进程：每个 family 单独生成 GP 脚本并各起一次 gp，由外部驱动合并逐用例结果并与期望清单比对（缺失即 FAIL）。生成器保留 --family 开关便于单独复现；不要把不同数据族塞进同一 gp 进程。
rec_description: 不同断言族分进程跑 gp，避免解释器内表状态互相污染导致精确计数断言假失败
rec_command: for fam in qt a5; do python3 upstream-gp-sweep-generator.py <root> --family $fam --out sweep-$fam.gp; gp -q -f sweep-$fam.gp; done
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach:
fallback_description: 若必须单进程，需在精确计数断言前重置 nflist 状态（gp 无公开重置 API，实际不可行），或改为同进程实测值并在另一进程单独复核
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

