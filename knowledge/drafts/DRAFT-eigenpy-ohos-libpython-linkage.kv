# Draft knowledge entry: eigenpy OHOS shared targets need explicit libpython linkage
id: DRAFT-eigenpy-ohos-libpython-linkage
trigger_tool: cmake|conan|lld
phase: build|link
error_signature: "_Py_Dealloc|_Py_NoneStruct|PyLong_FromLong|undefined symbol|libboost_python312.so|libpython3.12.so|unable to find library -lintl"

severity: 2
category: eigenpy|ohos|boost-python|libpython|linker
match_keywords: eigenpy, OHOS, lld, libpython3.12, Boost.Python, Python::Python, eigenpy_pywrap, libintl

title: eigenpy OHOS shared targets need explicit libpython linkage
root_cause: >
  eigenpy's core shared library and Python extension both use Python API symbols
  through Boost.Python. On OHOS, lld requires those symbols to be resolved at
  shared-library link time, and the Boost.Python dependency does not reliably
  propagate libpython as a transitive link item. The recipe must discover the
  selected interpreter's libpython path and add it directly to the affected
  targets. Some official CI Python builds also put -lintl into the
  Python::Python imported target even when libintl is not on the link search
  path, so the OHOS patch should prefer a dedicated OHOS_PYTHON_LIBRARY file
  path before falling back to imported Python targets.
affected_scope: >
  eigenpy 3.13.0 OHOS builds and similar Boost.Python CMake projects that build
  both a core shared library and a Python extension module.
verification_cmd: |
  sh "$HOME/bin/run-ohos-shadow-ci.sh" archives/e/eigenpy/3.13.0
  llvm-readelf -d <package>/lib/libeigenpy.so
  llvm-readelf -d <package>/lib/python3.12/site-packages/eigenpy/eigenpy_pywrap*.so

rec_priority: 1
rec_approach: link-libpython-on-eigenpy-shared-targets
rec_description: >
  Preload Python/Python3 CMake variables with the selected interpreter's
  include and libpython paths, then patch the upstream CMake link blocks on OHOS
  so both libeigenpy and eigenpy_pywrap explicitly link OHOS_PYTHON_LIBRARY
  first. Fall back to Python::Python, Python3::Python, Python_LIBRARIES, or
  Python3_LIBRARIES only when the direct file path is unavailable.
rec_command: |
  target_link_libraries(${PROJECT_NAME} PRIVATE "${OHOS_PYTHON_LIBRARY}")
  target_link_libraries(${PYWRAP} PRIVATE "${OHOS_PYTHON_LIBRARY}")
rec_auto_fix: false
rec_impl: ohos-explicit-libpython-target-link

fallback_priority: 2
fallback_approach: discover-libpython-from-interpreter-sysconfig
fallback_description: >
  If CMake cannot construct Python::Python during cross-build configure, query
  the selected interpreter for LIBDIR, LIBPL, LDLIBRARY, and mapped libpython
  paths, then pass the resulting file through Python_LIBRARIES and
  Python3_LIBRARIES.
fallback_command: |
  python3 -c "import sysconfig; print(sysconfig.get_config_var('LIBDIR'))"
fallback_auto_fix: false
fallback_impl: python-sysconfig-libpython-discovery

forbid_1_pattern: "target_link_libraries\\([^\\n]*(boost_python|Boost::python)[^\\n]*\\)"
forbid_1_reason: Boost.Python alone does not guarantee Python API symbols are resolved by OHOS lld.
forbid_1_consequence: libeigenpy.so or eigenpy_pywrap can fail with undefined _Py_* and Py* symbols.

principles: explicit-runtime-linkage, interpreter-matched-libpython, ohos-only-cmake-patch
source_event: eigenpy/3.13.0 device shadow CI undefined Python symbols; official CI #34231 -lintl link failure
last_updated: 2026-08-29
