#====================================================================
# DRAFT-tag-archive-git-version-gen-version-pin.kv
# 对应的人类文档: knowledge/drafts/DRAFT-tag-archive-git-version-gen-version-pin.md
#====================================================================

# ═══ Layer 0: 场景面 ═══
id:                     DRAFT-tag-archive-git-version-gen-version-pin
trigger_tool: cmake|configure|gcc
phase: build|package
error_signature: version.*GIT|0\.8\.0\.GIT|soname.*GIT|Unknown version

# ═══ Layer 1: 识别层 ═══
severity: 1
category: version-provenance, conan, cmake, portability
match_keywords: git-version-gen, tag archive, version 文件, 钉版, tarball-version, soname, DEF_VER
title: tag archive + git-version-gen 上游的 version 文件钉版法

# ═══ Layer 2: 诊断层 ═══
root_cause: git-version-gen 系脚本按"源根 version 文件→git describe→DEF_VER 默认值"三级取版;tag archive 无 .git 时回退默认脏版本(如 0.8.0.GIT),污染 ONION_VERSION/soname/pkg-config Version。脚本第一优先级本就是读源根 version 文件——发布工程自带的钉版接口,tag archive 只是没带上。
affected_scope: git/gnulib 系上游(git-version-gen);一切"构建期推导版本"且推导链依赖 .git 的工程;tag archive 源形态的全部此类任务。
verification_cmd: echo "<任务版本>" > "$SRC/version";configure 日志核版本打印;ls lib/ 核 soname 干净命名;cat lib/pkgconfig/*.pc 核 Version 字段

# ═══ Layer 3: 方案层 ═══
rec_priority: 1
rec_approach: version-file-pin-before-configure
rec_description: (1) 读上游 git-version-gen 头 40 行确认取版优先级与钉版文件名(version 或 .tarball-version);(2) build() 在 configure 前写该文件,内容=任务版本号(脚本自剥 v 前缀);(3) WSL 预验证核 soname/pc Version 干净;(4) 属配方资产注入(构建输入),非改上游文件字节。
rec_command: echo "0.8" > "$SRC/version" && cmake -S "$SRC" -B build && grep "version is" build/CMakeCache.txt
rec_auto_fix: false
rec_impl:

# ★ 禁止策略 ★
forbid_1_pattern: patch.*git-version-gen
forbid_1_reason: 为版本号改上游构建脚本漂移面大
forbid_1_consequence: 升级补丁冲突
forbid_2_pattern: accept.*DEF_VER|soname.*GIT
forbid_2_reason: 脏版本 soname 消费者无法依赖
forbid_2_consequence: ABI 断裂与审查退回
forbid_3_pattern: rename.*\.so|post.*rename
forbid_3_reason: 事后改名破坏与安装面对应关系
forbid_3_consequence: pkg-config/cmake-config 指向失效

# ═══ Layer 4: 原则引用 ═══
principles:

