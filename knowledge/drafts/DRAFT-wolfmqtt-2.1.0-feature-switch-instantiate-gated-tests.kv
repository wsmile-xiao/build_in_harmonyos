#====================================================================
# DRAFT-wolfmqtt-2.1.0-feature-switch-instantiate-gated-tests
#   用无依赖库特性开关实例化 AM_CONDITIONAL 门控的上游测试，
#   并把特性宏同步进 consumer defines（ABI 一致性）
# 来源: 任务 wolfmqtt-2.1.0-r01/r02/r03-pc1-15（wolfmqtt 2.1.0 适配）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-wolfmqtt-2.1.0-feature-switch-instantiate-gated-tests
trigger_tool:           configure|make|automake|conan
phase:                  testing|configuration|packaging
error_signature:        check_PROGRAMS.*if BUILD_|
                         AM_CONDITIONAL.*BUILD_|
                         uninstantiated.*--enable|
                         默认配置.*只实例化|
                         TOTAL:\s*[0-9]+.*声明数.*小于|
                         cpp_info\.defines.*缺.*宏|
                         scripts/.*\.test.*/bin/bash|
                         LTLIBEVENT.*空.*bin_PROGRAM

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               testing, autotools, am-conditional, feature-switch,
                        conan, cpp-info-defines, consumer-abi, ohos,
                        upstream-tests, cli-delivery, commands-json
match_keywords:         上游测试, 通过率, AM_CONDITIONAL, if BUILD_SN,
                        --enable-sn, --enable-v5, --enable-nonblock,
                        --enable-mt, --enable-broker, check_PROGRAMS,
                        特性开关, 门控, uninstantiated, 双口径,
                        source_declared_total, configured_executable_total,
                        cpp_info.defines, 特性宏, ABI, consumer, test_package,
                        make check, R51, R38, commands.json, LTLIBEVENT,
                        libevent, TESTS 覆盖, 集成脚本
title:                  用无依赖/交付形态合规的库特性开关实例化 AM_CONDITIONAL
                        门控的上游测试二进制，并把启用特性宏同步进
                        cpp_info.defines 保证 consumer ABI 一致
prescan_pattern:        if\s+BUILD_|AM_CONDITIONAL.*BUILD_|
                        check_PROGRAMS\s*\+=\s*tests/|
                        --enable-(sn|v5|nonblock|mt|broker)|
                        LTLIBEVENT|scripts/.*\.test
prescan_globs:          configure.ac, Makefile.am, tests/include.am,
                        src/include.am, conanfile.py

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             autotools 把测试目标挂在库特性开关的 AM_CONDITIONAL 条件块下
                        （if BUILD_SN 等）：特性默认关 → 对应 check_PROGRAMS 不生成，
                        configure/make 都不报错（优雅降级），双口径台账里大量源码声明
                        用例落入 uninstantiated，本可直接运行的测试白白损失覆盖率。
                        两种门控语义必须区分：库特性开关（可开）vs 可选测试框架
                        autodetect（AC_CHECK_CUTTER 等，须补框架）。开了库特性后，
                        公开头文件结构可能随特性宏变化（#ifdef 包字段/枚举），若不同步
                        cpp_info.defines，consumer 拿不到宏 → 头文件布局与库 ABI 错位。
                        同一 AM_CONDITIONAL 可同时门控库功能/测试/CLI（broker 案例），
                        需逐项评估交付形态。r02 实证：--enable-broker 虽产生
                        bin_PROGRAM，但上游从不设置 $(LTLIBEVENT)（无探测）且
                        mqtt_broker.c 无 event_* 引用 → 实际无硬链接依赖，补
                        commands.json 即合规（R38/L0k）。
affected_scope:         autotools 库型包，上游测试目标挂在库特性开关 AM_CONDITIONAL
                        下，且被门控特性无额外依赖、或依赖可消费且交付形态合规。
                        实证：wolfmqtt 2.1.0（SN/V5/NONBLOCK/MT/BROKER 五特性，
                        审查端全量口径 494 声明 → 487 实例化 487 通过）。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           enable-no-dependency-feature-switches-and-propagate-defines
rec_description:        ① 判别门控语义：grep -nE 'if BUILD_' tests/include.am 确认是
                        库特性 AM_CONDITIONAL（非测试框架 autodetect）；② 只开无依赖、
                        交付形态合规的库特性（--enable-sn/--enable-v5/
                        --enable-nonblock/--enable-mt；判据=不需新 requires、不产生
                        bin_PROGRAM）；broker 类先核验依赖可消费性 + 上游是否真链接
                        （LTLIBEVENT 空 + 无 event_ 引用 → 无硬依赖），CLI 时按 R38
                        补 commands.json 并设 cpp_info.bindirs；③ 特性宏同步
                        cpp_info.defines（ENABLE_MQTT_TLS/WOLFMQTT_SN/WOLFMQTT_V5/
                        WOLFMQTT_NONBLOCK/WOLFMQTT_MULTITHREAD/WOLFMQTT_BROKER），
                        consumer 测试用同一宏集编译；④ 集成脚本（非用户用例）用
                        automake TESTS 覆盖排除（make check TESTS="check_PROGRAMS..."）；
                        ⑤ 重跑 conan create（build() 内 make check 记录），对比
                        before/after 实例化数回填双口径台账。
rec_command:            grep -nE 'if BUILD_' tests/include.am;
                        grep -nE 'AM_CONDITIONAL' configure.ac;
                        grep -nE 'LTLIBEVENT|event_' configure.ac src/mqtt_broker.c;
                        conan create <pkg> -pr:h=<ohos-profile> -pr:b=<ohos-profile> --build=missing
rec_auto_fix:           false
rec_impl:               enable-feature-switches-in-generate-then-propagate-in-package-info

fallback_priority:      2
fallback_approach:      report-uninstantiated-with-ledger
fallback_description:   特性引入外部依赖且不可消费、或交付形态合规性无法满足（如
                        broker 真需 libevent 且制品缺失）时，不开开关，将对应用例记
                        uninstantiated 并写明恢复条件与依赖证据（conan download
                        命令/退出码/日志），等待分析端决定是否单独绑定。
fallback_command:       台账中按 source_declared_total / configured_executable_total /
                        executed_passed_total 双口径如实记录
fallback_auto_fix:      false
fallback_impl:          ledger-only

# ★ 禁止策略 ★
forbid_1_pattern:       改上游.*test.*\.c|sed.*test.*assert|强改 WITH_.*=yes
forbid_1_reason:         门控测试是"没跑/少跑"，改测试源或绕过守卫属谎报（R8）
forbid_1_consequence:   掩盖真实情况，审查拒收
forbid_2_pattern:       为实例化测试而开.*(broker|.*libevent.*|.*bin_PROGRAM)
forbid_2_reason:        特性翻转交付形态（库→CLI）时须补 commands.json/签名链；
                        仅当依赖可消费且交付形态合规才开，否则保持关闭
forbid_2_consequence:   意外产生 CLI 交付物或依赖未验证，R38/L0k/PF8 拦截
forbid_3_pattern:       cpp_info\.defines.*缺.*(WOLFMQTT|ENABLE_)|
                         只开开关.*不同步.*defines
forbid_3_reason:         头文件随宏变化时不同步 defines → consumer ABI 错位
forbid_3_consequence:   第三方 consumer 编译/链接期接口错位
forbid_4_pattern:       集成脚本.*计入.*用户用例|TESTS.*默认.*跑.*\.test
forbid_4_reason:        集成脚本（scripts/*.test）非用户 TEST() 用例，需 examples 二进制
                        + /bin/bash（OHOS 无）；R51 脚本列台账不计用例
forbid_4_consequence:   误报上游用例数，台账失真

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P010, P013

