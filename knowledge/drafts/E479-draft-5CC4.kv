#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E479.kv，填写各字段
# 对应的人类文档: doc/E479.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E479
trigger_tool: make|test|runtime
phase: testing
error_signature: chmod 000.*rw-|chmod.*not effective|Permission denied.*expected

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: hmdfs, testing, portability, posix
match_keywords: chmod, HMDFS, permission, fopen, 500, TEST_UNDER_VIRTUALBOX, 文件系统权限语义, 跳过测试
title: 文件系统权限语义不可靠时优先使用上游自带的可靠性开关，而不是跳过测试用例

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: HMDFS 上 chmod() 恒返回 0 但只加不减：有效模式 = 创建时模式 | 请求模式，world 位永远为 0（umask 000 新建文件仍是 -rw-rw----，随后 chmod 000/400 改不动），因此『改权限后访问应失败』这一断言前提在该平台必然不成立，且返回码无法暴露该失效
affected_scope: 所有含文件权限/只读目录/符号链接语义断言的测试套件（HTTP 静态服务、日志轮转、锁文件、安装包校验等）在 HMDFS 上的适配
verification_cmd: cd $HOME/tmp && touch f && chmod 000 f && ls -l f && cat f && echo READ_OK

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: upstream-unreliable-fs-switch
rec_description: 先在上游源码里找它为不可靠文件系统预留的编译期开关（如 Cesanta 的 TEST_UNDER_VIRTUALBOX、常见命名 NO_DNS_TEST / SKIP_PERM_TESTS），用 CFLAGS_EXTRA 传入，只关掉那一处断言块，零源码改动；受影响的只有该块而非整条用例
rec_command: make -C test -j1 unit_test CC=$CC CFLAGS_EXTRA=-DTEST_UNDER_VIRTUALBOX
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: skip-with-attribution
fallback_description: 确实没有可用的上游开关时，才按 E046 跳过该用例，并在 PR/notes 中给出真机实测证据与受影响断言数
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: __OHOS__|#ifdef __OHOS
forbid_1_reason: 为了绕过权限语义而在补丁里新增平台宏，会把平台判断写进上游代码，违反 R8/PF5 补丁平台宏闸
forbid_1_consequence: CI preflight PF5 直接拦截，补丁无法进上游且不可复用
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P016

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E046
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E479.md
last_updated: 2026-09-02
source_event: fossa/2.1 test_http_errors 在真机返回 200 而非 500

# ═══ 知识协作 (Authorship & Provenance) ═══
