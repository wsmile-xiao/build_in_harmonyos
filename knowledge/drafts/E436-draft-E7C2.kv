# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E436.kv，填写各字段
# 对应的人类文档: doc/E436.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E436
trigger_tool: configure
phase: configuration
error_signature: file failed to open for reading.*oauth2|pkg_config_custom_content|Cannot find glib-compile-schemas|glib_compile_schemas

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: configuration,cmake,glib,build-system
match_keywords: glib_compile_schemas, glib-compile-schemas, pkg_check_variable, conan .pc 缺变量, CMake cache 预置
title: GLibTools.cmake 用 pkg-config 变量定位 glib-compile-schemas，conan 生成的 .pc 无该变量

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: GLibTools.cmake 在非 CMAKE_CROSSCOMPILING（OHOS 上构建机=目标机，CMAKE_HOST_SYSTEM_NAME 也是 HarmonyOS）分支走 pkg_check_variable(GLib_COMPILE_SCHEMAS gio-2.0 glib_compile_schemas)，而 PkgConfigDeps 生成的 gio-2.0.pc 没有该变量 → configure FATAL 'Cannot find glib-compile-schemas'；此外 hnp 的 gdbus-codegen/glib-mkenums 是 /usr/bin/python3、/usr/bin/perl shebang 的坏脚本，conan glib 包内 ELF 工具未签名（loader 拒绝执行）
affected_scope: 所有用 GLibTools.cmake / pkg-config 变量探测构建期工具的 CMake 工程（evolution-data-server 系）
verification_cmd: grep -n glib_compile_schemas <generators>/gio-2.0.pc；head -1 /data/service/hnp/bin/{gdbus-codegen,glib-mkenums}

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: seed-cmake-cache-and-pc-variable
rec_description: 双管齐下：给 gio-2.0 组件注入 pkg_config_custom_content={glib_compile_schemas: <可运行路径>}，同时用 tc.variables 预置 CMake cache（GLIB_MKENUMS/GDBUS_CODEGEN 取 conan glib 的 python 脚本、GLIB_COMPILE_* 取 hnp 的 ELF 并把 libffi 目录加入 LD_LIBRARY_PATH）
rec_command: tc.variables["GLIB_COMPILE_SCHEMAS"]="/data/service/hnp/bin/glib-compile-schemas"
rec_auto_fix: false
rec_impl: 

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: find_program\(GLIB_COMPILE_SCHEMAS.*PATHS /us
forbid_1_reason: 应显式区分 Python 脚本类与 ELF 类工具来源
forbid_1_consequence: hnp 坏 shebang 或未签名 ELF 工具导致 configure 报 No such file or directory / operation not permitted
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P002,P009

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

