#====================================================================
# E2179-draft-C112.kv — meson 配置期 cpp.run() 探针因 host 共享依赖不在
# LD_LIBRARY_PATH 而失败（127 / Unknown variable）
# 触发事件: kea-hook-perfmon 3.0.3 适配（ISC Kea, meson + Conan）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E2179
trigger_tool:           meson
phase:                  configuration
error_signature:        Checking if "(LOG4CPLUS_INITIALIZER_H|Get Log4cplus version)" .* runs: NO \(127\)|Error loading shared library liblog4cplus\.so\.9|meson\.build:[0-9]+:[0-9]+: ERROR: Unknown variable "log4cplus"

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, conan, meson
match_keywords:         meson, cpp.run, run probe, runs: NO (127), Error loading shared library, Unknown variable, LD_LIBRARY_PATH, MesonToolchain, PkgConfigDeps, shared dependency, Conan
title:                  meson 配置期 compile-and-run 探针 127 —— host 共享依赖不在 LD_LIBRARY_PATH

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             meson 的 dependency() 特性探针是“编译并运行”，探针可执行文件在配置期
                        真实执行；Conan 提供的 host 依赖是 shared 库（如 log4cplus
                        shared=True），其 libdir 既不在构建目录 RPATH 内、也不在配置期进程的
                        LD_LIBRARY_PATH 中，动态加载失败（退出码 127）。meson 把“探针运行失败”
                        当成特性不可用，随后以“变量未定义”的形式在后续行报错，错误信息误导性强。
affected_scope:         OHOS/Conan 本地与 CI 构建中，任何依赖 shared 库并在 meson 配置期执行
                        compile-and-run 探针的项目（ISC Kea 3.0.3 的 log4cplus/openssl/boost
                        探针链；OpenSSL/日志类依赖同理）
verification_cmd:       grep -n -B3 -A3 'runs: NO (127)' <builddir>/meson-logs/meson-log.txt

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           inject-runtime-libdirs
rec_description:        在 conanfile.generate() 中把各 host 依赖的 cpp_info.libdirs 追加进
                        LD_LIBRARY_PATH 并落成 env script（随 conanbuild.sh 聚合，build 阶段
                        自动 source），使配置期运行探针可解析共享依赖
rec_command:            env = Environment(); 遍历 self.dependencies.values() 的 cpp_info.libdirs 调 env.append_path("LD_LIBRARY_PATH", libdir); env.vars(self).save_script("conanbuildenv-<pkg>-runtime")
rec_auto_fix:           false
rec_impl:               env-inject

fallback_priority:      2
fallback_approach:      disable-probe
fallback_description:   若该探针仅用于可选特性，用显式项目选项关闭它（如 -Dmysql=disabled、
                        -Dnetconf=disabled），避免配置期执行运行探针；不适用于强制特性
fallback_command:       tc.project_options["<feature>"] = "disabled"
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       --build=missing|跳过(配置|configure)探针|伪造 meson-log
forbid_1_reason:        用 --build=missing 或跳过探针会掩盖依赖缺口，产出不可复现的构建
forbid_1_consequence:   违反 R36（依赖必须先发布再构建下游）/ 产生假绿构建，CI 与本地结果不一致

# ═══ Layer 4: 原则引用 ═══
principles:

