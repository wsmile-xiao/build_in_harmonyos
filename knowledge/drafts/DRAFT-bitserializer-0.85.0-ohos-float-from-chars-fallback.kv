#====================================================================
# DRAFT-bitserializer-0.85.0-ohos-float-from-chars-fallback.kv
# 主题: OHOS libc++ charconv 缺浮点 from_chars，需 feature-gate 回退 strtod
# 来源: bitserializer 0.85.0 首轮适配首错（conan create / test_package 阶段）
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     DRAFT-bitserializer-0.85.0-ohos-float-from-chars-fallback
trigger_tool:           clang|cmake|conan
phase:                  compilation
error_signature:        call to deleted function 'from_chars'|
                        no matching function for call to 'from_chars'.*chars_format|
                        no viable overloaded.*from_chars.*float|from_chars.*is_integral.*not satisfied

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               platform, libcxx, charconv, portability
match_keywords:         from_chars, charconv, float, libc++, OHOS, feature macro, strtod,
                         BITSERIALIZER_HAS_FLOAT_FROM_CHARS, to_chars

# ═══ Layer 2: 诊断层 ═══
title:                  OHOS libc++ charconv 无浮点 from_chars，库的编译器版本判断宏需按平台关闭
root_cause:             OHOS SDK (26.0.0.18) 的 libcxx-ohos charconv 仅提供整型
                         from_chars（is_integral 约束）与浮点 to_chars 声明，
                         浮点 from_chars（float/double/long double, chars_format 重载）
                         未实现。上游库若按编译器版本（如 clang>13）默认开启浮点
                         from_chars 能力宏，编译期会命中 deleted bool 重载或
                         is_integral 约束模板而报 "call to deleted function 'from_chars'"。
                         需在配置/feature 宏层面关闭该能力，使浮点字符串转换回退到
                         strtod/strtof/strtold（snprintf 格式化输出）路径。
affected_scope:         C++17 库在 OHOS aarch64 调用 std::from_chars 浮点重载，
                         且库头按编译器版本（而非平台 libc++ 能力）声明浮点 from_chars 支持
verification_cmd:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing
                         # 复现最小探针: printf 'int main(){double d; std::from_chars("1.5","1.5"+3,d);}' | clang++ -x c++ -std=c++17 -c -

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           platform-gate-float-from-chars-macro
rec_description:        在库的配置头（如 cmake/bitserializerConfig.h.in 生成 config.h）的
                         能力宏判断中，为 OHOS 工具链显式关闭浮点 from_chars
                         （BITSERIALIZER_HAS_FLOAT_FROM_CHARS=0），并在转换实现处为
                         浮点类型提供 strtod/snprintf 回退路径（本库已有
                         convert_compatibility.h），保持整型路径使用 from_chars。
                         以补丁形式固化进 conandata.yml patches。
rec_command:            在 config.h.in 的宏判断处按 __OHOS__ 关闭：
                         #if defined(__OHOS__)  → #define BITSERIALIZER_HAS_FLOAT_FROM_CHARS 0
rec_auto_fix:           true

fallback_priority:      2
fallback_approach:      call-site-float-from-chars-guard
fallback_description:   若库未提供集中能力宏，则在调用点按 std::is_floating_point_v<T>
                         分派：浮点走 strtod 族，整型走 from_chars；同样打 patch 固化。

# ★ 禁止策略 ★
forbid_1_pattern:       chars_format::general.*from_chars.*float|from_chars\(.*float.*chars_format
forbid_1_reason:        OHOS libcxx-ohos 无该重载，硬传 chars_format 仍编译失败（本任务已验证）
forbid_1_consequence:   继续编译失败，浪费循环

# ═══ Layer 4: 原则引用 ═══
principles:             P003
causes:
caused_by:
similar_to:             E455, E532
conflicts_with:
prerequisite_of:

# ═══ 元数据 ═══
