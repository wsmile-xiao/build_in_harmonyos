#====================================================================
# E657 — OHOS conan 沙箱中不兼容 libc++_shared.so 遮蔽
#         所致宿主 cmake/qtpaths 符号重定位失败与 /system/lib64 前置修复
# 发现于: ksyntaxhighlighting 6.26.0 适配（KF6 系列包）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E657
trigger_tool:           conan|cmake|qtpaths
phase:                  configuration|build|runtime
error_signature:        Error relocating /data/service/hnp/bin/cmake: .*symbol not found|Error loading shared library libc++_shared.so.*needed by|Error loading shared library.*libc\+\+_shared\.so

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               ohos, toolchain, conan, runtime, portability
match_keywords:         libc++_shared.so, LD_LIBRARY_PATH, /system/lib64, conan, cmake, 符号重定位, symbol not found, 遮蔽, sandbox, qtpaths, ECM, KF6
title:                  OHOS conan 沙箱中不兼容 libc++_shared.so 遮蔽所致宿主 cmake/qtpaths 符号重定位失败，前置 /system/lib64 修复

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS conan 构建沙箱把各依赖包的 lib 目录 prepend 进 LD_LIBRARY_PATH 后，其中某个不兼容的 libc++_shared.so（如宿主二进制所需 ABI 版本不同）遮蔽了 /system/lib64 下的兼容版本；宿主工具（/data/service/hnp/bin/cmake、ECM KDEInstallDirs 调用的 qtbase qtpaths）运行时报 _ZNSt4__n1* / _ZNKSt4__n119__shared_weak_count 等 libc++ 符号 "symbol not found"，configure/构建直接失败。
affected_scope:         所有在 OHOS conan 沙箱中运行宿主 C++ 工具（cmake/qtpaths 等）的 CMake/ECM 工程（KF6 系列、Qt 系库），特别是依赖注入各依赖 lib 并 prepend LD_LIBRARY_PATH 的配方。
verification_cmd:       conan create archives/k/ksyntaxhighlighting/6.26.0 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing --user=ohpcd --channel=stable

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           prepend-system-lib64-to-ld-library-path
rec_description:        在配方 build()/test() 环境（Environment）中对 OHOS prepend LD_LIBRARY_PATH=/system/lib64，使加载器优先解析兼容的 system libc++，宿主 cmake/qtpaths 正常重定位。test_package 的 build() 与 test() 同样需要（其 cmake.configure 也跑宿主 cmake）。
rec_command:            build_env.prepend_path("LD_LIBRARY_PATH", "/system/lib64")  # 仅 settings.os == "OHOS" 时
rec_auto_fix:           false
rec_impl:               runtime-env-prepend-system-lib64

fallback_priority:      2
fallback_approach:      sdk-llvm-lib-prepend
fallback_description:   若 /system/lib64 无法满足（部分场景还需 SDK libc++），在 test_package 中对 /data/service/hnp/ohos-sdk.org/ohos-sdk_*/ohos/native/llvm/lib 同样 prepend，与 /system/lib64 并用。
fallback_command:       test_env.prepend_path("LD_LIBRARY_PATH", "/system/lib64"); sdk_llvm=.../llvm/lib; if是目录 prepend
fallback_auto_fix:      false
fallback_impl:          sdk-llvm-lib-prepend

forbid_1_pattern:       (删除|rm).*libc\+\+_shared\.so|unset LD_LIBRARY_PATH
forbid_1_reason:        删除/清空 LD_LIBRARY_PATH 会使依赖链运行的自身库也找不到，破坏其它并发任务沙箱。
forbid_1_consequence:   全局清变量引发不确定加载行为，且不影响已注入的 conan 环境缓存中的条目。

# ═══ Layer 4: 原则引用 ═══
principles:             P013

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E520, E538]
conflicts_with:         []
prerequisite_of:        []

