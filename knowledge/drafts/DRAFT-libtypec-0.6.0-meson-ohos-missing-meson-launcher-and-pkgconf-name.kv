#====================================================================
# DRAFT-libtypec-0.6.0-meson-ohos-missing-meson-launcher-and-pkgconf-name - Meson on OHOS: missing meson launcher + pkgconf binary name
#====================================================================

id:                     DRAFT-libtypec-0.6.0-meson-ohos-missing-meson-launcher-and-pkgconf-name
trigger_tool:           meson|conan
phase:                  configure|build
error_signature:        meson: inaccessible or not found|Found pkg-config: NO|Pkg-config for machine host machine not found|unable to make temporary file: Read-only file system

severity:               3
category:               meson|conan|pkg-config|ohos|headless-toolchain
match_keywords:         meson not found, pkg-config not found, Found pkg-config NO, PkgConfigDeps, tool_requires pkgconf, PKG_CONFIG, dependency libudev, Read-only file system TMPDIR, python mesonbuild module, OHOS headless build
title:                  Meson 在 OHOS 无头设备上缺 meson 可执行入口与 pkgconf 二进制名差异的修复模式

root_cause:             OHOS 构建机只把 meson 装成 python 模块（无 console script meson），且系统不带 pkg-config 二进制；PkgConfigDeps 只在 generators/ 生成 .pc 并设 PKG_CONFIG_PATH，并不提供 pkg-config 可执行程序；ohpcd 的 pkgconf/3.0.5 包提供的二进制名为 pkgconf 而非 pkg-config，meson 默认按 pkg-config 查找，必须用 PKG_CONFIG 环境变量显式指向；另 OHOS /tmp 只读，clang 写临时文件失败需 TMPDIR 指向 $HOME/tmp。
affected_scope:          用 Meson 构建、且经 dependency() + pkg-config 探测依赖（如 libudev/eudev）的 C 库；在无系统 meson/pkg-config 的 OHOS PC headless 构建机上。
verification_cmd:       conan create 成功（meson setup + ninja + install）；test_package 两个 C 消费者真机运行通过（init 版本串断言 + 查询 API 优雅降级）；libtypec.so 加载器接受。

rec_priority:           1
rec_approach:            tool-requires-pkgconf-plus-PKG_CONFIG-env
rec_description:        build_requirements() 里 tool_requires("pkgconf/<ver>") 提供 pkg-config 二进制；generate() 里 PkgConfigDeps + MesonToolchain 后设 os.environ["PKG_CONFIG"]="pkgconf"；设备 PATH 上补 meson 包装（exec python3 -m mesonbuild.mesonmain "$@"）；构建时 export TMPDIR=$HOME/tmp 并限 NINJAFLAGS=-j<N>。
rec_command:            self.tool_requires("pkgconf/3.0.5"); PkgConfigDeps(self).generate(); MesonToolchain(self).generate(); os.environ["PKG_CONFIG"]="pkgconf"; export TMPDIR=$HOME/tmp
rec_auto_fix:           false
rec_impl:               conan-recipe-plus-env

fallback_priority:      2
fallback_approach:      system-pkgconfig-in-imagen
fallback_description:   若构建镜像可预装 pkg-config 与 meson console script，则无需配方侧处理；但 OHOS headless 镜像通常精简，不推荐依赖镜像变更。
fallback_command:       apt/ohos pkg install pkg-config meson
fallback_auto_fix:      false
fallback_impl:          image-preinstall

forbid_1_pattern:       PkgConfigDeps\(self\)\.generate\(\)\s*$
forbid_1_reason:        只调用 PkgConfigDeps 不补 pkg-config 二进制，meson 仍报 Found pkg-config: NO。
forbid_1_consequence:   configure 阶段 "Pkg-config for machine host machine not found" 直接失败。

forbid_2_pattern:       os\.environ\["PKG_CONFIG"\]\s*=\s*"pkg-config"
forbid_2_reason:        ohpcd pkgconf 包二进制名为 pkgconf；写成 pkg-config 仍找不到。
forbid_2_consequence:   meson 仍按 pkg-config 查找并失败。

principles:             P010, P020
causes:                 []
caused_by:              []
similar_to:             [E093]
conflicts_with:         []
prerequisite_of:        []

