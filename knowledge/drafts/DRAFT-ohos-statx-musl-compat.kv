#====================================================================
# DRAFT-ohos-statx-musl-compat — OHOS musl 不定义 struct statx/STATX_* 宏/
#   statx()，systemd 的 stat-util.h/recurse-dir.c 需要——在 musl 兼容头补
#   结构体 + 宏 + 函数声明 + syscall 实现
# 对应人类文档: knowledge/drafts/DRAFT-ohos-statx-musl-compat.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR systemd/261 适配 HarmonyOS PC（statx-util/recurse-dir 编译）
#====================================================================

id:                     DRAFT-ohos-statx-musl-compat
trigger_tool:           cc|clang|make|meson
phase:                  compilation|linking
error_signature:        incomplete definition of type 'struct statx'|
                         use of undeclared identifier 'STATX_|STATX_.*not defined|
                         use of undeclared function 'statx'|
                         call to undeclared function 'statx'

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               ohos, musl, statx, syscall, headers, compilation, portability
match_keywords:         struct statx, STATX_TYPE, STATX_INO, STATX_MNT_ID,
                         STATX_ATTR_MOUNT_ROOT, statx(), __NR_statx, syscall,
                         musl, linux/stat.h, stat-util, incomplete type,
                         undeclared
title:                  OHOS musl 不定义 struct statx/STATX_* 宏/statx()——在
                         musl 兼容头补结构体+宏+函数声明+syscall 实现

# ═══ Layer 2: 诊断层 ═══
root_cause:             Linux 的 statx() 系统调用接口（struct statx + STATX_*
                         宏 + statx() 包装）定义在 linux/stat.h / glibc 的
                         sys/stat.h。OHOS musl 的 sys/stat.h 既不带 linux/stat.h
                         （避免冲突），也不定义 struct statx/STATX_* 宏，更不
                         声明 statx() 函数——systemd 的 stat-util.h（statx_is_set
                         读 stx_mask）与 recurse-dir.c（statx() 调用）编译报
                         "incomplete definition" / "undeclared identifier /
                         function"
affected_scope:         所有在 OHOS 上编译、使用 Linux statx 接口（statx() 系统调用
                         或 struct statx 字段）的库（systemd 即此类）
verification_cmd:       conan create archives/s/systemd/261 --build=missing
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 覆盖前 stat-util.h/recurse-dir.c 报 struct statx
                         # 不完整/STATX_* 未声明；覆盖后编译链接通过

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           musl-compat-statx
rec_description:        在 musl 兼容头（如 src/include/musl/sys/stat.h）补三件套：
                         ①struct statx（含 struct statx_timestamp 先定义，stx_mask
                         等最小字段）+ ②全部 STATX_* mask/attribute 宏（值取自
                         Linux uapi）+ ③statx() 函数声明；实现用 syscall(__NR_statx)
                         包装（OHOS 内核支持 statx，musl 未包装）
rec_command:            (musl 兼容头)
                         struct statx_timestamp { int64_t tv_sec; uint32_t tv_nsec; ... };
                         struct statx { uint32_t stx_mask; ... uint64_t __spare3[12]; };
                         #define STATX_TYPE 0x00000001U ... （mask+attribute 全套）
                         int statx(int dirfd, const char *pathname, int flags,
                                   unsigned int mask, struct statx *statxbuf);
                         (实现) int statx(...) { return syscall(__NR_statx, ...); }
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      source-patch-disable-statx-usage
fallback_description:   若补全不可行，patch 源码改用 stat() 替代 statx 调用——改动面
                         大且丢失 statx 能力，不推荐
fallback_command:       (逐文件补丁)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       skip.*statx.*路径|禁用.*statx|N/A（未运行）
forbid_1_reason:        musl 兼容补全可无损解决；跳过/禁用属"有可运行子集未尝试"
forbid_1_consequence:   被 rule 4 打回；且丢失 statx 语义
forbid_2_pattern:       sed.*stat-util\.h.*删除.*statx|patch.*去掉.*statx_is_set
forbid_2_reason:        删功能治标不治本；补全定义是标准做法
forbid_2_consequence:   换库/换平台即失效

# ═══ Layer 4: 原则引用 ═══
principles:

