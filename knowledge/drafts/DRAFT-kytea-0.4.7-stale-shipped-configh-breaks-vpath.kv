#====================================================================
# DRAFT-kytea-0.4.7-stale-shipped-configh-breaks-vpath.kv
# tarball 预生成 config.h 陈旧时 VPATH 构建 #include <pkg/config.h>
# 仍命中源码树旧文件，须 in-source 构建让 config.status 覆盖
# 完整叙事与证据见同目录 .md
#====================================================================

id:                     DRAFT (最终编号由知识库主编确认)
trigger_tool:           configure|make|conan
phase:                  configuration|compilation
error_signature:        fatal error.*boost/tr1/unordered_map\.hpp.*file not found.*src/include/<pkg>/config\.h|
                        file not found.*错误路径位于.*srcdir.*include.*config\.h
severity:               2
category:               autotools, VPATH, generated-header, conan-layout, packaging
match_keywords:         VPATH, config.h, 预生成, 陈旧, stale config.h,
                        AC_CONFIG_HEADERS, make dist, include <pkg/config.h>,
                        top_builddir, top_srcdir, -I, autotools_layout,
                        basic_layout, in-source, boost/tr1, kytea
title:                  tarball 预生成 config.h 陈旧时 VPATH 构建 #include <pkg/config.h> 仍命中源码树旧文件，须 in-source 构建让 config.status 覆盖
root_cause:             上游 make dist 把 AC_CONFIG_HEADERS 的产物（维护者机器上
                        生成的 src/include/<pkg>/config.h，含 HAVE_BOOST_TR1_* 等
                        本机不成立的宏）一并打进 tarball。源码用带前缀形态
                        #include <pkg/config.h> 引用；VPATH 构建时
                        -I$(top_srcdir)/src/include 使该前缀查找命中源码树陈旧
                        文件，而 -I$(top_builddir)/src/include/<pkg> 只对裸名
                        <config.h> 生效，改变不了带 <pkg>/ 前缀的解析。
                        陈旧宏打开不成立的能力分支 → 拉入不存在的头 → 编译失败。
                        in-source 时 config.status 原地覆盖陈旧文件，问题不暴露。
                        与编译器/sysroot/musl 无关（判别特征：同 tarball in-source
                        构建可过）。
affected_scope:         所有"tarball 分发已生成 <pkg>/config.h 且源码带前缀
                        include"的 autotools 项目。实测：kytea 0.4.7（VPATH 失败
                        于 boost/tr1/unordered_map.hpp not found，错误路径指向
                        srcdir；in-source 全过含 47 上游用例）。
verification_cmd:       # 判别：失败时源码树陈旧头含本机不成立宏，builddir 新头干净
                        grep -n 'define HAVE_BOOST' <srcdir>/src/include/kytea/config.h
                        # VPATH 失败现场：非空；in-source 成功后：空
                        # 三态对照（同 tarball）：
                        #   mkdir b && cd b && ../configure && make  → 失败（本条）
                        #   ./configure && make && make check       → 通过
rec_priority:           1
rec_approach:           in-source-build-overwrite-stale-header
rec_description:        配方改 in-source 构建：Conan 2 用 basic_layout（默认在
                        source_folder 内 configure），不用 autotools_layout（其
                        build-folder 分离即 VPATH）；手工构建直接在解压目录
                        ./configure。config.status 会以 AC_CONFIG_HEADERS 目标
                        路径原地覆盖陈旧头，无需源码补丁。
rec_command:            # conanfile.py: layout() 用 basic_layout(self)；
                        # 手工: tar xf kytea-0.4.7.tar.gz && cd kytea-0.4.7 && ./configure --prefix=$PWD/../install && make && make check
rec_auto_fix:           false
rec_impl:               conan-layout-basic
fallback_priority:      2
fallback_approach:      vpath-with-stale-header-removal
fallback_description:   源码树不可 in-source（HMDFS 只读等 E110/E434 场景）时保留
                        VPATH，但构建前删除源码树陈旧生成头 rm <srcdir>/src/include/<pkg>/config.h，
                        并确认 Makefile 依赖不会因此触发 autoreconf（tarball 含
                        预生成 Makefile.in 时通常安全）。
fallback_command:       rm <srcdir>/src/include/<pkg>/config.h && mkdir build && cd build && ../configure && make
fallback_auto_fix:      false
fallback_impl:          manual-remove-and-vpath
forbid_1_pattern:       对此类项目套用 autotools_layout 并预期 VPATH 构建成功
forbid_1_reason:        VPATH 下带前缀 #include <pkg/config.h> 必命中源码树陈旧
                        头（-I top_builddir/<pkg> 不参与前缀解析），编译必败于
                        维护者环境残留宏
forbid_1_consequence:   误诊为编译器/依赖缺失方向（如去补 boost），修复面扩大且
                        不解决根因
forbid_2_pattern:       手改源码树陈旧 config.h（sed 清宏）而不改构建布局
forbid_2_reason:        config.status 在 VPATH 下不写源码树，手改结果可被再次
                        打包/复用且不体现"重新探测"语义；正确做法是让 configure
                        重新生成
forbid_2_consequence:   宏集合与真实探测结果脱钩，特性开关静默漂移
principles:             [P-AUTOTOOLS-001]
causes:                 []
caused_by:              []
similar_to:             [E110, E434]
conflicts_with:         []
prerequisite_of:        []
doc_file:               DRAFT-kytea-0.4.7-stale-shipped-configh-breaks-vpath.md
last_updated:           2026-09-16
source_event:           kytea 0.4.7 OHOS PC aarch64 适配（feat/kytea-0.4.7；VPATH
                        反复失败 vs 探针 in-source 成功的三态对照定位）
authors:
source_pr:              pending（feat/kytea-0.4.7 交付 PR）
source_commit:          pending（随 PR 交付后回填）
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.95
