  trigger_overlap:       true      # 触发签名相同（xmmintrin.h only x86/x64）
  solution_overlap:      partial   # 既有=NEON 补丁/分支改造；本候选=上游文档化禁用宏零补丁
  combination_novelty:   true      # 「先查文档化禁用宏，再 NEON 移植」决策序为新增差异
  boundary_novelty:      true      # 有文档化宏（零成本禁用）vs 无宏（须 NEON 移植）
