#====================================================================
# DRAFT-tinyspline-0.6.0-cmake-libdir64-cmakedeps
#====================================================================

id:                     DRAFT-tinyspline-0.6.0-cmake-libdir64-cmakedeps
library:                tinyspline
version:                0.6.0
phase:                  package|consumer-configuration|linking
trigger_tool:           conan|cmake|cmakedeps
error_signature:        Library '.*' not found in package|cmakedeps_macros\.cmake.*not found in package|
                         Library '.*' not found\.  If '.*' is a system library

severity:               2
category:               cmake, conan, packaging, libdir, ohos
match_keywords:         CMakeDeps, lib64, CMAKE_INSTALL_LIBDIR, cache_variables,
                         GNUInstallDirs, not found in package, OHOS, aarch64,
                         test_package, libdirs, tinyspline

title:                  OHOS 下 GNUInstallDirs 选 lib64 导致 CMakeDeps "Library not found in package"

root_cause:             上游 CMake 用 GNUInstallDirs，64 位平台上 CMAKE_INSTALL_LIBDIR
                         默认取 lib64，cmake.install() 装进 lib64/；Conan 默认找
                         lib/，CMakeDeps imported target 找不到库文件即报
                         "not found in package"。CMakeToolchain 的 variables 无法
                         压过 GNUInstallDirs 的 cache 默认值。

affected_scope:         OHOS aarch64（或 lib64 默认平台）上、上游 CMake 未固定
                         CMAKE_INSTALL_LIBDIR 且为库类型（package_type=library）
                         的 Conan 配方。

verification_cmd:       conan create <recipe> -pr:h=<ohos-profile> --build=missing
                         --user=ohpcd --channel=stable
                         # 主包构建 + test_package 配置/编译均通过即验证

rec_priority:           1
rec_approach:           cache-variables-force-libdir
rec_description:        generate() 中用 tc.cache_variables["CMAKE_INSTALL_LIBDIR"]
                         = "lib" 覆盖 GNUInstallDirs 默认；package_info() 的
                         cpp_info.libdirs 兜底暴露 ["lib", "lib64"]。

rec_command:            tc.cache_variables["CMAKE_INSTALL_LIBDIR"] = "lib"
                         self.cpp_info.libdirs = ["lib", "lib64"]

rec_auto_fix:           false
rec_impl:               manual-conan-package-info

fallback_priority:      2
fallback_approach:      libdirs-match-upstream
fallback_description:   若上游显式指定安装目录（自定义 install 或写死 LIBDIR），
                         不强行覆盖，按上游实际 libdir 填 cpp_info.libdirs。

fallback_command:       self.cpp_info.libdirs = ["lib64"]

fallback_auto_fix:      false
fallback_impl:          manual-conan-package-info

forbid_1_pattern:       系统同名库改动态链接|blindly set libdirs without upstream check
forbid_1_reason:        R26 静态化约束独立于本条目；libdir 设置须与上游实际安装一致，
                         否则 test_package 假通过或下游链接失败。

forbid_1_consequence:   下游 CMakeDeps 消费者仍失败，测试假通过。

similar_to:             []
doc_file:               knowledge/drafts/DRAFT-tinyspline-0.6.0-cmake-libdir64-cmakedeps.md
last_updated:           2026-09-03
source_event:           tinyspline 0.6.0 R01 适配
authors:                tianyi