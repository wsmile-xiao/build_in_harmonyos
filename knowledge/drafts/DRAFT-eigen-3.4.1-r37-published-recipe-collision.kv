#====================================================================
# Draft knowledge entry - eigen 3.4.1 same-version R37 collision
# Source package: eigen/3.4.1
#====================================================================

id:                     DRAFT-eigen-3.4.1-r37-published-recipe-collision
trigger_tool:           conan|shadow-ci|git
phase:                  preflight|ci-gate
error_signature:        version_not_incremented|already published with different recipe|R37

severity:               1
category:               conan|registry|versioning|shadow-ci
match_keywords:         eigen, R37, version_not_incremented, already published, same-version recipe, conanfile.py, conandata.yml, shadow CI
title:                  Keep already-published eigen same-version recipes unchanged unless a suffix version is required

root_cause:             The OHOS registry gate rejects a changed recipe revision for an already-published
                        package version. For eigen/3.4.1, a same-version conanfile.py edit caused L0 to fail
                        before build/test, even though the package itself is header-only.
affected_scope:         Packages whose requested version is already published remotely and whose PR only needs
                        validation, metadata, or test_package evidence rather than a recipe/source fix.
verification_cmd:       CI_PACKAGES="archives/e/eigen/3.4.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           restore-published-recipe-or-bump-suffix
rec_description:        If the published recipe can stay valid, restore conanfile.py and conandata.yml
                        byte-for-byte and keep changes to tests, notes, manifests, and knowledge evidence.
                        If a real recipe fix is needed, create a suffix version such as 3.4.1.1.
rec_command:            git diff -- archives/e/eigen/3.4.1/conanfile.py archives/e/eigen/3.4.1/conandata.yml
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      suffix-version-recipe-fix
fallback_description:   Use a new archive version only when recipe or source changes are required.
fallback_command:       mkdir archives/e/eigen/3.4.1.1
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       same-version.*conanfile.py.*published|same-version.*conandata.yml.*published
forbid_1_reason:        A changed same-version recipe revision trips R37 when the package already exists remotely.
forbid_1_consequence:   CI fails at L0 with version_not_incremented before any package validation can run.

similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-eigen-3.4.1-r37-published-recipe-collision.md
last_updated:           2026-08-28
source_event:           eigen/3.4.1 shadow CI r1 failed at R37; r2 passed after recipe restoration

authors:                codex <codex@noreply.local>
source_pr:
source_commit:          48f48aced7

metrics_success_count:  1
metrics_fail_count:     1
metrics_confidence:     0.9
metrics_last_used:      2026-08-28

