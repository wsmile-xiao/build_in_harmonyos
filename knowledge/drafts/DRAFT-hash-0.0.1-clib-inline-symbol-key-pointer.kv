#====================================================================
# DRAFT-hash-0.0.1-clib-inline-symbol-key-pointer — clib 风格单文件 C 库
#   （无库构建目标）的 OHOS 直编配方 + C99 inline 外部 T 符号实证 +
#   khash 键指针存储语义（键必须稳定内存）
# 对应人类文档: knowledge/drafts/DRAFT-hash-0.0.1-clib-inline-symbol-key-pointer.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: hash 0.0.1 适配 HarmonyOS PC（clibs/hash，Makefile 仅 test 目标）
#          既有实证: E392 覆盖 raw-makefile 管道陷阱但未覆盖符号/键语义
#====================================================================

id:                     DRAFT-hash-0.0.1-clib-inline-symbol-key-pointer
trigger_tool:           clang|make|conan|ar
phase:                  compilation|linking|testing|runtime

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               ohos, conan, build-system, compat, libc
error_signature:        FAIL: size after insert = [0-9]+, expected 100000|
                         make: \*\*\* No rule to make target|make: \*\*\* No targets
                         specified and no makefile found|
                         undefined reference to `hash_[a-z]+'|undefined symbol: hash_[a-z]+
match_keywords:         clib, khash, single-file, raw makefile, inline, T symbol,
                         llvm-nm, key pointer, strdup, hash table, no library target,
                         Makefile test target
title:                  clib 风格无库构建目标单文件 C 库的 OHOS 直编配方与 C99 inline 符号/键指针语义

# ═══ Layer 2: 诊断层 ═══
root_cause:             clib 生态包 Makefile 仅含 test/clean 目标、无库构建与
                         install 规则，配方须自行合成 clang -c + ar 直编；
                         C99 inline+头文件原型经 -std=c99 编译为外部 T 符号
                         （可链接但需实测）；khash str 键表按键指针判等，
                         复用栈缓冲键造成别名去重、size 失真
affected_scope:         clibs/khash 系单文件 C 库及其消费方测试；无库构建目标
                         的 raw-makefile 包
verification_cmd:       llvm-nm <build>/hash.o | grep ' T hash_' &&
                         conan create archives/h/hash/0.0.1 --build=missing

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           clib-direct-compile-inline-symbol-key-memory
rec_description:        配方 build() 用 Conan toolchain 直编（cc 取
                         compiler_executables 字典 .get("c")，cwd=source_folder），
                         llvm-nm 实证 T 符号；消费方/测试键必须 strdup 稳定内存
                         （绝不复用栈缓冲），结束前 free
rec_command:            cc=$(conf compiler_executables['c']); ${cc} -std=c99 -fPIC -O2
                         -c hash.c -o hash.o; ar rcs libhash.a hash.o
rec_auto_fix:           false

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:
caused_by:
similar_to:             E392, DRAFT-lbfgs-1.10-single-source-direct-compile-triage
conflicts_with:
prerequisite_of:

