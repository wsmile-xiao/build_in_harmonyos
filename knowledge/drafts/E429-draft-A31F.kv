# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool:           python
phase:                  configuration
error_signature: IndexError: list index out of range.*files.py.*member.filename = name.split|Uncompressing.*IndexError|strip_root.*IndexError

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: conan|packaging
match_keywords: strip_root, IndexError, flat zip, 扁平压缩包, commonprefix
title: Conan 2 zip strip_root 对扁平压缩包（无顶层目录）误判公共字符串前缀为根目录并 IndexError

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan 2 的 unzip strip_root 实现用 os.path.commonprefix（纯字符串前缀而非路径组件）检测根目录：扁平 zip（如 NIST tnt_126.zip，21 个 tnt*.h 直接位于压缩包根）的公共前缀 tnt 被误判为根目录，随后对不含 / 的条目执行 name.split('/', 1)[1] 直接 IndexError。tar.gz 路径实现不同，无此问题。
affected_scope: 所有源码归档为扁平 zip（无顶层目录）的配方 source()；老牌官方网站分发的 zip 常见此形态（GitHub codeload tarball 恒有根目录，不受影响）。
verification_cmd: python -c "import zipfile; n=zipfile.ZipFile('<file>.zip').namelist(); print('flat:', all('/' not in x for x in n))"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: verify-archive-layout-then-strip-root-false
rec_description: 解包前先核实归档布局（zipfile namelist / unzip -l）：无顶层目录的扁平包必须 strip_root=False；有单一顶层目录才用 True。conandata.yml 注释记录布局特征，配方 source() 内注释说明原因。
rec_command: python -c "import zipfile; n=zipfile.ZipFile('src.zip').namelist(); print(all('/' not in x for x in n))"  # True=扁平包 → 配方改 strip_root=False
rec_auto_fix:           false
rec_impl:

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: strip_root=True
forbid_1_reason: 对扁平 zip 重打包前的 True 会在解包阶段必现 IndexError（非可重试的偶发错误）
forbid_1_consequence: conan create/source 直接崩溃，浪费一轮 CI；若误改回 True 需重跑整个 W3
forbid_2_pattern: https?://(?!.*(math\.nist\.gov|github\.com|gitlab\.com)).*/.*\.zip
forbid_2_reason: 为绕过扁平静 zip 改用个人/不明源重打包的 zip 违反 R39 官方源要求
forbid_2_consequence: PF7 源URL闸拦截建 PR；镜像等价性无法证明

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
error_excerpt: File ...conan/tools/files/files.py, line 416, in unzip: member.filename = name.split("/", 1)[1] IndexError: list index out of range
evidence: |
  libtnt 1.2.6（NIST TNT，tnt_126.zip 扁平包 21 头文件）本机 conan 2.31.2 实测（2026-09-16）：
  - strip_root=True → IndexError: list index out of range at
    conan/tools/files/files.py line 416（member.filename = name.split("/", 1)[1]）；
  - strip_root=False → 21 头完整解出到目标根；
  - 误判路径：commonprefix(['tnt.h','tnt_array1d.h',...]) = 'tnt'（纯字符串前缀）→
    split('/',1)[0] 整体被当作根目录名，护栏条件 not common_folder 不触发。
kb_ref: E276
doc_file:               doc/E429.md
last_updated: 2026-09-16
source_event:           libtnt 1.2.6 前置适配（2026-09-16，分支 feat/libtnt-1.2.6）

