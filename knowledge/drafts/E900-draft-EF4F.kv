#====================================================================
# E900 草稿 — conan perl 包 pod 工具 shebang 损坏 + 系统 pod2man 版本冲突
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E900
trigger_tool:           make|perl|install
phase:                  compilation|installation
error_signature:        bad interpreter.*bin/perl|//bin/perl|doesn't match executable|PERL5LIB|Compilation failed in require at.*pod2man|Can't locate.*strict.pm.*@INC.*//lib

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               portability, perl, build-system, autotools
match_keywords:         pod2man, pod2html, shebang, perl, PERL5LIB, version mismatch, bad interpreter, //bin/perl, Config.pm, man page
title:                  Makefile 调用 pod2man 解析到错误解释器（系统 perl 版本冲突或 conan perl 包 shebang 损坏）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             'autotools Makefile 裸调 pod2man/pod2html, PATH 上系统(HNP) pod2man 与 conan perl 包 PERL5LIB 并存时 Config.pm 版本断言失败(5.42.0 vs 5.42.2), 而 conan perl 包自身的 pod 工具脚本 shebang 又是损坏的 "#!//bin/perl"（重定位缺陷）, 两条路都不通'
affected_scope:         依赖 perl 并在构建期生成 man/html 文档的 autotools 包（rsnapshot 及同类）
verification_cmd:       head -1 $(conan cache 内 perl 包 bin/pod2man)  # 观察 #!//bin/perl

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           pin-interpreter-script-in-makefile
rec_description:        构建期程序化改写 Makefile, 把 pod2man/pod2html 替换为 "<conan perl 绝对路径>" "<pod 工具脚本绝对路径>" 形式, 用解释器直接执行脚本, 绕过损坏的 shebang 与 PATH 顺序不确定性
rec_command:            content.replace("\tpod2man ", "\t\"%s\" \"%s\" " % (perl_bin, pod2man_script))  # 在 bash config.status 之后、make 之前对 Makefile 执行
rec_auto_fix:           false
rec_impl:               source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      skip-man-pages
fallback_description:   若上游支持, 用 configure/make 变量禁用 man/html 文档生成, 回避 pod 工具依赖
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       //bin/perl
forbid_1_reason:        conan perl 包 pod 工具的损坏 shebang, 直接执行必失败
forbid_1_consequence:   'make 报 "bad interpreter: No such file or directory" Error 126'
forbid_2_pattern:       export PERL5LIB.*\$\{PERL5LIB
forbid_2_reason:        禁止在系统 perl 上叠加 conan perl 的 PERL5LIB——Config.pm 版本断言会中止编译
forbid_2_consequence:   "Perl lib version (5.42.2) doesn't match executable ... version (5.42.0)"

# ═══ Layer 4: 原则引用 ═══
principles:

