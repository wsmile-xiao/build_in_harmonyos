#====================================================================
# E429-draft — 无 dummy 后端、无可链接库 API 的 GUI/音频应用在
#             OHOS 无显示沙箱的 test_package 静态验证策略
# 对应的人类文档: doc/E429.md (draft)
#
# 触发事件: zita 0.2.2（上游 zita-rev1，JACK+X11 混响器 GUI 程序）适配
#           整个 test_package 运行验证反复失败；E471/E472 已覆盖库型
#           GUI 程序（gtkmm/SDL）的无显示测试，本条目补充"纯应用"
#           （reverb 可执行文件、无 dummy 后端、无库 API 可链接）场景。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E429
trigger_tool:           conan|test_package|cmake|runtime|make
phase:                  testing
error_signature:        Error loading shared library libc\+\+_shared\.so|Error relocating.*symbol not found|output missing version banner|Can't open display|Permission denied|Error 127 while executing|Error 3 while executing

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               testing, ohos, platform, limitation, conan
match_keywords:         test_package, GUI 应用, JACK, X11, 无显示, headless, dummy 后端, libc++_shared, /system/lib64, LD_LIBRARY_PATH, ELF 静态验证, 纯 C 检查器, self.run, can_run, 无库 API, reverb, zita-rev1, kokkinizita
title:                  无 dummy 后端、无可链接库 API 的 GUI/音频应用（JACK+X11）在 OHOS 无显示沙箱的 test_package：纯 C 检查器 + ELF/版本静态断言 + 尽力运行 -h

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             zita-rev1 是 JACK+X11 GUI 混响器**应用**（无库 API 可链接，test_package
                        无法通过链接库调用验证）；OHOS CI/沙箱无显示后端、无 JACK 服务，
                        GUI 程序的完整动态依赖链（libXft/libX11/libcairo/libjack 等）加载失败
                        （"Error loading shared library"/relocating symbol not found），
                        -h 帮助路径虽在 X/JACK 连接之前，但 musl 加载器解析全部 NEEDED 失败，
                        版本横幅无法输出。与 gtkmm(SDL) 库型 GUI 不同，本场景无 dummy 后端可用、
                        无 API 可探，只能退化为静态验证 + 尽力运行。
affected_scope:         OHOS 上所有"纯应用型"GUI/音频程序（无库 API、无 dummy 后端）的
                        test_package：如 JACK 客户端、X11 工具、音频处理器。
verification_cmd:       conan create archives/z/zita/0.2.2 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --user=ohpcd --channel=stable

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           headless-application-static-checker
rec_description:        test_package 改用**纯 C 检查器**（消除 C++ libc++_shared.so 运行依赖），
                        4 项检查全部为确定性静态断言：①fopen 验证 bin/<可执行文件> 存在；
                        ②读 ELF header 验证 64 位小端 AArch64；③memmem 验证版本字面量
                        （help() 以 %s-%s 运行时拼接，二进制内嵌 PROGNAME 与 VERSION 两
                        独立字面量）；④解析 ELF PT_DYNAMIC/DT_NEEDED，逐个确认所需共享库
                        在 LD_LIBRARY_PATH 中可解析为真实文件（动态依赖链完整）。
                        用例级口径：conan test 进程 rc=0 完整通过（1/1, 100%）；4 项检查点
                        仅参考补充，不作为独立用例计数。`-h` 尽力运行仅作诊断信息打印
                        （headless 沙箱加载 GUI 依赖链失败属平台限制），不进入断言判定、
                        不影响 rc。test() 中 conanrun 注入 /system/lib64（libc++_shared.so）
                        后直接 self.run 执行检查器。
rec_command:            "test_package/ 用纯 C 检查器 + ELF/版本字面量静态断言；test() 内
                        self.run(..., env=['conanrun','zita_sysenv']) 或手动拼接
                        LD_LIBRARY_PATH 追加 /system/lib64 后执行检查器"
rec_auto_fix:           false
rec_impl:               headless-static-checker

fallback_priority:      2
fallback_approach:      static-elf-verification-only
fallback_description:   若沙箱连动态加载链也无法初始化，确保检查器对 "Error loading"
                        "Error relocating" 输出做 SKIP（打印诊断后返回 0），不做失败判定
fallback_command:       ""
fallback_auto_fix:      false
fallback_impl:          none

# ★ 禁止策略 ★
forbid_1_pattern:       只 printf 字符串的空壳 test|pass-only|stub_test_method
forbid_1_reason:        R34/PF3 要求 test_package 实质依赖被测包，禁止空壳测试
forbid_1_consequence:   被 preflight PF3 / CI L1e 拦截
forbid_2_pattern:       用 env="conanrun" 单独执行 C++ 检查器而忽略 /system/lib64
forbid_2_reason:        conanrun 环境不含 /system/lib64，检查器自身 libc++ 依赖加载失败
forbid_2_consequence:   test() 报 Error loading libc++_shared.so 反复失败

# ═══ Layer 4: 原则引用 ═══
principles:

