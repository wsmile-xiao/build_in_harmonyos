#====================================================================
# DRAFT - OHOS SDK libcxx-ohos 提供占位 <format> 头但 std::format 不可用
# contributor: pc1-52
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-enchantum-0.4.0-libcxx-ohos-format-stub
source_lib:             enchantum 0.4.0
trigger_tool:           clang++|cmake|make
phase:                  testing|compilation
error_signature:        explicit specialization of non-template struct 'formatter'|no member named 'format' in namespace 'std'|HAS_STD_FORMAT.*Failed|constraints not satisfied for class template 'formatter'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, libcxx-stdlib, testing, toolchain
prescan_pattern:        (__has_include\s*\(\s*<format>|#include\s*<format>|std::format|std::formatter)
prescan_globs:          *.cpp, *.hpp, CMakeLists.txt, *.cmake
match_keywords:         <format>, std::format, std::formatter, __has_include, libcxx-ohos, OHOS SDK, clang15, C++20, placeholder header, HAS_STD_FORMAT, double_include, std_format
title:                  OHOS SDK clang15 的 <format> 头是占位实现：__has_include 为真但 std::format/std::formatter 不可用，必须用编译探测判定

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  OHOS SDK 26.0.0.18 自带的 libcxx-ohos（clang15 标准库）提供 <format> 头文件
  （include/libcxx-ohos/include/c++/v1/format 存在），因此 __has_include(<format>)
  返回真；但该头只是占位实现，std::format / std::formatter / std::formatter<string_view>
  均未真正实现。以 __has_include 作守卫的上游代码（如 enchantum tests/double_include.cpp
  的 #if __has_include(<format>)）会误判放行，进而包含 std_format.hpp 特化
  std::formatter 编译失败，首个错误为 "explicit specialization of non-template struct
  'formatter'"。CMake 的 check_cxx_source_compiles（HAS_STD_FORMAT）能正确探测失败，
  因此上游 CMake 会按设计剔除 std_format.cpp，但无法覆盖 double_include.cpp 的
  __has_include 守卫路径。
affected_scope:         所有依赖 C++20 <format> 能力、或在 C++20 配置下编译的
                        C/C++ 库在 OHOS SDK clang15 工具链上的测试/适配
verification_cmd:       cmake -DCMAKE_CXX_STANDARD=20 -S <src> -B build && grep -n 'HAS_STD_FORMAT' build/CMakeCache.txt; clang++ -std=c++20 -fsyntax-only <src>/tests/double_include.cpp 2>&1 | head -3

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           compile-probe-not-has-include-for-format
rec_description: >
  判定 <format> 可用性必须用编译探测（CMake check_cxx_source_compiles 或
  clang++ -std=c++20 -fsyntax-only 探针），禁止仅凭 __has_include(<format>) 放行。
  库配方保持 C++17 最低版本（INTERFACE cxx_std_17），C++20 专属测试
  （std_format/double_include/concepts/single_header）由上游 CMake 的 STD<20 或
  HAS_STD_FORMAT 门自动剔除即可；本库适配无源码补丁需求。
rec_command:            cmake -S <src> -B build -DENCHANTUM_BUILD_TESTS=ON -DFETCHCONTENT_SOURCE_DIR_CATCH2=<local-catch2>; ctest --output-on-failure
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      upgrade-toolchain-for-format
fallback_description:   OHOS SDK 升级到完整实现 <format> 的 libc++（需 clang 16+/GCC 13+ 标准库）后，占位头问题消失，可正常启用 C++20 <format> 测试。
fallback_command:       等待/升级工具链后重跑 ctest --output-on-failure
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       __has_include\s*\(\s*<format>\s*\)[^|]*\|\|[[:space:]]*true