#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: conan|conan create|ci-script|pre-download
phase: configuration
error_signature: gh-proxy\.com/file://.*Forbidden|NotADirectoryError:.*predl_cache.*\.tar\.gz|Could not download from the URL https://gh-proxy.com/file:///

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, detection, packaging
match_keywords: pre-download, conandata.yml, comment URL, 注释 URL, gh-proxy.com/file, file://, NotADirectoryError, mirror fallback, 子串替换, CI 预下载
title: CI pre-download 正则扫描 conandata.yml 全文（含注释）抓 URL，子串替换把真实源码 URL 污染成 gh-proxy.com/file://…

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: ci/conan/build_and_test.sh 的 pre-download 步骤用正则 (?:^|\s)(?:url:?\s*)?["']?-?\s*(https?://[^\s"']+) 扫描 conandata.yml 全文件提取 URL，然后 content.replace(url, file://...) 逐条子串替换。若注释里也写了 http(s) URL（如 # Upstream: https://github.com/owner/repo），该 URL 会被一起下载并替换；而它又是真实源码 URL 的前缀子串时，先替换短 URL 会把长 URL 改写成 https://gh-proxy.com/file:///…，final URL 既 403 又无法解析，conan source() 抛 NotADirectoryError。
affected_scope: 所有 conandata.yml 注释里含裸 http(s) URL 的配方；CI(build_and_test.sh) 与本地 W3（finish step5）同源触发。仅注释内 URL 会造成子串污染，源码 url 本身正常时也可能失败。
verification_cmd: python3 -c "import re;raw=open('archives/<l>/<pkg>/<ver>/conandata.yml').read();print(re.findall(r'(?:^|\s)(?:url:?\s*)?[\"\x27]?-?\s*(https?://[^\s\"\x27]+)',raw,re.M))"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: remove-non-source-urls-from-comments
rec_description: conandata.yml 注释中不要写裸 http(s):// URL（改用无 scheme 的 host/path，如 github.com/owner/repo）；只保留 sources.url 一个真实 URL。命令口径：用上面的 verification_cmd 确认 extract 到的 URL 数 = 1。
rec_command: python3 -c "import re;raw=open('archives/l/p/v/conandata.yml').read();assert len(re.findall(r'https?://',raw))==1"
rec_auto_fix: true
rec_impl: comment-url-strip

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: keep-comment-url-out-of-substring
fallback_description: 若必须保留注释 URL，则确保它不是 sources.url 的子串（例如注释写完整 README 链接而非仓库根，或改写为无 scheme 形式）。
fallback_command: 
fallback_auto_fix: false
fallback_impl: manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
applicable_when: conan create/W3 在 source() 阶段报 NotADirectoryError（指向 predl_cache 下 .tar.gz 的路径）或日志出现 gh-proxy.com/file:///… 403。
counterexamples: 源码 url 本身不可达导致的普通下载失败不适用；conandata 无注释 URL 时不适用。
limitations: 本地 W3 的 mirror-fallback 会在运行期把 url 改成 [gh-proxy, 原url] 列表并可能未还原，需提交前 git checkout 还原为官方单 URL。
doc_file:               doc/E543.md
last_updated: 2026-09-14
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

draft: true
contributor_id: B1A7
