#====================================================================
# DRAFT-E999-draft-8B83 — 外部框架头依赖消除
# 来源: PR feat/error-detection-2.1.1（error-detection 2.1.1 适配 HarmonyOS PC）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E999
trigger_tool:           clang|cmake
phase:                  compilation
error_signature:        fatal error: 'aKaReZa[^']*\.h' file not found|#include "[a-zA-Z]+\.h"

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               portability, headers
match_keywords:         外部框架头, 仓库外头文件, aKaReZa.h, 内联位宏, stdint, stdbool, 头文件依赖消除
title:                  外部框架头依赖消除：公开头文件引用仓库外作者框架头（AVR/平台专用）→ 以 stdint/stdbool + 所需位宏内联补丁替代 include

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游公开头文件 #include 作者个人框架头（如 aKaReZa.h），该头不在本仓库内，且其 AVR 变体仅 AVR 可用（include <avr/io.h>），OHOS PC 无法编译
affected_scope:         上游公开头文件依赖外部框架头的纯 C/C 轻量库（头文件含 #include "author-framework.h" 且该头不在仓库、AVR/平台专用）
verification_cmd:       conan create . -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing && CC=/data/service/hnp/bin/clang READELF=/data/service/hnp/bin/readelf STRINGS=/data/service/hnp/bin/strings python3 test_ohos/run_ohos_test.py <pkg>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           inline-bit-macros-portability-patch
rec_description:        用 portability 补丁把 #include "aKaReZa.h" 替换为 <stdint.h> + <stdbool.h> + 所需位宏（bitSet/bitClear/bitCheck/bitChange/bitCheckHigh/bitShiftLeft 等，与作者 STM32 通用变体定义一致），消除对仓库外 AVR 专用框架头的依赖
rec_command:            conan create . -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing
rec_auto_fix:           false
rec_impl:               conan-recipe-patch

fallback_priority:      2
fallback_approach:      vendor-framework-header
fallback_description:   若外部框架头为纯平台无关宏集合，也可将通用变体头文件随配方 vendored 进 include/ 提供
fallback_command:       （视头文件形态选择）
fallback_auto_fix:      false
fallback_impl:          conan-recipe

principles:             P004

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

