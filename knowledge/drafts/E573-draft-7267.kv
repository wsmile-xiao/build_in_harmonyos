#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E573.kv，填写各字段
# 对应的人类文档: doc/E573.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E573
trigger_tool: test / conan test_package / ld.lld
phase: testing
error_signature: Error loading shared library libxml2\.so\.16.*needed by .*/lld|Error relocating .*/lld: xmlFreeDoc: symbol not found|消费者程序链接失败但包本身 conan create 构建通过

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: platform, portability, build-system, musl
match_keywords: libxml2.so.16, lld, xmlFreeDoc, LD_LIBRARY_PATH, conan test_package
title: conan test_package 链接消费者程序时 lld 载入 libxml2.so.16 失败（工具链 lib 目录不在 loader 路径）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 工具链 clang 驱动调用的 lld 自身动态依赖 SDK llvm/lib 下的 libxml2.so.16；conan test 阶段 runenv 只导出包目录，而 musl 在 LD_LIBRARY_PATH 命中同名但不可加载的条目时硬失败、不再回退 RPATH/默认路径，干净 worker 上链接必挂且随 worker 环境呈间歇性
affected_scope: 所有在 test_package/test() 里用 ${CC:-clang} 现场编译并链接消费者程序的 OHOS 配方（链接由 lld 完成）；本地与 CI worker 环境不一致时表现为同一提交时绿时红
verification_cmd: LD_LIBRARY_PATH="$HOME/tmp/fakexml" clang -o consumer consumer.c -lcputil 2>&1 | grep -q 'libxml2\.so\.16.*lld'   # fakexml 内放一个同名空文件即复现；把工具链 ../lib 前置后即转绿

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 测试脚本先 command -v 解析 CC 真身，把 dirname(readlink -f CC)/../lib 前置进 LD_LIBRARY_PATH；仍失败用 -fuse-ld=bfd 回退；新建二进制 chmod +x（HMDFS 不保证可执行位）；test_package 的 LD_LIBRARY_PATH/PATH 用绝对包目录拼接
rec_description: 让测试期链接不依赖调用方 shell 环境：显式把工具链库目录（含 libxml2.so.16）放到 loader 搜索路径首位，保留 GNU ld 兜底
rec_command: cc_bin="$(command -v "${CC:-clang}")"; cc_lib="$(cd "$(dirname "$(readlink -f "$cc_bin")")/../lib" && pwd)"; export LD_LIBRARY_PATH="$cc_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"   # 若仍报 libxml2 则加 -fuse-ld=bfd 重链
rec_auto_fix:           false                    # 需按包改测试脚本，不由引擎自动执行
rec_impl:               test-env-loader-path

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      改用不依赖 libxml2 的链接器：clang -fuse-ld=bfd（工具链自带 GNU ld）
fallback_description:   lld 完全无法启动时走 GNU ld，产出二进制语义等价且不引入 libxml2 依赖，测试仍真实编译并执行消费者程序
fallback_command:       clang -fuse-ld=bfd -o consumer consumer.c -lcputil
fallback_auto_fix:      false
fallback_impl:          gnu-ld-fallback

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       LD_LIBRARY_PATH=(?:\.|lib\b|:)|(?:^|:)lib(?:$|:)
forbid_1_reason:        相对条目按进程 cwd 解析、空条目等于当前目录，测试期 cwd 可能是包目录或临时目录，库解析结果随环境漂移
forbid_1_consequence:   本地绿 CI 红（或反之）的间歇性失败：同一提交重复触发 CI 结果不同，排查成本极高
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

