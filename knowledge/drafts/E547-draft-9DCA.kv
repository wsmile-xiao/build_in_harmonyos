#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E547.kv，填写各字段
# 对应的人类文档: doc/E547.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E547
trigger_tool: curl|install|test|runtime
phase: runtime|testing
error_signature: SSL certificate problem: unable to get local issuer certificate|CURLE_SSL_CACERT|curl: \(60\)

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: network, portability, libc, ohos
match_keywords: SSL, CAINFO, CAPATH, certificate, HTTPS, curl, libcurl, CA证书
title: 进程内 libcurl 默认 CAINFO 失效致全部 HTTPS 失败: 运行时 CA 库探测

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS 无 /etc/ssl 默认 CA 路径; 发行 libcurl 编译期默认 CURLOPT_CAINFO 指向不存在的路径; libcurl 在默认 CAINFO 生效时不读 SSL_CERT_FILE 与 SSL_CERT_DIR env; 应用直接调用 libcurl(不经 curl 工具层)时 CURL_CA_BUNDLE env 亦无效; 实测 curl_easy_perform 返回 60 而显式指向设备证书即 200
affected_scope: 所有直接链接 libcurl 且未显式设置 CURLOPT_CAINFO 的程序(如 clib vendored http-get); Conan 发行 libcurl 包的下游消费者
verification_cmd: 用最小程序 curl_easy_perform 访问 https 站点得 rc=60( unable to get local issuer certificate); 设置 CURLOPT_CAINFO=/storage/Users/currentUser/usr/local/ssl/cert.pem(121 证书)或 CURLOPT_CAPATH=/system/etc/security/certificates(openssl 哈希命名目录)后得 status=200

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 运行时探测 CA 库并显式 setopt: 依次探测 CURL_CA_BUNDLE 与 SSL_CERT_FILE env(文件)、常见 Linux CA 文件(/etc/ssl/certs/ca-certificates.crt 等)、SSL_CERT_DIR env 与设备证书目录(/system/etc/security/certificates, openssl 哈希命名, 目录形式); 命中文件设 CURLOPT_CAINFO、命中目录设 CURLOPT_CAPATH; 缓存探测结果; 全部失败时保留 libcurl 默认行为不静默降级; 纯 POSIX access/getenv 无平台条件编译
rec_description: 在应用的 HTTP 封装层(如 vendored http-get)统一做一次 CA 库探测并对每个 easy handle 设置 CAINFO/CAPATH, 双环境(Linux/OHOS)兼容
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: 环境级修复: 在设备标准路径预置完整 CA bundle(如 /etc/ssl/certs/ca-certificates.crt)
fallback_description: 需要设备写权限, 单包适配场景不可用时用推荐方案
fallback_command:
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: CURLOPT_SSL_VERIFYPEER, 0|curl -k|--insecure
forbid_1_reason: 关闭证书验证属不安全下载, 知识 E185 的临时方案不适用于包产物
forbid_1_consequence: 供应链安全风险: 拉取的包代码可被中间人替换
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: 

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E185
conflicts_with:         []
prerequisite_of:        []

