#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: lang-preflight|ohc-run
phase: configuration
error_signature: 语言不匹配: task=cpp, detected=[^ ]+.*env_unsupported|detected_language.*(javascript|mixed|go|rust|python)

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: detection|platform|portability
match_keywords: lang-preflight, env_unsupported, lang_hold, detected_language, webextension, javascript, R47
title: R47 语言预检判定与 lang_hold 终态上报（JS/webextension 等非 C/C++ 包模板）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 任务默认语言 cpp 与源码实际语言不匹配（manifest/manifest_version=webextension、build_system=make/zip、源码零 C/C++ 文件）。R47 冻结协议：checkout 后必须先跑 lang-preflight，不匹配立即终态 env_unsupported，平台转 lang_hold 挂起等生态（非失败），禁止硬着头皮做 C/C++ conan 适配
affected_scope: 非 C/C++ 语言三方包（JS/webextension/Go/Rust/Python 等）被按默认 cpp 语言派发的适配任务；lang_hold 挂起与 dependency_missing 必须区分
verification_cmd: python3 scripts/ohc-run.py lang-preflight <name> <ver> --src <src>; echo 0

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: lang_hold 终态上报（与 dependency_missing 区分）：result --status env_unsupported 必带 --detected-language（协议枚举，禁自由文本）+ --ev-build-system/--ev-manifest/--ev-source-stats 三项证据（各≤200字符）；dependency_missing 是缺依赖可换源解决，语言不匹配换网络/换机器无用，属平台生态挂起
rec_description: 按 R47 走 env_unsupported 终态，平台转 lang_hold；同时可产出 upstream-test-inventory + 补充 JS 单测作为生态数据
rec_command: python3 scripts/ohc-run.py lang-preflight <name> <ver> --src <src>; python3 scripts/ohc-run.py result <name> <ver> --status env_unsupported --detected-language javascript --ev-build-system 'make|zip' --ev-manifest 'manifest.json (webextension)' --ev-source-stats '零 C/C++ 文件' --failed-reason '非 C/C++ 语言，R47 转 lang_hold' --out <out>
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E543.md
last_updated: 2026-09-09
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

draft: true
contributor_id: 1145
