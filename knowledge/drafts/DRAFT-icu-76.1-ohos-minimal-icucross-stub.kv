#====================================================================
# DRAFT-icu-76.1-ohos-minimal-icucross-stub
# Minimal icucross.mk/icucross.inc stub to satisfy ICU --with-cross-build
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: icu 76.1 HarmonyOS PC 适配（PR #8988，2026-09-16 实测）
#====================================================================

id:                     DRAFT-icu-76.1-ohos-minimal-icucross-stub
trigger_tool:           configure|autotools|make
phase:                  configuration
error_signature:        Cross compiling but no --with-cross-build|--with-cross-build.*required|cross.*build.*not found|configuring ICU.*requires --with-cross-build

severity:               3
category:               autotools|ohos|cross-compiling|icu|bootstrap
match_keywords:         ICU, icucross.mk, icucross.inc, --with-cross-build,
                         cross compiling, bootstrap, icupkg, pkgdata, gentest,
                         U_IS_BIG_ENDIAN, U_HAVE_ATOMIC, cross-build stub,
                         HarmonyOS, OHOS, autotools, configure

title:                  Satisfy ICU configure --with-cross-build with a minimal icucross.mk/icucross.inc stub
root_cause: >
  ICU configure detects host != build (e.g. --host=aarch64-unknown-linux-ohos vs
  --build=x86_64-unknown-linux-gnu) and enters cross_compiling=yes. In that mode ICU
  unconditionally requires --with-cross-build pointing to an existing ICU build tree so it
  can reuse build-host tools (genccode, pkgdata, icupkg, gentest) for data generation.
  On HarmonyOS CI there is no x86_64-side real ICU build tree, and building one doubles
  the workload; without any value for --with-cross-build, configure aborts.
affected_scope: >
  All ICU versions that gate data/tool building on cross_compiling (76.x, 77, 78 share the
  same configure logic), and any other autotools library that hard-requires a
  --with-*-build pointer to a prebuilt host tree when cross compiling.
verification_cmd: >
  grep -E "Cross compiling but no --with-cross-build|configuring ICU" config.log;
  test -f <build_folder>/icu-cross-stub/config/icucross.mk;
  test -f <build_folder>/icu-cross-stub/config/icucross.inc;
  make -j1 (data packaging step must succeed: libicudata.a produced)

rec_priority:           1
rec_approach:           minimal-icucross-stub
rec_description: >
  Create a minimal stub directory in the conan build folder with
  config/icucross.mk + config/icucross.inc. icucross.mk holds only the few variables ICU
  configure reads (ICU_CROSS_BUILDROOT, U_IS_BIG_ENDIAN, U_HAVE_ATOMIC, U_HAVE_STRTOD_L,
  U_HAVE_XLOCALE_H); icucross.inc is copied from the source's own config/mh-linux plus
  GENCCODE_ASSEMBLY_TYPE = -a gcc. This satisfies configure's existence check without a
  real host build tree. For the test suites (make check / testdata), additionally copy the
  already-built tools/gentest/gentest into <stub>/tools/gentest/ so test.icu generation
  finds a runnable host tool.
rec_command: >
  mkdir -p <build_folder>/icu-cross-stub/config
  printf 'ICU_CROSS_BUILDROOT = %s\nU_IS_BIG_ENDIAN = 0\nU_HAVE_ATOMIC = 1\nU_HAVE_STRTOD_L = 0\nU_HAVE_XLOCALE_H = 0\n' <build_folder>/icu-cross-stub > <build_folder>/icu-cross-stub/config/icucross.mk
  cp <src>/config/mh-linux <build_folder>/icu-cross-stub/config/icucross.inc
  echo 'GENCCODE_ASSEMBLY_TYPE = -a gcc' >> <build_folder>/icu-cross-stub/config/icucross.inc
  cp <src>/tools/gentest/gentest <build_folder>/icu-cross-stub/tools/gentest/gentest
  ./configure --host=aarch64-unknown-linux-ohos --build=x86_64-unknown-linux-gnu --with-cross-build=<build_folder>/icu-cross-stub ...
rec_auto_fix:           true
rec_impl:               conan-recipe-build-stub

fallback_priority:      2
fallback_approach:      real-cross-build-tree
fallback_description:   若 stub 不足以通过更严格的 configure 校验（非 ICU 场景），则需在 host 侧构建一个真实的最小 ICU 树（仅 tools）供 --with-cross-build 指向；代价高，仅作为 stub 失败的兜底。
fallback_command:       在 x86_64 主机构建 icu tools 后将整树路径传给 --with-cross-build
fallback_auto_fix:      false
fallback_impl:          build-host-tools

forbid_1_pattern:       删除 --host/--build 三元组以绕过交叉检测
forbid_1_reason:        撤销交叉模式会触发 AC_RUN_IFELSE 执行 conftest，回到 E064 弹窗/SIGSEGV 路径，且丢失目标平台特性检测
forbid_1_consequence:   编译在 conftest 阶段崩溃或产生错误 config.h

principles:             P016
causes:                 []
caused_by:              []
similar_to:             [E176, DRAFT-gnustep-gui-ohos-autoconf-cross-probe]
conflicts_with:         []
prerequisite_of:        []

