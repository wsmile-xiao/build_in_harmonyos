#====================================================================
# DRAFT-ohos-shell-uname-s-win32-fallthrough.kv
# 自研 shell 构建系统的 `uname -s` 平台探测：未识别平台落 Win32 分支
# （路径 B 知识库草稿，一/二之一）
# 来源: RetroArch 1.22.2 OHOS aarch64 适配（contrib-10118，分支 feat/retroarch-1.22.2）
# 边界: E532 是 CMake 族（CMAKE_SYSTEM_NAME/elseif UNIX/WIN32/FATAL_ERROR）；
#       本条是 shell 族（configure/case `uname -s` 默认分支），trigger_tool 与
#       error_signature 均不同，属不同子族。
# 状态: 草稿（待主编审核 promote 为正式 E 条目）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-ohos-shell-uname-s-win32-fallthrough
trigger_tool:           configure
phase:                  configuration
error_signature:        Checking operating system \.\.\. Win32|
                         Error: Cannot proceed without windres\.|
                         windres.*not found|
                         case "\$PLATFORM_NAME" in|
                         OS="Win32"

# ═══ Layer 1: 识别面 (Recognition) ═══
severity:               3
category:               platform, detection, ohos, build-system, portability, shell
match_keywords:         uname -s, uname, PLATFORM_NAME, quickbuild, qb.system.sh,
                         case "$PLATFORM_NAME", Win32, windres, HarmonyOS,
                         Cannot proceed without windres, 平台识别, 平台探测,
                         configure case, shell configure, homegrown build system
title:                  自研 shell 构建系统用 `uname -s` 做平台探测、未识别值走默认分支（常为
                        Win32）→ HarmonyOS 被当成 Windows：configure 反常索要 windres 或选错
                        全套 Win32 代码路径；需把 HarmonyOS 并入 Linux 族分支
prescan_pattern:        uname\s+-s|PLATFORM_NAME=.*uname
prescan_globs:          configure, *.sh, config.*, Makefile*, *.mk

# ═══ Layer 2: 诊断面 (Diagnosis) ═══
root_cause:             OHOS 真机 `uname -s` 返回 `HarmonyOS`（内核 sysname），不在
                        自研 configure 的 `case "$PLATFORM_NAME" in` 枚举里，落到
                        `*) OS="Win32"` 一类的默认分支。随后的 Windows 专属检查
                        （windres/d3d/dinput 等）或 Win32 代码路径全部失配，configure
                        在与目标平台毫无关系的位置报错（如
                        `Error: Cannot proceed without windres.`），极易被误诊为
                        「缺工具」。HarmonyOS PC 是 Linux/musl(bionic) 用户态，
                        正确归属是 Linux 族分支。
affected_scope:         所有自带 shell 平台探测的自研构建系统（quickbuild/qb 类、
                        手写 configure、bootstrap 脚本）；实证：RetroArch 1.22.2
                        qb/qb.system.sh（contrib-10118）。
verification_cmd:       uname -s                       # -> HarmonyOS（真机）
                        # 复现：在 qb.system.sh 的 case 里无 'HarmonyOS' 分支时
                        ./configure --disable-...      # -> Checking operating system ... Win32
                        #                                    Error: Cannot proceed without windres.
                        grep -n "uname -s" qb/*.sh configure 2>/dev/null   # 定位探测点

# ═══ Layer 3: 方案空间 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           merge-harmonyos-into-linux-branch
rec_description:        把 `'HarmonyOS'` 并入既有 Linux 分支（`'Linux'|'HarmonyOS') OS='Linux';;`）。
                        补丁只动 case 一行；不引入 `__OHOS__` 平台宏（R8），后续按
                        Linux/musl 语义正常探测特性。若脚本是按前缀/glob 匹配
                        （如 `Linux*`），同理加 `HarmonyOS*`。实证：RetroArch
                        1.22.2 补丁 0001，configure→make 全量通过。
rec_command:            sed -i "s/'Linux') OS='Linux';;/'Linux'|'HarmonyOS') OS='Linux';;/" qb/qb.system.sh
rec_auto_fix:           true
rec_impl:               patch configure-case add HarmonyOS to Linux branch

fallback_priority:      2
fallback_approach:      force-os-env-override
fallback_description:   脚本支持 OS/平台环境变量覆盖时（如 qb 允许导出 OS），在配方
                        build() 里 export OS=Linux 绕过 case；不如补丁稳定（子脚本
                        可能重跑探测），仅在不可改上游时使用。
fallback_command:       export OS=Linux && ./configure ...
fallback_auto_fix:      false
fallback_impl:          env override

# ★ 禁止策略（均以实测为依据）★
forbid_1_pattern:       装 windres|安装 mingw.*工具链|apt.*install.*windres
forbid_1_reason:        `Cannot proceed without windres` 是「被当成 Win32」的结果而非
                        缺工具；HarmonyOS 目标根本不需要 windres。
forbid_1_consequence:   装错工具链方向，configure 继续在 Win32 路径上连环失败。
forbid_2_pattern:       uname -s.*等于.*Linux|改内核 sysname|篡改 uname 输出
forbid_2_reason:        系统标识不可也不应篡改；探测方归类错误才是根因。
forbid_2_consequence:   破坏平台语义，引入更深的平台误判。
forbid_3_pattern:       #ifdef __OHOS__|#if defined\(__OHOS__
forbid_3_reason:        平台归类属构建系统（shell case）层，不该用 C 源码平台宏解决（R8：
                        源码/补丁禁平台宏，应走特性探测）。
forbid_3_consequence:   违反仓库 R8 门禁，被合规检视打回（实测：AI 检视 P1）。

# ═══ Layer 4: 原则引用 ═══
principles:             R8, R34

# ═══ 关系图 (Relations) ═══
causes:                 configure 误选 Win32 全套代码路径（windres/d3d/dinput 检查连环失败）
caused_by:              OHOS sysname=HarmonyOS 未被自研 shell 探测枚举
similar_to:             E532, E007, E564
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               knowledge/drafts/DRAFT-ohos-shell-uname-s-win32-fallthrough.md
last_updated:           2026-10-08
source_event:           RetroArch 1.22.2 OHOS aarch64 conan create；
                        qb/qb.system.sh case 修复后 configure→make -j 全量通过、
                        上游 libretro-common 5 套件 127/127

