#====================================================================
# DRAFT-fusion-1.3.3-cmake-no-install-rule-manual-package - CMake 无 install 规则的小型 C 库 Conan 配方手动装配模式
#====================================================================

id:                     DRAFT-fusion-1.3.3-cmake-no-install-rule-manual-package
trigger_tool:           conan|cmake
phase:                  packaging|testing
error_signature:        fatal error: 'Fusion\.h' file not found|Packaged 0 files|install rule|cmake\.install\(\).*nothing|no install rules

severity:               2
category:               cmake|conan|packaging|c-library|static-library
match_keywords:         no install rules, manual package, copy headers, static library, .a, package(), cmake.install, includedirs, test_package, include subdir, system_libs, math library
title:                  CMake 无 install 规则的小型 C 库：package() 手动装配 include/<subdir> 头与静态库

root_cause:             部分上游 CMake 工程只提供 add_library 与 target_include_directories，
                        完全不写 install(FILES/TARGETS ...) 规则（如 xioTechnologies/Fusion：
                        CMakeLists.txt 只有 add_library + target_include_directories(PUBLIC .)）。
                        此时配方若照搬模板走 cmake.install()，package() 不产出任何文件
                        （Packaged 0 files），同时 conan-init 默认 includedirs=["include"]
                        与 test_package 的 #include <X.h> 在 G2 阶段报 fatal error: file not found。
                        与 E217（上游 install 到 include/<subdir>，仅需调整 includedirs）不同，
                        此处上游根本没有安装目标，必须手动装配。

affected_scope:         上游 CMake 仅 add_library、无 install 规则的小型 C/C++ 静态库
                        （传感器融合、单文件算法类库常见）；OHOS aarch64 + Conan 2 配包装插场景。

verification_cmd:       conan create archives/f/fusion/1.3.3 -pr:h=ci/conan/profiles/ohos-aarch64 \
                        -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing  （G2 test_package 通过）

rec_priority:           1
rec_approach:           manual-package-header-subdir
rec_description:        build() 只构建库目标（cmake.build(target=["<TargetName>"]）跳过示例；
                        package() 用 copy() 手动装配：公开头 copy 到 package_folder/include/<PROJECT_NAME>/，
                        静态库 copy 到 package_folder/lib/，LICENSE copy 到 licenses/；
                        package_info() 声明 cpp_info.libs = ["<TargetName>"]，链接数学库的库追加
                        system_libs=["m"]（UNIX）；test_package 的 include 必须用
                        #include <PROJECT_NAME/Header.h>（子目录形态），与手动装配布局一致。
rec_command:            conanfile.py: cmake.build(target=["Fusion"]); copy(self,"*.h",
                        src=os.path.join(self.source_folder,"Fusion"),
                        dst=os.path.join(self.package_folder,"include","Fusion"));
                        copy(self,"libFusion.a", src=os.path.join(self.build_folder,"Fusion"),
                        dst=os.path.join(self.package_folder,"lib"));
                        cpp_info.libs=["Fusion"]; cpp_info.system_libs=["m"]
rec_auto_fix:           false
rec_impl:               conan-recipe-manual-package

fallback_priority:      2
fallback_approach:      add-upstream-install-rules-patch
fallback_description:   若项目较大/消费者需要 CMake CONFIG 包，可给上游补 install() 规则补丁
                        （install(TARGETS X ...) + install(FILES headers DESTINATION include/X)），
                        再走标准 cmake.install()；代价是引入补丁维护，小型库不推荐。
fallback_command:       patches/ 新增 install 规则补丁后 conan create
fallback_auto_fix:      false
fallback_impl:          source-patch

forbid_1_pattern:       cmake\.install\(\)|autotools\.install\(\)
forbid_1_reason:        上游无 install 规则时调用 install() 会静默打包 0 个文件（产物缺失），
                        下游链接失败且 CI L5 产物基线不通过。
forbid_1_consequence:   G4 产物完整性 / L5 产物基线失败；包内空 include/lib。

forbid_2_pattern:       #include\s*<(Fusion|X)\.h>
forbid_2_reason:        手动装配布局是 include/<PROJECT_NAME>/ 子目录；test_package 必须写
                        #include <PROJECT_NAME/X.h>，否则 G2 找不到头。
forbid_2_consequence:   conan-verify G2 在 test_package 阶段 fatal error。

forbid_3_pattern:       print.*OK|只打印字符串
forbid_3_reason:        test_package 必须真实调用被测库公开 API（R34），L1e 破坏性反向验证会拦截空壳。
forbid_3_consequence:   L1e 负向测试失败。

principles:             P012, P014
causes:                 []
caused_by:              []
similar_to:             [E217]
conflicts_with:         []
prerequisite_of:        []

