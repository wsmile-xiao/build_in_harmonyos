#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E532.kv，填写各字段
# 对应的人类文档: doc/E532.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E532
trigger_tool: cmake
phase: configuration
error_signature: LLDB_ENABLE_POSIX.*OFF|LLDB_ENABLE_POSIX 0|CMAKE_SYSTEM_NAME MATCHES "Linux\|Android"|TCP_NODELAY.*undeclared|NativeProcessLinux::Manager.*undefined|unable to locate lldb-server

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform, detection, cmake
match_keywords: LLDB_ENABLE_POSIX, TCP_NODELAY, lldb-server, HarmonyOS, CMAKE_SYSTEM_NAME, NativeProcessLinux
title: LLDB/LLVM monorepo CMake 平台分支缺 HarmonyOS（LLDB_ENABLE_POSIX + 多插件分支）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: LLVM 17 monorepo 内多个 CMake 文件(HandleLLVMOptions/LLDBConfig/LLDBGenerateConfig/Host/Process/Initialization/lldb-server) 的平台分支仅含 Linux|Android，OHOS 工具链 CMAKE_SYSTEM_NAME=HarmonyOS 全部落空: LLDB_ENABLE_POSIX=OFF 导致 netinet/tcp.h 等 POSIX 头不包含(TCP_NODELAY 未声明), Linux/POSIX 插件目录未加入, lldb-server 未构建(NativeProcessLinux 未链入)
affected_scope:
verification_cmd:

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:
rec_approach: 将 HarmonyOS 加入全部平台分支字符串: HandleLLVMOptions.cmake elseif(FUCHSIA OR UNIX OR CMAKE_SYSTEM_NAME STREQUAL HarmonyOS), LLDBGenerateConfig if(UNIX OR HarmonyOS), Host/Process/Initialization/lldb-server CMakeLists 的 Linux|Android 匹配扩展为 Linux|Android|HarmonyOS, LLDBConfig LLDB_CAN_USE_LLDB_SERVER 加入 HarmonyOS
rec_description:        一句话描述这个推荐方案
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

