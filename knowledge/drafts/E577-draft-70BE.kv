#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E577.kv，填写各字段
# 对应的人类文档: doc/E577.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E577
trigger_tool: make|conan|pkg-config
phase: configuration|installation
error_signature: No targets specified and no makefile found|no makefile found.  Stop

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, make, build-system, linking, relocatable
match_keywords: basic_layout, build-release, build_folder, raw Makefile, abspath PREFIX, pcfiledir, soname, VERSION, libfilteraudio, SOVERSION
title: 纯 Makefile 三方库配方的三个打包陷阱：basic_layout 构建目录错位、install 替换把 .pc 前缀固化成构建目录、Makefile VERSION 决定 soname

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: ①Conan basic_layout() 默认 folders.build=build-<build_type>/，self.run 的 cwd 是该目录，纯 Makefile 项目在那里没有 Makefile；②上游 install 规则用 $(abspath $(PREFIX)) 重写 .pc 的 prefix=，PREFIX 为空时得到构建目录这一死路径；③共享库 soname 由 Makefile 的 VERSION 末段决定，按包版本覆盖 VERSION 会把 soname 从 .so.0 改成 .so.1（ABI 误声明）
affected_scope: 所有上游只有手写 Makefile（无 configure/CMakeLists/meson）的 C/C++ 库配方；libfilteraudio/0.0.1 实测
verification_cmd: conan create <pkg> -pr:h=<ohos profile> -pr:b=<ohos profile> 后再: readelf -d <pkg>/lib/libX.so | grep SONAME; PKG_CONFIG_PATH=<pkg>/lib/pkgconfig pkg-config --cflags --libs <name>; find <pkg> -name '*.pc' -exec cat {} +

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: conan-makefile-library-three-fixes
rec_description: ①layout() 用 basic_layout(self, build_folder=".")（或 self.folders.build="."）把 build 目录压回源码根，使 make 找到 Makefile；②package() 在 make install 之后用 ${pcfiledir}/../.. 重写包内 .pc（可重定位），并让 Version 反映发布版本；③不覆盖 Makefile 的 VERSION，保留上游 soname（ABI 版本），只让 .pc 的 Version 写发布版本
rec_command: basic_layout(self, build_folder="."); make install DESTDIR=${package_folder} PREFIX= LIBDIR=lib INCLUDEDIR=include; 之后以 prefix=${pcfiledir}/../.. 重写 <pkg>/lib/pkgconfig/<name>.pc
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: run-make-in-source-folder
fallback_description: 不改 layout，而是在 self.run(..., cwd=self.source_folder) 里跑 make（cd-hit 4.8.1 的做法）；.pc 与 soname 两项仍须按推荐方案处理
fallback_command: self.run("make -j1 CC=...", cwd=self.source_folder)
fallback_auto_fix: false
fallback_impl: conan-recipe

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: make.*VERSION=[0-9]
forbid_1_reason: 在命令行覆盖上游 Makefile 的 VERSION 会改变由 VERSION 末段派生的 soname（libX.so.0 → libX.so.1），属 ABI 误声明；发布版本号只应写进包内 .pc 的 Version（以及 manifest/PR 文本）。
forbid_1_consequence: 产物 SONAME/下游 DT_NEEDED 与上游及发行版打包不一致，运行期按 soname 加载失败，L5/PIE 类产物门禁与预期不符。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P010

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: [DRAFT-cd-hit-4.8.1-make-conan-recipe, DRAFT-libharu-2.3.0-missing-dt-soname]
conflicts_with:         []
