#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E554.kv，填写各字段
# 对应的人类文档: doc/E554.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E554
trigger_tool: clang|test|runtime
phase: testing
error_signature: ftz_output_flush|daz_input_flush|flush-to-zero|_MM_FLUSH_ZERO

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: compiler-optimization,testing,platform
match_keywords: FPCR, FZ, DAZ, FTZ, constant folding, denormal, flush to zero, clang, O2, SIMD, NEON
title: clang -O2 常量折叠使 FPCR.FZ 运行时控制对已折叠常量失效（FTZ/DAZ 测试）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: clang -O2 在编译期将 FLT_MIN*0.5 等浮点常量表达式折叠为次正规常量，运行时 FPCR.FZ/DAZ 位对已折叠常量无作用；裸 asm 置 FPCR.FZ 后标量与 NEON vmul 实测均正常 flush（平台 FZ 有效），故非平台缺陷而是优化×运行时控制交互
affected_scope: 依赖运行时 CSR（FZ/DAZ/舍入模式）控制的 SIMD/数值库上游测试及业务代码（aarch64 + clang）
verification_cmd: clang++ -O0 与 -O2 分别编译同一 FTZ 测试；-O0 全过而 -O2 失败即命中；裸 asm msr FPCR bit24 后运行时输入 fmul 应返回 0

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 诊断：分别以 -O0 与 -O2 编译同一 FTZ 测试对比；验证平台 FZ：裸 asm mrs/msr FPCR 置 bit24 后运行时输入 fmul 应返回 0。处置：此类上游测试如实记录优化敏感性，-O0 下全过即平台能力达标；业务代码依赖运行时 CSR 控制时注意编译器常量折叠会绕过
rec_description: 以 -O0 对照复验运行时 CSR 控制类测试；平台 FZ 经裸 asm 实证有效；失败如实记录为优化敏感性而非平台缺陷
rec_command: clang++ -O0 -I. -march=armv8-a+fp+simd tests/ieee754.cpp tests/common.cpp tests/binding.cpp -lm -o /tmp/ieee754-O0
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: 若 -O0 仍失败，才考虑上游/平台限制路径：记录首个错误、命令、退出码与恢复条件
fallback_description: 仅当优化对照无法解释失败时使用
fallback_command:
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

