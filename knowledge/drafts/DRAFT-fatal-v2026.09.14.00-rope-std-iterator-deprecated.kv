#====================================================================
# DRAFT-fatal-v2026.09.14.00-rope-std-iterator-deprecated
# std::iterator (deprecated in C++17, marked deprecated by libc++ under -Werror)
# 触发事件: fatal v2026.09.14.00 鸿蒙 PC 适配（facebook/fatal, tag v2026.09.14.00）
# 路径: Path B（知识库扩展）
#====================================================================

id:                     DRAFT-fatal-v2026.09.14.00-rope-std-iterator-deprecated
trigger_tool:           clang|conan
phase:                  compilation|testing
error_signature:        is deprecated \[-Werror,-Wdeprecated-declarations\]|has been explicitly marked deprecated here|_LIBCPP_DEPRECATED_IN_CXX17 iterator|public std::iterator<

severity:               2
category:               ohos, toolchain, libc, c++, compiler, warnings, headers, compilation

prescan_pattern:        \bstd::iterator\s*<|public\s+std::iterator\b|_LIBCPP_DEPRECATED_IN_CXX17\s+iterator
prescan_globs:          *.h, *.hpp, *.hh, *.hxx, *.cpp, *.cc, *.cxx, *.ipp, *.tcc
match_keywords:         std::iterator, deprecated, _LIBCPP_DEPRECATED_IN_CXX17, -Werror, -Wdeprecated-declarations, iterator_category, value_type, difference_type, pointer, reference, rope.h, fatal, header-only
title:                  std::iterator C++17 弃用（libc++ 标 deprecated）打断 header-only 库的 -Werror 构建

root_cause:             fatal/string/rope.h 的 const_iterator 继承 std::iterator<...>，而 std::iterator 自 C++17 起弃用，libc++ 将其展开为 _LIBCPP_DEPRECATED_IN_CXX17 → __attribute__((deprecated))。上游 harness 带 -Wall -Werror -Wextra，弃用告警被升级为硬错误，rope_test.cpp 整个 TU 无法编译（47 个用例全部无法执行）。rope.h 是安装头文件，消费者以 -Werror 使用时同样失败。
affected_scope:         OHOS（clang + libcxx-ohos）或任何 C++17 以上、以 -Werror 构建的工程中，把 std::iterator 作为自定义迭代器基类的库头文件/测试 TU；fatal/v2026.09.14.00 实测受影响。
verification_cmd:       打补丁后 clang++ -Wall -Werror -Wextra -O0 -g -pthread -ftemplate-depth-1024 -std=c++17 -I . fatal/string/test/rope_test.cpp 应编译成功且输出 "succeeded: passed 47/47"；消费者侧 static_assert(std::is_same<std::iterator_traits<const_iterator>::iterator_category, std::bidirectional_iterator_tag>::value) 应成立。

rec_priority:           1
rec_approach:           replace-base-class-with-explicit-typedefs
rec_description:        移除 std::iterator 基类，改为语义等价的 5 个显式成员 typedef（iterator_category/value_type/difference_type/pointer/reference，其中 pointer=value_type*、reference=value_type&）；类内自引用须限定外层类名（rope::value_type）。
rec_command:            struct const_iterator {\n  using iterator_category = std::bidirectional_iterator_tag;\n  using value_type = rope::value_type;\n  using difference_type = rope::difference_type;\n  using pointer = rope::value_type *;\n  using reference = rope::value_type &;\n
rec_auto_fix:           false
rec_impl:               upstream-header-patch

fallback_priority:      2
fallback_approach:      keep-base-but-silence-in-consumer
fallback_description:   仅在消费者侧用 -Wno-deprecated-declarations 屏蔽——只适用于无法改上游头文件的场景，且不允许用于上游 harness（会与上游编译参数不一致），也不解决消费者 -Werror 构建问题。
fallback_command:       clang++ -Wno-deprecated-declarations ...
fallback_auto_fix:      false
fallback_impl:          consumer-flags

forbid_1_pattern:       (-Wno-error|-w\b|remove .*-Werror|CXXFLAGS=.*-Wno-deprecated)
forbid_1_reason:        上游 harness 的 -Wall -Werror -Wextra 是质量基线；放宽告警级别是掩盖问题，且使验证与上游不一致。
forbid_1_consequence:   编译参数与上游不一致，rule 4 验证结论不可信。

forbid_2_pattern:       ^\s*//\s*FATAL_TEST\(|#if 0[\s\S]*FATAL_TEST
forbid_2_reason:        禁止注释/删除整个 FATAL_TEST 用例来消除编译错误——会减少上游用例数。
forbid_2_consequence:   上游用例数下降，触发测试减少判定。

principles:             P005, P007
causes:                 []
caused_by:              []
similar_to:             [DRAFT-fatal-v2026.09.14.00-libcxx-tuple-element-static-assert, E198, E063]
conflicts_with:         []
prerequisite_of:        []

