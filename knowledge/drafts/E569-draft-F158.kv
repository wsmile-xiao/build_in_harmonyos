#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E569.kv，填写各字段
# 对应的人类文档: doc/E569.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E569
trigger_tool: python|conan|test
phase: testing
error_signature: RecursionError|File name too long|Errno 36|copytree.*build-release|Recursion|maximum recursion depth

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: build-system,conan,portability,test-framework
match_keywords: conan,basic_layout,build_folder,source_folder,copytree,shutil,RecursionError,self-recursion,build-release,自递归
title: conan basic_layout() 的 build_folder 落在 source_folder 之内，构建期 copytree 复制源码到 build 目录会自递归卡死

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: conan 2.x 的 basic_layout() 默认把 build_folder 设为 <source_folder>/build-release，即 build 目录位于源码目录之内；构建脚本若用 shutil.copytree(source_folder, build_folder/...) 复制一份源码再编译/测试，就会把已复制的内容再次复制进自身，形成无限递归（实测 CPU 100%、卡死数分钟，或 RecursionError/File name too long）
affected_scope: 所有使用 conan basic_layout() 且 build() 里想把源码复制到构建目录再操作的纯脚本型/无编译配方；autotools/cmake 因 in-source-out-of-source 约定通常不触发，但自研 python/shell 构建逻辑易踩
verification_cmd: python3 -c "from conans.model.layout import *;"  # 检查 basic_layout 下 build_folder 是否在 source_folder 内；或观察构建卡死时 build 目录内嵌套 build-release/build-release/...

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: run-tests-in-place-no-copy
rec_description: 不要复制源码：直接在 source_folder 内就地运行（cwd=self.source_folder），或把工作目录显式设为 build_folder 下的独立子目录而非复制整个 source_folder；若必须复制，排除 build 目录自身（ignore=shutil.ignore_patterns('build*')）
rec_command: proc = subprocess.run(cmd, cwd=self.source_folder, env=env)  # 就地运行，不 copytree
rec_auto_fix: false
rec_impl: conan-recipe-inplace-test

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: copytree-with-ignore
fallback_description: 确需独立副本时，用 shutil.copytree(ignore=...) 显式排除 build_folder（及其它 conan 生成目录），避免把自身纳入复制源
fallback_command:
fallback_auto_fix: false
fallback_impl: copytree-ignore-builddir

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

