#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: meson|pkg-config|clang
phase: compilation
error_signature: no member named 'join' in namespace 'fmt'|fmt::join

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: conan,meson,headers,build-system
match_keywords: fmt::join,fmt/ranges.h,spdlog/fmt/ranges.h,include/spdlog,PkgConfigDeps,cpp_info.includedirs
title: PkgConfigDeps 将依赖包嵌套 include 目录加入 -I，导致同名转发头遮蔽真实公共头

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 依赖配方同时导出 include 与 include/spdlog；PkgConfigDeps 原样生成两个 -I，后者在 fmt 的 include 根之前解析 <fmt/ranges.h> 为 spdlog/fmt/ranges.h，其外部 fmt 转发再次自包含并被 pragma once 截断，真实 fmt/ranges.h 从未加载
affected_scope: Conan 2 PkgConfigDeps + Meson 消费同时导出公共 include 根和可形成同名前缀的嵌套 include 目录的 C/C++ 依赖
verification_cmd: 检查 compile_commands.json 的 -I 顺序并用 clang++ -E 确认 fmt::join 声明是否出现；收窄 cpp_info.includedirs 后 conan create

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: normalize-dependency-include-roots-before-pkgconfigdeps
rec_description: 消费方 generate() 在 PkgConfigDeps.generate() 前将相关依赖 cpp_info.includedirs 收窄为真实公共 include 根，再重新配置并编译
rec_command: 在 generate() 中先把 self.dependencies["spdlog"].cpp_info.includedirs 收窄为 [<package_folder>/include]，再调用 PkgConfigDeps(self).generate()
rec_auto_fix: false
rec_impl:

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: fix-producer-cpp-info-export
fallback_description: 若可维护依赖包配方，从生产方 package_info() 删除无必要的 include/spdlog、include/fmt 等嵌套 include 导出，从根源修复所有消费者；软件 PR 不应跨目录修改依赖包时使用消费方收窄方案
fallback_command: 修改依赖配方 cpp_info.includedirs 后重新发布修订版本，并用真实消费者验证生成的 .pc Cflags
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 修改上游源码移除 fmt::join|硬编码 Conan 缓存哈希路径|-I.*fmt.*强行抢顺序
forbid_1_reason: 源码本身已正确包含 <fmt/ranges.h>；问题来自生成的依赖元数据和 -I 搜索顺序，源码补丁或缓存绝对路径只会掩盖根因
forbid_1_consequence: 换 worker、依赖 revision 或 include 顺序后再次失败，且补丁无法向上游解释
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:              P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             [E133, E217, E348]
conflicts_with:         []
prerequisite_of:        []

