#====================================================================
# E257 draft - HarmonyOS poll and epoll early-close capability mismatch
# Proposed document: drafts/E257-draft-2301.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E257
trigger_tool: test|runtime
phase: testing|runtime
error_signature: test-closed__|regress__|simpleclose_close|simpleclose_shutdown|EV_FEATURE_EARLY_CLOSE

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签 (自由文本, 用于分组过滤)
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: runtime|poll|epoll|socket|ohos
match_keywords: POLLRDHUP, EPOLLRDHUP, EV_FEATURE_EARLY_CLOSE, poll, epoll, simpleclose, HarmonyOS, OHOS
title: Gate unsupported RDHUP early-close advertisement on HarmonyOS poll and epoll

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: HarmonyOS headers define POLLRDHUP and EPOLLRDHUP, while libevent derives the poll feature and hard-codes the epoll feature; the tested native backends do not deliver the corresponding half-close semantics.
affected_scope: Projects that infer poll or epoll early-close capability from RDHUP constants while running natively on HarmonyOS.
verification_cmd: Run the official test-closed and regress suites with both POLL and EPOLL, then verify EV_FEATURE_EARLY_CLOSE is not advertised and all simpleclose cases pass.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: ohos-rdhup-capability-gate
rec_description: Under __OHOS__, define the poll and epoll RDHUP feature values as zero and use the derived value in each backend feature table.
rec_command: Patch poll.c and epoll.c under __OHOS__ guards, rebuild from the official archive, and rerun targeted plus complete native suites.
rec_auto_fix: false
rec_impl: source-patch-platform-guard

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      runtime-capability-probe
fallback_description:  When a generic platform guard is not acceptable upstream, enable each backend independently only after a target-native probe proves its half-close event.
fallback_command:       Add and run backend-specific native socketpair half-close probes before defining either capability.
fallback_auto_fix:      false
fallback_impl:          upstream-capability-probe

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: enable.*EV_FEATURE_EARLY_CLOSE.*(POLL|EPOLL)RDHUP|skip.*simpleclose|modify.*regress.*expected
forbid_1_reason: Header constants do not prove that the native poll or epoll implementation emits the event, and changing simpleclose expectations hides the platform capability mismatch.
forbid_1_consequence: Applications observe a false backend feature contract and half-close tests remain unreliable.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P004,P005,P015

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

