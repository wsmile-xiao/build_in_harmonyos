id: DRAFT-ohos-mimick-elf-relro-emutls
severity: 2
category: linker|runtime|compiler|ohos
trigger_tool: clang|cmake|elf|mprotect|conan
phase: configure|build|test|runtime
approach: probe-elf-relocations-and-preserve-relro
keywords: OHOS, AArch64, ELF, DT_GNU_HASH, GLOB_DAT, JUMP_SLOT, RELRO, emulated TLS, mprotect, malloc mock
error_signature: "could not find definitions for vital function(s): 'abort' 'vfprintf'; segmentation fault while writing GOT; recursive malloc mock"
match_keywords: "ElfW(Addr),DT_GNU_HASH,DT_RELA,R_AARCH64_GLOB_DAT,R_AARCH64_JUMP_SLOT,PROT_READ|PROT_WRITE,-fno-emulated-tls"
title: Preserve OHOS AArch64 ELF interceptor correctness across GNU hash, RELRO, relocation slots, and TLS
root_cause: "OHOS AArch64 ELF loaders and clang runtime differ from the assumptions in older dynamic-interception code: GNU hash may replace SysV hash, RELRO protects GOT pages, function addresses can use GLOB_DAT instead of JUMP_SLOT, and emulated TLS can re-enter a mocked allocator."
affected_scope: "C/C++ ELF interposition or mocking libraries that inspect dynamic symbols, patch GOT/PLT slots, or use allocator-sensitive thread-local state on OHOS AArch64."
verification_cmd: "clang -target aarch64-linux-ohos -fPIC probe.c; cmake -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_C_FLAGS=-fno-emulated-tls; ctest --test-dir build --output-on-failure"
rec_priority: 1
rec_approach: "probe GNU/SysV hash and both AArch64 relocation slot kinds, write only the target RELRO page temporarily, and disable emulated TLS only for the affected AArch64 Clang build"
rec_description: "Keep SysV lookup with a uint32_t GNU-hash fallback, collect GLOB_DAT together with JUMP_SLOT, temporarily mprotect only the GOT page and restore read-only protection, then verify the real mock/reset and allocator paths."
rec_command: "readelf -dW app; readelf -rW app; clang -fPIC -fno-emulated-tls ...; ctest --test-dir build --output-on-failure"
rec_auto_fix: false
forbid_1_pattern: "-Wl,-z,norelro|disable.*RELRO|PROT_READ.*PROT_WRITE.*entire"
forbid_1_reason: "Removing or permanently weakening RELRO hides the loader/runtime boundary and changes the security property of the executable."
forbid_1_consequence: "A mock may pass locally while the package no longer represents the target OHOS runtime or leaves writable GOT pages."
forbid_2_pattern: "fake.*abort|dummy.*vfprintf|fake.*imgui|skip.*mock|BUILD_TESTS=OFF"
forbid_2_reason: "Fake vital symbols or skipped tests do not validate the dynamic lookup, relocation, TLS, and reset paths that are being adapted."
forbid_2_consequence: "Initialization or allocator recursion failures remain hidden and the result cannot be reused by other ELF interceptor libraries."
fallback_priority: 2
fallback_approach: "stop with a runtime/platform analysis when public behavior still requires unavailable loader features"
fallback_description: "Retain compiler, loader, relocation, memory-protection, and test logs; do not report success from a compile-only or dummy-symbol workaround."
fallback_command: "record readelf -dW/-rW output, exact target compiler flags, original crash location, and real test counts"
fallback_auto_fix: false
