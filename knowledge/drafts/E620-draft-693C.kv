#====================================================================
# E620-draft-693C — 知识图谱条目
# CMakeDeps 生成的 Catch2 配置不把包内 lib/cmake/Catch2 加入
# CMAKE_MODULE_PATH（且 Catch2-Target-release.cmake 用空的
# catch2_BUILD_DIRS_RELEASE 覆盖该变量），上游 include(Catch) 失败
# 触发事件: j4-dmenu 3.2 HarmonyOS PC 适配
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E620
trigger_tool:           conan|conan create|cmake|catch2|ctest
phase:                  configuration
error_signature:        include could not find requested file:.*Catch|include could not find requested file: Catch|Unknown CMake command "catch_discover_tests"|catch_discover_tests.*Unknown CMake command

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               conan, cmake, testing, dependency, packaging
match_keywords:         include(Catch), Catch.cmake, catch_discover_tests, CMAKE_MODULE_PATH, catch2_BUILD_DIRS_RELEASE, CMakeDeps, Catch2Config.cmake, find_package(Catch2), Catch2::Catch2, Unknown CMake command, include could not find requested file
title:                  CMakeDeps 生成的 Catch2 配置未把包内 lib/cmake/Catch2 加入 CMAKE_MODULE_PATH，上游 include(Catch) 报 include could not find requested file: Catch

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             >
  ohpcd 的 catch2 包把 CTest 集成模块随框架一起安装到
  <包目录>/lib/cmake/Catch2/（含 Catch.cmake 与 CatchAddTests.cmake），文件确实存在；
  但 CMakeDeps 生成的 Catch2Config.cmake 没有把该目录追加到 CMAKE_MODULE_PATH，
  而上游 CMakeLists 依赖 `include(Catch)` 按模块搜索路径查找。更隐蔽的是
  Catch2-Target-release.cmake 里 `set(CMAKE_MODULE_PATH ...)` 用的是
  针对库为***空***的 catch2_BUILD_DIRS_RELEASE，等于把 CMAKE_MODULE_PATH
  清空覆盖，连 conan 预置的路径也一并抹掉。结果 find_package(Catch2) 能命中
  Catch2::Catch2 目标，紧接着的 include(Catch) 却报
  "include could not find requested file: Catch"，随后
  catch_discover_tests 报 'Unknown CMake command "catch_discover_tests"'。
  这是"目标可用但模块搜索路径缺失"的配置期失败，不是库源码缺陷，
  也不是包内模块缺失（与 E-ctpg 系列"包内根本不含模块"不同族）。
affected_scope:         所有用 find_package(Catch2 ...) + include(Catch) + catch_discover_tests
                        注册用例、且经 Conan 2.x（CMakeDeps/CMakeToolchain）落地的 C++ 库；
                        不限版本，只要 Catch2 的 CTest 模块装在包内而非 CMake 系统模块路径即命中
verification_cmd:       find "$(conan cache path catch2/3.16.0)" -name 'Catch.cmake' — 确认模块在包内；
                        且 grep -n CMAKE_MODULE_PATH "$(conan cache path catch2/3.16.0)"/lib/cmake/Catch2/Catch2-Target-release.cmake
                        可见其用 catch2_BUILD_DIRS_RELEASE 覆盖该变量

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           cmake-module-path-override-in-generate
rec_description:        在配方 generate() 中把 <catch2包目录>/lib/cmake/Catch2 显式写入 CMakeToolchain 的 CMAKE_MODULE_PATH 变量（用绝对路径、正斜杠）
rec_command:            tc.variables["CMAKE_MODULE_PATH"] = os.path.join(self.dependencies["catch2"].package_folder, "lib", "cmake", "Catch2").replace("\\", "/")
rec_auto_fix:           false
rec_impl:               cmake-module-path-override-in-generate

fallback_priority:      2
fallback_approach:      cmakedeps-module-path-cache-injection
fallback_description:   若不便改 generate()，可在上游 CMakeLists 前经 toolchain 注入
                        `list(APPEND CMAKE_MODULE_PATH "<包目录>/lib/cmake/Catch2")`，
                        或改用 CMakeDeps 的 builddirs 传播；均需绝对路径，不可依赖相对路径
fallback_command:       tc.cache_variables["CMAKE_MODULE_PATH"] = "<catch2包目录>/lib/cmake/Catch2"
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       .*Catch\.cmake.*(copy|cp|wget|curl|download)
forbid_1_reason:        模块本来就在 catch2 包内，从网络下载或手写一份 Catch.cmake 会掩盖真实的路径接线问题，
                        并在 catch2 版本升级时静默失配
forbid_1_consequence:   接线错误被伪造模块掩盖，CI 在 catch2 升级后出现难以定位的 ctest 注册行为漂移

# ═══ Layer 4: 原则引用 ═══
principles:

