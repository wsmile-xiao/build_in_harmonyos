#====================================================================
# DRAFT-kakasi-2.3.6-make-check-hmdfs-sh-exit77
# 触发事件: kakasi 2.3.6 HarmonyOS PC shadow CI
# 主从明确: HMDFS 不给 make check 的 TESTS 脚本执行权限（./test Permission
#           denied），改 sh 显式调用后，手动循环 `|| exit 1` 又把 skip(77)
#           当失败；循环须只把「非 0 且非 77」当失败
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-kakasi-2.3.6-make-check-hmdfs-sh-exit77
source_lib:             kakasi 2.3.6
trigger_tool:           make|test|sh
phase:                  testing
error_signature:        ./kakasi-.*: Permission denied|
                        FAIL: kakasi-|7 of 7 tests failed|
                        not GNU echo|not GNU od

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               testing, hmdfs, autotools
match_keywords:         make check, TESTS, Permission denied, check-TESTS,
                        exit 77, SKIP, sh prefix, GNU echo, GNU od, HMDFS
title:                  automake make check 的 TESTS 脚本在 HMDFS 上无执行权限，sh 循环须容忍 skip(77)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  两层原因：(1) HMDFS 不给脚本执行权限（E087），automake 的 check-TESTS 直接
  ./kakasi-N 就 Permission denied；(2) 改用 sh ./kakasi-N 后，若循环写成
  `sh ./test || exit 1`，会把 automake 的 SKIP 约定（退出码 77，如无 GNU 工具、
  上游 disabled）误判为失败，导致整个测试循环 exit 1。
affected_scope: >
  autotools/automake 的 make check（TESTS 驱动 shell 脚本）在 HMDFS 上；
  测试脚本带 skip 语义（exit 77）或上游 disabled 用 77/0 占位时。
verification_cmd: >
  sh ./kakasi-4; echo $?    # 期望 77 而非 1（确认 skip 语义）

# ═══ Layer 3: 方案层 (Solution) ═══
rec_priority:           1
rec_approach:           sh-prefix-tolerate-exit77
rec_description: >
  用 sh 显式调用 TESTS 脚本（绕过 HMDFS 无执行权限），并在循环里只把
  「非 0 且非 77」当失败：0=PASS、77=SKIP、其他=FAIL。
rec_command: >
  for t in TESTS...; do sh ./$t; rc=$?; [ $rc -eq 0 ] || [ $rc -eq 77 ] || exit 1; done
rec_auto_fix:           false
rec_impl:               manual-test-loop-exit77

forbid_1_pattern:       把 skip(77) 的测试申报为通过(PASS)
forbid_1_reason:        跳过与通过语义不同，混报会虚增通过数
forbid_1_consequence:   测试证据失真，后续适配者重复误判库的能力

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             [E087]
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
