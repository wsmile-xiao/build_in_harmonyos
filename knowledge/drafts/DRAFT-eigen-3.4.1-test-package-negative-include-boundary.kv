#====================================================================
# Draft knowledge entry - eigen destructive include-path boundary
# Source package: eigen/3.4.1
#====================================================================

id:                     DRAFT-eigen-3.4.1-test-package-negative-include-boundary
trigger_tool:           conan|cmake|shadow-ci
phase:                  packaging|testing|ci-gate
error_signature:        negative include-path test|false-green|source tree headers|packaged include path

severity:               2
category:               conan|test-package|negative-test|consumer-boundary
match_keywords:         eigen, destructive negative test, include path removal, source-tree accidental success, consumer validation
title:                  Eigen consumer tests should prove the packaged include path is required

root_cause:             A positive consumer build can accidentally succeed if headers are still visible from the source tree or
                        another host include path. Without a negative probe, the package dependency boundary is unproven.
affected_scope:         Header-only consumer test_packages that compile against installed headers.
verification_cmd:       CI_PACKAGES="archives/e/eigen/3.4.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           positive-smoke-plus-negative-probe
rec_description:        Keep a normal consumer smoke test, then remove the packaged include path and expect the build to fail.
                        Use that failure as evidence that the package surface is really being exercised.
rec_command:            conan create archives/e/eigen/3.4.1 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
rec_auto_fix:           false
rec_impl:               test-package

fallback_priority:      2
fallback_approach:      runtime-only-boundary
fallback_description:   If the negative probe cannot run on the current worker, keep the boundary documented and request a
                        recheck on a worker that can execute the consumer binary.
fallback_command:       rg -n "remove.*include|destructive" archives/e/eigen/3.4.1/test_package
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       test_package.*pass.*without negative test|source tree headers
forbid_1_reason:        The consumer can only be trusted if the packaged include path is proven necessary.
forbid_1_consequence:   False-green package validation can slip through review.

similar_to:             [E035,E307,E309]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-eigen-3.4.1-test-package-negative-include-boundary.md
last_updated:           2026-08-28
source_event:           eigen/3.4.1 shadow CI r2 destructive negative include-path check

authors:                codex <codex@noreply.local>
source_pr:
source_commit:          48f48aced7

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.83
metrics_last_used:      2026-08-28

