#====================================================================
# DRAFT-ohos-glib-sub-pc-merge-vars — Conan PkgConfigDeps 生成的
#   glib-2.0.pc 缺 datadir/glib_mkenums 等变量（gio-2.0 Requires 链与
#   gnome.mkenums_simple 需要），从 glib 包原始 .pc 合并缺失变量行
# 对应人类文档: knowledge/drafts/DRAFT-ohos-glib-sub-pc-merge-vars.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR polkit/127 适配 HarmonyOS PC（meson 构建）
#====================================================================

id:                     DRAFT-ohos-glib-sub-pc-merge-vars
trigger_tool:           meson|pkg-config|configure|cc|clang
phase:                  configuration|compilation
error_signature:        Variable 'datadir' not defined in .*glib-2\.0\.pc|
                         Could not get pkg-config variable.*glib-2\.0|
                         glib_mkenums.*not defined|glib_mkenums.*pkg-config|
                         Could not generate cflags for gio-2\.0|
                         Dependency lookup for gio-2\.0.*failed

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               meson, pkg-config, glib, .pc, generators, ohos, portability
match_keywords:         glib-2.0.pc, gio-2.0, datadir, glib_mkenums, glib_genmarshal,
                         PkgConfigDeps, generators_folder, mkenums_simple,
                         Requires: glib-2.0, pkg-config variable, gobject-query
title:                  Conan PkgConfigDeps 生成的 glib-2.0.pc 缺 datadir/glib_mkenums
                         等变量时，从 glib 包原始 .pc 合并缺失变量行

# ═══ Layer 2: 诊断层 ═══
root_cause:             Conan 的 PkgConfigDeps 只从依赖包的 package_info 生成
                         glib-2.0.pc，不含 glib 包原始 .pc 里的变量行：
                         ①gio-2.0.pc 的 `Requires: glib-2.0` 在展开 cflags 时
                         需要 glib-2.0.pc 提供 datadir（gio-2.0.pc 自己
                         datadir=${prefix}/share 但 Requires 链要父 .pc 定义）
                         ——缺则 "Variable 'datadir' not defined in glib-2.0.pc"
                         ②meson 的 gnome.mkenums_simple/gobject-query 用
                         get_variable(pkgconfig:) 读 glib_mkenums/
                         glib_genmarshal/gobject_query——缺则 "Could not get
                         pkg-config variable ... <PkgConfigDependency glib-2.0>"
affected_scope:         所有用 Conan PkgConfigDeps + meson 构建、且依赖 glib
                         的软件（dconf 只补 gio-2.0.pc + 改 prefix 未踩此坑；
                         polkit 用了 gnome.mkenums_simple 才触发）；以及任何
                         .pc 的 Requires 链需要父包变量变量的场景
verification_cmd:       conan create archives/p/polkit/127 --build=missing
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 合并后 generators_folder/glib-2.0.pc 含
                         # datadir/glib_mkenums 等，meson configure 通过

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           merge-missing-pc-vars
rec_description:        在 generate() 里读 glib 包原始 lib/pkgconfig/glib-2.0.pc，
                         提取 Conan 生成版缺失的 `key=value` 变量行
                         （datadir/glib_mkenums/glib_genmarshal/gobject_query/
                         glib_valgrind_suppressions 等，排除 Name/Description/
                         Version/Libs/Cflags/Requires 头字段），合并进
                         generators_folder/glib-2.0.pc 末尾。变量值里 ${bindir}
                         在 _fix_pc_prefix 后已指向 glib 包实际路径
rec_command:            (conanfile generate() 中)
                         _merge_glib_tool_vars(self, glib_pkg)
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      source-patch-mkenums
fallback_description:   若无法注入 .pc 变量，改源码绕开 gnome.mkenums_simple
                         （手写 enum 头）或给 meson 传 glib_mkenums 全路径——
                         改动面大，不推荐
fallback_command:       (逐文件补丁)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       sed.*datadir.*glib-2\.0\.pc|硬编码.*datadir=.*/share
forbid_1_reason:        硬编码路径掩盖 .pc 变量缺失的真实原因；且 datadir 值应
                         来自 glib 包（prefix 可变）
forbid_1_consequence:   换 glib 版本/路径即失效；CI 与本地行为不一致
forbid_2_pattern:       skip.*mkenums|禁用.*enum|N/A（未运行）
forbid_2_reason:        变量合并可无损解决；绕开 mkenums 属"有可运行子集未尝试"
forbid_2_consequence:   enum 类型生成缺失，库 API 不完整；被 rule 4 打回

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             E123
conflicts_with:         []
prerequisite_of:        []

