id:                     DRAFT-jaula-1.4.0-automake-default-includes-lacks-top-srcdir
source_lib:             jaula/1.4.0
trigger_tool:           make|automake|libtool|clang|conan
phase:                  compilation
error_signature:        'fatal error: .*/<pkg>/<own-header>.h file not found（同包公开头自引用 <pkg/...>，且编译行 DEFAULT_INCLUDES 只有 -I. -I$(srcdir) -I$(top_builddir)）'
severity:               3
category:               automake, autotools, build-environment, include-path, vpath
match_keywords:         DEFAULT_INCLUDES, top_srcdir, 自引用头, 头文件找不到, VPATH, out-of-source, basic_layout, AM_CXXFLAGS, automake 1.10, in-tree 蒙对
title:                  'automake 1.10.x（本包由 1.10.1 生成）的 DEFAULT_INCLUDES 不含 $(top_srcdir)：公开头自引用 <pkg/x.h> 的老包在 VPATH 构建下必挂（in-tree 才靠 -I.. 蒙对）'
root_cause:             'automake 生成的 COMPILE 行取 -I 来源为 DEFAULT_INCLUDES + INCLUDES + AM_CPPFLAGS + CPPFLAGS(+AM_/per-target CXXFLAGS)。automake 1.10.x（本包实测由 1.10.1 生成） 在子目录 Makefile 里把 DEFAULT_INCLUDES 落成 "-I. -I$(srcdir) -I$(top_builddir)"，不含 $(top_srcdir)；而 2005-2012 年代一批包的公开头互相写成 #include <pkg/xxx.h>，只有"含 pkg/ 子目录的那一层"作 -I 才可解析。同目录(in-tree)构建时 top_builddir 恰为 .. 指向源码根，问题被掩盖；conan 的 basic_layout 走 out-of-source，top_builddir 指向构建树（其 pkg/ 子目录只有 Makefile 与 .libs），于是同一行 include 找不到。上游若未写 AM_CPPFLAGS = -I$(top_srcdir)（jaula 的 Makefile.am 甚至注明为 bug 1827161 而删掉了 AM_CPPFLAGS），任何 -I 都补不上这一层。'
affected_scope:         '所有 conan out-of-source(VPATH) 构建 + automake 1.10.x（实测本包为 1.10.1）生成 + 公开头以 <包名/头名.h> 形态自引用的包。判据（三步取证，勿凭猜）：①grep Makefile.am 是否已删/未写 AM_CPPFLAGS；②看生成 Makefile 的 DEFAULT_INCLUDES 行是否缺 $(top_srcdir)；③看失败编译行里 -I 的集合。与 libnfc 那条（上游写了 -I$(top_srcdir) 但被空 per-target *_CPPFLAGS 替换掉）签名不同：那条是"写了被顶掉"，本条是"从未写"。'
verification_cmd:       'cd <worktree> && conan create archives/j/jaula/1.4.0 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64；反证：grep "^DEFAULT_INCLUDES" <build_folder>/jaula/Makefile'
rec_priority:           1
rec_approach:           inject-src-root-via-am-cxxflags-make-command-line
rec_description:        '不改上游任何 Makefile.am/头文件，用 make 命令行变量（优先级高于 Makefile 内赋值）把源码根注入 AM_CXXFLAGS。AM_CXXFLAGS 出现在 COMPILE 行且 automake 默认未赋值，覆盖它不丢任何既有 flags，也不碰 CPPFLAGS 里来自 AutotoolsDeps 的依赖 -I。 前置判据（第 4 步取证，必须做）：grep 上游 Makefile.am/Makefile.in 是否对被覆盖变量使用 `+=` 或已有赋值——make 命令行 `var=value` 会整体作废 Makefile 内对该变量的所有 += 追加（见 经验文档/B草稿库/DRAFT-PKG-VER-make-commandline-override-kills-plus-equals）。本包取证结果：`grep -c AM_CXXFLAGS jaula/Makefile.am` = 0，且 jaula/Makefile.in 只在 CXXCOMPILE/CXXLINK 里引用 AM_CXXFLAGS、从无赋值行 ⇒ 覆盖不丢任何东西。若目标变量本身带既有值（如 CFLAGS/CPPFLAGS），必须把既有值一并重述进命令行。'
rec_command:            'autotools.make(args=["-C", "<subdir>", "-j1", "AM_CXXFLAGS=-I{}".format(self.source_folder)])'
rec_auto_fix:           false
rec_impl:               'archives/j/jaula/1.4.0/conanfile.py build() 末行；真机实测该 -I 出现在编译行，且 jaula/ 的 16 个手写 .cc + flex 生成的 jaula_lexan.cc = 17 个 TU 全部编过（examples/ 的 2 个 .cc 不构建）'
fallback_priority:      2
fallback_approach:      switch-to-in-source-layout
fallback_description:   '改 layout() 为 in-source（self.folders.source = "."; self.folders.build = "."），让 -I.. 回到源码根，与同目录构建等价。代价：源码树被产物污染、与同族 kakasi 草稿同路径（见 similar_to），且需自查 .o/.lo 不被 JC 判为垃圾。'
fallback_command:       'def layout(self):\n    self.folders.source = "."\n    self.folders.build = "."'
fallback_auto_fix:      false
fallback_impl:          '未在本包采用；参考 knowledge/drafts/DRAFT-kakasi-2.3.6-autotools-relative-includes-vpath.md'
principles:             [P003, P007]
causes:                 []
caused_by:              []
similar_to:             ['DRAFT-kakasi-2.3.6-autotools-relative-includes-vpath', 'DRAFT-10251-libnfc-tools-1.8.0-automake-per-target-cppflags-empty-override', 'DRAFT-PKG-VER-make-commandline-override-kills-plus-equals']
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-jaula-1.4.0-automake-default-includes-lacks-top-srcdir.md
last_updated:           2026-09-25
source_event:           'jaula/1.4.0 鸿蒙 PC 真机适配（hw-9，2026-09-25）：conan create 首错 jaula_bad_data_type.h:32:10: fatal error: ''jaula/jaula_exception.h'' file not found；取证 Makefile:79 DEFAULT_INCLUDES = -I. -I$(srcdir) -I$(top_builddir)；补 AM_CXXFLAGS=-I<源码根> 后 17 个 TU（jaula/ 16 个手写 .cc + flex 生成的 jaula_lexan.cc） 全编过、libjaula.a 产出、test_package 消费者测试 32/32 断言通过'
