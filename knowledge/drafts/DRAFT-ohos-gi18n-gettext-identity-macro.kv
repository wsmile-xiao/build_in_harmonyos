#====================================================================
# DRAFT-ohos-gi18n-gettext-identity-macro — OHOS libintl.h 空 stub 下
#   gi18n.h 的 gettext() 编译期未声明，用恒等宏 -Dgettext(x)=(x) 修复
# 对应人类文档: knowledge/drafts/DRAFT-ohos-gi18n-gettext-identity-macro.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR polkit/127 适配 HarmonyOS PC（authfw=shadow + gettext=false）
#====================================================================

id:                     DRAFT-ohos-gi18n-gettext-identity-macro
trigger_tool:           clang|cc|meson|make|cc|compile
phase:                  compilation
error_signature:        undeclared function 'gettext'|
                         call to undeclared function 'gettext'|
                         implicit declaration of function 'gettext'|
                         _\(String\).*gettext.*not declared|
                         gi18n\.h.*gettext

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               gettext, i18n, libintl, compilation, ohos, portability
match_keywords:         gettext, gi18n.h, libintl, libintl.h, NLS, gettext=false,
                         dgettext, undeclared function, compile-time, empty stub,
                         identity macro, _(), Q_(), glib
title:                  OHOS libintl.h 为空 stub 不声明 gettext() 时，gi18n.h 的
                         `_()` 宏编译报 undeclared——用恒等宏 -Dgettext(x)=(x) 一处修复

# ═══ Layer 2: 诊断层 ═══
root_cause:             glib 的 gi18n.h 无条件定义
                         `#define _(String) gettext (String)`（还有 Q_/C_ 用
                         g_dpgettext，N_ 是恒等）。当构建未启用 gettext
                         （meson gettext=false 不设 ENABLE_GETTEXT）时，gi18n.h
                         仍展开 gettext()——但 OHOS 的 libintl.h 是空 stub
                         （只定义 __USE_GNU_GETTEXT 宏，不声明 gettext），
                         clang 报 "undeclared function 'gettext'"（ISO C99 起
                         implicit declaration 是错误），所有含 _() 调用的 .c
                         文件全部编译失败
affected_scope:         所有在 OHOS 上、include glib/gi18n.h 且（因无翻译需求）
                         关闭 NLS 的软件：polkit（pkttyagent/pkaction/pkcheck
                         等）、以及任何 glib 生态用 _() 宏的库/工具
verification_cmd:       conan create archives/p/polkit/127 --build=missing
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 覆盖前 pkttyagent.c/pkaction.c/pkcheck.c 报
                         # undeclared function 'gettext'；覆盖后 94/94 编译链接成功

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           gettext-identity-macro
rec_description:        在编译参数加 `-Dgettext(x)=(x)` 恒等宏：让 gi18n.h 里
                         `#define _(String) gettext (String)` 展开后变恒等
                         （gettext("...") → ("...")），_() 原样返回字符串——
                         与 gettext=false 语义一致，一处修复所有 _() 调用点，
                         不改任何源码。meson 配方里用
                         MesonToolchain 的 tc.c_args.append('-Dgettext(x)=(x)')
rec_command:            (conanfile generate() 中)
                         tc.c_args.append('-Dgettext(x)=(x)')
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      source-patch-gettext-stub
fallback_description:   若编译参数注入不可行（非 meson 构建），对含 _() 调用的 .c
                         文件逐一补 `#define gettext(x) (x)` 或改 include 为
                         glib.h（不经 gi18n.h）——改动面大，不推荐
fallback_command:       (补丁逐文件，改动面大)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       LIBS?=.*-lintl|链接.*libintl\.so|只.*链接.*修复.*编译
forbid_1_reason:        E015/E027 的 -lintl 解决的是**链接期** libintl 符号缺失；
                         本问题是**编译期** gettext 未声明——链接库不解决编译错误
forbid_1_consequence:   编译仍报 undeclared；且误引链接期方案掩盖真实问题面
forbid_2_pattern:       skip.*gettext|N/A（未运行）|patch.*gi18n\.h.*define.*gettext\(x\)=\(x\)
forbid_2_reason:        恒等宏可无损解决，逐文件补丁/跳过属"有可运行子集未尝试"
forbid_2_consequence:   改动面大难维护；被 rule 4 打回

# ═══ Layer 4: 原则引用 ═══
principles:

