#====================================================================
# E3000-draft-D384.kv — EA 家族头文件在 OHOS aarch64 的平台检测缺口
#====================================================================
# 来源: eabase 0699a15（electronicarts/EABase）OHOS aarch64 适配, 2026-09-11
# 状态: 草稿（待人工审核后 promote 为正式条目）

id:                     E3000
trigger_tool: clang|cmake|make
phase: compilation
error_signature:        EA_SYSTEM_LITTLE_ENDIAN.*(undefined|未定义)|va_list_reference.*va_list|EA_PLATFORM_MIN_MALLOC_ALIGNMENT.*(8|16)|pthread_setaffinity_np.*undeclared|pthread_getaffinity_np.*undeclared|pthread_setcancelstate.*undeclared

# ═══ Layer 1: 识别层 (Recognition) ═══
severity: 2
category: compat, libc, musl, platform, header
match_keywords:         EABase, EASTL, electronicarts, va_list_reference, aarch64, ARM64, EA_SYSTEM_LITTLE_ENDIAN, EA_PLATFORM_MIN_MALLOC_ALIGNMENT, va_list, musl, OHOS, EA family, pthread_setaffinity_np, pthread_setcancelstate
title:                  EA 家族头文件（eaplatform.h/eastdarg.h）缺少 OHOS aarch64 平台检测分支

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             EA 家族头文件（EABase 的 eaplatform.h / eastdarg.h）平台检测分支未覆盖 OHOS aarch64：
                        ① eaplatform.h Linux 分支的 __aarch64__ 分支漏定义 EA_SYSTEM_LITTLE_ENDIAN；
                        ② eastdarg.h 的 va_list_reference 判定条件缺 Linux+ARM64（aarch64 va_list 是 32 字节结构体，必须用引用传递，按值传递不推进）；
                        ③ EA_PLATFORM_MIN_MALLOC_ALIGNMENT 默认取 PTR_SIZE*2=16 但 OHOS aarch64 malloc 实测最小 8 字节对齐；
                        ④ EAThread 测试框架在 OHOS sysroot（musl）缺失 pthread_setaffinity_np/pthread_getaffinity_np/pthread_setcancelstate。
affected_scope:         EA 家族（EABase/EASTL/EAStdC/EAThread/EATest/EAMain）在 OHOS aarch64 的适配；任何以 EA_PLATFORM_LINUX 分支编译 aarch64 的 EA 家族库
verification_cmd:       clang -dM -E -I include/Common <(echo '#include <EABase/eabase.h>') | grep -E 'EA_SYSTEM_LITTLE_ENDIAN'; clang++ -std=c++17 -I include/Common test_ohos/TestEABaseOHOS.cpp

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description:        在 eaplatform.h aarch64 Linux 分支补 #define EA_SYSTEM_LITTLE_ENDIAN 1；eastdarg.h va_list_reference 条件追加 (defined(EA_PLATFORM_LINUX) && defined(EA_PROCESSOR_ARM64))；EA_PLATFORM_MIN_MALLOC_ALIGNMENT 以 POSIX 风格条件 (EA_PLATFORM_LINUX && EA_PROCESSOR_ARM64) 设为 8（aarch64 Linux-family malloc 实测最小 8 字节对齐）；EAThread 测试框架以 EA_PLATFORM_LINUX/EA_PROCESSOR_ARM64 组合判定跳过 affinity/cancel 调用（aarch64 通用，不限于单一平台宏、不进交付物）
rec_command:            见 eabase 0699a15 patches/0001-include-Common-EABase-config-eaplatform.h.patch 与 0002-include-Common-EABase-eastdarg.h.patch
rec_auto_fix:           false
rec_impl:               source-patch

# ═══ 禁止策略 ═══
forbid_1_pattern:       #define EA_SYSTEM_BIG_ENDIAN.*__aarch64__|patch.*sysrq
forbid_1_reason:        aarch64 统一小端，禁止错误声明大端
forbid_1_consequence:   端序判断反转导致运行时数据解析错乱

# ═══ Layer 4: 原则引用 ═══
principles:             P001, P003, P008

