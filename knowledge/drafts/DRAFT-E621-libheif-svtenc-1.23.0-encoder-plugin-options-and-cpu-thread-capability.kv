# ═══ 元数据 ═══
verification_cmd: |
  cd "$TASK_DIR/upstream/libheif-1.23.0" && \
  grep -n 'plugin_option(' CMakeLists.txt | wc -l && \
  grep -rho 'TEST_CASE' tests/*.cc | wc -l && \
  printf '#ifdef __OHOS__\nOHOS_YES\n#endif\n#if defined(__linux__)\nLINUX_YES\n#endif\n' > "$TASK_DIR/probe/m.c" && \
  /data/service/hnp/bin/clang -E "$TASK_DIR/probe/m.c" | grep -cE 'OHOS_YES|LINUX_YES'
