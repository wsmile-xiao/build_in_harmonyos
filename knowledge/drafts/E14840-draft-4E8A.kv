#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E14840.kv，填写各字段
# 对应的人类文档: doc/E14840.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E14840
trigger_tool:           conan
phase:                  testing|runtime
error_signature:        Error in package_info\(\).*package_folder.*NoneType|expected str, bytes or os.PathLike object, not NoneType

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               3
category:               conan, python, runtime
match_keywords:         package_info, package_folder, NoneType, visible=False, no_skip, embedded Python, application dependency
title:                  私有 Python 应用依赖被 Conan 消费图跳过，嵌入式解释器库无法作为运行闭包发布

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             共享 C 库嵌入 Conan Python 时，若 Python 与另一宿主依赖的同名传递库版本冲突，可能必须将 Python 要求设为 visible=False；但 Python 包类型为 application，消费者图会跳过这个私有二进制，package_info 中读取其 package_folder 得到 None，运行时也缺 libpython。no_skip=True 保留二进制；仅保留二进制不等于导出运行环境，还须明确传递解释器和库路径。
affected_scope:         在 Conan 2 中链接 libpython、依赖 application 类型 Python 包、且 Python 的传递依赖与其他公开宿主依赖冲突的 C/C++ 共享库
verification_cmd:       对干净 Conan home 执行 conan create；确认消费者图安装 Python 二进制、package_info 不含 None 路径、上游测试全量通过且安装包消费者能初始化 Python 并加载真实模块

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           retain-private-python-runtime-closure
rec_description:        先核对公开依赖与 Python 的完整二进制版本图；只在确需隔离冲突版本且 API/ABI 完全封装时将 Python 设为 visible=False、no_skip=True，并在 package_info 导出 PYTHONHOME 与 libpython 的运行库路径；构建、测试和安装中凡调用 Python 的步骤均显式应用依赖库运行环境。
rec_command:            conan graph info <recipe> -pr:h=<ohos-profile> -pr:b=<ohos-profile> -r=ohpcd && conan create <recipe> -pr:h=<ohos-profile> -pr:b=<ohos-profile> --build=never
rec_auto_fix:           false
rec_impl:               manual-recipe-fix

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       hard-code Conan cache path|omit Python from consumer graph|override zlib without a published matching binary
forbid_1_reason:        Conan cache 路径随 worker/构建变化；盲目统一传递库会改变已发布依赖的 package ID；只下载或只链接成功不能证明消费端运行闭包完整。
forbid_1_consequence:   package_info 再次为 None、运行期找不到 libpython，或远端制品仓缺少改图后的依赖二进制
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

