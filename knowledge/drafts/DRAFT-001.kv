error_signature: "umask 077 && mktemp -d.*Permission denied.*HMDFS"
root_cause: "HMDFS file system does not support file creation inside directories created by mktemp -d (0700 permissions)."
rec_approach: "Remove umask 077 from configure and add chmod 0777 after mktemp -d."
match_keywords: ["umask 077", "mktemp", "Permission denied", "HMDFS"]
error_excerpt: "./config.status: subs1.awk: Permission denied"
severity: P1
category: platform
