#====================================================================
# DRAFT-E582 — 知识图谱条目 (草稿)
# OHOS: ld -r + objcopy --keep-global-symbols 合并对象链接产物被 exec 拒绝
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-E582
trigger_tool:           make|ld|objcopy|runtime
phase:                  linking|runtime
error_signature: Operation not permitted.*bin/base64|sh: .*Operation not permitted|ld -r.*objcopy --keep-global-symbols|exec.*EPERM.*merged object|test_base64: .*126

# ═══ Layer 1: 识别层 (Recognition) ═══
severity: 2
category: ohos, linking, build-system, makefile
match_keywords: objcopy, keep-global-symbols, ld -r, EPERM, Operation not permitted, merged object, relocatable
title: OHOS 拒绝执行经 ld -r + objcopy --keep-global-symbols 合并对象链接出的可执行文件

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: 上游 Makefile 用 $(LD) -r 合并各 codec 对象生成"合并可重定位对象"，再用
  llvm-objcopy --keep-global-symbols 剥除非导出符号（只保留 lib/exports.txt 列出的全局符号）。
  该合并对象参与最终链接产出的可执行文件被 OHOS 内核 exec 安全策略拒绝（sh 报
  "Operation not permitted"，退出码 126），而直接链接原始 .o 文件的可执行文件可正常运行；
  CMake 路径（正常 add_library，无 objcopy 合并）产出的二进制无此问题。
affected_scope: OHOS aarch64 上使用 ld -r + llvm-objcopy --keep-global-symbols
  合并模式的 Makefile 库（如 aklomp/base64 0.5.0）
verification_cmd: make && make -C test 2>&1; ./test_base64 # -> sh: Operation not permitted (126);
  cmake -DBASE64_BUILD_TESTS=ON .. && make && ctest # -> 2/2 通过; 直接链接原始 .o 的可执行文件可运行

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority: 1
rec_approach: cmake-path
rec_description: 配方优先走 CMake 构建路径（正常 add_library，无 objcopy 合并步骤），
  或直接链接原始 .o 对象；避免让 objcopy --keep-global-symbols 合并对象参与最终链接。
rec_command: cmake -DBASE64_BUILD_TESTS=ON -DBASE64_WERROR=OFF .. && make -j1 && ctest
rec_auto_fix: false
rec_impl:

# 回退方案
fallback_priority: 2
fallback_approach: raw-object-link
fallback_description: 必须用 Makefile 路径时，用手工链接原始 .o（不经 ld -r + objcopy 合并）构建测试/CLI
fallback_command:
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略
forbid_1_pattern: objcopy --keep-global-symbols
forbid_1_reason: OHOS exec 安全策略拒绝合并后对象链接出的可执行文件 (EPERM/126)
forbid_1_consequence: 测试/CLI 不可执行，本地与 CI 验证失败

# ═══ Layer 4: 原则引用 ═══
principles: P017, P019

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E077, E537]
conflicts_with:         []
prerequisite_of:        []

