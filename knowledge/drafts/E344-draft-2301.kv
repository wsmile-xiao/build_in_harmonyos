#====================================================================
# E344 draft - 老版 config.sub 的 -linux* -> linux-gnu 改写：ohos 补丁需在 -linux*) 前加 -linux-ohos*) 空 case
# 触发事件: libXres 1.2.1 HarmonyOS PC 适配（archives/l/libXres/1.2.1）
# 主从明确：与 E340/E342 互补；E340 管头文件级依赖消费，E342 管头文件自包含与
#           宏/函数区分，E344 管 config.sub/guess 的 ohos 端口（含 2018 老版的
#           -linux*) 改写陷阱）。新版本 config.sub（2021+）无此改写，两处即可。
#====================================================================

id:                     E344
trigger_tool:           configure|config.sub|config.guess
phase:                  configuration
error_signature:        machine `.*-linux' not recognized|system `ohos' not recognized|Invalid configuration `.*linux-ohos'

severity:               3
category:               ohos, x11, autotools, portability, config.sub, config.guess, cross-compile
match_keywords:         config.sub, config.guess, linux-ohos, ohos, aarch64-unknown-linux-ohos, aarch64-linux-ohos, KERNEL-OS, cross mode, --build, --host, HarmonyOS, -linux-gnu, 2018 config.sub
title:                  老版 config.sub 仍含 `-linux*) -> linux-gnu` 改写，ohos 补丁必须在该 case 之前插入 `-linux-ohos*)` 空 case，否则 canonical 三元组被错误改写为 linux-gnu

root_cause:             autoconf 对 --build/--host 三元组调用 config.sub 做 canonical 化。
                        OHOS 交叉编译必须把 triplet 写成 build=aarch64-unknown-linux-ohos、
                        host=aarch64-linux-ohos（build != host 进入 cross 模式，works-check
                        只链接不运行，避开原生模式运行 conftest 被沙箱拦截）。但 2018 版的
                        config.sub（libXres 1.2.1 自带 2018-02-22）在 OS 处理末尾仍有
                        `-linux*) os=... s|linux|linux-gnu|` 改写：仅加 `linux-ohos*` 到
                        KERNEL-OS 列表 + `-linux-ohos*` 到 OS 校验列表，os 最终仍会被改成
                        linux-gnu-ohos。2021+ 版 config.sub 已移除该改写，两处补丁即够。

affected_scope:         一切 release tarball 内置老版（约 2018 及更早）config.sub/config.guess
                        的 X.Org autotools 库（libXres 1.2.1 实证：config.sub 2018-02-22、
                        config.guess 2018-02-24）在 OHOS 交叉编译中的端口化；以及需判断
                        config.sub 版本决定补丁 hunk 数的同类库。

verification_cmd:       (patch 后) ./config.sub aarch64-unknown-linux-ohos  # -> aarch64-unknown-linux-ohos
                        ./config.sub aarch64-linux-ohos                      # -> aarch64-unknown-linux-ohos
                        ./config.sub aarch64-linux-gnu                       # -> aarch64-unknown-linux-gnu (回归)
                        CI_PACKAGES="archives/l/libXres/1.2.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           config-sub-guess-ohos-portability
rec_description:        先确认 config.sub 版本与是否含 `-linux*) -> linux-gnu` 改写。2021+ 只需：
                        KERNEL-OS 列表（maybe_os case）加 `linux-ohos*`；OS 校验列表加
                        `-linux-ohos*`（2023 版另把 `ohos*` 加入 OS 名单）。2018- 老版需
                        第三个 hunk：在 `-linux-dietlibc)` 与 `-linux*)` 之间插入空 case
                        `-linux-ohos*) ;;` 以保住 os。config.guess 在
                        `case "$UNAME_MACHINE:$UNAME_SYSTEM:$UNAME_RELEASE:$UNAME_VERSION"`（2018）
                        或 `case $UNAME_MACHINE:$UNAME_SYSTEM:...`（2021+）前插入
                        `*:HarmonyOS:*:*)` 分支 echo aarch64-unknown-linux-ohos。补丁用 unified
                        diff（a/ b/ 头），conandata 用 list 格式（L0f 要求）。
rec_command:            CI_PACKAGES="archives/l/libXres/1.2.1" zsh ci/conan/build_and_test.sh
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      same-track-base-image
fallback_description:   若上游已随新版 automake 生成新 config.sub（2021+），按新版两处/三处补丁即可；
                        老版改写的检测 `grep -n '\-linux\*)' config.sub` 决定是否需第三 hunk。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          conan-recipe

forbid_1_pattern:       -linux\*\).*s|linux|linux-gnu|.* 之上无 -linux-ohos
forbid_1_reason:        老版 config.sub 不改写保护，os=-linux-ohos 会被 sed 改成 -linux-gnu-ohos，
                        canonical 三元组失真，依赖 target 名称的分支会误判。
forbid_1_consequence:   configure 产出的 host_os 变成 linux-gnu-ohos，后续 --host 条件分支失效。
forbid_2_pattern:       conandata\.yml.*patches:.*\{.*version.*:.*\}
forbid_2_reason:        L0f 门禁要求 patches 为 list 格式（patch_file/patch_description/patch_type），
                        dict-by-version 格式被判 wrong。
forbid_2_consequence:   CI L0f 失败（实测 libXres 批次前的 libxdamage/libxkbfile 同类失败）。

principles:             P013,P014
causes:                 []
caused_by:              []
similar_to:             E338,E340,E342
conflicts_with:         []
prerequisite_of:        []

