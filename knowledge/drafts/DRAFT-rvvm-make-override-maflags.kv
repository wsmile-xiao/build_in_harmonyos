#====================================================================
# DRAFT — Makefile 用 override MAKEFLAGS 强制并行时命令行 -j1 失效
#   实例：rvvm 0.6 OHOS shadow CI（make lib all 需传 JOBS=1 才单线程）
#   最终编号由知识库主编确认（本草稿不预占正式 E 编号）
#====================================================================

id:                     DRAFT-rvvm-make-override-maflags
trigger_tool:           make|conan
phase:                  compilation
error_signature:        override MAKEFLAGS|make.*-j1.*(hang|stuck|still parallel)|make.*-j.*hang|FIFO.*Permission denied

severity:               2
category:               build-system|makefile|parallel
match_keywords:         override MAKEFLAGS, JOBS, nproc, -j1, make, 并行构建, FIFO, jobserver, OHOS, single-thread, R9
title:                  Makefile 用 override MAKEFLAGS += -j $(JOBS) 强制并行时，命令行 -j1 失效，需传并行度变量（如 JOBS=1）

root_cause:             部分 Makefile 在 Makefile 内用 override MAKEFLAGS += -j $(JOBS)（JOBS ?= nproc）强制并行；命令行传 -j1 会先进入 MAKEFLAGS，随后被 override 追加的 -j $(JOBS) 覆盖（GNU make 取最后一个 -j 生效），导致 -j1 失效、仍按 nproc 并行。OHOS 上并行会触发 FIFO jobserver 限制（E074）而卡住/失败。
affected_scope:         OHOS 上所有 Makefile 型项目，其 Makefile 用 override MAKEFLAGS 强制 -j$(JOBS) 或 JOBS ?= nproc 模式（如 RVVM 0.6）。
verification_cmd:       传 -j1 后观察构建日志是否仍并行编译；或 make -n 检查实际生效的 -j 值。

rec_priority:           1
rec_approach:           override-parallel-var
rec_description:        在 conanfile.py 的 self.run() 中传 Makefile 定义的并行度变量（如 JOBS=1）而非 -j1，使 override MAKEFLAGS += -j 1 生效单线程（满足 R9）。
rec_command:            make JOBS=1 <targets>   # 变量名视 Makefile 而定，需先读 Makefile 确认
rec_auto_fix:           false
rec_impl:               conanfile.py self.run 传 JOBS=1

fallback_priority:      2
fallback_approach:      disable-jobserver
fallback_description:   若 Makefile 无并行度变量，用 MAKEFLAGS 环境变量禁用 jobserver（E074 fallback 同款）。
fallback_command:       export MAKEFLAGS="--no-builtin-rules --no-builtin-variables -j1"
fallback_auto_fix:      false
fallback_impl:          set-env-var

forbid_1_pattern:       make.*-j1.*(override MAKEFLAGS 项目)
forbid_1_reason:        -j1 会被 override MAKEFLAGS += -j $(JOBS) 覆盖，实际仍并行，造成"已单线程"的误判。
forbid_1_consequence:   OHOS 上并行触发 FIFO jobserver 卡住/失败，浪费调试轮次。

forbid_2_pattern:       为规避并行而修改 Makefile 删除 override MAKEFLAGS
forbid_2_reason:        改上游 Makefile 不可复现且污染上游构建（R6），应通过命令行变量覆盖。
forbid_2_consequence:   偏离上游构建语义，且非 OHOS 平台行为被意外改变。

principles:             P013, P014, P020
causes:                 []
caused_by:              [E074]
similar_to:             [E074, E333]
conflicts_with:         []
prerequisite_of:        []

