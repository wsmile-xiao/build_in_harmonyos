#====================================================================
# DRAFT-appstream-1.2.0-ohos-qt-loadasync-glib-pump.kv
# OHOS qtbase 未编译 QEventDispatcherGlib：GLib 异步完成回调挂在默认
# GMainContext idle source，纯 Qt 事件循环从不迭代 → 信号永不触发
# （Qt 测试 loadedSpy.wait() 超时）。用 0ms QTimer 泵在每个 Qt tick 迭代
# g_main_context_iteration，回调触发后停泵
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R03）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           Qt6 (qtbase) / GLib g_task
phase:                  runtime-event
error_signature:        loadedSpy\.wait\(\) returned FALSE|
                        QSignalSpy.*wait.*FALSE.*loadFinished|
                        g_task_run_in_thread.*never.*callback
severity:               2
category:               build, qt, glib, event-loop, portability
match_keywords:         qt6, qtbase, QEventDispatcherGlib, g_main_context_iteration,
                        GMainContext, g_task, loadAsync, QTimer, GLib, event loop,
                        OHOS, Qt test, QSignalSpy
title:                  qtbase 无 QEventDispatcherGlib：Qt 事件循环不迭代 GLib 主上下文 → QTimer 泵桥接
root_cause:             OHOS qtbase 未编译 glib 事件集成；GLib 异步回调挂在默认
                        GMainContext，纯 Qt 事件循环不迭代它，回调悬挂。
affected_scope:         Qt 应用/测试消费 GLib 异步 API 且 qtbase 无 glib 集成的平台。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing; meson test as-test_qt-pool as-test_qt-misc
rec_priority:           1
rec_approach:           qt-glib-maincontext-pump
rec_description:        loadAsync 启动 0ms QTimer，timeout 回调 g_main_context_iteration
                        (NULL, FALSE)；GLib 完成回调（emit 信号）后停泵。配套注入
                        qtbase 工具链（qt6.pc 转发、Qt6*.pc prefix 修正、moc/qmake6 PATH）。
rec_command:            |
  d->glibPump = new QTimer(d->q);
  d->glibPump->setInterval(0);
  QObject::connect(d->glibPump, &QTimer::timeout, d->q, []() {
      g_main_context_iteration (NULL, FALSE);
  });
  d->glibPump->start();
  /* 回调内: glibPump->stop(); deleteLater(); */
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       g_main_loop_run.*in.*thread
forbid_1_reason:        阻塞主事件循环线程，破坏 Qt 事件分发
forbid_2_pattern:       sleep.*wait.*poll
forbid_2_reason:        不得用轮询/睡眠代替事件循环桥接
principles:             R6, R8
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []
