#====================================================================
# Draft: objfw 1.5.7 ObjC consumer flags - constant string class mismatch
#        causes runtime SIGSEGV / OFMethodNotFound (recipe layer)
#====================================================================

id:                     DRAFT-OBJFW-157-CONSTANT-STRING-CLASS-CONSUMER-FLAGS
trigger_tool:           clang|objc|objfw|conan|test_package
phase:                  compilation|linking|testing
error_signature:        Signal 11.*core dumped|OFMethodNotFound|fconstant-string-class|OFConstantString|objc_msg_lookup.*objfw

severity:               2
category:               ohos, conan, runtime, objective-c, objfw
match_keywords:         objfw, 1.5.7, ObjFW, Objective-C, -fobjc-runtime=objfw, -fconstant-string-class=OFConstantString, OFConstantString, CFConstantString, containsString, dataWithEncoding, objcflags, test_package.m, Signal 11, OFMethodNotFound

title:                  objfw/1.5.7 consumers must compile ObjC sources with -fobjc-runtime=objfw and -fconstant-string-class=OFConstantString or @"..." literals crash at runtime

root_cause:             ObjFW ships its own Objective-C runtime (libobjfwrt) and
                        uses OFConstantString for constant string literals. The
                        library itself is built with
                        "-fconstant-string-class=OFConstantString -Xclang
                        -fno-constant-cfstrings" (recorded in upstream
                        buildsys OBJCFLAGS). A consumer that only links
                        -lobjfw/-lobjfwrt without passing the same flags gets
                        @"..." literals emitted as CFConstantString-style
                        objects. The mismatch is silent at compile/link time:
                        message sends with a literal argument (e.g.
                        [str containsString: @"x"]) dereference the wrong object
                        layout and die with SIGSEGV (Signal 11), or raise
                        OFMethodNotFound (Signal 6) when a stale selector is
                        looked up on the alien constant-string object.
affected_scope:         Any Conan recipe packaging ObjFW or ObjFW-based
                        Objective-C libraries for OHOS, and every downstream
                        consumer that compiles .m sources.
verification_cmd:       conan create archives/o/objfw/1.5.7 -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing

rec_priority:           1
rec_approach:           publish-objcflags-in-package-info
rec_description:        Publish consumer ObjC flags from the recipe:
                        self.cpp_info.objcflags = ["-fobjc-runtime=objfw",
                        "-fconstant-string-class=OFConstantString"], link
                        libs ["objfw", "objfwrt", "objfwtls"]. The
                        test_package must be a real .m source calling ObjFW
                        APIs (OFString/OFNumber/OFArray/OFData) compiled with
                        the same flags via clang -x objective-c and executed
                        with can_run; a C-only consumer cannot prove the ObjC
                        ABI (see forbid_1).
rec_command:            conan create archives/o/objfw/1.5.7 -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      explicit-test-compile-flags
fallback_description:   When a consumer build system ignores cpp_info.objcflags,
                        compile ObjC sources in its build/test step with an
                        explicit clang -x objective-c -fobjc-runtime=objfw
                        -fconstant-string-class=OFConstantString command line
                        (as done in objfw/1.5.7 test_package/conanfile.py).
fallback_command:
fallback_auto_fix:      false
fallback_impl:          conan-recipe

forbid_1_pattern:       test_package.*\.(c|cpp)$|main\(.*printf.*only
forbid_1_reason:         A C/C++-only consumer cannot exercise the Objective-C
                        runtime ABI, constant string class, or message dispatch.
forbid_1_consequence:   Package looks green while real ObjC consumers crash at
                        runtime with Signal 11 / OFMethodNotFound.

forbid_2_pattern:       omit.*fconstant-string-class|emit.*CFConstantString
forbid_2_reason:        @"..." literals compiled without
                        -fconstant-string-class=OFConstantString become
                        CFConstantString objects that ObjFW treats as
                        OFConstantString.
forbid_2_consequence:    Silent ABI mismatch; SIGSEGV or OFMethodNotFound at
                        first message send with a literal argument.

principles:             P010,P014,P017
causes:                 []
caused_by:              []
similar_to:             E449
conflicts_with:         []
prerequisite_of:        []

