#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E755.kv，填写各字段
# 对应的人类文档: doc/E755.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E755
trigger_tool: clang|ld|make
phase: linking
error_signature: cannot find entry symbol [A-Za-z-]*dynamic

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: portability, autotools, build-system, clang, ohos
match_keywords: export-dynamic, xport-dynamic, cannot find entry symbol, entry point, SIGSEGV, rc=139, AM_LDFLAGS, LDFLAGS
title: clang 把裸 -export-dynamic 当成 -e xport-dynamic：ELF 入口点丢失，程序启动即 SIGSEGV

prescan_pattern: (^|[^A-Za-z0-9_-])-export-dynamic(\s|$)
prescan_globs: Makefile*, Makefile.in, *.mk, *.am

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 自动化工具生成的 Makefile 里把 --export-dynamic 写成裸 -export-dynamic；GCC 驱动把它当自身选项转成 --export-dynamic，而 clang 驱动不识别、原样转给链接器，链接器按 -e 解析成入口符号 xport-dynamic（不存在），ELF e_entry 因此未设置。
affected_scope: 任何用 autotools 生成 Makefile 且 AM_LDFLAGS/LDFLAGS 里写裸 -export-dynamic 的包（ptask 1.0.0 实测）；症状是构建成功但每次运行在任何输出前就 rc=139 崩溃。
verification_cmd: readelf -h <bin> | grep Entry_point（应为非 0 的可执行地址）；构建日志里出现 ld.lld 的一行 cannot find entry symbol xport-dynamic 警告

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: patch-generated-makefile-link-flag
rec_description: 把裸 -export-dynamic 改成 -Wl,--export-dynamic（只补丁生成物 Makefile.in，不动 Makefile.am，避免触发 automake 重生成）。
rec_command: 在生成的 Makefile.in 里把 '-export-dynamic' 改成 '-Wl,--export-dynamic'（补丁），随后用 readelf -h <bin> | grep Entry_point 复核
rec_auto_fix: false
rec_impl: conan-patch-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

