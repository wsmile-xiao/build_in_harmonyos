#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E999.kv，填写各字段
# 对应的人类文档: doc/E999.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E999
trigger_tool:           python
phase:                  installation
error_signature:        pip.*shebang.*not portable|console_scripts.*absolute path

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               python, portability, packaging
match_keywords:         pip, console_scripts, shebang, entry_points, python3
title:                  pip生成的console script shebang指向构建机Python路径不可迁移
prescan_pattern:        ^\s*console_scripts\s*=|entry_points\s*=.*console_scripts
prescan_globs:          setup.py, setup.cfg, pyproject.toml

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             pip install生成的console script（bin/命令名）shebang硬编码构建机Python绝对路径，
                        打包后在不同Worker或用户环境中该路径不存在导致命令不可执行
affected_scope:         所有声明console_scripts或entry_points的Python包
verification_cmd:       head -1 $(conan cache path <pkg>/<ver>)/bin/<cmd> | grep -E '^#!/.*python'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           rewrite-shebang
rec_description:        在conanfile.py的package()中将pip生成的shebang改写为portable shell wrapper
rec_command:            sed -i '1c#!/bin/sh\nexec python3 -m <module> "$@"' ${conan_package_folder}/bin/<cmd>
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      env-shebang
fallback_description:   使用#!/usr/bin/env python3（依赖PATH但比绝对路径通用）
fallback_command:       sed -i '1c#!/usr/bin/env python3' ${conan_package_folder}/bin/<cmd>
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       保留pip生成的原始shebang|不做任何改写
forbid_1_reason:        pip生成的shebang硬编码构建机路径（如/usr/bin/python3.12），在其他环境不存在
forbid_1_consequence:   打包后的命令在消费者环境无法执行，conan test_package CLI验证失败
forbid_2_pattern:       依赖系统PATH配置
forbid_2_reason:        Conan包应自包含，不应依赖消费者环境的PATH配置找到python3
forbid_2_consequence:   消费者测试需要手动export PATH或activateConanRunEnvironment.sh才能运行CLI

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P007

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E999.md
last_updated:           2026-09-02
source_event:           py-cpuinfo-9.0.0适配，CI Worker PATH依赖导致CLI验证失败

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:                AtomCode <noreply@atomgit.com>
source_pr:              7675
source_commit:          fe8cd686e8

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

