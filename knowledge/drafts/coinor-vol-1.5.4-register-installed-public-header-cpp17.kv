#====================================================================
# DRAFT-coinor-vol-1.5.4-register-installed-public-header-cpp17
# C++17 下 register 关键字位于安装的公共头文件时须源码补丁（toolchain-flag 不足）
#====================================================================

id:                     DRAFT-coinor-vol-1.5.4-register-installed-public-header-cpp17
trigger_tool:           clang|make|conan
phase:                  compilation|package|test_package
error_signature:        ISO C\+\+17 does not allow 'register' storage class specifier|
                         -Wregister|error:.*register.*C\+\+17

severity:               2
category:               c++, header, cppstd-17, consumer
match_keywords:         register storage class, C++17, installed public header,
                         include/coin, consumer, test_package, 2003 legacy code,
                         toolchain-flag insufficient, source patch
title:                  C++17 下 register 关键字位于安装的公共头文件时须源码补丁（toolchain-flag 无法保护消费者）

root_cause:             2003 年代 C++ 代码使用 register 存储说明符（C++17 移除）。
                        当 register 位于**安装到公共 include 目录的头文件**（如
                        include/coin/VolVolume.hpp）时，仅靠库构建期的
                        toolchain-flag（-Wno-error=register）只能让库自身编译通过；
                        消费者以 cppstd=17 包含该头文件仍会 hard error。必须在源码
                        层移除 register，且补丁覆盖被安装的头文件。
affected_scope:         所有 2003 年代 C++ 库在 compiler.cppstd=17 的 OHOS 环境下，
                        且 register 位于安装公共头文件的场景。实测受影响：
                        coinor-vol 1.5.4（VolVolume.hpp 3 处）。
verification_cmd:       grep -nE '\\bregister\\b' <installed>/include/coin/*.hpp 应 0 命中；
                        clang++ -std=c++17 -stdlib=libc++ -I<prefix>/include/coin
                        <consumer>.cpp <prefix>/lib/libVol.a 应编译链接并运行 rc=0

rec_priority:           1
rec_approach:           source-patch-installed-header
rec_description:        在 conanfile.py build() 的 apply_conandata_patches 阶段，用补丁
                        移除公共头文件中的 register 关键字（模板参数与局部变量均需覆盖），
                        并确保补丁随 exports_sources 打包；test_package 消费者以
                        cppstd=17 包含该头文件验证。
rec_command:            patches/000X-register-remove.patch: VolVolume.hpp 中
                        VolMax(register const T x, ...) -> VolMax(const T x, ...)；
                        VolAbs(...) 同；register const double ll -> const double ll。
                        test_package 用 CMakeDeps + find_package 链接并运行。
rec_auto_fix:           false
rec_impl:               conan-recipe-source-patch

fallback_priority:      2
fallback_approach:      toolchain-flag-only
fallback_description:   若 register 仅存在于库内部源文件（非安装头文件），可用
                        tc.extra_cxxflags.append("-Wno-error=register") 降级；
                        但对安装公共头文件场景不充分（见 E293 与本文档边界）。
fallback_command:       tc.extra_cxxflags.append("-Wno-error=register")
fallback_auto_fix:      true
fallback_impl:          toolchain-flag

forbid_1_pattern:       --build=|--host=.*ohos|set\(CMAKE_CXX_STANDARD 11\)
forbid_1_reason:        禁止用 --build/--host 绕过（误判交叉编译），也禁止把
                        cppstd 降到 11 掩盖问题（OHOS profile 固定 17）
forbid_1_consequence:   级联错误链：交叉编译误判 → AC_RUN_IFELSE 跳过 → config.h 错误

principles:

causes:                 []
caused_by:              []
similar_to:             [E293]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/coinor-vol-1.5.4-register-installed-public-header-cpp17.md
last_updated:           2026-09-08
source_event:           coinor-vol 1.5.4 HarmonyOS PC adaptation (conan-verify G2)

