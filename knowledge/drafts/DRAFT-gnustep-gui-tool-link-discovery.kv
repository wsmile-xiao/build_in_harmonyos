#====================================================================
# DRAFT-gnustep-gui-tool-link-discovery
# GNUstep GUI tools must resolve staged in-tree shared-library aliases first
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: gnustep-gui 0.32.0 HarmonyOS PC 适配（PR #7095）
#====================================================================

id:                     DRAFT-gnustep-gui-tool-link-discovery
trigger_tool:           make|ld.lld|conan
phase:                  build|link|testing
error_signature:        unable to find library -lgnustep-gui|set_show_service.*link|gpbs.*link|gopen.*link|gcloseall.*link
severity:               2
category:               gnustep|linker|shared-library|make
match_keywords:         GNUstep GUI, Tools/GNUmakefile.preamble, GNUSTEP_GUI_TOOL_LIBS,
                         libgnustep-gui, GNUSTEP_SYSTEM_LIBRARIES, Source/obj, Library/Libraries, wildcard, symlink,
                         versioned shared object, lld

title:                  GNUstep GUI tools should resolve the staged in-tree shared library before falling back to -lgnustep-gui
root_cause: >
  GNUstep GUI tool targets are linked before the package install tree has fully stabilized.
  The build tree may expose libgnustep-gui as a versioned file, a symlink, or a plain alias
  under Source/obj, while the install tree may later place aliases under GNUSTEP_SYSTEM_LIBRARIES
  or Library/Libraries. Inherited SYSTEM_LIBS can still carry a raw -lgnustep-gui token, so the
  tool link must prefer an exact staged path when one is available.
  If Tools only accepts one filename form or only a regular file, GNUstep Make falls back to
  -lgnustep-gui and ld.lld cannot resolve the library on OHOS CI.
affected_scope: >
  GNUstep GUI 0.32.x builds that compile the Tools subproject before the shared library alias
  is visible in the recursive make search path.
verification_cmd: >
  Confirm that GNUSTEP_SYSTEM_LIBRARIES, Source/obj, or Library/Libraries contains a visible libgnustep-gui alias before
  entering Tools, and that GNUSTEP_GUI_TOOL_LIBS expands to a concrete staged path instead of plain
  -lgnustep-gui while SYSTEM_LIBS no longer contributes a raw gui basename.

rec_priority:           1
rec_approach:           staged-alias-first-tool-link
rec_description: >
  Stage or copy the current shared-library alias into GNUSTEP_SYSTEM_LIBRARIES, Source/obj,
  and Library/Libraries, export the chosen exact staged path as GNUSTEP_GUI_TOOL_LIBS for
  Tools, then let GNUstep Make fall back to the first existing candidate from
  libgnustep-gui.so.*, libgnustep-gui.*.so, libgnustep-gui.[0-9]*, libgnustep-gui.so,
  or libgnustep-gui before finally using -lgnustep-gui.
rec_command: >
  GNUSTEP_GUI_TOOL_LIBS=$(firstword $(wildcard $(GNUSTEP_SYSTEM_LIBRARIES)/libgnustep-gui.so.*
  $(GNUSTEP_SYSTEM_LIBRARIES)/libgnustep-gui.*.so $(GNUSTEP_SYSTEM_LIBRARIES)/libgnustep-gui.[0-9]*
  $(GNUSTEP_SYSTEM_LIBRARIES)/libgnustep-gui.so $(GNUSTEP_SYSTEM_LIBRARIES)/libgnustep-gui
  ../Source/$(GNUSTEP_OBJ_DIR)/libgnustep-gui.so.* ../Source/$(GNUSTEP_OBJ_DIR)/libgnustep-gui.*.so
  ../Source/$(GNUSTEP_OBJ_DIR)/libgnustep-gui.[0-9]* ../Source/$(GNUSTEP_OBJ_DIR)/libgnustep-gui.so
  ../Source/$(GNUSTEP_OBJ_DIR)/libgnustep-gui ../Library/Libraries/libgnustep-gui.so.*
  ../Library/Libraries/libgnustep-gui.*.so ../Library/Libraries/libgnustep-gui.[0-9]*
  ../Library/Libraries/libgnustep-gui.so ../Library/Libraries/libgnustep-gui) -lgnustep-gui
rec_auto_fix:           false
rec_impl:               tool-link-alias-discovery

fallback_priority:      2
fallback_approach:      copy-or-link-libgnustep-gui-into-tool-search-path
fallback_description: >
  If GNUstep Make still cannot see the staged alias, copy or symlink the resolved shared
  library into GNUSTEP_SYSTEM_LIBRARIES, Source/obj, and Library/Libraries before rerunning
  the Tools subproject.
fallback_command:       copy libgnustep-gui alias into Source/obj and Library/Libraries
fallback_auto_fix:      false
fallback_impl:          staged-build-tree-alias

forbid_1_pattern:       ^-lgnustep-gui$
forbid_1_reason:        Plain fallback without any visible in-tree alias still fails on OHOS CI.
forbid_1_consequence:   set_show_service and sibling tool links can fail with lld not finding the library.

principles:             P016
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

