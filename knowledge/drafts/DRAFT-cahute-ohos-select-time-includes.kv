#====================================================================
# DRAFT-cahute-ohos-select-time-includes — OHOS 上 select()/fd_set 需
# 显式包含 <sys/select.h> 与 <sys/time.h>
# 关联库: cahute 0.6（r02，OHOS aarch64 实测）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# 触发: CMake/Ninja 编译 lib/linkmedium.c（POSIX 串口路径）
# 时，fd_set 未声明、struct timeval 不完整类型。
id:                     DRAFT-cahute-ohos-select-time-includes
trigger_tool:           clang|cmake|ninja
phase:                  compilation
error_signature:        use of undeclared identifier 'fd_set'|variable has incomplete type 'struct timeval'|incomplete type 'struct timeval'|unknown type name 'fd_set'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               headers, posix, ohos, compat, libc
match_keywords:         fd_set, timeval, sys/select.h, sys/time.h, select, POSIX_SERIAL, OHOS, undeclared identifier, incomplete type
title:                  OHOS 上使用 select()/fd_set 的 C 库需显式包含 <sys/select.h> 与 <sys/time.h>

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             OHOS 的 select()/fd_set/struct timeval 不能依靠其他头文件间接引入：上游仅笼统包含 <time.h>/<unistd.h> 等头，在 Linux/glibc 上因传递包含正常，在 OHOS 上 fd_set 与 struct timeval 未声明导致编译失败。需要在使用 select() 的翻译单元显式包含 <sys/select.h> 与 <sys/time.h>。
affected_scope:         任何在 OHOS 上使用 select()/FD_* 宏/struct timeval 的 C/C++ 库（串口/套接字/管道轮询路径）；bossa 1.9.1 已有同类补丁（0001-src-PosixSerialPort-missing-includes.patch），跨库复用证据充分。
verification_cmd:       grep -nE 'fd_set|select\\(' lib/*.c | head; # 存在则查 #include 是否含 sys/select.h

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           add-explicit-select-time-includes
rec_description:        在非 WIN32 分支（#if !WIN32_ENABLED）显式包含 <sys/select.h> 与 <sys/time.h>，覆盖使用 select()/FD_SET 的翻译单元
rec_command:            sed -i 's/# include <linux\\/serial.h>/# include <linux\\/serial.h>\\n\\n#if !WIN32_ENABLED\\n# include <sys\\/select.h>\\n# include <sys\\/time.h>\\n#endif/' lib/linkmedium.c
rec_auto_fix:           false
rec_impl:               patch-source

fallback_priority:      2
fallback_approach:      guarded-ohos-include
fallback_description:   仅对 OHOS 加 include（#if defined(__OHOS__)），但非 WIN32 守卫更通用，惠及所有 POSIX 平台
fallback_auto_fix:      false