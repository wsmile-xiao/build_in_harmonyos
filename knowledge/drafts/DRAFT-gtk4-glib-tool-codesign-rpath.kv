#====================================================================
# DRAFT-gtk4-glib-tool-codesign-rpath
# 依赖包 bin 工具 .codesign 失效 + 无 RPATH → gnome.compile_resources 执行失败
# 触发事件: GTK4 4.22.4 HarmonyOS PC 适配（glib/2.84.0.1.1 shared=True）
#====================================================================

id:                     DRAFT-gtk4-glib-tool-codesign-rpath
trigger_tool:           ninja|meson|glib-compile-resources|glib-compile-schemas|glib-mkenums
phase:                  build|compilation
error_signature:        FAILED.*code=126.*(glib-compile-resources|glib-compile-schemas)|.*: Operation not permitted|
                         Error loading shared library libgio-2\.0\.so\.0.*(glib-compile-resources|glib-compile-schemas)|
                         gdk/gdkresources\.(c|h)|Could not get pkg-config variable

severity:               2
category:               elf-signing|rpath|conan|meson|tool-dependency|harmonyos
match_keywords:         glib-compile-resources, glib-compile-schemas, glib-mkenums,
                         codesign, Operation not permitted, exit 126, RPATH, LD_LIBRARY_PATH,
                         gnome.compile_resources, Conan dependency bin tool, OHOS, gdkresources,
                         pkg-config tool variable, shared glib

title:                  Re-sign dependency bin tools and inject LD_LIBRARY_PATH when a shared glib package's host tools fail under ninja

root_cause: >
  A Conan dependency installed as a SHARED library package (glib/2.84.0.1.1 shared=True)
  ships host executables (bin/glib-compile-resources, bin/glib-compile-schemas,
  bin/glib-mkenums, bin/glib-genmarshal). On HarmonyOS two independent defects surface at
  build time:
  (1) the package's bin tools carry a stale/expired .codesign section — HarmonyOS XPM
  refuses to exec them ("Operation not permitted", ninja FAILED [code=126] at
  gdk/gdkresources.c/h) even though the file mode has the exec bit;
  (2) the tools have NO RPATH, so even after the signature is refreshed the dynamic loader
  cannot find the package's own shared libs (libgio-2.0.so.0 / libglib-2.0.so.0 /
  libintl.so.8) unless the package lib dir is on LD_LIBRARY_PATH.
  Both must be fixed together: re-sign the ELF tool in place AND prepend the dependency lib
  dir to LD_LIBRARY_PATH before meson/ninja runs the custom command.
affected_scope: >
  OHOS/Meson builds where a shared Conan dependency provides host tools consumed by
  gnome.compile_resources / gnome.compile_schemas / gnome.mkenums, especially when the
  dependency recipe only re-signs its .so (post-install) but not its bin/ executables,
  and those executables are dynamically linked without RPATH.
verification_cmd: >
  # 1) minimal repro of the exec failure
  $CONAN_GLIB_PKG/bin/glib-compile-resources --version
  #    → "Operation not permitted" (code 126) before re-sign
  # 2) re-sign the ELF tool
  llvm-objcopy --remove-section .codesign $CONAN_GLIB_PKG/bin/glib-compile-resources
  binary-sign-tool sign -inFile $CONAN_GLIB_PKG/bin/glib-compile-resources \
                          -outFile $CONAN_GLIB_PKG/bin/glib-compile-resources -selfSign 1
  # 3) after re-sign, still fails unless libs are on the search path
  LD_LIBRARY_PATH=$CONAN_GLIB_PKG/lib $CONAN_GLIB_PKG/bin/glib-compile-resources --version
  #    → "2.84.0" (success)

rec_priority:           1
rec_approach:           conan-generate-resign-bin-tools-and-ld-library-path
rec_description: >
  In the consumer recipe's generate() (before MesonToolchain.generate and before ninja),
  iterate the glib dependency package_folder/bin and re-sign every ELF tool that carries a
  stale .codesign (skip non-ELF, e.g. shebang gdbus-codegen), then prepend the dependency
  lib dir to LD_LIBRARY_PATH. This mirrors the recipe's own .so post-install ML-0043 re-sign
  pattern, extended to the dependency's host bin tools. Do not claim EPERM = external block
  without running the minimal repro and the signature/arch/RPATH checks first.
rec_command: >
  # in gtk4 conanfile.py generate():
  objcopy=/data/service/hnp/bin/llvm-objcopy
  signer=/data/service/hnp/bin/binary-sign-tool
  gbin=<glib pkg folder>/bin; glib=<glib pkg folder>/lib
  export LD_LIBRARY_PATH="$glib:$LD_LIBRARY_PATH"
  for t in "$gbin"/*; do
    [ -f "$t" ] || continue
    head -c4 "$t" | grep -q $'\x7fELF' || continue      # skip shebang scripts
    $objcopy --remove-section .codesign "$t" 2>/dev/null || true
    $signer sign -inFile "$t" -outFile "$t" -selfSign 1
  done
rec_auto_fix:           false
rec_impl:               conan-recipe-generate-resign-bin-tools

fallback_priority:      2
fallback_approach:      point-meson-tool-vars-at-prebuilt-signed-tool
fallback_description: >
  If the shared glib package's tools cannot be re-signed in place (read-only package dir),
  override the pkg-config tool variables (glib_compile_resources / glib_compile_schemas /
  glib_mkenums / glib_genmarshal) in the generated glib-2.0.pc / gio-2.0.pc to point at a
  known-good, already-signed glib tool (e.g. the build-machine glib2/2.88.0 static tool that
  is statically linked and execs cleanly), and keep LD_LIBRARY_PATH for any dynamic libs.
fallback_command: >
  # gio-2.0.pc / glib-2.0.pc injection (recipe _fix_glib_pcs pattern)
  glib_compile_resources=${bindir}/glib-compile-resources
  glib_compile_schemas=${bindir}/glib-compile-schemas
  glib_mkenums=${bindir}/glib-mkenums
  glib_genmarshal=${bindir}/glib-genmarshal
fallback_auto_fix:      false
fallback_impl:          pc-tool-variable-redirect

forbid_1_pattern:       仅凭 "Operation not permitted" / "Permission denied" 判定 external_blocked
forbid_1_reason:         单条权限错误不足以构成外部阻塞；必须先核验工具绝对路径、来源/package ID、权限与可执行位、
                         ELF 架构与格式、签名/白名单、动态依赖闭包、runner/工作目录/环境变量，并用最小复现命令重试。
forbid_1_consequence:   错误地把可修复的内部工具签名问题报告为外部阻塞，导致返工被错误终止或绕过。
forbid_2_pattern:       只重签工具但不设 LD_LIBRARY_PATH（或反之）
forbid_2_reason:         两个缺陷独立叠加：签名问题表现为 EPERM，路径问题表现为 "Error loading shared library"，缺一不可。
forbid_2_consequence:   修一个仍失败，被误判为修复无效而回退版本。

# Layer 4: 原则引用
principles:              P017, P019
