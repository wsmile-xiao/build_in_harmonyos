#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E2175.kv，填写各字段
# 对应的人类文档: doc/E2175.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E2175
trigger_tool: clang|libc++|gtest
phase: native-test
error_signature: parallel_usage.*FAILED|Expected equality of these values|reads stale value under concurrent resize|passes on x86 fails on aarch64

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 1
category: platform|aarch64|concurrency
match_keywords: memory_order_relaxed,acquire-load,release-store,aarch64,upstream fix,backport
title: aarch64 弱内存序暴露上游并发库 relaxed 读写的真实竞态（x86 强序掩盖），修复=回移上游官方内存序修复

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: aarch64 弱内存序暴露上游库 relaxed key/value 读写的真实竞态；x86 TSO 强序掩盖（上游 CI 未发现）。修复策略=回移上游 main 的官方内存序修复并全量重跑上游测试
affected_scope: 使用 memory_order_relaxed 维护桶/槽位一致性的无锁并发容器（以 vyukov_hash_map 为例）；在 aarch64/armv8 目标（OHOS PC）上并发 resize/迁移与 lookup 并发时触发
verification_cmd: 上游测试全量重跑多轮（./gtest，811/811 ×4 轮稳定）+ 独立并发消费者测试（checks=263242 failures=0，连跑 3 轮计数确定）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: backport-upstream-memory-order-fix
rec_description: 对照上游 main 定位同文件内存序修复提交（commit log + PR），将 acquire/release 配对回移到 tag 版本对应结构（注意 retry 循环结构差异需按 tag 结构映射，勿盲移），重跑上游全量测试验证
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: false           true|false                  # 引擎能否自动执行
rec_impl: patch-backport               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: .*\b(fence|__dmb|asm volatile\("dmb)\b.*
forbid_1_reason: 用手工屏障/内联汇编掩盖内存序缺陷，不可移植且偏离上游实现，后续版本合并时冲突
forbid_1_consequence: 引入平台私有语义、阻碍回移上游后续修复，且无法证明与上游语义等价
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

