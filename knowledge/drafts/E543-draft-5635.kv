#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: conan|cmake|clang++|test
phase: configuration|testing
error_signature: Could NOT find Boost|Boost_INCLUDE_DIR|unit_test_framework|Missing prebuilt package for.*boost|Missing prebuilt package for.*zlib

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: dependency|boost|test|ohos
match_keywords: Boost.Test, unit_test_framework, Boost_INCLUDE_DIR, OHOS, header-only, test_sources, missing prebuilt package
title: OHOS upstream Boost.Test can use verified source headers when Conan binaries are unavailable

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: The upstream test project links Boost::unit_test_framework, but the OHOS arm64 Conan graph may have no compatible boost and transitive zlib binaries; configuring the original test project therefore fails before testing.
affected_scope: Header-only C++ libraries whose upstream tests require Boost.Test binaries on OHOS.
verification_cmd: conan install --requires=boost/1.84.0 --build=never; cmake -S tests -B build; compile all upstream test translation units with Boost 1.86.0 header-only entry and run the suite.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: source-boost-header-only
rec_description: Keep Boost out of the package requires graph; download a pinned official Boost source archive as test-only input, replace only the generated test main include with boost/test/included/unit_test.hpp, compile unchanged upstream test sources, and run the resulting binary.
rec_command: clang++ -std=c++17 -DTSL_DEBUG -UNDEBUG -DBOOST_DISABLE_THREADS -isystem<boost-root> -I<package-include> <generated-main.cpp> <all-upstream-test-sources.cpp> -o upstream-tests -pthread
rec_auto_fix: false
rec_impl: manual-recipe-test-source

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: existing-compatible-boost-package
fallback_description: Use an already verified OHOS-compatible Boost.Test package only when the package and all transitive binaries exist for the exact host profile.
fallback_command: conan search boost/1.84.0 -r=ohpcd
fallback_auto_fix: false
fallback_impl: dependency-preflight

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: R34|R39|R49

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes: []
caused_by: []
similar_to: [E035,E099]
conflicts_with: []
prerequisite_of: []

