#====================================================================
# E544-draft-B4CT.kv — 2005 年代 config.sub 连 aarch64 现代三元组也不识别，
# 原生构建只传 --build 不传 --host（cityhash 1.1.1 实证）
# 对应的人类文档: knowledge/drafts/E544-draft-B4CT.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E544
trigger_tool:           configure
phase:                  configuration
error_signature:        "Invalid configuration 'aarch64-unknown-linux-[a-z]+': machine 'aarch64-unknown-linux' not recognized|cannot guess build type; you must specify one"

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               autotools, build-system
match_keywords:         config.sub, config.guess, aarch64, Invalid configuration, machine not recognized, cannot guess build type, --build, --host, HarmonyOS, HongMeng
title:                  2005 年代 config.sub 连 aarch64 现代三元组也不识别：原生构建只传 --build 不传 --host

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             2012 年前发布的 config.guess/config.sub 不认识 aarch64 CPU 名。需要从 uname 猜测 build 类型的路径还可能因 HarmonyOS 内核名触发 E160；本实例显式传入 aarch64-unknown-linux-gnu 绕过 guess 层，剩余的 config.sub 对传入 --host 三元组仍会因拒绝 aarch64 开头 CPU 而报 Invalid configuration，老 config.sub 连 aarch64-unknown-linux-gnu 本身也不在已知 CPU 列表。
affected_scope:             发布早于 aarch64 命名普及（约 2012 年前）的 autotools 软件在 OHOS aarch64 原生构建时的配置阶段（cityhash 1.1.1 实证：configure 内嵌 2005 年 config.guess/config.sub）
verification_cmd:       ./config.sub aarch64-unknown-linux-gnu 报 Invalid configuration 即中招；./config.guess 报 cannot guess build type 同源

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           build-only-triplet
rec_description:        OHOS 原生构建（设备即目标机）显式只传 --build=aarch64-unknown-linux-gnu，不传 --host（host 缺省等于 build，绕开老 config.sub 校验）；若构建路径必须从 uname 猜测 build 类型，再另行采用 E160 config.guess 方案
rec_command:            tc.configure_args.append('--build=aarch64-unknown-linux-gnu')  # 勿传 --host；本实例不需要 E160 config.guess 补丁
rec_auto_fix:           false
rec_impl:               conanfile-layout

# 回退方案
fallback_priority:      2
fallback_approach:      refresh-config-sub
fallback_description:   用当前 autoconf/automake 自带的新版 config.guess/config.sub 整体替换随包旧文件（补丁体积大，为次选）
fallback_command:
fallback_auto_fix:      false
fallback_impl:          source-patch

# ★ 禁止策略 ★
forbid_1_pattern:       --host=aarch64-unknown-linux-ohos
forbid_1_reason:        老 config.sub 不在已知 CPU 列表里，传 ohos host 三元组必报 Invalid configuration，configure 直接终止
forbid_1_consequence:   configure 阶段失败，构建无法开始

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             E007, E160, E122, E072
conflicts_with:         []
prerequisite_of:        []

