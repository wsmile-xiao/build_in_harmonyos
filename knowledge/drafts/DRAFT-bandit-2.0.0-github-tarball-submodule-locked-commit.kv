#====================================================================
# DRAFT-bandit-2.0.0-github-tarball-submodule-locked-commit.kv
# GitHub 官方 tarball 缺 submodule 且为头文件硬依赖时，按 tag 锁定 commit
# 从官方源补齐 + Conan 多源 destination 打包（bandit 2.0.0 实证）
# 触发事件: bandit 2.0.0 HarmonyOS PC 适配（archives/b/bandit/2.0.0，r01）
#====================================================================

id:                     DRAFT-bandit-2.0.0-github-tarball-submodule-locked-commit
trigger_tool:           conan|source|download|cmake
phase:                  source|dependency-analysis|configuration|packaging
error_signature:        file not found.*<submodule path>|No such file or directory.*(snowhouse|cotire)|
                         empty submodule|\.gitmodules|git/trees|mode.*160000|
                         submodule.*missing|fatal error:.*\.h file not found

severity:               2
category:               dependency, submodule, packaging, conan, multi-source
match_keywords:         submodule, tarball, archive, GitHub, .gitmodules, locked commit,
                         Trees API, 160000, snowhouse, cotire, multi-source, destination,
                         conandata, strip_root, get()
title:                  官方 tarball 不含 submodule 且为硬依赖时：GitHub Trees API 锁定 commit，从官方源补齐，conandata 多源 destination 打包

root_cause: >
  GitHub archive 生成器只打包 git 跟踪树，submodule 目录为空占位（.gitmodules 仅有
  path/url 声明）。当 submodule 是头文件 include 硬依赖（如 bandit.h 强依赖 snowhouse）
  或构建系统硬依赖（如 cotire）时，直接编译必然失败。可选依赖场景（E425）可用占位
  目录裁剪，硬依赖场景必须补齐真实内容。

rec_priority:           1
rec_approach:           lock-commit-and-fetch-official
rec_description: >
  ① GitHub Trees API（GET /repos/{o}/{r}/git/trees/{tag}?recursive=1）读取
  mode=160000 条目的 commit sha（tag 锁定）；② 从官方源（codeload.github.com/
  {subowner}/{subrepo}/tar.gz/{sha}）下载该 commit 归档解压到 submodule 路径；
  ③ conandata.yml 用 sources 列表声明主包+submodule（url/sha256/destination），
  配方 source() 逐项 get(self, **item)（strip_root=True）；④ 纯构建期 submodule
  （如 cotire）在无编译的 header-only 配方中可省略。
rec_command: >
  curl -s "https://api.github.com/repos/banditcpp/bandit/git/trees/v2.0.0?recursive=1" &&
  curl -sL "https://codeload.github.com/joakimkarlsson/snowhouse/tar.gz/34d4b6df949356bcc0814f976f015ebee6ced9b3" -o snowhouse.tar.gz &&
  tar -xzf snowhouse.tar.gz --strip-components=1 -C bandit/assertion_frameworks/snowhouse
rec_auto_fix:           false
rec_impl:               conan-multi-source-submodule

fallback_priority:      2
fallback_approach:      scope-placeholders
fallback_description:   submodule 为可选功能依赖时参考 E425：保留空目录占位裁剪功能范围，不下载外部 submodule，避免混入本库 PR。
fallback_command:
fallback_auto_fix:      false

affected_scope:         使用 GitHub/同类托管官方 tarball 且含 submodule 的 C/C++ 库适配（submodule 为编译/头文件硬依赖时）。
verification_cmd:       conan create archives/b/bandit/2.0.0 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing --user=ohpcd --channel=stable

similar_to:             E150, E425
caused_by:
prerequisite_of:
conflicts_with:
