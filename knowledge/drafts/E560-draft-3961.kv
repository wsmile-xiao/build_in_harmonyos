#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E560.kv，填写各字段
# 对应的人类文档: doc/E560.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E560
trigger_tool: clang
phase: compilation
error_signature: must be initialized by a constant expression|cast from 'const void \*' is not allowed in a constant expression|static assertion expression is not an integral constant expression

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: toolchain, clang, cxx20, constexpr, ohos
match_keywords: constexpr, constant expression, const void, static_assert, C++20, C++17, P2738, clang 15, rapidhash, wyhash, hash header
title: constexpr 标注的 C 风格函数在 C++17/20 常量表达式中因 (const void*) 转换不可求值（P2738 需 clang 19+）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: C++ 常量表达式直到 C++26 P2738 才允许 void* 到具体对象指针的转换；给 C 库头加 constexpr 标注的项目（rapidhash v3 等）在 internal 函数体内写 const uint8_t* p=(const uint8_t*)key，使整条调用链在常量表达式中不可求值。OHOS clang 15.0.4 实测 C++17 与 C++20 均报 constexpr variable must be initialized by a constant expression，该能力 clang 19 才实现
affected_scope: 所有消费方试图对 constexpr 标注的 C 风格哈希/算法头（rapidhash/wyhash 系）做编译期 static_assert 求值的 OHOS 包；运行期调用不受影响
verification_cmd: clang++ -std=c++20 -c consumer.cpp 复现: error: constexpr variable 'kEmptyCx' must be initialized by a constant expression / note: cast from 'const void *' is not allowed in a constant expression

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: runtime-assert-or-clang19
rec_description: KAT/断言一律用运行期比较验证（test_package 口径），notes 声明常量表达式求值需 clang>=19（P2738/C++26）；不要为绕过它给上游头打补丁
rec_command: 将 static_assert(rapidhash(...)==KAT) 改为运行期 if 比较；或升级到 clang>=19 再启用编译期求值
rec_auto_fix: false
rec_impl: manual-edit

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: static_assert\(\s*rapidhash|constexpr\s+\w+\s+\w+\s*=\s*rapidhash
forbid_1_reason: P2738 在 clang 15 未实现，常量表达式必然不可求值
forbid_1_consequence: test_package 编译失败且 note 指向上游头文件内部行，易误判为包/配方缺陷
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

