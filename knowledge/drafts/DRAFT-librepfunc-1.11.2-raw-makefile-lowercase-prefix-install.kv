#====================================================================
# DRAFT-librepfunc-1.11.2-raw-makefile-lowercase-prefix-install
#   raw makefile 的 install 目标用小写 `prefix ?= /usr` 变量；Conan 配方
#   若传大写 PREFIX=（或未覆盖），库文件落入 DESTDIR/usr/lib 而非包根
#   lib/ → CMakeDeps "Library 'x' not found in package"
# 来源: librepfunc 1.11.2 适配（task librepfunc-1.11.2-r01-pc2-34）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-librepfunc-1.11.2-raw-makefile-lowercase-prefix-install
trigger_tool:           conan|make|cmake
phase:                  installation|configuration
error_signature:        Library '.*' not found in package|
                         cmakedeps_macros\.cmake.*conan_package_library_targets|
                         make install.*DESTDIR.*usr/lib|
                         prefix=.*空.*包根|PREFIX=.*未生效

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               make, install, conan, packaging, prefix, ohos,
                        raw-makefile, cmakedeps
match_keywords:         prefix, PREFIX, make install, DESTDIR, usr/lib,
                        CMakeDeps, not found in package, raw makefile,
                        大小写, lowercase, install target, package root
title:                  raw makefile 的 install 目标使用小写 `prefix ?= /usr` 变量时，Conan 配方传大写 `PREFIX=` 不生效（或无覆盖），库文件安装到 `DESTDIR/usr/lib` 而非包根 `lib/`，CMakeDeps 报 "Library 'x' not found in package"
prescan_pattern:        prefix\s*\?*=\s*/usr|PREFIX\s*=|make install.*DESTDIR
prescan_globs:          Makefile, conanfile.py

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             手写 Makefile 的 install 目标通常声明 `prefix ?= /usr`
                        并用小写变量展开目录（libdir=$(prefix)/lib 等）。
                        Conan 配方 sample 常以 `make install PREFIX=$package_folder`
                        （大写）传参，但 Make 变量名大小写敏感：大写 PREFIX 对
                        小写 prefix 无任何影响 → prefix 保持默认 /usr →
                        `make install DESTDIR=$package_folder prefix=` 若被忽略，
                        库文件落入 `$package_folder/usr/lib`。CMakeDeps 默认在
                        包根 `lib/` 下生成 -L 与 target，找不到
                        `usr/lib/librepfunc.a` → test_package find_package 报
                        "Library 'repfunc' not found in package"
                        （cmakedeps_macros.cmake 的 conan_package_library_targets）。
                        修复必须用小写 `prefix=`（空值使包根即 libdir），
                        而非大写 PREFIX=。
affected_scope:         所有 install 规则基于小写 `prefix ?= /usr` 变量展开目录的
                        raw makefile 库。实证：librepfunc 1.11.2（Makefile 中
                        prefix ?= /usr，install 安装 .so/.a/repfunc.h 到
                        $(prefix)/lib、$(prefix)/include）。
verification_cmd:       conan-verify G2：`conan create ... -pr:h=ohos-aarch64`
                        通过；检查包内 `find $package_folder -name 'librepfunc*'`
                        落点在 `lib/` 而非 `usr/lib`

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           make-install-lowercase-prefix-empty
rec_description:        package() 中运行
                        `make install DESTDIR=$package_folder prefix=`
                        （小写 prefix 置空，包根即安装根）；切勿用大写
                        PREFIX=；shared/static 分别对应上游 install /
                        install-static 目标
rec_command:            make install -j1 CXX=${CXX} DESTDIR=${CONAN_PACKAGE_FOLDER} prefix=
rec_auto_fix:           false
rec_impl:               conan-package-make-install-lowercase-prefix

fallback_priority:      2
fallback_approach:      copy-libs-with-conan-copy
fallback_description:   上游 Makefile install 行为不可控时，放弃 make install，
                        改用 conan.tools.files.copy 显式从 build 目录复制
                        lib/*.a/l*.so* 与 include/*.h 到包根 lib/、include/
fallback_command:
fallback_auto_fix:      false
fallback_impl:          conan-copy-manual-packaging

forbid_1_pattern:       cpp_info\.libs\s*=\s*\[.*lib.*\]|伪造.*usr/lib.*作为 libdir
forbid_1_reason:        库名应为去前缀名（librepfunc.a → "repfunc"），且不得靠
                        伪造 libdirs 掩盖产物落点错误；根因是安装变量名，不是
                        cpp_info 声明

# ═══ Layer 4: 知识层 (Knowledge) ═══
similar_to:             E392, E316, E277
caused_by:
prerequisite_of:
conflicts_with:
example:                librepfunc 1.11.2：conanfile.py package() 从
                        `PREFIX=`（大写，无效）改为 `prefix=`（小写空值）后，
                        librepfunc.a 落到包根 lib/，G2 PASS、G3 PASS、
                        G4 PASS、W3 本地 CI 全绿