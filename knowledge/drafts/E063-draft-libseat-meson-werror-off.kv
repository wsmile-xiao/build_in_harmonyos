#====================================================================
# E063-draft-libseat-meson-werror-off.kv — Meson + -Werror + OHOS SDK 头文件警告
#====================================================================
# 来源: libseat 0.9.1（seatd monorepo 库组件）OHOS aarch64 适配, 2026-09-07
# 状态: 草稿（待人工审核后 promote 为正式条目）

id:                     E063-draft-libseat-meson-werror-off
trigger_tool:           meson|clang
phase:                  compilation
error_signature:        CMSG_NXTHDR.*signedness|sys/socket\.h:.*warning.*expanded from macro|warning:.*comparison of integers of different signedness.*-Werror

severity:               2
category:               compat, compiler, warnings, meson, platform
match_keywords:         CMSG_NXTHDR, signedness, sys/socket.h, SDK header, werror, MesonToolchain, project_options, OHOS, seatd, libseat
title:                  OHOS SDK 头文件警告 + 上游 -Werror → meson project_options werror=false

root_cause:             OHOS SDK 的 sys/socket.h 中 CMSG_NXTHDR 宏展开（__CMSG_LEN(cmsg) + sizeof(struct cmsghdr) >= __MHDR_END(mhdr) - (unsigned char *)(cmsg)）产生无符号/有符号比较警告；上游 meson 工程 default_options 开启 werror=true，将 SDK 头文件自身的警告升级为编译错误。问题不源于目标库源码。
affected_scope:         所有使用 Meson + -Werror 且需在 OHOS SDK 下编译的 C/C++ 库（同源先例: seatd 0.9.1 配方，libseat 0.9.1 配方）
verification_cmd:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing
rec_priority:           1
rec_approach:           meson-werror-off
rec_description:        在 generate() 中对 MesonToolchain 设置 tc.project_options["werror"] = "false"（仅 OHOS 平台），从 native 配置层面关闭警告升级；无需源码补丁，不影响上游文件。
rec_command:            # conanfile.py generate(): if self.settings.os == "OHOS": tc.project_options["werror"] = "false"
rec_auto_fix:           true
rec_impl:               recipe-option

forbid_1_pattern:       patches/.*\.patch.*-Werror|#define CMSG_NXTHDR|patch.*sys/socket\.h
forbid_1_reason:        修改 SDK 头文件或为 SDK 警告打源码补丁会污染系统头文件且无法跨设备复现
principles:             P002, P003, P011
similar_to:             E063
caused_by:
prerequisite_of:
conflicts_with:

doc_file:               E063-draft-libseat-meson-werror-off.md
