#====================================================================
# DRAFT-lcdproc-0.5.9-legacy-autotools-config-anchor-miss
#   2014 年代 config.guess/config.sub：官方 patch-autotools-ohos.pl 锚点全失配，
#   config.sub 只需改两处而非三处，只改 kernel-OS 白名单会静默产出
#   aarch64-unknown-linux-gnu-ohos
# 来源: PR feat(lcdproc): 0.5.9 适配 HarmonyOS PC（分支 feat/lcdproc-0.5.9）
# 路径: Path B（知识库扩展）—— E007 / E072 在 2014 vintage 脚本上的变体
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# 辨别性指纹：E007/E072 的通用签名在老脚本上**不出现**（脚本连报错都到不了），
# 而是先撞上"补丁脚本自评 Score 1/5 却仍然 report success"这一上游工具缺陷。
id:                     DRAFT-lcdproc-0.5.9-legacy-autotools-config-anchor-miss
trigger_tool:           configure|perl
phase:                  configuration
error_signature:        Score:\s*1/5|unable to guess system type|
                         cannot guess build type|
                         machine\s+`?[a-z0-9_-]+'?\s+not recognized|
                         OS ohos not recognized|gnu-ohos

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               autotools, configure, patch, cross-compile
match_keywords:         config.guess, config.sub, patch-autotools-ohos.pl,
                        anchor, 锚点, Score 1/5, 2014-03-23, 2014-09-11,
                        android-linux, linux-uclibc, __ANDROID__,
                        maybe_os, kernel-OS, OS 白名单, basic_os,
                        linux-ohos, aarch64-unknown-linux-gnu-ohos,
                        静默规范化, 伪造的三元组, 老 autotools
title:                  2014 年代 config.guess/config.sub：官方补丁脚本锚点全失配 + config.sub 只需两处（只改 kernel-OS 会静默产出 -gnu-ohos）
prescan_pattern:        Score:\s*1/5|__ANDROID__|android-linux|linux-uclibc
prescan_globs:          config.guess, config.sub, configure.ac, acinclude.m4

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             两条独立的失效：
                        (1) scripts/patch-autotools-ohos.pl 的所有锚点都取自
                            2015 年之后的 config.guess/config.sub 形态
                            （__ANDROID__ 宏、android-linux 分支、linux-uclibc
                            kernel-OS 条目）。lcdproc 0.5.9 的 tarball 自带
                            2014-03-23 config.guess + 2014-09-11 config.sub，
                            这些锚点**一个都不存在**，脚本自评 Score: 1/5、
                            config.sub 零改动，却仍然 report success —— 上游
                            工具把"什么都没打上"当成功。
                        (2) E072 说 config.sub 要改三处（ohos-linux→basic_os
                            映射 + OS 白名单 + kernel-OS 白名单）。2014 版
                            config.sub 的基本 OS 归一化不是靠 ohos-linux 分支，
                            而是靠末尾 case $os 的 vendor 列表，所以只有**两处**：
                              - case $maybe_os 的 kernel-OS 白名单加 linux-ohos*
                              - 末尾 case $os 的 OS 白名单加 -linux-ohos*
                            **只改第 1 处时 config.sub 不报错**，但会把
                            aarch64-unknown-linux-ohos 规范化成
                            aarch64-unknown-linux-gnu-ohos —— 一个看起来合法、
                            实则错误的 vendor，错到后面很难查。
affected_scope:         所有"tarball 自带 2013-2015 年 config.guess/config.sub"的
                        autotools 项目（不跑 autoreconf 的老包是重灾区）。
                        判据：config.sub 里 grep 不到 __ANDROID__ 也没有
                        android-linux 分支。
verification_cmd:       perl ${SKILL_ROOT}/scripts/patch-autotools-ohos.pl \
                            --dry-run config.guess config.sub 2>&1 | grep -i score;
                         # 期望 Score >= 4/5；Score 1/5 = 锚点全失配，必须手写
                         head -20 config.sub | grep -c '20[12][0-9]-';
                         grep -c '__ANDROID__\|android-linux' config.guess config.sub;
                         ./config.sub aarch64-unknown-linux-ohos   # 必须是原样输出
                         ./config.sub aarch64-unknown-linux-gnu-ohos 2>&1 | head -1  # 应报错

# ═══ Layer 3: 方案层 (Solution) ═══
rec_priority:           1
rec_approach:           patch-legacy-config-by-hand
rec_description:        锚点全失配时不要硬套官方脚本，按 vintage 自己写补丁：

                        1) 先判 vintage：head -20 config.sub 看版权年份，
                           grep -c '__ANDROID__\|android-linux' config.guess config.sub
                           —— 0 命中即 2015 前版本。
                        2) config.guess 走 E007（加 *:HarmonyOS:*:* uname 分支）
                           **加上** DRAFT-lcdproc-0.5.9-config-guess-probe-before-dispatch
                           描述的"dispatch 之前"编译器 target 探针。
                        3) config.sub 只改两处（不要找 basic_os 映射分支，
                           老版本没有）：
                             - case $maybe_os 的 kernel-OS 白名单加 linux-ohos*
                             - 末尾 case $os 的 OS 白名单加 -linux-ohos*
                        4) 两处都必须改：只改 kernel-OS 会静默产出
                           aarch64-unknown-linux-gnu-ohos。
                        5) 验证必须双向：
                             ./config.sub aarch64-unknown-linux-ohos
                             #   -> aarch64-unknown-linux-ohos（原样，不许变成 -gnu-ohos）
                             ./config.sub x86_64-linux-gnu
                             #   -> 行为不变（确认没把老三元组打坏）
rec_command:            |
  # 1) 定位两处锚点（行号随 vintage 变，用模式而不是行号）
  grep -n 'case $maybe_os in' config.sub          # kernel-OS 白名单
  grep -n 'linux-android\*' config.sub             # 该行通常在 kernel-OS 列表里
  grep -n '\-linux-android\*' config.sub          # 末尾 OS 白名单（带前导连字符）
  # 2) 两处各加一条 linux-ohos* / -linux-ohos*，然后双向验证
  ./config.sub aarch64-unknown-linux-ohos
  ./config.sub aarch64-unknown-linux-gnu-ohos    # 应当报错
rec_auto_fix:           false
rec_impl:               manual-patch

fallback_priority:      2
fallback_approach:      download-gnuconfig
fallback_description:   从 GNU config 仓库取最新版 config.guess/config.sub
                        （已含 ohos 支持）替换。代价是引入外部依赖、且新版脚本
                        对 2014 vintage 的 `AC_CANONICAL_*` 期望可能不匹配，
                        替换后必须重跑 configure 验证。
fallback_command:       |
  curl -o config.guess 'https://git.savannah.gnu.org/gitweb/?p=config.git;a=blob_plain;f=config.guess;hb=HEAD'
  curl -o config.sub   'https://git.savannah.gnu.org/gitweb/?p=config.git;a=blob_plain;f=config.sub;hb=HEAD'
  chmod +x config.guess config.sub
fallback_auto_fix:      true
fallback_impl:          download-and-replace

fallback_2_priority:    3
fallback_2_approach:    set-host-triplet
fallback_2_description:  用 --host=aarch64-unknown-linux-ohos 直接喂 configure。
                        **不推荐**：触发 E007 forbid_1（cross_compiling=yes），
                        所有 AC_RUN_IFELSE 被跳过，生成错误的 config.h。
                        仅在前两条都不通、且已评估风险时作为最后手段。
fallback_2_auto_fix:   false
fallback_2_impl:       none

# ═══ Layer 4: 原则引用 ═══
principles:             P001, P003, P011

# ═══ 关系图 ═══
causes:
caused_by:
similar_to:             E007, E072,
                        DRAFT-lcdproc-0.5.9-config-guess-probe-before-dispatch
conflicts_with:
prerequisite_of:

# ═══ 元数据 ═══
doc_file:               doc/DRAFT-lcdproc-0.5.9-legacy-autotools-config-anchor-miss.md
last_updated:           2026-09-29
source_event:           archives/l/lcdproc/0.5.9/manifest.yaml（lcdproc 0.5.9 适配，
                        补丁 0001-config-guess-ohos-triplet.patch /
                        0002-config-sub-linux-ohos.patch；
                        tarball 实测 sha256 d48a9154…f97b83，1091292 字节）
author:                 lcdproc-0.5.9 适配
related_packages:       lcdproc/0.5.9
related_knowledge:      E007, E072

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:
source_pr:
source_commit:

