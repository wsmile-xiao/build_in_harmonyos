#====================================================================
# E351 draft - OHOS Autotools 交叉工具链完整接线
# 触发事件: libXcursor 1.2.3 HarmonyOS PC 适配（archives/l/libxcursor/1.2.3）
# 主从明确：只给 --host 不做工具链接线会导致 configure 找不到依赖 / 链接失败 /
#           产物 .pc/.la 携带绝对路径不可重定位；需 PkgConfigDeps+AutotoolsDeps +
#           relocatable linker view + .pc 相对化 + 移除 .la。libxrender/0.9.12 实证。
#====================================================================

id:                     E351
trigger_tool:           autoconf|configure|pkg-config|libtool
phase:                  build
error_signature:        Package '.*' not found|configure: error: Package requirements|/bin/sh.*configure|\.la.*not found|pkg-config.*required|relocatable

severity:               3
category:               ohos, autotools, cross-compile, pkgconfig, relocatable, linker-view
match_keywords:         AutotoolsDeps, PkgConfigDeps, relocatable linker view, --host=aarch64-linux-ohos, /system/bin/sh, pcfiledir, .la removal, PKG_CONFIG_PATH, libxcursor
title:                  OHOS Autotools 交叉工具链完整接线：PkgConfigDeps+AutotoolsDeps + relocatable linker view + .pc 相对化

root_cause:             configure 靠 pkg-config/AC_CHECK_LIB 找依赖，需同时给对
                        PKG_CONFIG_PATH、--host、工具链 flags；Conan 生成的 env 默认带
                        包缓存绝对路径，直接使用使产物 .pc 携带绝对 prefix、.la 引用绝对
                        依赖，消费者不可重定位，跨机器/目录构建失败。

affected_scope:         一切依赖多个 pkg-config 模块的 autotools 库在 OHOS 的适配
                        （X11 家族 Xcursor/Xrender/Xdamage/Xcomposite 等）；同轨依赖
                        库已发布（libx11/6.4.0、libxext/6.4.0、xorgproto/2025.1）。

verification_cmd:       CI_PACKAGES="archives/l/libxcursor/1.2.3" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           autotools-cross-wiring
rec_description:        generators 用 AutotoolsDeps+PkgConfigDeps；build 目录私有
                        relocatable linker view 让链接器经可重定位视图解析依赖；交叉
                        configure --host=aarch64-linux-ohos（build≠host）经 /system/bin/sh
                        执行；安装后 .pc 用 pcfiledir 相对化、移除 .la；package_info libs
                        与 .so 文件名一致。
rec_command:            CI_PACKAGES="archives/l/libxcursor/1.2.3" zsh ci/conan/build_and_test.sh
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:       pkg-config-shim
fallback_description:   若某依赖模块无 .pc（缺包），用最小 pkg-config shim 提供 CFLAGS/LIBS
                        探针；但只解决 configure 探测，不解决产物可重定位，优先级低。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          patch-configure

forbid_1_pattern:       /system/bin/pkg-config|/usr/bin/pkg-config|prefix=/[a-zA-Z]+/\.conan
forbid_1_reason:        把包缓存/主机绝对路径写入 .pc 使产物不可重定位。
forbid_1_consequence:   消费者 configure/test_package 换目录即失败。
forbid_2_pattern:       \.la.*install|libtool.*\.la
forbid_2_reason:        .la 携带绝对路径与依赖清单，打包后污染下游链接。
forbid_2_consequence:   下游链接报找不到 .la / 依赖分叉。
principles:             P013,P014
causes:                 []
caused_by:              []
similar_to:             E350,E340
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E351.md
last_updated:           2026-08-31
source_event:           libXcursor 1.2.3 HarmonyOS PC 适配
authors:                2301_76770579 <noreply@gitcode.com>
source_pr:              6738
