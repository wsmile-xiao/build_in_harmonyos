#====================================================================
# Draft knowledge entry - eigen consumer metadata surface
# Source package: eigen/3.4.1
#====================================================================

id:                     DRAFT-eigen-3.4.1-consumer-metadata-surface
trigger_tool:           conan|cmake|shadow-ci
phase:                  packaging|testing|ci-gate
error_signature:        L5_RESULT=warn: no artifacts found|header-only|Eigen3::Eigen|pkg-config|CMakeDeps

severity:               2
category:               conan|header-only|consumer-metadata|artifact-validation
match_keywords:         eigen, header-only, include surface, generated metadata, Eigen3::Eigen, pkg-config, CMakeDeps, test_package
title:                  Header-only eigen packages need include-tree and generated consumer metadata evidence

root_cause:             A header-only package may have no bin/lib artifacts by design. The actual validation target is the
                        installed include tree plus generated consumer metadata, which downstream builds must consume.
affected_scope:         Header-only Conan packages that install CMake package files or pkg-config metadata for consumers.
verification_cmd:       CI_PACKAGES="archives/e/eigen/3.4.1" zsh ci/conan/build_and_test.sh

rec_priority:           1
rec_approach:           metadata-surface-plus-consumer-run
rec_description:        Record the include directories, generated CMake files, and pkg-config file alongside the consumer
                        test result so the reviewer can see that the package surface is real.
rec_command:            conan create archives/e/eigen/3.4.1 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
rec_auto_fix:           false
rec_impl:               test-package

fallback_priority:      2
fallback_approach:      compile-only-boundary
fallback_description:   If runtime execution is blocked, keep the metadata surface recorded and mark target execution as
                        pending instead of treating the package as artifact-free.
fallback_command:       find <package-folder> -maxdepth 4 -type d -o -type f | sort | sed -n '1,80p'
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       no artifacts found.*pass|header-only.*complete without metadata
forbid_1_reason:        A header-only package still needs its installed include tree and consumer metadata to be correct.
forbid_1_consequence:   Downstream consumers can fail while CI appears to have only seen a harmless warning.

similar_to:             [E035,E307,E309]
conflicts_with:         []
prerequisite_of:        []

