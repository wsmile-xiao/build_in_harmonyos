#====================================================================
# DRAFT-geographiclib-2.7-data-gated-ctest-recovery
# 无依赖库数据门控 ctest 测试恢复：官方数据包双重核验 + 环境变量注入 + 注册数可量化恢复
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-geographiclib-2.7-data-gated-ctest-recovery
trigger_tool:           cmake|ctest|conan|curl|tar
phase:                  testing|configuration
error_signature:        |
                        ctest -N.*[0-9]+/[0-9]+ tests registered|
                        if \(EXISTS \$\{_DATADIR\}/.*\.(pgm|wmm|egm)\)|
                        add_test.*EXISTS.*data|
                        GEOGRAPHICLIB_DATA|ARROW_TEST_DATA|PARQUET_TEST_DATA|TZDIR

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               testing, cmake, data-gating, ohos
match_keywords:         ctest, add_test, 数据门控, data-gated, EXISTS 守卫, GEOGRAPHICLIB_DATA,
                        测试数据, test data, 未实例化, not instantiated, 重新注册, 双重核验
title:                  无依赖库数据门控 ctest 测试恢复：官方数据包可取得性双重核验 + 环境变量注入 + 注册数可量化恢复（199/211→211/211）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             >
                        测试注册依赖运行时数据目录：tests/CMakeLists.txt 用
                        if (EXISTS ${_DATADIR}/<模型文件>) 守卫包裹 add_test 注册，
                        配置期求值。默认 OHOS 环境无官方数据包、也无 GEOGRAPHICLIB_DATA
                        指向 → 守卫分支整体跳过，测试目标不生成、不注册、不执行
                        （ctest -N 注册数 199/211，12 项 Geoid/Magnetic/Gravity 数据门控
                        测试从未实例化）。属"数据门控注册机制"（数据缺失→注册缺失），
                        区别于依赖缺失（配方级）与编译门控（宏/条件编译互斥）。
affected_scope:         无依赖库的离线地理/科学数据门控测试体系（add_test 注册守卫依赖
                        运行时数据目录、数据可从官方源获取、注入环境变量后测试目标重新注册）；
                        geographiclib 2.7（GeoidEval0/MagneticField0-6/Gravity0-3 等 12 项）
verification_cmd:       |
                        # 1) 注册数可量化（未恢复 vs 恢复后）
                        ctest -N | grep -c 'Test #'         # 199/211 → 211
                        # 2) 官方数据包可取得性双重核验（首次判定 + 最终回报前各一次）
                        curl -sIL https://downloads.sourceforge.net/project/geographiclib/geoids-distrib/egm96-5.tar.bz2 | grep -c '200 OK'
                        # 3) 全量运行
                        export GEOGRAPHICLIB_DATA=<数据目录>; ctest --output-on-failure
                        #    → 211/211 Passed, 0 failed

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           data-package-dual-check-and-env-inject
rec_description:        >
                        1) 官方数据包可取得性双重核验（首次判定 + 最终回报前各一次）：
                        curl -sIL 官方 downloads.sourceforge.net URL 确认 HTTP 200，
                        且解压后数据文件存在可读；
                        2) 下载并注入：curl -sL -o <pkg>.tar.bz2 <官方URL> && tar xjf，
                        设置 GEOGRAPHICLIB_DATA=<数据目录>（或 cmake
                        -DGEOGRAPHICLIB_DATA=...）；
                        3) 重配置+重构建+全量运行：ctest --output-on-failure，
                        验证注册数 199→211、211/211 通过；12 项逐入口记录命令/cwd/退出码/日志。
rec_command:            curl -sL -o egm96-5.tar.bz2 https://downloads.sourceforge.net/project/geographiclib/geoids-distrib/egm96-5.tar.bz2 && tar xjf egm96-5.tar.bz2 && export GEOGRAPHICLIB_DATA=$PWD && cmake -S . -B build -DGEOGRAPHICLIB_DATA=$PWD && ctest --test-dir build --output-on-failure
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      consumer-test-package-plus-difference-report
fallback_description:   若官方源不可达或数据为商业/受限许可导致恢复不可行：不强行恢复，
                        提供 Conan test_package 运行时 API 验证兜底，并将未实例化/未执行
                        子集的缺口、数据来源与恢复条件如实写入 reports 与回报
                        （与 E292 fallback 一致：记录差异而非伪造通过）。
fallback_command:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 && grep -iE 'Passed|failed' <test_package日志>
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       GEOGRAPHICLIB_DATA=.*(currentUser|/storage/|file://|gh-proxy|ghfast)
forbid_1_reason:        执行端本地绝对路径/镜像代理 URL 泄露进提交内容（R39/PF7 禁止）。
forbid_1_consequence:   提交内容命中禁用标记被 W3/JC1/PR 门禁拦截，或数据恢复不可复现。
forbid_2_pattern:       ctest 未恢复注册却声明 100% 通过
forbid_2_reason:        未实例化项不得计为通过（双口径台账铁则），注册数必须可量化核对。
forbid_2_consequence:   虚报通过率 → W4 欺骗类门禁 fail。

# ═══ Layer 4: 原则引用 (Principles) ═══
principles:             [P013, P005]

# ═══ 关系图 (Relations) ═══
similar_to:             [E292]
caused_by:              []
conflicts_with:         []
prerequisite_of:        []

