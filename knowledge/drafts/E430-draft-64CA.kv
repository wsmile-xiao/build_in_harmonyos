#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E430.kv，填写各字段
# 对应的人类文档: doc/E430.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E430
trigger_tool: conan
phase: configure
error_signature: configure: error: X11 library is required|checking for main in -lX11... no|undefined reference

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: high
category: build-system
match_keywords: autotoolstoolchain,cppflags,ldflags,ac_check_lib,conan 2.29,dependencies,-lX11
title: Conan 2.29 AutotoolsToolchain 不向 CPPFLAGS/LDFLAGS 下发依赖的 -I/-L

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan 2.29 的 conan.tools.gnu.AutotoolsToolchain 生成的 conanautotoolstoolchain.sh 中 LDFLAGS 为空、CPPFLAGS 仅含 defines，不包含 dependencies.host 的 includedirs/libdirs（那是 AutotoolsDeps 的职责，但 AutotoolsToolchain 不自动组合）。上游 configure.ac 用 AC_CHECK_LIB([X11]) / AC_CHECK_HEADER 直接探测而非 pkg-config 时，探测必然失败并报 'X11 library is required'。另注意：configure 的 AC_CHECK_SIZEOF 会编译并运行 conftest，依赖共享库不在 LD_LIBRARY_PATH 时 conftest 退出 127，SIZEOF_UNSIGNED_INT/SIZEOF_UNSIGNED_LONG 静默变为 0
affected_scope: 所有使用 AutotoolsToolchain 且上游 configure 直接 AC_CHECK_LIB/AC_CHECK_HEADER 探测 Conan 管理依赖的 autotools 配方（HarmonyOS PC 与其他平台均受影响）
verification_cmd: grep -n LDFLAGS <build_folder>/build-release/conan/conanautotoolstoolchain.sh

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: explicit-flags-in-generate
rec_description: 在 conanfile.py 的 generate() 中遍历 self.dependencies.host，把 cpp_info.includedirs 拼进 CPPFLAGS（-I 前缀）、libdirs 拼进 LDFLAGS（-L 前缀），经 toolchain.environment().define() 注入后再 toolchain.generate(env=...)；同时把各依赖 libdir 加入 LD_LIBRARY_PATH 供 conftest 运行，把 PkgConfigDeps 的生成目录加进 PKG_CONFIG_PATH（依赖间有 Requires 时 configure 报 'Package xcb, required by x11, not found'）
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: none
rec_impl: 在 generate() 中: flags_cpp=[('-I'+os.path.join(d.package_folder,i)) for d in deps for i in d.cpp_info.includedirs]; flags_ld=[('-L'+os.path.join(d.package_folder,l)) for d in deps for l in d.cpp_info.libdirs]; environment.define('CPPFLAGS',' '.join(flags_cpp)); environment.define('LDFLAGS',' '.join(flags_ld)); 并 append_path LD_LIBRARY_PATH 与 PKG_CONFIG_PATH

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

