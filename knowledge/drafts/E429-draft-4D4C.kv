id: E429
trigger_tool: configure|make|clang
phase: configuration|compilation
error_signature: 'config\.status:.*Permission denied|subs1\.awk: Permission denied|sockaddr_storage.*redefinition'
severity: 2
category: autotools,hmdfs,ohos,headers,compat
match_keywords: config.status,subs1.awk,Permission denied,umask 077,sockaddr_storage,linux/socket.h,sys/socket.h
title: OHOS HMDFS Autotools temporary-file permissions and socket-header conflicts
root_cause: Autotools creates config.status temporary files with umask 077 on HMDFS, and OHOS exposes overlapping POSIX/Linux socket definitions.
affected_scope: Autotools C libraries built on HarmonyOS PC arm64 with OHOS SDK headers and HMDFS workspaces.
verification_cmd: OHC_W3_TIMEOUT=3600 zsh ci/conan/build_and_test.sh archives/l/libnftnl/1.3.1
rec_priority: 1
rec_approach: patch-source
rec_description: Apply a minimal configure umask patch and pass OHOS socket-header compatibility defines through the Conan toolchain.
rec_command: sed -i 's/umask 077/umask 022/g' configure
rec_auto_fix: false
rec_impl: refresh-patch
fallback_priority: 2
fallback_approach: environment
fallback_description: Build from a writable non-HMDFS workspace with an explicit OHOS temporary directory.
fallback_command: export TMPDIR="$HOME/tmp"; mkdir -p "$TMPDIR"
fallback_auto_fix: false
fallback_impl: manual
forbid_1_pattern: file://.*conandata\.yml|define.*__OHOS__.*patch
forbid_1_reason: Do not submit local source URLs or platform macro additions in patches when a Conan toolchain define is sufficient.
forbid_1_consequence: CI cannot reproduce the recipe or the patch violates the platform-compatibility patch rule.
principles: P003,P008,P015
causes: []
caused_by: []
similar_to: [E011,E119]
conflicts_with: []
prerequisite_of: []
doc_file: doc/E429.md
last_updated: 2026-09-10
source_event: libnftnl/1.3.1 OHOS Conan/W3 validation
authors: AtomCode <noreply@atomgit.com>
source_pr:
source_commit:
metrics_success_count: 1
metrics_fail_count: 0
metrics_confidence: 1.0
metrics_last_used: 2026-09-10
