#====================================================================
# DRAFT-nob.h-3.9.0-err2out-merge-order-libc-buffering
#   头文件库自带 runner 的 err2out 合并流顺序差异归因
#   （OHOS musl 系 libc stdio 缓冲策略 vs glibc 录制快照）
# 来源: PR feat/nob.h-3.9.0（nob.h 3.9.0 适配 HarmonyOS PC, pc7-47）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-nob.h-3.9.0-err2out-merge-order-libc-buffering
trigger_tool:           clang|cc|test-runner|make-check
phase:                  testing
error_signature:        UNEXPECTED OUTPUT!|diff .*\.exp .*\.out|^[0-9]+a[0-9,]+$|^[0-9]+d[0-9,]+$|
                        合并流|err2out|顺序相反|stderr.*stdout|快照比对

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               platform, testing, stdio, libc, header-only
match_keywords:         err2out, 合并流, stdout, stderr, 管道, 顺序差异,
                        libc 缓冲, musl, glibc, 快照比对, header-only,
                        nob.h, single-header, runner 驱动, 内容一致仅顺序不同
title:                  头文件库自带 runner 的 err2out 合并流顺序差异归因：
                        OHOS(musl 系) libc 下 stderr 无缓冲先落、stdout 全缓冲后落，
                        与 glibc 录制快照顺序相反；内容一致 + 仅顺序移动 → 归因
                        libc 缓冲策略，不属库缺陷，判据与 E658 同族、触发面扩展

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  chain 类用例以 err2out=true（或 2>&1）把 stdout/stderr 合并进同一管道后与
  上游 .stdout.txt 快照全文比对。OHOS(libc=musl 系) stderr 无缓冲立即写、
  stdout 对管道全缓冲退出时 flush，合并流到达顺序与 glibc 录制环境相反。
  内容逐字节一致，仅顺序敏感，非功能缺陷。
affected_scope: >
  头文件库/无二进制库 + 自带 runner 测试驱动（`<cc> -o runner *.c && ./runner`）
  + errout/2>&1 管道合并 + 快照全文比对的上游测试套；也适用于 autotools
  make check 中 `2>&1 | diff .exp` 形态（与 DRAFT-E658 重叠区）。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           attribute-to-libc-buffering-not-failing-library
rec_description: >
  1) 先 diff 确认 out 与 exp 行集合完全一致、仅顺序移动（a/d 移动块，无内容
  差异行）；2) 命中即归因 libc stdio 缓冲策略，不判库门禁失败、不伪造通过、
  不改上游测试；3) 如实计入上游用例分母（通过数/全量发现数），台账注明恢复
  条件；4) 若被测物有编译产物且允许最小补丁，可参考 E658 以
  setvbuf(stdout, NULL, _IOFBF, BUFSIZ) 统一缓冲（头文件库场景无法注入）。
rec_command: >
  diff -u tests/<name>.stdout.txt <(./build/<name>)   # 确认仅顺序移动
verification: >
  nob.h 3.9.0：chain 3× 确定性 ORDER_DIFF、内容逐字节一致；其余 18 用例
  PASS；全量 18/19 = 94.7%（2026-09-29 采信轮，OHOS aarch64）。
related: >
  similar_to = DRAFT-E658-scrub-musl-stdout-line-buffered-exp-interleave
  （同族根因：libc stdio 缓冲策略导致快照顺序差异；E658 触发面=make check
  `2>&1 |` 诊断行交错+setvbuf 修复；本条=runner 驱动 err2out 合并流整体顺序+
  无注入点归因路径）