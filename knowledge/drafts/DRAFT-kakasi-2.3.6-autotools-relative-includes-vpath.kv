#====================================================================
# DRAFT-kakasi-2.3.6-autotools-relative-includes-vpath
# 触发事件: kakasi 2.3.6 HarmonyOS PC shadow CI
# 主从明确: lib/Makefile.am 相对 INCLUDES (-I.. -I../src) 在 out-of-source
#           VPATH 构建下指向 build 目录而非源目录，导致 lib/*.c 报
#           fatal error: 'xxx.h' file not found；改 in-source 构建解决
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-kakasi-2.3.6-autotools-relative-includes-vpath
source_lib:             kakasi 2.3.6
trigger_tool:           clang|make|autotools
phase:                  compilation
error_signature:        fatal error: '.*\.h' file not found|
                        -I\.\./-I\.\./src|INCLUDES = -I\.\. -I\.\./src

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               autotools, build-system, portability
match_keywords:         INCLUDES, -I.., -I../src, VPATH, out-of-source,
                        build-release, kakasi.h not found, in-source,
                        folders.build, relative include path, automake 1.4
title:                  autotools 相对 INCLUDES 在 out-of-source VPATH 下失效时改 in-source 构建

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  autotools 老项目（AUTOMAKE_OPTIONS = 1.x）在 Makefile.am 里手写相对
  头文件搜索路径（如 lib/Makefile.am 的 INCLUDES = -I.. -I../src），automake
  不会把这种相对路径映射到源目录。Conan basic_layout 默认 out-of-source
  （源码在 b/、构建在 b/build-release/），make 在 build-release/lib 执行时
  -I../src 被解析为 build-release/src（不存在），而头文件在源树 b/src/，
  于是跨目录的 lib/*.c 报 "fatal error: 'xxx.h' file not found"（同目录的
  src/ 工具正常）。
affected_scope: >
  autotools 多目录项目 + 相对 -I 路径，在任何 out-of-source/VPATH 构建下；
  尤其 AUTOMAKE_OPTIONS = 1.x 的老库。
verification_cmd: >
  grep -n "INCLUDES" */Makefile.am && grep -n "fatal error.*file not found" <build-log>

# ═══ Layer 3: 方案层 (Solution) ═══
rec_priority:           1
rec_approach:           insource-build-relative-includes
rec_description: >
  在 Conan layout() 里设置 self.folders.build = "."，让构建回到源码树内，
  使相对 -I../src 恢复指向源目录（与 zlib 配方同款）；build() 里 configure
  路径相应改为 self.build_folder 下的 configure。
rec_command: >
  self.folders.build = "."
rec_auto_fix:           false
rec_impl:               manual-layout-in-source

fallback_priority:      2
fallback_approach:      patch-makefile-srcdir
fallback_description: >
  若必须保留 VPATH 构建，则打补丁把相对 INCLUDES 改为 $(top_srcdir)/
  $(srcdir) 绝对源目录变量，使 VPATH 下仍指向源树。
fallback_command:       sed -i 's|INCLUDES = -I.. -I../src|INCLUDES = -I$(top_srcdir) -I$(top_srcdir)/src|' lib/Makefile.am
fallback_auto_fix:      false
fallback_impl:          patch-makefile-am

forbid_1_pattern:       机械地给所有 VPATH 构建都改 in-source
forbid_1_reason:         某些项目（如 E434 copystamp）明确需要 VPATH 构建
forbid_1_consequence:   引入新的 VPATH 相关失败，且掩盖真正的路径问题

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

