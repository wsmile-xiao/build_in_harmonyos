#====================================================================
# DRAFT-lzham-1.0-stable1-stdint-int-min-macro — musl stdint.h 将
#   INT32_MIN/INT32_MAX 等定义为宏，与旧 C++ 自声明常量冲突
# 对应人类文档: knowledge/drafts/DRAFT-lzham-1.0-stable1-stdint-int-min-macro.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: lzham 1.0-stable1 适配 HarmonyOS PC（2015 年代 C++03 代码）
#====================================================================

id:                     DRAFT-lzham-1.0-stable1-stdint-int-min-macro
trigger_tool:           cmake|clang|clang++|make
phase:                  compilation
error_signature:        expected unqualified-id.*INT32_MIN|
                         expected ')'  .*INT32_MIN|
                         expanded from macro 'INT32_MIN'|
                         const int32 INT32_MIN.*=.*-2147483647|
                         INT8_MIN|INT16_MIN|INT64_MIN|UINT32_MAX.*macro

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               compat, libc, headers, musl, portability, macros
match_keywords:         INT32_MIN, INT32_MAX, INT8_MIN, INT64_MIN, stdint.h,
                        musl, macro, expected unqualified-id, expected ')',
                        __OHOS__, #undef, const int32, old C++ code,
                        C++03, lzham_types.h
title:                  musl stdint.h 的 INTxx_MIN/INTxx_MAX 宏与旧 C++ 代码
                         自声明同名常量冲突——按平台追加 #undef 守卫

# ═══ Layer 2: 诊断层 ═══
root_cause:             OpenHarmony 的 musl stdint.h 将 INT8_MIN/INT16_MIN/
                         INT32_MIN/INT32_MAX/INT64_MIN/INT64_MAX 等定义为宏
                         （如 #define INT32_MIN (-1-0x7fffffff)）。2015 年代
                         C++ 代码（如 lzham_types.h）在 namespace 内自声明
                         `const int32 INT32_MIN = (-2147483647 - 1);` 等常量。
                         预处理器先展开宏，声明退化为 `const int32 (-1-0x7fffffff) = ...`
                         编译报 expected ')' / expected unqualified-id。
                         glibc 在 C++03 下不展开这些宏（或行为不同），故上游在
                         glibc 环境正常；lzham 上游已为 Apple/FreeBSD/NetBSD
                         提供 #undef 守卫，但未覆盖 OHOS/musl
affected_scope:         在 OHOS/HarmonyOS 上编译自声明 INTxx_MIN/MAX（或
                         UINTxx_MIN/MAX）等标准宏同名常量的旧 C/C++ 库；
                         lzham 1.0-stable1 即此类
verification_cmd:       修复前: cmake --build <ohos-build> 报 lzham_types.h
                         expected unqualified-id（INT32_MIN/INT32_MAX 行）；
                         修复后: conan create archives/l/lzham/1.0-stable1
                         -pr:h=ci/conan/profiles/ohos-aarch64
                         -pr:b=ci/conan/profiles/ohos-aarch64 构建成功

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           undef-guard-extension
rec_description:        沿用上游既有模式，把平台守卫从
                         `#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__NetBSD__)`
                         扩展为追加 `|| defined(__OHOS__)`，在声明前 #undef 这些
                         宏。与上游 Apple/BSD 处理完全同构，改动 1 行，
                         零行为变化
rec_command:            (lzham_types.h)
                         #if defined(__APPLE__) || defined(__FreeBSD__) ||
                             defined(__NetBSD__) || defined(__OHOS__)
                            #undef INT8_MIN  ...  #undef INT64_MAX
                         #endif
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      rename-constants
fallback_description:   若库大量引用这些常量名（如 int_traits 模板参数），改名为
                         cINT32_MIN 等（devel 分支即采用 c 前缀改名）——
                         改动面大，仅当 undef 守卫不可行时使用
fallback_command:       (批量改名) INT32_MIN -> cINT32_MIN 等
fallback_auto_fix:      false
fallback_impl:          source-patch

# ★ 禁止策略 ★
forbid_1_pattern:       改 .c 为 .cpp|忽略.*expected unqualified-id|删除.*INT32_MIN.*行
forbid_1_reason:        这些常量被 int_traits/代码引用，删除会改变语义；跳过掩盖平台差异
forbid_1_consequence:   后续引用处编译失败或行为改变，被规则 4 打回
forbid_2_pattern:       用 -UINT32_MIN.*绕过
forbid_2_reason:        命令行 -U 只对 TU 生效且易漏；守卫更贴近上游模式、可随补丁交付
forbid_2_consequence:   多 TU/条件编译下不一致，复现困难

# ═══ Layer 4: 原则引用 ═══
principles:
causes:                 []
caused_by:              []
similar_to:             [E133]
conflicts_with:         []
prerequisite_of:        []
doc_file:               drafts/DRAFT-lzham-1.0-stable1-stdint-int-min-macro.md
last_updated:           2026-09-08
source_event:           lzham 1.0-stable1 r01 OHOS/aarch64: lzham_types.h 编译
                         expected unqualified-id，__OHOS__ 守卫追加后通过
authors:                pc4-3
source_pr:              (lzham 1.0-stable1 知识库扩展 PR)
metrics_success_count:  1
metrics_fail_count:     1
metrics_confidence:     0.6
