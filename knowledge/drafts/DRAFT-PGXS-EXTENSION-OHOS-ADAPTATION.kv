#====================================================================
# DRAFT-PGXS-EXTENSION-OHOS-ADAPTATION — PGXS 扩展 OHOS 适配共性模式
# 来源事件: pg-crash 0.3 HarmonyOS 适配（零补丁编译通过 + 真实集群验证）
# 适用家族: pg-crash/pgvector/pg_cron/pg_repack/pgq/pgqd/pgfincore/
#           pg-ivm/pg-gvm/pglogical 等全部 PGXS 型 PostgreSQL 扩展
#====================================================================

id:                     DRAFT-PGXS-EXTENSION-OHOS-ADAPTATION
trigger_tool:           make|clang|ld
phase:                  configuration|compilation|linking
error_signature:        c\.h file not found|postgres\.h.*No such file|pgxs\.mk.*No such file|pg_config: command not found|TRANSFORMATIONS.*PG_CONFIG|fatal error.*postgres\.h
severity:               3
category:               build-system, pgxs, postgresql, headers, detection
match_keywords:         PGXS, pg_config, pgxs.mk, MODULE_big, postgres.h, fmgr.h, PG_MODULE_MAGIC, shared_preload_libraries, extension_control_path, dynamic_library_path, enable_rpath, tool_requires
title:                  PGXS 型 PostgreSQL 扩展依赖服务端开发树（pg_config+PGXS+server 头），须以 tool_requires 接入 conan postgresql 包并注入 PG_CONFIG，不能手拼 -I

root_cause:             PGXS 扩展的 Makefile 以 `PGXS := $(shell $(PG_CONFIG) --pgxs); include $(PGXS)` 驱动，编译器/CFLAGS/头路径/安装路径全部由 pg_config 输出；扩展源码硬包含服务端头（postgres.h、fmgr.h、PG_MODULE_MAGIC），普通 libpq 客户端包不含这些头。OHOS 无系统 postgresql，离线手拼 -I 不可维护（本仓 conan 包 server 头布局为 include/postgresql/server，与标准 include/server 不同，手拼极易错）。
affected_scope:         全部 PGXS 型 PostgreSQL 扩展（检测：Makefile 命中 PGXS 模式 + C 源包含服务端头）；积分赛 p/pg 批次中 16+ 个包属此家族。
verification_cmd:       python3 knowledge/drafts/detect_pgxs.py <source-dir> --json   # 命中输出 pgxs_extension:true + 构建文件/源码证据

rec_priority:           1
rec_approach:           tool-requires-postgresql-inject-pg-config
rec_description:        配方以 tool_requires 声明 postgresql/<server 版本>（构建期/测试期依赖，非链接依赖）；build() 从依赖包解析 pg_config 绝对路径并注入 make：make PG_CONFIG="<abs>" enable_rpath=（关掉 PGXS 默认 rpath，防构建机路径进 RUNPATH）；编译器由 pg_config --cc 提供，不重复注入 CC。打包只收 lib/*.so 与 extension/ 资产（MODULE_big 型上游无 .control/.sql，不得虚构）。settings.rm_safe("os.version") 兼容 OHOS profile。
rec_command:            make PG_CONFIG="<postgresql-package>/bin/pg_config" enable_rpath=
rec_auto_fix:           false
rec_impl:               conan-recipe-pgxs

fallback_priority:      2
fallback_approach:      manual-include-override
fallback_description:   若无法使用 tool_requires（极老版本 conan），手拼 -I<pg>/include/postgresql/server + -fPIC -shared 绕过 PGXS，仅限单翻译单元扩展；多单元或含 PGXS 安装钩子的扩展不可用。
fallback_command:       clang -O2 -fPIC -shared -I<pg>/include -I<pg>/include/postgresql/server <src>.c -o <module>.so
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       PG_CONFIG\s*=\s*pg_config(?!\s*")|vendor.*postgres.*source|-I.*include/server(?!\w)
forbid_1_reason:        依赖 PATH 上的裸 pg_config 会命中构建机系统安装（OHOS 构建机没有）；vendoring postgresql 源码树重复维护；include/server 是标准布局而本仓是 include/postgresql/server，手拼必错。
forbid_1_consequence:   构建失败或产出带构建机路径 RUNPATH 的不可重定位制品；CI 环境与本地行为不一致。

principles:             []

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

