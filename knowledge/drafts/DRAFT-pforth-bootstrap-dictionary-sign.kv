#====================================================================
# DRAFT-pforth-bootstrap-dictionary-sign.kv
# pforth 2.0.1 OHOS 适配：轻量解释器 bootstrap（运行内核生成 dictionary）
# 的 Makefile target 分步签名模式，及 RESIZE-FILE ftruncate 补丁。
# 与 E325(vlang)/DRAFT-avr-gcc(gcc) 的编译器自举区分：
# pforth 是"运行解释器生成数据文件"，非"重新编译自身"，且用 Makefile
# target 分步（pfdicapp → pforthapp）而非显式多阶段。
#====================================================================

# Layer 0: error / trigger surface
id:                     DRAFT-pforth-bootstrap-dictionary-sign
trigger_tool:           conan|make|clang|binary-sign-tool|test_package
phase:                  build|package|testing
error_signature:        pforth.*Permission denied|binary-sign-tool|pforth.dic|pfdicdat.h|RESIZE-FILE.*fail|make test.*Error 40

# Layer 1: identification
severity:               2
category:               ohos, bootstrap, elf-signing, makefile, conan
match_keywords:         pforth, Forth, interpreter, bootstrap, dictionary, pforth.dic, pfdicdat.h, pforth_standalone, Makefile target, pfdicapp, pforthapp, binary-sign-tool, selfSign, ftruncate, RESIZE-FILE, __OHOS__, application package_type, commands.json
title:                  pforth 2.0.1：解释器 bootstrap（运行内核生成 dictionary）的 Makefile target 分步签名

root_cause:             |
  pforth 是 ANSI C 写的 Forth 解释器，构建是两步引导（bootstrap）：
  1) 编译 C 内核得到 pforth 可执行文件；
  2) 运行 pforth 编译 fth/system.fth 生成 pforth.dic（dictionary）与 pfdicdat.h（C 头）；
  3) 编译 pforth_standalone（内置 dictionary 的独立可执行文件）。
  OHOS 内核拒绝执行未签名的外来 ELF（E077/E135），而步骤 2 必须运行刚编译的
  pforth，因此必须在"运行它生成 dictionary"之前对 pforth 做 binary-sign-tool
  自签，不能等 make 全部完成或 package() 再批量签名（DRAFT-avr-gcc 同型问题）。
  上游 Makefile 提供 pfdicapp / pforthapp 两个 target，天然支持分步：
  make pfdicapp → 签名 pforth → make pforthapp → 签名 pforth_standalone。

affected_scope:         OHOS 上"先编译工具、再运行工具生成数据/头文件、最后编译最终产物"的
                        轻量 bootstrap 项目（解释器、代码生成器、词典/模板生成器）

verification_cmd:       |
  CI_PACKAGES="archives/p/pforth/2.0.1" zsh ci/conan/build_and_test.sh
  # 关键产物：bin/pforth、bin/pforth.dic、bin/pforth_standalone

rec_priority:           1
rec_approach:           makefile-target-staged-sign
rec_description:        |
  1) 用 Makefile 的分步 target 而非 make all：
     make pfdicapp CC=clang -j1        # 仅编译 pforth
  2) settings.os == "OHOS" 时对中间产物 pforth 做 binary-sign-tool -selfSign 1 并 chmod a+x；
  3) 再 make pforthapp CC=clang -j1    # 运行已签名 pforth 生成 dictionary + 编译 standalone；
  4) 对最终产物 pforth_standalone 做同样签名；
  5) 最后 make test（运行 6 个 Forth 脚本，失败退出码 40）。
  编译器从 Conan conf 获取（R33），make 统一 -j1（R9）。
rec_command:            |
  # 签名工具固定路径（DevBox 环境）
  /data/service/hnp/bin/binary-sign-tool sign -inFile <elf> -outFile <elf> -selfSign 1
  chmod a+x <elf>
rec_auto_fix:           false
rec_impl:               conan-recipe-staged-sign

fallback_priority:      0
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:       false
fallback_impl:

forbid_1_pattern:       把 pforth 等轻量 bootstrap 当普通单步 make 处理（make all 一步到位）
forbid_1_reason:         make all 会在中途运行未签名的 pforth 生成 dictionary，OHOS 上直接
                         Permission denied，且失败点难定位。
forbid_1_consequence:   dictionary 生成失败，或误判为源码编译错误。

forbid_2_pattern:       在 package() 才批量签名
forbid_2_reason:         bootstrap 的中间产物（pforth）必须在运行前签名，package() 阶段已太晚。
forbid_2_consequence:   构建期运行未签名 ELF 被内核拒绝，构建失败。

forbid_3_pattern:       把 pforth_standalone 与 pforth 分开打包而漏掉 pforth.dic
forbid_3_reason:        非 standalone 的 pforth 运行时按默认名 "pforth.dic" 查找 dictionary，
                         必须与可执行文件同目录（bin/）。
forbid_3_consequence:   消费者运行 bin/pforth 找不到 dictionary，功能缺失。

principles:             P017, P004

causes:                 []
caused_by:              []
similar_to:             [E325, E077, E135]
conflicts_with:         []
prerequisite_of:        []

