#====================================================================
# DRAFT-gli-0.8.2.0-strstr-pointer-compare-clang15.kv
# gli 0.8.2.0 旧代码 strstr(...) > 0 指针与 0 的有序比较在 clang 15 下为编译错误
# Draft only. Do not promote into knowledge/graph until promoted.
#====================================================================

id:                     DRAFT-gli-0.8.2.0-strstr-pointer-compare-clang15
trigger_tool:           clang|make
phase:                  compilation
error_signature:        ordered comparison between pointer and zero|
                         ordered comparison between pointer and integer|
                         'const char \*' and 'int'|strstr.*> 0
severity:               2
category:               compat, compiler, portability, legacy
match_keywords:         strstr, strchr, memchr, pointer, ordered comparison,
                         clang 15, null, NULL, nullptr, legacy code, > 0, < 0
title:                  旧 C/C++ 代码 `strstr/strchr(...) > 0` 指针有序比较在 clang 15 下报 error，改 `!= NULL`
root_cause:             gli 0.8.2.0（2016）测试代码用
                         `if(std::strstr(FilenameDst, ".dds") > 0 || ...)`
                         把 strstr 的指针返回值与 0 做 `>` 有序比较。clang 15 对
                         指针与零/整数的有序比较（>/</>=/<=）按 error 处理
                         （"ordered comparison between pointer and zero"），
                         导致 test/core/core_convert.cpp 编译失败。
rec_approach:           指针有序比较改判空比较
rec_description:        将 `ptr > 0` / `ptr < 0` 改为 `ptr != NULL`（或 `!= nullptr`）；
                         相等比较（== 0 / != 0）不受影响，无需修改。
rec_command: |
  # gli 0.8.2.0 实例
  sed -i 's/std::strstr(FilenameDst, "\.dds") > 0/std::strstr(FilenameDst, ".dds") != NULL/; s/std::strstr(FilenameDst, "\.ktx") > 0/std::strstr(FilenameDst, ".ktx") != NULL/' test/core/core_convert.cpp
verification_cmd:       make -j2 && ctest  # 修复后全量 0 错误，70/70 通过
affected_scope:         任何将 strstr/strchr/memchr 等指针返回值与 0 做有序比较的旧 C/C++ 代码在 clang 15+ 下
rec_priority:           1
rec_auto_fix:           true
rec_impl:               source-patch
keywords:               strstr, pointer, ordered comparison, clang 15, NULL, legacy
