#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E545.kv，填写各字段
# 对应的人类文档: doc/E545.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E545
trigger_tool:           cmake|install|binary-sign-tool
phase:                  installation|post-install
error_signature: Operation not permitted.*bin/|rc=126|Set non-toolchain portion of runtime path|codesign.*install|exec.*Operation not permitted

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: ohos,cmake,conan,packaging,elfsign
match_keywords: cmake --install, CMAKE_INSTALL_RPATH, codesign, ELF 重写, rc=126, Operation not permitted, conan package, 构建树可执行制品不可执行, binary-sign-tool, 自签名, Qt6 应用
title: CMake install 去掉 RPATH 重写 ELF 致 .codesign 失效——制品包内二进制 exec 报 Operation not permitted(rc=126)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: conan create 成功后，构建树内的二进制可正常执行，但制品包 bin/ 内同一二进制 exec 报 Operation not permitted（rc=126）。根因：CMake 的 install 阶段会为去掉构建期 RPATH 而重写 ELF（日志可见 Set non-toolchain portion of runtime path ... to ""），任何 ELF 重写都会使链接器写入的 .codesign 段失效，OHOS 内核拒绝加载签名失效的 ELF，故 package() 内 cmake.install() 之后必须重新自签名。
affected_scope: 所有在 OHOS 上用 CMake 构建并打包可执行文件的 Conan 配方（package_type=application / bindirs=bin），尤其 Qt6 GUI 应用；只要 install 阶段去掉构建 RPATH 就会触发
verification_cmd: conan create . -pr:h=ci/conan/profiles/ohos-aarch64 --build=missing && $(conan cache path <ref>)/bin/<binary> --version; echo rc=$?

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach:           post-install-script
rec_description: 在 conanfile.py 的 package() 中把签名作为最后一步：cmake.install()（以及任何 strip/patchelf/objcopy 改写）完成后，遍历 self.package_folder 对所有 ELF 执行 E077 四步——llvm-objcopy --remove-section .codesign → binary-sign-tool sign -inFile X -outFile X -selfSign 1 → os.chmod(mode | 0o111) 恢复执行位；只对 os == "OHOS" 生效，非 ELF 与符号链接跳过。
rec_command: llvm-objcopy --remove-section .codesign $f && binary-sign-tool sign -inFile $f -outFile $f -selfSign 1 && chmod a+x $f
rec_auto_fix:           false
rec_impl:               post-install-script

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:             P017, P019

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             E077
conflicts_with:         []
prerequisite_of:        []

