#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E571.kv，填写各字段
# 对应的人类文档: doc/E571.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E571
trigger_tool: conan create / make install
phase: install→package
error_signature: package 内缺少 etc/cpu.conf（或文件装到了宿主 /etc 而非包的 DESTDIR 下）；doc/Makefile.in 的 install-data-local 报 "cpu.conf: No such file or directory"（out-of-tree 时）

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: high
category: build-system, autotools, packaging
match_keywords: DESTDIR, install-data-local, mkinstalldirs, out-of-tree, srcdir, INSTALL_DATA
title: 手写 install-data-local 缺 DESTDIR 且未用 srcdir 前缀，conan staging 下装错位置或找不到源文件

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 老 autotools 工程的手写 install-data-local 规则假设两点：①安装目标是宿主根(缺 $(DESTDIR) 前缀)；②源文件在构建目录中(直接用 cpu.conf 而非 $(srcdir)/cpu.conf)。conan 走 out-of-tree 构建 + DESTDIR staging，两个假设同时失效：文件找不到 或 静默装进宿主 /etc（污染构建机）
affected_scope: 所有用自定义 install-data-local/install-exec-local 规则的老 autotools 包（cpu 1.4.3 实测 doc/Makefile.in）；症状随构建目录与源码树分离程度而定，CI 干净环境必现
verification_cmd: make install DESTDIR=$TEST_PREFIX 后检查 $TEST_PREFIX/etc/cpu.conf 是否存在，并确认宿主 /etc/cpu.conf 未被写入

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: patch-install-rule
rec_description: 以最小补丁修正 install-data-local：源文件加 $(srcdir)/ 前缀、目标补 $(DESTDIR) 前缀（cpu 的 0004-doc-Makefile.in.patch 即此形态，可上游化）
rec_command: patch doc/Makefile.in: "cpu.conf $(sysconfdir)/cpu.conf" → "$(srcdir)/cpu.conf $(DESTDIR)$(sysconfdir)/cpu.conf"
rec_auto_fix: false
rec_impl: patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P005

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

