#====================================================================
# E543 draft - C 库源码树自带 *.rockspec 触发 lang-preflight 误判 mixed
# 触发事件: hashchop 0.8-0 HarmonyOS PC 适配（archives/h/hashchop/0.8-0）
# 主从明确：这是语言预检（R47/lang_detect.py）的误报判别知识，与 E339 等
#           构建期知识正交；上游 Lua 生态 C 库（lpeg 同类）适配选型时先查本条。
#====================================================================

id:                     E543
trigger_tool:           ohc-run.py lang-preflight
phase:                  preflight
error_signature:        "语言不匹配: task=c(或cpp), detected=mixed → env_unsupported|manifest=lua 但统计 c 占"

severity:               2
category:               lang-preflight, rockspec, luarocks, lua, c, mixed, env_unsupported, false-positive
match_keywords:         rockspec, lang-preflight, detected=mixed, env_unsupported, luarocks, lang_detect, 语言预检, manifest 与统计矛盾
title:                  C/C++ 库源码树附带可选 LuaRocks 打包描述（*.rockspec）会被 lang-preflight 按 lua manifest 判型，与源码统计（c/cpp 主体）矛盾输出 detected=mixed/env_unsupported；按 R47 边界规则人工复核后可按 c/cpp 正常适配

root_cause:             lang_detect.py 的 _manifest_scan 按文件名优先级判语言：any(n.endswith(".rockspec"))
                        命中即返回 ("lua","luarocks")，优先级高于顶层 Makefile 的 ("c/cpp","make") 判型。
                        Lua 生态的 C 扩展库（hashchop 0.8-0：hashchop.c/lhashchop.c/bench.c/test.c + 可选
                        test.lua）常在发布树根附带 rockspec——它是 LuaRocks 的打包描述（声明 modules 与
                        lua >= 5.1 依赖），不是项目主语言声明。当任务语言=c 而检测输出 lua 时按
                        "manifest 与统计矛盾判 mixed" 规则终态 env_unsupported，造成可适配的 C 库被误杀。

affected_scope:         一切"C/C++ 为主体、附带 .rockspec 的 Lua 绑定可选"的上游库（Lua C 扩展是常见形态，
                        如 hashchop、同类 lpeg 式 makefile 项目）。判定链：源码统计 c/cpp 占比 >= 70%、
                        构建系统 make/cmake（rockspec type=builtin 仅声明模块编译方式）、lua 文件仅为
                        绑层测试（test.lua）或绑定源（lhashchop.c 是 C 源不是 lua）。命中即误报。

verification_cmd:       |
                        cd <源码根> && ls *.rockspec && grep -c '^TEST ' test.c
                        awk 'END{print NR}' hashchop.c lhashchop.c bench.c test.c
                        grep 'type *= *"builtin"' *.rockspec
                        make -j1 CC=clang && ./test
                        python3 scripts/ohc-run.py lang-preflight <name> <ver> --src <src>

rec_priority:           1
rec_approach:           rockspec-is-packaging-not-language
rec_description:        遇 lang-preflight 报 detected=mixed 且 evidence 显示 manifest=lua/luarocks、
                        统计 c/cpp 主体 >= 70% 时：①核对 rockspec 内容（dependencies lua、modules 列表、
                        type=builtin）确认只是 LuaRocks 打包描述；②核对真实构建入口（顶层 Makefile 的
                        默认目标不含 lua、或 cmake/autotools 均可独立构建 C 部分）；③源码统计确认 c/cpp
                        主体；④保留 lang-preflight 完整输出与自动写入的 env_unsupported result.json 作
                        证据，人工判误报后按任务语言继续适配，终态用 result --force 覆盖。不改框架、
                        不删上游 rockspec。
rec_command:            python3 scripts/ohc-run.py lang-preflight <name> <ver> --src <src-dir>
rec_auto_fix:           false
rec_impl:               process

fallback_priority:      2
fallback_approach:      task-lang-to-lua
fallback_description:   仅当任务语言确为 lua（包定位是 Lua 模块而非 C 库）时，接受 detected=lua 的匹配或
                        按平台流程走语言迁移；rockspec 且 lua 文件为主体（绑定 + 测试全 lua）时才属此类。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          process

forbid_1_pattern:       删除/改名上游 .rockspec 以通过预检
forbid_1_reason:        上游发布物的一部分，删除属于篡改源码且需补丁；预检误报应走人工复核留证，
                        不是改输入迁就检测器。
forbid_1_consequence:   引入无意义补丁，审阅负担与回退成本增加。
forbid_2_pattern:       修改 scripts/ohc/lang_detect.py（配方 PR 内）
forbid_2_reason:        框架文件在配方 PR 中只读（协作 Git 铁律）；框架修正须单独 PR。
forbid_2_consequence:   PR 被框架混入检查拦截/越权。

principles:             P013
causes:                 []
caused_by:              []
similar_to:             E339
conflicts_with:         []
prerequisite_of:        []

