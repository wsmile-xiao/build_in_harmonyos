#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E547.kv，填写各字段
# 对应的人类文档: doc/E547.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E547
trigger_tool:           configure|cmake|meson|make|gcc|clang|ld|python|pip|install|test|runtime
phase: compilation
error_signature: bash: line [0-9]+: g\+\+: command not found|g\+\+.*command not found.*Error 127

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: build-system
match_keywords: make, C++, variable, override, env, append
title: make 变量名含 + 号无法用命令行赋值覆盖(C++=x 被解析为变量 C+ 的追加)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: GNU make 解析命令行赋值时把紧邻 = 的 + 识别为追加操作符:参数 C++=x 被拆成变量名 C+ 与追加值 =x,makefile 内的 C++ = g++ 仍然生效
affected_scope: makefile 用含 + 的变量名声明 C++ 编译器(如 C++ = g++)且需要切换 clang++ 的工程
verification_cmd: printf 'C++ = g++\nall:\n\t@echo [${C++}]\n' > m.mk && make -f m.mk 'C++=x'   # 输出 [g++] 证明命令行不可覆盖

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: question-mark-equals-env-override
rec_description: 模板改 ?= 后经 env(1) 传非法 shell 变量名,make 视环境变量为已定义
rec_command: sed 模板 'C++\t= g++' -> 'C++\t?= g++' ; env 'C++=<clang++>' make -j1 ...
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes: 工具链的 clang++ 覆盖不生效,构建继续用 g++,在无 g++ 的 OHOS/HNP 环境下报 command not found(Error 127)
caused_by: 上游 makefile 用 C++ = g++ 声明 C++ 编译器且变量名含 +,命令行/环境均无法按常规方式覆盖(?= 之前)
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
error_pattern: make.*g\+\+: command not found|C\+\+.*g\+\+.*command not found
fix: 把模板改为 C++ ?= g+(语义不变),再用 env 'C++=clang++' make 经环境传入(?= 视环境变量为已定义);env(1) 可设置含 + 的非法 shell 变量名
verification: cbflib 0.9.7:补丁前 make C++=clang++ 仍调用 g++(Error 127);改 ?= + env 后 test_package 与上游测试全绿
references: archives/c/cbflib/0.9.7/patches/0001-cbflib-m4-makefile-tiff-switch-cxx-override.patch
doc_file:               doc/E547.md
last_updated: 2026-09-05
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

