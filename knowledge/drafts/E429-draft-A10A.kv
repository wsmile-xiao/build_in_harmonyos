#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: mvn|conan|create|maven-bundle-plugin|felix
phase: compilation
error_signature: Internal error in maven-bundle-plugin: ConcurrentModificationException

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: build-system, java
match_keywords: maven-bundle-plugin, ConcurrentModificationException, org.apache.felix, osgi-manifest, bnd, ZipFile, 4.2.1, 5.1.9, maven-javadoc-plugin, doclint, heading-sequence, JDK 17.0.13, BUILD FAILURE
title: maven-bundle-plugin 4.2.1（内含旧 bnd）在 JDK 17.0.13+ 下抛 ConcurrentModificationException，导致 Maven 构建失败于 osgi-manifest 目标——pin 到 5.1.9（bnd 5.1.2）即可；同类还有 maven-javadoc-plugin 的 doclint heading-sequence 报错（<doclint>none</doclint>）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: maven-bundle-plugin 4.2.1（2019 年版本，内含旧版 bnd）与 JDK 17.0.13+ 的 bnd/ZipFile 交互存在缺陷，构建到 manifest 生成（osgi-manifest 目标）时抛 java.util.ConcurrentModificationException，Maven 直接 BUILD FAILURE。实测报错：Failed to execute goal org.apache.felix:maven-bundle-plugin:4.2.1:manifest (osgi-manifest) on project jakarta.activation-api: Internal error in maven-bundle-plugin: ConcurrentModificationException。同一类"老插件 + 新 JDK"问题还包括 maven-javadoc-plugin 的 doclint：JDK 17.0.13+ 会强制校验 javadoc 注释的标题层级（<h3> 出现在 <h1> 之后即报 heading-sequence），需 <doclint>none</doclint>。
affected_scope: 所有在 build() 内用 Maven 构建、且 pom 依赖 maven-bundle-plugin 4.x/3.x 的 Java 库（Jakarta EE / JAX-RS / OSGi 类项目尤其常见）；只要 DTD 里 pin 了老版本且构建环境 JDK >= 17.0.13 就会命中
verification_cmd: 打补丁前后各跑一次 mvn：`mvn clean package -B -DskipTests=false`（失败时日志含 ConcurrentModificationException；成功后 BUILD SUCCESS）；补丁即 pom 中该插件 <version> 由 4.2.1 改为 5.1.9

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: patch-pom-to-pin-newer-maven-bundle-plugin
rec_description: 在归档的 patches/ 下加一个补丁改上游 pom：把 maven-bundle-plugin 的 <version>4.2.1</version> 改为 5.1.9（bnd 5.1.2）；如构建再报 javadoc heading-sequence，则在同一补丁里给 maven-javadoc-plugin 的 <configuration> 加 <doclint>none</doclint>。补丁用标准 unified diff（a/pom.xml、b/pom.xml 头，strip=1），并在 conandata.yml 的 patches: 段登记（patch_file / patch_description / patch_type: portability）。
rec_command: patch -p1 --dry-run < patches/<pkg>-0001-jdk17-bundle.patch # 先 dry-run 确认可干净应用
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: skip-osgi-manifest-plugin-execution
fallback_description: 若不便升版（例如升版会牵动其它插件配置），可在构建命令加 `-Dmaven.bundle.skip=true` 或对 bundle 插件跳过执行（仅当产物不需要 OSGi manifest 时）——但会削弱与上游产物的等价性，优先选 pin 版本
fallback_command: mvn clean package -B -DskipTests=false -Dmaven.bundle.skip=true
fallback_auto_fix: false
fallback_impl: forbid_1_pattern: <version>\s*4\.2\.1\s*</version>

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

