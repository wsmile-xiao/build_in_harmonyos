#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E580.kv，填写各字段
# 对应的人类文档: doc/E580.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E580
trigger_tool: test|make|configure|pkg-config|runtime
phase: testing
error_signature: Running test cases outside of kyua\(1\) is unsupported|kyua.*inaccessible or not found|Must provide a test case name|Cannot find the test program in the source directory|Failed to execute .*/bin/bash.*No such file|ATF_LIBEXECDIR|ATF_PKGDATADIR|examples_test

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: ohos, testing, autotools, conan, toolchain
match_keywords: kyua, ATF, atf-c++, atf-sh, Kyuafile, examples_test, atf-test-program, TP format, ident, 逐用例执行, ATF_LIBEXECDIR, ATF_PKGDATADIR, ATF_SHELL, interpreter, 用例对账, 上游测试执行, 测试运行器缺失
title: ATF/kyua 测试栈在 OHOS 无 kyua 时的全量执行协议：prog -l 枚举 + 单用例位置参数逐条执行 + atf-sh 环境装配与用例数对账

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: kyua 尚未适配 OHOS（下游任务），而 ATF（atf-c++/atf-sh）上游测试套件默认由 Kyuafile+kyua 编排；无 kyua 时缺少可复用的枚举-执行-对账范式：ATF 测试程序仅支持 -l 列出用例（TP 格式 ident）与单个位置参数运行一个用例（-r 是结果文件参数，非运行全部），直接裸执行只打印 kyua 警告；atf-sh 脚本的 shebang 取自 pkg-config 的 interpreter 变量，atf-sh 编译期默认 ATF_SHELL/ATF_LIBEXECDIR/ATF_PKGDATADIR 可能是构建机私有路径，examples_test 还要求在 make install 之后运行才能用已安装的 pkg-config 元数据编译示例
affected_scope: 所有以 ATF（atf-c++/atf-sh）编写、由 Kyuafile 与 kyua 编排的上游测试套件（lutok、kyua 自身、atf 自身、FreeBSD/NetBSD 移植库）；广义为任意测试运行器缺席或不可用时，按测试框架自身协议全量执行并如实对账的适配模板
verification_cmd: ./prog -l 枚举 ident; 逐条 ./prog <case> 以退出码判定; 用例总数与各程序用例数须与源码清点一致

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: atf-program-cli-direct-execution
rec_description: 以 ATF 测试程序自身 CLI 全量执行：-l 枚举 ident，逐用例以单个位置参数运行并按退出码判定（0=通过）；按程序强对账用例数；atf-sh 套件运行前显式设置 ATF_LIBEXECDIR/ATF_PKGDATADIR/ATF_SHELL，且 examples_test 在 make install 后运行
rec_command: prog -l 枚举; prog <case> 逐条执行; 退出码 0=通过
rec_auto_fix: false
rec_impl: manual-test-harness

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: kyua-orchestration-after-adaptation
fallback_description: kyua 适配落地后直接 kyua test -k Kyuafile --build-root=<builddir> 编排，用例集合与逐条执行完全一致，可无缝切换
fallback_command: kyua test -k Kyuafile --build-root=build
fallback_auto_fix: false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 以 test_package 代替上游套件并标注上游用例不可运行|伪造用例数或通过率|把 -r 当作运行全部
forbid_1_reason: R51 要求上游测试真实执行并如实回填通过率；test_package 不能替代上游套件；ATF 0.23 源码与实测均证明 -r 是结果文件参数
forbid_1_consequence: 被判定为欺骗性适配，通过率不可信
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: real-evidence-over-assumption, minimal-patch, upstream-test-integrity

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

