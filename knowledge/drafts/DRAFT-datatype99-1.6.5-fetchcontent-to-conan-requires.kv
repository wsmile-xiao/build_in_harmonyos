# ═══ Draft knowledge entry — datatype99 1.6.5 FetchContent → conan requires ═══
# Timestamp: 2026-09-09
# Software: datatype99 1.6.5
# Gate: G2 (conan create) / 上游测试实跑
# Status: UNMATCHED — needs human/AI review to promote to E-entry

id:                     DRAFT-datatype99-1.6.5-fetchcontent-to-conan-requires
trigger_tool:           cmake|conan|FetchContent
phase:                  build|test|porting
error_signature:        FetchContent.*metalang99|
                         FetchContent_MakeAvailable.*offline|
                         fsanitize=address.*musl
severity:               2
category:               build-system|header-only|dependency-management|fetchcontent
match_keywords:         datatype99, metalang99, FetchContent, header-only,
                         sum type, ML99_ASSERT_UNEVAL, compile-time assert,
                         asan, hirrolot
title:                  datatype99 1.6.5：FetchContent 现场下载依赖 → conan
                         requires 同版本替代，测试直编译实跑

root_cause: >
  datatype99 是 header-only 单头库，上游 CMakeLists.txt 用 FetchContent 现场
  下载 metalang99 v1.13.5 —— 沙箱网络拉取与 conan 依赖管理双冲突。测试源
  （tests/*.c 5 个程序）不依赖 CMake 生成物；上游给 GCC/Clang 挂
  -fsanitize=address，OHOS musl clang 的 ASan 不在配方保证范围，但省略不改变
  断言语义。
affected_scope: >
  hirrolot 系（metalang99/datatype99/interface99…）及一切"header-only +
  FetchContent 钉依赖 + 测试不依赖 CMake 生成物"的库。
verification_cmd: >
  grep -n 'FetchContent' CMakeLists.txt     # 现场确认依赖拉取
  grep -n 'v1.13.5' CMakeLists.txt          # 钉的版本（与 requires 对齐）
  cc -std=c99 -I. -I<ml99_inc> tests/tests.c -o tests && ./tests
rec_priority:           1
rec_approach:           fetchcontent-to-conan-requires + direct-compile-tests
rec_description: >
  (a) requires 与上游 FetchContent 钉的版本完全一致的 conan 包
  (transitive_headers=True)；(b) 跳过上游 CMake，build() 内直接编译 tests/
  全部程序实跑，编译期断言文件编译成功即通过；(c) package() 只装头。
rec_command: >
  self.requires("metalang99/1.13.5", transitive_headers=True)
  cc -std=c99 -I<src> -I<ml99_inc> tests/<name>.c -o <name> && ./<name>
rec_auto_fix:           true
rec_impl:               recipe-side-build

fallback_priority:      2
fallback_approach:      keep-fetchcontent
fallback_description:   >
  保留 FetchContent：沙箱网络不可用/依赖重复管理，必然失败或评审被拒。
fallback_command:       （不可用）
fallback_auto_fix:      false
fallback_impl:          none

forbid_1_pattern:       FetchContent.*保留|cmake.*fetch.*metalang99
forbid_1_reason:        现场下载与沙箱/conan 依赖管理冲突。
forbid_1_consequence:   构建失败或依赖版本漂移。
forbid_2_pattern:       metalang99/[0-9.]+(?!.*1\.13\.5)
forbid_2_reason:        requires 版本必须与上游钉的 v1.13.5 一致。
forbid_2_consequence:   宏引擎版本漂移导致展开行为差异。
forbid_3_pattern:       -fsanitize=address
forbid_3_reason:        OHOS musl clang ASan 不在配方保证范围，省之不断言语义。
forbid_3_consequence:   引入无谓环境依赖与失败面。

principles:             P001
