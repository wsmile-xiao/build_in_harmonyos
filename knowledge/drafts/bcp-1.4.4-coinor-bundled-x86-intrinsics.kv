#====================================================================
# DRAFT-BCP-144-COINOR-BUNDLED-X86-INTRINSICS-EXTERNAL-FLAGS
#   COIN-OR 捆绑依赖子树含无条件 x86 immintrin.h：W0 平台可移植性
#   全仓字面 grep 与真实构建面系统性偏差；外部依赖 flags 模式防触达
#   + 三步裁量判据（归类/探针/SUBDIRS 实证）
# 来源: 任务卡 5950 feat/bcp-1.4.4（依赖项），2026-09-23
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）；知识号 E693
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-BCP-144-COINOR-BUNDLED-X86-INTRINSICS-EXTERNAL-FLAGS
trigger_tool:           grep|clang|configure|conan
phase:                  precheck|configuration|compilation
error_signature:        immintrin\.h|emmintrin\.h|mmintrin\.h|
                        This header is only meant to be used on x86|
                        invalid (input|output) constraint.*=a. in asm|
                        __asm__.*(cpuid|prefetchnta)|
                        subdirs=.*Clp|coin_has_clp

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               portability, build-system, ohos-platform, coin-or, autotools
match_keywords:         immintrin, emmintrin, mmintrin, altivec, 3dnow, arm_neon,
                        cpuid, prefetchnta, COIN_PREFETCH, AVX2, ClpSimplexDual,
                        ClpPackedMatrix, CoinAbcHelperFunctions, COIN-OR,
                        捆绑依赖, bundled subtree, Dependencies, external deps,
                        flags 模式, --with-clp-incdir, coin_has_clp, SUBDIRS,
                        W0-3, 平台可移植性, 构建面, 字面 grep, x86 only,
                        aarch64, ohos, x86-only-error
title:                  COIN-OR 大 tarball 捆绑依赖子树的无条件 x86 immintrin.h：W0 平台可移植性全仓字面 grep 与构建面系统性偏差——三步裁量（命中归类→设备探针→configure SUBDIRS 实证）+ 外部依赖 flags 模式防触达
prescan_pattern:        'immintrin\.h|emmintrin\.h|__asm__\s+__volatile__\s*\(\s*"(cpuid|prefetchnta)|subdirs="\$subdirs Clp'
prescan_globs:          '*.c, *.cpp, *.hpp, *.h, configure, configure.ac, Dependencies'

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: |-
                        COIN-OR release tarball 的 Dependencies 文件声明硬依赖，却同时把
                        全部依赖子树捆进 tarball（Bcp-1.4.4 捆绑 CoinUtils/Osi/Vol/Clp/Cgl
                        五个目录）。捆绑子树是历史 x86 代码：Clp/src/ClpSimplexDual.cpp:3556
                        与 Clp/src/ClpPackedMatrix.cpp:6753 在 #ifdef _MSC_VER … #else 分支
                        **无条件** #include <immintrin.h>（非 AVX 宏守卫）；prefetchnta/cpuid
                        x86 asm 分别位于 #ifdef COIN_PREFETCH（宏定义本身被注释 = 默认关）
                        与 #if 0 死块；其余 immintrin 在 #if AVX2==1/2/3 守卫内（宏未定义
                        全部跳过）。于是「字面 grep 命中」与「真实构建面」是两个集合：
                        W0-3 判据对全仓扫描，而捆绑子树在外部依赖 flags 模式下根本不进
                        SUBDIRS（顶层 configure 仅 bundled 分支 subdirs="$subdirs Clp"，
                        Bcp/Makefile.am SUBDIRS = src）。设备一手探针定性：aarch64
                        clang15 下 #include <immintrin.h> rc=1（#error x86 only）、
                        cpuid/prefetchnta asm rc=1（invalid output constraint '=a'）——
                        命中若真被编译必失败，因此判据必须落在「是否进构建面」而非
                        「源码里有没有」。
affected_scope:         所有 COIN-OR 捆绑式大 tarball（Bcp/Cbc/Clp/系列及同形态
                        「Dependencies 声明外部依赖但 tarball 同时捆绑子树」的项目）
                        的 W0 平台可移植性预检；任何对 monorepo/大 tarball 做全仓
                        字面 grep 的移植预检判据都受同一偏差影响。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           external-deps-flags-mode-plus-three-step-adjudication
rec_description: |-
                        两件事一起做。A. 配方侧防触达（外部依赖 flags 模式，同已发布
                        coinor-cbc 2.10.13 先例）：直接驱动子包 configure，给
                        --with-clp-incdir/--with-clp-lib、--with-vol-*、--with-cgl-*，
                        旧式 AC_COIN_CHECK_PACKAGE 的 flags 分支直接置 coin_has_*=yes
                        并跳过 pkg-config 与 bundled 检测 → 5 个捆绑子树一个都不进
                        编译面；依赖头合并到单一 staging 供 incdir（configure 只收
                        单目录），链接串按「依赖方在前」直连 .a 绝对路径（已发布包
                        .la 固化 libdir='//'，-l 形式必炸 not a valid libtool
                        archive）；CFLAGS/CXXFLAGS 显式钉 '-O3 -pipe -DNDEBUG' 防
                        CI 环境泄漏。B. 判据侧三步裁量（替代「命中即止损」的字面
                        执行）：①命中归类——grep 命中按第一段目录分桶，区分
                        「自身子树/捆绑子树/死块守卫（#if 0、被注释的宏、未定义
                        条件宏）」；②一手编译探针——把命中头/asm 抽成最小 .c 在
                        设备编译拿 rc 实证；③configure 机制实证——读 flags 分支与
                        subdirs 追加条件，构建后 grep 编译日志自证捆绑子树无编译行。
                        三步全过判「不在构建面」不止损；任一步不过（外部依赖不可得
                        或被迫 bundled）即转强制路径止损上报。裁量必须登记 notes.md
                        问题表：命中文件全路径 + 探针读数 + 防触达机制 + 复发条件。
rec_command:             grep -rIlnE 'altivec|mmx|3dnow|mmintrin|arm_neon|immintrin' "$D" | sed "s|$D||" | cut -d/ -f1 | sort | uniq -c && printf '#include <immintrin.h>\nint main(void){return 0;}\n' > "$TASK_DIR/w0/probe_isa.c" && clang -c "$TASK_DIR/w0/probe_isa.c" -o "$TASK_DIR/w0/probe_isa.o"; echo "probe_rc=$?"
rec_auto_fix:            false
rec_impl:                external-flags-mode-plus-three-step-adjudication

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P006

# ═══ 关系图 (Relations) ═══
similar_to:             E646（COIN-OR 已发布包 .pc 固化 prefix=/ → flags 模式 +
                        合并 staging + 直连 .a；本条复用其 flags 模式，但判据面
                        是捆绑子树 x86 ISA 头与 W0 预检偏差，非消费路径）
caused_by:
conflicts_with:
prerequisite_of:        E646 的 flags 模式在「tarball 捆绑子树含强制 x86 路径」
                        时从「可选优化」升格为「必需防触达」

# ═══ 元数据 ═══
verification_cmd:       D="$HOME/tmp/bcp-1.4.4/src/extract/Bcp-1.4.4"; grep -rIlnE 'immintrin' "$D" | sed "s|$D||" | cut -d/ -f1 | sort | uniq -c; conan create "$HOME/ws/worktrees/bcp-1.4.4/archives/b/bcp/1.4.4" -pr:h=$HOME/ws/worktrees/bcp-1.4.4/ci/conan/profiles/ohos-aarch64 -pr:b=$HOME/ws/worktrees/bcp-1.4.4/ci/conan/profiles/ohos-aarch64 2>&1 | tee "$HOME/tmp/bcp-1.4.4/build.log" | tail -3; grep -cE ' (Clp|CoinUtils|Osi|Vol|Cgl)/' "$HOME/tmp/bcp-1.4.4/build.log"
doc_file:               knowledge/drafts/bcp-1.4.4-coinor-bundled-x86-intrinsics.md
last_updated:           2026-09-23
source_event:           任务卡 5950（依赖项·火种5）feat/bcp-1.4.4：W0-3 grep 命中
                        immintrin 4 文件（全在捆绑 Clp/），探针 rc=1，编排方裁决
                        「命中不在真实构建面、不止损」并要求三件附加（notes 裁量
                        登记 / 构建日志无 Clp/ 编译行自证 / feedback 记判据改进）
