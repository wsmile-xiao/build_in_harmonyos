#====================================================================
# DRAFT-gettext-tiny-0.3.3-libintl-no-macros-real-api-test —
#   libintl.h 恒等宏掩盖真实 gettext 函数，真实 API 测试必须
#   -DLIBINTL_NO_MACROS=1 强制真实符号调用
# 对应人类文档: knowledge/drafts/DRAFT-gettext-tiny-0.3.3-libintl-no-macros-real-api-test.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: gettext-tiny 0.3.3 适配 HarmonyOS PC（Makefile + conan create test_package）
#====================================================================

id:                     DRAFT-gettext-tiny-0.3.3-libintl-no-macros-real-api-test
trigger_tool:           clang|cc|make|cmake|conan
phase:                  testing|compilation
error_signature:        call to undeclared function 'gettext'|
                         implicit declaration of function 'gettext'|
                         LIBINTL_NO_MACROS|gettext.*macro.*identity|
                         incompatible integer to pointer.*gettext

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               gettext, libintl, testing, conan, test_package, ohos
match_keywords:         libintl.h, LIBINTL_NO_MACROS, gettext, dgettext, textdomain,
                         bindtextdomain, identity macro, macro expansion, real function,
                         -DLIBINTL_NO_MACROS, test_package, consumer, CTest, undefined
                         declaration, NLS
title:                  libintl.h 顶层宏把 gettext/dgettext/textdomain 展开成恒等
                         表达式，测试若不定义 LIBINTL_NO_MACROS=1 只会测到宏恒等，
                         真实库符号从未被调用——真实 API 测试必须显式
                         -DLIBINTL_NO_MACROS=1

# ═══ Layer 2: 诊断层 ═══
root_cause:             gettext-tiny 的 libintl.h 为兼容 configure 探测，在
                        函数声明之下定义了 `#define gettext(X) ((char*)(X))`、
                        `#define dgettext(dom,X) ...`、`#define textdomain(X) ...`
                        等恒等宏（LIBINTL_NO_MACROS 未定义时生效）。消费者编译
                        `gettext("hello")` 实际展开为 `((char*)("hello"))`，
                        完全不经过库内真实 gettext() 函数——test_package/消费者
                        用例若只断言返回字符串相等，测的是宏恒等而非库行为；
                        若在宏启用时调用还会被误判为"编译通过但链接未发生"。
                        只有定义 LIBINTL_NO_MACROS=1 跳过宏区，编译器才会看到
                        顶层真实函数声明并链接 libintl.a 的真实符号。
affected_scope:         所有在 OHOS 上消费 gettext-tiny/libintl 头文件的
                        test_package、消费者用例、上游测试：需要验证真实
                        gettext/dgettext/textdomain/bindtextdomain 行为的场景。
verification_cmd:       conan create archives/g/gettext-tiny/0.3.3 --build=missing
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: test_package 两个用例（test_gettext-tiny + 
                         # harmonyos_specific_test）均 PASSED；test.c/harmonyos 用
                         # -DLIBINTL_NO_MACROS=1 编译

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           libintl-no-macros-real-api-test
rec_description:        在 test_package/消费者用例的编译定义中加入
                        `LIBINTL_NO_MACROS=1`（CMake: target_compile_definitions
                        PRIVATE LIBINTL_NO_MACROS=1；Makefile: CFLAGS 追加
                        -DLIBINTL_NO_MACROS=1），使 gettext/dgettext/textdomain/
                        bindtextdomain 调用落到真实库符号，随后可对返回值、
                        errno（如 textdomain 非法域返回 NULL+EINVAL）做可观察断言。
rec_command:            |
  # CMake（test_package/CMakeLists.txt）
  add_executable(test_gettext-tiny test.c)
  target_compile_definitions(test_gettext-tiny PRIVATE LIBINTL_NO_MACROS=1)
  target_link_libraries(test_gettext-tiny gettext-tiny::gettext-tiny)
  # C 源码（test.c）——调用后必须用真实返回值断言，而非仅打印
  const char *s = gettext("hello");
  assert(s && strcmp(s, "hello") == 0);
  errno = 0;
  assert(textdomain("bad/domain") == NULL && errno == EINVAL);
rec_auto_fix:           false
rec_impl:               conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       只打印字符串.*测试|空壳.*消费者|print-only.*test
forbid_1_reason:        PF3/L0c 拦截空壳 test()；测试必须实际调用并断言真实结果
forbid_1_consequence:   preflight 拦截、CI 失败、消费者门禁不满足
forbid_2_pattern:       patch.*libintl\.h.*删除.*宏
forbid_2_reason:        宏是上游兼容设计（configure 探测依赖），改头文件影响面大
forbid_2_consequence:   补丁面大、易破坏依赖库探测逻辑

# ═══ Layer 4: 原则引用 ═══
principles:             P004

