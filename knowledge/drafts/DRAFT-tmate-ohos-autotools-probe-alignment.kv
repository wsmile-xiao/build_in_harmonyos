#====================================================================
# DRAFT-tmate-ohos-autotools-probe-alignment.kv
# tmate 2.4.0 (Autotools) OHOS 适配: pkg-config 探测名对齐 + 头文件检查顺序
#====================================================================

id:                     DRAFT (proposed E###)
trigger_tool:           configure|make|conan|pkg-config
phase:                  configuration|compilation
error_signature:        use of undeclared identifier 'OK'|
                         curses.h file not found|
                         ncurses.h file not found|
                         msgpack not found|msgpack >= 1.1.0 not found|
                         libssh not found|Required library .* not found|
                         configure: error: .* not found
severity:               2
category:               build-system|autotools|pkg-config|dependency-management|ohos
match_keywords:         tmate, tmux, PKG_CHECK_MODULES, pkg_config_name, msgpack-c,
                         ncursesw, AC_CHECK_HEADERS, curses.h, term.h, 探测名,
                         configure.ac, config.h, HAVE_CURSES_H, OHOS
title:                  ohpcd 配方 pkg_config_name 与上游 configure 探测名不一致时,须在 configure.ac 对齐探测名并后移头文件检查

root_cause: >
  (1) ohpcd Conan 配方声明的 pkg-config 名 (msgpack-c/7.0.0 -> "msgpack-c",
  ncurses/6.6 -> "ncursesw") 与上游 configure.ac 的 PKG_CHECK_MODULES 探测名
  ("msgpack", "ncurses") 不一致,configure 阶段找不到 .pc 而 AC_MSG_ERROR。
  (2) configure.ac 中 AC_CHECK_HEADERS(curses.h ncurses.h term.h) 位于
  PKG_CHECK_MODULES(LIBNCURSES, ncursesw) 之前执行;此时 ncurses 的 -I include
  目录尚未进入 CPPFLAGS,头文件检查全部失败 -> HAVE_CURSES_H/HAVE_NCURSES_H/
  HAVE_TERM_H 均未定义 -> 源码 #if defined(HAVE_CURSES_H) #include <curses.h>
  分支不生效 -> 编译期报 "use of undeclared identifier 'OK'"。
  (3) GitHub tag 归档不含预生成 configure/Makefile.in,须在主机 autogen 后以
  patch 落盘 (dhcpstarv r44 同款模式)。

affected_scope:         所有 autotools 库其依赖在 ohpcd 以不同 pkg-config 名发布,
                        且上游头文件检查早于依赖 -I 注入 (典型: tmate/tmux 系,
                        任何依赖 ncurses/msgpack 的 autotools 项目)
verification_cmd:       grep -nE "PKG_CHECK_MODULES|AC_CHECK_HEADERS" archives/t/tmate/2.4.0/patches/0001-configure-ac-probes.patch

rec_priority:           1
rec_approach:           patch-configure-ac-probe-alignment
rec_description:        以 patch 修改 configure.ac: (1) 将 PKG_CHECK_MODULES 探测名
                        对齐 ohpcd 配方的 pkg_config_name (msgpack->msgpack-c,
                        ncurses->ncursesw); (2) 将 AC_CHECK_HEADERS 头文件检查块
                        整体后移到四个 PKG_CHECK_MODULES 之后,使 -I include 先进入
                        CPPFLAGS; (3) 重新 autogen (aclocal+automake+autoreconf)
                        并把生成的 configure/Makefile.in/aclocal.m4/aux 脚本作为
                        新文件 patch 落盘 (config.guess 需含 HarmonyOS 探测块,
                        见 E007)。
rec_command:            # 主机 (autoconf 2.72 + automake 1.18 + pkg-config 0.29.2):
                        export PATH=~/.conan2/p/autom*/p/bin:$PATH
                        export PERL5LIB=~/.conan2/p/autom*/p/share/automake-1.18
                        export ACLOCAL_PATH=/data/service/hnp/pkg-config.org/pkg-config_0.29.2/share/aclocal
                        sh autogen.sh
                        # 以 git diff / diff -u 落盘 0001-configure-ac-probes.patch 等
rec_auto_fix:           false
rec_impl:               manual-hint

fallback_priority:      2
fallback_approach:      recipe-env-pkgconfig
fallback_description:   不改 configure.ac,而是在 recipe generate() 中把依赖 -I 目录
                        注入 CPPFLAGS (PkgConfigDeps + AutotoolsToolchain 环境组合),
                        使早期头文件检查可见;探测名不一致则仍需 patch 或别名 .pc。
fallback_command:       PKG_CONFIG_PATH 指向 PkgConfigDeps 生成目录;CPPFLAGS 追加依赖 includedirs
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       sed -i.*configure(未重新生成)
forbid_1_reason:        只改 configure.ac 不重新 autogen,产物 configure 未生效;直接改
                        生成 configure 则无法与 patch 基线一致。
forbid_2_pattern:       依赖探测名猜其他名|改名 ohpcd 配方
forbid_2_reason:        不得因上游探测失败而修改已发布依赖配方的 pkg_config_name,须在
                        被适配库的 configure.ac 侧对齐。

principles:

causes:                 []
caused_by:              []
similar_to:             [E007]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/drafts/DRAFT-tmate-ohos-autotools-probe-alignment.md
last_updated: 2026-08-15
source_event:           tmate 2.4.0 适配 (round 3 adapt rebuild_required): iter1 patch 路径失败、
                        iter2 头文件检查顺序导致 OK 未声明、依赖全部 ohpcd 可消费

authors:                atomcode-executor
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9
metrics_last_used:      2026-08-15
