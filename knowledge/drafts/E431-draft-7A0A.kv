#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E431.kv，填写各字段
# 对应的人类文档: doc/E431.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E431
trigger_tool: python|runtime|test
phase: runtime
error_signature: ImportError: cannot import name 'RunConfig' from 'riscemu'|ModuleNotFoundError: No module named 'core'|No module named 'core\.traps'|No module named 'core\.usermode_cpu'|Error while finding module specification for 'riscemu\.priv'

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: python, upstream-defect, limitation, test_package, compat
match_keywords: 绝对导入, from core import, 包内相对导入丢失, __init__ 未导出, RunConfig, py -m <pkg>.priv, 上游缺陷, master 同样未修, 死代码依赖, pyelftools 不可达, 不擅自打补丁
title: 上游子包用绝对导入 from core.* 且 __init__ 未导出 RunConfig 导致整子系统不可导入（发布版与 master 同）：适配时记录为不可用面而非擅自打补丁，依赖证明改走可达路径

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: riscemu/priv/{__main__,PrivCPU,ElfLoader}.py 写的是 Python 2 时代风格的顶层绝对导入 from core.usermode_cpu import * / from core.traps import *（应为 from ..core...），且 priv/__main__.py 里 from riscemu import RunConfig 而 riscemu/__init__.py 只导出 __version__/__author__/__copyright__；两条缺陷叠加使 priv 子系统（特权模式模拟器 + pyelftools ELF 加载器）在 2.2.7 与当前 master 上都不能 import，python -m riscemu.priv --help 直接 ImportError
affected_scope: riscemu 2.2.7 及 master 的 riscemu.priv.*（含 ElfLoader/PrivCPU）；连带使运行时依赖 pyelftools 在上游代码里成为不可达路径，任何以 priv 为入口的验证都必然失败；纯 Python 包适配中同类『发布版子模块整体不可导入』问题的通用处置
verification_cmd: python3 -c 'import riscemu.priv' ; echo rc=$?  # ImportError；python3 -m riscemu.priv --help  # ModuleNotFoundError: No module named 'core'；python3 -c 'from elftools.elf.elffile import ELFFile; f=ELFFile(open("/bin/ls","rb")); print(f.elfclass, list(f.iter_sections())[:1])'  # 证明依赖本身可用

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: document-unreachable-upstream-subpackage-keep-fidelity
rec_description: 不修改上游源码（不补 from ..core 也不补齐 __init__ 导出）：在 notes.md/manifest.yaml 的未覆盖项与知识条目中显式记录该子系统不可用，消费者测试回避 riscemu.priv 导入；对 pyelftools 这类『仅被该死代码使用』的运行时依赖，改在 test_package 里直接用 ELFFile 解析真实 ELF（/proc/self/exe 或 python 解释器本体）证明其功能可用，而不是删依赖或假声明
rec_command: python3 -c "from elftools.elf.elffile import ELFFile; f=ELFFile(open('/proc/self/exe','rb')); assert f.elfclass in (32,64); print(f.header['e_machine'], len(list(f.iter_sections())))"
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: patch .*from \.\.core|sed -i .*from core\.|raise.*priv.*skip
forbid_1_reason: 为让自己测试全绿而给上游缺陷打补丁会掩盖真实可用面、并让产物偏离上游 tag（无法与上游 sha256/行为对齐）
forbid_1_consequence: PR 与上游版本不一致、后续上游修复时形成分叉；同时把『不可用面』静默掉，违反 R34 的真实性取向
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

