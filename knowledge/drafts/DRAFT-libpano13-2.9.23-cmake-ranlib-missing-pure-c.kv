#====================================================================
# DRAFT-libpano13-2.9.23-cmake-ranlib-missing-pure-c
# 纯 C/CMake 库 conan 配方：OHOS SDK 缺 llvm-ranlib 导致静态库归档失败，
# 用 -DCMAKE_RANLIB 显式重指系统软链修复（E385 的纯 C 场景补充）
#====================================================================

id:                     DRAFT-libpano13-2.9.23-cmake-ranlib-missing-pure-c
trigger_tool:           cmake|conan|llvm-ranlib|llvm-ar
phase:                  compilation|linking
error_signature:        'Error running link command: no such file or directory|CMAKE_RANLIB.*native/llvm/bin/llvm-ranlib|静态库归档失败|libpano13\.a.*Error 2|no such file or directory.*\.a'

severity:               2
category:               ohos, cmake, toolchain, archive
match_keywords:         CMAKE_RANLIB, llvm-ranlib, llvm-ar, ohos.toolchain.cmake, 静态库, static archive, 归档, ranlib 缺失, libpano13, pure C library, conan create

title:                  纯 C/CMake 库在 OHOS 的 conan create 中静态库归档失败：SDK 缺 llvm-ranlib，配方内用 -DCMAKE_RANLIB 重指系统软链

root_cause:             'OHOS SDK 的 native/llvm/bin/ 只有 llvm-ar、无 llvm-ranlib（系统软链 /data/service/hnp/bin/llvm-ranlib 指向 llvm-ar）；ohos.toolchain.cmake 将 CMAKE_RANLIB 固定为 SDK 内不存在的 llvm-ranlib，CMake 生成静态库归档后 ranlib 索引报 "Error running link command: no such file or directory"。探索编译走系统 PATH 不触发，只有走 OHOS CMake toolchain 的 conan create 才暴露。与 E385 根因相同，但 E385 面向 Rust crate 子构建 + toolchain overlay，本条目是纯 C/CMake 库 conan 配方的直接修复。'

affected_scope:         所有以纯 C/CMake 构建、conanfile.py 走 OHOS ohos.toolchain.cmake、
                        且同时产出静态库（add_library STATIC 或 CMakeLists 默认双产物）的库；
                        libpano13 2.9.23（CMakeLists 非 WIN32 分支同时 add_library(pano13 SHARED)
                        与 pano13a STATIC）实证

verification_cmd:       |
  conan create . --version=<ver> -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing 2>&1 | grep -E "Linking C static library|Error running link command"
  # 修复前：libpano13.a 归档时 "Error running link command: no such file or directory"
  # 修复后：全部目标 Built，无归档错误

rec_priority:           1
rec_approach:           cmake-ranlib-direct-repoint
rec_description:        在 conanfile.py build() 的 cmake 命令行参数中追加
                        -DCMAKE_RANLIB=<存在的 ranlib 路径>，优先 /data/service/hnp/bin/llvm-ranlib
                        （软链到 llvm-ar），其次 SDK 内 llvm-ar 的绝对路径。无需 toolchain overlay
                        或 ranlib 包装器（E385 的 Rust 场景才需要）；纯 C 库直接重指 cache 变量即可。
rec_command:            defs.append('-DCMAKE_RANLIB="/data/service/hnp/bin/llvm-ranlib"')
rec_auto_fix:           true
rec_impl:               conanfile-cmake-flag

fallback_priority:      2
fallback_approach:      cmake-toolchain-overlay
fallback_description:   E385 的 target-scoped-cmake-toolchain-overlay：生成只执行 llvm-ar s 的 ranlib
                        包装器 + 薄 toolchain overlay 强制覆盖 CMAKE_RANLIB/C_COMPILER_RANLIB/
                        ASM_COMPILER_RANLIB。适用于包装器注入困难（如 cargo build.rs 子构建）的场景。
fallback_command:       printf '#!/bin/sh\nexec "%s" s "$@"\n' "$LLVM_AR" > "$BUILD_DIR/llvm-ranlib"; chmod +x "$BUILD_DIR/llvm-ranlib"
fallback_auto_fix:      false
fallback_impl:          cmake-toolchain-overlay

principles:             P010
causes:                 []
caused_by:              []
similar_to:             [E385, E012]
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-libpano13-2.9.23-cmake-ranlib-missing-pure-c.md

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:                OpenDesk
