#====================================================================
# Draft knowledge entry - BSD sysctl.h missing on OHOS -> __APPLE__ guard
# Source package: chipmunk2d/7.0.3
#====================================================================

id:                     DRAFT-chipmunk2d-7.0.3-sysctl-apple-guard
trigger_tool:           conan|cmake|clang
phase:                  compilation
error_signature:        sys/sysctl\.h.*file not found|fatal error:.*sys/sysctl\.h|sysctlbyname.*undeclared

severity:               2
category:               portability, libc, headers, platform-guard
match_keywords:         sys/sysctl.h, sysctlbyname, hw.ncpu, __APPLE__, BSD header, musl, OHOS,
                        file not found, header guard, platform conditional
title:                  BSD sys/sysctl.h 在 OHOS/musl 上缺失时，把 include 与 sysctlbyname 调用收敛到 __APPLE__ 守卫

root_cause:             sys/sysctl.h 是 BSD/macOS 专有头文件，OHOS 使用 musl libc 不提供该头。
                        上游源码在非 _WIN32 分支无条件 #include <sys/sysctl.h>，而其中的
                        sysctlbyname("hw.ncpu") 调用实际仅在 __APPLE__ 分支使用 —— 头文件
                        包含范围（无条件）比调用范围（仅 __APPLE__）更宽，导致 OHOS 编译
                        直接 fatal error。
affected_scope:         所有在非 _WIN32 分支无条件包含 BSD 专有头（sys/sysctl.h 等）但仅在
                        Apple 分支使用其 API 的 C/C++ 库（物理引擎、系统探测、便携库等）。
verification_cmd:       conan create archives/c/chipmunk2d/7.0.3 -pr:h=ci/conan/profiles/ohos-aarch64
                        -pr:b=<same> --build=missing，确认 cpHastySpace.c 无 file not found。

rec_priority:           1
rec_approach:           apple-guard-bsd-header-include
rec_description:        把 BSD/macOS 专有头文件的 include 收敛到与 API 调用相同的平台守卫
                        （#ifdef __APPLE__）下：当 sysctlbyname 等仅在 Apple 分支被调用时，
                        #include <sys/sysctl.h> 也必须放进同分支，避免在 OHOS/Linux-musl
                        上无条件包含造成 fatal error。非 Apple 分支无需替代实现（该功能
                        分支本身不可达）。
rec_command:            sed -n '/sys\/sysctl.h/,+3p' src/xxx.c（确认 include 与调用分支是否对称）
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      ohos-local-stub
fallback_description:   若目标平台确实需要读取 CPU 核心数等能力且无 Apple 分支可收敛，则按
                        E086 的 __OHOS__ 守卫模式提供本地等价实现（如通过 uname/sysconf），
                        不得把无条件 include 留成 file not found。
fallback_command:       grep -R -n "sysctl" src include 2>/dev/null || true
fallback_auto_fix:      false
fallback_impl:          source-patch

principles:
- P011

causes:                 []
caused_by:              []
similar_to:             [E086, E102]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/DRAFT-chipmunk2d-7.0.3-sysctl-apple-guard.md
last_updated:           2026-09-03
source_event:           chipmunk2d 7.0.3 HarmonyOS adaptation

