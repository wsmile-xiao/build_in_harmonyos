#====================================================================
# DRAFT knowledge entry — LP64 unsigned long 32-bit semantics
# Draft: review to promote to an E-entry.
#====================================================================
id:                     DRAFT-ohos-lp64-unsigned-long-32bit-semantics
software:               uasm
version:                2.57
trigger_tool:           clang
phase:                  compilation
error_signature:        -1 SHR|\(unsigned long\).*>>|0xffffffff.*(>>|SHR)|sizeof\(long\).*8
severity:               2
category:               portability, architecture, compiler
match_keywords:         unsigned long, LP64, LLP64, long width, 32-bit semantics,
                        sizeof(long), shift, SHR, bitmask, truncation,
                        cross-compile, aarch64, expected bin mismatch
title:                  LP64 平台上用 (unsigned long) 实现 32 位语义（位移/掩码）会静默算错
root_cause:             源码用 (unsigned long) 表达“32 位 MASM/win32 语义”的位移与掩码；
                        在 Windows(LLP64) long=32 位，在 OHOS/Linux(aarch64, LP64) long=64 位。
                        例如 (unsigned long)(-1) >> 4 得到 0x0FFFFFFFFFFFFFFF，取低 32 位仍为
                        0xFFFFFFFF，而 32 位语义期望 0x0FFFFFFF → 生成的机器码/常量错误。
affected_scope:         所有把 long/unsigned long 当作固定 32 位使用（位移、掩码、截断、
                        寄存器宽度假定、IPC/二进制格式）的历史代码；跨 Windows→LP64 移植。
verification_cmd:       printf 'int main(){long v=-1; printf("%%llx/%%x\\n",(unsigned long)v>>4,(unsigned)((unsigned long)v>>4)); return 0;}' > p.c;
                        clang -O0 p.c -o p && ./p   # => 0xfffffffffffffff / 0xffffffff（均非 0xfffffff）
rec_priority:           1
rec_approach:           fixed-width-cast
rec_description:        用定宽无符号类型（uint_32/uint32_t）替换语义上要求 32 位的 unsigned long
rec_command:            define uint_32 as unsigned int; cast (uint_32)value before shift/mask
rec_auto_fix:           false
rec_impl:               manual-cast-to-fixed-width
fallback_priority:      2
fallback_approach:      explicit-ifdef-width
fallback_description:   按目标 ABI 用编译期断言（sizeof(long)==4）并在 64 位平台改走 uint32_t
fallback_command:       static_assert(sizeof(long)==4, "assumes 32-bit long")
fallback_auto_fix:      false
fallback_impl:          static-assert
forbid_1_pattern:       \(unsigned long\).*(>>|<<|\&|\||~|0xffffffff)
forbid_1_reason:        用 unsigned long 承载固定 32 位语义，在 LP64 上位宽翻倍
forbid_1_consequence:   位移/掩码结果静默错误，产物字节与上游期望不符（编译期无告警）
forbid_2_pattern:       sizeof\(long\)\s*==\s*4
forbid_2_reason:        假定 long 为 32 位的编译期判断在 LP64 上恒假
forbid_2_consequence:   分支逻辑走错，且可移植性判断失效
principles:             []
causes:                 []
caused_by:              []
similar_to:             E113, DRAFT-E999-ohos-musl-long-double-double-alias
conflicts_with:         []
prerequisite_of:        []
