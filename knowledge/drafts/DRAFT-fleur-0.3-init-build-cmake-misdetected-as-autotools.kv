#====================================================================
# DRAFT-fleur-0.3-init-build-cmake-misdetected-as-autotools
#   init-build 将纯 CMake 项目误判为 autotools → 配方模板选错
# 来源: fleur 0.3 适配（HarmonyOS PC aarch64，conan-init 配方生成）
# 路径: Path B（知识库扩展）— 与 E097 部分覆盖，新增模板误判形态
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-fleur-0.3-init-build-cmake-misdetected-as-autotools
trigger_tool:           ohc-run.py conan-init|init-build
phase:                  configuration
error_signature:        构建系统:\s*autotools|AutotoolsToolchain|configure.*not found|exit 127|CMakeLists\.txt

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, detection, cmake, conan
match_keywords:         build system detection, autotools, CMakeLists.txt, configure missing,
                        recipe template, conanfile template, 误判, 模板选错, init-build,
                        conan-init, no configure script, 构建系统检测
title:                  init-build/conan-init 把无 configure 脚本的纯 CMake 项目误判为 autotools，conanfile 模板选错需手工重写为 CMake 配方
prescan_pattern:        CMakeLists\.txt|project\(.*\s+C\s*\)|add_library|add_executable

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             init-build 的构建系统检测以"是否存在 configure/configure.ac"
                        判定 autotools；纯 CMake 项目（顶层只有 CMakeLists.txt、
                        无 configure 脚本）被误判为 autotools，conan-init 据此
                        生成 AutotoolsToolchain + configure/make 模板配方。
                        按该模板跑 conan create 会因 configure 不存在失败
                        （G0 configure exit 127 佐证），且 generate() 不会注入
                        CMake 需要的变量（本案例：TARGET_GROUP=production）。

affected_scope:         所有"无 configure 脚本、纯 CMake 构建"的三方库首次适配；
                        HarmonyOS PC 构建仓通用（非 OHOS 专有——任何用 conan-init
                        生成配方的平台都会踩中模板误判）。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           rewrite-conanfile-to-cmake-template
rec_description:        用 templates/conanfile-cmake.py.tmpl 重写 conanfile.py：
                        ① CMakeToolchain + cmake_layout + CMake 辅助类；
                        ② generate() 注入项目必需变量（如 -DTARGET_GROUP=production）；
                        ③ 上游 CMakeLists 无 install() 规则时，package() 用
                           conan.tools.files.copy 手工拷贝产物（静态库 *.a /
                           公开头 *.h / CLI bin）；
                        ④ package_info 补全 libs 依赖顺序与 system_libs（如
                           fleur 依赖 fnv/myutils + m）。
                        同时把 .build-context 的 BUILD_SYSTEM 校正为 cmake。
                        判别：源码根目录含 CMakeLists.txt 且无 configure 脚本，
                        即按 CMake 处理。
rec_command:            grep -L '^configure$\|configure\.ac' <src>/ && ls <src>/CMakeLists.txt
rec_auto_fix:           false
rec_impl:               manual-recipe-rewrite

fallback_priority:      2
fallback_approach:      use-build-mode-b
fallback_description:   复杂项目可走模式 B：init-build 探索 + 手工编译验证后，
                        conan-init 只生成骨架，AI 按 CMake 模板完整重写配方。
fallback_command:       python3 scripts/ohc-run.py conan-init <sw> <ver>
fallback_auto_fix:      false
fallback_impl:          manual-recipe-rewrite

# ★ 禁止策略 ★
forbid_1_pattern:       按.*autotools.*模板.*提交|configure_args.*继续|AutotoolsToolchain.*照用
forbid_1_reason:        autotools 模板对纯 CMake 项目必然失败（无 configure），照用=配方废品
forbid_1_consequence:   CI conan create 失败，返工
forbid_2_pattern:       手写.*configure\.sh|伪造.*configure
forbid_2_reason:         不得为适配 autotools 模板伪造 configure 脚本——应改配方为 CMake 模板
forbid_2_consequence:   构建路径失真，产物不可复现

principles:             P-CMAKE
causes:                 []
caused_by:              []
similar_to:             [E097]
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-fleur-0.3-init-build-cmake-misdetected-as-autotools.md
last_updated:           2026-09-26
source_event:           fleur 0.3 conan-init 生成 autotools 模板，重写为 CMake 后 conan-verify G0-G4/L2/L4/L5 全过
authors:                pc4-45 <noreply@atomgit.com>
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0