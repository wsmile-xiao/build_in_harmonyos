#====================================================================
# E543.kv — 知识图谱条目
# 对应的人类文档: doc/E543.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E543
trigger_tool: qmake
phase: configuration
error_signature: Cannot read .*/mkspecs/modules-inst/qt_lib_(qml|quick|qmlmodels)\.pri: No such file or directory|qtHaveModule\(quick\).*false

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category: path-rewrite
match_keywords: qmake, mkspecs, modules-inst, qt_lib_qml.pri, qtHaveModule, chartsqml2, Cannot read, .cache/conan2
title: qmake 模块 .pri 路径重写正则漏 .cache/conan2 形态导致 QML 插件被静默跳过

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: 配方 _fix_qtbase_paths() 重写上游 qt5-qtdeclarative 包 mkspecs/modules*.pri 中的构建期旧路径时，正则只覆盖 /\.conan2/p/b/ 一种形态；当 conan home 位于 ~/.cache/conan2 时 .pri 内记录的是 .cache/conan2/p/b/ 形态，匹配不到导致旧路径残留，qmake 读不到 QtQuick 模块描述使 qtHaveModule(quick) 为假，src/src.pro 中 `qtHaveModule(quick): SUBDIRS += chartsqml2` 整个子目录被静默跳过；qmake 对读不到的 .pri 只告警不报错，退出码仍为 0
affected_scope: 所有 qmake 构建且依赖 qtHaveModule() 条件子模块的 Qt5 模块 (qtcharts/qtquickcontrols2/qtdatavisualization)
verification_cmd: grep -c "Cannot read .*mkspecs/modules-inst" build.log; ls $(conan cache path qt5-qtcharts/5.15.2:*)/qml/QtCharts/libqtchartsqml2.so

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority: 1
rec_approach: widen-path-regex
rec_description: 把路径重写正则改为宽版以同时覆盖两种 conan home 形态，并提取为类级常量供所有 .pri/.prl/.pc/cmake 重写调用点复用，避免只修一处
rec_command: _BUILD_DIR_PATTERN = re.compile(r"(/[^\s]*/(?:\.cache/)?\.?conan2/p/b/qt5-q[0-9a-f]+/b)")
rec_auto_fix: false
rec_impl: conanfile-fix-qtbase-paths

# 回退方案
fallback_priority:      2
fallback_approach: verify-artifact-manifest
fallback_description: 若正则难以穷举路径形态，则在 build() 结束后强制按 manifest.yaml 产物清单逐项断言（缺失即 raise），把静默跳过转为硬失败
fallback_command: 在 conanfile.py build() 末尾校验 qml/QtCharts/libqtchartsqml2.so 是否存在
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern: \(/\[\^\\s\]\*/\\\.conan2/p/b/
forbid_1_reason: 只匹配 .conan2 单一形态的窄版正则无法覆盖 conan home 位于 .cache/conan2 的环境
forbid_1_consequence: .pri 路径重写静默失效，qtHaveModule() 判假，条件子模块被跳过且退出码为 0，产物缺失直到打包后才暴露

# ═══ Layer 4: 原则引用 ═══
principles:

