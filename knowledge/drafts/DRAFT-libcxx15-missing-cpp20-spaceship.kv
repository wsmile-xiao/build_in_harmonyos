#====================================================================
# DRAFT-libcxx15-missing-cpp20-spaceship.kv
# OHOS clang15/libc++15 缺 std::string/vector/variant 的 C++20 operator<=>
# 触发事件: bali-phy 4.1 HarmonyOS PC 适配（archives/b/bali-phy/4.1，patch 0002）
#====================================================================

id:                     DRAFT-libcxx15-missing-cpp20-spaceship
trigger_tool:           clang|compile|conan
phase:                  compilation
error_signature:        no match for 'operator<=>'|
                         invalid operands to binary expression.*<=>|
                         use of deleted function.*operator<=>|
                         no viable overloaded '<=>'

severity:               3
category:               libcxx|toolchain|clang|cxx20|compile|compat
match_keywords:         operator<=>, spaceship, three-way comparison, libc++, libcxx,
                         std::string, std::vector, std::variant, LLVM 15, LLVM 17,
                         strong_ordering, compare_string, compare_vector, operator==,
                         C++20, defaulted
title:                  OHOS clang15/libc++15 缺 std::string/vector/variant 的 operator<=>：compare_string/compare_vector 可移植等价 + 手写 <=> 后显式补回 operator==

root_cause: >
  OHOS SDK 的 clang 15.0.4 配套 libc++（LLVM 15）未实现 std::string、std::vector、
  std::variant 的 C++20 三路比较 operator<=>（上游 libc++ 状态表 Cxx20Papers.csv
  将 P1614R2 "Library Support for the Spaceship Operator" 标为首发于 LLVM 19；
  容器 <=> 相关实现随后续版本落地）。C++20 目标编译 BAli-Phy 4.1 时，源码里
  直接使用 string/vector/variant 的 <=> 会编译失败。同时，把 defaulted
  operator<=> 改为手写后，C++20 隐含生成的 operator== 也随之消失，必须显式补回，
  否则 operator== 引用处再次编译失败。
affected_scope: >
  所有以 C++20（cppstd=20）为目标、对 std::string/std::vector/std::variant
  （或含其成员）使用 operator<=> 的 OHOS 库；任何使用 clang15/libc++15
  toolchain 的 C++20 项目都可能命中。
verification_cmd: >
  clang++ -std=c++20 -c <src.cc>    # 复现: no match for 'operator<=>'
  修复后: meson test 218/218 + test_package 10/10（bali-phy 实机）

rec_priority:           1
rec_approach:           portable-spaceship-equivalent
rec_description: >
  在公共头（bali-phy 0002 置于 src/computation/core/ast.H）提供两个可移植等价
  函数：compare_string(a,b)（内部 a.compare(b) 映射到 strong_ordering）与
  compare_vector(a,b)（逐元素 <=> + 长度序），把 9 处对 string/vector/variant
  的 operator<=> 改写为调用这两个函数；同时把因改写而失去隐含 operator== 的
  4 个原 defaulted 类型（Pattern/Alts/Constant/integer_container）按
  (*this <=> v2)==equal 显式补回 operator==。
rec_command:            >
  # 0002 patch 要点：
  #   inline std::strong_ordering compare_string(const std::string&, const std::string&)
  #   template<class T> std::strong_ordering compare_vector(const std::vector<T>&, ...)
  #   name <=> v2.name        -> compare_string(name, v2.name)
  #   args <=> a2.args        -> compare_vector(args, a2.args)
  #   Pattern/Alts/Constant/integer_container: 补 bool operator==(…)=( *this <=> v)==equal
rec_auto_fix:           false
rec_impl:               recipe-patch-portable-spaceship

fallback_priority:      2
fallback_approach:      upgrade-sdk-toolchain
fallback_description: >
  若 OHOS SDK 提供 clang17+/libc++17+（容器 <=> 已落地），可整体升级 toolchain
  而不改源码；但 OHOS SDK 15 为当前可用基线，升级依赖 SDK 发布，故以等价实现
  为推荐方案。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       -std=c\+\+17.*replace.*-std=c\+\+20|drop.*cppstd=20
forbid_1_reason:        降级语言标准会改变 ABI/语义并掩盖 C++20 依赖
forbid_1_consequence:   其他 C++20 特性（如 span/constexpr）不可用，语义漂移
forbid_2_pattern:       asm.*avx.*memory.*bypass|#pragma.*optimize.*off
forbid_2_reason:        与缺失标准库操作符无关的绕行手段
forbid_2_consequence:   不修复编译失败且引入不确定性

principles:             P005, P011
similar_to:             E130, E133, E306, E191
conflicts_with:
prerequisite_of:

