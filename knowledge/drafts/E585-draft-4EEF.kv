#====================================================================
# E585 — OHOS libc++ 无 <tr1/memory>：TR1 写法需迁移到 C++11 标准库
# 触发事件: vzlogger 0.8.9 HarmonyOS PC 适配（include/shared_ptr.hpp）
#====================================================================

id:                     E585
trigger_tool:           clang
phase:                  compilation
error_signature:        fatal error: .tr1/memory. file not found|tr1/memory.*No such file|std::tr1::shared_ptr.*no member|std::tr1::enable_shared_from_this.*no member

severity:               2
category:               headers, portability, libc
match_keywords:         tr1/memory, std::tr1, shared_ptr, TR1, libc++, header not found, C++11, enable_shared_from_this
title:                  OHOS libc++ 无 <tr1/memory>：旧代码 std::tr1::shared_ptr 需迁移到 <memory> + std::shared_ptr

root_cause:             OHOS 工具链的 libc++（LLVM libc++）不提供 C++ TR1 兼容头 <tr1/memory>；仍使用 std::tr1::shared_ptr / std::tr1::enable_shared_from_this（C++11 之前 TR1 写法）的旧版 C++ 代码，在编译时直接报 "fatal error: 'tr1/memory' file not found"。
affected_scope:         依赖 <tr1/memory> 的旧 C++ 代码（C++11 之前的 TR1 写法）在 OHOS PC 工具链（clang 15 + libc++）下无法编译。
verification_cmd:       1) 编译前 grep -rn "tr1/memory|std::tr1" 源码确认引用位置；2) 修复后重新 make，确认无 tr1/memory 相关报错。已在 vzlogger 0.8.9 实证：修复 shared_ptr.hpp 后编译通过。

rec_priority:           1
rec_approach:           std-library-migration
rec_description:        将 #include <tr1/memory> 改为 #include <memory>，std::tr1::shared_ptr / std::tr1::enable_shared_from_this 改为 std:: 命名空间对应类型（C++11 标准库已内置，无需额外依赖链接）。
rec_command:            sed -i 's|#include <tr1/memory>|#include <memory>|; s|std::tr1::shared_ptr|std::shared_ptr|g; s|std::tr1::enable_shared_from_this|std::enable_shared_from_this|g' include/shared_ptr.hpp
rec_auto_fix:           true
rec_impl:               source-edit

fallback_priority:      2
fallback_approach:      vendored-header-shim
fallback_description:   若全量迁移影响面过大（TR1 用法遍布多处），可在系统 include 路径外提供自研 <tr1/memory> 转发头（#include <memory> + using std::shared_ptr 到 std::tr1 命名空间），但仅建议临时过渡。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          source-edit

forbid_1_pattern:       #define.*shared_ptr.*__OHOS__|stub.*tr1/memory
forbid_1_reason:        OHOS libc++ 缺 TR1 头是"头文件不存在"，不是符号冲突；空 stub 转发头无必要且易导致 ABI 不一致。
forbid_1_consequence:   引入与 C++11 std 命名空间冲突的同名实体，下游混合使用 std::/std::tr1:: 时歧义或重复符号。

principles:             []

