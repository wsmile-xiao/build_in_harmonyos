#====================================================================
# DRAFT — OHOS gdk-pixbuf 生态缺 SVG loader：librsvg 启用 pixbuf-loader
# 构建 gdk-pixbuf SVG loader 插件并随包安装 + loaders.cache 部署 + 进程级解码验证
# 触发事件: librsvg 2.62.3.1（pc1-55 r01）HarmonyOS PC 适配
# 日期: 2026-09-19
#
# 与既有条目的关系（增量说明）:
#   E090   = meson custom_target 构建期执行宿主二进制（build 期触发面交集）
#   E255   = 资源型库 test_package 场景（关键词交集，非 loader 缺失）
#   E452   = 任务私有共享库副本重签（签名域，非本场景根因）
#   E471/E527 = gtk 显示后端/broadway（无关）
#   本条增量 = gdk-pixbuf 生态缺失 librsvg SVG loader 插件 → librsvg 需以
#   pixbuf-loader=enabled 构建 loader 模块，随包安装到 lib/gdk-pixbuf-2.0/
#   2.10.0/loaders/，部署 loaders.cache，并完成 gdk-pixbuf-query-loaders
#   发现 + gdk-pixbuf 进程级 SVG 解码复验；全知识库无先例条目，跨库可复用
#   （任何依赖 SVG 解码的库）。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-LIBRSVG-GDKPIXBUF-SVG-LOADER
trigger_tool:           gdk-pixbuf|gdk-pixbuf-query-loaders|meson|librsvg|conan
phase:                  configuration|installation|runtime|testing
error_signature:        Failed to load image.*unrecognized image file format|loader.*not.*found|gdk_pixbuf_new_from_file.*Error loading image|Image.*type.*is not supported|no loader.*svg|libpixbufloader_svg\.so

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               ohos, gdk-pixbuf, svg, loader, librsvg, meson, pixbuf-loader, gnome-ecosystem
match_keywords:         gdk-pixbuf, SVG loader, svg, pixbuf-loader, librsvg, libpixbufloader_svg, loaders.cache, gdk-pixbuf-query-loaders, 2.10.0, moduledir, cache_file, rsvg, icon, Scalable Vector Graphics
title:                  OHOS gdk-pixbuf 生态缺 SVG loader：librsvg 需 pixbuf-loader=enabled 构建 loader 插件并随包安装 + loaders.cache 部署 + query-loaders 发现 + 进程级解码复验

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             gdk-pixbuf 生态的 SVG 解码依赖 librsvg 提供的 loader 插件
                        （libpixbufloader_svg.so）。OHOS 制品仓既有 librsvg 版本
                        可能以 pixbuf-loader=disabled 构建（无 loader 模块），导致
                        gtk4/gtk3 等下游测试环境的 gdk-pixbuf 无法解码 SVG
                        （"unrecognized image file format" 类报错）。启用 loader
                        需同时满足：① meson 构建选项 pixbuf-loader=enabled；
                        ② gdk-pixbuf-2.0.pc 提供 gdk_pixbuf_moduledir /
                        gdk_pixbuf_cache_file 变量（PkgConfigDeps 生成版缺失，
                        gdk-pixbuf-loader/meson.build get_variable 依赖它们定位
                        loader 安装目录与 loaders.cache 路径）；③ 构建期
                        gdk-pixbuf-query-loaders 可执行（写进 meson native file
                        [binaries] 段，meson find_program 优先命中 native 声明）；
                        ④ 安装期 meson_install.py 以 --queryloaders/--cache-file
                        生成 loaders.cache；⑤ loader ELF 签名（OHOS 拒绝未签名
                        ELF）。任一缺失则 loader 不随包安装或不可被 gdk-pixbuf
                        加载。
affected_scope:         OHOS aarch64 上任何依赖 gdk-pixbuf SVG 解码的库与应用
                        （gtk4/gtk3 测试环境、vips、imlib2 等 gdk-pixbuf 消费者）。
                        亦适用于 gdk-pixbuf 2.44 系（loader 模块目录 2.10.0）。

verification_cmd: |
  # 1) 构建配置证据（conan create 日志）
  grep -E "pixbuf-loader|Generating gdk-pixbuf-loader/pixbufloader-svg" <conan-create.log>
  # 2) loader 模块随包安装
  find <pkg>/lib/gdk-pixbuf-2.0/ -name "libpixbufloader_svg.so"
  # 3) gdk-pixbuf-query-loaders 发现（LD_LIBRARY_PATH 含全部依赖 libdirs）
  GDK_PIXBUF_MODULEDIR=<pkg>/lib/gdk-pixbuf-2.0/2.10.0/loaders \
    <gdk-pixbuf>/bin/gdk-pixbuf-query-loaders | grep -A3 "libpixbufloader_svg"
  # 4) 进程级解码（公开 API gdk_pixbuf_new_from_file，返回非 NULL）
  <decode_svg> <min.svg>   # -> DECODE_OK WxH
  # 5) loaders.cache 产出
  grep -c "libpixbufloader_svg" <loaders.cache>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           enable-pixbuf-loader-and-deploy-loaders-cache
rec_description:        librsvg 配方 generate() 设 tc.project_options["pixbuf-loader"]=
                        "enabled"；生成器后处理补齐 gdk-pixbuf-2.0.pc 的
                        gdk_pixbuf_moduledir（${prefix}/lib/gdk-pixbuf-2.0/
                        2.10.0/loaders）与 gdk_pixbuf_cache_file（${prefix}/lib/
                        gdk-pixbuf-2.0/2.10.0/loaders.cache）；_inject_gdkpixbuf_
                        query_loaders 把 gdk-pixbuf 包 bin/gdk-pixbuf-query-loaders
                        写进 conan_meson_native.ini [binaries]；安装期由
                        gdk-pixbuf-loader/meson_install.py --queryloaders ...
                        --cache-file ... 生成 loaders.cache；package() 用
                        binary-sign-tool 对 loader .so 签名。
rec_command: |
  tc.project_options["pixbuf-loader"] = "enabled"
  # _generate_alias_pcs: 追加 gdk_pixbuf_moduledir/gdk_pixbuf_cache_file
  # _inject_gdkpixbuf_query_loaders: native [binaries] 注入
  # package(): llvm-objcopy --remove-section .codesign; binary-sign-tool sign -selfSign 1
rec_auto_fix:           false
rec_impl:               recipe

fallback_priority:      2
fallback_approach:      deploy-loader-externally
fallback_description:   若无法改 librsvg 配方（上游约束），可在测试环境把已构建的
                        libpixbufloader_svg.so 部署到 gdk-pixbuf 的 loaders 目录并
                        用 gdk-pixbuf-query-loaders 重建 loaders.cache（运行时部署，
                        不经 conan 图）。
fallback_command: |
  cp libpixbufloader_svg.so <gdk-pixbuf>/lib/gdk-pixbuf-2.0/2.10.0/loaders/
  GDK_PIXBUF_MODULEDIR=<gdk-pixbuf>/lib/gdk-pixbuf-2.0/2.10.0/loaders \
    <gdk-pixbuf>/bin/gdk-pixbuf-query-loaders > loaders.cache
fallback_auto_fix:      false
fallback_impl:          deployment

forbid_1_pattern:       pixbuf-loader.*disabled.*without.*loader|跳过 loader
forbid_1_reason:        pixbuf-loader 关闭即无 loader 模块，下游 SVG 解码必然失败。
forbid_1_consequence:   gtk4/gtk3 测试 SVG 用例持续失败（本任务起点）。
doc_file:               DRAFT-librsvg-2.62.3.1-gdkpixbuf-svg-loader.md
