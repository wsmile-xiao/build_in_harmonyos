#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: conan|meson
phase: configuration
error_signature: Version conflict: Conflict between libx11/.* and libx11/.* in the graph|Conflict originates from libxi/|libx11/1\.8\.[0-9]+ vs libx11/6\.4\.0

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, build-system, platform
match_keywords: version conflict, libx11, libxi, libxtst, libxext, libxfixes, conan graph, 6.4.0, 1.8.13, X11, soname, dependency group
title: X11 家族在 ohpcd 制品仓按 .so 主版本命名：libxi/libxtst/libxext/libxfixes 固定拉 libx11/6.4.0，顶层再声明 libx11/1.8.x 会触发 conan 图版本冲突

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 制品仓同时存在两套 X11 命名：旧的按上游版本号命名（libx11/1.8.13、libxi/1.8.3、libxtst/1.2.5）与按 .so 主版本命名的新组（libx11/6.4.0 = libX11.so.6.4.0、libxi/6.1.0、libxtst/6.1.0、libxext/6.4.0、libxfixes/6.1.0）。6.x 组的 recipe 内部固定 requires libx11/6.4.0，因此任何顶层声明 libx11/1.8.13 的 recipe 都会在 conan graph 解析阶段爆 "Version conflict: Conflict between libx11/6.4.0 and libx11/1.8.13 (Conflict originates from libxi/...)"，构建尚未开始即失败
affected_scope: 任何在 ohpcd 消费 X11（Xlib/XInput2/XTest）的 recipe：GTK/Qt X11 GUI 应用、X11 工具、wm/合成器等。实测：xclicker 1.5.1（依赖 libx11+libxi+libxtst）
verification_cmd: conan graph info archives/x/xclicker/1.5.1 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: align-x11-family-to-soname-version-group
rec_description: 把 recipe 的 X11 依赖整体对齐到 6.x 同源组（libx11/6.4.0 + libxi/6.1.0 + libxtst/6.1.0），不要混用 1.8.x 旧 ref；先 conan graph info / conan download --only-recipe 确认组内每个 ref 已发布，再写 requires
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: let-transitive-x11-resolve
fallback_description: 只显式声明确实直接使用其头文件的 X11 包（如需 Xlib 就声明 libx11），其余交给 libxi/libxtst 传递解析到同一 6.x 组；提交前用 conan graph info 校核无 version conflict
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: libx11/1\.8\.[0-9]+.*libxi/6\.1\.0|libx11/1\.8\.[0-9]+
forbid_1_reason: 1.8.x 与 6.x 两套 ref 并存必然触发 conan graph 版本冲突
forbid_1_consequence: conan graph 解析阶段直接 ERROR，构建未开始即失败，浪费整轮 CI
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

