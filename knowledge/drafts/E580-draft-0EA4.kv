#====================================================================
# E580 — init-build F068 嵌套源码提升误判 autotools 项目（根目录仅 configure.ac）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E580
trigger_tool:           init-build|autotools|configure
phase:                  configuration
error_signature:        解压后源码目录只剩扁平文件|Db 目录不存在|configure\.ac.*No such file or directory|Makefile\.am.*not found|嵌套源码提升完成.*Server

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               build-system, autotools, ohos
match_keywords:         _promote_nested_source, _find_source_subdir, 嵌套源码提升, configure.ac, Makefile.am, F068, init-build, Server 子目录, 手写 Makefile, 源码目录丢失

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             init_build.py 的 F068 嵌套源码提升逻辑 `_promote_nested_source` 使用
                        `_BUILD_MARKERS = ("configure", "CMakeLists.txt", "Makefile",
                        "meson.build")` 判断根目录是否为源码根；autotools 源码包 tarball
                        根目录通常只有 configure.ac + Makefile.am（不含 configure/Makefile），
                        根目录判定失败后 `_find_source_subdir` 递归搜索子目录，把含手写
                        Makefile 的业务子目录（如 whitedb 的 Server/）误判为"嵌套源码层"
                        并提升到根目录，同时删除其余全部真实源码目录（Db/Main/Parser/Test/
                        Admin 等）。单层提升 `_extract` 已正确把 whitedb-0.8.0alpha/ 提升到
                        根目录后，`_promote_nested_source` 又叠加一次误提升，造成二次破坏。
affected_scope:         tarball 根目录只有 configure.ac/Makefile.am（无预生成 configure/Makefile）
                        的 autotools 项目，且源码内含带手写 Makefile 的子目录（如 Server/）；
                        whitedb 0.8.0alpha 实测触发
verification_cmd:       ls -d Db Main Parser Test 2>/dev/null || echo "MISSING: 源码目录被误提升删除"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           manual-rebuild-dual-track
rec_description:        init-build 解压后若 work/orig 只剩扁平文件（对应某子目录内容）而
                        configure.ac/Db 等消失，判定为 F068 误提升。手动重建：从 tarball
                        重新解压到 .orig（只做单层提升 whitedb-0.8.0alpha/ → 根），复制出
                        .work，重写 .tarball-sha256，重建 edit-tracker 基线（edit_tracker
                        snapshot），清理损坏备份后继续正常适配流程
rec_command: |
  # 备份损坏目录 → 重建 .orig
  mv .orig .orig.broken && mv .work .work.broken
  mkdir -p .orig && tar xzf $BUILD_TARBALL -C .orig
  sub=$(ls -d .orig/*/ | head -1); mv $sub/* .orig/ && rmdir $sub
  sha256sum $BUILD_TARBALL | awk '{print $1}' > .orig/.tarball-sha256
  # 重建 .work + edit-tracker 基线
  mkdir -p .work && cp -a .orig/. .work/ && rm -f .work/.tarball-sha256
  python3 -c "from ohc.edit_tracker import snapshot; snapshot('.work')"
  rm -rf .orig.broken .work.broken
rec_auto_fix:           false
rec_impl:               manual-rebuild

# 回退方案
fallback_priority:      2
fallback_approach:      skip-promotion
fallback_description:   若 init-build 支持跳过嵌套提升参数则直接禁用；否则用 --no-download 模式手动解压
fallback_command:       tar xzf $BUILD_TARBALL && mv <extracted>/* $BUILD_SRC_DIR/
fallback_auto_fix:      false
fallback_impl:          manual-restore

# ★ 禁止策略 ★
forbid_1_pattern:       rm -rf 原始 tarball
forbid_1_reason:        tarball 是唯一完整源码来源，误提升后必须靠它重建
forbid_1_consequence:   删除后无法恢复完整源码树

# ═══ Layer 4: 原则引用 ═══
principles:

