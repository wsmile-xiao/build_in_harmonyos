#====================================================================
# Draft E3003 — ethtool_cmd_speed 符号级链接探测（glibc 有 / musl 缺）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E3003
trigger_tool:           waf|configure|cc|clang|ld
phase:                  configuration|linking
error_signature:        ethtool_cmd_speed|HAVE_ETHTOOL_CMD_SPEED|undefined reference to .ethtool_cmd_speed|declared here but not defined

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               detection, libc, musl, socket, glibc
match_keywords:         ethtool_cmd_speed, ethtool, HAVE_ETHTOOL_CMD_SPEED, symbol probe, link probe, glibc-only symbol, socket, interfaces, link speed
title:                  ethtool_cmd_speed 符号级链接探测：glibc 提供的符号在 musl 缺失，用**链接结果**定义 HAVE_，不用平台宏
prescan_pattern:        ethtool_cmd_speed|HAVE_ETHTOOL_CMD_SPEED
prescan_globs:          wscript, wscript_build, *.c, *.h, configure

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             `ethtool_cmd_speed` 是 glibc 提供的符号，libc（musl）无对应实现。若在源码/头文件中按平台分支判断，会引入平台宏（违反 R8/PF5）；而按"头文件里存在声明"判断会误判（声明存在但链接符号缺失）。正确做法是**符号级链接探测**：写一个引用 `ethtool_cmd_speed` 的小程序/tu 并尝试链接，由工具链真实链接结果决定是否定义 `HAVE_ETHTOOL_CMD_SPEED`。
affected_scope:         任何在 OHOS/musl 上引用 glibc 专有符号（ethtool_cmd_speed 类）的源码 probe；samba source3/lib/socket/interfaces.c 链路速率查询。
verification_cmd:       python3 buildtools/bin/waf configure 2>&1 | grep -i ethtool   # 观察 Checking for HAVE_ETHTOOL_CMD_SPEED
                        # 或手工编译: echo 'int ethtool_cmd_speed(); int main(){return ethtool_cmd_speed();}' | $(CC) -x c - -o /dev/null

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           ohos-symbol-link-probe
rec_description:        用 waf 的链接探测（build a small program that references the symbol ↔ link success）定义 `HAVE_ETHTOOL_CMD_SPEED`，由工具链真实链接结果决定，不使用平台宏。
rec_command:            (cd $TMPDIR && echo 'int ethtool_cmd_speed(void); int main(void){return ethtool_cmd_speed();}' | ${CC} -x c - -o /dev/null 2>&1)
rec_auto_fix:           false
rec_impl:               archives/s/samba/4.21.0/patches/0003-lib-socket-wscript.patch

fallback_priority:      2
fallback_approach:      runtime-capability-degrade
fallback_description:   无该符号时在调用侧做运行时能力降级（如 `*speed=0` 兜底），由调用点代码按 HAVE_ 分支备好降级路径。
fallback_command:       (make)   # 触发编译，验证无符号分支走兜底
fallback_auto_fix:      false

# ★ 禁止策略 ★
forbid_1_pattern:       __OHOS__|__linux__.*ethtool|#if.*glibc.*ethtool|HAVE_ETHTOOL_CMD_SPEED.*__(aarch64|arm)__
forbid_1_reason:        R8/PF5 禁平台/架构宏；按平台分支判定会掩盖真实链接语义。
forbid_1_consequence:   平台宏未经链接证据，在其它 libc/arch 上误判；W4/preflight 宏检查命中。

# ═══ Layer 4: 原则引用 ═══
principles:             real-evidence-over-assumption, platform-agnostic-fix, minimal-patch

# ═══ 关系图 ═══
causes:                 [E3003]
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 / 协作 / 度量 ═══
