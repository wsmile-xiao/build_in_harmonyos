#====================================================================
# DRAFT-minlzma-1.1.5-cmake-no-install-subdir-keep-path
#    上游 CMake 无 install() 规则时，库产物在 build 子目录；
#    package() 需显式源子目录 + keep_path=False，否则 CMakeDeps
#    在 lib/ 根目录找不到库（Library 'xxx' not found in package）
# 来源: minlzma 1.1.5 适配（Path B 知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-minlzma-1.1.5-cmake-no-install-subdir-keep-path
trigger_tool:           conan|conan create|test_package|CMakeDeps
phase:                  packaging|test_package
error_signature:        Library '[^']+' not found in package|
                         Conan: Target declared '[^']+'|
                         cmakedeps_macros.cmake.*not found in package|
                         Could not find library

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, packaging, cmake, keep_path, build-subdir
match_keywords:         install(), 无 install, keep_path, 子目录, build subdir,
                        CMakeDeps, not found in package, minlzlib, add_subdirectory,
                        cmake.install(), Library not found, 库产物位置
title:                  上游 CMake 无 install() 规则时，package() 必须显式指定产物子目录并以 keep_path=False 平铺，否则 CMakeDeps 报 Library 'xxx' not found in package

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游 CMake 工程（minlzma 等）没有 install() 规则，且目标库通过
                        add_subdirectory 构建在 build 目录的子目录（如 minlzlib/）下。
                        package() 若从 self.build_folder 根目录 copy("*.a") 并保留相对路径
                        （keep_path 默认 True），产物落在 lib/minlzlib/libxxx.a，而
                        CMakeDeps 按 cpp_info.libdirs=["lib"] 在 lib/ 根目录查找
                        libxxx.a → 报 "Library 'xxx' not found in package"，G2 的
                        test_package 阶段失败。
affected_scope:         任何无 install() 规则、产物在 build 子目录的 CMake 库；conan create
                        的 test_package find_package 阶段直接失败。
verification_cmd:       find <conan-cache>/p/<pkg>/b -name '*.a' -o -name '*.so' | head；
                        对比 package 目录 lib/ 下是否有 lib<name>.a

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           package-subdir-keep-path-false
rec_description:        package() 中按产物实际子目录显式 copy，并 keep_path=False：
                        copy(self, "*.a", src=os.path.join(self.build_folder, "<subdir>"),
                             dst=lib_dir, keep_path=False)；CLI 同理
                        copy(self, "<cli>", src=os.path.join(self.build_folder, "<subdir>"),
                             dst=bin_dir, keep_path=False)。头文件从 source_folder copy。
                        不改上游源码、不引入 install() 补丁。
rec_command:            python3 - <<'EOF'（示意）
                        copy(self, "*.a", src=os.path.join(self.build_folder, "minlzlib"),
                             dst=os.path.join(self.package_folder, "lib"), keep_path=False)
                        copy(self, "minlzdec", src=os.path.join(self.build_folder, "minlzdec"),
                             dst=os.path.join(self.package_folder, "bin"), keep_path=False)
                        EOF
rec_auto_fix:           false
rec_impl:               manual

# 回退方案
fallback_priority:      2
fallback_approach:      add-install-rule-patch
fallback_description:   若上游产物布局过散，可在 patches/ 增加最小 install() 规则补丁后再
                        cmake.install()；但补丁需过 PF 平台宏闸与 W4 审计，尽量先用手动 copy。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 ★
forbid_1_pattern:       write_file.*conanfile.py|手写 .ci-result.json
forbid_1_reason:        配方须经 conan-verify 实测，禁止伪证
forbid_1_consequence:   audit 失真一票否决

