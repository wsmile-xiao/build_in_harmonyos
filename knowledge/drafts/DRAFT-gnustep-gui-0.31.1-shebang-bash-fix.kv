#====================================================================
# DRAFT-gnustep-gui-0.31.1-shebang-bash-fix
# gnustep-make 包内脚本 shebang 需复制并修复为 /data/service/hnp/bin/bash
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: gnustep-gui 0.31.1 HarmonyOS PC 适配（PR #7408）
#====================================================================

id:                     DRAFT-gnustep-gui-0.31.1-shebang-bash-fix
trigger_tool:           shell|bash|make|gnustep-make|install
phase:                  configuration|build|install
error_signature:        /bin/sh.*not found|bad interpreter|/bin/bash.*not found|Permission denied.*script|exec.*denied.*shell|No such file or directory.*sh
severity:               3
category:               ohos|shell|gnustep|environment|toolchain|install
match_keywords:         shebang, /data/service/hnp/bin/bash, /bin/sh, gnustep-make scripts, exec restricted, hmdfs, shell interpreter
title:                  Fix gnustep-make package script shebangs to /data/service/hnp/bin/bash on OHOS
root_cause:             Scripts shipped inside the gnustep-make package use a shebang
                        (e.g. /bin/sh or /bin/bash) that either does not exist or is
                        exec-restricted on the OHOS worker (hmdfs). Copying the script into
                        the current package directory and rewriting the shebang to
                        /data/service/hnp/bin/bash makes it executable and relocatable on
                        OHOS.
affected_scope:         GNUstep packages that invoke helper scripts from the gnustep-make
                        tool package on OHOS workers where /bin/sh is unavailable or
                        restricted.
verification_cmd:       After copying and fixing the shebang, run the script during
                        configure/build; verify it executes without 'not found' or
                        'Permission denied'.

rec_priority:           1
rec_approach:           copy-and-fix-shebang
rec_description:        Copy the needed gnustep-make script into the current package's
                        directory, rewrite its shebang to /data/service/hnp/bin/bash, and
                        invoke the local copy so the OHOS worker can execute it.
rec_command:            cp <gnustep-make>/bin/<script> . && sed -i '1s|.*|#!/data/service/hnp/bin/bash|' <script> && ./<script>
rec_auto_fix:           false
rec_impl:               conan-recipe-build

fallback_priority:      2
fallback_approach:      inline-reimplementation
fallback_description:   If the script cannot run after shebang rewrite, inline the needed
                        logic directly in the recipe (e.g. mkdir -p, env setup) to avoid
                        depending on the restricted helper script.
fallback_command:       inline the helper logic in the recipe
fallback_auto_fix:      false
fallback_impl:          conan-recipe-build

forbid_1_pattern:       invoke.*gnustep-make.*script.*with.*original.*shebang
forbid_1_reason:        Original shebang (/bin/sh or /bin/bash) is unavailable/restricted on OHOS.
forbid_1_consequence:   Configure/build fails with 'not found' or 'Permission denied'.
forbid_2_pattern:       hardcode.*package_folder.*in.*shebang
forbid_2_reason:        gnustep-make is a shared relocatable Conan tool package.
forbid_2_consequence:   Builds become cache-location dependent.

principles:             P013,P014
causes:                 []
caused_by:              []
similar_to:             E337
conflicts_with:         []
prerequisite_of:        []

