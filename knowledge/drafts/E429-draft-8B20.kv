#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: conan|clang|make
phase: build
error_signature: sys/sysctl.h.*No such file|errc.*undefined symbol|__FBSDID.*undeclared|incompatible integer to pointer conversion passing 'long' to parameter of type 'const char \*'

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: ohos,bsd-make,cdefs-macro,sysctl,libc-compat
match_keywords: __FBSDID, __dead2, errc, sysctlbyname, sys/sysctl.h, BSD make, machine uninitialized
title: FreeBSD 专有接口（sysctl/errc/cdefs 宏）迁移 OHOS 的守卫与替换

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
affected_scope:         FreeBSD 系 make/autotools 工具链迁移 OHOS 时遇到的 sys/cdefs.h 宏、sysctl(3)、errc() 缺失
verification_cmd:       conan create archives/b/bsdmake/24 --build=missing 后运行 test_package/test.sh（4 组断言全通过）
root_cause: FreeBSD 源码头文件 sys/cdefs.h 提供 __FBSDID/__dead2 等宏、sys/sysctl.h 提供 sysctl(3)、libc 提供 errc()，OHOS 均缺失；且平台守卫若整块包裹 getenv 赋值会导致未初始化局部变量 UB
affected_scope:

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: ①sysctl/sysctlbyname 用 #ifdef __FreeBSD__ 守卫（只守卫调用本体，保留 getenv 赋值）；②编译参数注入 -D'__FBSDID(x)=' 与 -D'__dead2=__attribute__((__noreturn__))'；③errc() 等价替换为 errno=EAGAIN + err()
rec_description: bsdmake-24 适配实践：Apple BSD make 依赖 FreeBSD 专有接口，OHOS 需守卫与替换
rec_command: clang -D'__FBSDID(x)=' -D'__dead2=__attribute__((__noreturn__))' -DDEFSHELLNAME=\"sh\" -DMAKE_VERSION=\"5200408120\" -I. -c *.c
rec_auto_fix: true
rec_impl: platform-guard-plus-macro-inject

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: compile-time-macro-only
fallback_description: 若不改源码，仅靠编译参数无法消除 sys/sysctl.h 头文件缺失，需提供 stub 头或整体禁用相关代码路径
fallback_command: sed -i 's/#include <sys\/sysctl.h>/\/\* disabled on OHOS \*\//' main.c
fallback_auto_fix:      false
fallback_impl: none
# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: .*platform.*ifndef __FreeBSD__.*\n.*#ifdef __APPLE__.*sysctl
forbid_1_reason: 用整块 #ifdef 包裹含 getenv 赋值的代码会导致非 FreeBSD 平台局部变量未初始化 UB（bsdmake 实测段错误）
forbid_1_consequence: 运行时随机段错误，调试成本高
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: R8, R33

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

