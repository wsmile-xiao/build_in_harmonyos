#====================================================================
# E635.kv (draft) — OHOS 无系统时区数据库，Python stdlib zoneinfo 需 vendored tzdata
#====================================================================

id:                     E635
trigger_tool:           python|pip|test|runtime
phase:                  testing|runtime
error_signature:        zoneinfo\._common\.ZoneInfoNotFoundError|No time zone found with key|tzlocal\(\) does not support non-zoneinfo timezones like

severity:               2
category:               ohos, compat, portability, runtime, python
match_keywords:         ZoneInfoNotFoundError, zoneinfo, tzlocal, tzdata, /usr/share/zoneinfo, get_localzone, dateparser, TZ=UTC, tzdb
title:                  OHOS 无系统时区数据库：Python 标准库 zoneinfo（tzlocal/dateparser 走它）需随包 vendored PyPI tzdata

root_cause:             本平台没有 /usr/share/zoneinfo（stdlib zoneinfo 的 TZPATH 系统目录全部不存在），Python 标准库
                        zoneinfo 因此找不到任何时区。tzlocal.get_localzone() 与 dateparser 都经由 stdlib zoneinfo 解析
                        时区，于是抛 ZoneInfoNotFoundError。pytz 自带时区数据，不受影响——所以同一套用例里只有走
                        zoneinfo 的那部分失败，容易误判为"用例本身有问题"。
affected_scope:         所有在 OHOS 上使用 Python 标准库 zoneinfo / tzlocal / dateparser（以及任何只依赖系统 tzdb
                        的运行时）的包。对 CLI 类包而言不只是测试失败：工具自身的本地时区解析同样不可用。
verification_cmd:       python3 -c "import zoneinfo; print(zoneinfo.ZoneInfo('UTC'))"
                        # 修复前: ZoneInfoNotFoundError: No time zone found with key UTC
                        # 修复后(把 vendored site-packages 放进 PYTHONPATH): zoneinfo.ZoneInfo(key='UTC')

rec_priority:           1
rec_approach:           vendor-tzdata-package
rec_description:        把 PyPI 的 tzdata 包（zoneinfo 数据库）vendored 进包内 site-packages；stdlib zoneinfo 在系统
                        数据库缺失时会自动回退到该包，无需改任何源码或环境变量
rec_command:            pip install --only-binary=:all: --target=<私有 deps 目录> tzdata
rec_auto_fix:           false
rec_impl:               recipe-vendored-dependency

fallback_priority:      2
fallback_approach:      point-tzdir-at-existing-tzdb
fallback_description:   若环境内已有真实 tzdb（例如另一个包提供），可设 TZDIR 指向它；仅作临时手段，不得把
                        TZ=UTC 当作最终交付方案（会让所有本地时间转换失真）
fallback_command:       export TZDIR=<真实 tzdb 目录>
fallback_auto_fix:      false
fallback_impl:          env-var

forbid_1_pattern:       把 TZ=UTC 硬编码为最终交付方案
forbid_1_reason:        时区能力被降级为常量，本地时间换算全部失真，工具语义被破坏
forbid_1_consequence:   消费者拿到的本地时间与设备实际时区不一致
forbid_2_pattern:       往 /usr/share/zoneinfo 或共享 prefix 写时区数据
forbid_2_reason:        污染共享环境（R49），跨任务互相干扰且不可回滚
forbid_2_consequence:   CI worker 与本地共享文件系统互相污染，问题在别的任务里复现

principles:
causes:                 []
caused_by:              []
similar_to:             E315, E241
conflicts_with:         []
prerequisite_of:        []

