#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E568.kv，填写各字段
# 对应的人类文档: doc/E568.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E568
trigger_tool: python|pip|test
phase: testing
error_signature: Read-only file system|Errno 30|/tmp/afl_multicore\.PGID|No such file or directory: 'setsid'|FileNotFoundError.*setsid

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform,ohos,portability,test-framework
match_keywords: tempfile.gettempdir,TMPDIR,/tmp read-only,Errno 30,setsid,busybox applet,FileNotFoundError,upstream test hardcoded path,pytest --timeout,Popen
title: 上游 Python 包/测试把临时文件路径硬编码 /tmp（OHOS 只读挂载）；setsid 仅以 busybox applet 存在需软链补齐

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: OHOS/HarmonyOS PC 的 /tmp 为只读挂载（erofs, ro），而上游纯 Python 产品代码与测试把临时文件路径硬编码为 /tmp，写入即 OSError [Errno 30] Read-only file system；同环境未提供独立 setsid 可执行文件（仅 busybox applet），subprocess.Popen(['setsid',...]) 抛 FileNotFoundError
affected_scope: 所有在 OHOS 上构建期真实运行上游 pytest 套件的纯 Python 包；产品代码或测试硬编码 /tmp 存临时文件者，或 spawn setsid/pgrep/kill 等 util-linux 小工具者
verification_cmd: python3 -m pytest <tests> -q 2>&1 | grep -E 'Read-only file system|No such file or directory: .setsid.'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: tempfile-gettempdir-plus-busybox-shim
rec_description: 产品代码把硬编码 /tmp 改为 tempfile.gettempdir()（遵循 TMPDIR），并同步修改上游测试用例为同一口径；构建期生成私有 shim 目录，提供 setsid→busybox 软链（busybox 依 argv[0] 分派 applet）与 python→解释器软链，置于测试 PATH 最前
rec_command: export TMPDIR=$HOME/tmp; SHIM=$TMPDIR/shim; mkdir -p $SHIM; ln -sf $(command -v busybox) $SHIM/setsid; ln -sf $(command -v python3) $SHIM/python; PATH=$SHIM:$PATH python3 -m pytest tests
rec_auto_fix: false
rec_impl: conan-recipe-private-shim-and-tempdir-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: env-injection-only
fallback_description: 若不便改产品代码，仅在测试运行环境注入 shim + TMPDIR 并 monkeypatch tempfile；但产品在只读 /tmp 上仍不可用，治标不治本，故优先直接修产品代码
fallback_command:
fallback_auto_fix: false
fallback_impl: env-injection-only

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

