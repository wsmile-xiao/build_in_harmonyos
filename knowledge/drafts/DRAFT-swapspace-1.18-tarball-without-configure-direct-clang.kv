#====================================================================
# DRAFT-swapspace-1.18-tarball-without-configure-direct-clang.kv
# 配对文档: knowledge/drafts/DRAFT-swapspace-1.18-tarball-without-configure-direct-clang.md
# 来源: archives/s/swapspace/1.18 (swapspace 1.18 适配)
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-swapspace-1.18-tarball-without-configure-direct-clang
trigger_tool:           clang|ld|configure|make
phase:                  compilation|linking
error_signature:        use of undeclared identifier 'PACKAGE_VERSION'|use of
                         undeclared identifier 'PACKAGE_STRING'|clang: error: no such
                         file or directory:|duplicate symbol: main

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               build-system, autotools, packaging, compat
match_keywords:         PACKAGE_VERSION, PACKAGE_STRING, config.h.static,
                         config.h, configure.ac, noinst_PROGRAMS, autoreconf,
                         duplicate symbol main, no such file or directory
title:                  autotools 项目的发布 tarball 缺 configure/config.h 时的直编方案

# ═══ Layer 2: 诊断层 ═══
root_cause:             AC_INIT 的 PACKAGE_NAME/PACKAGE_VERSION/PACKAGE_STRING 只经
                         autoheader 生成的 config.h 到达程序；tarball 若不含 configure
                         也就没有 config.h，这些宏直接未定义。此外 self.run() 经 shell
                         执行，值内含空格的 -D 宏未加引号会被拆成多个 argv；autotools
                         的 noinst_PROGRAMS 自带 main，合并链接会 duplicate symbol
affected_scope:         仅含 configure.ac 而无生成 configure/config.h 的小型 autotools C
                         程序（tarball 内未预生成 autotools 产物的项目）
verification_cmd:       ls <srcdir>/configure <srcdir>/src/config.h <srcdir>/src/config.h.static

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           direct-clang
rec_description:        小型 C 项目跳过 autotools：复用上游手写 config.h.static 作为
                         config.h，用 -D 补齐 PACKAGE_* 宏，逐个 clang 调用复现
                         src/Makefile.static 的 target/source 映射；-D 值内含空格须加
                         shell 单引号；noinst_PROGRAMS 独立链接且不打包
rec_command:            cp src/config.h.static src/config.h && clang --std=gnu99 -O2 -Wall
                         -DSUPPORT_LARGE_FILES '-DVERSION="1.18"' '-DDATE="Sat Jan 22 2022"'
                         '-DPACKAGE_VERSION="1.18"' '-DPACKAGE_STRING="swapspace 1.18"'
                         -c src/<unit>.c -o <unit>.o
rec_auto_fix:           false
rec_impl:               manual

fallback_priority:      2
fallback_approach:      tool-requires-autoreconf
fallback_description:   项目文件较多时改走完整 autotools：tool_requires
                         autoconf/automake/m4/perl，在 build() 里 autoreconf -fi
                         再 configure/make
fallback_command:       autoreconf -fi && ./configure && make
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       -D[A-Za-z_]+=.[^"']*\s[^"']*[^'"]
forbid_1_reason:        self.run() 经 shell 执行，未加引号且值内含空格的 -D 宏会被
                         拆成多个 argv，clang 报 "no such file or directory: '<词>'"
forbid_1_consequence:   编译失败且报错信息与真实原因（宏定义错误）无关，误导排查方向
forbid_2_pattern:       将 noinst_PROGRAMS 的 .o 与主程序 .o 一并链接
forbid_2_reason:        noinst_PROGRAMS（如 hog）自带 main()
forbid_2_consequence:   ld 报 duplicate symbol: main

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P008

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

