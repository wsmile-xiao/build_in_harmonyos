#====================================================================
# DRAFT-appstream-1.2.0-ohos-filemonitor-changed-dedup.kv
# GFileMonitor 事件顺序因文件系统而异（ATTRIBUTE_CHANGED 可能先于 CREATED）：
# 同批 queued 的文件即将作为 added 发出时不再重复发 changed（含原子保存临时
# 文件 queue_temp 場景）→ 消除伪 changed 断言失败
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R03）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           GFileMonitor (GLib gio)
phase:                  runtime-event
error_signature:        cnt_changed == 0.*1 == 0|
                        Emit ::changed.*ATTRIBUTE_CHANGED.*CREATED|
                        G_FILE_MONITOR_EVENT_ATTRIBUTE_CHANGED.*EARLIER
severity:               2
category:               build, glib, gio, filesystem, event ordering, portability
match_keywords:         GFileMonitor, G_FILE_MONITOR_EVENT, ATTRIBUTE_CHANGED, CREATED,
                        inotify, file monitor, added, changed, dedup, queue_changed,
                        queue_add, OHOS, event order
title:                  GFileMonitor 事件顺序差异（ATTRIBUTE_CHANGED 先于 CREATED）——同批 added 去重
root_cause:             process_pending 先发 changed 后发 add；部分文件系统事件序
                        中 ATTRIBUTE_CHANGED 先于 CREATED，文件仍在 add/temp 队列
                        就被排队为 changed；上游假设 CREATED 先到。
affected_scope:         任何聚合 GFileMonitor added/changed 事件的实现与其测试。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing; meson test as-test_pool
rec_priority:           1
rec_approach:           filemonitor-batch-dedup
rec_description:        发 changed 前检查路径是否在 queue_add（将 as added 发出）或
                        queue_temp（原子保存临时文件）——命中则跳过，批量去重。
rec_command:            |
  if (_g_ptr_array_str_find (priv->queue_add, tmp) == NULL &&
      _g_ptr_array_str_find (priv->queue_temp, tmp) == NULL)
      as_file_monitor_emit_changed (monitor, tmp);
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       event_type.*ignore.*ATTRIBUTE_CHANGED
forbid_1_reason:        全局忽略属性变更会漏真实 changed（mtime 用例）
principles:             R6, R8
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-ohos-filemonitor-changed-dedup.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R03（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.8
