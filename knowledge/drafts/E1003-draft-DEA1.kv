#====================================================================
# E1003-draft-DEA1.kv — 单头文件 C++ 库缺 <system_error> 包含
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E1003
trigger_tool:           clang|conan|cmake
phase:                  compilation
error_signature:        no member named 'system_error' in namespace 'std'|no member named 'system_category' in namespace 'std'|invalid library name in argument '-stdlib=libstdc++'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               headers, libc++, portability, conan
match_keywords:         system_error, system_category, <system_error>, 缺 include, 传递包含,
                        transitive include, 头文件自包含, self-contained header, single-header,
                        header-only, libc++, OHOS, doctest include order, 消费者编译失败,
                        consumer compile failure, std::system_error
title:                  单头文件 C++ 库缺 #include <system_error>：OHOS libc++ 无传递包含致消费者编译失败（上游 doctest include 顺序掩盖）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             源码头文件使用了 std::system_error / std::system_category() 却未显式
                        #include <system_error>。Linux libstdc++ 下 <string>/<stdexcept> 会传递
                        包含它，编译恰好通过；OHOS libc++（裁剪 STL）无此传递包含，且上游测试
                        源先包含 doctest.h（其内部已含 <system_error>）把缺陷掩盖，导致只有
                        消费者视角（仅含该公开头）编译时才暴露。
affected_scope:         单头文件/header-only C++ 库的跨平台消费；OHOS/裁剪 libc++ 环境下任何
                        依赖传递包含 <system_error> 的头文件
verification_cmd:       /data/service/hnp/bin/clang++ -std=c++17 -Wall -Wextra -Werror -I include -x c++ -fsyntax-only <consumer.cpp> （仅含该公开头）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           add-system-error-include
rec_description:        在头文件中显式加入 #include <system_error>（源码补丁或 conandata patches），保证头文件自包含
rec_command:            patch 添加 `#include <system_error>` 于 include 区（patch_ng / GNU patch 均可）
rec_auto_fix:           true
rec_impl:               patch-include

fallback_priority:      2
fallback_approach:      consumer-side-workaround
fallback_description:   消费者侧先包含 <system_error> 再包含该头（仅临时规避，不推荐提交）
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       -fno-...|#include <bits/...>
forbid_1_reason:        不得用隐藏编译器开关或 GNU 私有头绕过，破坏可移植性
forbid_1_consequence:   其他 libc++/musl 环境仍失败

# ═══ Layer 4: 原则引用 ═══
principles:             headers, portability

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E455, stdex-header-wrapper-shadow-std-headers]
conflicts_with:         []
prerequisite_of:        []

