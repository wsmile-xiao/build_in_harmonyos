#====================================================================
# DRAFT-libmcfp-2.1.1-ohos-float-from-chars-fastfloat.kv
# 主题: OHOS libc++ 缺浮点 from_chars，上游 CPM 网络回退 → 预装 fast_float
#       conan 包 + CPM→find_package-first 补丁 + 目标名改写
# 来源: libmcfp 2.1.1 首轮适配（pc4-13，conan create + 37/37 上游测试 + test_ohos）
#====================================================================

# ═══ Layer 0: 错误面 ═══
id:                     DRAFT-libmcfp-2.1.1-ohos-float-from-chars-fastfloat
trigger_tool:           clang|clang++|cmake|conan
phase:                  configuration|compilation
error_signature:        call to deleted function 'from_chars'|
                        is_integral<float>::value.*not satisfied|
                        from_chars.*float.*not supported|
                        CPMFindPackage.*FastFloat.*download.*failed|
                        CPM: error: Failed to download|mcfp: Using fast_float for std::from_chars

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               platform, libcxx, charconv, cmake, conan, cpm, portability
match_keywords:         from_chars, charconv, float, double, libc++, OHOS, libcxx-ohos,
                        fast_float, FastFloat::fast_float, CPMFindPackage, try_compile,
                        STD_CHARCONV_COMPILING, USE_FAST_FLOAT, find_package CONFIG QUIET,
                        CMakeDeps, _LIBCPP_VERSION, cxx_std_23

# ═══ Layer 2: 诊断层 ═══
title:                  OHOS 上 C++23 浮点 from_chars 缺失 + 上游 CPM 拉 fast_float 网络回退：预装 conan 包并改 find_package-first
root_cause: |
  OHOS SDK (26.0.0.18) 配套 libc++ 的 <charconv> 仅实现整型 from_chars
  （is_integral 约束）与浮点 to_chars 声明；浮点 from_chars（float/double,
  chars_format 重载）未实现，命中 deleted bool 重载或 is_integral 约束模板，
  报 "call to deleted function 'from_chars'"。
  上游库若在 CMakeLists 用 try_compile(STD_CHARCONV_COMPILING, CXX_STANDARD 23)
  探测浮点 from_chars：OHOS 上探测失败后走 CPMFindPackage(NAME FastFloat ...) 从
  github.com 拉 fast_float 8.0.2 —— configure 期网络下载，CI worker 禁网即失败；
  即便网络可用也会 shadow 制品仓已提供的 fast_float。
affected_scope:         C++20/23 库在 OHOS aarch64 依赖浮点 std::from_chars、且上游以
                         CPM/FetchContent 方式拉 fast_float 作回退的构建。

# ═══ Layer 3: 处方层 ═══
rec_approach: |
  1) conanfile.py requirements() 加 self.requires("fast_float/8.0.1")（ohpcd 已发布，
     header-only，包内导出 fast_float::fast_float）；generate() 保留 CMakeDeps。
  2) patch 上游 CMakeLists.txt：CPMFindPackage 块前置 find_package(fast_float CONFIG
     QUIET)，未命中才保留 CPM 兜底；并把引用目标从 FastFloat::fast_float 改为
     fast_float::fast_float（CMakeDeps 实际导出的名字）。
  3) 若上游已设 USE_FAST_FLOAT 宏并按 TARGET_PROPERTY 取 INTERFACE_INCLUDE_DIRECTORIES，
     目标名改写后原表达式继续可用；charconv-fast_float 特化源文件照常编入。
  4) 验证：conan create 全绿；上游 Catch2 套件全量通过；test_ohos 真机浮点解析
     （-d 3.14159 -f 2.5）走 fast_float 路径并断言数值。
solution: |
  conandata.yml patches:
  0001-CMakeLists-preinstalled-fastfloat-first.patch（libmcfp 2.1.1 实证）:
  -    CPMFindPackage(
  -        NAME FastFloat
  -        GIT_REPOSITORY "https://github.com/fastfloat/fast_float"
  -        GIT_TAG v8.0.2
  -        EXCLUDE_FROM_ALL YES)
  +    find_package(fast_float CONFIG QUIET)
  +    if(NOT fast_float_FOUND)
  +        CPMFindPackage(NAME FastFloat GIT_REPOSITORY "https://github.com/fastfloat/fast_float" GIT_TAG v8.0.2 EXCLUDE_FROM_ALL YES)
  +    endif()
  -    $<TARGET_PROPERTY:FastFloat::fast_float,INTERFACE_INCLUDE_DIRECTORIES>
  +    $<TARGET_PROPERTY:fast_float::fast_float,INTERFACE_INCLUDE_DIRECTORIES>
fallback: |
  若上游无 try_compile 探测而是硬编码浮点 from_chars 能力宏，参照
  DRAFT-bitserializer（__OHOS__ 关闭能力宏回退 strtod）或 DRAFT-valijson
  （上游已内置自动检测回退）处理；本方案针对"上游已有 fast_float CPM 回退"场景。
verification_cmd: |
  conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=missing
  # 复现最小探针: printf 'int main(){double d; std::from_chars("1.5","1.5"+3,d);}' | clang++ -x c++ -std=c++2b -c -
verify_builds:           libmcfp 2.1.1 conan create PASS；上游 37/37 Catch2 用例通过；test_ohos T3/T4 PASS
prescan_pattern:        std::from_chars.*(float|double)|CPMFindPackage\(.*FastFloat|CPMAddPackage.*fast_float
kb_ref:                 ""
last_updated:           2026-09-28

# ═══ 关系字段 ═══
similar_to:             DRAFT-bitserializer-0.85.0-ohos-float-from-chars-fallback, DRAFT-valijson-1.1.3-ohos-float-from-chars-auto-fallback
caused_by:              OHOS libc++ 浮点 from_chars 缺失
prerequisite_of:        libmcfp 2.1.1 编译（以及同类 C++23 from_chars 库）
conflicts_with:         ""
