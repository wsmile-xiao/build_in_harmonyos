#====================================================================
# DRAFT — header-only 模板库的「首个 include 即交付头」自包含探针：
#         RingBufCPP.h 用 size_t 却不含 <stddef.h>，OHOS/musl+libc++ 下
#         单独 include 当场 unknown type name 'size_t'；
#         同批登记「上游无测试框架时 N=0 的四口径归因」写法。
# 触发事件: embedded_ringbuf_cpp 1.3 HarmonyOS PC 适配（2026-09-25）
# Reserved entry id: E743（tools/knowledge_id.py --claim --task embedded_ringbuf_cpp-1.3）
#
# 与既有条目的关系（增量说明）:
#   device-facts §二.17 = header-only/application 包整组命中 G4/L2/L4/L5
#     「跳过却打 ✅」⇒ 必须人工补测 —— 本条不重复其结论，本条的增量是
#     **测试装置本身**：把「第一个 include 就是交付头」写进 build() 与
#     test_package 两处，使头文件不自包含这类缺陷在设备上当场变红。
#   DRAFT-jsoncons-1.9.0-test-count-and-baseline-noise = 四口径不混用
#     —— 本条补的是「上游四口径全为 0 时如何逐项归因 + 消费者用例进
#     鸿蒙特有测试行」的最小模板。
#====================================================================

id:                     DRAFT-E743-embedded-ringbuf-cpp-self-contained-header-first-include
trigger_tool:           conan|clang|cmake|git
phase:                  compilation|testing
error_signature:        'unknown type name .size_t.|fatal error: .RingBuf\.h. file not found'

severity:               3
category:               header-only, c++, portability, ohos, self-contained-header, test-count
match_keywords:         RingBufCPP.h, RingBufHelpers.h, RingBuf.h, size_t, stddef.h, header-only, 自包含, 首个 include, unknown type name, add overwrite, 返回值 语义, N=0, 四口径, test_package, 鸿蒙特有测试, patch_ng strip=0, conan G1 def build, tools.build:compiler_executables, examples_no_arduino
title:                  header-only 模板库必须做「首个 include 即交付头」的自包含探针（缺 <stddef.h> 在 OHOS/musl+libc++ 下 unknown type name 'size_t'）；上游无测试框架时按四口径清点 N=0 并归因，消费者用例只进鸿蒙特有测试行

root_cause:             两个独立问题在同一任务暴露。(1) 上游 RingBufCPP.h 使用 size_t
                        却只 include RingBufHelpers.h，而非 Arduino 分支的
                        RingBufHelpers.h 只 include <stdint.h> —— <stdint.h> 不定义
                        size_t（定义它的是 <stddef.h>），头文件因此**不自包含**：能否
                        编译完全取决于消费者是否在它之前恰好 include 过提供 size_t 的头。
                        这是与平台无关的上游缺陷，在 musl/libc++ 这种不额外捎带的实现上
                        必然暴露；只要 test_package 先 include <cstdio> 就永远抓不到。
                        (2) 上游无构建系统、无测试框架：G1 却是纯文本门禁（无
                        package_type 例外分支）必须有 def build(，而"能编过"不等于
                        "被测过"，模板库若只编译实例化就无法证明交付面正确。
affected_scope:         所有 header-only / 单文件 / amalgamation 类交付（头文件即交付物），
                        尤其是模板库与"上游无测试框架"的包；任何 test_package 若先
                        include 标准头再 include 被测头，都会漏掉这类顺序依赖缺陷；
                        同族：上游示例引用了本版本不存在的文件（不可编译）时的 N 归因。
verification_cmd: |
  . "$HOME/tmp/embedded_ringbuf_cpp-1.3/env.sh"
  SRC="$TASK_DIR/w0/src"
  printf '#include <RingBufCPP.h>\nint main(){return 0;}\n' > "$TASK_DIR/repro.cpp"
  clang++ -std=c++17 -I "$SRC" "$TASK_DIR/repro.cpp" -o "$TASK_DIR/repro.out"; echo "rc=$?"   # 期望 1
  clang++ -std=c++17 -I "$TASK_DIR/patchwork/mod" "$TASK_DIR/repro.cpp" -o "$TASK_DIR/repro.out"; echo "rc=$?"   # 期望 0
  grep -c 'stddef.h' "$(conan cache path 'embedded_ringbuf_cpp/1.3:da39a3ee5e6b4b0d3255bfef95601890afd80709')/include/RingBufCPP.h"   # 期望 1（交付头已带补丁）
  grep -c 'CONSUMER TEST PASS' "$TASK_DIR/local-create-3.log"   # 期望 1

rec_priority:           1
rec_approach:           first-include-is-the-delivered-header-probe
rec_description:        header-only 包的测试装置固定三件套：(a) test_package/test.cpp 与
                        build() 内探针都把**交付头**作为第一个 include，紧接实例化模板
                        并断言读写与边界（只编译不算测）；(b) test_package 的 CMakeLists
                        用 find_package 的 include 目录断言被测头存在并 file(SHA256) 打进
                        日志，钉死「测试靶向 == package() 交付的那一份」；(c) 发现头文件
                        不自包含时补**纯标准头 include**补丁（无 __OHOS__ 分支，R8 合规），
                        并用 conan 真实执行路径自证：patch_ng.fromfile(p).apply(strip=0,
                        root=...) 后与目标树 filecmp 逐字节一致（conan patch() 默认 strip=0）。
                        上游无测试框架时 N 按四口径清点（源码宏数/框架注册数/assertion 数）
                        并逐项归因，消费者用例只进「鸿蒙特有测试」行、不进上游分母。
rec_command:            conan create "$HOME/ws/worktrees/embedded_ringbuf_cpp-1.3/archives/e/embedded_ringbuf_cpp/1.3" -pr:h="$HOME/ws/worktrees/embedded_ringbuf_cpp-1.3/ci/conan/profiles/ohos-aarch64" -pr:b="$HOME/ws/worktrees/embedded_ringbuf_cpp-1.3/ci/conan/profiles/ohos-aarch64" -c tools.build:jobs=4
rec_auto_fix:           false
rec_impl:               conan-recipe

forbid_1_pattern:       '#include <cstdio>|#include <stdio\.h>'
forbid_1_reason:        被测头前先 include 标准头会把 size_t 提前带进来，头文件不自包含的
                        缺陷被**顺序依赖**掩盖，测试恒绿而消费者按 README 用法必炸。
forbid_1_consequence:   假绿：conan create 与 CI 全过，外部审查/用户按文档用法第一行就
                        第一行就是 unknown type name 'size_t' 编译失败。

forbid_2_pattern:       上游无测试|没有测试|N/A
forbid_2_reason:        N=0 必须给四口径清点证据（源码宏数/框架注册数/assertion 数全 0 +
                        唯一含 test 的文件不可编译的实测 rc），不能只写结论；审方独立克隆
                        清点，实测 N > 声明 N 即判少报。
forbid_2_consequence:   rule4 少报 FAIL（近段 20 份外部裁决 5/20 命中）。

forbid_3_pattern:       RB_ATOMIC_START.*thread|std::thread.*RingBufCPP
forbid_3_reason:        OHOS/非 Arduino 分支 RB_ATOMIC_START/END 只是普通花括号，没有真实
                        互斥；多线程用例是真竞态，结果不可复现也不能当证据。
forbid_3_consequence:   用例随机红或随机绿，污染通过率与 W4 结论。

principles:             P013,P014
causes:                 []
caused_by:              []
