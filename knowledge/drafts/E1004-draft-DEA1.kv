#====================================================================
# E1004-draft-DEA1.kv — 上游无 git tag 库的版本映射与官方源固定
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E1004
trigger_tool:           conan|conan-create|git|curl
phase:                  configuration|sourcing
error_signature:        404.*tar.gz|Unable to find .*tag|not found.*archive|remote:.*tags|git ls-remote.*空|empty tags

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, versioning, sourcing, portability
match_keywords:         无 tag, no git tag, 版本映射, version mapping, cmake_minimum_required,
                        project VERSION, 官方 commit 归档, commit archive, codeload, sha256,
                        conandata sources, 版本来源, version provenance, 404 tag
title:                  上游无 git tag 的库：任务版本取自 cmake_minimum_required 等源码版本声明，conandata 官方源固定官方 commit 归档 + 实测 SHA-256

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             部分上游仓库不发布 git tag/release（如 README 直接指向 master 单文件），
                        用 tag 归档 URL（v3.8/3.8/v3.8.0 等）探测全部 404，conan registry 亦无
                        版本可用。任务给定的版本号可能取自源码内版本声明（cmake_minimum_required
                        的 CMake 版本、或 project VERSION 等），与上游实际版本体系不一致。
affected_scope:         无 tag 流程的 header-only/单文件仓库的 Conan 配方编写与版本溯源
verification_cmd:       git ls-remote --tags <upstream>; curl -sI https://codeload.github.com/<owner>/<repo>/tar.gz/<commit>

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           pin-official-commit-archive
rec_description:        以任务版本建归档目录；conandata sources.url 固定官方 master/指定 commit 的
                        官方 commit 归档 URL（github.com/.../archive/<sha>.tar.gz，重定向 codeload），
                        sha256 以流式 sha256sum 实测写入；notes.md/manifest 记录版本语义来源
rec_command:            curl -sSL <official commit archive URL> | sha256sum; 写入 conandata.yml
rec_auto_fix:           true
rec_impl:               conandata-commit-source

fallback_priority:      2
fallback_approach:      exports-sources
fallback_description:   仓库过小且网络受限时改用 exports_sources 携带源码（不推荐，CI 镜像机制仍以官方 URL 为准）
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       file://|\.build-cache|predl_cache|currentUser|ghproxy|ghfast
forbid_1_reason:        conandata/提交内容禁止本地路径、缓存路径、代理改写地址与执行端绝对路径（R39）
forbid_1_consequence:   命中 prohibited_markers，PR 被拒/返工

# ═══ Layer 4: 原则引用 ═══
principles:             conan, sourcing

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [DRAFT-E569-codeload-direct-url-bypass-302, E103]
conflicts_with:         []
prerequisite_of:        []

