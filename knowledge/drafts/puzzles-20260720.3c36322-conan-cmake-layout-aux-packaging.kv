#====================================================================
# Draft: puzzles 20260720.3c36322 - conan 2 cmake_layout package()
#        must read the CMake output dir from self.build_folder itself
#        (i.e. .../b/build/Release); conan copy() silently skips a
#        missing src, so auxiliary/cliprogram-style non-install
#        products never reach bin/ and CI L1 fails late
#====================================================================

id:                     DRAFT-PUZZLES-CMAKE-LAYOUT-AUX-PACKAGING
trigger_tool:           conan|conan-create|conan-verify|test_package
phase:                  packaging|testing
error_signature:        command not found|Packaged [0-9]+ files|binary not found|Cannot find source file

severity:               2
category:               conan, cmake, packaging, testing
match_keywords:         cmake_layout, build_folder, self.build_folder, build/Release, auxiliary, cliprogram, package(), shutil.copy2, conan copy, 静默跳过, non-install products, fuzzpuzz, command not found, bin missing
title:                  conan 2 cmake_layout: CMake 输出目录即 self.build_folder（.../b/build/Release）；打包非 install 产物（auxiliary/cliprogram）须用 shutil.copy2 + isfile 检查，conan copy() 对缺失 src 静默跳过导致包缺文件但 create 成功、CI L1 才暴露

root_cause:             conan 2 的 cmake_layout 把单配置构建输出放在 build 根下的 build/Release，且生成器把 self.build_folder 指向该 CMake 输出目录本身（.../b/build/Release），不是 build 根；conan copy() 的 src 不存在时静默跳过（无告警），包内缺文件但 conan create 仍成功；上游 CMake 通常不 install auxiliary/cliprogram 类测试程序，需在 package() 显式搬运，否则 CI test_package 阶段从 PATH 找不到（command not found）
affected_scope:         任何用 cmake_layout 单配置构建、且上游 CMake 不 install 测试/辅助程序（auxiliary、cliprogram、fuzz 工具）的 conan 2 配方；典型：Simons 系 games/tools（puzzles 的 14 个 auxiliary + fuzzpuzz）
verification_cmd:       conan create archives/p/puzzles/20260720.3c36322 -pr:h=ohos-local -pr:b=ohos-local --build=missing -tf="" && ls "$(ls -dt ~/.conan2/p/b/puzzl* | head -1)/p/bin" | wc -l   # 期望 55（40 官方 + 14 auxiliary + fuzzpuzz）

rec_priority:           1
rec_approach:           shutil-copy2-absolute-src-in-package
rec_description:        package() 先 cmake.install()，再用 shutil.copy2 显式复制辅助产物到 package_folder/bin：aux_src = os.path.join(self.build_folder, "auxiliary")（cmake_layout 下 self.build_folder 即 CMake 输出目录），逐个 os.path.isfile 检查后 copy2；fuzzpuzz 等顶层目标用 os.path.join(self.build_folder, "<tool>")
rec_command:            shutil.copy2(src, os.path.join(self.package_folder, "bin"))   # src 为绝对路径，先 os.path.isfile 检查
rec_auto_fix:           false

fallback_priority:      2
fallback_approach:      glob-recursive-locate-artifact
fallback_description:   在 build/source_folder 下 glob.glob(recursive=True) 定位产物（E340 同款，cargo 场景），cmake_layout 单配置路径可确定时优先直接路径
fallback_command:       glob.glob(os.path.join(self.build_folder, "**", "auxiliary", tool), recursive=True)
fallback_auto_fix:      false

forbid_1_pattern:       copy\(self, "[^"]*", src=os\.path\.join\(self\.build_folder, "Release"\)|copy\(self, "[^"]*", src=os\.path\.join\(self\.build_folder, "build", "Release"\)
forbid_1_reason:        build_folder/Release 与 build_folder/build/Release 都不存在（cmake_layout 下 CMake 输出目录就是 self.build_folder），copy() 静默跳过 → 包缺 auxiliary，CI L1 command not found
forbid_1_consequence:   积分赛 CI conan-build-test 阶段 FAIL（puzzles #66276 实例：PASS 38/FAIL 12），需整轮修复 + 重跑
forbid_2_pattern:       copy\(self, "[^"]*", src=aux_src\)
forbid_2_reason:        conan copy() 的目录/glob src 语义在多级 build 布局下易错位，缺失时静默跳过不报错
forbid_2_consequence:   复现"Packaged N files"但 bin/ 缺 auxiliary，本机 conan create 通过而 CI 失败

principles:             []
causes:                 []
caused_by:              []
similar_to:             [E340, E470, E225]
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/puzzles-20260720.3c36322-conan-cmake-layout-aux-packaging.md
last_updated:           2026-10-01
source_event:           CI #66276 conan-build-test FAIL（auxiliary command not found + fuzzpuzz-setup + ohos-save）；本机 conan create Packaged 41 files 缺 auxiliary
source_pr:              14184
source_commit:          c47da6837a
