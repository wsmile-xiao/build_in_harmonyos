# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E544
trigger_tool:           configure
phase:                  configuration
error_signature:        cannot guess build type.*uname|
                         config\.sub: invalid configuration.*ohos|
                         configure: error: cannot guess build type|
                         Kernel.*linux.*not known to work with OS.*ohos|
                         operating system.*not recognized

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               autotools, detection, ohos, platform, build-system
prescan_pattern:        config\.(guess|sub)
match_keywords:         config.guess, config.sub, HarmonyOS, ohos, cannot guess build type, invalid configuration, 三元组, triplet, 平台识别, uname, basic_os, kernel-os 白名单, per-file difflib, 补丁模式
title:                  release tarball 自带旧版 config.guess/config.sub 不识别 HarmonyOS 的标准补丁模式（guess 识别 + sub 三处白名单）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游 release tarball 打包的 config.guess/config.sub 版本过旧（如 pmix 5.0.11 带
                        2021-01-25 版），不认识 HarmonyOS（uname 输出 `HarmonyOS` / `ohos`）。
                        需要两个互补修改：config.guess 负责"猜出"三元组（加 HarmonyOS→ohos 识别分支，
                        与 E007 同源）；config.sub 负责"验证"三元组合法性（三处白名单，E072 同源）。
                        本条目沉淀两者**成对出现**的补丁模式与 per-file difflib 固化流程：
                        只改 guess 不改 sub → "invalid configuration" 报错；只改 sub 两处不改第三处 →
                        "Kernel 'linux' not known to work with OS 'ohos'"。
affected_scope:         所有使用 autotools 且 release tarball 内嵌 config.guess/config.sub 的 C/C++ 项目
                        在 OHOS (aarch64-linux-ohos) 上构建。已确认：hwloc、pmix、acl 等全部 autotools 新适配。
verification_cmd:       ./config/config.guess | grep ohos; ./config/config.sub aarch64-unknown-linux-ohos; grep -c "ohos" config/config.sub

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           patch-config-guess-sub-pair
rec_description:        成对打平台识别补丁：① config.guess 加 HarmonyOS 识别分支（uname -s 返回 HarmonyOS
                        → machine-unknown-linux-ohos），同文件内若有多处 `umask 077` 须一并 umask 077→022（E543）；
                        ② config.sub 三处白名单：ohos-linux 映射（basic_os=linux-ohos）、OS 白名单 ohos*、
                        kernel-os 白名单 linux-ohos*（缺第三处报 Kernel not known）。
                        修改在 .work 副本上做，用 per-file difflib 生成补丁固化进 conandata.yml patches 列表。
rec_command:            |
  # config.guess: 在 Linux 分支前加:
  #   HarmonyOS:*) echo "${machine}-unknown-linux-ohos"; exit ;;
  # config.sub 三处: ohos-linux 映射 / "ohos* | gnu* | android*..." / "linux-musl* | linux-ohos*"
  # 验证:
  ./config/config.guess   # → aarch64-unknown-linux-ohos
  ./config/config.sub aarch64-unknown-linux-ohos   # → aarch64-unknown-linux-ohos
rec_auto_fix:           true
rec_impl:               source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      replace-with-new-config-scripts
fallback_description:   从本仓库已成功适配的包（如 hwloc/pmix 归档 patches/）拷贝同年代的 config.guess/config.sub
                        补丁成果，或用系统里较新的 config.guess/config.sub 整文件替换后再叠加 umask 修复。
fallback_command:       cp /path/to/known-good/config.guess config/ && cp /path/to/known-good/config.sub config/
fallback_auto_fix:      false
fallback_impl:          source-patch

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       --build=aarch64-linux-ohos|--host=aarch64-linux-ohos
forbid_1_reason:         禁止用 --build/--host 显式三元组绕过 guess/sub 修复：AC_RUN_IFELSE 全跳过、
                         检测结果失真，且 conan AutotoolsToolchain 会在 CI 环境重复触发同一失败
forbid_1_consequence:   configure 看似通过但 config.h 检测全为默认值，编译期级联报错

# ═══ Layer 4: 原则引用 ═══
principles:             P004, P013

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E007, E072]
conflicts_with:         []
prerequisite_of:        []

