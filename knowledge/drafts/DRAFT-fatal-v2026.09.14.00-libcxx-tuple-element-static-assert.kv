#====================================================================
# DRAFT-fatal-v2026.09.14.00-libcxx-tuple-element-static-assert
# libc++ std::tuple_element out-of-range static_assert breaks SFINAE completeness probe
# 触发事件: fatal v2026.09.14.00 鸿蒙 PC 适配（facebook/fatal, tag v2026.09.14.00）
# 路径: Path B（知识库扩展）
#====================================================================

id:                     DRAFT-fatal-v2026.09.14.00-libcxx-tuple-element-static-assert
trigger_tool:           clang|conan
phase:                  compilation|testing
error_signature:        static assertion failed due to requirement .*Idx < 2|Index out of bounds in std::tuple_element|in instantiation of template type alias 'is_complete'|is_complete<std::tuple_element<

severity:               2
category:               ohos, toolchain, libc, c++, compiler, compilation, testing

prescan_pattern:        is_complete\s*<\s*std::tuple_element|sizeof\(T\)\s*>\s*\n?\s*template|Index out of bounds in std::tuple_element
prescan_globs:          *.h, *.hpp, *.hh, *.hxx, *.cpp, *.cc, *.cxx, *.ipp, *.tcc
match_keywords:         tuple_element, static_assert, SFINAE, is_complete, sizeof probe, _LIBCPP_VERSION, libcxx-ohos, -Werror, fatal, FATAL_EXPECT_FALSE, pair
title:                  新版 libc++ 的 std::tuple_element 越界 static_assert 击穿 SFINAE 完整性探测

root_cause:             上游 fatal 用 is_complete<T>（内部 sizeof(T) 作模板默认实参）以 SFINAE 探测类型完整性，期望越界索引的 std::tuple_element<2, std::pair<...>> 表现为不完整类型（替换失败 → false）。新版 libc++（OHOS libcxx-ohos / clang 15，libstdc++ 亦然）在 tuple_element 特化中加入 static_assert(Idx < 2)，标准库 static_assert 不处于 SFINAE 上下文，实例化即硬错误，无法被替换失败吞掉，导致该 TU 编译失败、85 个用例全部无法执行。
affected_scope:         在 OHOS（clang + libcxx-ohos）或任何使用较新 libc++/libstdc++ 的工具链上，以 SFINAE 探测标准库类型完整性（sizeof 探测 / is_complete 类工具）的 C++ 模板库及其测试；fatal/v2026.09.14.00 实测受影响（fatal/type/test/deprecated_transform_test.cpp）。
verification_cmd:       打补丁后执行 clang++ -Wall -Werror -Wextra -O0 -g -pthread -ftemplate-depth-1024 -std=c++17 -I . fatal/type/test/deprecated_transform_test.cpp 应编译成功，运行输出 "succeeded: passed 85/85"；全量复跑应得 TUs=67 compiled=67 executed_cases=839 passed=839 failed=0 skipped=0。

rec_priority:           1
rec_approach:           guard-the-sfinae-probe-by-implementation-macro
rec_description:        只对那一行断言加 #if !defined(_LIBCPP_VERSION)（或按实现宏组合）守卫，保留对仍 SFINAE 友好实现的检查；绝不删除 FATAL_TEST 用例本身，保持上游用例计数不变。
rec_command:            #if !defined(_LIBCPP_VERSION)\n  FATAL_EXPECT_FALSE((is_complete<std::tuple_element<2, pair>>::value));\n#endif
rec_auto_fix:           false
rec_impl:               upstream-test-patch

fallback_priority:      2
fallback_approach:      replace-probe-with-detection-idiom
fallback_description:   若确需在硬化后的标准库上表达「越界索引不可用」，改用检测惯用法（如检测 std::tuple_size 后再决定是否实例化 tuple_element），而不是依赖类型不完整；属于更大的测试改写，需在上游测试修改说明中逐条申报。
fallback_command:       template <typename P, std::size_t I, typename = void> struct has_element : std::false_type {};
fallback_auto_fix:      false
fallback_impl:          upstream-test-rewrite

forbid_1_pattern:       ^\s*//\s*FATAL_TEST\(|#if 0[\s\S]*FATAL_TEST
forbid_1_reason:        禁止注释/删掉整个 FATAL_TEST 用例来「消除」编译错误——会减少上游用例数，触发测试减少判定。
forbid_1_consequence:   上游用例数下降，rule 4/测试减少 判定不通过。

forbid_2_pattern:       (-Wno-error|-w\b|remove .*-Werror)
forbid_2_reason:        上游 harness 的 -Wall -Werror -Wextra 是其质量基线，放宽编译告警级别等于掩盖问题而非适配。
forbid_2_consequence:   编译参数与上游不一致，验证结论不可信。

principles:             P005, P007
causes:                 []
caused_by:              []
similar_to:             [DRAFT-fatal-v2026.09.14.00-rope-std-iterator-deprecated, E130, E063]
conflicts_with:         []
prerequisite_of:        []

