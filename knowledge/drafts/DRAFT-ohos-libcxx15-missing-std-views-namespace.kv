#====================================================================
# DRAFT-ohos-libcxx15-missing-std-views-namespace.kv
# OHOS clang15/libc++15 不提供 std::views 视图命名空间
#   （_LIBCPP_HAS_NO_INCOMPLETE_RANGES；__cpp_lib_ranges 已定义不能作判据）
# 触发事件: boost-ext-ut 2.3.1 HarmonyOS PC 适配（archives/b/boost-ext-ut/2.3.1，
#   PR #8569 patches/0001）
#====================================================================

id:                     DRAFT-ohos-libcxx15-missing-std-views-namespace
trigger_tool:           clang|cmake|conan
phase:                  compilation
error_signature:        "no member named 'views' in namespace 'std'"

severity:               3
category:               libcxx, toolchain, clang, cxx20, compat, ranges
match_keywords:         std::views, views, iota, ranges, libc++, libcxx, LLVM 15,
                        C++20, _LIBCPP_HAS_NO_INCOMPLETE_RANGES, __cpp_lib_ranges
title:                  OHOS clang15/libc++15 不提供 std::views 视图命名空间：__cpp_lib_ranges 已定义不能作判据，用 _LIBCPP_HAS_NO_INCOMPLETE_RANGES 扩展平台守卫

root_cause: >
  OHOS SDK26 clang 15.0.4 配套 libc++（LLVM 15）定义 _LIBCPP_HAS_NO_INCOMPLETE_RANGES
  （ranges 实现不完整），不提供 std::views 视图命名空间（std::views::iota 等不可用）。
  反直觉点：特性测试宏 __cpp_lib_ranges 却已定义——版本宏不等于可用性，以
  __cpp_lib_ranges 或 __has_include(<ranges>) 作条件判据在 OHOS 上必然漏判
  （boost-ext-ut 2.3.1 example/parameterized.cpp:50 实测：宏探测通过、
  std::views::iota 编译失败）。属 toolchain 能力缺口而非源码错误。
  与 DRAFT-ohos-libcxx15-format-ranges-capability-gap（<format> stub/ranges 内存算法）、
  DRAFT-ohos-libcxx15-missing-cpp20-ranges-algorithms（std::ranges 算法重载）同族互补：
  前两条覆盖 <format> 与 ranges 算法，本条覆盖 std::views 视图适配器与判据反例。

affected_scope: >
  所有以 C++20 为目标、源码使用 std::views 视图适配器（iota/transform/filter 等）
  的 OHOS 库；clang15/libc++15 工具链下的任何 C++20 项目都可能命中。
  注意上游项目常用平台宏守卫此类代码（boost-ext-ut 上游用 __EMSCRIPTEN__），
  OHOS 命中点恰在"上游守卫未覆盖的平台"。

verification_cmd: >
  printf '#include <version>\n#if defined(_LIBCPP_HAS_NO_INCOMPLETE_RANGES)\nHAS_GAP\n#endif' |
  clang++ -std=c++20 -stdlib=libc++ -E - | tail -1   # 输出 HAS_GAP 证实缺口
  clang++ -std=c++20 -stdlib=libc++ -fsyntax-only - <<<'#include <ranges>
  int main(){ auto r = std::views::iota(1,4); }'      # 复现 no member named 'views'
  修复后: conan create 全部 41 个 example 编译通过 + ctest 4/4（boost-ext-ut 2.3.1 实机）

rec_priority:           1
rec_approach:           incomplete-ranges-macro-guard-extends-upstream-platform-guard
rec_description: >
  条件编译改用 libc++ 自身缺口宏 _LIBCPP_HAS_NO_INCOMPLETE_RANGES，并与上游已有的
  平台守卫（如 __EMSCRIPTEN__）合并到同一 #if：
  `#if !defined(__EMSCRIPTEN__) && !defined(_LIBCPP_HAS_NO_INCOMPLETE_RANGES)`。
  不引入 __OHOS__ 等平台宏（R8/PF5 合规），libc++ 17+ ranges 补齐后宏不再定义、
  被守卫代码自动恢复。定位受影响文件用
  clang++ -std=c++20 -stdlib=libc++ -fsyntax-only 逐文件扫描（45 文件 30 秒定位唯一命中），
  快于全量构建失败重试。严禁用 -std=c++17 降级掩盖。
rec_command: >
  # boost-ext-ut 2.3.1 patch 0001（验证通过）：
  #   example/parameterized.cpp: #ifndef __EMSCRIPTEN__
  #   -> #if !defined(__EMSCRIPTEN__) && !defined(_LIBCPP_HAS_NO_INCOMPLETE_RANGES)

fallback_priority:      2
fallback_approach:      upgrade-sdk-toolchain
fallback_description:   等 OHOS SDK 提供 libc++17+（ranges/views 全量落地）整体升级工具链。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       __cpp_lib_ranges.*guard|guard.*__cpp_lib_ranges
forbid_1_reason:        __cpp_lib_ranges 在 OHOS libc++15 已定义（版本宏≠可用性），
                         用它守卫会漏判、守卫形同虚设
forbid_1_consequence:   OHOS 上仍编译失败，守卫无效
forbid_2_pattern:       -std=c\+\+17.*replace.*-std=c\+\+20|drop.*cppstd=20
forbid_2_reason:        降级语言标准改变语义并掩盖 C++20 依赖
forbid_2_consequence:   其他 C++20 特性不可用，语义漂移

similar_to:             DRAFT-ohos-libcxx15-format-ranges-capability-gap, DRAFT-ohos-libcxx15-missing-cpp20-ranges-algorithms
conflicts_with:
prerequisite_of:

