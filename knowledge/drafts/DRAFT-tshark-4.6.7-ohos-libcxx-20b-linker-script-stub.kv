error_signature: "undefined (reference|symbol).*_Znwm|undefined (reference|symbol).*_Zdl"
root_cause: "OHOS SDK 的 libc++.so 是 20 字节 linker-script 桩（INPUT(-lc++_shared)），非真实实现。裸 clang++ 会自动链接 libc++_shared.so，但 CMake/ccache 链接行不会自动带上，C++ 目标出现 undefined _Znwm/_Zdl（operator new/delete）。"
rec_approach: "链接行显式加全路径 $OHOS_SDK/llvm/lib/aarch64-linux-ohos/libc++_shared.so（conan 配方：extra_exelinkflags + extra_sharedlinkflags）；先验证运行时可解析（实测：链接它的 trivial 程序无 LD_LIBRARY_PATH 可运行，用于 configure 探测程序也安全）。"
match_keywords: ["libc++.so", "libc++_shared.so", "linker script", "20 byte", "_Znwm", "_Zdl", "OHOS", "C++"]
error_excerpt: "tshark 4.6.7: libwireshark.so undefined _Znwm/_Zdl（CMake/ccache 链接丢失 libc++_shared.so；SDK libc++.so 为 20B linker-script 桩）"
severity: P1
category: platform
last_updated: 2026-09-28
