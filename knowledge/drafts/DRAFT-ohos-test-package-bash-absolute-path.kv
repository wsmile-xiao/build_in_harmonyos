#====================================================================
# DRAFT-ohos-test-package-bash-absolute-path — test() 里 bash 在 OHOS run 环境不可用
# Source event: infgen 3.5 shadow CI r2 test() bash 不可用，改绝对路径 /data/service/hnp/bin/bash 后 r3 全绿
#====================================================================

id:                     DRAFT-ohos-test-package-bash-absolute-path
trigger_tool:           conan|test_package|shadow-ci
phase:                  test_package|runtime
error_signature:        /system/bin/sh: bash: inaccessible or not found|Error in test\(\) method|Error 127 while executing
severity:               2
category:               test-package|ohos-runtime|shell-path
match_keywords:         test_package, test(), bash, /data/service/hnp/bin/bash, VirtualRunEnv, conanrun, CONFIG_SHELL, inaccessible or not found, Error 127, self.run
title:                  Conan test_package 的 test() 在 OHOS 需用绝对路径 bash（run 环境 PATH 无 bash）

root_cause:             OHOS profile 的 [buildenv] 里 CONFIG_SHELL 与 PATH（含 /data/service/hnp/bin）只在 conan 的 build 阶段生效；test_package 的 test() 用 env="conanrun" 时，run 环境 PATH 只含 VirtualRunEnv 注入的 package bindirs，不含 /data/service/hnp/bin，故 self.run('bash ...') 找不到 bash（/system/bin/sh: bash: inaccessible or not found，Error 127）。
affected_scope:         所有 settings.os=OHOS 且 test() 用 bash 运行 test 脚本的 Conan test_package。
verification_cmd:       grep -n "bash" test_package/conanfile.py

rec_priority:           1
rec_approach:           ohos-absolute-bash-path
rec_description:        test() 中按 settings.os 选择 shell：OHOS 用 /data/service/hnp/bin/bash，其它平台用 bash；优先 CONFIG_SHELL 环境变量；显式声明 generators = "VirtualRunEnv" 确保 conanrun 生成。
rec_command:            shell = "/data/service/hnp/bin/bash" if str(self.settings.os) == "OHOS" else "bash"; shell = os.environ.get("CONFIG_SHELL", shell); self.run(f'{shell} "{script}"', env="conanrun")
rec_auto_fix:           false
rec_impl:               conanfile-edit

fallback_priority:      2
fallback_approach:      sh-instead-of-bash
fallback_description:   若 test 脚本不依赖 bash 特性（如 set -o pipefail），可改用 sh（/system/bin/sh 恒可用）调用；但含 pipefail 等 bashism 时必须用绝对路径 bash。
fallback_command:       self.run(f'sh "{script}"', env="conanrun")
fallback_auto_fix:      false
fallback_impl:          conanfile-edit

forbid_1_pattern:       self\.run\(f?'bash.*env="conanrun"\)   # OHOS 下裸 bash
forbid_1_reason:        OHOS run 环境 PATH 无 bash，裸 bash 必 Error 127。
forbid_1_consequence:   test_package 阶段失败，conan create 返回非零，L1 判定失败。

principles:             ohos-shell-path, test-package-integrity
causes:                 []
caused_by:              []
similar_to:             [E165, DRAFT-pico-sdk-test-package-absolute-pioasm]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-ohos-test-package-bash-absolute-path.md
last_updated:           2026-09-20
source_event:           infgen 3.5 shadow CI r2：test() 裸 bash 报 /system/bin/sh: bash: inaccessible or not found；改绝对路径 /data/service/hnp/bin/bash 后 r3 test_package 3/3 断言通过、L0-L5 全绿
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     1
metrics_confidence:     0.9
