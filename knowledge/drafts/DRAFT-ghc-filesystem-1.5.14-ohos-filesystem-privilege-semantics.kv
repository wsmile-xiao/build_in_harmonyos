id:                     DRAFT-ghc-filesystem-1.5.14-ohos-filesystem-privilege-semantics
trigger_tool:           filesystem-test-suite|Catch2|test_package|conan create
phase:                  testing|runtime
error_signature:        create_hard_link.*Operation not permitted|
                         copy.*create_hard_links.*not permitted|
                         mkfifo.*Operation not permitted|
                         fs\.permissions.*chmod.*not effective|
                         permissions.*owner_write.*not removed|
                         file permission.*assertion.*fail

severity:               1
category:               filesystem|platform-capability|testing|evidence-closure
match_keywords:         hard link, FIFO, mkfifo, chmod, permissions, owner_write,
                         Operation not permitted, HMDFS, SELinux, platform capability
                         boundary, upstream test, filesystem_test, ghc-filesystem,
                         evidence ledger, recovery condition, copy_options,
                         create_hard_links, recursive copy

root_cause:             OHOS 真机文件系统与 Linux 桌面假设存在三类系统性差异，
                         均发生在 syscall/文件系统层，与用户态库实现无关：
                         (1) HMDFS(nodev, 分布式) 不支持 hard link，link() 返回 Operation not permitted；
                         (2) SELinux 策略禁止创建 FIFO/命名管道，mkfifo() 返回 Operation not permitted；
                         (3) SELinux/HMDFS 忽略或部分屏蔽 POSIX chmod()/权限位，
                             chmod() 返回 0 但权限不变，或 other-read/owner-write 位被额外清除。
                         ghc-filesystem 为 header-only 纯用户态库，上述调用之上的逻辑无缺陷，
                         上游测试断言这些能力成立，在 OHOS 缺失时失败，但根因全属平台能力边界。

affected_scope:         OHOS 真机运行文件系统 API 上游测试套件的 C/C++ 库
                         (ghc::filesystem / std::filesystem 实现 / POSIX filesystem 测试 /
                         依赖文件权限断言的集成测试)

verification_cmd:       |
  # 最小能力探针（区分平台能力边界 vs 库缺陷）
  printf x > hl_probe_a && ln hl_probe_a hl_probe_b; echo "hardlink_exit=$?"
  mkfifo fifo_probe; echo "mkfifo_exit=$?"
  printf x > chmod_probe && chmod ugo-w chmod_probe && stat -c %A chmod_probe
  # 探针证明不可用的能力集合 ⊆ 失败断言的能力集合 => 平台能力边界

rec_priority:           1
rec_approach:           probe-attribution-evidence-closure
rec_description:        逐入口失败分类 -> 平台能力探针 -> 交叉对照归因 ->
                         保留逐入口证据台账(命令/cwd/退出码/首错/绝对日志/日志SHA-256) ->
                         恢复条件(标准 Linux 宿主重跑预期全绿)。
                         禁止修改上游测试断言；禁止 build-tests=false/宽泛跳过伪造通过；
                         禁止把受限用例伪写成通过。
rec_command:            |
  /data/service/hnp/bin/clang++ -std=c++17 -I include -I test test/filesystem_test.cpp -o filesystem_test && ./filesystem_test

recovery_condition:     在支持 hard link/FIFO 创建且 chmod 可生效的宿主(标准 Linux 桌面/
                         容器/CI 虚拟机)重跑，预期上游套件全绿；OHOS 真机受限用例如实标记
                         平台能力边界，不阻塞适配 PR；OHOS 版本放宽限制后重跑台账更新。

forbid_1_pattern:       修改上游测试断言 / 宽泛排除伪造通过
forbid_1_reason:        平台能力边界被当作库缺陷修补会污染代码并掩盖真实缺陷
forbid_1_consequence:   伪报通过、误导后续库复用判断

principles:             P013, P020
similar_to:             E046, E047, E074, E079, E220
delta_vs_similar:       既有 E046/E047/E074/E079/E220 各自单点记录单能力
                         (chmod 不生效 / other-read 屏蔽 / FIFO 拒绝 / hard link 拒绝 /
                         Perl 工具链存储权限分叉)。本条把这些单点整合为统一的
                         "上游文件系统测试失败归因" 诊断框架：探针->归因->证据闭环 判定流程、
                         verbatim 探针命令、逐入口台账模板与恢复条件，是这些单点记录
                         未覆盖的跨库可复用方法层。

causes:
caused_by:              E046, E047, E074, E079
conflicts_with:
