#====================================================================
# DRAFT-appstream-1.2.0-r04-glib-component-key-version-matrix.kv
# glib 组件键跨版本命名差异（2.84.0.1 带 -2.0 后缀 vs 2.88.3 无后缀）
# 导致 PkgConfigDeps 组件 requires 解析 "Component 'glib::gobject'
# not found" → force 固化版本 + 依赖 cpp_info 无后缀别名组件键注入 +
# PkgConfigDeps 手动调用（类级 generators 先于 generate() 运行失效）
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R04）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           conan|pkg-config
phase:                  generate
error_signature:        Component 'glib::gobject' not found in 'glib' package requirement|
                        Component 'glib::glib-2\.0' not found|
                        Component 'glib::gio' not found
severity:               3
category:               conan, pkg-config, glib, version-matrix, ohos
match_keywords:         glib, component, PkgConfigDeps, -2.0, gobject-2.0, glib-2.0,
                        version matrix, override, force, ohpcd, prebuilt, compose
title:                  glib 组件键跨版本命名差异（-2.0 后缀）致 PkgConfigDeps 组件 requires 解析失败 → force 固化 + 别名组件键注入 + 手动 PkgConfigDeps
root_cause:             ohpcd 预编译 pango/cairo 绑定 glib/2.84.0.1（组件键带 -2.0 后缀），
                        libxmlb/pango 配方 package_info 引用旧版组件名（无后缀或 -2.0
                        后缀两套并存）；同一 glib 版本无法同时满足两套组件键命名体系；
                        PkgConfigDeps 校验组件 requires 引用的组件键必须存在于依赖
                        cpp_info.components → 报 Component not found（R03 阻塞根因）。
affected_scope:         compose/渲染链命中 ohpcd 预编译（绑定特定 glib 组件键命名）的 Conan 项目。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing
rec_priority:           1
rec_approach:           glib-force-version-plus-component-alias-plus-manual-pkgconfigdeps
rec_description:        requirements 中 glib 用 force=True 固化版本（另见 r04-conan-
                        override-force-direct 草稿）；generate() 中在 PkgConfigDeps
                        (self).generate() 之前为 glib 依赖 cpp_info 注入无后缀别名组件
                        键（gobject → gobject-2.0 对象引用）；类级 generators 改为手动
                        调用（类级先于 generate() 运行，别名注入晚于生成器失效，实测
                        create26）。
rec_command:            |
  glib_dep = self.dependencies["glib"]
  for suffix, plain in (("glib-2.0","glib"),("gobject-2.0","gobject"),
                        ("gio-2.0","gio"),("gmodule-2.0","gmodule")):
      if suffix in glib_dep.cpp_info.components and plain not in glib_dep.cpp_info.components:
          glib_dep.cpp_info.components[plain] = glib_dep.cpp_info.components[suffix]
  from conan.tools.gnu import PkgConfigDeps
  PkgConfigDeps(self).generate()
rec_auto_fix:           false
rec_impl:               conan-recipe-generate
forbid_1_pattern:       generators = "PkgConfigDeps".*别名组件注入在 generate()
forbid_1_reason:        类级 generators 先于 generate() 运行，别名注入晚于生成器导致失效（实测 create26）
principles:             R33, R49
causes:                 [DRAFT-pc-chain-invisible-transitive-deps]
caused_by:              []
similar_to:             [DRAFT-pc-chain-invisible-transitive-deps, DRAFT-conan-shared-pkgconfig-requires-drop]
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-r04-glib-component-key-version-matrix.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R04（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.85