#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: pytest|conan|test_package|python
phase: testing
error_signature: 结果不符：得到 .*期望|未解析到 pytest 通过计数|ModuleNotFoundError.*记为通过|凭 API 名字推断语义

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: testing, quality
match_keywords: 断言纪律, docstring 为准, 源码为准, pytest passed failed errors, ModuleNotFoundError, ImportError, 未真跑, 消费者校验误判, Projection(keys, space)
title: 自建校验的两条断言纪律——①**消费者校验的断言必须以源码/docstring 为准**（本轮我把 `Projection(keys, space)` 当成"对值施加函数"，实测返回 `'x'` 期望 `'X'` 判 FAIL；实际语义是"按键投影"，可调用时被当作键的谓词）②**测试结果必须 passed/failed/errors 三项统计**，并把 `ModuleNotFoundError`/`ImportError`（说明没真跑起来）与"解析不到通过计数"单项判为**不成立**——否则会把"缺依赖"或"没真跑"记成通过

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 两类反复出现的误判，根因都在"用想当然代替证据"： ① **API 语义靠名字推断**：`Projection` 听起来像"投影值"，但源码签名是 `Projection(keys: _Matchable, space: Mapping)` —— `keys` 可为列表/可迭代/可调用/正则， 可调用时被当作**键的谓词**（`_dispatch()` 把 callable 直接用、把容器转成 `__contains__`）。 断言写错 → 校验报 FAIL，看似"产物有问题"，实则校验本身有错（本轮即此）。 ② **测试结果只看通过数**：只 `grep -c "passed"` 会把两种情况记成通过： （a）测试因缺依赖根本没跑（`ModuleNotFoundError`/`ImportError`）；（b）输出格式变化导致 解析不到计数（此时 `passed=0` 也可能是"没跑"而非"没有失败"）。
affected_scope: 所有自建消费者校验/适配后测试脚本；以及所有解析上游测试输出的场景
verification_cmd: ① 写断言前先看被测符号的 docstring/源码示例（`grep -nA20 "class <X>" <src>`）② 本地用**解包后的源码 + 真实依赖**跑一遍候选调用，并把输出**与断言值逐项对照**（只打印不对照等于没验证）③ 统计用 `re.findall(r"(\d+) passed|(\d+) failed|(\d+) error", out)` 三项齐看

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: source-of-truth-assertions-and-three-way-test-accounting
rec_description: ①**断言以源码为准**：写 `<mod>.<API>(…)` 调用前，先读该 API 的 docstring 示例或 `__init__` 签名，按示例构造入参与期望值；本地验证时把实际输出与将写入脚本的期望值**逐项对照**（本轮教训：本地已打印 `Projection: x`，我却写了期望 `'X'`）。②**结果三分类**：统计 `passed/failed/errors` 三项；出现 `ModuleNotFoundError`/`ImportError` → 判"测试不成立"（让 build 失败或记环境阻塞），出现 failed/errors → 判真实失败；**解析不到通过计数**同样判不成立，避免"没真跑"被记成通过。③消费者校验与上游测试分开统计（前者 N 项 fails/skips，后者 passed/failed/errors），PR 里分别给出。
rec_command: re.findall(r"(\d+) passed", out); re.findall(r"(\d+) failed", out); re.findall(r"(\d+) error", out); "ModuleNotFoundError" in out
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: compare-against-upstream-own-test-expectations
fallback_description: 若某 API 的语义难以从 docstring 判断，改用**上游自带测试里已经验证过的调用/期望**作为断言来源（例如上游 `tests/` 里对该类的用法），这比自己推断可靠；仍不确定时，把该调用降级为"只 import 不调用"的弱断言，并在 notes 里说明未覆盖该 API。
fallback_command:
fallback_auto_fix: false
fallback_impl: manual
forbid_1_pattern:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

