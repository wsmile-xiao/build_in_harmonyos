# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: make|clang|ar
phase: runtime-safety
error_signature: get_neighbor.*strncat|malloc\(sizeof\(char\) \* 1\)|Expected hash.*w40k|neighbors.*truncat

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: memory, safety, c, upstream-bugfix
match_keywords: geohash,get_neighbor,strncat,strcat,malloc,heap overflow,neighbors,libgeohash
title: 上游 C 库 malloc(1)+strncat 拼接前缀导致堆缓冲区溢出（get_neighbor 高精度邻居截断）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游 geohash.c get_neighbor() 中 char *base = malloc(1) 后用 strncat 追加 hash 前缀并 strcat 追加末字符，任何长度>0 的 hash 都会越界写堆内存；高精度(≥8) hash 的邻居计算产生截断/越界读（未定义行为，堆布局相关）。属上游缺陷，与 OHOS 平台无关。
affected_scope: 所有以 malloc(1)+strncat/strcat 拼接字符串的 C 库；libgeohash simplegeo commit 2469d3c9cc 及所有下游
verification_cmd: clang geohash_test.c geohash.c -o a.out && ./a.out —— 修复前输出 3 条 neighbor Error（w40k/w40s/w40j 截断），修复后 0 错误；test_package ctest 高精度邻居 8 断言全过

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: heap-buffer-alloc-length-plus-1
rec_description: 按前缀长度 + 末尾字符 + NUL 分配：malloc(hash_length+1)，再 strncat 前缀 + strcat 末字符；杜绝 strncat/strcat 在不足空间上的拼接。属通用 C 内存安全修复，可跨库复用。
rec_command: char *base = malloc(sizeof(char) * (hash_length + 1)); base[0]='\\0'; strncat(base, hash, hash_length - 1); ... strcat(base, last_hash);
rec_auto_fix: true
rec_impl: source-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
