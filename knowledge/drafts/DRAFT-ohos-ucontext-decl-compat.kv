#====================================================================
# DRAFT-ohos-ucontext-decl-compat — OHOS musl 的 ucontext.h 只定义
#   ucontext_t 类型、不声明 getcontext/makecontext/swapcontext/setcontext
#   （fiber 栈切换需要）——musl 兼容头补声明，实现由 libucontext 提供
# 对应人类文档: knowledge/drafts/DRAFT-ohos-ucontext-decl-compat.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR systemd/261 适配 HarmonyOS PC（sd-future/fiber.c 编译报
#           getcontext/makecontext/swapcontext 未声明）
#====================================================================

id:                     DRAFT-ohos-ucontext-decl-compat
trigger_tool:           cc|clang|make|meson
phase:                  compilation|linking
error_signature:        call to undeclared function 'getcontext'|
                         call to undeclared function 'makecontext'|
                         call to undeclared function 'swapcontext'|
                         call to undeclared function 'setcontext'|
                         ucontext.*undeclared

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               ohos, musl, ucontext, fiber, declaration, compilation
match_keywords:         ucontext, ucontext_t, getcontext, makecontext, swapcontext,
                         setcontext, fiber, coroutine, musl, undeclared,
                         libucontext, stack switch
title:                  OHOS musl 的 ucontext.h 只定义 ucontext_t、不声明 ucontext
                         族函数——musl 兼容头补声明（实现由 libucontext 提供）

# ═══ Layer 2: 诊断层 ═══
root_cause:             glibc 的 <ucontext.h> 声明 getcontext/makecontext/
                         swapcontext/setcontext（用户态栈切换原语，coroutine/fiber
                         的基础）。OHOS musl 的 <ucontext.h> **只定义 ucontext_t
                         类型**（及相关 struct），**不声明**这四个函数——musl 声明
                         ucontext 函数但未实现，需链 libucontext。使用它们的库
                         （systemd 的 sd-future/fiber.c）编译报 "call to undeclared
                         function"
affected_scope:         所有在 OHOS 上编译、使用 ucontext 栈切换原语（fiber/
                         coroutine）的库（systemd 的 sd-future 即此类）
verification_cmd:       conan create archives/s/systemd/261 --build=missing
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 覆盖前 fiber.c 报 getcontext/makecontext/
                         # swapcontext 未声明；覆盖后编译链接通过

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           musl-ucontext-decl
rec_description:        在 musl 兼容头（src/include/musl/ucontext.h）include_next
                         <ucontext.h> 后补四个函数的声明（ucontext_t 类型已由 musl
                         头定义）；实现不在此提供——依赖链加 libucontext（conan
                         依赖 + meson 的 -lucontext 链接），因为 musl 声明了这些
                         函数但未实现
rec_command:            (musl 兼容头 ucontext.h + 依赖 libucontext)
                         int getcontext(ucontext_t *ucp);
                         int setcontext(const ucontext_t *ucp);
                         void makecontext(ucontext_t *ucp, void (*func)(void), int argc, ...);
                         int swapcontext(ucontext_t *oucp, const ucontext_t *ucp);
                         # requirements: libucontext/1.5.2
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      source-patch-disable-fiber
fallback_description:   若补声明不可行，patch 源码关闭 fiber 特性——改动面大，不推荐
fallback_command:       (逐文件补丁)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       skip.*fiber|禁用.*sd-future|N/A（未运行）
forbid_1_reason:        补声明+链 libucontext 可无损解决；跳过/禁用属"有可运行
                         子集未尝试"
forbid_1_consequence:   被 rule 4 打回
forbid_2_pattern:       sed.*fiber\.c.*删除.*getcontext|patch.*去掉.*makecontext
forbid_2_reason:        删功能治标不治本；补声明是标准做法
forbid_2_consequence:   换库/换平台即失效

# ═══ Layer 4: 原则引用 ═══
principles:

