#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 Ennn.kv，填写各字段
# 对应的人类文档: doc/Ennn.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
# 编号说明: 本条目原号 E570，因 E570 已被两个独立来源占用（上游主线
#   archives/l/libmobi/0.12/conanfile.py:248 的注释引用；以及并发任务
#   wt-dazzdb-1.0-git20250217.a3eefd4/knowledge/drafts/E570-draft-EB2A.kv 的真实草稿），
#   经 W4 审计指出后改用 E573。E573 为双口径最小空号：跨 worktree 文件形态扫描
#   （含 DRAFT-<ID>-* 形态）与主线文本引用整词扫描取并集后，E543–E572 全部已占用
#   （E543–E567 已被主线追踪；E568/E569→wt-crashmail、E570→wt-dazzdb、
#   E571→wt-libtsm、E572→wt-cube2font 为各任务尚未合入的本地草稿）。
id:                     E573
trigger_tool: make|clang
phase: compilation
error_signature: no such file or directory: 'NDEBUG'|CFLAGS="-O3 NDEBUG"

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, toolchain, make
match_keywords: GnuToolchain, raw Makefile, CFLAGS, defines, NDEBUG, 裸宏名, -D 前缀, conan create, basic_layout
title: raw Makefile 配方手工拼接 GnuToolchain 的 CFLAGS 时 defines 是裸宏名，缺 -D 前缀被 clang 当成源文件

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: GnuToolchain.defines 返回的是「裸宏名」列表（Release 下为 ['NDEBUG']），-D 前缀由消费方补——AutotoolsToolchain/CMakeToolchain 内部自行拼 -D 与 /D，而 raw Makefile 工程没有 configure/cmake 代它拼 flags；配方按直觉写 " ".join(tc.cflags + tc.defines) 时 NDEBUG 就变成独立的编译参数，clang 把第一个非选项参数当成输入文件，报 no such file or directory: 'NDEBUG'，真实错误完全落在 clang/源文件名上而不指向配方行
affected_scope: 所有用 GnuToolchain 手工拼 CFLAGS/CPPFLAGS 构建 raw Makefile（无 configure、无 CMakeLists.txt）工程的 Conan 配方；首个实测实例 dbview 1.0.4（G2 首轮 conan create 即失败）
verification_cmd: grep -m1 'RUN: make' <conan create 日志>  # 修复后应出现 CFLAGS="-O3 -DNDEBUG"；未修复时同一行是 CFLAGS="-O3 NDEBUG"，紧随其后首条错误为 clang-15: error: no such file or directory: 'NDEBUG'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           add-cflags
rec_description:        拼接 CFLAGS 时给 defines 逐项补 -D 前缀：cflags = " ".join(tc.cflags + [f"-D{d}" for d in tc.defines])
rec_command:            make -j1 CC="${CC}" CFLAGS="<tc.cflags> -D<tc.defines 逐项>"
rec_auto_fix:           false
rec_impl:               conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      set-env-var
fallback_description:   不使用 GnuToolchain.defines，改由配方按 build_type 自行判定并写入 -DNDEBUG（与 profile 脱钩，仅作回退）
fallback_command:       CFLAGS="-O3 -DNDEBUG"
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       tc\.cflags \+ tc\.defines
forbid_1_reason:        defines 是裸宏名，直接与 cflags 相加产生非法编译参数；错误信息指向 clang 与源文件名，不指向配方行，排查成本高
forbid_1_consequence:   conan create 在 build() 该行报 Error 2 while executing，clang 报 no such file or directory: 'NDEBUG'，每轮浪费一次完整构建
forbid_2_pattern:       os\.environ\[["']CFLAGS["']\]
forbid_2_reason:        R33 禁止裸用 shell 环境变量传编译参数（release worker 上为空导致静默降级）
forbid_2_consequence:   本地通过、CI worker 行为不一致，且 flags 与 profile 脱钩
# forbid_3_pattern:
# forbid_3_reason:
# forbid_3_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

