#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E8288.kv，填写各字段
# 对应的人类文档: doc/E8288.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E8288
trigger_tool:           test
phase:                  testing
error_signature:        FAIL!.*JsonCreatorTest::test(EpisodeActions|Settings)

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               compat, portability
match_keywords:         QDateTime, QJsonDocument, UTC, ISODate, QtTest, QVariant
title:                  Qt JSON 日期测试须显式区分本地时区输入与序列化格式

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             无时区的 QDateTime::fromString 默认按本地时间解析；生产代码转换 UTC 后数值变化，而 QVariant JSON 日期与显式 Qt::ISODate 字符串还具有不同的毫秒格式。
affected_scope:         Qt 日期及 JSON 的跨时区测试，特别是旧 Qt4 fixture 在 Qt5 原生环境执行；不适用于修改生产接口的时间契约。
verification_cmd:      分别回读两个 QtTest 程序的 -functions 清单并完整执行；核对 32+5 个逻辑方法的命名 PASS 与进程 RC0，不计 initTestCase/cleanupTestCase。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           source-patch
rec_description:        先定位实际序列化 API 和接口契约，再为 UTC fixture 显式 setTimeSpec(Qt::UTC)，按各 API 保留精确格式断言，完整重跑原测试。
rec_command: 先比较原始 fixture 的 timeSpec 与生产 toUTC/toString 调用；在测试源码为 UTC 输入声明 timeSpec，分开验证 QVariant JSON 毫秒和 ISODate 输出；重跑每个命名用例。
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: explicit-contract-fixture-per-time-spec
fallback_description: 若业务接口要求本地时间，保留本地输入并以明确偏移构造期望；不得把任意业务时间强改 UTC。
fallback_command: 为本地和 UTC 两类输入分别绑定接口契约、时区与序列化入口，再比较真实日期值和完整 JSON。
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       QSKIP|QEXPECT_FAIL|remove.*timezone|strip.*timestamp
forbid_1_reason:        跳过测试或抹去时区、毫秒会隐藏时间值及协议格式差异，不能证明兼容性。
forbid_1_consequence:   测试分母失真，可能掩盖真实 UTC 转换或 JSON 接口回归。
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

