#====================================================================
# DRAFT-21003-ctest-subdir-testfile
# CMake add_test 位于子目录（tests/）时顶层 CTestTestfile.cmake 不生成，
# ctest --test-dir 必须指向子目录，否则报 "No tests were found"
# 来源: lwjson 1.9.0 适配 (2026-10-04)
#====================================================================

id:                     DRAFT-21003
source_lib:             lwjson 1.9.0
trigger_tool:           cmake|ctest|conan create|finish
phase:                  testing
error_signature:        No tests were found|ctest.*No tests|CTestTestfile\.cmake.*no such
match_keywords:         ctest, --test-dir, CTestTestfile.cmake, add_test, enable_testing, tests/ 子目录, subdirectory, No tests were found, PROJECT_IS_TOP_LEVEL, 顶层构建目录, tests subdir
category:               build-system, cmake, testing
severity:               1
status:                 draft
agent_id:               atomcode-lwjson-r01-pc1-3

root_cause: >
  --- CMake 的 enable_testing()/add_test() 常见于子目录（tests/CMakeLists.txt）。
  此时 CTest 测试清单（CTestTestfile.cmake）只生成在 <build>/tests/ 子目录，
  顶层 <build>/ 没有 CTestTestfile.cmake。在顶层构建目录运行
  `ctest --test-dir <build>` 会得到 "No tests were found"（exit 0，静默通过），
  造成"测试没跑却以为通过"的假阳性；但 ctest 在 <build> 里 exec 不到任何测试。
  上游 test.py 类脚本常逐子目录建 __build__ 并 ctest 于子目录，本地手动复现
  "make check" 等价物时必须同样把 --test-dir 指到含 add_test 的子目录。
affected_scope:         所有 add_test/enable_testing 位于子目录、顶层 CMakeLists
                        只 add_subdirectory 的 CMake 工程（CI 配方 build() 内
                        跑上游 ctest 时最常踩）
verification_cmd:       find <build> -name CTestTestfile.cmake；若只在
                        <build>/tests/ 存在，则 ctest 需 --test-dir <build>/tests。

rec_priority:           1
rec_approach:           ctest-subdir-test-dir
rec_description:        conanfile.py build()/本地验证里用
                        ctest --test-dir <binary_folder>/tests --output-on-failure
                        （路径由 cmake_layout 解析），并断言真实 test 计数
                        （Passed 行数），避免 "No tests were found" 假通过。
rec_command:            ctest --test-dir $BUILD/tests --output-on-failure
rec_auto_fix:           false
rec_impl:               recipe-build-command

forbid_1_pattern:       ctest\s*--test-dir\s*<绝对顶层build>
forbid_1_reason:        顶层无 CTestTestfile.cmake 时静默 0 测试通过，伪造"测试跑过"。
forbid_2_pattern:       skip.*ctest.*No tests.*found
forbid_2_reason:        "No tests were found" 是路径问题不是"上游无测试"，
                        应指向子目录重跑而非跳过（R51 台账口径）。

principles:             P010, P014

similar_to:             E292（layered-ctest-migration，CTest 分层迁移策略）；
                        E294（dual-cmake-build-tree，双构建树）
caused_by:              []
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-21003-ctest-subdir-testfile.md
last_updated:           2026-10-04
source_event:           lwjson 1.9.0：ctest --test-dir __build__ 报
                        "No tests were found"，--test-dir __build__/tests 得
                        1/1 Passed（test_stream 入口）；conan create build() 用
                        <build>/Release/tests 复现 1/1 Passed。现有 E292/E294
                        均聚焦 CTest 迁移/双树策略，未覆盖子目录测试清单定位。