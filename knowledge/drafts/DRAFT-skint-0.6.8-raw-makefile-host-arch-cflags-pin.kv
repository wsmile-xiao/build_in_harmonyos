#====================================================================
# DRAFT: 手写 makefile 用「构建机 uname」推导架构 CFLAGS + 默认 PREFIX 编入
#        绝对路径 —— 交叉编译必须用 make 命令行整体覆盖 CFLAGS
#====================================================================

id:                     DRAFT-skint-0.6.8-raw-makefile-host-arch-cflags-pin
status:                 pending-editor-review
title:                  手写 makefile 以 $(shell uname -m) 推导架构 CFLAGS（如 -D NAN_BOXING）、并按默认 PREFIX 把绝对路径编入产物时，交叉编译会按“构建机”取值：产物语义随构建机变化、包不可重定位；用 make 命令行整体覆盖 CFLAGS 可一次消除两类不可复现
trigger_tool:           make|clang|conan
phase:                  configuration|compilation
error_signature:        |
  ARM_64 architecture is detected|
  X86_64 architecture is detected|
  -D ?NAN_BOXING|
  -DLIBDIR=/usr/local/|
  uname -m.*(AMD64|ARM64|POWER64|RV64)

severity:               2
category:               build-system, make, cross-compile, toolchain, relocatable
match_keywords:         raw makefile, 手写 makefile, 无 configure, $(shell uname -m), uname 架构嗅探, ARCH=AMD64, -D NAN_BOXING, NaN boxing, PREFIX 默认 /usr/local, -DLIBDIR, 绝对路径烤入 ELF, 不可重定位, make 命令行变量, GNU make 命令行优先, 构建机 vs 目标机, 交叉编译, CFLAGS 钉死

root_cause: >
  makefile 把“执行 make 的机器”当成了“目标机”：$(shell uname -m) 推导 ARCH 后据此追加架构
  CFLAGS（skint 0.6.8 是依赖 48 位地址空间的 -D NAN_BOXING），同时用默认
  PREFIX=/usr/local 追加 -DLIBDIR=$(PREFIX)/share/<pkg>/lib。交叉编译时前者使目标 ELF 的对象
  表示由构建机架构决定（macOS arm64 打开 NAN_BOXING；而真正的 aarch64-linux-ohos 上
  uname -m 返回 aarch64、不匹配 makefile 的任何分支，反而不打开），同一份配方在两台构建机
  产出语义不同的二进制；后者把构建机绝对路径烤进 ELF，包被搬到 conan 包目录后运行时默认
  路径必然失效，破坏可重定位性。
affected_scope: >
  用 $(shell uname ...) 等宿主探测推导编译参数的手写/GNU makefile 项目；需要交叉编译到
  OHOS（或其他 target）的场景；默认 PREFIX 会被写进 ELF 作为运行时默认路径的项目。
verification_cmd: >
  make -C <src> -j1 CC="<tools.build:compiler_executables:c>" CFLAGS="-O2 -DNDEBUG" "<target>";
  llvm-readelf -d "<target>" | grep -E 'NEEDED'
  # 判定：编译行中不再出现宿主架构探测派生的宏（-D NAN_BOXING）与 -DLIBDIR=/usr/local/；
  #      产物内不再残留构建机绝对路径（可重定位）

rec_priority:           1
rec_approach:           pin-cflags-on-make-command-line
rec_description:        >
  在 conanfile.py 的 build() 里用 make 的**命令行变量**整体钉死编译参数（GNU make 命令行变量
  优先于 makefile 内的 = 与 +=），CC 取自 tools.build:compiler_executables（R33）；外置
  数据/库目录改用 Conan 机制（runenv_info / cpp_info / 包内相对路径）在运行期或打包期注入，
  不编入 ELF。
rec_command:            make -C <src> -j1 CC="<conf cc>" CFLAGS="-O2 -DNDEBUG" "<target>"
rec_auto_fix:           false
rec_impl:               manual
fallback_priority:      2
fallback_approach:      upstream-patch-remove-host-sniffing
fallback_description:   >
  若必须保留 makefile 的自动探测（同一份 makefile 也要用于本机构建），打最小补丁把架构/前缀
  参数改成尊重外部传入（如 ARCH ?= unknown），补丁走 refresh-patch 并在 notes.md 说明理由。
fallback_command:       python3 scripts/ohc-run.py refresh-patch --auto <name> <version>
fallback_auto_fix:      false
fallback_impl:          manual
forbid_1_pattern:       CFLAGS\s*\+?=\s*.*(NAN_BOXING|LIBDIR=)
forbid_1_reason:        在 conanfile 里用 += 追加 CFLAGS 压不住 makefile 内的宿主探测与 PREFIX 派生值
forbid_1_consequence:   构建机架构决策与构建机绝对路径照样进入目标产物
forbid_2_pattern:       sed -i.*[Mm]akefile
forbid_2_reason:        直接 sed 改 makefile 不可复现，且重新解包/distclean 后即失效（R6/P003）
forbid_2_consequence:   改动不落补丁体系，后续构建悄悄退回宿主嗅探
principles:             P006, P014
similar_to:             DRAFT-E640, DRAFT-E687, E296
conflicts_with:         []
causes:                 []
caused_by:              []
prerequisite_of:        []
doc_file:               DRAFT-skint-0.6.8-raw-makefile-host-arch-cflags-pin.md
last_updated:           2026-10-02
source_event:           skint 0.6.8 适配（分支 feat/skint-0.6.8；ohos-local profile，构建机 macOS arm64 → 目标 aarch64-linux-ohos）
authors:                5DBC
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-10-02
draft:                  true
contributor_id:         5DBC
