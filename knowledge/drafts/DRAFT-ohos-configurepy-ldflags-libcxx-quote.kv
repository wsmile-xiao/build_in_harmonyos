# DRAFT-ohos-configurepy-ldflags-libcxx-quote.kv
# 对应文档: knowledge/drafts/DRAFT-ohos-configurepy-ldflags-libcxx-quote.md
#
# 问题层: 自研 Python configure.py（非 autotools/cmake）生成 Makefile 的三方库，
#         OHOS 下 C++ 链接缺 libc++（clang++ 不自动带），且 configure.py 的
#         argparse 对含空格的 --ldflags 值必须引号包裹（否则 -lc++ 被拆成
#         独立选项报 no such option: -l）

# ═══ Layer 0: 错误面 ═══
id:                     DRAFT-ohos-configurepy-ldflags-libcxx-quote
trigger_tool:           configure|make|clang|ld
phase:                  configuration|linking
error_signature:        undefined symbol: std::__n1::cerr|undefined symbol: std::__n1::ios_base::init|no such option: -l|configure.py: error: no such option

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               build-system, linking, detection, make, compat
match_keywords:         configure.py, --ldflags, libc++, std::__n1, no such option, argparse, botan
title:                  自研 configure.py 生成 Makefile：OHOS 链接缺 libc++ 需 --ldflags 显式注入，且含空格值必须引号包裹

# ═══ Layer 2: 诊断层 ═══
root_cause:             (1) 自研 configure.py（Python argparse 配置脚本，非 autotools/cmake）生成 Makefile，
                        其链接命令直接用 $(CXX)，但 OHOS 沙箱 clang++ 链接不自动附加 libc++，C++ 测试/程序
                        链接报 undefined symbol: std::__n1::cerr 等 libc++ 符号（std::__n1 是 libc++ 的
                        inline namespace __1）；(2) 注入链接标志时，configure.py 的 argparse 把含空格的
                        --ldflags="..." 值按空格拆成多个 argv，-lc++ 被当成独立选项 -l → 报
                        "configure.py: error: no such option: -l"
affected_scope:         用自研 Python configure.py 生成 Makefile 的 C++ 库（如 botan-2），OHOS 适配时
                        链接测试程序/可执行文件需显式 libc++
verification_cmd:       make botan-test 2>&1 | grep "undefined symbol: std::__n1"; ./configure.py --ldflags="-L<dir> -lc++"

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           ldflags-quoted-inject-libcxx
rec_description:        configure 时用引号包裹含空格的 --ldflags 值注入 libc++：
                        --ldflags="-L<OHOS SDK libc++ 目录> -lc++"（值整体加引号，
                        argparse 才能收到单个 FLAGS 串再按空格 split 传给链接器）
rec_command:            ./configure.py --cc=clang --cc-bin=${CC} --ldflags="-L/data/service/hnp/ohos-sdk.org/ohos-sdk_26.0.0.18/ohos/native/llvm/lib/aarch64-linux-ohos -lc++" --prefix=${PACKAGE_FOLDER}
rec_auto_fix:           true
rec_impl:               env-var-append

fallback_priority:      2
fallback_approach:      env-LDFLAGS
fallback_description:   configure.py 支持从环境变量 LDFLAGS 读取（options.ldflags = update_from_env(...)），
                        用 export LDFLAGS="-L<dir> -lc++" 注入；同样注意值含空格时在 shell 里加引号
fallback_command:       export LDFLAGS="-L<SDK libc++ 目录> -lc++"; ./configure.py ...
fallback_auto_fix:      true

# ═══ 禁止策略 ═══
forbid_1_pattern:       --ldflags=-L[^ ]* -lc\+\+
forbid_1_reason:        不加引号时 -lc++ 被 argparse 拆成独立选项 -l，configure.py 直接报错
forbid_1_consequence:   configure 失败（configure.py: error: no such option: -l），无法生成 Makefile

# ═══ 关系图 ═══
similar_to:             E247, E191, DRAFT-postgresql-18.3-make-args-shell-quote
conflicts_with:

# ═══ 元数据 ═══
doc_file:               DRAFT-ohos-configurepy-ldflags-libcxx-quote.md
last_updated:           2026-09-08
source_event:           botan-2 2.19.5 适配（PR feat/botan-2-2.19.5）：botan-test 链接缺 libc++ + --ldflags 引号陷阱

# ═══ 质量 ═══
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     high
draft:                  true
