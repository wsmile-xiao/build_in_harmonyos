id:                     E560
trigger_tool:           conan
phase:                  testing
error_signature:        Error in test\(\) method.*self\.run\(.*--help|self\.run\(.*--version.*ConanException: Error 1 while executing|unrecognized option: version

severity:               1
category:               testing, portability, detection
match_keywords:         fdkaac, --help, exit code 1, test_package, self.run, version banner, usage() return -1
title:                  CLI 工具 -h/--help 按设计返回非零退出码，test_package 的 self.run 需检查输出而非退出码

root_cause:             部分上游 CLI 工具的 -h/--help 处理是 `return usage(), -1;`（如 fdkaac 1.0.9 src/main.c），打印完帮助横幅后以非零状态退出。Conan test_package 的 self.run() 默认把非零退出码当失败抛 ConanException，导致"帮助能正常打印"的二进制被误判为测试失败。这不是 OHOS 平台问题，是上游 CLI 设计与 Conan 测试约定的语义错配。
affected_scope:         所有产物为 CLI 可执行文件、且上游 --help/--version 返回非零退出码的包（fdkaac 1.0.9 实测：--version 直接 unrecognized option；--help 打印横幅后退出码 1）
verification_cmd:       手动运行 packaged 二进制 --help，观察 stdout 有版本横幅且 $? 为 1；grep 上游源码 "case 'h'" 确认 return -1

rec_priority:           1
rec_approach:           check-banner-not-exit-code
rec_description:        test_package 不假设 --help 退出码为 0：用 subprocess 捕获 stdout/stderr 后断言版本横幅文本存在（如 "fdkaac 1.0.9"），或 self.run(..., ignore_errors=True) 后另行校验输出；功能验证走真实编码/执行而非 --version
rec_command:            proc = subprocess.run([fdkaac, "--help"], capture_output=True, text=True); assert "fdkaac 1.0.9" in proc.stdout + proc.stderr
rec_auto_fix:           false
rec_impl:               manual-ci-and-recipe

fallback_priority:      2
fallback_approach:      real-work-instead-of-version-flag
fallback_description:   跳过 --help/--version 探测，直接用二进制做一次真实工作（编码/转换/解析样例输入）并断言产物特征字节（如 M4A 的 ftyp box、ADTS 同步字 ff f*），既避开退出码语义又满足 R34 实质测试
fallback_command:       self.run(f'"{fdkaac}" -b 128000 --silent -o out.m4a in.wav', env="conanrun")
fallback_auto_fix:      false
fallback_impl:          manual-ci-and-recipe

forbid_1_pattern:       ignore_errors=True.*pass
forbid_1_reason:        只加 ignore_errors 却不断言任何输出/产物 = 空壳测试（R34/L1e 破坏性反向验证会拦截）
forbid_1_consequence:   CI L1e sabotage 测试移走 bin/ 仍通过 → 判 test() 空壳，PR 被拒
forbid_2_pattern:       patch.*src/main\.c.*case 'h'.*return 0
forbid_2_reason:        为让 --help 退出码变 0 而改上游源码属于过度适配；上游行为是文档化设计
forbid_2_consequence:   引入无必要补丁，增加维护负担且可能被上游拒收

principles:

causes:                 []
caused_by:              []
similar_to:             E239, E298
conflicts_with:         []
prerequisite_of:        []

source_package:         fdk-aac-encoder/1.0.9
first_seen:             2026-09-04
last_updated:           2026-09-04
metrics_hits:           0
