#====================================================================
# Draft knowledge entry - CMake GNUInstallDirs branch missing HarmonyOS
# Source package: libguarded/2.0.1 (CopperSpice cs_libguarded)
#====================================================================

id:                     DRAFT-libguarded-2.0.1-cmake-gnuinstalldirs-harmonyos-branch
trigger_tool:           cmake|cmake --install
phase:                  install
error_signature:        file cannot create directory: /cmake/|Maybe need administrative privileges|CMAKE_INSTALL_INCLUDEDIR|CMAKE_INSTALL_LIBDIR|GNUInstallDirs

severity:               3
category:               cmake|platform-detection|install-dirs|ohos|portability
match_keywords:         GNUInstallDirs, CMAKE_INSTALL_INCLUDEDIR, CMAKE_INSTALL_LIBDIR, HarmonyOS, OHOS, CMAKE_SYSTEM_NAME, install destination, absolute path, CopperSpice, cmake --install
title:                  CMake platform branch that carries include(GNUInstallDirs) without HarmonyOS leaves CMAKE_INSTALL_* empty and installs to absolute paths

root_cause:             Upstream CMakeLists routes platform setup through
                        if(Darwin)/elseif(Linux|OpenBSD|FreeBSD|NetBSD|DragonFly)/elseif(Windows)
                        and only the matched branches call include(GNUInstallDirs). On OpenHarmony
                        CMAKE_SYSTEM_NAME is HarmonyOS (device cmake auto-detection and the OHOS
                        adapted Conan toolchain both use this spelling), so no branch matches,
                        GNUInstallDirs is never included, and CMAKE_INSTALL_INCLUDEDIR/LIBDIR stay
                        empty. Empty variables inside DESTINATION strings degrade to absolute
                        paths (/CsLibGuarded, /cmake/CsLibGuarded): configure succeeds and only
                        cmake --install fails with "file cannot create directory".

affected_scope:         CMake projects whose GNUInstallDirs include is gated behind a platform
                        branch without an OHOS/HarmonyOS spelling. The CopperSpice cs_* CMake
                        skeleton shares this exact structure, so sibling libraries are expected
                        to hit the same install failure. Configure-time output looks healthy
                        ("will be installed in: /usr/local"), which delays discovery to install
                        or packaging stage.

verification_cmd:       cmake --install <build-dir> --prefix <staging-prefix>

rec_priority:           1
rec_approach:           add-ohos-spelling-to-gnuinstalldirs-branch
rec_description:        Extend the platform regex with both OpenHarmony spellings so the branch
                        that carries include(GNUInstallDirs) also runs on OHOS/HarmonyOS, e.g.
                        elseif(CMAKE_SYSTEM_NAME MATCHES "(Linux|OpenBSD|FreeBSD|NetBSD|DragonFly|OHOS|HarmonyOS)").
                        This keeps the real platform identity, additionally grants the ELF
                        $ORIGIN RPATH from that branch, and fixes direct on-device builds, not
                        only the Conan packaging path. Ship it as a portability patch.
rec_command:            grep -n "GNUInstallDirs" CMakeLists.txt && grep -n "CMAKE_SYSTEM_NAME MATCHES" CMakeLists.txt
rec_auto_fix:           false
rec_impl:               cmake-patch

fallback_priority:      2
fallback_approach:      toolchain-platform-override
fallback_description:   When patching is not acceptable, override the platform in the recipe
                        (CMAKE_SYSTEM_NAME=Linux plus CMAKE_SYSTEM_PROCESSOR=aarch64 in
                        CMakeToolchain cache variables) so the existing Linux branch runs. This
                        works for packaging but hides the platform identity from consumers and
                        leaves direct on-device upstream builds broken; treat as fallback only.
fallback_command:       grep -rn "CMAKE_SYSTEM_NAME" conanfile.py
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       install\(.*DESTINATION.*\$\{CMAKE_INSTALL_[A-Z]+\}.*\)\s*$
forbid_1_reason:        Unconditionally trusting CMAKE_INSTALL_* variables without checking that the
                        branch defining them actually ran turns silent empties into root-level writes.
forbid_1_consequence:   Install fails at /cmake/<Pkg> or, worse, succeeds writing absolute paths on a
                        privileged host.

similar_to:             [E267,E504,E532,DRAFT-eigen-3.4.1-cmake-harmonyos-warning-triage]
conflicts_with:         []
prerequisite_of:        []

