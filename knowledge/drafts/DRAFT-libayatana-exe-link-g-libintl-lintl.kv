#====================================================================
# DRAFT-libayatana-exe-link-g-libintl-lintl — 可执行文件链接期
#   g_libintl_ngettext undefined（PkgConfigDeps 生成的 glib-2.0.pc
#   缺 -lintl）——EXE linker flags 追加 -lintl + test_package 补 pc
# 对应人类文档: knowledge/drafts/DRAFT-libayatana-exe-link-g-libintl-lintl.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: libayatana 0.9.5 (libayatana-indicator) HarmonyOS PC 适配
#  （tools/ayatana-indicator-loader3 链接经 libayatana-ido3 链引用
#   g_libintl_ngettext）
#====================================================================

id:                     DRAFT-libayatana-exe-link-g-libintl-lintl
trigger_tool:           ld|clang|cmake|conan create
phase:                  linking
error_signature:        undefined reference due to --no-allow-shlib-undefined: g_libintl_ngettext|
                         undefined reference to `g_libintl_ngettext'|
                         ld\.lld: error: undefined reference.*g_libintl_

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               linking, nls, conan, cmake, pkgconfig
match_keywords:         g_libintl_ngettext, libintl, -lintl, --no-allow-shlib-undefined,
                         PkgConfigDeps, glib-2.0.pc, Libs, 追加, EXE linker flags,
                         loader 链接, shared lib 静态引用
title:                  可执行文件链接期 g_libintl_ngettext undefined——
                         PkgConfigDeps 生成的 glib-2.0.pc 缺 -lintl，EXE linker
                         flags 追加 -lintl 解决

# ═══ Layer 2: 诊断层 ═══
root_cause:             glib 配方 package_info 导出的 glib-2.0.pc（PkgConfigDeps
                         生成）Libs 行只含 -lglib-2.0 -lm -lpthread -ldl，未含
                         -lintl。当 .so（如 libayatana-ido3 静态内嵌 glib）引用
                         g_libintl_ngettext 且被可执行文件链接时，
                         ld.lld --no-allow-shlib-undefined 强制该符号必须有定义；
                         glib 包内 libintl.so 实际导出 g_libintl_ngettext，
                         只是 pc 未带 -lintl（正式 E015/E027 覆盖 configure
                         传参/disable-nls 场景，但均未覆盖 PkgConfigDeps 生成
                         pc 缺 -lintl 的 CMake 场景）
affected_scope:         所有依赖 glib + gtk/ayatana 生态、产物含可执行文件的 CMake
                         项目（loader 等可执行链接 .so 链引用 g_libintl_* 时）
verification_cmd:       nm -D <glib_pkg>/lib/libintl.so | grep g_libintl_ngettext
                         （应有 T 符号，证明只需补链接参数而非 wrapper）

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           exe-linker-flags-lintl
rec_description:        generate() 里给 CMAKE_EXE_LINKER_FLAGS 追加 -lintl
                         （glib 包 libdir 已在 link_dirs 注入中）：
                         tc.variables["CMAKE_EXE_LINKER_FLAGS"] = flags + " -lintl"
                         test_package 侧（PkgConfigDeps 场景）同步给生成的
                         glib-2.0.pc 的 Libs 行追加 -lintl，保证消费者链接闭合
rec_command:            见 conanfile.py generate()（主包 EXE flags）+ test_package
                         conanfile.py generate()（glib-2.0.pc Libs 追加）
rec_auto_fix:           false
rec_impl:               recipe-generate

fallback_priority:      2
fallback_approach:      intl-wrapper
fallback_description:   仅当 glib 包内 libintl.so 不导出 g_libintl_*（musl 场景）
                         才用 E508 的 intl-wrapper 源码垫片；本场景符号存在仅缺
                         链接参数，wrapper 属过度方案
fallback_command:
fallback_auto_fix:      false
fallback_impl:          source-shim

# ★ 禁止策略 ★
forbid_1_pattern:       --disable-nls
forbid_1_reason:        本库为 GTK3 图形库，NLS 是交付面；E027 的禁用式方案
                         不适合此处（且符号本身存在，补链接即可）
forbid_1_consequence:   功能损失（多语言支持被裁）

# ═══ Layer 4: 关联 ═══
similar_to:             E015, E027, E508, E123, DRAFT-glib-2.84.0.1-gettext-libintl-ld-library-path-shadow
causes:                 []
caused_by:              []
conflicts_with:         []
prerequisite_of:        []
last_updated:           2026-09-18
source_event:           libayatana 0.9.5 HarmonyOS PC 适配：G2 链接
                         tools/ayatana-indicator-loader3 报 g_libintl_ngettext
                         undefined（引用自 libayatana-ido3-0.4.so）；nm 验证 glib
                         包内 libintl.so 有 T 符号 → EXE flags 追加 -lintl 后通过
authors:                OHC-Agent