#====================================================================
# DRAFT-gnustep-gui-appkit-consumer-closure
# Real AppKit consumers need gnustep-base propagation and GNUstep runtime flags
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: gnustep-gui 0.32.0 HarmonyOS PC 适配（PR #7095）
#====================================================================

id:                     DRAFT-gnustep-gui-appkit-consumer-closure
trigger_tool:           clang|ld.lld|conan|cmake
phase:                  build|package|testing
error_signature:        AppKit/AppKit.h file not found|unknown type name NSImage|unknown type name NSBezierPath|undefined reference to gnustep_test_support_value|undefined reference to objc_msgSend|linker command failed with exit code 1

severity:               2
category:               objc|appkit|consumer-test|transitive-headers|transitive-libs|runtime
match_keywords:         AppKit, NSImage, NSBezierPath, NSColor, NSConstantString,
                         -fobjc-runtime=gcc, -fblocks, transitive_headers,
                         transitive_libs, test_package, gnustep-base::gnustep-base,
                         gnustep-gui::gnustep-gui

title:                  Real AppKit consumers need gnustep-base headers/libs and GNUstep runtime flags, not a plain C smoke test
root_cause: >
  GNUstep GUI exports an Objective-C AppKit API that depends on gnustep-base symbols and
  GNUstep runtime conventions. A consumer that only checks for library presence can compile
  too little or link with the wrong runtime flags. Because -fobjc-runtime=gcc,
  -fblocks, and -fconstant-string-class=NSConstantString are part of the ABI contract, the
  test_package must mirror them and compile a real AppKit consumer.
affected_scope: >
  Conan consumers of GNUstep GUI, especially test_package recipes that use AppKit headers and
  expect Objective-C runtime compatibility across build and target stages.
verification_cmd: >
  Compile the package's AppKit consumer with AppKit/AppKit.h and require NSImage,
  NSBezierPath, and NSColor construction to succeed while linking only against the packaged
  gnustep-gui and gnustep-base outputs.

rec_priority:           1
rec_approach:           compile-real-AppKit-consumer-with-ABI-flags
rec_description: >
  Keep gnustep-base as a transitive public dependency and propagate headers/libs to the
  downstream consumer. In test_package, build a genuine Objective-C AppKit probe rather than
  a plain C stub, and link with the GNUstep runtime flags
  -fobjc-runtime=gcc -fblocks -fconstant-string-class=NSConstantString so the consumer uses
  the same ABI assumptions as the package itself.
rec_command: >
  add_executable(test_gnustep_gui test_gnustep_gui.m test_support.c);
  target_link_options(test_gnustep_gui PRIVATE -fobjc-runtime=gcc -fblocks);
  target_link_libraries(test_gnustep_gui PRIVATE gnustep-gui::gnustep-gui)
rec_auto_fix:           false
rec_impl:               appkit-consumer-test-package

fallback_priority:      2
fallback_approach:      direct-objc-consumer-with-explicit-transitive-deps
fallback_description: >
  If the consumer helper cannot inherit the package's exported flags automatically, inject the
  same runtime options and explicit gnustep-base dependency in the consumer CMakeLists rather
  than dropping AppKit usage or substituting a non-Objective-C smoke test.
fallback_command:       keep the Objective-C consumer and inject the same GNUstep runtime flags explicitly
fallback_auto_fix:      false
fallback_impl:          manual-consumer-abi-closure

forbid_1_pattern:       plain C consumer|hello world C smoke test|omit.*-fobjc-runtime|omit.*NSConstantString
forbid_1_reason:        A plain C consumer does not exercise the Objective-C ABI or AppKit export surface.
forbid_1_consequence:   The package may appear linkable while real AppKit consumers still fail.

forbid_2_pattern:       transitive_headers=False|transitive_libs=False|public dependency hidden from consumer
forbid_2_reason:        AppKit headers and symbols must propagate to downstream consumers.
forbid_2_consequence:   The consumer compiles against the wrong include/link surface and fails outside the recipe.

principles:             P016
