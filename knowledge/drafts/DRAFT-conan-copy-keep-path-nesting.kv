#====================================================================
# DRAFT-conan-copy-keep-path-nesting — conan copy 工具 pattern+keep_path 目录嵌套陷阱
# 触发事件: alexjs 11.0.1 HarmonyOS PC 适配（archives/a/alexjs/11.0.1）
# 主从明确：conan.tools.files.copy 的路径语义坑，影响 export_sources/package
#====================================================================

id:                     DRAFT-conan-copy-keep-path-nesting
trigger_tool:           conan|copy
phase:                  package|export
error_signature:        Cannot find module.*test/index.js|node test/index.js.*Error|
                         node_modules/.*/bin|directory.*nested|keep_path

severity:               3
category:               conan|recipe|packaging
match_keywords:         conan copy, keep_path, export_sources, node_modules, pattern,
                         嵌套, 目录复制, copytree
title:                  conan copy 工具 pattern+keep_path 的目录嵌套陷阱：pattern 指向目录自身时会把目录名再套一层

root_cause: >
  conan.tools.files.copy 的 keep_path=True 会保留 pattern 匹配到的相对路径。
  若 pattern 为 'upstream-tests/*' 而 src 指向 recipe 根，会把 upstream-tests/
  目录名作为相对路径前缀再拼到 dst 后（upstream-tests/upstream-tests/...）；
  同理 'node_modules/*' + src 指向 node_modules 会匹配不到任何文件（静默空目录），
  导致打包产物缺依赖、运行期 ERR_MODULE_NOT_FOUND。
  正确写法：src 指向目录内部 + pattern '*'（如 src=<...>/upstream-tests,
  pattern='*'）；复制整目录树用 shutil.copytree 更确定。
affected_scope: >
  所有 conanfile.py 中通过 copy() 复制目录树到 export_sources / package 的场景，
  尤其是 npm/Node.js 项目的 node_modules 整树打包与上游测试目录携带。
verification_cmd: >
  conan create 后检查 build/export 缓存中目标目录层级（find <cache> -name
  '<dir>/<dir>'）；或打包后运行产物验证依赖完整（node cli.js --version）。

rec_priority:           1
rec_approach:           src-into-dir-pattern-star
rec_description: >
  src 参数指向目录内部（不包含要复制的目录名），pattern 用 '*'，keep_path=True
  即可平铺复制；跨目录树复制用 shutil.copytree（确定性，无 pattern 语义歧义）。
rec_command: >
  copy(self, "*", src=os.path.join(self.recipe_folder, "upstream-tests"),
       dst=os.path.join(self.export_sources_folder, "upstream-tests"));
  shutil.copytree(tests_src, tests_dst)
rec_auto_fix:           false
rec_impl:               conan-copy-correct-pattern

forbid_1_pattern:       copy\(self, "dir/\*", src=recipe_root|copy\(self, "node_modules/\*"
forbid_1_reason: >
  pattern 'dir/*' + src 指向上级目录会把 dir/ 再套一层；'node_modules/*' + src
  指向 node_modules 匹配不到任何文件，静默产出空目录。
forbid_1_consequence:   export_sources 双重嵌套导致 build 找不到测试；package 缺依赖运行失败

principles:             P016
similar_to:
conflicts_with:
prerequisite_of:

