id:                     E257
trigger_tool:           make
phase:                  installation
error_signature:        No rule to make target 'install'|make: \*\*\* No targets specified and no makefile found|install target not defined

severity:               2
category:               platform, install, build-system
match_keywords:         HarmonyOS, UNAME, filter, install target, No rule to make target,
                        Makefile, DESTDIR, make install

root_cause:             纯 Makefile 项目（无 configure）在顶层 Makefile 用 ifneq(filter Linux Darwin ..., $(UNAME)) 白名单包裹整个安装规则段，UNAME=HarmonyOS 不在白名单内导致 install 目标与 DESTDIR 目录变量整体未定义，make install 报 No rule to make target 'install'。与 E108（install 命令缺失 Error 127）不同：本条是目标未定义，E108 是命令不存在

affected_scope:         使用 UNAME 平台过滤包裹 install 段的纯 Makefile 项目（xxhash 0.8.2 实测）
verification_cmd:       make -n install

rec_priority:           1
rec_approach:           patch-makefile-uname-whitelist
rec_description:        在源 Makefile 的 UNAME filter 白名单中追加 HarmonyOS（R1/R6：改源文件并经 track-edit 记录，补丁由 refresh-patch --auto 生成）；若系统同时缺 GNU install 命令，参照 E108 用 cp -p/mkdir -p 替换 INSTALL/INSTALL_DATA/INSTALL_DIR
rec_command:            编辑 Makefile: ifneq (,$(filter Linux Darwin ... HarmonyOS , $(UNAME)))
rec_auto_fix:           false
rec_impl:               manual-patch

forbid_1_pattern:       --build=|--host=
forbid_1_reason:        native 编译禁止使用 --build/--host 参数（R15 铁律）
forbid_1_consequence:   config.guess 检测被绕过，可能导致平台识别错误

principles:

causes:                 []
caused_by:              []
similar_to:             [E108]
conflicts_with:         []
prerequisite_of:        []

doc_file:               doc/E257.md
last_updated: 2026-08-31
source_event:           xxhash-0.8.2-compile

