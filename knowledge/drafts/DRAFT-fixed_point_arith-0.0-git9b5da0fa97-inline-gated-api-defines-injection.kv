#====================================================================
# DRAFT-fixed_point_arith-0.0-git9b5da0fa97-inline-gated-api-defines-injection
#    头文件门控的 inline 公开 API → Conan 配方必须注入 cpp_info.defines
# 来源: fixed_point_arith 0.0-git9b5da0fa97 适配（Path B 知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-fixed_point_arith-0.0-git9b5da0fa97-inline-gated-api-defines-injection
trigger_tool:           conan|cc|clang|test_package
phase:                  configuration|compilation|testing
error_signature:        implicit declaration of function.*f_add|
                         implicit declaration of function.*q_rot|
                         undefined reference to.*f_add|
                         header.*new declaration of.*inline|
                         FXP_C99_INLINE

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, recipe, headers, inline, defines, fixed-point
match_keywords:         cpp_info.defines, FXP_C99_INLINE, 头文件门控, inline 公开 API,
                        implicit declaration, net-buffer, Q 格式, 固定点, package_info
title:                  头文件门控的 inline 公开 API：库头文件在 #ifdef <宏> 内才声明函数，
                        Conan 配方必须在 package_info() 注入 cpp_info.defines 与上游默认一致

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             公开 API 的存在性由编译宏门控（fixed_point.h 仅在 FXP_C99_INLINE 定义时
                        include inline/fixed_point.h），上游 Makefile 默认 -DFXP_C99_INLINE 编译；
                        消费者未定义该宏则头文件无函数声明，调用报隐式声明/链接失败，
                        错误信息与库无关难以定位。配方 package_info() 未传递上游默认编译宏。
affected_scope:         所有以"宏门控 inline 声明 + 上游默认开启该宏"方式提供公开 API 的
                        C 库（固定点/向量/矩阵/数学内联头文件典型），其 Conan 配方与消费者测试。
verification_cmd:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64

# 真实证据: fixed_point_arith 0.0-git9b5da0fa97 (2026-09-27) conan create 通过
#   头文件: include/fixed_point/fixed_point.h #ifdef FXP_C99_INLINE #include "inline/fixed_point.h" #endif
#   上游:   Makefile CPPFLAGS += -DFXP_C99_INLINE
#   修复:   package_info(): self.cpp_info.defines = ["FXP_C99_INLINE"]

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           inline-gated-api-defines-injection
rec_description:        在 package_info() 中注入与上游默认一致的门控宏:
                        self.cpp_info.defines = ["<上游默认宏>"]。消费者测试因此只需包含公开
                        头文件即可编译运行；注入值必须与库编译时一致（LTO 变体除外）。
rec_command:            self.cpp_info.defines = ["FXP_C99_INLINE"]
rec_auto_fix:           false
rec_impl:               conanfile-edit

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      consumer-define-in-test
fallback_description:   若无法修改配方（外部配方），在消费者测试顶部 #define <宏> 后再包含头文件，
                        但这是测试侧补丁，会掩盖配方契约缺口，不推荐。
fallback_command:       #define FXP_C99_INLINE · #include "fixed_point/fixed_point.h"
fallback_auto_fix:      false
fallback_impl:          test-edit

# ★ 禁止策略 (与推荐方案同等重要) ★
forbid_1_pattern:       cpp_info\.defines\s*=\s*\[\s*"FXP_C99_INLINE"\]\s*\]\s*$.*(?:LTO|lto)
forbid_1_reason:        若上游按 LTO（不定义该宏）构建，注入会与库符号分裂。
forbid_1_consequence:   消费者声明与库符号不一致，链接或语义错误。

# ═══ Layer 4: 原则引用 ═══
principles:

