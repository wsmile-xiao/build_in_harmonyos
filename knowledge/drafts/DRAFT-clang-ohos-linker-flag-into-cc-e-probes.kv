#====================================================================
# DRAFT-clang-ohos-linker-flag-into-cc-e-probes.kv
# OHOS 宿主 clang 把链接期选项 (-fuse-ld=lld) 带进 $CC -E 预处理探测,
# stderr "argument unused" 使 autoconf 预处理模式头文件探测误判
# 触发事件: i686-elf-binutils 2.46.1 HarmonyOS PC 适配 (round 3-5)
#====================================================================

id:                     DRAFT (proposed E###)
trigger_tool:           configure|clang|make
phase:                  configuration|compilation
error_signature:        argument unused during compilation|
                         unused argument.*-fuse-ld|
                         checking for limits.h.*no|checking for fcntl.h.*no|
                         checking for spawn.h.*no|
                         LONG_MIN undeclared|posix_spawn undeclared

severity:               2
category:               autotools|detection|toolchain|ohos|build-system
match_keywords:         -fuse-ld=lld, $CC -E, preprocess probe, argument unused,
                         unused-command-line-argument, CPPFLAGS, HAVE_LIMITS_H,
                         HAVE_FCNTL_H, HAVE_SPAWN_H, autoconf, clang, stderr,
                         header detection, libiberty, fibheap.c, pex-unix.c
title:                  OHOS 宿主 clang 把链接期选项带进 $CC -E 预处理探测,须以 CPPFLAGS 追加 -Wno-unused-command-line-argument 恢复头文件探测

root_cause: >
  OHOS 构建宿主 clang 在每次编译调用 (含 configure 的 $CC -E 预处理探测) 注入
  链接期选项 (典型 -fuse-ld=lld)。该选项在预处理上下文未被使用,clang 向 stderr
  打印 "argument unused during compilation" 告警。autoconf 旧式预处理模式头文件
  检查把任何 stderr 视为失败,HAVE_LIMITS_H/HAVE_FCNTL_H/HAVE_SPAWN_H 等被误判为
  no,导致 libiberty 编译失败 (LONG_MIN in fibheap.c, O_* in pex-unix.c,
  posix_spawn ...)。

affected_scope: >
  所有 autotools + OHOS 宿主 clang 的适配。binutils 族 i686-elf-binutils、
  x86_64-elf-binutils、riscv64-elf-gdb 三处逐字同款修复 (注释+CPPFLAGS);
  仓库 archives 18 个文件 (gdal/3.9.2.1+3.9.2.2、hydra、kvazaar、octave、
  proj、inotify-tools、lttoolbox、wal2json、x86_64-elf-grub、riscv64-elf-gdb、
  x86_64-elf-binutils 等) + 候选 2 文件 = 20 文件含同类
  -Wno-unused-command-line-argument。

verification_cmd: >
  grep -n "unused-command-line-argument" archives/*/*/*/conanfile.py |
  wc -l   # 同类 flag 覆盖 20 文件
  grep -e "checking for limits.h" -e "checking for fcntl.h" configure.log
  # 修复后应输出 yes

rec_priority:           1
rec_approach:           env-cppflags-suppress-unused-arg
rec_description: >
  build() 向 os.environ[CPPFLAGS] 追加 -Wno-unused-command-line-argument,精准抑制
  该单条诊断 (P007),使 $CC -E 预处理探测获得干净 stderr,头文件探测恢复正确。
rec_command:            os.environ["CPPFLAGS"] = (os.environ.get("CPPFLAGS", "") + " -Wno-unused-command-line-argument").strip()
rec_auto_fix:           false
rec_impl:               conan-recipe-environment

fallback_priority:      2
fallback_approach:      configure-ac-compiler-mode-probes
fallback_description:   若告警抑制仍不足,应按 autoconf 现代探测改 configure.ac 的
                        AC_CHECK_HEADERS 为编译器模式 (AC_TRY_COMPILE/AC_PREPROC_IFELSE
                        依赖编译器返回码而非 stderr),从根上消除 stderr 语义依赖。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       "#ifdef __OHOS__|defined\\(__OHOS__\\)|is_ohos\\(\\)|#define HAVE_LIMITS_H.*1"
forbid_1_reason:        这是工具链告警语义问题,不是平台能力差异;平台宏/预置答案硬编码
                        (R8) 无法覆盖其他同样注入链接期 flag 的 clang 驱动与构建宿主。
forbid_1_consequence:   PR 审查被拒 (R8 违规),机制在同类工具链上仍会复发。
forbid_2_pattern:       -Wno-error|CFLAGS.*-Wno-unused-command-line-argument
forbid_2_reason:        应精准到具体告警类别 (P007) 并放 CPPFLAGS 覆盖预处理探测;
                        全局 -Wno-error 掩盖真实编译错误,仅 CFLAGS 漏掉 $CC -E 阶段。
forbid_2_consequence:   真实错误被掩盖 (P007 违反),或 $CC -E 探测仍在告警使 HAVE_*_H
                        误判依旧。

principles:             P007, P014

causes:                 []
caused_by:              []
similar_to:             [E063, E266]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-clang-ohos-linker-flag-into-cc-e-probes.md
last_updated:           2026-08-23
source_event:           i686-elf-binutils 2.46.1 适配 (round 3-5): $CC -E 预处理探测
                        stderr 污染致 HAVE_LIMITS_H/HAVE_FCNTL_H/HAVE_SPAWN_H 误判,
                        CPPFLAGS 追加 -Wno-unused-command-line-argument 后 configure
                        通过、make check 0 unexpected failure;x86_64-elf-binutils
                        2.46.1 与 riscv64-elf-gdb 17.2 同款修复 (注释逐字一致)

authors:                atomcode-executor
source_pr:
source_commit:

metrics_success_count:  3
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-08-23
