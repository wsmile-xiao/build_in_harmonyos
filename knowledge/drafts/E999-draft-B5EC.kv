#====================================================================
# E999 draft — OHOS libc++ lacks std::string_view operator<=>
# 发现于 kcodecs 6.26.0 适配（2026-09-05）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E999
trigger_tool:           clang
phase:                  compilation
error_signature:        invalid operands to binary expression \('std::string_view' \(aka 'basic_string_view<char>'\) and 'std::string_view'\)|no known conversion from 'std::string_view' .* to .* for 1st argument.*operator<=>|no member named 'operator<=>' in namespace 'std'

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               libc, portability, build-system, cmake
prescan_pattern:        operator<=>\s*\(\s*const\s+(std::)?string_view
match_keywords:         string_view, operator<=>, spaceship, libc++, clang 15, compare
title:                  OHOS libc++ (clang 15 工具链) 未实现 std::string_view 的 operator<=>，C++20 三路比较代码编译失败

# ═══ Layer 2: 诊断层 ═══
root_cause:              OHOS SDK 的 libc++ 头文件（clang 15 工具链）不提供 std::basic_string_view 的三路比较运算符（上游 libc++ 在更高版本才实现），任何用 sv <=> sv 的 C++20 代码在该工具链上无法编译
affected_scope:          所有以 C++20 编译且对 string_view 使用三路比较的第三方库（KDE Frameworks 6.26 起新代码常见）
verification_cmd:        echo '#include <string_view>
auto c = std::string_view("a") <=> std::string_view("b");' | clang++ -std=c++20 -x c++ - -fsyntax-only

# ═══ Layer 3: 方案层 ═══
rec_priority:            1
rec_approach:            source-patch
rec_description:         将 sv <=> sv 改写为 sv.compare(other) <=> 0——compare 返回 int，内置整型 <=> 可用，保留 std::strong_ordering 语义
rec_command:             patch 源文件: return std::string_view{...}.compare(std::string_view{...}) <=> 0;
rec_auto_fix:            false
rec_impl:                manual-patch

fallback_priority:       2
fallback_approach:       toolchain-upgrade
fallback_description:    等 OHOS SDK 升级到提供 string_view spaceship 的 libc++ 后自然解决（当前 26.0.0.18 SDK 无解）
fallback_command:
fallback_auto_fix:       false
fallback_impl:

forbid_1_pattern:        -std=c\+\+17
forbid_1_reason:         降回 C++17 会让库内其他 C++20 特性（std::span 等）编译失败，只是把错误换个位置
forbid_1_consequence:    连锁编译错误，问题扩大

# ═══ Layer 4: 原则引用 ═══
principles:              P005

# ═══ 关系图 ═══
causes:                  []
caused_by:               []
similar_to:              []
conflicts_with:          []
prerequisite_of:         []

