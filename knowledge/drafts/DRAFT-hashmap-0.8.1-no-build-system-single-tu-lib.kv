#====================================================================
# DRAFT-hashmap-0.8.1-no-build-system-single-tu-lib — 无构建系统
# 单 TU C 源库（.c+.h）custom 配方直接编译上游 .c 为静态库
#
# 触发事件: hashmap 0.8.1（tidwall/hashmap.c）首轮适配——上游无
#           configure/make/CMake/meson，仅 hashmap.c(1154 行) + hashmap.h
#           (62 行)。conan-init 按 autotools 模板生成配方不适用，需改为
#           custom 配方直接编译单 TU。
# 路径: Path B（知识库扩展）
#====================================================================

id:                     DRAFT-hashmap-0.8.1-no-build-system-single-tu-lib
source_lib:             hashmap 0.8.1
trigger_tool:           conan|conan-verify|conan-init
phase:                  recipe|compilation|packaging
error_signature:        No configure|no Makefile|autotools.*configure.*fail|
                        cc: error: configure: No such file|No targets specified

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, c, single-file, no-build-system, custom-recipe, packaging
match_keywords:         hashmap.c, tidwall, 单文件, single-file, 无构建系统,
                        no build system, single translation unit, 单 TU, direct
                        compile, custom 配方, libhashmap, .c+.h, 静态库
title:                  无构建系统单 TU C 源库（.c+.h）应使用 custom 配方直接编译上游 .c 为静态库，勿用 autotools/makefile 模板或 header-only 形态

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  conan-init 按源码形态推断构建系统，纯 .c+.h 无 Makefile 的上游可能被
  误判为 autotools 而生成 configure/make 配方，build() 在 configure 阶段
  必然失败。同时该形态既不是 header-only（实现体在 .c 不在头文件，E257
  不适用），也不是 stb 单头实现库（实现体在头文件宏实例化，DRAFT-enet
  不适用）。正确形态是 custom 配方：build() 直接用 Conan conf 提供的
  编译器把上游 .c 编译为静态库（clang -c → ar 归档 → ranlib），package()
  安装 .h 与 .a；shared 选项时加 -fPIC 编 .so。编译器必须从
  tools.build:compiler_executables（dict）读取（E392），禁止裸 ${CC}。
affected_scope:         所有"实现体在 .c、无任何构建系统"的单 TU C 源库
                        （hashmap.c 类：一个 .c + 一个 .h、无 Makefile/CMake），
                        在 Conan 2 + OHOS/CI clean 环境下适配的配方。
verification_cmd:       python3 scripts/ohc-run.py conan-verify hashmap 0.8.1
                        # G0-G4+L2/L4/L5 全 PASS

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           custom-direct-compile-single-tu
rec_description:        配方三要素：(1) package_type="library"，settings 四项齐全，
                        options shared 默认 False（R26）；(2) build() 从
                        tools.build:compiler_executables（check_type=dict）取
                        cc/ar/ranlib，clang -c 上游 .c -o hashmap.o 后
                        ar rcs libhashmap.a + ranlib；shared=True 时
                        clang -fPIC -shared 编 .so；(3) package() 安装
                        hashmap.h 到 include/、libhashmap.a/.so 到 lib/、
                        LICENSE 到 licenses/；package_info libs=["hashmap"]。
rec_command:            cc=self.conf.get("tools.build:compiler_executables",default={},check_type=dict).get("c","clang")
rec_auto_fix:           false
rec_impl:               conan-recipe

# 回退方案
fallback_priority:      2
fallback_approach:      headeronly-with-source-tu
fallback_description:   若该形态被误判为 header-only（仅头文件被安装、.c 未编译），
                        下游链接会缺符号。回退：把 .c 作为实现 TU 纳入库目标
                        （同 DRAFT-enet fallback 思路但用 custom 直接编译）。
fallback_command:       package_type="library"; build(): 编译 .c 为 .a
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       AutotoolsToolchain\(self\).*configure|autotools\.configure\(\)|make CC=
forbid_1_reason:        无 configure/Makefile 的上游走 autotools/makefile 模板必然失败。
forbid_2_pattern:       \$\{CC\}|\$\{CFLAGS\}
forbid_2_reason:        R33：CI worker 上 shell 环境变量为空，必须从 Conan conf 取编译器。

# ═══ Layer 4: 验证层 (Validation) ═══
verified_on:            hashmap 0.8.1（OHOS armv8，clang 15.0.4，conan 2.29.1）
verification_result:    libhashmap.a 正常产出（ar archive）；conan-verify
                        G0-G4+L2/L4/L5 全 PASS；W3 本地 CI 100%（L0/L1/L4/L5）；
                        消费者 test_package（test_hashmap）1/1 Passed；鸿蒙专项
                        tests-ohos/ohos_test.c PASSED。

# 反例/限制
limitations: >
  - 仅适用实现体在 .c、无任何构建系统的单 TU 库。有 Makefile 走 E392
    raw-makefile 模式；实现体在头文件（宏实例化）走 DRAFT-enet；
    纯 header-only 走 E257/E321/E322。
  - 上游测试（如 HASHMAP_TEST 内置自检）以独立入口运行并记双口径台账，
    不并入配方 build()。
