#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E546.kv，填写各字段
# 对应的人类文档: doc/E546.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E546
trigger_tool: conan
phase: build|link
error_signature: Found Eigen2:|undefined symbol: OpenBabel::the.*Charges|no member named 'svd' in 'Eigen::Matrix'|no matching member function for call to 'solve'|libxml2 not found - disabling CML support

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 3
category: build-system|cmake|conan
match_keywords: Eigen3_FOUND,LibXml2_FOUND,EIGEN3_FOUND,LIBXML2_FOUND,CONFIG,find_package,cmake_file_name,undefined symbol,Fallback,Eigen2 branch
title: conan CMakeToolchain 强制 CONFIG 优先后，上游 Module 风格全大写 <PKG>_FOUND 判断失效，静默回退到错误分支（Eigen2 API/禁用 CML）导致静态链接 undefined symbol

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: conan 2.x CMakeToolchain 设 CMAKE_FIND_PACKAGE_PREFER_CONFIG=ON，find_package(Eigen3/LibXml2) 走 CONFIG 模式命中 CMakeDeps 生成的 config，只定义 Eigen3_FOUND/LibXml2_FOUND（与包名同形）；上游按 Module 惯例判全大写 EIGEN3_FOUND/LIBXML2_FOUND → 恒 false → 回退 Eigen2 API 分支（对 Eigen3 头编译 Eigen2 代码）或排除 XML 格式/插件源码，最终静态链接时 undefined symbol。cpp_info.includedirs/libdirs 还可能是相对 package_folder 的相对路径，isfile 探针必须先锚定为绝对路径。
affected_scope: 所有依赖 Eigen3/LibXml2 等 conan 包、上游用 Module 风格 find_package 变量判断的 CMake 工程（静态构建下症状为 undefined symbol，动态构建下为功能静默缺失）
verification_cmd:

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:
rec_approach: ①补丁把上游判断改为 if(EIGEN3_FOUND OR Eigen3_FOUND)（含带空格变体）；②module-mode 消费的变量（EIGEN3_INCLUDE_DIR、ZLIB_LIBRARY、LIBXML2_LIBRARY/LIBRARIES）在 recipe generate() 显式注入为绝对路径（EIGEN3 探针文件=signature_of_eigen3_matrix_library）；③若上游 test/tools 分支 set(libs )，CONFIG 模式不填全大写变量，需 recipe 直接注入 LIBXML2_LIBRARIES 缓存变量。实例：openbabel/3.1.1 patches/0001/0003/0004/0005
rec_description:        一句话描述这个推荐方案
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

