#====================================================================
# DRAFT-ci-l1d-print-substring-false-positive.kv
# CI L1d "fake test" 启发式对消费者可执行文件名含 print/echo/true 子串的误报
#====================================================================

id:                     DRAFT-ci-l1d-print-substring-false-positive
trigger_tool:           ci|test
phase:                  testing
error_signature:        L1d: test\(\) method appears to be a fake test|
                         fake test detected|self\.run.*\(echo\|print\|true\)
severity:               2
category:               ci|test|l1|false-positive|ohos
match_keywords:         L1d, fake test, fake_test, 误报, false positive, print, echo,
                         true, self.run, consumer, 消费者, 可执行文件名, add_executable,
                         CTest, test_package
title:                  CI L1d "fake test" 误报: self.run 行子串匹配 echo/print/true,
                        消费者可执行文件名含 print 等子串时误判为空壳测试

root_cause: >
  build_and_test.sh L1d 用 grep -qE "self\.run.*(echo|print|true)" 对
  test_package/conanfile.py 判假测试, 该模式为行内子串匹配。当消费者可执行
  文件名或 self.run 命令行中其他标识符包含 print/echo/true 子串
  (asprintf.c 实例: test_asprintf_c 因 asprintf 含 print 被命中), 且 test()
  实际执行真实构建+运行的 CTest 用例时, L1d 误报 fake test, W3 整体失败。
  测试内容真实 (真实断言+链接包产物+退出码 0), 误报差异完全来自名字子串。
affected_scope:         >
  test_package 消费者可执行文件名含 print/echo/true 子串的库 (asprintf、
  printf 系、任何 print/echo 相关命名), 且 test() 通过 cmake/ctest 真实
  构建并运行消费者程序。影响面: W3 L1 门禁误判, 不阻塞 CI 修复后的真实
  交付, 但阻断首轮适配自动化。
verification_cmd:       grep -qE "self\.run.*(echo|print|true)" test_package/conanfile.py
                        && grep -q "add_executable\|--target test" test_package/CMakeLists.txt
                        ; # 同时成立即疑似误报, 需人工核对测试是否真实运行

rec_priority:           1
rec_approach:           rename-consumer-executable
rec_description:        重命名消费者可执行文件, 避开 echo/print/true 子串
                        (asprintf.c: test_asprintf_c→test_consume), 同步
                        CMakeLists.txt add_executable 与 MANIFEST.yml 声明,
                        重跑 conan-verify/W3 复验。真实测试内容保持不变。
rec_command:            # 编辑 test_package/CMakeLists.txt add_executable 目标名 +
                        #   MANIFEST.yml 二进制声明 + conanfile.py 引用, 全部一致,
                        #   然后重跑: python3 scripts/ohc-run.py conan-verify asprintf.c 0.0.3
rec_auto_fix:           false
rec_impl:               rename-executable

fallback_priority:      2
fallback_approach:      ci-heuristic-anchor
fallback_description:   (根治, CI 维护端) 将 L1d 模式改为词边界/独立词匹配, 排除
                        --target/add_executable 构建上下文, 或存在真实构建+运行
                        证据时豁免。不在执行端权限内, 仅上报建议。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 ★
forbid_1_pattern:       self\.run\([^)]*echo|self\.run\([^)]*print
forbid_1_reason:        为绕过 L1d 把真实测试替换成 echo/print 空壳, 触发 E251
                        虚假测试红线; 且 L1e 负向测试仍会拦截无包依赖的测试。
forbid_2_pattern:       只改 MANIFEST.yml 不重跑 W3|伪造 CTest 日志
forbid_2_reason:        测试产物与声明不一致, W4 审计/R38 可发现; 改名后必须
                        实际重跑并保留真实日志。

principles:

causes:                 []
caused_by:              []
similar_to:             [E251, E281]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-ci-l1d-print-substring-false-positive.md
last_updated:           2026-09-20
source_event:           asprintf.c 0.0.3 OHOS 适配首轮: W3 L1d 误报 fake test
                        (可执行文件名含 print), 重命名 test_consume 后 W3 通过,
                        exit_code=0
contributor_id:         pc7-1
authors:                pc7-1
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.85
metrics_last_used:      2026-09-20