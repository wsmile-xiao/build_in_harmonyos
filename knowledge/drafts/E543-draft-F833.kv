#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: build.sh|clang|conan|cmake
phase: building|packaging|testing
error_signature: #!/bin/bash|/bin/bash: No such file or directory|gcc: inaccessible or not found|no formal test suite

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: ohos, build-system, c, conan, testing
match_keywords: aria, C89, standalone, build.sh, /bin/bash, gcc, clang, llvm-ar, llvm-ranlib, no tests, consumer test, static library
title: Single-file C89 libraries with a hard-coded standalone build script need a custom Conan static-library recipe and API consumer test

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: The upstream project is a single-file C89 library whose only build entrypoint hard-codes /bin/bash and gcc and provides no registered test suite. On HarmonyOS the script cannot run as written because the shell path and compiler name are unavailable, while the source itself compiles with the profile clang toolchain. Treating examples as formal tests would overstate coverage.
affected_scope: Embeddable C or C89 libraries distributed as source plus a standalone shell build script, with no Makefile, configure, CTest, or formal test directory, when adapted to OHOS Conan.
verification_cmd: Use Conan profile compiler_executables for clang, llvm-ar, and llvm-ranlib; build a static package; run a real API consumer test; separately record upstream entrypoint errors and any example probes.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: custom-single-file-c89-static-recipe
rec_description: Classify the recipe as custom, compile the public source with Conan-provided clang using the upstream C89 warning flags plus -fPIC, archive it with llvm-ar and llvm-ranlib, install the public header and library, and add a substantive consumer test that exercises exported API behavior. Keep upstream formal-test count at zero when source inspection confirms there is no test registration mechanism; report examples separately.
rec_command: conan create archives/a/aria/0.1.1 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64 --build=aria/*
rec_auto_fix: false
rec_impl: conan-recipe-and-api-consumer-test

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: upstream-entrypoint-probe-and-explicit-test-inventory
fallback_description: If the upstream script cannot execute on OHOS, run it as-is to capture the concrete shell/compiler error, then use the source compiler path only for a separately identified standalone probe; never count the probe as an upstream formal test.
fallback_command: ./build.sh; sh build.sh; clang aria.c -o aria -DAR_STANDALONE -std=c89 -pedantic -O3
fallback_auto_fix: false
fallback_impl: manual-evidence

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: claiming upstream examples are formal tests
forbid_1_reason: Examples exercise the standalone interpreter but are not registered by an upstream test harness.
forbid_1_consequence: The PR test count and upstream pass rate become misleading.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: P013, P014

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to: E037, E342, E525
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
forbid_2_pattern: replacing the real C compiler failure with a stub or claiming the hard-coded build.sh passed
forbid_2_reason: The OHOS limitation is in the script environment, not evidence that the source or package API is untestable.
forbid_2_consequence: The build evidence would be false or would hide the actual portability boundary.
doc_file: doc/E543.md
last_updated: 2026-09-03
source_event: archives/a/aria/0.1.1/reports/upstream-test-inventory.md and device-validation.md

