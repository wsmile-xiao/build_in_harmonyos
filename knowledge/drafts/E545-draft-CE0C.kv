#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E545.kv，填写各字段
# 对应的人类文档: doc/E545.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E545
trigger_tool: test
phase: testing
error_signature: Segmentation fault|CU_register_suites|CU_SuiteInfo|CU_SetUpFunc|CU_TEST_INFO_NULL|Run Summary.*14

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: testing,compat,abi,ohos
match_keywords:         CU_SuiteInfo, CU_SetUpFunc, CU_register_suites, cunit, Segmentation fault, core dumped, incompatible pointer types, test suite registration, cunit/2.1-3, cunit/2.1-2, 单元测试框架, 段错误
title: cu 单元测试框架大版本 ABI 变更导致测试套件注册期段错误

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 上游测试源码按旧版 CUnit 的 4 字段 CU_SuiteInfo（pName,pInitFunc,pCleanupFunc,pTests）初始化；cunit/2.1-3 在其中间插入 pSetUpFunc/pTearDownFunc，编译期只有 -Wincompatible-pointer-types 警告（CU_TestInfo[] 赋给 CU_SetUpFunc），运行时 pTests 保持 NULL，CU_register_suites 解引用空指针 → 测试二进制刚启动即段错误（core dumped），无任何用例输出。
affected_scope:         所有自带 CUnit 测试套件（make check / ctest 注册 CU_SuiteInfo）的开源库在 OHOS/Conan 适配场景；多版本 cunit 配方（cunit/2.1-2 与 2.1-3 的 CU_SuiteInfo 布局不同）
verification_cmd:       make -C tests check 2>&1 | tail -20   # 期望输出 "Run Summary ... tests 14 14 13 1"；异常时输出 "Segmentation fault (core dumped)"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: 编译期检查 CU_SuiteInfo 结构体字段数：若目标库测试源码使用 4 字段初始化器，必须搭配 cunit/2.1-2（4 字段布局）；2.1-3 及以后需改测试源码为 6/5 字段或使用 CU_SUITE_INFO_NULL 显式补齐。判据：报错行 warning: incompatible pointer types initializing 'CU_SetUpFunc'。验证命令：make -C tests check 应输出 Run Summary tests 行而非 Segmentation fault。
rec_description:        按目标库测试源码的 CU_SuiteInfo 初始化字段数选择 cunit 版本（4 字段→cunit/2.1-2）
rec_command:            可选: 具体命令模板(${VAR}变量引用)
rec_auto_fix:           true|false                  # 引擎能否自动执行
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
