#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E555.kv，填写各字段
# 对应的人类文档: doc/E555.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E555
trigger_tool: clang|test|runtime
phase: testing
error_signature: cvtss_si64_nan|_mm_cvtss_si64|res == indefinite|int64.*NaN

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category: compiler-optimization,testing,ub,platform
match_keywords: NaN, int64, float to int, undefined behavior, clang, aarch64, cvtss, SIMD, NEON, static_cast
title: clang aarch64 下 (int64_t)NaN float→int64 转换在 -O2 为 UB 生成垃圾值

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: sse2neon _mm_cvtss_si64 用 C++ static_cast 将 NaN float 转 int64；(int64_t)NaN 是未定义行为。clang aarch64 -O2 常量折叠/代码生成返回垃圾值（实测 370999932605、543919170456 等，非 0 非 INT64_MIN），-O0 返回 0（上游允许值）；x86 硬件则返回 INT64_MIN（indefinite）
affected_scope: 所有在 aarch64+clang 下做 float→int64 标量转换的 C/C++ 代码（SIMD 翻译库、数值库、图像音频采样转换）
verification_cmd: printf '(int64_t)NaN at -O0/-O2'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 2
rec_approach: 诊断：分别 -O0/-O2 编译同一 NaN 转换复现；-O0 返回 0 而 -O2 返回垃圾值即为命中。处置：涉 NaN float→int64 的业务代码需显式 isnan/isfinite 守卫或使用饱和转换指令；适配库测试失败如实记录为编译器 UB 差异，-O0 通过即满足上游允许语义
rec_description: 涉 NaN→int64 转换必须显式守卫；上游测试失败记录为编译器 UB 差异而非平台缺陷
rec_command: clang++ -O0 -I. -march=armv8-a+fp+simd tests/nan.cpp tests/common.cpp tests/binding.cpp -lm -o /tmp/nan-O0
rec_auto_fix:           false
rec_impl:               manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: 若业务必须复现 x86 indefinite 语义，可用饱和转换指令（vcvtq_s64_f64 族）自行实现 NaN→0/INT64_MIN 映射
fallback_description: 仅当无法通过显式守卫满足语义时使用
fallback_command:
fallback_auto_fix:      false
fallback_impl:          manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

