#====================================================================
# E322-draft-392D — CPMAddPackage 依赖在禁网 CI 下用 SOURCE_DIR 分支本地化
# 触发事件: cxxgraph 4.1.0 适配（task cxxgraph-4.1.0-r01-pc1-14）
#
# 与既有条目的关系（部分覆盖 + 新增差异）:
#   DRAFT-cmake-cpm-addpackage-local-package-offline —— 讲上游已设
#     CPM_USE_LOCAL_PACKAGES ON 时的零 patch 路线（<Pkg>_DIR 指向本地包）。
#     本条目讲上游**未设**该开关时，用 patch 给 CPMAddPackage 增加
#     SOURCE_DIR 分支 + conandata 预下载源码的路线（需维护补丁，但无需
#     CMakeDeps config 生成）。两者同为 CPM 离线场景，解法不同：零 patch
#     vs SOURCE_DIR 分支 patch。crow 的 CATCH2_LOCAL_SOURCE_DIR 是同模式的
#     先例（无独立知识条目）。
#====================================================================

id:                     E322-draft-392D
trigger_tool:           cmake|conan|configure
phase:                  configuration
error_signature:        CPM: error: Failed to download|
                         CPM: Adding package .*\(downloading\)|
                         fatal: unable to access .*CPMAddPackage|
                         Downloading CPM\.cmake.*github\.com|
                         CPM_SOURCE_CACHE.*(not|missing)

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               cmake, network, test, portability
match_keywords:         CPMAddPackage, CPM.cmake, SOURCE_DIR, offline, github, googletest, zlib, CPM_SOURCE_CACHE, test
title:                  上游 CPMAddPackage 依赖在禁网 CI 下无法下载：patch 增加 SOURCE_DIR 本地源分支 + conandata 预下载源码

# ═══ Layer 2: 诊断层 ═══
root_cause:             上游 CMake 项目用 CPM.cmake 拉取测试依赖（googletest/zlib 等），
                         CI worker 无法直连 github.com；且上游未设 CPM_USE_LOCAL_PACKAGES，
                         CPMAddPackage 一律走 GITHUB_REPOSITORY 下载，configure 阶段即失败。
                         顶层 CMakeLists 还可能配置期直连 GitHub 下载 CPM.cmake 引导脚本本身。
affected_scope:         所有用 CPMAddPackage 拉取依赖（尤其测试框架）且无法直连 github.com
                         的 OHOS/CI 交叉编译项目；含 CPM.cmake 引导脚本在线下载的项目。
verification_cmd:       配方内 conan create 成功（configure/build/test 全过）+ 测试日志出现
                         "CPM: Adding package googletest@ (v1.17.0 at <本地路径>)" 而非下载。

# ═══ Layer 3: 方案层 ★ ═══
rec_priority:           1
rec_approach:           cpm-addpackage-source-dir-branch
rec_description:        给上游 CPMAddPackage 增加 if(DEFINED <PKG>_LOCAL_SOURCE_DIR) 本地
                         SOURCE_DIR 分支（保留原 GITHUB_REPOSITORY 回退），配方 generate() 注入
                         cache_variables 指向 build_folder 内 conandata 预下载解压的源码。
rec_command:            CXXGRAPH_GTEST_SOURCE_DIR=${build_folder}/gtest_src CXXGRAPH_ZLIB_SOURCE_DIR=${build_folder}/zlib_src
rec_auto_fix:           false
rec_impl:               manual-recipe-edit

# 回退方案
fallback_priority:      2
fallback_approach:      cpm-use-local-packages
fallback_description:   若上游已设 CPM_USE_LOCAL_PACKAGES ON：零 patch，用 <Pkg>_DIR 指向
                         包内 config（见 DRAFT-cmake-cpm-addpackage-local-package-offline）。
fallback_command:       CPM_USE_LOCAL_PACKAGES=<Pkg>_DIR
fallback_auto_fix:      false
fallback_impl:          manual-recipe-edit

# ★ 禁止策略 ★
forbid_1_pattern:       gh-proxy\.com|ghfast\.top
forbid_1_reason:        PF7 源 URL 闸禁镜像域名（R39）；conandata.yml 必须官方 HTTPS 源
forbid_1_consequence:   CI 硬闸拦截，PR 无法合入；本地缓存回填 GH 直连失败
forbid_2_pattern:       file://|/storage/Users/currentUser|currentUser
forbid_2_reason:        禁止本地目录/执行端绝对路径污染 conandata（任务明确禁止）
forbid_2_consequence:   JC1/JC5 拦截 + 审计 P0

# ═══ Layer 4: 原则引用 ═══
principles:             P001, P005

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             [DRAFT-cmake-cpm-addpackage-local-package-offline, E017]
conflicts_with:         []
prerequisite_of:        []

