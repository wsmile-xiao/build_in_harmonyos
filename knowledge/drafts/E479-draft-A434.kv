#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E479.kv，填写各字段
# 对应的人类文档: doc/E479.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E479
trigger_tool: llvm-objcopy|binary-sign-tool|conan|cmake
phase: packaging|runtime|testing
error_signature: Operation not permitted.*(XaoS|lrelease)|(?:XaoS|lrelease): Operation not permitted|\.codesign section already exists

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform, compat, ohos, build-system
match_keywords: .codesign, binary-sign-tool, llvm-objcopy, Operation not permitted, QtTools, HarmonyOS
title: Re-sign HarmonyOS executables after their final content change

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: HarmonyOS may reject an ELF with Operation not permitted when its .codesign data is stale or invalid, even when the section exists and execute permissions are present. CMake installation or RPATH rewriting can invalidate a freshly linked application signature, while a Qt host tool from Conan cache can also be denied at exec time. Re-sign only a build-local copy of dependency tools, then re-sign the installed application after the last install-time mutation.
affected_scope: HarmonyOS native Conan packages that execute Qt host tools during build or install executable ELFs whose bytes or RPATH may change after linking.
verification_cmd: On an OHOS aarch64 device, run llvm-objcopy --remove-section .codesign <ELF>; binary-sign-tool sign -inFile <ELF> -outFile <ELF>.signed -selfSign 1; preserve executable mode and replace the ELF; then execute a real workload and inspect its output.

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: resign-elf-after-final-content-mutation
rec_description: On OHOS, create a private signed copy of any Conan-cached Qt host tool whose execution is denied, without modifying the immutable dependency cache. After CMake install has finalized the application binary and its RPATH, remove the old .codesign section, self-sign the installed ELF, preserve executable permissions, and replace it atomically. Confirm the tool launches and validate the application's real output on device.
rec_command: llvm-objcopy --remove-section .codesign <private-ELF> && binary-sign-tool sign -inFile <private-ELF> -outFile <private-ELF>.signed -selfSign 1 && chmod 0750 <private-ELF>.signed && mv <private-ELF>.signed <private-ELF>
rec_auto_fix: false
rec_impl: recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: rebuild-the-tool-with-a-valid-ohos-signature
fallback_description: If the platform signing tools are unavailable, rebuild or select a Qt tool package whose installed ELF passes actual execution on the target device; do not bypass the kernel execution check.
fallback_command:
fallback_auto_fix: false
fallback_impl: manual

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: chmod.*0755|chmod.*\+x
forbid_1_reason: Changing mode bits does not repair invalid HarmonyOS ELF signature data and does not resolve Operation not permitted.
forbid_1_consequence: The binary remains unexecutable despite appearing executable in ls output.
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
forbid_2_pattern: modify.*\.conan2|rewrite.*Conan cache
forbid_2_reason: Do not repair an immutable dependency package in place; the build must be reproducible from the recipe.
forbid_2_consequence: Local cache mutation hides the issue and produces a non-reproducible package.
doc_file: knowledge/drafts/E479-draft-A434.md
last_updated: 2026-10-11
source_event: XaoS 4.3.4 real HarmonyOS 6.0 aarch64 Conan build and render test, 2026-10-11

