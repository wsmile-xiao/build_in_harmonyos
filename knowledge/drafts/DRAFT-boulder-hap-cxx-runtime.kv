#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E088.kv，填写各字段
# 对应的人类文档: doc/E088.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E088
trigger_tool: conan|cmake|hvigor|HAP|NAPI
phase: packaging|runtime
error_signature: load libc++_shared.so failed, namespace=ndk no inherits|namespace=moduleNs_default|Error loading shared library libc++_shared.so

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: packaging, runtime, linking, ohos
match_keywords: Conan, HAP, ArkUI, NAPI, libc++_shared.so, moduleNs_default, ndk no inherits, SDK, NOTICE, arm64-v8a, SHF_ALLOC
title: Conan 预编译 C++ 模块进入 HAP 后的 SDK 运行库装载契约（E088 扩展）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Conan shell 消费者与 HAP 应用的动态链接命名空间不同；预编译工程仅复制业务模块时遗漏动态 SDK C++ 运行库，系统同名库存在并不能证明应用可见。
affected_scope: OHOS/HarmonyOS aarch64 上将 Conan 预编译 C++ 模块集成到 ArkUI HAP 的项目；Boulder 1.02 两模块和 SDK 26.0.0.18 已验证。
verification_cmd: llvm-readelf -d libboulderhost.so；核查最终 HAP libs/arm64-v8a 后安装并进入原生游戏/编辑器；见随附可复现步骤和证据报告。

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: package-matching-sdk-runtime-in-hap-private-libs
rec_description: 定位实际消费者和 NEEDED；从实际 C++ 编译器查询匹配 SDK libc++_shared.so，校验路径存在；安装到 HAP 工程目标 ABI 私有库目录并保留 SDK NOTICE；消费者检查包内容，最终 HAP 实机调用原生功能，并比较 strip 前后的 ELF 分配节。
rec_command: 详见配套 Markdown 中 CMake 片段与 HAP 验证命令。
rec_auto_fix: false
rec_impl: manual-runner-path

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
