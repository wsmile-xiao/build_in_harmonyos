#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E545.kv，填写各字段
# 对应的人类文档: doc/E545.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E545
trigger_tool: runtime|test|ld
phase: runtime|testing|linking
error_signature: undefined symbol:.*|dlopen.*failed.*undefined symbol|Error relocating.*symbol not found|RTLD_NOW.*undefined

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform, compat, libc
match_keywords: undefined symbol, dlopen, RTLD_NOW, plugin module, symbol shim, musl lazy binding, module_exports
title: kamailio core 插件独立打包：dlopen 需消费者进程提供 core 符号 shim（musl 无惰性绑定）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 共享模块（如 kamailio 模块 debugger.so）不把宿主程序本体写进 DT_NEEDED，其引用的宿主符号只在 dlopen 时解析；OHOS/musl 无惰性绑定（RTLD_LAZY 等价 RTLD_NOW），因此宿主符号缺失时 dlopen 立即失败，而不是等到首次调用才失败
affected_scope: 各类"插件式"生态的模块包：kamailio 模块、apache/nginx 模块、GStreamer 插件、PAM 模块等（模块自身无外部库依赖、符号面由宿主提供）
verification_cmd: llvm-nm -u <module>.so | wc -l  # 列出模块未定义符号；llvm-readelf -d <module>.so | grep NEEDED  # 确认未 NEEDED 宿主本体

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: consumer-shim-export-dynamic
rec_description: 在 test_package 里实现消费者进程：提供宿主未定义符号的 shim（含全局量与函数），用 -Wl,--export-dynamic 链接使 shim 进入动态符号表，再 dlopen 模块并真实调用其入口（dlsym 取导出表 → init → child_init），含负例
rec_command: clang test_package/shim.c test_package/e2e.c -Wl,--export-dynamic -ldl -o e2e && ./e2e <module>.so
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: 只做 ELF 魔数/架构断言即宣称模块可用
forbid_1_reason: ELF 断言无法证明模块能被宿主加载：符号面缺失的模块同样能通过 ELF 检查
forbid_1_consequence: 空壳测试，模块真实不可用却报成功（R34 风险）
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

