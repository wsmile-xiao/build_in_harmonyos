#====================================================================
# E330 — CMake 未知平台（HarmonyOS）共享库无 SONAME
# 来源: libiio 0.25 适配 (PR #8323, 2404_87638649, 2026-09-05)
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
trigger_tool:           ld|cmake|runtime
phase:                  linking|runtime
error_signature:        Error loading shared library \.\./lib[A-Za-z0-9_-]+\.so|Error relocating .*: symbol not found \(needed by \./bin/\w+\)

# ═══ Layer 1: 根因 (Root Cause) ═══
error_excerpt:          Error loading shared library ../libiio.so: (needed by .../bin/iio_info) / Error relocating .../bin/iio_info: iio_context_get_name: symbol not found
root_cause:             CMake 对未识别的 CMAKE_SYSTEM_NAME（HarmonyOS 无 Platform/HarmonyOS 模块）不定义 CMAKE_SHARED_LIBRARY_SONAME_FLAG，libiio.so 被链接为无 SONAME 的共享库；下游可执行文件在构建树内链接时把构建树相对路径（../libiio.so）写入 DT_NEEDED，安装到布局（bin/ + lib/）后加载器按该相对路径查找必然失败
failure_mode:           链接期成功但运行期符号重定位失败——工具二进制在包目录里执行报 "Error loading shared library ../libXXX.so" + 全部导出符号 not found
os_affected:            OHOS
component:              构建系统|链接器
kb_category:            build-system

# ═══ Layer 2: 处方 (Prescription) ═══
rec_approach:           conanfile.py generate() 里用 CMakeToolchain 的 extra_sharedlinkflags 注入 unversioned SONAME：tc.extra_sharedlinkflags.append("-Wl,-soname,libXXX.so")（包内只有一个共享库时安全）。修复后 readelf -d libXXX.so 应出现 SONAME 条目、工具 DT_NEEDED 变为裸 "libXXX.so"，可由运行时库路径解析
auto_fix:               false
rec_command:            tc.extra_sharedlinkflags.append("-Wl,-soname,libiio.so") && conan create ... && readelf -d $(find ~/.conan2/p -name libiio.so | head -1) | grep -i soname
verify_command:         readelf -d <pkg>/lib/libXXX.so | grep SONAME && readelf -d <pkg>/bin/<tool> | grep NEEDED
fallback:               若包内多个共享库需分别命名，可给 CMake 加 set(CMAKE_SHARED_LIBRARY_SONAME_FLAG "-Wl,-soname") 并逐 target 设 SONAME 属性；或在上游 CMakeLists 补 set_target_properties(... PROPERTIES ...)

# ═══ Layer 3: 关联 (Context) ═══
related_errors:         E120|E132
related_docs:           knowledge/operations/build-systems.md
prescan_pattern:        CMAKE_SYSTEM_NAME MATCHES \"Linux\"
match_keywords:         soname,dt_needed,unknown platform,HarmonyOS cmake,shared library soname,../lib
source_package:         libiio/0.25
severity:               medium
category:               build-system
platform:               ohos
last_updated:           2026-09-05
