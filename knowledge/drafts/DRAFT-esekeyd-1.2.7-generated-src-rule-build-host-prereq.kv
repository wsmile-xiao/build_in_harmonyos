#====================================================================
# Draft knowledge entry - autotools generated-source rule depends on a
# build-host absolute path (/usr/include/linux/input.h) and is timestamp
# sensitive; tarball ships the pre-generated file -> drop the rule.
# Custom rules using $(SOURCES) as compile input break VPATH -> use $<.
# Source package: esekeyd/1.2.7
#====================================================================

id:                     DRAFT-esekeyd-1.2.7-generated-src-rule-build-host-prereq
trigger_tool:           make|configure
phase:                  build
error_signature:        No rule to make target '/usr/include/linux/input.h'|no such file or directory: 'mkparser.c'|\.\/mkparser /usr/include

severity:               2
category:               build-system|autotools|portability
match_keywords:         parser.c, generated source, 生成源文件, mkparser, /usr/include/linux/input.h, No rule to make target, VPATH, $(SOURCES), $<, CC_FOR_BUILD, automake custom rule, out-of-source, timestamp, 时间戳敏感, pre-generated, 预生成, Makefile.am, Makefile.in, esekeyd

title:                  autotools 生成源文件规则依赖构建机绝对路径且时间戳敏感（esekeyd parser.c）：tarball 已含预生成结果时直接删规则；自定义规则 VPATH 需 $< 而非 $(SOURCES)

root_cause:             >
    esekeyd 的 src/Makefile.am 把生成源文件 parser.c 声明为
    "parser.c: mkparser /usr/include/linux/input.h" 的规则产物：
    (1) 前提是构建机绝对路径，容器/交叉/OHOS 环境无此文件时 make 直接
    "No rule to make target '/usr/include/linux/input.h'"；
    (2) 规则时间戳敏感——tarball 内 parser.c mtime 为 2010 发布时间，
    现代内核头永远更新，make 每次都尝试运行 host 工具 mkparser 重建，
    交叉时 CC_FOR_BUILD 探测 gcc/cc（OHOS 无 gcc）失败。而发布 tarball
    本就自带预生成 parser.c，重建既不必要也不可行，正确解法是删除该
    规则（Makefile.am 与预生成 Makefile.in 必须两处同步删）。同族：
    自定义规则 "mkparser: $(mkparser_SOURCES)" 以 $(SOURCES) 作编译
    输入，VPATH（out-of-source）下编译器不解析 VPATH（只有 make 自动
    变量 $< $^ 会被重写为解析后路径），报 no such file: 'mkparser.c'，
    需改为 $<。Conan Autotools 默认 out-of-source，命中概率高。

affected_scope:         所有把生成源文件（parser/表驱动代码）声明为依赖
                        构建机文件之规则、且 tarball 已含预生成结果的
                        autotools 包；以及自定义规则用 $(SOURCES)/裸文件名
                        作编译输入的包（automake 自身规则用 $< 不受影响）。

verification_cmd:       |
  # 本机：干净解压 tarball
  git apply --check patches/0001-makefile-vpath-and-no-parser-regen.patch
  git apply patches/0001-... && grep -c 'parser.c: mkparser /usr/include' src/Makefile.am src/Makefile.in
  # 期望：0 0（两处规则均已删除）
  # 交叉编译 6 个 .c 全过 + 3 程序链接 AArch64 ELF（esekeyd/1.2.7 实测）
  # 反向复现（未打补丁）：VPATH 构建下 make 报 mkparser.c not found /
  # No rule to make target /usr/include/linux/input.h

rec_priority:           1
rec_approach:           drop-rule-plus-vpath-autovar
rec_description:        >
    补丁同步删除 Makefile.am 与预生成 Makefile.in 中的生成规则两行
    （保留 mkparser 的 noinst 构建——它是 mkparser.c 可编译性的免费回归
    验证），并把自定义规则的 $(mkparser_SOURCES) 改为 $<。不改配方、
    不 touch 时间戳、不引入对构建机内核头的依赖。
rec_command:            |
  # 补丁内容（.am 与 .in 各一处）：
  -parser.c: mkparser /usr/include/linux/input.h
  -	./mkparser /usr/include/linux/input.h > parser.c
   以及
  -	$(CC_FOR_BUILD) -o $@ $(mkparser_SOURCES)
  +	$(CC_FOR_BUILD) -o $@ $<
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      recipe-touch-prereq
fallback_description:   >
    在配方 build() 里 touch parser.c 或先构建 mkparser 再改 mtime——不
    推荐：脆弱（依赖解包顺序与系统头 mtime），且 Makefile.in 的绝对路径
    前提仍会让 make 报 No rule to make target，未除根因。
fallback_command:       ""
fallback_auto_fix:      false
fallback_impl:          conanfile-edit

# ★ 禁止策略 ★
forbid_1_pattern:       touch\s+parser\.c   # 用 touch 糊时间戳
forbid_1_reason:        未删除规则时绝对路径前提仍在，make 依旧报 No rule to make target；时间序依赖系统头 mtime。
forbid_1_consequence:   交叉/容器构建随机失败，且失败点在 make 而非编译，难定位。

forbid_2_pattern:       ^-.*Makefile\.am(?!.*Makefile\.in)   # 只删 .am 不同步 .in
forbid_2_reason:        该包不运行 automake，configure 实际读取的是预生成 Makefile.in；只改 .am 不生效。
forbid_2_consequence:   补丁"已打但无效"，真机构建仍触发原规则。

# Relations
similar_to:             DRAFT-riemann-c-client-1.10.4-pre-generated-sources
caused_by:              ""
prerequisite_of:        ""
conflicts_with:         ""
complement:             E041, E069, E037, E049, E392

# Provenance
source_package:         esekeyd/1.2.7
source_event:           esekeyd 1.2.7 first OHOS adaptation (2026-09-29)
authors:                esekeyd 适配会话（worktree feat/esekeyd-1.2.7-codex）
