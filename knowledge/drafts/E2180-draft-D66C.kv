#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E2180.kv，填写各字段
# 对应的人类文档: doc/E2180.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E2180
trigger_tool:           conan|make
phase:                  compilation
error_signature: Error -11 while executing|conanbuild.*self.sourcing|SIGSEGV.*self\.run.*make|build failed.*无编译输出.*Error -11

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan,env,makefile
match_keywords:         conanbuild, save_script, SIGSEGV, self-source, Error -11, env script
title: Conan 自定义 env 脚本命名为 conanbuild 与聚合启动器自引用导致 build 子进程 SIGSEGV(Error -11)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: conanfile.generate() 中 save_script("conanbuild") 与 Conan 自身聚合启动脚本同名,聚合器写出的 conanbuild.sh 内容为 source 自身,执行时无限递归栈溢出,build 子进程信号 11 死亡且无编译输出
affected_scope:         在 generate() 中用 save_script 注入 env 并在 build() 里 source 脚本启动 make 的 conanfile 配方(chiark-utils 8.0.1 实测;conanrun 同名同理)
verification_cmd:       grep -n save_script conanfile.py; 手动 source conanbuild.sh 复现 shell 立即被信号 11 杀死

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach: no-custom-conanbuild-script
rec_description: 禁止把自定义 env 脚本命名为 conanbuild;向裸 Makefile 传编译器/标志时在 build() 里从 self.conf 读出后直接拼进 self.run 命令行,跳过 env 脚本层
rec_command:            self.run('make CC=%s CMDLINE_CPPFLAGS=<聚合include> CMDLINE_LDFLAGS=<聚合lib>' % self.conf.get('tools.build:compiler_executables'))
rec_auto_fix:           false
rec_impl:               manual-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      rename-env-script
fallback_description:   将自定义 env 脚本改为非保留名(如 myenv.sh)并在 build() 显式 source;需自查 conanbuild/conanrun 全部保留名避免再撞名
fallback_command:       env.vars(self).save_script('myenv') + self.run('. ./myenv.sh && make')
fallback_auto_fix:      false
fallback_impl:          manual-patch

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E2180.md
last_updated: 2026-09-08
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
metrics_confidence:     0.0
metrics_last_used:

