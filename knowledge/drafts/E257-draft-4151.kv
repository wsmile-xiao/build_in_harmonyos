#====================================================================
# E257-draft-4151
# Single-module Python bootstrap dependencies without build-backend execution
#====================================================================

id:                     E257-draft-4151
trigger_tool:           python|setuptools|pip|conan|runtime
phase:                  packaging|installation|testing|runtime
error_signature:        "ModuleNotFoundError: No module named ['\"]six['\"]|setuptools.*(requires|depends on).*six"
severity:               2
category:               python|single-module|bootstrap-dependency|conan|packaging|OHOS
match_keywords:         six.py, py_modules, single-module Python, setuptools,
                         bootstrap dependency, direct module copy, site-packages,
                         PYTHONPATH, package metadata, VirtualRunEnv, L1e
title:                  Directly package a verified single-module Python bootstrap dependency without invoking its build backend

root_cause: >
  A bottom-level Python compatibility module can be needed by the packaging
  toolchain itself. Invoking pip or setuptools to package that module adds a
  build-backend bootstrap dependency even when upstream declares one importable
  py_modules payload and the installed runtime needs no generated files,
  package data, entry points, native extensions, or distribution metadata.
  Copying arbitrary Python projects is not equivalent: direct installation is
  valid only after the upstream metadata and complete payload are audited.
affected_scope: >
  Pure-Python distributions whose audited upstream metadata declares exactly
  one top-level module and whose runtime behavior does not depend on wheel
  generation, package data, entry points, namespace packages, native
  extensions, generated sources, or importlib.metadata distribution records.
verification_cmd: >
  Inspect upstream setup metadata for py_modules and excluded install features;
  compile the module source; verify the declared version; run the unmodified
  upstream suite; import through Conan VirtualRunEnv; assert module.__file__ is
  inside the package; then remove package lib/ and require the consumer to fail.

rec_priority:           1
rec_approach:           audited-single-module-direct-install
rec_description: >
  Treat direct installation as an audited packaging implementation, not a
  shortcut. Prove the complete importable payload is one module, copy that exact
  module into lib/python/site-packages, export the location through Conan
  runenv_info, and validate syntax, version, public APIs, resolved module path,
  the unmodified upstream suite, and an L1e destructive negative run. Preserve
  the license separately and record every omitted build-backend feature.
rec_command:            CI_PACKAGES="archives/s/six/1.17.0" zsh ci/conan/build_and_test.sh
rec_auto_fix:           false
rec_impl:               conan-audited-single-module-copy

fallback_priority:      2
fallback_approach:      build-wheel-with-isolated-tools
fallback_description: >
  If any audit condition fails, use the upstream build backend in a separately
  provisioned build context, build a wheel without resolving runtime
  dependencies, and install the wheel payload. Do not silently discard metadata
  or generated artifacts.
fallback_command:       python -m pip wheel --no-deps --no-build-isolation .
fallback_auto_fix:      false
fallback_impl:          python-wheel-packaging

forbid_1_pattern:       copy\(.*["']\*\.py["']|copy.*source.*site-packages
forbid_1_reason:        A wildcard source copy does not prove equivalence to the upstream install manifest.
forbid_1_consequence:   Package data, entry points, generated files, namespace modules, or metadata can be silently omitted.

forbid_2_pattern:       skip.*(upstream|consumer).*test|assert.*__version__.*only
forbid_2_reason:        A version string alone proves neither API behavior nor that the consumer imported the Conan payload.
forbid_2_consequence:   An ambient module or incomplete payload can produce a false-positive package result.

forbid_3_pattern:       direct.*copy.*(package_data|entry_points|extension|namespace|importlib.metadata)
forbid_3_reason:        These install features require wheel/build-backend semantics or an explicitly equivalent implementation.
forbid_3_consequence:   Runtime behavior differs from the upstream distribution despite a successful import.

principles:
