id: "E717"
trigger_tool: "conan|configure|make"
phase: "configure|build"
error_signature: "invalid host type|can only configure for one host|invalid option; use --help|autoconf version 2\\.13"
severity: !!int "2"
category: "build-system-autotools"
match_keywords: "opt 3.19, autoconf 2.13, bundled configure, autoreconf, invalid host type, invalid option, datarootdir, CFLAGS, CXXFLAGS, CXX=g++, AC_SUBST, make line override, automake 1.4-p5, DESTDIR, config.sub, config.guess"
title: "Bundled autoconf 2.13 configure rejects command-line VAR=value and --datarootdir, and configure.in's literal CXX=g++ survives AC_SUBST — pin flags via environment prefix + make line, override CXX on the make line, never autoreconf"
root_cause: "The bundled configure was generated by autoconf 2.13: its argument parser treats VAR=value words as host types (warning: invalid host type -> error: can only configure for one host and one target, rc=1) and does not know --datarootdir (added in 2.60), so Conan AutotoolsToolchain's default configure args and the modern './configure CFLAGS=...' idiom both fail hard; separately configure.in ends with a literal 'CXX=g++' plus AC_SUBST(CXX) which bakes 'CXX = g++' into every generated Makefile, so passing CXX at configure time only satisfies AC_PROG_CXX and the build still dies with 'g++: No such file or directory'."
affected_scope: "Any pre-2006 autotools project whose shipped configure says 'Generated automatically using autoconf version 2.13' (often with no config.sub/config.guess because AC_CANONICAL_HOST is absent); any recipe that copies modern configure-argument idioms or relies on AutotoolsToolchain defaults for such projects."
verification_cmd: "sh -c 'd=\"$HOME/tmp/opt-3.19/w0\"; rm -rf \"$d/repro-e717\"; mkdir -p \"$d/repro-e717/b\" \"$d/repro-e717/home\"; tar -xzf \"$d/dl/c1.tar.gz\" -C \"$d/repro-e717\"; cd \"$d/repro-e717/b\"; HOME=\"$d/repro-e717/home\" CC=/data/service/hnp/bin/clang ../opt-3.19.orig/configure --prefix=/ \"CFLAGS=-O3\"; echo rc=$?'"
rec_priority: !!int "1"
rec_approach: "env-prefix-plus-make-line-double-pin-never-autoreconf"
rec_description: "Do not run autoreconf. Invoke the bundled configure yourself: 'umask 022 && CC=... CXX=... CFLAGS=... CXXFLAGS=... <src>/configure --prefix=/', because 2.13 reads flags from the environment only and rejects VAR=value arguments and --datarootdir (so skip Autotools.configure()). Pin the same flags again on the make line (autotools.make(args=['-j1','CXX=clang++','CFLAGS=...','CXXFLAGS=...'])) and use that same make-line override to defeat the baked-in 'CXX = g++' from configure.in's literal CXX=g++. Verify rc=0 by counting AC_OUTPUT products (Makefile, src/Makefile, test/Makefile, ext/Makefile, opt.spec) before make, and count the installed tree afterwards (automake 1.4-p5 does support DESTDIR)."
rec_command: "grep -n '^CFLAGS = \\|^CXX = ' <build>/src/Makefile  # after configure: pinned flags, then make line overrides CXX"
rec_auto_fix: !!bool "false"
