#====================================================================
# DRAFT-iowow-1.5.2-autark-build-system-ohos-adaptation
#   Autark（build.sh 包装器）构建系统在 OHOS 上的 Conan 配方适配：
#   -j→-J 参数、/bin install 工具 PATH、lib64 安装目录、直接调用 build.sh
# 来源: iowow 1.5.2 适配 HarmonyOS PC（PR 关联）
# 路径: Path B（知识库扩展）
# 状态: 草稿（待审核 promote）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-iowow-1.5.2-autark-build-system-ohos-adaptation
trigger_tool:           build.sh|autark|conan|make
phase:                  configuration|compilation|packaging

error_signature:        required tool 'install' not found in PATH|
                        Library '[A-Za-z0-9_]+' not found in package|
                        autark.*-j.*usage|^usage: autark|
                        build\.sh.*-j|AUTARK_HOME|\.autark/system\.sh

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, autark, conan, packaging, custom-build
match_keywords:         autark, build.sh, build.sh wrapper, -J jobs, -j invalid,
                        install tool, /bin, PATH, lib64, lib dir, package(),
                        CMakeDeps not found, Autark, Softmotions, iowow,
                        custom build system, OHOS, conanfile
title:                  Autark（build.sh 包装器）项目 OHOS 适配：直接调 build.sh（-J 并行、/bin 补 PATH、package() 兼容 lib64/lib）
prescan_pattern:        (^|/)build\.sh$|\.autark/(system|test_|fetch_resource)\.sh
prescan_globs:          build.sh, .autark/*.sh, **/build.sh

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Autark 是自研构建系统（顶层 build.sh 内嵌 amalgamated autark.c +
                        .autark/ 探测脚本），不是 autotools/cmake：init-build 按 URL 猜
                        构建系统会误判；autark 并行参数是 -J<N> 而非 -j（-j 打印 usage 退出）；
                        system.sh check_tool install 硬性要求 install 工具（在 /bin，
                        构建机默认 PATH 无 /bin 时失败）；64 位目标安装产物落 --prefix/lib64/
                        而非 lib/，Conan package() 只拷 lib/ 会缺库。

affected_scope:         使用 Softmotions Autark 构建的 C/C++ 库（iowow 及其生态）在
                        OHOS/Conan 环境下的配方适配；任何默认 PATH 缺 /bin 的构建机
                        上跑 build.sh 的项目。

# ═══ Layer 3: 方案层 (Solution) ═══
rec_priority:           1
rec_approach:           direct-build-sh-invocation
rec_description:        conanfile.py 不用 autotools 模板，直接以 subprocess 调用
                        ./build.sh --prefix=<build_folder>/stage -J1，编译器按 R33
                        从 self.conf tools.build:compiler_executables 读取（不裸用
                        ${CC}）；PATH 显式前置 /bin（install 工具）；package() 对
                        lib64/ 与 lib/ 都尝试拷贝静态库与 .pc；测试经
                        IOWOW_RUN_TESTS=1 触发（等价 make check）。
rec_command:            self.run("CC=<cc> BUILD_TYPE=Release ./build.sh --prefix=<stage> -J1", cwd=self.source_folder)
rec_auto_fix:           false
rec_impl:               manual

# ═══ 验证与边界 ═══
verification_cmd:       conan-verify（G2 conan create 干净构建）+ test_package 消费者用例
verification_result:    G2 PASS；消费者 1/1 Passed；上游 78/78 用例通过
valid_boundary:         顶层 build.sh + .autark/ 探测脚本的 Autark 项目；
                        Makefile 再包一层 make -j 的混合项目无 -j 参数陷阱
similar_to:             E531（同 OHOS musl 缺 qsort_r 根因，但 E531 为链接期 shim 补丁方案；
                        本条目为 Autark 探测脚本预期失败 + 库自带 sort_r.h 自动回退，
                        探针失败不是构建失败信号——边界差异）
prerequisite_of:
conflicts_with:

last_updated:           2026-09-21
authors:                pc1-24
