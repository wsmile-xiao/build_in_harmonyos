#====================================================================
# DRAFT - ohpcd 无独立 libudev 包，须由提供者（eudev/systemd）以
#         pkg_config_name = libudev 冒充；上游硬要求 dependency('libudev') 且无 fallback
# 最终编号由知识库主编确认
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-LIBUDEV-PROVIDER-IS-EUDEV
trigger_tool:           meson|conan|pkg-config|configure
phase:                  configuration
error_signature:        Dependency "libudev" not found|libudev.*not found|dependency\('libudev'\)|pkg-config.*libudev.*not found

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, detection, adaptation
match_keywords:         libudev, eudev, systemd, udev, pkg_config_name, pkg-config, meson dependency, provided capability, package name vs module name, ohpcd, no fallback, hard requirement, provider conflict
title:                  ohpcd/本仓没有名为 libudev 的包 —— 它是 pkg-config 的**能力名**，须由提供者（eudev 或 systemd，其配方把 pkg_config_name 设为 libudev）满足；conan 侧 require 写提供者包名，meson 侧探测名保持 libudev

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             libudev 是**能力名**（pkg-config 模块名）而非**包名**。历史上由 systemd 提供，现亦可由 eudev 提供；两者都安装 libudev.pc，故 pkg-config --exists libudev 成立，但仓库里并没有叫 libudev 的 conan 包（ohpcd 实查 0 条）。上游 meson.build 常写死 dependency('libudev') 且无 fallback（libinput 1.26.2 meson.build:146 即如此），于是「conan 依赖名」与「meson 探测名」不一致，configure 期报 Dependency "libudev" not found。
affected_scope:         所有以 libudev 为依赖的库（libinput、weston、libwacom、systemd 系组件等）在无独立 libudev 包的环境下适配时；通用模式——能力名与包名不是一回事（同类如 libintl/gettext、libcrypto/openssl）。
verification_cmd:       conan search 'libudev/*' -r=ohpcd; pkg-config --exists libudev && echo OK; grep -n "dependency('libudev')" <src>/meson.build

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           require-provider-package-and-expose-pc-module
rec_description:        conan 侧 require **提供者包**（优先 eudev/3.2.14，轻量且不带整个 systemd），并确保其 .pc 可被 meson 找到（PKG_CONFIG_PATH 或 PkgConfigDeps）；meson 侧探测名**保持** dependency('libudev') 不改写上游。
rec_command:            self.requires("eudev/3.2.14")  # 并确认 pkg-config --exists libudev 返回 0
rec_auto_fix:           false
rec_impl:               conanfile.py::requirements

fallback_priority:      2
fallback_approach:      use-systemd-as-provider
fallback_description:   若该图已因其它依赖引入 systemd，可直接用 systemd/261 作为 libudev 提供者；但会显著增大依赖面（systemd 会带进更多组件），仅在不得已时使用。
fallback_command:       self.requires("systemd/261")
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       dependency\('eudev'\)|rewrite.*meson.*libudev.*eudev|self\.requires\(["']libudev
forbid_1_reason:        把上游探测名改写成 eudev 会让配方绑死单一提供者且偏离上游；直接 require libudev 则 conan 找不到该 ref。
forbid_1_consequence:   上游后续若改用 systemd 提供者即失效；或 conan 解析期直接报无此包。

principles:

