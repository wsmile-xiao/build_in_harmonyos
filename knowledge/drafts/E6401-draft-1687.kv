#====================================================================
# E6401-draft-1687.kv — 旧式 C 测试程序 char 承接 getopt() 返回值
# 草稿（待主编审核转正为 E6401.kv）
# 对应的人类文档: knowledge/drafts/E6401-draft-1687.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E6401
trigger_tool:           test|make|conan
phase:                  testing
error_signature:        Failed with: Invalid parameter|testsuite.*Invalid parameter|Invalid parameter

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               testing, portability, ohos, libc, autotools
match_keywords:         Failed with: Invalid parameter, Usage:, testsuite, getopt, char c, EOF, int c, EXTRA_PROGRAMS, check_PROGRAMS, 测试程序退出, 用例未执行
title:                  旧式 C 测试程序用 `char` 承接 getopt() 返回值 → OHOS aarch64 上 EOF 哨兵截断失效，测试程序直接退出（`Failed with: Invalid parameter`），整轮用例 0 执行

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             测试程序里写 `char c; while ((c = getopt(argc, argv, "...")) != EOF)`：
                        在 OHOS aarch64 上该赋值把 getopt() 的 int 返回值截断到 char，
                        EOF(-1) 经 char 往返后不再与 EOF 比较相等（平台 char 有效宽度/符号性使
                        "结束"哨兵失效），循环永不终止、直接落入 `default:` 分支 → 打印 usage()
                        后 fatal("Invalid parameter") 退出。现象是"上游有测试程序，但一条用例都没跑"，
                        极易被误判成"上游无测试"。
affected_scope:         旧式 C 工程（autotools 的 EXTRA_PROGRAMS / check_PROGRAMS 手工构建的
                        test harness、独立 test 二进制）中凡以 char 承接 getopt() 返回值的；
                        在 OHOS aarch64 上必现；其它平台因 char 的符号性/宽度不同可能偶然正常，
                        故上游不会发现该缺陷。
verification_cmd:       grep -n 'char c;' utils/testsuite.c ;
                        <test-binary> -a ; echo "rc=$?"   # 修复前打印 Usage + Failed with: Invalid parameter

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           use-int-for-getopt-return
rec_description:        在 patches/ 中把承接 getopt() 返回值的 `char` 改为 `int`（getopt 规范返回 int）。
                        仅改局部变量类型，不改测试输入、断言与判定标准，属最小平台适配。
rec_command:            sed -i 's/^\([[:space:]]*\)char c;/\1int c;/' <test>.c   # 建议以 patches/000N-*.patch 固化，便于审计
rec_auto_fix:           false
rec_impl:               source-patch

fallback_priority:      2
fallback_approach:      declare-not-run-and-cover-by-consumer-test
fallback_description:   若审阅口径禁止改动上游测试源，禁止伪造通过：应如实申报该 harness 未运行
                        （0 执行），并以 test_package 消费者测试覆盖被测包功能，在 PR 中写明差异。
fallback_command:
fallback_auto_fix:      false
fallback_impl:          conan-recipe

forbid_1_pattern:       char[[:space:]]+[a-zA-Z_][a-zA-Z0-9_]*[[:space:]]*;
forbid_1_reason:        继续用 char 承接 getopt() 返回值，在 OHOS aarch64 上必然导致整轮用例不执行。
forbid_1_consequence:   上游测试统计失真（0 执行却宣称已有测试覆盖），PR 会被 R51 判 P1。
forbid_2_pattern:       Failed with: Invalid parameter
forbid_2_reason:        该输出是测试程序参数解析崩溃，不是测试通过。
forbid_2_consequence:   把崩溃当通过 = 伪造测试结论（P0）。

