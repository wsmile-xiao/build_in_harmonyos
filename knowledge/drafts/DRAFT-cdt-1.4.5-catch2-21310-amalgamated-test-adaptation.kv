#====================================================================
# DRAFT-cdt-1.4.5-catch2-21310-amalgamated-test-adaptation - 制品仓 catch2
# v2.13 合并头布局下的上游 Catch2 v3 多头测试适配
#
# 场景: cdt 1.4.5 (artem-ogre/CDT, header-only, CMake) OHOS armv8 适配。
#       上游测试 tests/cdt.test.cpp include 5 个 catch2 v3 多头路径头
#       (catch2/benchmark/catch_benchmark.hpp 等)，CMakeLists 用
#       find_package(Catch2 3 QUIET) 且链 Catch2::Catch2WithMain +
#       include(Catch)/catch_discover_tests；制品仓已发布 catch2/2.13.10-r0
#       （v2.13 合并头 catch.hpp 单头布局 + 4 个 reporter 头），
#       上游标注的 catch2/3.4.0 未发布。
#
# 适用: 任何上游测试用 Catch2 v3 多头 include、制品仓仅发布 v2.13 合并头
#       包的 C++ 库（与 kangaru 草稿互补：kangaru 解决空 submodule + CMakeDeps
#       命中 find_package；本草稿解决 include 路径/注册/链接目标三处差异）。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-cdt-1.4.5-catch2-21310-amalgamated-test-adaptation
source_lib:             cdt 1.4.5
trigger_tool:           conan|conan create|cmake|clang
phase:                  source|configuration|test|link
error_signature:        catch2/benchmark/catch_benchmark.hpp.*(No such file|not found)|catch2/catch_test_macros.hpp.*not found|Catch2::Catch2WithMain.*target was not found|include could not find requested file.*Catch|catch_discover_tests.*Unknown CMake command|find_package\(Catch2 3\)

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan|packaging|header-only|test|catch2|cmake
match_keywords:         catch2, 2.13.10-r0, catch.hpp, amalgamated, single header, CATCH_CONFIG_MAIN, CATCH_CONFIG_ENABLE_BENCHMARKING, Catch2WithMain, catch_discover_tests, Catch.cmake, find_package, TEMPLATE_LIST_TEST_CASE, generators, matchers, benchmark
title:                  制品仓 catch2 v2.13 合并头布局下运行上游 Catch2 测试的三处适配（include 合并头化 / 无 WithMain 改 CATCH_CONFIG_MAIN / 无 Catch.cmake 改单 add_test）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  ① 制品仓 catch2/2.13.10-r0 配方仅打包 single_include/catch2（合并头 catch.hpp
  + 4 个 reporter 头），不含 v3 风格多头布局（benchmark/、generators/、
  matchers/、catch_test_macros.hpp 等），上游测试按 v3 多头 include 必然编译失败；
  ② 该配方仅声明 cmake_target_name=Catch2::Catch2，无 Catch2WithMain 组件，
  上游 find_package(Catch2 3) 因版本 2.13<3 不满足而下落空 submodule 分支，
  链 Catch2::Catch2WithMain 也直接找不到目标；
  ③ v2.13 包不透出 extras/Catch.cmake，上游 include(Catch)+catch_discover_tests
  无法工作（未知命令/include 找不到文件），逐用例 CTest 注册不可用。

affected_scope: >
  所有上游测试使用 Catch2 v3 多头 include / Catch2WithMain / catch_discover_tests，
  而制品仓仅发布 v2.13 合并头 catch2 包的 C++ 库；对 header-only 库测试秒级
  时可无条件运行（本任务 enable_testing=True 实测 28/28, 4788 断言）。

verification_cmd: >
  conan create archives/c/cdt/1.4.5 -o cdt/*:enable_testing=True
  -pr:h=ohos-aarch64 -pr:b=ohos-aarch64 --build=missing（G2 全绿 + 上游测试全过）;
  $BUILD_DIR/CDT-tests --list-tests; $BUILD_DIR/CDT-tests -r compact

# ═══ Layer 3: 方案层 (Fix) ═══
rec_priority:           1
rec_approach:           patch-tests-to-amalgamated-catch2-header
rec_description: >
  补丁层做三处最小适配（不涉及平台宏，R8 合规，且不改测试逻辑）:
  ① 测试源码 5 条 v3 多头 include 替换为
  `#define CATCH_CONFIG_ENABLE_BENCHMARKING` + `#include <catch2/catch.hpp>`
  （v2.13 合并头含全部所需宏: TEST_CASE/TEMPLATE_LIST_TEST_CASE/BENCHMARK/
  GENERATE/Approx/WithinAbs/SECTION，已实测 grep 确认宏存在）；
  ② CMakeLists find_package(Catch2 3 QUIET) → find_package(Catch2 QUIET)；
  ③ 测试目标改链 Catch2::Catch2 + target_compile_definitions(CATCH_CONFIG_MAIN)
  （合并头经该宏生成 main），catch_discover_tests 改单
  add_test(NAME ${TEST_TARGET_NAME} COMMAND ${TEST_TARGET_NAME}
  WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}/tests")；
  配方侧: 仅 enable_testing=True 时 require catch2/2.13.10-r0 + 声明
  generators="CMakeDeps"（生成 Catch2Config.cmake）。
  用例级证据采集改用二进制自带能力: --list-tests（含隐藏 tag 过滤）与 -r compact。

rec_command: >
  # conanfile.py
  def requirements(self):
      if self.options.enable_testing:
          self.requires("catch2/2.13.10-r0")
  generators = "CMakeDeps"
  # patches/0001-CMakeLists.txt.patch, 0002-tests-cdt.test.cpp.patch
rec_auto_fix:           false
rec_impl:               patch-cmake-and-test-includes

fallback_priority:      2
fallback_approach:      conan-test-requires-plus-cmake-deps-only
fallback_description:   若上游测试源码本来就是 v2.13 兼容 include（如 catch.hpp），
                        可只做 kangaru 式 test_requires+CMakeDeps 无需补丁；
                        本方案与 kangaru 草稿 (similar_to) 组合覆盖完整场景。
fallback_command:       self.test_requires("catch2/2.13.10-r0"); generate(): CMakeDeps(self).generate()
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ═══ Layer 4: 关系与来源 ═══
similar_to:             DRAFT-kangaru-4.3.2-catch2-submodule-test-requires
similar_to:             DRAFT-cmake-test-framework-fetch-to-conan-find-package
causes:
caused_by:              制品仓 catch2 版本策略（v2.13.10-r0 合并头）与上游 v3 多头布局的差异
conflicts_with:
prerequisite_of:

