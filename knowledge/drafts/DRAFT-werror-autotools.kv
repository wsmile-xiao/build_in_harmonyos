#====================================================================
# DRAFT-werror-autotools.kv — 上游构建脚本硬编码 -Werror 在 clang/OHOS 下升级为错误
# 草稿（待知识库主编审核，拟提升编号 Exxx）
# 来源 PR: OpenHarmonyPCDeveloper/build_in_harmonyos !14041（schism 20260524 适配）
#====================================================================

id:                     DRAFT-werror-autotools
trigger_tool:           configure|cmake
phase:                  configuration|compilation
error_signature:        error:.*\[-Werror,|error:.*\[-Werror=|error: unknown warning option.*-Werror|non-void function does not return a value.*\[-Werror

severity:               2
category:               build-system, autotools, cmake, portability
match_keywords:         -Werror, Werror, warning-as-error, [-Werror, unknown warning option, clang strict, CFLAGS, CXXFLAGS, configure, configure.ac, autotools, CMakeLists.txt, Wno-error, add_compile_options, AX_CHECK_COMPILE_FLAG

title:                  上游构建脚本硬编码 -Werror，clang/OHOS 交叉编译下告警升级为错误

root_cause:             上游 autotools / CMake 工程在 configure.ac、生成的 configure、
                         Makefile.am 或 CMakeLists.txt 中硬编码注入 -Werror 或逐项
                         -Werror=<flag>（如 AX_CHECK_COMPILE_FLAG(-Werror=return-type)、
                         SCHISM_CHECK_COMPILE_FLAG）。gcc 对告警容忍度高可正常构建；
                         clang15（OHOS SDK 内置）对同一代码新增告警并升级为 error，
                         直接编译失败。注入点位于使用方 CFLAGS 之后，-Wno-error 无法覆盖。
affected_scope:         所有在构建脚本中硬编码 -Werror 的上游工程（autotools 为主，
                         CMake 显式 add_compile_options(-Werror) 同类）
verification_cmd:       python3 knowledge/drafts/werror-autotools/detect_werror.py --src ${BUILD_SRC_DIR} --json;
                         grep -nE '^[[:space:]]*[A-Za-z_]+[[:space:]]*=[[:space:]]*"[^"]*[[:space:]]-Werror' configure | head

rec_priority:           1
rec_approach:           patch-build-script-remove-werror
rec_description:        用配对补丁剔除构建脚本中的 -Werror 注入：0003 处理 configure 中总
                         -Werror 注入行，0004 正则批量剔除逐项 -Werror=<flag>；保留告警可见性
                         （只去 -Werror，不屏蔽 -Wall）。模板见
                         knowledge/drafts/werror-autotools/patch-templates/，按检测脚本给出的
                         file:line 重 diff（勿盲套）
rec_command:            python3 knowledge/drafts/werror-autotools/detect_werror.py --src ${BUILD_SRC_DIR} --json  # exit 1 = 命中，需处理
rec_auto_fix:           false
rec_impl:               manual-patch

fallback_priority:      2
fallback_approach:      env-cflags-wno-error
fallback_description:   构建时追加 CFLAGS=-Wno-error（仅当上游注入顺序早于使用方 CFLAGS 时有效；
                         schism 实测顺序在其后，故本条目默认不走此路）
fallback_command:       CFLAGS="$CFLAGS -Wno-error" CXXFLAGS="$CXXFLAGS -Wno-error" make
fallback_auto_fix:      false
fallback_impl:          env-flags

forbid_1_pattern:       -Wno-error.*(?:make|configure)|CFLAGS=.*-Wno-error.*configure
forbid_1_reason:        上游 -Werror 注入在外部 CFLAGS 之后，-Wno-error 覆盖不到已升级的 error
forbid_1_consequence:   构建仍失败，且掩盖真实注入点（误判为工具链问题，浪费时间）
forbid_2_pattern:       (?:-Werror|werror).*-Wno-.*-Wall|patch.*-Werror.*-Wno-all
forbid_2_reason:        为过编译而整体关告警（-w / -Wno-all），会掩盖真实适配缺陷
forbid_2_consequence:   隐藏平台适配问题（未实现 syscall、类型截断等），产出带病制品

principles:             []

causes:                 []
caused_by:              []
similar_to:             [E007]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-werror-autotools.md
last_updated:           2026-09-28
