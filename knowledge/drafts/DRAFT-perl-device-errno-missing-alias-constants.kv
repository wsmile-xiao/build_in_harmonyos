#====================================================================
# DRAFT-perl-device-errno-missing-alias-constants — 设备 perl 的 Errno 把与
#   EAGAIN/EOPNOTSUPP 同值的别名常量从导出表去重，依赖 EWOULDBLOCK/ENOTSUP
#   的 CPAN 测试会编译期失败；改 pin OHOS 预装 hnp perl
# 对应人类文档: knowledge/drafts/DRAFT-perl-device-errno-missing-alias-constants.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。正式编号由 graph promote 分配。
#====================================================================

id:                     DRAFT-perl-device-errno-missing-alias-constants
trigger_tool:           perl|make|test
phase:                  testing
error_signature:        "\w+" is not exported by the Errno module|
                         Can't continue after import errors|
                         No plan found in TAP output|
                         Wstat: 65280 \(exited 255\)
severity:               2
category:               perl, environment, portability, testing, task
match_keywords:         Errno, EWOULDBLOCK, ENOTSUP, EAGAIN, EOPNOTSUPP, errno alias,
                         @EXPORT_OK, use Errno qw, hnp perl, /data/service/hnp/bin/perl,
                         prove, make test, TAP, no plan found, device perl
title:                  OHOS 设备 perl 的 Errno 去重了同值别名常量（EWOULDBLOCK/ENOTSUP），
                        依赖它们的上游测试会编译期失败——应 pin 预装 hnp perl

# ═══ Layer 2: 诊断层 ═══
root_cause:             OHOS 上并存两套 perl：设备 perl（5.42.2，
                        随「Python/perl 安装器」落在
                        /storage/Users/currentUser/usr/local）与系统预装
                        /data/service/hnp/bin/perl（5.42.0）。设备 perl 的
                        Errno.pm 只保留 EAGAIN => 11（以及 EOPNOTSUPP），把
                        与它**同值**的别名 EWOULDBLOCK（同 11）、ENOTSUP
                        （同 EOPNOTSUPP）从 %err 里去掉了——而 @EXPORT_OK 是
                        `keys %err` 派生的，于是 `use Errno qw(EAGAIN
                        EWOULDBLOCK)` 报 "EWOULDBLOCK" is not exported，测试
                        脚本在编译期即失败（BEGIN failed），TAP 输出为空，
                        prove 报 "No plan found in TAP output" / exited 255。
                        危害是「假失败」：同一套上游测试在 hnp perl 下全过。
affected_scope:         所有依赖 Errno 别名常量（EWOULDBLOCK / ENOTSUP 等与
                        主名同值的 POSIX 别名）的 CPAN 测试或脚本；
                        更一般地，任何「设备 perl 与 hnp perl 能力不一致」
                        引发的编译期假失败。实例：Metrics-Any 0.10 的
                        t/11adapter-file.t（`use Errno qw( EAGAIN EWOULDBLOCK )`）
                        在设备 perl 下 Files=14/Tests=73/FAIL，
                        在 hnp perl 下 Files=14/Tests=83/PASS。
verification_cmd:       /storage/Users/currentUser/usr/local/bin/perl -e 'use Errno qw(EWOULDBLOCK); print "ok\n"'
                        # → "EWOULDBLOCK" is not exported by the Errno module
                        /data/service/hnp/bin/perl -e 'use Errno qw(EWOULDBLOCK); print "ok\n"'
                        # → ok

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           pin-interpreter
rec_description:        配方与 test_package 统一 pin /data/service/hnp/bin/perl
                        （写出绝对路径，回退 PATH 上的 perl）——hnp perl 的
                        Errno 导出完整，上游测试可真跑；与仓内 perl-uri、
                        perl-io-multiplex 先例做法一致。
                        不要为迁就设备 perl 而去改上游测试源码（改测试即失去
                        R51 申报口径），也不要用 `use Errno ()` 之类改写掩盖。
rec_command:            self.run("/data/service/hnp/bin/perl Makefile.PL INSTALLDIRS=site") …
                        # test_package 亦以同一绝对路径 perl 驱动 -I<site>
rec_auto_fix:           false
rec_impl:               recipe-pattern

fallback_priority:      2
fallback_approach:      tool-requires-perl
fallback_description:   若后续把 OHOS perl 本体适配为 conan 制品
                        （ohpcd 已有 perl/5.42.2.x），可改为 tool_requires
                        该制品并 pin 其解释器路径，摆脱对宿主预装 perl 的依赖。
                        注意仍需验证该制品的 Errno 是否完整导出别名常量。
fallback_command:       self.tool_requires("perl/5.42.2.3")
fallback_auto_fix:      false
fallback_impl:          manual

forbid_1_pattern:       改.*t/.*\.t.*(以|to).*(通过|pass)|sed -i.*Errno.*\.t|
                        删.*测试.*Errno
forbid_1_reason:        修改/删除上游测试来迁就解释器缺陷，属以掩盖换通过，
                        违反 R51（须如实申报测试分母与结果）。
forbid_1_consequence:   测试证据失真；掩盖了真实的解释器能力差异。

forbid_2_pattern:       use\s+Errno\s+\(\)|no\s+warnings.*Errno
forbid_2_reason:        用空 import 或关警告把编译期失败按下去，等于假装测试跑了。
forbid_2_consequence:   上游测试实际未执行却显示通过，适配可信度尽失。

principles:             real-upstream-test-evidence, upstream-source-untouched,
                        reproducible-build-test

causes:                 []
caused_by:              []
similar_to:             [E137, E155]
conflicts_with:         []
prerequisite_of:        []

