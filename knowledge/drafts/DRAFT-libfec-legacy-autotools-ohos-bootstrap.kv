#====================================================================
# Draft: 2016 年前旧版 autotools 源码在 OHOS 的引导修复——
#        config.guess/sub 旧版须先整体升级再打 HarmonyOS 补丁，
#        gcc/install/ldconfig 缺失命令替换为 clang/cp
#====================================================================

id:                     DRAFT-LIBFEC-LEGACY-AUTOTOOLS-OHOS-BOOTSTRAP
trigger_tool:           configure|make|install|config.guess|config.sub|gcc|ldconfig
phase:                  configuration|compilation|installation
error_signature:        cannot guess build type|cannot guess.*build type|
                         config.guess.*unable|Invalid configuration.*not recognized|
                         make: gcc: No such file or directory|
                         make: install: No such file or directory|
                         make: ldconfig: No such file or directory|
                         patch-autotools-ohos.*Could not find __ANDROID__

severity:               2
category:               autotools, ohos, portability, toolchain
match_keywords:         config.guess, config.sub, HarmonyOS, __OHOS__, ohos-linux,
                         old autotools, 2016, android-linux, __ANDROID__,
                         patch-autotools-ohos, gcc, clang, install, ldconfig, toybox,
                         DESTDIR, srcdir, undefined symbol, Cpu_mode

title:                  2016 年前旧版 autotools 源码在 OHOS 上需先整体升级 config.guess/sub 再打 HarmonyOS 补丁；gcc/install/ldconfig 缺失需替换为 $(CC)/cp

root_cause:             (1) GNU config.guess/config.sub 老版本（约 2016 年前）既无 HarmonyOS 分支，
                        也没有 patch-autotools-ohos.pl 依赖的 __ANDROID__/android-linux/linux-uclibc
                        锚点，直接打补丁会 "Could not find __ANDROID__" 且 config.sub 不认
                        aarch64-linux-ohos 三元组；必须先整体替换为 2023-08-22 版再打补丁。
                        (2) OHOS 环境仅提供 clang/toybox：无 gcc、无 coreutils install、无 ldconfig；
                        上游 makefile.in 硬编码 gcc 与 install/ldconfig 时，configure/make/install
                        各阶段直接失败。
affected_scope:         携带旧版 config.guess/sub 或硬编码 gcc/install/ldconfig 的 autotools/makefile
                        库在 HarmonyOS PC (arm64) 上首次适配（libfec 1.0 实测）。

verification_cmd:       ./config.guess; ./config.sub aarch64-linux-ohos;
                        ./configure --prefix=...; make; make test

rec_priority:           1
rec_approach:           upgrade-guess-sub-then-patch-plus-cc-cp-rebind
rec_description:        (1) 将源码树 config.guess/config.sub 整体替换为 2023-08-22 版
                        （可从仓库内 babeltrace/c-algorithms 归档的 autotools/config/ 复制），
                        chmod +x 后运行 patch-autotools-ohos.pl config.guess config.sub
                        （5/5 校验：__OHOS__/HarmonyOS/ohos-linux/linux-ohos 全命中），
                        输出标准三元组 aarch64-unknown-linux-ohos。
                        (2) makefile.in 硬编码 gcc → $(CC)（conan/clang 注入）；install 规则
                        `install -m` → `cp -f` 并加 $(DESTDIR) 前缀与 $(srcdir)/ 源文件前缀
                        （out-of-tree 构建）；configure.in 对 ohos 平台 REBIND（ldconfig）置空。
rec_command:            perl scripts/patch-autotools-ohos.pl config.guess config.sub &&
                        sed 替换 makefile.in 后 ./configure --prefix=$DEFAULT_PREFIX && make -j1
rec_auto_fix:           true
rec_impl:               patches/0001-config.guess.patch ... patches/0006-makefile.in.patch
                        （libfec 1.0 实测 6 补丁）

fallback_priority:      2
fallback_approach:      consult-knowledge
fallback_description:   E007/E072/E160/E205 覆盖 config.guess HarmonyOS 分支（新版本）；
                        E098 覆盖 install 缺失；本条目补充"旧版须先升级"前置与命令替换组合。
fallback_command:       grep -r "config.guess" knowledge/graph/index.tsv

forbid_1_pattern:       --build=aarch64-linux-gnu|--host=.*绕过 config.guess
forbid_1_reason:        显式 --build/--host 使 configure 误判交叉编译（cross_compiling=yes），
                        AC_RUN_IFELSE 等运行时检测全部跳过，生成错误 config.h（E007 forbid）。
forbid_1_consequence:   平台能力硬编码默认值，级联 E064/E061/E062/E063 错误链。

principles:             minimal-patch, real-evidence-over-assumption
