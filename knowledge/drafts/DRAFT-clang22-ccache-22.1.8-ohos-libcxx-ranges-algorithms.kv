#====================================================================
# DRAFT-clang22-ccache-22.1.8-ohos-libcxx-ranges-algorithms.kv
# OHOS libcxx-ohos std::ranges 算法缺失（all_of/any_of/equal）
# Software: clang22-ccache 22.1.8 (upstream ccache v4.14), task clang22-ccache-22.1.8-r03-pc3-9
# Gate: conan create (ohos-aarch64 profile) exit 0; unittest 243 例 238 通过(5 败为 HMDFS 平台限制)
# similar_to: DRAFT-332-openrct2-0.5.3-libcpp15-cpp20-compat; DRAFT-graaf-1.1.0-ohos-libcxx-std-ranges-missing;
#             DRAFT-clang18-ccache-18.1.8-ohos-libcxx-ranges-algorithms（同族先例）; E130
# Status: DRAFT — needs review to promote to E-entry
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-clang22-ccache-22.1.8-ohos-libcxx-ranges-algorithms
trigger_tool:           clang++|libc++|cmake
phase:                  compilation
error_signature:        no member named 'all_of' in namespace 'std::ranges'|
                         no member named 'any_of' in namespace 'std::ranges'|
                         no member named 'equal' in namespace 'std::ranges'
severity:               3
category:               platform, libcxx-stdlib, ohos, compat
match_keywords:         std::ranges, ranges algorithm, libcxx-ohos, LLVM 15, _LIBCPP_VERSION, all_of, any_of, equal, ccache

# ═══ Layer 1: 识别层 (Recognition) ═══
title:                  ohos-libcxx-ranges-algorithms-all-of-any-of-equal

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:            OHOS SDK libcxx-ohos (LLVM 15.0.4, _LIBCPP_VERSION 15004) 的 <ranges> 头存在，
                       但 ranges 算法(all_of/any_of/equal 等)未实现，即使 -std=c++20 也缺失；
                       与既有 DRAFT-332 (fill/lower_bound)、DRAFT-graaf (max/min_element/count_if)
                       同属 libc++15 <ranges> 不完整族。
affected_scope:        OHOS 设备上使用 C++20 <ranges> 算法的三方库；LLVM 16+ libc++ / libstdc++ 不受影响；
                       ccache v4.14 (C++20) 命中 argprocessing.cpp/config.cpp/util/path.cpp/unittest。

verification_cmd:      grep -rn "std::ranges::all_of\|std::ranges::any_of\|std::ranges::equal" src/ unittest/

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           source-patch
rec_description:       将 std::ranges::XXX(range, pred) 替换为等价迭代器版
                       std::all_of/std::any_of/std::equal(begin, end, pred)；Tokenizer 等
                       单表达式消费场景需先绑定到 const 局部变量再 begin()/end()；
                       std::ranges::equal(range, other) 需改写为 std::equal(begin,end,other.begin(),other.end())。
rec_command:            sed -i 's/std::ranges::all_of(/std::all_of(/; s/std::ranges::any_of(/std::any_of(/; s/std::ranges::equal(/std::equal(/' src/**.cpp unittest/**.cpp
rec_auto_fix:           false
rec_impl:               source-patch (4 patches: 0001-argprocessing 0002-config 0003-util/path 0004-unittest)

fallback_priority:      2
fallback_approach:      change-cxx-standard
fallback_description:   仅因 C++ 标准过低触发时改 C++17；ranges 算法缺失无标准参数可解，必须源码替换
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       sed.*-i.*std::ranges.*-e.*s/.*\/\/.*/
forbid_1_reason:        不得用注释掉 ranges 调用或绕过检查的方式掩盖编译错误
forbid_1_consequence:   L1 测试缺失真实编译验证，finish 会拒绝

# ═══ Layer 4: 关联 ═══
principles:             P-COMPAT-001
causes:                 []
caused_by:              []
similar_to:             DRAFT-332-openrct2-0.5.3-libcpp15-cpp20-compat, DRAFT-graaf-1.1.0-ohos-libcxx-std-ranges-missing, DRAFT-clang18-ccache-18.1.8-ohos-libcxx-ranges-algorithms, E130