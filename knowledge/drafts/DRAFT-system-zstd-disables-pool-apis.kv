#====================================================================
# DRAFT - 用 --system-zstd 链系统 libzstd 时，python-zstandard 按**上游设计**
#         关闭 pool API（HAVE_ZSTD_POOL_APIS 仅在 ZSTD_SINGLE_FILE 捆绑构建下
#         定义）→ 上游 test_features 必失败；且该开关是 setup.py argv 须两步
# 最终编号由知识库主编确认
#====================================================================

id:                     DRAFT-SYSTEM-ZSTD-DISABLES-POOL-APIS
trigger_tool:           conan|setuptools|pip|ld
phase:                  configuration|testing
error_signature:        test_features|backend_features|multi_compress_to_buffer|multi_decompress_to_buffer|HAVE_ZSTD_POOL_APIS|ZSTD_SINGLE_FILE

severity:               2
category:               build-system, adaptation, ci
match_keywords:         zstandard, python-zstandard, --system-zstd, system_zstd, bundled zstd, ZSTD_SINGLE_FILE, HAVE_ZSTD_POOL_APIS, pool.h, multi_compress_to_buffer, multi_decompress_to_buffer, backend_features, test_features, ZSTD_MULTITHREAD, bdist_wheel, PEP517, setup.py argv
title:                  用 --system-zstd 链系统/conan libzstd 时，python-zstandard 会按上游设计关闭 pool API（HAVE_ZSTD_POOL_APIS 仅定义于 ZSTD_SINGLE_FILE 捆绑构建），故上游 test_features 必失败 —— 属有意取舍，应据实申报

root_cause:             c-ext/python-zstandard.h 里 #ifdef ZSTD_SINGLE_FILE 分支包含 <zstd.c> 并 #define HAVE_ZSTD_POOL_APIS，其注释明示「We use private APIs from pool.h. We can't rely on availability of this header or symbols when linking against the system libzstd. But we know it works when using the bundled single file library.」；setup_zstd.py 的 system_zstd 分支只加 -DZSTD_MULTITHREAD、不加 -DZSTD_SINGLE_FILE。于是 --system-zstd 构建下 backend_c.c 中 #ifdef HAVE_ZSTD_POOL_APIS 包住的 multi_compress_to_buffer / multi_decompress_to_buffer 不注册，而上游 test_features 的期望集是按**捆绑构建**写的 -> 恰好失败一条。附带：--system-zstd 是 setup.py 的 argv 开关（sys.argv.remove），pip 的 PEP517 构建路径无法透传自定义 argv。
affected_scope:         任何用 --system-zstd（链系统/conan libzstd 而非捆绑源码）打包 python-zstandard 的配方；通用模式——替换上游默认依赖来源会改变编译期宏，进而改变运行期 feature 集。
verification_cmd:       grep -n -A6 "ifdef ZSTD_SINGLE_FILE" c-ext/python-zstandard.h; grep -n -A6 "system_zstd" setup_zstd.py

rec_priority:           1
rec_approach:           declare-upstream-tradeoff
rec_description:        接受并据实申报——把 test_features 列入 ALLOWED_TEST_FAILURES，并在 notes.md / MANIFEST.yml / PR 正文引用上游 python-zstandard.h 注释说明「链接系统 libzstd 无法依赖 pool.h 私有 API」，禁止静默放行。
rec_command:            setup.py bdist_wheel --system-zstd -d <wheels> && pip install --target=<staging> <wheels>/*.whl
rec_auto_fix:           false
rec_impl:               conanfile.py::ALLOWED_TEST_FAILURES

fallback_priority:      2
fallback_approach:      use-bundled-build
fallback_description:   若确需 pool API，则改回上游默认捆绑构建（不传 --system-zstd），代价是随包分发 zstd 源码（PyPI wheel 亦静态链 zstd）。
fallback_command:       pip install <src>
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       (patch|fix).*(ZSTD_SINGLE_FILE|HAVE_ZSTD_POOL_APIS)|delete.*test_features|skip.*test_features.*(without|未).*(申报|declare)
forbid_1_reason:        HAVE_ZSTD_POOL_APIS 只在 ZSTD_SINGLE_FILE 下定义是上游有意的可移植性设计，不是缺陷；静默删除/跳过该用例而不申报即失真。
forbid_1_consequence:   评审判为掩盖失败；且与申报表不符。

principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

