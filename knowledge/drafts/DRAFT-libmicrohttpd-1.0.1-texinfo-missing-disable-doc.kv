#====================================================================
# DRAFT-libmicrohttpd-1.0.1-texinfo-missing-disable-doc.kv
#  草稿 — autotools 在无 texinfo/makeinfo 环境构建文档失败（Error 127）
#  来源: libmicrohttpd 1.0.1 适配（task libmicrohttpd-1.0.1-r01）
#====================================================================

id:                     DRAFT-libmicrohttpd-1.0.1-texinfo-missing-disable-doc
title:                  Autotools doc target fails with "makeinfo: inaccessible or not found" (Error 127) on texinfo-less build env — fix by --disable-doc
category:               autotools, configure, documentation, toolchain
error_signature:        makeinfo: inaccessible or not found|makeinfo: missing on your system|Error 127.*\.info|Cannot.*makeinfo|\bmissing\b.*makeinfo

match_keywords:         makeinfo, texinfo, Error 127, doc target, --disable-doc,
                         autotools, info pages, texi2any, documentation build

root_cause:             Autotools 项目的 doc/Makefile 在 make/make install 时会调用
                        makeinfo（或 texi2any）生成 .info 文档。构建/CI 环境未安装
                        texinfo 工具链时，build-aux/missing 包装器报
                        "makeinfo: inaccessible or not found"，install 阶段
                        doc 子目录以 Error 127 失败；若 install 带
                        install-recursive，整个安装流程中断（exit 2）。

verification_cmd:       grep -n "MAKEINFO" doc/Makefile.in | head -3;
                        which makeinfo texi2any || echo "makeinfo missing";
                        ./configure --help | grep -E "disable-doc|enable-doc"

rec_approach:           configure-disable-doc
rec_description:        在 configure 阶段显式禁用文档构建：
                        ./configure --disable-doc
                        Conan 配方中在 AutotoolsToolchain.generate() 追加
                        tc.configure_args.append("--disable-doc")。
                        该选项对运行库本身无影响（仅跳过 info/html 文档生成），
                        且避免 CI 干净环境缺少 texinfo 导致的 install 中断。
                        如仍需文档，先 tool_requires texinfo 或安装 texinfo 包。

affected_scope:         所有使用 Autotools 且在无 texinfo 的干净 CI/容器环境
                        构建的 C/C++ 项目；libmicrohttpd 1.0.1（本轮实测）。

severity:               2
phase:                  build
platform:               OHOS, Linux
evidence:               libmicrohttpd-1.0.1 install2.log（makeinfo: inaccessible or not found → Error 127）
                        configure4/5.log（--disable-doc 后 configure exit 0、install exit 0）
                        reports/knowledge-candidate-ledger.md 候选 3
