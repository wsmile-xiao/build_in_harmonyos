#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 Ennn.kv，填写各字段
# 对应的人类文档: doc/Ennn.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E552
trigger_tool:           meson|test
phase:                  testing
error_signature:        Dependency "doctest" not found|Dependency "fmt" not found|Subproject .* does not exist and cannot be downloaded|Failed to download|subprojects/[a-z]+\.wrap

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity:               2
category:               build-system, testing, network, portability
match_keywords:         meson, wrap, subprojects, doctest, fmt, upstream test, direct compile, DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN, network fetch, per-TU
title:                  meson+wrap 网络拉取型上游测试可用直编方案在 CI/离线设备执行（免 meson）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause:             上游测试套件由 meson 驱动且测试依赖经 subprojects/*.wrap 在配置期从网络拉取（doctest/fmt 等），离线或网络受限的 CI/设备无法完成拉取，导致上游测试整体不可执行
affected_scope:         测试由 meson 驱动且依赖经 wrap 拉取的 C/C++ 项目；header-only 测试依赖（doctest/gtest/catch2 系）最适配；不适用于依赖 meson 代码生成或无源码编译型 wrap 依赖的项目
verification_cmd:       clang++ -std=c++17 -DDOCTEST_CONFIG_IMPLEMENT_WITH_MAIN -I include -I <doctest解包>/doctest -I <fmt解包>/include -I test test/unit/<TU>.cpp <辅助对象> -o t.bin && ./t.bin | tail -3

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority:           1
rec_approach:           direct-compile-upstream-tests
rec_description:        用与 wrap 锁定版本一致的官方依赖 tarball 头文件加上游自带辅助 TU，逐 TU 直接编译运行上游测试，完全绕开 meson 与网络拉取，不修改上游测试源码
rec_command:            clang++ -std=c++17 -DDOCTEST_CONFIG_IMPLEMENT_WITH_MAIN -I include -I <doctest解包>/doctest -I <fmt解包>/include -I test test/unit/<TU>.cpp <Counter.o> <fmt_format.o> <fmt_os.o> <api.o> -o t.bin && ./t.bin
rec_auto_fix:           false
rec_impl:               manual-direct-compile

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      tool-requires-meson
fallback_description:   tool_requires("meson/1.11.0") 配合 MesonToolchain/Meson 助手在 CI 内走原生 meson test（c-list 3.1.0 先例），要求制品仓已发布 meson 包且 wrap 拉取在 CI 可达
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       ^diff --git a/test/
forbid_1_reason:        直编方案不得修改上游测试源码来迁就编译环境，否则上游用例统计口径失真
forbid_1_consequence:   R51 上游测试三步法违规，测试数字不可信
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

