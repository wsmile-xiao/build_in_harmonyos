#====================================================================
# DRAFT-gnustep-gui-0.31.1-objc-runtime-gnu
# GNUstep GUI must use the same GNU Objective-C runtime as gnustep-base
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: gnustep-gui 0.31.1 HarmonyOS PC 适配（PR #7408）
#====================================================================

id:                     DRAFT-gnustep-gui-0.31.1-objc-runtime-gnu
trigger_tool:           gnustep-make|make|clang|conan
phase:                  configuration|build|linking
error_signature:        OBJC_RUNTIME_LIB.*gnu|GNU runtime.*not available|objc_msg_lookup|ng_runtime|libobjc.*gnu|runtime library.*mismatch|NSObject.*receiver type

severity:               3
category:               ohos|objective-c|gnustep|conan|runtime|toolchain
match_keywords:         OBJC_RUNTIME_LIB, gnu, ng runtime, gnustep-base, libobjc2, Objective-C runtime, GNUstep GUI, AppKit
title:                  GNUstep GUI must compile with the same GNU Objective-C runtime (OBJC_RUNTIME_LIB=gnu) as gnustep-base
root_cause:             GNUstep GUI (AppKit layer) is compiled against and linked with
                        gnustep-base, which was built with the GNU Objective-C runtime
                        (libobjc2, OBJC_RUNTIME_LIB=gnu). If the GUI package is built with
                        the default "ng" (next-generation) runtime, method dispatch,
                        constant-string classes, and class registration ABI are
                        incompatible, causing link-time or runtime failures in the
                        downstream consumer.
affected_scope:         GNUstep application-layer packages (gui/back) built through Conan on
                        OHOS, consuming gnustep-base/1.31.1 and libobjc2/2.2.1.
verification_cmd:       Build gnustep-gui 0.31.1 with OBJC_RUNTIME_LIB=gnu exported in the
                        configure/build environment; verify libgnustep-gui.so links and a
                        test_package AppKit consumer runs.

rec_priority:           1
rec_approach:           export-objc-runtime-gnu
rec_description:        Export OBJC_RUNTIME_LIB=gnu (and keep the same -fobjc-runtime=gcc /
                        -fconstant-string-class=NSConstantString flags) in the GNUstep
                        environment used for both configure and make, matching the runtime
                        ABI of gnustep-base/libobjc2 so AppKit code links and runs on OHOS.
rec_command:            export OBJC_RUNTIME_LIB=gnu
rec_auto_fix:           false
rec_impl:               conan-recipe-env

fallback_priority:      2
fallback_approach:      explicit-runtime-cflags
fallback_description:   If the make environment is not honored, inject -fobjc-runtime=gcc and
                        -fconstant-string-class=NSConstantString via ADDITIONAL_CPPFLAGS /
                        ADDITIONAL_LDFLAGS passed on the make command line.
fallback_command:       make ADDITIONAL_CPPFLAGS="-fobjc-runtime=gcc -fconstant-string-class=NSConstantString ..."
fallback_auto_fix:      false
fallback_impl:          conan-recipe-env

forbid_1_pattern:       OBJC_RUNTIME_LIB=ng|use.*default.*runtime
forbid_1_reason:        Default "ng" runtime ABI is incompatible with gnustep-base/libobjc2.
forbid_1_consequence:   AppKit consumer fails to link or crashes at runtime on OHOS.

principles:             P016
causes:                 []
caused_by:              []
similar_to:             DRAFT-gnustep-base-1.31.1-objc-runtime-consumer
conflicts_with:         []
prerequisite_of:        []

