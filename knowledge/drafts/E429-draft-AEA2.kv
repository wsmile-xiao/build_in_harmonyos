#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: conan
phase: configuration
error_signature: 缺少: export_sources\(\) 方法|缺少: 补丁应用调用|G1: FAIL|No rule to make target 'check'

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan,build-system,script
match_keywords: G1,export_sources,apply_conandata_patches,conan-init,autotools,completion script,脚本包,headeronly,test.c
title: 纯脚本/补全脚本包被 conan-init 误判为 autotools，且 G1 强制要求 export_sources/apply_conandata_patches 字面项

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 构建系统探测见顶层 Makefile 即判 autotools，脚本包的 Makefile 只有 install 目标无编译规则；G1 用字符串字面量 export_sources/apply_conandata_patches 判完整性，patches 为空时同样必须出现；test_package 默认 C 模板（test.c+CMakeLists）对无符号脚本包不可链接
affected_scope: 所有无构建/打包族（header-only 之外的纯脚本、数据、bash 补全脚本）配方
verification_cmd: python3 scripts/ohc-run.py conan-verify <软件> <版本> 2>&1 | grep -E "G1: (PASS|FAIL)|缺少: export_sources|补丁应用调用"

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: 改用 templates/conanfile-headeronly.py.tmpl 变体 C：删 Autotools/generate 与 shared option，build() 仅核验脚本存在与非空但保留 apply_conandata_patches(self)，def export_sources() 调 export_conandata_patches(self)，package() copy 到 share/bash-completion/completions/，package_info() libs/bindirs/libdirs/includedirs 置空 + resdirs=[share]，package_id() self.info.clear()；test_package 用 .sh 断言 + self.run(bash …)
rec_description:        把 conan-init 生成的 autotools 骨架改写为「无编译脚本包」形态：只装不编、安装落包内 share/、test_package 用 shell 断言真实 source 被测脚本
rec_command:            python3 scripts/ohc-run.py conan-init <软件> <版本>   # 之后按变体 C 手工改写 conanfile.py 与 test_package/
rec_auto_fix:           false
rec_impl:               headeronly-script-variant-c

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:      若变体 C 模板不可用（如 conan-init 版本未注册 headeronly），直接以已发布同族配方为底稿复制改写：archives/d/docker-completion/29.5.2/conanfile.py 或 archives/b/brew-cask-completion/2.1/conanfile.py（两者均为 package() copy + resdirs=["share"] + 无 requires）
fallback_description:   用同族已发布配方作底稿手工改写，绕开构建系统误判路径
fallback_command:       python3 scripts/ohc-run.py recipe-search <软件名> -d <依赖>
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:       autotools\.(configure|make)\(\)|AutotoolsToolchain\(self\)
forbid_1_reason:        纯脚本/数据包没有任何 configure 脚本与编译规则，套用 autotools 骨架或保留 options.shared/cpp_info.libs=[包名] 会让 G2 conan create 在 configure 阶段必然失败，或产出根本不存在的库声明
forbid_1_consequence:   conan-verify G2 FAIL（configure: not found / No rule to make target），或 package_info 声明与包内产物不符导致下游消费者链接失败
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
#                本模式无对应现存原则（P001-P020 均针对 autotools/补丁/链接/HMDFS/签名），
#                建议主编在 promote 时新增一条「无构建族配方禁止套用编译型模板」原则
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
auto_command:
verification: conan-verify G1→G4 全 PASS + test_package 7 断言 PASS（pip-completion/20200731；同族 docker-completion/29.5.2、brew-cask-completion/2.1）
related: E524
doc_file:               drafts/E429-draft-AEA2.md          # 草稿期配套文档；promote 后由工具改写为 doc/E429.md
last_updated: 2026-09-08
source_event:           pip-completion/20200731 适配（conan-verify G1 首跑 FAIL → 改写脚本包配方）

# ═══ 知识协作 (Authorship & Provenance) ═══
# authors: 作者列表 (格式: Name <email>, Name2 <email2>)
#          草稿生成时自动从 git config 填入；主编合入时保留原作者
#          合并到已有条目时追加为第二/第三作者
# source_pr:            添加该条目的 PR 编号
# source_commit:        添加时的 commit SHA (短)
authors:
source_pr:
source_commit:

# ═══ 质量度量 (Quality Metrics, 方案 D) ═══
# metrics_success_count: 该修复方案成功次数
# metrics_fail_count:    该修复方案失败次数
# metrics_confidence:    置信度 = success / (success + fail)
# metrics_last_used:     最后使用时间
metrics_success_count:  0
metrics_fail_count:     0
