id:                     E543
trigger_tool:           clang|gcc|cmake
phase:                  compilation
error_signature:        no matching function for call to 'std::map<.*>::insert\(.*absl::string_view|no match for 'operator\+'.*std::__1::basic_string.*absl::string_view|cannot convert.*absl::string_view.*to.*std::string|no viable conversion from 'absl::string_view' to 'std::string'

severity:               2
category:               compat, build-system, portability
match_keywords:         absl::string_view, descriptor accessor, protobuf 33, no matching function for call to insert, no match for operator+, cannot convert absl::string_view to std::string, protoc plugin, grpc_generator
title:                  protobuf 30+ descriptor accessor 返回 absl::string_view，下游 protoc 插件按 std::string 消费产生批量编译错误

root_cause: protobuf 30 起（含 33.x）把 descriptor accessor（name()/full_name()/package()/
  json_name()/filename() 等）返回值从 const std::string& 改为 absl::string_view，下游
  代码把返回值塞进 std::map<std::string,std::string> key/value、做 string 拼接或传给
  形参为 std::string 的 helper 时产生 51 处级联编译错误；上游插件若 pin 老 protobuf
  （如 grpc-web 2.1.1 pin protobuf 29.1）则源码无兼容改动
affected_scope: 所有直接消费 protobuf descriptor API 的 protoc 插件/生成器（grpc-web、
  grpc 插件类项目），以及把 protobuf 从 29.x 升到 30+ 的存量代码
verification_cmd: grep -n "absl::string_view" $(conan cache path protobuf 2>/dev/null)/include/google/protobuf/descriptor.h 2>/dev/null || grep -rn "string_view name()" <protobuf>/include/google/protobuf/descriptor.h

rec_priority:            1
rec_approach:            source-patch-stringview-migration
rec_description:         只读 helper 形参 absl::string_view 化 + map key/拼接点显式 std::string() 包裹 accessor 返回值，固化为规范 patch 随 conandata.yml 应用
rec_command:             生成补丁后 conandata.yml 声明 patches（patch_type: compatibility），build() 内 apply_conandata_patches(self)
rec_auto_fix:            false
rec_impl:                manual-patch

fallback_priority:       2
fallback_approach:       pin-old-protobuf
fallback_description:    若制品仓存在 protobuf 29.x 且依赖闭包可满足，退回老版本规避迁移（不推荐，偏离仓库统一 protobuf 33 基线）
fallback_command:        conan download "protobuf/29.x" -r=ohpcd --only-recipe
fallback_auto_fix:       false
fallback_impl:

forbid_1_pattern:        sed -i.*descriptor->name\(\)\.c_str\(\)
forbid_1_reason:          批量 .c_str() 硬改会把临时 string_view 生命周期问题引入运行时（悬垂指针），且无法通过编译器的 string_view 显式转换检查
forbid_1_consequence:     编译看似通过但运行时未定义行为或 string 内容损坏

causes:                  []
caused_by:               []
similar_to:              [E014]
conflicts_with:          []
prerequisite_of:         []

doc_file:                doc/E543.md
last_updated: 2026-09-07
source_event:            protoc-gen-grpc-web 2.1.1 对 protobuf/33.6.1 构建，grpc_generator.cc 51 处编译错误，两轮幂等替换脚本生成规范补丁后 clang++ -std=c++17 编译零错误

authors: ningyu405 <ningyu405@gitcode.com>
