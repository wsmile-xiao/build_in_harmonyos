#====================================================================
# DRAFT-enet-2.7.0-cmake-transition-recipe - 同一库跨大版本构建系统迁移
# conan-init 按旧版本历史生成过期模板（autotools→CMake）
#
# 场景: enet 2.7.0（zpl-c/enet）在 1.3.18（autotools）之后迁移为原生
#       CMake（CMakeLists.txt：ENET_STATIC/ENET_SHARED/ENET_TEST）。
#       ohc-run.py conan-init 依据同库旧版本归档（1.3.18 autotools）推断
#       构建系统并生成 AutotoolsToolchain 配方模板 + sha256 占位符，
#       与新版本实际构建系统不符，直接 conan create 必然失败。
# 适用: 同库大版本升级时构建系统发生迁移（autotools→cmake/meson 等）的
#       Conan 配方适配；也适用于 conan-init 依据旧版本历史生成模板的所有库。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-enet-2.7.0-cmake-transition-recipe
source_lib:             enet 2.7.0
trigger_tool:           ohc-run.py|conan-init|conan create
phase:                  recipe|configuration
error_signature:        AutotoolsToolchain|configure_args|REPLACE_WITH_ACTUAL_SHA256|no CMakeLists|template.*autotools

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, build-system, migration, recipe, cmake, autotools
match_keywords:         conan-init, 旧版本, 历史模板, autotools, cmake, 构建系统迁移,
                        build system migration, version upgrade, 版本升级, sha256 占位符,
                        REPLACE_WITH_ACTUAL_SHA256, 配方模板过期
title:                  同库大版本构建系统迁移（如 autotools→CMake）时 conan-init 依据旧版本历史生成过期模板，须按新版本实际构建系统重写配方并回填真实 sha256

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  conan-init 的构建系统推断依赖同库旧版本归档（如 1.3.18 的 autotools），
  未感知新版本构建系统迁移。生成的 conanfile.py 使用 AutotoolsToolchain/
  configure_args，conandata.yml 的 sha256 留 REPLACE_WITH_ACTUAL_SHA256
  占位符，与新版本（原生 CMake，无 configure.ac）完全不匹配。
affected_scope:         同库跨大版本迁移构建系统的库（autotools→cmake/meson 等）；
                        conan-init 依据历史版本生成模板的所有适配任务。
verification_cmd:       ls <source>/CMakeLists.txt; grep -nE 'project\(|option\(' <source>/CMakeLists.txt;
                        python3 scripts/ohc-run.py conan-init <name> <version> 2>&1 | grep -E '构建系统|autotools|cmake'

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           rewrite-recipe-by-actual-build-system
rec_description:        以新版本源码实际构建系统为准重写 conanfile.py：CMake 库用
                        CMakeToolchain/CMake（本项目 templates/conanfile-cmake.py.tmpl），
                        generate() 显式设置库选项（如 ENET_STATIC=ON、ENET_TEST=OFF 仅打包、
                        ENET_TEST=ON 单独构建上游测试），package_info() 填真实 libs；
                        conandata.yml 回填官方 tarball 真实 sha256（sha256sum 核验）。
                        上游测试另行构建运行（R51 双口径台账），不进配方。
rec_command:            cp templates/conanfile-cmake.py.tmpl archives/<l>/<name>/<version>/conanfile.py;
                        sha256sum <tarball>  # 回填 conandata.yml
rec_auto_fix:           false
rec_impl:               conan-recipe
fallback_priority:      2
fallback_approach:      manual-recipe-authoring
fallback_description:   参考同构建系统已完成配方（recipe-search 或同字母表邻近库）
                        手写配方，再以 conan-verify G0-G4 验证。
fallback_command:       python3 scripts/ohc-run.py recipe-search <name> -b cmake
fallback_auto_fix:      false
fallback_impl:          manual
forbid_1_pattern:       沿用旧版本 Autotools 模板|把 sha256 占位符留在 conandata.yml|伪造 sha256

# ═══ Layer 4: 验证层 (Validation) ═══
verified_on:            enet 2.7.0（OHOS armv8，clang 15.0.4，conan 2.29.1）
verification_result:    CMake 配方重写后 conan-verify G0-G4+L2/L4/L5 全 PASS；
                        W3 本地 CI incremental 100% (1/1)；W4 审计 P0/P1=0；
                        上游 7 用例 + HarmonyOS 专项回环测试全过。
# 反例/限制
limitations: >
  - 仅覆盖构建系统迁移导致的模板过期；若新版本仍用 autotools 则无需重写。
  - 重写后必须过 conan-verify/W3，不得跳过验证直接提交。
