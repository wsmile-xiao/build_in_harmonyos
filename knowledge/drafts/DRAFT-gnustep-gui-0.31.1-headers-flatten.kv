#====================================================================
# DRAFT-gnustep-gui-0.31.1-headers-flatten
# GNUstepGUI 头文件需平铺到 Library/Headers/GNUstepGUI/
#
# 本条目为 draft，不预占正式 E 编号，禁止直接 promote。
# 触发事件: gnustep-gui 0.31.1 HarmonyOS PC 适配（PR #7408）
#====================================================================

id:                     DRAFT-gnustep-gui-0.31.1-headers-flatten
trigger_tool:           conan|clang|package|install|make
phase:                  install|packaging|compilation
error_signature:        GNUstepGUI/GSVersion.h.*not found|GNUstepGUI.*headers.*not.*found|AppKit.h.*not.*found|GNUstepGUI directory|headers.*flatten|cannot find.*GSVersion
severity:               2
category:               ohos|gnustep|headers|packaging|compilation|conan
match_keywords:         GNUstepGUI, AppKit.h, GSVersion.h, headers, flatten, Library/Headers, include path, gnustep-gui
title:                  Flatten GNUstepGUI headers into Library/Headers/GNUstepGUI/ so AppKit.h include resolves
root_cause:             GNUstep GUI's AppKit.h references subheaders via
                        <GNUstepGUI/GSVersion.h>. On OHOS/Conan packaging, if the installed
                        header layout nests GNUstepGUI headers under a deeper path (e.g.
                        Library/Headers/GNUstepGUI/AppKit/...), the include
                        <GNUstepGUI/GSVersion.h> cannot be resolved by consumers. Headers
                        must be flattened into Library/Headers/GNUstepGUI/.
affected_scope:         GNUstep AppKit packages and their consumers on OHOS/Conan where the
                        package install preserves a nested GNUstepGUI header tree.
verification_cmd:       After packaging, verify Library/Headers/GNUstepGUI/GSVersion.h exists
                        at the flattened path and a consumer compiling <AppKit/AppKit.h>
                        resolves it.

rec_priority:           1
rec_approach:           flatten-gnustepgui-headers
rec_description:        During packaging, collect all GNUstepGUI headers and flatten them
                        under Library/Headers/GNUstepGUI/ so AppKit.h's
                        <GNUstepGUI/GSVersion.h> include resolves for consumers.
rec_command:            flatten headers to <pkg>/Library/Headers/GNUstepGUI/
rec_auto_fix:           false
rec_impl:               conan-recipe-packaging

fallback_priority:      2
fallback_approach:      add-include-path
fallback_description:   If flattening is not feasible, add the nested GNUstepGUI parent
                        directory to cpp_info.includedirs so <GNUstepGUI/...> resolves.
fallback_command:       extend cpp_info.includedirs with the GNUstepGUI parent
fallback_auto_fix:      false
fallback_impl:          conan-recipe-packaging

forbid_1_pattern:       omit.*GNUstepGUI.*headers|package.*without.*GSVersion.h
forbid_1_reason:        Consumers include <GNUstepGUI/GSVersion.h> via AppKit.h.
forbid_1_consequence:   Downstream AppKit compiles fail with header-not-found.
forbid_2_pattern:       hardcode.*absolute.*header.*path
forbid_2_reason:        Absolute paths break reproducibility.
forbid_2_consequence:   Clean consumers fail on another worker.

principles:             P016
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

doc_file:               drafts/DRAFT-gnustep-gui-0.31.1-headers-flatten.md
last_updated:           2026-08-31
