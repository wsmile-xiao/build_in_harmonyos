#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E430.kv，填写各字段
# 对应的人类文档: doc/E430.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E430
trigger_tool: python|pip|test|lit
phase: testing
error_signature: 'filecheck': command not found|error: command failed with exit status: 127|Failed: 1|ModuleNotFoundError: No module named 'filecheck'

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: python, test_package, detection, conan, build-system
match_keywords: import 探针, 隐式命名空间包, namespace package, PEP 420, 目录名遮蔽 shadowing, test_package/filecheck, shutil.which, PATH 探针, pip install 被跳过, 静默跳过, lit 127
title: 用 python -c 'import <name>' 探测命令行工具（filecheck/lit 等）是否可用时，test_package 里的同名目录会被当作隐式命名空间包而导入成功，pip 安装被静默跳过，直到 lit 用例报 command not found (127)

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: Python 3.3+ 的隐式命名空间包规则让 import filecheck 在 PYTHONPATH 命中任意名为 filecheck/ 的目录时即成功（无需 __init__.py）；test_package 恰好把上游 lit 目录复制成 test_package/filecheck/ 并把它所在目录放入 PYTHONPATH，于是 import 探针恒真，_ensure_module 判定工具已装而跳过 pip install，真正缺失的是同名可执行文件 filecheck（PyPI 包），直到 lit 跑到用例才以 127 暴露；诊断成本被推迟到测试阶段
affected_scope: 所有在 test_package/conanfile.py 里用 import 探针做『工具是否已安装』判定、且 PYTHONPATH 含与被探测工具同名的目录（filecheck/、lit/、pytest/ 等）的配方；也影响用 import 探针判定编译器/命令行的通用写法
verification_cmd: python3 -c "import filecheck" ; echo rc=$?   # 在 test_package 目录、PYTHONPATH 含 test_package 时 rc=0（假阳性）；ls $(dirname $(which python3))/filecheck  # 真实可执行文件不存在；shutil.which('filecheck') 返回 None

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: cli-probe-with-shutil-which
rec_description: 区分两类依赖探针：Python 模块用 import 探针，命令行工具一律用 PATH 探针（shutil.which(name, path=env['PATH']) 或直接执行 --version），装完再复检一次并在失败时 raise ConanException，绝不静默继续
rec_command: if not shutil.which('filecheck', path=env['PATH']): self._pip_install(env, python, 'filecheck==0.0.23'); assert shutil.which('filecheck', path=env['PATH'])
rec_auto_fix: true
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: import (filecheck|lit|pytest|ninja|cmake)$
forbid_1_reason: 对命令行工具用 import 探针在存在同名目录（或同名模块被无关包占用）时给出假阳性，安装被跳过
forbid_1_consequence: 问题推迟到测试用例阶段才以 127/command not found 暴露，且容易误判为被测软件缺陷
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

# ═══ 元数据 ═══
doc_file:               doc/E430.md
last_updated: 2026-09-29
source_event:           # 触发此条目创建的编译事件(如有)

# ═══ 知识协作 (Authorship & Provenance) ═══
