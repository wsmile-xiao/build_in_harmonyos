#====================================================================
# E601 (draft) — OHOS toybox diff 不支持 -c（context 格式），上游测试脚本整组 FAIL
# 对应的人类文档: E601-draft-4E3E.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E601
trigger_tool:           test
phase:                  testing
error_signature: |
  diff: Unknown option 'c'
  diff: Unknown option 'C'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               compat, ohos, toolchain, testing
prescan_pattern:        \bdiff\s+-[a-zA-Z]*[cC]\b
prescan_globs:          test*, *.sh, *.test, Makefile*, *.mk, *.am, *.in
match_keywords:         toybox, diff, diff -c, context diff, Unknown option 'c', make check, TESTS, xpt, expected output, diff -u
title:                  OHOS 的 diff 是 toybox 实现、只支持 unified 输出，上游测试脚本里的 diff -c 让整组用例 FAIL

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             鸿蒙 PC 的 /usr/bin/diff 由 toybox 提供，只实现 unified 格式输出（-u / -U N），不认识 POSIX 的 context 格式选项 -c / -C N。
 很多上游测试脚本用 `程序输出 | diff -c 期望文件 -` 比对，于是在 CI 的 aarch64 原生机上每个用例都以 `diff: Unknown option 'c'` 立即失败，
 表现为"N of N tests failed"——失败的是比对工具，不是被测程序：同一轮构建里被测二进制通常已能正常运行并输出正确结果。
 在 x86 交叉 runner 上本地验证时通常用的是 GNU diffutils，这个问题完全暴露不出来，只会在 CI 第一轮出现。
affected_scope:         所有在 build() 里执行上游 make check / 测试脚本、且脚本用 diff -c（或 -C N）比对期望输出的包；常见于 1990–2000 年代的 automake 老项目（TESTS=... 配 *.xpt / *.exp / *.out 期望文件）。
 与被测程序的平台适配无关。
verification_cmd:       grep -rnE '\bdiff\s+-[a-zA-Z]*[cC]\b' <src>/test* <src>/tests <src>/Makefile.am 2>/dev/null

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           test-script-diff-unified
rec_description:        在测试脚本里把 `diff -c` 改为 POSIX 的 `diff -u`（`-C N` 改为 `-U N`）：toybox 与 GNU diffutils 都支持，读 stdin 的 `-` 也照常可用，比对语义（相同退出 0、不同退出 1）不变，只是失败时的差异展示格式从 context 变为 unified。
 用补丁固化（每个脚本一行），在 PR 的"上游测试用例修改说明"里逐条登记；期望输出文件本身无需改动。
rec_command:            sed -i 's/\bdiff -c\b/diff -u/' <src>/test1 <src>/test2 ...   # 在 .work 中修改后 refresh-patch --auto
rec_auto_fix:           false
rec_impl:               manual-patch

fallback_priority:      2
fallback_approach:      gnu-diffutils-first-in-path
fallback_description:   若脚本依赖 context 格式的具体输出（极少见，例如把 diff 结果再喂给别的工具解析），则 tool_requires 已发布的 GNU diffutils 并让它在测试时先于 /usr/bin 出现在 PATH（做法与 DRAFT-toybox-diff-e-ed-script 相同）。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       make check.*\|\|\s*true|ignore.*test.*fail|-k check
forbid_1_reason:        失败原因是比对工具不兼容而不是程序有 bug，吞掉 make check 的失败等于把整组上游测试变成空跑
forbid_1_consequence:   CI 变绿但上游用例一个都没真正比对，PR 里申报的上游通过率失实（R51）
forbid_2_pattern:       rm -f .*/test[0-9]*\.xpt|TESTS\s*=\s*$
forbid_2_reason:        删除期望输出或清空 TESTS 以"通过" make check
forbid_2_consequence:   同上，属于把 skip 写成通过

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 (Relations) ═══
causes:                 []
caused_by:              []
similar_to:             [E402, E254]
conflicts_with:         []
prerequisite_of:        []

