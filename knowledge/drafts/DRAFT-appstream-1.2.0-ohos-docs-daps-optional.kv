#====================================================================
# DRAFT-appstream-1.2.0-ohos-docs-daps-optional.kv
# 文档校验测试依赖 daps（DocBook 发布工具），OHOS 无此程序：
# meson find_program(required:false) 仅在有 daps 时注册 make-docs 目标；
# doc-build-helper.py 对缺失 daps 跳过其子进程（valsec-gen 真实校验保留），
# as-validate_docs 测试仍运行
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R03）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           daps (DocBook) / meson / python
phase:                  configuration, runtime-validate
error_signature:        FileNotFoundError.*daps|
                        daps.*not found|
                        No such file or directory.*'daps'
severity:               2
category:               build, docs, tooling, meson, portability
match_keywords:         daps, docbook, find_program, required: false, docs, as-validate_docs,
                        valsec-gen, OHOS, documentation validation, make-docs
title:                  docs 校验工具 daps 缺失 → find_program(required:false) + 子进程跳过，测试仍运行
root_cause:             as-validate_docs 依赖 daps 做 DocBook schema 校验；OHOS 无
                        daps 发布包。meson 侧硬性 find_program 使配置失败，helper
                        侧硬调子进程使运行失败。
affected_scope:         任何 meson 文档校验测试依赖平台级 daps/DocBook 工具的配方。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing; meson test as-validate_docs
rec_priority:           1
rec_approach:           docs-daps-optional-fallback
rec_description:        meson 侧 daps 可选（仅存在时注册 make-docs）；helper 侧
                        shutil.which(daps_exe) 为空时跳过 daps 子进程，valsec-gen
                        （AppStream 标签段校验）保留并作为通过依据。
rec_command:            |
  daps_exe = find_program('daps', required: false)
  if daps_exe.found()
      ...make-docs...
  endif
  # helper: if shutil.which(daps_exe) is None: return True
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       -Ddocs=false
forbid_1_reason:        整体关闭 docs 会连 valsec-gen 校验与测试一起丢弃
forbid_2_pattern:       skip.*as-validate_docs
forbid_2_reason:        不得把测试写成跳过——本方案保持测试运行
principles:             R6, R8
causes:                 []
caused_by:              []
similar_to:             DRAFT-appstream-1.2.0-ohos-meson-itstool-join-optional
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-ohos-docs-daps-optional.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R03（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.85
