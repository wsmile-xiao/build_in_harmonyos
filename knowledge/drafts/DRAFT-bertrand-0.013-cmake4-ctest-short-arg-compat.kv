#====================================================================
# DRAFT-bertrand-0.013-cmake4-ctest-short-arg-compat - 上游 shunit2/CTest
# 脚本使用旧短参 `ctest -N -o`，CMake 4.x 移除 -o → PATH 前置兼容包装
# 剥离 -o 后整脚本实跑（零源码修改）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-bertrand-0.013-cmake4-ctest-short-arg-compat
source_lib:             bertrand 0.013
trigger_tool:           ctest|cmake|shunit2|bash
phase:                  testing|configuration
error_signature:        CMake Error: Unknown argument: -o|ctest -N -o|ctest:.*-o.*not supported|Unknown argument.*-o

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               testing|cmake|ctest|compat|shunit2
match_keywords:         ctest -N -o, ctest, CMake 4, Unknown argument, -o, --output-on-failure, shunit2, Total Tests, CMake 4.x CLI, 短参数移除, compat wrapper, PATH
title:                  上游测试脚本使用旧短参 `ctest -N -o` 在 CMake 4.x 报 Unknown argument: -o 时，PATH 前置兼容包装剥离 -o 后整脚本实跑（零源码修改、断言不变）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  CMake 4.x 收紧 CTest CLI，移除旧短参数 `-o`（列表/计数场景由 -N 承担，
  输出选项改由 --output-on-failure 等长参表达）。上游测试脚本（常见于
  shunit2 套件）按旧版 CTest 编写，例如
  `ctest -N -o | grep -E '^Total Tests: [0-9]+'`，在新版直接报
  "CMake Error: Unknown argument: -o"，导致断言拿不到计数、整脚本失败。
  这不是库源码缺陷，而是上游测试脚本对 CTest CLI 版本的隐性依赖。
affected_scope: >
  任何上游测试脚本/套件使用 `ctest -N -o`（或其它已移除的 CTest 旧短参）
  且执行端 CMake ≥4.0 的 C++ 库；尤其 shunit2 驱动的安装/开关验证类脚本。
  对 -N 列表计数场景，剥离 -o 不改变语义，属安全兼容。

verification_cmd: >
  printf '#!/bin/sh\nfor a in "$@"; do [ "$a" = "-o" ] && continue; set -- "$@" "$a"; done\nexec /path/to/ctest "$@"\n' > compat-bin/ctest
  && chmod +x compat-bin/ctest && PATH="$(pwd)/compat-bin:$PATH" bash test/installation-tests.sh
  # 期望: 使用 ctest -N -o 的函数全部通过（Total Tests: 0 / 非 0 断言原样执行）

# ═══ Layer 3: 方案层 (Solution Space) ═══
rec_priority:           1
rec_approach:           path-compat-wrapper-strip-obsolete-flag
rec_description: >
  不修改上游测试源码、不产生补丁：在运行测试的 PATH 前置层放置一个
  ctest 兼容包装，仅剥离已移除的 `-o` 短参（其余参数原样转发到真实
  ctest）。上游脚本断言文本（如 `Total Tests: 0` / 非 0）原样执行，
  整脚本真实跑通。适用于 -N 列表计数类用法；若脚本依赖 -o 的旧输出行为
  （非常见），改用等价长参 --output-on-failure 并核对断言语义。
rec_command: >
  mkdir -p compat-bin && cat > compat-bin/ctest <<'EOF'
  #!/bin/sh
  # CMake 4.x removed ctest -o; strip it (upstream scripts use `ctest -N -o`)
  args=""
  for a in "$@"; do
    [ "$a" = "-o" ] && continue
    args="$args \"$a\""
  done
  eval exec /data/service/hnp/cmake.org/cmake_4.1.2/bin/ctest $args
  EOF
  chmod +x compat-bin/ctest && PATH="$(pwd)/compat-bin:$PATH" bash test/test-program-termination.sh
rec_auto_fix:           false
rec_impl:               runtime-compat-wrapper

fallback_priority:      2
fallback_approach:      long-flag-mapping
fallback_description:   若上游脚本语义依赖 -o 的输出（非仅计数），将 -o 映射为
                        --output-on-failure（等价长参）后再转发；仍失败则按
                        上游脚本真实版本依赖记录未运行项并附恢复条件。
fallback_command:       sed 's/ -o / --output-on-failure /g' 于包装内参数处理
fallback_auto_fix:      false
fallback_impl:          flag-mapping

forbid_1_pattern:       修改上游测试.*把失败写成通过|伪造 ctest.*输出|注释掉断言
forbid_1_reason:        断言必须真实执行；只允许修正工具参数兼容，不改变断言语义。

# ═══ Layer 4: 防护层 (Guard) ═══
guard_pattern:          ctest -N -o|ctest -o|Unknown argument.*-o
guard_check:            运行 shunit2/测试脚本遇 "Unknown argument: -o" 即命中本
                        模式：PATH 前置 compat 包装剥离 -o 后整脚本实跑。

# ═══ 知识协作 (Authorship & Provenance) ═══
authors:                pc4-21
source_lib:             bertrand 0.013
source_pr:              11960
source_commit:

# ═══ 质量度量 (Quality Metrics) ═══
metrics_success_count:  1
