#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E563.kv，填写各字段
# 对应的人类文档: doc/E563.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id: E563
trigger_tool: conan
phase: configuration
error_signature: ERROR: Invalid package version

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: conan, packaging, versioning, ohos
match_keywords: Invalid package version, single character, version slug, set_version, L0n, branch name gate, conan create, ConanName, 任务卡版本
title: Conan 拒绝单字符版本（ConanName 要求 >=2 字符）；任务卡单数字版本须目录保持任务卡值并用 set_version() 归一化制品版本

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: conan/api/model/refs.py 的 ref 校验正则 ^[a-z0-9_][a-z0-9_+.-]{1,100}$ 对第二字符组要求 1 到 100 次重复，使版本总长至少为 2，单字符版本（如任务卡版本 3）在 conan create 导出阶段即报 Invalid package version；而仓库 CI 的 L0n 分支门禁按「分支去前缀 == 包目录名-版本目录」精确匹配、平台按该分支名关联任务，版本目录又必须保留任务卡原值
affected_scope: 所有任务卡版本为单数字或单字符的上游包（如 rapidhash 3）；多字符但含大写的版本走 hfsm2 beta73 小写化先例，不适用本条
verification_cmd: conan create archives/r/rapidhash/3 -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=... 复现: ERROR: Invalid package version '3'（导出阶段立即失败，与源码无关）

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: dir-keeps-task-card-version-set-version-normalizes
rec_description: 归档目录与分支保持任务卡版本（过 L0n 精确匹配与平台关联）；配方不写字面 self.version 属性，改用 set_version() 把制品版本归一化为合规 slug（上游 tag 剥前缀如 rapidhash_v3 到 v3）；test_package/MANIFEST.yml 的 package 字段与制品版本对齐；notes 与版本级 manifest 留证目录-制品版本对应关系
rec_command: conanfile.py: def set_version(self): self.version = "v3"  # 上游 tag rapidhash_v3 剥前缀
rec_auto_fix: false
rec_impl: manual-edit

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: ^\s*version\s*=\s*["']3["']
forbid_1_reason: 字面单字符版本属性会在 conan create 导出阶段被 ConanName 校验拒绝
forbid_1_consequence: G2 conan create 必失败且与源码无关，易误判为配方其他问题
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

