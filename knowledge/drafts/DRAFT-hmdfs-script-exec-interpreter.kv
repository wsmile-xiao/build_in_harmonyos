#====================================================================
# DRAFT-hmdfs-script-exec-interpreter — HMDFS/SELinux 沙盒禁止直接执行脚本→解释器执行
# 触发事件: librsvg 2.62.3 HarmonyOS PC 适配（archives/l/librsvg/2.62.3）
# 主从明确：主根因=脚本执行限制；签名并发 os error 26 为附加 note
#====================================================================

id:                     DRAFT-hmdfs-script-exec-interpreter
trigger_tool:           meson|python3|clang|make
phase:                  configuration|compilation
error_signature:        cannot execute.*script|.*\.py: cannot execute|
                         find_program.*makedef.*NO|Text file busy.*os error 26

severity:               2
category:               filesystem|hmdfs|platform-limitation
match_keywords:         HMDFS, SELinux, 脚本执行, makedef.py, python3, wrapper,
                         binary-sign-tool, 签名并发
title:                  HMDFS/SELinux 沙盒禁止直接执行脚本；用"解释器+脚本路径"调用；签名并发用 CARGO_BUILD_JOBS=1

root_cause: >
  $HOME 挂载 HMDFS，沙盒/SELinux 禁止直接执行脚本文件（.py/.sh），meson
  find_program('meson/makedef.py', native: true) 找到文件但无法作为可执行程序运行，
  需改以"解释器+脚本路径"（find_program('python3', native: true) + files('script')）。
  附加 note（非主根因）：OHOS 自动签名与并行编译并发冲突，产生 Text file busy
  (os error 26)，用 CARGO_BUILD_JOBS=1 / CARGO_JOBS=1 限制并行规避；源自 2.62.2，
  本轮为复用 + CI 'Program python3 found: YES' 生效确认。
affected_scope: >
  OHOS 上一切以"脚本文件直接可执行"为假设的构建系统集成（meson find_program、
  shebang 直接调用、make 直接运行 .py/.sh）；以及并行构建与 OHOS 自动签名并发场景。
verification_cmd: >
  meson 日志 find_program('meson/makedef.py', native: true) → found: NO，
  或直接执行报 cannot execute；CI 日志 'Program python3 found: YES' 为解释器路径生效；
  并行构建报 Text file busy (os error 26) 为签名并发命中。

rec_priority:           1
rec_approach:           interpreter-invoke
rec_description: >
  find_program('python3', native: true) + files('script') 组合，以"解释器+脚本
  路径"调用（makedef_script = files('meson/makedef.py')）；并行构建限制
  CARGO_BUILD_JOBS=1 / CARGO_JOBS=1 规避签名并发。
rec_command: >
  python3_native = find_program('python3', native: true);
  makedef_script = files('meson/makedef.py');
  custom_target(..., command: [python3_native, makedef_script, ...])
rec_auto_fix:           false
rec_impl:               meson-interpreter-invoke

forbid_1_pattern:       直接 find_program('meson/makedef.py', native: true) 作为可执行文件
forbid_1_reason: >
  HMDFS 沙盒禁止直接执行脚本，即使 find_program 找到该文件，运行期仍无法执行；
  正确做法是探测解释器并把脚本作为解释器参数传入。
forbid_1_consequence:   meson 配置阶段 fail 或运行期 cannot execute

principles:             P016
similar_to:             E079 (HMDFS 硬链接，非脚本执行)
conflicts_with:
prerequisite_of:

doc_file:               knowledge/drafts/DRAFT-hmdfs-script-exec-interpreter.md
last_updated:           2026-08-14
source_event:           archives/l/librsvg/2.62.3（继承 2.62.2，本轮复用确认）

authors:
source_pr:
source_commit:          1639c2650d (feat/librsvg-2.62.3)

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-08-14
