#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E430.kv，填写各字段
# 对应的人类文档: doc/E430.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E430
trigger_tool: clang|cmake|make
phase: compilation
error_signature: no member named 'sort' in namespace 'std::ranges'|no member named 'find' in namespace 'std::ranges'|std::ranges::.*no member|__cpp_lib_ranges

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: platform, libcxx-stdlib, cplusplus, c++20
match_keywords: std::ranges, __cpp_lib_ranges, no member named, ranges::sort, ranges::find, reverse_view, erase-remove, libcxx-ohos, _LIBCPP_VERSION 15004
title: OHOS libc++ 15.0.4 的 <ranges> 头存在但算法成员整批缺失：std::ranges::sort/find/copy/transform 等全部 no member 编译错误

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: SDK 的 libcxx-ohos 中 <ranges> 头存在，但 __cpp_lib_ranges 未定义，std::ranges 命名空间的算法集（sort/find/copy/transform/unique/remove 等）整批缺失——命名空间在、算法不在，属硬平台约束（-stdlib=libc++ 单独探针同样编不过）。zeek 8.2.1 实测 47 文件 83+ 使用点，且经 .pac/.bif 模板源码链（Dict.h/telemetry）链式扩散全树报错。
affected_scope: 所有使用 std::ranges 算法的 C++20 软件，尤其是经模板间接命中时错误信息指向无关文件。
verification_cmd: clang -E -dM -x c++ - | grep __cpp_lib_ranges（未定义=命中）；最小探针 std::ranges::sort 编译应报 no member

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: rewrite-ranges-to-classic-stl
rec_description: 机械映射表改写为等价经典 STL：std::ranges::sort(v,cmp)→std::sort(v.begin(),v.end(),cmp)；reverse_view→反向迭代器；ranges::unique（返回对）→std::unique（单迭代器）；ranges::remove+begin（erase-remove 惯用法）→v.erase(std::remove(...),v.end())。派生陷阱（zeek 实测 P9）：机械改写时把原始 C 数组当容器用 .begin()/.end() 会再报 member reference base type 错误，C 数组须用 std::begin/std::end——改写后须全树 grep std::ranges:: 清零 + C 数组调用点专项复查。
rec_command: grep -rn 'std::ranges::' src/ auxil/ | wc -l（改写后应为 0）&& make
rec_auto_fix: false
rec_impl:               impl-name                   # 内置实现名 (见 DESIGN §5)

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
