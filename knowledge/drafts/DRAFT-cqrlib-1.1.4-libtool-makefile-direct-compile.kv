# ═══ Draft knowledge entry — cqrlib 1.1.4 libtool 手写 Makefile → 配方内直接编译 ═══
# Timestamp: 2026-09-09
# Software: cqrlib 1.1.4
# Gate: G2 (conan create) / 上游自检测试
# Status: UNMATCHED — needs human/AI review to promote to E-entry

id:                     DRAFT-cqrlib-1.1.4-libtool-makefile-direct-compile
trigger_tool:           make|libtool|conan|cc
phase:                  build|test|porting
error_signature:        'libtool: command not found|INSTALLDIR.*\$HOME|diff.*_orig\.lst.*No such|0 字节.*_orig\.lst'
severity:               2
category:               portability|build-system|makefile|libtool|test-oracle
match_keywords:         cqrlib, quaternion, libtool Makefile, INSTALLDIR HOME,
                         orig.lst empty, errorcount, header-only C++ template,
                         direct compile, no cmake, no autotools
title:                  cqrlib 1.1.4：libtool 手写 Makefile 小库的 OHOS 适配 —
                         配方内直接编译 + 自检测试 exit 判据（上游 diff 判据不可用）

root_cause: >
  cqrlib 是"单 cqrlib.c + 单 cqrlib.h"微型库，上游只有一份 2009 年起的手写
  Makefile：硬依赖 libtool（COMPILE_COMMAND 全走 $(LIBTOOL) --mode=*）、
  INSTALLDIR 默认 $HOME、install 目标附带现场编译 4 个 dynamic/static 测试并
  diff——沙箱/打包流程全不可用。其 make tests 的判据是运行测试程序后
  diff -b -c 对比 *_orig.lst，但 GitHub tarball 内两个 *_orig.lst 均为 0 字节
  占位 → diff 判据形式存在、实际不可用；真正的判据是程序自检返回值
  （CQRlibTest main 返回 errorcount）。
affected_scope: >
  任何"单/少源文件 + 手写 libtool/plain Makefile + 无 CMake/autotools"的小 C
  库（2000s 学术/工具类代码尤甚）迁移到 OHOS/无 libtool 的沙箱环境。
verification_cmd: >
  grep -n 'LIBTOOL' Makefile            # 硬依赖 libtool
  grep -n 'INSTALLDIR  =  $(HOME)' Makefile   # 装到 HOME
  wc -c CQRlibTest_orig.lst CPPQRTest_orig.lst  # 均 0 字节
  cc -O2 -fPIC -c cqrlib.c && ar rcs libCQRlib.a cqrlib.o
  cc -O2 -I. CQRlibTest.c libCQRlib.a -lm -o CQRlibTest && ./CQRlibTest   # exit 0
rec_priority:           1
rec_approach:           recipe-direct-compile + exit-selfcheck-tests
rec_description: >
  (a) 不走 libtool Makefile：build() 内用 conan conf compiler_executables 的
  clang 直接 -c 编译 + ar/-shared 出库；(b) 上游测试按真实判据执行：编译运行
  CQRlibTest.c（链库）与 CPPQRTest.cpp（不链库，测头内 C++ 模板），exit 非零
  即失败，body/MANIFEST 如实标注 diff 判据因 .lst 空占位不可用；(c) 打包
  cqrlib.h + libCQRlib，libs=["CQRlib"]（大小写敏感沿用上游）。
rec_command: >
  cc -O2 -fPIC -I<src> -c cqrlib.c -o cqrlib.o; ar rcs libCQRlib.a cqrlib.o
  cc -O2 -I<src> CQRlibTest.c libCQRlib.a -lm -o CQRlibTest && ./CQRlibTest
  c++ -O2 -I<src> CPPQRTest.cpp -lm -o CPPQRTest && ./CPPQRTest   # 不链库
rec_auto_fix:           true
rec_impl:               recipe-side-build

fallback_priority:      2
fallback_approach:      patch-libtool-makefile
fallback_description:   >
  给上游 Makefile 打补丁替换 INSTALLDIR/LIBTOOL 后硬跑；对沙箱仍脆弱
  （install 目标现场编译+diff），不建议。
fallback_command:       （patch Makefile 后 make all tests，需自带 libtool）
fallback_auto_fix:      false
fallback_impl:          portability-patch

forbid_1_pattern:       claim.*diff.*orig\.lst.*passed|make tests.*全过
forbid_1_reason:        '*_orig.lst 是 0 字节占位，diff 判据不可用，谎称通过即覆盖伪造。'
forbid_1_consequence:   评审/审计当场识破，知识条目作废。
forbid_2_pattern:       CPPQRTest.*-lCQRlib
forbid_2_reason:        CPPQRTest 测的是头内 header-only C++ 模板，上游 Makefile 不链库。
forbid_2_consequence:   测试语义偏离上游，模板路径缺陷测不出。
forbid_3_pattern:       libtool.*--mode|INSTALLDIR.*HOME.*unchanged
forbid_3_reason:        沙箱无 libtool、$HOME 不可作安装前缀，硬跑上游 Makefile 必败。
forbid_3_consequence:   构建期失败。

