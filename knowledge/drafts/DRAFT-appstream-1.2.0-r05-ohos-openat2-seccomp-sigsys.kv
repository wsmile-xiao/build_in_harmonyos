#====================================================================
# DRAFT-appstream-1.2.0-r05-ohos-openat2-seccomp-sigsys.kv
# OHOS seccomp 对 openat2() 直接落杀（SIGSYS，rc=159）而非返回错误码，
# 能力探针自身被信号杀死 —— 探针包 SIGSYS handler + sigsetjmp 防护，
# 被打断时回退用户态路径解析
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R05）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           asc-directory-unit (openat2 path resolution)
phase:                  runtime-syscall
error_signature:        exit code 159|SIGSYS|killed.*signal 31|openat2.*SIGSYS|
                        DirectoryUnit.*159|seccomp.*openat2
severity:               2
category:               syscall, seccomp, SIGSYS, openat2, capability-probe, portability
match_keywords:         openat2, SIGSYS, seccomp, sigsetjmp, capability probe,
                        asc_openat2_usable, path resolution, OHOS, 159
title:                  seccomp 落杀型平台：能力探针包 SIGSYS handler + sigsetjmp 回退
root_cause:             OHOS seccomp 对 openat2(SYS_openat2) 直接以 SIGSYS 杀死进程，
                        而非返回 ENOSYS/EPERM；探针假定"调用失败返回错误码"，探针即死。
affected_scope:         在 seccomp 落杀（SIGSYS）型平台上做 syscall 能力探测的代码。
verification_cmd:       conan create appstream 1.2.0 -pr:h=ohos-aarch64 -pr:b=ohos-aarch64
                        --build=missing；as-test_compose DirectoryUnit/Escape 通过 rc=0。
rec_priority:           1
rec_approach:           sigsys-guarded-capability-probe
rec_description:        探针执行前安装 SIGSYS handler，用 sigsetjmp 记录现场；
                        handler 内 siglongjmp 回探针；被打断则视为"不可用"，
                        回退用户态等价实现（路径解析等）。
rec_command:            |
  static sigjmp_buf env;
  static void on_sigsys (int sig) { siglongjmp (env, 1); }
  if (sigsetjmp (env, 1) == 0)
      fd = asc_openat2 (AT_FDCWD, ".", ASC_O_LOOKUP);
  else
      probe_died = TRUE;   /* openat2 被 seccomp 拦截 → 回退 userspace */
  sigaction (SIGSYS, &old_sa, NULL);
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       EXCLUDE_LIST.*openat2
forbid_1_reason:        仅排除会导致路径解析能力静默丢失；须先探针防护并回退等价实现
principles:             R6
causes:                 []
caused_by:              []
similar_to:             E051
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-r05-ohos-openat2-seccomp-sigsys.md
last_updated:           2026-09-25
source_event:           appstream-1.2.0 R05（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.9