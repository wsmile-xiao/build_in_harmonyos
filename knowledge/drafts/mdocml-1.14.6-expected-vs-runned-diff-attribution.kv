#====================================================================
# Draft: mdocml 1.14.6 - 上游测试期望文件数与实跑数不等时的差额归因
#        口径（rule4 少报防线）：期望 .out_* 1189 vs 实跑 1427 本就不同
#        量纲；类内差额必须定位到具体文件——lint 249 vs 248 的差 1 =
#        mdoc/Xr/args 被上游 regress.pl 的 "# OpenBSD only" 解析边界
#        有意排除，utf8 26 vs 21 的差 5 = UTF8_TARGETS 注册面收窄
#====================================================================

id:                     DRAFT-MDOCL-1146-EXPECTED-VS-RUNNED-DIFF-ATTRIBUTION
trigger_tool:           'conan|make'
phase:                  'testing'
error_signature:        'NUMBER OF FAILED TESTS|tests run\.|rule4|少报|实测 N > 声明 N|LINT_TARGETS|UTF8_TARGETS|OpenBSD only|parse error'

severity:               3
category:               'test-count|audit|portability|workflow'
match_keywords:         'regress, tests run, expected, out_lint, out_utf8, LINT_TARGETS, UTF8_TARGETS, REGRESS_TARGETS, OpenBSD only, parse_makefile, last if, rule4, underreport, 差额, 归因, 计数口径, 手写 Makefile, 测试清点, assertion_count'

title:                  '上游测试「期望文件数」与「实跑 tests run」本就不同量纲，类内差额必须定位到具体文件再提审：注册面收窄（UTF8_TARGETS）与 Makefile 解析边界（# OpenBSD only）是两类可复用成因'

root_cause:             'rule4 红线是「实测 N > 声明 N」即少报，但上游测试的三个计数量纲互不相等：输入文件数、期望输出文件数、驱动程序实跑的 tests run 数。mandoc/mdocml 1.14.6 实测：输入 .in 572、期望 .out_* 1189（ascii565/markdown253/lint249/html68/tag28/utf826）、实跑 tests run 1427（ascii565+tag28+man244+utf821+html68+markdown253+lint248）——man 类 244 没有独立期望文件，它是把 -T man 产物再用 mandoc 以 -man -T ascii 回读后与 .out_ascii 比对，所以实跑可以大于期望文件数。真正的风险是「期望文件存在但驱动不跑」这类静默差额，它让声明数与审方独立清点数对不上。本例两类成因都可精确定位：(1) lint 期望 249 vs 实跑 248，差 1 = mdoc/Xr/args —— 其 LINT_TARGETS 写在 mdoc/Xr/Makefile 第 5 行 # OpenBSD only 注释（原文 target tests cause too much trouble elsewhere）之后，而上游 regress.pl 的 parse_makefile 有 last if /^# OpenBSD only/ 提前终止解析，于是该项被上游有意不注册、不跑，期望文件 args.out_lint 与输入 args.in 却都还在；(2) utf8 期望 26 vs 实跑 21，差 5 = char/unicode 目录的 UTF8_TARGETS 只注册 ascii invalid man mdoc namediff 五项，其余 input/latin1/latin1diff/named/nogroff 有期望文件但不在注册面。ascii/tag/html/markdown 四类零差额。定位手段不是猜：按 perl 的解析口径（含 last if 边界）重算注册集，再与实跑产物集合（*.mandoc_lint 等）做 comm 双向差集，差集恰好只剩那一项即闭环。'
affected_scope:         '所有用手写 Makefile + perl/shell 驱动逐文件比对的上游测试套件（mandoc regress、groff/tbl 同族、以及任何 expected-golden 目录形态）；以及一切需要在 PR 正文申报上游测试数 N 的任务——差额未归因就提审会在 W4 或外部审查被判少报返工。'
verification_cmd:       'find regress -type f -name "*.out_*" | wc -l ; grep -E "tests run|NUMBER OF FAILED" regress.log ; comm -23 lint_expected.txt lint_registered.txt ; comm -23 lint_expected.txt lint_ran.txt'

rec_priority:           2
rec_approach:           'attribute-every-delta-to-a-concrete-file-before-submission'
rec_description:        '申报上游测试数前先做三步对账，任何一步对不上都要定位到具体文件名才允许提审：第一步分栏清点——输入文件（*.in / *_test.c / TESTS 列表）与期望输出文件（*.out_* / golden / expected）分别计数，两者与驱动程序实跑的 tests run 是三个不同量纲，不要互相替代，也不要用其中任何一个去凑任务卡上的约数；第二步算类内差额——逐类别（ascii/lint/utf8/html…）把期望文件数与实跑数相减，零差额的类别直接记零，非零差额必须给出文件名与成因；第三步用「解析口径复算 + 产物集合差集」闭环，不要靠肉眼：按驱动程序真实的解析规则（含注释边界、跳过声明、SKIP_* 变量）重算注册集，再与实跑产物（*.mandoc_lint / *.mandoc_ascii 等中间产物文件）做 comm 双向差集，差集恰好等于第二步给的文件名才算归因完成。本例两个可复用成因：① 手写 Makefile 里注释边界会截断解析——perl parse_makefile 的 last if 某注释行让写在其后的 LINT_TARGETS 整段失效，属于上游有意排除而非平台失败，要在 notes 里写明「上游有意不注册」并引原文注释；② 注册面收窄——UTF8_TARGETS / SKIP_* 显式列举法只跑子集，期望文件多于实跑是设计使然，同样要写明差额文件清单。方向判据要写进正文：rule4 红线是实测大于声明（少报），若声明来自任务卡约数且大于实测（本例 1468 vs 1189）则方向安全、不存在少报风险，但约数不是判据，判据是实测两栏加取数命令；约数与任何实测集合都对不上时如实写「差额无对应集合」，不要硬凑解释。'
rec_command:            'find regress -type f -name "*.out_*" | sed "s/.*\.out_//" | sort | uniq -c ; grep -E "tests run|NUMBER OF FAILED" regress.log ; for f in $(find regress -name Makefile); do awk "/# OpenBSD only/{exit} /^LINT_TARGETS/{print}" "$f"; done | wc -l'
rec_auto_fix:           false

# ═══ 知识协作 (Authorship & Provenance) ═══
source_pr:              pending
source_commit:          pending
