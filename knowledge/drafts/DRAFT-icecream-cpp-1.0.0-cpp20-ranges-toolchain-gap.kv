#====================================================================
# DRAFT-icecream-cpp-1.0.0-cpp20-ranges-toolchain-gap - OHOS SDK clang15
# libc++ 缺 C++20 std::views（<ranges>）：依赖 ranges 的上游测试硬阻塞归类
#
# 场景: icecream-cpp 1.0.0 在 OHOS PC aarch64（OHOS SDK 26.0.0.18,
#       clang 15.0.4, libcxx-ohos）上编译官方上游测试 test_c++20.cpp:
#       `namespace rv = std::views;` 报 error: expected namespace name。
#       最小探针 #include <ranges> + std::views 同样失败。属工具链缺项
#       （libc++ 未提供 C++20 <ranges> views），非库缺陷。
# 适用: 依赖 C++20 ranges/views 的上游测试在 OHOS 工具链上的处理模式。
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     DRAFT-icecream-cpp-1.0.0-cpp20-ranges-toolchain-gap
source_lib:             icecream-cpp 1.0.0
trigger_tool:           clang++|cmake|conan create
phase:                  test|compilation
error_signature:        error: expected namespace name|namespace rv = std::views|std::views|#include <ranges>

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               3
category:               toolchain|testing|platform|libc++
match_keywords:         std::views, std::ranges, <ranges>, C++20, libc++, libcxx-ohos, clang15, toolchain, expected namespace name, range adaptor, transform, filter, OHOS SDK
title:                  OHOS SDK clang15 libc++ 缺 C++20 std::views：ranges 依赖测试硬阻塞归类与头文件守卫检查

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause: >
  OHOS SDK 26.0.0.18 自带 libc++（libcxx-ohos/include/c++/v1）未提供 C++20
  <ranges> views（std::views 命名空间缺失），#include <ranges> 后
  `namespace rv = std::views;` 报 expected namespace name。工具链限制：
  库本体若用 __cpp_lib_ranges 守卫 ranges 用法则仍可正常编译（icecream.hpp
  实测 C++23 用例通过），仅直接依赖 std::views 的测试文件编译失败。
affected_scope:         OHOS/HarmonyOS（SDK 26.0.0.18 clang15/libc++) 上依赖 C++20 ranges 的上游测试与库
verification_cmd:       printf '#include <ranges>\nnamespace rv = std::views;\n' | clang++ -std=c++20 -x c++ -fsyntax-only -

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           toolchain-gap-ledger-blocked
rec_description: >
  (1) 全量枚举测试入口后如实尝试运行；对依赖 std::views 的用例标记
      blocked_toolchain，台账写明首个错误/命令/退出码/恢复条件；
      (2) 恢复条件=OHOS 工具链升级至含 C++20 <ranges> 的 libc++ 后重跑；
      (3) 配方侧：头文件库若无需编译产物，可在 BUILD_TESTING=OFF 下由
      test_package 承担消费者验证（R34 实质调用）；头文件 ranges 用法
      应确认以 __cpp_lib_ranges 守卫，避免拖垮整库编译。
rec_command:            >
  clang++ -std=c++20 -I <src> tests/test_c++20.cpp
rec_auto_fix:           false
rec_impl:               ledger-categorize|profile-check

# 回退方案
fallback_priority:      2
fallback_approach:      toolchain-upgrade
fallback_description:   若平台后续提供含 <ranges> 的新 SDK/libc++，重跑原测试即恢复；无需库侧改动
fallback_auto_fix:      false
fallback_impl:          none

# ═══ Layer 4: 证据层 (Evidence) ═══
evidence: >
  icecream-cpp 1.0.0: tests/test_c++20.cpp:32 `namespace rv = std::views;`
  → `error: expected namespace name`（日志 任务日志目录
  $TMPDIR/icecream-cpp-r01-logs/upstream-test-c++20-c++20.log.compile）；最小探针
  <ranges>+std::views 复现；同工具链 -std=c++23（c++2b）下 test_c++23 通过、
  icecream.hpp 自身 ranges 用法由 __cpp_lib_ranges 守卫（无编译错误）。

# 查重结论 (Path B 必需)
dedup_conclusion: >
  index.tsv E292 含 ranges 关键字但为 Arrow 分层 ctest 迁移场景（不同）；
  doc/、graph、drafts（66 条）均无 OHOS libc++ 缺 std::views 条目
  → 未命中，新建本条草稿（路径 B）。
related_entries:        E292