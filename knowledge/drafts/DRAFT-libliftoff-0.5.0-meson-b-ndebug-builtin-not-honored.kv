caused_by:              []
similar_to:             [E259, DRAFT-taocpp-tuple-1.0.0-ndebug-werror-upstream-test-debug-build, DRAFT-libnih-1.0.3-ndebug-assert-sideeffect-hoist, embedmq-1.0.1-ndebug-assert-control-flow-test]
