#====================================================================
# Draft knowledge entry - libmysofa OHOS cross sysroot libm injection
# Source package: libmysofa/1.3.5
#====================================================================

id:                     DRAFT-libmysofa-1.3.5-ohos-cross-sysroot-libm-injection
trigger_tool:           conan|cmake|clang
phase:                  configuration|generation|linking
error_signature:        MATH.*NOTFOUND|find_library\(MATH m\)|linked by target.*NOTFOUND|libm\.a

severity:               3
category:               cmake, toolchain, linking, libm, ohos, cross-compile
match_keywords:         find_library, MATH, libm, NOTFOUND, sysroot, OHOS, aarch64-linux-ohos, cross compile, CMakeToolchain, cache variable, arm-linux-ohos
title:                  OHOS cross toolchain: CMake find_library(m) NOTFOUND, inject sysroot libm.a via CMakeToolchain variable

root_cause:             On OHOS cross builds the conan profile only injects
                        compiler_executables (no CMAKE_SYSROOT /
                        CMAKE_FIND_ROOT_PATH), so CMake's find_library(m) does
                        not search the OHOS SDK sysroot (usr/lib/<arch>-linux-ohos/)
                        and leaves MATH=NOTFOUND, failing configure for any
                        upstream CMakeLists.txt that does `find_library(MATH m)`.
                        This is the reverse of E376 (which applies when the
                        target links without a separate libm): here libm.a
                        genuinely exists in the sysroot and IS required.
affected_scope:         Every CMake C/C++ library whose CMakeLists.txt uses
                        find_library(MATH m) or FindMath-style lookup when built
                        as a conan package with the ohos-aarch64 profile
                        (aarch64/armv7/x86_64-linux-ohos sysroot dirs).
verification_cmd:       conan create . -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64

rec_priority:           1
rec_approach:           sysroot-libm-cache-injection
rec_description:        In conanfile.py generate(): when settings.os == "OHOS",
                        glob the OHOS SDK sysroot (e.g.
                        /data/service/hnp/ohos-sdk.org/*/ohos/native/sysroot),
                        map settings.arch -> {armv8: aarch64-linux-ohos,
                        armv7: arm-linux-ohos, x86_64: x86_64-linux-ohos},
                        and if sysroot/usr/lib/<arch>-linux-ohos/libm.a exists
                        set tc.variables["MATH"] to that absolute path. This is
                        a narrow recipe/toolchain cache binding (same spirit as
                        E376) but injects the real required libm instead of an
                        empty binding, which E376 explicitly forbids for this
                        case (its empty-cache is only valid when the target
                        links math symbols without a separate library).
rec_command:            glob.glob("/data/service/hnp/ohos-sdk.org/*/ohos/native/sysroot") -> tc.variables["MATH"] = sysroot/usr/lib/<arch_dir>/libm.a
rec_auto_fix:           true
rec_impl:               conan-toolchain-cache-binding

fallback_priority:      2
fallback_approach:      cmake-find-root-path
fallback_description:   Alternatively set CMAKE_FIND_ROOT_PATH/CMAKE_SYSROOT to
                        the sysroot so find_library(m) discovers libm itself;
                        prefer the narrow MATH cache binding to avoid affecting
                        other find_* lookups in the same configure.
fallback_command:       tc.variables["CMAKE_FIND_ROOT_PATH"] = <sysroot>
fallback_auto_fix:      true
fallback_impl:          conan-toolchain-cache-binding

prescan_pattern:        find_library\(MATH|FindMath|libm\.a
