#====================================================================
# E429-draft-1F8C.kv — Conan PkgConfigDeps 不生成依赖包内的额外 .pc 组件
# 触发编译事件: libmbim-tools 1.34.0 适配（meson + glib/2.84.0.1，
#   meson.build 中 dependency('gio-unix-2.0')）
# Status: DRAFT — 待主编审核后 promote 为正式条目
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E429
trigger_tool:           meson|conan|pkg-config
phase:                  configuration
error_signature:        Dependency "gio-unix-2\.0" not found|gio-unix-2\.0.*not found|Run-time dependency gio-unix-2\.0 found: NO|pkg-config.*gio-unix-2\.0.*No such file

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               build-system, meson, dependency
match_keywords:         gio-unix-2.0, PkgConfigDeps, glib, meson dependency not found, pkg_config_path, conan_meson_native.ini, extra component pc, meson
title:                  Conan PkgConfigDeps 只生成依赖配方已声明的组件 .pc；meson 找不到依赖包内的额外 .pc（典型：glib 的 gio-unix-2.0.pc）

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             Conan 的 PkgConfigDeps 依据依赖包的 package_info 组件（cpp_info.components）
                        生成 .pc。glib 配方只声明 glib-2.0/gobject-2.0/gio-2.0/gmodule-2.0/
                        gthread-2.0 等组件，因此不生成 gio-unix-2.0.pc——即使该 .pc 实际
                        存在于 glib 包的 lib/pkgconfig。meson.build 里 dependency('gio-unix-2.0')
                        在仅把 generators_folder 放进 PKG_CONFIG_PATH 时找不到它，配置期报
                        "Dependency gio-unix-2.0 not found"。
affected_scope:         任何用 meson dependency() 请求“依赖包自带、但消费侧配方未声明为组件”的 .pc 的
                        软件；glib 系的 gio-unix-2.0 最常见，其他库的非默认 component .pc 同理
                        （libmbim / libqmi / ModemManager 系、任何 gio-unix 使用者）
verification_cmd:       find "$(conan cache path glib/2.84.0.1)" -name 'gio-unix-2.0.pc'  # 依赖包内存在
                        ls <build>/conan/*.pc | grep gio-unix                          # generators 内缺失

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           meson-pkg-config-path-inject
rec_description:        在 conanfile 的 generate() 里把各依赖包的 lib/pkgconfig（及 share/pkgconfig）
                        加上 generators_folder 一并写进 meson machine file 的 [properties]
                        pkg_config_path，并同时 prepend PKG_CONFIG_PATH；meson 的 dependency()
                        即可命中依赖包自带的额外 .pc。先例 archives/a/accountsservice/26.27.3。
rec_command:            pkg_config_path = ['<generators_folder>', '<dep>/lib/pkgconfig', ...]
                        （写入 conan_meson_native.ini 的 [properties]；PKG_CONFIG_PATH 同步注入）
rec_auto_fix:           false
rec_impl:               conanfile-generate

fallback_priority:      2
fallback_approach:      disable-optional-dependency
fallback_description:   只有当该 .pc 对应的是可选功能时，才可显式关闭对应 meson 选项
                        （如 -Dintrospection=false 关闭 gobject-introspection）。gio-unix-2.0
                        在本场景为必需，不能关。
fallback_auto_fix:      false
fallback_impl:          configure-option

# ★ 禁止策略 ★
forbid_1_pattern:       rm.*gio-unix|sed.*gio-unix.*-delete|mv.*gio-unix.*\.pc
forbid_1_reason:        不要删除/改名依赖包内的 .pc 文件，应通过 pkg_config_path 让其可见
forbid_1_consequence:   meson configure 因缺依赖直接失败，或掩盖真实依赖

# ═══ Layer 4: 原则引用 ═══
principles:

