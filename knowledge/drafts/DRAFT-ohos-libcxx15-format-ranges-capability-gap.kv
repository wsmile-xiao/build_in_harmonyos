#====================================================================
# DRAFT-ohos-libcxx15-format-ranges-capability-gap.kv
# OHOS SDK26 libc++15: <format> 为空 stub（_LIBCPP_HAS_NO_INCOMPLETE_FORMAT）
# 且 ranges 内存算法缺失（_LIBCPP_HAS_NO_INCOMPLETE_RANGES）
# 触发事件: microsoft-proxy 4.0.1 HarmonyOS PC 适配（patch 0001）
#====================================================================

id:                     DRAFT-ohos-libcxx15-format-ranges-capability-gap
trigger_tool:           clang|conan|cmake
phase:                  compilation
error_signature:        no member named 'formatter' in namespace 'std'|
                         no member named 'uninitialized_copy' in namespace 'std::ranges'|
                         no member named 'format_context' in namespace 'std'|
                         no member named 'basic_format_parse_context' in namespace 'std'|
                         _LIBCPP_HAS_NO_INCOMPLETE_FORMAT|
                         _LIBCPP_HAS_NO_INCOMPLETE_RANGES

severity:               3
category:               libcxx, toolchain, compat, cxx20, portability, libc
match_keywords:         std::formatter, std::format, std::format_context, __has_include,
                         __cpp_lib_format, std::ranges::uninitialized_copy, format stub,
                         libc++, libcxx-ohos, OHOS SDK, clang 15, ranges algorithm,
                         C++20, memory_resource
title:                  OHOS libc++15 定义 _LIBCPP_HAS_NO_INCOMPLETE_FORMAT/RANGES：<format> 为空 stub、ranges 内存算法不可用——用 __cpp_lib_format 特性宏守卫 + 经典算法替换

root_cause: >
  OHOS SDK26（ohos-sdk_26.0.0.18）配套 libc++ 15.0.4 在 include/c++/v1/__config 中定义
  _LIBCPP_HAS_NO_INCOMPLETE_FORMAT 与 _LIBCPP_HAS_NO_INCOMPLETE_RANGES：官方的 <format> 头
  存在但其全部实现被 #if 关闭（成为空 stub），std::ranges::uninitialized_copy/for_each
  等 ranges 内存算法整体不可用；同时不提供 <memory_resource> 头。用 __has_include(<format>)
  探测会误判"可用"（头存在但无声明），导致依赖完整 C++20 标准库的 header-only 库
  （如 microsoft/proxy、fmt-adjacent 库）编译在 OHOS 上与使用完整 libc++ 的 CI 行为不同。
affected_scope: >
  目标 OHOS SDK26 clang15/libc++15 的所有 C++20 项目：include <format> 的库、直接使用
  std::ranges 内存算法（uninitialized_copy/uninitialized_default_construct 等）的库、
  依赖 <format> 隐式传递引入 <string_view> 的代码；gtest 上游测试中引用 std::format
  的用例也命中。
verification_cmd: >
  /data/service/hnp/bin/clang++ -std=c++20 -c probe.cpp   # 复现 std::formatter 缺失
  修复后: conan create . -pr:h ohos-aarch64 -pr:b default --build=missing -> exit 0

rec_priority:           1
rec_approach:           cpp-lib-format-guard-plus-classic-algorithms
rec_description: >
  ①把 `#if __has_include(<format>)` 全部改为标准特性宏
  `#if defined(__cpp_lib_format) && __cpp_lib_format >= 202110L`
  （OHOS libc++ 不定义该宏，format skill 自动禁用，符合标准语义）；
  ②`std::ranges::uninitialized_copy(a, b)` 换成等效经典算法
  `std::uninitialized_copy(std::begin(a), std::end(a), b)`
  （经典算法在 OHOS libc++ 中存在）；③若库依赖 <format> 隐式传递的
  <string_view>，补直接 include。补丁属 libc 能力探测类（R8 例外），非平台宏，
  完整 libc++ 工具链同样可编译（行为不变）。
rec_command:            >
  # patch 0001（microsoft-proxy 4.0.1 验证通过）：
  #   sed 将 proxy.h 4 处 __has_include(<format>) -> defined(__cpp_lib_format) && >= 202110L
  #   5 处 std::ranges::uninitialized_copy -> std::uninitialized_copy(std::begin(..), std::end(..), ..)
rec_auto_fix:           false
rec_impl:               recipe-patch-portable-format-ranges

fallback_priority:      2
fallback_approach:      upgrade-sdk-toolchain
fallback_description:   等 OHOS SDK 提供 libc++17+（format/ranges 全量落地）整体升级工具链；
                         但 SDK15 当前为可用基线，升级依赖 SDK 发布。
fallback_command:
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       -std=c\+\+17.*replace.*-std=c\+\+20|drop.*cppstd=20
forbid_1_reason:        降级语言标准改变 ABI/语义并掩盖 C++20 依赖
forbid_1_consequence:   其他 C++20 特性不可用，语义漂移
forbid_2_pattern:       define.*_LIBCPP_HAS_NO_INCOMPLETE_FORMAT.*0|undef.*_LIBCPP_HAS_NO
forbid_2_reason:        试图命令行/代码内撤销 libc++ 能力标记会改变 STL 内部配置，
                         产生未定义 ABI 行为
forbid_2_consequence:   二进制不兼容、CI 与本地行为不一致

principles:             P005, P011
similar_to:             E130, E191, E306, E455, DRAFT-libcxx15-missing-cpp20-spaceship
conflicts_with:
prerequisite_of:

