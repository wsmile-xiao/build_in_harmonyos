#====================================================================
# DRAFT-libfyaml-0.9.6-pkgm4-pkgcheck-unexpanded
# pkg.m4 缺失 -> PKG_CHECK_MODULES 宏未展开 -> configure shell 语法错误
# 触发: libfyaml 0.9.6 HarmonyOS PC 适配（archives/l/libfyaml/0.9.6）
# 完整叙事与证据见同目录 .md
#====================================================================

id:                     DRAFT-libfyaml-0.9.6-pkgm4-pkgcheck-unexpanded
trigger_tool:           configure
phase:                  configuration
error_signature:        syntax error: unexpected 'LIBYAML,'|
                         PKG_CHECK_MODULES\([A-Z_]+,.*unexpanded|
                         configure\[[0-9]+\]: syntax error: unexpected
severity:               2
category:               autotools, configure, pkg-config, aclocal
match_keywords:         pkg.m4, PKG_CHECK_MODULES, unexpanded, aclocal, bootstrap,
                         autoreconf, configure, syntax error, pkg-config, m4
title:                  pkg.m4 缺失使 PKG_CHECK_MODULES 宏未展开，configure 残留宏文本报 shell 语法错误；复制 pkg.m4 到源码树 m4/ 后重跑 bootstrap 即可
root_cause:             PKG_CHECK_MODULES 定义于 pkg-config 自带 pkg.m4。autoreconf 生成
                        configure 时 aclocal 找不到 pkg.m4（源码树 m4/ 无、系统 aclocal
                        目录不在隐式搜索路径），宏未展开原样残留，/bin/sh 解析报
                        "syntax error: unexpected 'LIBYAML,'"。上游 tag 压缩包不含生成
                        configure、需 bootstrap 现场生成时必现。
affected_scope:         所有 Autotools 项目中 configure.ac 使用 PKG_CHECK_MODULES 系列宏、
                        且 tag 包无 configure、构建环境 pkg-config 不在 aclocal 隐式路径
                        （如 /data/service/hnp 非标准安装根）
verification_cmd:       grep -c PKG_CHECK_MODULES configure;   # 期望 0
                        grep -c 'AC_DEFUN.*PKG_CHECK_MODULES' m4/pkg.m4   # 期望 >=1
rec_priority:           1
rec_approach:           copy-pkgm4-into-m4
rec_description:        将 pkg-config 安装目录下 share/aclocal/pkg.m4 复制到源码树 m4/pkg.m4，
                        重新运行 bootstrap.sh 生成 configure（宏被正确展开），再 configure。
                        Conan 配方场景：export_sources 携带 pkg.m4，build() 内先复制到
                        source_folder/m4/pkg.m4 再 sh bootstrap.sh，最后应用 config.guess/
                        config.sub 补丁（补丁须在 bootstrap 之后应用，autoreconf 会覆盖）。
rec_command:            |
  cp /data/service/hnp/pkg-config.org/pkg-config_0.29.2/share/aclocal/pkg.m4 m4/pkg.m4
  sh bootstrap.sh
  grep -c PKG_CHECK_MODULES configure   # 0 = 展开成功
  ./configure --prefix=$DEFAULT_PREFIX
rec_auto_fix:           true
rec_impl:               copy-file-into-m4
forbid_1_pattern:       --build=*|--host=*
forbid_1_reason:        交叉编译绕过会误判 build host，AC_RUN_IFELSE 等运行时检测被跳过
similar_to:             E089|E468|DRAFT-pkgm4-preset-nonempty-gate
caused_by:
conflicts_with:
prerequisite_of:
principles:
doc_file:               knowledge/drafts/DRAFT-libfyaml-0.9.6-pkgm4-pkgcheck-unexpanded.md
last_updated:           2026-09-06
source_event:           archives/l/libfyaml/0.9.6

