#====================================================================
# E639-draft-2264 — 知识图谱条目
# spdlog 制品的 cpp_info.includedirs 含 include/spdlog，使
# `#include <fmt/ranges.h>` 解析到 spdlog 自带的 shim
# spdlog/fmt/ranges.h（自包含守卫吞掉真 fmt 头）→ fmt::join 未声明
# 触发事件: j4-dmenu 3.2 HarmonyOS PC 适配
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E639
trigger_tool:           conan|conan create|clang|gcc|cmake
phase:                  compilation
error_signature:        no member named 'join' in namespace 'fmt'|fmt::join.*undeclared|'join' is not a member of 'fmt'|error: no matching function for call to 'join'

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               conan, headers, c++, dependency, compilation
match_keywords:         include/spdlog, includedirs, cpp_info, fmt/ranges.h, fmt::join, spdlog/fmt, shim header, pragma once, include order, header shadowing, external fmt, SPDLOG_FMT_EXTERNAL, CMakeDeps
title:                  spdlog 包把 include/spdlog 列为 include 路径，使 <fmt/ranges.h> 命中 spdlog 自带 shim，真 fmt 头被 #pragma once 吞掉导致 fmt::join 未声明

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             >
  spdlog 仓库为避免依赖外部 fmt，在 include/spdlog/fmt/ 下自带一套转发 shim
  （bundled/fmt/ranges.h 与 fmt/ranges.h 同构）。ohpcd 的 spdlog 制品把
  cpp_info.includedirs 设为包含 include 与 include/spdlog 两项，编译命令里于是
  出现 `-isystem .../spdlog/include/spdlog`。此后 `#include <fmt/ranges.h>`
  先在该目录命中 spdlog 的 shim；shim 自身带 #pragma once 且不转发到真 fmt
  头，等于把真正的 fmt/ranges.h 吞掉，最终 fmt::join 等仅由真 fmt 头声明的
  符号全部未声明。根因是"依赖把自己的 include 根目录暴露过深 + 与同名第三方
  头目录重名"的路径遮蔽，与 fmt 版本漂移无关（错以为是 10→12 跨版本 API 变更
  是常见误诊）。
affected_scope:         所有直接把 `#include <fmt/...>` 与 spdlog 一起使用、且 spdlog
                        制品的 includedirs 含 include/spdlog 的 C++ 工程；静态/动态链接
                        无关（纯编译期头解析问题）；只要 include 路径顺序让
                        include/spdlog 先于 fmt 的 include 根生效即命中
verification_cmd:       编译命令中 grep '-isystem .*spdlog/include/spdlog' 有命中即可疑；
                        进一步 grep -rn 'pragma once' <spdlog包>/include/spdlog/fmt/ranges.h
                        确认 shim 自包含：shim 不含指向外部 fmt 的 include 即坐实遮蔽

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           narrow-dependency-includedirs-in-generate
rec_description:        在配方 generate() 中把 spdlog 的 cpp_info.includedirs 覆盖为仅
                        <spdlog包目录>/include（保留 spdlog 头可用，同时移除
                        include/spdlog 这层多余根，使 <fmt/...> 一律解析到 fmt 包）
rec_command:            self.dependencies["spdlog"].cpp_info.includedirs = [os.path.join(self.dependencies["spdlog"].package_folder, "include")]
rec_auto_fix:           false
rec_impl:               narrow-dependency-includedirs-in-generate

fallback_priority:      2
fallback_approach:      cmake-toolchain-include-order
fallback_description:   若不便覆盖 includedirs，可在 toolchain 中把 fmt 的 include 根
                        前置于 spdlog 的 include/spdlog 之前（CMAKE_CXX_FLAGS 前置 -isystem，
                        或调换依赖顺序），使真 fmt 头先命中；属于顺序兜底，语义不如方案 1 干净
fallback_command:       tc.variables["CMAKE_CXX_FLAGS"] = f"-isystem {fmt_include} " + prev_flags
fallback_auto_fix:      false
fallback_impl:

forbid_1_pattern:       .*SPDLOG_FMT_EXTERNAL.*(0|OFF|False)|.*define.*SPDLOG_USE_STD_FORMAT
forbid_1_reason:        用宏把 spdlog 切到 bundled-fmt 分支并不能解决 <fmt/ranges.h> 被遮蔽——
                        工程本身仍要真 fmt 头；且会引入 spdlog 与 fmt 两套 fmt 定义共存的 ODR 风险
forbid_1_consequence:   编译期看似通过，运行期或跨 TU 内联时出现 fmt 符号不一致 / ODR 违例

# ═══ Layer 4: 原则引用 ═══
principles:

