#====================================================================
# DRAFT-ohos-conan-copy-fnmatch-anchored — conan copy() 的 pattern 用
#   fnmatch 锚定全路径匹配：* 不跨目录分隔符，子目录产物需 ** 或前导 *
# 触发事件: nymphcast 0.2-alpha0 package()（bin/<triple>/nymphcast_server）
# 扩展项：建议与 E320-draft-GLOB-LOCATE 及
#   DRAFT-conan-copy-keep-path-nesting 合并评估（B3-1）
#====================================================================

id:                     DRAFT-ohos-conan-copy-fnmatch-anchored
trigger_tool:           conan
phase:                  packaging
error_signature:        copy\(.*\).*not found|
                        0 files copied|
                         empty .*package|
                         bin/.*/.*binary.*not found

severity:               2
category:               conan|recipe|packaging
match_keywords:         conan copy, fnmatch, keep_path, **, glob, subdir,
                         package(), bin/<triple>, pattern anchored, * not crossing slash
title:                  conan copy() 的 pattern 是 fnmatch 锚定全路径匹配：
                        产物在子目录时 copy("name",...) 0 匹配，须 "**/name"
                        或前导 "*" + keep_path=False

root_cause: >
  conan.tools.files.copy 的 pattern 经 fnmatch.fnmatch 对相对 src 的全路径
  做锚定匹配（conan 2.29.1 源码 copy_pattern.py：fnmatch.fnmatch(
  os.path.normpath(相对路径), pattern)）。fnmatch 的 "*" 不跨 "/"（设备
  python3 实测 fnmatch.fnmatch("bin/aarch64/nymphcast_server",
  "nymphcast_server") = False；"**/nymphcast_server" = True）。产物落在
  子目录（如 Makefile 输出 bin/<triple>/nymphcast_server）时，硬编码
  copy("nymphcast_server", src_dir, dst) 匹配 0 个文件，package 静默缺产物。

affected_scope: >
  所有在 package()/export_sources 中复制"构建产物位于子目录"的 conan
  recipe（Makefile/autotools 型常见 TARGET_BIN 含工具链 triple 子目录）。

verification_cmd: >
  python3 -c "import fnmatch;print(fnmatch.fnmatch(\"bin/aarch64/nymphcast_server\",\"nymphcast_server\"),fnmatch.fnmatch(\"bin/aarch64/nymphcast_server\",\"**/nymphcast_server\"))"
  # 期望 False True

rec_priority:           1
rec_approach:           double-star-pattern-keep-path-false
rec_description: >
  对子目录产物用 "**/<name>"（或前导 "*<name>"）匹配 + keep_path=False 平铺，
  使其进入 package 的 bin/ 根。nymphcast 实际：copy(self, "**/nymphcast_server",
  src=bin, dst=package/bin, keep_path=False)。
rec_command: >
  copy(self, "**/nymphcast_server",
       os.path.join(server_dir, "bin"),
       os.path.join(self.package_folder, "bin"), keep_path=False)
rec_auto_fix:           false
rec_impl:               conan-copy-double-star

fallback_priority:      2
fallback_approach:      locate-then-copy
fallback_description: >
  若 pattern 仍不可靠，先在 build/source folder 用 glob.glob(recursive=True)
  定位产物绝对路径，再按已知 src 目录 copy（等价 E320-draft-GLOB-LOCATE）。
fallback_command:       glob.glob(os.path.join(root, "**", "bin", "*", "<bin>"), recursive=True)
fallback_auto_fix:      false
fallback_impl:          conanfile-glob-locate

forbid_1_pattern:       copy\(self,\s*"[^*/]+",\s*src=.*bin
forbid_1_reason:        单段 pattern（无 * 前缀）在 src 根对子目录产物 0 匹配（fnmatch 锚定）。
forbid_1_consequence:   package 静默缺二进制，test_package/运行找不到产物。

principles:             P016
similar_to:             E320-draft-GLOB-LOCATE, DRAFT-conan-copy-keep-path-nesting
conflicts_with:
prerequisite_of:

doc_file:               knowledge/drafts/DRAFT-ohos-conan-copy-fnmatch-anchored.md
last_updated:           2026-08-27
source_event:           archives/n/nymphcast/0.2-alpha0 conanfile.py package()；
                        Auditor B3/B3-1 复核（copy_pattern.py + fnmatch 实测）

authors:                GoliWie <GoliWie@noreply.gitcode.com>
source_pr:
source_commit:

metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     1.0
metrics_last_used:      2026-08-27
