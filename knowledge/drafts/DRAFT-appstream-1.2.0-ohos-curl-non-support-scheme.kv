#====================================================================
# DRAFT-appstream-1.2.0-ohos-curl-non-support-scheme.kv
# libcurl 未编译 SSL 时 curl_url_set 对 https 返回 CURLUE_BAD_SCHEME → 格式校验
# 误报 "URL format is invalid"；传 CURLU_NON_SUPPORT_SCHEME 使格式校验与
# 协议可用性解耦（可达性仍由 check_urls/--no-net 控制）
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R03）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           libcurl / curl_url_set
phase:                  runtime-validate
error_signature:        URL format is invalid|
                        CURLUE_BAD_SCHEME|
                        curl_url_set.*CURLUPART_URL.*return
severity:               2
category:               build, dependency, curl, validation, portability
match_keywords:         libcurl, curl_url_set, CURLU_NON_SUPPORT_SCHEME, CURLUE_BAD_SCHEME,
                        SSL, https, URL format is invalid, ohpcd, as-validator, format validation
title:                  libcurl 无 SSL 时 https URL 被 curl_url_set 判为格式错误——CURLU_NON_SUPPORT_SCHEME 解耦
root_cause:             curl_url_set(flags=0) 对未编译协议处理器的 scheme 返回
                        CURLUE_BAD_SCHEME，把"格式合法"与"协议可用"耦合；
                        OHOS ohpcd libcurl/8.5.0 无 SSL，https 一律 BAD_SCHEME。
affected_scope:         任何用 libcurl URL API 做格式校验的解析器/校验器，
                        且构建仓 libcurl 缺 scheme 处理器。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing; meson test as-validate_metainfo.cli as-test_validate
rec_priority:           1
rec_approach:           curl-non-support-scheme-flag
rec_description:        格式校验调用传 CURLU_NON_SUPPORT_SCHEME，仅校验 URL 语法；
                        可达性/协议检查交给调用方（check_urls / --no-net）单独门控。
rec_command:            |
  return curl_url_set (cu, CURLUPART_URL, url, CURLU_NON_SUPPORT_SCHEME) == CURLUE_OK;
rec_auto_fix:           false
rec_impl:               source-patch
forbid_1_pattern:       check_urls=.*curl_easy_perform.*format
forbid_1_reason:        不得用网络可达性代替格式校验（--no-net 下不可用）
principles:             R6, R8
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-ohos-curl-non-support-scheme.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R03（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  2
metrics_fail_count:     0
metrics_confidence:     0.85
