#====================================================================
# Draft: conan profile 固定 cppstd=17 时，构建期代码生成器输出含 register 的 C++ 源被 clang 判错
# 来源: tdlib/1.8.0 适配（CMake + gperf 生成 MIME 表），2026-09-24
# 复用面: 任何「构建期用 gperf/lex/yacc 等生成器产出 C++ 源码」且 profile 固定 cppstd>=17 的包
#====================================================================

draft:                 true
id:                    DRAFT-tdlib-1.8.0-cpp17-gperf-register-generated-table
status:                pending-editor-review
trigger_tool:          cmake|clang|make
phase:                 compilation
error_signature:       ISO C\+\+17 does not allow 'register' storage class specifier|error:.*\[-Wregister\]|\.gperf:[0-9]+:[0-9]+: error|gperf.*register.*storage class

severity:              3
category:              build-system, cmake, compiler, conan, c++
prescan_pattern:       \.gperf$|GPERF_EXECUTABLE|find_program\(\s*GPERF|gperf\s+-m[0-9]
prescan_globs:         CMakeLists.txt, *.cmake, *.gperf, *.txt
match_keywords:        register 存储类, ISO C++17 does not allow 'register', -Wregister, -Wno-register, -Wdeprecated-register, gperf 生成表, 构建期代码生成器, compiler.cppstd=17, CMAKE_CXX_STANDARD 覆盖 -std=c++14, mime_type_to_extension.gperf
title:                 profile 固定 cppstd=17 时构建期生成器（gperf）产出的 register 代码被 clang 判为错误——上游 -Wdeprecated-register 抑制不住 C++17 的 -Wregister

root_cause:            上游工程自加 -std=c++14（或依赖编译器默认 C++14），并只抑制了 C++14 时期的 -Wdeprecated-register；但 conan profile 固定 compiler.cppstd=17，CMake 把由 CMAKE_CXX_STANDARD 推出的标准开关放在编译命令最后一位，覆盖掉工程自己追加的 -std=c++14，实际以 C++17 编译。gperf 吐出的表仍使用 register（C++17 已移除该存储类），clang 在 C++17 下把 -Wregister 直接判为 error（不同于 C++14 的 warning），于是构建期生成的 .cpp 全部编不过。
affected_scope:        任何构建期用代码生成器产出 C++（gperf/lex/bison/flex/自制生成器）+ conan profile 固定 cppstd 的包；C++14 老工程尤甚
error_excerpt:         auto/mime_type_to_extension.gperf:47:20: error: ISO C++17 does not allow 'register' storage class specifier [-Wregister]（9 errors generated，make exit=2）
verification_cmd:      grep -o '\-std=c++1[47]' build/compile_commands.json | sort | uniq -c   # 出现两条、后者生效即命中本模式
rec_priority:          1
rec_approach:          extra-cxxflags-suppress-generator-dialect
rec_description:        经 conan toolchain 向 C/CXX 追加 -Wno-register（不改上游源码、不改生成物、不动 profile 的 cppstd），使生成器产出的旧方言代码在 C++17 下静默通过。该抑制只针对 register 一个移除特性，不影响其他 C++17 诊断。
rec_command:           tc = CMakeToolchain(self); tc.extra_cxxflags.append("-Wno-register"); tc.generate()
rec_auto_fix:          false
rec_impl:              cmake-toolchain-extra-flags
fallback_priority:     2
fallback_approach:     generator-post-process
fallback_description:  生成后对产物做 register 剥离（sed/grep -v）——仅在生成器命令可介入（自定义 add_custom_command）时可行，且属改生成物，需在 notes.md 说明
fallback_command:      add_custom_command(OUTPUT x.cpp COMMAND ${GPERF} ... | sed 's/\bregister //g' > x.cpp)
fallback_auto_fix:     false
forbid_1_pattern:      patch.*\.gperf|sed.*\bregister\b.*>.*\.cpp|CMAKE_CXX_STANDARD.*14
forbid_1_reason:       ①.gperf/.cpp 是构建期生成物，每轮重建，补丁必然被覆盖或落到源码树产生脏 diff；②把 CMAKE_CXX_STANDARD 压回 14 会使「包元数据 cppstd=17 / 实际编译 C++14」错位，且全局降语言级别会掩盖真正的 C++17 兼容问题
forbid_1_consequence:  生成物污染 patches/ 与源码树；下游按 cppstd=17 消费时行为与声明不符

principles:            P004, P011
causes:                []
caused_by:             []
similar_to:            [E293, E187, E103]
conflicts_with:        []
prerequisite_of:       []
