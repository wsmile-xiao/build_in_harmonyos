# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E15139
trigger_tool: conan|cmake|ctest
phase: testing
error_signature: hwy_list_targets|POST_BUILD|CMAKE_GTEST_DISCOVER_TESTS_DISCOVERY_MODE

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: cmake, testing, runtime
match_keywords: PRE_TEST, POST_BUILD, gtest_discover_tests, build-tree library, native execution, deferred discovery
title: PRE_TEST postpones test discovery but not independent POST_BUILD executables

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: The GoogleTest discovery mode affects gtest_discover_tests only; independent custom POST_BUILD commands still execute during cmake.build and require native execution and build-tree shared-library providers at that earlier phase. Conan creates CMake generator directories before recipe generate(); a source BUILD file can collide with the default build directory on a case-insensitive target filesystem. Select a non-colliding cmake_layout build_folder rather than deleting the upstream build-system input.
affected_scope: Native builds combining GoogleTest-compatible deferred discovery with custom executable build commands; cross compilation needs a supported emulator or an upstream-specific solution.
verification_cmd: conan create <recipe> -pr:h=<native-ohos> -pr:b=<native-ohos>; inspect the full upstream and installed consumer terminals

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: separate-build-execution-and-test-discovery-environments
rec_description: Inventory build-time custom commands independently of discovery; provide task-scoped build-tree runtime libraries during cmake.build, sign completed test binaries, then discover and run the full upstream suite. Conan creates CMake generator directories before recipe generate(); a source BUILD file can collide with the default build directory on a case-insensitive target filesystem. Select a non-colliding cmake_layout build_folder rather than deleting the upstream build-system input.
rec_command: See the paired Markdown for the exact evidence-backed implementation and verification sequence.
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach:
fallback_description:
fallback_command:
fallback_auto_fix:      false
fallback_impl:

