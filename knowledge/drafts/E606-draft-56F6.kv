#====================================================================
# E606 — FETCHCONTENT_SOURCE_DIR_<DEP> 目录名与 conan get(strip_root=True)
#        落位不一致，配置期报 Manually specified source directory is missing
# 用法: 验证后由主编提升为正式 E606 条目
# 对应的人类文档: knowledge/drafts/E606-draft-56F6.md
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E606
trigger_tool: cmake|conan
phase: configuration
error_signature: Manually specified source directory is missing: FETCHCONTENT_SOURCE_DIR_|__FetchContent_Populate

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: build-system, cmake, conan
match_keywords: FETCHCONTENT_SOURCE_DIR, FetchContent, strip_root, Manually specified source directory is missing, offline dependency injection, conan source()
title: FETCHCONTENT_SOURCE_DIR_<DEP> 目录名与 conan get(strip_root=True) 落位不一致，配置期报 Manually specified source directory is missing

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: conan.tools.files.get(..., strip_root=True) 剥掉 tarball 顶层目录（如 qdldl-0.1.8/），依赖源码直接落在 destination 目录本身；配方若按 tarball 目录名拼 FETCHCONTENT_SOURCE_DIR_<DEP>，该路径不存在，CMake 在 __FetchContent_Populate 直接报错。SOURCE_DIR 覆盖语义是‘把该目录当作依赖源码根’，与 tarball 内目录名无关。
affected_scope: 上游用 CMake FetchContent 引入依赖、配方改为离线投喂官方源码的 C/C++ 包（osqp 1.0.0 → qdldl 0.1.8 实测）
verification_cmd: conan create . 2>&1 | grep -E 'Manually specified source directory|FetchContent'

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: explicit-offline-dest-dir-shared-constant
rec_description: 给离线依赖指定显式目录名（如 <source>/_offline_deps/qdldl），并让 source() 的 destination 与 generate() 的 FETCHCONTENT_SOURCE_DIR_<DEP> 共用同一常量，杜绝两处路径漂移。
rec_command: QDLDL_OFFLINE_SUBDIR = ('_offline_deps','qdldl'); get(self, **self.conan_data['sources']['qdldl'], destination=os.path.join(self.source_folder, *self.QDLDL_OFFLINE_SUBDIR), strip_root=True); tc.cache_variables['FETCHCONTENT_SOURCE_DIR_QDLDL'] = os.path.join(self.source_folder, *self.QDLDL_OFFLINE_SUBDIR)
rec_auto_fix: false
rec_impl: conan-recipe

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: keep-tarball-root-dir
fallback_description: 改为 strip_root=False 保留 tarball 顶层目录并按真实目录名引用；版本升级时目录名需同步修改。
fallback_command:
fallback_auto_fix: false
fallback_impl: conan-recipe

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

