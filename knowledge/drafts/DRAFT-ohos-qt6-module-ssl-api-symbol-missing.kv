#====================================================================
# DRAFT-ohos-qt6-module-ssl-api-symbol-missing — Qt 子模块基于非 SSL
#   qtbase（FEATURE_openssl=OFF）编译时，libQt6<Module>.so 以
#   QT_CONFIG(ssl)=off 编译，不导出 SSL 相关成员函数（如
#   QWebSocket::ignoreSslErrors），TLS 消费者链接报
#   "undefined symbol"，需同源码新建不同依赖契约的 .1.1.1 变体
# 对应人类文档: knowledge/drafts/DRAFT-ohos-qt6-module-ssl-api-symbol-missing.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR ausweisapp/2.5.4 适配 HarmonyOS PC（最终链接
#   src/AusweisApp 报 5 个 QWebSocket SSL 符号 undefined）
#====================================================================

id:                     DRAFT-ohos-qt6-module-ssl-api-symbol-missing
trigger_tool:           conan|cmake|ld
phase:                  linking
error_signature:        undefined symbol: QWebSocket::sslConfiguration|
                         undefined symbol: QWebSocket::ignoreSslErrors|
                         undefined symbol: QWebSocket::setSslConfiguration|
                         undefined symbol: QWebSocket::preSharedKeyAuthenticationRequired|
                         undefined symbol: QWebSocket::sslErrors|
                         QT_CONFIG\(ssl\)=off.*QWebSocket

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               ohos, linking, dependency, conan, cmake
match_keywords:         QWebSocket, ignoreSslErrors, setSslConfiguration, sslErrors,
                         preSharedKeyAuthenticationRequired, sslConfiguration,
                         QT_CONFIG(ssl), FEATURE_openssl, libQt6WebSockets, qtbase,
                         SSL variant, undefined symbol, TLS, wss, variant, dependency
                         contract, 6.11.1.1.1
title:                  Qt 子模块基于非 SSL qtbase 编译时不导出 SSL API 符号
                         （QWebSocket::ignoreSslErrors 等 5 个），TLS 消费者链接报
                         undefined symbol——同源码新建 .1.1.1 依赖契约变体解决

# ═══ Layer 2: 诊断层 ═══
root_cause:             Qt 6 子模块（qtwebsockets 等）编译时按所依赖 qtbase 报告的
                         feature 开关裁剪 API：非 SSL qtbase（FEATURE_openssl=OFF，
                         QT_CONFIG(ssl)=off）下，QWebSocket 的 SSL 相关成员函数
                         （ignoreSslErrors/setSslConfiguration/sslErrors/
                         preSharedKeyAuthenticationRequired/sslConfiguration）整体
                         不编译进 libQt6WebSockets.so，头文件声明仍在但链接期
                         无符号可解析。依赖该模块做 TLS(wss://) 的消费者（如
                         ausweisapp eID 客户端 ConnectRequest/
                         RemoteWebSocketServerImpl）链接时 ld.lld 报 undefined
                         symbol。修法不是改模块源码，而是依赖侧对齐：qtbase 先出
                         SSL 变体（qtbase/6.11.1.1.1），qtwebsockets 同源码归档
                         （SHA-256 不变）新建依赖该变体的 6.11.1.1.1 变体
affected_scope:         所有基于非 SSL qtbase 构建、且下游走 TLS 的 Qt 模块
                         （qtwebsockets/QWebSocket、qtnetworkauth 等）及其消费者
verification_cmd:       conan create archives/q/qtwebsockets/6.11.1.1.1
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         --build=missing
                         # 期望: libQt6WebSockets.so 导出 QWebSocket::ignoreSslErrors
                         # 等 5 个 SSL 符号（nm -D 可查）；ausweisapp 最终链接通过

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           dependency-contract-variant
rec_description:        qtbase 侧新建 SSL 变体（FEATURE_openssl=ON，如
                         qtbase/6.11.1.1.1），qtwebsockets 等子模块复制原版本、
                         requirements 改为依赖该 SSL 变体（qtwebsockets/6.11.1.1.1），
                         同一上游源码归档、SHA-256 不变，仅依赖契约不同。原
                         6.11.1 配方不动，非 SSL 用途不受影响
rec_command:            (conanfile.py requirements)
                         self.requires("qtbase/6.11.1.1.1")
                         # generate() 与 validate() 对齐 qtbase SSL 变体契约
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      patch-qtbase-feature-openssl-on
fallback_description:   直接改 qtbase/6.11.1 配方把 FEATURE_openssl 打开——会改变
                         既有 6.11.1 制品的依赖契约（引入 openssl 依赖），影响
                         所有下游非 SSL 用途，不推荐
fallback_command:       (改 qtbase generate() FEATURE_openssl=ON)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       skip.*链接|忽略.*undefined|N/A（未运行）|不链接.*QWebSocket
forbid_1_reason:        SSL API 是 TLS 消费者绕不开的真需求；跳过/忽略属"有可运行
                         子集未尝试"
forbid_1_consequence:   被 rule 4 打回；且掩盖依赖契约错配的真实问题面
forbid_2_pattern:       patch.*qwebsocket.*删除.*ssl|sed.*qwebsocket.*删.*SSL
forbid_2_reason:        删模块源码的 SSL 分支会破坏上游 API 完整性，治标不治本
forbid_2_consequence:   上游升级/其他消费者（合法使用 SSL API）即失效

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             E323
conflicts_with:         []
prerequisite_of:        []

