#====================================================================
# E556-draft-F3B1 — CMake install(FILES) 引用构建目录路径但文件仅存在于源码目录
# 触发事件: check 0.11.0 HarmonyOS PC 适配 conan create package() 阶段失败
#           (archives/c/check/0.11.0, 2026-09-16 实证)
# 与 E555（libzzip --target 定向构建绕过 ALL 生成目标）共享 error_signature
# "file INSTALL cannot find"，但根因/方案独立：
#   E555 = 安装清单引用"从未生成的产物"（.pc/软链/生成头，构建闭包缺失）
#   本条目 = 安装清单引用"路径写错目录的源码文件"（文件真实存在但在源码目录）
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
id:                     E556-draft-F3B1
trigger_tool:           cmake|install|conan
phase:                  installation
error_signature:        file INSTALL cannot find \"[^\"]*/([Bb]uild|build)/[^\"]+\"|INSTALL cannot find.*libcompat\.h|cmake --install.*failed

# ═══ Layer 1: 识别层 (Recognition) ═══
severity:               2
category:               cmake, build-system, packaging
match_keywords:         file INSTALL cannot find, install(FILES, CMAKE_BINARY_DIR, CMAKE_CURRENT_SOURCE_DIR, libcompat.h, install manifest, source dir, build dir
title:                  CMake install(FILES) 把源码头文件路径写成 ${CMAKE_BINARY_DIR}（文件实际在源码目录），cmake --install 必然失败

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
root_cause:             上游 CMakeLists 的 install(FILES ${CMAKE_BINARY_DIR}/xxx.h DESTINATION include) 假设头文件是 configure_file/生成物（存在于构建目录），但该文件实际是源码目录中的静态头文件；构建目录中不存在此路径 → cmake --install 执行安装清单时报 file INSTALL cannot find 直接失败。
affected_scope:         所有上游把纯源码头文件路径写成 CMAKE_BINARY_DIR 的旧 CMake 工程；OHOS 适配时 conan create/test_package 的 cmake.install() 阶段必现，与平台无关。
verification_cmd:       grep -rn "install(FILES.*CMAKE_BINARY_DIR.*\.h" <src>/CMakeLists.txt && stat <src>/xxx.h

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
rec_priority:           1
rec_approach:           fix-install-source-dir-path
rec_description:        将 install(FILES) 中错误的构建目录路径改为源码目录路径（${CMAKE_CURRENT_SOURCE_DIR}/xxx.h），保留下划线中的文件名；若确为 configure_file 生成物则改装 ${CMAKE_CURRENT_BINARY_DIR} 并确认生成目标先于安装执行。
rec_command:           sed -i 's|install(FILES ${CMAKE_BINARY_DIR}/\(lib/\)\{0,1\}\([^ )]*\.h\)|install(FILES ${CMAKE_CURRENT_SOURCE_DIR}/\2|' <src>/CMakeLists.txt
rec_auto_fix:           false
rec_impl:               source-patch

# ═══ Layer 4: 原则引用 ═══
principles:             P005
forbid_1_pattern:       install\(FILES.*\$\{CMAKE_BINARY_DIR\}.*\.h
forbid_1_reason:        不要继续引用构建目录路径；文件不在构建目录时安装必失败。
forbid_1_consequence:   cmake --install 卡死整个配方 package() 阶段。

# ═══ Layer 5: 溯源与协作 (Provenance) ═══
authors:                pc2-16
source_pr:              feat/check-0.11.0
source_commit:          (PR 合并后回填)
similar_to:             E555
# E555 部分覆盖差异（R02 补充）：
#   已覆盖部分（E555-draft-9C21/E555-draft-A7F3）：error_signature "file INSTALL
#   cannot find"；根因=--target 定向构建绕过 ALL 生成目标 + if(UNIX OR MINGW)
#   平台门控选项默认 OFF，产物（.pc/软链/生成头）从未生成；方案=构建完整闭包/
#   修正选项门控。
#   本轮新增部分：install(FILES) 路径字面量写错目录（${CMAKE_BINARY_DIR}/lib/…
#   而文件仅存在于源码目录），产物一直存在、非生成物缺失；方案=改
#   ${CMAKE_CURRENT_SOURCE_DIR} 一行修复。两者组合构成 CMake install 失败
#   完整谱系（未生成 vs 路径错误），E555 无法覆盖本候选的错误签名路径变体。
caused_by:              []
prerequisite_of:        []
conflicts_with:         []
doc_file:               knowledge/drafts/E556-draft-F3B1.md
last_updated:           2026-09-16