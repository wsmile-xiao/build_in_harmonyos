#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E543.kv，填写各字段
# 对应的人类文档: doc/E543.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E543
trigger_tool: clang|cmake|conan
phase: build|testing|packaging
error_signature: undefined reference.*boost.*unit_test|libboost_unit_test_framework.*not found|Boost.Test.*header-only

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: ohos|boost|testing|cmake|conan|header-only
match_keywords: Boost.Test,unit_test_framework,included/unit_test.hpp,header-only,OHOS,Conan,CMake,upstream tests,test_package
title: OHOS 缺少 Boost.Test 链接库时保留上游套件的 header-only 迁移与消费验证

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: 部分 OHOS 制品仓 Boost 包提供 Boost.Test 头文件但没有可链接的 libboost_unit_test_framework，直接沿用上游 unit_test.hpp 入口会在链接阶段失败。仅关闭上游测试会丢失真实覆盖；应区分运行时包依赖与测试构建依赖，沿用上游全部测试源，将入口切到 included/unit_test.hpp，并用 Conan CMakeDeps/CMakeToolchain 让独立 test_package 验证安装后的 CMake target。
affected_scope: 在 OHOS 上适配且上游测试使用 Boost.Test 的 C++ header-only 或 CMake INTERFACE 库；仅当制品仓确实提供 Boost.Test 头文件而不提供所需链接库时适用。
verification_cmd: conan create <recipe> --profile:host=ohos-aarch64 --profile:build=ohos-aarch64 --build=missing; grep -E "Running [0-9]+ test cases|No errors detected"; conan test test_package

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: header-only-boost-test-with-independent-consumer
rec_description: 不改动上游断言或删减测试文件；通过可审查补丁把唯一测试入口改为 boost/test/included/unit_test.hpp，在 recipe 中以 test-only tool_requires 提供 Boost 头文件，按上游五个或实际完整测试翻译单元编译并运行；package_info 保持 header-only 运行时图，test_package 用 CMakeDeps 找到安装后的 CMake config/target，并执行真实 map/set API 检查。
rec_command: patch tests/main.cpp: boost/test/unit_test.hpp -> boost/test/included/unit_test.hpp; compile all upstream test translation units with -std=c++11 and -DBOOST_DISABLE_THREADS; conan create ...; test_package consumer
rec_auto_fix: false
rec_impl: conan-recipe-plus-upstream-test-entry-patch

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority:      2
fallback_approach: verified-boost-source-or-honest-upstream-skip
fallback_description: 若制品仓没有 Boost.Test 头文件，不能把 upstream_test 伪装成通过；应使用经过校验的官方 Boost 源码树作为仅测试输入，或明确记录上游测试未运行并让 test_package 覆盖核心 API。
fallback_command: compile test_package with CMakeDeps when packaged Boost is available; otherwise record upstream_tests=not_run and run the standalone consumer checks
fallback_auto_fix:      false
fallback_impl: manual-evidence

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern: BUILD_TESTING[[:space:]]*=[[:space:]]*OFF
forbid_1_reason: 关闭上游测试会删除本条验证对象，不能作为上游测试通过的替代
forbid_1_consequence: 测试统计失真，审查者无法判断上游套件是否实际执行
forbid_2_pattern: tool_requires\("cmake/
forbid_2_reason: CMake 是构建工具，不应以 Conan 包依赖掩盖工具链环境问题
forbid_2_consequence: 违反仓库构建工具依赖规则并降低可复现性
forbid_3_pattern: skip.*upstream|upstream.*skip
forbid_3_reason: 缺少 Boost.Test 链接库时应切换到 header-only 入口或如实记录未运行，不能静默跳过
forbid_3_consequence: 会产生虚假的全绿适配结论

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles: []

