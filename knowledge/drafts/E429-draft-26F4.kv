#====================================================================
# _template.kv — 知识图谱条目模板
# 用法: 复制此文件为 E429.kv，填写各字段
# 对应的人类文档: doc/E429.md
#
# 格式规则:
#   - key: value（冒号后一个空格，value 到行尾）
#   - 多行值: 下一行以空格开头 = 续行
#   - 列表值: 逗号分隔
#   - 正则值: | 分隔多个模式
#   - 以 # 开头的行为注释
#   - 空行忽略
#====================================================================

# ═══ Layer 0: 错误面 (Error Surface) ═══
# trigger_tool: 出错的工具 (configure/cmake/meson/make/gcc/clang/ld/python/pip/install/test/runtime)
# phase:         出错阶段 (configuration/compilation/linking/installation/testing/runtime)
# error_signature: 正则表达式(|分隔), 用于精确匹配日志文本
id:                     E429
trigger_tool: conan|create|test_package|bash|test.sh
phase: testing
error_signature: JAR not found at .*\.jar

# ═══ Layer 1: 识别层 (Recognition) ═══
# severity:      3=🔴blocking  2=🟡medium  1=🟢minor  0=✅resolved
# category:      分类标签（受控词表 64 词，逗号分隔，最多 5 个；add/promote 自动归一化）
# prescan_pattern: （可选）预编译源码扫描正则——写入后 PreScanner 运行时自动派生
#                   PSCAN-KB-{id} 规则，无需改 pre-scan-rules.yaml（知识增长即扫描能力增长）
# prescan_globs:   （可选）扫描范围 glob 列表，默认 '*.c, *.h, *.cc, *.cpp, *.sh, Makefile*, *.mk'
# 词表: platform, compat, limitation, detection, hmdfs, ohos, selinux, kernel, portability, libc, musl, posix, syscall, headers, threading, socket, network, build-system, cmake, autotools ...（全表见 scripts/ohc/kb_taxonomy.py）
# match_keywords: 纯文本关键词(逗号分隔), 用于粗筛(固定字符串匹配F)
# title:         简短标题(一句话描述错误模式)
severity: 2
category: testing, packaging, conan
match_keywords: JAR not found, test_package, test.sh, finalName, 产物名不含版本号, ls pipe head, SIGPIPE, pipefail, set -euo pipefail, 脚本无输出 exit 1, 141, glob, basename
title: 两个 test_package 陷阱：①Maven 产物名常因 pom 的 finalName 而不含版本号（写死 jarkarta.activation-api-2.0.0.jar 会 "JAR not found"）须按目录发现；②`JAR=$(ls ... | head -1)` 在 `set -euo pipefail` 下会因 head 早退给 ls 触发 SIGPIPE（退出码 141）令脚本静默退出——连 echo 都不打印

# ═══ Layer 2: 诊断层 (Diagnosis) ═══
# root_cause:       一句话根因描述(逗号可分行)
# affected_scope:   影响范围
# verification_cmd: 验证诊断是否正确的命令
root_cause: ①上游 pom 常设 <finalName>，使产物名与 <artifactId>-<version>.jar 的默认约定不一致（实测 jaf-api：activationapi 产出 jakarta.activation-api.jar、activation 产出 jakarta.activation.jar，均无版本号）；test_package 若按 Maven 默认命名写死路径，就报 "JAR not found"，而构建本身是成功的。②在 `set -euo pipefail` 的脚本里写 `JAR_API="$(ls "$DIR"/a*.jar | head -1)"`：当匹配到 2 个及以上文件时，head 读够一行即退出，ls 继续写管道时收到 SIGPIPE 并以 141 退出；pipefail 把 141 视为失败 → set -e 立即终止脚本。表现为**脚本一行输出都没有、conan 只报 Error 1 while executing**，极难定位（旧写法还能出 "=== xxx 测试 ===" 首行，改写法后连首行都没了）。
affected_scope: 所有 Java 类库配方的 test_package（test.sh / test_package/conanfile.py）以及任何用 “命令替换 + 管道 + set -e/pipefail” 发现产物路径的构建/测试脚本
verification_cmd: bash -c 'set -euo pipefail; d=$(mktemp -d); touch $d/a1.jar $d/a2.jar; x="$(ls $d/a*.jar | head -1)"; echo got=$x'; echo exited=$? # 实测：无输出、退出码 1

# ═══ Layer 3: 方案层 (Solution Space) ★ ═══
# 推荐方案 (priority 越小越优先, 从 1 开始)
rec_priority: 1
rec_approach: discover-artifacts-by-glob-not-pipe
rec_description: ①产物发现：不要按 "<artifactId>-<version>.jar" 写死，改用 glob 循环按类别挑（API jar 用 *-api*.jar，类 jar 用 *.jar 且排除 *-api*），并在取不到时打印 libexec/ 实际内容以便定位；②避免 `cmd | head` 直接进命令替换：改 for-glob 循环，或对管道兜底（`... | head -1 || true`），或临时 `set +o pipefail`。同思路适用于其它"发现产物/取第一条"的脚本场景。
rec_command: for f in "$PKG_DIR"/libexec/*.jar; do [ -f "$f" ] || continue; case "$(basename "$f")" in jakarta.activation-api*) JAR_API="$f" ;; jakarta.activation*) JAR_IMPL="$f" ;; esac; done
rec_auto_fix: false
rec_impl: manual

# 回退方案 (当推荐方案不可用时尝试)
fallback_priority: 2
fallback_approach: assert-and-print-dir-listing
fallback_description: 若仍想用简单写法，至少在取不到产物时 `ls -la "$PKG_DIR"/libexec` 打印实际内容再退出——把"静默 141"变成可读的路径不匹配；这能避免一轮 4 分钟的 conan create 只换来一句 Error 1
fallback_command: ls -la "$PKG_DIR"/libexec
fallback_auto_fix: false
fallback_impl: forbid_1_pattern: \$\(ls [^)]*\| *head

# ★ 禁止策略 (与推荐方案同等重要) ★
# forbid_N_pattern:     正则(|分隔), 匹配则拒绝/警告
# forbid_N_reason:      为什么禁止
# forbid_N_consequence: 违反后的后果
forbid_1_pattern:
forbid_1_reason:
forbid_1_consequence:
# forbid_2_pattern:
# forbid_2_reason:
# forbid_2_consequence:

# ═══ Layer 4: 原则引用 ═══
# principles:    适用的原则 ID 列表(逗号分隔), 在 graph/principles.kv 中定义
principles:

# ═══ 关系图 (Relations) ═══
# causes:          本模式是这些模式的根因 (修好本模式可能同时解决它们)
# caused_by:       本模式的根因是这些模式 (应先修它们)
# similar_to:      特征相似可能混淆的模式
# conflicts_with:  解决方案互相冲突的模式
# prerequisite_of: 本模式是修复这些模式的前置条件
causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

