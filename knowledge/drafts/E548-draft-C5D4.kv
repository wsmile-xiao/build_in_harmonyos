id:                     E548
trigger_tool:           ld|clang
phase:                  linking
error_signature:        dlopen.*failed|cannot open shared object|DT_NEEDED

severity:               2
category:               ohos, cmake, build-system
match_keywords:         SONAME, -Wl,-soname, DT_NEEDED, dlopen, 相对路径, OHOS 工具链, CMAKE_SHARED_LIBRARY_SONAME, openbabel
title:                  OHOS 工具链默认不设 SONAME 旗标：无 SONAME 共享库使消费者 DT_NEEDED 记为相对路径，dlopen 按进程 CWD 相对解析而失败

root_cause:             OHOS clang/lld 默认不加 -Wl,-soname（Linux 工具链自动派生 soname）：消费者链接无 SONAME 共享库时，链接器把被依赖库的相对路径原样写入消费者 DT_NEEDED，dlopen 时按进程 CWD 相对解析找不到库
affected_scope:         OHOS aarch64 共享库多库依赖链包（插件链主库、主库链子库）；openbabel 3.2.1 实证（92+ 格式插件 dlopen 失败，readelf 见 DT_NEEDED 相对路径）
verification_cmd:       readelf -d <库.so> | grep SONAME（应有条目）；readelf -d <消费者.so> | grep NEEDED（应为库名而非路径）

rec_priority:           1
rec_approach:           soname-flags-inject
rec_description:        配方 generate() 注入 CMAKE_SHARED_LIBRARY_SONAME_CXX_FLAG/C_FLAG=-Wl,-soname,，恢复标准 soname 机制（CMake 拼出 -Wl,-soname,<soname>）
rec_command:
rec_auto_fix:           false
rec_impl:               recipe-cache-variable

fallback_priority:      2
fallback_description:   CMake 变量无效时，补丁对目标加 target_link_options(<lib> PRIVATE -Wl,-soname,lib<name>.so) 单点指定
fallback_auto_fix:      false
fallback_impl:          manual-source-patch

principles:

causes:                 []
caused_by:              []
similar_to:             []
conflicts_with:         []
prerequisite_of:        []

