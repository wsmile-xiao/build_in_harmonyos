#====================================================================
# DRAFT-appstream-1.2.0-ohos-pkgconfig-component-requires-pc.kv
# Conan 配方根级 cpp_info.requires 经 PkgConfigDeps 生成的 .pc Requires 链
# 不完整（静态库消费者链接缺符号）→ 组件式 package_info（components + 全量
# lib.requires）+ package_type='library' + commands.json CLI 声明
# 实例：appstream 1.2.0（archives/a/appstream/1.2.0，R02）
#====================================================================

id:                     DRAFT (proposed E5xx，最终编号由知识库主编确认)
trigger_tool:           conan|pkg-config|conan_test|cmake
phase:                  packaging|linking|testing
error_signature:        undefined symbol: fy_.*sb_stemmer_new.*appstream|
                        appstream\.pc.*Requires:.*(缺 libfyaml|libstemmer)|
                        appstream\.h' file not found.*find_package\(appstream\)|
                        PkgConfigDeps.*Requires.*不完整
severity:               2
category:               conan, pkg-config, packaging, static-linking, cmake
match_keywords:         PkgConfigDeps, cpp_info.requires, components, package_info,
                        .pc, Requires, static library, consumer, libfyaml, libstemmer,
                        package_type, application, library, commands.json, CMakeDeps,
                        find_package, appstream::appstream
title:                  PkgConfigDeps 对根级 cpp_info.requires 生成的 .pc Requires 不完整 → 组件式 package_info 全量声明
root_cause:             PkgConfigDeps 对**根级** self.cpp_info.requires 的解析在组件式
                        配方下才稳定：根级声明生成的 .pc Requires 静默缺项
                        （appstream 实测缺 libfyaml/libstemmer），静态库消费者按
                        appstream.pc 链接时 fy_*/sb_* 符号未定义；另外
                        package_type='application'（含 CLI）使 CMakeDeps 消费者
                        空 include/libs（appstream.h 找不到）。
affected_scope:         Conan 2 meson/静态库配方：头文件安装于 include/<name>/ 子目录、
                        含 CLI 与库双产物、消费者经 pkg-config（.pc Requires）或
                        CMakeDeps（find_package）链接的项目。
verification_cmd:       conan create archives/a/appstream/1.2.0 -pr:h=<abs>/ci/conan/profiles/ohos-aarch64 -pr:b=<abs>/ci/conan/profiles/ohos-aarch64 --build=missing  # test_package 真实 API 消费者 1/1 通过
rec_priority:           1
rec_approach:           component-package-info-full-requires
rec_description:        package_info 改为组件式（libxmlb 同款）：
                        components["<name>"] + includedirs(include/<name>) +
                        libs + **全量 lib.requires**（glib 家族组件与直接依赖组件
                        逐一列出）+ system_libs + pkg_config_name/cmake_target_name；
                        package_type='library'（CLI 由软件级 commands.json 声明，
                        R38）；保证生成的 .pc Requires 与 CMakeDeps 目标均完整。
rec_command:            |
  self.cpp_info.set_property("cmake_file_name", "appstream")
  self.cpp_info.set_property("cmake_target_name", "appstream::appstream")
  self.cpp_info.set_property("pkg_config_name", "appstream")
  lib = self.cpp_info.components["appstream"]
  lib.includedirs = ["include/appstream"]
  lib.libs = ["appstream"]
  lib.requires = ["glib::glib", "glib::gobject", "glib::gio", "glib::gmodule",
                  "libcurl::libcurl", "libxml2::libxml2", "libxmlb::libxmlb",
                  "libfyaml::libfyaml", "libstemmer::libstemmer", "zstd::zstd"]
  lib.system_libs = ["m", "pthread"]
rec_auto_fix:           false
rec_impl:               conan-recipe-package-info
forbid_1_pattern:       package_type\s*=\s*["']application["']
forbid_1_reason:        application 包类型使 CMakeDeps 按可执行应用处理，消费者空
                        include/libs；库+CLI 双产物应改用 library + commands.json
forbid_2_pattern:       self\.cpp_info\.requires\s*=\s*\[.*\]\s*$（根级、无组件）
forbid_2_reason:        PkgConfigDeps 对根级 requires 的 .pc Requires 解析静默缺项
                        （实测缺传递组件），需组件式声明
principles:             R26, R34, R38
causes:                 []
caused_by:              []
similar_to:             [DRAFT-conan-shared-pkgconfig-requires-drop, E348, E216, E447]
conflicts_with:         []
prerequisite_of:        []
doc_file:               knowledge/drafts/DRAFT-appstream-1.2.0-ohos-pkgconfig-component-requires-pc.md
last_updated:           2026-09-20
source_event:           appstream-1.2.0 R02（archives/a/appstream/1.2.0）
authors:                pc2-19
source_pr:
source_commit:
metrics_success_count:  1
metrics_fail_count:     0
metrics_confidence:     0.8