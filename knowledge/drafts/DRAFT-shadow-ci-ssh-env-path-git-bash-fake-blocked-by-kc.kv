#====================================================================
# DRAFT-shadow-ci-ssh-env-path-git-bash-fake-blocked-by-kc — ssh 启动
#   run-conan-heavy.sh 时 PATH 缺 /data/service/hnp/bin，CI 脚本外层
#   git/bash 不可执行，KC 段失败伪装成 blocked_by_KC
# 对应文档: knowledge/drafts/DRAFT-shadow-ci-ssh-env-path-git-bash-fake-blocked-by-kc.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。正式编号由 graph promote 分配。
#====================================================================

id:                     DRAFT-shadow-ci-ssh-env-path-git-bash-fake-blocked-by-kc
trigger_tool:           shadow-ci|ohos-test-runner|run-conan-heavy
phase:                  ci-boot
error_signature:        build_and_test\.sh.*permission denied:\s*(git|bash)|
                         L1_RESULT=skip: blocked_by_KC.*permission denied

severity:               2
category:               shadow-ci, environment, path, ci-script
match_keywords:         blocked_by_KC, permission denied git, permission denied bash,
                         run-conan-heavy.sh, env.sh PATH, hnp/bin, ssh 非交互,
                         KC 段失败, 知识图谱假象, shadow CI 秒退, env.txt
title:                  ssh 裸调 run-conan-heavy.sh 继承的 PATH 缺
                         /data/service/hnp/bin → build_and_test.sh 外层 git/bash
                         不可执行 → 全线 skip: blocked_by_KC（伪装成知识图谱问题）

# ═══ Layer 2: 诊断层 ═══
root_cause:             隔离 job 的 env.sh 以 export PATH=<python>:<local>:$PATH
                        继承 ssh 调用环境；非交互 ssh shell 的 PATH 常不含
                        /data/service/hnp/bin（bash/git/zsh 仅装在该目录）。
                        build_and_test.sh 在 G0e 段直接调 git、KC 段直接调 bash，
                        PATH 缺失时 zsh 报 permission denied: git/bash，KC 段
                        失败连带 L1-L5 全部 skip: blocked_by_KC。Conan profile
                        [buildenv] 的 +(path)/data/service/hnp/bin 只作用于 conan
                        内部，覆盖不了 CI 脚本自身的调用。
affected_scope:         所有从工作机 ssh 启动 run-conan-heavy.sh 的 shadow CI
                        场景；"历史 job 同脚本能跑"不代表当前 ssh 环境也能跑
                        （操作者当时可能带了 hnp PATH）。
verification_cmd:       grep hnp/bin <run-id>/logs/env.txt
                        # 无输出 → PATH 缺失（决定性证据）
                        grep "permission denied" <run-id>/logs/stderr.log

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           export-path-in-ssh-command
rec_description:        启动 runner 前在 ssh 命令行内显式注入 PATH：
                        export PATH=/data/service/hnp/bin:$PATH 后再 sh
                        run-conan-heavy.sh。也可按 E540 用 ohos-test-runner.sh
                        --path。修后重跑（设备 job 目录/包无需改动）。
rec_command:            ssh <user>@<device> 'export PATH=/data/service/hnp/bin:$PATH; sh ~/ohos-users/codex/<job>/run-conan-heavy.sh'
rec_auto_fix:           false
rec_impl:               export-path-in-ssh-command

fallback_priority:      2
fallback_approach:      runner-path-option
fallback_description:   ohos-test-runner.sh --path "/data/service/hnp/bin:$EXTRA"，
                        与 E540 同法；适合需要同时注入 cmake 等更多工具目录的
                        heavy 任务。
fallback_command:       sh $HOME/bin/ohos-test-runner.sh --path "/data/service/hnp/bin:..." -- zsh ci/conan/build_and_test.sh <pkg>
fallback_auto_fix:      false
fallback_impl:          runner-path-option

forbid_1_pattern:       skip: blocked_by_KC.*(排查|检查|修复).*(知识|草稿|drafts|knowledge)
forbid_1_reason:        blocked_by_KC 在本场景是 PATH 问题的假象（KC 段调 bash
                        失败），知识图谱本身（G0 已 pass，541 entries）没有问题。
forbid_1_consequence:   误入知识草稿排查方向，浪费真机窗口轮次（实测 r1 即如此）。

forbid_2_pattern:       以.*(登录 shell|交互 shell).*(PATH|which).*(结论|判断)
forbid_2_reason:        登录 shell 与 runner 实际环境不同；必须以 run 目录
                        logs/env.txt 的 PATH 为准。
forbid_2_consequence:   登录 shell 能找到 bash/git 而误判设备正常，反复重跑仍秒退。

principles:             env-txt-as-evidence, distinguish-gate-vs-cause

causes:                 []
caused_by:              []
similar_to:             [E540, E518]
conflicts_with:         []
prerequisite_of:        []

doc_file:               knowledge/drafts/DRAFT-shadow-ci-ssh-env-path-git-bash-fake-blocked-by-kc.md
last_updated:           2026-09-29
source_event:           mdns-reflector 0.0.1 shadow CI r1：秒退 + 全线
                        blocked_by_KC + stderr permission denied git/bash；
                        ssh 命令行注入 hnp PATH 后 r2 走到 conan create

