#====================================================================
# DRAFT-ohos-pkgconfig-name-alias — PkgConfigDeps 生成的 .pc 文件名
#   与 configure 期望名不一致（如生成 sqlite.pc、configure 找
#   sqlite3.pc）——复制别名解决
# 对应人类文档: knowledge/drafts/DRAFT-ohos-pkgconfig-name-alias.md
#
# 本条目为 draft（草稿），尚未由主编审核合入。
# 触发事件: PR zeitgeist/1.0.4 适配 HarmonyOS PC（autotools + Vala）
#====================================================================

id:                     DRAFT-ohos-pkgconfig-name-alias
trigger_tool:           configure|pkg-config
phase:                  configuration
error_signature:        No package '.*' found|
                         Package requirements .* were not met|
                         required by '.*', not found|
                         PKG_CHECK_MODULES.*not found

# ═══ Layer 1: 识别层 ═══
severity:               2
category:               pkgconfig, configure, autotools, detection, build-system
match_keywords:         No package, pkg-config, PkgConfigDeps, sqlite3.pc, sqlite.pc,
                         PKG_CHECK_MODULES, .pc filename, alias, .pc name mismatch,
                         package not found, zeitgeist
title:                  PkgConfigDeps 生成的 .pc 文件名与 configure 期望名不一致——
                         复制别名解决（如 sqlite.pc → sqlite3.pc）

# ═══ Layer 2: 诊断层 ═══
root_cause:             conan 的 PkgConfigDeps 生成 .pc 文件时，文件名取自 conan
                         包名（如 sqlite → sqlite.pc），而上游 configure.ac 的
                         PKG_CHECK_MODULES 按上游模块名探测（如 sqlite3 → 找
                         sqlite3.pc）。名字不一致时 pkg-config 报
                         "No package 'sqlite3' found"，即便依赖已正确安装——
                         是 .pc 文件名约定差异，非依赖缺失
affected_scope:         所有用 PkgConfigDeps 且上游 configure 探测名 ≠ conan 包名的
                         库（zeitgeist 即此类：conan 包 sqlite/3.53.3 → sqlite.pc，
                         configure 找 sqlite3.pc）。常见于上游模块名带版本后缀/
                         缩写与 conan 包名不同
verification_cmd:       conan create archives/z/zeitgeist/1.0.4
                         -pr:h=ci/conan/profiles/ohos-aarch64 -pr:b=ci/conan/profiles/ohos-aarch64
                         # 期望: 未加别名时 configure 报
                         #   "No package 'sqlite3' found"；复制 sqlite3.pc 别名后
                         #   PKG_CHECK_MODULES 通过

# ═══ Layer 3: 方案层 ═══
rec_priority:           1
rec_approach:           pc-alias-copy
rec_description:        generate() 里把 PkgConfigDeps 生成的 .pc 复制一份为
                         configure 期望名（sqlite.pc → sqlite3.pc）。零源码改动，
                         纯构建产物命名对齐；若两个名字都需保留则共存（同名 .pc
                         在 generators 目录，PKG_CONFIG_PATH 优先命中）
rec_command:            (conanfile.py generate() 中)
                         import shutil
                         gen = self.generators_folder
                         if os.path.isfile(os.path.join(gen, "sqlite.pc")):
                             shutil.copy2(os.path.join(gen, "sqlite.pc"),
                                          os.path.join(gen, "sqlite3.pc"))
rec_auto_fix:           false
rec_impl:               conan-recipe

fallback_priority:      2
fallback_approach:      pkgconfig-path-append
fallback_description:   若上游探测名对应的 .pc 由依赖包自带（如 glib 包内含
                         gio-unix-2.0.pc），把依赖包原装 pkgconfig 目录 append 进
                         PKG_CONFIG_PATH——只适用依赖包确实自带该名 .pc 的情况
fallback_command:       (PKG_CONFIG_PATH += <dep pkg>/lib/pkgconfig)
fallback_auto_fix:      false
fallback_impl:          conan-recipe

# ★ 禁止策略 ★
forbid_1_pattern:       误判.*依赖.*缺失|conan install.*重装|删.*sqlite.*依赖
forbid_1_reason:        名字不一致 ≠ 依赖缺失——重装/删依赖不解决问题且可能破坏图
forbid_1_consequence:   浪费时间且依赖图被破坏，configure 依旧失败
forbid_2_pattern:       sed.*configure.*sqlite3.*改.*sqlite|改.*configure\.ac.*探测名
forbid_2_reason:        改上游探测名会脱离上游模块约定，别名是更小/可复现的修法
forbid_2_consequence:   上游升级后探测名回归，补丁失效

# ═══ Layer 4: 原则引用 ═══
principles:

# ═══ 关系图 ═══
causes:                 []
caused_by:              []
similar_to:             DRAFT-ohos-glib-sub-pc-merge-vars
conflicts_with:         []
prerequisite_of:        []

