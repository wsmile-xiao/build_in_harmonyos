#====================================================================
# tag-archive-vs-master-buildfile.kv
# 源码分析误用 master 分支构建文件: tag 归档内容才是配方唯一依据
# 触发实例: libuinputplus 0.1.4 真机 shadow CI r3
#====================================================================

trigger_tool:            源码/构建系统分析(W1)|conan-init|CMake 系配方
phase:                   analysis
error_signature:         test_package.*fatal error: '.*\.(h|hpp)' file not found|
                          Packaging.*Packaged \d+ '\.(h|hpp|hpp)' files.*test_package.*fatal error
severity:                2
category:                headers, build-system, conan, methodology
match_keywords:          master 分支, tag 归档, CMakeLists 不一致,
                          includedirs, test_package, file not found,
                          源码分析, 构建文件, pkg-config, Cflags,
                          DESTINATION include, 子目录

root_cause:              W1 源码分析时用 raw.githubusercontent.com/<repo>/master/
                          的构建文件代替目标 tag 归档内的文件。master 与 tag
                          内容可差异巨大: libuinputplus v0.1.4 tag 实际为
                          SHARED+STATIC 双目标、头文件装 include/uInputPlus/
                          子目录、附 pkgconfig, 而 master 分支 CMakeLists 是
                          精简版(单目标、平铺 include/)。按 master 写
                          cpp_info.includedirs=["include"] 后, test_package
                          编译报 fatal error: 'uInput.hpp' file not found,
                          而包内头文件实际位于 include/uInputPlus/。
                          与 E217 的区别: E217 是"没查 install DESTINATION",
                          本条是"查了错误版本的 CMakeLists"——分析对象选错。
affected_scope:          所有 CMake/Autotools 系配方的 W1 分析阶段,
                          特别是 master 与最新 tag 间有重构/精简的上游
verification_cmd:        diff <(tar xzf <tag-archive> --to-stdout '*CMakeLists.txt') \
                          <(curl -s https://raw.githubusercontent.com/<repo>/master/CMakeLists.txt)
                          # 有差异则分析必须以 tag 归档为准

rec_priority:            1
rec_approach:            analyze-tag-archive-only
rec_description:         ① W1 分析必须基于目标 tag/commit 的归档文件本身
                          (即 conan source() 将要下载、sha256 校验的那份),
                          禁止用 master 分支文件推断 install 布局;
                          ② 上游带 *.pc.in 时, 直接读其 Cflags/Libs 行推断
                          消费端 include 契约——libuinputplus 的
                          "Cflags: -I${includedir}/uInputPlus" 一步给出
                          cpp_info.includedirs=["include/uInputPlus"];
                          ③ 真机上 conan 缓存的 source 目录 (sha256 已验证)
                          是最终事实源, 本地分析文件可与其 diff 校验
rec_command:             grep -E "install\(FILES|DESTINATION|add_library" <tag-src>/CMakeLists.txt && \
                          cat <tag-src>/*.pc.in
rec_auto_fix:            false
rec_impl:                manual

fallback_priority:       2
fallback_approach:       verify-from-device-source-cache
fallback_description:    本地已按错误布局写完配方时, 用真机 conan 缓存源码
                          目录核对实际 install 行为 (cmake --install 日志会
                          打印每个文件的最终安装路径), 据此修正
                          cpp_info.includedirs 后重跑
fallback_auto_fix:       false

forbid_1_pattern:        用 raw.githubusercontent.com/<repo>/master/* 分析非 master 版本
principles:

causes:                  E217(终态症状同: includedirs 未匹配 install 子目录,
                          根因层不同——本条是分析对象选错), E221(cpp_info 公开
                          契约建模)
