#pragma once

// ⚠ 缺陷态示例（demo.sh 阶段①使用）：本封装头调用 gettext 家族函数，却没有
// #include <libintl.h>。GNU/glibc 下 dgettext() 可经隐式声明使用，OHOS(musl)
// 下没有 libc 内建 gettext，该写法在目标平台不可移植。
#include <string>

namespace i18n_demo {

std::string tr(const char *domain, const char *msgid);

std::string tr_plural(const char *domain, const char *msgid,
                      const char *msgid_plural, unsigned long n);

} // namespace i18n_demo
