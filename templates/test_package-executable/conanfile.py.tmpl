import os
import subprocess

from conan import ConanFile


class {ClassName}TestConan(ConanFile):
    """test_package for executable packages — runs the binary directly."""
    settings = "os", "arch", "compiler", "build_type"
    test_type = "explicit"

    def build(self):
        # No build needed — we test the installed executable directly
        pass

    def test(self):
        # Find the installed executable
        bin_path = os.path.join(self.deps_env_info["{name}"].PATH[0], "{name}")
        if not os.path.isfile(bin_path):
            # Try common variations
            for candidate in os.listdir(os.path.dirname(bin_path)):
                full = os.path.join(os.path.dirname(bin_path), candidate)
                if os.access(full, os.X_OK):
                    bin_path = full
                    break

        self.output.info(f"Testing executable: {bin_path}")

        # Smoke test: run with --version
        ret = subprocess.run([bin_path, "--version"],
                             capture_output=True, text=True, timeout=30)
        if ret.returncode == 0:
            self.output.info(f"✅ --version: {ret.stdout.strip()[:80]}")
        else:
            # Try --help as fallback (some tools don't support --version)
            ret2 = subprocess.run([bin_path, "--help"],
                                  capture_output=True, text=True, timeout=30)
            if ret2.returncode == 0:
                self.output.info("✅ --help OK")
            else:
                raise Exception(f"Executable failed: {bin_path} "
                                f"(version rc={ret.returncode}, help rc={ret2.returncode})")
