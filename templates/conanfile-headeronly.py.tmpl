#!/usr/bin/env python3
"""Conan recipe template — Header-only / 无构建打包族（v12.21 新增）.

适用（普查 3,477 配方中占 26% 却长期无模板的族类）：
  A. Header-only C/C++ 库（doctest/catch2 型——cpp_info 仅头文件）
  B. 纯数据/文档/脚本重分发（字体/配置/资源包——无编译）
  C. 解释型脚本工具打包（perl/python/bash CLI 工具——只装不编）

用法: 替换 {NAME}/{name}/{version}/{description}/{license}/{homepage}
     按变体删改 A/B/C 注释块。
铁律对齐: R34（test_package 必须真实调用被测物——header-only 也要写
test.c 实际 include 并使用接口，不能只 print）；R51（上游测试三步法
照常适用：header-only 库的上游测试也要清点+如实申报）。
"""
from conan import ConanFile
from conan.tools.files import get, copy
from conan.tools.layout import basic_layout


class {NAME}Conan(ConanFile):
    name = "{name}"
    version = "{version}"
    description = "{description}"
    license = "{license}"
    homepage = "{homepage}"
    url = ""  # CI fills this

    package_type = "library"      # 变体 B/C 可改 "none"

    # 无编译产物 → settings 仅保留结构一致性；package_id 清空见下
    settings = "os", "compiler", "build_type", "arch"

    no_copy_source = True

    def layout(self):
        basic_layout(self)

    def source(self):
        get(self, **self.conan_data["sources"], strip_root=True)

    # 无编译阶段：不定义 build()，或留空（不得伪造编译日志——R34）

    def package(self):
        # ── 变体 A: header-only 库 ──
        copy(self, "*.h", src=self.source_folder,
             dst="include")
        copy(self, "*.hpp", src=self.source_folder,
             dst="include")
        copy(self, "LICENSE*", src=self.source_folder,
             dst="licenses", keep_path=False)
        # ── 变体 B: 数据/资源包（按实际目标路径改写）──
        # copy(self, "*.ttf", src=self.source_folder, dst="share/fonts")
        # ── 变体 C: 脚本工具（装到 bin 并保持可执行）──
        # copy(self, "{name}", src=self.source_folder, dst="bin")

    def package_id(self):
        self.info.clear()          # 无构建依赖 os/compiler → 单一 package_id

    def package_info(self):
        # 变体 A: 标准头文件信息
        self.cpp_info.bindirs = []
        self.cpp_info.libdirs = []
        # 变体 B/C: cpp_info 置空，改用 runenv_info 定义运行期环境
        # self.runenv_info.define_path("{name}_HOME", self.package_folder)
