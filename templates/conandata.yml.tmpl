# conandata.yml template
# File location: archives/{letter}/{name}/{version}/conandata.yml
# This file is the single source of truth for source URL + SHA256 + patches.
# conanfile.py reads this via self.conan_data["sources"] and apply_conandata_patches().

sources:
  url: "https://example.com/{name}-{version}.tar.gz"
  sha256: "REPLACE_WITH_ACTUAL_SHA256"

patches:
  # Each patch entry:
  #   key = patch filename (relative to patches/ directory)
  #   patch_file = actual path
  #   patch_description = what and why
  #   patch_type = portability | bugfix | backport
  #
  # "0001-fix-config-sub.patch":
  #   patch_file: "patches/0001-fix-config-sub.patch"
  #   patch_description: "Fix config.sub to recognize aarch64-ohos"
  #   patch_type: "portability"
